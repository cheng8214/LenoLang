{
  "name": "vscode-leno",
  "displayName": "Leno Language Support",
  "description": "Language support for Leno programming language - syntax highlighting, code completion, hover info, diagnostics",
  "version": "1.1.0",
  "publisher": "leno-lang",
  "repository": {
    "type": "git",
    "url": "https://gitee.com/cheng8214/LenoLang"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages",
    "Language Packs"
  ],
  "keywords": [
    "leno",
    "language",
    "lsp"
  ],
  "activationEvents": [
    "onLanguage:leno",
    "onCommand:leno.selectLanguage"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "leno.associateFiles",
        "title": "关联 .leno 文件",
        "category": "Leno"
      }
    ],
    "languages": [
      {
        "id": "leno",
        "aliases": [
          "Leno",
          "leno"
        ],
        "extensions": [
          ".leno"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/leno-icon.svg",
          "dark": "./icons/leno-icon.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "leno",
        "scopeName": "source.leno",
        "path": "./syntaxes/leno.tmLanguage.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Leno Language Server",
      "properties": {
        "leno.languageServer.path": {
          "type": "string",
          "default": "",
          "description": "Path to the Leno language server executable (leno_lsp.exe)"
        },
        "leno.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the Leno language server"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^8.1.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "^18.x",
    "typescript": "^4.9.4",
    "eslint": "^8.28.0",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "@vscode/vsce": "^2.19.0"
  }
}
