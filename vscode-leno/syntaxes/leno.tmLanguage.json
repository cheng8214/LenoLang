{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Leno",
  "scopeName": "source.leno",
  "fileTypes": [".leno"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.leno",
          "match": "//.*$"
        },
        {
          "name": "comment.block.leno",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.leno",
          "match": "\\b(if|else|eif|then|while|for|to|break|continue|return|switch|case|default|try|catch|finally|throw)\\b"
        },
        {
          "name": "keyword.declaration.leno",
          "match": "\\b(var|func|struct|cstruct|enum|face|impl|import|export|as|use|new|self)\\b"
        },
        {
          "name": "keyword.operator.type.leno",
          "match": "\\b(is|in|and|or|not|as)\\b"
        },
        {
          "name": "keyword.other.leno",
          "match": "\\b(async|await)\\b"
        },
        {
          "name": "constant.language.leno",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.leno",
          "match": "\\b(int|float|string|bool|any|var)\\b"
        },
        {
          "name": "support.type.builtin.leno",
          "match": "\\b(Array|Dict|Ptr|File|bigint|Thread|Channel)\\b"
        },
        {
          "name": "support.type.clayout.leno",
          "match": "\\b(i8|u8|i16|u16|i32|u32|i64|u64|f32|f64|str16)\\b"
        },
        {
          "name": "support.type.cplatform.leno",
          "match": "\\b(c_int|c_uint|c_long|c_ulong|c_longlong|c_ulonglong|c_size|c_ssize|c_char)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.leno",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.leno",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.leno",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.leno",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.leno",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.float.leno",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.leno",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.power.leno",
          "match": "(\\*\\*)"
        },
        {
          "name": "keyword.operator.arithmetic.leno",
          "match": "([+%]|\\-(?!>)|/(?![*/])|\\*(?!\\*))"
        },
        {
          "name": "keyword.operator.comparison.leno",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.leno",
          "match": "(=|\\+=|-=|\\*=|/=|%=)"
        },
        {
          "name": "keyword.operator.increment.leno",
          "match": "(\\+\\+|--)"
        },
        {
          "name": "keyword.operator.arrow.leno",
          "match": "(->)"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.accessor.leno",
          "match": "\\."
        }
      ]
    }
  }
}
