// Test file for Leno LSP
// This file demonstrates various Leno language features

// Variable declarations
var message = "Hello, Leno!"
var count = 42
var pi = 3.14159
var flag = true

// Function definition
func greet(string name):string {
    return "Hello, " + name + "!"
}

// Struct definition
struct Point {
    int x = 0
    int y = 0
    
    func move(int dx, int dy) {
        x = x + dx
        y = y + dy
    }
}

// Main function
func main() {
    // Print message
    print(message)
    
    // Create a point
    var p = Point()
    p.move(10, 20)
    print("Point: (" + p.x + ", " + p.y + ")")
    
    // Call function
    var greeting = greet("World")
    print(greeting)
    
    // Array
    var numbers = [1, 2, 3, 4, 5]
    for numbers to n {
        print(n)
    }
    
    // Dictionary
    var person = {
        "name": "Alice",
        "age": 30
    }
    print(person["name"])
    
    // Type guard
    var value = 100
    if value is int {
        print("Value is an integer: " + value)
    }
}

