// web_crawler.leno — LenoWeb 爬虫框架（URL 工具 + 队列爬取）
// 依赖 web_net.leno（HTTP）和 web_html.leno（HTML 解析）

import strings
import "web_html.leno" as htmls
import "web_net.leno"
use web_net.(HttpClient, Response, createClient)

// ==================== URL 工具 ====================

func _s(any v): string {
    if v is string { return v }
    return ""
}

func _i(any v): int {
    if v is int { return v }
    return 0
}

export func parseUrl(string url): Dict {
    int pos = 0
    int len = url.len()
    string scheme = ""
    while pos < len {
        if url.byte(pos) == 58 {
            pos = pos + 1
            break
        }
        scheme = scheme + strings.char(url.byte(pos))
        pos = pos + 1
    }
    if pos >= len { return {} }
    if url.byte(pos) != 47 { return {} }
    if pos + 1 >= len { return {} }
    if url.byte(pos + 1) != 47 { return {} }
    pos = pos + 2
    
    string host = ""
    while pos < len {
        int b = url.byte(pos)
        if b == 58 or b == 47 or b == 63 or b == 35 { break }
        host = host + strings.char(b)
        pos = pos + 1
    }
    
    int port = -1
    if pos < len and url.byte(pos) == 58 {
        pos = pos + 1
        port = 0
        while pos < len {
            int b = url.byte(pos)
            if b >= 48 and b <= 59 {
                port = port * 10 + (b - 48)
                pos = pos + 1
            } else { break }
        }
    }
    
    string path = ""
    if pos < len { path = url[pos:] }
    if path == "" { path = "/" }
    
    Dict[string, any] r = {}
    r["scheme"] = scheme
    r["host"] = host
    r["port"] = port
    r["path"] = path
    return r
}

export func buildUrl(Dict parts): string {
    string scheme = _s(parts["scheme"])
    string host = _s(parts["host"])
    int port = _i(parts["port"])
    string path = _s(parts["path"])
    string result = scheme + "://" + host
    if (scheme == "http" and port != 80 and port > 0) or
       (scheme == "https" and port != 443 and port > 0) {
        result = result + ":" + format("%d", port)
    }
    result = result + path
    return result
}

export func domain(string url): string {
    return _s(parseUrl(url)["host"])
}

export func baseUrl(string url): string {
    Dict parts = parseUrl(url)
    string scheme = _s(parts["scheme"])
    string host = _s(parts["host"])
    int port = _i(parts["port"])
    string path = _s(parts["path"])
    int lastSlash = -1
    int i = 0
    while i < path.len() {
        if path.byte(i) == 47 { lastSlash = i }
        i = i + 1
    }
    string base = "/"
    if lastSlash > 0 { base = path[:lastSlash + 1] }
    string result = scheme + "://" + host
    if (scheme == "http" and port != 80 and port > 0) or
       (scheme == "https" and port != 443 and port > 0) {
        result = result + ":" + format("%d", port)
    }
    result = result + base
    return result
}

func _collapse(string path): string {
    Array segs = []
    string cur = ""
    int i = 0
    while i < path.len() {
        int b = path.byte(i)
        if b == 47 {
            if cur == ".." {
                if segs.len() > 0 { segs = segs[:segs.len() - 1] }
            } else if cur != "." and cur != "" {
                segs.add(cur)
            }
            cur = ""
        } else {
            cur = cur + strings.char(b)
        }
        i = i + 1
    }
    if cur == ".." {
        if segs.len() > 0 { segs = segs[:segs.len() - 1] }
    } else if cur != "." and cur != "" {
        segs.add(cur)
    }
    string result = ""
    if path.byte(0) == 47 { result = "/" }
    result = result + strings.join(segs, "/")
    if path.byte(path.len() - 1) == 47 and result != "/" {
        result = result + "/"
    }
    return result
}

export func resolveUrl(string base, string ref): string {
    if ref.len() > 4 {
        string prefix = ""
        int maxC = 10
        if ref.len() < maxC { maxC = ref.len() }
        int j = 0
        while j < maxC {
            prefix = prefix + strings.char(ref.byte(j))
            j = j + 1
        }
        if prefix.has("://") { return normalizeUrl(ref) }
    }
    if ref.len() > 2 and ref.byte(0) == 47 and ref.byte(1) == 47 {
        return normalizeUrl(_s(parseUrl(base)["scheme"]) + ":" + ref)
    }
    Dict bp = parseUrl(base)
    string scheme = _s(bp["scheme"])
    string host = _s(bp["host"])
    int port = _i(bp["port"])
    string basePath = _s(bp["path"])
    string bpo = basePath
    int qi = -1
    int fi = -1
    int bi = 0
    while bi < basePath.len() {
        int b = basePath.byte(bi)
        if b == 63 and qi < 0 { qi = bi }
        if b == 35 and fi < 0 { fi = bi }
        bi = bi + 1
    }
    if qi >= 0 { bpo = basePath.slice(0, qi) }
    else if fi >= 0 { bpo = basePath.slice(0, fi) }
    if bpo.len() > 0 and bpo.byte(bpo.len() - 1) != 47 {
        int ls = -1
        int si = 0
        while si < bpo.len() {
            if bpo.byte(si) == 47 { ls = si }
            si = si + 1
        }
        if ls >= 0 { bpo = bpo[:ls + 1] }
    }
    string resolved = ""
    if ref.byte(0) == 47 { resolved = ref }
    else { resolved = bpo + ref }
    resolved = _collapse(resolved)
    string result = scheme + "://" + host
    if (scheme == "http" and port != 80 and port > 0) or
       (scheme == "https" and port != 443 and port > 0) {
        result = result + ":" + format("%d", port)
    }
    result = result + resolved
    return normalizeUrl(result)
}

export func normalizeUrl(string url): string {
    Dict parts = parseUrl(url)
    string scheme = _s(parts["scheme"])
    string host = _s(parts["host"]).to_lower()
    int port = _i(parts["port"])
    string path = _s(parts["path"])
    int fi = -1
    int pi = 0
    while pi < path.len() {
        if path.byte(pi) == 35 { fi = pi; break }
        pi = pi + 1
    }
    if fi >= 0 { path = path.slice(0, fi) }
    if path == "" { path = "/" }
    Dict[string, any] r = {}
    r["scheme"] = scheme
    r["host"] = host
    r["port"] = port
    r["path"] = path
    return buildUrl(r)
}

// 提取 URL 中指定 query 参数的值，找不到返回空串
export func getQueryParam(string url, string key): string {
    int qi = strings.find(url, "?")
    if qi < 0 {
        return ""
    }
    // 截取 query 部分（去掉 fragment）
    int end = url.len()
    int fi = strings.find(url, "#")
    if fi >= 0 and fi > qi {
        end = fi
    }
    string qs = url.slice(qi + 1, end)
    // 按 & 分割各参数
    int start = 0
    int len = qs.len()
    while start <= len {
        int amp = strings.find(qs.slice(start, len), "&")
        int segEnd = len
        if amp >= 0 {
            segEnd = start + amp
        }
        string seg = qs.slice(start, segEnd)
        // 按 = 分割 key=value
        int eq = strings.find(seg, "=")
        string k = ""
        string v = ""
        if eq >= 0 {
            k = seg.slice(0, eq)
            v = seg.slice(eq + 1, seg.len())
        } else {
            k = seg
        }
        if k == key {
            return v
        }
        if amp < 0 {
            break
        }
        start = segEnd + 1
    }
    return ""
}

// 去掉 URL 的 query 和 fragment，返回纯净 URL
export func stripQuery(string url): string {
    int len = url.len()
    int end = len
    int qi = strings.find(url, "?")
    int fi = strings.find(url, "#")
    if qi >= 0 and (fi < 0 or qi < fi) {
        end = qi
    } else if fi >= 0 {
        end = fi
    }
    return url.slice(0, end)
}

// ==================== Robots.txt 解析 ====================

// 解析 robots.txt 文本，返回规则结构：
// {groups: [{user_agents: [...], allow: [...], disallow: [...]}]}
export func parseRobots(string text): Dict {
    var lines = strings.split(text, "\n")
    Array groups = []
    Dict[string, any] cur = {user_agents: [], allow: [], disallow: []}
    for lines to ln {
        string line = strings.trim(ln)
        if line == "" or line.starts_with("#") {
            continue
        }
        int ci = strings.find(line, ":")
        if ci < 0 {
            continue
        }
        string field = strings.to_lower(strings.trim(line.slice(0, ci)))
        string value = strings.trim(line.slice(ci + 1, line.len()))
        if field == "user-agent" {
            // 新一组
            var prevUas = cur["user_agents"]
            if prevUas is Array and prevUas.len() > 0 {
                groups.add(cur)
            }
            cur = {user_agents: [value], allow: [], disallow: []}
        } else if field == "allow" {
            if value != "" {
                var allows = cur["allow"]
                if allows is Array {
                    allows.add(value)
                }
            }
        } else if field == "disallow" {
            if value != "" {
                var disallows = cur["disallow"]
                if disallows is Array {
                    disallows.add(value)
                }
            }
        }
    }
    var lastUas = cur["user_agents"]
    if lastUas is Array and lastUas.len() > 0 {
        groups.add(cur)
    }
    return {groups: groups}
}

// 判断是否允许抓取 url。userAgent 不区分大小写，支持通配 *
func _robotsRuleMatch(string rule, string path): bool {
    // 支持 * 通配符的简单前缀匹配
    int star = strings.find(rule, "*")
    if star < 0 {
        return path.starts_with(rule)
    }
    string prefix = rule.slice(0, star)
    string suffix = rule.slice(star + 1, rule.len())
    if not path.starts_with(prefix) {
        return false
    }
    if suffix == "" {
        return true
    }
    return path.has(suffix)
}

// 从 URL 中提取用于 robots 匹配的路径
func _robotsPath(string url): string {
    string clean = stripQuery(url)
    int hi = strings.find(clean, "://")
    if hi < 0 {
        return clean
    }
    int slash = strings.find(clean.slice(hi + 3, clean.len()), "/")
    if slash < 0 {
        return "/"
    }
    string p = clean.slice(hi + 3 + slash, clean.len())
    if p == "" {
        p = "/"
    }
    return p
}

// 判断 robots.txt 是否允许抓取指定 URL
export func isRobotsAllowed(string robotsText, string userAgent, string url): bool {
    var parsed = parseRobots(robotsText)
    var groups = parsed["groups"]
    string ua = strings.to_lower(userAgent)
    string path = _robotsPath(url)

    // 查找最匹配的 UA 组（精确匹配优先，其次 *)
    Dict[string, any] selected = null
    bool selectedIsStar = false
    if groups is Array {
        for groups to g {
            if g is Dict[string, any] {
                var uas = g["user_agents"]
                if uas is Array {
                    for uas to gagent {
                        string gs = strings.to_lower(gagent)
                        if gs == "*" {
                            if selected == null {
                                selected = g
                                selectedIsStar = true
                            }
                        } else if gs == ua {
                            selected = g
                            selectedIsStar = false
                        }
                    }
                }
            }
        }
    }
    if selected == null {
        return true
    }

    // 检查 Allow / Disallow 规则
    bool allowed = true
    var allows = selected["allow"]
    var disallows = selected["disallow"]

    // Disallow 命中即拒绝，除非 Allow 覆盖
    if disallows is Array {
        for disallows to rule {
            if _robotsRuleMatch(rule, path) {
                allowed = false
            }
        }
    }
    if allows is Array {
        for allows to rule {
            if _robotsRuleMatch(rule, path) {
                allowed = true
            }
        }
    }
    return allowed
}

// ==================== Sitemap.xml 解析 ====================

// 解析 sitemap.xml 文本，提取所有 <loc> 中的 URL
export func parseSitemap(string xml): Array[string] {
    Array[string] urls = []
    int pos = 0
    int n = xml.len()
    while true {
        // 查找 <loc>（大小写不敏感：支持 <loc> 和 <LOC>）
        int open = strings.find(xml.slice(pos, n), "<loc")
        if open < 0 {
            break
        }
        int start = pos + open
        // 跳过标签内容 <loc> 或 <loc ...>
        int gt = strings.find(xml.slice(start, n), ">")
        if gt < 0 {
            break
        }
        int contentStart = start + gt + 1
        // 查找 </loc>
        int closeTag = strings.find(xml.slice(contentStart, n), "</loc")
        if closeTag < 0 {
            break
        }
        int contentEnd = contentStart + closeTag
        string url = xml.slice(contentStart, contentEnd)
        url = strings.trim(url)
        if url != "" {
            urls.add(url)
        }
        pos = contentEnd
    }
    return urls
}

// 从 URL 获取其 sitemap.xml 路径（简化：直接返回 /sitemap.xml）
export func sitemapUrl(string baseUrl): string {
    string clean = baseUrl
    if clean.ends_with("/") {
        clean = clean.slice(0, clean.len() - 1)
    }
    return clean + "/sitemap.xml"
}

// ==================== Crawler 核心 ====================

export func Crawler(Dict config): Dict {
    Dict[string, any] c = {}
    c["start_urls"] = []
    c["allowed_domains"] = []
    c["max_pages"] = 100
    c["max_depth"] = 3
    c["delay_ms"] = 0
    c["user_agent"] = "LenoCrawler/1.0"
    c["visited"] = {}
    c["queue"] = []
    c["page_count"] = 0
    c["running"] = false
    if config["start_urls"] is Array { c["start_urls"] = config["start_urls"] }
    if config["allowed_domains"] is Array { c["allowed_domains"] = config["allowed_domains"] }
    if config["max_pages"] is int { c["max_pages"] = config["max_pages"] }
    if config["max_depth"] is int { c["max_depth"] = config["max_depth"] }
    if config["delay_ms"] is int { c["delay_ms"] = config["delay_ms"] }
    if config["user_agent"] is string { c["user_agent"] = config["user_agent"] }
    return c
}

export func start(Dict[string, any] crawler): Dict {
    crawler["running"] = true
    crawler["page_count"] = 0
    var startRaw = crawler["start_urls"]
    if startRaw is Array {
        int idx = 0
        while idx < startRaw.len() {
            if startRaw[idx] is string {
                Dict[string, any] entry = {}
                entry["url"] = startRaw[idx]
                entry["depth"] = 0
                var queue = crawler["queue"]
                if queue is Array { queue.add(entry) }
            }
            idx = idx + 1
        }
    }
    return crawler
}

export func nextUrl(Dict[string, any] crawler): any {
    var queue = crawler["queue"]
    if queue is Array {
        return _nextUrlLoop(crawler, queue)
    }
    return null
}

func _nextUrlLoop(Dict[string, any] crawler, Array queue): any {
    while queue.len() > 0 {
        var entry = queue[0]
        crawler["queue"] = queue[1:]
        if entry is Dict {
            string url = _s(entry["url"])
            int depth = _i(entry["depth"])
            var visited = crawler["visited"]
            if visited is Dict {
                if visited[url] is bool {
                    if visited[url] { continue }
                }
            }
            if depth > crawler["max_depth"] { continue }
            var allowed = crawler["allowed_domains"]
            if allowed is Array and allowed.len() > 0 {
                string d = domain(url)
                if not allowed.has(d) { continue }
            }
            return entry
        }
    }
    return null
}

export func markVisited(Dict[string, any] crawler, string url) {
    var visited = crawler["visited"]
    if visited is Dict { visited[url] = true }
    crawler["page_count"] = crawler["page_count"] + 1
}

export func enqueue(Dict[string, any] crawler, string url, int depth) {
    var visited = crawler["visited"]
    if visited is Dict {
        if visited[url] is bool {
            if visited[url] { return }
        }
    }
    if depth > crawler["max_depth"] { return }
    Dict[string, any] entry = {}
    entry["url"] = url
    entry["depth"] = depth
    var queue = crawler["queue"]
    if queue is Array { queue.add(entry) }
}

export func shouldStop(Dict[string, any] crawler): bool {
    var running = crawler["running"]
    if running is bool {
        if not running { return true }
    }
    if crawler["page_count"] >= crawler["max_pages"] { return true }
    var queue = crawler["queue"]
    if queue is Array {
        if queue.len() == 0 { return true }
    } else {
        return true
    }
    return false
}

export func stop(Dict[string, any] crawler) {
    crawler["running"] = false
}

// ==================== 便捷组合函数 ====================

export func fetchPage(string url, string user_agent): any {
    HttpClient c = createClient()
    c.setHeaders(["User-Agent: " + user_agent])
    Response resp = c.get(url)
    c.close()
    if not resp.ok() { return null }
    string body = resp.body
    Dict[string, any] r = {}
    r["url"] = url
    r["status"] = resp.statusCode
    r["body"] = body
    r["html"] = htmls.parse(body)
    return r
}

export func extractLinks(Dict[string, any] page): Array[string] {
    if not page is Dict { return [] }
    var root = page["html"]
    string bu = _s(page["url"])
    Array links = []
    var allRaw = htmls.select(root, "a")
    if allRaw is Array {
        int i = 0
        while i < allRaw.len() {
            var node = allRaw[i]
            if node is Dict {
                string href = htmls.attr(node, "href")
                if href != "" { links.add(resolveUrl(bu, href)) }
            }
            i = i + 1
        }
    }
    return links
}
