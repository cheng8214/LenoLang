// web_html.leno — LenoWeb HTML 解析器（纯 Leno 实现）
// 使用模块级全局变量管理解析状态
// 使用泛型类型 Array[string]/Dict[string,string] 提高类型安全性
// 支持：HTML 实体解码、DOCTYPE、CDATA、容错解析

import strings

// ==================== 模块级全局状态 ====================

var _g_pos = 0
var _g_html = ""

// ==================== 辅助函数 ====================

func _isAlpha(int b): bool {
    return (b >= 97 and b <= 122) or (b >= 65 and b <= 90)
}

func _isAlphaNum(int b): bool {
    return (b >= 97 and b <= 122) or (b >= 65 and b <= 90) or (b >= 48 and b <= 57)
}

func _isSpace(int b): bool {
    return b == 32 or b == 9 or b == 10 or b == 13
}

// ==================== 解析器 ====================

func _parseTagName(): string {
    string tag = ""
    while _g_pos < _g_html.len(){
        int b = _g_html.byte(_g_pos)
        if _isAlphaNum(b) or b == 45 or b == 95 {
            tag = tag + strings.char(b)
            _g_pos = _g_pos + 1
        } else {
            break
        }
    }
    return tag
}

func _skipWs() {
    while _g_pos <  _g_html.len() {
        int b = _g_html.byte(_g_pos)
        if _isSpace(b) {
            _g_pos = _g_pos + 1
        } else {
            break
        }
    }
}

func _parseAttrs(): Dict[string, string] {
    Dict[string, string] attrs = {}
    int len = _g_html.len()
    while _g_pos < len {
        while _g_pos < len and _isSpace(_g_html.byte(_g_pos)) {
            _g_pos = _g_pos + 1
        }
        if _g_pos >= len {
            break
        }
        int b = _g_html.byte(_g_pos)
        if b == 62 or b == 47 {
            break
        }
        // 跳过非法字符
        if b == 60 or b == 38 {
            _g_pos = _g_pos + 1
            continue
        }
        string name = ""
        while _g_pos < len {
            int ch = _g_html.byte(_g_pos)
            if _isSpace(ch) or ch == 61 or ch == 62 or ch == 47 or ch == 60 or ch == 38 {
                break
            }
            name = name + strings.char(ch)
            _g_pos = _g_pos + 1
        }
        if name == "" {
            _g_pos = _g_pos + 1
            continue
        }
        // 属性名转小写
        name = name.to_lower()
        while _g_pos < len and _isSpace(_g_html.byte(_g_pos)) {
            _g_pos = _g_pos + 1
        }
        string val = ""
        if _g_pos < len and _g_html.byte(_g_pos) == 61 {
            _g_pos = _g_pos + 1
            while _g_pos < len and _isSpace(_g_html.byte(_g_pos)) {
                _g_pos = _g_pos + 1
            }
            int q = -1
            if _g_pos < len {
                q = _g_html.byte(_g_pos)
            }
            if q == 34 or q == 39 {
                _g_pos = _g_pos + 1
                while _g_pos < len {
                    int ch = _g_html.byte(_g_pos)
                    if ch == q {
                        _g_pos = _g_pos + 1
                        break
                    }
                    val = val + strings.char(ch)
                    _g_pos = _g_pos + 1
                }
            } else {
                // 无引号属性值
                while _g_pos < len {
                    int ch = _g_html.byte(_g_pos)
                    if _isSpace(ch) or ch == 62 or ch == 47 {
                        break
                    }
                    val = val + strings.char(ch)
                    _g_pos = _g_pos + 1
                }
            }
        } else {
            // 布尔属性：checked, disabled, selected 等
            // HTML 中布尔属性存在即表示 true，值设为属性名本身
            val = name
        }
        attrs[name] = val
    }
    return attrs
}

func _parseText(): string {
    string text = ""
    int len = _g_html.len()
    while _g_pos < len {
        int b = _g_html.byte(_g_pos)
        if b == 60 {
            break
        }
        text = text + strings.char(b)
        _g_pos = _g_pos + 1
    }
    return text
}

// 判断是否为 void 标签（不需要闭合标签）
func _isVoidTag(string tagName): bool {
    return tagName == "br" or tagName == "hr" or tagName == "img" or
           tagName == "input" or tagName == "meta" or tagName == "link" or
           tagName == "area" or tagName == "base" or tagName == "col" or
           tagName == "embed" or tagName == "source" or tagName == "track" or
           tagName == "wbr"
}

// ==================== HTML 实体解码 ====================

func _namedEntity(string name): string {
    switch name {
        case "amp" { return "&" }
        case "lt" { return "<" }
        case "gt" { return ">" }
        case "quot" { return "\"" }
        case "apos" { return "'" }
        case "nbsp" { return " " }
        case "copy" { return "©" }
        case "reg" { return "®" }
        case "trade" { return "™" }
        case "hellip" { return "…" }
        case "mdash" { return "—" }
        case "ndash" { return "–" }
        case "laquo" { return "«" }
        case "raquo" { return "»" }
        case "ldquo" { return "\u201C" }
        case "rdquo" { return "\u201D" }
        case "lsquo" { return "‘" }
        case "rsquo" { return "’" }
        case "bull" { return "•" }
        case "middot" { return "·" }
        case "deg" { return "°" }
        case "plusmn" { return "±" }
        case "times" { return "×" }
        case "divide" { return "÷" }
        case "frac14" { return "¼" }
        case "frac12" { return "½" }
        case "frac34" { return "¾" }
        default { return "" }
    }
}

func _hexDigit(int ch): int {
    if ch >= 48 and ch <= 57 { return ch - 48 }
    if ch >= 65 and ch <= 70 { return ch - 55 }
    if ch >= 97 and ch <= 102 { return ch - 87 }
    return -1
}

func _codepointToUtf8(int cp): string {
    if cp <= 127 {
        return strings.char(cp)
    }
    if cp <= 2047 {
        int b1 = 192 + (cp / 64)
        int b2 = 128 + (cp % 64)
        return strings.char(b1) + strings.char(b2)
    }
    if cp <= 65535 {
        int b1 = 224 + (cp / 4096)
        int b2 = 128 + ((cp / 64) % 64)
        int b3 = 128 + (cp % 64)
        return strings.char(b1) + strings.char(b2) + strings.char(b3)
    }
    int b1 = 240 + (cp / 262144)
    int b2 = 128 + ((cp / 4096) % 64)
    int b3 = 128 + ((cp / 64) % 64)
    int b4 = 128 + (cp % 64)
    return strings.char(b1) + strings.char(b2) + strings.char(b3) + strings.char(b4)
}

func _decodeEntities(string text): string {
    string result = ""
    int i = 0
    int len = text.len()
    while i < len {
        int b = text.byte(i)
        if b == 38 {
            int savePos = i
            i = i + 1
            if i < len and text.byte(i) == 35 {
                i = i + 1
                int codepoint = 0
                if i < len and (text.byte(i) == 120 or text.byte(i) == 88) {
                    i = i + 1
                    while i < len {
                        int ch = text.byte(i)
                        if ch == 59 {
                            i = i + 1
                            break
                        }
                        int d = _hexDigit(ch)
                        if d < 0 { break }
                        codepoint = codepoint * 16 + d
                        i = i + 1
                    }
                } else {
                    while i < len {
                        int ch = text.byte(i)
                        if ch == 59 {
                            i = i + 1
                            break
                        }
                        if ch >= 48 and ch <= 57 {
                            codepoint = codepoint * 10 + (ch - 48)
                            i = i + 1
                        } else {
                            break
                        }
                    }
                }
                if codepoint > 0 and codepoint <= 1114111 {
                    result = result + _codepointToUtf8(codepoint)
                } else {
                    i = savePos + 1
                    result = result + strings.char(38)
                }
            } else {
                string name = ""
                while i < len {
                    int ch = text.byte(i)
                    if ch == 59 {
                        i = i + 1
                        break
                    }
                    if ch == 38 or _isSpace(ch) or ch == 60 or ch == 62 {
                        break
                    }
                    name = name + strings.char(ch)
                    i = i + 1
                }
                string decoded = _namedEntity(name)
                if decoded != "" {
                    result = result + decoded
                } else {
                    i = savePos + 1
                    result = result + strings.char(38)
                }
            }
        } else {
            result = result + strings.char(b)
            i = i + 1
        }
    }
    return result
}

// ==================== 元素解析 ====================

func _parseElement(): any {
    int len = _g_html.len()
    if _g_pos >= len {
        return null
    }
    if _g_html.byte(_g_pos) != 60 {
        return null
    }

    // 注释 <!-- ... -->
    if _g_pos + 3 < len and _g_html.byte(_g_pos+1) == 33 and _g_html.byte(_g_pos+2) == 45 and _g_html.byte(_g_pos+3) == 45 {
        _g_pos = _g_pos + 4
        while _g_pos < len {
            if _g_html.byte(_g_pos) == 45 and _g_pos+2 < len and _g_html.byte(_g_pos+1) == 45 and _g_html.byte(_g_pos+2) == 62 {
                _g_pos = _g_pos + 3
                break
            }
            _g_pos = _g_pos + 1
        }
        return null
    }

    // CDATA <![CDATA[ ... ]]>
    if _g_pos + 8 < len and _g_html.byte(_g_pos+1) == 33 and _g_html.byte(_g_pos+2) == 91 and _g_html.byte(_g_pos+3) == 67 and _g_html.byte(_g_pos+4) == 68 and _g_html.byte(_g_pos+5) == 65 and _g_html.byte(_g_pos+6) == 84 and _g_html.byte(_g_pos+7) == 65 and _g_html.byte(_g_pos+8) == 91 {
        _g_pos = _g_pos + 9
        string cdata = ""
        while _g_pos < len {
            if _g_pos + 2 < len and _g_html.byte(_g_pos) == 93 and _g_html.byte(_g_pos+1) == 93 and _g_html.byte(_g_pos+2) == 62 {
                _g_pos = _g_pos + 3
                break
            }
            cdata = cdata + strings.char(_g_html.byte(_g_pos))
            _g_pos = _g_pos + 1
        }
        var node = {tag: "#text", attrs: {}, children: [], text: cdata}
        return node
    }

    // DOCTYPE / 其他声明 <!...>
    if _g_pos + 1 < len and _g_html.byte(_g_pos+1) == 33 {
        _g_pos = _g_pos + 2
        while _g_pos < len and _g_html.byte(_g_pos) != 62 {
            _g_pos = _g_pos + 1
        }
        if _g_pos < len and _g_html.byte(_g_pos) == 62 {
            _g_pos = _g_pos + 1
        }
        return null
    }

    // 闭合标签 </...>
    if _g_pos + 1 < len and _g_html.byte(_g_pos+1) == 47 {
        return null
    }

    _g_pos = _g_pos + 1

    string tagName = _parseTagName()
    if tagName == "" {
        return null
    }
    tagName = strings.to_lower(tagName)

    Dict[string, string] attrs = _parseAttrs()

    bool selfClosing = false
    if _g_pos < len and _g_html.byte(_g_pos) == 47 {
        selfClosing = true
        _g_pos = _g_pos + 1
    }
    if _g_pos < len and _g_html.byte(_g_pos) == 62 {
        _g_pos = _g_pos + 1
    }

    if selfClosing {
        var node = {tag: tagName, attrs: attrs, children: [], text: ""}
        return node
    }

    if _isVoidTag(tagName) {
        var node = {tag: tagName, attrs: attrs, children: [], text: ""}
        return node
    }

    // script/style 标签：原始内容直接读取
    if tagName == "script" or tagName == "style" {
        string rawContent = ""
        while _g_pos < len {
            if _g_html.byte(_g_pos) == 60 and _g_pos+1 < len and _g_html.byte(_g_pos+1) == 47 {
                int savePos = _g_pos
                _g_pos = _g_pos + 2
                string closeTag = _parseTagName()
                closeTag = strings.to_lower(closeTag)
                if closeTag == tagName {
                    _parseAttrs()
                    if _g_pos < len and _g_html.byte(_g_pos) == 62 {
                        _g_pos = _g_pos + 1
                    }
                    var node = {tag: tagName, attrs: attrs, children: [], text: rawContent}
                    return node
                } else {
                    _g_pos = savePos
                    rawContent = rawContent + strings.char(_g_html.byte(_g_pos))
                    _g_pos = _g_pos + 1
                }
            } else {
                rawContent = rawContent + strings.char(_g_html.byte(_g_pos))
                _g_pos = _g_pos + 1
            }
        }
        var node = {tag: tagName, attrs: attrs, children: [], text: rawContent}
        return node
    }

    // 普通标签
    var children = []
    string textContent = ""

    while _g_pos < len {
        if _g_html.byte(_g_pos) == 60 {
            if _g_pos + 3 < len and _g_html.byte(_g_pos+1) == 33 and _g_html.byte(_g_pos+2) == 45 and _g_html.byte(_g_pos+3) == 45 {
                _g_pos = _g_pos + 4
                while _g_pos < len {
                    if _g_html.byte(_g_pos) == 45 and _g_pos+2 < len and _g_html.byte(_g_pos+1) == 45 and _g_html.byte(_g_pos+2) == 62 {
                        _g_pos = _g_pos + 3
                        break
                    }
                    _g_pos = _g_pos + 1
                }
                continue
            }
            // CDATA in body
            if _g_pos + 8 < len and _g_html.byte(_g_pos+1) == 33 and _g_html.byte(_g_pos+2) == 91 and _g_html.byte(_g_pos+3) == 67 and _g_html.byte(_g_pos+4) == 68 and _g_html.byte(_g_pos+5) == 65 and _g_html.byte(_g_pos+6) == 84 and _g_html.byte(_g_pos+7) == 65 and _g_html.byte(_g_pos+8) == 91 {
                _g_pos = _g_pos + 9
                string cdata = ""
                while _g_pos < len {
                    if _g_pos + 2 < len and _g_html.byte(_g_pos) == 93 and _g_html.byte(_g_pos+1) == 93 and _g_html.byte(_g_pos+2) == 62 {
                        _g_pos = _g_pos + 3
                        break
                    }
                    cdata = cdata + strings.char(_g_html.byte(_g_pos))
                    _g_pos = _g_pos + 1
                }
                if cdata != "" {
                    textContent = textContent + cdata
                    var textNode = {tag: "#text", attrs: {}, children: [], text: cdata}
                    children.add(textNode)
                }
                continue
            }
            if _g_pos + 1 < len and _g_html.byte(_g_pos+1) == 47 {
                _g_pos = _g_pos + 2
                _parseTagName()
                while _g_pos < len and _g_html.byte(_g_pos) != 62 {
                    _g_pos = _g_pos + 1
                }
                if _g_pos < len and _g_html.byte(_g_pos) == 62 {
                    _g_pos = _g_pos + 1
                }
                break
            }
            var child = _parseElement()
            if child != null {
                children.add(child)
            }
        } else {
            string text = _parseText()
            if text != "" {
                text = _decodeEntities(text)
                textContent = textContent + text
                var textNode = {tag: "#text", attrs: {}, children: [], text: text}
                children.add(textNode)
            }
        }
    }

    var node = {tag: tagName, attrs: attrs, children: children, text: textContent}
    return node
}

// ==================== 对外接口 ====================

export func parse(string html): any {
    _g_html = html
    _g_pos = 0

    var root = {tag: "#document", attrs: {}, children: [], text: ""}
    int len = _g_html.len()

    while _g_pos < len {
        while _g_pos < len and _isSpace(_g_html.byte(_g_pos)) {
            _g_pos = _g_pos + 1
        }
        if _g_pos >= len {
            break
        }
        if _g_html.byte(_g_pos) == 60 {
            // 注释
            if _g_pos + 3 < len and _g_html.byte(_g_pos+1) == 33 and _g_html.byte(_g_pos+2) == 45 and _g_html.byte(_g_pos+3) == 45 {
                _g_pos = _g_pos + 4
                while _g_pos < len {
                    if _g_html.byte(_g_pos) == 45 and _g_pos+2 < len and _g_html.byte(_g_pos+1) == 45 and _g_html.byte(_g_pos+2) == 62 {
                        _g_pos = _g_pos + 3
                        break
                    }
                    _g_pos = _g_pos + 1
                }
                continue
            }
            // DOCTYPE / CDATA / 其他声明
            if _g_pos + 1 < len and _g_html.byte(_g_pos+1) == 33 {
                if _g_pos + 8 < len and _g_html.byte(_g_pos+2) == 91 and _g_html.byte(_g_pos+3) == 67 and _g_html.byte(_g_pos+4) == 68 and _g_html.byte(_g_pos+5) == 65 and _g_html.byte(_g_pos+6) == 84 and _g_html.byte(_g_pos+7) == 65 and _g_html.byte(_g_pos+8) == 91 {
                    // CDATA
                    _g_pos = _g_pos + 9
                    string cdata = ""
                    while _g_pos < len {
                        if _g_pos + 2 < len and _g_html.byte(_g_pos) == 93 and _g_html.byte(_g_pos+1) == 93 and _g_html.byte(_g_pos+2) == 62 {
                            _g_pos = _g_pos + 3
                            break
                        }
                        cdata = cdata + strings.char(_g_html.byte(_g_pos))
                        _g_pos = _g_pos + 1
                    }
                    if cdata != "" {
                        var textNode = {tag: "#text", attrs: {}, children: [], text: cdata}
                        var kidsRaw = root["children"]
                        if kidsRaw is Array {
                            kidsRaw.add(textNode)
                        }
                    }
                    continue
                }
                // 其他 <!...> 跳过
                _g_pos = _g_pos + 2
                while _g_pos < len and _g_html.byte(_g_pos) != 62 {
                    _g_pos = _g_pos + 1
                }
                if _g_pos < len and _g_html.byte(_g_pos) == 62 {
                    _g_pos = _g_pos + 1
                }
                continue
            }
            // 闭合标签（忽略孤立的）
            if _g_pos + 1 < len and _g_html.byte(_g_pos+1) == 47 {
                _g_pos = _g_pos + 2
                while _g_pos < len and _g_html.byte(_g_pos) != 62 {
                    _g_pos = _g_pos + 1
                }
                if _g_pos < len and _g_html.byte(_g_pos) == 62 {
                    _g_pos = _g_pos + 1
                }
                continue
            }
            var child = _parseElement()
            if child != null {
                var kidsRaw = root["children"]
                if kidsRaw is Array {
                    kidsRaw.add(child)
                }
            }
        } else {
            string text = _parseText()
            if text != "" {
                text = _decodeEntities(text)
                var textNode = {tag: "#text", attrs: {}, children: [], text: text}
                var kidsRaw = root["children"]
                if kidsRaw is Array {
                    kidsRaw.add(textNode)
                }
            }
        }
    }

    return root
}

// ==================== 便捷函数 ====================

export func tag(any node): string {
    if node is Dict {
        var v = node["tag"]
        if v is string {
            return v
        }
    }
    return ""
}

export func text(any node): string {
    if node is Dict {
        var v = node["text"]
        if v is string {
            return v
        }
    }
    return ""
}

export func allText(any node): string {
    if node == null {
        return ""
    }
    string result = ""
    if node is Dict {
        var t = node["tag"]
        if t is string {
            if t == "#text" {
                var txt = node["text"]
                if txt is string {
                    return txt
                }
            }
        }
        var kids = node["children"]
        if kids is Array {
            for kids to child {
                result = result + allText(child)
            }
        }
    }
    return result
}

// 清洗文本：合并连续空白（含换行）为单个空格，去首尾空白
export func cleanText(string raw): string {
    if raw == "" {
        return ""
    }
    string out = ""
    bool lastWasSpace = false
    int n = raw.len()
    for 0:n-1 to i {
        int b = raw.byte(i)
        if _isSpace(b) {
            if not lastWasSpace {
                out = out + " "
            }
            lastWasSpace = true
        } else {
            out = out + strings.char(b)
            lastWasSpace = false
        }
    }
    // 去首尾空白
    while out.len() > 0 and out.byte(0) == 32 {
        out = out.slice(1, out.len())
    }
    while out.len() > 0 and out.byte(out.len() - 1) == 32 {
        out = out.slice(0, out.len() - 1)
    }
    return out
}

// HTML 转可读纯文本（仿 html2text）：保留段落/标题/列表/换行结构
export func htmlToText(any node): string {
    if node == null {
        return ""
    }
    string result = ""
    if node is Dict {
        var t = node["tag"]
        string tag = ""
        if t is string {
            tag = t
        }
        // 文本节点
        if tag == "#text" {
            var txt = node["text"]
            if txt is string {
                return txt
            }
        }
        // 块级标签：段落前后加换行
        if tag == "p" or tag == "div" or tag == "section" or tag == "article" or tag == "header" or tag == "footer" {
            result = result + "\n"
        }
        // 标题：前后空行，加 # 标记
        if tag == "h1" {
            result = result + "\n# "
        } else if tag == "h2" {
            result = result + "\n## "
        } else if tag == "h3" {
            result = result + "\n### "
        } else if tag == "h4" or tag == "h5" or tag == "h6" {
            result = result + "\n#### "
        }
        // 列表项：前缀 "- "
        if tag == "li" {
            result = result + "- "
        }
        var kids = node["children"]
        if kids is Array {
            for kids to child {
                result = result + _toText(child)
            }
        }
        // 块级结束换行
        if tag == "p" or tag == "div" or tag == "li" or tag == "h1" or tag == "h2" or tag == "h3" or tag == "h4" or tag == "h5" or tag == "h6" {
            result = result + "\n"
        }
    }
    return result
}

func _toText(any node): string {
    if node == null {
        return ""
    }
    string result = ""
    if node is Dict {
        var t = node["tag"]
        string tag = ""
        if t is string {
            tag = t
        }
        if tag == "#text" {
            var txt = node["text"]
            if txt is string {
                return txt
            }
        }
        if tag == "br" {
            return "\n"
        }
        if tag == "p" or tag == "div" or tag == "section" or tag == "article" {
            result = result + "\n"
        }
        if tag == "h1" {
            result = result + "\n# "
        } else if tag == "h2" {
            result = result + "\n## "
        } else if tag == "h3" {
            result = result + "\n### "
        }
        if tag == "li" {
            result = result + "- "
        }
        var kids = node["children"]
        if kids is Array {
            for kids to child {
                result = result + _toText(child)
            }
        }
        if tag == "p" or tag == "div" or tag == "li" or tag == "h1" or tag == "h2" or tag == "h3" {
            result = result + "\n"
        }
    }
    return result
}

// 去除 HTML 字符串中的所有标签，只保留文本（不解析 DOM，纯字符串处理）
// 例："<p>Hi <b>there</b></p>" -> "Hi there"
export func stripTags(string html): string {
    string out = ""
    int n = html.len()
    bool inTag = false
    for 0:n-1 to i {
        int b = html.byte(i)
        if b == 60 {
            // <
            inTag = true
        } else if b == 62 {
            // >
            inTag = false
        } else {
            if not inTag {
                out = out + strings.char(b)
            }
        }
    }
    return cleanText(out)
}

// 提取节点内所有文本（去标签、合并空白），等价于 allText + cleanText
export func textContent(any node): string {
    return cleanText(allText(node))
}

// 提取 HTML 中第一个表格为二维数组（每行=一行，每格=cleanText 后的文本）
export func extractTable(any root): Array[Array[string]] {
    var tables = select(root, "table")
    Array[Array[string]] tableData = []
    if tables is Array and tables.len() > 0 {
        var tbl = tables[0]
        var rows = select(tbl, "tr")
        if rows is Array {
            for rows to tr {
                // 该行的所有单元格（td + th）
                var cells = select(tr, "td")
                var thCells = select(tr, "th")
                Array[string] rowData = []
                if cells is Array {
                    for cells to td {
                        rowData.add(cleanText(allText(td)))
                    }
                }
                if thCells is Array {
                    for thCells to th {
                        rowData.add(cleanText(allText(th)))
                    }
                }
                tableData.add(rowData)
            }
        }
    }
    return tableData
}

export func attr(any node, string name): string {
    if node is Dict {
        var a = node["attrs"]
        if a is Dict[string, string] {
            var v = a[name]
            if v is string {
                return _decodeEntities(v)
            }
        }
    }
    return ""
}

export func children(any node): Array {
    if node is Dict {
        var kids = node["children"]
        if kids is Array {
            return kids
        }
    }
    return []
}

export func getLinks(string html): Array[string] {
    var root = parse(html)
    var links = []
    _collectLinks(root, links)
    return links
}

// 提取 HTML 的 <title> 文本（不存在返回空串）
export func getTitle(any root): string {
    var titles = select(root, "title")
    if titles is Array and titles.len() > 0 {
        return cleanText(allText(titles[0]))
    }
    return ""
}

// 提取 HTML 中 <meta> 标签的属性值（按 name 或 property 匹配，取 content 属性）
export func getMeta(any root, string name): string {
    var metas = select(root, "meta")
    if metas is Array {
        for metas to m {
            string mname = attr(m, "name")
            if mname == "" {
                mname = attr(m, "property")
            }
            if mname == name {
                return attr(m, "content")
            }
        }
    }
    return ""
}

// 提取 HTML 中所有 <meta> 标签为 Dict（name/property -> content）
export func getMetas(any root): Dict {
    var result = {}
    var metas = select(root, "meta")
    if metas is Array {
        for metas to m {
            string mname = attr(m, "name")
            if mname == "" {
                mname = attr(m, "property")
            }
            if mname != "" {
                result[mname] = attr(m, "content")
            }
        }
    }
    return result
}

// 从 DOM 中删除所有匹配 selector 的元素（修改传入的 root），返回删除个数
export func removeElement(any root, string selector): int {
    var sels = _splitSelector(selector)
    if sels.len() == 0 {
        return 0
    }
    return _removeRec(root, sels)
}

func _removeRec(any node, Array sels): int {
    if node == null {
        return 0
    }
    int removed = 0
    if node is Dict {
        var kids = node["children"]
        if kids is Array {
            Array keep = []
            Dict sel = sels[0] as Dict
            for kids to child {
                if _matchSimple(child, sel) {
                    removed = removed + 1
                } else {
                    keep.add(child)
                    removed = removed + _removeRec(child, sels)
                }
            }
            node["children"] = keep
        }
    }
    return removed
}

// 提取 HTML 中表单字段为 Dict（name -> value），仿 BeautifulSoup 表单解析
// 支持 input/select/textarea，取 name 属性和 value/文本
export func extractForm(any root): Dict {
    var result = {}
    var inputs = select(root, "input")
    if inputs is Array {
        for inputs to inp {
            string iname = attr(inp, "name")
            if iname != "" {
                string val = attr(inp, "value")
                if val == "" and attr(inp, "type") == "checkbox" {
                    if attr(inp, "checked") != "" {
                        val = "on"
                    }
                }
                result[iname] = val
            }
        }
    }
    var selects = select(root, "select")
    if selects is Array {
        for selects to sel {
            string sname = attr(sel, "name")
            if sname != "" {
                // 找选中的 option
                var options = select(sel, "option")
                string selVal = ""
                if options is Array {
                    for options to opt {
                        if attr(opt, "selected") != "" {
                            selVal = cleanText(allText(opt))
                            break
                        }
                    }
                }
                result[sname] = selVal
            }
        }
    }
    var textareas = select(root, "textarea")
    if textareas is Array {
        for textareas to ta {
            string taname = attr(ta, "name")
            if taname != "" {
                result[taname] = cleanText(allText(ta))
            }
        }
    }
    return result
}

// ==================== 便捷查询 API（仿 BeautifulSoup） ====================

// 按 id 查找节点，返回第一个匹配或 null
export func getElementById(any root, string id): any {
    if id == "" {
        return null
    }
    var parts = _splitSelector("#" + id)
    if parts.len() == 0 {
        return null
    }
    var current = [root]
    for 0:parts.len()-1 to pi {
        Dict p0 = parts[pi]
        var next = []
        for current to node {
            _findDescendants(node, p0, next)
        }
        current = next
    }
    if current.len() > 0 {
        return current[0]
    }
    return null
}

// 按标签名查找所有节点
export func getElementsByTag(any root, string tagName): Array[any] {
    return select(root, tagName)
}

// 按 class 名查找所有节点
export func getElementsByClass(any root, string className): Array[any] {
    if className == "" {
        return []
    }
    return select(root, "." + className)
}

// 通用查找：可按 tag/class/id 组合过滤（均为可选，传空串表示不过滤）
export func findAll(any root, string tagName, string className, string idName): Array[any] {
    var all = []
    _findAllRec(root, tagName, className, idName, all)
    return all
}

func _findAllRec(any node, string tagName, string className, string idName, Array results) {
    if node == null {
        return
    }
    if node is Dict {
        var matched = true
        if tagName != "" {
            var t = node["tag"]
            if t is string {
                if t != tagName {
                    matched = false
                }
            } else {
                matched = false
            }
        }
        if matched and className != "" {
            var cls = attr(node, "class")
            if not _hasWord(cls, className) {
                matched = false
            }
        }
        if matched and idName != "" {
            var idv = attr(node, "id")
            if idv != idName {
                matched = false
            }
        }
        if matched {
            results.add(node)
        }
        var kids = node["children"]
        if kids is Array {
            for kids to child {
                _findAllRec(child, tagName, className, idName, results)
            }
        }
    }
}

func _collectLinks(any node, Array links) {
    if node == null {
        return
    }
    if node is Dict {
        var t = node["tag"]
        if t is string {
            if t == "a" {
                var a = node["attrs"]
                if a is Dict[string, string] {
                    var href = a["href"]
                    if href != "" {
                        links.add(href)
                    }
                }
            }
        }
        var kids = node["children"]
        if kids is Array {
            for kids to child {
                _collectLinks(child, links)
            }
        }
    }
}

// ==================== CSS 选择器 ====================

func _parseSimple(string selector): Dict {
    var r = {tag: "", id: "", classes: [], attrName: "", attrValue: "", attrOp: "=", hasAttr: false, pseudo: ""}
    int i = 0
    int slen = selector.len()

    while i < slen {
        int b = selector.byte(i)
        if _isAlphaNum(b) or b == 42 or b == 45 or b == 95 {
            var tagRaw = r["tag"]
            if tagRaw is string {
                r["tag"] = tagRaw + strings.char(b)
            }
            i = i + 1
        } else {
            break
        }
    }

    while i < slen {
        int b = selector.byte(i)
        if b == 46 {
            i = i + 1
            string cls = ""
            while i < slen {
                int ch = selector.byte(i)
                if ch == 46 or ch == 35 or ch == 91 or ch == 58 {
                    break
                }
                cls = cls + strings.char(ch)
                i = i + 1
            }
            var classesRaw = r["classes"]
            if classesRaw is Array {
                classesRaw.add(cls)
            }
        } else if b == 35 {
            i = i + 1
            string idVal = ""
            while i < slen {
                int ch = selector.byte(i)
                if ch == 46 or ch == 35 or ch == 91 or ch == 58 {
                    break
                }
                idVal = idVal + strings.char(ch)
                i = i + 1
            }
            r["id"] = idVal
        } else if b == 91 {
            i = i + 1
            string attrName = ""
            while i < slen {
                int ch = selector.byte(i)
                if ch == 61 or ch == 94 or ch == 36 or ch == 42 or ch == 93 {
                    break
                }
                attrName = attrName + strings.char(ch)
                i = i + 1
            }
            r["attrName"] = attrName
            r["hasAttr"] = true
            r["attrOp"] = "="
            if i < slen {
                int op = selector.byte(i)
                if op == 61 {
                    // =
                    i = i + 1
                } else if op == 94 and i + 1 < slen and selector.byte(i + 1) == 61 {
                    // ^=
                    r["attrOp"] = "^="
                    i = i + 2
                } else if op == 36 and i + 1 < slen and selector.byte(i + 1) == 61 {
                    // $=
                    r["attrOp"] = "$="
                    i = i + 2
                } else if op == 42 and i + 1 < slen and selector.byte(i + 1) == 61 {
                    // *=
                    r["attrOp"] = "*="
                    i = i + 2
                }
                if i <= slen and i - 1 < slen {
                    // 读取属性值（到 ] 为止）
                    string attrVal = ""
                    while i < slen {
                        int ch = selector.byte(i)
                        if ch == 93 {
                            break
                        }
                        attrVal = attrVal + strings.char(ch)
                        i = i + 1
                    }
                    r["attrValue"] = attrVal
                }
            }
            if i < slen and selector.byte(i) == 93 {
                i = i + 1
            }
        } else if b == 58 {
            // 伪类 :first-child / :last-child / :nth-child(n) / :only-child
            i = i + 1
            string pseudo = ""
            while i < slen {
                int ch = selector.byte(i)
                if ch == 40 or ch == 46 or ch == 35 or ch == 91 or ch == 58 or ch == 62 {
                    break
                }
                pseudo = pseudo + strings.char(ch)
                i = i + 1
            }
            r["pseudo"] = pseudo
            if i < slen and selector.byte(i) == 40 {
                // nth-child(n)
                i = i + 1
                string arg = ""
                while i < slen {
                    int ch = selector.byte(i)
                    if ch == 41 {
                        break
                    }
                    arg = arg + strings.char(ch)
                    i = i + 1
                }
                if i < slen and selector.byte(i) == 41 {
                    i = i + 1
                }
                r["pseudoArg"] = arg
            }
        } else {
            break
        }
    }

    return r
}

func _splitSelector(string selector): Array[Dict] {
    Array[Dict] parts = []
    string current = ""
    int i = 0
    int slen = selector.len()
    bool lastWasChild = false

    while i < slen {
        int b = selector.byte(i)
        if b == 62 {
            if current != "" {
                Dict parsed = _parseSimple(current)
                parsed["isChild"] = false
                parts.add(parsed)
                current = ""
            }
            lastWasChild = true
            i = i + 1
        } else if _isSpace(b) {
            if current != "" {
                Dict parsed = _parseSimple(current)
                parsed["isChild"] = lastWasChild
                parts.add(parsed)
                current = ""
                lastWasChild = false
            }
            i = i + 1
        } else {
            current = current + strings.char(b)
            i = i + 1
        }
    }

    if current != "" {
        Dict parsed = _parseSimple(current)
        parsed["isChild"] = lastWasChild
        parts.add(parsed)
    }

    return parts
}

func _hasWord(string str, string word): bool {
    if str == "" or word == "" {
        return false
    }
    int i = 0
    int slen = str.len()
    while i < slen {
        while i < slen and _isSpace(str.byte(i)) {
            i = i + 1
        }
        string w = ""
        while i < slen {
            int b = str.byte(i)
            if _isSpace(b) {
                break
            }
            w = w + strings.char(b)
            i = i + 1
        }
        if w == word {
            return true
        }
    }
    return false
}

// 检查伪类匹配：node 是兄弟中第 idx 个（0 起），total 为兄弟总数
func _matchPseudo(any node, Dict sel, int idx, int total): bool {
    var p = sel["pseudo"]
    if not (p is string) {
        return true
    }
    if p == "" {
        return true
    }
    if p == "first-child" {
        return idx == 0
    } else if p == "last-child" {
        return idx == total - 1
    } else if p == "only-child" {
        return total == 1
    } else if p == "nth-child" {
        var arg = sel["pseudoArg"]
        if arg is string {
            int n = _int(arg)
            if n > 0 {
                return idx == n - 1
            }
        }
        return false
    }
    return true
}

func _matchSimple(any node, Dict sel): bool {
    if node == null {
        return false
    }
    if node is Dict {
        var tagVal = sel["tag"]
        if tagVal is string {
            if tagVal != "" and tagVal != "*" {
                var nt = node["tag"]
                if nt is string {
                    if nt != tagVal {
                        return false
                    }
                } else {
                    return false
                }
            }
        }

        var idVal = sel["id"]
        if idVal is string {
            if idVal != "" {
                var a = node["attrs"]
                if a is Dict {
                    var nodeId = a["id"]
                    if nodeId is string {
                        if nodeId != idVal {
                            return false
                        }
                    } else {
                        return false
                    }
                } else {
                    return false
                }
            }
        }

        var classesRaw = sel["classes"]
        if classesRaw is Array {
            var nodeAttrs = node["attrs"]
            if nodeAttrs is Dict {
                var nodeClass = nodeAttrs["class"]
                if nodeClass is string {
                    for classesRaw to cls {
                        if cls is string {
                            if not _hasWord(nodeClass, cls) {
                                return false
                            }
                        }
                    }
                } else {
                    if classesRaw.len() > 0 {
                        return false
                    }
                }
            }
        }

        var hasAttr = sel["hasAttr"]
        if hasAttr is bool {
            if hasAttr {
                var attrName = sel["attrName"]
                if attrName is string {
                    if attrName != "" {
                        var nodeAttrs = node["attrs"]
                        if nodeAttrs is Dict {
                            var nodeAttrVal = nodeAttrs[attrName]
                            var selAttrVal = sel["attrValue"]
                            var attrOp = sel["attrOp"]
                            if attrOp is string {
                                if selAttrVal is string {
                                    if selAttrVal != "" {
                                        if nodeAttrVal is string {
                                            var actual = nodeAttrVal
                                            if attrOp == "=" {
                                                if actual != selAttrVal {
                                                    return false
                                                }
                                            } else if attrOp == "^=" {
                                                // 前缀匹配
                                                if not actual.starts_with(selAttrVal) {
                                                    return false
                                                }
                                            } else if attrOp == "$=" {
                                                // 后缀匹配
                                                if not actual.ends_with(selAttrVal) {
                                                    return false
                                                }
                                            } else if attrOp == "*=" {
                                                // 包含匹配
                                                if not actual.has(selAttrVal) {
                                                    return false
                                                }
                                            } else {
                                                if actual != selAttrVal {
                                                    return false
                                                }
                                            }
                                        } else {
                                            return false
                                        }
                                    }
                                }
                            }
                        } else {
                            return false
                        }
                    }
                }
            }
        }

        return true
    }
    return false
}

func _findDescendants(any node, Dict sel, Array results) {
    if node == null {
        return
    }
    if node is Dict[string,Array] {
        var kids = node["children"]
        if kids is Array {
            int total = kids.len()
            for 0:total-1 to i {
                var child = kids[i]
                if _matchSimple(child, sel) and _matchPseudo(child, sel, i, total) {
                    results.add(child)
                }
                _findDescendants(child, sel, results)
            }
        }
    }
}

func _findDirectChildren(any node, Dict sel, Array results) {
    if node == null {
        return
    }
    if node is Dict[string,Array] {
        var kids = node["children"]
        if kids is Array {
            int total = kids.len()
            for 0:total-1 to i {
                var child = kids[i]
                if _matchSimple(child, sel) and _matchPseudo(child, sel, i, total) {
                    results.add(child)
                }
            }
        }
    }
}

export func select(any root, string selector): Array[any] {
    var parts = _splitSelector(selector)
    if parts.len() == 0 {
        return []
    }

    var current = [root]
    int partsLen = parts.len()
    for 0:partsLen-1 to pi {
        Dict p0 = parts[pi]
        var next = []
        for current to node {
            var isChildVal = p0["isChild"]
            if isChildVal is bool {
                if isChildVal {
                    _findDirectChildren(node, p0, next)
                } else {
                    _findDescendants(node, p0, next)
                }
            } else {
                _findDescendants(node, p0, next)
            }
        }
        current = next
    }

    return current
}

export func selectOne(any root, string selector): any {
    var results = select(root, selector)
    if results.len() > 0 {
        return results[0]
    }
    return null
}
