// web_html.leno — LenoWeb HTML 解析器（纯 Leno 实现）
// 使用模块级全局变量管理解析状态
// 使用泛型类型 Array[string]/Dict[string,string] 提高类型安全性
// 支持：HTML 实体解码、DOCTYPE、CDATA、容错解析

import strings

// ==================== HtmlNode 结构 ====================
// 强类型 DOM 节点，替代旧的 Dict 表示
// tag 取值：普通元素为标签名(小写)；文本节点为 "#text"；文档根为 "#document"

export struct HtmlNode {
    string tag
    Dict[string, string] attrs
    Array[HtmlNode] children
    string text

    // 获取属性值（不存在返回空串）
    func attr(string name): string {
        return attrs.get(name, "")
    }

    // 判断是否有指定属性
    func hasAttr(string name): bool {
        return attrs.has(name)
    }

    // 直接文本内容（不含子节点）
    func text(): string {
        return text
    }

    // 是否文本节点
    func isTextNode(): bool {
        return tag == "#text"
    }

    // 是否元素节点（非文本/非文档根）
    func isElement(): bool {
        return tag != "#text" and tag != "#document"
    }

    // 标签名
    func tagName(): string {
        return tag
    }

    // 获取 class 列表
    func classes(): Array[string] {
        string c = attrs.get("class", "")
        Array[string] result = []
        if c == "" { return result }
        Array segs = c.split(" ")
        for segs.len() to i {
            if segs[i] != "" { result.add(segs[i]) }
        }
        return result
    }

    // 是否包含某 class
    func hasClass(string name): bool {
        Array cl = classes()
        for cl.len() to i {
            if cl[i] == name { return true }
        }
        return false
    }

    // 子节点数
    func childCount(): int {
        return children.len()
    }

    // 按选择器查询子元素（后代）
    func select(string selector): Array[HtmlNode] {
        Array parts = _splitSelector(selector)
        if parts.len() == 0 { return [] }
        Array[HtmlNode] current = [self]
        int partsLen = parts.len()
        for 0:partsLen-1 to pi {
            Dict p0 = parts[pi]
            Array[HtmlNode] next = []
            for current.len() to ci {
                HtmlNode node = current[ci]
                var isChildVal = p0["isChild"]
                if isChildVal is bool {
                    if isChildVal {
                        _findDirectChildren(node, p0, next)
                    } else {
                        _findDescendants(node, p0, next)
                    }
                } else {
                    _findDescendants(node, p0, next)
                }
            }
            current = next
        }
        return current
    }

    // 查询第一个匹配
    func selectOne(string selector): HtmlNode? {
        Array[HtmlNode] r = select(selector)
        if r.len() > 0 { return r[0] }
        return null
    }

    // 深度优先文本拼接
    func allText(): string {
        return _collectText(self)
    }

    // 移除匹配选择器的子节点，返回移除数量
    func remove(string selector): int {
        return removeElement(self, selector)
    }
}

// ==================== 模块级全局状态 ====================

var _g_pos = 0
var _g_html = ""

// ==================== 辅助函数 ====================

func _isAlpha(int b): bool {
    return (b >= 97 and b <= 122) or (b >= 65 and b <= 90)
}

func _isAlphaNum(int b): bool {
    return (b >= 97 and b <= 122) or (b >= 65 and b <= 90) or (b >= 48 and b <= 57)
}

func _isSpace(int b): bool {
    return b == 32 or b == 9 or b == 10 or b == 13
}

// ==================== 解析器 ====================

func _parseTagName(): string {
    string tag = ""
    while _g_pos < _g_html.len(){
        int b = _g_html.byte(_g_pos)
        if _isAlphaNum(b) or b == 45 or b == 95 {
            tag = tag + strings.char(b)
            _g_pos = _g_pos + 1
        } else {
            break
        }
    }
    return tag
}

func _skipWs() {
    while _g_pos <  _g_html.len() {
        int b = _g_html.byte(_g_pos)
        if _isSpace(b) {
            _g_pos = _g_pos + 1
        } else {
            break
        }
    }
}

func _parseAttrs(): Dict[string, string] {
    Dict[string, string] attrs = {}
    int len = _g_html.len()
    while _g_pos < len {
        while _g_pos < len and _isSpace(_g_html.byte(_g_pos)) {
            _g_pos = _g_pos + 1
        }
        if _g_pos >= len {
            break
        }
        int b = _g_html.byte(_g_pos)
        if b == 62 or b == 47 {
            break
        }
        // 跳过非法字符
        if b == 60 or b == 38 {
            _g_pos = _g_pos + 1
            continue
        }
        string name = ""
        while _g_pos < len {
            int ch = _g_html.byte(_g_pos)
            if _isSpace(ch) or ch == 61 or ch == 62 or ch == 47 or ch == 60 or ch == 38 {
                break
            }
            name = name + strings.char(ch)
            _g_pos = _g_pos + 1
        }
        if name == "" {
            _g_pos = _g_pos + 1
            continue
        }
        // 属性名转小写
        name = name.to_lower()
        while _g_pos < len and _isSpace(_g_html.byte(_g_pos)) {
            _g_pos = _g_pos + 1
        }
        string val = ""
        if _g_pos < len and _g_html.byte(_g_pos) == 61 {
            _g_pos = _g_pos + 1
            while _g_pos < len and _isSpace(_g_html.byte(_g_pos)) {
                _g_pos = _g_pos + 1
            }
            int q = -1
            if _g_pos < len {
                q = _g_html.byte(_g_pos)
            }
            if q == 34 or q == 39 {
                _g_pos = _g_pos + 1
                while _g_pos < len {
                    int ch = _g_html.byte(_g_pos)
                    if ch == q {
                        _g_pos = _g_pos + 1
                        break
                    }
                    val = val + strings.char(ch)
                    _g_pos = _g_pos + 1
                }
            } else {
                // 无引号属性值
                while _g_pos < len {
                    int ch = _g_html.byte(_g_pos)
                    if _isSpace(ch) or ch == 62 or ch == 47 {
                        break
                    }
                    val = val + strings.char(ch)
                    _g_pos = _g_pos + 1
                }
            }
        } else {
            // 布尔属性：checked, disabled, selected 等
            // HTML 中布尔属性存在即表示 true，值设为属性名本身
            val = name
        }
        attrs[name] = val
    }
    return attrs
}

func _parseText(): string {
    string text = ""
    int len = _g_html.len()
    while _g_pos < len {
        int b = _g_html.byte(_g_pos)
        if b == 60 {
            break
        }
        text = text + strings.char(b)
        _g_pos = _g_pos + 1
    }
    return text
}

// 判断是否为 void 标签（不需要闭合标签）
func _isVoidTag(string tagName): bool {
    return tagName == "br" or tagName == "hr" or tagName == "img" or
           tagName == "input" or tagName == "meta" or tagName == "link" or
           tagName == "area" or tagName == "base" or tagName == "col" or
           tagName == "embed" or tagName == "source" or tagName == "track" or
           tagName == "wbr"
}

// ==================== HTML 实体解码 ====================

func _namedEntity(string name): string {
    switch name {
        case "amp" { return "&" }
        case "lt" { return "<" }
        case "gt" { return ">" }
        case "quot" { return "\"" }
        case "apos" { return "'" }
        case "nbsp" { return " " }
        case "copy" { return "©" }
        case "reg" { return "®" }
        case "trade" { return "™" }
        case "hellip" { return "…" }
        case "mdash" { return "—" }
        case "ndash" { return "–" }
        case "laquo" { return "«" }
        case "raquo" { return "»" }
        case "ldquo" { return "\u201C" }
        case "rdquo" { return "\u201D" }
        case "lsquo" { return "‘" }
        case "rsquo" { return "’" }
        case "bull" { return "•" }
        case "middot" { return "·" }
        case "deg" { return "°" }
        case "plusmn" { return "±" }
        case "times" { return "×" }
        case "divide" { return "÷" }
        case "frac14" { return "¼" }
        case "frac12" { return "½" }
        case "frac34" { return "¾" }
        default { return "" }
    }
}

func _hexDigit(int ch): int {
    if ch >= 48 and ch <= 57 { return ch - 48 }
    if ch >= 65 and ch <= 70 { return ch - 55 }
    if ch >= 97 and ch <= 102 { return ch - 87 }
    return -1
}

func _codepointToUtf8(int cp): string {
    if cp <= 127 {
        return strings.char(cp)
    }
    if cp <= 2047 {
        int b1 = 192 + (cp / 64)
        int b2 = 128 + (cp % 64)
        return strings.char(b1) + strings.char(b2)
    }
    if cp <= 65535 {
        int b1 = 224 + (cp / 4096)
        int b2 = 128 + ((cp / 64) % 64)
        int b3 = 128 + (cp % 64)
        return strings.char(b1) + strings.char(b2) + strings.char(b3)
    }
    int b1 = 240 + (cp / 262144)
    int b2 = 128 + ((cp / 4096) % 64)
    int b3 = 128 + ((cp / 64) % 64)
    int b4 = 128 + (cp % 64)
    return strings.char(b1) + strings.char(b2) + strings.char(b3) + strings.char(b4)
}

func _decodeEntities(string text): string {
    string result = ""
    int i = 0
    int len = text.len()
    while i < len {
        int b = text.byte(i)
        if b == 38 {
            int savePos = i
            i = i + 1
            if i < len and text.byte(i) == 35 {
                i = i + 1
                int codepoint = 0
                if i < len and (text.byte(i) == 120 or text.byte(i) == 88) {
                    i = i + 1
                    while i < len {
                        int ch = text.byte(i)
                        if ch == 59 {
                            i = i + 1
                            break
                        }
                        int d = _hexDigit(ch)
                        if d < 0 { break }
                        codepoint = codepoint * 16 + d
                        i = i + 1
                    }
                } else {
                    while i < len {
                        int ch = text.byte(i)
                        if ch == 59 {
                            i = i + 1
                            break
                        }
                        if ch >= 48 and ch <= 57 {
                            codepoint = codepoint * 10 + (ch - 48)
                            i = i + 1
                        } else {
                            break
                        }
                    }
                }
                if codepoint > 0 and codepoint <= 1114111 {
                    result = result + _codepointToUtf8(codepoint)
                } else {
                    i = savePos + 1
                    result = result + strings.char(38)
                }
            } else {
                string name = ""
                while i < len {
                    int ch = text.byte(i)
                    if ch == 59 {
                        i = i + 1
                        break
                    }
                    if ch == 38 or _isSpace(ch) or ch == 60 or ch == 62 {
                        break
                    }
                    name = name + strings.char(ch)
                    i = i + 1
                }
                string decoded = _namedEntity(name)
                if decoded != "" {
                    result = result + decoded
                } else {
                    i = savePos + 1
                    result = result + strings.char(38)
                }
            }
        } else {
            result = result + strings.char(b)
            i = i + 1
        }
    }
    return result
}

// ==================== 元素解析 ====================

// 内部节点工厂：创建 HtmlNode
func _makeNode(string tag, Dict[string, string] attrs, Array[HtmlNode] children, string text): HtmlNode {
    HtmlNode n = new HtmlNode()
    n.tag = tag
    n.attrs = attrs
    n.children = children
    n.text = text
    return n
}

func _parseElement(): HtmlNode? {
    int len = _g_html.len()
    if _g_pos >= len {
        return null
    }
    if _g_html.byte(_g_pos) != 60 {
        return null
    }

    // 注释 <!-- ... -->
    if _g_pos + 3 < len and _g_html.byte(_g_pos+1) == 33 and _g_html.byte(_g_pos+2) == 45 and _g_html.byte(_g_pos+3) == 45 {
        _g_pos = _g_pos + 4
        while _g_pos < len {
            if _g_html.byte(_g_pos) == 45 and _g_pos+2 < len and _g_html.byte(_g_pos+1) == 45 and _g_html.byte(_g_pos+2) == 62 {
                _g_pos = _g_pos + 3
                break
            }
            _g_pos = _g_pos + 1
        }
        return null
    }

    // CDATA <![CDATA[ ... ]]>
    if _g_pos + 8 < len and _g_html.byte(_g_pos+1) == 33 and _g_html.byte(_g_pos+2) == 91 and _g_html.byte(_g_pos+3) == 67 and _g_html.byte(_g_pos+4) == 68 and _g_html.byte(_g_pos+5) == 65 and _g_html.byte(_g_pos+6) == 84 and _g_html.byte(_g_pos+7) == 65 and _g_html.byte(_g_pos+8) == 91 {
        _g_pos = _g_pos + 9
        string cdata = ""
        while _g_pos < len {
            if _g_pos + 2 < len and _g_html.byte(_g_pos) == 93 and _g_html.byte(_g_pos+1) == 93 and _g_html.byte(_g_pos+2) == 62 {
                _g_pos = _g_pos + 3
                break
            }
            cdata = cdata + strings.char(_g_html.byte(_g_pos))
            _g_pos = _g_pos + 1
        }
        return _makeNode("#text", {}, [], cdata)
    }

    // DOCTYPE / 其他声明 <!...>
    if _g_pos + 1 < len and _g_html.byte(_g_pos+1) == 33 {
        _g_pos = _g_pos + 2
        while _g_pos < len and _g_html.byte(_g_pos) != 62 {
            _g_pos = _g_pos + 1
        }
        if _g_pos < len and _g_html.byte(_g_pos) == 62 {
            _g_pos = _g_pos + 1
        }
        return null
    }

    // 闭合标签 </...>
    if _g_pos + 1 < len and _g_html.byte(_g_pos+1) == 47 {
        return null
    }

    _g_pos = _g_pos + 1

    string tagName = _parseTagName()
    if tagName == "" {
        return null
    }
    tagName = strings.to_lower(tagName)

    Dict[string, string] attrs = _parseAttrs()

    bool selfClosing = false
    if _g_pos < len and _g_html.byte(_g_pos) == 47 {
        selfClosing = true
        _g_pos = _g_pos + 1
    }
    if _g_pos < len and _g_html.byte(_g_pos) == 62 {
        _g_pos = _g_pos + 1
    }

    if selfClosing {
        return _makeNode(tagName, attrs, [], "")
    }

    if _isVoidTag(tagName) {
        return _makeNode(tagName, attrs, [], "")
    }

    // script/style 标签：原始内容直接读取
    if tagName == "script" or tagName == "style" {
        string rawContent = ""
        while _g_pos < len {
            if _g_html.byte(_g_pos) == 60 and _g_pos+1 < len and _g_html.byte(_g_pos+1) == 47 {
                int savePos = _g_pos
                _g_pos = _g_pos + 2
                string closeTag = _parseTagName()
                closeTag = strings.to_lower(closeTag)
                if closeTag == tagName {
                    _parseAttrs()
                    if _g_pos < len and _g_html.byte(_g_pos) == 62 {
                        _g_pos = _g_pos + 1
                    }
                    return _makeNode(tagName, attrs, [], rawContent)
                } else {
                    _g_pos = savePos
                    rawContent = rawContent + strings.char(_g_html.byte(_g_pos))
                    _g_pos = _g_pos + 1
                }
            } else {
                rawContent = rawContent + strings.char(_g_html.byte(_g_pos))
                _g_pos = _g_pos + 1
            }
        }
        return _makeNode(tagName, attrs, [], rawContent)
    }

    // 普通标签
    Array[HtmlNode] children = []
    string textContent = ""

    while _g_pos < len {
        if _g_html.byte(_g_pos) == 60 {
            if _g_pos + 3 < len and _g_html.byte(_g_pos+1) == 33 and _g_html.byte(_g_pos+2) == 45 and _g_html.byte(_g_pos+3) == 45 {
                _g_pos = _g_pos + 4
                while _g_pos < len {
                    if _g_html.byte(_g_pos) == 45 and _g_pos+2 < len and _g_html.byte(_g_pos+1) == 45 and _g_html.byte(_g_pos+2) == 62 {
                        _g_pos = _g_pos + 3
                        break
                    }
                    _g_pos = _g_pos + 1
                }
                continue
            }
            // CDATA in body
            if _g_pos + 8 < len and _g_html.byte(_g_pos+1) == 33 and _g_html.byte(_g_pos+2) == 91 and _g_html.byte(_g_pos+3) == 67 and _g_html.byte(_g_pos+4) == 68 and _g_html.byte(_g_pos+5) == 65 and _g_html.byte(_g_pos+6) == 84 and _g_html.byte(_g_pos+7) == 65 and _g_html.byte(_g_pos+8) == 91 {
                _g_pos = _g_pos + 9
                string cdata = ""
                while _g_pos < len {
                    if _g_pos + 2 < len and _g_html.byte(_g_pos) == 93 and _g_html.byte(_g_pos+1) == 93 and _g_html.byte(_g_pos+2) == 62 {
                        _g_pos = _g_pos + 3
                        break
                    }
                    cdata = cdata + strings.char(_g_html.byte(_g_pos))
                    _g_pos = _g_pos + 1
                }
                if cdata != "" {
                    textContent = textContent + cdata
                    children.add(_makeNode("#text", {}, [], cdata))
                }
                continue
            }
            if _g_pos + 1 < len and _g_html.byte(_g_pos+1) == 47 {
                _g_pos = _g_pos + 2
                _parseTagName()
                while _g_pos < len and _g_html.byte(_g_pos) != 62 {
                    _g_pos = _g_pos + 1
                }
                if _g_pos < len and _g_html.byte(_g_pos) == 62 {
                    _g_pos = _g_pos + 1
                }
                break
            }
            HtmlNode? childOpt = _parseElement()
            if childOpt != null {
                children.add(childOpt as HtmlNode)
            }
        } else {
            string text = _parseText()
            if text != "" {
                text = _decodeEntities(text)
                textContent = textContent + text
                children.add(_makeNode("#text", {}, [], text))
            }
        }
    }

    return _makeNode(tagName, attrs, children, textContent)
}

// ==================== 对外接口 ====================

export func parse(string html): HtmlNode {
    _g_html = html
    _g_pos = 0

    HtmlNode root = _makeNode("#document", {}, [], "")
    int len = _g_html.len()

    while _g_pos < len {
        while _g_pos < len and _isSpace(_g_html.byte(_g_pos)) {
            _g_pos = _g_pos + 1
        }
        if _g_pos >= len {
            break
        }
        if _g_html.byte(_g_pos) == 60 {
            // 注释
            if _g_pos + 3 < len and _g_html.byte(_g_pos+1) == 33 and _g_html.byte(_g_pos+2) == 45 and _g_html.byte(_g_pos+3) == 45 {
                _g_pos = _g_pos + 4
                while _g_pos < len {
                    if _g_html.byte(_g_pos) == 45 and _g_pos+2 < len and _g_html.byte(_g_pos+1) == 45 and _g_html.byte(_g_pos+2) == 62 {
                        _g_pos = _g_pos + 3
                        break
                    }
                    _g_pos = _g_pos + 1
                }
                continue
            }
            // DOCTYPE / CDATA / 其他声明
            if _g_pos + 1 < len and _g_html.byte(_g_pos+1) == 33 {
                if _g_pos + 8 < len and _g_html.byte(_g_pos+2) == 91 and _g_html.byte(_g_pos+3) == 67 and _g_html.byte(_g_pos+4) == 68 and _g_html.byte(_g_pos+5) == 65 and _g_html.byte(_g_pos+6) == 84 and _g_html.byte(_g_pos+7) == 65 and _g_html.byte(_g_pos+8) == 91 {
                    // CDATA
                    _g_pos = _g_pos + 9
                    string cdata = ""
                    while _g_pos < len {
                        if _g_pos + 2 < len and _g_html.byte(_g_pos) == 93 and _g_html.byte(_g_pos+1) == 93 and _g_html.byte(_g_pos+2) == 62 {
                            _g_pos = _g_pos + 3
                            break
                        }
                        cdata = cdata + strings.char(_g_html.byte(_g_pos))
                        _g_pos = _g_pos + 1
                    }
                    if cdata != "" {
                        root.children.add(_makeNode("#text", {}, [], cdata))
                    }
                    continue
                }
                // 其他 <!...> 跳过
                _g_pos = _g_pos + 2
                while _g_pos < len and _g_html.byte(_g_pos) != 62 {
                    _g_pos = _g_pos + 1
                }
                if _g_pos < len and _g_html.byte(_g_pos) == 62 {
                    _g_pos = _g_pos + 1
                }
                continue
            }
            // 闭合标签（忽略孤立的）
            if _g_pos + 1 < len and _g_html.byte(_g_pos+1) == 47 {
                _g_pos = _g_pos + 2
                while _g_pos < len and _g_html.byte(_g_pos) != 62 {
                    _g_pos = _g_pos + 1
                }
                if _g_pos < len and _g_html.byte(_g_pos) == 62 {
                    _g_pos = _g_pos + 1
                }
                continue
            }
            HtmlNode? childOpt = _parseElement()
            if childOpt != null {
                root.children.add(childOpt as HtmlNode)
            }
        } else {
            string text = _parseText()
            if text != "" {
                text = _decodeEntities(text)
                root.children.add(_makeNode("#text", {}, [], text))
            }
        }
    }

    return root
}

// ==================== 便捷函数 ====================

export func tag(HtmlNode node): string {
    return node.tag
}

export func text(HtmlNode node): string {
    return node.text
}

export func allText(HtmlNode node): string {
    return _collectText(node)
}

// 内部：深度优先收集文本
func _collectText(HtmlNode node): string {
    string result = ""
    if node.tag == "#text" {
        return node.text
    }
    for node.children.len() to i {
        result = result + _collectText(node.children[i])
    }
    return result
}

// 清洗文本：合并连续空白（含换行）为单个空格，去首尾空白
export func cleanText(string raw): string {
    if raw == "" {
        return ""
    }
    string out = ""
    bool lastWasSpace = false
    int n = raw.len()
    for 0:n-1 to i {
        int b = raw.byte(i)
        if _isSpace(b) {
            if not lastWasSpace {
                out = out + " "
            }
            lastWasSpace = true
        } else {
            out = out + strings.char(b)
            lastWasSpace = false
        }
    }
    // 去首尾空白
    while out.len() > 0 and out.byte(0) == 32 {
        out = out.slice(1, out.len())
    }
    while out.len() > 0 and out.byte(out.len() - 1) == 32 {
        out = out.slice(0, out.len() - 1)
    }
    return out
}

// HTML 转可读纯文本（仿 html2text）：保留段落/标题/列表/换行结构
export func htmlToText(HtmlNode node): string {
    return _toText(node)
}

func _toText(HtmlNode node): string {
    string result = ""
    string tag = node.tag
    // 文本节点
    if tag == "#text" {
        return node.text
    }
    // 块级标签：段落前后加换行
    if tag == "p" or tag == "div" or tag == "section" or tag == "article" or tag == "header" or tag == "footer" {
        result = result + "\n"
    }
    // 标题：前后空行，加 # 标记
    if tag == "h1" {
        result = result + "\n# "
    } else if tag == "h2" {
        result = result + "\n## "
    } else if tag == "h3" {
        result = result + "\n### "
    } else if tag == "h4" or tag == "h5" or tag == "h6" {
        result = result + "\n#### "
    }
    // 列表项：前缀 "- "
    if tag == "li" {
        result = result + "- "
    }
    for node.children.len() to i {
        result = result + _toText(node.children[i])
    }
    // 块级结束换行
    if tag == "p" or tag == "div" or tag == "li" or tag == "h1" or tag == "h2" or tag == "h3" or tag == "h4" or tag == "h5" or tag == "h6" {
        result = result + "\n"
    }
    return result
}

// 去除 HTML 字符串中的所有标签，只保留文本（不解析 DOM，纯字符串处理）
// 例："<p>Hi <b>there</b></p>" -> "Hi there"
export func stripTags(string html): string {
    string out = ""
    int n = html.len()
    bool inTag = false
    for 0:n-1 to i {
        int b = html.byte(i)
        if b == 60 {
            // <
            inTag = true
        } else if b == 62 {
            // >
            inTag = false
        } else {
            if not inTag {
                out = out + strings.char(b)
            }
        }
    }
    return cleanText(out)
}

// 提取节点内所有文本（去标签、合并空白），等价于 allText + cleanText
export func textContent(HtmlNode node): string {
    return cleanText(allText(node))
}

// 提取 HTML 中第一个表格为二维数组（每行=一行，每格=cleanText 后的文本）
export func extractTable(HtmlNode root): Array[Array[string]] {
    Array[HtmlNode] tables = select(root, "table")
    Array[Array[string]] tableData = []
    if tables.len() > 0 {
        HtmlNode tbl = tables[0]
        Array[HtmlNode] rows = select(tbl, "tr")
        for rows.len() to i {
            HtmlNode tr = rows[i]
            Array[HtmlNode] cells = select(tr, "td")
            Array[HtmlNode] thCells = select(tr, "th")
            Array[string] rowData = []
            for cells.len() to j {
                rowData.add(cleanText(allText(cells[j])))
            }
            for thCells.len() to j {
                rowData.add(cleanText(allText(thCells[j])))
            }
            tableData.add(rowData)
        }
    }
    return tableData
}

export func attr(HtmlNode node, string name): string {
    string v = node.attrs.get(name, "")
    if v == "" { return "" }
    return _decodeEntities(v)
}

export func children(HtmlNode node): Array[HtmlNode] {
    return node.children
}

export func getLinks(string html): Array[string] {
    var root = parse(html)
    var links = []
    _collectLinks(root, links)
    return links
}

// 提取 HTML 的 <title> 文本（不存在返回空串）
export func getTitle(HtmlNode root): string {
    Array[HtmlNode] titles = select(root, "title")
    if titles.len() > 0 {
        return cleanText(allText(titles[0]))
    }
    return ""
}

// 提取 HTML 中 <meta> 标签的属性值（按 name 或 property 匹配，取 content 属性）
export func getMeta(HtmlNode root, string name): string {
    Array[HtmlNode] metas = select(root, "meta")
    for metas.len() to i {
        HtmlNode m = metas[i]
        string mname = attr(m, "name")
        if mname == "" {
            mname = attr(m, "property")
        }
        if mname == name {
            return attr(m, "content")
        }
    }
    return ""
}

// 提取 HTML 中所有 <meta> 标签为 Dict（name/property -> content）
export func getMetas(HtmlNode root): Dict {
    Dict result = {}
    Array[HtmlNode] metas = select(root, "meta")
    for metas.len() to i {
        HtmlNode m = metas[i]
        string mname = attr(m, "name")
        if mname == "" {
            mname = attr(m, "property")
        }
        if mname != "" {
            result[mname] = attr(m, "content")
        }
    }
    return result
}

// 从 DOM 中删除所有匹配 selector 的元素（修改传入的 root），返回删除个数
export func removeElement(HtmlNode root, string selector): int {
    Array sels = _splitSelector(selector)
    if sels.len() == 0 {
        return 0
    }
    return _removeRec(root, sels)
}

func _removeRec(HtmlNode node, Array sels): int {
    int removed = 0
    Array[HtmlNode] keep = []
    Dict sel = sels[0] as Dict
    for node.children.len() to i {
        HtmlNode child = node.children[i]
        if _matchSimple(child, sel) {
            removed = removed + 1
        } else {
            keep.add(child)
            removed = removed + _removeRec(child, sels)
        }
    }
    node.children = keep
    return removed
}

// 提取 HTML 中表单字段为 Dict（name -> value），仿 BeautifulSoup 表单解析
// 支持 input/select/textarea，取 name 属性和 value/文本
export func extractForm(HtmlNode root): Dict {
    Dict result = {}
    Array[HtmlNode] inputs = select(root, "input")
    for inputs.len() to i {
        HtmlNode inp = inputs[i]
        string iname = attr(inp, "name")
        if iname != "" {
            string val = attr(inp, "value")
            if val == "" and attr(inp, "type") == "checkbox" {
                if attr(inp, "checked") != "" {
                    val = "on"
                }
            }
            result[iname] = val
        }
    }
    Array[HtmlNode] selects = select(root, "select")
    for selects.len() to i {
        HtmlNode sel = selects[i]
        string sname = attr(sel, "name")
        if sname != "" {
            Array[HtmlNode] options = select(sel, "option")
            string selVal = ""
            for options.len() to j {
                if attr(options[j], "selected") != "" {
                    selVal = cleanText(allText(options[j]))
                    break
                }
            }
            result[sname] = selVal
        }
    }
    Array[HtmlNode] textareas = select(root, "textarea")
    for textareas.len() to i {
        HtmlNode ta = textareas[i]
        string taname = attr(ta, "name")
        if taname != "" {
            result[taname] = cleanText(allText(ta))
        }
    }
    return result
}

// ==================== 便捷查询 API（仿 BeautifulSoup） ====================

// 按 id 查找节点，返回第一个匹配或 null
export func getElementById(HtmlNode root, string id): HtmlNode? {
    if id == "" {
        return null
    }
    Array parts = _splitSelector("#" + id)
    if parts.len() == 0 {
        return null
    }
    Array[HtmlNode] current = [root]
    for 0:parts.len()-1 to pi {
        Dict p0 = parts[pi]
        Array[HtmlNode] next = []
        for current.len() to ci {
            _findDescendants(current[ci], p0, next)
        }
        current = next
    }
    if current.len() > 0 {
        return current[0]
    }
    return null
}

// 按标签名查找所有节点
export func getElementsByTag(HtmlNode root, string tagName): Array[HtmlNode] {
    return select(root, tagName)
}

// 按 class 名查找所有节点
export func getElementsByClass(HtmlNode root, string className): Array[HtmlNode] {
    if className == "" {
        return []
    }
    return select(root, "." + className)
}

// 通用查找：可按 tag/class/id 组合过滤（均为可选，传空串表示不过滤）
export func findAll(HtmlNode root, string tagName, string className, string idName): Array[HtmlNode] {
    Array[HtmlNode] all = []
    _findAllRec(root, tagName, className, idName, all)
    return all
}

func _findAllRec(HtmlNode node, string tagName, string className, string idName, Array[HtmlNode] results) {
    bool matched = true
    if tagName != "" {
        if node.tag != tagName {
            matched = false
        }
    }
    if matched and className != "" {
        if not _hasWord(attr(node, "class"), className) {
            matched = false
        }
    }
    if matched and idName != "" {
        if attr(node, "id") != idName {
            matched = false
        }
    }
    if matched {
        results.add(node)
    }
    for node.children.len() to ci {
        _findAllRec(node.children[ci], tagName, className, idName, results)
    }
}

func _collectLinks(HtmlNode node, Array[string] links) {
    if node.tag == "a" {
        string href = node.attrs.get("href", "")
        if href != "" {
            links.add(href)
        }
    }
    for node.children.len() to ci {
        _collectLinks(node.children[ci], links)
    }
}

// ==================== CSS 选择器 ====================

func _parseSimple(string selector): Dict {
    var r = {tag: "", id: "", classes: [], attrName: "", attrValue: "", attrOp: "=", hasAttr: false, pseudo: ""}
    int i = 0
    int slen = selector.len()

    while i < slen {
        int b = selector.byte(i)
        if _isAlphaNum(b) or b == 42 or b == 45 or b == 95 {
            var tagRaw = r["tag"]
            if tagRaw is string {
                r["tag"] = tagRaw + strings.char(b)
            }
            i = i + 1
        } else {
            break
        }
    }

    while i < slen {
        int b = selector.byte(i)
        if b == 46 {
            i = i + 1
            string cls = ""
            while i < slen {
                int ch = selector.byte(i)
                if ch == 46 or ch == 35 or ch == 91 or ch == 58 {
                    break
                }
                cls = cls + strings.char(ch)
                i = i + 1
            }
            var classesRaw = r["classes"]
            if classesRaw is Array {
                classesRaw.add(cls)
            }
        } else if b == 35 {
            i = i + 1
            string idVal = ""
            while i < slen {
                int ch = selector.byte(i)
                if ch == 46 or ch == 35 or ch == 91 or ch == 58 {
                    break
                }
                idVal = idVal + strings.char(ch)
                i = i + 1
            }
            r["id"] = idVal
        } else if b == 91 {
            i = i + 1
            string attrName = ""
            while i < slen {
                int ch = selector.byte(i)
                if ch == 61 or ch == 94 or ch == 36 or ch == 42 or ch == 93 {
                    break
                }
                attrName = attrName + strings.char(ch)
                i = i + 1
            }
            r["attrName"] = attrName
            r["hasAttr"] = true
            r["attrOp"] = "="
            if i < slen {
                int op = selector.byte(i)
                if op == 61 {
                    // =
                    i = i + 1
                } else if op == 94 and i + 1 < slen and selector.byte(i + 1) == 61 {
                    // ^=
                    r["attrOp"] = "^="
                    i = i + 2
                } else if op == 36 and i + 1 < slen and selector.byte(i + 1) == 61 {
                    // $=
                    r["attrOp"] = "$="
                    i = i + 2
                } else if op == 42 and i + 1 < slen and selector.byte(i + 1) == 61 {
                    // *=
                    r["attrOp"] = "*="
                    i = i + 2
                }
                if i <= slen and i - 1 < slen {
                    // 读取属性值（到 ] 为止）
                    string attrVal = ""
                    while i < slen {
                        int ch = selector.byte(i)
                        if ch == 93 {
                            break
                        }
                        attrVal = attrVal + strings.char(ch)
                        i = i + 1
                    }
                    r["attrValue"] = attrVal
                }
            }
            if i < slen and selector.byte(i) == 93 {
                i = i + 1
            }
        } else if b == 58 {
            // 伪类 :first-child / :last-child / :nth-child(n) / :only-child
            i = i + 1
            string pseudo = ""
            while i < slen {
                int ch = selector.byte(i)
                if ch == 40 or ch == 46 or ch == 35 or ch == 91 or ch == 58 or ch == 62 {
                    break
                }
                pseudo = pseudo + strings.char(ch)
                i = i + 1
            }
            r["pseudo"] = pseudo
            if i < slen and selector.byte(i) == 40 {
                // nth-child(n)
                i = i + 1
                string arg = ""
                while i < slen {
                    int ch = selector.byte(i)
                    if ch == 41 {
                        break
                    }
                    arg = arg + strings.char(ch)
                    i = i + 1
                }
                if i < slen and selector.byte(i) == 41 {
                    i = i + 1
                }
                r["pseudoArg"] = arg
            }
        } else {
            break
        }
    }

    return r
}

func _splitSelector(string selector): Array[Dict] {
    Array[Dict] parts = []
    string current = ""
    int i = 0
    int slen = selector.len()
    bool lastWasChild = false

    while i < slen {
        int b = selector.byte(i)
        if b == 62 {
            if current != "" {
                Dict parsed = _parseSimple(current)
                parsed["isChild"] = false
                parts.add(parsed)
                current = ""
            }
            lastWasChild = true
            i = i + 1
        } else if _isSpace(b) {
            if current != "" {
                Dict parsed = _parseSimple(current)
                parsed["isChild"] = lastWasChild
                parts.add(parsed)
                current = ""
                lastWasChild = false
            }
            i = i + 1
        } else {
            current = current + strings.char(b)
            i = i + 1
        }
    }

    if current != "" {
        Dict parsed = _parseSimple(current)
        parsed["isChild"] = lastWasChild
        parts.add(parsed)
    }

    return parts
}

func _hasWord(string str, string word): bool {
    if str == "" or word == "" {
        return false
    }
    int i = 0
    int slen = str.len()
    while i < slen {
        while i < slen and _isSpace(str.byte(i)) {
            i = i + 1
        }
        string w = ""
        while i < slen {
            int b = str.byte(i)
            if _isSpace(b) {
                break
            }
            w = w + strings.char(b)
            i = i + 1
        }
        if w == word {
            return true
        }
    }
    return false
}

// 检查伪类匹配：node 是兄弟中第 idx 个（0 起），total 为兄弟总数
func _matchPseudo(HtmlNode node, Dict sel, int idx, int total): bool {
    var p = sel["pseudo"]
    if not (p is string) {
        return true
    }
    if p == "" {
        return true
    }
    if p == "first-child" {
        return idx == 0
    } else if p == "last-child" {
        return idx == total - 1
    } else if p == "only-child" {
        return total == 1
    } else if p == "nth-child" {
        var arg = sel["pseudoArg"]
        if arg is string {
            int n = _int(arg)
            if n > 0 {
                return idx == n - 1
            }
        }
        return false
    }
    return true
}

func _matchSimple(HtmlNode node, Dict sel): bool {
    var tagVal = sel["tag"]
    if tagVal is string {
        if tagVal != "" and tagVal != "*" {
            if node.tag != tagVal {
                return false
            }
        }
    }

    var idVal = sel["id"]
    if idVal is string {
        if idVal != "" {
            if node.attrs.get("id", "") != idVal {
                return false
            }
        }
    }

    var classesRaw = sel["classes"]
    if classesRaw is Array {
        string nodeClass = node.attrs.get("class", "")
        if nodeClass == "" {
            if classesRaw.len() > 0 {
                return false
            }
        } else {
            for classesRaw.len() to ci {
                var cls = classesRaw[ci]
                if cls is string {
                    if not _hasWord(nodeClass, cls) {
                        return false
                    }
                }
            }
        }
    }

    var hasAttr = sel["hasAttr"]
    if hasAttr is bool {
        if hasAttr {
            var attrName = sel["attrName"]
            if attrName is string {
                if attrName != "" {
                    string nodeAttrVal = node.attrs.get(attrName, "")
                    var selAttrVal = sel["attrValue"]
                    var attrOp = sel["attrOp"]
                    if attrOp is string {
                        if selAttrVal is string {
                            if selAttrVal != "" {
                                string actual = nodeAttrVal
                                if attrOp == "=" {
                                    if actual != selAttrVal {
                                        return false
                                    }
                                } else if attrOp == "^=" {
                                    if not actual.starts_with(selAttrVal) {
                                        return false
                                    }
                                } else if attrOp == "$=" {
                                    if not actual.ends_with(selAttrVal) {
                                        return false
                                    }
                                } else if attrOp == "*=" {
                                    if not actual.has(selAttrVal) {
                                        return false
                                    }
                                } else {
                                    if actual != selAttrVal {
                                        return false
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    return true
}

func _findDescendants(HtmlNode node, Dict sel, Array[HtmlNode] results) {
    int total = node.children.len()
    for 0:total-1 to i {
        HtmlNode child = node.children[i]
        if _matchSimple(child, sel) and _matchPseudo(child, sel, i, total) {
            results.add(child)
        }
        _findDescendants(child, sel, results)
    }
}

func _findDirectChildren(HtmlNode node, Dict sel, Array[HtmlNode] results) {
    int total = node.children.len()
    for 0:total-1 to i {
        HtmlNode child = node.children[i]
        if _matchSimple(child, sel) and _matchPseudo(child, sel, i, total) {
            results.add(child)
        }
    }
}

export func select(HtmlNode root, string selector): Array[HtmlNode] {
    Array parts = _splitSelector(selector)
    if parts.len() == 0 {
        return []
    }

    Array[HtmlNode] current = [root]
    int partsLen = parts.len()
    for 0:partsLen-1 to pi {
        Dict p0 = parts[pi]
        Array[HtmlNode] next = []
        for current.len() to ci {
            HtmlNode node = current[ci]
            var isChildVal = p0["isChild"]
            if isChildVal is bool {
                if isChildVal {
                    _findDirectChildren(node, p0, next)
                } else {
                    _findDescendants(node, p0, next)
                }
            } else {
                _findDescendants(node, p0, next)
            }
        }
        current = next
    }

    return current
}

export func selectOne(HtmlNode root, string selector): HtmlNode? {
    Array[HtmlNode] results = select(root, selector)
    if results.len() > 0 {
        return results[0]
    }
    return null
}
