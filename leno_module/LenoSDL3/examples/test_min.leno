// test_min.leno — 最小渲染测试，排除 wrapper 层问题
import "../lib/SDL3.leno" as SDL3
use SDL3.Event
use SDL3.Renderer

main() {
    var win = SDL3.createWindow({title: "Min Test", w: 800, h: 600, flags: SDL3.WINDOW_RESIZABLE})
    if not win.ok { print("创建窗口失败"); return }

    win.run(
        func(Event e): bool {
            if e.isKeyDown() and e.scancode() == SDL3.SCANCODE_ESCAPE { return false }
            return true
        },
        func(Renderer r) {
            // 最小渲染：只清屏 + 一个矩形
            r.setColor(255, 0, 0, 255)
            r.clear()
            r.fillRect(100, 100, 200, 200)
        }
    )
    print("退出")
}
