// test_text_debug.leno - 调试文本渲染问题
import "../lib/SDL3.leno" as SDL3

main() {
    print("=== 开始调试 ===")
    
    // 创建窗口
    var win = SDL3.createWindow("文本调试", 400, 200, 0)
    if not win.ok {
        print("窗口创建失败")
        return
    }
    print("窗口创建成功")
    
    // 加载字体
    var font_path = "C:/Windows/Fonts/msyh.ttc"
    var font = SDL3.createFont(font_path, 24.0)
    if not font.ok {
        print("字体加载失败: " + font_path)
        win.destroy()
        return
    }
    print("字体加载成功，高度: " + font.height)
    
    // 创建渲染器
    var ren = SDL3.createRenderer(win.handle)
    if not ren.ok {
        print("渲染器创建失败")
        font.close()
        win.destroy()
        return
    }
    print("渲染器创建成功")
    
    // 尝试渲染文本为Surface（先测试英文）
    print("尝试调用 renderTextBlended（英文）...")
    var surface = font.renderTextBlended("Hello", 255, 255, 255)
    if surface == null {
        print("英文Surface创建失败: " + SDL3.getError())
        // 尝试Solid模式
        print("尝试 renderTextSolid...")
        surface = font.renderTextSolid("Hello", 255, 255, 255)
        if surface == null {
            print("Solid也失败: " + SDL3.getError())
            ren.destroy()
            font.close()
            win.destroy()
            return
        }
        print("Solid Surface 创建成功")
    } else {
        print("Blended Surface 创建成功")
    }
    
    // 尝试从Surface创建纹理
    print("尝试创建纹理...")
    var tex = new SDL3.TextTexture()
    if not tex.createFromSurface(ren.handle, surface) {
        print("纹理创建失败")
        ren.destroy()
        font.close()
        win.destroy()
        return
    }
    print("纹理创建成功")
    
    // 绘制一帧
    ren.setColor(0, 0, 0, 255)
    ren.clear()
    
    if tex.ok {
        // 使用简化版的 drawTextureAt，自动管理 SDL_FRect
        ren.drawTextureAt(tex.texture, 50.0, 50.0, 200.0, 50.0)
        print("纹理绘制完成")
    }
    
    ren.present()
    
    // 等待几秒
    SDL3.delay(3000)
    
    // 清理（不调用ttfQuit）
    tex.destroy()
    ren.destroy()
    font.close()
    win.destroy()
    
    print("=== 调试完成 ===")
}