// multi_window_manager.leno — 多窗口管理示例（并行数组版本）
//
// 演示：
//   1. 主窗口 + 模态对话框
//   2. 统一事件循环按 windowID 分发
//   3. 对话框关闭后主窗口继续运行
//   4. 按 D 键弹出对话框，点击确认/取消或 X 关闭
//
// 架构核心：
//   SDL3 所有窗口事件走同一个 SDL_PollEvent 队列，
//   每个事件带 windowID 标识属于哪个窗口。
//   用并行数组管理窗口信息，findIndex 按 windowID 分发。
import "../../lib/SDL3.leno" as SDL3
use SDL3.Event
use SDL3.Renderer
use SDL3.Scancode
use SDL3.Window

// ============================================================================
// 并行数组存储窗口信息
// ============================================================================
Array[Window]   _wins     = []
Array[Renderer] _rens     = []
Array[int]      _ids      = []
Array[bool]     _alive    = []
Array[bool]     _pending  = []
Array[int]      _kinds    = []  // 0=main, 1=dialog

bool _running = false
bool _dialogOpen = false

// 注册窗口
func addWindow(Window win, int kind) {
    Renderer ren = win.createRenderer()
    _wins.add(win)
    _rens.add(ren)
    _ids.add(win.getID())
    _alive.add(true)
    _pending.add(false)
    _kinds.add(kind)
}

// 按 windowID 查找索引
func findIndex(int id): int {
    var i = 0
    while i < _ids.len() {
        if _alive[i] and _ids[i] == id {
            return i
        }
        i = i + 1
    }
    return -1
}

// 标记待关闭（不立即销毁）
func markClose(int idx) {
    if idx >= 0 and _alive[idx] {
        _alive[idx] = false
        _pending[idx] = true
        if _kinds[idx] == 1 {
            _dialogOpen = false
        }
    }
}

// 统一销毁待关闭窗口
func flushClose() {
    var i = 0
    while i < _pending.len() {
        if _pending[i] {
            _pending[i] = false
            _rens[i].destroy()
            _wins[i].destroy()
        }
        i = i + 1
    }
}

// 打开对话框
func openDialog() {
    _dialogOpen = true
    Window dlg = SDL3.createWindow({title: "对话框", w: 400, h: 260})
    if dlg.ok {
        dlg.setPosition(200, 150)
        addWindow(dlg, 1)
    }
}

// ============================================================================
// 主入口
// ============================================================================
main() {
    Window mainWin = SDL3.createWindow({title: "主窗口 — 按 D 弹出对话框", w: 800, h: 600})
    if not mainWin.ok {
        print("创建主窗口失败")
        return
    }
    addWindow(mainWin, 0)  // 0=main

    _running = true
    Event ev = SDL3.createEvent()

    while _running {
        // 1. 处理所有事件
        while ev.poll() {
            if ev.isQuit() {
                _running = false
                break
            }

            int idx = findIndex(ev.windowID())
            if idx < 0 { continue }

            if _kinds[idx] == 0 {
                // 主窗口事件
                if ev.isKeyDown() and ev.scancode() == Scancode.D {
                    if not _dialogOpen { openDialog() }
                } else if ev.isWindowClose() {
                    _running = false
                    markClose(idx)
                }
            } else if _kinds[idx] == 1 {
                // 对话框事件
                if ev.isWindowClose() {
                    markClose(idx)
                } else if ev.isMouseButtonDown() {
                    float mx = ev.mouseX()
                    float my = ev.mouseY()
                    // 确认按钮 (40, 180, 140×30)
                    if mx >= 40 and mx <= 180 and my >= 180 and my <= 210 {
                        print("对话框: 确认")
                        markClose(idx)
                    }
                    // 取消按钮 (220, 180, 140×30)
                    if mx >= 220 and mx <= 360 and my >= 180 and my <= 210 {
                        print("对话框: 取消")
                        markClose(idx)
                    }
                }
            }
        }

        if not _running { break }

        // 2. 绘制所有存活窗口
        var aliveCount = 0
        var i = 0
        while i < _wins.len() {
            if _alive[i] and not _pending[i] {
                if _kinds[i] == 0 {
                    _rens[i].clearColor(30, 30, 46, 255)
                    _rens[i].setColor(69, 71, 90, 255)
                    _rens[i].fillRect(50, 50, 700, 200)
                    _rens[i].setColor(166, 227, 161, 255)
                    _rens[i].fillRect(100, 120, 200, 50)
                    _rens[i].setColor(88, 91, 112, 255)
                    _rens[i].fillRect(0, 560, 800, 40)
                } else if _kinds[i] == 1 {
                    _rens[i].clearColor(49, 50, 68, 255)
                    _rens[i].setColor(88, 91, 112, 255)
                    _rens[i].fillRect(20, 20, 360, 200)
                    _rens[i].setColor(166, 227, 161, 255)
                    _rens[i].fillRect(40, 180, 140, 30)
                    _rens[i].setColor(243, 139, 168, 255)
                    _rens[i].fillRect(220, 180, 140, 30)
                }
                _rens[i].present()
                aliveCount = aliveCount + 1
            }
            i = i + 1
        }

        // 3. 统一销毁待关闭窗口
        flushClose()

        if aliveCount == 0 { _running = false }
    }

    ev.uninit()
    print("程序退出")
}
