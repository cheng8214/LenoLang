// test_filedialog.leno — 验证独立文件对话框模块 sdl_filedialog.leno
// 运行：leno leno_module/LenoSDL3/examples/基础示例/test_filedialog.leno （需 SDL3.dll）
//
// 操作：O=打开文件(多选)  S=保存文件  F=选择文件夹  ESC=退出
// 结果实时显示在窗口上（回调在主线程返回，由 run() 每帧 clib 调用自动泵送）。
//
// 注意：g_status 用【文件级】变量，避免闭包按值捕获导致窗口读不到更新。

import "../../lib/SDL3.leno" as SDL3
use SDL3.Event
use SDL3.Renderer
use SDL3.Scancode

import "../../lib/sdl_filedialog.leno" as fdlg

// 文件级状态（全局单例，闭包修改对外层可见）
string g_status = "按 O=打开  S=保存  F=文件夹  ESC=退出"

main() {
    var win = SDL3.createWindow({title: "文件对话框测试 — O/S/F 弹框 ESC 退出", w: 720, h: 420})
    print("window 创建: " + (win != null))

    win.run(
        func(Event e): bool {
            if e.isQuit() { return false }
            if e.isKeyDown() {
                int sc = e.scancode()
                if sc == Scancode.ESCAPE {
                    return false
                } else if sc == Scancode.O {
                    fdlg.showOpenFileDialog(win,
                        func(Array[string] paths, int filter) {
                            print(">>> 打开回调触发, 文件数=" + paths.len())
                            if paths.len() > 0 {
                                g_status = "【打开】共 " + paths.len() + " 个: " + paths[0]
                            } else {
                                g_status = "【打开】已取消"
                            }
                        },
                        { allow_many: true,
                          filters: [ {name:"Leno 脚本", pattern:"*.leno"}, {name:"全部文件", pattern:"*.*"} ],
                          default_location: "." })
                } else if sc == Scancode.S {
                    fdlg.showSaveFileDialog(win,
                        func(Array[string] paths, int filter) {
                            print(">>> 保存回调触发, 文件数=" + paths.len())
                            if paths.len() > 0 {
                                g_status = "【保存】路径 = " + paths[0]
                            } else {
                                g_status = "【保存】已取消"
                            }
                        },
                        { filters: [ {name:"文本文件", pattern:"*.txt"} ], default_location: "." })
                } else if sc == Scancode.F {
                    fdlg.showOpenFolderDialog(win,
                        func(Array[string] paths, int filter) {
                            print(">>> 文件夹回调触发, 文件数=" + paths.len())
                            if paths.len() > 0 {
                                g_status = "【文件夹】= " + paths[0]
                            } else {
                                g_status = "【文件夹】已取消"
                            }
                        }, {})
                }
            }
            return true
        },
        func(Renderer r) {
            r.clearColor(24, 24, 32, 255)
            r.setColor(180, 220, 255, 255)
            r.drawText(SDL3.createFontAuto(16.0), g_status, 24, 30, 180, 220, 255)
            r.setColor(140, 140, 150, 255)
            r.drawText(SDL3.createFontAuto(13.0), "提示: 结果由主线程回调返回（跨线程回调自动泵送）", 24, 70, 140, 140, 150)
        }
    )
    print("关闭")
}
