// test_heart_popup.leno — 无数小窗口排列成爱心形状，随机语录+颜色
import "../../lib/SDL3.leno" as SDL3
use SDL3.Event
use SDL3.Renderer
use SDL3.Scancode
use SDL3.Window
import maths
import rands

// ==================== 语录 ====================
var _quotes = [
    "世间美好与你环环相扣","所念皆星河","热爱可抵岁月漫长",
    "山野万里，你是我藏在微风里的欢喜","眉眼弯弯","星河滚烫",
    "愿有岁月可回首","春风十里不如你","晴空万里不及心中有你",
    "所有的温柔眷恋","你眸中的星河","万物皆有裂痕",
    "与你同行不介路远","愿三冬暖春不寒","时光往复爱你如初",
    "你是我的今天和明天","世界灿烂盛大","绕过山河错落",
    "但愿人长久","人间四月天","落花时节又逢君","此心安处是吾乡"
]

// ==================== 心形几何 ====================
func heartX(float t): float { return 16.0 * maths.sin(t) * maths.sin(t) * maths.sin(t) }
func heartY(float t): float {
    return 13.0 * maths.cos(t) - 5.0 * maths.cos(2.0 * t)
          - 2.0 * maths.cos(3.0 * t) - maths.cos(4.0 * t)
}

// ==================== 窗口管理 ====================
Array[Window]   _wins  = []
Array[Renderer] _rens  = []
Array[int]      _ids   = []
Array[bool]     _alive = []
Array[bool]     _pend  = []
Array[int]      _qidx  = []

func addWindow(Window win, int qi) {
    Renderer ren = win.createRenderer()
    _wins.add(win); _rens.add(ren); _ids.add(win.getID())
    _alive.add(true); _pend.add(false); _qidx.add(qi)
}

func findIndex(int id): int {
    var i = 0
    while i < _ids.len() { if _alive[i] and _ids[i] == id { return i }; i += 1 }
    return -1
}

func markClose(int idx) {
    if idx >= 0 and _alive[idx] { _alive[idx] = false; _pend[idx] = true }
}

func flushClose() {
    var i = 0
    while i < _pend.len() {
        if _pend[i] { _pend[i] = false; _rens[i].destroy(); _wins[i].destroy() }
        i += 1
    }
}

// ==================== 逐帧生成状态 ====================
var _spawning  = false
var _spawnN    = 0
var _spawnI    = 0
var _spawnCX   = 600.0
var _spawnCY   = 400.0
var _spawnSC   = 30.0

func spawnOne() {
    if _spawnI >= _spawnN { _spawning = false; return }
    float step = 6.28318531 / _spawnN
    float t = step * _spawnI
    var px = _spawnCX + _spawnSC * heartX(t)
    // 翻 Y: 屏幕 Y 向下，心形曲线上方为正
    var py = _spawnCY - _spawnSC * heartY(t) * 1.3
    Window w = SDL3.createWindow({title: "^_^", w: 180, h: 50})
    if w.ok {
        w.setPosition(px as int, py as int)
        addWindow(w, rands.ints(0, _quotes.len() - 1))
    }
    _spawnI += 1
}

// ==================== 主 ====================
main() {
    Window ctrl = SDL3.createWindow({title: "爱心窗阵 — 1=生成  R=刷新  ESC=关闭本窗", w: 500, h: 250})
    if not ctrl.ok { return }
    Renderer ctrlRen = ctrl.createRenderer()

    var _running = true
    var font = SDL3.createFontAuto(14.0)
    var fontS = SDL3.createFontAuto(11.0)
    Event ev = SDL3.createEvent()

    while _running {
        while ev.poll() {
            if ev.isQuit() { _running = false; break }
            int idx = findIndex(ev.windowID())
            if idx < 0 {
                if ev.isKeyDown() {
                    if ev.scancode() == Scancode.ESCAPE { _running = false }
                    if ev.scancode() == Scancode._1 { _spawning = true; _spawnN = 50; _spawnI = 0 }
                    if ev.scancode() == Scancode.R {
                        var i = 0
                        while i < _qidx.len() { _qidx[i] = rands.ints(0, _quotes.len() - 1); i += 1 }
                    }
                }
                continue
            }
            if ev.isWindowClose() or (ev.isKeyDown() and ev.scancode() == Scancode.ESCAPE) {
                markClose(idx)
            }
        }

        // 绘制控制窗口
        ctrlRen.clearColor(#0F0F1EFF)
        ctrlRen.setColor(#FFB4C8FF)
        ctrlRen.drawText(font, "💖 爱心语录窗阵", 20, 20, #FFB4C8FF)
        ctrlRen.setColor(#C8C8DCFF)
        var alive = 0; var i = 0
        while i < _alive.len() { if _alive[i] { alive += 1 }; i += 1 }
        ctrlRen.drawText(font, "1 = 生成50个爱心窗   R = 刷新语录   ESC = 退出", 20, 60, #C8C8DCFF)
        ctrlRen.drawText(font, "当前存活: " + alive as string, 20, 95, #C8DC64FF)
        ctrlRen.drawText(fontS, "(点爱心小窗的 ESC 或 X 关闭单个)", 20, 125, #787896FF)
        ctrlRen.present()

        // 逐帧生成爱心窗（每帧1个）
        if _spawning { spawnOne() }

        // 绘制爱心小窗
        i = 0
        while i < _wins.len() {
            if _alive[i] and not _pend[i] {
                var cr = 200 + i % 56; var cg = 100 + (i * 3) % 156; var cb = 150 + (i * 7) % 106
                _rens[i].clearColor((255 << 24) | ((cr/5) << 16) | ((cg/5) << 8) | (cb/5))
                _rens[i].setColor((255 << 24) | (cr << 16) | (cg << 8) | cb)
                _rens[i].drawText(fontS, _quotes[_qidx[i]], 8, 16, (255 << 24) | (cr << 16) | (cg << 8) | cb)
                _rens[i].present()
            }
            i += 1
        }

        flushClose()
    }

    ev.uninit()
    ctrlRen.destroy(); ctrl.destroy()
    print("byebye")
}
