// test_multi_window.leno — 多窗口测试
// 创建三个独立窗口，验证引用计数：关闭任一窗口不影响其他窗口
import "../../lib/SDL3.leno" as SDL3
use SDL3.Event
use SDL3.Renderer
use SDL3.Window

main() {
    print("=== 多窗口测试 ===")

    // 创建三个窗口
    Window w1 = SDL3.createWindow({title: "Window 1 - 红色",   w: 400, h: 300})
    Window w2 = SDL3.createWindow({title: "Window 2 - 绿色",   w: 400, h: 300})
    Window w3 = SDL3.createWindow({title: "Window 3 - 蓝色",   w: 400, h: 300})

    if not w1.ok or not w2.ok or not w3.ok {
        print("窗口创建失败")
        return
    }

    print("三个窗口已创建，关闭其中一个不会退出")

    // 窗口1：红色背景（独立循环）
    w1.run(
        func(Event e): bool {
            if e.isKeyDown() and e.scancode() == SDL3.SCANCODE_ESCAPE { return false }
            if e.isWindowClose() {
                print("Window 1 关闭")
                return false
            }
            return true
        },
        func(Renderer r) {
            r.clearColor(180, 40, 40, 255)
            r.drawText(SDL3.createFontAuto(24), "Window 1 — 红色", 50, 120, 255, 255, 255)
        }
    )
    print("Window 1 exit (其他窗口不受影响)")

    // 窗口2：绿色背景
    w2.run(
        func(Event e): bool {
            if e.isKeyDown() and e.scancode() == SDL3.SCANCODE_ESCAPE { return false }
            if e.isWindowClose() {
                print("Window 2 关闭")
                return false
            }
            return true
        },
        func(Renderer r) {
            r.clearColor(40, 160, 40, 255)
            r.drawText(SDL3.createFontAuto(24), "Window 2 — 绿色", 50, 120, 255, 255, 255)
        }
    )
    print("Window 2 exit (其他窗口不受影响)")

    // 窗口3：蓝色背景
    w3.run(
        func(Event e): bool {
            if e.isKeyDown() and e.scancode() == SDL3.SCANCODE_ESCAPE { return false }
            if e.isWindowClose() {
                print("Window 3 关闭")
                return false
            }
            return true
        },
        func(Renderer r) {
            r.clearColor(40, 40, 180, 255)
            r.drawText(SDL3.createFontAuto(24), "Window 3 — 蓝色", 50, 120, 255, 255, 255)
        }
    )
    print("Window 3 exit (最后一个窗口退出，SDL 清理)")

    print("=== 多窗口测试完成 ===")
}
