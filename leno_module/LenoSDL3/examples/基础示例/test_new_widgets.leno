// test_new_widgets.leno — 新增控件完整测试
// 覆盖 ImageView / Separator / LinkButton / Spinner / GroupBox 的所有属性和交互
import "../../lib/SDL3.leno" as SDL3
use SDL3.(Event, Renderer, Scancode)

main() {
    var win = SDL3.createWindow({title: "新增控件完整测试", w: 960, h: 720, flags: 0x20})
    if not win.ok { return }
    win.setResizable(true)

    // ================================================================
    // 1. GroupBox: 分组容器 — 测试 title / radius / bg_rgb / border_rgb / title_rgb / clip
    // ================================================================
    var gb1 = win.addGroupBox({
        title: "1. GroupBox 基础属性", x: 10, y: 10, w: 460, h: 200,
        radius: 10.0, title_pad: 12.0, border_alpha: 220,
        bg_rgb: [40, 42, 50], border_rgb: [100, 120, 160], title_rgb: [255, 200, 80]
    })

    // ================================================================
    // 2. ImageView: 图片展示 — 测试 3 种模式 + 边框 + 圆角 + 透明度 + 着色 + 背景填充
    // ================================================================

    // 2a: aspectFit 模式 + 边框 + 圆角 + 手型光标
    var iv1 = win.addImageView({
        x: 20, y: 40, w: 120, h: 100,
        image_mode: 0,        // aspectFit
        border: true, radius: 8.0,
        cursor: SDL3.SystemCursor.POINTER,
        tip: "aspectFit: 完整显示"
    })
    iv1.on_click(func() { print("[ImageView] aspectFit 被点击") })
    gb1.add(iv1)

    // 2b: stretch 模式 + 背景填充 + 边框自定义色
    var iv2 = win.addImageView({
        x: 155, y: 40, w: 120, h: 100,
        image_mode: 1,        // stretch
        border: true, radius: 4.0,
        border_rgb: [200, 80, 80], border_alpha: 255,
        bg_rgb: [30, 30, 40]
    })
    gb1.add(iv2)

    // 2c: aspectFill 模式 + 透明度 + 着色
    var iv3 = win.addImageView({
        x: 290, y: 40, w: 120, h: 100,
        image_mode: 2,        // aspectFill
        border: true, radius: 6.0,
        alpha: 180,
        image_tint: [100, 255, 100]
    })
    gb1.add(iv3)

    // 2d: 无图片占位 + 不可见状态切换
    var iv4 = win.addImageView({
        x: 20, y: 150, w: 390, h: 40,
        image_mode: 1,
        border: true, border_rgb: [60, 60, 80],
        bg_rgb: [20, 20, 30],
        tip: "无图片占位"
    })
    gb1.add(iv4)

    // ================================================================
    // 3. Separator: 分隔线 — 测试水平/垂直 + 粗细 + 颜色 + margin
    // ================================================================
    var sepH1 = win.addSeparator({x: 10, y: 220, w: 460, dir: 0, thickness: 1, margin: 10.0})
    var sepH2 = win.addSeparator({x: 10, y: 228, w: 460, dir: 0, thickness: 3, rgb: [180, 80, 80], alpha: 255})
    var sepV1 = win.addSeparator({x: 480, y: 10, dir: 1, h: 350, thickness: 2, margin: 5.0, rgb: [80, 180, 80], alpha: 200})
    var sepV2 = win.addSeparator({x: 940, y: 10, dir: 1, h: 700, thickness: 1, rgb: [80, 80, 180], alpha: 120})

    // ================================================================
    // 4. GroupBox 2: LinkButton 专区
    // ================================================================
    var gb2 = win.addGroupBox({
        title: "2. LinkButton 链接按钮", x: 490, y: 10, w: 460, h: 200,
        radius: 8.0,
        bg_rgb: [35, 38, 46], border_rgb: [90, 100, 130], title_rgb: [100, 200, 255]
    })

    // 4a: 带URL + 始终下划线 + 默认色
    var lb1 = win.addLinkButton({text: "GitHub 首页", x: 505, y: 45, font_size: 15, url: "https://github.com"})
    lb1.on_click(func() { print("[LinkButton] GitHub 点击") })
    gb2.add(lb1)

    // 4b: 无URL + 仅悬停下划线
    var lb2 = win.addLinkButton({text: "仅悬停下划线", x: 505, y: 75, font_size: 15, underline: false, underline_hover: true})
    lb2.on_click(func() { print("[LinkButton] hover-only 下划线点击") })
    gb2.add(lb2)

    // 4c: 自定义颜色 + 已访问状态
    var lb3 = win.addLinkButton({text: "自定义颜色", x: 505, y: 105, font_size: 15, rgb: [255, 200, 0], hover_rgb: [255, 100, 0], visited: true})
    lb3.on_click(func() { print("[LinkButton] 自定义颜色点击") })
    gb2.add(lb3)

    // 4d: 无下划线 + 禁用状态
    var lb4 = win.addLinkButton({text: "禁用状态", x: 505, y: 135, font_size: 15, underline: false, enabled: false})
    gb2.add(lb4)

    // 4e: 提示文本 + 光标
    var lb5 = win.addLinkButton({text: "悬停看提示", x: 505, y: 165, font_size: 15, tip: "这是一个链接提示"})
    lb5.on_click(func() { print("[LinkButton] 带提示点击") })
    gb2.add(lb5)

    // ================================================================
    // 5. GroupBox 3: Spinner 专区
    // ================================================================
    var gb3 = win.addGroupBox({
        title: "3. Spinner 加载动画", x: 10, y: 240, w: 460, h: 160,
        radius: 8.0,
        bg_rgb: [38, 40, 48], border_rgb: [100, 90, 130]
    })

    // 5a: 默认运行 + full_track
    var sp1 = win.addSpinner({x: 30, y: 290, size: 40, thickness: 3.0, speed: 270.0, running: true, full_track: true})
    gb3.add(sp1)

    // 5b: 自定义颜色 + 更快速度
    var sp2 = win.addSpinner({x: 110, y: 290, size: 40, thickness: 4.0, speed: 720.0, running: true, full_track: false, rgb: [255, 100, 50], track_rgb: [60, 60, 60], track_alpha: 120})
    gb3.add(sp2)

    // 5c: 停止状态
    var sp3 = win.addSpinner({x: 190, y: 290, size: 40, thickness: 3.0, running: false, full_track: true, rgb: [100, 255, 100]})
    gb3.add(sp3)

    // 5d: 大尺寸 + 慢速
    var sp4 = win.addSpinner({x: 280, y: 275, size: 60, thickness: 5.0, speed: 90.0, running: true, full_track: true, rgb: [200, 100, 255], track_rgb: [40, 40, 50], track_alpha: 60})
    gb3.add(sp4)

    // ================================================================
    // 6. GroupBox 4: 运行时属性切换测试
    // ================================================================
    var gb4 = win.addGroupBox({
        title: "4. 运行时属性切换 (按 1/2/3/4 切换)", x: 490, y: 220, w: 460, h: 480,
        radius: 8.0,
        bg_rgb: [30, 32, 40], border_rgb: [80, 120, 160], title_rgb: [255, 255, 100]
    })

    // 6a: 可切换可见性的 ImageView
    var ivTest = win.addImageView({x: 510, y: 260, w: 200, h: 120, image_mode: 0, border: true, radius: 6.0, border_rgb: [100, 100, 120], tip: "按1切换可见性"})
    gb4.add(ivTest)

    // 6b: 可切换方向的 Separator
    var sepTest = win.addSeparator({x: 730, y: 260, dir: 1, h: 120, thickness: 2, rgb: [200, 200, 0], alpha: 255})
    gb4.add(sepTest)

    // 6c: 可切换运行状态的 Spinner
    var spTest = win.addSpinner({x: 510, y: 400, size: 50, thickness: 4.0, speed: 360.0, running: true, full_track: true, rgb: [100, 200, 255]})
    gb4.add(spTest)

    // 6d: 可切换文字的 LinkButton
    var lbTest = win.addLinkButton({text: "初始文字 (按4切换)", x: 510, y: 470, font_size: 16, underline: true})
    lbTest.on_click(func() { print("[运行时] LinkButton 被点击") })
    gb4.add(lbTest)

    // 6e: GroupBox 嵌套测试
    var gbNested = win.addGroupBox({title: "嵌套 GroupBox", x: 510, y: 510, w: 420, h: 170, radius: 6.0, bg_rgb: [50, 52, 60], border_rgb: [120, 80, 160]})
    var nestedSep = win.addSeparator({x: 525, y: 550, w: 390, dir: 0, thickness: 2, rgb: [160, 80, 160], alpha: 200})
    gbNested.add(nestedSep)
    var nestedLb = win.addLinkButton({text: "嵌套链接", x: 525, y: 570, font_size: 14})
    gbNested.add(nestedLb)
    var nestedSp = win.addSpinner({x: 650, y: 565, size: 28, thickness: 2.5, speed: 540.0, running: true, full_track: true, rgb: [255, 160, 80]})
    gbNested.add(nestedSp)
    gb4.add(gbNested)

    // 状态追踪
    bool ivVisible = true
    bool spRunning = true
    int lbToggle = 0
    bool sepIsVertical = true

    // ================================================================
    // 运行
    // ================================================================
    win.run(func(Event ev): bool {
        if ev.isQuit() { return false }
        if ev.isKeyDown() {
            int sc = ev.scancode()
            if sc == SDL3.Scancode.ESCAPE { return false }
            // 按 1: 切换 ImageView 可见性
            if sc == SDL3.Scancode._1 {
                ivVisible = not ivVisible
                ivTest.set_visible(ivVisible)
                print("[切换] ImageView visible=" + ivVisible)
            }
            // 按 2: 切换 Separator 方向
            if sc == SDL3.Scancode._2 {
                sepIsVertical = not sepIsVertical
                if sepIsVertical { sepTest.set_vertical() }
                else { sepTest.set_horizontal() }
                print("[切换] Separator vertical=" + sepIsVertical)
            }
            // 按 3: 切换 Spinner 运行状态
            if sc == SDL3.Scancode._3 {
                spRunning = not spRunning
                if spRunning { spTest.start() } else { spTest.stop() }
                print("[切换] Spinner running=" + spRunning)
            }
            // 按 4: 切换 LinkButton 文字
            if sc == SDL3.Scancode._4 {
                lbToggle = lbToggle + 1
                if lbToggle % 3 == 0 { lbTest.set_text("初始文字 (按4切换)") }
                else if lbToggle % 3 == 1 { lbTest.set_text("已访问状态") ; lbTest.set_visited(true) }
                else { lbTest.set_text("重置颜色") ; lbTest.set_visited(false) ; lbTest.set_text_rgb(100, 255, 100) }
                print("[切换] LinkButton toggle=" + lbToggle)
            }
        }
        return true
    }, func(Renderer r) {
        // 控件由 win.run 自动渲染
    })
}
