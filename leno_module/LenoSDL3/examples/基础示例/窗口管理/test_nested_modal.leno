// test_nested_modal.leno — 嵌套模态：主→模态2→模态3
import "../../../lib/SDL3.leno" as SDL3
use SDL3.Event
use SDL3.Renderer
use SDL3.Scancode
use SDL3.WindowFlag

main() {
    var win = SDL3.createWindow({title: "主窗口 — 2=模态2 3=模态3 ESC=退", w: 640, h: 480})
    win.run(
        func(Event e): bool {
            if e.isKeyDown() {
                if e.scancode() == Scancode.ESCAPE { return false }
                if e.scancode() == Scancode._2 { showModal2() }
                if e.scancode() == Scancode._3 {
                    var dlg = SDL3.createDialogWindow({title: "模态3", w: 300, h: 180, flags: WindowFlag.UTILITY})
                    SDL3.runModal(dlg,
                        func(Event ev): bool {
                            if ev.isKeyDown() and ev.scancode() == Scancode.ESCAPE { return false }
                            if ev.isKeyDown() and ev.scancode() == Scancode._3 {
                                var d2 = SDL3.createDialogWindow({title: "模态3-再一层", w: 280, h: 160, flags: WindowFlag.UTILITY})
                                SDL3.runModal(d2,
                                    func(Event e2): bool { return not (e2.isKeyDown() and e2.scancode() == Scancode.ESCAPE) },
                                    func(Renderer r) { r.clearColor(#3C0A0AFF); r.drawText(SDL3.createFontAuto(13.0),"最深层模态",30,40,#FF6464FF) }
                                )
                            }
                            return true
                        },
                        func(Renderer r) { r.clearColor(#3C0A0AFF); r.drawText(SDL3.createFontAuto(14.0),"模态3",30,30,#FF6464FF) }
                    )
                }
            }
            return true
        },
        func(Renderer r) {
            r.clearColor(#141428FF)
            r.drawText(SDL3.createFontAuto(18.0),"主窗口",20,20,#FFFFFFFF)
            r.drawText(SDL3.createFontAuto(14.0),"2=模态2 3=模态3 ESC=退",20,55,#C8C8F0FF)
        }
    )
    print("全部关闭")
}

func showModal2() {
    var dlg = SDL3.createDialogWindow({title: "模态2", w: 350, h: 220, flags: WindowFlag.UTILITY})
    SDL3.runModal(dlg,
        func(Event e): bool {
            if e.isKeyDown() {
                if e.scancode() == Scancode.ESCAPE { return false }
                if e.scancode() == Scancode._3 {
                    var d2 = SDL3.createDialogWindow({title: "模态3 [从2弹出]", w: 280, h: 160, flags: WindowFlag.UTILITY})
                    SDL3.runModal(d2,
                        func(Event e2): bool { return not (e2.isKeyDown() and e2.scancode() == Scancode.ESCAPE) },
                        func(Renderer r) { r.clearColor(#3C0F0FFF); r.drawText(SDL3.createFontAuto(13.0),"从模态2弹出的模态3",20,40,#FF6464FF) }
                    )
                }
            }
            return true
        },
        func(Renderer r) { r.clearColor(#280F0FFF); r.drawText(SDL3.createFontAuto(14.0),"模态2 — 3=弹模态3",20,30,#FF9632FF) }
    )
}
