// 测试 Array[T] 类型信息是否丢失
import "../../../lib/SDL3.leno" as SDL3
use SDL3.Event
use SDL3.Renderer
use SDL3.Window
use SDL3.WindowFlag
use SDL3.Scancode
use SDL3.EventHandler
use SDL3.RenderCallback

func addOne(int x): int { return x + 1 }

main() {
    var w1 = SDL3.createWindow({title: "窗口1", w: 400, h: 300, flags: WindowFlag.RESIZABLE})
    var w2 = SDL3.createWindow({title: "窗口2", w: 400, h: 300, flags: WindowFlag.RESIZABLE})

    print("=== 测试1: Array[Window] 存入 Window 类型是否丢失 ===")
    Array[Window] wins = [w1, w2]
    print("wins.len =", wins.len())
    print("wins[0].ok =", wins[0].ok)
    print("wins[0] is Window =", wins[0] is Window)

    print("")
    print("=== 测试2: Array[EventHandler] 存入函数类型 ===")
    EventHandler eh1 = func(Event e): bool { return true }
    EventHandler eh2 = func(Event e): bool { return true }
    Array[EventHandler] handlers = [eh1, eh2]
    print("handlers.len =", handlers.len())
    print("handlers[0] is EventHandler =", handlers[0] is EventHandler)
    print("handlers[0] is func =", handlers[0] is func)

    print("")
    print("=== 测试3: 混合类型 Array（元素为 any）===")
    var mixed = [w1, addOne]
    print("mixed[0] is Window =", mixed[0] is Window)
    print("mixed[1] is func =", mixed[1] is func)

    print("")
    print("=== 测试4: Array[Window] 传给 export func 后 ===")
    func callOnWin(Array[Window] arr) {
        print("arr.len =", arr.len())
        print("arr[0].ok =", arr[0].ok)
    }
    callOnWin(wins)

    print("")
    print("=== 测试5: Array[EventHandler] 传给 export func 后 ===")
    func callOnHandler(Array[EventHandler] arr) {
        print("arr.len =", arr.len())
        // 直接调用 handlers[0] 是否可以？
        var ev = SDL3.createEvent()
        print("arr[0](ev) =", arr[0](ev))
    }
    callOnHandler(handlers)

    print("")
    print("=== DONE ===")
    w1.destroy(); w2.destroy()
}
