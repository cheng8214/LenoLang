// test_dialog_api.leno — createDialogWindow + runModal 一行模态
import "../../../lib/SDL3.leno" as SDL3
use SDL3.Event
use SDL3.Renderer
use SDL3.Scancode
use SDL3.WindowFlag

main() {
    var win = SDL3.createWindow({title: "主窗口 — M=模态 ESC=退", w: 600, h: 400})

    win.run(
        func(Event e): bool {
            if e.isKeyDown() {
                if e.scancode() == Scancode.ESCAPE { return false }
                if e.scancode() == Scancode.M {
                    var dlg = SDL3.createDialogWindow({title: "确认对话框", w: 350, h: 200, flags: WindowFlag.UTILITY})
                    SDL3.runModal(dlg,
                        func(Event ev): bool {
                            if ev.isKeyDown() and ev.scancode() == Scancode.ESCAPE { return false }
                            return true
                        },
                        func(Renderer r) {
                            r.clearColor(#281414FF)
                            r.setColor(#FFC864FF)
                            r.drawText(SDL3.createFontAuto(15.0), "模态对话框", 30, 40, #FFC864FF)
                            r.drawText(SDL3.createFontAuto(13.0), "ESC 关闭", 30, 80, #C8C8C8FF)
                        }
                    )
                }
            }
            return true
        },
        func(Renderer r) {
            r.clearColor(#141428FF)
            r.setColor(#FFFFFFFF)
            r.drawText(SDL3.createFontAuto(16.0), "主窗口 — M=弹出模态", 20, 20, #FFFFFFFF)
            r.drawText(SDL3.createFontAuto(14.0), "弹出后主窗口阻塞,点击闪屏", 20, 55, #FFC864FF)
        }
    )
    print("关闭")
}
