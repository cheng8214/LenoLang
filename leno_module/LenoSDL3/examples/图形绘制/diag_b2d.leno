// diag_b2d.leno — 诊断 Blend2D 库加载
import dirs
import files
import "../../lib/sdl_blend2d.leno" as b2d

main() {
    print("script_dir = " + dirs.script_dir())
    var p1 = dirs.script_dir() + "/blend2d.dll"
    var p2 = dirs.script_dir() + "/../blend2d.dll"
    print("exists(p1) = " + files.exists(p1))
    print("exists(p2) = " + files.exists(p2))
    var lib = b2d.lib()
    print("b2d.lib() is null ? ")
    print(lib == null)
    if lib != null {
        print("blend2d loaded OK")
    } else {
        print("blend2d FAILED to load")
    }
}
