// test_b2d.leno — 测试 Blend2D 抗锯齿绘制（替代 SDL3 原生锯齿图元）
import "../../lib/SDL3.leno" as SDL3
use SDL3.Event
use SDL3.Renderer
use SDL3.Scancode
import maths
import "../../lib/sdl_blend2d.leno" as b2d
use b2d.B2DCanvas

main() {
    var win = SDL3.createWindow({title: "Blend2D 抗锯齿测试 — 线/圆/矩形", w: 800, h: 600})
    if not win.ok { return }

    SDL3.ttfInit()
    var font = SDL3.createFontAuto(14.0)

    var canvas = new B2DCanvas()
    bool canvasReady = false
    int w = 800; int h = 600

    var angle = 0.0

    win.run(
        func(Event e): bool {
            if e.isQuit() or e.isWindowClose() { return false }
            if e.isKeyDown() and e.scancode() == Scancode.ESCAPE { return false }
            return true
        },
        func(Renderer r) {
            // 首次：用 SDL_Renderer* 初始化画布（一次性）
            if not canvasReady {
                canvasReady = canvas.init(r.handle, w, h)
                if not canvasReady { return }
            }

            angle = angle + 0.6; if angle >= 360.0 { angle = 0.0 }

            // 清屏（不透明底 0xAARRGGBB）
            canvas.clear(0xFF202830)

            // 标题
            r.drawText(font, "Blend2D 抗锯齿 — 与 SDL 原生对比", 10, 5, 230, 230, 160)

            // ===== 1. 矩形：SDL 原生（锯齿） vs Blend2D（抗锯齿）=====
            r.drawText(font, "SDL 原生矩形", 30, 35, 200, 180, 120)
            r.setColor(255, 100, 50, 255);  r.fillRect(30, 60, 140, 80)
            r.setColor(255, 200, 180, 255); r.drawRect(30, 60, 140, 80)

            r.drawText(font, "Blend2D 矩形", 200, 35, 120, 200, 255)
            canvas.fillRect(200, 60, 140, 80, 0xFFFF6432)
            canvas.strokeRect(200, 60, 140, 80, 2.0, 0xFFFFC8B4)

            // ===== 2. 圆：SDL 原生 vs Blend2D =====
            r.drawText(font, "SDL 原生圆", 400, 35, 200, 180, 120)
            r.setColor(200, 100, 255, 255); r.fillCircle(470, 100, 45)
            r.setColor(255, 255, 255, 255); r.drawCircle(470, 100, 45)

            r.drawText(font, "Blend2D 圆", 560, 35, 120, 200, 255)
            canvas.fillCircle(630, 100, 45, 0xFFC864FF)
            canvas.strokeCircle(630, 100, 45, 2.0, 0xFFFFFFFF)

            // ===== 3. 线段：斜线最容易看出锯齿 vs 平滑 =====
            r.drawText(font, "SDL 原生线", 30, 180, 200, 180, 120)
            r.setColor(100, 255, 200, 255)
            r.drawLine(30, 240, 170, 200)   // 斜线（锯齿明显）

            r.drawText(font, "Blend2D 线", 200, 180, 120, 200, 255)
            canvas.line(200, 240, 340, 200, 2.5, 0xFF64FFC8)

            // ===== 4. 多个旋转圆/线，演示抗锯齿边 =====
            r.drawText(font, "Blend2D 多圆 + 旋转线", 420, 180, 120, 200, 255)
            for 0 : 6 to i {
                float a = (angle + _float(i) * 60.0) * 3.14159265 / 180.0
                float cx = 560.0 + maths.cos(a) * 90.0
                float cy = 280.0 + maths.sin(a) * 60.0
                canvas.fillCircle(cx, cy, 18.0, 0xFF50A0E0)
            }
            // 旋转线段
            float a2 = angle * 3.14159265 / 180.0
            canvas.line(420, 280, 420.0 + maths.cos(a2) * 120.0, 280.0 + maths.sin(a2) * 120.0, 3.0, 0xFFE0E040)

            // ===== 5. 圆角矩形（用 fillRect 模拟，Blend2D 平滑描边）=====
            r.drawText(font, "Blend2D 描边框", 30, 320, 120, 200, 255)
            canvas.strokeRect(30, 350, 220, 120, 4.0, 0xFF90FF90)

            // ===== 6. 文字提示 =====
            r.drawText(font, "ESC 退出", 700, 580, 120, 120, 120)

            // 关键：把 Blend2D 的离屏纹理上传并贴到窗口
            canvas.present(r.handle)
        }
    )

    if canvas.ok { canvas.destroy() }
    if font.ok { font.close() }
    SDL3.ttfQuit()
}
