// test_draw.leno — 测试绘制：矩形/圆形/三角形/线条/阴影/渐变
import "../lib/SDL3.leno" as SDL3
import maths
use SDL3.Event
use SDL3.Renderer
use SDL3.SDL_Vertex

main() {
    var win = SDL3.createWindow({title: "绘制测试 — 矩形/圆形/三角/阴影", w: 800, h: 600})
    if not win.ok { return }

    SDL3.ttfInit()
    var font = SDL3.createFontAuto(14.0)

    var angle = 0.0

    win.run(
        func(Event e): bool {
            if e.isQuit() or e.isWindowClose() { return false }
            if e.isKeyDown() and e.scancode() == SDL3.SCANCODE_ESCAPE { return false }
            return true
        },
        func(Renderer r) {
            r.clearColor(30, 30, 50, 255)
            angle = angle + 0.5; if angle >= 360.0 { angle = 0.0 }

            // ---- 标题 ----
            r.drawText(font, "绘制测试 — 矩形/圆形/三角形/阴影/渐变", 10, 5, 255, 220, 80)

            // ==================== 1. 矩形阴影效果 ====================
            r.drawText(font, "矩形 + 阴影", 30, 30, 200, 200, 100)

            // 阴影（偏移 + 半透明黑）
            r.setColor(0, 0, 0, 100)
            r.fillRect(35, 55, 140, 80)

            // 矩形本体
            r.setColor(255, 100, 50, 255);   r.fillRect(30, 50, 140, 80)
            r.setColor(255, 200, 180, 255);   r.drawRect(30, 50, 140, 80)

            // 圆角效果（用 4 个 drawLine 画圆角边）
            r.setColor(50, 200, 100, 255);    r.fillRect(200, 50, 140, 80)
            r.setColor(255, 255, 255, 255);   r.drawRect(200, 50, 140, 80)

            // ==================== 2. 圆形 ====================
            r.drawText(font, "圆形", 430, 30, 200, 200, 100)

            // 阴影 + 圆
            r.setColor(0, 0, 0, 80)
            r.fillCircle(505, 95, 45)
            r.setColor(200, 100, 255, 255)
            r.fillCircle(500, 90, 45)
            r.setColor(255, 255, 255, 255)
            r.drawCircle(500, 90, 45)

            // 空心圆
            r.setColor(100, 220, 255, 255)
            r.drawCircle(600, 90, 40)
            r.drawCircle(600, 90, 35)

            // ==================== 3. 三角形（用线画） ====================
            r.drawText(font, "三角形 (drawLine)", 30, 155, 200, 200, 100)

            // 三角形填充阴影
            float tx = 120; float ty = 250
            r.setColor(0, 0, 0, 80)
            r.drawLine(tx, ty + 40, tx + 60, ty); r.drawLine(tx + 60, ty, tx + 120, ty + 40); r.drawLine(tx + 120, ty + 40, tx, ty + 40)

            // 三角形填充（用多条线逼近）
            r.setColor(255, 200, 80, 255)
            for 0 : 40 to yi {
                float ratio = _float(yi) / 40.0
                float lx = tx + 5 + ratio * 60.0
                float rx = tx + 5 + (1.0 - ratio) * 60.0 + 60.0
                r.drawLine(lx, ty + 40 - ratio * 40 - 5, rx, ty + 40 - ratio * 40 - 5)
            }
            // 三角边框
            r.setColor(255, 255, 255, 255)
            r.drawLine(tx, ty + 40, tx + 60, ty)
            r.drawLine(tx + 60, ty, tx + 120, ty + 40)
            r.drawLine(tx + 120, ty + 40, tx, ty + 40)

            // 空心三角
            float t2x = 250; float t2y = 250
            r.setColor(100, 255, 200, 255)
            r.drawLine(t2x, t2y + 40, t2x + 60, t2y)
            r.drawLine(t2x + 60, t2y, t2x + 120, t2y + 40)
            r.drawLine(t2x + 120, t2y + 40, t2x, t2y + 40)

            // 旋转三角形 (drawGeometry — 真三角形渲染)
            r.drawText(font, "旋转三角 (Geometry)", 420, 155, 200, 200, 100)
            float acx = 480; float acy = 230
            float arad = angle * 3.14159265 / 180.0
            float cosA = maths.cos(arad); float sinA = maths.sin(arad)

            // 用 SDL_Vertex 定义旋转三角形（3 个顶点，旋转后坐标）
            float p0x = cosA * 0.0  - sinA * (-35.0) + acx
            float p0y = sinA * 0.0  + cosA * (-35.0) + acy
            float p1x = cosA * 35.0 - sinA * 35.0  + acx
            float p1y = sinA * 35.0 + cosA * 35.0  + acy
            float p2x = cosA * (-35.0) - sinA * 35.0 + acx
            float p2y = sinA * (-35.0) + cosA * 35.0 + acy

            // 用 SDL_Vertex cstruct 创建三角形顶点
            var verts = SDL_Vertex.malloc_array(3)
            verts[0].x = p0x; verts[0].y = p0y
            verts[0].r = 1.0; verts[0].g = 0.0; verts[0].b = 0.0; verts[0].a = 1.0
            verts[1].x = p1x; verts[1].y = p1y
            verts[1].r = 0.0; verts[1].g = 1.0; verts[1].b = 0.0; verts[1].a = 1.0
            verts[2].x = p2x; verts[2].y = p2y
            verts[2].r = 0.0; verts[2].g = 0.0; verts[2].b = 1.0; verts[2].a = 1.0

            r.drawGeometry(verts.to_ptr(), 3, null, 0)
            verts.free()

            // ==================== 4. 虚线/网格 ====================
            r.drawText(font, "虚线 & 网格", 30, 300, 200, 200, 100)

            // 虚线
            r.setColor(150, 200, 255, 200)
            for 0 : 10 to i { r.drawLine(30.0 + _float(i * 15), 340.0, 40.0 + _float(i * 15), 340.0) }

            // 网格（6x6 点阵 + 连线）
            r.setColor(100, 150, 200, 180)
            for 0 : 6 to xi {
                for 0 : 6 to yi {
                    float gx = 200.0 + _float(xi) * 25.0
                    float gy = 340.0 + _float(yi) * 25.0
                    r.drawPoint(gx, gy)
                    // 画网格线
                    if xi < 6 { r.drawLine(gx, gy, gx + 25.0, gy) }
                    if yi < 6 { r.drawLine(gx, gy, gx, gy + 25.0) }
                }
            }

            // ==================== 5. 渐变条 ====================
            r.drawText(font, "渐变", 430, 300, 200, 200, 100)

            for 0 : 20 to i {
                float ratio = _float(i) / 20.0
                int rr = 255 - _int(ratio * 200)
                int gg = _int(ratio * 255)
                int bb = 200
                r.setColor(rr, gg, bb, 255)
                r.fillRect(430.0 + _float(i * 18), 340.0, 18.0, 60.0)
            }

            // 垂直渐变
            for 0 : 30 to i {
                float ratio = _float(i) / 30.0
                int rr = _int(ratio * 255)
                int gg = 100
                int bb = 255 - _int(ratio * 255)
                r.setColor(rr, gg, bb, 255)
                r.drawLine(430.0, 420.0 + _float(i * 2), 790.0, 420.0 + _float(i * 2))
            }

            // ==================== 6. 随机点星场 ====================
            r.setColor(255, 255, 255, 180)
            for 0 : 80 to i {
                var px = 30.0 + _float((i * 137 + angle as int) % 340)
                var py = 470.0 + _float((i * 97 + angle as int) % 100)
                r.drawPoint(px, py)
            }

            // ESC 提示
            r.drawText(font, "ESC 退出", 700, 580, 100, 100, 100)
        }
    )

    if font.ok { font.close() }
    SDL3.ttfQuit()
}
