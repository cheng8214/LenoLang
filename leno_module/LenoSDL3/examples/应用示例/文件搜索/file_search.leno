// file_search.leno — 多线程文件搜索器（测试 threads + UI 交互）
//
// 功能：
//   1. 输入搜索目录和关键词，点击"搜索"启动后台线程递归扫描文件
//   2. 多线程并行搜索：先收集所有子目录，再均匀分配给最多 8 个线程
//   3. 线程通过 channel 实时把匹配结果发回主线程（UI 线程）
//   4. UI 通过 Timer 每 50ms 轮询 channel，非阻塞地获取结果并更新 ListBox
//   5. 搜索完成/取消/统计信息均实时展示
//
// 测试重点：
//   - threads.start() 启动多个工作线程
//   - threads.channel() 线程间通信
//   - channel.try_send() / try_receive() 非阻塞收发
//   - channel.close() / is_closed() 取消信号
//   - thread.state() / join() 线程状态检测与返回值
//
// 重要：Leno 线程创建时深拷贝全局变量，因此全局变量跨线程不可见。
//   - 计数：工作线程用局部变量统计，通过 join() 返回值汇总到主线程
//   - 取消：主线程 close channel，工作线程检测 is_closed() 退出
//   - 完成：主线程用 thread.state() 检测所有线程结束，再 join() 取返回值
//
// 运行：leno file_search.leno
import "../../../lib/SDL3.leno" as SDL3
use SDL3.(Event, Renderer, WindowFlag, Scancode, Timer)
use SDL3.(Window, TitleBar, Edit, Button, ListBox, Label, ProgressBar, HBox, VBox)
import threads
import dirs
import times as ti

// ==================== 全局状态 ====================
Window win
TitleBar titleBar
Edit searchDirEdit
Edit keywordEdit
Button searchBtn
Button stopBtn
ListBox resultBox
Label statusLbl
Label countLbl
ProgressBar progressBar
Timer pollTimer

// 搜索控制（仅主线程读写，不跨线程共享）
var searchChannel = null    // channel: 线程→主线程 发送文件路径
var searchThreads = []      // 活跃线程列表
var searchActive = false    // 是否正在搜索
var totalFound = 0          // 已找到的匹配数（主线程聚合）
var totalScanned = 0        // 已扫描的文件数（主线程聚合）
var expectedThreads = 0     // 预期线程总数
var searchStartTime = 0     // 开始时间（毫秒）

// ==================== 目录收集 ====================

// 递归收集目录下所有子目录（非文件），用于均匀分配给工作线程
// 只展开一层子目录，避免收集阶段耗时过长
func _collect_subdirs(string dir, int depth): Array {
    var result = []

    if depth <= 0 {
        result.add(dir)
        return result
    }

    var entries = null
    try {
        entries = dirs.listdir(dir)
    } catch e {
        result.add(dir)
        return result
    }
    if entries == null {
        result.add(dir)
        return result
    }

    var has_subdir = false
    for entries to entry {
        if entry.starts_with("$") or entry.starts_with(".") { continue }
        var fullpath = dirs.join(dir, entry)
        try {
            if dirs.is_dir(fullpath) {
                has_subdir = true
                // 递归收集子目录
                var sub = _collect_subdirs(fullpath, depth - 1)
                for sub.len() to i {
                    result.add(sub[i])
                }
            }
        } catch e {
            // 跳过权限不足的目录
        }
    }

    // 如果没有子目录，把自己作为工作单元
    if not has_subdir {
        result.add(dir)
    }

    return result
}

// ==================== 工作线程函数 ====================

// 递归扫描目录，返回 [scanned, found]
// 每个目录操作都独立 try-catch，权限错误只跳过当前目录，不影响兄弟目录
func _scan_recursive(any ch, string dir, string keyword): Array {
    var scanned = 0
    var found = 0

    // 取消信号：channel 被主线程关闭
    if ch is Channel {
        if ch.is_closed() { return [0, 0] }
    }

    // listdir 可能因权限不足抛异常
    var entries = null
    try {
        entries = dirs.listdir(dir)
    } catch e {
        return [0, 0]
    }
    if entries == null { return [0, 0] }

    for entries to entry {
        // 取消检查
        if ch is Channel {
            if ch.is_closed() { break }
        }

        // 跳过系统目录和隐藏文件
        if entry.starts_with("$") or entry.starts_with(".") { continue }

        var fullpath = dirs.join(dir, entry)

        // is_dir 可能因权限不足抛异常
        var isDir = false
        try {
            isDir = dirs.is_dir(fullpath)
        } catch e {
            continue
        }

        if isDir {
            // 递归处理子目录，累加子目录的计数
            var sub = _scan_recursive(ch, fullpath, keyword)
            scanned = scanned + _int(sub[0])
            found = found + _int(sub[1])
        } else {
            scanned = scanned + 1

            // 匹配关键词（不区分大小写）
            var matched = false
            if keyword == "" {
                matched = true
            } else {
                var lowerEntry = entry.to_lower()
                var lowerKeyword = keyword.to_lower()
                if lowerEntry.has(lowerKeyword) {
                    matched = true
                }
            }

            if matched {
                found = found + 1
                // 通过 channel 发送匹配结果（try_send 避免关闭后报错）
                if ch is Channel {
                    ch.try_send(fullpath)
                }
            }
        }
    }

    return [scanned, found]
}

// 批量目录搜索线程入口：扫描多个子目录，返回合计 [scanned, found]
func scan_batch_worker(any ch, Array dirs_to_scan, string keyword): Array {
    var total_scanned = 0
    var total_found = 0
    if ch is Channel {
        for dirs_to_scan.len() to i {
            if ch.is_closed() { break }
            string d = _str(dirs_to_scan[i])
            try {
                var result = _scan_recursive(ch, d, keyword)
                total_scanned = total_scanned + _int(result[0])
                total_found = total_found + _int(result[1])
            } catch e {
                // 权限不足等错误，跳过该目录继续下一个
            }
        }
    }
    return [total_scanned, total_found]
}

// ==================== UI 构建 ====================

func setupUI() {
    float PAD = 12.0
    float W = 900.0
    float H = 600.0
    float TOOLBAR_H = 36.0

    // 标题栏
    titleBar = SDL3.createTitleBar({title: "多线程文件搜索 - Leno threads + SDL3 UI", height: 32, font_size: 14})
    win.add(titleBar)
    float titleH = titleBar.get_h()

    // 顶部工具栏（搜索目录 + 关键词 + 按钮）
    var toolbar = SDL3.createHBox({x: PAD, y: titleH + PAD, w: W - PAD * 2, h: TOOLBAR_H, padX: 4, padY: 2, spacing: 6})

    var dirLabel = SDL3.createLabel({x: 0, y: 0, text: "目录:", font_size: 14})
    toolbar.add(dirLabel, {grow: 0, shrink: 0, align: 3})

    searchDirEdit = SDL3.createEdit({x: 0, y: 0, w: 300, h: 28, font_size: 13, placeholder: "搜索目录..."})
    searchDirEdit.set_text(dirs.dirname(dirs.script_dir()))
    toolbar.add(searchDirEdit, {grow: 1, shrink: 1, align: 3})

    var kwLabel = SDL3.createLabel({x: 0, y: 0, text: "关键词:", font_size: 14})
    toolbar.add(kwLabel, {grow: 0, shrink: 0, align: 3})

    keywordEdit = SDL3.createEdit({x: 0, y: 0, w: 150, h: 28, font_size: 13, placeholder: "文件名关键词..."})
    toolbar.add(keywordEdit, {grow: 0, shrink: 0, basis: 150, align: 3})

    searchBtn = SDL3.createButton({x: 0, y: 0, w: 70, h: 28, text: "搜索", font_size: 14})
    toolbar.add(searchBtn, {grow: 0, shrink: 0, basis: 70, align: 3})
    searchBtn.on_click(func() { startSearch() })

    stopBtn = SDL3.createButton({x: 0, y: 0, w: 70, h: 28, text: "停止", font_size: 14})
    toolbar.add(stopBtn, {grow: 0, shrink: 0, basis: 70, align: 3})
    stopBtn.set_enabled(false)
    stopBtn.on_click(func() { stopSearch() })

    // 进度条（搜索中设为 100% 表示活跃，空闲设为 0%）
    progressBar = SDL3.createProgressBar({x: PAD, y: titleH + PAD + TOOLBAR_H + 4, w: W - PAD * 2, h: 6, show_text: false})
    progressBar.set_value(0.0)

    // 状态栏
    var statusBar = SDL3.createHBox({x: PAD, y: titleH + PAD + TOOLBAR_H + 14, w: W - PAD * 2, h: 24, padX: 0, padY: 0, spacing: 12})
    statusLbl = SDL3.createLabel({x: 0, y: 0, text: "就绪 - 输入目录和关键词后点击搜索", font_size: 13})
    statusBar.add(statusLbl, {grow: 1, shrink: 1, align: 1})
    countLbl = SDL3.createLabel({x: 0, y: 0, text: "找到: 0  扫描: 0  线程: 0", font_size: 13})
    statusBar.add(countLbl, {grow: 0, shrink: 0, align: 2})

    // 结果列表
    resultBox = SDL3.createListBox({x: PAD, y: titleH + PAD + TOOLBAR_H + 44, w: W - PAD * 2, h: H - titleH - PAD * 3 - TOOLBAR_H - 44 - PAD, font_size: 13})

    // 设置根布局
    var root = SDL3.createVBox({x: 0, y: 0, w: W, h: H, padX: PAD, padY: PAD, spacing: 4})
    root.add(toolbar, {grow: 0, shrink: 0, align: 3})
    root.add(progressBar, {grow: 0, shrink: 0, align: 3})
    root.add(statusBar, {grow: 0, shrink: 0, align: 3})
    root.add(resultBox, {grow: 1, shrink: 1, align: 3})
    win.setRootAt(root, 0, titleH)
}

// ==================== 匹配检查 ====================

func matchKeyword(string entry, string keyword): bool {
    if keyword == "" { return true }
    var lowerEntry = entry.to_lower()
    var lowerKeyword = keyword.to_lower()
    return lowerEntry.has(lowerKeyword)
}

// ==================== 搜索控制 ====================

func startSearch() {
    if searchActive { return }

    string dirPath = searchDirEdit.get_text()
    string keyword = keywordEdit.get_text()

    if dirPath == "" {
        statusLbl.set_text("错误: 请输入搜索目录")
        SDL3.markFrameRedraw()
        return
    }

    if not dirs.exists(dirPath) or not dirs.is_dir(dirPath) {
        statusLbl.set_text("错误: 目录不存在或不是目录")
        SDL3.markFrameRedraw()
        return
    }

    // 重置状态
    searchActive = true
    totalFound = 0
    totalScanned = 0
    expectedThreads = 0
    searchStartTime = ti.ms()
    searchThreads = []
    resultBox.clear()
    resultBox.add_item("=== 搜索开始 ===")
    resultBox.add_item("目录: " + dirPath)
    if keyword != "" {
        resultBox.add_item("关键词: " + keyword)
    } else {
        resultBox.add_item("关键词: (全部文件)")
    }

    statusLbl.set_text("收集子目录中...")
    SDL3.markFrameRedraw()

    // 创建 channel（大缓冲，减少 try_send 丢弃）
    searchChannel = threads.channel(4096)

    // 递归收集所有子目录（展开 2 层，让大目录树拆分得更均匀）
    var allDirs = _collect_subdirs(dirPath, 2)

    resultBox.add_item("子目录数: " + allDirs.len())
    resultBox.add_item("---")

    var ch = searchChannel

    // 将所有子目录均匀分配给最多 8 个线程
    var maxThreads = 8
    if allDirs.len() < maxThreads { maxThreads = allDirs.len() }
    if maxThreads < 1 { maxThreads = 1 }

    if allDirs.len() == 0 {
        // 没有子目录，单线程搜索整个目录
        var t = threads.start(func(any c, Array dirs_arr, string k): Array {
            return scan_batch_worker(c, dirs_arr, k)
        }, ch, [dirPath], keyword)
        searchThreads.add(t)
        expectedThreads = 1
    } else {
        int perThread = allDirs.len() / maxThreads
        int remainder = allDirs.len() % maxThreads
        int idx = 0

        for maxThreads to i {
            var batch = []
            int count = perThread
            if i < remainder { count = count + 1 }
            for count to j {
                if idx < allDirs.len() {
                    batch.add(allDirs[idx])
                    idx = idx + 1
                }
            }
            if batch.len() == 0 { continue }

            var t = threads.start(func(any c, Array dirs_arr, string k): Array {
                return scan_batch_worker(c, dirs_arr, k)
            }, ch, batch, keyword)
            searchThreads.add(t)
            expectedThreads = expectedThreads + 1
        }
    }

    // 处理顶层文件（主线程直接扫描）
    var topEntries = null
    try {
        topEntries = dirs.listdir(dirPath)
    } catch e {
        topEntries = null
    }
    if topEntries != null {
        for topEntries to entry {
            if entry.starts_with("$") or entry.starts_with(".") { continue }
            var fullpath = dirs.join(dirPath, entry)
            var isDir = false
            try { isDir = dirs.is_dir(fullpath) } catch e { continue }
            if not isDir {
                totalScanned = totalScanned + 1
                if matchKeyword(entry, keyword) {
                    totalFound = totalFound + 1
                    if ch is Channel {
                        ch.try_send(fullpath)
                    }
                }
            }
        }
    }

    statusLbl.set_text("搜索中... " + expectedThreads + " 个线程并行")
    countLbl.set_text("找到: " + totalFound + "  扫描: " + totalScanned + "  线程: " + expectedThreads)
    searchBtn.set_enabled(false)
    stopBtn.set_enabled(true)
    progressBar.set_value(100.0)
    SDL3.markFrameRedraw()
}

func stopSearch() {
    if not searchActive { return }
    if searchChannel is Channel {
        searchChannel.close()
    }
    statusLbl.set_text("正在停止...")
    SDL3.markFrameRedraw()
}

func finishSearch() {
    searchActive = false

    // join 所有线程并获取返回值 [scanned, found]
    for searchThreads.len() to i {
        var t = searchThreads[i]
        if t is Thread {
            try {
                var result = t.join()
                if result is Array {
                    totalScanned = totalScanned + _int(result[0])
                    totalFound = totalFound + _int(result[1])
                }
            } catch e {
                // 线程出错（如权限不足），跳过
            }
        }
    }
    searchThreads = []

    // 排空 channel 中剩余的文件路径
    if searchChannel is Channel {
        var ch = searchChannel
        while ch.len() > 0 {
            var msg = ch.try_receive()
            if msg == null { break }
            string s = _str(msg)
            resultBox.add_item(s)
        }
        searchChannel.close()
    }

    // 计算耗时
    int elapsed = ti.ms() - searchStartTime
    if elapsed < 0 { elapsed = 0 }

    resultBox.add_item("---")
    resultBox.add_item("=== 搜索完成 ===")
    resultBox.add_item("耗时: " + elapsed + "ms  匹配: " + totalFound + "  扫描: " + totalScanned)
    resultBox.scroll_to_bottom()

    statusLbl.set_text("搜索完成 - 耗时 " + elapsed + "ms")
    countLbl.set_text("找到: " + totalFound + "  扫描: " + totalScanned + "  线程: 0")
    searchBtn.set_enabled(true)
    stopBtn.set_enabled(false)
    progressBar.set_value(0.0)
    SDL3.markFrameRedraw()
}

// ==================== 每帧轮询 channel（UI 线程）====================

func pollChannel() {
    if not searchActive { return }

    // 1. 排空 channel 中的文件路径结果
    if searchChannel is Channel {
        var ch = searchChannel
        int received = 0
        int maxPerFrame = 100   // 每帧最多处理 100 条

        while received < maxPerFrame {
            var msg = ch.try_receive()
            if msg == null { break }
            string s = _str(msg)
            resultBox.add_item(s)
            received = received + 1
        }

        if received > 0 {
            resultBox.scroll_to_bottom()
        }
    }

    // 2. 用 thread.state() 检测所有线程是否已完成
    bool allDone = true
    int runningCount = 0
    for searchThreads.len() to i {
        var t = searchThreads[i]
        if t is Thread {
            string st = t.state()
            if st == "running" {
                allDone = false
                runningCount = runningCount + 1
            }
        }
    }

    // 更新计数显示
    countLbl.set_text("找到: " + totalFound + "  扫描: " + totalScanned + "  线程: " + runningCount + "/" + expectedThreads)

    // 3. 所有线程完成 → join 取返回值并结束搜索
    if allDone {
        finishSearch()
    }
}

// ==================== 事件处理 ====================

func handleEvent(Event ev): bool {
    if ev.isQuit() or ev.isWindowClose() { return false }
    if ev.isKeyDown() and ev.scancode() == Scancode.ESCAPE { return false }

    // 回车触发搜索
    if ev.isKeyDown() and ev.scancode() == Scancode.RETURN {
        if keywordEdit.is_focused() or searchDirEdit.is_focused() {
            startSearch()
        }
    }

    return true
}

// ==================== 主函数 ====================

main() {
    win = SDL3.createWindow({title: "多线程文件搜索", w: 900, h: 600, flags: WindowFlag.RESIZABLE})
    if not win.ok { return }

    setupUI()

    // 创建定时器：每 50ms 轮询 channel（UI 线程，非阻塞）
    pollTimer = win.addTimer(50, func() {
        pollChannel()
    })

    win.run(
        func(Event ev): bool { return handleEvent(ev) },
        func(Renderer r) {
            // 定时器回调在主循环中驱动，此处无需额外处理
        }
    )

    // 清理：关闭 channel 通知工作线程停止，再 join 等待退出
    pollTimer.stop()
    if searchChannel is Channel {
        searchChannel.close()
    }
    for searchThreads.len() to i {
        var t = searchThreads[i]
        if t is Thread {
            try { t.join() } catch e {}
        }
    }

    SDL3.quit()
    print("文件搜索器退出")
}
