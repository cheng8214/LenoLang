var MAP_H   = 672.0              // 14 * 48
var WIN_W   = 960                // 与地图同宽（无侧栏，HUD 叠加在地图上下边）
var WIN_H   = 672
var HUD_H   = 34.0               // 顶部状态条高
var BAR_H   = 58.0               // 底部建塔栏高
var BAR_Y   = MAP_H - BAR_H      // 底栏 y
var CARD_W  = 96.0               // 底栏塔卡片宽

// 格子类型
var T_GRASS = 0
var T_PATH  = 1
var T_ROCK  = 2
var T_START = 3
