// Trae 签到（Leno 版 · CLI）—— ②③ 的逻辑在 `trae_core.leno`，本文件只做"参数解析 + 输出格式"
//
// 对标参考件 D:\Leno工程\TraeSign-main\trae-checkin.js —— 算法与流程以它为准：
//   读本机 Trae 登录态 → 派生解密拿 token/dcId → 调 checkin_credits/status|claim → 打印结果
//
// 用法（用**位置子命令**：解释器会先吃掉自己的 `--xxx` 旗标，`--list` 之类会被它当成自己的
// 选项并打印帮助 ✗ ⇒ 这里一律用位置词，另带 `-s/-l/-j/-a` 单横线别名）：
//   leno trae_sign.leno                      # 签到（默认；今天已签到会提示无需重复）
//   leno trae_sign.leno status               # 只查状态，不签到
//   leno trae_sign.leno list                 # 列出各品牌登录态账号（不打印 token）
//   leno trae_sign.leno diag                 # 打印账号/设备ID/token 长度（交叉验证用）
//   leno trae_sign.leno json                 # 结果用一行 JSON 输出（便于脚本调用）
//   leno trae_sign.leno app "Trae CN"        # 指定品牌（缺省取第一个可用）
//
// 安全（与参考件一致）：只**读**登录态文件；**不打印 token**；不修改登录态文件 ✓
//
// 注：逻辑与 GUI（`trae_gui.leno`）**共用** `trae_core.leno` ✓ —— 单一事实来源，
//     避免两套实现漂移（见 `docs/待办_单一事实来源与重复实现收敛.md` ✓）。
import "trae_core.leno" as core

var JSON_MODE = false

func say(string s) {
    // JSON 模式下诊断信息不上 stdout（保持 stdout 只有一行 JSON）✓
    if not JSON_MODE { print(s) }
}

func emit_json(string brand, string username, string ok, string code, string checked, string base, string extra, string msg) {
    print("{\"success\":" + ok
        + ",\"code\":" + code
        + ",\"checked_in\":" + checked
        + ",\"brand\":\"" + brand + "\""
        + ",\"username\":\"" + username + "\""
        + ",\"base\":" + base
        + ",\"extra\":" + extra
        + ",\"message\":\"" + msg + "\"}\n")
}

main() {
    var args = _args()
    var brand = ""
    var mode = "claim"
    int i = 0
    while i < args.len() {
        var a = args[i]
        if a == "status" or a == "-s" { mode = "status" }
        else if a == "list" or a == "-l" { mode = "list" }
        else if a == "diag" or a == "-d" { mode = "diag" }
        else if a == "json" or a == "-j" { mode = "json" }
        else if a == "app" or a == "-a" {
            if i + 1 < args.len() { brand = args[i + 1]; i = i + 1 }
        }
        i = i + 1
    }
    if mode == "json" { JSON_MODE = true; mode = "claim" }

    // ---- list：列出各品牌可用账号 ----
    if mode == "list" {
        var all = core.scan_accounts()
        if JSON_MODE {
            print("{\"accounts\":[")
            int n = 0
            for all to row {
                if n > 0 { print(",") }
                print("{\"brand\":\"" + row[0] + "\",\"username\":\"" + row[1] + "\",\"hasToken\":" + row[2] + "}")
                n = n + 1
            }
            print("]}\n")
        } else {
            if all.len() == 0 {
                print("未找到任何 Trae 登录态。请先在 Trae 桌面端登录（TRAE SOLO CN / Trae CN / TraeWork）。\n")
                _exit(1)
            }
            print("找到 " + (all.len() as string) + " 个登录态（不打印 token）：\n")
            for all to row {
                print("  " + row[0] + "  账号=" + row[1] + "  token=" + row[2] + "\n")
            }
        }
        return
    }

    // ---- 选账号 ----
    Array[string] acc = []
    if brand != "" {
        acc = core.load_account(brand)
    } else {
        acc = core.default_account()
    }
    if acc.len() == 0 {
        if JSON_MODE { emit_json(brand, "", "false", "-1", "false", "null", "null", "未找到登录态，请先用 Trae 桌面端登录") }
        else { print("ERROR: 未找到登录态，请先在 Trae 桌面端登录（TRAE SOLO CN / Trae CN）。\n") }
        _exit(1)
    }
    var acct_brand = acc[0]
    var username = acc[1]
    var token = acc[2]
    var region = acc[3]
    var dc_id = acc[4]
    if token == "" {
        if JSON_MODE { emit_json(acct_brand, username, "false", "-2", "false", "null", "null", "登录态无 token") }
        else { print("ERROR: 登录态里没有 token，请在 Trae 客户端重新登录。\n") }
        _exit(1)
    }
    // ---- diag：与参考实现交叉验证用（只打印可公开的元信息，**不打印 token**）----
    if mode == "diag" {
        print("[leno] 品牌=" + acct_brand + " 账号=" + username
            + " token长度=" + (token.len() as string)
            + " 设备ID=" + dc_id + " region=" + region + "\n")
        return
    }

    // ---- HTTP（所有头必须一次设完 ✓ 见 trae_core.authed_client 的注释）----
    var c = core.authed_client(token, dc_id, region)
    say("品牌: " + acct_brand + "  账号: " + username + "  设备ID: " + dc_id + "\n")

    var st = core.fetch_status(c)
    if core.st_http_err(st) != "" {
        if JSON_MODE { emit_json(acct_brand, username, "false", "-3", "false", "null", "null", "HTTP " + core.st_http_err(st)) }
        else { print("ERROR: 查询状态失败 HTTP " + core.st_http_err(st) + " " + core.st_err(st) + "\n") }
        _exit(1)
    }
    var base = core.st_base(st)
    var extra = core.st_extra(st)
    if not core.st_ok(st) {
        // 诊断（与参考件的 TRAE_CHECKIN_DEBUG 同旨）：打印 HTTP 码与原始响应，便于分辨
        // 「token 过期」/「设备不匹配(9074)」/「本机已被另一账号签到(9095)」等
        if _env("TRAE_CHECKIN_DEBUG") != null {
            print("[debug] HTTP=" + core.st_http_code(st) + " 响应=" + core.st_raw(st) + "\n")
        }
        var msg = core.st_msg(st)
        if JSON_MODE { emit_json(acct_brand, username, "false", "-6", "false", "null", "null", msg) }
        else { print("ERROR: " + msg + "\n") }
        _exit(1)
    }
    var checked = "false"
    if core.st_checked(st) { checked = "true" }
    if checked == "true" {
        if JSON_MODE { emit_json(acct_brand, username, "true", "0", "true", base, extra, "今日已签到") }
        else { print("今日已签到（无需重复）。积分 base=" + base + " extra=" + extra + "\n") }
        return
    }
    if mode == "status" {
        if JSON_MODE { emit_json(acct_brand, username, "true", "0", "false", base, extra, "今日未签到") }
        else { print("今日未签到。积分 base=" + base + " extra=" + extra + "\n") }
        return
    }

    // ---- 签到 ----
    var r = core.do_claim(c)
    if core.cl_http_err(r) != "" {
        if JSON_MODE { emit_json(acct_brand, username, "false", "-3", "false", base, extra, "HTTP " + core.cl_http_err(r)) }
        else { print("ERROR: 签到请求失败 HTTP " + core.cl_http_err(r) + "\n") }
        _exit(1)
    }
    if core.cl_ok(r) {
        var nb = core.cl_base(r)
        var ne = core.cl_extra(r)
        if JSON_MODE { emit_json(acct_brand, username, "true", "0", "true", nb, ne, "签到成功") }
        else { print("签到成功！积分 base=" + nb + " extra=" + ne + "\n") }
        return
    }
    // "-6"：claim 说成功但二次确认说没签到（token 过期导致的"假成功"）⇒ 与旧 CLI/参考件逐字一致 ✓
    if core.cl_code(r) == "-6" {
        var m6 = core.cl_msg(r)
        if JSON_MODE { emit_json(acct_brand, username, "false", "-6", "false", base, extra, m6) }
        else { print("ERROR: " + m6 + "\n") }
        _exit(1)
    }
    if core.cl_code(r) == "9095" {
        var m95 = core.cl_msg(r)
        if JSON_MODE { emit_json(acct_brand, username, "false", "9095", "false", base, extra, m95) }
        else { print(m95 + "\n") }
        _exit(1)
    }
    var mf = core.cl_msg(r)
    if mf == "" { mf = "签到失败" }
    if JSON_MODE { emit_json(acct_brand, username, "false", core.cl_code(r), "false", base, extra, mf) }
    else { print("签到失败：code=" + core.cl_code(r) + " " + mf + "\n") }
    _exit(1)
}
