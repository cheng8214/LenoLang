        bar = win.addMenuBar({x:0, y:0, w:1000, h:MENU_H, font_size:14, image_size:16, image_pad:10, image_gap:6})
        int mFile = bar.addMenu("文件")
        bar.addItem(mFile, {label:"打开目录...", id:"openfolder", image:imgPath("open.png")})
        bar.addItem(mFile, {label:"新建文件夹", id:"newfolder", image:imgPath("new.png")})
        bar.addItem(mFile, {label:"新建文件", id:"newfile", image:imgPath("filetypes/file_1.png")})
        bar.addSeparator(mFile)
        bar.addItem(mFile, {label:"刷新", id:"refresh", image:imgPath("update.png")})
        bar.addSeparator(mFile)
        bar.addItem(mFile, {label:"退出", id:"exit", image:imgPath("exit.png")})
        mEditId = bar.addMenu("编辑")
        bar.addItem(mEditId, {label:"复制", id:"copy", image:imgPath("copy.png")})
        bar.addItem(mEditId, {label:"剪切", id:"cut", image:imgPath("jianqie.png")})
        bar.addItem(mEditId, {label:"粘贴", id:"paste", image:imgPath("zhantie.png")})
        bar.addSeparator(mEditId)
        bar.addItem(mEditId, {label:"删除", id:"del", image:imgPath("delete.png")})
        bar.setItemEnabled(mEditId, "paste", false)
        mBookmarkId = bar.addMenu("书签")
        int mView = bar.addMenu("视图")
        bar.addItem(mView, {label:"刷新", shortcut:"F5", id:"refresh", image:imgPath("update.png")})
        bar.addItem(mView, {label:"向上", shortcut:"Backspace", id:"up", image:imgPath("filetypes/folder_1.png")})
        int mHelp = bar.addMenu("帮助")
        bar.addItem(mHelp, {label:"关于", id:"about", image:imgPath("about.png")})
        bar.on_select(func(string menu, string id) { onMenuSelect(menu, id) })
    }

    // ===================== UI 构建：工具栏 =====================

    func setupToolbar() {
        toolbar = SDL3.createHBox({x:0, y:0, w:100, h:TOOLBAR_H, padX:4, padY:2, spacing:4})
        mainLayout.add(toolbar, {grow:0, shrink:0, basis:TOOLBAR_H, align:3})

        pathCombo = SDL3.createComboBox({x:0, y:0, w:300, h:28, font_size:14, placeholder:"选择或浏览目录...", popup_h:300, bg_rgb:[20,22,28], text_rgb:[235,240,255]})
        toolbar.add(pathCombo, {grow:1, shrink:1, align:3})
        pathCombo.on_change(func(int idx) { onComboChange(idx) })

        var btnOpen = iconBtn("open.png")
        toolbar.add(btnOpen, {grow:0, shrink:0, basis:32, align:3})
        btnOpen.set_tip("打开选中项"); btnOpen.on_click(func() { openSelected() })

        btnBack = iconBtn("last.png")
        toolbar.add(btnBack, {grow:0, shrink:0, basis:32, align:3})
        btnBack.set_tip("后退"); btnBack.on_click(func() { goBack() })

        btnForward = iconBtn("next.png")
        toolbar.add(btnForward, {grow:0, shrink:0, basis:32, align:3})
        btnForward.set_tip("前进"); btnForward.on_click(func() { goForward() })

        var btnRefresh = iconBtn("update.png")
        toolbar.add(btnRefresh, {grow:0, shrink:0, basis:32, align:3})
        btnRefresh.set_tip("刷新"); btnRefresh.on_click(func() { openDir(curDir) })
    }

    // ===================== UI 构建：导航面板 =====================

    func setupNavPanel() {
        navPanel = SDL3.createPanel({x:0, y:0, w:NAV_W, h:100, bg_rgb:[26,28,36], border_rgb:[70,75,92], radius:8})
        content.set_first(navPanel)

        navVBox = SDL3.createVBox({x:0, y:0, w:100, h:100, padX:PAD, padY:PAD, spacing:6})
        navPanel.setLayoutPadded(navVBox, PAD)

        var navTitle = SDL3.createLabel({x:0, y:0, text:"导航", font_size:14, text_rgb:[150,200,255]})
        navVBox.add(navTitle, {grow:0, shrink:0, align:0})

        pathSearch = SDL3.createEdit({x:0, y:0, w:100, h:26, font_size:13, placeholder:"搜索当前目录…", bg_rgb:[18,20,26], text_rgb:[230,235,245]})
        navVBox.add(pathSearch, {grow:0, shrink:0, align:3})
        pathSearch.on_change(func() { onSearchChange() })
        pathSearch.on_enter(func() { onSearchEnter() })

        navToolbar = SDL3.createHBox({x:0, y:0, w:100, h:26, padX:0, padY:0, spacing:4})
        navVBox.add(navToolbar, {grow:0, shrink:0, align:3})

        btnNew = navBtn("new.png")
        navToolbar.add(btnNew, {grow:1, shrink:1, align:3})
        btnNew.set_tip("新建文件夹"); btnNew.on_click(func() { newFolder() })

        btnRefresh = navBtn("update.png")
        navToolbar.add(btnRefresh, {grow:1, shrink:1, align:3})
        btnRefresh.set_tip("刷新"); btnRefresh.on_click(func() { openDir(curDir) })

        btnToggle = navBtn("zhetie.png")
        navToolbar.add(btnToggle, {grow:1, shrink:1, align:3})
        btnToggle.set_tip("折叠/展开导航树"); btnToggle.on_click(func() { onToggleTree() })

        tree = SDL3.createTreeView({x:0, y:0, w:100, h:100, font_size:14, image_size:16, image_gap:4})
        navVBox.add(tree, {grow:1, shrink:1, align:3})
        tree.on_change(func(Array[int] ids) { onTreeChange(ids) })
        tree.on_toggle(func(int id, bool expanded) { onTreeToggle(id, expanded) })
    }

    // ===================== UI 构建：文件列表表格 =====================

    func setupTable() {
        table = SDL3.createTable({
            x:0, y:0, w:100, h:100,
            headers:["名称","大小","类型"],
            col_widths:[380,140,140],
            sortable:true, zebra:true, row_h:24, header_h:28, font_size:14,
            image_col:0, image_size:18, image_pad:4, image_gap:4
        })
        content.set_second(table)
        table.on_select(func(int row) { onTableSelect(row) })
        table.on_context_will_open(func(int row) { onContextWillOpen(row) })
        table.on_context_select(func(int row, string id) { onContextSelect(row, id) })
        table.on_edit_commit(func(int row, int col, string text) { onEditCommit(row, col, text) })
        table.set_editable(false)
        table.set_multi_select(true)   // ★ 开启多选：Ctrl+点击切换 / Shift+点击范围选择
        table.on_dbl_click(func(int row, int col) { onTableDblClick(row, col) })
    }

    // ===================== 键盘快捷键处理 =====================
    // 返回 true = 继续运行主循环，返回 false = 退出程序

    func handleKeyboard(Event ev): bool {
        if wantQuit or ev.isQuit() { return false }

        // ★ 安全兜底：模态对话框关闭后可能残留 _dragPending 状态
        //   （左键点击菜单项时误触发），在非左键按下/非拖拽移动事件时强制清除
        if _dragPending and not ev.isMouseButtonDown() and not (ev.isMouseMotion() and _dragging) {
            _dragPending = false
            _dragging = false
            _dragPaths = []
        }

        // ==================== 拖拽逻辑 ====================
        // 鼠标按下 Table 时记录起点，等待移动阈值触发拖拽
        // ★ 排除弹层（菜单/下拉框）打开时的点击：左键点击右键菜单项时，
        //   鼠标位置仍在 Table 区域内，但此时应由菜单处理点击而非触发拖拽。
        if ev.isMouseButtonDown() and ev.mouseButton() == 1 {
            if table.contains(ev.mouseX(), ev.mouseY()) and not core.inPopupCapture(ev.mouseX(), ev.mouseY()) {
                _dragStartX = ev.mouseX()
                _dragStartY = ev.mouseY()
                _dragPending = true
                _dragging = false
                _dragTargetNode = -1
            }
        }

        // 鼠标移动：超过阈值进入拖拽模式，追踪 TreeView 放置目标
        if ev.isMouseMotion() and _dragPending and not _dragging {
            float dx = ev.mouseX() - _dragStartX
            float dy = ev.mouseY() - _dragStartY
            if (dx * dx + dy * dy) > 25.0 {
                _dragPaths = getSelectedPaths()
if _dragPaths.len() > 0 {
_dragging = true
_dragMouseX = ev.mouseX()
_dragMouseY = ev.mouseY()
// 构建浮动框显示文字
if _dragPaths.len() == 1 {
_dragLabel = dirs.basename(_dragPaths[0])
} else {
_dragLabel = dirs.basename(_dragPaths[0]) + "  (+" + (_dragPaths.len() - 1) + ")"
}
statusLbl.set_text("拖拽 " + _dragPaths.len() + " 项…")
}
            }
        }

if ev.isMouseMotion() and _dragging {
_dragMouseX = ev.mouseX()
_dragMouseY = ev.mouseY()
core.markFrameRedraw()   // 拖拽浮动框跟随鼠标，每帧重绘
if tree.contains(ev.mouseX(), ev.mouseY()) {
int nodeId = tree._id_at(ev.mouseX(), ev.mouseY())
if nodeId >= 0 {
string tp = nodeType(nodeId)
if tp == "folder" or tp == "drive" {
_dragTargetNode = nodeId
} else {
_dragTargetNode = -1
}
} else {
_dragTargetNode = -1
}
} else {
_dragTargetNode = -1
}
}

        // 鼠标释放：在 TreeView 文件夹上释放则执行移动
        if ev.isMouseButtonUp() and ev.mouseButton() == 1 {
            if _dragging and _dragTargetNode >= 0 {
                string targetPath = nodePath(_dragTargetNode)
                if targetPath != "" and dirs.is_dir(targetPath) {
                    moveFilesTo(targetPath)
                }
            }
            _dragging = false
            _dragPending = false
            _dragPaths = []
            _dragTargetNode = -1
        }

        // ==================== 键盘快捷键 ====================
        if ev.isKeyDown() and not pathSearch.is_focused() {
            int sc = ev.scancode()
            int mod = ev.keyMod()
            bool ctrl = (mod & 64) != 0 or (mod & 128) != 0
            if sc == core.Scancode.F5 { openDir(curDir); return true }
            if sc == core.Scancode.F2 {
                int sr = table.get_selected_row()
                if sr >= 0 and sr < table.row_count() {
                    var r = table.get_row(sr)
                    if r.len() >= 5 {
                        renameOldPath = r[3]
                        table.begin_edit(sr, 0)
                    }
                }
                return true
            }
            if sc == core.Scancode.BACKSPACE { goUp(); return true }
            if sc == core.Scancode.DELETE {
                // ★ 批量删除：优先检查多选
                Array[int] selRows = table.get_selected_rows()
                if selRows.len() > 1 {
                    doDeletePath("", false)
                } eif selPath != "" {
                    doDeletePath(selPath, selIsDir)
                }
                return true
            }
            if ctrl and sc == core.Scancode.C { doCopy(""); return true }
            if ctrl and sc == core.Scancode.X { doCut(""); return true }
            if ctrl and sc == core.Scancode.V { doPaste(); return true }
        }
        return true
    }

    // ===================== 主入口 =====================

    func run() {
        SDL3.ttfInit()
        int flags = 0x20 | 0x80  // RESIZABLE(0x20) | MAXIMIZED(0x80)
        win = SDL3.createWindow({title:"LenoSDL3 文件管理器", w:1000, h:680, flags:flags})
        if not win.ok { SDL3.ttfQuit(); return }
        win.setMinSize(640, 400)

        imgDir = dirs.join(dirs.script_dir(), "images")

        setupMenuBar()
        loadBookmarks()
        refreshBookmarkMenu()

        mainLayout = SDL3.createVBox({x:0, y:MENU_H, w:1000, h:680-MENU_H, padX:PAD, padY:PAD, spacing:4})
        win.setRootAt(mainLayout, 0, MENU_H)

        setupToolbar()

        content = SDL3.createSplitter({x:0, y:0, w:0, h:0, orientation:0, ratio:0.3, min_first:120, min_second:300, divider_width:4, hit_pad:4})
        mainLayout.add(content, {grow:1, shrink:1, align:3})

        setupNavPanel()
        setupTable()

        statusLbl = SDL3.createLabel({x:0, y:0, text:"就绪", font_size:13, text_rgb:[170,200,170]})
        mainLayout.add(statusLbl, {grow:0, shrink:0, basis:STATUS_H, align:0})

        // 初始化导航树
        regCounter = 1
        nodePaths = []
        nodeTypes = []
        loadedIds = []
        history = []
        histIndex = -1
        treeExpanded = true
        var navRoots = buildNavRoots()
        tree.set_items(navRoots)
        regDicts(navRoots)
        loadPcDrives()
        openDir(dirs.dirname(dirs.script_dir()))
        updateNavButtons()

// 叠加层回调：拖拽浮动框在所有控件/弹层之上绘制
// （原 render 回调在控件渲染之前调用，会被 Table/TreeView 等覆盖，导致不可见）
win.setOverlay(func(Renderer r) {
    if _dragging and _dragLabel != "" {
        statusLbl._ensure_font()
        Font? f = statusLbl._font
        if f != null and f.ok {
            StringSize sz = f.measureString(_dragLabel)
            float padX = 10.0; float padY = 5.0
            float boxW = sz.w + padX * 2.0
            float boxH = sz.h + padY * 2.0
            float bx = _dragMouseX + 14.0
            float by = _dragMouseY + 14.0
            float radius = 4.0
            // 半透明圆角背景
            r.setColor(30, 60, 120, 220)
            r.fillRoundedRect(bx, by, boxW, boxH, radius)
            // 圆角边框
            r.setColor(80, 140, 220, 255)
            r.drawRoundedRect(bx, by, boxW, boxH, radius)
            // 文字
            r.drawText(f, _dragLabel, bx + padX, by + padY, 255, 255, 255)
        }
    }
})

win.run(
    func(Event ev): bool { return handleKeyboard(ev) },
    func(Renderer r) { }   // 渲染回调（控件渲染前调用，拖拽浮动框已移至 setOverlay）
)
        SDL3.ttfQuit()
    }
}

// ===================== 程序入口 =====================
main() {
    FileManager fm = new FileManager()
    fm.run()
}
