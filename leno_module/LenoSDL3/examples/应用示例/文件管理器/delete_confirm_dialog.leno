// delete_confirm_dialog.leno — 删除确认对话框（模态窗口，VBox/HBox 自动布局）
// 用法：
//   delete_confirm.show(path, isDir, onConfirm)       — 单项删除确认
//   delete_confirm.showBatch(count, onConfirm)         — 批量删除确认
import "../../../lib/SDL3.leno" as SDL3
import "../../../lib/sdl_core.leno" as core
import dirs
use SDL3.Event
use SDL3.Renderer
use SDL3.VBox
use SDL3.HBox
use SDL3.Label
use SDL3.Button
use SDL3.Widget
use SDL3.Scancode

// 显示删除确认对话框（单项），用户确认后回调 onConfirm
export func show(string path, bool isDir, func():void onConfirm) {
    string nm = dirs.basename(path)
    string kind = if isDir then "文件夹" else "文件"

    var dlg = SDL3.createDialogWindow({title:"确认删除 — " + nm, w:440, h:220})
    VBox root = SDL3.createVBox({x:0, y:0, w:440, h:220, padX:40, padY:18, spacing:8})
    dlg.setRoot(root)

    // ★ 居中 label 用 align:1 添加到 VBox（dialogLabel 内部用 w:1 让 VBox 定位到中心）
    root.add(SDL3.dialogLabel("确认删除", 16, 255, 130, 100, 1), {grow:0, shrink:0, align:1})
    root.add(SDL3.dialogLabel("确定要删除以下" + kind + "吗？此操作无法撤销。", 13, 200, 210, 225, 1), {grow:0, shrink:0, align:1})
    // ★ 属性行用 align:3(stretch) 撑满宽度，value 自动截断
    root.add(SDL3.dialogPropRow("名称:", nm, 280), {grow:0, shrink:0, align:3})
    root.add(SDL3.dialogPropRow("类型:", kind, 280), {grow:0, shrink:0, align:3})
    root.add(SDL3.dialogPropRow("路径:", path, 280), {grow:0, shrink:0, align:3})

    // 弹性间隔 + 按钮行
    root.add(SDL3.dialogSpacer(), {grow:1, shrink:1, align:0})

    // ★ 按钮行用 align:3(stretch) 撑满宽度，HBox justify:1 居中按钮
    Button btnDel = SDL3.createButton({x:0, y:0, w:100, h:34, text:"删除", bg_rgb:[220,70,70], text_rgb:[255,255,255]})
    Button btnCancel = SDL3.createButton({x:0, y:0, w:100, h:34, text:"取消", bg_rgb:[60,66,80], text_rgb:[220,230,245]})
    HBox btnRow = SDL3.dialogButtonRow([btnDel, btnCancel], 16)
    root.add(btnRow, {grow:0, shrink:0, align:3})

    var shouldClose = false
    btnCancel.on_click(func() { shouldClose = true })
    btnDel.on_click(func() {
        shouldClose = true
        if onConfirm != null { onConfirm() }
    })

    SDL3.runModal(dlg,
        func(Event ev): bool {
            if ev.isQuit() or ev.isWindowClose() { return false }
            if ev.isKeyDown() and ev.scancode() == Scancode.ESCAPE { return false }
            if shouldClose { return false }
            return true
        },
        func(Renderer r) { r.clearColor(30, 33, 42, 255) }
    )
}

// 显示批量删除确认对话框，用户确认后回调 onConfirm
export func showBatch(int count, func():void onConfirm) {
    var dlg = SDL3.createDialogWindow({title:"确认批量删除", w:400, h:180})
    VBox root = SDL3.createVBox({x:0, y:0, w:400, h:180, padX:40, padY:20, spacing:10})
    dlg.setRoot(root)

    root.add(SDL3.dialogLabel("确认批量删除", 16, 255, 130, 100, 1), {grow:0, shrink:0, align:1})
    root.add(SDL3.dialogLabel("确定要删除选中的 " + count + " 个项目吗？", 14, 200, 210, 225, 1), {grow:0, shrink:0, align:1})
    root.add(SDL3.dialogLabel("此操作无法撤销。", 13, 180, 190, 200, 1), {grow:0, shrink:0, align:1})

    root.add(SDL3.dialogSpacer(), {grow:1, shrink:1, align:0})

    Button btnDel = SDL3.createButton({x:0, y:0, w:110, h:34, text:"全部删除", bg_rgb:[220,70,70], text_rgb:[255,255,255]})
    Button btnCancel = SDL3.createButton({x:0, y:0, w:100, h:34, text:"取消", bg_rgb:[60,66,80], text_rgb:[220,230,245]})
    HBox btnRow = SDL3.dialogButtonRow([btnDel, btnCancel], 16)
    root.add(btnRow, {grow:0, shrink:0, align:3})

    var shouldClose = false
    btnCancel.on_click(func() { shouldClose = true })
    btnDel.on_click(func() {
        shouldClose = true
        if onConfirm != null { onConfirm() }
    })

    SDL3.runModal(dlg,
        func(Event ev): bool {
            if ev.isQuit() or ev.isWindowClose() { return false }
            if ev.isKeyDown() and ev.scancode() == Scancode.ESCAPE { return false }
            if shouldClose { return false }
            return true
        },
        func(Renderer r) { r.clearColor(30, 33, 42, 255) }
    )
}
