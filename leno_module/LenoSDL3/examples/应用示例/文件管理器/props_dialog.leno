// props_dialog.leno — 文件/文件夹属性对话框（模态窗口，自动布局版）
// 用法：props.show(path, isDir)
import "../../../lib/SDL3.leno" as SDL3
import "../../../lib/sdl_core.leno" as core
import "../../../lib/sdl_theme.leno" as theme
import dirs
use SDL3.Event
use SDL3.Renderer
use SDL3.VBox
use SDL3.HBox
use SDL3.Label
use SDL3.Button
use SDL3.Widget
use SDL3.Scancode

// 人类可读大小
func fmtSize(int b): string {
    if b < 1024 { return b + " B" }
    float kb = _float(b) / 1024.0
    if kb < 1024.0 { return _int(kb) + " KB" }
    float mb = kb / 1024.0
    if mb < 1024.0 { return _int(mb) + " MB" }
    float gb = mb / 1024.0
    return _int(gb) + " GB"
}

bool _shouldClose = false

// 显示属性对话框
export func show(string path, bool isDir) {
    string nm = dirs.basename(path)
    string dir = dirs.dirname(path)
    var st = dirs.stat(path)

    int szb = _int(st.get("size", 0))
    string szStr = fmtSize(szb) + " (" + szb + " 字节)"

    string ext = dirs.extname(nm)
    string kind
    if isDir {
        kind = "文件夹"
    } else {
        string e = ext
        if e.len() > 1 { e = e.slice(1, e.len()) }
        kind = if e != "" then ("文件 " + e) else "文件"
    }

    int mt = _int(st.get("mtime", 0))
    string mtStr = if mt > 0 then (mt as string) else "N/A"

    bool exists = _bool(st.get("exists", false))
    string existStr = if exists then "是" else "否"
    string accessStr = if exists then "可访问" else "无法访问（可能已被移动或删除）"

    _shouldClose = false

    float dlgW = 470.0
    float dlgH = 380.0
    float padX = 30.0
    float innerW = dlgW - padX * 2.0   // 410
    float propMaxW = innerW - 80.0 - 8.0  // label列80 + spacing8 = 322

    var dlg = SDL3.createDialogWindow({title:"属性 - " + nm, w:dlgW, h:dlgH})
    VBox root = SDL3.createVBox({x:0, y:0, w:dlgW, h:dlgH, padX:padX, padY:16, spacing:6})
    dlg.setRoot(root)

    // ★ 标题居中：dialogLabel(align:1) 内部用 w:1，VBox align:1 定位到中心
    root.add(SDL3.dialogLabel("文件属性", 16), {grow:0, shrink:0, align:1})

    // ★ 属性行用 dialogPropRow，max_w 实现自动截断
    root.add(SDL3.dialogPropRow("名称:", nm, propMaxW), {grow:0, shrink:0, align:3})
    root.add(SDL3.dialogPropRow("类型:", kind, propMaxW), {grow:0, shrink:0, align:3})
    root.add(SDL3.dialogPropRow("位置:", dir, propMaxW), {grow:0, shrink:0, align:3})
    root.add(SDL3.dialogPropRow("大小:", szStr, propMaxW), {grow:0, shrink:0, align:3})
    root.add(SDL3.dialogPropRow("修改时间:", mtStr, propMaxW), {grow:0, shrink:0, align:3})
    root.add(SDL3.dialogPropRow("是否存在:", existStr, propMaxW), {grow:0, shrink:0, align:3})
    root.add(SDL3.dialogPropRow("完整路径:", path, propMaxW), {grow:0, shrink:0, align:3})

    // 访问状态行（颜色按存在性变化，手动创建以支持自定义颜色 + 截断）
    // ★ w:1 让 VBox align:3(stretch) 自动撑满
    HBox accessRow = SDL3.createHBox({x:0, y:0, w:1, h:22, padX:0, padY:0, spacing:8})
    Label al = SDL3.createLabel({x:0, y:0, w:80, h:22, text:"访问状态:", font_size:13})
    // 访问状态值：存在=绿色调，不存在=红色调（这些是语义色，不随主题变）
    int accessR = if exists then 80 else 220
    int accessG = if exists then 200 else 60
    int accessB = if exists then 100 else 60
    Label av = SDL3.createLabel({x:0, y:0, w:260, h:22, text:accessStr, font_size:13, text_rgb:[accessR,accessG,accessB], max_w:propMaxW, truncate:2})
    accessRow.add(al, {grow:0, shrink:0, basis:80, align:0})
    accessRow.add(av, {grow:1, shrink:1, align:0})
    root.add(accessRow, {grow:0, shrink:0, align:3})

    // 弹性间隔
    root.add(SDL3.dialogSpacer(), {grow:1, shrink:1, align:0})

    // ★ 确定按钮居中：dialogButtonRow + VBox align:3(stretch)
    Button btnOk = SDL3.createButton({x:0, y:0, w:100, h:34, text:"确定", type:"primary"})
    HBox btnRow = SDL3.dialogButtonRow([btnOk], 0)
    root.add(btnRow, {grow:0, shrink:0, align:3})

    btnOk.on_click(func() { _shouldClose = true })

    SDL3.runModal(dlg,
        func(Event ev): bool {
            if ev.isQuit() or ev.isWindowClose() { return false }
            if ev.isKeyDown() and ev.scancode() == Scancode.ESCAPE { return false }
            if _shouldClose { return false }
            return true
        },
        func(Renderer r) { var th = theme.getTheme(); r.clearColor(th.bgR, th.bgG, th.bgB, 255) }
    )
}
