// pe_analyzer.leno — Leno PE 分析器（可视化界面版）
//
// 基于 SDL3 GUI 的 PE/EXE 文件分析器，支持：
//   1. 通过文件对话框选择 .exe/.dll 文件
//   2. 解析 DOS 头、PE 头、节区表、导入表
//   3. 检测 LENB 尾部附加数据（Leno 编译器生成的元信息）
//   4. XOR(LENO) 加密字符串搜索与解密
//   5. LENB 字节码反汇编(显示 opcode、常量池、跳转目标、行号)
//
// 布局结构：
//   Window
//   ├── TitleBar（自绘标题栏）
//   └── VBox root
//       ├── HBox toolbar（浏览按钮 + 文件路径标签 + 分析按钮）
//       ├── TabControl（8 个页签：概览 / DOS头 / PE头 / 节区 / 导入表 / LENB / XOR字符串 / 反汇编）
//       │   ├── 概览页：ListBox 显示文件基本信息和关键数据
//       │   ├── DOS头页：Table 显示 DOS 头各字段
//       │   ├── PE头页：Table 显示 PE/可选头各字段
//       │   ├── 节区页：Table 显示各节区信息
//       │   ├── 导入表页：Table 显示导入的 DLL 和函数
//       │   ├── LENB页：ListBox 显示 LENB 尾部元信息
//       │   ├── XOR字符串页：Table 显示解密后的字符串
//       │   └── 反汇编页：ListBox 显示 opcode、常量池、跳转目标、行号
//       └── Label statusLbl（底部状态栏）
//
// 运行：leno pe_analyzer.leno
import "../../../lib/SDL3.leno" as SDL3
import "../../../lib/sdl_filedialog.leno" as fdlg
use SDL3.(Event, Renderer, Window, WindowFlag, TitleBar, Scancode)
use SDL3.(Button, Label, ListBox, Table, HBox, VBox, TabControl)
import files
import strings
import dirs

// ==================== PE 解析常量 ====================

const LENB_MAGIC = 0x424E454C  // "LENB" little-endian
const DOS_MAGIC  = 0x5A4D      // "MZ" little-endian
const PE_MAGIC   = 0x00004550  // "PE\0\0" little-endian

// 16 进制字符表
const HEX_CHARS = "0123456789ABCDEF"

// XOR 密钥 "LENO" = 0x4C, 0x45, 0x4E, 0x4F
func xorKey(int i): int {
    if i == 0 { return 0x4C }
    if i == 1 { return 0x45 }
    if i == 2 { return 0x4E }
    return 0x4F
}

// ==================== 二进制读取工具函数 ====================

// 从 string 的指定偏移读取 4 字节小端 uint32
func readU32(string data, int off): int {
    int val = 0
    for 0:3 to i {
        val = val | (data.byte(off + i) << (i * 8))
    }
    return val
}

// 从 string 的指定偏移读取 2 字节小端 uint16
func readU16(string data, int off): int {
    return data.byte(off) | (data.byte(off + 1) << 8)
}

// 从 string 的指定偏移读取 1 字节
func readU8(string data, int off): int {
    return data.byte(off)
}

// ==================== 格式化工具函数 ====================

// 格式化为 8 位 hex（无 0x 前缀，用于拼接）
func toHex8(int v): string {
    string s = ""
    for 7:0:-1 to i {
        int nibble = (v >> (i * 4)) & 0xF
        s = s + HEX_CHARS[nibble]
    }
    return s
}

// 格式化为 4 位 hex（无 0x 前缀，用于拼接）
func toHex4(int v): string {
    string s = ""
    for 3:0:-1 to i {
        int nibble = (v >> (i * 4)) & 0xF
        s = s + HEX_CHARS[nibble]
    }
    return s
}

// 格式化为 2 位 hex（无前缀）
func toHex2(int v): string {
    int hi = (v >> 4) & 0xF
    int lo = v & 0xF
    return HEX_CHARS[hi] + HEX_CHARS[lo]
}

// 人类可读文件大小
func fmtSize(int b): string {
    if b < 1024 { return b + " B" }
    float kb = _float(b) / 1024.0
    if kb < 1024.0 { return _int(kb) + " KB" }
    float mb = kb / 1024.0
    if mb < 1024.0 { return _int(mb) + " MB" }
    float gb = mb / 1024.0
    int gbInt = _int(gb)
    int tenths = _int((gb - _float(gbInt)) * 10.0)
    if tenths == 0 { return gbInt + " GB" }
    return gbInt + "." + tenths + " GB"
}

// 根据节区特征值返回可读名称
func sectionFlagsName(int flags): string {
    Array[string] parts = []
    if (flags & 0x20000000) != 0 { parts.add("X") }
    if (flags & 0x40000000) != 0 { parts.add("R") }
    if (flags & 0x80000000) != 0 { parts.add("W") }
    if (flags & 0x20) != 0 { parts.add("CODE") }
    if (flags & 0x40) != 0 { parts.add("IDATA") }
    if (flags & 0x80) != 0 { parts.add("UDATA") }
    return parts.join("/")
}

// 根据子系统值返回可读名称
func subsystemName(int sub): string {
    switch sub {
        case 0 { return "未知" }
        case 1 { return "原生" }
        case 2 { return "Windows GUI" }
        case 3 { return "Windows 控制台" }
        case 5 { return "OS/2 字符" }
        case 7 { return "Posix 字符" }
        case 9 { return "Windows CE GUI" }
        case 10 { return "EFI 应用" }
        case 11 { return "EFI 启动服务" }
        case 12 { return "EFI 运行时" }
        case 13 { return "EFI ROM" }
        case 14 { return "XBOX" }
    }
    return "其他(" + sub + ")"
}

// 根据机器类型返回可读名称
func machineName(int mach): string {
    switch mach {
        case 0x014C { return "x86 (i386)" }
        case 0x0200 { return "Intel Itanium" }
        case 0x8664 { return "x64 (AMD64)" }
        case 0x01C0 { return "ARM" }
        case 0xAA64 { return "ARM64" }
    }
    return "未知(0x" + toHex4(mach) + ")"
}

// ==================== PE 分析器结构体 ====================

struct PEAnalyzer {
    // ===== 布局常量 =====
    float PAD = 8.0

    // ===== UI 控件引用 =====
    Window      win
    TitleBar    titleBar
    Button      browseBtn
    Button      analyzeBtn
    Label       fileLbl
    Label       statusLbl
    TabControl  tab

    // 各页的展示控件
    ListBox     overviewBox    // 概览
    Table       dosTable       // DOS 头
    Table       peTable        // PE 头
    Table       sectionTable   // 节区
    Table       importTable    // 导入表
    ListBox     lenbBox        // LENB 信息
    Table       xorTable       // XOR 字符串
    ListBox     disasmBox      // 反汇编输出

    // ===== 分析状态 =====
    string filePath = ""
    string fileData  = ""    // 文件二进制数据
    int    fileSize  = 0
    bool   analyzed  = false

    // PE 解析结果缓存
    int dosHeaderOff = 0       // DOS 头偏移（通常为 0）
    int peHeaderOff  = 0       // PE 头偏移（e_lfanew）
    int optHeaderOff = 0       // 可选头偏移
    int sectionTableOff = 0    // 节区表偏移
    int sectionCount = 0       // 节区数量
    int is64bit = 0            // 是否 64 位（0x20B1 vs 0x010B）

    // 反汇编器全局状态
    int gLenbOff = 0           // LENB blob 起始偏移（绝对）
    int gLenbPos = 0           // 当前解析位置（绝对）
    int gLenbEnd = 0           // LENB 结束位置（绝对）
    int gDepth   = 0           // 递归深度限制
    Array[string] gLines = []  // 反汇编行累加器

    // ==================== RVA 转文件偏移 ====================

    func rvaToOffset(int rva): int {
        int secSize = 40
        for sectionCount to i {
            int off = sectionTableOff + i * secSize
            if off + secSize > fileSize { break }
            int virtSize = readU32(fileData, off + 8)
            int virtAddr = readU32(fileData, off + 12)
            int rawOff   = readU32(fileData, off + 20)
            if rva >= virtAddr and rva < virtAddr + virtSize {
                return rawOff + (rva - virtAddr)
            }
        }
        return 0
    }

    // 从文件偏移读取 C 字符串（以 \0 结尾，最多 maxLen 字节）
    func readCString(int fileOff, int maxLen): string {
        string s = ""
        int i = 0
        while i < maxLen and fileOff + i < fileSize {
            int b = fileData.byte(fileOff + i)
            if b == 0 { break }
            // 只显示可打印 ASCII 和扩展字符
            if b >= 0x20 and b <= 0x7E {
                s = s + strings.char(b)
            } else {
                s = s + "."
            }
            i = i + 1
        }
        return s
    }

    // ==================== UI 构建 ====================

    func setupUI() {
        // 标题栏
        titleBar = SDL3.createTitleBar({title: "Leno PE 分析器", height: 32, font_size: 14})
        win.add(titleBar)
        float titleH = titleBar.get_h()

        // 顶部工具栏
        var toolbar = SDL3.createHBox({h: 36, padX: 4, padY: 2, spacing: 6})

        browseBtn = SDL3.createButton({w: 80, h: 28, text: "浏览...", font_size: 14})
        toolbar.add(browseBtn, {grow: 0, shrink: 0, basis: 80, align: 3})
        browseBtn.on_click(func() { onBrowse() })

        fileLbl = SDL3.createLabel({text: "文件: (未选择)", font_size: 13})
        toolbar.add(fileLbl, {grow: 1, shrink: 1, align: 3})

        analyzeBtn = SDL3.createButton({w: 70, h: 28, text: "分析", font_size: 14})
        toolbar.add(analyzeBtn, {grow: 0, shrink: 0, basis: 70, align: 3})
        analyzeBtn.set_enabled(false)
        analyzeBtn.on_click(func() { onAnalyze() })

        // 选项卡容器
        tab = SDL3.createTabControl({
            tabs: ["概览", "DOS 头", "PE 头", "节区", "导入表", "LENB", "XOR 字符串", "反汇编"],
            active: 0,
            font_size: 14
        })

        // ===== 各页内容 =====

        // 概览页 - ListBox
        overviewBox = SDL3.createListBox({font_size: 13})
        var overviewLayout = SDL3.createVBox({padX: PAD, padY: PAD, spacing: 0})
        overviewLayout.add(overviewBox, {grow: 1, shrink: 1, align: 3})
        tab.setPageLayout(0, overviewLayout)

        // DOS 头页 - Table
        dosTable = SDL3.createTable({
            headers: ["字段", "值", "说明"],
            col_widths: [180.0, 200.0, 400.0],
            sortable: false, zebra: true, row_h: 24, header_h: 28, font_size: 13
        })
        var dosLayout = SDL3.createVBox({padX: PAD, padY: PAD, spacing: 0})
        dosLayout.add(dosTable, {grow: 1, shrink: 1, align: 3})
        tab.setPageLayout(1, dosLayout)

        // PE 头页 - Table
        peTable = SDL3.createTable({
            headers: ["字段", "值", "说明"],
            col_widths: [180.0, 200.0, 400.0],
            sortable: false, zebra: true, row_h: 24, header_h: 28, font_size: 13
        })
        var peLayout = SDL3.createVBox({padX: PAD, padY: PAD, spacing: 0})
        peLayout.add(peTable, {grow: 1, shrink: 1, align: 3})
        tab.setPageLayout(2, peLayout)

        // 节区页 - Table
        sectionTable = SDL3.createTable({
            headers: ["序号", "名称", "虚拟大小", "虚拟地址", "原始大小", "原始偏移", "特征值"],
            col_widths: [50.0, 120.0, 100.0, 100.0, 100.0, 100.0, 150.0],
            sortable: true, zebra: true, row_h: 24, header_h: 28, font_size: 13
        })
        var secLayout = SDL3.createVBox({padX: PAD, padY: PAD, spacing: 0})
        secLayout.add(sectionTable, {grow: 1, shrink: 1, align: 3})
        tab.setPageLayout(3, secLayout)

        // 导入表页 - Table
        importTable = SDL3.createTable({
            headers: ["DLL", "函数名", "RVA", "序号"],
            col_widths: [200.0, 400.0, 100.0, 80.0],
            sortable: true, zebra: true, row_h: 24, header_h: 28, font_size: 13
        })
        var impLayout = SDL3.createVBox({padX: PAD, padY: PAD, spacing: 0})
        impLayout.add(importTable, {grow: 1, shrink: 1, align: 3})
        tab.setPageLayout(4, impLayout)

        // LENB 页 - ListBox
        lenbBox = SDL3.createListBox({font_size: 13})
        var lenbLayout = SDL3.createVBox({padX: PAD, padY: PAD, spacing: 0})
        lenbLayout.add(lenbBox, {grow: 1, shrink: 1, align: 3})
        tab.setPageLayout(5, lenbLayout)

        // XOR 字符串页 - Table
        xorTable = SDL3.createTable({
            headers: ["序号", "偏移", "长度", "解密内容"],
            col_widths: [50.0, 120.0, 60.0, 600.0],
            sortable: true, zebra: true, row_h: 24, header_h: 28, font_size: 13
        })
        var xorLayout = SDL3.createVBox({padX: PAD, padY: PAD, spacing: 0})
        xorLayout.add(xorTable, {grow: 1, shrink: 1, align: 3})
        tab.setPageLayout(6, xorLayout)

        // 反汇编页 - ListBox（等宽字体显示字节码行）
        disasmBox = SDL3.createListBox({font_size: 12})
        var disasmLayout = SDL3.createVBox({padX: PAD, padY: PAD, spacing: 0})
        disasmLayout.add(disasmBox, {grow: 1, shrink: 1, align: 3})
        tab.setPageLayout(7, disasmLayout)

        // 状态栏
        statusLbl = SDL3.createLabel({text: "就绪 - 点击[浏览...]选择 PE 文件", font_size: 13})

        // 根布局
        var root = SDL3.createVBox({padX: PAD, padY: PAD, spacing: 4})
        root.add(toolbar, {grow: 0, shrink: 0, align: 3})
        root.add(tab, {grow: 1, shrink: 1, align: 3})
        root.add(statusLbl, {grow: 0, shrink: 0, basis: 22, align: 3})
        win.setRootAt(root, 0, titleH)
    }

    // ==================== 事件回调 ====================

    // 浏览文件
    func onBrowse() {
        fdlg.showOpenFileDialog(win, func(Array[string] paths, int filter) {
            if paths != null and paths.len() > 0 {
                filePath = paths[0]
                fileLbl.set_text("文件: " + dirs.basename(filePath))
                analyzeBtn.set_enabled(true)
                statusLbl.set_text("已选择: " + filePath)
                SDL3.markFrameRedraw()
            }
        }, {
            filters: [
                {name: "可执行文件", pattern: "*.exe"},
                {name: "动态链接库", pattern: "*.dll"},
                {name: "所有文件", pattern: "*.*"}
            ],
            default_location: dirs.dirname(dirs.script_dir())
        })
    }

    // 分析文件
    func onAnalyze() {
        if filePath == "" {
            statusLbl.set_text("错误: 请先选择文件")
            SDL3.markFrameRedraw()
            return
        }
        if not files.exists(filePath) {
            statusLbl.set_text("错误: 文件不存在")
            SDL3.markFrameRedraw()
            return
        }

        statusLbl.set_text("正在读取文件...")
        SDL3.markFrameRedraw()

        // 读取文件
        File f = files.open(filePath, "rb")
        if f == null {
            statusLbl.set_text("错误: 无法打开文件")
            SDL3.markFrameRedraw()
            return
        }
        fileSize = f.len()
        fileData = f.read(fileSize)
        f.close()

        if fileSize < 64 {
            statusLbl.set_text("错误: 文件太小，不是有效的 PE 文件")
            SDL3.markFrameRedraw()
            return
        }

        statusLbl.set_text("正在解析 PE 结构...")
        SDL3.markFrameRedraw()

        // 解析各部分
        analyzed = true
        analyzeOverview()
        analyzeDOSHeader()
        analyzePEHeader()
        analyzeSections()
        analyzeImports()
        analyzeLENB()
        analyzeXORStrings()
        analyzeDisasm()

        statusLbl.set_text("分析完成 - " + dirs.basename(filePath) + " (" + fmtSize(fileSize) + ")")
        SDL3.markFrameRedraw()
    }

    // ==================== 概览页 ====================

    func analyzeOverview() {
        overviewBox.clear()
        overviewBox.add_item("========== 文件概览 ==========")
        overviewBox.add_item("文件路径: " + filePath)
        overviewBox.add_item("文件名: " + dirs.basename(filePath))
        overviewBox.add_item("文件大小: " + fileSize + " bytes (" + fmtSize(fileSize) + ")")
        overviewBox.add_item("")

        // 检测 MZ 头
        int dosMagic = readU16(fileData, 0)
        if dosMagic == DOS_MAGIC {
            overviewBox.add_item("[DOS 头] MZ 魔数: 0x" + toHex4(dosMagic) + " (有效)")
            peHeaderOff = readU32(fileData, 0x3C)
            overviewBox.add_item("[DOS 头] e_lfanew (PE 头偏移): 0x" + toHex8(peHeaderOff))
        } else {
            overviewBox.add_item("[DOS 头] MZ 魔数: 0x" + toHex4(dosMagic) + " (无效! 不是 PE 文件)")
            overviewBox.add_item("x 该文件不是有效的 PE/EXE 文件")
            return
        }

        // 检测 PE 签名
        if peHeaderOff + 4 <= fileSize {
            int peSig = readU32(fileData, peHeaderOff)
            if peSig == PE_MAGIC {
                overviewBox.add_item("[PE 头] PE 签名: 0x" + toHex8(peSig) + " (PE\\0\\0, 有效)")
            } else {
                overviewBox.add_item("[PE 头] PE 签名: 0x" + toHex8(peSig) + " (无效!)")
                return
            }
        }

        // 机器类型
        if peHeaderOff + 6 <= fileSize {
            int machine = readU16(fileData, peHeaderOff + 4)
            overviewBox.add_item("[PE 头] 机器类型: " + machineName(machine))
        }

        // 节区数量
        if peHeaderOff + 8 <= fileSize {
            sectionCount = readU16(fileData, peHeaderOff + 6)
            overviewBox.add_item("[PE 头] 节区数量: " + sectionCount)
        }

        // 可选头 magic（判断 32/64 位）
        optHeaderOff = peHeaderOff + 24
        if optHeaderOff + 2 <= fileSize {
            int optMagic = readU16(fileData, optHeaderOff)
            if optMagic == 0x010B {
                is64bit = 0
                overviewBox.add_item("[可选头] Magic: 0x" + toHex4(optMagic) + " (PE32, 32位)")
            } else if optMagic == 0x20B {
                is64bit = 1
                overviewBox.add_item("[可选头] Magic: 0x" + toHex4(optMagic) + " (PE32+, 64位)")
            } else {
                overviewBox.add_item("[可选头] Magic: 0x" + toHex4(optMagic) + " (未知格式)")
            }
        }

        // 入口点
        if optHeaderOff + 20 <= fileSize {
            int entryRVA = readU32(fileData, optHeaderOff + 16)
            overviewBox.add_item("[可选头] 入口点 RVA: 0x" + toHex8(entryRVA))
        }

        // 节区表偏移
        if peHeaderOff + 22 <= fileSize {
            sectionTableOff = peHeaderOff + 24 + readU16(fileData, peHeaderOff + 20)
            overviewBox.add_item("[节区表] 偏移: 0x" + toHex8(sectionTableOff))
        }
        overviewBox.add_item("")

        // LENB 检测
        if fileSize >= 8 {
            int magicTail = readU32(fileData, fileSize - 4)
            int lenbSize = readU32(fileData, fileSize - 8)
            if magicTail == LENB_MAGIC {
                overviewBox.add_item("[LENB] 检测到 Leno 尾部附加数据!")
                overviewBox.add_item("[LENB] 魔数: 0x" + toHex8(magicTail) + " (LENB)")
                overviewBox.add_item("[LENB] 数据大小: " + lenbSize + " bytes")
                int lenbOff = fileSize - 8 - lenbSize
                overviewBox.add_item("[LENB] 数据偏移: 0x" + toHex8(lenbOff))
            } else {
                overviewBox.add_item("[LENB] 未检测到 Leno 尾部数据")
            }
        }
        overviewBox.add_item("")
        overviewBox.add_item("========== 分析完成 ==========")
    }

    // ==================== DOS 头页 ====================

    func analyzeDOSHeader() {
        Array[Array[string]] rows = []
        if fileSize < 64 { dosTable.set_rows(rows); return }

        rows.add(["e_magic", "0x" + toHex4(readU16(fileData, 0)), "DOS 魔数 'MZ' (0x5A4D)"])
        rows.add(["e_cblp", _str(readU16(fileData, 2)), "最后一页字节数"])
        rows.add(["e_cp", _str(readU16(fileData, 4)), "文件页数"])
        rows.add(["e_crlc", _str(readU16(fileData, 6)), "重定位项数"])
        rows.add(["e_cparhdr", _str(readU16(fileData, 8)), "头部段落大小(每段16字节)"])
        rows.add(["e_minalloc", _str(readU16(fileData, 10)), "最少需要的额外段落数"])
        rows.add(["e_maxalloc", _str(readU16(fileData, 12)), "最多需要的额外段落数"])
        rows.add(["e_ss", _str(readU16(fileData, 14)), "初始 SS"])
        rows.add(["e_sp", _str(readU16(fileData, 16)), "初始 SP"])
        rows.add(["e_csum", _str(readU16(fileData, 18)), "校验和"])
        rows.add(["e_ip", _str(readU16(fileData, 20)), "初始 IP"])
        rows.add(["e_cs", _str(readU16(fileData, 22)), "初始 CS"])
        rows.add(["e_lfarlc", _str(readU16(fileData, 24)), "重定位表偏移"])
        rows.add(["e_ovno", _str(readU16(fileData, 26)), "覆盖号"])
        rows.add(["e_lfanew", "0x" + toHex8(readU32(fileData, 0x3C)), "PE 头偏移(指向 PE 签名)"])

        dosTable.set_rows(rows)
    }

    // ==================== PE 头页 ====================

    func analyzePEHeader() {
        Array[Array[string]] rows = []
        if peHeaderOff == 0 or peHeaderOff + 24 > fileSize {
            peTable.set_rows(rows)
            return
        }

        // === COFF 头 ===
        rows.add(["--- COFF 头 ---", "", ""])
        rows.add(["Machine", "0x" + toHex4(readU16(fileData, peHeaderOff + 4)), machineName(readU16(fileData, peHeaderOff + 4))])
        rows.add(["NumberOfSections", _str(readU16(fileData, peHeaderOff + 6)), "节区数量"])
        rows.add(["TimeDateStamp", "0x" + toHex8(readU32(fileData, peHeaderOff + 8)), "时间戳(Unix)"])
        rows.add(["PointerToSymbolTable", "0x" + toHex8(readU32(fileData, peHeaderOff + 12)), "符号表偏移"])
        rows.add(["NumberOfSymbols", _str(readU32(fileData, peHeaderOff + 16)), "符号表数量"])
        rows.add(["SizeOfOptionalHeader", _str(readU16(fileData, peHeaderOff + 20)), "可选头大小(字节)"])
        rows.add(["Characteristics", "0x" + toHex4(readU16(fileData, peHeaderOff + 22)), "文件特征值"])

        // === 可选头 ===
        optHeaderOff = peHeaderOff + 24
        int optSize = readU16(fileData, peHeaderOff + 20)
        if optSize > 0 and optHeaderOff + optSize <= fileSize {
            rows.add(["", "", ""])
            rows.add(["--- 可选头 ---", "", ""])

            int optMagic = readU16(fileData, optHeaderOff)
            string magicStr = "未知"
            if optMagic == 0x010B { magicStr = "PE32 (32位)" }
            if optMagic == 0x20B { magicStr = "PE32+ (64位)" }
            rows.add(["Magic", "0x" + toHex4(optMagic), magicStr])

            rows.add(["MajorLinkerVersion", _str(readU8(fileData, optHeaderOff + 2)), "链接器主版本号"])
            rows.add(["MinorLinkerVersion", _str(readU8(fileData, optHeaderOff + 3)), "链接器次版本号"])
            rows.add(["SizeOfCode", _str(readU32(fileData, optHeaderOff + 4)), "代码段总大小"])
            rows.add(["SizeOfInitializedData", _str(readU32(fileData, optHeaderOff + 8)), "已初始化数据大小"])
            rows.add(["SizeOfUninitializedData", _str(readU32(fileData, optHeaderOff + 12)), "未初始化数据大小"])
            rows.add(["AddressOfEntryPoint", "0x" + toHex8(readU32(fileData, optHeaderOff + 16)), "入口点 RVA"])
            rows.add(["BaseOfCode", "0x" + toHex8(readU32(fileData, optHeaderOff + 20)), "代码段基址 RVA"])

            if optMagic == 0x010B {
                // PE32
                rows.add(["BaseOfData", "0x" + toHex8(readU32(fileData, optHeaderOff + 24)), "数据段基址 RVA"])
                rows.add(["ImageBase", "0x" + toHex8(readU32(fileData, optHeaderOff + 28)), "镜像基址"])
                rows.add(["SectionAlignment", "0x" + toHex8(readU32(fileData, optHeaderOff + 32)), "节区对齐粒度"])
                rows.add(["FileAlignment", "0x" + toHex8(readU32(fileData, optHeaderOff + 36)), "文件对齐粒度"])
                rows.add(["MajorOSVersion", _str(readU16(fileData, optHeaderOff + 40)), "所需 OS 主版本号"])
                rows.add(["MinorOSVersion", _str(readU16(fileData, optHeaderOff + 42)), "所需 OS 次版本号"])
                rows.add(["MajorImageVersion", _str(readU16(fileData, optHeaderOff + 44)), "镜像主版本号"])
                rows.add(["MinorImageVersion", _str(readU16(fileData, optHeaderOff + 46)), "镜像次版本号"])
                rows.add(["MajorSubsystemVersion", _str(readU16(fileData, optHeaderOff + 48)), "子系统主版本号"])
                rows.add(["MinorSubsystemVersion", _str(readU16(fileData, optHeaderOff + 50)), "子系统次版本号"])
                rows.add(["SizeOfImage", "0x" + toHex8(readU32(fileData, optHeaderOff + 56)), "镜像总大小"])
                rows.add(["SizeOfHeaders", "0x" + toHex8(readU32(fileData, optHeaderOff + 60)), "头部大小"])
                rows.add(["Subsystem", _str(readU16(fileData, optHeaderOff + 68)), subsystemName(readU16(fileData, optHeaderOff + 68))])
                rows.add(["CheckSum", "0x" + toHex8(readU32(fileData, optHeaderOff + 64)), "校验和"])
            } else if optMagic == 0x20B {
                // PE32+
                rows.add(["ImageBase", "0x" + toHex8(readU32(fileData, optHeaderOff + 24)), "镜像基址(低32位)"])
                rows.add(["ImageBase_Hi", "0x" + toHex8(readU32(fileData, optHeaderOff + 28)), "镜像基址(高32位)"])
                rows.add(["SectionAlignment", "0x" + toHex8(readU32(fileData, optHeaderOff + 32)), "节区对齐粒度"])
                rows.add(["FileAlignment", "0x" + toHex8(readU32(fileData, optHeaderOff + 36)), "文件对齐粒度"])
                rows.add(["MajorOSVersion", _str(readU16(fileData, optHeaderOff + 40)), "所需 OS 主版本号"])
                rows.add(["MinorOSVersion", _str(readU16(fileData, optHeaderOff + 42)), "所需 OS 次版本号"])
                rows.add(["SizeOfImage", "0x" + toHex8(readU32(fileData, optHeaderOff + 56)), "镜像总大小"])
                rows.add(["SizeOfHeaders", "0x" + toHex8(readU32(fileData, optHeaderOff + 60)), "头部大小"])
                rows.add(["Subsystem", _str(readU16(fileData, optHeaderOff + 68)), subsystemName(readU16(fileData, optHeaderOff + 68))])
                rows.add(["CheckSum", "0x" + toHex8(readU32(fileData, optHeaderOff + 64)), "校验和"])
            }
        }

        peTable.set_rows(rows)
    }

    // ==================== 节区页 ====================

    func analyzeSections() {
        Array[Array[string]] rows = []
        if sectionCount == 0 or sectionTableOff == 0 {
            sectionTable.set_rows(rows)
            return
        }

        int secSize = 40
        for sectionCount to i {
            int off = sectionTableOff + i * secSize
            if off + secSize > fileSize { break }

            // 节区名（8字节，可能含 \0）
            string name = ""
            for 0:7 to j {
                int b = fileData.byte(off + j)
                if b == 0 { break }
                name = name + strings.char(b)
            }

            int virtSize = readU32(fileData, off + 8)
            int virtAddr = readU32(fileData, off + 12)
            int rawSize  = readU32(fileData, off + 16)
            int rawOff   = readU32(fileData, off + 20)
            int flags    = readU32(fileData, off + 36)

            rows.add([
                _str(i + 1),
                name,
                _str(virtSize),
                "0x" + toHex8(virtAddr),
                _str(rawSize),
                "0x" + toHex8(rawOff),
                "0x" + toHex8(flags) + " [" + sectionFlagsName(flags) + "]"
            ])
        }
        sectionTable.set_rows(rows)
    }

    // ==================== 导入表页 ====================

    func analyzeImports() {
        Array[Array[string]] rows = []

        // 数据目录在可选头中的偏移：PE32 = optHeaderOff + 96, PE32+ = optHeaderOff + 112
        int dataDirOff = optHeaderOff + 96
        if is64bit == 1 { dataDirOff = optHeaderOff + 112 }

        // 导入表是第 2 个目录项（索引 1）
        int impDirRVA = 0
        if dataDirOff + 8 <= fileSize {
            impDirRVA = readU32(fileData, dataDirOff + 8)
        }

        if impDirRVA == 0 {
            importTable.set_rows(rows)
            return
        }

        // 将 RVA 转换为文件偏移
        int impFileOff = rvaToOffset(impDirRVA)
        if impFileOff == 0 {
            importTable.set_rows(rows)
            return
        }

        // 遍历导入描述符（每个 20 字节）
        int descSize = 20
        int maxDlls = 64
        int dllCount = 0

        while dllCount < maxDlls {
            int descOff = impFileOff + dllCount * descSize
            if descOff + descSize > fileSize { break }

            // 导入描述符字段
            int origFirstThunk = readU32(fileData, descOff + 0)   // OriginalFirstThunk (ILT RVA)
            int nameRVA        = readU32(fileData, descOff + 12)   // DLL 名称 RVA
            int firstThunk     = readU32(fileData, descOff + 16)   // FirstThunk (IAT RVA)

            // 终止条件：全零描述符
            if nameRVA == 0 and firstThunk == 0 { break }

            // 读取 DLL 名称
            int nameOff = rvaToOffset(nameRVA)
            string dllName = "???"
            if nameOff > 0 and nameOff < fileSize {
                dllName = readCString(nameOff, 256)
            }

            // 遍历该 DLL 的导入函数
            // 优先使用 OriginalFirstThunk (ILT)，如果为 0 则用 FirstThunk (IAT)
            int thunkRVA = origFirstThunk
            if thunkRVA == 0 { thunkRVA = firstThunk }

            if thunkRVA == 0 {
                rows.add([dllName, "(无法解析 thunk)", "0x" + toHex8(firstThunk), "-"])
                dllCount = dllCount + 1
                continue
            }

            int thunkOff = rvaToOffset(thunkRVA)
            if thunkOff == 0 {
                rows.add([dllName, "(无法解析 thunk 偏移)", "0x" + toHex8(firstThunk), "-"])
                dllCount = dllCount + 1
                continue
            }

            // 遍历 thunk 数组（每项 4 字节 on 32位）
            int thunkSize = 4
            if is64bit == 1 { thunkSize = 8 }
            int maxFuncs = 512
            int funcCount = 0

            while funcCount < maxFuncs {
                int thunkEntryOff = thunkOff + funcCount * thunkSize
                if thunkEntryOff + thunkSize > fileSize { break }

                int thunkVal = readU32(fileData, thunkEntryOff)
                // 终止条件：全零 thunk
                if thunkVal == 0 { break }

                // 最高位为 1 表示按序号导入
                if is64bit == 1 {
                    // 64位：检查高32位
                    int thunkHi = readU32(fileData, thunkEntryOff + 4)
                    if (thunkHi & 0x80000000) != 0 {
                        int ordinal = thunkVal & 0xFFFF
                        rows.add([dllName, "Ordinal #" + ordinal, "0x" + toHex8(firstThunk + funcCount * 8), _str(ordinal)])
                    } else {
                        // 按名称导入：thunkVal 是 Hint/Name 结构的 RVA
                        int hintNameOff = rvaToOffset(thunkVal)
                        if hintNameOff > 0 and hintNameOff + 2 < fileSize {
                            int hint = readU16(fileData, hintNameOff)
                            string funcName = readCString(hintNameOff + 2, 256)
                            rows.add([dllName, funcName, "0x" + toHex8(firstThunk + funcCount * 8), _str(hint)])
                        } else {
                            rows.add([dllName, "(名称偏移无效)", "0x" + toHex8(thunkVal), "-"])
                        }
                    }
                } else {
                    // 32位
                    if (thunkVal & 0x80000000) != 0 {
                        int ordinal = thunkVal & 0xFFFF
                        rows.add([dllName, "Ordinal #" + ordinal, "0x" + toHex8(firstThunk + funcCount * 4), _str(ordinal)])
                    } else {
                        // 按名称导入：thunkVal 是 Hint/Name 结构的 RVA
                        int hintNameOff = rvaToOffset(thunkVal)
                        if hintNameOff > 0 and hintNameOff + 2 < fileSize {
                            int hint = readU16(fileData, hintNameOff)
                            string funcName = readCString(hintNameOff + 2, 256)
                            rows.add([dllName, funcName, "0x" + toHex8(firstThunk + funcCount * 4), _str(hint)])
                        } else {
                            rows.add([dllName, "(名称偏移无效)", "0x" + toHex8(thunkVal), "-"])
                        }
                    }
                }
                funcCount = funcCount + 1
            }

            if funcCount == 0 {
                rows.add([dllName, "(无导入函数)", "-", "-"])
            }
            dllCount = dllCount + 1
        }

        importTable.set_rows(rows)
    }

    // ==================== LENB 页 ====================

    func analyzeLENB() {
        lenbBox.clear()
        lenbBox.add_item("========== LENB 尾部分析 ==========")

        if fileSize < 8 {
            lenbBox.add_item("x 文件太小，无法包含 LENB 尾部")
            return
        }

        int magicOff = fileSize - 4
        int sizeOff = fileSize - 8

        int magic = readU32(fileData, magicOff)
        int lenbSize = readU32(fileData, sizeOff)

        lenbBox.add_item("尾部魔数偏移: 0x" + toHex8(magicOff))
        lenbBox.add_item("尾部大小偏移: 0x" + toHex8(sizeOff))
        lenbBox.add_item("尾部 Magic: 0x" + toHex8(magic))
        lenbBox.add_item("LENB 期望值: 0x" + toHex8(LENB_MAGIC))
        lenbBox.add_item("匹配: " + (if magic == LENB_MAGIC then "是" else "否"))
        lenbBox.add_item("")

        if magic == LENB_MAGIC {
            int lenbOffset = fileSize - 8 - lenbSize
            lenbBox.add_item("v 检测到 LENB 尾部!")
            lenbBox.add_item("LENB 数据大小: " + lenbSize + " bytes")
            lenbBox.add_item("LENB 数据偏移: 0x" + toHex8(lenbOffset))
            lenbBox.add_item("")

            // 解析 LENB 头部
            if lenbOffset + 28 <= fileSize {
                lenbBox.add_item("--- LENB 头部字段 ---")
                int lenbMagicVal = readU32(fileData, lenbOffset)
                int lenbVersion = readU32(fileData, lenbOffset + 4)
                int lenbFlags = readU32(fileData, lenbOffset + 8)
                int lenbSrcHash = readU32(fileData, lenbOffset + 12)
                int globalVars = readU32(fileData, lenbOffset + 20)
                int globalFuncs = readU32(fileData, lenbOffset + 24)

                lenbBox.add_item("Magic:    0x" + toHex8(lenbMagicVal) + " (LENB)")
                lenbBox.add_item("Version:  0x" + toHex8(lenbVersion))
                lenbBox.add_item("Flags:    0x" + toHex8(lenbFlags))
                lenbBox.add_item("SrcHash:  0x" + toHex8(lenbSrcHash))
                lenbBox.add_item("全局变量数: " + globalVars)
                lenbBox.add_item("全局函数数: " + globalFuncs)

                // 尝试读取符号计数
                if lenbOffset + 32 <= fileSize {
                    int symCount = readU32(fileData, lenbOffset + 28)
                    lenbBox.add_item("符号数:   " + symCount)
                }
            }

            // Hex dump 前 64 字节（每行 16 字节）
            lenbBox.add_item("")
            lenbBox.add_item("--- LENB 头部 Hex Dump (前 64 字节) ---")
            int dumpLen = 64
            if lenbOffset + dumpLen > fileSize { dumpLen = fileSize - lenbOffset }
            int row = 0
            while row * 16 < dumpLen {
                int rowOff = row * 16
                int rowEnd = rowOff + 16
                if rowEnd > dumpLen { rowEnd = dumpLen }
                string addr = toHex8(lenbOffset + rowOff)
                string hexData = ""
                string asciiData = ""
                for rowOff:rowEnd to j {
                    int byteVal = fileData.byte(lenbOffset + j)
                    hexData = hexData + toHex2(byteVal) + " "
                    if byteVal >= 0x20 and byteVal <= 0x7E {
                        asciiData = asciiData + strings.char(byteVal)
                    } else {
                        asciiData = asciiData + "."
                    }
                }
                // 补齐最后一行的空位
                while rowEnd - rowOff < 16 {
                    hexData = hexData + "   "
                    rowOff = rowOff + 1
                }
                lenbBox.add_item("0x" + addr + "  " + hexData + " " + asciiData)
                row = row + 1
            }
        } else {
            lenbBox.add_item("x 未检测到 LENB 尾部数据")
            lenbBox.add_item("该文件可能不是 Leno 编译器生成的可执行文件")
            lenbBox.add_item("或 LENB 尾部已被移除/修改")
        }
        lenbBox.add_item("")
        lenbBox.add_item("========== LENB 分析完成 ==========")
    }

    // ==================== XOR 字符串页 ====================

    func analyzeXORStrings() {
        Array[Array[string]] rows = []

        // XOR(LENO) 字符串搜索：扫描整个文件
        int pos = 0
        int maxPos = fileSize - 12
        int found = 0
        int maxResults = 500

        while pos < maxPos and found < maxResults {
            int runStart = pos
            int runLen = 0
            string decrypted = ""

            while pos + runLen < fileSize and runLen < 256 {
                int b = fileData.byte(pos + runLen)
                int keyByte = xorKey(runLen % 4)
                int dec = b ^ keyByte

                if (dec >= 0x20 and dec <= 0x7E) or dec >= 0x80 {
                    decrypted = decrypted + strings.char(dec)
                    runLen = runLen + 1
                } else {
                    break
                }
            }

            if runLen >= 12 {
                found = found + 1
                rows.add([
                    _str(found),
                    "0x" + toHex8(runStart),
                    _str(runLen),
                    decrypted
                ])
                pos = runStart + runLen
            } else {
                pos = pos + 1
            }
        }

        xorTable.set_rows(rows)
    }

    // ==================== 反汇编器辅助 ====================

    func rbe32(int off): int {
        int b0 = fileData.byte(off) & 0xFF
        int b1 = fileData.byte(off + 1) & 0xFF
        int b2 = fileData.byte(off + 2) & 0xFF
        int b3 = fileData.byte(off + 3) & 0xFF
        return (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
    }
    func rbe16(int off): int {
        int b0 = fileData.byte(off) & 0xFF
        int b1 = fileData.byte(off + 1) & 0xFF
        return (b0 << 8) | b1
    }
    func rbe_i64_hex(int off): string {
        int hi = rbe32(off)
        int lo = rbe32(off + 4)
        return "0x" + toHex8(hi) + toHex8(lo)
    }
    func readXorStr(int byteLen): string {
        if byteLen > 10000 { return "<long-str:" + _str(byteLen) + ">" }
        string s = ""
        for 0:byteLen-1 to i {
            int key = 0x4C
            if i % 4 == 1 { key = 0x45 }
            if i % 4 == 2 { key = 0x4E }
            if i % 4 == 3 { key = 0x4F }
            int plain = (fileData.byte(gLenbPos) ^ key) & 0xFF
            s = s + strings.char(plain)
            gLenbPos = gLenbPos + 1
        }
        return s
    }
    func constTagName(int tag): string {
        switch tag {
            case 0x00 { return "NULL" }
            case 0x01 { return "TRUE" }
            case 0x02 { return "FALSE" }
            case 0x03 { return "INT" }
            case 0x04 { return "FLOAT" }
            case 0x05 { return "STRING" }
            case 0x06 { return "FUNCTION" }
            case 0x07 { return "BIGINT" }
            case 0x08 { return "RANGE" }
            case 0x09 { return "ARRAY" }
            case 0x0A { return "DICT" }
            case 0x0B { return "STRUCT_DEF" }
            case 0x0C { return "ENUM_DEF" }
            case 0x0D { return "CSTRUCT_DEF" }
            case 0x0E { return "FACE_DEF" }
            case 0x0F { return "MODULE" }
            case 0x10 { return "MODULE_REF" }
            case 0x11 { return "FFI_PTR" }
            case 0x12 { return "CLOSURE" }
            case 0x13 { return "FFI_LIB" }
        }
        return "TAG_0x" + toHex2(tag)
    }
    func opName(int code): string {
        if code == 0 { return "OP_CONST" }
        if code == 1 { return "OP_NULL" }
        if code == 2 { return "OP_TRUE" }
        if code == 3 { return "OP_FALSE" }
        if code == 4 { return "OP_ZERO" }
        if code == 5 { return "OP_ONE" }
        if code == 6 { return "OP_POP" }
        if code == 7 { return "OP_DUP" }
        if code == 8 { return "OP_GET_LOCAL" }
        if code == 9 { return "OP_SET_LOCAL" }
        if code == 10 { return "OP_SET_LOCAL_POP" }
        if code == 11 { return "OP_MOVE_LOCAL" }
        if code == 12 { return "OP_GET_GLOBAL" }
        if code == 13 { return "OP_SET_GLOBAL" }
        if code == 14 { return "OP_GET_UPVALUE" }
        if code == 15 { return "OP_SET_UPVALUE" }
        if code == 16 { return "OP_CLOSE_UPVALUE" }
        if code == 17 { return "OP_DEFINE_GLOBAL" }
        if code == 18 { return "OP_GET_GLOBAL_FUNC" }
        if code == 19 { return "OP_DEFINE_GLOBAL_FUNC" }
        if code == 20 { return "OP_GET_NATIVE" }
        if code == 21 { return "OP_ADD" }
        if code == 22 { return "OP_SUB" }
        if code == 23 { return "OP_MUL" }
        if code == 24 { return "OP_DIV" }
        if code == 25 { return "OP_MOD" }
        if code == 26 { return "OP_BITAND" }
        if code == 27 { return "OP_BITOR" }
        if code == 28 { return "OP_BITXOR" }
        if code == 29 { return "OP_BITNOT" }
        if code == 30 { return "OP_SHL" }
        if code == 31 { return "OP_SHR" }
        if code == 32 { return "OP_USHR" }
        if code == 33 { return "OP_NEG" }
        if code == 34 { return "OP_NOT" }
        if code == 35 { return "OP_CAST_FLOAT" }
        if code == 36 { return "OP_CAST_INT" }
        if code == 37 { return "OP_CAST_STRING" }
        if code == 38 { return "OP_SET_PTR_ELEM_TYPE" }
        if code == 39 { return "OP_SET_DECLARED_FACE" }
        if code == 40 { return "OP_INC" }
        if code == 41 { return "OP_DEC" }
        if code == 42 { return "OP_INC_LOCAL" }
        if code == 43 { return "OP_DEC_LOCAL" }
        if code == 44 { return "OP_PRE_INC_LOCAL" }
        if code == 45 { return "OP_PRE_DEC_LOCAL" }
        if code == 46 { return "OP_EQ" }
        if code == 47 { return "OP_NEQ" }
        if code == 48 { return "OP_IS_NULL" }
        if code == 49 { return "OP_LT" }
        if code == 50 { return "OP_GT" }
        if code == 51 { return "OP_LE" }
        if code == 52 { return "OP_GE" }
        if code == 53 { return "OP_IN" }
        if code == 54 { return "OP_RANGE" }
        if code == 55 { return "OP_JUMP" }
        if code == 56 { return "OP_JUMP_IF_FALSE" }
        if code == 57 { return "OP_JUMP_IF_TRUE" }
        if code == 58 { return "OP_LOOP" }
        if code == 59 { return "OP_CALL" }
        if code == 60 { return "OP_TAIL_CALL" }
        if code == 61 { return "OP_CLOSURE" }
        if code == 62 { return "OP_RETURN" }
        if code == 63 { return "OP_RETURN_MULTI" }
        if code == 64 { return "OP_ARRAY" }
        if code == 65 { return "OP_ARRAY_GET" }
        if code == 66 { return "OP_ARRAY_SET" }
        if code == 67 { return "OP_ARRAY_APPEND" }
        if code == 68 { return "OP_ARRAY_APPEND_NOPUSH" }
        if code == 69 { return "OP_DICT" }
        if code == 70 { return "OP_DICT_GET" }
        if code == 71 { return "OP_DICT_SET" }
        if code == 72 { return "OP_DICT_GET_KEY" }
        if code == 73 { return "OP_LOAD_NATIVE_MODULE" }
        if code == 74 { return "OP_MODULE_CALL" }
        if code == 75 { return "OP_GET_MODULE_CONST" }
        if code == 76 { return "OP_STRING_ADD" }
        if code == 77 { return "OP_INDEX" }
        if code == 78 { return "OP_INDEX_SET" }
        if code == 79 { return "OP_SLICE" }
        if code == 80 { return "OP_LENGTH" }
        if code == 81 { return "OP_ITER_GET" }
        if code == 82 { return "OP_ITER_GET_VALUE" }
        if code == 83 { return "OP_TRY" }
        if code == 84 { return "OP_CATCH" }
        if code == 85 { return "OP_FINALLY" }
        if code == 86 { return "OP_END_TRY" }
        if code == 87 { return "OP_THROW" }
        if code == 88 { return "OP_GET_MODULE_VAR" }
        if code == 89 { return "OP_SET_MODULE_VAR" }
        if code == 90 { return "OP_GET_MODULE_FUNC" }
        if code == 91 { return "OP_DEFINE_MODULE_FUNC" }
        if code == 92 { return "OP_GET_PROPERTY" }
        if code == 93 { return "OP_TYPE_CHECK" }
        if code == 94 { return "OP_AS_CAST" }
        if code == 95 { return "OP_FOR_PREP" }
        if code == 96 { return "OP_FOR_LOOP" }
        if code == 97 { return "OP_ADD_INT" }
        if code == 98 { return "OP_SUB_INT" }
        if code == 99 { return "OP_MUL_INT" }
        if code == 100 { return "OP_DIV_INT" }
        if code == 101 { return "OP_MOD_INT" }
        if code == 102 { return "OP_ADD_FLOAT" }
        if code == 103 { return "OP_SUB_FLOAT" }
        if code == 104 { return "OP_MUL_FLOAT" }
        if code == 105 { return "OP_DIV_FLOAT" }
        if code == 106 { return "OP_NEG_INT" }
        if code == 107 { return "OP_NEG_FLOAT" }
        if code == 108 { return "OP_EQ_INT" }
        if code == 109 { return "OP_LT_INT" }
        if code == 110 { return "OP_GT_INT" }
        if code == 111 { return "OP_LE_INT" }
        if code == 112 { return "OP_GE_INT" }
        if code == 113 { return "OP_EQ_FLOAT" }
        if code == 114 { return "OP_LT_FLOAT" }
        if code == 115 { return "OP_GT_FLOAT" }
        if code == 116 { return "OP_LE_FLOAT" }
        if code == 117 { return "OP_GE_FLOAT" }
        if code == 118 { return "OP_ADD_INT_IMM" }
        if code == 119 { return "OP_SUB_INT_IMM" }
        if code == 120 { return "OP_MUL_INT_IMM" }
        if code == 121 { return "OP_LT_INT_IMM" }
        if code == 122 { return "OP_GT_INT_IMM" }
        if code == 123 { return "OP_LE_INT_IMM" }
        if code == 124 { return "OP_GE_INT_IMM" }
        if code == 125 { return "OP_EQ_INT_IMM" }
        if code == 126 { return "OP_SHL_IMM" }
        if code == 127 { return "OP_SHR_IMM" }
        if code == 128 { return "OP_USHR_IMM" }
        if code == 129 { return "OP_STRUCT_DEF" }
        if code == 130 { return "OP_STRUCT_INIT" }
        if code == 131 { return "OP_GET_FIELD" }
        if code == 132 { return "OP_SET_FIELD" }
        if code == 133 { return "OP_GET_FIELD_ADDR" }
        if code == 134 { return "OP_GET_METHOD" }
        if code == 135 { return "OP_ENUM_DEF" }
        if code == 136 { return "OP_FACE_DEF" }
        if code == 137 { return "OP_CSTRUCT_DEF" }
        if code == 138 { return "OP_GET_CSTRUCT_DEF" }
        if code == 139 { return "OP_AWAIT" }
        if code == 140 { return "OP_ASYNC_CALL" }
        if code == 141 { return "OP_INIT_LENOMODULE" }
        if code == 142 { return "OP_CLIB_CALL" }
        if code == 143 { return "OP_CFUNC_CALLBACK" }
        if code == 144 { return "OP_CALL_NATIVE" }
        if code == 145 { return "OP_TAIL_CALL_NATIVE" }
        if code == 146 { return "OP_U8_TO_F64" }
        if code == 147 { return "OP_PUSH_TYPE_ARGS" }
        if code == 148 { return "OP_DTOR_LOCAL" }
        if code == 149 { return "OP_CALL_GLOBAL_FUNC" }
        if code == 150 { return "OP_INC_LOCAL_NOPUSH" }
        if code == 151 { return "OP_DEC_LOCAL_NOPUSH" }
        if code == 152 { return "OP_MOVE_LOCAL_POP" }
        if code == 153 { return "OP_INDEX_SET_NOPUSH" }
        if code == 154 { return "OP_CLEAR_LOCAL_RANGE" }
        if code == 155 { return "OP_SWITCH_LOOKUP" }
        if code == 156 { return "OP_INVOKE_METHOD" }
        return "OP_0x" + toHex2(code)
    }
    func opImmSize(int op): int {
        if op == 0 { return 2 }
        if op >= 8 and op <= 20 { return 2 }
        if op == 11 or op == 152 { return 4 }
        if op == 55 or op == 56 or op == 57 or op == 58 { return 4 }
        if op == 59 or op == 60 { return 2 }
        if op == 61 { return 2 }
        if op == 64 { return 2 }
        if op == 67 or op == 68 { return 2 }
        if op == 73 or op == 74 or op == 75 { return 2 }
        if op == 88 or op == 89 or op == 90 or op == 91 { return 2 }
        if op >= 118 and op <= 128 { return 1 }
        if op == 131 or op == 132 or op == 134 or op == 153 { return 1 }
        if op == 144 or op == 145 or op == 149 or op == 156 { return 4 }
        if op == 133 or op == 148 or op == 150 or op == 151 { return 2 }
        if op == 154 { return 4 }
        if op == 129 { return 0 }
        if op == 135 { return 0 }
        if op == 137 or op == 138 { return 0 }
        if op == 130 { return 2 }
        if op == 147 { return 1 }
        return 0
    }
    func skipConstRaw() {
        int tag = fileData.byte(gLenbPos) & 0xFF; gLenbPos = gLenbPos + 1
        if tag == 0x00 or tag == 0x01 or tag == 0x02 { return }
        if tag == 0x03 or tag == 0x04 { gLenbPos = gLenbPos + 8; return }
        if tag == 0x05 {
            int n = rbe32(gLenbPos); gLenbPos = gLenbPos + 4 + n
            return
        }
        if tag == 0x09 {
            int n = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
            for 0:n-1 to i { skipConstRaw() }
            return
        }
        if tag == 0x0A {
            int n = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
            for 0:(2 * n)-1 to i { skipConstRaw() }
            return
        }
        if tag == 0x07 {
            int limbs = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
            gLenbPos = gLenbPos + 1  // is_negative
            gLenbPos = gLenbPos + 4 * limbs
            return
        }
        if tag == 0x08 {
            gLenbPos = gLenbPos + 8 + 8 + 1
            return
        }
        if tag == 0x06 {
            skipFuncRaw()
            return
        }
        if tag == 0x13 {
            int has = fileData.byte(gLenbPos) & 0xFF; gLenbPos = gLenbPos + 1
            if has != 0 {
                int n = rbe32(gLenbPos); gLenbPos = gLenbPos + 4 + n
            }
            return
        }
        if tag == 0x11 {
            gLenbPos = gLenbPos + 2
            return
        }
        gLenbPos = gLenbPos + 1
    }
    func skipFuncRaw() {
        int nameLen = rbe32(gLenbPos); gLenbPos = gLenbPos + 4 + nameLen
        int arity = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
        int upvals = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
        int locals = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
        gLenbPos = gLenbPos + 1  // has_try
        int pcnt = rbe32(gLenbPos); gLenbPos = gLenbPos + 4 + pcnt
        int tpcnt = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
        for 0:tpcnt-1 to i {
            int n = rbe32(gLenbPos); gLenbPos = gLenbPos + 4 + n
        }
        skipChunkRaw()
    }
    func skipChunkRaw() {
        int fnLen = rbe32(gLenbPos); gLenbPos = gLenbPos + 4 + fnLen
        int lcnt = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
        int ccnt = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
        for 0:ccnt-1 to i { skipConstRaw() }
        int codeLen = rbe32(gLenbPos); gLenbPos = gLenbPos + 4 + codeLen
        int hasLines = fileData.byte(gLenbPos) & 0xFF; gLenbPos = gLenbPos + 1
        if hasLines == 1 and codeLen > 0 {
            gLenbPos = gLenbPos + 2 * codeLen
        }
    }
    func formatConst(int idx, string text): string {
        return "; const[" + _str(idx) + "] = " + text
    }
    func parseConstText(int depth): string {
        int tag = fileData.byte(gLenbPos) & 0xFF; gLenbPos = gLenbPos + 1
        if tag == 0x00 { return "null" }
        if tag == 0x01 { return "true" }
        if tag == 0x02 { return "false" }
        if tag == 0x03 {
            int hi = rbe32(gLenbPos)
            int lo = rbe32(gLenbPos + 4)
            gLenbPos = gLenbPos + 8
            if hi == 0 and (lo >> 31) == 0 { return _str(lo) }
            return "int:" + toHex8(hi) + toHex8(lo)
        }
        if tag == 0x04 {
            string hex = rbe_i64_hex(gLenbPos); gLenbPos = gLenbPos + 8
            return "float:" + hex
        }
        if tag == 0x05 {
            int n = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
            string s = readXorStr(n)
            return "'" + s + "'"
        }
        if tag == 0x06 {
            int nameLen = rbe32(gLenbPos); gLenbPos = gLenbPos + 4 + nameLen
            if gLenbPos + 17 > gLenbEnd { return "FUNC?<trunc>" }
            int arity = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
            int upvals = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
            int locals = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
            int hasTry = fileData.byte(gLenbPos) & 0xFF; gLenbPos = gLenbPos + 1
            int pcnt = rbe32(gLenbPos); gLenbPos = gLenbPos + 4 + pcnt
            int tpcnt = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
            for 0:tpcnt-1 to i {
                int n3 = rbe32(gLenbPos); gLenbPos = gLenbPos + 4 + n3
            }
            return "FUNC(arity=" + _str(arity) + ",upvals=" + _str(upvals) + ",locals=" + _str(locals) + ")"
        }
        if tag == 0x07 {
            int n = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
            gLenbPos = gLenbPos + 1 + 4 * n
            return "BIGINT(limbs=" + _str(n) + ")"
        }
        if tag == 0x08 {
            int sHi = rbe32(gLenbPos); int sLo = rbe32(gLenbPos + 4); gLenbPos = gLenbPos + 8
            int eHi = rbe32(gLenbPos); int eLo = rbe32(gLenbPos + 4); gLenbPos = gLenbPos + 8
            int inc = fileData.byte(gLenbPos) & 0xFF; gLenbPos = gLenbPos + 1
            return "RANGE"
        }
        if tag == 0x09 {
            int n = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
            string r = "["
            for 0:n-1 to i {
                if i > 0 { r = r + "," }
                r = r + parseConstText(depth)
            }
            return r + "]"
        }
        if tag == 0x0A {
            int n = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
            string r = "{"
            for 0:n-1 to i {
                if i > 0 { r = r + "," }
                r = r + parseConstText(depth) + ":" + parseConstText(depth)
            }
            return r + "}"
        }
        if tag == 0x13 {
            int has = fileData.byte(gLenbPos) & 0xFF; gLenbPos = gLenbPos + 1
            if has == 0 { return "FFI_LIB(null)" }
            int n5 = rbe32(gLenbPos); gLenbPos = gLenbPos + 4 + n5
            return "FFI_LIB"
        }
        if tag == 0x11 {
            gLenbPos = gLenbPos + 2
            return "FFI_PTR"
        }
        int nSkip = 0
        string label = constTagName(tag)
        return "<" + label + ">"
    }
    func decodeOneInstruction(int codeStart, int codeLen, Array[int] lines, int idx): string {
        int pc = codeStart + idx
        if pc + 1 > gLenbEnd { return "<eof>" }
        int op = fileData.byte(pc) & 0xFF
        int immSz = opImmSize(op)
        string name = opName(op)
        string operands = ""
        int lineNo = -1
        if idx < lines.len() { lineNo = lines[idx] }
        int nextPc = pc + 1 + immSz
        if op == 0 {  // CONST
            if pc + 3 <= gLenbEnd {
                int ci = rbe16(pc + 1)
                operands = "const[" + _str(ci) + "]"
            }
        } else if op == 8 {  // GET_LOCAL
            if pc + 3 <= gLenbEnd { operands = "slot=" + _str(rbe16(pc + 1)) }
        } else if op == 9 {  // SET_LOCAL
            if pc + 3 <= gLenbEnd { operands = "slot=" + _str(rbe16(pc + 1)) }
        } else if op == 12 {  // GET_GLOBAL
            if pc + 3 <= gLenbEnd { operands = "slot=" + _str(rbe16(pc + 1)) }
        } else if op == 13 {  // SET_GLOBAL
            if pc + 3 <= gLenbEnd { operands = "slot=" + _str(rbe16(pc + 1)) }
        } else if op == 11 {  // MOVE_LOCAL
            if pc + 5 <= gLenbEnd {
                operands = "src=" + _str(rbe16(pc + 1)) + " dst=" + _str(rbe16(pc + 3))
            }
        } else if op == 59 {  // CALL
            if pc + 3 <= gLenbEnd { operands = "argc=" + _str(rbe16(pc + 1)) }
        } else if op == 55 or op == 56 or op == 57 {
            if pc + 5 <= gLenbEnd {
                int target = rbe32(pc + 1)
                int absT = pc + 1 + 4 + target
                operands = "-> 0x" + toHex8(absT)
            }
        } else if op == 58 {  // LOOP
            if pc + 5 <= gLenbEnd {
                int target = rbe32(pc + 1)
                int absT = pc + 1 + 4 + target
                operands = "-> 0x" + toHex8(absT)
            }
        } else if op == 144 or op == 145 or op == 149 or op == 156 {
            if pc + 5 <= gLenbEnd {
                operands = "name=" + _str(rbe16(pc + 1)) + " argc=" + _str(rbe16(pc + 3))
            }
        } else if op == 61 {  // CLOSURE
            if pc + 3 <= gLenbEnd { operands = "const[" + _str(rbe16(pc + 1)) + "]" }
        } else if op == 73 {  // LOAD_NATIVE_MODULE
            if pc + 3 <= gLenbEnd { operands = "const[" + _str(rbe16(pc + 1)) + "]" }
        } else if op >= 118 and op <= 128 {
            if pc + 2 <= gLenbEnd {
                int imm = fileData.byte(pc + 1) & 0xFF
                if imm >= 128 { imm = imm - 256 }
                operands = "imm=" + _str(imm)
            }
        } else if op == 64 {  // ARRAY
            if pc + 3 <= gLenbEnd { operands = "cap=" + _str(rbe16(pc + 1)) }
        } else if op == 131 or op == 132 {
            if pc + 2 <= gLenbEnd { operands = "field=" + _str(fileData.byte(pc + 1) & 0xFF) }
        } else if op == 148 or op == 150 or op == 151 or op == 133 {
            if pc + 3 <= gLenbEnd { operands = "slot=" + _str(rbe16(pc + 1)) }
        } else if immSz > 0 {
            operands = "<" + _str(immSz) + "B>"
        }
        string lineField = "?"
        if lineNo == 0 { lineField = "0" }
        if lineNo > 0 { lineField = _str(lineNo) }
        string addrField = toHex8(pc)
        return addrField + "  L" + lineField + "  " + name + "  " + operands
    }
    func parseOneChunkBody(int depth) {
        if depth > 4 { gLines.add("  ; <深度超限,停止展开>"); return }
        if gLenbPos + 4 > gLenbEnd { return }
        int fnLen = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
        if fnLen < 0 or fnLen > 1000 { return }
        string fnName = readXorStr(fnLen)
        if gLenbPos + 8 > gLenbEnd { return }
        int localCount = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
        int constCnt = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
        gLines.add("; ===== " + fnName + " (locals=" + _str(localCount) + ", consts=" + _str(constCnt) + ") =====")
        Array[int] constStarts = []
        Array[string] constTexts = []
        for 0:constCnt-1 to ci {
            constStarts.add(gLenbPos)
            string ct = parseConstText(depth + 1)
            constTexts.add(ct)
        }
        for 0:constCnt-1 to ci {
            int cst = constStarts[ci]
            int tag = fileData.byte(cst) & 0xFF
            gLines.add(formatConst(ci, constTexts[ci]))
            if tag == 0x06 and depth < 4 {
                int subPos = cst + 1
                int nameLen = rbe32(subPos); subPos = subPos + 4 + nameLen
                subPos = subPos + 13
                int p2 = rbe32(subPos); subPos = subPos + 4 + p2
                int tp2 = rbe32(subPos); subPos = subPos + 4
                for 0:tp2-1 to k {
                    int n2 = rbe32(subPos); subPos = subPos + 4 + n2
                }
                int savedPos = gLenbPos
                gLenbPos = subPos
                parseOneChunkBody(depth + 1)
                gLenbPos = savedPos
            }
        }
        if gLenbPos + 4 > gLenbEnd { return }
        int codeLen = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
        int codeStart = gLenbPos
        gLenbPos = gLenbPos + codeLen
        int hasLines = -1
        Array[int] lines = []
        if gLenbPos + 1 <= gLenbEnd {
            hasLines = fileData.byte(gLenbPos) & 0xFF
            gLenbPos = gLenbPos + 1
            if hasLines == 1 and codeLen > 0 {
                for 0:codeLen-1 to li {
                    if gLenbPos + 2 <= gLenbEnd {
                        lines.add(rbe16(gLenbPos)); gLenbPos = gLenbPos + 2
                    }
                }
            }
        }
        for 0:codeLen-1 to ii {
            if hasLines != 1 { lines.add(-1) }
        }
        gLines.add("; --- bytecode (" + _str(codeLen) + "B) ---")
        int pc = 0
        while pc < codeLen {
            if codeStart + pc >= gLenbEnd { break }
            int opc = fileData.byte(codeStart + pc) & 0xFF
            int imm = opImmSize(opc)
            string line = decodeOneInstruction(codeStart, codeLen, lines, pc)
            gLines.add(line)
            pc = pc + 1 + imm
        }
    }

    // ==================== 反汇编顶层驱动 ====================

    func skipHeaderAndSymbols(int startPos): int {
        int pos = startPos
        if pos + 12 > gLenbEnd { return pos }
        int gvars = rbe32(pos); pos = pos + 4
        int gfuncs = rbe32(pos); pos = pos + 4
        int symCount = rbe32(pos); pos = pos + 4
        for 0:symCount-1 to si {
            if pos + 13 > gLenbEnd { break }
            int kind = fileData.byte(pos) & 0xFF; pos = pos + 1
            int nameLen = rbe32(pos); pos = pos + 4
            if nameLen < 0 or nameLen > 100000 or pos + nameLen + 8 > gLenbEnd { break }
            pos = pos + nameLen
            pos = pos + 4  // index
            pos = pos + 1  // is_captured
            if pos + 2 > gLenbEnd { break }
            int tkind = fileData.byte(pos) & 0xFF; pos = pos + 1
            int hasDk = fileData.byte(pos) & 0xFF; pos = pos + 1
            if hasDk != 0 {
                if pos + 4 > gLenbEnd { break }
                int dkCount = rbe32(pos); pos = pos + 4
                for 0:dkCount-1 to di {
                    if pos + 4 > gLenbEnd { break }
                    int dkLen = rbe32(pos); pos = pos + 4
                    if dkLen < 0 or pos + dkLen > gLenbEnd { break }
                    pos = pos + dkLen
                }
            }
        }
        return pos
    }

    func analyzeDisasm(){
        disasmBox.clear()
        gLines = []
        if fileSize < 8 {
            disasmBox.add_item("文件太小,无法包含 LENB 尾部")
            return
        }
        int tailMagic = readU32(fileData, fileSize - 4)
        if tailMagic != LENB_MAGIC {
            disasmBox.add_item("未检测到 LENB 尾部数据")
            disasmBox.add_item("尾部魔数: 0x" + toHex8(tailMagic) + " (期望 0x" + toHex8(LENB_MAGIC) + ")")
            return
        }
        int lenbSize = readU32(fileData, fileSize - 8)
        if lenbSize <= 0 or lenbSize > fileSize - 8 {
            disasmBox.add_item("LENB 大小异常: " + _str(lenbSize))
            return
        }
        int lenbStart = fileSize - 8 - lenbSize
        gLenbOff = lenbStart
        gLenbPos = lenbStart
        gLenbEnd = fileSize - 8
        if gLenbEnd - gLenbOff < 20 {
            disasmBox.add_item("LENB 数据太短")
            return
        }
        int magic = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
        int version = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
        int flags = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
        string srcHash = rbe_i64_hex(gLenbPos)
        gLenbPos = gLenbPos + 8
        gLines.add("; ===== LENB Header =====")
        gLines.add("; magic:    0x" + toHex8(magic))
        gLines.add("; version:  0x" + toHex8(version))
        gLines.add("; flags:    0x" + toHex8(flags))
        gLines.add("; src_hash: " + srcHash)
        gLines.add("; blob_off: 0x" + toHex8(gLenbOff))
        gLines.add("; blob_end: 0x" + toHex8(gLenbEnd))
        int parseStart = skipHeaderAndSymbols(gLenbPos)
        gDepth = 0
        gLenbPos = parseStart
        gLines.add("; ===== (跳过符号表,跳到模块主体) =====")
        parseOneChunkBody(0)
        for 0:gLines.len()-1 to li {
            disasmBox.add_item(gLines[li])
        }
    }

    // ==================== 事件处理 ====================

    func handleEvent(Event ev): bool {
        if ev.isQuit() or ev.isWindowClose() { return false }
        if titleBar.is_close_requested() {
            titleBar.clear_close_request()
            return false
        }
        if ev.isKeyDown() and ev.scancode() == Scancode.ESCAPE { return false }
        return true
    }

    // ==================== 主入口 ====================

    func run() {
        SDL3.ttfInit()

        win = SDL3.createWindow({
            title: "Leno PE 分析器",
            w: 1100, h: 700,
            flags: WindowFlag.RESIZABLE
        })
        if not win.ok { SDL3.ttfQuit(); return }
        win.setMinSize(700, 500)

        setupUI()

        win.run(
            func(Event ev): bool { return handleEvent(ev) },
            func(Renderer r) { }
        )

        SDL3.ttfQuit()
    }
}

// ==================== 程序入口 ====================

main() {
    PEAnalyzer app = new PEAnalyzer()
    app.run()
}