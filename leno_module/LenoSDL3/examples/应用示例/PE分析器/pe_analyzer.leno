// pe_analyzer.leno -- Leno PE 分析器（可视化界面版）
//
// 基于 SDL3 GUI 的 PE/EXE 文件分析器，支持：
//   1. 通过文件对话框选择 .exe/.dll 文件
//   2. 解析 DOS 头、PE 头、节区表、导入表
//   3. 检测 LENB 尾部附加数据（Leno 编译器生成的元信息）
//   4. XOR(LENO) 加密字符串搜索与解密
//   5. LENB 字节码反汇编(显示 opcode、常量池、跳转目标、行号)
//   6. 反汇编 Table 支持右键菜单修改数据、写回磁盘、查找数据
//
// 运行：leno pe_analyzer.leno
import "../../../lib/SDL3.leno" as SDL3
import "../../../lib/sdl_filedialog.leno" as fdlg
use SDL3.(Event, Renderer, Window, WindowFlag, TitleBar, Scancode)
use SDL3.(Button, Label, ListBox, Table, HBox, VBox, TabControl, Edit)
import files
import strings
import dirs

// ==================== PE 解析常量 ====================

const LENB_MAGIC = 0x424E454C  // "LENB" little-endian (trailer)
const DOS_MAGIC  = 0x5A4D      // "MZ" little-endian
const PE_MAGIC   = 0x00004550  // "PE\0\0" little-endian

// 16 进制字符表
const HEX_CHARS = "0123456789ABCDEF"

// XOR 密钥 "LENO" = 0x4C, 0x45, 0x4E, 0x4F
func xorKey(int i): int {
    switch i % 4 {
        case 0 { return 0x4C }
        case 1 { return 0x45 }
        case 2 { return 0x4E }
        default { return 0x4F }
    }
}

// ==================== 二进制读取工具函数 ====================
// 注意：readU32/readU16 读取小端，用于 PE 头和文件尾部 trailer
//       rbe32/rbe16 读取大端，用于 LENB blob 内部数据

// 从 string 的指定偏移读取 4 字节小端 uint32
func readU32(string data, int off): int {
    int val = 0
    for 0:3 to i {
        val = val | (data.byte(off + i) << (i * 8))
    }
    return val
}

// 从 string 的指定偏移读取 2 字节小端 uint16
func readU16(string data, int off): int {
    return data.byte(off) | (data.byte(off + 1) << 8)
}

// 从 string 的指定偏移读取 1 字节
func readU8(string data, int off): int {
    return data.byte(off)
}

// ==================== 格式化工具函数 ====================

func toHex8(int v): string {
    string s = ""
    for 7:0:-1 to i {
        int nibble = (v >> (i * 4)) & 0xF
        s = s + HEX_CHARS[nibble]
    }
    return s
}

func toHex4(int v): string {
    string s = ""
    for 3:0:-1 to i {
        int nibble = (v >> (i * 4)) & 0xF
        s = s + HEX_CHARS[nibble]
    }
    return s
}

func toHex2(int v): string {
    int hi = (v >> 4) & 0xF
    int lo = v & 0xF
    return HEX_CHARS[hi] + HEX_CHARS[lo]
}

func fmtSize(int b): string {
    if b < 1024 { return b + " B" }
    float kb = _float(b) / 1024.0
    if kb < 1024.0 { return _int(kb) + " KB" }
    float mb = kb / 1024.0
    if mb < 1024.0 { return _int(mb) + " MB" }
    float gb = mb / 1024.0
    int gbInt = _int(gb)
    int tenths = _int((gb - _float(gbInt)) * 10.0)
    if tenths == 0 { return gbInt + " GB" }
    return gbInt + "." + tenths + " GB"
}

func sectionFlagsName(int flags): string {
    Array[string] parts = []
    if (flags & 0x20000000) != 0 { parts.add("X") }
    if (flags & 0x40000000) != 0 { parts.add("R") }
    if (flags & 0x80000000) != 0 { parts.add("W") }
    if (flags & 0x20) != 0 { parts.add("CODE") }
    if (flags & 0x40) != 0 { parts.add("IDATA") }
    if (flags & 0x80) != 0 { parts.add("UDATA") }
    return parts.join("/")
}

func subsystemName(int sub): string {
    switch sub {
        case 0 { return "未知" }
        case 1 { return "原生" }
        case 2 { return "Windows GUI" }
        case 3 { return "Windows 控制台" }
        case 5 { return "OS/2 字符" }
        case 7 { return "Posix 字符" }
        case 9 { return "Windows CE GUI" }
        case 10 { return "EFI 应用" }
        case 11 { return "EFI 启动服务" }
        case 12 { return "EFI 运行时" }
        case 13 { return "EFI ROM" }
        case 14 { return "XBOX" }
    }
    return "其他(" + sub + ")"
}

func machineName(int mach): string {
    switch mach {
        case 0x014C { return "x86 (i386)" }
        case 0x0200 { return "Intel Itanium" }
        case 0x8664 { return "x64 (AMD64)" }
        case 0x01C0 { return "ARM" }
        case 0xAA64 { return "ARM64" }
    }
    return "未知(0x" + toHex4(mach) + ")"
}

// ==================== PE 分析器结构体 ====================

struct PEAnalyzer {
    // ===== 布局常量 =====
    float PAD = 8.0

    // ===== UI 控件引用 =====
    Window      win
    TitleBar    titleBar
    Button      browseBtn
    Button      analyzeBtn
    Label       fileLbl
    Label       statusLbl
    TabControl  tab

    // 各页的展示控件
    ListBox     overviewBox
    Table       dosTable
    Table       peTable
    Table       sectionTable
    Table       importTable
    ListBox     lenbBox
    Table       xorTable
    Table       disasmTable

    // 反汇编页搜索栏
    Edit        disasmSearchEdit
    Button      disasmSearchBtn
    Button      disasmSaveBtn
    Button      disasmSearchNextBtn

    // 反汇编数据缓存（用于搜索和保存）
    Array[Array[string]] disasmRows = []
    int         disasmSearchPos = 0  // 搜索当前匹配位置
    string      disasmSearchKey = "" // 搜索关键字

    // ===== 分析状态 =====
    string filePath = ""
    string fileData  = ""
    int    fileSize  = 0
    bool   analyzed  = false

    // PE 解析结果缓存
    int dosHeaderOff = 0
    int peHeaderOff  = 0
    int optHeaderOff = 0
    int sectionTableOff = 0
    int sectionCount = 0
    int is64bit = 0

    // LENB 区域缓存
    int gLenbOff = 0
    int gLenbPos = 0
    int gLenbEnd = 0

    // 反汇编行累加器
    Array[string] gLines = []
    int gLineCount = 0

    // ==================== RVA 转文件偏移 ====================

    func rvaToOffset(int rva): int {
        int secSize = 40
        for sectionCount to i {
            int off = sectionTableOff + i * secSize
            if off + secSize > fileSize { break }
            int virtSize = readU32(fileData, off + 8)
            int virtAddr = readU32(fileData, off + 12)
            int rawOff   = readU32(fileData, off + 20)
            if rva >= virtAddr and rva < virtAddr + virtSize {
                return rawOff + (rva - virtAddr)
            }
        }
        return 0
    }

    // 从文件偏移读取 C 字符串（以 \0 结尾，最多 maxLen 字节）
    func readCString(int fileOff, int maxLen): string {
        string s = ""
        int i = 0
        while i < maxLen and fileOff + i < fileSize {
            int b = fileData.byte(fileOff + i)
            if b == 0 { break }
            if b >= 0x20 and b <= 0x7E {
                s = s + strings.char(b)
            } else {
                s = s + "."
            }
            i = i + 1
        }
        return s
    }

    // ==================== UI 构建 ====================

    func setupUI() {
        titleBar = SDL3.createTitleBar({title: "Leno PE 分析器", height: 32, font_size: 14})
        win.add(titleBar)
        float titleH = titleBar.get_h()

        var toolbar = SDL3.createHBox({h: 36, padX: 4, padY: 2, spacing: 6})

        browseBtn = SDL3.createButton({w: 80, h: 28, text: "浏览...", font_size: 14})
        toolbar.add(browseBtn, {grow: 0, shrink: 0, basis: 80, align: 3})
        browseBtn.on_click(func() { onBrowse() })

        fileLbl = SDL3.createLabel({text: "文件: (未选择)", font_size: 13})
        toolbar.add(fileLbl, {grow: 1, shrink: 1, align: 3})

        analyzeBtn = SDL3.createButton({w: 70, h: 28, text: "分析", font_size: 14})
        toolbar.add(analyzeBtn, {grow: 0, shrink: 0, basis: 70, align: 3})
        analyzeBtn.set_enabled(false)
        analyzeBtn.on_click(func() { onAnalyze() })

        tab = SDL3.createTabControl({
            tabs: ["概览", "DOS 头", "PE 头", "节区", "导入表", "LENB", "XOR 字符串", "反汇编"],
            active: 0,
            font_size: 14
        })

        // 概览页
        overviewBox = SDL3.createListBox({font_size: 13})
        var overviewLayout = SDL3.createVBox({padX: PAD, padY: PAD, spacing: 0})
        overviewLayout.add(overviewBox, {grow: 1, shrink: 1, align: 3})
        tab.setPageLayout(0, overviewLayout)

        // DOS 头页
        dosTable = SDL3.createTable({
            headers: ["字段", "值", "说明"],
            col_widths: [180.0, 200.0, 400.0],
            sortable: false, zebra: true, row_h: 24, header_h: 28, font_size: 13
        })
        var dosLayout = SDL3.createVBox({padX: PAD, padY: PAD, spacing: 0})
        dosLayout.add(dosTable, {grow: 1, shrink: 1, align: 3})
        tab.setPageLayout(1, dosLayout)

        // PE 头页
        peTable = SDL3.createTable({
            headers: ["字段", "值", "说明"],
            col_widths: [180.0, 200.0, 400.0],
            sortable: false, zebra: true, row_h: 24, header_h: 28, font_size: 13
        })
        var peLayout = SDL3.createVBox({padX: PAD, padY: PAD, spacing: 0})
        peLayout.add(peTable, {grow: 1, shrink: 1, align: 3})
        tab.setPageLayout(2, peLayout)

        // 节区页
        sectionTable = SDL3.createTable({
            headers: ["序号", "名称", "虚拟大小", "虚拟地址", "原始大小", "原始偏移", "特征值"],
            col_widths: [50.0, 120.0, 100.0, 100.0, 100.0, 100.0, 150.0],
            sortable: true, zebra: true, row_h: 24, header_h: 28, font_size: 13
        })
        var secLayout = SDL3.createVBox({padX: PAD, padY: PAD, spacing: 0})
        secLayout.add(sectionTable, {grow: 1, shrink: 1, align: 3})
        tab.setPageLayout(3, secLayout)

        // 导入表页
        importTable = SDL3.createTable({
            headers: ["DLL", "函数名", "RVA", "序号"],
            col_widths: [200.0, 400.0, 100.0, 80.0],
            sortable: true, zebra: true, row_h: 24, header_h: 28, font_size: 13
        })
        var impLayout = SDL3.createVBox({padX: PAD, padY: PAD, spacing: 0})
        impLayout.add(importTable, {grow: 1, shrink: 1, align: 3})
        tab.setPageLayout(4, impLayout)

        // LENB 页
        lenbBox = SDL3.createListBox({font_size: 13})
        var lenbLayout = SDL3.createVBox({padX: PAD, padY: PAD, spacing: 0})
        lenbLayout.add(lenbBox, {grow: 1, shrink: 1, align: 3})
        tab.setPageLayout(5, lenbLayout)

        // XOR 字符串页
        xorTable = SDL3.createTable({
            headers: ["序号", "偏移", "长度", "解密内容"],
            col_widths: [50.0, 120.0, 60.0, 600.0],
            sortable: true, zebra: true, row_h: 24, header_h: 28, font_size: 13
        })
        var xorLayout = SDL3.createVBox({padX: PAD, padY: PAD, spacing: 0})
        xorLayout.add(xorTable, {grow: 1, shrink: 1, align: 3})
        tab.setPageLayout(6, xorLayout)

        // 反汇编页
        var disasmToolbar = SDL3.createHBox({h: 36, padX: 4, padY: 2, spacing: 6})
        disasmSearchEdit = SDL3.createEdit({w: 200, h: 28, font_size: 13, placeholder: "搜索指令/地址/操作数..."})
        disasmToolbar.add(disasmSearchEdit, {grow: 1, shrink: 1, align: 3})
        disasmSearchBtn = SDL3.createButton({w: 60, h: 28, text: "查找", font_size: 14})
        disasmToolbar.add(disasmSearchBtn, {grow: 0, shrink: 0, basis: 60, align: 3})
        disasmSearchNextBtn = SDL3.createButton({w: 70, h: 28, text: "下一个", font_size: 14})
        disasmToolbar.add(disasmSearchNextBtn, {grow: 0, shrink: 0, basis: 70, align: 3})
        disasmSaveBtn = SDL3.createButton({w: 80, h: 28, text: "保存修改", font_size: 14})
        disasmToolbar.add(disasmSaveBtn, {grow: 0, shrink: 0, basis: 80, align: 3})
        disasmSearchBtn.on_click(func() { onDisasmSearch() })
        disasmSearchNextBtn.on_click(func() { onDisasmSearchNext() })
        disasmSaveBtn.on_click(func() { onDisasmSave() })
        disasmSearchEdit.on_enter(func() { onDisasmSearch() })

        disasmTable = SDL3.createTable({
            headers: ["地址", "行号", "指令", "操作数", "原始字节"],
            col_widths: [110.0, 60.0, 160.0, 200.0, 300.0],
            sortable: true, zebra: true, row_h: 22, header_h: 28, font_size: 12,
            editable: false, cell_select: true
        })
        var disasmLayout = SDL3.createVBox({padX: PAD, padY: PAD, spacing: 4})
        disasmLayout.add(disasmToolbar, {grow: 0, shrink: 0, align: 3})
        disasmLayout.add(disasmTable, {grow: 1, shrink: 1, align: 3})
        tab.setPageLayout(7, disasmLayout)

        // 反汇编 Table 右键菜单
        disasmTable.addContextItem({label: "修改此单元格", id: "edit_cell", shortcut: "F2"})
        disasmTable.addContextItem({label: "修改整行数据", id: "edit_row"})
        disasmTable.addContextSeparator()
        disasmTable.addContextItem({label: "复制整行", id: "copy_row", shortcut: "Ctrl+C"})
        disasmTable.addContextItem({label: "复制地址", id: "copy_addr"})
        disasmTable.addContextSeparator()
        disasmTable.addContextItem({label: "跳转到地址...", id: "goto_addr"})
        disasmTable.addContextItem({label: "保存修改到文件", id: "save_file"})
        disasmTable.on_context_select(func(int row, string id) { onDisasmContext(row, id) })
        disasmTable.on_context_will_open(func(int row) { onDisasmCtxWillOpen(row) })
        disasmTable.on_edit_commit(func(int row, int col, string newText) { onDisasmEditCommit(row, col, newText) })
        disasmTable.on_cell(func(int row, int col) { onDisasmCellClick(row, col) })

        // 状态栏
        statusLbl = SDL3.createLabel({text: "就绪 - 点击[浏览...]选择 PE 文件", font_size: 13})

        // 根布局
        var root = SDL3.createVBox({padX: PAD, padY: PAD, spacing: 4})
        root.add(toolbar, {grow: 0, shrink: 0, align: 3})
        root.add(tab, {grow: 1, shrink: 1, align: 3})
        root.add(statusLbl, {grow: 0, shrink: 0, basis: 22, align: 3})
        win.setRootAt(root, 0, titleH)
    }

    // ==================== 事件回调 ====================

    func onBrowse() {
        fdlg.showOpenFileDialog(win, func(Array[string] paths, int filter) {
            if paths != null and paths.len() > 0 {
                filePath = paths[0]
                fileLbl.set_text("文件: " + dirs.basename(filePath))
                analyzeBtn.set_enabled(true)
                statusLbl.set_text("已选择: " + filePath)
                SDL3.markFrameRedraw()
            }
        }, {
            filters: [
                {name: "可执行文件", pattern: "*.exe"},
                {name: "动态链接库", pattern: "*.dll"},
                {name: "所有文件", pattern: "*.*"}
            ],
            default_location: dirs.dirname(dirs.script_dir())
        })
    }

    func onAnalyze() {
        if filePath == "" {
            statusLbl.set_text("错误: 请先选择文件")
            SDL3.markFrameRedraw()
            return
        }
        if not files.exists(filePath) {
            statusLbl.set_text("错误: 文件不存在")
            SDL3.markFrameRedraw()
            return
        }

        statusLbl.set_text("正在读取文件...")
        SDL3.markFrameRedraw()

        File f = files.open(filePath, "rb")
        if f == null {
            statusLbl.set_text("错误: 无法打开文件")
            SDL3.markFrameRedraw()
            return
        }
        fileSize = f.len()
        fileData = f.read(fileSize)
        f.close()

        // 用 byte_len() 校准实际读到的字节数
        // 注意: len() 返回 UTF-8 字符数, byte_len() 返回字节数
        // 二进制文件必须用 byte_len(), 否则边界检查会出错
        fileSize = fileData.byte_len()

        if fileSize < 64 {
            statusLbl.set_text("错误: 文件太小，不是有效的 PE 文件")
            SDL3.markFrameRedraw()
            return
        }

        statusLbl.set_text("正在解析 PE 结构...")
        SDL3.markFrameRedraw()

        analyzed = true
        analyzeOverview()
        analyzeDOSHeader()
        analyzePEHeader()
        analyzeSections()
        analyzeImports()
        analyzeLENB()
        analyzeXORStrings()
        analyzeDisasm()

        statusLbl.set_text("分析完成 - " + dirs.basename(filePath) + " (" + fmtSize(fileSize) + ")")
        SDL3.markFrameRedraw()
    }

    // ==================== 概览页 ====================

    func analyzeOverview() {
        overviewBox.clear()
        overviewBox.add_item("========== 文件概览 ==========")
        overviewBox.add_item("文件路径: " + filePath)
        overviewBox.add_item("文件名: " + dirs.basename(filePath))
        overviewBox.add_item("文件大小: " + fileSize + " bytes (" + fmtSize(fileSize) + ")")
        overviewBox.add_item("")

        int dosMagic = readU16(fileData, 0)
        if dosMagic == DOS_MAGIC {
            overviewBox.add_item("[DOS 头] MZ 魔数: 0x" + toHex4(dosMagic) + " (有效)")
            peHeaderOff = readU32(fileData, 0x3C)
            overviewBox.add_item("[DOS 头] e_lfanew (PE 头偏移): 0x" + toHex8(peHeaderOff))
        } else {
            overviewBox.add_item("[DOS 头] MZ 魔数: 0x" + toHex4(dosMagic) + " (无效! 不是 PE 文件)")
            overviewBox.add_item("x 该文件不是有效的 PE/EXE 文件")
            return
        }

        if peHeaderOff + 4 <= fileSize {
            int peSig = readU32(fileData, peHeaderOff)
            if peSig == PE_MAGIC {
                overviewBox.add_item("[PE 头] PE 签名: 0x" + toHex8(peSig) + " (PE\\0\\0, 有效)")
            } else {
                overviewBox.add_item("[PE 头] PE 签名: 0x" + toHex8(peSig) + " (无效!)")
                return
            }
        }

        if peHeaderOff + 6 <= fileSize {
            int machine = readU16(fileData, peHeaderOff + 4)
            overviewBox.add_item("[PE 头] 机器类型: " + machineName(machine))
        }

        if peHeaderOff + 8 <= fileSize {
            sectionCount = readU16(fileData, peHeaderOff + 6)
            overviewBox.add_item("[PE 头] 节区数量: " + sectionCount)
        }

        optHeaderOff = peHeaderOff + 24
        if optHeaderOff + 2 <= fileSize {
            int optMagic = readU16(fileData, optHeaderOff)
            switch optMagic {
                case 0x010B {
                    is64bit = 0
                    overviewBox.add_item("[可选头] Magic: 0x" + toHex4(optMagic) + " (PE32, 32位)")
                }
                case 0x20B {
                    is64bit = 1
                    overviewBox.add_item("[可选头] Magic: 0x" + toHex4(optMagic) + " (PE32+, 64位)")
                }
                default {
                    overviewBox.add_item("[可选头] Magic: 0x" + toHex4(optMagic) + " (未知格式)")
                }
            }
        }

        if optHeaderOff + 20 <= fileSize {
            int entryRVA = readU32(fileData, optHeaderOff + 16)
            overviewBox.add_item("[可选头] 入口点 RVA: 0x" + toHex8(entryRVA))
        }

        if peHeaderOff + 22 <= fileSize {
            sectionTableOff = peHeaderOff + 24 + readU16(fileData, peHeaderOff + 20)
            overviewBox.add_item("[节区表] 偏移: 0x" + toHex8(sectionTableOff))
        }
        overviewBox.add_item("")

        // LENB 检测 (trailer 使用小端)
        if fileSize >= 8 {
            int magicTail = readU32(fileData, fileSize - 4)
            int lenbSize = readU32(fileData, fileSize - 8)
            if magicTail == LENB_MAGIC {
                overviewBox.add_item("[LENB] 检测到 Leno 尾部附加数据!")
                overviewBox.add_item("[LENB] 魔数: 0x" + toHex8(magicTail) + " (LENB)")
                overviewBox.add_item("[LENB] 数据大小: " + lenbSize + " bytes")
                int lenbOff = fileSize - 8 - lenbSize
                overviewBox.add_item("[LENB] 数据偏移: 0x" + toHex8(lenbOff))
            } else {
                overviewBox.add_item("[LENB] 未检测到 Leno 尾部数据")
            }
        }
        overviewBox.add_item("")
        overviewBox.add_item("========== 分析完成 ==========")
    }

    // ==================== DOS 头页 ====================

    func analyzeDOSHeader() {
        Array[Array[string]] rows = []
        if fileSize < 64 { dosTable.set_rows(rows); return }

        rows.add(["e_magic", "0x" + toHex4(readU16(fileData, 0)), "DOS 魔数 'MZ' (0x5A4D)"])
        rows.add(["e_cblp", _str(readU16(fileData, 2)), "最后一页字节数"])
        rows.add(["e_cp", _str(readU16(fileData, 4)), "文件页数"])
        rows.add(["e_crlc", _str(readU16(fileData, 6)), "重定位项数"])
        rows.add(["e_cparhdr", _str(readU16(fileData, 8)), "头部段落大小(每段16字节)"])
        rows.add(["e_minalloc", _str(readU16(fileData, 10)), "最少需要的额外段落数"])
        rows.add(["e_maxalloc", _str(readU16(fileData, 12)), "最多需要的额外段落数"])
        rows.add(["e_ss", _str(readU16(fileData, 14)), "初始 SS"])
        rows.add(["e_sp", _str(readU16(fileData, 16)), "初始 SP"])
        rows.add(["e_csum", _str(readU16(fileData, 18)), "校验和"])
        rows.add(["e_ip", _str(readU16(fileData, 20)), "初始 IP"])
        rows.add(["e_cs", _str(readU16(fileData, 22)), "初始 CS"])
        rows.add(["e_lfarlc", _str(readU16(fileData, 24)), "重定位表偏移"])
        rows.add(["e_ovno", _str(readU16(fileData, 26)), "覆盖号"])
        rows.add(["e_lfanew", "0x" + toHex8(readU32(fileData, 0x3C)), "PE 头偏移(指向 PE 签名)"])

        dosTable.set_rows(rows)
    }

    // ==================== PE 头页 ====================

    func analyzePEHeader() {
        Array[Array[string]] rows = []
        if peHeaderOff == 0 or peHeaderOff + 24 > fileSize {
            peTable.set_rows(rows)
            return
        }

        rows.add(["--- COFF 头 ---", "", ""])
        rows.add(["Machine", "0x" + toHex4(readU16(fileData, peHeaderOff + 4)), machineName(readU16(fileData, peHeaderOff + 4))])
        rows.add(["NumberOfSections", _str(readU16(fileData, peHeaderOff + 6)), "节区数量"])
        rows.add(["TimeDateStamp", "0x" + toHex8(readU32(fileData, peHeaderOff + 8)), "时间戳(Unix)"])
        rows.add(["PointerToSymbolTable", "0x" + toHex8(readU32(fileData, peHeaderOff + 12)), "符号表偏移"])
        rows.add(["NumberOfSymbols", _str(readU32(fileData, peHeaderOff + 16)), "符号表数量"])
        rows.add(["SizeOfOptionalHeader", _str(readU16(fileData, peHeaderOff + 20)), "可选头大小(字节)"])
        rows.add(["Characteristics", "0x" + toHex4(readU16(fileData, peHeaderOff + 22)), "文件特征值"])

        optHeaderOff = peHeaderOff + 24
        int optSize = readU16(fileData, peHeaderOff + 20)
        if optSize > 0 and optHeaderOff + optSize <= fileSize {
            rows.add(["", "", ""])
            rows.add(["--- 可选头 ---", "", ""])

            int optMagic = readU16(fileData, optHeaderOff)
            string magicStr = "未知"
            switch optMagic {
                case 0x010B { magicStr = "PE32 (32位)" }
                case 0x20B { magicStr = "PE32+ (64位)" }
            }
            rows.add(["Magic", "0x" + toHex4(optMagic), magicStr])

            rows.add(["MajorLinkerVersion", _str(readU8(fileData, optHeaderOff + 2)), "链接器主版本号"])
            rows.add(["MinorLinkerVersion", _str(readU8(fileData, optHeaderOff + 3)), "链接器次版本号"])
            rows.add(["SizeOfCode", _str(readU32(fileData, optHeaderOff + 4)), "代码段总大小"])
            rows.add(["SizeOfInitializedData", _str(readU32(fileData, optHeaderOff + 8)), "已初始化数据大小"])
            rows.add(["SizeOfUninitializedData", _str(readU32(fileData, optHeaderOff + 12)), "未初始化数据大小"])
            rows.add(["AddressOfEntryPoint", "0x" + toHex8(readU32(fileData, optHeaderOff + 16)), "入口点 RVA"])
            rows.add(["BaseOfCode", "0x" + toHex8(readU32(fileData, optHeaderOff + 20)), "代码段基址 RVA"])

            switch optMagic {
                case 0x010B {
                    rows.add(["BaseOfData", "0x" + toHex8(readU32(fileData, optHeaderOff + 24)), "数据段基址 RVA"])
                    rows.add(["ImageBase", "0x" + toHex8(readU32(fileData, optHeaderOff + 28)), "镜像基址"])
                    rows.add(["SectionAlignment", "0x" + toHex8(readU32(fileData, optHeaderOff + 32)), "节区对齐粒度"])
                    rows.add(["FileAlignment", "0x" + toHex8(readU32(fileData, optHeaderOff + 36)), "文件对齐粒度"])
                    rows.add(["MajorOSVersion", _str(readU16(fileData, optHeaderOff + 40)), "所需 OS 主版本号"])
                    rows.add(["MinorOSVersion", _str(readU16(fileData, optHeaderOff + 42)), "所需 OS 次版本号"])
                    rows.add(["MajorImageVersion", _str(readU16(fileData, optHeaderOff + 44)), "镜像主版本号"])
                    rows.add(["MinorImageVersion", _str(readU16(fileData, optHeaderOff + 46)), "镜像次版本号"])
                    rows.add(["MajorSubsystemVersion", _str(readU16(fileData, optHeaderOff + 48)), "子系统主版本号"])
                    rows.add(["MinorSubsystemVersion", _str(readU16(fileData, optHeaderOff + 50)), "子系统次版本号"])
                    rows.add(["SizeOfImage", "0x" + toHex8(readU32(fileData, optHeaderOff + 56)), "镜像总大小"])
                    rows.add(["SizeOfHeaders", "0x" + toHex8(readU32(fileData, optHeaderOff + 60)), "头部大小"])
                    rows.add(["Subsystem", _str(readU16(fileData, optHeaderOff + 68)), subsystemName(readU16(fileData, optHeaderOff + 68))])
                    rows.add(["CheckSum", "0x" + toHex8(readU32(fileData, optHeaderOff + 64)), "校验和"])
                }
                case 0x20B {
                    rows.add(["ImageBase", "0x" + toHex8(readU32(fileData, optHeaderOff + 24)), "镜像基址(低32位)"])
                    rows.add(["ImageBase_Hi", "0x" + toHex8(readU32(fileData, optHeaderOff + 28)), "镜像基址(高32位)"])
                    rows.add(["SectionAlignment", "0x" + toHex8(readU32(fileData, optHeaderOff + 32)), "节区对齐粒度"])
                    rows.add(["FileAlignment", "0x" + toHex8(readU32(fileData, optHeaderOff + 36)), "文件对齐粒度"])
                    rows.add(["MajorOSVersion", _str(readU16(fileData, optHeaderOff + 40)), "所需 OS 主版本号"])
                    rows.add(["MinorOSVersion", _str(readU16(fileData, optHeaderOff + 42)), "所需 OS 次版本号"])
                    rows.add(["SizeOfImage", "0x" + toHex8(readU32(fileData, optHeaderOff + 56)), "镜像总大小"])
                    rows.add(["SizeOfHeaders", "0x" + toHex8(readU32(fileData, optHeaderOff + 60)), "头部大小"])
                    rows.add(["Subsystem", _str(readU16(fileData, optHeaderOff + 68)), subsystemName(readU16(fileData, optHeaderOff + 68))])
                    rows.add(["CheckSum", "0x" + toHex8(readU32(fileData, optHeaderOff + 64)), "校验和"])
                }
            }
        }

        peTable.set_rows(rows)
    }

    // ==================== 节区页 ====================

    func analyzeSections() {
        Array[Array[string]] rows = []
        if sectionCount == 0 or sectionTableOff == 0 {
            sectionTable.set_rows(rows)
            return
        }

        int secSize = 40
        for sectionCount to i {
            int off = sectionTableOff + i * secSize
            if off + secSize > fileSize { break }

            string name = ""
            for 0:7 to j {
                int b = fileData.byte(off + j)
                if b == 0 { break }
                name = name + strings.char(b)
            }

            int virtSize = readU32(fileData, off + 8)
            int virtAddr = readU32(fileData, off + 12)
            int rawSize  = readU32(fileData, off + 16)
            int rawOff   = readU32(fileData, off + 20)
            int flags    = readU32(fileData, off + 36)

            rows.add([
                _str(i + 1),
                name,
                _str(virtSize),
                "0x" + toHex8(virtAddr),
                _str(rawSize),
                "0x" + toHex8(rawOff),
                "0x" + toHex8(flags) + " [" + sectionFlagsName(flags) + "]"
            ])
        }
        sectionTable.set_rows(rows)
    }

    // ==================== 导入表页 ====================

    func analyzeImports() {
        Array[Array[string]] rows = []

        int dataDirOff = optHeaderOff + 96
        if is64bit == 1 { dataDirOff = optHeaderOff + 112 }

        int impDirRVA = 0
        if dataDirOff + 8 <= fileSize {
            impDirRVA = readU32(fileData, dataDirOff + 8)
        }

        if impDirRVA == 0 {
            importTable.set_rows(rows)
            return
        }

        int impFileOff = rvaToOffset(impDirRVA)
        if impFileOff == 0 {
            importTable.set_rows(rows)
            return
        }

        int descSize = 20
        int maxDlls = 64
        int dllCount = 0

        while dllCount < maxDlls {
            int descOff = impFileOff + dllCount * descSize
            if descOff + descSize > fileSize { break }

            int origFirstThunk = readU32(fileData, descOff + 0)
            int nameRVA        = readU32(fileData, descOff + 12)
            int firstThunk     = readU32(fileData, descOff + 16)

            if nameRVA == 0 and firstThunk == 0 { break }

            int nameOff = rvaToOffset(nameRVA)
            string dllName = "???"
            if nameOff > 0 and nameOff < fileSize {
                dllName = readCString(nameOff, 256)
            }

            int thunkRVA = origFirstThunk
            if thunkRVA == 0 { thunkRVA = firstThunk }

            if thunkRVA == 0 {
                rows.add([dllName, "(无法解析 thunk)", "0x" + toHex8(firstThunk), "-"])
                dllCount = dllCount + 1
                continue
            }

            int thunkOff = rvaToOffset(thunkRVA)
            if thunkOff == 0 {
                rows.add([dllName, "(无法解析 thunk 偏移)", "0x" + toHex8(firstThunk), "-"])
                dllCount = dllCount + 1
                continue
            }

            int thunkSize = 4
            if is64bit == 1 { thunkSize = 8 }
            int maxFuncs = 512
            int funcCount = 0

            while funcCount < maxFuncs {
                int thunkEntryOff = thunkOff + funcCount * thunkSize
                if thunkEntryOff + thunkSize > fileSize { break }

                int thunkVal = readU32(fileData, thunkEntryOff)
                if thunkVal == 0 { break }

                if is64bit == 1 {
                    int thunkHi = readU32(fileData, thunkEntryOff + 4)
                    if (thunkHi & 0x80000000) != 0 {
                        int ordinal = thunkVal & 0xFFFF
                        rows.add([dllName, "Ordinal #" + ordinal, "0x" + toHex8(firstThunk + funcCount * 8), _str(ordinal)])
                    } else {
                        int hintNameOff = rvaToOffset(thunkVal)
                        if hintNameOff > 0 and hintNameOff + 2 < fileSize {
                            int hint = readU16(fileData, hintNameOff)
                            string funcName = readCString(hintNameOff + 2, 256)
                            rows.add([dllName, funcName, "0x" + toHex8(firstThunk + funcCount * 8), _str(hint)])
                        } else {
                            rows.add([dllName, "(名称偏移无效)", "0x" + toHex8(thunkVal), "-"])
                        }
                    }
                } else {
                    if (thunkVal & 0x80000000) != 0 {
                        int ordinal = thunkVal & 0xFFFF
                        rows.add([dllName, "Ordinal #" + ordinal, "0x" + toHex8(firstThunk + funcCount * 4), _str(ordinal)])
                    } else {
                        int hintNameOff = rvaToOffset(thunkVal)
                        if hintNameOff > 0 and hintNameOff + 2 < fileSize {
                            int hint = readU16(fileData, hintNameOff)
                            string funcName = readCString(hintNameOff + 2, 256)
                            rows.add([dllName, funcName, "0x" + toHex8(firstThunk + funcCount * 4), _str(hint)])
                        } else {
                            rows.add([dllName, "(名称偏移无效)", "0x" + toHex8(thunkVal), "-"])
                        }
                    }
                }
                funcCount = funcCount + 1
            }

            if funcCount == 0 {
                rows.add([dllName, "(无导入函数)", "-", "-"])
            }
            dllCount = dllCount + 1
        }

        importTable.set_rows(rows)
    }

    // ==================== LENB 页 ====================

    func analyzeLENB() {
        lenbBox.clear()
        lenbBox.add_item("========== LENB 尾部分析 ==========")

        if fileSize < 8 {
            lenbBox.add_item("x 文件太小，无法包含 LENB 尾部")
            return
        }

        // trailer 使用小端 (native endian on x86)
        int magicOff = fileSize - 4
        int sizeOff = fileSize - 8
        int magic = readU32(fileData, magicOff)
        int lenbSize = readU32(fileData, sizeOff)

        lenbBox.add_item("尾部魔数偏移: 0x" + toHex8(magicOff))
        lenbBox.add_item("尾部大小偏移: 0x" + toHex8(sizeOff))
        lenbBox.add_item("尾部 Magic: 0x" + toHex8(magic))
        lenbBox.add_item("LENB 期望值: 0x" + toHex8(LENB_MAGIC))
        lenbBox.add_item("匹配: " + (if magic == LENB_MAGIC then "是" else "否"))
        lenbBox.add_item("")

        if magic != LENB_MAGIC {
            lenbBox.add_item("x 未检测到 LENB 尾部数据")
            lenbBox.add_item("该文件可能不是 Leno 编译器生成的可执行文件")
            lenbBox.add_item("")
            lenbBox.add_item("========== LENB 分析完成 ==========")
            return
        }

        if lenbSize <= 0 or lenbSize > fileSize - 8 {
            lenbBox.add_item("x LENB 大小异常: " + lenbSize)
            return
        }

        int lenbOffset = fileSize - 8 - lenbSize
        lenbBox.add_item("v 检测到 LENB 尾部!")
        lenbBox.add_item("LENB 数据大小: " + lenbSize + " bytes")
        lenbBox.add_item("LENB 数据偏移: 0x" + toHex8(lenbOffset))
        lenbBox.add_item("")

        // LENB blob 内部使用大端 -- 用 rbe32 读取
        if lenbOffset + 20 <= fileSize {
            lenbBox.add_item("--- LENB 头部字段 (大端) ---")
            int lenbMagicVal = rbe32(lenbOffset)
            int lenbVersion = rbe32(lenbOffset + 4)
            int lenbFlags = rbe32(lenbOffset + 8)
            // src_hash 是 u64 BE (8 字节)
            string srcHashHex = rbe_i64_hex(lenbOffset + 12)

            lenbBox.add_item("Magic:    0x" + toHex8(lenbMagicVal))
            lenbBox.add_item("Version:  0x" + toHex8(lenbVersion))
            lenbBox.add_item("Flags:    0x" + toHex8(lenbFlags))
            lenbBox.add_item("SrcHash:  " + srcHashHex)

            // scope data 从 offset 20 开始
            if lenbOffset + 32 <= fileSize {
                int globalVars = rbe32(lenbOffset + 20)
                int globalFuncs = rbe32(lenbOffset + 24)
                int symCount = rbe32(lenbOffset + 28)
                lenbBox.add_item("全局变量数: " + globalVars)
                lenbBox.add_item("全局函数数: " + globalFuncs)
                lenbBox.add_item("符号数:     " + symCount)
            }
        }

        // Hex dump 前 64 字节
        lenbBox.add_item("")
        lenbBox.add_item("--- LENB 头部 Hex Dump (前 64 字节) ---")
        int dumpLen = 64
        if lenbOffset + dumpLen > fileSize { dumpLen = fileSize - lenbOffset }
        int row = 0
        while row * 16 < dumpLen {
            int rowOff = row * 16
            int rowEnd = rowOff + 16
            if rowEnd > dumpLen { rowEnd = dumpLen }
            string addr = toHex8(lenbOffset + rowOff)
            string hexData = ""
            string asciiData = ""
            for rowOff:rowEnd to j {
                int byteVal = fileData.byte(lenbOffset + j)
                hexData = hexData + toHex2(byteVal) + " "
                if byteVal >= 0x20 and byteVal <= 0x7E {
                    asciiData = asciiData + strings.char(byteVal)
                } else {
                    asciiData = asciiData + "."
                }
            }
            int padCount = rowEnd - rowOff
            while padCount < 16 {
                hexData = hexData + "   "
                padCount = padCount + 1
            }
            lenbBox.add_item("0x" + addr + "  " + hexData + " " + asciiData)
            row = row + 1
        }

        lenbBox.add_item("")
        lenbBox.add_item("========== LENB 分析完成 ==========")
    }

    // ==================== XOR 字符串页 ====================
    //
    // XOR(LENO) 字符串只存在于 LENB blob 内部，不扫描整个 PE 文件。
    // 这避免了在大型 exe 上因逐字节扫描+字符串拼接导致的内存爆炸。

    func analyzeXORStrings() {
        Array[Array[string]] rows = []

        // 检测 LENB 尾部
        if fileSize < 8 {
            xorTable.set_rows(rows)
            return
        }
        int magicTail = readU32(fileData, fileSize - 4)
        if magicTail != LENB_MAGIC {
            xorTable.set_rows(rows)
            return
        }
        int lenbSize = readU32(fileData, fileSize - 8)
        if lenbSize <= 0 or lenbSize > fileSize - 8 {
            xorTable.set_rows(rows)
            return
        }

        int lenbStart = fileSize - 8 - lenbSize
        int lenbEnd = fileSize - 8

        // 只在 LENB blob 范围内搜索
        int pos = lenbStart
        int found = 0
        int maxResults = 500

        while pos < lenbEnd - 4 and found < maxResults {
            // 尝试在当前位置读取 XOR 字符串: u32 BE length + XOR bytes
            int strLen = rbe32(pos)
            if strLen >= 4 and strLen <= 10000 and pos + 4 + strLen <= lenbEnd {
                // 解密并检查是否为可打印字符串
                bool printable = true
                for 0:strLen-1 to j {
                    int b = fileData.byte(pos + 4 + j)
                    int dec = (b ^ xorKey(j)) & 0xFF
                    if dec < 0x20 or dec > 0x7E {
                        printable = false
                        break
                    }
                }
                if printable {
                    // 解密字符串
                    string decrypted = ""
                    for 0:strLen-1 to j {
                        int b = fileData.byte(pos + 4 + j)
                        int dec = (b ^ xorKey(j)) & 0xFF
                        decrypted = decrypted + strings.char(dec)
                    }
                    found = found + 1
                    rows.add([
                        _str(found),
                        "0x" + toHex8(pos),
                        _str(strLen),
                        decrypted
                    ])
                    pos = pos + 4 + strLen
                    continue
                }
            }
            pos = pos + 1
        }

        xorTable.set_rows(rows)
    }

    // ==================== 反汇编器辅助函数 ====================
    // LENB blob 内部所有整数使用大端 (big-endian)

    func rbe32(int off): int {
        int b0 = fileData.byte(off) & 0xFF
        int b1 = fileData.byte(off + 1) & 0xFF
        int b2 = fileData.byte(off + 2) & 0xFF
        int b3 = fileData.byte(off + 3) & 0xFF
        return (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
    }

    func rbe16(int off): int {
        int b0 = fileData.byte(off) & 0xFF
        int b1 = fileData.byte(off + 1) & 0xFF
        return (b0 << 8) | b1
    }

    func rbe_i64_hex(int off): string {
        int hi = rbe32(off)
        int lo = rbe32(off + 4)
        return "0x" + toHex8(hi) + toHex8(lo)
    }

    // 从 gLenbPos 读取 XOR 加密字符串 (长度前缀已由调用方读取)
    func readXorStr(int byteLen): string {
        if byteLen < 0 or gLenbPos + byteLen > gLenbEnd {
            gLenbPos = gLenbEnd
            return "<invalid>"
        }
        if byteLen > 10000 {
            gLenbPos = gLenbPos + byteLen
            return "<long:" + _str(byteLen) + ">"
        }
        string s = ""
        for 0:byteLen-1 to i {
            int key = xorKey(i)
            int plain = (fileData.byte(gLenbPos) ^ key) & 0xFF
            s = s + strings.char(plain)
            gLenbPos = gLenbPos + 1
        }
        return s
    }

    // 跳过一个 XOR 字符串 (只推进 gLenbPos，不解密)
    func skipXorStr() {
        int n = rbe32(gLenbPos)
        gLenbPos = gLenbPos + 4
        if n < 0 or gLenbPos + n > gLenbEnd {
            gLenbPos = gLenbEnd
            return
        }
        gLenbPos = gLenbPos + n
    }

    // ==================== 常量标签名 ====================

    func constTagName(int tag): string {
        switch tag {
            case 0x00 { return "NULL" }
            case 0x01 { return "TRUE" }
            case 0x02 { return "FALSE" }
            case 0x03 { return "INT" }
            case 0x04 { return "FLOAT" }
            case 0x05 { return "STRING" }
            case 0x06 { return "FUNCTION" }
            case 0x07 { return "BIGINT" }
            case 0x08 { return "RANGE" }
            case 0x09 { return "ARRAY" }
            case 0x0A { return "DICT" }
            case 0x0B { return "ENUM_DEF" }
            case 0x0C { return "STRUCT_DEF" }
            case 0x0D { return "CSTRUCT_DEF" }
            case 0x0E { return "FACE_DEF" }
            case 0x0F { return "MODULE" }
            case 0x10 { return "FFI_PTR" }
            case 0x11 { return "CLOSURE" }
            case 0x12 { return "FFI_LIB" }
            case 0x13 { return "MODULE_REF" }
        }
        return "TAG_0x" + toHex2(tag)
    }

    // ==================== Opcode 名称表 ====================

    func opName(int code): string {
        switch code {
            case 0 { return "OP_CONST" }
            case 1 { return "OP_NULL" }
            case 2 { return "OP_TRUE" }
            case 3 { return "OP_FALSE" }
            case 4 { return "OP_ZERO" }
            case 5 { return "OP_ONE" }
            case 6 { return "OP_POP" }
            case 7 { return "OP_DUP" }
            case 8 { return "OP_GET_LOCAL" }
            case 9 { return "OP_SET_LOCAL" }
            case 10 { return "OP_SET_LOCAL_POP" }
            case 11 { return "OP_MOVE_LOCAL" }
            case 12 { return "OP_GET_GLOBAL" }
            case 13 { return "OP_SET_GLOBAL" }
            case 14 { return "OP_GET_UPVALUE" }
            case 15 { return "OP_SET_UPVALUE" }
            case 16 { return "OP_CLOSE_UPVALUE" }
            case 17 { return "OP_DEFINE_GLOBAL" }
            case 18 { return "OP_GET_GLOBAL_FUNC" }
            case 19 { return "OP_DEFINE_GLOBAL_FUNC" }
            case 20 { return "OP_GET_NATIVE" }
            case 21 { return "OP_ADD" }
            case 22 { return "OP_SUB" }
            case 23 { return "OP_MUL" }
            case 24 { return "OP_DIV" }
            case 25 { return "OP_MOD" }
            case 26 { return "OP_BITAND" }
            case 27 { return "OP_BITOR" }
            case 28 { return "OP_BITXOR" }
            case 29 { return "OP_BITNOT" }
            case 30 { return "OP_SHL" }
            case 31 { return "OP_SHR" }
            case 32 { return "OP_USHR" }
            case 33 { return "OP_NEG" }
            case 34 { return "OP_NOT" }
            case 35 { return "OP_CAST_FLOAT" }
            case 36 { return "OP_CAST_INT" }
            case 37 { return "OP_CAST_STRING" }
            case 38 { return "OP_SET_PTR_ELEM_TYPE" }
            case 39 { return "OP_SET_DECLARED_FACE" }
            case 40 { return "OP_INC" }
            case 41 { return "OP_DEC" }
            case 42 { return "OP_INC_LOCAL" }
            case 43 { return "OP_DEC_LOCAL" }
            case 44 { return "OP_PRE_INC_LOCAL" }
            case 45 { return "OP_PRE_DEC_LOCAL" }
            case 46 { return "OP_EQ" }
            case 47 { return "OP_NEQ" }
            case 48 { return "OP_IS_NULL" }
            case 49 { return "OP_LT" }
            case 50 { return "OP_GT" }
            case 51 { return "OP_LE" }
            case 52 { return "OP_GE" }
            case 53 { return "OP_IN" }
            case 54 { return "OP_RANGE" }
            case 55 { return "OP_JUMP" }
            case 56 { return "OP_JUMP_IF_FALSE" }
            case 57 { return "OP_JUMP_IF_TRUE" }
            case 58 { return "OP_LOOP" }
            case 59 { return "OP_CALL" }
            case 60 { return "OP_TAIL_CALL" }
            case 61 { return "OP_CLOSURE" }
            case 62 { return "OP_RETURN" }
            case 63 { return "OP_RETURN_MULTI" }
            case 64 { return "OP_ARRAY" }
            case 65 { return "OP_ARRAY_GET" }
            case 66 { return "OP_ARRAY_SET" }
            case 67 { return "OP_ARRAY_APPEND" }
            case 68 { return "OP_ARRAY_APPEND_NOPUSH" }
            case 69 { return "OP_DICT" }
            case 70 { return "OP_DICT_GET" }
            case 71 { return "OP_DICT_SET" }
            case 72 { return "OP_DICT_GET_KEY" }
            case 73 { return "OP_LOAD_NATIVE_MODULE" }
            case 74 { return "OP_MODULE_CALL" }
            case 75 { return "OP_GET_MODULE_CONST" }
            case 76 { return "OP_STRING_ADD" }
            case 77 { return "OP_INDEX" }
            case 78 { return "OP_INDEX_SET" }
            case 79 { return "OP_SLICE" }
            case 80 { return "OP_LENGTH" }
            case 81 { return "OP_ITER_GET" }
            case 82 { return "OP_ITER_GET_VALUE" }
            case 83 { return "OP_TRY" }
            case 84 { return "OP_CATCH" }
            case 85 { return "OP_FINALLY" }
            case 86 { return "OP_END_TRY" }
            case 87 { return "OP_THROW" }
            case 88 { return "OP_GET_MODULE_VAR" }
            case 89 { return "OP_SET_MODULE_VAR" }
            case 90 { return "OP_GET_MODULE_FUNC" }
            case 91 { return "OP_DEFINE_MODULE_FUNC" }
            case 92 { return "OP_GET_PROPERTY" }
            case 93 { return "OP_TYPE_CHECK" }
            case 94 { return "OP_AS_CAST" }
            case 95 { return "OP_FOR_PREP" }
            case 96 { return "OP_FOR_LOOP" }
            case 97 { return "OP_ADD_INT" }
            case 98 { return "OP_SUB_INT" }
            case 99 { return "OP_MUL_INT" }
            case 100 { return "OP_DIV_INT" }
            case 101 { return "OP_MOD_INT" }
            case 102 { return "OP_ADD_FLOAT" }
            case 103 { return "OP_SUB_FLOAT" }
            case 104 { return "OP_MUL_FLOAT" }
            case 105 { return "OP_DIV_FLOAT" }
            case 106 { return "OP_NEG_INT" }
            case 107 { return "OP_NEG_FLOAT" }
            case 108 { return "OP_EQ_INT" }
            case 109 { return "OP_LT_INT" }
            case 110 { return "OP_GT_INT" }
            case 111 { return "OP_LE_INT" }
            case 112 { return "OP_GE_INT" }
            case 113 { return "OP_EQ_FLOAT" }
            case 114 { return "OP_LT_FLOAT" }
            case 115 { return "OP_GT_FLOAT" }
            case 116 { return "OP_LE_FLOAT" }
            case 117 { return "OP_GE_FLOAT" }
            case 118 { return "OP_ADD_INT_IMM" }
            case 119 { return "OP_SUB_INT_IMM" }
            case 120 { return "OP_MUL_INT_IMM" }
            case 121 { return "OP_LT_INT_IMM" }
            case 122 { return "OP_GT_INT_IMM" }
            case 123 { return "OP_LE_INT_IMM" }
            case 124 { return "OP_GE_INT_IMM" }
            case 125 { return "OP_EQ_INT_IMM" }
            case 126 { return "OP_SHL_IMM" }
            case 127 { return "OP_SHR_IMM" }
            case 128 { return "OP_USHR_IMM" }
            case 129 { return "OP_STRUCT_DEF" }
            case 130 { return "OP_STRUCT_INIT" }
            case 131 { return "OP_GET_FIELD" }
            case 132 { return "OP_SET_FIELD" }
            case 133 { return "OP_GET_FIELD_ADDR" }
            case 134 { return "OP_GET_METHOD" }
            case 135 { return "OP_ENUM_DEF" }
            case 136 { return "OP_FACE_DEF" }
            case 137 { return "OP_CSTRUCT_DEF" }
            case 138 { return "OP_GET_CSTRUCT_DEF" }
            case 139 { return "OP_AWAIT" }
            case 140 { return "OP_ASYNC_CALL" }
            case 141 { return "OP_INIT_LENOMODULE" }
            case 142 { return "OP_CLIB_CALL" }
            case 143 { return "OP_CFUNC_CALLBACK" }
            case 144 { return "OP_CALL_NATIVE" }
            case 145 { return "OP_TAIL_CALL_NATIVE" }
            case 146 { return "OP_U8_TO_F64" }
            case 147 { return "OP_PUSH_TYPE_ARGS" }
            case 148 { return "OP_DTOR_LOCAL" }
            case 149 { return "OP_CALL_GLOBAL_FUNC" }
            case 150 { return "OP_INC_LOCAL_NOPUSH" }
            case 151 { return "OP_DEC_LOCAL_NOPUSH" }
            case 152 { return "OP_MOVE_LOCAL_POP" }
            case 153 { return "OP_INDEX_SET_NOPUSH" }
            case 154 { return "OP_CLEAR_LOCAL_RANGE" }
            case 155 { return "OP_SWITCH_LOOKUP" }
            case 156 { return "OP_INVOKE_METHOD" }
            default { return "OP_0x" + toHex2(code) }
        }
    }

    func opImmSize(int op): int {
        // 先处理范围判断和组合条件
        if op >= 8 and op <= 20 { return 2 }
        if op >= 118 and op <= 128 { return 1 }
        switch op {
            case 0 { return 2 }
            case 11, 152 { return 4 }
            case 55, 56, 57, 58 { return 4 }
            case 59, 60 { return 2 }
            case 61 { return 2 }
            case 64 { return 2 }
            case 67, 68 { return 2 }
            case 73, 74, 75 { return 2 }
            case 88, 89, 90, 91 { return 2 }
            case 131, 132, 134, 153 { return 1 }
            case 144, 145, 149, 156 { return 4 }
            case 133, 148, 150, 151 { return 2 }
            case 154 { return 4 }
            case 129 { return 0 }
            case 135 { return 0 }
            case 137, 138 { return 0 }
            case 130 { return 2 }
            case 147 { return 1 }
            default { return 0 }
        }
    }

    // ==================== 常量跳过函数 (skipConstRaw) ====================
    //
    // 所有 skip 函数推进 gLenbPos 到常量数据之后。
    // 标签字节已由 skipConstRaw 读取。
    //
    // LENB 序列化格式 (大端):
    //   string = u32 len + XOR(bytes)
    //   u32/u16 = big-endian

    func skipConstRaw() {
        if gLenbPos >= gLenbEnd { return }
        int tag = fileData.byte(gLenbPos) & 0xFF
        gLenbPos = gLenbPos + 1

        // NULL/TRUE/FALSE: 无数据 (范围判断, switch 不支持 <=)
        if tag <= 0x02 { return }

        switch tag {
            // INT: u64 BE (8 字节, v2.2.0+)
            case 0x03 { gLenbPos = gLenbPos + 8; return }

            // FLOAT: double BE (8 字节)
            case 0x04 { gLenbPos = gLenbPos + 8; return }

            // STRING: u32 len + XOR bytes
            case 0x05 {
                skipXorStr()
                return
            }

            // FUNCTION: name + arity + upvals + locals + has_try + params + type_params + chunk
            case 0x06 {
                skipFuncRaw()
                return
            }

            // BIGINT: u32 limb_count + u8 is_negative + 4*limbs 字节
            case 0x07 {
                int limbs = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
                gLenbPos = gLenbPos + 1  // is_negative
                if limbs < 0 or limbs > 100000 { gLenbPos = gLenbEnd; return }
                gLenbPos = gLenbPos + 4 * limbs
                return
            }

            // RANGE: u64 start + u64 end + u8 inclusive = 17 字节
            case 0x08 {
                gLenbPos = gLenbPos + 17
                return
            }

            // ARRAY: u32 count + count * constant
            case 0x09 {
                int n = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
                if n < 0 or n > 100000 { gLenbPos = gLenbEnd; return }
                for 0:n-1 to i { skipConstRaw() }
                return
            }

            // DICT: u32 count + 2*count * constant
            case 0x0A {
                int n = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
                if n < 0 or n > 100000 { gLenbPos = gLenbEnd; return }
                int total = 2 * n
                for 0:total-1 to i { skipConstRaw() }
                return
            }

            // ENUM_DEF: name + u32 member_count + members*(string + u64)
            case 0x0B {
                skipXorStr()
                int mc = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
                if mc < 0 or mc > 100000 { gLenbPos = gLenbEnd; return }
                for 0:mc-1 to i {
                    skipXorStr()
                    gLenbPos = gLenbPos + 8  // member value u64
                }
                return
            }

            // STRUCT_DEF: name + fields + methods + impls + consts
            case 0x0C {
                skipXorStr()
                int fc = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
                if fc < 0 or fc > 100000 { gLenbPos = gLenbEnd; return }
                for 0:fc-1 to i {
                    skipXorStr()       // field name
                    gLenbPos = gLenbPos + 1  // type
                    int hasSTN = fileData.byte(gLenbPos) & 0xFF; gLenbPos = gLenbPos + 1
                    if hasSTN != 0 { skipXorStr() }  // struct_type_name
                    int hasDef = fileData.byte(gLenbPos) & 0xFF; gLenbPos = gLenbPos + 1
                    if hasDef != 0 { skipConstRaw() }  // default value
                    gLenbPos = gLenbPos + 2  // element_type + nullable
                }
                int mc = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
                if mc < 0 or mc > 100000 { gLenbPos = gLenbEnd; return }
                for 0:mc-1 to i {
                    skipXorStr()       // method name
                    skipConstRaw()     // method function (or null)
                }
                int ic = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
                if ic < 0 or ic > 100000 { gLenbPos = gLenbEnd; return }
                for 0:ic-1 to i { skipXorStr() }  // impl names
                int cc = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
                if cc < 0 or cc > 100000 { gLenbPos = gLenbEnd; return }
                for 0:cc-1 to i {
                    skipXorStr()       // const name
                    skipConstRaw()     // const value
                }
                return
            }

            // CSTRUCT_DEF: name + u32 field_count + u32 size + u32 align + u8 packed + u8 explicit + fields
            case 0x0D {
                skipXorStr()
                int fc = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
                gLenbPos = gLenbPos + 4  // total_size
                gLenbPos = gLenbPos + 4  // alignment
                gLenbPos = gLenbPos + 1  // is_packed
                gLenbPos = gLenbPos + 1  // explicit_align
                if fc < 0 or fc > 100000 { gLenbPos = gLenbEnd; return }
                for 0:fc-1 to i {
                    skipXorStr()       // field name
                    gLenbPos = gLenbPos + 1  // type
                    gLenbPos = gLenbPos + 4  // offset
                    gLenbPos = gLenbPos + 4  // size
                    gLenbPos = gLenbPos + 4  // array_dim
                    int hasSN = fileData.byte(gLenbPos) & 0xFF; gLenbPos = gLenbPos + 1
                    if hasSN != 0 { skipXorStr() }  // struct_name
                    gLenbPos = gLenbPos + 1  // element_type
                }
                return
            }

            // FACE_DEF: name + u32 method_count + methods*(string + u32 params + u8 ret + params*u8)
            case 0x0E {
                skipXorStr()
                int mc = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
                if mc < 0 or mc > 100000 { gLenbPos = gLenbEnd; return }
                for 0:mc-1 to i {
                    skipXorStr()       // method name
                    int pc = rbe32(gLenbPos); gLenbPos = gLenbPos + 4  // param_count
                    gLenbPos = gLenbPos + 1  // return type
                    if pc < 0 or pc > 100000 { gLenbPos = gLenbEnd; return }
                    gLenbPos = gLenbPos + pc  // param types (1 byte each)
                }
                return
            }

            // MODULE: name + has_path + path + globals + exports + native_imports
            //         + init_chunk + export_mapping + use_reexport
            case 0x0F {
                skipXorStr()       // module name
                int hasPath = fileData.byte(gLenbPos) & 0xFF; gLenbPos = gLenbPos + 1
                if hasPath != 0 { skipXorStr() }  // source path
                int gc = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
                if gc < 0 or gc > 100000 { gLenbPos = gLenbEnd; return }
                for 0:gc-1 to i { skipConstRaw() }  // globals
                int ec = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
                if ec < 0 or ec > 100000 { gLenbPos = gLenbEnd; return }
                int totalE = 2 * ec
                for 0:totalE-1 to i { skipConstRaw() }  // exports (key+value)
                int nic = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
                if nic < 0 or nic > 100000 { gLenbPos = gLenbEnd; return }
                for 0:nic-1 to i { skipXorStr() }  // native imports
                int hasInit = fileData.byte(gLenbPos) & 0xFF; gLenbPos = gLenbPos + 1
                if hasInit != 0 { skipChunkRaw() }
                // export_mapping (v2.2.0+)
                int emc = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
                if emc < 0 or emc > 100000 { gLenbPos = gLenbEnd; return }
                for 0:emc-1 to i {
                    skipXorStr()       // mapping name
                    gLenbPos = gLenbPos + 4  // global_index
                }
                // use_reexport (v2.2.0+)
                int urc = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
                if urc < 0 or urc > 100000 { gLenbPos = gLenbEnd; return }
                for 0:urc-1 to i {
                    skipXorStr()       // reexport name
                    gLenbPos = gLenbPos + 4  // kind (i32)
                }
                return
            }

            // FFI_PTR: u64 ptr + u64 size + u8 owned + u8 freed + u8 element_type = 19 字节
            case 0x10 {
                gLenbPos = gLenbPos + 19
                return
            }

            // CLOSURE: nested function constant + u32 upvalue_count + u32 type_param_count + strings
            case 0x11 {
                skipConstRaw()     // function constant (recursive)
                gLenbPos = gLenbPos + 4  // upvalue_count
                int tpc = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
                if tpc < 0 or tpc > 100000 { gLenbPos = gLenbEnd; return }
                for 0:tpc-1 to i { skipXorStr() }
                return
            }

            // FFI_LIB: u8 has_path + if has: string
            case 0x12 {
                int has = fileData.byte(gLenbPos) & 0xFF; gLenbPos = gLenbPos + 1
                if has != 0 { skipXorStr() }
                return
            }

            // MODULE_REF: name + u8 has_path + if has: string
            case 0x13 {
                skipXorStr()
                int has = fileData.byte(gLenbPos) & 0xFF; gLenbPos = gLenbPos + 1
                if has != 0 { skipXorStr() }
                return
            }

            // 未知标签: 尝试跳过 1 字节 (best effort)
            default {
                gLenbPos = gLenbPos + 1
            }
        }
    }

    // 跳过函数数据 (tag 已由调用方读取)
    // name + arity + upvals + locals + has_try + params + type_params + chunk
    func skipFuncRaw() {
        skipXorStr()       // function name
        gLenbPos = gLenbPos + 4  // arity
        gLenbPos = gLenbPos + 4  // upvalue_count
        gLenbPos = gLenbPos + 4  // local_count
        gLenbPos = gLenbPos + 1  // has_try
        int pcnt = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
        if pcnt < 0 or pcnt > 100000 { gLenbPos = gLenbEnd; return }
        gLenbPos = gLenbPos + pcnt  // param types (1 byte each)
        int tpcnt = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
        if tpcnt < 0 or tpcnt > 100000 { gLenbPos = gLenbEnd; return }
        for 0:tpcnt-1 to i { skipXorStr() }
        skipChunkRaw()
    }

    // 跳过 chunk 数据
    // filename + local_count + const_count + constants + code + lines
    func skipChunkRaw() {
        skipXorStr()       // filename
        gLenbPos = gLenbPos + 4  // local_count
        int ccnt = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
        if ccnt < 0 or ccnt > 100000 { gLenbPos = gLenbEnd; return }
        for 0:ccnt-1 to i { skipConstRaw() }
        int codeLen = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
        if codeLen < 0 or codeLen > 1000000 { gLenbPos = gLenbEnd; return }
        gLenbPos = gLenbPos + codeLen
        if gLenbPos >= gLenbEnd { return }
        int hasLines = fileData.byte(gLenbPos) & 0xFF; gLenbPos = gLenbPos + 1
        if hasLines == 1 and codeLen > 0 {
            gLenbPos = gLenbPos + 2 * codeLen
        }
    }

    // ==================== 常量文本解析 (parseConstText) ====================
    //
    // 读取常量并返回可读字符串，同时推进 gLenbPos 到常量之后。
    // 必须跳过完整常量数据 (包括 FUNCTION 的嵌套 chunk)。

    func parseConstText(int depth): string {
        if depth > 20 {
            skipConstRaw()
            return "<deep>"
        }
        if gLenbPos >= gLenbEnd { return "<eof>" }
        int tag = fileData.byte(gLenbPos) & 0xFF
        gLenbPos = gLenbPos + 1

        switch tag {
            case 0x00 { return "null" }
            case 0x01 { return "true" }
            case 0x02 { return "false" }

            // INT: u64 BE
            case 0x03 {
                int hi = rbe32(gLenbPos)
                int lo = rbe32(gLenbPos + 4)
                gLenbPos = gLenbPos + 8
                if hi == 0 and (lo >> 31) == 0 { return _str(lo) }
                return "int:" + toHex8(hi) + toHex8(lo)
            }

            // FLOAT: double BE
            case 0x04 {
                string hex = rbe_i64_hex(gLenbPos); gLenbPos = gLenbPos + 8
                return "float:" + hex
            }

            // STRING: u32 len + XOR bytes
            case 0x05 {
                int n = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
                string s = readXorStr(n)
                return "'" + s + "'"
            }

            // FUNCTION: name + header + chunk (必须跳过 chunk!)
            case 0x06 {
                int nameLen = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
                string fnName = readXorStr(nameLen)
                if gLenbPos + 13 > gLenbEnd { return "FUNC?<trunc>" }
                int arity = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
                int upvals = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
                int locals = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
                int hasTry = fileData.byte(gLenbPos) & 0xFF; gLenbPos = gLenbPos + 1
                int pcnt = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
                if pcnt < 0 or pcnt > 10000 { gLenbPos = gLenbEnd; return "FUNC?<bad>" }
                gLenbPos = gLenbPos + pcnt
                int tpcnt = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
                if tpcnt < 0 or tpcnt > 10000 { gLenbPos = gLenbEnd; return "FUNC?<bad>" }
                for 0:tpcnt-1 to i { skipXorStr() }
                // 关键修复: 跳过嵌套 chunk
                skipChunkRaw()
                return "FUNC(" + fnName + ",arity=" + _str(arity) + ",upvals=" + _str(upvals) + ",locals=" + _str(locals) + ")"
            }

            // BIGINT: u32 limbs + u8 is_neg + 4*limbs
            case 0x07 {
                int n = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
                gLenbPos = gLenbPos + 1
                if n < 0 or n > 100000 { gLenbPos = gLenbEnd; return "BIGINT?<bad>" }
                gLenbPos = gLenbPos + 4 * n
                return "BIGINT(limbs=" + _str(n) + ")"
            }

            // RANGE: u64 start + u64 end + u8 inclusive
            case 0x08 {
                gLenbPos = gLenbPos + 17
                return "RANGE"
            }

            // ARRAY: u32 count + count * constant
            case 0x09 {
                int n = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
                if n < 0 or n > 10000 { gLenbPos = gLenbEnd; return "[?<bad>]" }
                string r = "["
                for 0:n-1 to i {
                    if i > 0 { r = r + "," }
                    r = r + parseConstText(depth + 1)
                }
                return r + "]"
            }

            // DICT: u32 count + 2*count * constant
            case 0x0A {
                int n = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
                if n < 0 or n > 10000 { gLenbPos = gLenbEnd; return "{?<bad>}" }
                string r = "{"
                for 0:n-1 to i {
                    if i > 0 { r = r + "," }
                    r = r + parseConstText(depth + 1) + ":" + parseConstText(depth + 1)
                }
                return r + "}"
            }

            // ENUM_DEF: name + members
            case 0x0B {
                int nameLen = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
                string name = readXorStr(nameLen)
                int mc = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
                if mc < 0 or mc > 100000 { gLenbPos = gLenbEnd; return "ENUM?<bad>" }
                for 0:mc-1 to i {
                    skipXorStr()
                    gLenbPos = gLenbPos + 8
                }
                return "ENUM(" + name + ")"
            }

            // STRUCT_DEF: name + fields + methods + impls + consts
            case 0x0C {
                int nameLen = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
                string name = readXorStr(nameLen)
                int fc = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
                if fc < 0 or fc > 100000 { gLenbPos = gLenbEnd; return "STRUCT?<bad>" }
                for 0:fc-1 to i {
                    skipXorStr()
                    gLenbPos = gLenbPos + 1  // type
                    int hasSTN = fileData.byte(gLenbPos) & 0xFF; gLenbPos = gLenbPos + 1
                    if hasSTN != 0 { skipXorStr() }
                    int hasDef = fileData.byte(gLenbPos) & 0xFF; gLenbPos = gLenbPos + 1
                    if hasDef != 0 { skipConstRaw() }
                    gLenbPos = gLenbPos + 2
                }
                int mc = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
                if mc < 0 or mc > 100000 { gLenbPos = gLenbEnd; return "STRUCT?<bad>" }
                for 0:mc-1 to i {
                    skipXorStr()
                    skipConstRaw()
                }
                int ic = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
                if ic < 0 or ic > 100000 { gLenbPos = gLenbEnd; return "STRUCT?<bad>" }
                for 0:ic-1 to i { skipXorStr() }
                int cc = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
                if cc < 0 or cc > 100000 { gLenbPos = gLenbEnd; return "STRUCT?<bad>" }
                for 0:cc-1 to i {
                    skipXorStr()
                    skipConstRaw()
                }
                return "STRUCT(" + name + ")"
            }

            // CSTRUCT_DEF
            case 0x0D {
                int nameLen = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
                string name = readXorStr(nameLen)
                int fc = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
                gLenbPos = gLenbPos + 4 + 4 + 1 + 1  // size + align + packed + explicit
                if fc < 0 or fc > 100000 { gLenbPos = gLenbEnd; return "CSTRUCT?<bad>" }
                for 0:fc-1 to i {
                    skipXorStr()
                    gLenbPos = gLenbPos + 1 + 4 + 4 + 4  // type + offset + size + array_dim
                    int hasSN = fileData.byte(gLenbPos) & 0xFF; gLenbPos = gLenbPos + 1
                    if hasSN != 0 { skipXorStr() }
                    gLenbPos = gLenbPos + 1  // element_type
                }
                return "CSTRUCT(" + name + ")"
            }

            // FACE_DEF
            case 0x0E {
                int nameLen = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
                string name = readXorStr(nameLen)
                int mc = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
                if mc < 0 or mc > 100000 { gLenbPos = gLenbEnd; return "FACE?<bad>" }
                for 0:mc-1 to i {
                    skipXorStr()
                    int pc = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
                    gLenbPos = gLenbPos + 1  // return type
                    if pc < 0 or pc > 100000 { gLenbPos = gLenbEnd; return "FACE?<bad>" }
                    gLenbPos = gLenbPos + pc
                }
                return "FACE(" + name + ")"
            }

            // MODULE
            case 0x0F {
                int nameLen = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
                string name = readXorStr(nameLen)
                int hasPath = fileData.byte(gLenbPos) & 0xFF; gLenbPos = gLenbPos + 1
                if hasPath != 0 { skipXorStr() }
                int gc = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
                if gc < 0 or gc > 100000 { gLenbPos = gLenbEnd; return "MODULE?<bad>" }
                for 0:gc-1 to i { skipConstRaw() }
                int ec = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
                if ec < 0 or ec > 100000 { gLenbPos = gLenbEnd; return "MODULE?<bad>" }
                int totalE = 2 * ec
                for 0:totalE-1 to i { skipConstRaw() }
                int nic = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
                if nic < 0 or nic > 100000 { gLenbPos = gLenbEnd; return "MODULE?<bad>" }
                for 0:nic-1 to i { skipXorStr() }
                int hasInit = fileData.byte(gLenbPos) & 0xFF; gLenbPos = gLenbPos + 1
                if hasInit != 0 { skipChunkRaw() }
                // export_mapping (v2.2.0+)
                int emc = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
                if emc < 0 or emc > 100000 { gLenbPos = gLenbEnd; return "MODULE?<bad>" }
                for 0:emc-1 to i {
                    skipXorStr()
                    gLenbPos = gLenbPos + 4
                }
                // use_reexport (v2.2.0+)
                int urc = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
                if urc < 0 or urc > 100000 { gLenbPos = gLenbEnd; return "MODULE?<bad>" }
                for 0:urc-1 to i {
                    skipXorStr()
                    gLenbPos = gLenbPos + 4
                }
                return "MODULE(" + name + ")"
            }

            // FFI_PTR: u64 + u64 + u8 + u8 + u8 = 19 bytes
            case 0x10 {
                gLenbPos = gLenbPos + 19
                return "FFI_PTR"
            }

            // CLOSURE: function constant + u32 + u32 + strings
            case 0x11 {
                string fnDesc = parseConstText(depth + 1)
                gLenbPos = gLenbPos + 4  // upvalue_count
                int tpc = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
                if tpc < 0 or tpc > 100000 { gLenbPos = gLenbEnd; return "CLOSURE?<bad>" }
                for 0:tpc-1 to i { skipXorStr() }
                return "CLOSURE(" + fnDesc + ")"
            }

            // FFI_LIB: u8 has_path + if has: string
            case 0x12 {
                int has = fileData.byte(gLenbPos) & 0xFF; gLenbPos = gLenbPos + 1
                if has != 0 {
                    int n = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
                    string p = readXorStr(n)
                    return "FFI_LIB(" + p + ")"
                }
                return "FFI_LIB(null)"
            }

            // MODULE_REF: name + u8 has_path + if has: string
            case 0x13 {
                int nameLen = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
                string name = readXorStr(nameLen)
                int has = fileData.byte(gLenbPos) & 0xFF; gLenbPos = gLenbPos + 1
                if has != 0 { skipXorStr() }
                return "MODULE_REF(" + name + ")"
            }

            // 未知标签
            default {
                gLenbPos = gLenbPos + 1
                return "<" + constTagName(tag) + ">"
            }
        }
    }

    // ==================== 指令解码 ====================

    func decodeOneInstruction(int codeStart, int codeLen, Array[int] lines, int idx): string {
        int pc = codeStart + idx
        if pc + 1 > gLenbEnd { return "<eof>" }
        int op = fileData.byte(pc) & 0xFF
        int immSz = opImmSize(op)
        string name = opName(op)
        string operands = ""
        int lineNo = -1
        if idx < lines.len() { lineNo = lines[idx] }

        // 范围判断先处理（switch 不支持范围）
        if op >= 118 and op <= 128 {
            if pc + 2 <= gLenbEnd {
                int imm = fileData.byte(pc + 1) & 0xFF
                if imm >= 128 { imm = imm - 256 }
                operands = "imm=" + _str(imm)
            }
        } else {
            switch op {
                case 0 {
                    if pc + 3 <= gLenbEnd { operands = "const[" + _str(rbe16(pc + 1)) + "]" }
                }
                case 8, 9, 12, 13 {
                    if pc + 3 <= gLenbEnd { operands = "slot=" + _str(rbe16(pc + 1)) }
                }
                case 11 {
                    if pc + 5 <= gLenbEnd {
                        operands = "src=" + _str(rbe16(pc + 1)) + " dst=" + _str(rbe16(pc + 3))
                    }
                }
                case 59 {
                    if pc + 3 <= gLenbEnd { operands = "argc=" + _str(rbe16(pc + 1)) }
                }
                case 55, 56, 57, 58 {
                    if pc + 5 <= gLenbEnd {
                        int target = rbe32(pc + 1)
                        int absT = pc + 1 + 4 + target
                        operands = "-> 0x" + toHex8(absT)
                    }
                }
                case 144, 145, 149, 156 {
                    if pc + 5 <= gLenbEnd {
                        operands = "name=" + _str(rbe16(pc + 1)) + " argc=" + _str(rbe16(pc + 3))
                    }
                }
                case 61, 73 {
                    if pc + 3 <= gLenbEnd { operands = "const[" + _str(rbe16(pc + 1)) + "]" }
                }
                case 64 {
                    if pc + 3 <= gLenbEnd { operands = "cap=" + _str(rbe16(pc + 1)) }
                }
                case 131, 132 {
                    if pc + 2 <= gLenbEnd { operands = "field=" + _str(fileData.byte(pc + 1) & 0xFF) }
                }
                case 148, 150, 151, 133 {
                    if pc + 3 <= gLenbEnd { operands = "slot=" + _str(rbe16(pc + 1)) }
                }
                default {
                    if immSz > 0 { operands = "<" + _str(immSz) + "B>" }
                }
            }
        }

        string lineField = "?"
        switch lineNo {
            case 0 { lineField = "0" }
            default { if lineNo > 0 { lineField = _str(lineNo) } }
        }
        string addrField = toHex8(pc)
        return addrField + "  L" + lineField + "  " + name + "  " + operands
    }

    // ==================== Chunk 主体解析 ====================

    func addLine(string s) {
        if gLineCount < 10000 {
            gLines.add(s)
            gLineCount = gLineCount + 1
        }
    }

    // 将一行反汇编文本拆分成 Table 行（地址/行号/指令/操作数/原始字节）
    // 指令行格式: "0xADDR  L42  OP_NAME  operands"
    // 注释行格式: "; ..."，整行放到指令列
    func addDisasmRow(string s) {
        if gLineCount < 10000 {
            gLineCount = gLineCount + 1
            // 注释行
            if s.len() > 0 and s[0] == ";" {
                disasmRows.add(["", "", s, "", ""])
                return
            }
            // 指令行: 尝试拆分
            string addr = ""
            string lineNo = ""
            string opName = s
            string operands = ""
            string rawBytes = ""

            // 拆分: 地址  L行号  指令  操作数
            // 注意: decodeOneInstruction 返回的地址是纯 hex（不含 0x 前缀）
            int space1 = s.find("  ")
            if space1 > 0 {
                addr = "0x" + s.slice(0, space1)
                int restStart = space1
                while restStart < s.len() and s[restStart] == " " { restStart = restStart + 1 }
                if restStart < s.len() and s[restStart] == "L" {
                    int space2 = s.find("  ", restStart)
                    if space2 > restStart {
                        lineNo = s.slice(restStart, space2)
                        int rest2 = space2
                        while rest2 < s.len() and s[rest2] == " " { rest2 = rest2 + 1 }
                        if rest2 < s.len() {
                            int space3 = s.find("  ", rest2)
                            if space3 > rest2 {
                                opName = s.slice(rest2, space3)
                                int rest3 = space3
                                while rest3 < s.len() and s[rest3] == " " { rest3 = rest3 + 1 }
                                if rest3 < s.len() {
                                    operands = s.slice(rest3, s.len())
                                }
                            } else {
                                opName = s.slice(rest2, s.len())
                            }
                        }
                    }
                }
            }
            disasmRows.add([addr, lineNo, opName, operands, rawBytes])
        }
    }

    func parseOneChunkBody(int depth) {
        if depth > 4 { addDisasmRow("  ; <深度超限,停止展开>"); return }
        if gLenbPos + 4 > gLenbEnd { return }

        // filename string
        int fnLen = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
        if fnLen < 0 or fnLen > 1000 { return }
        string fnName = readXorStr(fnLen)

        if gLenbPos + 8 > gLenbEnd { return }
        int localCount = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
        int constCnt = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
        if constCnt < 0 or constCnt > 100000 { return }

        addDisasmRow("; ===== " + fnName + " (locals=" + _str(localCount) + ", consts=" + _str(constCnt) + ") =====")

        // 解析常量 (parseConstText 现在会跳过完整常量，包括 FUNCTION 的 chunk)
        Array[int] constStarts = []
        Array[string] constTexts = []
        for 0:constCnt-1 to ci {
            constStarts.add(gLenbPos)
            string ct = parseConstText(depth + 1)
            constTexts.add(ct)
        }

        // 显示常量，对 FUNCTION 常量递归展开嵌套 chunk
        for 0:constCnt-1 to ci {
            int cst = constStarts[ci]
            int tag = fileData.byte(cst) & 0xFF
            addDisasmRow("; const[" + _str(ci) + "] = " + constTexts[ci])
            if tag == 0x06 and depth < 4 {
                // 从保存的起始位置重新计算 chunk 偏移
                int subPos = cst + 1  // skip tag
                int nameLen = rbe32(subPos); subPos = subPos + 4 + nameLen
                subPos = subPos + 13  // arity(4) + upvals(4) + locals(4) + has_try(1)
                int p2 = rbe32(subPos); subPos = subPos + 4 + p2  // param_count + params
                int tp2 = rbe32(subPos); subPos = subPos + 4
                for 0:tp2-1 to k {
                    int n2 = rbe32(subPos); subPos = subPos + 4 + n2
                }
                int savedPos = gLenbPos
                gLenbPos = subPos
                parseOneChunkBody(depth + 1)
                gLenbPos = savedPos
            }
        }

        // 读取字节码
        if gLenbPos + 4 > gLenbEnd { return }
        int codeLen = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
        if codeLen < 0 or codeLen > 1000000 { return }
        int codeStart = gLenbPos
        gLenbPos = gLenbPos + codeLen

        // 读取行号
        int hasLines = -1
        Array[int] lines = []
        if gLenbPos + 1 <= gLenbEnd {
            hasLines = fileData.byte(gLenbPos) & 0xFF
            gLenbPos = gLenbPos + 1
            if hasLines == 1 and codeLen > 0 {
                for 0:codeLen-1 to li {
                    if gLenbPos + 2 <= gLenbEnd {
                        lines.add(rbe16(gLenbPos)); gLenbPos = gLenbPos + 2
                    }
                }
            }
        }
        for 0:codeLen-1 to ii {
            if hasLines != 1 { lines.add(-1) }
        }

        addDisasmRow("; --- bytecode (" + _str(codeLen) + "B) ---")
        int pc = 0
        while pc < codeLen {
            if codeStart + pc >= gLenbEnd { break }
            int opc = fileData.byte(codeStart + pc) & 0xFF
            int imm = opImmSize(opc)
            string line = decodeOneInstruction(codeStart, codeLen, lines, pc)
            addDisasmRow(line)
            // 为指令行补充原始字节列（第5列）
            int rowIdx = disasmRows.len() - 1
            if rowIdx >= 0 and disasmRows[rowIdx][0].len() > 0 {
                string hexStr = ""
                int byteCnt = 1 + imm
                if byteCnt > 16 { byteCnt = 16 }
                for 0:byteCnt-1 to bi {
                    if codeStart + pc + bi < gLenbEnd {
                        hexStr = hexStr + toHex2(fileData.byte(codeStart + pc + bi)) + " "
                    }
                }
                disasmRows[rowIdx][4] = hexStr
            }
            pc = pc + 1 + imm
        }
    }

    // ==================== 符号表跳过 ====================

    func skipHeaderAndSymbols(int startPos): int {
        int pos = startPos
        if pos + 12 > gLenbEnd { return pos }
        int gvars = rbe32(pos); pos = pos + 4
        int gfuncs = rbe32(pos); pos = pos + 4
        int symCount = rbe32(pos); pos = pos + 4
        if symCount < 0 or symCount > 100000 { return pos }

        for 0:symCount-1 to si {
            if pos + 13 > gLenbEnd { break }
            int kind = fileData.byte(pos) & 0xFF; pos = pos + 1

            // name: string (u32 len + XOR bytes)
            int nameLen = rbe32(pos); pos = pos + 4
            if nameLen < 0 or nameLen > 100000 or pos + nameLen + 8 > gLenbEnd { break }
            pos = pos + nameLen

            pos = pos + 4  // index (i32)
            pos = pos + 1  // is_captured
            pos = pos + 1  // type_kind
            int hasDk = fileData.byte(pos) & 0xFF; pos = pos + 1

            if hasDk != 0 {
                if pos + 4 > gLenbEnd { break }
                int dkCount = rbe32(pos); pos = pos + 4
                if dkCount < 0 or dkCount > 100000 { break }
                for 0:dkCount-1 to di {
                    if pos + 4 > gLenbEnd { break }
                    int dkLen = rbe32(pos); pos = pos + 4
                    if dkLen < 0 or pos + dkLen > gLenbEnd { break }
                    pos = pos + dkLen
                }
            }

            // SYM_CLIB (kind=10) / SYM_CFUNC (kind=11)
            switch kind {
                case 10 {
                    if pos + 4 > gLenbEnd { break }
                    int cfc = rbe32(pos); pos = pos + 4
                    if cfc < 0 or cfc > 100000 { break }
                    for 0:cfc-1 to ci {
                        if pos + 4 > gLenbEnd { break }
                        int fnLen = rbe32(pos); pos = pos + 4
                        if fnLen < 0 or pos + fnLen > gLenbEnd { break }
                        pos = pos + fnLen
                        pos = pos + 1  // return type
                        if pos + 4 > gLenbEnd { break }
                        int pc2 = rbe32(pos); pos = pos + 4
                        if pc2 < 0 or pc2 > 100000 { break }
                        pos = pos + pc2  // param types (1 byte each)
                    }
                }
                case 11 {
                    if pos + 4 > gLenbEnd { break }
                    int pc3 = rbe32(pos); pos = pos + 4
                    pos = pos + 1  // return type
                    if pc3 < 0 or pc3 > 100000 { break }
                    pos = pos + pc3  // param types (1 byte each)
                }
            }
        }
        return pos
    }

    // ==================== 反汇编顶层驱动 ====================

    func analyzeDisasm() {
        disasmRows = []
        gLines = []
        gLineCount = 0
        disasmSearchPos = 0
        disasmSearchKey = ""

        if fileSize < 8 {
            disasmRows.add(["", "", "文件太小,无法包含 LENB 尾部", "", ""])
            disasmTable.set_rows(disasmRows)
            return
        }
        int tailMagic = readU32(fileData, fileSize - 4)
        if tailMagic != LENB_MAGIC {
            disasmRows.add(["", "", "未检测到 LENB 尾部数据", "", ""])
            disasmRows.add(["", "", "尾部魔数: 0x" + toHex8(tailMagic) + " (期望 0x" + toHex8(LENB_MAGIC) + ")", "", ""])
            disasmTable.set_rows(disasmRows)
            return
        }
        int lenbSize = readU32(fileData, fileSize - 8)
        if lenbSize <= 0 or lenbSize > fileSize - 8 {
            disasmRows.add(["", "", "LENB 大小异常: " + _str(lenbSize), "", ""])
            disasmTable.set_rows(disasmRows)
            return
        }
        int lenbStart = fileSize - 8 - lenbSize
        gLenbOff = lenbStart
        gLenbPos = lenbStart
        gLenbEnd = fileSize - 8
        if gLenbEnd - gLenbOff < 20 {
            disasmRows.add(["", "", "LENB 数据太短", "", ""])
            disasmTable.set_rows(disasmRows)
            return
        }

        // 读取 LENB 头部 (大端)
        int magic = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
        int version = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
        int flags = rbe32(gLenbPos); gLenbPos = gLenbPos + 4
        string srcHash = rbe_i64_hex(gLenbPos)
        gLenbPos = gLenbPos + 8

        addDisasmRow("; ===== LENB Header =====")
        addDisasmRow("; magic:    0x" + toHex8(magic))
        addDisasmRow("; version:  0x" + toHex8(version))
        addDisasmRow("; flags:    0x" + toHex8(flags))
        addDisasmRow("; src_hash: " + srcHash)
        addDisasmRow("; blob_off: 0x" + toHex8(gLenbOff))
        addDisasmRow("; blob_end: 0x" + toHex8(gLenbEnd))

        int parseStart = skipHeaderAndSymbols(gLenbPos)
        gLenbPos = parseStart
        addDisasmRow("; ===== (跳过符号表,跳到模块主体) =====")
        parseOneChunkBody(0)

        // 输出到 Table
        disasmTable.set_rows(disasmRows)
        if gLineCount >= 10000 {
            disasmRows.add(["", "", "... (输出已截断,超过 10000 行)", "", ""])
            disasmTable.set_rows(disasmRows)
        }
        statusLbl.set_text("反汇编完成 - " + disasmRows.len() + " 行")
        SDL3.markFrameRedraw()
    }

    // ==================== 反汇编搜索功能 ====================

    func onDisasmSearch() {
        string key = disasmSearchEdit.get_text()
        if key == "" {
            statusLbl.set_text("请输入搜索关键字")
            SDL3.markFrameRedraw()
            return
        }
        disasmSearchKey = key
        disasmSearchPos = 0
        if disasmSearchInternal() {
            statusLbl.set_text("找到匹配 - 行 " + _str(disasmSearchPos + 1))
        } else {
            statusLbl.set_text("未找到匹配: " + key)
        }
        SDL3.markFrameRedraw()
    }

    func onDisasmSearchNext() {
        if disasmSearchKey == "" {
            onDisasmSearch()
            return
        }
        disasmSearchPos = disasmSearchPos + 1
        if disasmSearchInternal() {
            statusLbl.set_text("找到匹配 - 行 " + _str(disasmSearchPos + 1))
        } else {
            // 重头开始搜索
            disasmSearchPos = 0
            if disasmSearchInternal() {
                statusLbl.set_text("重新搜索 - 行 " + _str(disasmSearchPos + 1))
            } else {
                statusLbl.set_text("未找到匹配: " + disasmSearchKey)
            }
        }
        SDL3.markFrameRedraw()
    }

    func disasmSearchInternal(): bool {
        string key = disasmSearchKey
        for disasmSearchPos:disasmRows.len()-1 to i {
            // 搜索所有列
            for 0:4 to col {  // 遍历 5 列: 地址/行号/指令/操作数/原始字节
                string cell = disasmRows[i][col]
                if cell.find(key) >= 0 {
                    disasmSearchPos = i
                    disasmTable.set_selected(i)
                    return true
                }
            }
        }
        return false
    }

    // ==================== 反汇编右键菜单回调 ====================

    func onDisasmCtxWillOpen(int row) {
        // 只有指令行（地址列非空）才允许修改
        bool isInstruction = false
        if row >= 0 and row < disasmRows.len() {
            if disasmRows[row][0].len() > 0 { isInstruction = true }
        }
        disasmTable.setContextItemEnabled("edit_cell", isInstruction)
        disasmTable.setContextItemEnabled("edit_row", isInstruction)
        disasmTable.setContextItemEnabled("copy_row", row >= 0)
        disasmTable.setContextItemEnabled("copy_addr", isInstruction)
        disasmTable.setContextItemEnabled("goto_addr", true)
        disasmTable.setContextItemEnabled("save_file", true)
    }

    func onDisasmContext(int row, string id) {
        if id == "edit_cell" {
            // 获取右击的列
            int col = disasmTable.get_context_menu_col()
            if col < 0 { col = 3 }  // 默认编辑操作数列
            disasmTable.begin_edit(row, col)
        } eif id == "edit_row" {
            // 默认编辑操作数列（第3列，索引3）
            disasmTable.begin_edit(row, 3)
        } eif id == "copy_row" {
            if row >= 0 and row < disasmRows.len() {
                string line = disasmRows[row][0] + "  " + disasmRows[row][1] + "  " + disasmRows[row][2] + "  " + disasmRows[row][3]
                statusLbl.set_text("已复制: " + line)
                SDL3.markFrameRedraw()
            }
        } eif id == "copy_addr" {
            if row >= 0 and row < disasmRows.len() {
                statusLbl.set_text("地址: " + disasmRows[row][0])
                SDL3.markFrameRedraw()
            }
        } eif id == "goto_addr" {
            // 跳转到地址：在搜索框中输入地址，然后查找
            statusLbl.set_text("在搜索框输入地址然后点击查找")
            SDL3.markFrameRedraw()
        } eif id == "save_file" {
            onDisasmSave()
        }
    }

    func onDisasmEditCommit(int row, int col, string newText) {
        if row < 0 or row >= disasmRows.len() { return }
        // 更新内存中的数据
        disasmRows[row][col] = newText
        // 同步更新 fileData（如果是操作数列，需要重新计算字节）
        // 这里先只更新显示，保存时统一写回
        statusLbl.set_text("已修改行 " + _str(row + 1) + " 列 " + _str(col) + " - 点击保存修改写入文件")
        SDL3.markFrameRedraw()
    }

    func onDisasmCellClick(int row, int col) {
        // 单击单元格时显示详情
        if row >= 0 and row < disasmRows.len() {
            string cell = disasmRows[row][col]
            if cell.len() > 0 {
                statusLbl.set_text("行 " + _str(row + 1) + " 列 " + _str(col) + ": " + cell)
                SDL3.markFrameRedraw()
            }
        }
    }

    // ==================== 保存修改到文件 ====================
    //
    // 将修改后的反汇编数据写回 PE 文件。根据修改的单元格内容，
    // 重新计算字节码并写入对应文件偏移。
    // 参考 LenoHack 的 patch_files.leno 模式：
    //   files.open(path, "r+b") → seek(offset) → write(bytes) → close()

    func onDisasmSave() {
        if filePath == "" {
            statusLbl.set_text("错误: 请先选择文件")
            SDL3.markFrameRedraw()
            return
        }
        if not analyzed {
            statusLbl.set_text("错误: 请先分析文件")
            SDL3.markFrameRedraw()
            return
        }

        // 备份原文件
        string backupPath = filePath + ".bak"
        try {
            File src = files.open(filePath, "rb")
            File dst = files.open(backupPath, "wb")
            int sz = src.len()
            string data = src.read(sz)
            dst.write(data)
            src.close()
            dst.close()
        } catch {
            statusLbl.set_text("警告: 备份失败,继续保存")
            SDL3.markFrameRedraw()
        }

        // 写回文件 - 使用 r+b 模式原地修改
        File wf = files.open(filePath, "r+b")
        if wf == null {
            statusLbl.set_text("错误: 无法以读写模式打开文件")
            SDL3.markFrameRedraw()
            return
        }

        int patchCount = 0
        // 遍历反汇编行，找到有地址的指令行，将修改后的操作数/指令写回
        for 0:disasmRows.len()-1 to ri {
            string addrStr = disasmRows[ri][0]
            if addrStr == "" { continue }
            if addrStr.len() < 3 { continue }
            // 解析地址 (格式: 0x........)
            if addrStr[0] != "0" or addrStr[1] != "x" { continue }
            int addr = hexStrToInt(addrStr)
            if addr <= 0 or addr >= fileSize { continue }

            // 获取原始字节列和当前字节列
            string rawHex = disasmRows[ri][4]
            if rawHex == "" { continue }

            // 将修改后的原始字节列写回文件
            // 解析 hex 字符串为字节序列
            Array[int] bytes = parseHexBytes(rawHex)
            if bytes.len() == 0 { continue }

            // 与原文件对比，只写有变化的字节
            int changed = 0
            for 0:bytes.len()-1 to bi {
                if addr + bi < fileSize {
                    int origByte = fileData.byte(addr + bi)
                    if origByte != bytes[bi] {
                        wf.seek(addr + bi, "set")
                        wf.write(strings.char(bytes[bi]))
                        changed = changed + 1
                    }
                }
            }
            if changed > 0 {
                patchCount = patchCount + changed
            }
        }

        wf.close()

        // 重新读取文件到内存（保持 fileData 与磁盘同步）
        File rf = files.open(filePath, "rb")
        if rf != null {
            fileSize = rf.len()
            fileData = rf.read(fileSize)
            fileSize = fileData.byte_len()
            rf.close()
        }

        if patchCount > 0 {
            statusLbl.set_text("v 保存完成 - 修改 " + patchCount + " 字节, 备份: " + dirs.basename(backupPath))
        } else {
            statusLbl.set_text("无修改内容（原始字节列未变化）")
        }
        SDL3.markFrameRedraw()
    }

    // hex 字符串转 int（如 "0x1234" → 4660）
    func hexStrToInt(string s): int {
        int result = 0
        int start = 0
        if s.len() > 2 and s[0] == "0" and s[1] == "x" { start = 2 }
        for start:s.len()-1 to i {
            string ch = s[i]
            int v = 0
            if ch >= "0" and ch <= "9" {
                v = strings.byte(ch) - 48
            } eif ch >= "A" and ch <= "F" {
                v = strings.byte(ch) - 55
            } eif ch >= "a" and ch <= "f" {
                v = strings.byte(ch) - 87
            } else {
                break
            }
            result = result * 16 + v
        }
        return result
    }

    // 解析 hex 字节字符串（如 "48 8B 05" → [0x48, 0x8B, 0x05]）
    func parseHexBytes(string s): Array[int] {
        Array[int] result = []
        string cur = ""
        for 0:s.len()-1 to i {
            string ch = s[i]
            if ch == " " {
                if cur.len() == 2 {
                    result.add(hexStrToInt("0x" + cur))
                }
                cur = ""
            } else {
                cur = cur + ch
            }
        }
        if cur.len() == 2 {
            result.add(hexStrToInt("0x" + cur))
        }
        return result
    }

    // ==================== 事件处理 ====================

    func handleEvent(Event ev): bool {
        if ev.isQuit() or ev.isWindowClose() { return false }
        if titleBar.is_close_requested() {
            titleBar.clear_close_request()
            return false
        }
        if ev.isKeyDown() and ev.scancode() == Scancode.ESCAPE { return false }
        return true
    }

    // ==================== 主入口 ====================

    func run() {
        SDL3.ttfInit()

        win = SDL3.createWindow({
            title: "Leno PE 分析器",
            w: 1100, h: 700,
            flags: WindowFlag.RESIZABLE
        })
        if not win.ok { SDL3.ttfQuit(); return }
        win.setMinSize(700, 500)

        setupUI()

        win.run(
            func(Event ev): bool { return handleEvent(ev) },
            func(Renderer r) { }
        )

        SDL3.ttfQuit()
    }
}

// ==================== 程序入口 ====================

main() {
    PEAnalyzer app = new PEAnalyzer()
    app.run()
}
