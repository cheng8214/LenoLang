// hello_window.leno — SDL3 绘图示例（矩形、圆、线、混合模式）
import "../lib/SDL3.leno" as SDL3
use SDL3.Event
use SDL3.Renderer

main() {
    var win = SDL3.createWindow({title: "Hello LenoSDL3 - 绘图演示", w: 800, h: 600, flags: SDL3.WINDOW_RESIZABLE})
    if not win.ok { return }
    win.setResizable(false)

    win.run(
        func(Event e): bool {
            if e.isKeyDown() and e.scancode() == SDL3.SCANCODE_ESCAPE { return false }
            return true
        },
        func(Renderer r) {
            // 深色背景
            r.setColor(20, 30, 50, 255)
            r.clear()

            // ---- 1. 填充矩形 ----
            r.setColor(60, 120, 220, 255)
            r.fillRect(30, 30, 150, 100)

            // ---- 2. 矩形轮廓 ----
            r.setColor(255, 255, 255, 255)
            r.drawRect(30, 30, 150, 100)

            // ---- 3. 填充圆 ----
            r.setColor(220, 160, 50, 255)
            r.fillCircle(280, 80, 50)

            // ---- 4. 圆轮廓 ----
            r.setColor(255, 255, 0, 255)
            r.drawCircle(400, 80, 55)

            // ---- 5. 十字线 ----
            r.setColor(200, 200, 200, 255)
            r.drawLine(400, 180, 400, 350)
            r.drawLine(250, 265, 550, 265)

            // ---- 6. 对角线（X形） ----
            r.setColor(150, 150, 150, 255)
            r.drawLine(250, 180, 550, 350)
            r.drawLine(550, 180, 250, 350)

            // ---- 7. 气泡圆组 ----
            r.setColor(100, 200, 100, 180)
            r.fillCircle(100, 420, 30)
            r.fillCircle(170, 440, 25)
            r.fillCircle(240, 420, 30)
            r.fillCircle(310, 440, 25)

            // ---- 8. 点阵 ----
            r.setColor(255, 255, 255, 255)
            for 0:10 to i {
                r.drawPoint(500 + i * 22, 160)
            }

            // ---- 9. 矩形组 ----
            r.setColor(180, 80, 180, 255)
            r.fillRect(500, 250, 50, 80)
            r.fillRect(560, 230, 50, 100)
            r.fillRect(620, 250, 50, 80)

            // ---- 10. 半透明混合 ----
            r.setBlendMode(SDL3.BLENDMODE_BLEND)
            r.setColor(255, 80, 80, 160)
            r.fillRect(500, 400, 80, 80)
            r.setColor(80, 80, 255, 160)
            r.fillRect(540, 410, 80, 80)
            r.setColor(80, 255, 80, 160)
            r.fillRect(560, 430, 80, 80)
            r.setBlendMode(SDL3.BLENDMODE_NONE)
        }
    )

    print("退出成功")
}
