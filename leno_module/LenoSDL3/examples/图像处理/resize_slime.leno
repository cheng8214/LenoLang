// resize_slime.leno — 把大图压缩成 288x48、背景透明的 PNG
// 原理：开 HIDDEN 离屏窗口(288x48) → 全透明清屏 → 把源图按 LINEAR 缩放到画布
//       → readPixelsAt 读回帧缓冲(含 alpha 通道) → saveImagePNG 存盘。
// 运行：build\leno.exe resize_slime.leno
import "../../lib/SDL3.leno" as SDL3
use SDL3.(WindowFlag, Window, Renderer)

main() {
    string SRC = "d:\\CLeno\\史莱姆.png"
    string DST = "d:\\CLeno\\LenoC\\leno_module\\LenoSDL3\\examples\\应用示例\\游戏\\塔防\\image\\史莱姆.png"

    int W = 288
    int H = 48

    var win = SDL3.createWindow({
        title: "slime-resize",
        w: W,
        h: H,
        flags: WindowFlag.HIDDEN
    })
    if not win.ok {
        print("[resize] 窗口创建失败: " + SDL3.getError())
        return
    }

    Renderer r = SDL3.createRenderer(win.getHandle())

    // 关键：全透明清屏，得到带 alpha 的画布
    r.clearColor(#00000000)

    Ptr[u8] tex = SDL3.loadImageTexture(r.handle, SRC)
    if tex == null {
        print("[resize] 加载源图失败: " + SDL3.getError())
        SDL3.quit()
        return
    }

    var[float, float](sw, sh) = r.getTextureSize(tex)
    print("[resize] 源图尺寸: " + _int(sw) + " x " + _int(sh) + "  →  目标: " + W + " x " + H)

    // 把整张源图缩放到 288x48（loadImageTexture 已默认 LINEAR + BLEND）
    r.drawTextureAt(tex, 0.0, 0.0, _float(W), _float(H))
    r.flush()

    // 读回整块画布的像素（含 alpha）
    Ptr[u8] surface = r.readPixelsAt(0, 0, W, H)
    if surface == null {
        print("[resize] 读像素失败: " + SDL3.getError())
        SDL3.quit()
        return
    }

    if SDL3.saveImagePNG(surface, DST) {
        print("[resize] 已保存: " + DST)
    } else {
        print("[resize] 保存失败: " + SDL3.getError())
    }

    SDL3.destroySurface(surface)
    SDL3.destroyTexture(tex)
    SDL3.quit()
    print("[resize] 完成")
}
