// test_transform.leno — 测试图片旋转 & 翻转
import "../../lib/SDL3.leno" as SDL3
import "../../lib/sdl_core.leno" as core
use SDL3.Event
use SDL3.Renderer
use SDL3.Scancode
use SDL3.Flip

main() {
    var win = SDL3.createWindow({title: "Transform 测试 — 旋转 & 翻转", w: 900, h: 600})
    if not win.ok { return }

    // TTF
    SDL3.ttfInit()
    var font = SDL3.createFontAuto(16.0)

    var imgPath = "d:\\1.png"
    var loadedTex = null as Ptr[u8]
    var texLoaded = false

    var angle = 0.0       // 当前角度
    var flip   = 0        // 0=none, 1=H, 2=V
    var autoSpin = false  // 是否自动旋转

    win.run(
        func(Event e): bool {
            if e.isQuit() or e.isWindowClose() { return false }
            if e.isKeyDown() and e.scancode() == Scancode.ESCAPE { return false }

            // R: 手动旋转 +15°
            if e.isKeyDown() and e.scancode() == Scancode.R {
                angle = angle + 15.0; if angle >= 360.0 { angle = angle - 360.0 }
            }
            // F: 循环翻转模式
            if e.isKeyDown() and e.scancode() == Scancode.F {
                flip = flip + 1; if flip >= 3 { flip = 0 }
            }
            // S: 自动旋转开关
            if e.isKeyDown() and e.scancode() == Scancode.S {
                autoSpin = not autoSpin
            }
            return true
        },
        func(Renderer r) {
            r.clearColor(#161628FF)

            // 首次加载纹理
            if not texLoaded {
                loadedTex = SDL3.loadImageTexture(r.handle, imgPath)
                texLoaded = true
            }

            // 自动旋转
            if autoSpin {
                angle = angle + 1.5; if angle >= 360.0 { angle = angle - 360.0 }
                core.requestRedraw()   // 关键：主循环是「事件驱动重绘」，必须主动请求下一帧，否则动画会卡住（只有鼠标移动等事件触发时才重绘）
            }

            // 标题
            r.drawText(font, "Transform 测试 — 旋转 & 翻转", 10, 8, #FFDC50FF)

            // 状态栏
            var flipName = "无"
            if flip == 1 { flipName = "水平" }
            if flip == 2 { flipName = "垂直" }
            r.drawText(font, "角度: " + angle + "°  翻转: " + flipName + "  自动旋转: " + (if autoSpin then "开" else "关"), 10, 32, #96C8FFFF)

            // 绘制图片：多个副本展示不同效果
            if loadedTex != null {
                var[float, float](iw, ih) = r.getTextureSize(loadedTex)
                float scale = 90.0 / (if ih > iw then ih else iw)  // 缩放到合适大小
                float tw = iw * scale; float th = ih * scale

                // 1. 原始（不旋转不翻转）— 左上
                r.drawText(font, "原始", 10, 68, #646464FF)
                r.drawTextureAt(loadedTex, 10, 90, tw, th)

                // 2. 旋转 — 中间大图
                float cx = 420.0; float cy = 340.0
                float bw = tw * 2.0; float bh = th * 2.0
                r.drawText(font, "旋转 " + angle + "°  翻转:" + flipName, 380, 68, #FFC850FF)
                r.drawTextureRotated(loadedTex, cx - bw/2, cy - bh/2, bw, bh,
                                      angle, bw/2, bh/2, flip)

                // 3. 水平翻转（固定）— 右下
                r.drawText(font, "水平翻转", 680, 68, #646464FF)
                r.drawTextureRotated(loadedTex, 680, 90, tw, th, 0.0, 0.0, 0.0, Flip.HORIZONTAL)

                // 4. 垂直翻转（固定）— 右下2
                r.drawText(font, "垂直翻转", 680, 140 + _int(th), #646464FF)
                r.drawTextureRotated(loadedTex, 680, 162 + _int(th), tw, th, 0.0, 0.0, 0.0, Flip.VERTICAL)
            }

            // 操作说明
            r.drawText(font, "========================================", 10, 440, #505050FF)
            r.drawText(font, "操作:", 10, 462, #C8C864FF)
            r.drawText(font, "  R — 手动旋转 +15°", 10, 484, #969696FF)
            r.drawText(font, "  F — 循环翻转 (无→水平→垂直)", 10, 504, #969696FF)
            r.drawText(font, "  S — 自动旋转 开/关", 10, 524, #969696FF)
            r.drawText(font, "  ESC — 退出", 10, 544, #969696FF)
        }
    )

    if font.ok { font.close() }
    SDL3.ttfQuit()
}