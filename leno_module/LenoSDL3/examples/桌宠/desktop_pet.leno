// desktop_pet.leno — 可爱桌宠（拖拽移动、呼吸动画、眨眼、挥手、自动走动）
// 使用 win.run() 回调模式，透明窗口
import "../../lib/SDL3.leno" as SDL3
import maths
use SDL3.(Event, Renderer, WindowFlag, BlendMode)

// 桌宠状态
struct Pet {
    float x, y           // 位置（窗口内）
    float vx             // 移动速度
    int frame            // 帧计数
    int blinkTimer       // 眨眼计时器
    bool isBlinking      // 是否在眨眼
    bool isDragging      // 是否在拖拽
    bool isHover         // 鼠标悬停
    bool isHappy         // 开心状态（点击后）
    int happyTimer       // 开心持续时间
    bool isWaving        // 是否在挥手
    int waveTimer        // 挥手计时器
    int waveFrame        // 挥手帧
    int walkTimer        // 行走计时器
    int winX, winY       // 窗口位置
}

// 绘制桌宠（一只小猫）
func drawPet(Renderer r, Pet pet) {
    float x = pet.x
    float y = pet.y + maths.sin(_float(pet.frame) * 0.05) * 3.0  // 呼吸动画
    
    // 身体颜色
    int bodyR = 255, bodyG = 200, bodyB = 150  // 橘猫色
    if pet.isHappy {
        bodyR = 255; bodyG = 180; bodyB = 200  // 开心时变粉
    }
    
    // === 身体 ===
    r.setColor(bodyR, bodyG, bodyB, 255)
    r.fillCircle(x, y, 28.0)
    
    // === 头部 ===
    float headY = y - 28.0
    r.fillCircle(x, headY, 20.0)
    
    // === 耳朵（用小圆模拟） ===
    r.fillCircle(x - 16.0, headY - 16.0, 9.0)
    r.fillCircle(x + 16.0, headY - 16.0, 9.0)
    // 耳朵内部
    r.setColor(255, 180, 180, 255)
    r.fillCircle(x - 16.0, headY - 16.0, 5.0)
    r.fillCircle(x + 16.0, headY - 16.0, 5.0)
    
    // === 眼睛 ===
    r.setColor(255, 255, 255, 255)
    float eyeY = headY - 2.0
    
    if not pet.isBlinking {
        // 眼白
        r.fillCircle(x - 8.0, eyeY, 6.0)
        r.fillCircle(x + 8.0, eyeY, 6.0)
        // 眼珠
        r.setColor(50, 50, 50, 255)
        r.fillCircle(x - 8.0, eyeY, 3.5)
        r.fillCircle(x + 8.0, eyeY, 3.5)
        // 高光
        r.setColor(255, 255, 255, 255)
        r.fillCircle(x - 6.0, eyeY - 2.0, 1.8)
        r.fillCircle(x + 10.0, eyeY - 2.0, 1.8)
    } else {
        // 眨眼时画线
        r.setColor(50, 50, 50, 255)
        r.drawLine(x - 13.0, eyeY, x - 3.0, eyeY)
        r.drawLine(x + 3.0, eyeY, x + 13.0, eyeY)
    }
    
    // === 鼻子 ===
    r.setColor(255, 150, 150, 255)
    r.fillCircle(x, headY + 4.0, 2.5)
    
    // === 嘴巴 ===
    r.setColor(50, 50, 50, 255)
    if pet.isHappy {
        // 开心的笑
        r.drawLine(x - 4.0, headY + 8.0, x, headY + 11.0)
        r.drawLine(x, headY + 11.0, x + 4.0, headY + 8.0)
    } else {
        // 平静的嘴
        r.drawLine(x - 4.0, headY + 8.0, x + 4.0, headY + 8.0)
    }
    
    // === 前腿（左边是固定腿） ===
    r.setColor(bodyR, bodyG, bodyB, 255)
    r.fillCircle(x - 16.0, y + 22.0, 7.0)
    
    // === 右手（挥手或站立） ===
    float handX = x + 16.0
    float handY = y + 22.0
    
    if pet.isWaving {
        // 挥手动画
        float waveOffset = maths.sin(_float(pet.waveFrame) * 0.3) * 12.0
        handY = handY - 15.0 - waveOffset
        
        // 手臂
        r.setColor(bodyR, bodyG, bodyB, 255)
        r.fillCircle(x + 16.0, y + 10.0, 5.0)  // 肘部
        
        // 手掌（小爪子）
        r.fillCircle(handX + waveOffset * 0.3, handY, 8.0)
        
        // 手指（三个小圆）
        r.fillCircle(handX + waveOffset * 0.3 - 4.0, handY - 6.0, 3.0)
        r.fillCircle(handX + waveOffset * 0.3, handY - 7.0, 3.0)
        r.fillCircle(handX + waveOffset * 0.3 + 4.0, handY - 6.0, 3.0)
    } else {
        // 正常站立
        r.fillCircle(handX, handY, 7.0)
    }
    
    // === 悬停高亮 ===
    if pet.isHover {
        r.setColor(255, 255, 100, 150)
        r.drawCircle(x, y, 42.0)
    }
}

main() {
    // 创建无边框、置顶、透明的小窗口
    var win = SDL3.createWindow({
        title: "Desktop Pet",
        w: 150,
        h: 150,
        flags: WindowFlag.BORDERLESS | WindowFlag.ALWAYS_ON_TOP | WindowFlag.TRANSPARENT
    })
    if not win.ok { 
        print("[错误] 窗口创建失败")
        return 
    }
    print("[OK] 窗口创建成功")
    
    // 设置窗口位置（屏幕右下角）
    win.setPosition(1200, 700)
    
    // 启用连续渲染（动画需要）
    win.setMaxFPS(60)
    
    // 初始化桌宠状态
    var pet = new Pet()
    pet.x = 75.0
    pet.y = 95.0
    pet.vx = 0.0
    pet.frame = 0
    pet.blinkTimer = 0
    pet.isBlinking = false
    pet.isDragging = false
    pet.isHover = false
    pet.isHappy = false
    pet.happyTimer = 0
    pet.isWaving = false
    pet.waveTimer = 0
    pet.waveFrame = 0
    pet.walkTimer = 200  // 2秒后开始走动
    pet.winX = 1200
    pet.winY = 700
    
    // 事件处理函数
    func onEvent(Event ev): bool {
        // 窗口关闭
        if ev.isQuit() or ev.isWindowClose() { return false }
        
        // 鼠标移动 - 检测悬停
        if ev.isMouseMotion() {
            float mx = ev.mouseX()
            float my = ev.mouseY()
            float dx = mx - pet.x
            float dy = my - pet.y
            pet.isHover = dx * dx + dy * dy < 1764.0  // 42x42
            
            // 拖拽时移动窗口
            if pet.isDragging {
                float dx2 = ev.mouseDX()
                float dy2 = ev.mouseDY()
                pet.winX = pet.winX + _int(dx2)
                pet.winY = pet.winY + _int(dy2)
                win.setPosition(pet.winX, pet.winY)
            }
        }
        
        // 鼠标按下 - 开始拖拽
        if ev.isMouseButtonDown() and ev.mouseButton() == 1 {  // 左键
            float mx = ev.mouseX()
            float my = ev.mouseY()
            float dx = mx - pet.x
            float dy = my - pet.y
            if dx * dx + dy * dy < 1764.0 {
                pet.isDragging = true
                pet.vx = 0.0
            }
        }
        
        // 鼠标释放 - 结束拖拽
        if ev.isMouseButtonUp() and ev.mouseButton() == 1 {
            if pet.isDragging {
                pet.isDragging = false
                pet.walkTimer = 150  // 1.5秒后重新开始走动
            } else if pet.isHover {
                // 点击但未拖拽 = 开心反应
                pet.isHappy = true
                pet.happyTimer = 60
                pet.isWaving = true
                pet.waveTimer = 60
                pet.waveFrame = 0
            }
        }
        
        return true
    }
    
    // 渲染函数
    func onRender(Renderer r) {
        // 更新动画状态
        pet.frame = pet.frame + 1
        
        // 眨眼逻辑
        pet.blinkTimer = pet.blinkTimer + 1
        if pet.blinkTimer > 180 {  // 约3秒眨一次
            pet.isBlinking = true
            if pet.blinkTimer > 195 {
                pet.isBlinking = false
                pet.blinkTimer = 0
            }
        }
        
        // 开心状态
        if pet.isHappy {
            pet.happyTimer = pet.happyTimer - 1
            if pet.happyTimer <= 0 {
                pet.isHappy = false
            }
        }
        
        // 挥手动画
        if pet.isWaving {
            pet.waveFrame = pet.waveFrame + 1
            pet.waveTimer = pet.waveTimer - 1
            if pet.waveTimer <= 0 {
                pet.isWaving = false
            }
        }
        
        // 自动走动逻辑
        if not pet.isDragging {
            pet.walkTimer = pet.walkTimer - 1
            if pet.walkTimer <= 0 {
                // 随机改变行为
                int action = _int(maths.sin(_float(pet.frame) * 0.01) * 100.0) % 10
                
                if action < 3 {
                    pet.vx = -0.5  // 向左
                } else if action < 6 {
                    pet.vx = 0.5   // 向右
                } else {
                    pet.vx = 0.0   // 停止
                    // 停止时随机挥手
                    if action >= 8 and not pet.isWaving {
                        pet.isWaving = true
                        pet.waveTimer = 60
                        pet.waveFrame = 0
                    }
                }
                pet.walkTimer = 100 + _int(maths.sin(_float(pet.frame) * 0.02) * 50.0 + 50.0)
            }
            
            // 应用移动
            pet.x = pet.x + pet.vx
            
            // 边界检测（窗口内）
            if pet.x < 35.0 {
                pet.x = 35.0
                pet.vx = 0.3
            }
            if pet.x > 115.0 {
                pet.x = 115.0
                pet.vx = -0.3
            }
            
            // 移动窗口位置（屏幕上）
            if pet.vx != 0.0 {
                pet.winX = pet.winX + _int(pet.vx * 2.0)
                
                // 屏幕边界检测
                if pet.winX < 0 { pet.winX = 0 }
                if pet.winX > 1770 {  // 1920 - 150
                    pet.winX = 1770
                    pet.vx = -pet.vx
                }
                
                win.setPosition(pet.winX, pet.winY)
            }
        }
        
        // 透明背景（alpha=0）
        r.setColor(0, 0, 0, 0)
        r.clear()
        
        // 绘制桌宠
        drawPet(r, pet)
    }
    // 运行事件循环
    win.run(onEvent, onRender)
    
    // 清理
    win.destroy()
    SDL3.quit()
    
    print("桌宠退出")
}