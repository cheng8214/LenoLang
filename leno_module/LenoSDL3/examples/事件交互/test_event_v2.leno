// test_event_v2.leno - 测试新增事件 API (文本输入/拖放/窗口状态/键盘修饰等)
import "../../lib/SDL3.leno" as SDL3
use SDL3.Event
use SDL3.Renderer

main() {
    var win = SDL3.createWindow({title: "Event v2 - Text/Focus/Drop", w: 800, h: 550})
    if not win.ok { print("窗口失败"); return }

    SDL3.ttfInit()
    var font = SDL3.createFontAuto(18.0)

    var events = []
    var textBuffer = ""       // 文本输入缓冲区
    var mx = 0; var my = 0    // 鼠标位置
    var wheelVal = 0          // 滚轮值
    var focused = true        // 窗口焦点
    var minimized = false
    var mouseInWindow = true

    win.run(
        func(Event e): bool {
            // ---- 记录事件类型 ----
            var ename = ""
            if e.isQuit()             { return false }
            if e.isWindowClose()      { ename = "WindowClose"; return false }
            if e.isKeyDown()          { ename = "KeyDown(" + e.scancode() + ")" }
            if e.isKeyUp()            { ename = "KeyUp(" + e.scancode() + ")" }
            if e.isMouseMotion()      { mx = _int(e.mouseX()); my = _int(e.mouseY()) }
            if e.isMouseButtonDown()  { ename = "MouseDown(btn=" + e.mouseButton() + " x=" + _int(e.mouseX()) + " y=" + _int(e.mouseY()) + ")" }
            if e.isMouseButtonUp()    { ename = "MouseUp(btn=" + e.mouseButton() + ")" }
            if e.isMouseWheel()       { wheelVal = wheelVal + _int(e.wheelY()); ename = "Wheel(x=" + _int(e.wheelX()) + " y=" + _int(e.wheelY()) + ")" }

            // 窗口事件
            if e.isWindowResized()    { ename = "Resized" }
            if e.isWindowMoved()      { ename = "Moved" }
            if e.isWindowMinimized()  { ename = "Minimized"; minimized = true }
            if e.isWindowMaximized()  { ename = "Maximized" }
            if e.isWindowRestored()   { ename = "Restored"; minimized = false }
            if e.isWindowFocusGained(){ ename = "FocusGained"; focused = true }
            if e.isWindowFocusLost()  { ename = "FocusLost"; focused = false }
            if e.isWindowMouseEnter() { ename = "MouseEnter"; mouseInWindow = true }
            if e.isWindowMouseLeave() { ename = "MouseLeave"; mouseInWindow = false }

            // 文本输入
            if e.isTextInput()        { textBuffer = textBuffer + e.text(); ename = "TextInput(\"" + e.text() + "\")" }

            // 拖放
            if e.isDropFile()         { ename = "DropFile(" + e.dropPath() + ")" }
            if e.isDropText()         { ename = "DropText(" + e.dropPath() + ")" }

            // 键盘修饰键
            if e.isKeyDown() and e.keyRepeat()  { ename = ename + " [REPEAT]" }

            if ename != "" {
                if events.len() >= 20 { events.remove(0) }
                events.add(ename)
            }

            return true
        },
        func(Renderer r) {
            r.clearColor(18, 18, 38, 255)

            // 标题
            r.drawText(font, "Event v2 - Text/Focus/Drop/Drag", 10, 8, 255, 220, 100)

            // 状态栏
            var f = if focused then "在" else "丢失"
            var m = if mouseInWindow then "在窗口内" else "已离开"
            var n = if minimized then "是" else "否"
            r.drawText(font, "状态: 焦点:" + f + "  鼠标:" + m + "  最小化:" + n, 10, 32, 140, 200, 255)

            // 鼠标
            r.drawText(font, "鼠标: x=" + mx + " y=" + my + "  滚轮: " + wheelVal, 10, 55, 140, 200, 255)

            // 文本输入
            r.drawText(font, "文本输入: \"" + textBuffer + "\"", 10, 80, 100, 255, 100)

            // 事件历史
            r.drawText(font, "--- 事件历史 (最近20条) ---", 10, 110, 150, 150, 150)
            var ey = 132
            for 0 : events.len() - 1 to i {
                r.drawText(font, (events.len() - i) + ": " + (events[events.len() - 1 - i] ), 10, ey, 140, 200, 255)
                ey = ey + 20
            }

            // 功能说明
            r.drawText(font, "--- 功能说明 ---", 410, 10, 200, 200, 100)
            r.drawText(font, "键盘: 按任意键测试 KeyDown/Up/Repeat", 410, 35, 140, 200, 255)
            r.drawText(font, "鼠标: 移动/点击/滚轮测试", 410, 55, 140, 200, 255)
            r.drawText(font, "文本: 切换到其他窗口再切回", 410, 75, 140, 200, 255)
            r.drawText(font, "焦点: 点击窗口标题栏 或 切换窗口", 410, 95, 140, 200, 255)
            r.drawText(font, "鼠标进入/离开: 移入/移出窗口", 410, 115, 140, 200, 255)
            r.drawText(font, "拖放: 从文件管理器拖文件到窗口", 410, 135, 140, 200, 255)
            r.drawText(font, "窗口状态: 最小化/最大化/还原窗口", 410, 155, 140, 200, 255)
            r.drawText(font, "按 ESC 或关闭窗口退出", 410, 185, 140, 200, 255)
        }
    )

    if font.ok { font.close() }
    SDL3.ttfQuit()
}
