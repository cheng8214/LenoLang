// test_extras.leno — 测试 createTexture / updateTexture / setColorScale
import "../lib/SDL3.leno" as SDL3
use SDL3.Event
use SDL3.Renderer

main() {
    var win = SDL3.createWindow({title: "Extras Test — 纹理创建 & 颜色缩放", w: 600, h: 400})
    if not win.ok { return }

    SDL3.ttfInit()
    var font = SDL3.createFontAuto(16.0)

    // 动态纹理
    var dynTex = null as Ptr
    var scale  = 1.0
    var lastMsg = ""

    win.run(
        func(Event e): bool {
            if e.isQuit() or e.isWindowClose() { return false }
            if e.isKeyDown() and e.scancode() == SDL3.SCANCODE_ESCAPE { return false }

            // 颜色缩放调节
            if e.isKeyDown() and e.scancode() == SDL3.SCANCODE_UP   { scale = scale + 0.1; if scale > 3.0 { scale = 3.0 }; lastMsg = "scale=" + scale }
            if e.isKeyDown() and e.scancode() == SDL3.SCANCODE_DOWN { scale = scale - 0.1; if scale < 0.1 { scale = 0.1 }; lastMsg = "scale=" + scale }

            return true
        },
        func(Renderer r) {
            r.clearColor(20, 20, 40, 255)
            r.setColorScale(scale)    // 应用颜色缩放

            // 首次创建动态纹理（RGBA8888, TARGET 访问模式）
            if dynTex == null {
                dynTex = r.createTexture(SDL3.PIXELFORMAT_RGBA8888, SDL3.TEXTUREACCESS_TARGET, 200, 150)
                if dynTex != null {
                    lastMsg = "createTexture 200x150 OK"
                    // 用离屏渲染画内容到纹理
                    r.setRenderTarget(dynTex)
                    r.clearColor(40, 80, 120, 255)
                    r.setRenderTarget(null)
                } else {
                    lastMsg = "createTexture FAIL"
                }
            }

            // 绘制动态纹理
            if dynTex != null {
                r.drawTextureAt(dynTex, 10, 60, 200, 150)
            }

            r.drawText(font, "Extras Test — createTexture & colorScale", 10, 8, 255, 220, 80)
            r.drawText(font, "ColorScale: " + scale + "   " + lastMsg, 10, 32, 180, 200, 255)

            // 说明
            int ly = 230
            r.drawText(font, "纹理创建:", 10, ly, 200, 255, 100); ly = ly + 22
            r.drawText(font, "  左侧蓝色方块 = createTexture(200x150) + 离屏渲染", 10, ly, 120, 120, 120); ly = ly + 22
            r.drawText(font, "颜色缩放:", 10, ly, 200, 255, 100); ly = ly + 22
            r.drawText(font, "  UP/DOWN — 调节亮度 scale=" + scale, 10, ly, 120, 120, 120); ly = ly + 22
            r.drawText(font, "  scale<1 变暗  scale=1 正常  scale>1 变亮(HDR)", 10, ly, 100, 100, 100); ly = ly + 22
            r.drawText(font, "ESC — 退出", 10, ly + 10, 150, 150, 150)
        }
    )

    if font.ok { font.close() }
    SDL3.ttfQuit()
    print(lastMsg)
}
