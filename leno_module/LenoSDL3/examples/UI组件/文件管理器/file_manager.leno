// file_manager.leno — LenoSDL3 文件管理器示例
// 演示组合：TreeView 目录树 + Table 文件列表 + Edit 路径栏 + MenuBar + 信息面板
// 核心能力（均来自 dirs 模块）：
//   · dirs.script_dir()  起始目录推导
//   · dirs.listdir()     列目录（仅名称）
//   · dirs.is_dir()      区分文件/文件夹
//   · dirs.join()        拼接完整路径
//   · dirs.stat()        读取大小（Dict{size,...}）
//   · dirs.extname()     取扩展名
//   · dirs.basename()/dirname()/abspath()
//   · dirs.mkdir_p()     新建文件夹
// 布局：顶部菜单 → 路径工具栏 → 左侧目录树 + 右侧文件表/信息面板 → 底部状态栏
import "../../../lib/SDL3.leno" as SDL3
import "../../../lib/sdl_core.leno" as core
import "../../../lib/sdl_filedialog.leno" as fdlg
import "about_dialog.leno" as about
import "delete_confirm_dialog.leno" as del_confirm
import "props_dialog.leno" as props
import dirs
import files
use SDL3.Event
use SDL3.Renderer
use SDL3.Window
use SDL3.Panel
use SDL3.TreeView
use SDL3.Table
use SDL3.Label
use SDL3.Edit
use SDL3.Button
use SDL3.MenuBar
use SDL3.ComboBox

// ===================== 模块级状态（供模块函数共享） =====================
string _curDir = ""
Array[Array[string]] _rows = []     // 表格行：[名称, 大小, 类型, 完整路径, 是否目录("1"/"0")]；第4/5列仅内部用，表头只有3列故不显示
string _renameOldPath = ""          // 右键“重命名”时暂存旧路径，供编辑提交后 dirs.rename 使用
bool _skipComboCallback = false
string _selPath = ""                // 当前选中项完整路径
bool   _selIsDir = false
Array[int] _loadedIds = []          // 已懒加载子节点的树节点 id
Array[string] _nodePaths = []       // 树节点 id-1 → 完整路径
Array[string] _nodeTypes = []       // 树节点 id-1 → 类型（pc/qa/drive/folder）
int    _regCounter = 1              // regDicts 用的 id 分配计数器（与 TreeView 内部 DFS 一致）
bool   _treeExpanded = true         // 导航树当前是否处于展开态
bool   _wantQuit = false
string _imgDir = ""                // 图标资源目录（images/）

// 文件剪贴板：复制/剪切的文件路径 + 操作类型
Array[string] _clipPaths = []
string _clipOp = ""

// 导航历史：后退/前进
Array[string] _history = []
int _histIndex = -1

// 控件引用（main 中赋值）
Window _win
TreeView _tree
Table  _table
ComboBox _pathCombo
Label  _statusLbl
Panel  _navPanel                     // 左侧导航面板容器（背景卡片）
Edit   _pathSearch                  // 左侧搜索 / 跳转输入框
Button _btnNew                      // 左侧"新建"按钮
Button _btnRefresh                  // 左侧"刷新"按钮
Button _btnToggle                   // 左侧"展开/折叠"按钮
Button _btnBack                     // 后退按钮
Button _btnForward                  // 前进按钮

// ===================== 工具函数 =====================

// 根据文件扩展名/是否目录，返回对应图标路径
//   文件夹 → folder_1.png   .exe → exe_1.png   .dll → dll_1.png   其他 → file_1.png
func iconForRow(string ext, bool isDir): string {
    if isDir { return _imgDir + "/folder_1.png" }
    if ext == ".exe" { return _imgDir + "/exe_1.png" }
    if ext == ".dll" { return _imgDir + "/dll_1.png" }
    return _imgDir + "/file_1.png"
}

// 列出某目录下的子文件夹，返回 TreeView 节点字典数组
func subFolders(string path): Array[Dict] {
    Array[Dict] out = []
    var names = dirs.listdir(path)
    if names != null {
        for names.len() to i {
            string nm = names[i]
            string fp = dirs.join(path, nm)
            if dirs.is_dir(fp) {
                out.add({text: nm, data: {path: fp}, has_children: true, path: fp, image: _imgDir + "/folder_1.png"})
            }
        }
    }
    return out
}

// 人类可读大小
func fmtSize(int b): string {
    if b < 1024 { return (b as string) + " B" }
    float kb = _float(b) / 1024.0
    if kb < 1024.0 { return _int(kb) + " KB" }
    float mb = kb / 1024.0
    if mb < 1024.0 { return _int(mb) + " MB" }
    float gb = mb / 1024.0
    return (_int(gb) as string) + " GB"
}

// 树节点是否已懒加载过子节点
func _isLoaded(int id): bool {
    for _loadedIds.len() to i { if _loadedIds[i] == id { return true } }
    return false
}

// 盘符显示名：去掉末尾分隔符（"C:\\" → "C:"，"/" → "/"）
func driveLabel(string p): string {
    string s = p
    while s.len() > 0 {
        string last = s.slice(s.len() - 1, s.len())
        if last == "\\" or last == "/" { s = s.slice(0, s.len() - 1) } else { break }
    }
    if s.len() == 0 { return p }
    return s
}

// 把节点字典列表登记进 _nodePaths/_nodeTypes（id 分配顺序与 TreeView 内部 DFS 完全一致）
func ensureNodeArr(int n) {
    while _nodePaths.len() < n { _nodePaths.add(""); _nodeTypes.add("") }
}
func regDicts(Array[Dict] ds) {
    for ds.len() to i {
        Dict d = ds[i] as Dict
        ensureNodeArr(_regCounter)
        Dict dd = d.get("data", {})
        _nodePaths[_regCounter - 1] = dd.get("path", "") 
        _nodeTypes[_regCounter - 1] = dd.get("type", "folder") 
        _regCounter = _regCounter + 1
        var ch = d.get("children", null)
        if ch is Array[Dict] and (ch as Array[Dict]).len() > 0 {
            regDicts(ch as Array[Dict])
        }
    }
}
func nodePath(int id): string {
    int idx = id - 1
    if idx >= 0 and idx < _nodePaths.len() { return _nodePaths[idx] }
    return ""
}
func nodeType(int id): string {
    int idx = id - 1
    if idx >= 0 and idx < _nodeTypes.len() { return _nodeTypes[idx] }
    return "folder"
}
func findNodeByType(string tp): int {
    for _nodeTypes.len() to i { if _nodeTypes[i] == tp { return i + 1 } }
    return -1
}

// 构建导航树根：此电脑（磁盘入口）+ 快速访问（当前位置）
func buildNavRoots(): Array[Dict] {
    string folderIcon = _imgDir + "/folder_1.png"
    Array[Dict] roots = []
    roots.add({text:"此电脑", data:{type:"pc", path:""}, has_children:true, expanded:true, image:folderIcon})
    string root = dirs.dirname(dirs.script_dir())
    Array[Dict] qaKids = []
    qaKids.add({text:"当前位置", data:{type:"folder", path:root}, has_children:true, expanded:true, image:folderIcon, children: subFolders(root)})
    roots.add({text:"快速访问", data:{type:"qa", path:""}, has_children:true, expanded:true, image:folderIcon, children: qaKids})
    return roots
}

// 此电脑节点：加载全部盘符（pc 节点为根首位，id 固定为 1）
func loadPcDrives() {
    int pcId = findNodeByType("pc")
    if pcId < 0 or _isLoaded(pcId) { return }
    var dv = dirs.list_drives()
    if dv != null {
        for dv.len() to i {
            string d = dv[i] as string
            Dict node = {text: driveLabel(d), data:{type:"drive", path:d}, has_children:true, image: _imgDir + "/folder_1.png"}
            int nid = _tree.add_child(pcId, node)
            ensureNodeArr(nid)
            _nodePaths[nid - 1] = d
            _nodeTypes[nid - 1] = "drive"
        }
    }
    _loadedIds.add(pcId)
}

// 树节点展开：懒加载子目录（盘符 / 普通文件夹）
func _onTreeToggle(int id, bool expanded) {
    if not expanded or _isLoaded(id) { return }
    string tp = nodeType(id)
    string p = nodePath(id)
    if tp == "pc" {
        var dv = dirs.list_drives()
        if dv != null {
            for dv.len() to i {
                string d = dv[i] as string
                Dict node = {text: driveLabel(d), data:{type:"drive", path:d}, has_children:true, image: _imgDir + "/folder_1.png"}
                int nid = _tree.add_child(id, node)
                ensureNodeArr(nid)
                _nodePaths[nid - 1] = d
                _nodeTypes[nid - 1] = "drive"
            }
        }
    } else if p != "" {
        var subs = subFolders(p)
        for subs.len() to i {
            int nid = _tree.add_child(id, subs[i])
            ensureNodeArr(nid)
            Dict dd = subs[i].get("data", {})
            _nodePaths[nid - 1] = dd.get("path", "") 
            _nodeTypes[nid - 1] = "folder"
        }
    }
    _loadedIds.add(id)
}

// 选中树节点：导航（跳过容器节点 pc/qa）
func _onTreeChange(Array[int] ids) {
    if ids.len() == 0 { return }
    int id = ids[0]
    string tp = nodeType(id)
    if tp == "pc" or tp == "qa" { return }
    string p = nodePath(id)
    if p != "" and dirs.is_dir(p) { openDir(p) }
}

// ===================== 导航历史 =====================

func _pushHistory(string path) {
    if _histIndex >= 0 and _histIndex < _history.len() and _history[_histIndex] == path { return }
    while _history.len() > _histIndex + 1 { _history.pop() }
    _history.add(path)
    _histIndex = _history.len() - 1
    _updateNavButtons()
}

func _updateNavButtons() {
    if _btnBack._loaded { _btnBack.set_enabled(_histIndex > 0) }
    if _btnForward._loaded { _btnForward.set_enabled(_histIndex >= 0 and _histIndex < _history.len() - 1) }
}

func goBack() {
    if _histIndex <= 0 { return }
    _histIndex = _histIndex - 1
    openDirNoHistory(_history[_histIndex])
}

func goForward() {
    if _histIndex >= _history.len() - 1 { return }
    _histIndex = _histIndex + 1
    openDirNoHistory(_history[_histIndex])
}

// ===================== 目录操作 =====================

// 打开目录（带历史记录）
func openDir(string path) {
    if not dirs.is_dir(path) {
        _statusLbl.set_text("无法打开目录: " + path)
        return
    }
    _pushHistory(path)
    openDirNoHistory(path)
}

// 打开目录（不记历史，用于后退前进）
func openDirNoHistory(string path) {
    if not dirs.is_dir(path) {
        _statusLbl.set_text("无法打开目录: " + path)
        return
    }
    _curDir = path
    _rows = []

    var names = dirs.listdir(path)
    if names == null {
        _table.set_rows([])
        _statusLbl.set_text("无法读取目录（权限不足或路径不存在）: " + path)
        _selPath = ""; _selIsDir = false
        return
    }

    // 先分文件夹 / 文件两批收集，文件夹排在前；每行第4/5列携带完整路径与是否目录，随排序一起移动
    Array[Array[string]] folders = []
    Array[Array[string]] fileRows = []
    for names.len() to i {
        string nm = names[i]
        string fp = dirs.join(path, nm)
        if dirs.is_dir(fp) {
            folders.add([nm, "", "文件夹", fp, "1"])
        } else {
            var st = dirs.stat(fp)
            int szb = st.get("size", 0)
            string ext = dirs.extname(nm)
            string tp = "文件"
            if ext != "" and ext != "." { tp = "文件 " + ext }
            fileRows.add([nm, fmtSize(szb), tp, fp, "0"])
        }
    }
    for folders.len() to i { _rows.add(folders[i]) }
    for fileRows.len() to i { _rows.add(fileRows[i]) }

    _table.set_rows(_rows)
    // 为每行设置对应类型图标和悬浮 tip（文件名 + 大小 + 类型）
    for _rows.len() to i {
        bool isDir = (_rows[i][4] == "1")
        string ext = dirs.extname(_rows[i][0])
        _table.set_row_image(i, iconForRow(ext, isDir))
        string nm = _rows[i][0]
        string sz = _rows[i][1]
        string tp = _rows[i][2]
        string tipText = "名称: " + nm
        if not isDir { tipText = tipText + "\n大小: " + sz }
        tipText = tipText + "\n类型: " + tp
        _table.set_row_tip(i, tipText)
    }
    _statusLbl.set_text(_rows.len() + " 个对象")
    _syncComboToHistory()
    _selPath = ""; _selIsDir = false
}

// 同步 ComboBox 到历史记录
func _syncComboToHistory() {
    if not _pathCombo._loaded { return }
    _pathCombo.set_items(_history)
    if _histIndex >= 0 and _histIndex < _history.len() {
        _skipComboCallback = true
        _pathCombo.set_selected(_histIndex)
        _skipComboCallback = false
    }
}

// 打开选中项（文件夹→进入；文件→系统默认程序打开）
func openSelected() {
    if _selPath == "" { return }
    if _selIsDir { openDir(_selPath) }
    else { openFile(_selPath) }
}

// 用系统默认程序打开文件
func openFile(string path) {
    if path == "" { return }
    if dirs.is_dir(path) { openDir(path); return }
    string cmd = "cmd /c start \"\" \"" + path + "\""
    var r = _exec(cmd)
    _statusLbl.set_text("已打开: " + dirs.basename(path))
}

// 文件复制（使用 files 模块读写）
func _copyFile(string src, string dst): bool {
    if dirs.is_dir(src) { return false }
    var content = files.read(src)
    if content == null { return false }
    files.write(dst, content)
    return dirs.exists(dst)
}

// 递归复制目录
func _copyDirRec(string src, string dst): bool {
    if not dirs.mkdir_p(dst) { return false }
    var names = dirs.listdir(src)
    if names == null { return true }
    for names.len() to i {
        string nm = names[i]
        string sp = dirs.join(src, nm)
        string dp = dirs.join(dst, nm)
        if dirs.is_dir(sp) {
            if not _copyDirRec(sp, dp) { return false }
        } else {
            if not _copyFile(sp, dp) { return false }
        }
    }
    return true
}

// 粘贴（复制或移动剪贴板中的文件到当前目录）
func pasteFiles() {
    if _clipPaths.len() == 0 or _clipOp == "" {
        _statusLbl.set_text("剪贴板为空")
        return
    }
    int okCount = 0
    for _clipPaths.len() to i {
        string src = _clipPaths[i]
        string nm = dirs.basename(src)
        string target = dirs.join(_curDir, nm)
        // 避开重名
        if dirs.exists(target) {
            string nameNoExt = nm
            string ext = dirs.extname(nm)
            if ext != "" and ext != "." {
                nameNoExt = nm.slice(0, nm.len() - ext.len())
            }
            int n = 1
            while dirs.exists(target) {
                n = n + 1
                target = dirs.join(_curDir, nameNoExt + " - 副本 (" + n + ")" + ext)
            }
        }
        bool ok = false
        if _clipOp == "copy" {
            if dirs.is_dir(src) { ok = _copyDirRec(src, target) } else { ok = _copyFile(src, target) }
        } else if _clipOp == "cut" {
            ok = dirs.rename(src, target)
        }
        if ok { okCount = okCount + 1 }
    }
    string opName = if _clipOp == "copy" then "复制" else "移动"
    _statusLbl.set_text(opName + "完成: " + okCount + " 项")
    if _clipOp == "cut" { _clipPaths = []; _clipOp = "" }
    openDir(_curDir)
}

// 新建文件夹（自动避开重名）
func newFolder() {
    int n = 1
    string base = dirs.join(_curDir, "新建文件夹")
    string target = base
    while dirs.exists(target) {
        n = n + 1
        target = base + " (" + n + ")"
    }
    if dirs.mkdir_p(target) {
        openDir(_curDir)
        _statusLbl.set_text("已创建: " + dirs.basename(target))
    } else {
        _statusLbl.set_text("创建文件夹失败")
    }
}

// 新建文件（自动避开重名，创建空 .txt 文件）
func newFile() {
    int n = 1
    string base = dirs.join(_curDir, "新建文本文档")
    string target = base + ".txt"
    while dirs.exists(target) {
        n = n + 1
        target = base + " (" + n + ").txt"
    }
    files.write(target, "")
    if dirs.exists(target) {
        openDir(_curDir)
        _statusLbl.set_text("已创建: " + dirs.basename(target))
    } else {
        _statusLbl.set_text("创建文件失败")
    }
}

// ===================== 主程序 =====================
main() {
    SDL3.ttfInit()
    _win = SDL3.createWindow({title:"LenoSDL3 文件管理器", w:1000, h:680, resizable:true})
    if not _win.ok { SDL3.ttfQuit(); return }

    _imgDir = dirs.join(dirs.script_dir(), "images")

    // ---------- 顶部菜单 ----------
    var bar = _win.addMenuBar({x:0, y:0, w:1000, h:30, font_size:14})
    int mFile = bar.addMenu("文件")
    bar.addItem(mFile, {label:"打开目录...", id:"openfolder"})
    bar.addItem(mFile, {label:"新建文件夹", id:"newfolder"})
    bar.addItem(mFile, {label:"新建文件", id:"newfile"})
    bar.addSeparator(mFile)
    bar.addItem(mFile, {label:"刷新", id:"refresh"})
    bar.addSeparator(mFile)
    bar.addItem(mFile, {label:"退出", id:"exit"})
    int mEdit = bar.addMenu("编辑")
    bar.addItem(mEdit, {label:"复制", id:"copy"})
    bar.addItem(mEdit, {label:"剪切", id:"cut"})
    bar.addItem(mEdit, {label:"粘贴", id:"paste"})
    bar.addSeparator(mEdit)
    bar.addItem(mEdit, {label:"删除", id:"del"})
    bar.setItemEnabled(mEdit, "paste", false)
    int mHelp = bar.addMenu("帮助")
    bar.addItem(mHelp, {label:"关于", id:"about"})

    bar.on_select(func(string menu, string id) {
        if id == "openfolder" {
            fdlg.showOpenFolderDialog(_win, func(Array[string] paths, int filter) {
                if paths != null and paths.len() > 0 { openDir(paths[0]) }
            }, {default_location: _curDir})
        } else if id == "newfolder" { newFolder() }
        else if id == "newfile"   { newFile() }
        else if id == "copy" {
            if _selPath != "" { _clipPaths = [_selPath]; _clipOp = "copy"; _statusLbl.set_text("已复制: " + dirs.basename(_selPath)); bar.setItemEnabled(mEdit, "paste", true) }
        } else if id == "cut" {
            if _selPath != "" { _clipPaths = [_selPath]; _clipOp = "cut"; _statusLbl.set_text("已剪切: " + dirs.basename(_selPath)); bar.setItemEnabled(mEdit, "paste", true) }
        } else if id == "paste" {
            if _clipPaths.len() > 0 and _clipOp != "" { bool wasCut = (_clipOp == "cut"); pasteFiles(); if wasCut { bar.setItemEnabled(mEdit, "paste", false) } }
            else { _statusLbl.set_text("剪贴板为空，无法粘贴") }
        }
        else if id == "del" {
            if _selPath != "" {
                del_confirm.show(_selPath, _selIsDir, func() {
                    if dirs.delete(_selPath) { _statusLbl.set_text("已删除: " + dirs.basename(_selPath)); openDir(_curDir) }
                    else { _statusLbl.set_text("删除失败: " + dirs.basename(_selPath)) }
                })
            }
        }
        else if id == "refresh"   { openDir(_curDir) }
        else if id == "exit"      { _wantQuit = true }
        else if id == "about"     { about.show() }
    })

    // ---------- 路径工具栏（ComboBox 历史下拉） ----------
    _pathCombo = SDL3.createComboBox({x:12, y:38, w:740, h:28, font_size:14, placeholder:"选择或浏览目录...", popup_h: 300, bg_rgb:[20,22,28], text_rgb:[235,240,255]})
    _win.add(_pathCombo)
    _pathCombo.on_change(func(int idx) {
        if _skipComboCallback { return }
        if idx >= 0 and idx < _history.len() {
            _histIndex = idx
            openDirNoHistory(_history[idx])
            _updateNavButtons()
        }
    })
    var btnOpen = SDL3.createButton({x:758, y:38, w:32, h:28, text:"", image_path:_imgDir + "/open.png", background:false})
    _win.add(btnOpen); btnOpen.set_tip("打开选中项"); btnOpen.on_click(func() { openSelected() })
    _btnBack = SDL3.createButton({x:834, y:38, w:32, h:28, text:"", image_path:_imgDir + "/last.png", background:false})
    _win.add(_btnBack); _btnBack.set_tip("后退"); _btnBack.on_click(func() { goBack() })
    _btnForward = SDL3.createButton({x:870, y:38, w:32, h:28, text:"", image_path:_imgDir + "/next.png", background:false})
    _win.add(_btnForward); _btnForward.set_tip("前进"); _btnForward.on_click(func() { goForward() })
    var btnRefresh = SDL3.createButton({x:910, y:38, w:32, h:28, text:"", image_path:_imgDir + "/update.png", background:false})
    _win.add(btnRefresh); btnRefresh.set_tip("刷新"); btnRefresh.on_click(func() { openDir(_curDir) })

    // ---------- 左侧导航面板（此电脑 + 快速访问 + 工具栏） ----------
    _navPanel = SDL3.createPanel({x:12, y:74, w:300, h:560, bg_rgb:[26,28,36], border_rgb:[70,75,92], radius:8})
    _win.add(_navPanel)

    var navTitle = SDL3.createLabel({x:24, y:84, text:"导航", font_size:14, text_rgb:[150,200,255]})
    _navPanel.add(navTitle)

    // 搜索 / 跳转路径输入框
    _pathSearch = SDL3.createEdit({x:24, y:108, w:276, h:26, font_size:13, placeholder:"搜索或输入路径…", bg_rgb:[18,20,26], text_rgb:[230,235,245]})
    _navPanel.add(_pathSearch)
    _pathSearch.on_enter(func() {
        string t = _pathSearch.get_text()
        if t == "" { return }
        string target = t
        if not dirs.is_dir(target) {
            string j = dirs.join(_curDir, t)
            if dirs.is_dir(j) { target = j } else { _statusLbl.set_text("找不到: " + t); return }
        }
        openDir(target)
        _pathSearch.set_text("")
    })

    // 工具栏按钮
    _btnNew = SDL3.createButton({x:24, y:142, w:84, h:26, text:"", image_path:_imgDir + "/new.png", background:false})
    _navPanel.add(_btnNew); _btnNew.set_tip("新建文件夹"); _btnNew.on_click(func() { newFolder() })
    _btnRefresh = SDL3.createButton({x:114, y:142, w:84, h:26, text:"", image_path:_imgDir + "/update.png", background:false})
    _navPanel.add(_btnRefresh); _btnRefresh.set_tip("刷新"); _btnRefresh.on_click(func() { openDir(_curDir) })
    _btnToggle = SDL3.createButton({x:204, y:142, w:84, h:26, text:"", image_path:_imgDir + "/zhetie.png", background:false})
    _navPanel.add(_btnToggle); _btnToggle.set_tip("折叠/展开导航树"); _btnToggle.on_click(func() {
        if _treeExpanded { _tree.collapse_all(); _treeExpanded = false }
        else { _tree.expand_all(); _treeExpanded = true }
    })

    // 目录树
    _tree = SDL3.createTreeView({x:24, y:180, w:276, h:448, font_size:14, image_size:16, image_gap:4})
    _navPanel.add(_tree)
    _tree.on_change(_onTreeChange)
    _tree.on_toggle(_onTreeToggle)

    // ---------- 右侧文件列表 ----------
    _table = SDL3.createTable({
        x:324, y:74, w:664, h:560,
        headers:["名称","大小","类型"],
        col_widths:[380,140,140],
        sortable:true, zebra:true, row_h:24, header_h:28, font_size:14,
        image_col:0, image_size:18, image_pad:4, image_gap:4
    })
    _win.add(_table)
    _table.on_select(func(int row) {
        if row < 0 or row >= _table.row_count() { return }
        var r = _table.get_row(row)
        if r.len() < 5 { return }
        _selPath = r[3]; _selIsDir = (r[4] == "1")
        return
    })

    // ---------- 表格右击上下文菜单：按“文件 / 文件夹 / 空白处”动态区分 ----------
    // 弹出前按命中行类型重建菜单项：文件夹多“在此文件夹内新建文件夹”，文件多“属性”
    _table.on_context_will_open(func(int row) {
        _table.clearContextItems()
        if row < 0 {
            _table.addContextItem({label:"新建文件夹", id:"newfolder"})
            _table.addContextItem({label:"新建文件", id:"newfile"})
            _table.addContextSeparator()
            _table.addContextItem({label:"粘贴", id:"paste"})
            _table.addContextSeparator()
            _table.addContextItem({label:"刷新", id:"refresh"})
            // 剪贴板为空时禁用粘贴
            if _clipPaths.len() == 0 or _clipOp == "" {
                _table.setContextItemEnabled("paste", false)
            }
            return
        }
        var r = _table.get_row(row)
        bool isDir = (r.len() >= 5 and r[4] == "1")
        _table.addContextItem({label:"打开", id:"open"})
        _table.addContextSeparator()
        _table.addContextItem({label:"复制", id:"copyfile"})
        _table.addContextItem({label:"剪切", id:"cutfile"})
        _table.addContextItem({label:"粘贴", id:"paste"})
        _table.addContextSeparator()
        _table.addContextItem({label:"重命名", id:"rename"})
        _table.addContextItem({label:"删除", id:"del"})
        _table.addContextSeparator()
        if isDir {
            _table.addContextItem({label:"在此文件夹内新建文件夹", id:"newfolder"})
        } else {
            _table.addContextItem({label:"属性", id:"props"})
        }
        if _clipPaths.len() == 0 or _clipOp == "" {
            _table.setContextItemEnabled("paste", false)
        }
        return
    })
    _table.on_context_select(func(int row, string id) {
        if row < 0 {
            if id == "newfolder" { newFolder() }
            else if id == "newfile" { newFile() }
            else if id == "paste" { bool wasCut = (_clipOp == "cut"); pasteFiles(); if wasCut { bar.setItemEnabled(mEdit, "paste", false) } }
            else if id == "refresh" { openDir(_curDir) }
            return
        }
        var r = _table.get_row(row)
        if r.len() < 5 { return }
        string p = r[3]; bool isDir = (r[4] == "1")
        if id == "open" {
            _selPath = p; _selIsDir = isDir; openSelected()
        } else if id == "copyfile" {
            _clipPaths = [p]; _clipOp = "copy"
            _statusLbl.set_text("已复制: " + dirs.basename(p))
            bar.setItemEnabled(mEdit, "paste", true)
        } else if id == "cutfile" {
            _clipPaths = [p]; _clipOp = "cut"
            _statusLbl.set_text("已剪切: " + dirs.basename(p))
            bar.setItemEnabled(mEdit, "paste", true)
        } else if id == "paste" {
            bool wasCut = (_clipOp == "cut"); pasteFiles(); if wasCut { bar.setItemEnabled(mEdit, "paste", false) }
        } else if id == "rename" {
            _renameOldPath = p
            _table.begin_edit(row, 0)
        } else if id == "del" {
            del_confirm.show(p, isDir, func() {
                if dirs.delete(p) {
                    _statusLbl.set_text("已删除: " + dirs.basename(p))
                    openDir(_curDir)
                } else {
                    _statusLbl.set_text("删除失败（可能被占用或权限不足）: " + dirs.basename(p))
                }
            })
        } else if id == "newfolder" {
            newFolder()
        } else if id == "props" {
            props.show(p, isDir)
        }
        return
    })
    // 行内编辑提交（由右键“重命名”触发）：真正落盘到 dirs.rename
    _table.on_edit_commit(func(int row, int col, string text) {
        if _renameOldPath == "" { return }
        string oldP = _renameOldPath; _renameOldPath = ""
        string newP = dirs.join(_curDir, text)
        if oldP == newP { return }
        if dirs.rename(oldP, newP) {
            _statusLbl.set_text("已重命名: " + text)
        } else {
            _statusLbl.set_text("重命名失败（名称冲突或权限不足）: " + text)
        }
        openDir(_curDir)   // 刷新列表（成功显示新名，失败还原）
        return
    })
    // 双击行直接打开（文件夹进入、文件提示已选）；行内编辑仅由右键“重命名”触发，故关闭双击编辑
    _table.set_editable(false)
    _table.on_dbl_click(func(int row, int col) {
        if row < 0 or row >= _table.row_count() { return }
        var r = _table.get_row(row)
        if r.len() < 5 { return }
        _selPath = r[3]; _selIsDir = (r[4] == "1"); openSelected()
        return
    })

    // ---------- 底部状态栏 ----------
    _statusLbl = SDL3.createLabel({x:12, y:648, text:"就绪", font_size:13, text_rgb:[170,200,170]})
    _win.add(_statusLbl)

    // ---------- 初始化：导航树（此电脑 + 快速访问） ----------
    _regCounter = 1
    _nodePaths = []
    _nodeTypes = []
    _loadedIds = []
    _history = []
    _histIndex = -1
    _treeExpanded = true
    var navRoots = buildNavRoots()
    _tree.set_items(navRoots)
    regDicts(navRoots)
    loadPcDrives()
    openDir(dirs.dirname(dirs.script_dir()))
    _updateNavButtons()

    // ---------- 运行主循环 ----------
    _win.run(
        func(Event ev): bool {
            if _wantQuit or ev.isQuit() { return false }
            return true
        },
        func(Renderer r) {
             r.clearColor(30, 33, 42, 255)
        }
    )
    SDL3.ttfQuit()
}
