// test_chart_standalone.leno — 单独测试三种图表控件（不依赖看板）
import "./../../../lib/SDL3.leno" as SDL3
import "./../../../lib/sdl_core.leno" as core
use SDL3.Event
use SDL3.Renderer
use SDL3.Window
use SDL3.BarChart
use SDL3.LineChart
use SDL3.PieChart

main() {
    SDL3.ttfInit()
    var win = SDL3.createWindow({title:"图表单独测试", w:900, h:640, resizable:true})
    if not win.ok { SDL3.ttfQuit(); return }

    // ---- 测试 1：柱状图 ----
    var bar = SDL3.createBarChart({x:30, y:60, w:380, h:250, title:"柱状图-各机房请求量(万)", font_size:12})
    win.add(bar)
    bar.set_data(["北京","上海","广州","深圳","成都","杭州"], [120,200,90,150,75,180])

    // ---- 测试 2：折线图（双系列）----
    var line = SDL3.createLineChart({x:30, y:340, w:380, h:260, title:"折线图-CPU 使用率(%)", font_size:12})
    win.add(line)
    line.set_data(
        ["00","04","08","12","16","20","24"],
        [[20,35,30,60,75,50,25],[30,40,38,55,68,45,30]],
        ["节点A","节点B"]
    )

    // ---- 测试 3：饼图 ----
    var pie = SDL3.createPieChart({x:470, y:60, w:400, h:300, title:"饼图-流量来源占比", font_size:12})
    win.add(pie)
    pie.set_data(["直接访问","搜索引擎","社交媒体","其他"], [35,40,18,7])

    win.run(
        func(Event ev): bool {
            if ev.isQuit() or ev.isWindowClose() { return false }
            return true
        },
        func(Renderer r) {
            r.clearColor(#12141AFF)
            
        }
    )

    SDL3.ttfQuit()
}
