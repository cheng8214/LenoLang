// test_button_image.leno — Button 图片（图标）功能探索测试
// 参考成熟框架设计：
//   Qt          setIcon / setIconSize
//   Material    icon + iconGravity (start/end/top)
//   WinForms    Image + TextImageRelation (ImageBeforeText / TextBeforeImage / ImageAboveText / TextAboveImage)
import "../../../lib/SDL3.leno" as SDL3
use SDL3.(Event, Renderer, Button, Scancode, Window)
import "../../../lib/sdl_core.leno" as core; use core.sdl3
import "../../../lib/sdl_image.leno" as img

// 程序化生成纯色图标（利用 SDL 表面 + SDL_image 保存）
func makeIcon(string path, int r, int g, int b): bool {
    Ptr[u8] surf = core.lib().SDL_CreateSurface(64, 64, core.PIXELFORMAT_RGBA8888)
    if surf == null { print("[icon] 创建表面失败: " + path); return false }
    int col = core.lib().SDL_MapSurfaceRGBA(surf, r, g, b, 255)
    core.lib().SDL_FillSurfaceRect(surf, null, col)
    bool ok = img.savePNG(surf, path)
    core.lib().SDL_DestroySurface(surf)
    print("[icon] " + (if ok then "OK " else "FAIL ") + path)
    return ok
}

main() {
    SDL3.ttfInit()

    // 使用外部图片 D:/1.png 演示各布局（请确保该文件存在）

    Window win = SDL3.createWindow({title: "Button 图片演示", w: 520, h: 420})
    if not win.ok { print("窗口创建失败"); return }

    // —— 演示 1：图标在左（默认，对齐 Material iconGravity=start / WinForms ImageBeforeText） ——
    Button bLeft = win.addButton({
        text: "图标在左", x: 30, y: 30, w: 200, h: 50,
        type: "primary",
        image_path: "D:/1.png", image_pos: "left", image_gap: 8
    })

    // —— 演示 2：图标在右（Material iconGravity=end / WinForms TextBeforeImage） ——
    Button bRight = win.addButton({
        text: "图标在右", x: 280, y: 30, w: 200, h: 50,
        type: "success",
        image_path: "D:/1.png", image_pos: "right"
    })

    // —— 演示 3：图标在上（Material iconGravity=top / WinForms ImageAboveText） ——
    Button bTop = win.addButton({
        text: "图标在上", x: 30, y: 110, w: 200, h: 70,
        type: "warning",
        image_path: "D:/1.png", image_pos: "top"
    })

    // —— 演示 4：图标在下（WinForms TextAboveImage） ——
    Button bBottom = win.addButton({
        text: "图标在下", x: 280, y: 110, w: 200, h: 70,
        type: "danger",
        image_path: "D:/1.png", image_pos: "bottom"
    })

    // —— 演示 5：透明度 + 着色（对齐 Qt ColorMod / Material icon tint） ——
    Button bTint = win.addButton({
        text: "半透明+红色着色", x: 30, y: 210, w: 230, h: 50,
        type: "dark",
        image_path: "D:/1.png", image_pos: "left",
        image_alpha: 120, image_tint: [255, 60, 60]
    })

    // —— 演示 6：点击动态切换图片（模拟图标状态切换） ——
    Button bSwap = win.addButton({
        text: "点我切换图标", x: 280, y: 210, w: 200, h: 50,
        type: "primary",
        image_path: "D:/1.png", image_pos: "left"
    })
    var swapState = 0
    bSwap.on_click(func() {
        swapState = swapState + 1
        if swapState % 2 == 0 { bSwap.set_image_pos("left") }
        else { bSwap.set_image_pos("right") }
        bSwap.set_text("点我切换图标 #" + swapState)
        print("[swap] 图标位置切到 " + (if swapState % 2 == 0 then "左" else "右"))
    })

    // —— 演示 7：纯图标按钮（无文字） ——
    Button bIconOnly = win.addButton({
        x: 30, y: 290, w: 50, h: 50,
        type: "success",
        image_path: "D:/1.png"
    })

    // —— 演示 8：很小的按钮（窄高 + 图标在上）—— 验证图标/文字自适应与裁剪不溢出
    Button bSmall = win.addButton({
        text: "小按钮", x: 100, y: 360, w: 90, h: 46,
        type: "primary",
        image_path: "D:/1.png", image_pos: "top"
    })

    print("=== Button 图片演示：左/右/上/下/透明着色/动态切换/纯图标 均已创建 ===")

    // 按钮的 process(事件) 与 render(绘制) 已由 Window.run() 内部自动完成
    // （sdl_window.leno 第558行自动 process、第616行自动 render 所有 widget），
    // 这里只需写「自定义逻辑」：ESC/关闭退出 + 背景清屏。切勿手动调用 btn.render/process。
    win.run(
        func(Event ev): bool {
            if ev.isQuit() or ev.isWindowClose() { return false }
            if ev.isKeyDown() and ev.scancode() == Scancode.ESCAPE { return false }
            return true
        },
        func(Renderer r) {
            r.clearColor(30, 32, 40, 255)
        }
    )
}