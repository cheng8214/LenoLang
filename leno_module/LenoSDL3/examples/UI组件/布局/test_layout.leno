// test_layout.leno — 布局系统测试（HBox / VBox / AnchorBox）
// 验证控件能自动排布，无需手填绝对坐标；窗口缩放时布局自适应（expand）。
// 约定：子控件用 SDL3.createXxx 创建（不注册到窗口），只把布局容器注册进窗口。
import "../../../lib/SDL3.leno" as SDL3
use SDL3.Event
use SDL3.Renderer
use SDL3.Scancode
use SDL3.HBox
use SDL3.VBox
use SDL3.AnchorBox
use SDL3.WindowFlag
use SDL3.Size

main() {
    var win = SDL3.createWindow({title: "布局系统测试", w: 640, h: 480, flags: WindowFlag.RESIZABLE})
    if not win.ok { return }
    SDL3.ttfInit()

    // 顶部：水平布局，三个按钮，中间那个占满剩余宽度
    HBox top = win.addHBox({x: 10, y: 10, w: 620, h: 44, spacing: 8, padX: 6, padY: 6})
    top.add(SDL3.createButton({text: "固定A", w: 90, h: 32}), {})
    top.add(SDL3.createButton({text: "弹性B（占满剩余）", w: 120, h: 32}), {expand: true})
    top.add(SDL3.createButton({text: "固定C", w: 90, h: 32}), {})

    // 中部：垂直布局，装一组表单控件；Edit/Slider 撑满宽度
    VBox form = win.addVBox({x: 10, y: 70, w: 300, h: 390, spacing: 10, padX: 8, padY: 8})
    form.add(SDL3.createLabel({text: "用户名"}), {})
    var ed = SDL3.createEdit({w: 200, h: 34, placeholder: "请输入"})
    ed.set_window(win.handle)
    form.add(ed, {expand: true})
    form.add(SDL3.createLabel({text: "音量"}), {})
    form.add(SDL3.createSlider({w: 200, h: 24, min: 0, max: 100, value: 40}), {expand: true})
    form.add(SDL3.createCheckBox({text: "记住我", checked: true}), {})
    form.add(SDL3.createToggle({text: "启用", on: true}), {})
    form.add(SDL3.createProgressBar({w: 200, h: 20, value: 65}), {expand: true})
    form.add(SDL3.createButton({text: "提交", w: 200, h: 36}), {align: 1})   // 居中

    // 右侧：锚点布局，把控件钉在四角/居中
    AnchorBox ab = win.addAnchorBox({x: 330, y: 70, w: 300, h: 390})
    ab.add(SDL3.createLabel({text: "左上"}), {left: 8, top: 8})
    ab.add(SDL3.createLabel({text: "右上"}), {right: 8, top: 8})
    ab.add(SDL3.createLabel({text: "居中"}), {centerX: true, centerY: true})
    ab.add(SDL3.createButton({text: "右下", w: 90, h: 32}), {right: 8, bottom: 8})
    ab.add(SDL3.createListBox({items: ["项1", "项2", "项3", "项4", "项5"], w: 160, h: 120}),
           {left: 8, bottom: 8})

    print("布局测试已启动，可拖动缩放窗口观察自适应")
    win.run(
        func(Event e): bool {
            if e.isQuit() or e.isWindowClose() { return false }
            if e.isKeyDown() and e.scancode() == Scancode.ESCAPE { return false }
            // 窗口缩放/最大化时，让三个容器跟随新尺寸重新排布（process/render 每帧会重排版子控件）
            if e.isWindowResized() {
                Size s = win.getSize()
                float W = _float(s.w); float H = _float(s.h)
                float leftW = (W - 30.0) / 2.0
                top.set_pos(10.0, 10.0); top.set_size(W - 20.0, 44.0)
                form.set_pos(10.0, 70.0); form.set_size(leftW, H - 80.0)
                ab.set_pos(10.0 + leftW + 10.0, 70.0); ab.set_size(leftW, H - 80.0)
            }
            return true
        },
        func(Renderer r) {
            r.setColor(28, 30, 38, 255)
            r.clear()
        }
    )

    SDL3.ttfQuit()
}
