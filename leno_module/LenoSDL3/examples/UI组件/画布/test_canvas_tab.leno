// test_canvas_tab.leno — 画布控件(Canvas) × TabControl 联动测试
// 运行：leno 本文件（Esc 退出）
//
// 验证点：
//  1) 画布像普通控件一样放置任意位置、设定大小（页内相对坐标 dx,dy 挂载）；
//  2) 局部坐标：on_draw 回调以 (0,0) 为画布左上角、(w,h) 为右下角绘制；
//  3) 裁剪：故意绘制超出画布范围的大图元，验证不会溢出污染邻近控件
//     （画布右侧紧贴一个按钮，若裁剪失败该按钮会被色块盖住）；
//  4) 持久画布（persist=true + PixelBuffer）：点击落点涂鸦，切页再切回内容保留；
//  5) 声明式+持久可叠加：持久画布之上再画淡色网格；
//  6) 事件回调：on_click / on_motion 收到画布局部坐标。
import "../../../lib/SDL3.leno" as SDL3
use SDL3.Event
use SDL3.Renderer
use SDL3.Scancode
use SDL3.TabControl
use SDL3.Button
use SDL3.Label
use SDL3.Font
use SDL3.Canvas

main() {
    var win = SDL3.createWindow({title: "Canvas 画布 × Tab 测试", w: 680, h: 500})
    if not win.ok { return }

    SDL3.ttfInit()
    var font = SDL3.createFontAuto(14.0)

    // 状态栏：显示最近一次画布事件（局部坐标）
    var status = win.addLabel({text: "状态：", font_size: 13, text_color: #C8D2E6FF, x: 20, y: 470})

    // ==================== Tab：两页各嵌一个画布 ====================
    var tab = win.addTabControl({
        x: 20, y: 16, w: 640, h: 430,
        tabs: ["声明式画布", "持久画布(涂鸦)"],
        active: 0, tab_h: 34, font_size: 15
    })

    // ---- 页 0：声明式画布（on_draw 每帧重画，局部坐标） ----
    var cv0 = SDL3.createCanvas({
        w: 520, h: 380, bg_color: #1B1F28FF, border_color: #4A5166FF
    })
    tab.addToPage(0, cv0, 10, 8)

    // 画布右侧紧贴一个按钮：验证画布裁剪 —— 若 on_draw 的内容溢出，
    // 该按钮会被色块/图形盖住，说明裁剪失效
    var guardBtn = SDL3.createButton({w: 110, h: 30, text: "画布外按钮"})
    tab.addToPage(0, guardBtn, 540, 8)
    guardBtn.on_click(func() {
        print("画布外的按钮正常响应（未被越界绘制遮挡）")
    })

    cv0.on_draw(func(Renderer r, float ox, float oy, float cw, float ch) {
        // 1) 故意绘制「超出画布范围」的半透明大矩形（从 -40 延伸到 cw+80），
        //    应被裁剪到画布内，不污染右侧按钮
        r.setColor(#FF6E8240)
        r.fillRect(ox - 40.0, oy - 40.0, cw + 120.0, ch + 160.0)

        // 2) 淡色网格（画布内部，局部坐标 0..cw / 0..ch）
        r.setColor(#2A3040FF)
        float gx = 0.0
        while gx <= cw {
            r.drawLine(gx, 0.0, gx, ch)
            gx = gx + 40.0
        }
        float gy = 0.0
        while gy <= ch {
            r.drawLine(0.0, gy, cw, gy)
            gy = gy + 40.0
        }

        // 3) 中心坐标轴（十字）
        r.setColor(#3D4A66FF)
        r.drawLine(cw / 2.0, 0.0, cw / 2.0, ch)
        r.drawLine(0.0, ch / 2.0, cw, ch / 2.0)

        // 4) 圆 + 圆环 + 叠加圆（验证圆、圆角矩形在局部坐标下正常）
        r.setColor(#58A0FFFF)
        r.fillCircle(cw * 0.3, ch * 0.42, 60.0)
        r.setColor(#FFAA50FF)
        r.drawCircle(cw * 0.7, ch * 0.42, 64.0)
        r.setColor(#50D296AA)
        r.fillCircle(cw * 0.7, ch * 0.42, 34.0)
        r.setColor(#BE78FFFF)
        r.fillRoundedRect(cw * 0.3 - 70.0, ch * 0.42 - 96.0, 140.0, 30.0, 8.0)

        // 5) 文字：局部坐标锚点绘制一段说明
        r.setColor(#FFFFFFE6)
        r.drawText(font, "Canvas 局部坐标", cw * 0.3 - 60.0, ch * 0.42 - 88.0, #FFFFFFE6)
        r.setColor(#AAB4C8FF)
        r.drawText(font, "(0,0)=左上角  (w,h)=右下角  越界图元被裁剪", 12.0, ch - 26.0, #AAB4C8FF)

        // 6) 越界图形：圆的一部分落在画布外，验证只显示画布内部分
        r.setColor(#78D2EB80)
        r.fillCircle(-30.0, ch + 20.0, 60.0)
    })

    // 画布内点击/移动 → 局部坐标（应始终在 0..520 / 0..380 内）
    cv0.on_click(func(float lx, float ly) {
        status.set_text("状态：页0 点击 (" + (_int(lx) as string) + ", " + (_int(ly) as string) + ")")
        print("页0 画布点击 局部坐标: (" + (_int(lx) as string) + ", " + (_int(ly) as string) + ")")
    })

    // ---- 页 1：持久画布（persist + PixelBuffer，涂鸦不消失） ----
    var cv1 = SDL3.createCanvas({
        w: 520, h: 380, persist: true, buffer_w: 260, buffer_h: 190,
        bg_color: #14171EFF, border_color: #4A5166FF
    })
    tab.addToPage(1, cv1, 10, 8)

    // 画布上方提示 + 清除按钮
    var tip1 = SDL3.createLabel({text: "点击画布涂鸦（持久，切页不丢）", font_size: 13, text_color: #AAB4C8FF})
    tab.addToPage(1, tip1, 10, 392)
    var clearBtn = SDL3.createButton({w: 100, h: 26, text: "清除画布"})
    tab.addToPage(1, clearBtn, 150, 388)
    clearBtn.on_click(func() {
        cv1.clear_buffer()
        print("持久画布已清除")
    })

    // 持久画布基础涂鸦：点击落 12x12 色块（buffer 为 260x190，坐标直接映射）
    cv1.on_click(func(float lx, float ly) {
        int px = _int(lx); int py = _int(ly)
        for -2 : 2 to i {
            for -2 : 2 to j {
                cv1.set_pixel(px + i, py + j, 255, 170, 80, 255)
            }
        }
        status.set_text("状态：页1 涂鸦 @ (" + (px as string) + ", " + (py as string) + ")")
        print("页1 持久画布涂鸦: (" + (px as string) + ", " + (py as string) + ")")
    })

    // 声明式叠加：持久内容之上每帧画淡色网格（验证 on_draw 与 persist 共存）
    cv1.on_draw(func(Renderer r, float ox, float oy, float cw, float ch) {
        r.setColor(#30384A80)
        float gx = 0.0
        while gx <= cw {
            r.drawLine(gx, 0.0, gx, ch)
            gx = gx + 50.0
        }
        float gy = 0.0
        while gy <= ch {
            r.drawLine(0.0, gy, cw, gy)
            gy = gy + 50.0
        }
        r.setColor(#AAB4C8C0)
        r.drawText(font, "persist + on_draw 叠加", 10.0, 8.0, #AAB4C8C0)
        // 声明式随时可消失的内容：右下角半透明圆（不写入持久层）
        r.setColor(#58A0FF80)
        r.fillCircle(cw - 50.0, ch - 50.0, 24.0)
    })

    // 切页日志
    tab.on_change(func(int idx) {
        print("切换到第 " + idx + " 页：" + (if idx == 0 then "声明式画布" else "持久画布"))
    })

    // 窗口级联动：切到持久页后等待 1 秒再切回，验证涂鸦不丢
    win.addButton({x: 20, y: 452, w: 170, h: 30, text: "切到页1再切回"}).on_click(func() {
        print("—— 切到页 1 ——")
        tab.set_active(1)
        SDL3.delay(1200)
        print("—— 切回页 0 ——")
        tab.set_active(0)
        print("—— 再切回页 1（持久涂鸦应完整保留） ——")
        tab.set_active(1)
    })

    // ---- 主循环 ----
    win.run(
        func(Event e): bool {
            if e.isQuit() or e.isWindowClose() { return false }
            if e.isKeyDown() and e.scancode() == Scancode.ESCAPE { return false }
            return true
        },
        func(Renderer r) {
            r.clearColor(#1C1E24FF)
            r.drawText(font, "Canvas 画布 × Tab 测试（Esc 退出）", 20, 2, #C8D2E6FF)
        }
    )

    if font.ok { font.close() }
    SDL3.ttfQuit()
}