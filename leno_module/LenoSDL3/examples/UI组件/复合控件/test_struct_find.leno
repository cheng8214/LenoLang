// 复现：_find 跨函数返回节点后，读 .checked 是否与树中真实值一致
struct N {
    int id
    bool flag
    Array[N] children = []
}

Array[N] roots = []

func _find(int id): N {
    for roots.len() to i {
        if roots[i].id == id { return roots[i] }
        N c = _findIn(roots[i].children, id)
        if c.id >= 0 { return c }
    }
    N e = new N()
    return e
}
func _findIn(Array[N] list, int id): N {
    for list.len() to i {
        if list[i].id == id { return list[i] }
        N c = _findIn(list[i].children, id)
        if c.id >= 0 { return c }
    }
    N e = new N()
    return e
}
// 原地写
func setFlag(int id, bool v): bool {
    for roots.len() to i {
        if roots[i].id == id { roots[i].flag = v; return true }
        if setFlagIn(roots[i].children, id, v) { return true }
    }
    return false
}
func setFlagIn(Array[N] list, int id, bool v): bool {
    for list.len() to i {
        if list[i].id == id { list[i].flag = v; return true }
        if setFlagIn(list[i].children, id, v) { return true }
    }
    return false
}

func fmtB(bool b): string { if b { return "true" } else { return "false" } }

main() {
    // 构造：root1(id1, 含 child id2) ; root3(id3)
    N a = new N(); a.id = 1
    N a1 = new N(); a1.id = 2
    a.children.add(a1)
    N b = new N(); b.id = 3
    roots.add(a); roots.add(b)

    setFlag(3, true)              // 原地写 root3
    N x = _find(3)                // 跨函数返回 root3
    print("setFlag(3,true) 后 _find(3).flag = " + fmtB(x.flag))

    N y = _find(1)
    print("_find(1).flag = " + fmtB(y.flag))
}
