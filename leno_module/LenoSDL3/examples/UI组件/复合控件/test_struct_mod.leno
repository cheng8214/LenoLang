// test_struct_mod.leno —— 充当被导入的“模块”，导出一个结构体与持有数组的容器
// 目的：验证 Array[Struct] 元素在模块内部访问时，字段读取/比较/写回是否正常
export struct Item {
    int id = -1
    string text = ""
    bool checked = false
}

export struct Holder {
    Array[Item] _items = []

    func fill() {
        for 5 to i {
            Item it = new Item()
            it.id = i
            it.text = "n" + i
            it.checked = false
            _items.add(it)
        }
    }
    func count(): int { return _items.len() }

    // 复刻原始 render 的逐行判断：元素 .id == 某 int 是否只有命中行才为 true
    func diagnose(int probe): Array[string] {
        Array[string] out = []
        for _items.len() to i {
            Item it = _items[i]
            bool m = (it.id == probe)        // 关键：元素 .id 与 int 比较
            out.add("i=" + i + " id=" + it.id + " match=" + m)
        }
        return out
    }
    func flip(int idx, bool v) { _items[idx].checked = v }
    func is_checked(int idx): bool { return _items[idx].checked }

    // 供模块外访问（避免直接暴露数组字段）
    func id_at(int i): int { return _items[i].id }
    func match_at(int i, int probe): bool { return _items[i].id == probe }
    func checked_at(int i): bool { return _items[i].checked }
}
