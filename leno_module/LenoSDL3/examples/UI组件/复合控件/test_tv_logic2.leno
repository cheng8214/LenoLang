// 验证重写后的 struct 数组版本：选中/勾选状态正确持久化
import "../../../lib/SDL3.leno" as SDL3
use SDL3.TreeView

func fmtArr(Array[int] a): string {
    string s = "["
    for a.len() to i { if i > 0 { s = s + "," }; s = s + a[i] }
    return s + "]"
}
func fmtB(bool b): string {
    if b { return "true" } else { return "false" }
}

main() {
    var tv = SDL3.createTreeView({
        x: 0, y: 0, w: 200, h: 300,
        items: [
            {text:"A", children:[ {text:"A1"}, {text:"A2"} ]},
            {text:"B", checkable:true}
        ],
        show_check: true,
        on_change: func(Array[int] ids) { print("on_change -> " + fmtArr(ids)) }
    })

    tv.select(4)            // B（可勾选节点）
    print("selId=" + tv.get_selected_id())
    print("selIds=" + fmtArr(tv.get_selected_ids()))

    tv.set_checked(4, true)
    print("checked=" + fmtArr(tv.get_checked_ids()))
    print("is_checked(4)=" + fmtB(tv.is_checked(4)))

    tv.set_checked(4, false)
    print("checked2=" + fmtArr(tv.get_checked_ids()))

    // 展开/折叠
    tv.expand(1, true)
    print("A expanded -> A1/A2 可见行数=" + tv.get_visible_count())
}
