// 隔离3：在能用的 iso 基础上，加上 _findIn(roots[i].children, id) 调用，看是否触发失败
struct N { int id; bool flag; Array[N] kids = [] }
Array[N] roots = []

func setFlag(int id, bool v) {
    for roots.len() to i { if roots[i].id == id { roots[i].flag = v; return } }
}
func get(int id): N {
    for roots.len() to i {
        if roots[i].id == id { return roots[i] }
        N c = findIn(roots[i].children, id)   // 关键：调用 children 递归
        if c.id >= 0 { return c }
    }
    N e = new N(); return e
}
func findIn(Array[N] list, int id): N {
    for list.len() to i { if list[i].id == id { return list[i] } }
    N e = new N(); return e
}

func fmtB(bool b): string { if b { return "true" } else { return "false" } }

main() {
    N a = new N(); a.id = 1
    N a1 = new N(); a1.id = 2; a.kids.add(a1)
    N b = new N(); b.id = 3
    roots.add(a); roots.add(b)

    setFlag(3, true)
    print("直接读 roots[1].flag = " + fmtB(roots[1].flag))
    N x = get(3)
    print("get(3).flag = " + fmtB(x.flag))
}
