// 隔离：自递归字段 .children 直接元素访问 / 取变量 / 传参，看哪种才坏
struct N { int id; bool flag; Array[N] children = [] }
Array[N] roots = []

func passParam(Array[N] list): int { return list.len() }

func fmtB(bool b): string { if b { return "true" } else { return "false" } }

main() {
    N a = new N(); a.id = 1
    N a1 = new N(); a1.id = 2; a.children.add(a1)
    N b = new N(); b.id = 3
    roots.add(a); roots.add(b)

    print("1) roots[0].children.len = " + roots[0].children.len())   // 期望 1
    Array[N] ch = roots[0].children
    print("2) ch = roots[0].children; ch.len = " + ch.len())          // 期望 1
    print("3) ch[0].id = " + ch[0].id)                                // 期望 2
    print("4) passParam(roots[0].children) = " + passParam(roots[0].children))  // 期望 1 (常量下标传参)
    print("5) roots[1].flag = " + fmtB(roots[1].flag))                // 期望 false
}
