// test_panel.leno — Panel 单独测试（容器 + 裁剪 + 子控件转发）
// 运行：leno 本文件
import "../../../../lib/SDL3.leno" as SDL3
use SDL3.Event
use SDL3.Renderer
use SDL3.Scancode
use SDL3.Panel
use SDL3.Button
use SDL3.Label

main() {
    var win = SDL3.createWindow({title: "Panel 测试", w: 560, h: 420})
    if not win.ok { return }

    SDL3.ttfInit()
    var font = SDL3.createFontAuto(14.0)

    // 面板 1：子控件溢出右边界 -> 演示裁剪
    var panel = win.addPanel({x: 30, y: 50, w: 260, h: 200,
        bg_color: #2C2E36FF, border_color: #5A5F6EFF, radius: 10})
    var pTitle = SDL3.createLabel({text: "面板内控件（溢出会被裁剪）", x: 45, y: 60, font_size: 14})
    panel.add(pTitle)
    // 按钮故意超出面板右边界（面板宽 260，从 x=30 到 290；此按钮到 320 溢出）
    var pBtn = SDL3.createButton({x: 45, y: 95, w: 280, h: 34, text: "超宽按钮(右侧溢出被裁)"})
    panel.add(pBtn)
    var pLb = SDL3.createLabel({text: "面板内说明文字", x: 45, y: 145, font_size: 13})
    panel.add(pLb)
    var pChk = SDL3.createCheckBox({x: 45, y: 175, w: 180, h: 24, text: "面板内复选框"})
    panel.add(pChk)

    // 面板 2：无裁剪（clip:false），同样溢出但完整显示
    var panel2 = win.addPanel({x: 310, y: 50, w: 220, h: 200,
        bg_color: #28302CFF, border_color: #5A6E5FFF, radius: 10, clip: false})
    var p2Title = SDL3.createLabel({text: "面板2(不裁剪)", x: 325, y: 60, font_size: 14})
    panel2.add(p2Title)
    var p2Btn = SDL3.createButton({x: 325, y: 95, w: 280, h: 34, text: "超宽按钮(不裁剪完整显示)"})
    panel2.add(p2Btn)

    // 面板外独立按钮，确认 Panel 不干扰其它控件
    win.addButton({x: 310, y: 280, w: 180, h: 34, text: "面板外按钮"}).on_click(func() {
        print("点击了面板外的按钮")
    })

    win.run(
        func(Event e): bool {
            if e.isQuit() or e.isWindowClose() { return false }
            if e.isKeyDown() and e.scancode() == Scancode.ESCAPE { return false }
            return true
        },
        func(Renderer r) {
            r.clearColor(#1C1E24FF)
            r.drawText(font, "Panel 测试 (Esc 退出) 左=裁剪 右=不裁剪", 30, 12, #C8D2E6FF)
        }
    )

    if font.ok { font.close() }
    SDL3.ttfQuit()
}
