// 精确探测：哪些下标形式能正确读/写 struct 数组元素
struct N { int id; bool flag }

Array[N] g = []

func readAt(Array[N] list, int idx): bool { return list[idx].flag }   // 参数下标读
func writeAt(Array[N] list, int idx, bool v) { list[idx].flag = v }   // 参数下标写

func fmtB(bool b): string { if b { return "true" } else { return "false" } }

main() {
    N a = new N(); a.id = 1; a.flag = true
    N b = new N(); b.id = 2; b.flag = false
    g.add(a); g.add(b)

    print("--- 读 ---")
    print("const g[0].flag = " + fmtB(g[0].flag))        // 期望 true
    print("const g[1].flag = " + fmtB(g[1].flag))        // 期望 false
    for g.len() to i { print("loop  g[" + i + "].flag = " + fmtB(g[i].flag)) }  // 期望 true/false
    print("param readAt(g,0) = " + fmtB(readAt(g, 0)))   // 期望 true
    print("param readAt(g,1) = " + fmtB(readAt(g, 1)))   // 期望 false

    N n0 = g[0]; print("alias N n=g[0]; n.flag = " + fmtB(n0.flag))  // 别名读 期望 true
    N n1 = g[1]; n1.flag = true                          // 别名写
    print("after alias write, g[1].flag = " + fmtB(g[1].flag))  // 期望 true(写回)

    print("--- 写 (参数下标) ---")
    writeAt(g, 0, false)
    print("after writeAt(g,0,false), g[0].flag = " + fmtB(g[0].flag))  // 期望 false(写回)

    print("--- 跨函数返回 struct 元素 ---")
    N r = getAt(g, 1)
    print("getAt(g,1).flag = " + fmtB(r.flag))           // 期望 true(别名写后)
}

func getAt(Array[N] list, int idx): N { return list[idx] }   // 返回元素
