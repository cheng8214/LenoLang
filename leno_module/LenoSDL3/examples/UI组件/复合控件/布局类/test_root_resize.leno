// test_root_resize.leno — 验证「根布局 fill 窗口 + 缩放自动适配」(P0)
// 运行：leno 本文件（Esc 退出）
//
// 把 VBox 设为 win.setRoot，窗口尺寸变化时根自动填满，整棵控件树每帧重排。
// 拖动窗口边缘应看到：
//   - 标题 Label、输入框 Edit 用 align:3(STRETCH) 横向撑满，随窗口变宽；
//   - 底部 HBox 内「自适应A」用 expand 占满剩余宽度，窗口越宽它越宽。
// 若缩放时控件跟随变化，说明 P0 根布局机制生效（无需任何手动 set_size）。
import "../../../../lib/SDL3.leno" as SDL3
use SDL3.Event
use SDL3.Renderer
use SDL3.Scancode
use SDL3.VBox
use SDL3.Label
use SDL3.Edit
use SDL3.Button
use SDL3.HBox

main() {
    var win = SDL3.createWindow({title: "根布局缩放测试", w: 480, h: 360})
    if not win.ok { return }
    win.setResizable(true)
    win.setMinSize(280, 220)

    SDL3.ttfInit()
    var font = SDL3.createFontAuto(14.0)

    // 根布局：VBox 填满窗口，缩放时整棵树自动重排
    var root = win.addVBox({x: 0, y: 0, w: 480, h: 360, spacing: 12, padX: 16, padY: 16})
    win.setRoot(root)

    root.add(SDL3.createLabel({text: "根布局自动填满窗口（拖动窗口试试）", font_size: 16}), {align: 3})
    root.add(SDL3.createEdit({w: 200, h: 32, placeholder: "输入框随窗口变宽"}), {align: 3})
    root.add(SDL3.createLabel({text: "下面 HBox：左侧自适应，右侧固定", font_size: 13}), {align: 3})

    var hb = SDL3.createHBox({w: 400, h: 36, spacing: 10})
    hb.add(SDL3.createButton({text: "自适应A", w: 120, h: 30}), {expand: true})
    hb.add(SDL3.createButton({text: "固定B", w: 120, h: 30}), {})
    root.add(hb, {align: 3})

    win.run(
        func(Event e): bool {
            if e.isQuit() or e.isWindowClose() { return false }
            if e.isKeyDown() and e.scancode() == Scancode.ESCAPE { return false }
            return true
        },
        func(Renderer r) {
            r.clearColor(28, 30, 36, 255)
        }
    )

    if font.ok { font.close() }
    SDL3.ttfQuit()
}
