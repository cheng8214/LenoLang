// show_time.leno - 在窗口中实时显示当前时间
import "../lib/SDL3.leno" as SDL3
import times

main() {
    var win = SDL3.createWindow({title: "实时时间显示 - SDL3_ttf 文字测试", w: 600, h: 300, flags: SDL3.WINDOW_HIGH_PIXEL_DENSITY})
    if not win.ok { print("创建窗口失败"); return }

    SDL3.ttfInit()

    // 大字（显示时间）
    var font = SDL3.createFontAuto(48.0)
    if not font.ok { print("加载字体失败"); win.destroy(); return }

    // 小字（日期/提示）
    var fontSmall = SDL3.createFontAuto(24.0)

    print("字体加载成功，高度: " + font.height)

    var ev = SDL3.createEvent()
    var ren = SDL3.createRenderer(win.handle)
    if not ren.ok { font.close(); win.destroy(); return }
    ren.setVSync(1)

    float winW = 600.0
    var running = true
    while running {
        while ev.poll() {
            if ev.isQuit() or ev.isWindowClose() { running = false }
            if ev.isKeyDown() and ev.scancode() == SDL3.SCANCODE_ESCAPE { running = false }
        }

        var dt = times.datetime()  // [年, 月, 日, 时, 分, 秒]

        ren.clearColor(20, 20, 40, 255)

        // 时间（大字体居中）
        var timeStr = dt[3] + ":" + dt[4] + ":" + dt[5]
        ren.drawTextCentered(font, timeStr, winW, 60.0, 255, 255, 255)

        // 日期（居中）
        var dateStr = dt[0] + "年" + dt[1] + "月" + dt[2] + "日"
        ren.drawTextCentered(fontSmall, dateStr, winW, 140.0, 200, 200, 255)

        // 英文日期时间（居中）
        var enStr = dt[0] + "-" + dt[1] + "-" + dt[2] + "  " + dt[3] + ":" + dt[4] + ":" + dt[5]
        ren.drawTextCentered(fontSmall, enStr, winW, 185.0, 150, 200, 150)

        // 提示（居中）
        ren.drawTextCentered(fontSmall, "按 ESC 退出", winW, 240.0, 100, 100, 100)

        ren.present()
        SDL3.delay(16)
    }

    ren.destroy()
    if font.ok { font.close() }
    if fontSmall.ok { fontSmall.close() }
    ev.uninit()
    win.destroy()
    SDL3.ttfQuit()
    print("程序结束")
}
