// test_new_api.leno — 测试新增 API：窗口控制/纹理调色/截图/剪贴板
import "../lib/SDL3.leno" as SDL3
use SDL3.Event
use SDL3.Renderer

main() {
    var win = SDL3.createWindow({title: "New API Test", w: 700, h: 500, flags: SDL3.WINDOW_RESIZABLE})
    if not win.ok { return }

    // ---- 剪贴板 ----
    SDL3.setClipboardText("Hello from LenoSDL3!")
    print("剪贴板: " + SDL3.getClipboardText())

    // ---- 窗口 API ----
    win.setTitle("New API — 窗口/纹理/截图/光标/全屏/计时")
    win.setOpacity(0.95)
    win.setAlwaysOnTop(false)
    print("窗口初始化 OK")

    // ---- 性能计数器 ----
    var perfStart = SDL3.getPerfCounter()
    var perfFreq  = SDL3.getPerfFrequency()
    print("性能计数器: freq=" + perfFreq + " start=" + perfStart)

    // ---- 光标初始状态 ----
    var cursorVis = SDL3.cursorVisible()
    print("光标初始状态: " + (if cursorVis then "可见" else "隐藏"))

    // ---- TTF ----
    SDL3.ttfInit()
    var font = SDL3.createFontAuto(16.0)

    // 状态
    var alpha     = 255
    var cr = 255; var cg = 255; var cb = 255
    var clipText  = SDL3.getClipboardText()
    var lastMsg   = ""
    var needShot  = false
    var loadedTex = null as Ptr
    var texLoaded = false

    win.run(
        func(Event e): bool {
            if e.isQuit() or e.isWindowClose() { return false }
            if e.isKeyDown() and e.scancode() == SDL3.SCANCODE_ESCAPE { return false }

            if e.isMouseButtonDown() {
                print("鼠标按钮: " + e.mouseButton() + "  掩码: " + SDL3.getMouseState())
            }

            // 纹理调色
            if e.isKeyDown() and e.scancode() == SDL3.SCANCODE_1 { alpha = 128; lastMsg = "alpha=128" }
            if e.isKeyDown() and e.scancode() == SDL3.SCANCODE_2 { alpha = 255; lastMsg = "alpha=255" }
            if e.isKeyDown() and e.scancode() == SDL3.SCANCODE_3 { cr = 255; cg = 100; cb = 100; lastMsg = "红色调" }
            if e.isKeyDown() and e.scancode() == SDL3.SCANCODE_4 { cr = 255; cg = 255; cb = 255; lastMsg = "正常" }

            // 窗口控制
            if e.isKeyDown() and e.scancode() == SDL3.SCANCODE_W { win.show(); lastMsg = "show" }
            if e.isKeyDown() and e.scancode() == SDL3.SCANCODE_H { win.hide(); lastMsg = "hide" }
            if e.isKeyDown() and e.scancode() == SDL3.SCANCODE_M { win.maximize(); lastMsg = "maximize" }
            if e.isKeyDown() and e.scancode() == SDL3.SCANCODE_N { win.minimize(); lastMsg = "minimize" }
            if e.isKeyDown() and e.scancode() == SDL3.SCANCODE_R { win.restore(); lastMsg = "restore" }
            if e.isKeyDown() and e.scancode() == SDL3.SCANCODE_Z { win.setSize(400, 300); lastMsg = "400x300" }

            // 剪贴板
            if e.isKeyDown() and e.scancode() == SDL3.SCANCODE_C { clipText = SDL3.getClipboardText(); lastMsg = "clipboard read" }

            // 光标
            if e.isKeyDown() and e.scancode() == SDL3.SCANCODE_D { SDL3.showCursor(); cursorVis = true;  lastMsg = "showCursor" }
            if e.isKeyDown() and e.scancode() == SDL3.SCANCODE_X { SDL3.hideCursor(); cursorVis = false; lastMsg = "hideCursor" }

            // 全屏
            if e.isKeyDown() and e.scancode() == SDL3.SCANCODE_F { win.setFullscreen(true); lastMsg = "fullscreen ON" }

            // 截图
            if e.isKeyDown() and e.scancode() == SDL3.SCANCODE_P { needShot = true }

            return true
        },
        func(Renderer r) {
            r.clearColor(20, 20, 40, 255)

            if not texLoaded {
                loadedTex = SDL3.loadImageTexture(r.handle, "d:\\1.png")
                texLoaded = true
            }

            if loadedTex != null {
                r.setTextureAlpha(loadedTex, alpha)
                r.setTextureColor(loadedTex, cr, cg, cb)
                r.drawTextureAt(loadedTex, 480, 280, 200, 180)
            }

            r.drawText(font, "New API — 窗口控制 & 纹理调色 & 截图", 10, 8, 255, 220, 80)
            r.drawText(font, "Alpha:" + alpha + "  RGB:" + cr + "," + cg + "," + cb + "  光标:" + (if cursorVis then "可见" else "隐藏") + "  操作: " + lastMsg, 10, 32, 180, 200, 255)

            int ly = 70
            r.drawText(font, "纹理: 1=半透明 2=不透明 3=红色调 4=正常", 10, ly, 150, 150, 150); ly = ly + 22
            r.drawText(font, "窗口: W=显示 H=隐藏 M=最大化 N=最小化 R=还原 Z=400x300", 10, ly, 150, 150, 150); ly = ly + 22
            r.drawText(font, "全屏: F=开启  光标: D=显示 X=隐藏", 10, ly, 150, 150, 150); ly = ly + 22
            r.drawText(font, "截图: P=保存  剪贴板: C=读取   ESC=退出", 10, ly, 150, 150, 150); ly = ly + 15

            r.drawText(font, "新增 API:", 10, ly, 200, 255, 100); ly = ly + 22
            r.drawText(font, "  Mouse: showCursor/hideCursor/cursorVisible/warpMouse/getMouseState", 10, ly, 100, 200, 100); ly = ly + 22
            r.drawText(font, "  Timer: getPerfCounter/getPerfFrequency", 10, ly, 100, 200, 100); ly = ly + 22
            r.drawText(font, "  Window: setFullscreen/show/hide/maximize/minimize/restore/setOpacity", 10, ly, 100, 200, 100); ly = ly + 22
            r.drawText(font, "  Renderer: setRenderTarget/setTextureAlpha/setTextureColor/readPixels/flush/drawTexture9Grid/drawTextureTiled", 10, ly, 100, 200, 100); ly = ly + 22
            r.drawText(font, "  Clipboard: getClipboardText/setClipboardText", 10, ly, 100, 200, 100)

            // 截图：present 之前读取像素并保存
            if needShot {
                needShot = false
                var surface = r.readPixels(null)
                if surface != null {
                    var ok = SDL3.saveImageBMP(surface, "d:\\screenshot.bmp")
                    lastMsg = "截图 " + (if ok then "OK" else "失败")
                    print(lastMsg + " — d:\\screenshot.bmp")
                } else {
                    lastMsg = "截图失败"
                }
            }
        }
    )

    if font.ok { font.close() }
    SDL3.ttfQuit()
    print("测试完成")
}
