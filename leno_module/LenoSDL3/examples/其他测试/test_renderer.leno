// 测试 Renderer 新增方法：getColor/getColorFloat/getOutputSize
import "../../lib/SDL3.leno" as SDL3
use SDL3.Event
use SDL3.Renderer
use SDL3.Scancode
use SDL3.WindowFlag

main() {
    var win = SDL3.createWindow({title: "Renderer 测试", w: 400, h: 300, flags: WindowFlag.RESIZABLE})
    if not win.ok { return }

    SDL3.ttfInit()
    var font = SDL3.createFont("C:/Windows/Fonts/consola.ttf", 20.0)
    if not font.ok { font = SDL3.createFont("C:/Windows/Fonts/consolas.ttf", 20.0) }

    var outSize = ""
    var colorInfo = ""
    var floatInfo = ""

    win.run(
        func(Event e): bool {
            if e.isQuit() or e.isWindowClose() { return false }
            if e.isKeyDown() and e.scancode() == Scancode.ESCAPE { return false }
            return true
        },
        func(Renderer r) {
            r.setColor(#141428FF)
            r.clear()

            // 只采集一次数据
            if outSize == "" {
                var[int, int](_ow, _oh) = r.getOutputSize()
                outSize = "Output Size: " + _ow + " x " + _oh
            }
            if colorInfo == "" {
                r.setColor(#64C832FF)
                int c = r.getColor()
                int cr = (c >> 16) & 0xFF
                int cg = (c >> 8) & 0xFF
                int cb = c & 0xFF
                int ca = (c >> 24) & 0xFF
                colorInfo = "Color: r=" + cr + " g=" + cg + " b=" + cb + " a=" + ca
            }
            if floatInfo == "" {
                r.setColorFloat(0.2, 0.6, 0.3, 1.0)
                var[float, float, float, float](cfr, cfg, cfb, cfa) = r.getColorFloat()
                floatInfo = "Float: r=" + cfr + " g=" + cfg +
                            " b=" + cfb + " a=" + cfa
            }

            r.drawText(font, "=== Renderer API Test ===", 10, 10, #FFFF64FF)
            r.drawText(font, outSize, 10, 40, #C8C8FFFF)
            r.drawText(font, colorInfo, 10, 70, #64C832FF)
            r.drawText(font, floatInfo, 10, 100, #32C864FF)
            r.drawText(font, "Press ESC to exit", 10, 140, #808080FF)

            // 用采集到的颜色画个矩形验证
            r.setColor(#64C832FF)
            r.fillRect(10, 180, 100, 60)
        }
    )

    if font.ok { font.close() }
    SDL3.ttfQuit()
}