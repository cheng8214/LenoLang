// test_extras.leno — 测试 createTexture / lockTexture / setColorScale / mouseGrab / raise
import "../../lib/SDL3.leno" as SDL3
use SDL3.Event
use SDL3.Renderer
use SDL3.Scancode
use SDL3.TextureAccess

main() {
    var win = SDL3.createWindow({title: "Extras — lockTexture & mouseGrab & colorScale", w: 600, h: 400})
    if not win.ok { return }

    SDL3.ttfInit()
    var font = SDL3.createFontAuto(16.0)

    // 动态纹理
    var dynTex = null as Ptr[u8]
    var scale  = 1.0
    var lastMsg = ""
    var grabbed = false

    win.run(
        func(Event e): bool {
            if e.isQuit() or e.isWindowClose() { return false }
            if e.isKeyDown() and e.scancode() == Scancode.ESCAPE { return false }

            // 颜色缩放
            if e.isKeyDown() and e.scancode() == Scancode.UP   { scale = scale + 0.1; if scale > 3.0 { scale = 3.0 }; lastMsg = "scale=" + scale }
            if e.isKeyDown() and e.scancode() == Scancode.DOWN { scale = scale - 0.1; if scale < 0.1 { scale = 0.1 }; lastMsg = "scale=" + scale }

            // 鼠标锁定
            if e.isKeyDown() and e.scancode() == Scancode.G {
                grabbed = not grabbed
                win.setMouseGrab(grabbed)
                lastMsg = if grabbed then "mouseGrab ON" else "mouseGrab OFF"
                print(lastMsg + "  getMouseGrab=" + win.getMouseGrab())
            }

            // 窗口前置
            if e.isKeyDown() and e.scancode() == Scancode.T { var ok = win.raise(); lastMsg = "raise=" + ok }

            return true
        },
        func(Renderer r) {
            r.clearColor(#141428FF)
            r.setColorScale(scale)

            // 首次创建动态纹理（TARGET 模式用于离屏渲染）
            if dynTex == null {
                dynTex = r.createTexture(SDL3.PIXELFORMAT_RGBA8888, TextureAccess.TARGET, 200, 150)
                if dynTex != null {
                    // 离屏渲染到纹理
                    r.setRenderTarget(dynTex)
                    r.clearColor(#3250B4FF)
                    r.setRenderTarget(null)
                    lastMsg = "createTexture 200x150 OK"
                } else {
                    lastMsg = "createTexture FAIL"
                }
            }

            if dynTex != null {
                r.drawTextureAt(dynTex, 10, 60, 200, 150)
            }

            r.drawText(font, "Extras — lockTexture & mouseGrab & colorScale", 10, 8, #FFDC50FF)
            r.drawText(font, "Scale:" + scale + "  Grab:" + grabbed + "  " + lastMsg, 10, 32, #B4C8FFFF)

            int ly = 230
            r.drawText(font, "颜色缩放: UP/DOWN", 10, ly, #969696FF); ly = ly + 22
            r.drawText(font, "鼠标锁定: G=切换 (鼠标限制在窗口内)", 10, ly, #969696FF); ly = ly + 22
            r.drawText(font, "窗口前置: T", 10, ly, #969696FF); ly = ly + 22
            r.drawText(font, "ESC — 退出", 10, ly + 12, #969696FF)
        }
    )

    if font.ok { font.close() }
    SDL3.ttfQuit()
    print(lastMsg)
}