// test_timer.leno — 测试 Timer：stop/start/reset/setOnce
import "../../lib/SDL3.leno" as SDL3
use SDL3.Event
use SDL3.Renderer
use SDL3.Timer
use SDL3.Scancode

main() {
    var win = SDL3.createWindow({title: "定时器测试", w: 600, h: 400})
    if not win.ok { return }

    // 字体只创建一次
    var font  = SDL3.createFontAuto(16.0)
    var font_s = SDL3.createFontAuto(12.0)
    var font_l = SDL3.createFontAuto(18.0)

    // 变量先声明，再在回调中引用
    var _count = 0       // t1 计数
    var _boom  = false   // t2 触发标志
    var _done  = false   // t3 触发标志
    var _msg   = ""      // 提示文字
    var _flash = 0.0     // 闪烁计时

    // ==================== 定时器 ====================
    // t1: 循环定时器，每秒触发
    Timer t1 = win.addTimer(1000, func() { _count += 1 })

    // t2: 初始暂停（ms=0），后续手动 start
    Timer t2 = win.addTimer(0, func() { _boom = true })

    // t3: 一次性，5 秒后触发
    Timer t3 = win.addTimerOnce(5000, func() { _done = true })

    // ==================== 主循环 ====================
    win.run(
        func(Event e): bool {
            if e.isQuit() or e.isWindowClose() { return false }
            if e.isKeyDown() {
                int sc = e.scancode()
                if sc == Scancode.ESCAPE { return false }
                if sc == Scancode.SPACE {
                    // 空格：t2 切换启动/暂停
                    if t2.running { t2.stop(); _msg = "t2 已暂停" }
                    else { t2.start(); _msg = "t2 已启动 (0.5s)" }
                }
                if sc == Scancode.R {
                    // R：reset t2 间隔为 500ms
                    t2.reset(500); t2.start()
                    _msg = "t2 间隔改为 500ms"
                }
                if sc == Scancode.S {
                    // S：stop t1
                    t1.stop(); _msg = "t1 已暂停"
                }
                if sc == Scancode.G {
                    // G：go/resume t1
                    t1.start(); _msg = "t1 已恢复"
                }
            }
            return true
        },
        func(Renderer r) {
            // 1. tick 所有定时器
            t1.tick()
            t2.tick()
            t3.tick()

            // 2. t2 的视觉反馈
            if _boom {
                _boom = false
                _flash = 1.0
            }
            _flash -= 0.02
            if _flash < 0.0 { _flash = 0.0 }

            // 3. 渲染
            r.clearColor(#141423FF)

            // 标题
            r.setColor(#FFDC64FF)
            r.drawText(font_l, "定时器测试 — 空格=切换t2  R=reset  S=停止t1  G=恢复t1", 10, 5, #FFC850FF)

            // ========== t1: 循环计数器 ==========
            r.setColor(#50C8FFFF)
            r.fillRoundedRect(30, 40, 250, 60, 10)
            r.setColor(#FFFFFFFF)
            r.drawText(font_l, "t1 计数: " + _count as string, 50, 55, #FFFFFFFF)
            r.drawText(font_s, "每秒 +1  (S=暂停 G=恢复)", 50, 78, #B4C8DCFF)

            // ========== t2: 手动控制 ==========
            if _flash > 0.0 {
                r.setColor(#FF5050C8)
                r.fillRoundedRect(30, 120, 250, 60, 10)
            } else {
                r.setColor(#323246FF)
                r.drawRoundedRect(30, 120, 250, 60, 10)
            }
            r.setColor(#FFFFFFFF)
            r.drawText(font, "t2: 空格切换  R=reset 500ms", 45, 140, #C8C8DCFF)

            // 状态指示
            if t2.running {
                r.setColor(#64FF64FF)
                r.fillRoundedRect(295, 128, 20, 20, 4)
            } else {
                r.setColor(#FF6464FF)
                r.fillRoundedRect(295, 128, 20, 20, 4)
            }

            // ========== t3: 一次性 ==========
            r.setColor(#3C3C5AFF)
            r.drawRoundedRect(30, 200, 540, 60, 10)
            r.setColor(#FFFFFFFF)
            if _done {
                r.drawText(font_l, "t3: 5 秒已到！一次性定时器触发", 45, 218, #64FF64FF)
            } else {
                r.drawText(font, "t3: 等待中... 5 秒后自动触发", 45, 218, #C8C8DCFF)
            }

            // ========== 提示消息 ==========
            if _msg != "" {
                r.setColor(#000000B4)
                r.fillRoundedRect(150, 300, 300, 40, 8)
                r.setColor(#FFC832FF)
                r.drawText(font, _msg, 170, 310, #FFC832FF)
            }

            // ========== 图例 ==========
            r.setColor(#9696B4C8)
            r.drawText(font_s, "t1状态:" + t1.running as string + "  t2状态:" + t2.running as string + "  t3状态:" + t3.running as string, 30, 365, #9696B4FF)
        }
    )
}