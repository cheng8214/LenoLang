// sdl_combobox.leno — 下拉框控件（点击展开列表选择，回调 on_change(int)）
import maths
import "sdl_renderer.leno" as ren; use ren.Renderer
import "sdl_font.leno" as fnt; use fnt.Font
import "sdl_event.leno" as evt; use evt.Event
import "sdl_core.leno" as core; use core.(SystemCursor, SDL_Rect, sdl3)
import "sdl_widget.leno" as wgt; use wgt.Widget
import "sdl_tooltip.leno" as tip
import "sdl_theme.leno" as theme; use theme.Theme
import "sdl_image.leno" as img
import "sdl_edit.leno" as edt; use edt.Edit

export struct ComboBox impl Widget {
    float x = 0.0, y = 0.0, w = 200.0, h = 30.0
    Array[string] items = []
    int _sel = -1              // 选中索引（-1 无）
    bool _open = false
    float _itemH = 24.0
    float _scroll = 0.0
    int _hover = -1
    float _popupMax = 200.0    // 弹出列表最大高度
    float _fontSize = 15.0; string _fontPath = ""; int _fontStyle = 0; Font? _font
    string _placeholder = "请选择"
    int br = 38, bg = 40, bb = 48
    int _bdrR = 90, _bdrG = 95, _bdrB = 110
    int _selR = 60, _selG = 150, _selB = 235
    int _hovR = 70, _hovG = 78, _hovB = 92
    int tr = 235, tg = 235, tb = 245
    int _sbR = 120, _sbG = 125, _sbB = 140
    int _cursor = SystemCursor.POINTER
    bool enabled = true, visible = true, _loaded = false
    string _tip = ""
    bool _draggingScroll = false
    float _sbDragOffset = 0.0
    func(int):void _onChange
    func(string):void _onEnter     // 可编辑模式：回车回调
    Ptr[u8]? _winHnd            // 所属窗口句柄：下拉层按窗口隔离绘制；面板/Tab 嵌套未拿到句柄则为 null
    // ===== 可编辑模式 =====
    bool _editable = false       // 是否可编辑（内嵌 Edit 控件）
    Edit? _edit                 // 内嵌编辑框（懒创建）

    // ==================== 每项图标支持（对齐 Table._rowImages / TreeView image） ====================
    Array[string] _itemImages = []    // 每项图标路径（与 items 平行，空串=无图标）
    float _imgSize = 16.0             // 图标边长
    float _imgGap  = 6.0              // 图标与文字间距
    // 纹理缓存（避免每帧重载 & 纹理泄漏）
    Array[string] _imgCachePaths = []
    Array[Ptr[u8]] _imgCacheTex   = []

    func _ensure_font() {
        if _font == null or not _font.ok {
            if _font != null and _font.ok { fnt.releaseFont(_font) }
            if _fontPath != "" { _font = fnt.acquireFont(_fontPath, _fontSize) }
            else { _font = fnt.acquireFontAuto(_fontSize) }
            if _font.ok and _fontStyle != 0 { _font.setStyle(_fontStyle) }
        }
    }

    func _ph(): float {
        float ph = items.len() * _itemH
        return if ph > _popupMax then _popupMax else ph
    }
    func _max_scroll(): float {
        float m = items.len() * _itemH - _ph()
        return if m < 0.0 then 0.0 else m
    }
    func _clamp_scroll() {
        float m = _max_scroll()
        if _scroll < 0.0 { _scroll = 0.0 }
        if _scroll > m { _scroll = m }
    }

    // ==================== 布局接口 ====================
    func get_w(): float          { return w }
    func get_h(): float          { return h }
    func set_pos(float px, float py) { x = px; y = py }
    func set_size(float sw, float sh) { w = sw; h = sh }

    func set(Dict opts) {
        Theme th = theme.getTheme()
        br = th.bgR; bg = th.bgG; bb = th.bgB
        _bdrR = th.borderR; _bdrG = th.borderG; _bdrB = th.borderB
        _selR = th.accentR; _selG = th.accentG; _selB = th.accentB
        _hovR = th.bgHoverR; _hovG = th.bgHoverG; _hovB = th.bgHoverB
        tr = th.txtR; tg = th.txtG; tb = th.txtB
        _sbR = th.sbR; _sbG = th.sbG; _sbB = th.sbB
        x         = opts.get("x", 0)
        y         = opts.get("y", 0)
        w         = opts.get("w", 200)
        h         = opts.get("h", 30)
        _itemH    = opts.get("item_h", 24)
        _popupMax = opts.get("popup_h", 200)
        _fontSize = opts.get("font_size", 15)
        _fontPath = opts.get("font_path", "")
        _fontStyle = opts.get("font_style", 0)
        _placeholder = opts.get("placeholder", "请选择")

        var its = opts.get("items", [])
        if its is Array[string] { items = its } else { items = [] }
        _sel = opts.get("selected", -1)
        if _sel >= items.len() { _sel = -1 }

        // 默认颜色见字段声明（br/bg/bb/_bdrR/_selR/_hovR/tr/_sbR 等均有默认，以下仅 opts 覆盖）

        // 颜色可被 dict 覆盖（[r,g,b]）
        var bgc = opts.get("bg_rgb")
        if bgc is Array[int] { br = bgc[0]; bg = bgc[1]; bb = bgc[2] }
        var bdc = opts.get("border_rgb")
        if bdc is Array[int] { _bdrR = bdc[0]; _bdrG = bdc[1]; _bdrB = bdc[2] }
        var slc = opts.get("sel_rgb")
        if slc is Array[int] { _selR = slc[0]; _selG = slc[1]; _selB = slc[2] }
        var hvc = opts.get("hover_rgb")
        if hvc is Array[int] { _hovR = hvc[0]; _hovG = hvc[1]; _hovB = hvc[2] }
        var ctc = opts.get("text_rgb")
        if ctc is Array[int] { tr = ctc[0]; tg = ctc[1]; tb = ctc[2] }
        var sbc = opts.get("scroll_rgb")
        if sbc is Array[int] { _sbR = sbc[0]; _sbG = sbc[1]; _sbB = sbc[2] }

        // 每项图标
        var iis = opts.get("item_images")
        if iis is Array[string] { _itemImages = iis } else { _itemImages = [] }
        _imgSize = opts.get("image_size", 16)
        _imgGap  = opts.get("image_gap", 6)

        _cursor = _int(opts.get("cursor", SystemCursor.POINTER))
        enabled = opts.get("enabled", true)
        visible = opts.get("visible", true)
        _tip = opts.get("tip", "")
        _open = false; _scroll = 0.0; _hover = -1   // 重置：收起弹层、滚动归零、悬停行清除
        _editable = opts.get("editable", false)
        if _editable and _edit == null {
            _edit = edt.createEdit({x:x+4, y:y+1, w:w-24, h:h-2, font_size:_fontSize, border:false, draw_bg:false, radius:0, placeholder:_placeholder, text_rgb:[tr,tg,tb]})
            _edit.on_enter(func() { if _onEnter != null { _onEnter(_edit.get_text()) } })
            // ★ 同步初始选中项文本到 Edit（selected 在 set 前面已解析）
            if _sel >= 0 and _sel < items.len() { _edit.set_text(items[_sel]) }
        }
        _ensure_font()
        _loaded = true
    }

    // ==================== 设置方法 ====================
    func set_items(Array[string] its) { items = its; if _sel >= items.len() { _sel = -1 }; _open = false; _scroll = 0.0; _itemImages = [] }
    func set_items_with_images(Array[string] its, Array[string] imgs) {
        items = its; _itemImages = imgs
        if _sel >= items.len() { _sel = -1 }; _open = false; _scroll = 0.0
    }
    func set_item_image(int idx, string path) {
        while _itemImages.len() <= idx { _itemImages.add("") }
        _itemImages[idx] = path
    }
    func get_item_image(int idx): string {
        if idx < 0 or idx >= _itemImages.len() { return "" }
        return _itemImages[idx]
    }
    func set_image_size(float s) { _imgSize = s }
    func set_image_gap(float g)  { _imgGap = g }
    func add_item(string s)           { items.add(s) }
    func clear()                      { items = []; _itemImages = []; _sel = -1; _open = false; _scroll = 0.0; _hover = -1 }
    func set_enabled(bool e)          { enabled = e }
    func set_visible(bool v)           { visible = v }
    func is_visible(): bool           { return visible }
    func set_font_size(float s)       { _fontSize = s; if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null }
    func get_x(): float               { return x }
    func get_y(): float               { return y }

    func get_selected(): int          { return _sel }
    func get_selected_text(): string  { return if _sel >= 0 and _sel < items.len() then items[_sel] else "" }
    func set_selected(int idx) {
        if idx < 0 or idx >= items.len() { return }
        _sel = idx
        if _editable and _edit != null and not _edit.is_focused() { _edit.set_text(items[_sel]) }
        if _onChange != null { _onChange(_sel) }
    }
    func close() { _open = false }
    func isOpen(): bool { return _open }
    // 记录所属窗口句柄，供下拉层按窗口隔离绘制（渲染循环据 hwnd 只画本窗口下拉框）
    func setWindowHandle(Ptr[u8] hwnd) { _winHnd = hwnd }
    func getWindowHandle(): Ptr[u8] { return _winHnd }

    // 纹理缓存：按 path 取/载纹理（对齐 Table._get_tex 模式）
    func _get_tex(Renderer r, string path): Ptr[u8] {
        for _imgCachePaths.len() to i {
            if _imgCachePaths[i] == path { return _imgCacheTex[i] }
        }
        Ptr[u8] t = img.loadTexture(r.handle, path)
        _imgCachePaths.add(path); _imgCacheTex.add(t)
        return t
    }
    func _free_img_cache() {
        sdl3 _lib = core.lib()
        for _imgCacheTex.len() to i {
            if _imgCacheTex[i] != null { _lib.SDL_DestroyTexture(_imgCacheTex[i]) }
        }
        _imgCachePaths = []; _imgCacheTex = []
    }

    func on_change(func(int):void cb) { _onChange = cb }
    func on_enter(func(string):void cb) { _onEnter = cb }
    func set_editable(bool e) { _editable = e }
    func is_editing(): bool { return _editable and _edit != null and _edit.is_focused() }
    func get_text(): string { if _editable and _edit != null { return _edit.get_text() }; return get_selected_text() }
    func set_text(string t) { if _editable and _edit != null { _edit.set_text(t) } }

    func contains(float mx, float my): bool {
        return mx >= x and mx <= x + w and my >= y and my <= y + h
    }
    func _popup_rect(): Array[float] {
        float ph = _ph()
        return [x, y + h, w, ph]
    }
    func _in_popup(float mx, float my): bool {
        var pr = _popup_rect()
        return mx >= pr[0] and mx <= pr[0] + pr[2] and my >= pr[1] and my <= pr[1] + pr[3]
    }
    func _index_at(float mx, float my): int {
        if not _in_popup(mx, my) { return -1 }
        var pr = _popup_rect()
        int idx = _int((my - pr[1] + _scroll) / _itemH)
        if idx < 0 or idx >= items.len() { return -1 }
        return idx
    }

    // 弹层竖向滚动条几何：返回 [sx, sw, ty0, ty1, thH, thy, maxs, px, py, ph]
    func _sb_geom_popup(): Array[float] {
        var pr = _popup_rect()
        float px = pr[0], py = pr[1], pw = pr[2], ph = pr[3]
        float maxs = _max_scroll()
        float sw = 8.0
        float sx = px + pw - sw - 2.0
        float ty0 = py + 2.0
        float ty1 = py + ph - 2.0
        float trk = ty1 - ty0
        float thH = maths.max(20.0, maths.min(ph * ph / (items.len() * _itemH), ph - 4.0))
        float thy = ty0 + (_scroll / maxs) * (trk - thH)
        return [sx, sw, ty0, ty1, thH, thy, maxs, px, py, ph]
    }
    func _in_vscroll_popup(float mx, float my): bool {
        if not _open or _max_scroll() <= 0.0 { return false }
        var g = _sb_geom_popup()
        return mx >= g[0] - 2.0 and mx <= g[0] + g[1] + 2.0 and my >= g[2] and my <= g[3]
    }
    func _in_thumb_popup(float mx, float my): bool {
        if not _open or _max_scroll() <= 0.0 { return false }
        var g = _sb_geom_popup()
        return mx >= g[0] - 2.0 and mx <= g[0] + g[1] + 2.0 and my >= g[5] and my <= g[5] + g[4]
    }

    // ==================== 交互 ====================
    func process(Event ev) {
        if not _loaded { return }
        if not enabled { _open = false; _hover = -1; _draggingScroll = false; return }

        float mx = ev.mouseX(); float my = ev.mouseY()
        if ev.isMouseWheel() { mx = ev.wheelMouseX(); my = ev.wheelMouseY() }

        // ★ 可编辑模式：Edit 聚焦时，键盘/文本事件路由给 Edit
        if _editable and _edit != null and _edit.is_focused() {
            _edit.set_pos(x + 4, y + 1); _edit.set_size(w - 24, h - 2)
            _edit.process(ev)
            // 点击箭头区域：展开/收起下拉
            if ev.isMouseButtonDown() and contains(mx, my) and mx >= x + w - 20.0 {
                if not _open { _open = true; _scroll = 0.0; if _sel >= 0 { float iy = _sel * _itemH; if iy + _itemH > _ph() { _scroll = iy + _itemH - _ph() }; _clamp_scroll() } }
                else { _open = false }
                _edit.blur()
            } eif ev.isMouseButtonDown() and not _edit.contains(mx, my) {
                _edit.blur()
            }
            return
        }

        // 弹层捕获：光标落在"他人的下拉弹层"范围内、且本框未展开时，忽略该事件
        if core.inPopupCapture(mx, my) and not _open { return }

        // 拖拽结束
        if ev.isMouseButtonUp() and _draggingScroll { _draggingScroll = false; return }

        // 弹层滚动条优先（仅展开时）
        if _open and ev.isMouseButtonDown() and _in_vscroll_popup(mx, my) {
            var g = _sb_geom_popup()
            float maxs = g[6], trk = g[3] - g[2], thH = g[4]
            if _in_thumb_popup(mx, my) {
                _draggingScroll = true
                _sbDragOffset = my - g[5]                  // 记录起点相对滑块顶偏移，避免跳动
            } else {
                _draggingScroll = true
                _sbDragOffset = thH / 2.0
                float rel = my - g[2] - thH / 2.0
                if trk - thH > 0.0 { _scroll = rel * maxs / (trk - thH) }
                _clamp_scroll()
            }
            return
        }

        // 拖拽中：跟随鼠标移动滑块（即使移出弹层也继续）
        if _draggingScroll {
            if ev.isMouseMotion() {
                var g = _sb_geom_popup()
                float maxs = g[6], trk = g[3] - g[2], thH = g[4]
                float rel = my - g[2] - _sbDragOffset
                if trk - thH > 0.0 { _scroll = rel * maxs / (trk - thH) }
                _clamp_scroll()
                core.markFrameRedraw()
            }
            return
        }

        if ev.isMouseWheel() and _open {
            // 滚轮只作用于光标所在的弹层，避免同一事件被其它控件共享
            if not _in_popup(ev.wheelMouseX(), ev.wheelMouseY()) { return }
            float d = ev.wheelY() * _itemH
            _scroll = _scroll - d
            _clamp_scroll()
        }

        if ev.isMouseMotion() {
            int prevHover = _hover
            if _open { _hover = _index_at(mx, my) } else { _hover = -1 }
            bool hv = _open and _hover >= 0
            if not hv { hv = contains(mx, my) }
            if _hover != prevHover { core.markFrameRedraw() } else { core.markFrameMotion() }
            if hv and _cursor >= 0 { core.requestCursor(_cursor) }
            if hv and _tip != "" { tip.tipReport(_tip, mx, my) }
            // 未命中不再强制设 DEFAULT，由 Window 帧末统一决定（避免覆盖上方弹层的手型）
        }

        if ev.isMouseButtonDown() {
            if not _open {
                if contains(mx, my) {
                    // ★ 可编辑模式：点击文本区域聚焦 Edit（不展开弹层）
                    if _editable and _edit != null and mx < x + w - 20.0 {
                        _edit.set_pos(x + 4, y + 1); _edit.set_size(w - 24, h - 2)
                        _edit.focus(); return
                    }
                    _open = true
                    _scroll = 0.0
                    if _sel >= 0 {
                        float iy = _sel * _itemH
                        if iy + _itemH > _ph() { _scroll = iy + _itemH - _ph() }
                        _clamp_scroll()
                    }
                }
            } else {
                int idx = _index_at(mx, my)
                if idx >= 0 {
                    _sel = idx
                    _open = false
                    if _onChange != null { _onChange(_sel) }
                } else if not contains(mx, my) {
                    _open = false   // 点击弹出区域外关闭
                } else {
                    _open = false   // 点击标题栏收起
                }
            }
        }
    }

    // ==================== 渲染 ====================
    func render(Renderer r) {
        if not _loaded { return }
        if not visible { return }
        _ensure_font()

        int bgr = br, bgg = bg, bgb = bb
        if not enabled { bgr = br / 2; bgg = bg / 2; bgb = bb / 2 }
        r.setColor(bgr, bgg, bgb, 255)
        r.fillRoundedRect(x, y, w, h, 6.0)

        // 当前文字 + 图标
        float textX = x + 8.0
        // ★ 可编辑模式：渲染 Edit 代替静态文字
        if _editable and _edit != null {
            _edit.set_pos(x + 4, y + 1); _edit.set_size(w - 24, h - 2)
            _edit.render(r)
            // 下拉箭头
            float aw = 10.0, ax = x + w - aw - 8.0, ay = y + h / 2.0
            r.setColor(_bdrR + 60, _bdrG + 60, _bdrB + 60, 255)
            r.drawTriangle(ax + aw / 2.0, ay, aw / 2.0, 180.0, _bdrR + 60, _bdrG + 60, _bdrB + 60, 255)
            // 边框
            r.setColor(_bdrR, _bdrG, _bdrB, 220)
            r.drawRoundedRect(x, y, w, h, 6.0)
            return
        }
        if _font.ok {
            // 选中项图标
            if _sel >= 0 and _sel < _itemImages.len() and _itemImages[_sel] != "" {
                Ptr[u8] tex = _get_tex(r, _itemImages[_sel])
                if tex != null {
                    float isz = _imgSize
                    if isz > h - 8.0 { isz = h - 8.0 }
                    float iy = y + (h - isz) / 2.0
                    r.setTextureAlpha(tex, 255); r.setTextureColor(tex, 255, 255, 255)
                    var nats = r.getTextureSize(tex)
                    float nw = nats["w"], nh = nats["h"]
                    if nw > 0.0 and nh > 0.0 {
                        float s = isz / nw; if isz / nh < s { s = isz / nh }
                        float dw = nw * s, dh = nh * s
                        r.drawTextureAt(tex, textX + (isz - dw) / 2.0, iy + (isz - dh) / 2.0, dw, dh)
                    }
                    textX = textX + isz + _imgGap
                }
            }
            string t = ""
            if _sel >= 0 and _sel < items.len() { t = items[_sel] } else { t = _placeholder }
            float th = _font.measureString("Ag").h
            int tcR = tr, tcG = tg, tcB = tb
            if not enabled { tcR = tr / 2; tcG = tg / 2; tcB = tb / 2 }
            float ty = r.snapY(y + (h - th) / 2.0)
            r.drawText(_font, t, r.snapX(textX), ty, tcR, tcG, tcB)
        }

        // 下拉箭头（向下填充三角）
        float aw = 10.0, ax = x + w - aw - 8.0, ay = y + h / 2.0
        r.setColor(_bdrR + 60, _bdrG + 60, _bdrB + 60, 255)
        r.drawTriangle(ax + aw / 2.0, ay, aw / 2.0, 180.0, _bdrR + 60, _bdrG + 60, _bdrB + 60, 255)

        // 边框
        r.setColor(_bdrR, _bdrG, _bdrB, 220)
        r.drawRoundedRect(x, y, w, h, 6.0)
    }

    // 弹出列表（独立 overlay 通道：由 Window 在所有控件渲染完后第二遍调用，
    // 保证下拉层永远盖在其它控件之上，不会被列表中靠后的 ComboBox 挡住）
    func renderPopup(Renderer r) {
        if not _loaded or not visible or not _open or items.len() == 0 { return }
        int bgr = br, bgg = bg, bgb = bb
        if not enabled { bgr = br / 2; bgg = bg / 2; bgb = bb / 2 }
        var pr = _popup_rect()
        float px = pr[0], py = pr[1], pw = pr[2], ph = pr[3]

        // 把弹出矩形登记为事件捕获区，使下层控件忽略落在弹层范围内的鼠标/滚轮事件
        core.setPopupCapture(px, py, pw, ph)

        r.setColor(bgr, bgg, bgb, 255)
        r.fillRoundedRect(px, py, pw, ph, 6.0)

        SDL_Rect clip = SDL_Rect.malloc()
        clip.x = _int(px); clip.y = _int(py)
        clip.w = _int(pw) + 1; clip.h = _int(ph) + 1   // +1 覆盖浮点截断的亚像素
        r.pushClipRect(clip.to_ptr())

        float radius = 6.0
        for items.len() to i {
            float iy = r.snapY(py - _scroll + i * _itemH)
            if iy + _itemH < py or iy > py + ph { continue }
            int rr = bgr, gg = bgg, bb2 = bgb
            if i == _sel { rr = _selR; gg = _selG; bb2 = _selB }
            else if i == _hover { rr = _hovR; gg = _hovG; bb2 = _hovB }
            r.setColor(rr, gg, bb2, 255)
            // 首行/末行需用圆角矩形 + 填补缺口，否则高亮背景会溢出弹层的圆角边界
            bool atTop = (iy <= py + 0.5)
            bool atBottom = (iy + _itemH >= py + ph - 0.5)
            if atTop and atBottom {
                r.fillRoundedRect(px, iy, pw, _itemH, radius)
            } else if atTop {
                r.fillRoundedRect(px, iy, pw, _itemH, radius)
                r.fillRect(px, iy + _itemH - radius, radius, radius)
                r.fillRect(px + pw - radius, iy + _itemH - radius, radius, radius)
            } else if atBottom {
                r.fillRoundedRect(px, iy, pw, _itemH, radius)
                r.fillRect(px, iy, radius, radius)
                r.fillRect(px + pw - radius, iy, radius, radius)
            } else {
                r.fillRect(px, iy, pw, _itemH)
            }

            if _font.ok {
                float th = _font.measureString("Ag").h
                int tcR = tr, tcG = tg, tcB = tb
                float ty = r.snapY(iy + (_itemH - th) / 2.0)
                float tx = r.snapX(px + 8.0)
                // 每项图标
                if i < _itemImages.len() and _itemImages[i] != "" {
                    Ptr[u8] tex = _get_tex(r, _itemImages[i])
                    if tex != null {
                        float isz = _imgSize
                        if isz > _itemH - 4.0 { isz = _itemH - 4.0 }
                        float iy2 = iy + (_itemH - isz) / 2.0
                        r.setTextureAlpha(tex, 255); r.setTextureColor(tex, 255, 255, 255)
                        var nats = r.getTextureSize(tex)
                        float nw = nats["w"], nh = nats["h"]
                        if nw > 0.0 and nh > 0.0 {
                            float s = isz / nw; if isz / nh < s { s = isz / nh }
                            float dw = nw * s, dh = nh * s
                            r.drawTextureAt(tex, tx + (isz - dw) / 2.0, iy2 + (isz - dh) / 2.0, dw, dh)
                        }
                        tx = tx + isz + _imgGap
                    }
                }
                r.drawText(_font, items[i], tx, ty, tcR, tcG, tcB)
            }
        }
        r.popClipRect()
        clip.free()

        r.setColor(_bdrR, _bdrG, _bdrB, 220)
        r.drawRoundedRect(px, py, pw, ph, 6.0)

        // 弹出滚动条
        float maxs = _max_scroll()
        if maxs > 0.0 {
            float sw = 8.0, sx = px + pw - sw - 2.0
            r.setColor(_sbR, _sbG, _sbB, 180)
            r.fillRoundedRect(sx, py + 2.0, sw, ph - 4.0, sw / 2.0)
            float ratio = _scroll / maxs
            float thH = maths.max(20.0, maths.min(ph * ph / (items.len() * _itemH), ph - 4.0))
            float thy = py + 2.0 + ratio * (ph - 4.0 - thH)
            r.setColor(_sbR + 60, _sbG + 60, _sbB + 60, 255)
            r.fillRoundedRect(sx, thy, sw, thH, sw / 2.0)
        }
    }

    func dispose() {
        if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null
        _edit?.dispose()
        _free_img_cache()         // 释放图标纹理缓存
        _unregisterComboBox(self)   // 从下拉框登记表摘除自身，避免窗口销毁后悬空引用累积
    }
}

// ==================== 下拉框登记（兜底第二遍绘制） ====================
// 经 panel.add / 布局容器 / Tab 页添加的 ComboBox 不会进入窗口首遍绘制顺序，
// 其展开的下拉层无法兜底到最上层（会被同级控件遮挡）。这里统一登记（createComboBox 工厂登记），
// 由窗口第二遍按窗口隔离绘制；面板/Tab 嵌套等拿不到句柄的控件 _winHnd 为 null，兜底画到任意窗口。
// 区别于旧「全局数组永不摘除」反模式：本数组在 ComboBox.dispose() 时摘除自身，
// 窗口销毁（递归 dispose 所有控件）后不残留，无悬空引用累积、无跨窗口数组无限增长。
Array[ComboBox] _comboPopupRegistry = []
export func registerComboBox(ComboBox c) {
    for _comboPopupRegistry.len() to k { if _comboPopupRegistry[k] == c { return } }  // 去重
    _comboPopupRegistry.add(c)
}
// 第二遍：仅绘制归属本窗口（hwnd）的下拉层；未登记句柄（嵌套控件）兜底画到任意窗口
export func renderComboBoxes(Renderer r, Ptr[u8] hwnd) {
    for _comboPopupRegistry.len() to i {
        var cb = _comboPopupRegistry[i]
        if cb.isOpen() {
            if cb.getWindowHandle() == null or cb.getWindowHandle() == hwnd {
                cb.renderPopup(r)
            }
        }
    }
}
// 摘除某个下拉框（在 ComboBox.dispose 时调用；置于文件末尾以便引用 _comboPopupRegistry）
func _unregisterComboBox(ComboBox c) {
    for _comboPopupRegistry.len() to k { if _comboPopupRegistry[k] == c { _comboPopupRegistry.remove(k); break } }
}

// 工厂
export func createComboBox(Dict opts): ComboBox {
    ComboBox cb = new ComboBox(); cb.set(opts)
    registerComboBox(cb)   // 登记到全局注册表，确保经 panel/tab/布局添加时下拉层也能画到最上层
    return cb
}
