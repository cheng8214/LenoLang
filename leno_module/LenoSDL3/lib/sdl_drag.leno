// sdl_drag.leno — 拖拽提示框组件
// 拖拽文件/项目时在鼠标附近显示的浮动提示框（半透明圆角背景 + 文字）。
// 用法：
//   DragHint dh = SDL3.createDragHint({})
//   win.setOverlay(func(Renderer r) { dh.render(r) })
//   dh.show("file.txt (+2)", mouseX, mouseY)  // 显示/更新
//   dh.hide()                                   // 隐藏
//   dh.dispose()                                // 释放资源
import "sdl_renderer.leno" as ren; use ren.Renderer
import "sdl_font.leno" as fnt; use fnt.Font
import "sdl_core.leno" as core
import "sdl_theme.leno" as theme
use theme.Color

export struct DragHint {
    // ── 样式配置 ──
    Font? _font = null           // 字体缓存（懒加载）
    float _fontSize = 13.0       // 字体大小
    float _padX = 10.0           // 内边距 X
    float _padY = 5.0            // 内边距 Y
    float _radius = 4.0          // 圆角半径
    float _offsetX = 14.0        // 相对鼠标的 X 偏移
    float _offsetY = 14.0        // 相对鼠标的 Y 偏移
    // 背景色（半透明）
    Color _bgColor = #1E3C78DC
    // 边框色
    Color _brColor = #508CDCFF
    // 文字色
    Color _txColor = #FFFFFFFF

    // ── 运行时状态 ──
    string _text = ""            // 显示文本
    float _x = 0.0, _y = 0.0    // 鼠标位置
    bool _visible = false        // 是否可见

    // 初始化（通过 Dict 配置样式）
    func set(Dict opts) {
        _fontSize = opts.get("font_size", 13.0)
        _padX = opts.get("pad_x", 10.0)
        _padY = opts.get("pad_y", 5.0)
        _radius = opts.get("radius", 4.0)
        _offsetX = opts.get("offset_x", 14.0)
        _offsetY = opts.get("offset_y", 14.0)
        if opts.get("bg_color") is Color => t { _bgColor = t }
        if opts.get("border_color") is Color => t { _brColor = t }
        var bga = opts.get("bg_a")
        if bga is int { _bgColor = theme.withAlpha(_bgColor, bga) }
        var bra = opts.get("border_a")
        if bra is int { _brColor = theme.withAlpha(_brColor, bra) }
        if opts.get("text_color") is Color => t { _txColor = t }
    }

    // 确保字体已加载
    func _ensureFont() {
        if _font != null and _font.ok { return }
        _font = fnt.acquireFontAuto(_fontSize)
    }

    // 显示拖拽提示（设置文本 + 位置 + 可见）
    func show(string text, float x, float y) {
        _text = text
        _x = x; _y = y
        _visible = true
        core.markFrameRedraw()
    }

    // 仅更新位置（不改变文本）
    func updatePos(float x, float y) {
        _x = x; _y = y
        if _visible { core.markFrameRedraw() }
    }

    // 隐藏
    func hide() {
        _visible = false
        _text = ""
    }

    // 渲染（作为 overlay 回调使用）
    func render(Renderer r) {
        if not _visible or _text == "" { return }
        _ensureFont()
        if _font == null or not _font.ok { return }
        StringSize sz = _font.measureString(_text)
        float boxW = sz.w + _padX * 2.0
        float boxH = sz.h + _padY * 2.0
        float bx = _x + _offsetX
        float by = _y + _offsetY
        // 半透明圆角背景
        r.setColor(_bgColor)
        r.fillRoundedRect(bx, by, boxW, boxH, _radius)
        // 圆角边框
        r.setColor(_brColor)
        r.drawRoundedRect(bx, by, boxW, boxH, _radius)
        // 文字
        r.drawText(_font, _text, bx + _padX, by + _padY, _txColor)
    }

    // 释放字体资源
    func dispose() {
        if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null
    }
}

// 工厂
export func createDragHint(Dict opts): DragHint {
    DragHint dh = new DragHint()
    dh.set(opts)
    return dh
}
