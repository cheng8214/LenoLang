// sdl_theme.leno — 全局主题系统（支持运行时切换）
//
// 设计：
//   1. 全局单例 _theme，控件在 set() 时读取默认配色
//   2. Themeable face — 控件实现 applyTheme(Theme) 即可支持运行时切换
//   3. Window.applyThemeAll(Theme) 遍历所有控件，调用 applyTheme 刷新颜色
//
// 用法：
//   // 创建前设置主题（传统方式）
//   SDL3.setTheme(SDL3.lightTheme())
//   win.addButton({text:"OK"})
//
//   // 运行时切换主题（无需关闭窗口！）
//   win.applyThemeAll(SDL3.lightTheme())
//
// 优先级：opts 显式覆盖 > 主题默认 > 结构体硬编码
// 注意：applyTheme 会用新主题覆盖所有主题派生颜色（包括 set() 时通过 opts 设置的）
import "sdl_widget.leno" as wgt; use wgt.Widget

// ==================== Theme 结构体 ====================
export struct Theme {
    string name = "dark"

    // === 背景层次（从深到浅） ===
    int bgR = 38, bgG = 40, bgB = 48              // 控件主背景
    int bgAltR = 44, bgAltG = 46, bgAltB = 54     // 次级背景（面板/斑马纹/非激活标签）
    int bgInputR = 35, bgInputG = 35, bgInputB = 50  // 输入框背景（略深于主背景）
    int bgHoverR = 70, bgHoverG = 78, bgHoverB = 92   // 悬停行背景
    int bgSelR = 52, bgSelG = 58, bgSelB = 70        // 选中行背景（比 hover 更深，非蓝色）
    int bgZebraR = 44, bgZebraG = 46, bgZebraB = 54  // 斑马纹行（与 bgAlt 相同）
    int bgHeaderR = 46, bgHeaderG = 48, bgHeaderB = 56  // 表头/标签栏背景

    // === 文字 ===
    int txtR = 235, txtG = 235, txtB = 245        // 主文字色
    int txtInputR = 220, txtInputG = 220, txtInputB = 240  // 输入框文字
    int txtOnAccentR = 255, txtOnAccentG = 255, txtOnAccentB = 255  // 强调色上的白字
    int txtDimR = 120, txtDimG = 128, txtDimB = 140  // 暗淡/空状态文字
    int txtHeaderR = 220, txtHeaderG = 225, txtHeaderB = 235  // 表头文字

    // === 强调/交互色 ===
    int accentR = 60, accentG = 150, accentB = 235    // 选中/开关/强调主色
    int accentFocusR = 100, accentFocusG = 180, accentFocusB = 255  // 聚焦边框（比 accent 更亮）
    int accentBrightR = 80, accentBrightG = 160, accentBrightB = 245  // 更亮的强调色（tab 下划线等）

    // === 边框/分隔 ===
    int borderR = 90, borderG = 95, borderB = 110     // 普通边框
    int sepR = 70, sepG = 74, sepB = 84              // 分隔线/连接线

    // === 滚动条 ===
    int sbR = 120, sbG = 125, sbB = 140              // 滚动条颜色

    // === 预设按钮色 ===
    int btnPrimaryR = 60, btnPrimaryG = 140, btnPrimaryB = 220
    int btnDangerR = 220, btnDangerG = 60, btnDangerB = 60
    int btnSuccessR = 60, btnSuccessG = 200, btnSuccessB = 80
    int btnWarningR = 240, btnWarningG = 160, btnWarningB = 30
    int btnDarkR = 60, btnDarkG = 60, btnDarkB = 70

    // === Tooltip ===
    int tipBgR = 38, tipBgG = 40, tipBgB = 48
    int tipTxtR = 232, tipTxtG = 234, tipTxtB = 242
    int tipBrdR = 110, tipBrdG = 115, tipBrdB = 132

    // === 字体 ===
    float fontSize = 15.0
}

// ==================== Themeable 接口 ====================
// 控件实现此接口即可支持运行时主题切换。
// Window.applyThemeAll() 会遍历所有控件，对实现 Themeable 的调用 applyTheme。
export face Themeable {
    func applyTheme(Theme t)
}

// ==================== 全局单例 ====================
Theme _theme = new Theme()

export func getTheme(): Theme { return _theme }
export func setTheme(Theme t) { _theme = t }

// ==================== 预设主题 ====================

// 深色主题（默认值已匹配，返回全新实例以便用户进一步微调）
export func darkTheme(): Theme {
    Theme t = new Theme()
    t.name = "dark"
    return t
}

// 浅色主题
export func lightTheme(): Theme {
    Theme t = new Theme()
    t.name = "light"
    // 背景层次（从浅到略深）
    t.bgR = 240; t.bgG = 240; t.bgB = 245
    t.bgAltR = 232; t.bgAltG = 232; t.bgAltB = 238
    t.bgInputR = 255; t.bgInputG = 255; t.bgInputB = 255
    t.bgHoverR = 206; t.bgHoverG = 214; t.bgHoverB = 224
    t.bgSelR = 170; t.bgSelG = 178; t.bgSelB = 190
    t.bgZebraR = 236; t.bgZebraG = 236; t.bgZebraB = 242
    t.bgHeaderR = 226; t.bgHeaderG = 228; t.bgHeaderB = 234
    // 文字
    t.txtR = 30; t.txtG = 30; t.txtB = 40
    t.txtInputR = 25; t.txtInputG = 25; t.txtInputB = 35
    t.txtOnAccentR = 255; t.txtOnAccentG = 255; t.txtOnAccentB = 255
    t.txtDimR = 140; t.txtDimG = 145; t.txtDimB = 155
    t.txtHeaderR = 40; t.txtHeaderG = 45; t.txtHeaderB = 55
    // 强调/交互
    t.accentR = 60; t.accentG = 130; t.accentB = 220
    t.accentFocusR = 80; t.accentFocusG = 150; t.accentFocusB = 230
    t.accentBrightR = 60; t.accentBrightG = 130; t.accentBrightB = 220
    // 边框/分隔
    t.borderR = 200; t.borderG = 205; t.borderB = 212
    t.sepR = 210; t.sepG = 214; t.sepB = 220
    // 滚动条
    t.sbR = 160; t.sbG = 165; t.sbB = 175
    // 预设按钮色
    t.btnPrimaryR = 50; t.btnPrimaryG = 120; t.btnPrimaryB = 210
    t.btnDangerR = 210; t.btnDangerG = 50; t.btnDangerB = 50
    t.btnSuccessR = 50; t.btnSuccessG = 180; t.btnSuccessB = 70
    t.btnWarningR = 230; t.btnWarningG = 150; t.btnWarningB = 20
    t.btnDarkR = 70; t.btnDarkG = 70; t.btnDarkB = 80
    // Tooltip
    t.tipBgR = 250; t.tipBgG = 250; t.tipBgB = 255
    t.tipTxtR = 30; t.tipTxtG = 30; t.tipTxtB = 40
    t.tipBrdR = 180; t.tipBrdG = 185; t.tipBrdB = 195
    return t
}

// 午夜蓝主题（深色变体，偏蓝）
export func midnightTheme(): Theme {
    Theme t = new Theme()
    t.name = "midnight"
    // 背景层次（深蓝调）
    t.bgR = 22; t.bgG = 28; t.bgB = 44
    t.bgAltR = 28; t.bgAltG = 34; t.bgAltB = 52
    t.bgInputR = 18; t.bgInputG = 24; t.bgInputB = 40
    t.bgHoverR = 40; t.bgHoverG = 52; t.bgHoverB = 80
    t.bgSelR = 30; t.bgSelG = 40; t.bgSelB = 64
    t.bgZebraR = 28; t.bgZebraG = 34; t.bgZebraB = 52
    t.bgHeaderR = 30; t.bgHeaderG = 38; t.bgHeaderB = 58
    // 文字
    t.txtR = 200; t.txtG = 215; t.txtB = 240
    t.txtInputR = 190; t.txtInputG = 205; t.txtInputB = 235
    t.txtOnAccentR = 255; t.txtOnAccentG = 255; t.txtOnAccentB = 255
    t.txtDimR = 100; t.txtDimG = 115; t.txtDimB = 145
    t.txtHeaderR = 190; t.txtHeaderG = 205; t.txtHeaderB = 230
    // 强调/交互（偏青蓝）
    t.accentR = 50; t.accentG = 170; t.accentB = 220
    t.accentFocusR = 80; t.accentFocusG = 200; t.accentFocusB = 255
    t.accentBrightR = 70; t.accentBrightG = 180; t.accentBrightB = 240
    // 边框/分隔
    t.borderR = 60; t.borderG = 75; t.borderB = 110
    t.sepR = 45; t.sepG = 55; t.sepB = 85
    // 滚动条
    t.sbR = 80; t.sbG = 100; t.sbB = 140
    // 预设按钮色
    t.btnPrimaryR = 45; t.btnPrimaryG = 150; t.btnPrimaryB = 210
    t.btnDangerR = 210; t.btnDangerG = 55; t.btnDangerB = 55
    t.btnSuccessR = 50; t.btnSuccessG = 185; t.btnSuccessB = 100
    t.btnWarningR = 235; t.btnWarningG = 155; t.btnWarningB = 25
    t.btnDarkR = 40; t.btnDarkG = 50; t.btnDarkB = 70
    // Tooltip
    t.tipBgR = 22; t.tipBgG = 28; t.tipBgB = 44
    t.tipTxtR = 200; t.tipTxtG = 215; t.tipTxtB = 240
    t.tipBrdR = 70; t.tipBrdG = 85; t.tipBrdB = 120
    return t
}
