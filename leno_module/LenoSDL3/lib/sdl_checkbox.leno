// sdl_checkbox.leno — 复选框控件
// 通过 win.addCheckBox({...}) 创建，点击切换选中态，回调 on_change(bool)
import "sdl_renderer.leno" as ren; use ren.Renderer
import "sdl_font.leno" as fnt; use fnt.Font
import "sdl_event.leno" as evt; use evt.Event
import "sdl_core.leno" as core; use core.SystemCursor
import "sdl_widget.leno" as wgt; use wgt.Widget

export struct CheckBox impl Widget {
    string text
    float x; float y
    float _box              // 勾选框边长
    float _gap              // 框与文字间距
    float _fontSize
    string _fontPath
    int _fontStyle
    Font  _font
    bool _checked
    int cr, cg, cb          // 未选中框背景
    int cc, ck, cbl         // 选中框背景
    int tr, tg, tb          // 文字色
    int _brdR, _brdG, _brdB // 框边框色
    int _cursor
    bool hover
    bool _wasHover
    bool _pressed
    bool enabled
    bool _loaded
    func(bool):void _onChange

    func _ensure_font() {
        if _font == null or not _font.ok {
            if _font != null { _font.close() }
            if _fontPath != "" { _font = fnt.createFont(_fontPath, _fontSize) }
            else { _font = fnt.createFontAuto(_fontSize) }
            if _font.ok and _fontStyle != 0 { _font.setStyle(_fontStyle) }
        }
    }

    // ==================== set 初始化 ====================
    func set(Dict opts) {
        text      = opts.get("text", "") as string
        x         = _float(opts.get("x", 0))
        y         = _float(opts.get("y", 0))
        _box      = _float(opts.get("box", 22))
        _gap      = _float(opts.get("gap", 8))
        _fontSize = _float(opts.get("font_size", 16))
        _fontPath = opts.get("font_path", "") as string
        _fontStyle = _int(opts.get("font_style", 0))

        cr = 60;  cg = 60;  cb = 72     // 未选框背景
        cc = 60;  ck = 170; cbl = 245   // 选中框背景
        tr = 235; tg = 235; tb = 245    // 文字色
        _brdR = 130; _brdG = 130; _brdB = 150

        _cursor = _int(opts.get("cursor", SystemCursor.DEFAULT))
        _checked = _bool(opts.get("checked", false))
        enabled = _bool(opts.get("enabled", true))
        hover = false; _wasHover = false; _pressed = false
        _ensure_font()
        _loaded = true
    }

    // ==================== 设置方法 ====================
    func set_text(string t)     { text = t }
    func set_checked(bool c)     { _checked = c }
    func is_checked(): bool     { return _checked }
    func set_enabled(bool e)     { enabled = e }
    func set_font_size(float s)  { _fontSize = s; if _font != null { _font.close(); _font = null } }
    func get_x(): float          { return x }
    func get_y(): float          { return y }

    func on_change(func(bool):void cb) { _onChange = cb }

    func contains(float mx, float my): bool {
        float tw = 0.0
        if _font != null and _font.ok and text != "" { tw = _float(_font.measureString(text).w) }
        float totalW = _box + _gap + tw
        return mx >= x and mx <= x + totalW and my >= y and my <= y + _box
    }

    // ==================== 交互 ====================
    func process(Event ev) {
        if not _loaded { return }
        if not enabled { hover = false; _pressed = false; return }

        if ev.isMouseMotion() {
            _wasHover = hover
            hover = contains(ev.mouseX(), ev.mouseY())
            if _cursor >= 0 {
                if hover and not _wasHover { core.setSystemCursor(_cursor) }
                if not hover and _wasHover { core.setSystemCursor(SystemCursor.DEFAULT) }
            }
        }

        if ev.isMouseButtonUp() { _pressed = false }

        if ev.isMouseButtonDown() and hover and not _pressed {
            _pressed = true
            _checked = not _checked
            if _onChange != null { _onChange(_checked) }
        }
    }

    // ==================== 渲染 ====================
    func render(Renderer r) {
        if not _loaded { return }
        _ensure_font()
        float bx = x; float by = y; float bs = _box

        // 框背景
        int br = cr; int bg = cg; int bb = cb
        if _checked { br = cc; bg = ck; bb = cbl }
        if hover { br = br + 25; bg = bg + 25; bb = bb + 25
                   if br > 255 { br = 255 }; if bg > 255 { bg = 255 }; if bb > 255 { bb = 255 } }
        if not enabled { br = cr / 2; bg = cg / 2; bb = cb / 2 }

        r.setColor(br, bg, bb, 255)
        r.fillRoundedRect(bx, by, bs, bs, 5.0)

        // 边框
        r.setColor(_brdR, _brdG, _brdB, 220)
        r.drawRoundedRect(bx, by, bs, bs, 5.0)

        // 勾
        if _checked {
            r.setColor(255, 255, 255, 255)
            float p = bs * 0.26
            r.drawLine(bx + p,                by + bs * 0.52, bx + bs * 0.42, by + bs * 0.72)
            r.drawLine(bx + bs * 0.42,        by + bs * 0.72, bx + bs - p,     by + bs * 0.30)
        }

        // 文字
        if _font != null and _font.ok and text != "" {
            float cy = by + (bs - _float(_font.measureString("Ag").h)) / 2.0
            int tcR = tr; int tcG = tg; int tcB = tb
            if not enabled { tcR = tr / 2; tcG = tg / 2; tcB = tb / 2 }
            r.drawText(_font, text, bx + bs + _gap, cy, tcR, tcG, tcB)
        }
    }

    func dispose() {
        if _font != null { _font.close(); _font = null }
    }
}

// 工厂
export func createCheckBox(Dict opts): CheckBox {
    CheckBox cb = new CheckBox(); cb.set(opts); return cb
}
