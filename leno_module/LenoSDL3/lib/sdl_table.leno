// sdl_table.leno — 表格控件（多列多行，可选表头/排序/选择/双向滚动）
// 通过 win.addTable({...}) 创建；数据用 set_rows / add_row 设置。
import maths
import "sdl_renderer.leno" as ren; use ren.Renderer
import "sdl_font.leno" as fnt; use fnt.Font
import "sdl_event.leno" as evt; use evt.Event
import "sdl_core.leno" as core; use core.SystemCursor; use core.SDL_Rect
import "sdl_widget.leno" as wgt; use wgt.Widget
import "sdl_edit.leno" as edt; use edt.Edit
import "sdl_tooltip.leno" as tip
import "sdl_menu.leno" as menu; use menu.MenuBar
import "sdl_image.leno" as img
import "sdl_theme.leno" as theme; use theme.Theme

export struct Table impl Widget {
    float x = 0.0, y = 0.0, w = 360.0, h = 240.0
    Array[string] _headers = []
    Array[float] _colW = []
    Array[int] _aligns = []           // 每列对齐：0 左, 1 中, 2 右
    Array[int] _headerAligns = []     // 表头文字对齐（可独立于数据列），0 左, 1 中, 2 右
    Array[Array[string]] _rows = []
    int _ncols = 1
    bool _autoCols = true            // 列宽是否按宽度等分（用户未指定 col_widths）
    float _headerH = 28.0, _rowH = 24.0
    float _scrollX = 0.0, _scrollY = 0.0
    int _selRow = -1, _selCol = -1, _hoverRow = -1; bool _multi = false; Array[int] _selRows = []
    bool _sortable = false; int _sortCol = -1; bool _sortDesc = false, _zebra = true

    float _fontSize = 15.0; string _fontPath = ""; int _fontStyle = 0; Font? _font
    float _textH = 16.0         // 缓存字体行高，避免每个单元格重复 measureString
    int br = 38, bg = 40, bb = 48
    int _hdrR = 46, _hdrG = 48, _hdrB = 56, _hdrTxtR = 220, _hdrTxtG = 225, _hdrTxtB = 235
    int _selR = 60, _selG = 150, _selB = 235
    int _hovR = 70, _hovG = 78, _hovB = 92
    int _zebR = 44, _zebG = 46, _zebB = 54
    int tr = 232, tg = 235, tb = 245, _sepR = 70, _sepG = 74, _sepB = 84, _sbR = 120, _sbG = 125, _sbB = 140
    int _cursor = SystemCursor.POINTER
    bool enabled = true, visible = true, _loaded = false
    string _tip = ""
    Ptr[u8]? _clipBase            // 表格整体裁剪区指针（供单元格内裁剪后恢复）
    Array[float] _colWPrefix = []    // 列宽前缀和缓存：_colWPrefix[i] = sum(_colW[0..i-1])，让 _col_x O(1)
    bool _colWPrefixValid = false
    float _cachedTotalW = -1.0       // _total_w() 缓存，避免 process/render 中多次遍历 _colW
    bool _totalWValid = false
    int _hoverColForTip = -1         // 缓存：上次做 tooltip 截断检查的列索引
    string _hoverTipText = ""        // 缓存：当前悬停单元格的 tooltip 文本（空串=无需 tooltip）
    bool _draggingV = false, _draggingH = false; float _vDragOffset = 0.0, _hDragOffset = 0.0
    int _dragCol = -1; float _dragStartX = 0.0, _dragStartW = 0.0; bool _resizable = true
    func(int):void _onSelect
    func(int, int):void _onCell
    // 内嵌右击上下文菜单（复用 MenuBar 弹层渲染与捕获；默认不预置项，由应用层自定义）
    MenuBar? _ctxMenu
    int _ctxMenuH = -1
    Ptr[u8]? _hwnd           // 所属窗口句柄（供内嵌右击菜单按窗口隔离绘制）
    bool _ctxMenuEnabled = true
    // 行图标支持：指定某列显示 [图标+文字]，图标路径由 _rowImages 独立存储（对齐 Treeview 模式）
    int          _imageCol = -1           // 图标列索引（0-based，-1=无图标列）
    Array[string] _rowImages = []         // 每行图标路径（与 _rows 平行，空串=无图标）
    Array[string] _rowTips = []           // 每行自定义悬浮 tip（与 _rows 平行，空串=无自定义 tip）
    float        _imgSize = 0.0           // 图标边长（0 = 自动：取 _rowH - 8）
    int          _imgMode = 0             // 内容模式：0=aspectFit 1=stretch 2=aspectFill
    float        _imgPad = 4.0            // 图标在单元格内的左侧内边距
    float        _imgGap = 4.0            // 图标与文字间距
    Array[string] _imgCachePaths = []     // 纹理缓存路径
    Array[Ptr[u8]] _imgCacheTex = []      // 纹理缓存指针
    string _imgLastPath = ""               // MRU 快路径：上次命中的图标路径
    Ptr[u8] _imgLastTex = null             // MRU 快路径：上次命中的纹理指针
    // === 拟合文本缓存 ===
    // 预计算所有单元格的截断文本和宽度，避免 render 路径每帧调用 _fit_cell_text + measureString。
    // 在数据/列宽/字体变化时失效，render 中 _ensure_fitted() 惰性重建。
    Array[string] _fittedText = []        // flat: row * _ncols + col，截断后的文本
    Array[float] _fittedW = []            // flat: row * _ncols + col，截断后文本的测量宽度
    bool _fittedValid = false
    int _ctxRow = -1, _ctxCol = -1   // 右击命中行/列
    int _winW = 0, _winH = 0          // 所属窗口逻辑宽高（上下文菜单边界夹紧用）
    func(int, string):void _onCtxSelect   // 上下文菜单自定义回调（参数为命中行与项 id）
    func(int):void _onCtxWillOpen          // 右键菜单弹出前回调（参数为命中行）；用于按行类型动态重建菜单项
    func(int, int, string):void _onEditCommit  // 行内编辑提交回调（行, 列, 新文本）；供应用层落盘（如重命名）
    func(int, Array[int]):void _onCheck       // 复选框变化回调（复选列索引, 勾选行索引数组）

    // === 复选框列 ===
    int  _checkCol = -1               // 复选框列索引（-1=无复选框列）
    Array[bool] _rowChecked = []      // 每行勾选状态（与 _rows 平行）
    bool _checkHeaderState = false    // 表头全选框状态（三态：半选用 false 但有部分勾选时渲染半选样式）
    int  _chkR = 70, _chkG = 178, _chkB = 120   // 勾选框填充色
    int  _chkBoxR = 90, _chkBoxG = 95, _chkBoxB = 110  // 未勾选时边框色
    int  _markR = 235, _markG = 240, _markB = 250  // 勾选标记颜色

    // === 行级颜色 ===
    Array[int] _rowColors = []        // 每行文字色 RGB 打包：0xRRGGBB，0=用默认色

    // === 空状态 ===
    string _emptyText = "暂无数据"     // 空状态提示文字
    int _emptyR = 120, _emptyG = 128, _emptyB = 140  // 空状态文字颜色

    // === 双击编辑（默认关闭，由应用按需开启） ===
    Edit? _edit
    bool _editing = false
    bool _editable = false          // 是否允许双击进入单元格编辑（默认 false）
    int _editRow = -1, _editCol = -1
    int _lastClickTime = -100000
    float _lastClickX = 0.0, _lastClickY = 0.0
    func(int, int):void _onDblClick  // 双击单元格回调（无论是否可编辑都会触发，便于应用层自定义如“打开”）

    func _ensure_font() {
        if _font == null or not _font.ok {
            if _font != null and _font.ok { fnt.releaseFont(_font) }
            if _fontPath != "" { _font = fnt.acquireFont(_fontPath, _fontSize) }
            else { _font = fnt.acquireFontAuto(_fontSize) }
            if _font.ok {
                if _fontStyle != 0 { _font.setStyle(_fontStyle) }
                _textH = _font.measureString("Ag").h   // 字体加载时缓存行高，避免每帧渲染中调用 measureString
            }
        }
    }
    func _total_w(): float {
        if _totalWValid { return _cachedTotalW }
        float s = 0.0
        for _colW.len() to i { s = s + _colW[i] }
        _cachedTotalW = s; _totalWValid = true
        return s
    }
    func _compute_sb(): Array[float] {
        float vw = 0.0, hh = 0.0
        float bodyH0 = h - _headerH - 8.0
        float bodyW0 = w - 8.0
        float ch = _rows.len() * _rowH
        float tw = _total_w()
        if ch > bodyH0 { vw = 8.0 }
        if tw > bodyW0 { hh = 8.0 }
        if vw > 0.0 and tw > bodyW0 - vw { hh = 8.0 }
        if hh > 0.0 and ch > bodyH0 - hh { vw = 8.0 }
        return [vw, hh]
    }
    func _max_scroll_y(): float {
        var sb = _compute_sb()
        float bodyH = h - _headerH - sb[1]
        if bodyH < 0 { bodyH = 0 }
        float ch = _rows.len() * _rowH
        if ch <= 0 { ch = 1 }
        float m = ch - bodyH
        if m < 0 { m = 0 }
        return m
    }
    func _max_scroll_x(): float {
        var sb = _compute_sb()
        float bodyW = w - sb[0]
        if bodyW < 0 { bodyW = 0 }
        float m = _total_w() - bodyW
        if m < 0 { m = 0 }
        return m
    }
    func _clamp_scroll() {
        float my = _max_scroll_y(); if _scrollY < 0 { _scrollY = 0 }; if _scrollY > my { _scrollY = my }
        float mx = _max_scroll_x(); if _scrollX < 0 { _scrollX = 0 }; if _scrollX > mx { _scrollX = mx }
    }
    // 键盘导航：选中某行并滚动到可见
    func _select_key(int row) {
        if row < 0 or row >= _rows.len() { return }
        _selRow = row
        _selRows = [row]
        _ensure_row_visible(row)
        core.markFrameRedraw()
        if _onSelect != null { _onSelect(row) }
    }
    // 滚动使指定行可见
    func _ensure_row_visible(int row) {
        if row < 0 { return }
        var sb = _compute_sb()
        float visH = h - _headerH - sb[1]
        if visH < 0 { visH = 0 }
        float rowTop = row * _rowH
        float rowBot = rowTop + _rowH
        if rowTop < _scrollY { _scrollY = rowTop }
        eif rowBot > _scrollY + visH { _scrollY = rowBot - visH }
        _clamp_scroll()
    }
    // 确保列宽前缀和缓存有效（列宽变化时由 _recompute_cols / 列拖拽处失效）
    func _ensure_col_prefix() {
        if _colWPrefixValid { return }
        _colWPrefix = [0.0]
        float s = 0.0
        for _colW.len() to i { s = s + _colW[i]; _colWPrefix.add(s) }
        _colWPrefixValid = true
    }
    func _col_x(int ci): float {
        _ensure_col_prefix()
        if ci < 0 { return x - _scrollX }
        if ci >= _colWPrefix.len() { ci = _colWPrefix.len() - 1 }
        if ci < 0 { return x - _scrollX }
        return x - _scrollX + _colWPrefix[ci]
    }
    func _row_at(float my): int {
        if my < y + _headerH { return -1 }
        int idx = _int((my - y - _headerH + _scrollY) / _rowH)
        if idx < 0 or idx >= _rows.len() { return -1 }
        return idx
    }
    func _col_at(float mx): int {
        if mx < x - _scrollX { return -1 }
        float cx = x - _scrollX
        for 0 : _ncols - 1 to k {
            if mx >= cx and mx < cx + _colW[k] { return k }
            cx = cx + _colW[k]
        }
        return -1
    }
    // 命中表头列分隔线（用于列宽拖拽），返回左侧列索引，未命中返回 -1
    func _header_resize_col(float mx): int {
        if not _resizable { return -1 }
        if _ncols <= 0 { return -1 }
        float tol = 5.0
        for 0 : _ncols - 1 to c {
            float edge = _col_x(c) + _colW[c]
            if mx >= edge - tol and mx <= edge + tol { return c }
        }
        return -1
    }
    func _cell(int r, int c): string {
        if r < 0 or r >= _rows.len() { return "" }
        var row = _rows[r]
        if c < 0 or c >= row.len() { return "" }
        return row[c]
    }

    // ==================== set 初始化 ====================
    func set(Dict opts) {
        // 主题默认配色（opts 覆盖优先级更高）
        Theme th = theme.getTheme()
        br = th.bgR; bg = th.bgG; bb = th.bgB
        _hdrR = th.bgHeaderR; _hdrG = th.bgHeaderG; _hdrB = th.bgHeaderB
        _selR = th.accentR; _selG = th.accentG; _selB = th.accentB
        _hovR = th.bgHoverR; _hovG = th.bgHoverG; _hovB = th.bgHoverB
        _zebR = th.bgZebraR; _zebG = th.bgZebraG; _zebB = th.bgZebraB
        tr = th.txtR; tg = th.txtG; tb = th.txtB
        _hdrTxtR = th.txtHeaderR; _hdrTxtG = th.txtHeaderG; _hdrTxtB = th.txtHeaderB
        _sepR = th.sepR; _sepG = th.sepG; _sepB = th.sepB
        _sbR = th.sbR; _sbG = th.sbG; _sbB = th.sbB
        _emptyR = th.txtDimR; _emptyG = th.txtDimG; _emptyB = th.txtDimB
        _chkBoxR = th.borderR; _chkBoxG = th.borderG; _chkBoxB = th.borderB
        _markR = th.txtOnAccentR; _markG = th.txtOnAccentG; _markB = th.txtOnAccentB
        x = opts.get("x", 0)
        y = opts.get("y", 0)
        w = opts.get("w", 360)
        h = opts.get("h", 240)
        _headerH = opts.get("header_h", 28)
        _rowH = opts.get("row_h", 24)
        _fontSize = opts.get("font_size", 15)
        _fontPath = opts.get("font_path", "")
        _fontStyle = opts.get("font_style", 0)
        _sortable = opts.get("sortable", false)
        _resizable = opts.get("resizable", true)
        _zebra = opts.get("zebra", true)

        var hs = opts.get("headers", [])
        if hs is Array[string] { _headers = hs } else { _headers = [] }
        var cws = opts.get("col_widths", [])
        if cws is Array[float] { _colW = cws ; _autoCols = (_colW.len() == 0) }
        else { _colW = []; _autoCols = true }
        var als = opts.get("aligns", [])
        if als is Array[int] { _aligns = als } else { _aligns = [] }
        var has = opts.get("header_aligns", [])
        if has is Array[int] { _headerAligns = has } else { _headerAligns = [] }

        var rs = opts.get("rows", [])
        if rs is Array[Array[string]] { _rows = rs } else { _rows = [] }

        _ncols = _headers.len()
        if _ncols == 0 {
            int m = 0
            for _rows.len() to i { if _rows[i].len() > m { m = _rows[i].len() } }
            _ncols = m
        }
        if _ncols == 0 { _ncols = 1 }
        _recompute_cols()

        // 默认配色见字段声明（br/bg/bb/_hdrR/_selR/_hovR/_zebR/tr/_sepR/_sbR 等均有默认，以下仅 opts 覆盖）
        var bgc = opts.get("bg_rgb")
        if bgc is Array[int] { br = bgc[0]; bg = bgc[1]; bb = bgc[2] }
        var hdc = opts.get("header_rgb")
        if hdc is Array[int] { _hdrR = hdc[0]; _hdrG = hdc[1]; _hdrB = hdc[2] }
        var slc = opts.get("sel_rgb")
        if slc is Array[int] { _selR = slc[0]; _selG = slc[1]; _selB = slc[2] }
        var sc = opts.get("sep_rgb")
        if sc is Array[int] { _sepR = sc[0]; _sepG = sc[1]; _sepB = sc[2] }

        // 行图标配置：image_col 指定哪列显示 [图标+文字]，图标路径由 row_images 独立存储
        _imageCol = opts.get("image_col", -1)
        var ri = opts.get("row_images", [])
        if ri is Array[string] { _rowImages = ri } else { _rowImages = [] }
        _imgSize = opts.get("image_size", 0.0)
        _imgMode = opts.get("image_mode", 0)
        _imgPad = opts.get("image_pad", 4.0)
        _imgGap = opts.get("image_gap", 4.0)

        // 复选框列配置
        _checkCol = opts.get("check_col", -1)
        var chkR = opts.get("check_rgb")
        if chkR is Array[int] { _chkR = chkR[0]; _chkG = chkR[1]; _chkB = chkR[2] }
        _emptyText = opts.get("empty_text", "暂无数据")
        var empc = opts.get("empty_rgb")
        if empc is Array[int] { _emptyR = empc[0]; _emptyG = empc[1]; _emptyB = empc[2] }
        // 初始化行勾选/颜色数组长度
        while _rowChecked.len() < _rows.len() { _rowChecked.add(false) }
        while _rowColors.len() < _rows.len() { _rowColors.add(0) }

        _cursor = _int(opts.get("cursor", SystemCursor.POINTER))
        enabled = opts.get("enabled", true)
        visible = opts.get("visible", true)
        _tip = opts.get("tip", "")
        _selRow = -1; _selCol = -1; _hoverRow = -1; _selRows = []
        _multi = opts.get("multi_select", opts.get("multi", false))
        _scrollX = 0.0; _scrollY = 0.0
        _sortCol = -1; _sortDesc = false
        _draggingV = false; _draggingH = false
        _dragCol = -1
        _ensure_font()
        _clamp_scroll()
        // 编辑框（朴素写法：在 sdl_table 内部经模块别名 edt 创建，触发传递加载别名 bug）
        _edit = edt.createEdit({x:0, y:0, w:w, h:_rowH, font_size:_fontSize, border:false, radius:0})
        _editing = false
        _editRow = -1; _editCol = -1
        // 内嵌右击上下文菜单（首次 set 时创建，避免重复注册到全局菜单注册表）
        if _ctxMenu == null {
            _ctxMenu = menu.createMenuBar({})
            _ctxMenu.setWindowSize(_winW, _winH)
            _ctxMenuH = _ctxMenu.addContextMenu("table_ctx")
            _ctxMenu.on_select(func(string m, string id) { _ctx_select(id) })
            menu.registerContextMenu(_ctxMenu)
        }
        _loaded = true
    }

    func _recompute_cols() {
        _colWPrefixValid = false
        _totalWValid = false
        _invalidate_fitted()
        int n = _ncols
        if n <= 0 { n = 1 }
        if _autoCols or _colW.len() != n {
            _colW = []
            float cw = w / n
            if cw < 30.0 { cw = 30.0 }
            for n to _ { _colW.add(cw) }
        }
        if _aligns.len() != n {
            _aligns = []
            for n to _ { _aligns.add(0) }
        }
        if _headerAligns.len() != n {
            _headerAligns = []
            for n to i { int a = 0; if i < _aligns.len() { a = _aligns[i] }; _headerAligns.add(a) }
        }
    }

    // ==================== 布局接口 ====================
    func get_w(): float { return w }
    func get_h(): float { return h }
    func get_x(): float { return x }
    func get_y(): float { return y }
    func set_pos(float px, float py) { x = px; y = py; _clamp_scroll() }
    func set_size(float sw, float sh) {
        w = sw; h = sh
        if _autoCols { _recompute_cols() }
        _clamp_scroll()
    }

    // ==================== 数据操作 ====================
    func set_rows(Array[Array[string]] rs) {
        _rows = rs
        _invalidate_fitted()
        int m = 0
        for _rows.len() to i { if _rows[i].len() > m { m = _rows[i].len() } }
        if _headers.len() > 0 { _ncols = _headers.len() }
        eif m > 0 { _ncols = m } eif _ncols == 0 { _ncols = 1 }
        _recompute_cols()
        _clamp_scroll()
        _selRow = -1; _selRows = []
        // 同步 _rowImages / _rowTips / _rowChecked / _rowColors 长度
        while _rowImages.len() > _rows.len() { _rowImages.remove(_rowImages.len() - 1) }
        while _rowTips.len() > _rows.len() { _rowTips.remove(_rowTips.len() - 1) }
        while _rowChecked.len() > _rows.len() { _rowChecked.remove(_rowChecked.len() - 1) }
        while _rowColors.len() > _rows.len() { _rowColors.remove(_rowColors.len() - 1) }
        while _rowChecked.len() < _rows.len() { _rowChecked.add(false) }
        while _rowColors.len() < _rows.len() { _rowColors.add(0) }
        _update_check_header()
    }
    func add_row(Array[string] row, string imgPath) {
        _rows.add(row)
        _invalidate_fitted()
        _rowImages.add(imgPath)
        _rowTips.add("")
        _rowChecked.add(false)
        _rowColors.add(0)
        if row.len() > _ncols and _headers.len() == 0 { _ncols = row.len(); _recompute_cols() }
        _clamp_scroll()
        _update_check_header()
    }
    func remove_row(int idx) {
        _invalidate_fitted()
        if idx >= 0 and idx < _rows.len() { _rows.remove(idx) }
        if idx >= 0 and idx < _rowImages.len() { _rowImages.remove(idx) }
        if idx >= 0 and idx < _rowTips.len() { _rowTips.remove(idx) }
        if idx >= 0 and idx < _rowChecked.len() { _rowChecked.remove(idx) }
        if idx >= 0 and idx < _rowColors.len() { _rowColors.remove(idx) }
        if _selRow == idx { _selRow = -1 }
        eif _selRow > idx { _selRow = _selRow - 1 }
        Array[int] ns = []
        for _selRows.len() to i {
            int r = _selRows[i]
            if r == idx { continue }
            if r > idx { r = r - 1 }
            ns.add(r)
        }
        _selRows = ns
        _clamp_scroll()
        _update_check_header()
    }
    func clear() { _rows = []; _rowImages = []; _rowTips = []; _rowChecked = []; _rowColors = []; _selRow = -1; _selCol = -1; _selRows = []; _scrollX = 0; _scrollY = 0; _checkHeaderState = false; _invalidate_fitted() }
    func row_count(): int { return _rows.len() }
    func col_count(): int { return _ncols }
    func get_row(int idx): Array[string] {
        if idx >= 0 and idx < _rows.len() { return _rows[idx] }
        return []
    }
    func set_cell(int r, int c, string v) {
        if r >= 0 and r < _rows.len() {
            while _rows[r].len() <= c { _rows[r].add("") }
            _rows[r][c] = v
            _invalidate_fitted()
        }
    }
    // 获取单元格文本（供 tooltip 截断检测用）
    func _cell_text(int r, int c): string {
        if r < 0 or r >= _rows.len() { return "" }
        if c < 0 or c >= _rows[r].len() { return "" }
        return _rows[r][c]
    }
    func get_cell(int r, int c): string {
        return _cell_text(r, c)
    }
    func set_headers(Array[string] hs) {
        _headers = hs; _ncols = hs.len(); if _ncols == 0 { _ncols = 1 }
        _recompute_cols(); _clamp_scroll(); _invalidate_fitted()
    }
    func _is_sel(int r): bool {
        for _selRows.len() to i { if _selRows[i] == r { return true } }
        return false
    }
    func _toggle_sel(int r) {
        int idx = -1
        for _selRows.len() to i { if _selRows[i] == r { idx = i } }
        if idx >= 0 { _selRows.remove(idx) }
        else { _selRows.add(r) }
    }
    func set_selected(int idx) { _selRows = []; if idx >= 0 and idx < _rows.len() { _selRow = idx; _selRows.add(idx) } }
    func get_selected_row(): int { return _selRow }
    func get_selected_rows(): Array[int] { return _selRows }
    func set_aligns(Array[int] als) { _aligns = als; if _aligns.len() != _ncols { _recompute_cols() } }
    func set_header_aligns(Array[int] als) { _headerAligns = als; if _headerAligns.len() != _ncols { _recompute_cols() } }
    func set_multi_select(bool m) { _multi = m }
    func select_all() { _selRows = []; for _rows.len() to i { _selRows.add(i) }; if _selRow < 0 and _rows.len() > 0 { _selRow = 0 } }
    func clear_selection() { _selRows = []; _selRow = -1 }

    // ==================== 排序 ====================
    func sort_by(int col, bool desc) {
        _sortCol = col; _sortDesc = desc
        _invalidate_fitted()
        for 0 : _rows.len() - 1 to i {
            for i + 1 : _rows.len() - 1 to j {
                string a = _cell(i, col), b = _cell(j, col)
                bool lt = (a < b)
                if desc { lt = (b < a) }
                if lt {
                    var tmp = _rows[i]; _rows[i] = _rows[j]; _rows[j] = tmp
                    // 同步交换行图标/勾选/颜色，保持与行数据对齐
                    if i < _rowImages.len() and j < _rowImages.len() {
                        string ti = _rowImages[i]; _rowImages[i] = _rowImages[j]; _rowImages[j] = ti
                    }
                    if i < _rowTips.len() and j < _rowTips.len() {
                        string tt = _rowTips[i]; _rowTips[i] = _rowTips[j]; _rowTips[j] = tt
                    }
                    if i < _rowChecked.len() and j < _rowChecked.len() {
                        bool tb = _rowChecked[i]; _rowChecked[i] = _rowChecked[j]; _rowChecked[j] = tb
                    }
                    if i < _rowColors.len() and j < _rowColors.len() {
                        int tc = _rowColors[i]; _rowColors[i] = _rowColors[j]; _rowColors[j] = tc
                    }
                }
            }
        }
    }

    // ==================== 设置方法 ====================
    func set_font_size(float s) { _fontSize = s; if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null; _invalidate_fitted() }
    func set_enabled(bool e) { enabled = e }
    func set_visible(bool v) { visible = v }
    func set_resizable(bool r) { _resizable = r }
    func is_visible(): bool { return visible }
    func set_tip(string t) { _tip = t }
    func on_select(func(int):void cb) { _onSelect = cb }
    func on_cell(func(int, int):void cb) { _onCell = cb }

    // ==================== 行图标设置方法 ====================
    func set_image_col(int c) { _imageCol = c; _invalidate_fitted() }
    func set_row_image(int row, string path) {
        if row >= 0 and row < _rowImages.len() { _rowImages[row] = path; _invalidate_fitted() }
        eif row >= 0 {
            while _rowImages.len() <= row { _rowImages.add("") }
            _rowImages[row] = path
        }
    }
    func get_row_image(int row): string {
        if row >= 0 and row < _rowImages.len() { return _rowImages[row] }
        return ""
    }
    func set_row_tip(int row, string tip) {
        if row >= 0 and row < _rowTips.len() { _rowTips[row] = tip }
        eif row >= 0 {
            while _rowTips.len() <= row { _rowTips.add("") }
            _rowTips[row] = tip
        }
    }
    func set_image_size(float s) { _imgSize = s; _invalidate_fitted() }
    func set_image_mode(int m) { _imgMode = m }
    func set_image_pad(float p) { _imgPad = p; _invalidate_fitted() }
    func set_image_gap(float g) { _imgGap = g; _invalidate_fitted() }

    // ==================== 复选框列 ====================
    func set_check_col(int c) { _checkCol = c }
    func is_row_checked(int row): bool {
        if row >= 0 and row < _rowChecked.len() { return _rowChecked[row] }
        return false
    }
    func set_row_checked(int row, bool on) {
        if row >= 0 and row < _rowChecked.len() {
            _rowChecked[row] = on
            _update_check_header()
            if _onCheck != null { _onCheck(_checkCol, _get_checked_rows()) }
        }
    }
    func get_checked_rows(): Array[int] { return _get_checked_rows() }
    func check_all() {
        for _rowChecked.len() to i { _rowChecked[i] = true }
        _checkHeaderState = true
        if _onCheck != null { _onCheck(_checkCol, _get_checked_rows()) }
    }
    func uncheck_all() {
        for _rowChecked.len() to i { _rowChecked[i] = false }
        _checkHeaderState = false
        if _onCheck != null { _onCheck(_checkCol, []) }
    }
    func _get_checked_rows(): Array[int] {
        Array[int] out = []
        for _rowChecked.len() to i { if _rowChecked[i] { out.add(i) } }
        return out
    }
    // 根据行勾选状态更新表头全选框状态
    func _update_check_header() {
        if _checkCol < 0 { return }
        int cnt = 0
        for _rowChecked.len() to i { if _rowChecked[i] { cnt = cnt + 1 } }
        _checkHeaderState = (cnt > 0 and cnt == _rowChecked.len())
    }
    func on_check(func(int, Array[int]):void cb) { _onCheck = cb }

    // ==================== 行级颜色 ====================
    // color 为 0xRRGGBB 整数（如 0xFF4040 表红色），0 表示恢复默认色
    func set_row_color(int row, int color) {
        if row >= 0 {
            while _rowColors.len() <= row { _rowColors.add(0) }
            _rowColors[row] = color
        }
    }
    func get_row_color(int row): int {
        if row >= 0 and row < _rowColors.len() { return _rowColors[row] }
        return 0
    }
    func clear_row_colors() {
        for _rowColors.len() to i { _rowColors[i] = 0 }
    }

    // ==================== 空状态 ====================
    func set_empty_text(string t) { _emptyText = t }

    // ==================== 右击上下文菜单（默认不预置任何项，由应用层自定义） ====================
    // 设置所属窗口逻辑宽高，供上下文菜单弹出时做边界夹紧
    func set_window_size(int ww, int hh) {
        _winW = ww; _winH = hh
        _ctxMenu?.setWindowSize(ww, hh)
    }
    // ★ Widget 接口：窗口 resize 时自动同步尺寸到内部菜单
    func on_window_resize(int ww, int hh) {
        set_window_size(ww, hh)
    }
    // 记录所属窗口句柄，供内嵌右击菜单按窗口隔离绘制
    func set_window_handle(Ptr[u8] hwnd) {
        _hwnd = hwnd
        _ctxMenu?.setWindowHandle(hwnd)
    }
    // 启用/禁用右击上下文菜单
    func set_context_menu_enabled(bool en) { _ctxMenuEnabled = en }
    func is_context_menu_enabled(): bool { return _ctxMenuEnabled }
    // 向上下文菜单追加一项，返回项在菜单内索引（可用于挂子菜单）
    func addContextItem(Dict opts): int {
        if _ctxMenu == null or _ctxMenuH < 0 { return -1 }
        return _ctxMenu.addContextItem(_ctxMenuH, opts)
    }
    // 向上下文菜单追加分隔线
    func addContextSeparator() {
        if _ctxMenu == null or _ctxMenuH < 0 { return }
        _ctxMenu.addContextSeparator(_ctxMenuH)
    }
    // 按 id 动态启用/禁用某个上下文菜单项（供调用方按当前状态刷新）
    func setContextItemEnabled(string id, bool en) {
        if _ctxMenu != null and _ctxMenuH >= 0 { _ctxMenu.setContextItemEnabled(_ctxMenuH, id, en) }
    }
    // 返回内嵌上下文菜单（MenuBar），应用可经 addContextItem 等进一步扩展或挂子菜单
    func get_context_menu(): MenuBar { return _ctxMenu }
    func get_context_menu_handle(): int { return _ctxMenuH }
    // 右击时记录的行/列（在 on_context_select 回调内可读，定位操作目标）
    func get_context_menu_row(): int { return _ctxRow }
    func get_context_menu_col(): int { return _ctxCol }
    // 注册上下文菜单自定义回调（参数为命中行与项 id）；也可直接在 addContextItem 的 opts 里写 action
    func on_context_select(func(int, string):void cb) { _onCtxSelect = cb }
    // 注册“右键菜单弹出前”回调（参数为命中行，row<0 表示空白处）；用于按行类型动态重建菜单项
    func on_context_will_open(func(int):void cb) { _onCtxWillOpen = cb }
    // 清空内嵌上下文菜单的全部项（配合 on_context_will_open 在弹出前重建）
    func clearContextItems() {
        if _ctxMenu != null and _ctxMenuH >= 0 { _ctxMenu.clearContextItems(_ctxMenuH) }
    }
    // 注册行内编辑提交回调（行,列,新文本）；如用于右键“重命名”后落盘
    func on_edit_commit(func(int, int, string):void cb) { _onEditCommit = cb }
    // 程序触发进入某行某列的行内编辑（如右键“重命名”）
    func begin_edit(int row, int col) { _begin_edit(row, col) }

    // 在 (x,y) 弹出上下文菜单，并记录右击命中的行/列
    func _open_ctx_menu(float x, float y, int keyMod) {
        if _ctxMenu == null or _ctxMenuH < 0 { return }
        _ctxRow = _row_at(y); _ctxCol = _col_at(x)
        // 右击命中数据行时，更新选中状态
        if _ctxRow >= 0 {
            // ★ 多选模式右击选中逻辑（对齐 Windows 资源管理器行为）：
            //   - 右击行已选中 → 保持当前多选状态不变（仅更新 _selRow 为当前行）
            //   - 右击行未选中 + 无 Ctrl → 替换为唯一选中项（清除旧多选）
            //   - 右击行未选中 + Ctrl → 追加到多选集
            if not _is_sel(_ctxRow) {
                _selRow = _ctxRow
                if _multi {
                    int MOD_CTRL = 64
                    if (keyMod & MOD_CTRL) != 0 {
                        _selRows.add(_ctxRow)       // Ctrl+右击：追加到多选
                    } else {
                        _selRows = [_ctxRow]         // 普通右击：替换为唯一选中
                    }
                } else {
                    _selRows = [_ctxRow]
                }
                if _onSelect != null { _onSelect(_ctxRow) }
            } eif _multi {
                // 多选模式下右击已选中行：仅更新 selRow 为当前行，保持 _selRows 不变
                _selRow = _ctxRow
                if _onSelect != null { _onSelect(_ctxRow) }
            } else {
                // 单选模式：正常选中
                _selRow = _ctxRow; _selRows = [_ctxRow]
                if _onSelect != null { _onSelect(_ctxRow) }
            }
        }
        // 弹出前把命中行交给应用层，由它按行类型重建菜单项（文件/文件夹/空白处不同）
        if _onCtxWillOpen != null { _onCtxWillOpen(_ctxRow) }
        // 重建后仍无任何有效项则不弹菜单（避免出现空白横线）
        if _ctxMenu.contextItemCount(_ctxMenuH) == 0 { return }
        _ctxMenu.openContext(_ctxMenuH, x, y)
    }
    // 上下文菜单项动作分发
    func _ctx_select(string id) {
        if _onCtxSelect != null { _onCtxSelect(_ctxRow, id) }
    }

    // ==================== 双击编辑 ====================
    func _begin_edit(int row, int col) {
        if row < 0 or row >= _rows.len() { return }
        if col < 0 or col >= _ncols { return }
        _editRow = row; _editCol = col
        float cx = _col_x(col)
        float ry = y + _headerH - _scrollY + row * _rowH
        _edit.set_pos(cx, ry)
        _edit.set_size(_colW[col], _rowH)
        _edit.set_font_size(_fontSize)
        _edit.set_text(_cell(row, col))
        _edit.focus()
        _editing = true
    }
    func _commit_edit() {
        if _editRow >= 0 and _editCol >= 0 and _editRow < _rows.len() {
            string newText = _edit.get_text()
            set_cell(_editRow, _editCol, newText)
            if _onEditCommit != null { _onEditCommit(_editRow, _editCol, newText) }
        }
        _editing = false
        _editRow = -1; _editCol = -1
        _lastClickTime = -100000
        _edit.blur()    // 停止闪烁定时器，避免每 500ms 空跑 requestRedraw 导致 Table 闪烁
    }
    func is_editing(): bool { return _editing }
    // 启用/禁用双击进入单元格编辑（默认关闭）
    func set_editable(bool en) { _editable = en }
    func is_editable(): bool { return _editable }
    // 双击单元格回调：无论是否可编辑都会触发，便于应用层自定义（如文件管理器双击打开）
    func on_dbl_click(func(int, int):void cb) { _onDblClick = cb }
    func edit_debug(): string {
        if _edit == null { return "edit=null" }
        if _edit.is_loaded() { return "edit.loaded=true" }
        return "edit.loaded=false"
    }

    func contains(float mx, float my): bool {
        return mx >= x and mx <= x + w and my >= y and my <= y + h
    }

    // ==================== 交互 ====================
    func process(Event ev) {
        if not _loaded or not visible or not enabled {
            _hoverRow = -1; _draggingV = false; _draggingH = false; _dragCol = -1
            return
        }
        float mx = ev.mouseX(), my = ev.mouseY()
        if ev.isMouseWheel() { mx = ev.wheelMouseX(); my = ev.wheelMouseY() }

        // 内嵌右击上下文菜单已展开：所有事件先交菜单处理（选择/关闭由菜单自身负责）
        if _ctxMenuEnabled and _ctxMenu != null and _ctxMenu.isOpen() {
            if ev.isMouseButtonDown() and ev.mouseButton() == 3 {
                _ctxMenu.close()
                if contains(mx, my) { _open_ctx_menu(mx, my, ev.keyMod()) }
                return
            }
            _ctxMenu.process(ev)
            return
        }

        // ★ 修复：编辑中且 Edit 的右击菜单展开时，事件必须经 Edit 转发给菜单处理。
        //   若先走 inPopupCapture 拦截，Edit 的菜单将收不到点击事件，导致菜单项无法选中。
        if _editing and _edit.isContextMenuOpen() {
            _edit.process(ev)
            // 菜单关闭后（如点击菜单项执行了动作），若点击在 Edit 外部则提交编辑
            if not _edit.isContextMenuOpen() and ev.isMouseButtonDown()
               and not _edit.contains(ev.mouseX(), ev.mouseY()) {
                _commit_edit()
            }
            return
        }

        if core.inPopupCapture(mx, my) { return }

        // 编辑中：事件转发给编辑框
        if _editing {
            _edit.process(ev)
            if ev.isKeyDown() and ev.scancode() == core.Scancode.RETURN { _commit_edit() }
            eif ev.isMouseButtonDown() and not _edit.contains(ev.mouseX(), ev.mouseY()) {
                _commit_edit()
            }
            return
        }

        // 键盘导航：表格聚焦时处理方向键/Enter/PageUp/PageDown/Home/End/Ctrl+A
        if ev.isKeyDown() {
            int sc = ev.scancode()
            int mod = ev.keyMod()
            switch sc {
                case core.Scancode.UP {
                    if _rows.len() == 0 { return }
                    int r = _selRow - 1
                    if _selRow < 0 { r = 0 }
                    if r < 0 { r = 0 }
                    _select_key(r)
                    return
                }
                case core.Scancode.DOWN {
                    if _rows.len() == 0 { return }
                    int r = _selRow + 1
                    if _selRow < 0 { r = 0 }
                    if r >= _rows.len() { r = _rows.len() - 1 }
                    _select_key(r)
                    return
                }
                case core.Scancode.HOME {
                    if _rows.len() == 0 { return }
                    _select_key(0)
                    return
                }
                case core.Scancode.END {
                    if _rows.len() == 0 { return }
                    _select_key(_rows.len() - 1)
                    return
                }
                case core.Scancode.PAGEUP {
                    if _rows.len() == 0 { return }
                    var sbP = _compute_sb()
                    float bodyH = h - _headerH - sbP[1]
                    if bodyH < 0 { bodyH = 0 }
                    int pageSteps = _int(bodyH / _rowH)
                    if pageSteps < 1 { pageSteps = 1 }
                    int r = _selRow - pageSteps
                    if r < 0 { r = 0 }
                    _select_key(r)
                    return
                }
                case core.Scancode.PAGEDOWN {
                    if _rows.len() == 0 { return }
                    var sbP = _compute_sb()
                    float bodyH = h - _headerH - sbP[1]
                    if bodyH < 0 { bodyH = 0 }
                    int pageSteps = _int(bodyH / _rowH)
                    if pageSteps < 1 { pageSteps = 1 }
                    int r = _selRow + pageSteps
                    if r >= _rows.len() { r = _rows.len() - 1 }
                    _select_key(r)
                    return
                }
                case core.Scancode.RETURN {
                    if _selRow >= 0 and _selRow < _rows.len() {
                        if _onDblClick != null { _onDblClick(_selRow, _selCol) }
                        if _editable { _begin_edit(_selRow, _selCol) }
                    }
                    return
                }
                case core.Scancode.A {
                    // Ctrl+A 全选（未按 Ctrl 时不拦截，让事件继续传递）
                    if (mod & 64) != 0 or (mod & 128) != 0 {
                        if _multi { select_all() }
                        return
                    }
                }
            }
        }

        // 仅处理命中表格区域内的事件（表格外点击/悬停不触发表头与行交互）
        if not contains(mx, my) {
            _hoverRow = -1
            _hoverColForTip = -1; _hoverTipText = ""
            return
        }

        var sb = _compute_sb()
        float vw = sb[0], hh = sb[1]

        if ev.isMouseButtonUp() { _draggingV = false; _draggingH = false; _dragCol = -1 }

        // 竖向滚动条
        if vw > 0.0 {
            float sx = x + w - vw - 2.0
            bool inV = mx >= sx - 2.0 and mx <= sx + vw + 2.0 and my >= y + _headerH and my <= y + h - hh
            if ev.isMouseButtonDown() and inV {
                float maxY = _max_scroll_y(); if maxY <= 0 { maxY = 1 }
                float bodyH = h - _headerH - hh
                float track = bodyH - 4.0
                float contentH = _rows.len() * _rowH; if contentH <= 0 { contentH = 1 }
                float thumbH = maths.max(18.0, maths.min(bodyH * bodyH / contentH, bodyH))
                float thy = y + _headerH + 2.0 + (_scrollY / maxY) * (track - thumbH)
                if my >= thy and my <= thy + thumbH { _draggingV = true; _vDragOffset = my - thy }
                else {
                    _draggingV = true; _vDragOffset = thumbH / 2.0
                    _scrollY = (my - (y + _headerH + 2.0) - thumbH / 2.0) * (maxY / (track - thumbH))
                    _clamp_scroll()
                }
                return
            }
            if _draggingV and ev.isMouseMotion() {
                float maxY = _max_scroll_y(); if maxY <= 0 { maxY = 1 }
                float bodyH = h - _headerH - hh
                float track = bodyH - 4.0
                float contentH = _rows.len() * _rowH; if contentH <= 0 { contentH = 1 }
                float thumbH = maths.max(18.0, maths.min(bodyH * bodyH / contentH, bodyH))
                _scrollY = (my - (y + _headerH + 2.0) - _vDragOffset) * (maxY / (track - thumbH))
                _clamp_scroll()
                core.markFrameRedraw()
                return
            }
        }

        // 横向滚动条
        if hh > 0.0 {
            float sy = y + h - hh - 2.0
            bool inH = my >= sy - 2.0 and my <= sy + hh + 2.0 and mx >= x and mx <= x + w - vw
            if ev.isMouseButtonDown() and inH {
                float maxX = _max_scroll_x(); if maxX <= 0 { maxX = 1 }
                float bodyW = w - vw
                float track = bodyW - 4.0
                float tw = _total_w(); if tw <= 0 { tw = 1 }
                float thumbW = maths.max(18.0, maths.min(bodyW * bodyW / tw, bodyW))
                float thx = x + 2.0 + (_scrollX / maxX) * (track - thumbW)
                if mx >= thx and mx <= thx + thumbW { _draggingH = true; _hDragOffset = mx - thx }
                else {
                    _draggingH = true; _hDragOffset = thumbW / 2.0
                    _scrollX = (mx - (x + 2.0) - thumbW / 2.0) * (maxX / (track - thumbW))
                    _clamp_scroll()
                }
                return
            }
            if _draggingH and ev.isMouseMotion() {
                float maxX = _max_scroll_x(); if maxX <= 0 { maxX = 1 }
                float bodyW = w - vw
                float track = bodyW - 4.0
                float tw = _total_w(); if tw <= 0 { tw = 1 }
                float thumbW = maths.max(18.0, maths.min(bodyW * bodyW / tw, bodyW))
                _scrollX = (mx - (x + 2.0) - _hDragOffset) * (maxX / (track - thumbW))
                _clamp_scroll()
                core.markFrameRedraw()
                return
            }
        }

        if ev.isMouseWheel() {
            if not contains(ev.wheelMouseX(), ev.wheelMouseY()) { return }
            int mod = ev.keyMod()
            if (mod & 1) != 0 { _scrollX = _scrollX - ev.wheelX() * 24.0 }
            else { _scrollY = _scrollY - ev.wheelY() * _rowH }
            _clamp_scroll()
            return
        }

        if ev.isMouseMotion() {
            int prevHover = _hoverRow
            _hoverRow = _row_at(my)
            bool hv = _hoverRow >= 0
            if _hoverRow != prevHover { core.markFrameRedraw() } else { core.markFrameMotion() }
            if _dragCol >= 0 {
                float nw = _dragStartW + (mx - _dragStartX)
                if nw < 24.0 { nw = 24.0 }
                if _dragCol >= 0 and _dragCol < _colW.len() { _colW[_dragCol] = nw; _colWPrefixValid = false; _totalWValid = false; _invalidate_fitted() }
                _autoCols = false
                _clamp_scroll()
                core.markFrameRedraw()
                core.requestCursor(SystemCursor.EW_RESIZE)
            } eif my < y + _headerH {
                int rc = _header_resize_col(mx)
                if rc >= 0 { core.requestCursor(SystemCursor.EW_RESIZE) }
                eif hv and _cursor >= 0 { core.requestCursor(_cursor) }
            } eif hv and _cursor >= 0 {
                core.requestCursor(_cursor)
            }
            string rt = if _hoverRow >= 0 and _hoverRow < _rowTips.len() then _rowTips[_hoverRow] else ""
            // ★ Tooltip 节流：仅在悬停目标（行/单元格）变化时调用 tipReport（重置延迟计时器），
            //   同一目标内的鼠标移动调用 tipKeep（保持 tooltip 活跃但不重置计时器）。
            //   旧方案每次 motion 都调 tipReport → _tipStart 恒被重置 → tipWaiting() 恒 true
            //   → 窗口 60fps 空转重绘。新方案让计时器从首次进入目标起自然到期，到期后
            //   tipRemainingMs()==0 触发一次重绘显示 tooltip，之后不再额外重绘。
            bool prevHv = prevHover >= 0
            if _tip != "" {
                if hv {
                    // 表级 tip：仅进出表格时重置延迟，表格内移动不重置
                    if hv != prevHv { tip.tipReport(_tip, mx, my) }
                    else { tip.tipKeep(mx, my) }
                }
            } eif rt != "" and hv {
                // 行级自定义 tip：仅跨行时重置延迟，同行内移动不重置
                if _hoverRow != prevHover { tip.tipReport(rt, mx, my) }
                else { tip.tipKeep(mx, my) }
            } eif hv {
                // 单元格 Tooltip：文字被截断时悬停显示完整内容
                // 优化：仅当悬停单元格(行+列)变化时才做 measureString 截断检查，
                //       同一单元格内的鼠标移动直接复用缓存的 tooltip 文本，
                //       避免每次 mouse motion 都调 measureString（线性扫描 256 槽缓存）
                int hc = _col_at(mx)
                if hc >= 0 {
                    bool cellChanged = (_hoverRow != prevHover or hc != _hoverColForTip)
                    if cellChanged {
                        _hoverColForTip = hc
                        _hoverTipText = ""
                        string cellText = _cell_text(_hoverRow, hc)
                        if cellText != "" and cellText != null {
                            float iconOff = 0.0
                            if hc == _imageCol and _hoverRow < _rowImages.len() {
                                string ip = _rowImages[_hoverRow]
                                if ip != "" and ip != null { iconOff = _rowH * 0.7 }
                            }
                            float pad = 8.0
                            float availW = _colW[hc] - 2.0 * pad - iconOff
                            float fullW = _font.measureString(cellText).w
                            if fullW > availW { _hoverTipText = cellText }
                        }
                    }
                    // 复用缓存的 tooltip 文本保持 tooltip 可见
                    // ★ 优化：同一单元格内用 tipKeep 替代 tipReport，不重置延迟计时器
                    if _hoverTipText != "" {
                        float cellX = _col_x(hc)
                        float cellCY = y + _headerH - _scrollY + _hoverRow * _rowH + _rowH / 2.0
                        if cellChanged { tip.tipReport(_hoverTipText, cellX, cellCY) }
                        else { tip.tipKeep(cellX, cellCY) }
                    }
                }
            }
        }

        if ev.isMouseButtonDown() {
            // 右击：在表格内弹出上下文菜单（默认无预置项，由应用层自定义）
            if _ctxMenuEnabled and _ctxMenu != null and ev.mouseButton() == 3 {
                if contains(mx, my) { _open_ctx_menu(mx, my, ev.keyMod()) }
                return
            }
            if my < y + _headerH {
                // 表头复选框：点击全选/全不选
                if _checkCol >= 0 and _is_in_checkbox(mx, my, true, -1) {
                    if _checkHeaderState { uncheck_all() } else { check_all() }
                    return
                }
                int rc = _header_resize_col(mx)
                if rc >= 0 {
                    _dragCol = rc; _dragStartX = mx; _dragStartW = _colW[rc]
                    _autoCols = false
                    return
                }
                int col = _col_at(mx)
                if col >= 0 and _sortable { sort_by(col, not (_sortCol == col and _sortDesc)) }
            } else {
                int row = _row_at(my)
                int col = _col_at(mx)
                if row >= 0 {
                    // 行复选框点击
                    if _checkCol >= 0 and col == _checkCol and _is_in_checkbox(mx, my, false, row) {
                        set_row_checked(row, not is_row_checked(row))
                        return
                    }
                    int now = core.getTicks()
                    bool isDbl = now - _lastClickTime < 400
                            and mx >= _lastClickX - 10 and mx <= _lastClickX + 10
                            and my >= _lastClickY - 10 and my <= _lastClickY + 10
                    _lastClickTime = now
                    _lastClickX = mx; _lastClickY = my
                    if isDbl and col >= 0 {
                        if _onDblClick != null { _onDblClick(row, col) }
                        if _editable { _begin_edit(row, col) }
                        return
                    }
                    if _multi {
                        int MOD_SHIFT = 1, MOD_CTRL = 64
                        int mod = ev.keyMod()
            bool shift = (mod & MOD_SHIFT) != 0, ctrl = (mod & MOD_CTRL) != 0
                        if shift and _selRow >= 0 {
                            int a = _selRow, b = row
                            if a > b { int t = a; a = b; b = t }
                            _selRows = []
                            for a : b to k { _selRows.add(k) }
                        } eif ctrl {
                            _toggle_sel(row)
                        } else {
                            _selRows = [row]
                        }
                        _selRow = row
                    } else {
                        _selRows = [row]
                        _selRow = row
                    }
                    if _onSelect != null { _onSelect(row) }
                    if _onCell != null and col >= 0 { _onCell(row, col) }
                }
            }
        }
    }

    // ==================== 复选框命中测试与绘制 ====================
    // 判断点击是否落在复选框区域。isHeader=true 时用表头坐标(row 忽略)；否则用数据行坐标
    func _is_in_checkbox(float mx, float my, bool isHeader, int row): bool {
        if _checkCol < 0 { return false }
        float cx = _col_x(_checkCol)
        float cw = _colW[_checkCol]
        float boxSize = 14.0
        float bx = cx + (cw - boxSize) / 2.0
        float by
        if isHeader {
            by = y + (_headerH - boxSize) / 2.0
        } else {
            if row < 0 { return false }
            float ry = y + _headerH - _scrollY + row * _rowH
            by = ry + (_rowH - boxSize) / 2.0
        }
        return mx >= bx and mx <= bx + boxSize and my >= by and my <= by + boxSize
    }

    // 在指定单元格中心绘制复选框。checked=是否勾选，partial=是否半选(仅表头)
    func _draw_checkbox(Renderer r, float cx, float cw, float ry, float rh, bool checked, bool partial) {
        float boxSize = 14.0
        float bx = r.snapX(cx + (cw - boxSize) / 2.0)
        float by = r.snapY(ry + (rh - boxSize) / 2.0)
        if checked or partial {
            int cr = _chkR, cg = _chkG, cb = _chkB
            if partial { cr = 100; cg = 110; cb = 125 }   // 半选用灰色
            if not enabled { cr = cr / 2; cg = cg / 2; cb = cb / 2 }
            r.setColor(cr, cg, cb, 255)
            r.fillRect(bx, by, boxSize, boxSize)
            // 勾号（checked）或横杠（partial 半选）
            if checked {
                int mr = _markR, mg = _markG, mb = _markB
                if not enabled { mr = 120; mg = 125; mb = 135 }
                r.setColor(mr, mg, mb, 255)
                r.drawLine(bx + 3.0, by + 7.5, bx + 6.0, by + 10.5)
                r.drawLine(bx + 6.0, by + 10.5, bx + 11.0, by + 4.5)
            } eif partial {
                int mr = _markR, mg = _markG, mb = _markB
                if not enabled { mr = 120; mg = 125; mb = 135 }
                r.setColor(mr, mg, mb, 255)
                r.drawLine(bx + 3.0, by + 7.0, bx + 11.0, by + 7.0)
            }
        } else {
            int br2 = _chkBoxR, bg2 = _chkBoxG, bb2 = _chkBoxB
            if not enabled { br2 = br2 / 2; bg2 = bg2 / 2; bb2 = bb2 / 2 }
            r.setColor(br2, bg2, bb2, 255)
            r.drawRect(bx, by, boxSize, boxSize)
        }
    }

    // ==================== 渲染 ====================
    // 按可用宽度测算，超宽时在末尾追加 "…" 截断（二分查找最大可容纳字符数）
    func _fit_cell_text(string t, float availW): string {
        if _font == null or not _font.ok { return t }
        if availW <= 0.0 { return "" }
        float fullW = _font.measureString(t).w
        if fullW <= availW { return t }
        float eW = _font.measureString("\u2026").w   // "…"
        float limit = availW - eW
        if limit < 0.0 { return "\u2026" }
        int n = t.len()
        int lo = 0, hi = n
        while lo < hi {
            int mid = (lo + hi + 1) / 2
            float mw = _font.measureString(t.slice(0, mid)).w
            if mw <= limit { lo = mid } else { hi = mid - 1 }
        }
        return t.slice(0, lo) + "\u2026"
    }

    // ==================== 拟合文本缓存 ====================
    // 预计算所有单元格的截断文本 + 测量宽度，render 中直接查表，消除每帧 _fit_cell_text 二分搜索
    // 和 measureString 的 string key 构造 + 缓存扫描开销（~120-420 次/帧 → 0 次/帧）。
    // 在数据/列宽/字体/图标布局变化时调用 _invalidate_fitted() 失效。

    func _invalidate_fitted() { _fittedValid = false }

    // 计算指定行指定列的图标占宽（不绘制，仅用于拟合文本的可用宽度计算）
    func _compute_icon_off(int r, int c): float {
        if c != _imageCol or not _has_image_col() { return 0.0 }
        if r < 0 or r >= _rowImages.len() { return 0.0 }
        if _rowImages[r] == "" { return 0.0 }
        float imgSize = _imgSize
        if imgSize <= 0.0 { imgSize = _rowH - 8.0 }
        if imgSize <= 0.0 { return 0.0 }
        return imgSize + _imgGap
    }

    // 惰性重建拟合文本缓存：遍历所有行×列，预计算截断文本和宽度
    func _ensure_fitted() {
        if _fittedValid { return }
        if _font == null or not _font.ok { return }
        _fittedText = []
        _fittedW = []
        float pad = 8.0
        for _rows.len() to r {
            for 0 : _ncols - 1 to c {
                string text = _cell(r, c)
                float iconOff = _compute_icon_off(r, c)
                float availW = _colW[c] - 2.0 * pad - iconOff
                string fitted = _fit_cell_text(text, availW)
                float fw = 0.0
                if fitted != "" { fw = _font.measureString(fitted).w }
                _fittedText.add(fitted)
                _fittedW.add(fw)
            }
        }
        _fittedValid = true
    }

    // 使用预计算的截断文本和宽度绘制单元格文字（跳过 _fit_cell_text 和 measureString）
    func _draw_cached_text(Renderer r, string dt, float tw, float cx, float cw, float ry, float rh, int align, int R, int G, int B, float iconOff) {
        if dt == "" { return }
        float th = _textH
        float ty = ry + (rh - th) / 2.0
        float pad = 8.0
        float tx
        switch align {
            case 2 { tx = cx + cw - pad - tw }
            case 1 { tx = cx + iconOff + (cw - iconOff - tw) / 2.0 }
            default { tx = cx + pad + iconOff }
        }
        if tx < cx + 2.0 { tx = cx + 2.0 }
        float cl = cx; if cl < x { cl = x }
        float crx = cx + cw; if crx > x + w { crx = x + w }
        if tx >= crx { return }
        r.drawText(_font, dt, r.snapX(tx), r.snapY(ty), R, G, B)
    }

    // 判断是否启用了图标列
    func _has_image_col(): bool { return _imageCol >= 0 }

    // 获取行 ri 的图标路径（越界或无图标返回空串）
    func _row_image(int ri): string {
        if ri < 0 or ri >= _rowImages.len() { return "" }
        return _rowImages[ri]
    }

    // 纹理缓存：按 path 取/载纹理，避免每帧重载与纹理泄漏
    // ★ MRU 快路径：文件管理器中连续多行常共用同一图标（如全部是文件夹），
    //   单槽快路径将 O(n) 线性扫描降为 O(1)，消除每行 string 比较开销
    func _get_tex(Renderer r, string path): Ptr[u8] {
        if path == _imgLastPath and _imgLastTex != null { return _imgLastTex }
        for _imgCachePaths.len() to i {
            if _imgCachePaths[i] == path {
                _imgLastPath = path; _imgLastTex = _imgCacheTex[i]
                return _imgCacheTex[i]
            }
        }
        Ptr[u8] t = img.loadTexture(r.handle, path)
        _imgCachePaths.add(path); _imgCacheTex.add(t)
        _imgLastPath = path; _imgLastTex = t
        return t
    }

    // 在图标列单元格内绘制 [图标+文字]（对齐 Treeview 的 icon+text 模式）
    // 返回图标占据的宽度（0 = 无图标），供调用方在文字绘制时偏移
    func _draw_cell_icon(Renderer r, string ipath, float cx, float ry, float rh): float {
        if ipath == "" { return 0.0 }
        Ptr[u8] tex = _get_tex(r, ipath)
        if tex == null { return 0.0 }
        float imgSize = _imgSize
        if imgSize <= 0.0 { imgSize = rh - 8.0 }
        if imgSize <= 0.0 { return 0.0 }
        float imgX = cx + _imgPad
        float imgY = ry + (rh - imgSize) / 2.0
        r.setTextureAlpha(tex, 255)
        r.setTextureColor(tex, 255, 255, 255)
        var nats = r.getTextureSize(tex)
        float nw = nats["w"], nh = nats["h"]
        switch _imgMode {
            case 1 {
                // stretch：直接拉伸填满
                r.drawTextureFromTo(tex, 0.0, 0.0, nw, nh, imgX, imgY, imgSize, imgSize)
            }
            case 2 {
                // aspectFill（裁边填满）：覆盖缩放 + 居中裁剪源矩形
                float s = imgSize / nw; if imgSize / nh > s { s = imgSize / nh }
                float sw = imgSize / s, sh = imgSize / s
                float sx = (nw - sw) / 2.0, sy = (nh - sh) / 2.0
                r.drawTextureFromTo(tex, sx, sy, sw, sh, imgX, imgY, imgSize, imgSize)
            }
            default {
                // aspectFit（默认，留边）：保持比例完整显示
                float s = imgSize / nw; if imgSize / nh < s { s = imgSize / nh }
                float dw = nw * s, dh = nh * s
                r.drawTextureFromTo(tex, 0.0, 0.0, nw, nh,
                    imgX + (imgSize - dw) / 2.0, imgY + (imgSize - dh) / 2.0, dw, dh)
            }
        }
        return imgSize + _imgGap   // 返回图标总占宽（含间距），文字需右移此量
    }

    func _draw_cell_text(Renderer r, string t, float cx, float cw, float ry, float rh, int align, int R, int G, int B, float iconOff) {
        if _font == null or not _font.ok { return }
        if t == "" { return }
        float th = _textH
        float ty = ry + (rh - th) / 2.0
        float pad = 8.0
        float availW = cw - 2.0 * pad - iconOff
        string dt = _fit_cell_text(t, availW)
        if dt == "" { return }
        float tw = _font.measureString(dt).w
        float tx
        switch align {
            case 2 { tx = cx + cw - pad - tw }
            case 1 { tx = cx + iconOff + (cw - iconOff - tw) / 2.0 }
            default { tx = cx + pad + iconOff }
        }
        if tx < cx + 2.0 { tx = cx + 2.0 }
        // 安全裁剪：tx 已 clamp，body clip 已覆盖数据区，无需 per-cell pushClipRect
        // （每格 push/pop 会产生 2 次 batch flush，12行×5列=120次/帧，导致闪烁）
        float cl = cx; if cl < x { cl = x }
        float crx = cx + cw; if crx > x + w { crx = x + w }
        if tx >= crx { return }
        r.drawText(_font, dt, r.snapX(tx), r.snapY(ty), R, G, B)
    }

    func render(Renderer r) {
        if not _loaded or not visible { return }
        _ensure_font()
        _ensure_fitted()   // ★ 惰性重建拟合文本缓存（仅在数据/列宽/字体变化后首次调到时计算）

        // 背景底色（在字体检查之前画，避免字体偶发未就绪时 Table 区域变透明露出容器底色 → 闪一下）
        int bgr = br, bgg = bg, bgb = bb
        if not enabled { bgr = br / 2; bgg = bg / 2; bgb = bb / 2 }
        r.setColor(bgr, bgg, bgb, 255)
        r.fillRect(x, y, w, h)

        if _font == null or not _font.ok { return }   // 字体无效时仍有背景，只跳过文字

        SDL_Rect clip = SDL_Rect.malloc()
        clip.x = _int(x); clip.y = _int(y)
        clip.w = _int(w) + 1; clip.h = _int(h) + 1   // +1 防止浮点坐标截断丢失亚像素，避免行边缘闪烁
        r.pushClipRect(clip.to_ptr())
        _clipBase = clip.to_ptr()

        var sb = _compute_sb()

        // 表头
        r.setColor(_hdrR, _hdrG, _hdrB, 255)
        r.fillRect(x, y, w, _headerH)
        for 0 : _ncols - 1 to c {
            float cx = _col_x(c)
            float cw = _colW[c]
            if cx + cw < x or cx > x + w { continue }
            // 复选框列表头：绘制全选/半选复选框
            if c == _checkCol and _checkCol >= 0 {
                int cnt = 0
                for _rowChecked.len() to i { if _rowChecked[i] { cnt = cnt + 1 } }
                bool partial = (cnt > 0 and cnt < _rowChecked.len())
                _draw_checkbox(r, cx, cw, y, _headerH, _checkHeaderState, partial)
            }
            if c < _headers.len() and c != _checkCol {
                string t = _headers[c]
                int htcR = _hdrTxtR, htcG = _hdrTxtG, htcB = _hdrTxtB
                if c == _sortCol {
                    if _sortDesc { t = t + " ▼" } else { t = t + " ▲" }
                }
                _draw_cell_text(r, t, cx, cw, y, _headerH, _headerAligns[c], htcR, htcG, htcB, 0.0)
            }
            r.setColor(_sepR, _sepG, _sepB, 130)
            r.drawLine(cx + cw, y, cx + cw, y + _headerH)
        }
        r.setColor(_sepR, _sepG, _sepB, 220)
        r.drawLine(x, y + _headerH, x + w, y + _headerH)

        // 数据行
        float bodyTop = y + _headerH
        float bodyH = h - _headerH - sb[1]
        float bodyW = w - sb[0]
        // 数据区裁剪：防止行渲染渗透到底部滚动条区域
        SDL_Rect bodyClip = SDL_Rect.malloc()
        bodyClip.x = _int(x); bodyClip.y = _int(bodyTop)
        bodyClip.w = _int(bodyW) + 1; bodyClip.h = _int(bodyH) + 1   // +1 覆盖浮点截断的亚像素
        r.pushClipRect(bodyClip.to_ptr())
        // 关键：把 _clipBase 临时换成 bodyClip，让 _draw_cell_text 内部恢复时回到 body 区
        // （否则恢复为全表 clip，后续行背景 fillRect 就会渗透到滚动条区域）
        _clipBase = bodyClip.to_ptr()
        int startRow = _int(_scrollY / _rowH)
        if startRow < 0 { startRow = 0 }
        int endRow = startRow + _int(bodyH / _rowH) + 2
        if endRow > _rows.len() - 1 { endRow = _rows.len() - 1 }
        for startRow : endRow to ri {
            float ry = bodyTop - _scrollY + ri * _rowH
            if ry + _rowH < bodyTop or ry > bodyTop + bodyH { continue }
            int rr = bgr, rg = bgg, rb = bgb
            if _is_sel(ri) { rr = _selR; rg = _selG; rb = _selB }
            eif ri == _hoverRow { rr = _hovR; rg = _hovG; rb = _hovB }
            eif _zebra and (ri % 2 == 1) { rr = _zebR; rg = _zebG; rb = _zebB }
            r.setColor(rr, rg, rb, 255)
            r.fillRect(x, ry, w, _rowH + 1.0)   // +1 覆盖亚像素间隙，防止行间闪烁
            if ri < _rows.len() {
                var row = _rows[ri]
                string imgPath = _row_image(ri)
                // 行级颜色：取本行文字色（0=用默认色）
                int rowR = tr, rowG = tg, rowB = tb
                if ri < _rowColors.len() and _rowColors[ri] != 0 {
                    int cval = _rowColors[ri]
                    rowR = (cval >> 16) & 255
                    rowG = (cval >> 8) & 255
                    rowB = cval & 255
                }
                for 0 : _ncols - 1 to c {
                    float cx = _col_x(c), cw = _colW[c]
                    if cx + cw < x or cx > x + w { continue }
                    // 复选框列：绘制行复选框
                    if c == _checkCol and _checkCol >= 0 {
                        _draw_checkbox(r, cx, cw, ry, _rowH, is_row_checked(ri), false)
                        r.setColor(_sepR, _sepG, _sepB, 70)
                        r.drawLine(cx + cw, ry, cx + cw, ry + _rowH)
                        continue
                    }
                    float iconOff = 0.0
                    if c == _imageCol and _has_image_col() {
                        iconOff = _draw_cell_icon(r, imgPath, cx, ry, _rowH)
                    }
                    if c < row.len() {
                        // ★ 使用预计算的拟合文本和宽度，跳过 _fit_cell_text + measureString
                        int fidx = ri * _ncols + c
                        string dt = ""
                        float dw = 0.0
                        if fidx < _fittedText.len() { dt = _fittedText[fidx]; dw = _fittedW[fidx] }
                        _draw_cached_text(r, dt, dw, cx, cw, ry, _rowH, _aligns[c], rowR, rowG, rowB, iconOff)
                    }
                    r.setColor(_sepR, _sepG, _sepB, 70)
                    r.drawLine(cx + cw, ry, cx + cw, ry + _rowH)
                }
            }
        }

        // 空状态提示：无数据时在数据区居中显示
        if _rows.len() == 0 and _emptyText != "" {
            float tw = _font.measureString(_emptyText).w
            float tx = x + (w - tw) / 2.0
            float ty = bodyTop + (bodyH - _textH) / 2.0
            r.setColor(_emptyR, _emptyG, _emptyB, 255)
            r.drawText(_font, _emptyText, r.snapX(tx), r.snapY(ty), _emptyR, _emptyG, _emptyB)
        }

        // 恢复表格整体裁剪区（滚动条/边框需全区域绘制）
        _clipBase = clip.to_ptr()
        r.popClipRect()
        bodyClip.free()

        if _dragCol >= 0 and _dragCol < _colW.len() {
            float ex = _col_x(_dragCol) + _colW[_dragCol]
            r.setColor(_selR, _selG, _selB, 255)
            r.drawLine(ex, y, ex, y + h)
        }

        r.setColor(_sepR, _sepG, _sepB, 220)
        r.drawRect(x, y, w, h)

        if sb[0] > 0.0 { _draw_vscroll(r, sb) }
        if sb[1] > 0.0 { _draw_hscroll(r, sb) }

        if _editing and _edit != null { _edit.render(r) }

        r.popClipRect(); clip.free()
    }

    func _draw_vscroll(Renderer r, Array[float] sb) {
        float vw = 8.0
        float sx = x + w - vw - 2.0
        float bodyH = h - _headerH - sb[1]
        float maxY = _max_scroll_y(); if maxY <= 0 { maxY = 1 }
        float track = bodyH - 4.0
        float contentH = _rows.len() * _rowH; if contentH <= 0 { contentH = 1 }
        float thumbH = maths.max(18.0, maths.min(bodyH * bodyH / contentH, bodyH))
        float thy = y + _headerH + 2.0 + (_scrollY / maxY) * (track - thumbH)
        r.setColor(_sbR, _sbG, _sbB, 180)
        r.fillRoundedRect(sx, y + _headerH + 2.0, vw, bodyH - 4.0, vw / 2.0)
        r.setColor(_sbR + 60, _sbG + 60, _sbB + 60, 255)
        r.fillRoundedRect(sx, thy, vw, thumbH, vw / 2.0)
    }
    func _draw_hscroll(Renderer r, Array[float] sb) {
        float hh = 8.0
        float sy = y + h - hh - 2.0
        float maxX = _max_scroll_x(); if maxX <= 0 { maxX = 1 }
        float bodyW = w - sb[0]
        float track = bodyW - 4.0
        float tw = _total_w(); if tw <= 0 { tw = 1 }
        float thumbW = maths.max(18.0, maths.min(bodyW * bodyW / tw, bodyW))
        float thx = x + 2.0 + (_scrollX / maxX) * (track - thumbW)
        r.setColor(_sbR, _sbG, _sbB, 180)
        r.fillRoundedRect(x + 2.0, sy, bodyW - 4.0, hh, hh / 2.0)
        r.setColor(_sbR + 60, _sbG + 60, _sbB + 60, 255)
        r.fillRoundedRect(thx, sy, thumbW, hh, hh / 2.0)
    }

    func dispose() {
        if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null
        _edit?.dispose(); _edit = null
        _ctxMenu?.dispose(); _ctxMenu = null
        // 纹理缓存仅清空引用：其由所属渲染器在销毁时统一释放，
        // 此处再 SDL_DestroyTexture 会造成 double-free/崩溃（见 sdl_font.leno 注释）
        _imgCacheTex = []; _imgCachePaths = []
        _imgLastPath = ""; _imgLastTex = null
        _fittedText = []; _fittedW = []; _fittedValid = false
    }
}

// 工厂
export func createTable(Dict opts): Table {
    Table t = new Table(); t.set(opts); return t
}
