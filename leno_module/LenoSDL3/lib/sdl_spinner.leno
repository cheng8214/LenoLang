// sdl_spinner.leno — 加载旋转动画指示器
// 通过 win.addSpinner({...}) 创建，用于异步操作时的加载反馈
// 旋转弧线动画，支持自定义大小/颜色/速度
import "sdl_renderer.leno" as ren; use ren.Renderer
import "sdl_event.leno" as evt; use evt.Event
import "sdl_core.leno" as core
import "sdl_widget.leno" as wgt; use wgt.Widget
import "sdl_theme.leno" as theme; use theme.(Theme, Themeable)
use theme.Color
import maths

export struct Spinner impl Widget {
    float x = 0.0, y = 0.0
    float _size = 32.0           // 直径
    float _thickness = 3.0       // 线条粗细
    Color _color = #64B4FFFF  // 旋转弧颜色
    Color _trackColor = #464A54FF  // 背景轨道色
    int _trackA = 80             // 背景轨道透明度
    float _speed = 270.0         // 旋转速度（度/秒）
    float _angle = 0.0           // 当前旋转角度
    float _lastTick = 0.0        // 上一帧时间戳
    bool _running = true         // 是否正在旋转
    bool _full = false           // 是否画整圆轨道（true=整圈背景+旋转缺口）
    bool visible = true, _loaded = false
    string _tip = ""

    func set(Dict opts) {
        Theme th = theme.getTheme()
        _color = theme.brighten(th.accent, 30)
        _trackColor = th.sep
        x      = opts.get("x", 0)
        y      = opts.get("y", 0)
        _size  = opts.get("size", 32)
        _thickness = opts.get("thickness", 3.0)
        _speed = opts.get("speed", 270.0)
        _running = opts.get("running", true)
        _full = opts.get("full_track", false)
        visible = opts.get("visible", true)
        _tip = opts.get("tip", "")
        var c = opts.get("color")
        if c is int { _color = c }
        var tc = opts.get("track_color")
        if tc is int { _trackColor = tc }
        _trackA = opts.get("track_alpha", 80)
        _loaded = true
    }

    // ==================== 设置方法 ====================
    func set_diameter(float s) { _size = s }
    func set_thickness(float t) { _thickness = t }
    func set_color(Color color) { _color = color }
    func set_speed(float s) { _speed = s }
    func start() { _running = true; _lastTick = 0.0 }
    func stop()  { _running = false; _angle = 0.0; _lastTick = 0.0 }
    func is_running(): bool { return _running }
    func set_visible(bool v) { visible = v }
    func is_visible(): bool { return visible }
    func set_enabled(bool e) {}
    func set_tip(string t) { _tip = t }

    // ==================== 查询方法 ====================
    func get_x(): float { return x }
    func get_y(): float { return y }
    func get_w(): float { return _size }
    func get_h(): float { return _size }
    func set_pos(float px, float py) { x = px; y = py }
    func set_size(float sw, float sh) { _size = if sw < sh then sw else sh }

    func process(Event ev) {}

    // ==================== 动画步进 ====================
    func _step() {
        if not _running { return }
        float now = _float(core.getTicks())
        if _lastTick > 0.0 {
            float dt = (now - _lastTick) / 1000.0
            _angle = _angle + _speed * dt
            if _angle >= 360.0 { _angle = _angle - 360.0 }
        }
        _lastTick = now
    }

    // ==================== 渲染 ====================
    func render(Renderer r) {
        if not _loaded or not visible { return }
        _step()
        if _running { core.requestRedraw() }

        float cx = x + _size / 2.0
        float cy = y + _size / 2.0
        float radius = _size / 2.0 - _thickness

        // 背景轨道（整圆）
        if _full or _trackA > 0 {
            r.setColor(theme.withAlpha(_trackColor, _trackA))
            _draw_arc(r, cx, cy, radius, 0.0, 360.0, _thickness)
        }

        // 旋转弧（约 120 度的弧段）
        if _running or _full {
            float a0 = _angle
            float a1 = _angle + 120.0
            r.setColor(_color)
            _draw_arc(r, cx, cy, radius, a0, a1, _thickness)
        }
    }

    // 用线段逼近圆弧（SDL3 无原生圆弧绘制）
    func _draw_arc(Renderer r, float cx, float cy, float radius, float a0, float a1, float thick) {
        if radius <= 0.0 { return }
        float span = a1 - a0
        if span <= 0.0 { return }
        int segs = _int(radius * span / 360.0 * 0.4)
        if segs < 4 { segs = 4 }
        if segs > 120 { segs = 120 }
        float step = span / _float(segs)
        float d2r = 3.14159265 / 180.0
        for 0 : segs to i {
            float aa = a0 + step * _float(i)
            float ab = a0 + step * _float(i + 1)
            float x1 = cx + radius * maths.cos(aa * d2r)
            float y1 = cy + radius * maths.sin(aa * d2r)
            float x2 = cx + radius * maths.cos(ab * d2r)
            float y2 = cy + radius * maths.sin(ab * d2r)
            r.drawLine(x1, y1, x2, y2)
        }
    }

    func dispose() {}
}

// 工厂
export func createSpinner(Dict opts): Spinner {
    Spinner s = new Spinner(); s.set(opts); return s
}
