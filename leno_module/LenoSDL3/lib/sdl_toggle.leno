// sdl_toggle.leno — 开关（滑块式）
// 通过 win.addToggle({...}) 创建，点击切换 on/off，回调 on_change(bool)
import "sdl_renderer.leno" as ren; use ren.Renderer
import "sdl_font.leno" as fnt; use fnt.Font
import "sdl_event.leno" as evt; use evt.Event
import "sdl_core.leno" as core; use core.SystemCursor
import "sdl_widget.leno" as wgt; use wgt.Widget
import "sdl_tooltip.leno" as tip
import "sdl_theme.leno" as theme; use theme.(Theme, Themeable)
use theme.Color

export struct Toggle impl Widget {
    string text = ""
    float x = 0.0, y = 0.0
    float w = 52.0, h = 28.0
    float _fontSize = 15.0
    string _fontPath = ""
    int _fontStyle = 0
    Font? _font
    bool _on = false
    Color _onColor = #3CAAF5FF
    Color _offColor = #464652FF
    Color _txtColor = #EBEBF5FF
    Color _knobColor = #FFFFFFFF       // 滑块填充色
    Color _knobBrdColor = #C8C8D2FF // 滑块边框色（浅色主题下确保可见）
    int _cursor = SystemCursor.DEFAULT
    bool hover = false, _wasHover = false, _pressed = false, enabled = true, visible = true, _loaded = false
    string _tip = ""           // 悬停提示文本（空 = 不提示）
    bool _animate = false
    float _animSpeed = 12.0, _animPos = 0.0, _animTarget = 0.0, _animLast = 0.0
    bool _animating = false
    float _fontH = 0.0          // 字体行高缓存（字体不变时为常量，避免每帧 measureString）
    func(bool):void _onChange

    func _ensure_font() {
        if _font == null or not _font.ok {
            if _font != null and _font.ok { fnt.releaseFont(_font) }
            if _fontPath != "" { _font = fnt.acquireFont(_fontPath, _fontSize) }
            else { _font = fnt.acquireFontAuto(_fontSize) }
            if _font.ok and _fontStyle != 0 { _font.setStyle(_fontStyle) }
            if _font.ok { _fontH = _font.measureString("Ag").h }
        }
    }

    func set(Dict opts) {
        Theme th = theme.getTheme()
        _onColor = th.accent
        _offColor = th.bgAlt
        _txtColor = th.txt
        _knobColor = th.txtOnAccent
        _knobBrdColor = th.border
        text      = opts.get("text", "")
        x         = opts.get("x", 0)
        y         = opts.get("y", 0)
        w         = opts.get("w", 52)
        h         = opts.get("h", 28)
        _fontSize = opts.get("font_size", 15)
        _fontPath = opts.get("font_path", "")
        _fontStyle = opts.get("font_style", 0)

        // 默认颜色见字段声明，以下仅 opts 覆盖

        // 颜色：opts 未传则保持默认值
        if opts.get("on_color") is Color => t { _onColor = t }
        if opts.get("off_color") is Color => t { _offColor = t }
        if opts.get("text_color") is Color => t { _txtColor = t }

        _cursor = opts.get("cursor", SystemCursor.DEFAULT)
        _on = opts.get("on", false)
        enabled = opts.get("enabled", true)
        visible = opts.get("visible", true)
        // hover/_wasHover/_pressed 默认见字段声明
        _tip = opts.get("tip", "")

        // 动画选项：anim=true 开启平滑滑动动画，anim_speed 控制速度
        _animate = opts.get("anim", false)
        _animSpeed = opts.get("anim_speed", 12.0)
        _animPos = if _on then 1.0 else 0.0
        _animTarget = _animPos
        _animLast = 0.0
        _animating = false

        _ensure_font()
        _loaded = true
    }

    func set_text(string t)    { text = t }
    func set_tip(string t)      { _tip = t }
    func set_on(bool o) {
        if _on != o {
            _on = o
            if _animate {
                _animTarget = if _on then 1.0 else 0.0
                _animating = true
                _animLast = 0.0
            } else {
                _animPos = if _on then 1.0 else 0.0
            }
        }
    }
    func is_on(): bool          { return _on }
    func get_anim_pos(): float  { return _animPos }   // 滑块当前显示位置（用于观察过渡）
    func set_enabled(bool e)     { enabled = e }
    func set_visible(bool v)      { visible = v }
    func is_visible(): bool       { return visible }
    func set_font_size(float s)  { _fontSize = s; if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null }
    func get_x(): float          { return x }
    func get_y(): float          { return y }
    func get_w(): float {
        _ensure_font()
        float tw = 0.0
        if _font != null and _font.ok and text != "" { tw = _font.measureString(text).w }
        return w + 10.0 + tw
    }
    func get_h(): float          { return h }
    func set_pos(float px, float py) { x = px; y = py }
    func set_size(float sw, float sh) {}

    func on_change(func(bool):void cb) { _onChange = cb }

    func contains(float mx, float my): bool {
        float tw = 0.0
        if _font != null and _font.ok and text != "" { tw = _font.measureString(text).w }
        float totalW = w + 10.0 + tw
        return mx >= x and mx <= x + totalW and my >= y and my <= y + h
    }

    func process(Event ev) {
        if not _loaded { return }
        if not visible { return }
        if not enabled { hover = false; _pressed = false; return }
        // 弹层捕获：事件落在“他人的弹层（如打开的菜单/下拉）范围内时忽略，避免穿透到下层控件
        float mx = ev.mouseX(), my = ev.mouseY()
        if ev.isMouseWheel() { mx = ev.wheelMouseX(); my = ev.wheelMouseY() }
        if core.inPopupCapture(mx, my) { return }


        if ev.isMouseMotion() {
            _wasHover = hover
            hover = contains(ev.mouseX(), ev.mouseY())
            if _cursor >= 0 {
                if hover { core.requestCursor(_cursor) }
            }
            // 悬停提示：hover 时上报；离开由 tipEndMotion 统一清除
            if hover and _tip != "" { tip.tipReport(_tip, ev.mouseX(), ev.mouseY()) }
        }

        if ev.isMouseButtonUp() { _pressed = false }

        if ev.isMouseButtonDown() and hover and not _pressed {
            _pressed = true
            _on = not _on
            if _animate {
                _animTarget = if _on then 1.0 else 0.0
                _animating = true
                _animLast = 0.0
            } else {
                _animPos = if _on then 1.0 else 0.0
            }
            if _onChange != null { _onChange(_on) }
        }
    }

    // ==================== 动画步进（每帧由 render 调用） ====================
    func _step_anim() {
        if not _animating { return }
        if _animSpeed <= 0.0 { _animPos = _animTarget; _animating = false; return }  // 关闭动画：立即到位
        float now = _float(core.getTicks())
        float dt = 0.0
        if _animLast > 0.0 { dt = (now - _animLast) / 1000.0 }
        _animLast = now
        float diff = _animTarget - _animPos
        float ad = diff
        if ad < 0.0 { ad = -ad }
        if ad <= 0.001 {
            _animPos = _animTarget
            _animating = false
        } else if dt > 0.0 {
            float f = _animSpeed * dt
            if f > 1.0 { f = 1.0 }
            _animPos += diff * f
        }
    }

    func render(Renderer r) {
        if not _loaded { return }
        if not visible { return }
        _ensure_font()
        _step_anim()
        if _animating { core.requestRedraw() }

        // 轨道（颜色按动画位置在 关闭色↔开启色 之间平滑过渡）
        int offR = theme.colorR(_offColor); int offG = theme.colorG(_offColor); int offB = theme.colorB(_offColor)
        int onR  = theme.colorR(_onColor);  int onG  = theme.colorG(_onColor);  int onB  = theme.colorB(_onColor)
        int trkR = _int(offR + _animPos * (onR - offR))
        int trkG = _int(offG + _animPos * (onG - offG))
        int trkB = _int(offB + _animPos * (onB - offB))
        int trkA = _int(theme.colorA(_offColor) + _animPos * (theme.colorA(_onColor) - theme.colorA(_offColor)))
        if hover { trkR = trkR + 20; trkG = trkG + 20; trkB = trkB + 20
                   if trkR > 255 { trkR = 255 }; if trkG > 255 { trkG = 255 }; if trkB > 255 { trkB = 255 } }
        if not enabled { trkR = offR / 2; trkG = offG / 2; trkB = offB / 2 }
        r.setColor(theme.packColor(trkR, trkG, trkB, trkA))
        r.fillRoundedRect(x, y, w, h, h / 2.0)

        // 滑块（按动画位置在 左↔右 之间平滑滑动）
        float knob = h - 6.0
        float kxOff = x + 3.0
        float kxOn  = x + w - 3.0 - knob
        float kx = kxOff + _animPos * (kxOn - kxOff)
        r.setColor(_knobColor)
        r.fillRoundedRect(kx, y + 3.0, knob, knob, knob / 2.0)
        // 浅色主题下滑块可能与轨道重合，添加边框确保可见
        r.setColor(theme.withAlpha(_knobBrdColor, 130))
        r.drawRoundedRect(kx, y + 3.0, knob, knob, knob / 2.0)

        // 文字
        if _font != null and _font.ok and text != "" {
            float cy = y + (h - _fontH) / 2.0
            Color tc = _txtColor
            if not enabled { tc = theme.packColor(theme.colorR(_txtColor) / 2, theme.colorG(_txtColor) / 2, theme.colorB(_txtColor) / 2) }
            r.drawText(_font, text, x + w + 10.0, cy, tc)
        }
    }

    func dispose() {
        if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null
    }
}

export func createToggle(Dict opts): Toggle {
    Toggle t = new Toggle(); t.set(opts); return t
}
