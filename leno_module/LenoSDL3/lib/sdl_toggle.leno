// sdl_toggle.leno — 开关（滑块式）
// 通过 win.addToggle({...}) 创建，点击切换 on/off，回调 on_change(bool)
import "sdl_renderer.leno" as ren; use ren.Renderer
import "sdl_font.leno" as fnt; use fnt.Font
import "sdl_event.leno" as evt; use evt.Event
import "sdl_core.leno" as core; use core.SystemCursor
import "sdl_widget.leno" as wgt; use wgt.Widget
import "sdl_tooltip.leno" as tip

export struct Toggle impl Widget {
    string text = ""
    float x = 0.0; float y = 0.0
    float w = 52.0; float h = 28.0
    float _fontSize = 16.0
    string _fontPath = ""
    int _fontStyle = 0
    Font  _font
    bool _on = false
    int _onR = 60; int _onG = 170; int _onB = 245
    int _offR = 70; int _offG = 70; int _offB = 82
    int tr = 235; int tg = 235; int tb = 245
    int _cursor = SystemCursor.DEFAULT
    bool hover = false
    bool _wasHover = false
    bool _pressed = false
    bool enabled = true
    bool visible = true
    bool _loaded = false
    string _tip = ""           // 悬停提示文本（空 = 不提示）
    bool _animate = false
    float _animSpeed = 12.0
    float _animPos = 0.0
    float _animTarget = 0.0
    float _animLast = 0.0
    bool _animating = false
    func(bool):void _onChange

    func _ensure_font() {
        if _font == null or not _font.ok {
            if _font != null { _font.close() }
            if _fontPath != "" { _font = fnt.createFont(_fontPath, _fontSize) }
            else { _font = fnt.createFontAuto(_fontSize) }
            if _font.ok and _fontStyle != 0 { _font.setStyle(_fontStyle) }
        }
    }

    func set(Dict opts) {
        text      = opts.get("text", "") as string
        x         = _float(opts.get("x", 0))
        y         = _float(opts.get("y", 0))
        w         = _float(opts.get("w", 52))
        h         = _float(opts.get("h", 28))
        _fontSize = _float(opts.get("font_size", 16))
        _fontPath = opts.get("font_path", "") as string
        _fontStyle = _int(opts.get("font_style", 0))

        // 默认颜色见字段声明（_onR/_onG/_onB/_offR/_offG/_offB/tr/tg/tb 均有默认，以下仅 opts 覆盖）

        // 颜色可被 dict 覆盖（[r,g,b]）
        var onc = opts.get("on_rgb")
        if onc is Array[int] { _onR = _int(onc[0]); _onG = _int(onc[1]); _onB = _int(onc[2]) }
        var ofc = opts.get("off_rgb")
        if ofc is Array[int] { _offR = _int(ofc[0]); _offG = _int(ofc[1]); _offB = _int(ofc[2]) }
        var ttc = opts.get("text_rgb")
        if ttc is Array[int] { tr = _int(ttc[0]); tg = _int(ttc[1]); tb = _int(ttc[2]) }

        _cursor = _int(opts.get("cursor", SystemCursor.DEFAULT))
        _on = _bool(opts.get("on", false))
        enabled = _bool(opts.get("enabled", true))
        visible = _bool(opts.get("visible", true))
        // hover/_wasHover/_pressed 默认见字段声明
        _tip = opts.get("tip", "") as string

        // 动画选项：anim=true 开启平滑滑动动画，anim_speed 控制速度
        _animate = _bool(opts.get("anim", false))
        _animSpeed = _float(opts.get("anim_speed", 12.0))
        _animPos = if _on then 1.0 else 0.0
        _animTarget = _animPos
        _animLast = 0.0
        _animating = false

        _ensure_font()
        _loaded = true
    }

    func set_text(string t)    { text = t }
    func set_tip(string t)      { _tip = t }
    func set_on(bool o) {
        if _on != o {
            _on = o
            if _animate {
                _animTarget = if _on then 1.0 else 0.0
                _animating = true
                _animLast = 0.0
            } else {
                _animPos = if _on then 1.0 else 0.0
            }
        }
    }
    func is_on(): bool          { return _on }
    func get_anim_pos(): float  { return _animPos }   // 滑块当前显示位置（用于观察过渡）
    func set_enabled(bool e)     { enabled = e }
    func set_visible(bool v)      { visible = v }
    func is_visible(): bool       { return visible }
    func set_font_size(float s)  { _fontSize = s; if _font != null { _font.close(); _font = null } }
    func get_x(): float          { return x }
    func get_y(): float          { return y }
    func get_w(): float {
        _ensure_font()
        float tw = 0.0
        if _font != null and _font.ok and text != "" { tw = _float(_font.measureString(text).w) }
        return w + 10.0 + tw
    }
    func get_h(): float          { return h }
    func set_pos(float px, float py) { x = px; y = py }
    func set_size(float sw, float sh) {}

    func on_change(func(bool):void cb) { _onChange = cb }

    func contains(float mx, float my): bool {
        float tw = 0.0
        if _font != null and _font.ok and text != "" { tw = _float(_font.measureString(text).w) }
        float totalW = w + 10.0 + tw
        return mx >= x and mx <= x + totalW and my >= y and my <= y + h
    }

    func process(Event ev) {
        if not _loaded { return }
        if not visible { return }
        if not enabled { hover = false; _pressed = false; return }
        // 弹层捕获：事件落在“他人的弹层（如打开的菜单/下拉）范围内时忽略，避免穿透到下层控件
        float mx = ev.mouseX(); float my = ev.mouseY()
        if ev.isMouseWheel() { mx = ev.wheelMouseX(); my = ev.wheelMouseY() }
        if core.inPopupCapture(mx, my) { return }


        if ev.isMouseMotion() {
            _wasHover = hover
            hover = contains(ev.mouseX(), ev.mouseY())
            if _cursor >= 0 {
                if hover and not _wasHover { core.setSystemCursor(_cursor) }
                if not hover and _wasHover { core.setSystemCursor(SystemCursor.DEFAULT) }
            }
            // 悬停提示：进入上报、离开清除
            if hover and _tip != "" { tip.tipReport(_tip, ev.mouseX(), ev.mouseY()) }
            else if _wasHover and not hover { tip.tipClear() }
        }

        if ev.isMouseButtonUp() { _pressed = false }

        if ev.isMouseButtonDown() and hover and not _pressed {
            _pressed = true
            _on = not _on
            if _animate {
                _animTarget = if _on then 1.0 else 0.0
                _animating = true
                _animLast = 0.0
            } else {
                _animPos = if _on then 1.0 else 0.0
            }
            if _onChange != null { _onChange(_on) }
        }
    }

    // ==================== 动画步进（每帧由 render 调用） ====================
    func _step_anim() {
        if not _animating { return }
        if _animSpeed <= 0.0 { _animPos = _animTarget; _animating = false; return }  // 关闭动画：立即到位
        float now = _float(core.getTicks())
        float dt = 0.0
        if _animLast > 0.0 { dt = (now - _animLast) / 1000.0 }
        _animLast = now
        float diff = _animTarget - _animPos
        float ad = diff
        if ad < 0.0 { ad = -ad }
        if ad <= 0.001 {
            _animPos = _animTarget
            _animating = false
        } else if dt > 0.0 {
            float f = _animSpeed * dt
            if f > 1.0 { f = 1.0 }
            _animPos += diff * f
        }
    }

    func render(Renderer r) {
        if not _loaded { return }
        if not visible { return }
        _ensure_font()
        _step_anim()

        // 轨道（颜色按动画位置在 关闭色↔开启色 之间平滑过渡）
        int trkR = _int(_offR + _animPos * (_onR - _offR))
        int trkG = _int(_offG + _animPos * (_onG - _offG))
        int trkB = _int(_offB + _animPos * (_onB - _offB))
        if hover { trkR = trkR + 20; trkG = trkG + 20; trkB = trkB + 20
                   if trkR > 255 { trkR = 255 }; if trkG > 255 { trkG = 255 }; if trkB > 255 { trkB = 255 } }
        if not enabled { trkR = _offR / 2; trkG = _offG / 2; trkB = _offB / 2 }
        r.setColor(trkR, trkG, trkB, 255)
        r.fillRoundedRect(x, y, w, h, h / 2.0)

        // 滑块（按动画位置在 左↔右 之间平滑滑动）
        float knob = h - 6.0
        float kxOff = x + 3.0
        float kxOn  = x + w - 3.0 - knob
        float kx = kxOff + _animPos * (kxOn - kxOff)
        r.setColor(245, 245, 250, 255)
        r.fillRoundedRect(kx, y + 3.0, knob, knob, knob / 2.0)

        // 文字
        if _font != null and _font.ok and text != "" {
            float cy = y + (h - _float(_font.measureString("Ag").h)) / 2.0
            int tcR = tr; int tcG = tg; int tcB = tb
            if not enabled { tcR = tr / 2; tcG = tg / 2; tcB = tb / 2 }
            r.drawText(_font, text, x + w + 10.0, cy, tcR, tcG, tcB)
        }
    }

    func dispose() {
        if _font != null { _font.close(); _font = null }
    }
}

export func createToggle(Dict opts): Toggle {
    Toggle t = new Toggle(); t.set(opts); return t
}
