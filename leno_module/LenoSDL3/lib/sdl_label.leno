// sdl_label.leno — 标签控件
// 通过 win.addLabel({...}) 创建，支持多行、对齐、自动换行
import "sdl_renderer.leno" as ren; use ren.Renderer
import "sdl_font.leno" as fnt; use fnt.Font
import "sdl_event.leno" as evt; use evt.Event
import "sdl_core.leno" as core
use core.SDL_Rect
import "sdl_widget.leno" as wgt; use wgt.Widget
import "sdl_tooltip.leno" as tip
import "sdl_theme.leno" as theme; use theme.(Theme, Themeable)

export struct Label impl Widget, Themeable {
    // ==================== 关联常量 ====================
    const ALIGN_LEFT   = 0   // 左对齐
    const ALIGN_CENTER = 1   // 居中对齐
    const ALIGN_RIGHT  = 2   // 右对齐

    const TRUNCATE_NONE     = 0   // 不截断
    const TRUNCATE_ELLIPSIS = 1   // 截断显示省略号
    const TRUNCATE_SCROLL   = 2   // 滚动显示

    string text = ""
    float x = 0.0, y = 0.0
    float _fontSize = 15.0       // 字体大小
    string _fontPath = ""        // 字体路径（空则自动匹配）
    int _fontStyle = 0           // 字体样式
    Font? _font                  // 字体缓存
    int _txtColor = #FFFFFFFF  // 文字色
    int _align = ALIGN_LEFT          // 对齐（ALIGN_LEFT/CENTER/RIGHT）
    float _w = 0.0; float _h = 16.0  // 缓存自然尺寸（供布局使用）
    bool _loaded = false
    bool visible = true
    bool enabled = true
    bool hover = false, _wasHover = false
    string _tip = ""             // 悬停提示文本（空 = 不提示）
    // ── 截断/滚动支持 ──
    float max_w = 0.0            // 最大显示宽度（>0 时启用截断或滚动）
    int _truncate = TRUNCATE_NONE    // 截断模式（TRUNCATE_NONE/ELLIPSIS/SCROLL）
    string _fullText = ""        // 完整文本（截断模式下 tooltip 用）
    float _scrollOffset = 0.0    // 滚动偏移（像素）
    int _scrollDir = 1           // 滚动方向: 1=右→左, -1=左→右
    int _scrollLastTick = 0      // 上次滚动时间戳

    func _ensure_font() {
        if _font == null or not _font.ok {
            if _font != null and _font.ok { fnt.releaseFont(_font) }
            if _fontPath != "" {
                _font = fnt.acquireFont(_fontPath, _fontSize)
            } else {
                _font = fnt.acquireFontAuto(_fontSize)
            }
            if _font.ok and _fontStyle != 0 { _font.setStyle(_fontStyle) }
        }
    }

    // ==================== set 初始化 ====================
    func set(Dict opts) {
        Theme th = theme.getTheme()
        _txtColor = th.txt
        text      = opts.get("text", "")
        x         = opts.get("x", 0)
        y         = opts.get("y", 0)
        _fontSize = opts.get("font_size", 15)
        _fontPath = opts.get("font_path", "")
        _fontStyle = opts.get("font_style", 0)

        // 文字色见字段声明默认白色，以下仅 opts 覆盖
        var tc = opts.get("text_color")
        if tc is int { _txtColor = tc }

        // 对齐
        _align = opts.get("align", ALIGN_LEFT)

        _ensure_font()
        if _font.ok {
            if text != "" { _w = _font.measureString(text).w } else { _w = 0.0 }
            _h = _font.measureString("Ag").h
        } else { _w = 0.0; _h = 16.0 }
        // hover/_wasHover 默认见字段声明
        _tip = opts.get("tip", "")
        // 截断/滚动支持
        max_w = opts.get("max_w", 0.0)
        _truncate = opts.get("truncate", TRUNCATE_NONE)
        _fullText = text
        _scrollOffset = 0.0
        _scrollDir = 1
        _scrollLastTick = 0
        visible = opts.get("visible", true)
        enabled = opts.get("enabled", true)
        _loaded = true
    }

    // ==================== 设置方法 ====================
    func set_text(string t)        {
        text = t
        _fullText = t
        _scrollOffset = 0.0
        _scrollLastTick = 0
        if _font != null and _font.ok {
            if text != "" { _w = _font.measureString(text).w } else { _w = 0.0 }
            _h = _font.measureString("Ag").h
        }
    }
    func set_text_color(int color) { _txtColor = color }
    func set_font_size(float s) {
        _fontSize = s
        if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null
    }
    func set_font_path(string p) {
        _fontPath = p
        if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null
    }
    func set_font_style(int style) {
        _fontStyle = style
        _ensure_font()
        if _font.ok { _font.setStyle(style) }
    }
    func set_align(int a) { _align = a }
    func set_tip(string t) { _tip = t }
    func set_visible(bool v) { visible = v }
    func is_visible(): bool { return visible }
    func set_enabled(bool e) { enabled = e }
    func is_enabled(): bool { return enabled }
    func set_max_w(float w) { max_w = w }
    func set_truncate(int mode) { _truncate = mode; _scrollOffset = 0.0; _scrollLastTick = 0 }

    // ── 截断文本：测量并裁剪出适合 max_w 的 "前缀...后缀" 形式 ──
    func _truncatedText(): string {
        if max_w <= 0.0 or _font == null or not _font.ok { return text }
        var ms = _font.measureString(text)
        if ms.w <= max_w { return text }
        // 省略号宽度
        string ellipsis = "..."
        var es = _font.measureString(ellipsis)
        float avail = max_w - es.w
        if avail <= 0.0 { return ellipsis }
        // 从尾部截取后缀（约占可用空间的 40%）
        int textLen = text.len()
        int tailStart = textLen
        float tailW = 0.0
        for textLen - 1 : 0 to i {
            string ch = text.slice(i, i + 1)
            var cs = _font.measureString(ch)
            if tailW + cs.w > avail * 0.4 { tailStart = i + 1; break }
            tailW = tailW + cs.w
            tailStart = i
        }
        string tail = text.slice(tailStart, textLen)
        // 从头部截取前缀（填满剩余空间）
        float headW = 0.0
        int headEnd = 0
        for 0 : textLen - 1 to i {
            string ch = text.slice(i, i + 1)
            var cs = _font.measureString(ch)
            if headW + cs.w > avail - tailW { headEnd = i; break }
            headW = headW + cs.w
            headEnd = i + 1
        }
        string head = text.slice(0, headEnd)
        return head + ellipsis + tail
    }

    // ==================== 查询方法 ====================
    func get_text(): string  { return text }
    func get_x(): float      { return x }
    func get_y(): float      { return y }
    func get_w(): float      { return _w }
    func get_h(): float      { return _h }
    func set_pos(float px, float py) { x = px; y = py }
    func set_size(float sw, float sh) { _w = sw; _h = sh }

    // 标签仅用于悬停提示检测（其余输入不参与）
    func process(Event ev) {
        if not _loaded or not enabled or not visible { return }
        if not ev.isMouseMotion() { return }
        float mx = ev.mouseX(); float my = ev.mouseY()
        // ★ 弹层捕获：与 Button/Toggle 等控件一致，弹层打开时不响应 hover
        if core.inPopupCapture(mx, my) { hover = false; return }
        _wasHover = hover
        hover = mx >= x and mx <= x + _w and my >= y and my <= y + _h
        // 截断模式：hover 时显示完整文本
        if hover and _truncate == TRUNCATE_ELLIPSIS and max_w > 0.0 and _fullText != "" {
            tip.tipReport(_fullText, mx, my)
        } else if hover and _tip != "" {
            tip.tipReport(_tip, mx, my)
        }
        core.markFrameMotion()
    }

    // ==================== 渲染 ====================
    func render(Renderer r) {
        if not _loaded or not enabled or not visible { return }
        _ensure_font()
        if _font == null or not _font.ok { return }
        if text == "" { return }

        // ── 截断模式 ──
        if _truncate == TRUNCATE_ELLIPSIS and max_w > 0.0 {
            var ms = _font.measureString(text)
            if ms.w <= max_w {
                // 不需要截断，正常绘制
                float drawX = x
                if _align == ALIGN_CENTER { drawX = x - ms.w / 2.0 }
                if _align == ALIGN_RIGHT { drawX = x - ms.w }
                r.drawText(_font, text, drawX, y, _txtColor)
                return
            }
            // 截断绘制
            string truncText = _truncatedText()
            r.drawText(_font, truncText, x, y, _txtColor)
            return
        }

        // ── 滚动模式 ──
        if _truncate == TRUNCATE_SCROLL and max_w > 0.0 {
            var ms = _font.measureString(text)
            if ms.w <= max_w {
                // 不需要滚动，正常绘制
                float drawX = x
                if _align == ALIGN_CENTER { drawX = x - ms.w / 2.0 }
                if _align == ALIGN_RIGHT { drawX = x - ms.w }
                r.drawText(_font, text, drawX, y, _txtColor)
                return
            }
            // 更新滚动偏移
            int now = core.getTicks()
            if _scrollLastTick == 0 { _scrollLastTick = now }
            int dt = now - _scrollLastTick
            if dt > 0 {
                _scrollOffset = _scrollOffset + _float(dt) * 0.03 * _float(_scrollDir)
                _scrollLastTick = now
            }
            // 滚动范围：从 0 到 -(textWidth - max_w + 20)
            float scrollRange = ms.w - max_w + 20.0
            if _scrollDir == 1 {
                if _scrollOffset >= scrollRange {
                    _scrollOffset = scrollRange
                    _scrollDir = -1
                }
            } else {
                if _scrollOffset <= 0.0 {
                    _scrollOffset = 0.0
                    _scrollDir = 1
                }
            }
            // 用裁剪矩形绘制
            SDL_Rect clip = SDL_Rect.malloc()
            clip.x = _int(x); clip.y = _int(y)
            clip.w = _int(max_w); clip.h = _int(_h + 2)
            r.pushClipRect(clip)
            r.drawText(_font, text, x - _scrollOffset, y, _txtColor)
            r.popClipRect()
            clip.free()
            core.markFrameRedraw()
            return
        }

        // ── 普通绘制 ──
        var ms = _font.measureString(text)
        float drawX = x
        if _align == ALIGN_LEFT { drawX = x }                          // 左对齐
        if _align == ALIGN_CENTER { drawX = x - ms.w / 2.0 }     // 居中
        if _align == ALIGN_RIGHT { drawX = x - ms.w }           // 右对齐

        r.drawText(_font, text, drawX, y, _txtColor)
    }

// 释放字体资源
func dispose() {
if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null
}

// ==================== 运行时主题切换 ====================
func applyTheme(Theme t) {
_txtColor = t.txt
}
}

// 工厂
export func createLabel(Dict opts): Label {
    Label lbl = new Label(); lbl.set(opts); return lbl
}
