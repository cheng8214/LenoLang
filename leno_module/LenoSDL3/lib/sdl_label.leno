// sdl_label.leno — 标签控件
// 通过 win.addLabel({...}) 创建，支持多行、对齐、自动换行
import "sdl_renderer.leno" as ren; use ren.Renderer
import "sdl_font.leno" as fnt; use fnt.Font
import "sdl_event.leno" as evt; use evt.Event
import "sdl_widget.leno" as wgt; use wgt.Widget
import "sdl_tooltip.leno" as tip

export struct Label impl Widget {
    string text
    float x; float y
    float _fontSize              // 字体大小
    string _fontPath             // 字体路径（空则自动匹配）
    int _fontStyle               // 字体样式
    Font  _font                  // 字体缓存
    int tr; int tg; int tb       // 文字色
    int _align                   // 对齐: 0=左, 1=中, 2=右
    float _w; float _h           // 缓存自然尺寸（供布局使用）
    bool _loaded
    bool visible
    bool hover; bool _wasHover
    string _tip             // 悬停提示文本（空 = 不提示）

    func _ensure_font() {
        if _font == null or not _font.ok {
            if _font != null { _font.close() }
            if _fontPath != "" {
                _font = fnt.createFont(_fontPath, _fontSize)
            } else {
                _font = fnt.createFontAuto(_fontSize)
            }
            if _font.ok and _fontStyle != 0 { _font.setStyle(_fontStyle) }
        }
    }

    // ==================== set 初始化 ====================
    func set(Dict opts) {
        text      = opts.get("text", "") as string
        x         = _float(opts.get("x", 0))
        y         = _float(opts.get("y", 0))
        _fontSize = _float(opts.get("font_size", 16))
        _fontPath = opts.get("font_path", "") as string
        _fontStyle = _int(opts.get("font_style", 0))

        // 文字色（默认白色）
        tr = 255; tg = 255; tb = 255
        var tc = opts.get("text_rgb")
        if tc is Array[int] { tr = _int(tc[0]); tg = _int(tc[1]); tb = _int(tc[2]) }

        // 对齐
        _align = _int(opts.get("align", 0))

        _ensure_font()
        if _font != null and _font.ok {
            if text != "" { _w = _float(_font.measureString(text).w) } else { _w = 0.0 }
            _h = _float(_font.measureString("Ag").h)
        } else { _w = 0.0; _h = 16.0 }
        hover = false; _wasHover = false
        _tip = opts.get("tip", "") as string
        visible = _bool(opts.get("visible", true))
        _loaded = true
    }

    // ==================== 设置方法 ====================
    func set_text(string t)        {
        text = t
        if _font != null and _font.ok {
            if text != "" { _w = _float(_font.measureString(text).w) } else { _w = 0.0 }
            _h = _float(_font.measureString("Ag").h)
        }
    }
    func set_text_rgb(int r, int g, int b) { tr = r; tg = g; tb = b }
    func set_font_size(float s) {
        _fontSize = s
        if _font != null { _font.close(); _font = null }
    }
    func set_font_path(string p) {
        _fontPath = p
        if _font != null { _font.close(); _font = null }
    }
    func set_font_style(int style) {
        _fontStyle = style
        _ensure_font()
        if _font != null and _font.ok { _font.setStyle(style) }
    }
    func set_align(int a) { _align = a }
    func set_tip(string t) { _tip = t }
    func set_visible(bool v) { visible = v }
    func is_visible(): bool { return visible }

    // ==================== 查询方法 ====================
    func get_text(): string  { return text }
    func get_x(): float      { return x }
    func get_y(): float      { return y }
    func get_w(): float      { return _w }
    func get_h(): float      { return _h }
    func set_pos(float px, float py) { x = px; y = py }
    func set_size(float sw, float sh) { _w = sw; _h = sh }

    // 标签仅用于悬停提示检测（其余输入不参与）
    func process(Event ev) {
        if not _loaded { return }
        if not visible { return }
        if not ev.isMouseMotion() { return }
        _wasHover = hover
        float mx = ev.mouseX(); float my = ev.mouseY()
        hover = mx >= x and mx <= x + _w and my >= y and my <= y + _h
        if hover and _tip != "" { tip.tipReport(_tip, mx, my) }
        else if _wasHover and not hover { tip.tipClear() }
    }

    // ==================== 渲染 ====================
    func render(Renderer r) {
        if not _loaded { return }
        if not visible { return }
        _ensure_font()
        if _font == null or not _font.ok { return }
        if text == "" { return }

        var ms = _font.measureString(text)
        float drawX = x
        if _align == 0 { drawX = x }                          // 左对齐
        if _align == 1 { drawX = x - _float(ms.w) / 2.0 }     // 居中
        if _align == 2 { drawX = x - _float(ms.w) }           // 右对齐

        r.drawText(_font, text, drawX, y, tr, tg, tb)
    }

    // 释放字体资源
    func dispose() {
        if _font != null { _font.close(); _font = null }
    }
}

// 工厂
export func createLabel(Dict opts): Label {
    Label lbl = new Label(); lbl.set(opts); return lbl
}
