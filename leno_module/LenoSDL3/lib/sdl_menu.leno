// sdl_menu.leno — 菜单栏控件（顶部菜单 + 下拉项 + 子菜单 + 右键上下文）
// 通过 win.addMenuBar({...}) 创建，点击顶部标题展开下拉，悬停含子菜单的项弹出二级，
// 点击叶子项触发回调；点击空白处 / 切换标题 / Esc 关闭。下拉层走第二遍 renderPopup，
// 复用 sdl_core 的弹层捕获区机制（setPopupCapture），与 ComboBox 同一范式。
//
// 用法：
//   var bar = win.addMenuBar({
//     x: 0, y: 0, w: 600, h: 28,
//     menus: [
//       { title: "文件", items: [
//           { label: "新建", id: "new", shortcut: "Ctrl+N", action: func():void { ... } },
//           { label: "最近打开", submenu: [ {label:"a.txt", id:"recent1"}, ... ] },
//           { separator: true },
//           { label: "退出", id: "exit" },
//       ]},
//       { title: "帮助", items: [ { label: "关于", id: "about" } ] },
//     ]
//   })
//   bar.on_select(func(string menu, string id) { print(menu + " -> " + id) })
import "sdl_renderer.leno" as ren; use ren.Renderer
import "sdl_font.leno" as fnt; use fnt.Font
import "sdl_event.leno" as evt; use evt.Event
import "sdl_core.leno" as core; use core.SystemCursor; use core.Scancode; use core.SDL_Rect
import "sdl_widget.leno" as wgt; use wgt.Widget

// 单个菜单项（可被子菜单嵌套）
export struct MenuItem {
    string label
    string id
    string shortcut
    bool enabled
    bool separator
    Array[MenuItem] submenu
    func():void action
}

// 由 Dict 构造一个 MenuItem（递归支持子菜单）。供解析与构建器共用。
func _makeItem(Dict d): MenuItem {
    MenuItem mi = new MenuItem()
    mi.label     = d.get("label", "") as string
    mi.id        = d.get("id", mi.label) as string
    mi.shortcut  = d.get("shortcut", "") as string
    mi.enabled   = _bool(d.get("enabled", true))
    mi.separator = _bool(d.get("separator", false))
    mi.action    = d.get("action", null) as func():void
    var sub = d.get("submenu", [])
    if sub is Array[Dict] { mi.submenu = parseMenuItems(sub as Array[Dict]) }
    else { mi.submenu = [] }
    return mi
}

// 把用户传入的 Array[Dict] 解析为 Array[MenuItem]（递归支持子菜单）
export func parseMenuItems(Array[Dict] src): Array[MenuItem] {
    Array[MenuItem] out = []
    for src.len() to i { out.add(_makeItem(src[i])) }
    return out
}

// ==================== 几何辅助（模块级，供命中判定/绘制共用） ====================
func _colW(Array[MenuItem] items, Font f, float itemH): float {
    float mw = 120.0
    for items.len() to i {
        var it = items[i]
        if it.separator { continue }
        float w = 60.0
        if f != null and f.ok { w = _float(f.measureString(it.label).w) }
        if it.shortcut != "" and f != null and f.ok { w = w + 16.0 + _float(f.measureString(it.shortcut).w) }
        if w > mw { mw = w }
    }
    return mw + 20.0
}
func _panelH(Array[MenuItem] items, float itemH): float {
    float hh = 0.0
    for items.len() to i {
        if items[i].separator { hh = hh + 9.0 } else { hh = hh + itemH }
    }
    return hh
}
func _itemOffsets(Array[MenuItem] items, float itemH): Array[float] {
    Array[float] offs = []
    float y = 0.0
    for items.len() to i {
        offs.add(y)
        if items[i].separator { y = y + 9.0 } else { y = y + itemH }
    }
    return offs
}
func _itemAt(Array[MenuItem] items, float px, float py, float pw, float mx, float my, float itemH): int {
    var offs = _itemOffsets(items, itemH)
    for items.len() to i {
        float iy = py + offs[i]
        float ih = if items[i].separator then 9.0 else itemH
        if mx >= px and mx <= px + pw and my >= iy and my <= iy + ih { return i }
    }
    return -1
}

export struct MenuBar impl Widget {
    float x; float y; float w; float h
    float _itemH
    Array[string]       _titles
    Array[Array[MenuItem]] _menus
    int _open        // 当前展开的顶部菜单索引，-1 无
    int _hoverTop   // 悬停的顶部标题索引，-1 无
    int _hoverItem  // 当前展开菜单中悬停项索引，-1 无
    int _openSub    // 当前展开菜单中“已展开子菜单”的项索引，-1 无
    int _hoverSub   // 子菜单中悬停项索引，-1 无

    float _fontSize; string _fontPath; int _fontStyle; Font _font

    // 配色
    int _barR, _barG, _barB        // 菜单栏背景
    int _barHovR, _barHovG, _barHovB  // 悬停/激活标题背景
    int _bgR, _bgG, _bgB           // 下拉面板背景
    int _hovR, _hovG, _hovB        // 项悬停背景
    int _txtR, _txtG, _txtB        // 文字色
    int _disR, _disG, _disB        // 禁用文字色
    int _sepR, _sepG, _sepB        // 分隔线色
    int _bdrR, _brdG, _brdB        // 边框色
    int _accR, _accG, _accB        // 激活下划线
    int _cursor
    bool enabled; bool _loaded
    func(string, string):void _onSelect

    func _ensure_font() {
        if _font == null or not _font.ok {
            if _font != null { _font.close() }
            if _fontPath != "" { _font = fnt.createFont(_fontPath, _fontSize) }
            else { _font = fnt.createFontAuto(_fontSize) }
            if _font.ok and _fontStyle != 0 { _font.setStyle(_fontStyle) }
        }
    }

    // ==================== 布局接口 ====================
    func get_w(): float { return w }
    func get_h(): float { return h }
    func get_x(): float { return x }
    func get_y(): float { return y }
    func set_pos(float px, float py) { x = px; y = py }
    func set_size(float sw, float sh) { w = sw; h = sh }

    func set(Dict opts) {
        x       = _float(opts.get("x", 0))
        y       = _float(opts.get("y", 0))
        w       = _float(opts.get("w", 600))
        h       = _float(opts.get("h", 28))
        _itemH  = _float(opts.get("item_h", 26))
        _fontSize = _float(opts.get("font_size", 14))
        _fontPath = opts.get("font_path", "") as string
        _fontStyle = _int(opts.get("font_style", 0))

        _titles = []
        _menus  = []
        var ms = opts.get("menus", [])
        if ms is Array[Dict] {
            for ms.len() to i {
                var m = ms[i] as Dict
                _titles.add(m.get("title", "") as string)
                var its = m.get("items", [])
                if its is Array[Dict] { _menus.add(parseMenuItems(its as Array[Dict])) }
                else { _menus.add([]) }
            }
        }

        _barR = 34; _barG = 36; _barB = 44
        _barHovR = 50; _barHovG = 52; _barHovB = 62
        _bgR = 30; _bgG = 32; _bgB = 38
        _hovR = 60; _hovG = 120; _hovB = 200
        _txtR = 225; _txtG = 228; _txtB = 235
        _disR = 120; _disG = 122; _disB = 130
        _sepR = 80; _sepG = 84; _sepB = 96
        _bdrR = 90; _brdG = 95; _brdB = 110
        _accR = 80; _accG = 160; _accB = 245

        var bgc = opts.get("bg");      if bgc is Array[int] { _bgR = _int(bgc[0]); _bgG = _int(bgc[1]); _bgB = _int(bgc[2]) }
        var brc = opts.get("border");  if brc is Array[int] { _bdrR = _int(brc[0]); _brdG = _int(brc[1]); _brdB = _int(brc[2]) }
        var accc = opts.get("accent"); if accc is Array[int] { _accR = _int(accc[0]); _accG = _int(accc[1]); _accB = _int(accc[2]) }

        _cursor = _int(opts.get("cursor", SystemCursor.POINTER))
        _open = -1; _hoverTop = -1; _hoverItem = -1; _openSub = -1; _hoverSub = -1
        enabled = _bool(opts.get("enabled", true))
        _ensure_font()
        _loaded = true
    }

    // ==================== 设置方法 ====================
    func on_select(func(string, string):void cb) { _onSelect = cb }
    func set_enabled(bool e) { enabled = e }
    func set_font_size(float s) { _fontSize = s; if _font != null { _font.close(); _font = null } }
    func close() { _open = -1; _openSub = -1; _hoverItem = -1; _hoverSub = -1 }

    // ==================== 构建器（避免多层嵌套字面量；每项单行 Dict 即可） ====================
    // 新增一个顶级菜单，返回其索引
    func addMenu(string title): int {
        _titles.add(title)
        _menus.add([])
        return _titles.len() - 1
    }
    // 向指定顶级菜单追加一项，返回该项在菜单内的索引（可用于挂子菜单）
    func addItem(int menuIdx, Dict opts): int {
        if menuIdx < 0 or menuIdx >= _menus.len() { return -1 }
        var mi = _makeItem(opts)
        _menus[menuIdx].add(mi)
        return _menus[menuIdx].len() - 1
    }
    // 向指定顶级菜单追加分隔线
    func addSeparator(int menuIdx) {
        if menuIdx < 0 or menuIdx >= _menus.len() { return }
        var mi = new MenuItem(); mi.separator = true; mi.submenu = []
        _menus[menuIdx].add(mi)
    }
    // 向某顶级菜单的某一项（parentIdx）追加子菜单项，返回子菜单内索引
    func addSubmenuItem(int menuIdx, int parentIdx, Dict opts): int {
        if menuIdx < 0 or menuIdx >= _menus.len() { return -1 }
        var arr = _menus[menuIdx]
        if parentIdx < 0 or parentIdx >= arr.len() { return -1 }
        var mi = _makeItem(opts)
        arr[parentIdx].submenu.add(mi)
        return arr[parentIdx].submenu.len() - 1
    }
    // 向某顶级菜单的某一项追加子菜单分隔线
    func addSubmenuSeparator(int menuIdx, int parentIdx) {
        if menuIdx < 0 or menuIdx >= _menus.len() { return }
        var arr = _menus[menuIdx]
        if parentIdx < 0 or parentIdx >= arr.len() { return }
        var mi = new MenuItem(); mi.separator = true; mi.submenu = []
        arr[parentIdx].submenu.add(mi)
    }

    // ==================== 几何 ====================
    func _topRects(): Array[Array[float]] {
        Array[Array[float]] out = []
        int n = _titles.len()
        if n == 0 { return out }
        _ensure_font()
        float tx = x
        for n to i {
            float tw = 60.0
            if _font != null and _font.ok { tw = _float(_font.measureString(_titles[i]).w) + 28.0 }
            if tw < 40.0 { tw = 40.0 }
            out.add([tx, y, tw, h])
            tx = tx + tw
        }
        return out
    }
    func _panelRect(int mIdx): Array[float] {
        var rs = _topRects()
        var r = rs[mIdx]
        float px = r[0]
        float py = y + h
        float pw = _colW(_menus[mIdx], _font, _itemH)
        float ph = _panelH(_menus[mIdx], _itemH)
        return [px, py, pw, ph]
    }
    func _subRect(int parentIdx): Array[float] {
        var g = _panelRect(_open)
        var offs = _itemOffsets(_menus[_open], _itemH)
        float iy = g[1] + offs[parentIdx]
        var sub = _menus[_open][parentIdx].submenu
        float fw = _colW(sub, _font, _itemH)
        float fx = g[0] + g[2] - 2.0
        float fy = iy
        float fh = _panelH(sub, _itemH)
        return [fx, fy, fw, fh]
    }

    // ==================== 动作 ====================
    func _invokeItem(int mIdx, int itIdx) {
        var it = _menus[mIdx][itIdx]
        if it.action != null { it.action() }
        if _onSelect != null { _onSelect(_titles[mIdx], it.id) }
        close()
    }
    func _invokeSub(int parentIdx, int subIdx) {
        var sub = _menus[_open][parentIdx].submenu
        var it = sub[subIdx]
        if it.action != null { it.action() }
        if _onSelect != null { _onSelect(_titles[_open], it.id) }
        close()
    }

    // ==================== 交互 ====================
    func process(Event ev) {
        if not _loaded { return }
        if not enabled { close(); return }

        float mx = ev.mouseX(); float my = ev.mouseY()

        if ev.isKeyDown() and ev.scancode() == Scancode.ESCAPE { close(); return }

        if ev.isMouseMotion() {
            var rs = _topRects()
            _hoverTop = -1
            for rs.len() to i {
                var r = rs[i]
                if mx >= r[0] and mx <= r[0] + r[2] and my >= r[1] and my <= r[1] + r[3] { _hoverTop = i }
            }
            if _open >= 0 {
                var g = _panelRect(_open)
                _hoverItem = _itemAt(_menus[_open], g[0], g[1], g[2], mx, my, _itemH)
                if _openSub >= 0 {
                    // 先看光标是否落在已展开的子菜单飞出层内（避免移到飞出层时父项悬停丢失导致关闭）
                    var sg = _subRect(_openSub)
                    int si = _itemAt(_menus[_open][_openSub].submenu, sg[0], sg[1], sg[2], mx, my, _itemH)
                    if si >= 0 {
                        _hoverSub = si
                    } else {
                        if _hoverItem >= 0 and _menus[_open][_hoverItem].submenu.len() > 0 and _menus[_open][_hoverItem].enabled {
                            _openSub = _hoverItem; _hoverSub = -1
                        } else {
                            _openSub = -1; _hoverSub = -1
                        }
                    }
                } else {
                    if _hoverItem >= 0 and _menus[_open][_hoverItem].submenu.len() > 0 and _menus[_open][_hoverItem].enabled {
                        _openSub = _hoverItem; _hoverSub = -1
                    }
                }
            }
            core.markFrameMotion()
            if (_hoverTop >= 0 or (_open >= 0 and _hoverItem >= 0)) and _cursor >= 0 { core.requestCursor(_cursor) }
        }

        if ev.isMouseButtonUp() { return }

        if ev.isMouseButtonDown() {
            var rs = _topRects()
            int hitTop = -1
            for rs.len() to i {
                var r = rs[i]
                if mx >= r[0] and mx <= r[0] + r[2] and my >= r[1] and my <= r[1] + r[3] { hitTop = i }
            }
            if hitTop >= 0 {
                if _open == hitTop { _open = -1 }   // 再次点击同一标题：收起
                else { _open = hitTop; _openSub = -1; _hoverItem = -1; _hoverSub = -1 }
                return
            }
            if _open >= 0 {
                // 优先判定子菜单飞出层
                if _openSub >= 0 {
                    var sub = _menus[_open][_openSub].submenu
                    var sg = _subRect(_openSub)
                    int si = _itemAt(sub, sg[0], sg[1], sg[2], mx, my, _itemH)
                    if si >= 0 and sub[si].enabled and not sub[si].separator { _invokeSub(_openSub, si); return }
                }
                // 主下拉项
                var g = _panelRect(_open)
                int it = _itemAt(_menus[_open], g[0], g[1], g[2], mx, my, _itemH)
                if it >= 0 and _menus[_open][it].enabled and not _menus[_open][it].separator {
                    if _menus[_open][it].submenu.len() > 0 { _openSub = it; _hoverSub = -1 }
                    else { _invokeItem(_open, it) }
                    return
                }
                // 点击下拉区域外：收起
                close()
            }
        }
    }

    // ==================== 渲染：仅画菜单栏（下拉走 renderPopup 第二遍） ====================
    func render(Renderer r) {
        if not _loaded { return }
        _ensure_font()

        r.setColor(_barR, _barG, _barB, 255)
        r.fillRect(x, y, w, h)
        r.setColor(_bdrR, _brdG, _brdB, 220)
        r.drawLine(x, y + h, x + w, y + h)

        var rs = _topRects()
        for rs.len() to i {
            var rr = rs[i]
            bool active = (_open == i)
            bool hov = (_hoverTop == i) or active
            if hov { r.setColor(_barHovR, _barHovG, _barHovB, 255); r.fillRect(rr[0], rr[1], rr[2], rr[3]) }
            if _font != null and _font.ok and _titles[i] != "" {
                float tw = _float(_font.measureString(_titles[i]).w)
                float th = _float(_font.measureString("Ag").h)
                float tx = rr[0] + (rr[2] - tw) / 2.0
                float ty = rr[1] + (rr[3] - th) / 2.0
                r.drawText(_font, _titles[i], r.snapX(tx), r.snapY(ty), _txtR, _txtG, _txtB)
            }
            if active { r.setColor(_accR, _accG, _accB, 255); r.fillRect(rr[0], rr[1] + rr[3] - 2.0, rr[2], 2.0) }
        }
    }

    // 第二遍：把下拉面板（含子菜单）画在最上层，并登记弹层捕获区
    func renderPopup(Renderer r) {
        if not _loaded or _open < 0 { return }
        var items = _menus[_open]
        var g = _panelRect(_open)
        float px = g[0]; float py = g[1]; float pw = g[2]; float ph = g[3]

        // 捕获区取“下拉 + 子菜单飞出”的包围盒，抑制其范围内其它控件的事件
        float capX = px; float capY = py; float capR = px + pw; float capB = py + ph
        if _openSub >= 0 and _openSub < items.len() and items[_openSub].submenu.len() > 0 {
            var sg = _subRect(_openSub)
            if sg[0] < capX { capX = sg[0] }
            if sg[1] < capY { capY = sg[1] }
            if sg[0] + sg[2] > capR { capR = sg[0] + sg[2] }
            if sg[1] + sg[3] > capB { capB = sg[1] + sg[3] }
        }
        core.setPopupCapture(capX, capY, capR - capX, capB - capY)

        _drawPanel(r, items, px, py, pw, _hoverItem)
        if _openSub >= 0 and _openSub < items.len() and items[_openSub].submenu.len() > 0 {
            var sg = _subRect(_openSub)
            _drawPanel(r, items[_openSub].submenu, sg[0], sg[1], sg[2], _hoverSub)
        }
    }

    func _drawPanel(Renderer r, Array[MenuItem] items, float px, float py, float pw, int hoverIdx) {
        float ph = _panelH(items, _itemH)
        r.setColor(_bgR, _bgG, _bgB, 255)
        r.fillRoundedRect(px, py, pw, ph, 6.0)

        SDL_Rect clip = SDL_Rect.malloc()
        clip.x = _int(px); clip.y = _int(py); clip.w = _int(pw); clip.h = _int(ph)
        r.setClipRect(clip.to_ptr())

        float iy = py
        for items.len() to i {
            var it = items[i]
            if it.separator {
                r.setColor(_sepR, _sepG, _sepB, 200)
                r.drawLine(px + 10.0, iy + 4.0, px + pw - 10.0, iy + 4.0)
                iy = iy + 9.0
                continue
            }
            float ry = iy
            bool hov = (i == hoverIdx) and it.enabled
            if hov { r.setColor(_hovR, _hovG, _hovB, 255); r.fillRect(px, ry, pw, _itemH) }
            int lr = _txtR; int lg = _txtG; int lb2 = _txtB
            if not it.enabled { lr = _disR; lg = _disG; lb2 = _disB }
            if _font != null and _font.ok {
                float th = _float(_font.measureString("Ag").h)
                float ty = ry + (if th > _itemH then 0.0 else (_itemH - th) / 2.0)
                r.drawText(_font, it.label, r.snapX(px + 12.0), r.snapY(ty), lr, lg, lb2)
                if it.shortcut != "" {
                    float sw = _float(_font.measureString(it.shortcut).w)
                    r.drawText(_font, it.shortcut, r.snapX(px + pw - 12.0 - sw), r.snapY(ty), lr, lg, lb2)
                }
                if it.submenu.len() > 0 {
                    float ax = px + pw - 14.0; float ay = ry + _itemH / 2.0
                    r.drawTriangle(ax, ay, 5.0, 90.0, lr, lg, lb2, 255)
                }
            }
            iy = iy + _itemH
        }
        r.clearClip()
        clip.free()

        r.setColor(_bdrR, _brdG, _brdB, 220)
        r.drawRoundedRect(px, py, pw, ph, 6.0)
    }

    func dispose() {
        if _font != null { _font.close(); _font = null }
    }
}

// 工厂
export func createMenuBar(Dict opts): MenuBar {
    MenuBar m = new MenuBar(); m.set(opts); return m
}
