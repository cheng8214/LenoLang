    // 添加锚点布局容器，opts: {x, y, w, h, padX, padY}
    // ab.add(win.addButton({...}), {left:10, top:10}) 钉在左上；{centerX:true,centerY:true} 居中
    func addAnchorBox(Dict opts): AnchorBox {
        AnchorBox b = lay.createAnchorBox(opts)
