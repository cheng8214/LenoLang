// sdl_window.leno — SDL3 窗口封装
import "sdl_core.leno" as core
use core.sdl3

sdl3 _lib = core.lib()

import "sdl_renderer.leno" as renderer
use renderer.Renderer
import "sdl_event.leno" as event
use event.Event

export struct Window {
    Ptr handle; bool ok

    func init(Dict opts): bool {
        if not core.initVideo() {
            print("[LenoSDL3] init failed: " + core.getError())
            return false
        }
        var title = opts.get("title", "LenoSDL3") as string
        var w     = opts.get("w", 800) as int
        var h     = opts.get("h", 600) as int
        var flags = opts.get("flags", 0) as int
        handle = _lib.SDL_CreateWindow(title, w, h, flags) as Ptr
        ok = handle != null
        return ok
    }

    func setResizable(bool v) {
        if ok { _lib.SDL_SetWindowResizable(handle, v) }
    }

    func destroy() {
        if ok { _lib.SDL_DestroyWindow(handle); handle = null; ok = false }
    }

    func run(var onEvent, var onRender) {
        Renderer ren = renderer.createRenderer(handle)
        if not ren.ok { destroy(); return }

        Event ev = event.createEvent()
        var running = true
        while running {
            while ev.poll() {
                if ev.isQuit() or ev.isWindowClose() { running = false }
                else if not onEvent(ev) { running = false }
            }
            onRender(ren)
            ren.present()
        }
        ev.uninit()
        ren.destroy()
        destroy()
        core.quit()
    }
}

export func createWindow(Dict opts): Window {
    Window win = new Window(); win.init(opts); return win
}
