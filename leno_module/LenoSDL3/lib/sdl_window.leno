    // 添加网格布局容器，opts: {x, y, w, h, cols, spacing, padX, padY, col_weights}
    // grid.add(win.addButton({...}), {align: 1})  align: 0=左上 1=居中 2=右下 3=撑满
    func addGridLayout(Dict opts): GridLayout {
        GridLayout b = grdlib.createGridLayout(opts)
        _widgets.add(b as Widget)
        _widgetZ.add(opts.get("z", 0.0))
        b._bind_window(handle)
        return b
