// sdl_window.leno — SDL3 窗口封装
//
// 提供两种使用模式：
// 1. run() 回调模式（推荐）：
//    win.run(onEvent, onRender)
//       onEvent: func(Event): bool  — 返回 false 退出
//       onRender: func(Renderer)    — 每帧绘制
//
// 2. 手动轮询模式：
//    var ev = SDL3.createEvent()
//    while running { while ev.poll() { ... } ren.clear(); ...; ren.present() }
import "sdl_core.leno" as core
use core.sdl3

sdl3 _lib = core.lib()

import "sdl_renderer.leno" as renderer
use renderer.Renderer
import "sdl_event.leno" as event
use event.Event

export struct Window {
    Ptr handle    // SDL_Window 指针
    bool ok       // 窗口是否创建成功

    // opts 支持字段：title(string), w(int), h(int), flags(int)
    func init(Dict opts): bool {
        if not core.initVideo() {
            print("[LenoSDL3] init failed: " + core.getError())
            return false
        }
        string title = opts.get("title", "LenoSDL3") as string
        int w        = opts.get("w", 800) as int
        int h        = opts.get("h", 600) as int
        int flags    = opts.get("flags", 0) as int
        handle = _lib.SDL_CreateWindow(title, w, h, flags) as Ptr
        ok = handle != null
        return ok
    }

    // 设置窗口标题
    func setTitle(string title): bool {
        return _lib.SDL_SetWindowTitle(handle, title)
    }

    // 设置窗口大小
    func setSize(int w, int h): bool {
        return _lib.SDL_SetWindowSize(handle, w, h)
    }

    // 设置窗口位置
    func setPosition(int x, int y): bool {
        return _lib.SDL_SetWindowPosition(handle, x, y)
    }

    // 设置窗口是否可调整大小
    func setResizable(bool v) {
        if ok { _lib.SDL_SetWindowResizable(handle, v) }
    }

    // 设置窗口置顶
    func setAlwaysOnTop(bool v): bool {
        return _lib.SDL_SetWindowAlwaysOnTop(handle, v)
    }

    // 设置窗口透明度（0.0 全透明 ~ 1.0 不透明）
    func setOpacity(float v): bool {
        return _lib.SDL_SetWindowOpacity(handle, v)
    }

    // 窗口状态控制
    func show(): bool        { return _lib.SDL_ShowWindow(handle) }
    func hide(): bool        { return _lib.SDL_HideWindow(handle) }
    func maximize(): bool    { return _lib.SDL_MaximizeWindow(handle) }
    func minimize(): bool    { return _lib.SDL_MinimizeWindow(handle) }
    func restore(): bool     { return _lib.SDL_RestoreWindow(handle) }

    // 销毁窗口
    func destroy() {
        if ok { _lib.SDL_DestroyWindow(handle); handle = null; ok = false }
    }

    // 运行主循环（回调模式）
    // onEvent(Event): bool  — 返回 false 则退出循环
    // onRender(Renderer)   — 每帧渲染回调
    func run(var onEvent, var onRender) {
        Renderer ren = renderer.createRenderer(handle)
        if not ren.ok { destroy(); return }

        Event ev = event.createEvent()
        bool running = true
        while running {
            // 处理所有待处理事件
            while ev.poll() {
                if ev.isQuit() or ev.isWindowClose() { running = false }
                else if not onEvent(ev) { running = false }
            }
            onRender(ren)
            ren.present()
        }
        // 清理
        ev.uninit()
        ren.destroy()
        destroy()
        core.quit()
    }
}

// 创建窗口实例，opts: {title, w, h, flags}
export func createWindow(Dict opts): Window {
    Window win = new Window(); win.init(opts); return win
}
