// sdl_window.leno — SDL3 窗口封装
//
// 提供两种使用模式：
// 1. run() 回调模式（推荐）：
//    win.run(onEvent, onRender)
//       onEvent: func(Event): bool  — 返回 false 退出
//       onRender: func(Renderer)    — 每帧绘制
//
// 2. 手动轮询模式：
//    var ev = SDL3.createEvent()
//    while running { while ev.poll() { ... } ren.clear(); ...; ren.present() }
import "sdl_core.leno" as core
use core.(sdl3, SDL_Point, Size)

sdl3 _lib = core.lib()

// 全局窗口引用计数，最后一个窗口销毁时才 quit
var _windowCount = 0

import "sdl_renderer.leno" as renderer
use renderer.Renderer
import "sdl_event.leno" as event
use event.Event
import "sdl_timer.leno" as timer
use timer.Timer
import "sdl_button.leno" as btn
use btn.Button
import "sdl_label.leno" as lbl
use lbl.Label
import "sdl_edit.leno" as edt
use edt.Edit
import "sdl_checkbox.leno" as chk
use chk.CheckBox
import "sdl_radio.leno" as rb
use rb.RadioButton
import "sdl_toggle.leno" as tgl
use tgl.Toggle
import "sdl_slider.leno" as sld
use sld.Slider
import "sdl_progress.leno" as prg
use prg.ProgressBar
import "sdl_listbox.leno" as lb
use lb.ListBox
import "sdl_combobox.leno" as cbb
use cbb.ComboBox
import "sdl_panel.leno" as pnl
use pnl.Panel
import "sdl_tab.leno" as tab
use tab.TabControl
import "sdl_spinbox.leno" as spb
use spb.SpinBox
import "sdl_table.leno" as tbl
use tbl.Table
import "sdl_layout.leno" as lay
use lay.(HBox, VBox, AnchorBox)
import "sdl_menu.leno" as menu
use menu.MenuBar
import "sdl_scrollview.leno" as scv
use scv.ScrollView
import "sdl_treeview.leno" as tvlib
use tvlib.TreeView
import "sdl_tooltip.leno" as tip
import "sdl_widget.leno" as wgt
use wgt.Widget
import "sdl_chart.leno" as cht
use cht.(BarChart, LineChart, PieChart)

export alias EventHandler  = func(Event):bool
export alias RenderCallback = func(Renderer)

// 多窗口回调缓存
Array[int]             _runWids   = []
Array[Ptr[u8]]            _runHnds   = []
Array[Renderer]        _runRens   = []
Array[EventHandler]    _runEvts   = []
Array[RenderCallback]  _runRends  = []
Array[Array[Widget]]   _runWidgets = []
Array[Array[MenuBar]]   _runMenus   = []
Array[MenuBar]          _runCtxBar  = []   // 各窗口级右击上下文菜单（由 setContextMenu 注册，run 自动接管弹出）
Array[int]             _runCtxIdx  = []   // 对应的上下文菜单索引
Array[Widget]          _runRoots  = []     // 各窗口的根布局控件（setRoot 设置）
Array[int]             _runW     = []     // 各窗口逻辑宽（Tooltip 夹紧用）
Array[int]             _runH     = []     // 各窗口逻辑高
Array[int]             _runDialogHidden = []  // 对话框窗口是否创建时隐藏（首次渲染后 show）
var _runLoopActive = false    // 主循环是否已在运行
Array[int] _modalStack = []   // 模态窗口栈（支持嵌套）

// 推入模态窗口（runModal 内部调用）
export func pushModal(int w) { _modalStack.add(w) }
// 弹出栈顶：仅当栈顶匹配时才弹出（防止重复弹/弹错）
export func popModalIfTop(int w) {
    if _modalStack.len() > 0 and _modalStack.last() == w { _modalStack.pop() }
}
// 当前是否为模态状态（栈非空即模态）
func _isModal(): bool { return _modalStack.len() > 0 }
func _modalTop(): int { if _modalStack.len() > 0 then _modalStack.last() else -1 }

// 兼容旧 API（已废弃，仅 test_modal_dialog.leno 等旧示例使用）
export func setModalWid(int w) {
    if w < 0 { _modalStack = [] }
    else { _modalStack.add(w) }
}
export func getModalWid(): int { return _modalTop() }

// 仅为注册（不启动循环），给 Dialog 等外部 struct 用
export func registerRun(Ptr[u8] hdl, int wid, Renderer ren, var onEvent, var onRender) {
    _runWids.add(wid)
    _runHnds.add(hdl)
    _runRens.add(ren)
    _runEvts.add(onEvent)
    _runRends.add(onRender)
}


export struct Window {
    Ptr[u8] handle    // SDL_Window 指针
    bool ok       // 窗口是否创建成功
    int _w; int _h; float _aaScale
    int _maxFPS = 30        // 最大渲染帧率（0=不限制）
    Array[Widget] _widgets = []
    Array[MenuBar]  _menus  = []   // 菜单栏集合，第二遍画下拉层（盖在最上层）
    MenuBar _ctxBar = null          // 窗口级右击上下文菜单（setContextMenu 注册，run 自动接管弹出）
    int    _ctxIdx = -1             // 对应的上下文菜单索引（-1 表示未注册）
    Widget _root                     // 根布局控件（setRoot 设置），缩放时自动填满窗口
    bool _dialogHidden = false        // 对话框窗口：创建时隐藏，首帧渲染完后 show（消除闪现）

    // opts 支持字段：title(string), w(int), h(int), flags(int)
    func init(Dict opts): bool {
        if not core.initVideo() {
            print("[LenoSDL3] init failed: " + core.getError())
            return false
        }
        string title = opts.get("title", "LenoSDL3")
        int w        = opts.get("w", 800)
        int h        = opts.get("h", 600)
        int flags    = opts.get("flags", 0)
        _w = w; _h = h
        // 超采样抗锯齿：默认关闭；aa:true / aa:2 / aa:1.5 开启
        _aaScale = 0.0
        var aaOpt = opts.get("aa", 0.0)
        if aaOpt is bool { if aaOpt { _aaScale = 2.0 } }
        else { float a = aaOpt; if a > 0.0 { _aaScale = a } }
        handle = _lib.SDL_CreateWindow(title, w, h, flags) as Ptr[u8]
        ok = handle != null
        if ok { _windowCount = _windowCount + 1 }
        return ok
    }

    // 获取窗口 ID
    func getID(): int {
        return _lib.SDL_GetWindowID(handle) as int
    }

    func getHandle(): Ptr[u8] { return handle }

    // 设置窗口标题
    func setTitle(string title): bool {
        return _lib.SDL_SetWindowTitle(handle, title)
    }

    // 设置窗口大小
    func setSize(int w, int h): bool {
        return _lib.SDL_SetWindowSize(handle, w, h)
    }

    // 获取窗口真实像素尺寸（HiDPI 时大于逻辑尺寸）
    func getSizeInPixels(): Size {
        SDL_Point pt = SDL_Point.malloc()
        _lib.SDL_GetWindowSizeInPixels(handle, &pt.x, &pt.y)
        var d = {w: pt.x, h: pt.y}
        pt.free(); return d
    }

    // 获取窗口逻辑尺寸（绘图坐标系使用的尺寸，不受 HiDPI 放大影响）
    func getSize(): Size {
        SDL_Point pt = SDL_Point.malloc()
        _lib.SDL_GetWindowSize(handle, &pt.x, &pt.y)
        var d = {w: pt.x, h: pt.y}
        pt.free(); return d
    }

    // 设置窗口位置
    func setPosition(int x, int y): bool {
        return _lib.SDL_SetWindowPosition(handle, x, y)
    }

    // 设置窗口是否可调整大小
    func setResizable(bool v) {
        if ok { _lib.SDL_SetWindowResizable(handle, v) }
    }

    // 设置最大渲染帧率（默认 30 FPS；0 = 不限制）
    func setMaxFPS(int fps) { _maxFPS = fps }

    // 设置窗口置顶
    func setAlwaysOnTop(bool v): bool {
        return _lib.SDL_SetWindowAlwaysOnTop(handle, v)
    }

    // 设置窗口透明度（0.0 全透明 ~ 1.0 不透明）
    func setOpacity(float v): bool {
        return _lib.SDL_SetWindowOpacity(handle, v)
    }

    // 鼠标锁定 & 相对模式（FPS 游戏用）
    func setMouseGrab(bool v): bool              { return _lib.SDL_SetWindowMouseGrab(handle, v) }
    func getMouseGrab(): bool                    { return _lib.SDL_GetWindowMouseGrab(handle) }
    func setRelativeMouse(bool v): bool          { return _lib.SDL_SetWindowRelativeMouseMode(handle, v) }
    func getRelativeMouse(): bool                { return _lib.SDL_GetWindowRelativeMouseMode(handle) }

    // 限制窗口最小尺寸
    func setMinSize(int w, int h): bool          { return _lib.SDL_SetWindowMinimumSize(handle, w, h) }

    // 窗口闪烁（FLASH_BRIEFLY=短暂, FLASH_UNTIL_FOCUSED=直到获得焦点, FLASH_CANCEL=取消）
    func flash(int op): bool                     { return _lib.SDL_FlashWindow(handle, op) }

    // 设置窗口图标（surface 来自 SDL3.loadImage 等）
    func setIcon(Ptr[u8] icon): bool { return _lib.SDL_SetWindowIcon(handle, icon) }

    // 全屏切换
    func setFullscreen(bool v): bool { return _lib.SDL_SetWindowFullscreen(handle, v) }

    // 前置窗口并获取焦点
    func raise(): bool       { return _lib.SDL_RaiseWindow(handle) }

    // 窗口状态控制
    func show(): bool        { return _lib.SDL_ShowWindow(handle) }
    func hide(): bool        { return _lib.SDL_HideWindow(handle) }
    func maximize(): bool    { return _lib.SDL_MaximizeWindow(handle) }
    func minimize(): bool    { return _lib.SDL_MinimizeWindow(handle) }
    func restore(): bool     { return _lib.SDL_RestoreWindow(handle) }

    // 销毁窗口（同时释放所有控件资源：字体等，避免窗口关闭后字体泄漏）
    func destroy() {
        if ok {
            // 根销毁：先释放所有控件资源，沿父子树递归清理
            for _widgets to w { w.dispose() }
            if _root != null { _root.dispose() }
            _lib.SDL_DestroyWindow(handle); handle = null; ok = false; _windowCount = _windowCount - 1
        }
    }

    // 手动创建渲染器（供轮询模式使用）
    func createRenderer(): Renderer {
        return renderer.createRenderer(handle)
    }

    // 添加定时器（毫秒），用法: Timer t = win.addTimer(200, func() { ... })
    func addTimer(int ms, func():void cb): Timer {
        Timer t = new Timer(); t.set(ms, cb); timer.registerTimer(t); return t
    }

    // 添加一次性定时器
    func addTimerOnce(int ms, func():void cb): Timer {
        Timer t = new Timer(); t.setOnce(ms, cb); timer.registerTimer(t); return t
    }

    // 添加按钮，opts: {text, x, y, w, h, r, g, b}
    // 返回 Button，可 .on_click(func() { ... })
    func addButton(Dict opts): Button {
        Button b = btn.createButton(opts)
        _widgets.add(b as Widget)
        return b
    }

    // 添加标签，opts: {text, x, y, font_size, rgb, align}
    func addLabel(Dict opts): Label {
        Label l = lbl.createLabel(opts)
        _widgets.add(l as Widget)
        return l
    }

    // 添加文本编辑框，opts: {text, x, y, w, h, placeholder, password, readonly}
    func addEdit(Dict opts): Edit {
        Edit ed = edt.createEdit(opts)
        ed.set_window(handle)
        ed.set_window_size(_w, _h)
        var cm = ed.get_context_menu()
        if cm != null { menu.registerContextMenu(cm) }   // 上下文菜单登记，由窗口第二遍按窗口隔离绘制
        _widgets.add(ed as Widget)
        return ed
    }

    // 通用控件注册：任何 impl Widget 的控件（含第三方自定义控件）都能被 run() 自动管理
    func add(Widget w): Widget {
        _widgets.add(w)
        // 绑定窗口句柄：容器向下传递，Edit 直接设置，确保嵌套其中的 Edit 能正确定位 IME 候选框
        Panel p = w as Panel
        if p != null { p._bind_window(handle); return w }
        ScrollView s = w as ScrollView
        if s != null { s._bind_window(handle); return w }
        HBox h = w as HBox
        if h != null { h._bind_window(handle); return w }
        VBox vb = w as VBox
        if vb != null { vb._bind_window(handle); return w }
        AnchorBox ab = w as AnchorBox
        if ab != null { ab._bind_window(handle); return w }
        TabControl tc = w as TabControl
        if tc != null { tc._bind_window(handle); return w }
        Edit e = w as Edit
        if e != null { e.set_window(handle); return w }
        SpinBox sp = w as SpinBox
        if sp != null { sp._bind_window(handle); return w }
        TreeView tv = w as TreeView
        if tv != null { tv.set_window_handle(handle); return w }
        return w
    }

    // 设置根布局控件：窗口缩放时自动把根控件尺寸设为窗口大小并驱动内部布局重排
    func setRoot(Widget root) {
        _root = root
        root.set_pos(0, 0)
        root.set_size(_w, _h)
    }

    // 添加复选框，opts: {text, x, y, box, checked, on_change}
    // 返回 CheckBox，可 .on_change(func(bool){...}) / .set_checked(bool) / .is_checked()
    func addCheckBox(Dict opts): CheckBox {
        CheckBox c = chk.createCheckBox(opts)
        _widgets.add(c as Widget)
        return c
    }

    // 添加单选按钮，opts: {text, x, y, group, checked, on_change}
    // 同一 group 内互斥（由控件内部注册表实现）
    func addRadioButton(Dict opts): RadioButton {
        RadioButton r = rb.createRadioButton(opts)
        r.setWindowHandle(handle)   // 让同组互斥按窗口隔离（避免跨窗口同组互相取消）
        _widgets.add(r as Widget)
        return r
    }

    // 添加开关，opts: {text, x, y, w, h, on, on_change}
    func addToggle(Dict opts): Toggle {
        Toggle t = tgl.createToggle(opts)
        _widgets.add(t as Widget)
        return t
    }

    // 添加滑块，opts: {x, y, w, h, min, max, value, step, vertical, on_change}
    // 返回 Slider，可 .set_value(float) / .get_value() / .on_change(func(float){...})
    func addSlider(Dict opts): Slider {
        Slider s = sld.createSlider(opts)
        _widgets.add(s as Widget)
        return s
    }

    // 添加进度条，opts: {x, y, w, h, min, max, value, clickable, show_text, on_change}
    func addProgressBar(Dict opts): ProgressBar {
        ProgressBar p = prg.createProgressBar(opts)
        _widgets.add(p as Widget)
        return p
    }

    // 添加列表框，opts: {x, y, w, h, items, item_h, mode, selected, on_change}
    // mode: 0=单选, 1=多选；on_change 回调收到选中的索引数组 Array[int]
    func addListBox(Dict opts): ListBox {
        ListBox lb2 = lb.createListBox(opts)
        _widgets.add(lb2 as Widget)
        return lb2
    }

    // 添加下拉框，opts: {x, y, w, h, items, item_h, popup_h, placeholder, selected, on_change}
    // on_change 回调收到选中索引 int
    func addComboBox(Dict opts): ComboBox {
        ComboBox cb = cbb.createComboBox(opts)
        cb.setWindowHandle(handle)   // 让下拉层按窗口隔离绘制（工厂已登记到 registerComboBox）
        _widgets.add(cb as Widget)
        return cb
    }

    // 添加菜单栏，opts: {x, y, w, h, menus:[{title, items:[...]}], item_h, font_size, ...}
    // 下拉层自动盖在最上层（renderPopup 第二遍绘制 + 弹层捕获区）
    func addMenuBar(Dict opts): MenuBar {
        MenuBar m = menu.createMenuBar(opts)
        m.setWindowHandle(handle)   // 让活动菜单按窗口隔离（避免跨窗口互相抢互斥）
        _widgets.add(m as Widget)
        _menus.add(m)
        m.setWindowSize(_w, _h)   // 供上下文菜单弹出时按窗口边界夹紧
        return m
    }

    // 注册窗口级右击上下文菜单（只需调用一次）。之后 run 会在每帧事件处理中统一接管右击：
    // 若命中控件自行弹出了自身菜单（占用弹层），则不弹窗口菜单；否则才弹本菜单。
    // 这样「控件菜单优先、窗口菜单兜底」由底层统一保证，示例无需在 onEvent 里处理右键。
    func setContextMenu(MenuBar bar, int ctxIdx) { bar.setWindowHandle(handle); _ctxBar = bar; _ctxIdx = ctxIdx }

    // 添加面板容器，opts: {x, y, w, h, bg, border, radius, border_alpha, clip}
    // 用 panel.add(win.addButton({...})) 把子控件挂到面板（子控件用窗口绝对坐标）
    func addPanel(Dict opts): Panel {
        Panel p = pnl.createPanel(opts)
        _widgets.add(p as Widget)
        p._bind_window(handle)
        return p
    }

    // 添加选项卡容器，opts: {x, y, w, h, tabs:[...], active, tab_h, font_size, ...}
    // 用法：tab.addToPage(0, SDL3.createButton({...})) 把子控件挂到指定页（子控件用窗口绝对坐标，落在内容区）
    func addTabControl(Dict opts): TabControl {
        TabControl t = tab.createTabControl(opts)
        _widgets.add(t as Widget)
        t._bind_window(handle)
        return t
    }

    // 添加数值微调框，opts: {x, y, w, h, min, max, value, step, int, decimals, ...}
    // 返回 SpinBox，可 .on_change(func(float){...}) / .set_value(float) / .get_value() / .set_range(lo,hi)
    func addSpinBox(Dict opts): SpinBox {
        SpinBox s = spb.createSpinBox(opts)
        _widgets.add(s as Widget)
        s._bind_window(handle)
        return s
    }

    // 添加表格，opts: {x, y, w, h, headers, col_widths, aligns, rows, row_h, header_h, sortable, zebra, ...}
    // 返回 Table，可 .on_select(func(int){...}) / .on_cell(func(int,int){...}) / .set_rows(...) / .add_row(...)
    func addTable(Dict opts): Table {
        Table t = tbl.createTable(opts)
        t.set_window_size(_w, _h)
        t.set_window_handle(handle)
        _widgets.add(t as Widget)
        var cm = t.get_context_menu()
        if cm != null { menu.registerContextMenu(cm) }   // 上下文菜单登记，由窗口第二遍按窗口隔离绘制
        return t
    }

    // 添加水平布局容器，opts: {x, y, w, h, spacing, padX, padY}
    // hb.add(win.addButton({...}), {expand:true}) 占满剩余宽度；{align:1} 交叉轴居中
    func addHBox(Dict opts): HBox {
        HBox b = lay.createHBox(opts)
        _widgets.add(b as Widget)
        b._bind_window(handle)
        return b
    }

    // 添加垂直布局容器，opts: {x, y, w, h, spacing, padX, padY}
    func addVBox(Dict opts): VBox {
        VBox b = lay.createVBox(opts)
        _widgets.add(b as Widget)
        b._bind_window(handle)
        return b
    }

    // 添加锚点布局容器，opts: {x, y, w, h, padX, padY}
    // ab.add(win.addButton({...}), {left:10, top:10}) 钉在左上；{centerX:true,centerY:true} 居中
    func addAnchorBox(Dict opts): AnchorBox {
        AnchorBox b = lay.createAnchorBox(opts)
        _widgets.add(b as Widget)
        b._bind_window(handle)
        return b
    }

    // 添加通用滚动容器，opts: {x, y, w, h, content_w, content_h, bg, border, radius}
    // 用法：var box = SDL3.createVBox({...}); sv.set_content(box)；内容控件用 createXxx 创建（不要 win.add）
    // content_w/h 不传则自动取内容自然尺寸；悬停滚轮滚动，可拖右侧/底部滚动条
    func addScrollView(Dict opts): ScrollView {
        ScrollView s = scv.createScrollView(opts)
        _widgets.add(s as Widget)
        s._bind_window(handle)
        return s
    }

    // 添加树视图，opts: {x, y, w, h, items, row_h, indent, mode, show_check, context_menu, on_change, ...}
    // 返回 TreeView，可 .on_change(func(Array[int]){...}) / .on_context(...) / .on_toggle(...) /
    //   .expand/.collapse_all/.get_selected_id/.get_node/.add_child/.remove_node 等
    func addTreeView(Dict opts): TreeView {
        TreeView t = tvlib.createTreeView(opts)
        t.set_window(_w, _h)
        t.set_window_handle(handle)
        var cm = t.get_context_menu()
        if cm != null { menu.registerContextMenu(cm) }   // 右键上下文菜单登记，由窗口第二遍按窗口隔离绘制
        _widgets.add(t as Widget)
        return t
    }

    // 添加柱状图，opts: {x, y, w, h, title, font_size, show_values, show_grid}
    // 返回 BarChart，可 .set_data(Array[string] cats, Array[float] vals)
    func addBarChart(Dict opts): BarChart {
        BarChart c = cht.createBarChart(opts)
        _widgets.add(c as Widget)
        return c
    }

    // 添加折线图，opts: {x, y, w, h, title, font_size, show_grid, show_points}
    // 返回 LineChart，可 .set_data(Array[string] xlabels, Array[Array[float]] series, Array[string] names)
    func addLineChart(Dict opts): LineChart {
        LineChart c = cht.createLineChart(opts)
        _widgets.add(c as Widget)
        return c
    }

    // 添加饼图，opts: {x, y, w, h, title, font_size}
    // 返回 PieChart，可 .set_data(Array[string] labels, Array[float] values)
    func addPieChart(Dict opts): PieChart {
        PieChart c = cht.createPieChart(opts)
        _widgets.add(c as Widget)
        return c
    }

    // 仅注册窗口（不启动主循环），用于多窗口场景：先逐个 registerOnly，最后 run() 启动循环
    func registerOnly(EventHandler onEvent, RenderCallback onRender) {
        core.startTextInput(handle)      // 启用文本输入（供 Edit 控件使用）
        Renderer ren = renderer.createRenderer(handle)
        if _aaScale > 0.0 { ren.enableSSAA(_w, _h, _aaScale) }
        _runWids.add(getID())
        _runHnds.add(handle)
        _runRens.add(ren)
        _runEvts.add(onEvent)
        _runRends.add(onRender)
        _runWidgets.add(_widgets)    // 统一关联控件列表
        _runMenus.add(_menus)        // 菜单栏集合（用于第二遍 overlay 绘制）
        if _ctxBar != null { _runCtxBar.add(_ctxBar); _runCtxIdx.add(_ctxIdx) }
        else { _runCtxBar.add(menu.createMenuBar({})); _runCtxIdx.add(-1) }   // 占位（idx=-1 表示未注册，run 中不弹）
        _runRoots.add(_root)         // 根布局控件
        Size sz = getSize()           // 窗口逻辑尺寸（Tooltip 浮层夹紧用）
        _runW.add(sz.w); _runH.add(sz.h)
        _runDialogHidden.add(_dialogHidden)   // 对话框窗口：首帧渲染后自动 show
    }

    // 运行主循环（回调模式，支持多窗口）
    // 单窗口：直接调用 run() 注册并启动循环
    // 多窗口：各窗口先 registerOnly()，最后一个 run() 启动循环
    func run(EventHandler onEvent, RenderCallback onRender) {
        registerOnly(onEvent, onRender)
        if _runLoopActive { return }
        _runLoopActive = true

        Event ev = event.createEvent()
        bool _needRedraw = true       // 初始绘制一次
        int  _lastRenderTicks = core.getTicks()   // 上次渲染时刻，用于帧率节流
        int  _throttleMs = if _maxFPS > 0 then 1000 / _maxFPS else 1
        while true {
            core.resetFrameCursor()   // 每帧开始：清空本帧光标请求
            bool _hadEvent = false
            // 动态计算等待时长：有重绘请求时节流至目标 FPS，空闲时按定时器触发时刻
            int timeoutMs = 500
            if _needRedraw {
                int elapsed = core.getTicks() - _lastRenderTicks
                int remain = _throttleMs - elapsed
                if remain < 1 { remain = 1 }
                if remain > timeoutMs { remain = timeoutMs }
                timeoutMs = remain
            } else {
                int nextTM = timer.nextTimerMs()
                if nextTM >= 0 {
                    int wait = nextTM - core.getTicks()
                    if wait < 1 { wait = 1 }
                    if wait > 100 { wait = 100 }
                    timeoutMs = wait
                }
            }
            int _t0 = core.getTicks()
            ev.waitTimeout(timeoutMs)
            // 兜底：若 waitTimeout 提前返回（实际等待 < 5ms 且无事件），
            // 强制 Sleep 补足，防止事件循环高频空转→CPU 占用异常
            int _wakeTick = core.getTicks()
            int _wakeWait = _wakeTick - _t0
            if not ev.has and _wakeWait < 5 { core.delay(5 - _wakeWait) }
            while ev.has {
                // 鼠标移动(motion)不强制整窗重绘：光标为 OS 级、hover 变化已由控件
                // markFrameRedraw() 请求重绘；否则每次移动都触发全窗清屏+全控件重绘，
                // 偶发呈现异常会让控件（如表）整块露出背景而“闪一下”。
                // 滚轮/点击/resize/键盘等非 motion 事件仍强制重绘。
                if not ev.isMouseMotion() { _hadEvent = true }
                if ev.isQuit() {
                    for _runWids.len() to i {
                        // 根销毁：退出前先释放所有控件资源（字体等），沿父子树递归清理
                        var ws = _runWidgets[i]
                        if ws != null { for ws to w { w.dispose() } }
                        _runRens[i].destroy()
                        _lib.SDL_DestroyWindow(_runHnds[i])
                        _windowCount -= 1
                    }
                    ev.uninit()
                    if _windowCount <= 0 { core.quit() }
                    return
                }
                int wid = ev.windowID()
                // 模态：仅栈顶窗口接收事件，其余全部跳过（含主窗口 + 下层模态）
                // 注意：必须继续 poll 前进事件队列，否则 ev.has 恒为 true 导致 while 死循环（窗口假死）
                if _isModal() and wid != _modalTop() { ev.poll(); continue }
                for _runWids.len() to i {
                    if _runWids[i] == wid {
                        if not _runEvts[i](ev) or ev.isWindowClose() {
                            if _isModal() and _runWids[i] == _modalTop() { _modalStack.pop() }
                            // 根销毁：关闭窗口前先释放所有控件资源（字体等），沿父子树递归清理
                            var ws = _runWidgets[i]
                            if ws != null { for ws to w { w.dispose() } }
                            var rt = _runRoots[i]
                            if rt != null { rt.dispose() }
                            _runRens[i].destroy()
                            _lib.SDL_DestroyWindow(_runHnds[i])
                            _windowCount -= 1
                            _runWids.remove(i);  _runHnds.remove(i)
                            _runRens.remove(i);  _runEvts.remove(i)
                            _runRends.remove(i); _runWidgets.remove(i); _runMenus.remove(i); _runRoots.remove(i); _runW.remove(i); _runH.remove(i)
                            _runCtxBar.remove(i); _runCtxIdx.remove(i)
                            _runDialogHidden.remove(i)
                            break
                        }
                    }
                }
                // 自动处理该窗口的所有控件事件
                for _runWids.len() to j {
                    if _runWids[j] == wid {
                        var ws = _runWidgets[j]
                        for ws to w { w.process(ev) }
                        break
                    }
                }
                // 窗口级右击上下文菜单（统一在底层接管，而非示例 onEvent）：
                // 先让命中控件自行处理右键（Edit/ComboBox 等会弹出自身菜单并占住弹层捕获区），
                // 若没有任何控件占用弹层，才弹出窗口级菜单，避免「窗口菜单盖住控件菜单」。
                if ev.isMouseButtonDown() and ev.mouseButton() == 3 {
                    for _runWids.len() to j {
                        if _runWids[j] == wid {
                            if _runCtxIdx[j] >= 0 and not core.inPopupCapture(ev.mouseX(), ev.mouseY()) {
                                _runCtxBar[j].openContext(_runCtxIdx[j], ev.mouseX(), ev.mouseY())
                            }
                            break
                        }
                    }
                }
                // 窗口缩放/最大化：重建该窗口的 SSAA 离屏纹理，使其覆盖新尺寸
                // （否则 clear/present 仍按初始尺寸，放大区域是黑底、控件落入黑区不可见）
                if ev.isWindowResized() {
                    for _runWids.len() to k {
                        if _runWids[k] == wid {
                            SDL_Point pt = SDL_Point.malloc()
                            _lib.SDL_GetWindowSize(_runHnds[k], &pt.x, &pt.y)
                            _runRens[k].resizeSSAA(pt.x, pt.y)
                            // 驱动根布局控件跟随窗口大小
                            var rootWid = _runRoots[k]
                            if rootWid != null { rootWid.set_size(pt.x, pt.y) }
                            pt.free()
                            break
                        }
                    }
                }
                ev.poll()              // 获取队列中下一个事件
            }
            core.applyFrameCursor()    // 帧末：按本帧各控件的请求统一设置一次光标（避免互相覆盖）
            if _runWids.len() == 0 {
                ev.uninit()
                if _windowCount <= 0 { core.quit() }
                return
            }
            // 驱动所有定时器（在事件轮询外，确保 idle 期间也能触发定时器与自动重绘）
            timer.tickAllTimers()
            // 事件驱动重绘：非 motion 事件/动画请求/tooltip等待时才渲染，空闲时跳过以降低 CPU 占用。
            // 注意：纯鼠标移动(motion)不再触发整窗重绘——其光标为 OS 级、hover 变化由控件
            // markFrameRedraw() 单独请求；否则每次移动都整窗清屏+重绘会偶发“闪一下”。
            if _hadEvent { _needRedraw = true }
            if core.consumeRedrawRequest() { _needRedraw = true }
            if tip.tipWaiting() { _needRedraw = true }
            if _needRedraw {
                int now = core.getTicks()
                if now - _lastRenderTicks >= _throttleMs {   // 节流：距上次渲染不足节流间隔则跳过
                    _lastRenderTicks = now
                    _needRedraw = false   // 清除标记；动画控件在 render 时可调用 requestRedraw() 请求下一帧
                    for _runWids.len() to i {
                    _runRens[i].clearColor(0, 0, 0, 255)   // 每帧清屏：避免旧帧像素残留；否则动态文字(状态栏/信息面板)更新时会叠加在旧文字上，表现为"文字重叠"
                    _runRends[i](_runRens[i])
                    // 弹层捕获区：每帧渲染前清空，由展开的下拉框在 renderPopup 里重新登记
                    core.clearPopupCapture()
                    // 自动渲染该窗口的所有控件（按添加顺序层叠）
                    var ws = _runWidgets[i]
                    for ws to w { w.render(_runRens[i]) }
                    // 第二遍：所有展开的下拉框画在最上层（按窗口隔离；含经 panel/tab/布局添加的，由 registerComboBox 兜底）
                    cbb.renderComboBoxes(_runRens[i], _runHnds[i])
                    // 第二遍：所有展开的下拉菜单画在最上层
                    var mns = _runMenus[i]
                    for mns to mn { mn.renderPopup(_runRens[i]) }
                    // 第二遍：所有展开的控件内嵌右击上下文菜单（Edit 经 panel.add 添加时未进 _menus，
                    // 在此兜底绘制到最上层，避免被同级控件遮挡）
                    menu.renderContextMenus(_runRens[i], _runHnds[i])
                    // Tooltip 浮层：在所有控件与弹层之后绘制，浮在最上层；不拦截输入
                    tip.tipTick()
                    tip.tipRender(_runRens[i], _runW[i], _runH[i])
                    _runRens[i].present()
                    // 对话框窗口：首帧渲染完后显示（避免创建时闪现默认背景）
                    if _runDialogHidden[i] {
                        _lib.SDL_ShowWindow(_runHnds[i])
                        _runDialogHidden[i] = false
                    }
                }
                }              // 闭合节流 if
            }
            // 动画控件可能在 render 中调用了 requestRedraw() → 标记快速轮询
            if core.consumeRedrawRequest() { _needRedraw = true }
        }
    }
}

// 创建窗口实例，opts: {title, w, h, flags}
export func createWindow(Dict opts): Window {
    Window win = new Window(); win.init(opts); return win
}



