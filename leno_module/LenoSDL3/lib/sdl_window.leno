    // 添加表格，opts: {x, y, w, h, headers, col_widths, aligns, rows, row_h, header_h, sortable, zebra, ...}
    // 返回 Table，可 .on_select(func(int){...}) / .on_cell(func(int,int){...}) / .set_rows(...) / .add_row(...)
    func addTable(Dict opts): Table {
        Table t = tbl.createTable(opts)
        t.set_window_size(_w, _h)
        t.set_window_handle(handle)
        _widgets.add(t as Widget)
        _widgetZ.add(opts.get("z", 0.0))
        if t.is_context_menu_enabled() { menu.registerContextMenu(t.get_context_menu()) }   // 上下文菜单登记，由窗口第二遍按窗口隔离绘制
        return t
    }

    // 添加水平布局容器，opts: {x, y, w, h, spacing, padX, padY}
    // hb.add(win.addButton({...}), {expand:true}) 占满剩余宽度；{align:1} 交叉轴居中
    func addHBox(Dict opts): HBox {
        HBox b = lay.createHBox(opts)
        _widgets.add(b as Widget)
        _widgetZ.add(opts.get("z", 0.0))
        b._bind_window(handle)
        return b
