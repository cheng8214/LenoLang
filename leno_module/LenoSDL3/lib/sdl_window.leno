    // 添加带标题的分组容器，opts: {x, y, w, h, title, bg_rgb, border_rgb, title_rgb, radius, ...}
    // 用 gb.add(win.addButton({x, y, ...})) 把子控件挂到分组（子控件用窗口绝对坐标）
    func addGroupBox(Dict opts): GroupBox {
