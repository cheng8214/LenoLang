    // 添加垂直布局容器，opts: {x, y, w, h, spacing, padX, padY}
    func addVBox(Dict opts): VBox {
        VBox b = lay.createVBox(opts)
        _widgets.add(b as Widget)
        _widgetZ.add(opts.get("z", 0.0))
        b._bind_window(handle)
        return b
