    // 添加树视图，opts: {x, y, w, h, items, row_h, indent, mode, show_check, context_menu, on_change, ...}
    // 返回 TreeView，可 .on_change(func(Array[int]){...}) / .on_context(...) / .on_toggle(...) /
    //   .expand/.collapse_all/.get_selected_id/.get_node/.add_child/.remove_node 等
    func addTreeView(Dict opts): TreeView {
