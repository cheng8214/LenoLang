    // 添加折线图，opts: {x, y, w, h, title, font_size, show_grid, show_points}
    // 返回 LineChart，可 .set_data(Array[string] xlabels, Array[Array[float]] series, Array[string] names)
    func addLineChart(Dict opts): LineChart {
