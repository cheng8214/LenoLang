    // 添加饼图，opts: {x, y, w, h, title, font_size}
    // 返回 PieChart，可 .set_data(Array[string] labels, Array[float] values)
    func addPieChart(Dict opts): PieChart {
        PieChart c = cht.createPieChart(opts)
        _widgets.add(c as Widget)
        _widgetZ.add(opts.get("z", 0.0))
        return c
    }

    // 仅注册窗口（不启动主循环），用于多窗口场景：先逐个 registerOnly，最后 run() 启动循环
    func registerOnly(EventHandler onEvent, RenderCallback onRender) {
        core.startTextInput(handle)      // 启用文本输入（供 Edit 控件使用）
        // ★ 阻塞等待 OS 完成异步窗口状态变更（如创建时带 MAXIMIZED 标志的窗口）。
        //   SDL3 官方 API：SDL_SyncWindow 阻塞直到所有 pending 的窗口状态变更被 OS 应用。
        //   不调用此函数时，Windows 上最大化是异步的——getSize() 可能返回请求尺寸（1000x680）
        //   而非最大化后的实际尺寸（如 1920x1080），导致 SSAA 纹理创建为小尺寸→迷你版闪现。
        _lib.SDL_SyncWindow(handle)
        // ★ 获取窗口实际尺寸（系统可能已最大化/恢复到不同尺寸），
        //   用实际值初始化 SSAA 纹理和根布局，避免首帧渲染到旧尺寸纹理再贴到大窗口左上角
        Size actualSz = getSize()
        _w = actualSz.w; _h = actualSz.h
        Renderer ren = renderer.createRenderer(handle)
        if _aaScale > 0.0 { ren.enableSSAA(actualSz.w, actualSz.h, _aaScale) }
        // ★ 同步根布局到实际窗口尺寸（setRootAt 在 run() 前调用，此时窗口可能已被系统改变尺寸）
        if _root != null {
            _root.set_pos(_rootX, _rootY)
            _root.set_size(_float(actualSz.w) - _rootX, _float(actualSz.h) - _rootY)
        }
        // ★ 同步 MenuBar 到实际窗口尺寸（系统可能已最大化）
        float _tbH0 = _findTitleBarHeight(_widgets)
        for _menus.len() to mi {
            MenuBar mb = _menus[mi]
            mb.set_pos(0, _tbH0)
            mb.set_size(_float(actualSz.w), mb.get_h())
            mb.setWindowSize(actualSz.w, actualSz.h)
        }
        // ★ 同步 Table/TreeView 内嵌上下文菜单的窗口尺寸（供右键菜单边界夹紧）
        for _widgets.len() to wi {
            var widget = _widgets[wi]
            if widget is Table {
                Table t = widget; t.set_window_size(actualSz.w, actualSz.h)
            } else if widget is TreeView {
                TreeView tv = widget; tv.set_window(actualSz.w, actualSz.h)
            }
        }
        _runWids.add(getID())
        _runHnds.add(handle)
        _runRens.add(ren)
        _runEvts.add(onEvent)
        _runRends.add(onRender)
        _runWidgets.add(_widgets)    // 统一关联控件列表
        _runWidgetZ.add(_widgetZ)    // 统一关联 z 值列表
        _runMenus.add(_menus)        // 菜单栏集合（用于第二遍 overlay 绘制）
        MenuBar? cb = _ctxBar
        if cb is MenuBar { _runCtxBar.add(cb); _runCtxIdx.add(_ctxIdx) }
        else { _runCtxBar.add(menu.createMenuBar({})); _runCtxIdx.add(-1) }   // 占位（idx=-1 表示未注册，run 中不弹）
        _runRoots.add(_root)         // 根布局控件
        _runRootX.add(_rootX)         // 根布局偏移
        _runRootY.add(_rootY)
        _runW.add(actualSz.w); _runH.add(actualSz.h)
        _runDialogHidden.add(_dialogHidden)   // 对话框窗口：首帧渲染后自动 show
        _runTransparent.add(_transparent)    // 透明窗口标志
        _runOverlays.add(_overlay)           // 叠加层回调（可空）
        _runShortcuts.add(_shortcuts)          // 快捷键列表
        _runShortcutGuards.add(_shortcutGuard) // 快捷键守卫
    }

    // 运行主循环（回调模式，支持多窗口）
    // 单窗口：直接调用 run() 注册并启动循环
    // 多窗口：各窗口先 registerOnly()，最后一个 run() 启动循环
    func run(EventHandler onEvent, RenderCallback onRender) {
        registerOnly(onEvent, onRender)
        if _runLoopActive { return }
        _runLoopActive = true

        // ★ 首帧前检测：SDL_SyncWindow 已在 registerOnly 中阻塞等待 OS 完成最大化，
        //   正常情况下此处尺寸应与 registerOnly 时一致。此检测作为安全网，防止极端时序下
        //   registerOnly 到 run() 之间窗口尺寸再次变化（如用户快速操作）。
        for _runWids.len() to i {
            SDL_Point pt = SDL_Point.malloc()
            _lib.SDL_GetWindowSize(_runHnds[i], &pt.x, &pt.y)
            if pt.x != _runW[i] or pt.y != _runH[i] {
                _runRens[i].resizeSSAA(pt.x, pt.y)
                _runW[i] = pt.x; _runH[i] = pt.y
                var rootWid = _runRoots[i]
                rootWid?.set_pos(_runRootX[i], _runRootY[i])
                rootWid?.set_size(_float(pt.x) - _runRootX[i], _float(pt.y) - _runRootY[i])
                // ★ 同步 MenuBar 尺寸到满宽（首帧尺寸可能与 registerOnly 时不同）
                float _tbH1 = _findTitleBarHeight(_runWidgets[i])
                var menus0 = _runMenus[i]
                for menus0.len() to mi0 {
                    MenuBar bar = menus0[mi0]
                    bar.set_pos(0, _tbH1)
                    bar.set_size(_float(pt.x), bar.get_h())
                    bar.setWindowSize(pt.x, pt.y)
                }
                // ★ 同步 Table/TreeView 窗口尺寸 + Splitter 向下传播（供内部右键菜单边界夹紧）
                var widgets0 = _runWidgets[i]
                for widgets0.len() to wi0 {
                    var widget = widgets0[wi0]
                    if widget is Table { Table t = widget; t.on_window_resize(pt.x, pt.y) }
                    else if widget is TreeView { TreeView tv = widget; tv.on_window_resize(pt.x, pt.y) }
                    else if widget is Splitter { Splitter sp = widget; sp._bind_window_size(_runHnds[i], pt.x, pt.y) }
                }
                // 根布局为 Splitter 时向下传播窗口尺寸（根布局内嵌的 Table 可能不在 _widgets 顶层）
                var rw0 = rootWid
                if rw0 is Splitter { Splitter sp = rw0; sp._bind_window_size(_runHnds[i], pt.x, pt.y) }
            }
            pt.free()
        }

        Event ev = event.createEvent()
        bool _needRedraw = true       // 初始绘制一次
        int  _lastRenderTicks = core.getTicks()   // 上次渲染时刻，用于帧率节流
        int  _throttleMs = if _maxFPS > 0 then 1000 / _maxFPS else 1
        int _sizeSyncRemaining = 10   // 安全网：前 N 帧持续检查窗口尺寸（SDL_SyncWindow 已解决主问题）
        while true {
            core.resetFrameCursor()   // 每帧开始：清空本帧光标请求
            bool _hadEvent = false
            // 动态计算等待时长：有重绘请求时节流至目标 FPS，空闲时按定时器触发时刻
            int timeoutMs = 500
            if _needRedraw {
                int elapsed = core.getTicks() - _lastRenderTicks
                int remain = _throttleMs - elapsed
                if remain < 1 { remain = 1 }
                if remain > timeoutMs { remain = timeoutMs }
                timeoutMs = remain
            } else {
                int nextTM = timer.nextTimerMs()
                if nextTM >= 0 {
                    int wait = nextTM - core.getTicks()
                    if wait < 1 { wait = 1 }
                    if wait > 100 { wait = 100 }
                    timeoutMs = wait
                }
                // ★ Tooltip 等待：将 poll 超时设为 tooltip 剩余等待时间，
                //   到期后唤醒一次渲染以显示 tooltip，而非每帧 60fps 空转重绘。
                //   旧方案 tipWaiting() 恒为 true → _needRedraw 恒 true → 60fps 全量重绘，
                //   在弱 CPU 上仅 hover 表格就能占 30%+ CPU。
                int tipRemain = tip.tipRemainingMs()
                if tipRemain >= 0 and tipRemain < timeoutMs { timeoutMs = tipRemain }
                if timeoutMs < 1 { timeoutMs = 1 }
            }
            int _t0 = core.getTicks()
            ev.waitTimeout(timeoutMs)
            // 兜底：若 waitTimeout 提前返回（实际等待 < 5ms 且无事件），
            // 强制 Sleep 补足，防止事件循环高频空转→CPU 占用异常
            int _wakeTick = core.getTicks()
            int _wakeWait = _wakeTick - _t0
            if not ev.has and _wakeWait < 5 { core.delay(5 - _wakeWait) }
            // ★ Motion 事件合并：鼠标快速移动时 SDL 队列中会堆积大量连续 motion 事件，
            //   每个都触发全控件 process()。弱 CPU 上导致 CPU 占用飙升。
            //   合并策略：只保留同窗口的最后一个 motion 事件，丢弃中间的。
            //   _motionBuf 保存最新 motion，_deferredBuf 保存合并期间遇到的非 motion 事件。
            Ptr[u8] _motionBuf = ffi.malloc(128)
            Ptr[u8] _deferredBuf = ffi.malloc(128)
            bool _hasDeferred = false
            while ev.has {
                // 鼠标移动(motion)不强制整窗重绘：光标为 OS 级、hover 变化已由控件
                // markFrameRedraw() 请求重绘；否则每次移动都触发全窗清屏+全控件重绘，
                // 偶发呈现异常会让控件（如表）整块露出背景而“闪一下”。
                // 滚轮/点击/resize/键盘等非 motion 事件仍强制重绘。
                if not ev.isMouseMotion() { _hadEvent = true }
                if ev.isQuit() {
                    for _runWids.len() to i {
                        // 根销毁：退出前先释放所有控件资源（字体等），沿父子树递归清理
                        var ws = _runWidgets[i]
                        if ws != null { for ws to w { w.dispose() } }
                        _runRens[i].destroy()
                        _lib.SDL_DestroyWindow(_runHnds[i])
                        _windowCount -= 1
                    }
                    ev.uninit()
                    if _windowCount <= 0 { core.quit() }
                    _runLoopActive = false
                    return
                }
                int wid = ev.windowID()
                // 模态：仅栈顶窗口接收事件，其余全部跳过（含主窗口 + 下层模态）
                // 注意：必须继续 poll 前进事件队列，否则 ev.has 恒为 true 导致 while 死循环（窗口假死）
                if _isModal() and wid != _modalTop() {
                    // 用户点击了非模态窗口（如父窗口标题栏），OS 已把父窗口提到前面；
                    // 立刻把模态窗口 raise 回来，防止对话框被遮挡
                    if ev.isWindowFocusGained() or ev.isMouseButtonDown() {
                        raiseWindow(_modalTop())
                    }
                    ev.poll(); continue
                }
                // ★ Motion 事件合并：当前事件是鼠标移动时，连续 poll 直到找到最后一个
                //   同窗口 motion 事件，中间的全部丢弃。若遇到非 motion 事件则暂存，
                //   处理完 motion 后再处理。这样无论队列堆积多少 motion，每帧只处理 1 个。
                if ev.isMouseMotion() and not _hasDeferred {
                    ev.saveRaw(_motionBuf)
                    bool _coalescing = true
                    while _coalescing {
                        ev.poll()
                        if not ev.has {
                            ev.restoreRaw(_motionBuf)
                            ev.has = true
                            _coalescing = false
                        } else if ev.isMouseMotion() and ev.windowID() == wid {
                            ev.saveRaw(_motionBuf)   // 更新为更新的 motion
                        } else {
                            // 遇到非 motion 事件（或其它窗口的 motion）：暂存，先处理 motion
                            ev.saveRaw(_deferredBuf)
                            ev.restoreRaw(_motionBuf)
                            ev.has = true
                            _hasDeferred = true
                            _coalescing = false
                        }
                    }
                }
                for _runWids.len() to i {
                    if _runWids[i] == wid {
                        // ★ 快捷键优先处理：键按下事件先尝试匹配已注册快捷键，
                        //   匹配成功则跳过用户事件处理器（避免重复处理）；
                        //   守卫回调返回 true 时阻止快捷键（如 Edit/Table 编辑中）
                        bool _shortcutHandled = false
                        if ev.isKeyDown() { _shortcutHandled = _tryShortcut(i, ev) }
                        if not _shortcutHandled and (not _runEvts[i](ev) or ev.isWindowClose()) {
                            // 模态窗口关闭：弹出栈并恢复焦点到父窗口
                            int _restoreWid = -1
                            if _isModal() and _runWids[i] == _modalTop() {
                                _restoreWid = _modalParent(_runWids[i])
                                _modalStack.pop()
                                // ★ 模态对话框关闭时清除 tooltip 状态：
                                //   对话框打开期间主窗口不接收 motion 事件，tipEndMotion 无法触发清除，
                                //   导致对话框前的 tip 状态残留（_tipText 非空、_tipVisible 可能已为 true）。
                                //   关闭后残留的 tip 会自动弹出并跟随鼠标，必须在此主动清除。
                                tip.tipClear()
                            }
                            // 根销毁：关闭窗口前先释放所有控件资源（字体等），沿父子树递归清理
                            var ws = _runWidgets[i]
                            if ws != null { for ws to w { w.dispose() } }
                            var rt = _runRoots[i]
                            rt?.dispose()
                            _runRens[i].destroy()
                            _lib.SDL_DestroyWindow(_runHnds[i])
                            _windowCount -= 1
                            _runWids.remove(i);  _runHnds.remove(i)
                            _runRens.remove(i); _runEvts.remove(i)
                            _runRends.remove(i); _runWidgets.remove(i); _runWidgetZ.remove(i); _runMenus.remove(i); _runRoots.remove(i); _runRootX.remove(i); _runRootY.remove(i); _runW.remove(i); _runH.remove(i)
                            _runCtxBar.remove(i); _runCtxIdx.remove(i)
                            _runDialogHidden.remove(i); _runTransparent.remove(i)
                            _runOverlays.remove(i)
                            _runShortcuts.remove(i); _runShortcutGuards.remove(i)
                            // 恢复焦点到父窗口（非模态关闭时 _restoreWid 为 -1，跳过）
                            if _restoreWid >= 0 { raiseWindow(_restoreWid) }
                            break
                        }
                    }
                }
                // 自动处理该窗口的所有控件事件
                // 鼠标运动事件：处理前重置 tip 上报标记，处理后若无人上报则清除
                // （解决多控件处理顺序导致的 tipClear 覆盖 tipReport 问题）
                bool _isMotion = ev.isMouseMotion()
                if _isMotion { tip.tipSetWindow(wid); tip.tipBeginMotion() }
                for _runWids.len() to j {
                    if _runWids[j] == wid {
                        // 先处理根布局控件（背景层），再处理 _widgets（覆盖层如 MenuBar）
                        var rootWid = _runRoots[j]
                        // ★ 安全网：每帧向根控件下发窗口句柄，确保所有子控件（含动态添加的、
                        //   或因创建顺序/容器类型遗漏而未收到句柄的）都能拿到 _hwnd。
                        //   _bind_window 是幂等操作（重复设置同一句柄无副作用），开销可忽略。
                        if rootWid is Widget { _refreshWindowHandle(rootWid, _runHnds[j], _runW[j], _runH[j]) }
                        rootWid?.process(ev)
                        var ws = _runWidgets[j]
                        for ws to w { w.process(ev) }
                        break
                    }
                }
                if _isMotion { tip.tipEndMotion() }
                // 窗口级右击上下文菜单（统一在底层接管，而非示例 onEvent）：
                // 先让命中控件自行处理右键（Edit/ComboBox 等会弹出自身菜单并占住弹层捕获区），
                // 若没有任何控件占用弹层，才弹出窗口级菜单，避免「窗口菜单盖住控件菜单」。
                if ev.isMouseButtonDown() and ev.mouseButton() == 3 {
                    for _runWids.len() to j {
                        if _runWids[j] == wid {
                            if _runCtxIdx[j] >= 0 and not core.inPopupCapture(ev.mouseX(), ev.mouseY()) {
                                _runCtxBar[j].openContext(_runCtxIdx[j], ev.mouseX(), ev.mouseY())
                            }
                            break
                        }
                    }
                }
                // 窗口缩放：重建 SSAA 离屏纹理 + 更新逻辑尺寸 + 驱动根布局跟随
                // ★ 不在此处理 WINDOW_MAXIMIZED/WINDOW_RESTORED 事件：这些事件触发时窗口可能尚在
                //   动画过程中，SDL_GetWindowSize 返回的是最终尺寸而非当前实际尺寸，此时重建 SSAA
                //   会导致纹理尺寸与窗口实际尺寸不匹配→缩小版。首次最大化的同步由 _sizeSyncRemaining
                //   在渲染阶段（窗口尺寸已稳定）可靠完成。
                if ev.isWindowResized() {
                    for _runWids.len() to k {
                        if _runWids[k] == wid {
                            SDL_Point pt = SDL_Point.malloc()
                            _lib.SDL_GetWindowSize(_runHnds[k], &pt.x, &pt.y)
                            _runRens[k].resizeSSAA(pt.x, pt.y)
                            // ★ 更新逻辑尺寸（背景填充 + Tooltip 夹紧依赖此值）
                            _runW[k] = pt.x; _runH[k] = pt.y
                            // 驱动根布局控件跟随窗口大小（带偏移）
                            var rootWid = _runRoots[k]
                            rootWid?.set_pos(_runRootX[k], _runRootY[k])
                            rootWid?.set_size(_float(pt.x) - _runRootX[k], _float(pt.y) - _runRootY[k])
                            // ★ 自动同步 MenuBar 尺寸到满宽（此前示例需手动 _updateMenuBar）
                            float _tbH2 = _findTitleBarHeight(_runWidgets[k])
                            var menus = _runMenus[k]
                            for menus.len() to m {
                                MenuBar bar = menus[m]
                                bar.set_pos(0, _tbH2)
                                bar.set_size(_float(pt.x), bar.get_h())
                                bar.setWindowSize(pt.x, pt.y)
                            }
                            // ★ 自动同步窗口尺寸到 Table/TreeView/Splitter（供内部右键菜单边界夹紧）
                            var widgets = _runWidgets[k]
                            for widgets.len() to w {
                                var widget = widgets[w]
                                if widget is Table {
                                    Table t = widget; t.on_window_resize(pt.x, pt.y)
                                } else if widget is TreeView {
                                    TreeView tv = widget; tv.on_window_resize(pt.x, pt.y)
                                } else if widget is Splitter {
                                    Splitter sp = widget; sp._bind_window_size(_runHnds[k], pt.x, pt.y)
                                }
                            }
                            // ★ 根布局为 Splitter 时向下传播窗口尺寸（根布局内嵌的 Table 可能不在 _widgets 顶层）
                            var rootWid2 = _runRoots[k]
                            if rootWid2 is Splitter {
                                Splitter sp = rootWid2; sp._bind_window_size(_runHnds[k], pt.x, pt.y)
                            }
                            pt.free()
                            break
                        }
                    }
                }
                // 获取队列中下一个事件（或恢复合并期间暂存的非 motion 事件）
                if _hasDeferred {
                    ev.restoreRaw(_deferredBuf)
                    ev.has = true
                    _hasDeferred = false
                } else {
                    ev.poll()
                }
            }
            ffi.free(_motionBuf); ffi.free(_deferredBuf)
            core.applyFrameCursor()    // 帧末：按本帧各控件的请求统一设置一次光标（避免互相覆盖）
            if _runWids.len() == 0 {
                ev.uninit()
                if _windowCount <= 0 { core.quit() }
                _runLoopActive = false
                return
            }
            // 驱动所有定时器（在事件轮询外，确保 idle 期间也能触发定时器与自动重绘）
            timer.tickAllTimers()
            // 事件驱动重绘：非 motion 事件/动画请求/tooltip就绪时才渲染，空闲时跳过以降低 CPU 占用。
            // 注意：纯鼠标移动(motion)不再触发整窗重绘——其光标为 OS 级、hover 变化由控件
            // markFrameRedraw() 单独请求；否则每次移动都整窗清屏+重绘会偶发“闪一下”。
            // ★ Tooltip 优化：旧方案 tipWaiting() 在等待延迟期间恒返回 true，导致每帧 60fps
            //   全量重绘（即使画面无任何变化）。新方案仅在延迟到期时（tipRemainingMs()==0）
            //   触发一次重绘以显示 tooltip，等待期间通过 poll 超时挂起，CPU 降至接近 0。
            if _hadEvent { _needRedraw = true }
            if core.consumeRedrawRequest() { _needRedraw = true }
            if tip.tipRemainingMs() == 0 { _needRedraw = true }
            if _needRedraw {
                int now = core.getTicks()
                if now - _lastRenderTicks >= _throttleMs {   // 节流：距上次渲染不足节流间隔则跳过
                    _lastRenderTicks = now
                    _needRedraw = false   // 清除标记；动画控件在 render 时可调用 requestRedraw() 请求下一帧
                    // ★ 安全网尺寸同步：SDL_SyncWindow 已在 registerOnly 中阻塞等待 OS 完成最大化，
                    //   正常情况下首帧 getSize() 已返回正确尺寸。此多帧检查仅作为极端时序下的
                    //   兜底（如某些 Windows 版本 SyncWindow 返回后仍有微小延迟），检测到变化
                    //   立即重建 SSAA 纹理并同步根布局。未变化时仅多一次 SDL_GetWindowSize 调用。
                    if _sizeSyncRemaining > 0 {
                        _sizeSyncRemaining = _sizeSyncRemaining - 1
                        for _runWids.len() to fi {
                            SDL_Point fpt = SDL_Point.malloc()
                            _lib.SDL_GetWindowSize(_runHnds[fi], &fpt.x, &fpt.y)
                            if fpt.x != _runW[fi] or fpt.y != _runH[fi] {
                                _runRens[fi].resizeSSAA(fpt.x, fpt.y)
                                _runW[fi] = fpt.x; _runH[fi] = fpt.y
                                var fRoot = _runRoots[fi]
                                fRoot?.set_pos(_runRootX[fi], _runRootY[fi])
                                fRoot?.set_size(_float(fpt.x) - _runRootX[fi], _float(fpt.y) - _runRootY[fi])
                                var fMenus = _runMenus[fi]
                                float _tbH3 = _findTitleBarHeight(_runWidgets[fi])
                                for fMenus.len() to fmi {
                                    MenuBar fbar = fMenus[fmi]
                                    fbar.set_pos(0, _tbH3)
                                    fbar.set_size(_float(fpt.x), fbar.get_h())
                                    fbar.setWindowSize(fpt.x, fpt.y)
                                }
                                var fWidgets = _runWidgets[fi]
                                for fWidgets.len() to fwi {
                                    var fw = fWidgets[fwi]
                                    if fw is Table { Table ft = fw; ft.on_window_resize(fpt.x, fpt.y) }
                                    else if fw is TreeView { TreeView ftv = fw; ftv.on_window_resize(fpt.x, fpt.y) }
                                    else if fw is Splitter { Splitter fsp = fw; fsp._bind_window_size(_runHnds[fi], fpt.x, fpt.y) }
                                }
                                var frw = fRoot
                                if frw is Splitter { Splitter fsp = frw; fsp._bind_window_size(_runHnds[fi], fpt.x, fpt.y) }
                            }
                            fpt.free()
                        }
                    }
                    for _runWids.len() to i {
                    // 每帧清屏：用 fillRect 打满整个窗口代替 SDL_RenderClear
                    // SDL_RenderClear 在 Win/D3D 后端可能不走 back buffer 缓冲，导致短暂黑闪
                    // 透明窗口跳过背景填充，保留 alpha=0 区域透明
                    // 使用主题背景色而非硬编码黑色，消除首帧黑闪
                    var ren = _runRens[i]
                    // ★ SSAA：每帧渲染前重新设置渲染目标到离屏高分辨率纹理 + 缩放
                    // present() 每帧执行后会重置渲染目标为窗口、缩放为 1.0，
                    // 必须在此切回 SSAA 纹理，否则后续 fillRect/控件绘制全部直接画到窗口、SSAA 失效
                    ren.beginFrame()
                    if not _runTransparent[i] {
                        Theme th = theme.getTheme()
                        ren.setColor(th.bgR, th.bgG, th.bgB, 255)
                        ren.fillRect(0, 0, _float(_runW[i]), _float(_runH[i]))
                    }
                    _runRends[i](_runRens[i])
                    // 弹层捕获区：每帧渲染前清空，由展开的下拉框在 renderPopup 里重新登记
                    core.clearPopupCapture()
                    // 先渲染根布局控件（背景层），再渲染 _widgets（按 z 值排序后层叠）
                    var rootWid = _runRoots[i]
                    rootWid?.render(_runRens[i])
                    // 自动渲染该窗口的所有控件（z 值小的先画，大的后画；同 z 值保持添加顺序）
                    var ws = _runWidgets[i]
                    var wz = _runWidgetZ[i]
                    int wn = ws.len()
                    if wn > 0 {
                        // 构建排序索引（稳定排序：同 z 值保持原始顺序）
                        Array[int] order = []
                        for wn to k { order.add(k) }
                        // 选择排序（控件数量通常 < 50，不需要复杂排序算法）
                        for wn to k {
                            int minIdx = k
                            int j = k + 1
                            while j < wn {
                                if wz[order[j]] < wz[order[minIdx]] { minIdx = j }
                                j = j + 1
                            }
                            if minIdx != k {
                                int tmp = order[k]; order[k] = order[minIdx]; order[minIdx] = tmp
                            }
                        }
                        for wn to k { ws[order[k]].render(_runRens[i]) }
                    }
                    // 第二遍：所有展开的下拉框画在最上层（按窗口隔离；含经 panel/tab/布局添加的，由 registerComboBox 兜底）
                    cbb.renderComboBoxes(_runRens[i], _runHnds[i])
                    // 第二遍：所有展开的下拉菜单画在最上层
                    var mns = _runMenus[i]
                    for mns to mn { mn.renderPopup(_runRens[i]) }
                    // 第二遍：所有展开的控件内嵌右击上下文菜单（Edit 经 panel.add 添加时未进 _menus，
                    // 在此兜底绘制到最上层，避免被同级控件遮挡）
                    menu.renderContextMenus(_runRens[i], _runHnds[i], _runW[i], _runH[i])
                    // Tooltip 浮层：在所有控件与弹层之后绘制，浮在最上层；不拦截输入
                    // tipTick 是全局状态更新，每帧只需调一次（在首个窗口时调用）
                    if i == 0 { tip.tipTick() }
                    tip.tipRender(_runRens[i], _runW[i], _runH[i], _runWids[i])
                    // 叠加层：在所有控件/弹层/Tooltip 之上绘制（拖拽浮动框等），present 之前最后一遍
                    var _ovl = _runOverlays[i]
                    if _ovl != null { _ovl(_runRens[i]) }
                    _runRens[i].present()
                    // 对话框窗口：首帧渲染完后显示（避免创建时闪现默认背景）
                    // show 后立即 raise，确保对话框在主窗口前面
                    if _runDialogHidden[i] {
                        _lib.SDL_ShowWindow(_runHnds[i])
                        _lib.SDL_RaiseWindow(_runHnds[i])
                        _runDialogHidden[i] = false
                    }
                }
                }              // 闭合节流 if
            }
            // 动画控件可能在 render 中调用了 requestRedraw() → 标记快速轮询
            if core.consumeRedrawRequest() { _needRedraw = true }
        }
    }
}

// 创建窗口实例，opts: {title, w, h, flags}
export func createWindow(Dict opts): Window {
    Window win = new Window(); win.init(opts); return win
}



