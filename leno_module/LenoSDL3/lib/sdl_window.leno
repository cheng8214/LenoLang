// ★ 注册扩展窗口句柄下发回调：布局容器（HBox/VBox/AnchorBox）遇到 Splitter/Panel/TabControl/
// SpinBox/GroupBox/ScrollView/ComboBox 等后续扩展类型时，通过此回调下发窗口句柄，无需在 sdl_layout 中
// import 这些类型（避免循环依赖）。此前示例需手动调用 _content._bind_window()，现在自动完成。
lay.setExtraPassWindow(func(Widget c, Ptr[u8] hwnd) {
    switch c {
        case is Panel, ScrollView, TabControl, SpinBox, GroupBox, Splitter, ComboBox { c._bind_window(hwnd); return }
        case is Edit { c.set_window(hwnd); return }
        case is Table, TreeView { c.set_window_handle(hwnd); return }
        case is TitleBar { c.set_window_handle(hwnd); return }
    }
})

export alias EventHandler  = func(Event):bool
export alias RenderCallback = func(Renderer)

// ==================== 快捷键系统 ====================
// 上层通过 win.addShortcut("Ctrl+C", func() { ... }) 注册快捷键，
// 框架自动在事件循环中匹配并执行，无需手动判断 scancode/modifier。
// setShortcutGuard 设置守卫回调：返回 true 时阻止快捷键（如 Edit/Table 编辑中）。

export struct Shortcut {
    string display    // 显示文本: "Ctrl+C", "F5", "Backspace"
    int scancode      // 解析后的 scancode
    int modFlags      // bit 0=Ctrl, 1=Shift, 2=Alt, 3=GUI
    func():void callback
    bool enabled = true
}

// 键名 → scancode 映射表（懒加载）
Dict _keyNameMap = null

func _ensureKeyNameMap() {
    if _keyNameMap != null { return }
    _keyNameMap = {
        "F1": 58, "F2": 59, "F3": 60, "F4": 61, "F5": 62, "F6": 63,
        "F7": 64, "F8": 65, "F9": 66, "F10": 67, "F11": 68, "F12": 69,
        "BACKSPACE": 42, "DELETE": 76, "DEL": 76, "INSERT": 73,
        "ESCAPE": 41, "ESC": 41, "RETURN": 40, "ENTER": 40, "SPACE": 44, "TAB": 43,
        "HOME": 74, "END": 77, "PAGEUP": 75, "PAGEUP": 75, "PAGEDOWN": 78,
        "LEFT": 80, "RIGHT": 79, "UP": 82, "DOWN": 81,
        "A": 4, "B": 5, "C": 6, "D": 7, "E": 8, "F": 9, "G": 10,
        "H": 11, "I": 12, "J": 13, "K": 14, "L": 15, "M": 16,
        "N": 17, "O": 18, "P": 19, "Q": 20, "R": 21, "S": 22,
        "T": 23, "U": 24, "V": 25, "W": 26, "X": 27, "Y": 28, "Z": 29,
        "0": 39, "1": 30, "2": 31, "3": 32, "4": 33, "5": 34,
        "6": 35, "7": 36, "8": 37, "9": 38
    }
}

// 解析快捷键字符串: "Ctrl+C" → {scancode, modFlags}
func _parseShortcut(string key): Dict {
    _ensureKeyNameMap()
    int mods = 0  // bit 0=Ctrl, 1=Shift, 2=Alt, 3=GUI
    string k = key
    while true {
        if k.starts_with("Ctrl+") {
            mods = mods | 1; k = k.slice(5, k.len())
        } eif k.starts_with("Shift+") {
            mods = mods | 2; k = k.slice(6, k.len())
        } eif k.starts_with("Alt+") {
            mods = mods | 4; k = k.slice(4, k.len())
        } eif k.starts_with("GUI+") {
            mods = mods | 8; k = k.slice(4, k.len())
        } else {
            break
        }
    }
    int sc = _int(_keyNameMap.get(k.to_upper(), 0))
    return {scancode: sc, mods: mods}
}

// 多窗口回调缓存
Array[int]             _runWids   = []
Array[Ptr[u8]]            _runHnds   = []
Array[Renderer]        _runRens   = []
Array[EventHandler]    _runEvts   = []
Array[RenderCallback]  _runRends  = []
Array[Array[Widget]]   _runWidgets = []
Array[Array[float]]   _runWidgetZ = []     // 各窗口控件的 z 值数组（与 _runWidgets 并行）
Array[Array[MenuBar]]   _runMenus   = []
Array[MenuBar]          _runCtxBar  = []   // 各窗口级右击上下文菜单（由 setContextMenu 注册，run 自动接管弹出）
Array[int]             _runCtxIdx  = []   // 对应的上下文菜单索引
Array[Widget?]          _runRoots  = []     // 各窗口的根布局控件（setRoot 设置，可空）
Array[float]           _runRootX = []     // 各窗口根布局 X 偏移（如 MenuBar 高度）
Array[float]           _runRootY = []
Array[int]             _runW     = []     // 各窗口逻辑宽（背景填充 + Tooltip 夹紧用）
Array[int]             _runH     = []     // 各窗口逻辑高
Array[bool]            _runDialogHidden = []  // 对话框窗口是否创建时隐藏（首次渲染后 show）
Array[bool]            _runTransparent = []    // 各窗口是否透明（跳过背景填充）
Array[RenderCallback]  _runOverlays = []    // 各窗口叠加层回调（在所有控件/弹层/Tooltip 之上、present 之前调用）
Array[Array[Shortcut]]  _runShortcuts = []    // 各窗口快捷键列表
Array[func():bool]       _runShortcutGuards = [] // 各窗口快捷键守卫回调
var _runLoopActive = false    // 主循环是否已在运行
Array[int] _modalStack = []   // 模态窗口栈（支持嵌套）

// ★ 安全网：每帧向根控件下发窗口句柄，确保所有子控件（含动态添加的）都能拿到 _hwnd。
//   与 Window._passWindowHandle 逻辑一致，但作为模块级函数供事件循环调用（可处理多窗口）。
func _refreshWindowHandle(Widget w, Ptr[u8] hwnd, int ww, int hh) {
    switch w {
        case is Splitter { w._bind_window_size(hwnd, ww, hh); return }
        case is Panel, ScrollView, HBox, VBox, AnchorBox, TabControl, SpinBox, GroupBox, GridLayout, ComboBox { w._bind_window(hwnd); return }
        case is Edit { w.set_window(hwnd); return }
        case is TreeView { w.set_window_handle(hwnd); w.set_window(ww, hh); return }
        case is Table { w.set_window_handle(hwnd); w.set_window_size(ww, hh); return }
        case is TitleBar { w.set_window_handle(hwnd); return }
    }
}

// 模块级快捷键尝试匹配（事件循环中调用，必须在 _runShortcuts/_runShortcutGuards 定义之后）
func _tryShortcut(int winIdx, Event ev): bool {
    if winIdx >= _runShortcuts.len() { return false }
    var shortcuts = _runShortcuts[winIdx]
    if shortcuts.len() == 0 { return false }
    var guard = _runShortcutGuards[winIdx]
    if guard != null {
        if guard() { return false }
    }
    int sc = ev.scancode()
    int mod = ev.keyMod()
    bool ctrl = (mod & 64) != 0 or (mod & 128) != 0
    bool shift = (mod & 1) != 0 or (mod & 2) != 0
    bool alt = (mod & 4) != 0 or (mod & 8) != 0
    bool gui = (mod & 16) != 0 or (mod & 32) != 0
    for shortcuts.len() to si {
        Shortcut s = shortcuts[si]
        if not s.enabled { continue }
        if s.scancode != sc { continue }
        int mf = s.modFlags
        if (mf & 1) != 0 and not ctrl { continue }
        if (mf & 2) != 0 and not shift { continue }
        if (mf & 4) != 0 and not alt { continue }
        if (mf & 8) != 0 and not gui { continue }
        if s.callback != null { s.callback() }
        return true
    }
    return false
}

// 查找控件列表中 TitleBar 的高度（用于 MenuBar 偏移）
func _findTitleBarHeight(Array[Widget] widgets): float {
    if widgets == null { return 0.0 }
    for widgets.len() to i {
        var w = widgets[i]
        if w is TitleBar { TitleBar tb = w; return tb.get_h() }
    }
    return 0.0
}

// 推入模态窗口（runModal 内部调用）
export func pushModal(int w) { _modalStack.add(w) }
// 弹出栈顶：仅当栈顶匹配时才弹出（防止重复弹/弹错）
export func popModalIfTop(int w) {
    if _modalStack.len() > 0 and _modalStack[_modalStack.len() - 1] == w { _modalStack.pop() }
}
// 当前是否为模态状态（栈非空即模态）
func _isModal(): bool { return _modalStack.len() > 0 }
func _modalTop(): int {
    if _modalStack.len() > 0 { return _modalStack[_modalStack.len() - 1] }
    return -1
}

// 获取模态栈中指定窗口下方的窗口 ID（即打开该模态窗口的父窗口）
func _modalParent(int wid): int {
    for _modalStack.len() to i {
        if _modalStack[i] == wid {
            if i > 0 { return _modalStack[i - 1] }
            return -1
        }
    }
    return -1
}

// 按 wid 提升窗口到前台（SDL_RaiseWindow）
export func raiseWindow(int wid) {
    for _runWids.len() to i {
        if _runWids[i] == wid { _lib.SDL_RaiseWindow(_runHnds[i]); return }
    }
}

// 兼容旧 API（已废弃，仅 test_modal_dialog.leno 等旧示例使用）
export func setModalWid(int w) {
    if w < 0 { _modalStack = [] }
    else { _modalStack.add(w) }
}
export func getModalWid(): int { return _modalTop() }

// 仅为注册（不启动循环），给 Dialog 等外部 struct 用
export func registerRun(Ptr[u8] hdl, int wid, Renderer ren, any onEvent, any onRender) {
    _runWids.add(wid)
    _runHnds.add(hdl)
    _runRens.add(ren)
    _runEvts.add(onEvent)
    _runRends.add(onRender)
    _runOverlays.add(null)   // 占位（Dialog 无叠加层）
}


export struct Window {
    Ptr[u8] handle    // SDL_Window 指针
    bool ok       // 窗口是否创建成功
    int _w; int _h; float _aaScale
    int _maxFPS = 30        // 最大渲染帧率（0=不限制）
    Array[Widget] _widgets = []
    Array[float]  _widgetZ = []   // 各控件的 z 值（与 _widgets 并行），渲染时按 z 升序排列
    Array[MenuBar]  _menus  = []   // 菜单栏集合，第二遍画下拉层（盖在最上层）
    MenuBar? _ctxBar              // 窗口级右击上下文菜单（setContextMenu 注册，run 自动接管弹出）
    int    _ctxIdx = -1             // 对应的上下文菜单索引（-1 表示未注册）
    Widget? _root                     // 根布局控件（setRoot/setRootAt 设置），缩放时自动跟随
    float _rootX = 0.0, _rootY = 0.0  // 根布局偏移（如 MenuBar 高度偏移）
    bool _dialogHidden = false        // 对话框窗口：创建时隐藏，首帧渲染完后 show（消除闪现）
    bool _transparent = false          // 透明窗口（跳过背景填充）
    RenderCallback? _overlay = null      // 叠加层渲染回调（setOverlay 设置，在所有控件/弹层之上绘制）
    Array[Shortcut] _shortcuts = []    // 本窗口注册的快捷键
    func():bool _shortcutGuard = null  // 快捷键守卫：返回 true 时阻止快捷键

    // 设置叠加层渲染回调（在所有控件和弹层渲染之后、present 之前调用）
    // 用途：拖拽浮动框、自定义全局浮层等需要绘制在所有控件之上的场景
    func setOverlay(RenderCallback cb) { _overlay = cb }

    // ==================== 快捷键注册 ====================
    // 注册快捷键，key 格式: "F5", "Backspace", "Ctrl+C", "Ctrl+Shift+S"
    // 返回 Shortcut 对象，可通过 .enabled = false 临时禁用
    func addShortcut(string key, func():void cb): Shortcut {
        var parsed = _parseShortcut(key)
        Shortcut s = new Shortcut()
        s.display = key
        s.scancode = parsed.get("scancode", 0)
        s.modFlags = parsed.get("mods", 0)
        s.callback = cb
        _shortcuts.add(s)
        return s
    }

    // 移除已注册的快捷键
    func removeShortcut(Shortcut s) {
        for _shortcuts.len() to i {
            if _shortcuts[i] == s { _shortcuts.remove(i); return }
        }
    }

    // 设置守卫回调：返回 true 时阻止所有快捷键（如 Edit/Table 编辑中）
    func setShortcutGuard(func():bool guard) { _shortcutGuard = guard }

    // opts 支持字段：title(string), w(int), h(int), flags(int)
    func init(Dict opts): bool {
        if not core.initVideo() {
            print("[LenoSDL3] init failed: " + core.getError())
            return false
        }
        string title = opts.get("title", "LenoSDL3")
        int w        = opts.get("w", 800)
        int h        = opts.get("h", 600)
        int flags    = opts.get("flags", 0)
        _w = w; _h = h
        // 检测透明窗口标志
        _transparent = (flags & 0x0000000040000000) != 0
        // 超采样抗锯齿：默认关闭；aa:true / aa:2 / aa:1.5 开启
        _aaScale = 0.0
        var aaOpt = opts.get("aa", 0.0)
        if aaOpt is bool { if aaOpt { _aaScale = 2.0 } }
        else { float a = aaOpt; if a > 0.0 { _aaScale = a } }
        handle = _lib.SDL_CreateWindow(title, w, h, flags)
        ok = handle != null
        if ok { _windowCount = _windowCount + 1 }
        return ok
    }

    // 获取窗口 ID
    func getID(): int {
        return _lib.SDL_GetWindowID(handle)
    }

    func getHandle(): Ptr[u8] { return handle }

    // 设置窗口标题
    func setTitle(string title): bool {
        return _lib.SDL_SetWindowTitle(handle, title)
    }

    // 设置窗口大小
    func setSize(int w, int h): bool {
        return _lib.SDL_SetWindowSize(handle, w, h)
    }

    // 获取窗口真实像素尺寸（HiDPI 时大于逻辑尺寸）
    func getSizeInPixels(): Size {
        SDL_Point pt = SDL_Point.malloc()
        _lib.SDL_GetWindowSizeInPixels(handle, &pt.x, &pt.y)
        Size d = {w: pt.x, h: pt.y}
        pt.free(); return d
    }

    // 获取窗口逻辑尺寸（绘图坐标系使用的尺寸，不受 HiDPI 放大影响）
    func getSize(): Size {
        SDL_Point pt = SDL_Point.malloc()
        _lib.SDL_GetWindowSize(handle, &pt.x, &pt.y)
        Size d = {w: pt.x, h: pt.y}
        pt.free(); return d
    }

    // 设置窗口位置
    func setPosition(int x, int y): bool {
        return _lib.SDL_SetWindowPosition(handle, x, y)
    }

    // 设置窗口是否可调整大小
    func setResizable(bool v) {
        if ok { _lib.SDL_SetWindowResizable(handle, v) }
    }

    // 设置窗口是否有系统标题栏边框（false = 无边框，自绘标题栏用）
    func setBordered(bool v) {
        if ok { _lib.SDL_SetWindowBordered(handle, v) }
    }

    // ==================== 运行时主题切换 ====================
    // 遍历所有控件（含根布局和 MenuBar），对实现 Themeable 的调用 applyTheme
    // 无需关闭/重建窗口，立即生效
    func applyThemeAll(Theme t) {
        // 1. 更新全局主题单例
        theme.setTheme(t)
        // 2. 遍历 _widgets（覆盖层：MenuBar/TitleBar 等）
        for _widgets.len() to i {
            _applyThemeWidget(_widgets[i], t)
        }
        // 3. 遍历根布局控件（背景层：VBox/HBox 内的 Panel/Table/TreeView 等）
        if _root != null { _applyThemeWidget(_root, t) }
        // 4. 请求重绘
        core.requestRedraw()
    }

    // 对单个控件及其子控件应用主题（递归容器）
    func _applyThemeWidget(Widget w, Theme t) {
        switch w {
            case is Button { w.applyTheme(t) }
            case is Label { w.applyTheme(t) }
            case is Edit { w.applyTheme(t) }
            case is Table { w.applyTheme(t) }
            case is TreeView { w.applyTheme(t) }
            case is ComboBox { w.applyTheme(t) }
            case is MenuBar { w.applyTheme(t) }
            case is TitleBar { w.applyTheme(t) }
            case is Splitter {
                w.applyTheme(t)
                // 递归两侧子控件（_first / _second 为 Widget?）
                var f = w._first
                if f is Widget { _applyThemeWidget(f, t) }
                var s = w._second
                if s is Widget { _applyThemeWidget(s, t) }
            }
            case is Panel {
                w.applyTheme(t)
                // ★ 递归 _layoutChild（setLayoutPadded 设置的布局子控件，如 VBox）
                var lc = w._layoutChild
                if lc is Widget { _applyThemeWidget(lc, t) }
                // 递归 children（通过 add() 添加的子控件）
                for w.children.len() to ci { _applyThemeWidget(w.children[ci], t) }
            }
            case is GroupBox {
                w.applyTheme(t)
                // ★ 递归 _layoutChild（setLayoutPadded 设置的布局子控件，如 VBox）
                var glc = w._layoutChild
                if glc is Widget { _applyThemeWidget(glc, t) }
                // 递归 children（通过 add() 添加的子控件）
                for w.children.len() to ci { _applyThemeWidget(w.children[ci], t) }
            }
            case is HBox {
                for w._c.len() to ci { _applyThemeWidget(w._c[ci], t) }
            }
            case is VBox {
                for w._c.len() to ci { _applyThemeWidget(w._c[ci], t) }
            }
            case is GridLayout {
                for w._c.len() to ci { _applyThemeWidget(w._c[ci], t) }
            }
        }
    }

    // 设置最大渲染帧率（默认 30 FPS；0 = 不限制）
    func setMaxFPS(int fps) { _maxFPS = fps }

    // 设置窗口置顶
    func setAlwaysOnTop(bool v): bool {
        return _lib.SDL_SetWindowAlwaysOnTop(handle, v)
    }

    // 设置窗口透明度（0.0 全透明 ~ 1.0 不透明）
    func setOpacity(float v): bool {
        return _lib.SDL_SetWindowOpacity(handle, v)
    }

    // 鼠标锁定 & 相对模式（FPS 游戏用）
    func setMouseGrab(bool v): bool              { return _lib.SDL_SetWindowMouseGrab(handle, v) }
    func getMouseGrab(): bool                    { return _lib.SDL_GetWindowMouseGrab(handle) }
    func setRelativeMouse(bool v): bool          { return _lib.SDL_SetWindowRelativeMouseMode(handle, v) }
    func getRelativeMouse(): bool                { return _lib.SDL_GetWindowRelativeMouseMode(handle) }

    // 限制窗口最小尺寸
    func setMinSize(int w, int h): bool          { return _lib.SDL_SetWindowMinimumSize(handle, w, h) }

    // 窗口闪烁（FLASH_BRIEFLY=短暂, FLASH_UNTIL_FOCUSED=直到获得焦点, FLASH_CANCEL=取消）
    func flash(int op): bool                     { return _lib.SDL_FlashWindow(handle, op) }

    // 设置窗口图标（surface 来自 SDL3.loadImage 等）
    func setIcon(Ptr[u8] icon): bool { return _lib.SDL_SetWindowIcon(handle, icon) }

    // 全屏切换
    func setFullscreen(bool v): bool { return _lib.SDL_SetWindowFullscreen(handle, v) }

    // 前置窗口并获取焦点
    func raise(): bool       { return _lib.SDL_RaiseWindow(handle) }

    // 窗口状态控制
    func show(): bool        { return _lib.SDL_ShowWindow(handle) }
    func hide(): bool        { return _lib.SDL_HideWindow(handle) }
    func maximize(): bool    { return _lib.SDL_MaximizeWindow(handle) }
    func minimize(): bool    { return _lib.SDL_MinimizeWindow(handle) }
    func restore(): bool     { return _lib.SDL_RestoreWindow(handle) }

    // 销毁窗口（同时释放所有控件资源：字体等，避免窗口关闭后字体泄漏）
    func destroy() {
        if ok {
            // 根销毁：先释放所有控件资源，沿父子树递归清理
            for _widgets to w { w.dispose() }
            _root?.dispose()
            _lib.SDL_DestroyWindow(handle); handle = null; ok = false; _windowCount = _windowCount - 1
        }
    }

    // 手动创建渲染器（供轮询模式使用）
    func createRenderer(): Renderer {
        return renderer.createRenderer(handle)
    }

    // 添加定时器（毫秒），用法: Timer t = win.addTimer(200, func() { ... })
    func addTimer(int ms, func():void cb): Timer {
        Timer t = new Timer(); t.set(ms, cb); timer.registerTimer(t); return t
    }

    // 添加一次性定时器
    func addTimerOnce(int ms, func():void cb): Timer {
        Timer t = new Timer(); t.setOnce(ms, cb); timer.registerTimer(t); return t
    }

    // 添加按钮，opts: {text, x, y, w, h, r, g, b}
    // 返回 Button，可 .on_click(func() { ... })
    func addButton(Dict opts): Button {
        Button b = btn.createButton(opts)
        _widgets.add(b as Widget)
        _widgetZ.add(opts.get("z", 0.0))
        return b
    }

    // 添加标签，opts: {text, x, y, font_size, rgb, align}
    func addLabel(Dict opts): Label {
        Label l = lbl.createLabel(opts)
        _widgets.add(l as Widget)
        _widgetZ.add(opts.get("z", 0.0))
        return l
    }

    // 添加文本编辑框，opts: {text, x, y, w, h, placeholder, password, readonly}
    func addEdit(Dict opts): Edit {
        Edit ed = edt.createEdit(opts)
        ed.set_window(handle)
        ed.set_window_size(_w, _h)
        if ed.is_context_menu_enabled() { menu.registerContextMenu(ed.get_context_menu()) }   // 上下文菜单登记，由窗口第二遍按窗口隔离绘制
        _widgets.add(ed as Widget)
        _widgetZ.add(opts.get("z", 0.0))
        return ed
    }

    // 通用控件注册：任何 impl Widget 的控件（含第三方自定义控件）都能被 run() 自动管理
    // z 值默认 0.0；如需自定义层级用 addZ(w, z) 或 setWidgetZ(w, z)
    func add(Widget w): Widget {
        _widgets.add(w)
        _widgetZ.add(0.0)
        // 绑定窗口句柄：容器向下传递，Edit/Table/TreeView/TitleBar 直接设置
        switch w {
            case is Panel, ScrollView, HBox, VBox, AnchorBox, TabControl, SpinBox, GroupBox, Splitter {
                w._bind_window(handle); return w
            }
            case is Edit {
                w.set_window(handle); return w
            }
            case is TreeView {
                w.set_window_handle(handle)
                w.set_window(_w, _h); return w
            }
            case is Table {
                w.set_window_handle(handle)
                w.set_window_size(_w, _h); return w
            }
            case is TitleBar {
                w.set_window_handle(handle); return w
            }
        }
        return w
    }

    // 带层级的控件注册：z 值大的控件画在 z 值小的控件之上
    func addZ(Widget w, float z): Widget {
        _widgets.add(w)
        _widgetZ.add(z)
        switch w {
            case is Panel, ScrollView, HBox, VBox, AnchorBox, TabControl, SpinBox, GroupBox, Splitter {
                w._bind_window(handle); return w
            }
            case is Edit {
                w.set_window(handle); return w
            }
            case is TreeView {
                w.set_window_handle(handle)
                w.set_window(_w, _h); return w
            }
            case is Table {
                w.set_window_handle(handle)
                w.set_window_size(_w, _h); return w
            }
            case is TitleBar {
                w.set_window_handle(handle); return w
            }
        }
        return w
    }

    // 设置已有控件的 z 值（用于运行时动态调整层级）
    func setWidgetZ(Widget w, float z) {
        for _widgets.len() to i {
            if _widgets[i] == w { _widgetZ[i] = z; return }
        }
    }

    // 设置根布局控件：窗口缩放时自动把根控件尺寸设为窗口大小并驱动内部布局重排
    // ★ 同时下发窗口句柄（等价于 win.add 的 _bind_window），确保根控件内部的 Edit/TreeView/ComboBox 等能正常工作
    func setRoot(Widget root) {
        _root = root
        _rootX = 0.0; _rootY = 0.0
        root.set_pos(0, 0)
        root.set_size(_w, _h)
        _passWindowHandle(root)
    }

    // 设置根布局控件（带偏移）：窗口缩放时自动把根控件位置/尺寸设为 (x,y,winW-x,winH-y)
    // 典型场景：顶部 MenuBar 占 h=30，根布局从 (0,30) 开始填满剩余空间
    func setRootAt(Widget root, float ox, float oy) {
        _root = root
        _rootX = ox; _rootY = oy
        root.set_pos(ox, oy)
        root.set_size(_float(_w) - ox, _float(_h) - oy)
        _passWindowHandle(root)
    }

    // 向控件下发窗口句柄（与 add() 中的 switch 逻辑一致）
    // 容器类型递归向下传递；Edit/TreeView/Table 直接设置
    func _passWindowHandle(Widget w) {
        switch w {
            case is Splitter {
                // ★ Splitter 需要传递窗口尺寸，以便向下传播给内嵌的 Table/TreeView
                w._bind_window_size(handle, _w, _h); return
            }
            case is Panel, ScrollView, HBox, VBox, AnchorBox, TabControl, SpinBox, GroupBox {
                w._bind_window(handle); return
            }
            case is Edit {
                w.set_window(handle); return
            }
            case is TreeView {
                w.set_window_handle(handle)
                w.set_window(_w, _h); return
            }
            case is Table {
                w.set_window_handle(handle)
                w.set_window_size(_w, _h); return
            }
            case is TitleBar {
                w.set_window_handle(handle); return
            }
        }
    }

    // 添加复选框，opts: {text, x, y, box, checked, on_change}
    // 返回 CheckBox，可 .on_change(func(bool){...}) / .set_checked(bool) / .is_checked()
    func addCheckBox(Dict opts): CheckBox {
        CheckBox c = chk.createCheckBox(opts)
        _widgets.add(c as Widget)
        _widgetZ.add(opts.get("z", 0.0))
        return c
    }

    // 添加单选按钮，opts: {text, x, y, group, checked, on_change}
    // 同一 group 内互斥（由控件内部注册表实现）
    func addRadioButton(Dict opts): RadioButton {
        RadioButton r = rb.createRadioButton(opts)
        r.setWindowHandle(handle)   // 让同组互斥按窗口隔离（避免跨窗口同组互相取消）
        _widgets.add(r as Widget)
        _widgetZ.add(opts.get("z", 0.0))
        return r
    }

    // 添加开关，opts: {text, x, y, w, h, on, on_change}
    func addToggle(Dict opts): Toggle {
        Toggle t = tgl.createToggle(opts)
        _widgets.add(t as Widget)
        _widgetZ.add(opts.get("z", 0.0))
        return t
    }

    // 添加滑块，opts: {x, y, w, h, min, max, value, step, vertical, on_change}
    // 返回 Slider，可 .set_value(float) / .get_value() / .on_change(func(float){...})
    func addSlider(Dict opts): Slider {
        Slider s = sld.createSlider(opts)
        _widgets.add(s as Widget)
        _widgetZ.add(opts.get("z", 0.0))
        return s
    }

    // 添加进度条，opts: {x, y, w, h, min, max, value, clickable, show_text, on_change}
    func addProgressBar(Dict opts): ProgressBar {
        ProgressBar p = prg.createProgressBar(opts)
        _widgets.add(p as Widget)
        _widgetZ.add(opts.get("z", 0.0))
        return p
    }

    // 添加列表框，opts: {x, y, w, h, items, item_h, mode, selected, on_change}
    // mode: 0=单选, 1=多选；on_change 回调收到选中的索引数组 Array[int]
    func addListBox(Dict opts): ListBox {
        ListBox lb2 = lb.createListBox(opts)
        _widgets.add(lb2 as Widget)
        _widgetZ.add(opts.get("z", 0.0))
        return lb2
    }

    // 添加下拉框，opts: {x, y, w, h, items, item_h, popup_h, placeholder, selected, on_change}
    // on_change 回调收到选中索引 int
    func addComboBox(Dict opts): ComboBox {
        ComboBox cb = cbb.createComboBox(opts)
        cb.setWindowHandle(handle)   // 让下拉层按窗口隔离绘制（工厂已登记到 registerComboBox）
        _widgets.add(cb as Widget)
        _widgetZ.add(opts.get("z", 0.0))
        return cb
    }

    // 添加菜单栏，opts: {x, y, w, h, menus:[{title, items:[...]}], item_h, font_size, ...}
    // 下拉层自动盖在最上层（renderPopup 第二遍绘制 + 弹层捕获区）
    func addMenuBar(Dict opts): MenuBar {
        MenuBar m = menu.createMenuBar(opts)
        m.setWindowHandle(handle)   // 让活动菜单按窗口隔离（避免跨窗口互相抢互斥）
        _widgets.add(m as Widget)
        _widgetZ.add(opts.get("z", 0.0))
        _menus.add(m)
        m.setWindowSize(_w, _h)   // 供上下文菜单弹出时按窗口边界夹紧
        return m
    }

    // 注册窗口级右击上下文菜单（只需调用一次）。之后 run 会在每帧事件处理中统一接管右击：
    // 若命中控件自行弹出了自身菜单（占用弹层），则不弹窗口菜单；否则才弹本菜单。
    // 这样「控件菜单优先、窗口菜单兜底」由底层统一保证，示例无需在 onEvent 里处理右键。
    func setContextMenu(MenuBar bar, int ctxIdx) { bar.setWindowHandle(handle); _ctxBar = bar; _ctxIdx = ctxIdx }

    // 添加面板容器，opts: {x, y, w, h, bg, border, radius, border_alpha, clip}
    // 用 panel.add(win.addButton({...})) 把子控件挂到面板（子控件用窗口绝对坐标）
    func addPanel(Dict opts): Panel {
        Panel p = pnl.createPanel(opts)
        _widgets.add(p as Widget)
        _widgetZ.add(opts.get("z", 0.0))
        p._bind_window(handle)
        return p
    }

    // 添加选项卡容器，opts: {x, y, w, h, tabs:[...], active, tab_h, font_size, ...}
    // 用法：tab.addToPage(0, SDL3.createButton({...})) 把子控件挂到指定页（子控件用窗口绝对坐标，落在内容区）
    func addTabControl(Dict opts): TabControl {
        TabControl t = tab.createTabControl(opts)
        _widgets.add(t as Widget)
        _widgetZ.add(opts.get("z", 0.0))
        t._bind_window(handle)
        return t
    }

    // 添加数值微调框，opts: {x, y, w, h, min, max, value, step, int, decimals, ...}
    // 返回 SpinBox，可 .on_change(func(float){...}) / .set_value(float) / .get_value() / .set_range(lo,hi)
    func addSpinBox(Dict opts): SpinBox {
        SpinBox s = spb.createSpinBox(opts)
        _widgets.add(s as Widget)
        _widgetZ.add(opts.get("z", 0.0))
        s._bind_window(handle)
        return s
