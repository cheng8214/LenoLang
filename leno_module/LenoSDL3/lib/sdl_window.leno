    // 添加图片视图，opts: {x, y, w, h, image_path, image_mode, radius, border, alpha, tint, cursor, on_click, ...}
    // image_mode: 0=aspectFit(默认) 1=stretch 2=aspectFill
    // 返回 ImageView，可 .set_image(path) / .set_mode(mode) / .on_click(func(){...}) 等
    func addImageView(Dict opts): ImageView {
        ImageView iv = ivw.createImageView(opts)
        _widgets.add(iv as Widget)
        _widgetZ.add(opts.get("z", 0.0))
        return iv
