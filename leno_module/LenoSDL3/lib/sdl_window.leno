    // 添加模态遮罩（Scrim），默认 z=900（画在普通控件之上、弹层之下）
    // 用法：scrim = win.addScrim({}); scrim.show() / scrim.hide()
    func addScrim(Dict opts): Scrim {
        float zv = opts.get("z", 900.0)
        Scrim s = scrlib.createScrim(opts)
        s.set_pos(0, 0)
        s.set_size(_float(_w), _float(_h))
        _widgets.add(s as Widget)
