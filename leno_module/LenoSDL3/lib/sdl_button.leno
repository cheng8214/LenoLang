// sdl_button.leno — 按钮控件
// 通过 win.addButton({...}) 创建，run() 自动处理交互和渲染
import "sdl_renderer.leno" as ren; use ren.Renderer
import "sdl_font.leno" as fnt; use fnt.Font
import "sdl_event.leno" as evt; use evt.Event
import "sdl_core.leno" as core; use core.(SystemCursor, sdl3)
import "sdl_widget.leno" as wgt; use wgt.Widget
import "sdl_tooltip.leno" as tip
import "sdl_image.leno" as img
import "sdl_theme.leno" as theme; use theme.Theme

export struct Button impl Widget {
    string text = "Button"
    float x = 0.0, y = 0.0, w = 100.0, h = 40.0
    float _radius = 6.0      // 圆角半径
    float _fontSize = 15.0   // 字体大小
    string _fontPath = ""    // 字体路径（空则自动选择）
    int _fontStyle = 0       // 字体样式（STYLE_BOLD|STYLE_ITALIC 等）
    Font? _font              // 字体缓存
    int cr = 60, cg = 140, cb = 220   // 背景色（默认 primary）
    int tr = 255, tg = 255, tb = 255  // 文字色
    int hvr = 0, hvg = 0, hvb = 0     // 悬停背景色（为 0 时自动计算）
    int _prR = 0, _prG = 0, _prB = 0   // 按下背景色（为 0 时自动变暗）
    int _cursor = SystemCursor.POINTER   // 悬停鼠标样式（默认手型）
    func():void _onClick    // 点击回调
    bool hover = false
    bool _wasHover = false  // 上一帧悬停状态
    bool enabled = true
    bool visible = true
    bool _showShadow = true // 是否显示阴影
    bool _showBorder = true // 是否显示边框
    bool _loaded = false
    string _tip = ""        // 悬停提示文本（空 = 不提示）

    // ==================== 图片（图标） ====================
    // 设计参考：Qt setIcon/setIconSize、Material iconGravity、WinForms TextImageRelation
    string _imagePath = ""   // 图片路径（空 = 无图）
    int    _imgPos = 0       // 图标相对文字位置：0=left 1=right 2=top 3=bottom
    float  _imgSize = 0.0    // 图标边长（0 = 自动：取 min(h-8, 自然高)）
    float  _imgGap = 6.0     // 图标与文字间距
    int    _imgAlpha = 255   // 图标透明度 0~255
    int    _imgTintR = -1, _imgTintG = -1, _imgTintB = -1   // 图标着色（-1 = 不着色，其余按 [r,g,b] 着色）
    Ptr[u8]? _imgTex   // 图片纹理（懒加载，dispose 释放）
    string _imgLoadPath = "" // 已尝试加载的路径（避免加载失败每帧重试）

    // ==================== 状态图片（对齐 iOS UIButton.setImage(_:forState:)） ====================
    string _imgPathHover = "";    Ptr[u8]? _imgTexHover;    string _imgLoadHover = ""
    string _imgPathPressed = "";  Ptr[u8]? _imgTexPressed;  string _imgLoadPressed = ""
    string _imgPathDisabled = ""; Ptr[u8]? _imgTexDisabled; string _imgLoadDisabled = ""
    bool   _pressed = false       // 鼠标按下且悬停中（用于 pressed 态图片 / 按下高亮）

    // ==================== 内容模式（对齐 iOS contentMode / Android scaleType） ====================
    // 0=aspectFit 默认（保持比例，完整显示在方框内，不拉伸） 1=stretch 拉伸填满 2=aspectFill 覆盖填满(裁剪)
    int _imgMode = 0

    // ==================== 背景图（对齐 iOS setBackgroundImage） ====================
    string _bgImagePath = ""; Ptr[u8]? _bgTex; string _bgLoadPath = ""

    // ==================== 预设类型 ====================
    func _apply_type(string t) {
        Theme th = theme.getTheme()
        switch t {
            case "primary"  { cr = th.btnPrimaryR;  cg = th.btnPrimaryG;  cb = th.btnPrimaryB }
            case "danger"   { cr = th.btnDangerR;   cg = th.btnDangerG;   cb = th.btnDangerB }
            case "success"  { cr = th.btnSuccessR;  cg = th.btnSuccessG;  cb = th.btnSuccessB }
            case "warning"  { cr = th.btnWarningR;  cg = th.btnWarningG;  cb = th.btnWarningB }
            case "dark"     { cr = th.btnDarkR;     cg = th.btnDarkG;     cb = th.btnDarkB }
            default {}
        }
    }

    func _ensure_font() {
        if _font == null or not _font.ok {
            if _font != null and _font.ok { fnt.releaseFont(_font) }
            if _fontPath != "" {
                _font = fnt.acquireFont(_fontPath, _fontSize)
            } else {
                _font = fnt.acquireFontAuto(_fontSize)
            }
            if _font.ok and _fontStyle != 0 { _font.setStyle(_fontStyle) }
        }
    }

    // 懒加载图片纹理（需要有效渲染器，render 时调用）
    func _ensure_image(Renderer r) {
        Ptr[u8] h = r.handle
        if _imagePath != "" and _imgTex == null and _imgLoadPath != _imagePath {
            _imgTex = img.loadTexture(h, _imagePath); _imgLoadPath = _imagePath
        }
        if _imgPathHover != "" and _imgTexHover == null and _imgLoadHover != _imgPathHover {
            _imgTexHover = img.loadTexture(h, _imgPathHover); _imgLoadHover = _imgPathHover
        }
        if _imgPathPressed != "" and _imgTexPressed == null and _imgLoadPressed != _imgPathPressed {
            _imgTexPressed = img.loadTexture(h, _imgPathPressed); _imgLoadPressed = _imgPathPressed
        }
        if _imgPathDisabled != "" and _imgTexDisabled == null and _imgLoadDisabled != _imgPathDisabled {
            _imgTexDisabled = img.loadTexture(h, _imgPathDisabled); _imgLoadDisabled = _imgPathDisabled
        }
        if _bgImagePath != "" and _bgTex == null and _bgLoadPath != _bgImagePath {
            _bgTex = img.loadTexture(h, _bgImagePath); _bgLoadPath = _bgImagePath
        }
    }

    // ==================== set 初始化 ====================
    func set(Dict opts) {
        // 主题默认配色（opts 覆盖优先级更高）
        Theme th = theme.getTheme()
        cr = th.btnPrimaryR; cg = th.btnPrimaryG; cb = th.btnPrimaryB
        tr = th.txtOnAccentR; tg = th.txtOnAccentG; tb = th.txtOnAccentB
        text = opts.get("text", "Button")
        x    = opts.get("x", 0)
        y    = opts.get("y", 0)
        w    = opts.get("w", 100)
        h    = opts.get("h", 40)

        // 圆角
        _radius   = opts.get("radius", 6)
        // 字体大小
        _fontSize = opts.get("font_size", 15)
        // 字体路径（空则自动匹配系统字体）
        _fontPath = opts.get("font_path", "")
        // 字体样式（粗体/斜体/下划线等）
        _fontStyle = opts.get("font_style", 0)

        // 默认颜色见字段声明（cr/cg/cb/tr/tg/tb/hvr/hvg/hvb 均有默认，以下仅 opts 覆盖）

        // 预设类型（优先级低于显式 rgb）
        var tp = opts.get("type")
        if tp is string { _apply_type(tp) }

        // bg_rgb: 背景色 [r, g, b]
        var c = opts.get("bg_rgb")
        if c is Array[int] { cr = c[0]; cg = c[1]; cb = c[2] }

        // text_rgb: 文字色 [r, g, b]
        var tc = opts.get("text_rgb")
        if tc is Array[int] { tr = tc[0]; tg = tc[1]; tb = tc[2] }

        // hover_rgb: 悬停背景色 [r, g, b]（不设置则自动加亮）
        var hc = opts.get("hover_rgb")
        if hc is Array[int] { hvr = hc[0]; hvg = hc[1]; hvb = hc[2] }

        // pressed_rgb: 按下背景色 [r, g, b]（不设置则自动变暗）
        var pc = opts.get("pressed_rgb")
        if pc is Array[int] { _prR = pc[0]; _prG = pc[1]; _prB = pc[2] }

        // 外观开关
        _showShadow = opts.get("shadow", true)
        _showBorder = opts.get("border", true)

        // 鼠标样式（默认手型，-1 不改变）
        _cursor = _int(opts.get("cursor", SystemCursor.POINTER))

        // 状态（hover/_wasHover 默认见字段声明；enabled/visible 有 opts 默认）
        enabled = opts.get("enabled", true)
        visible = opts.get("visible", true)
        _tip    = opts.get("tip", "")

        // 图片（图标）
        _imagePath = opts.get("image_path", "")
        var ip = opts.get("image_pos", "left")
        if ip is string {
            switch ip {
                case "left"   { _imgPos = 0 }
                case "right"  { _imgPos = 1 }
                case "top"    { _imgPos = 2 }
                case "bottom" { _imgPos = 3 }
                default       { _imgPos = 0 }
            }
        }
        _imgSize  = opts.get("image_size", 0.0)
        _imgGap   = opts.get("image_gap", 6.0)
        _imgAlpha = opts.get("image_alpha", 255)
        var tint = opts.get("image_tint")
        if tint is Array[int] { _imgTintR = tint[0]; _imgTintG = tint[1]; _imgTintB = tint[2] }

        // 内容模式 / 状态图片 / 背景图
        _imgMode        = opts.get("image_mode", 0)
        _imgPathHover   = opts.get("image_path_hover", "")
        _imgPathPressed = opts.get("image_path_pressed", "")
        _imgPathDisabled = opts.get("image_path_disabled", "")
        _bgImagePath    = opts.get("bg_image", "")

        // 更换任意图片路径时释放旧纹理，下一帧 render 重新加载
        _release_all_images()
        _imgLoadPath = ""; _imgLoadHover = ""; _imgLoadPressed = ""
        _imgLoadDisabled = ""; _bgLoadPath = ""

        _ensure_font()
        _loaded = true
    }

    // ==================== 设置方法 ====================
    func set_text(string t)     { text = t }
    func set_tip(string t)       { _tip = t }
    func set_pos(float px, float py)      { x = px; y = py }
    func set_size(float sw, float sh)     { w = sw; h = sh }
    func set_bounds(float bx, float by, float bw, float bh) {
        x = bx; y = by; w = bw; h = bh
    }
    func set_bg(int r, int g, int b)    { cr = r; cg = g; cb = b }
    func set_text_rgb(int r, int g, int b) { tr = r; tg = g; tb = b }
    func set_hover_rgb(int r, int g, int b) { hvr = r; hvg = g; hvb = b }
    func set_pressed_rgb(int r, int g, int b) { _prR = r; _prG = g; _prB = b }
    func set_font_size(float s) {
        _fontSize = s
        if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null
    }
    func set_font_path(string path) {
        _fontPath = path
        if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null
    }
    func set_font_style(int style) {
        _fontStyle = style
        _ensure_font()
        if _font.ok { _font.setStyle(style) }
    }
    func set_radius(float r)   { _radius = r }
    func set_enabled(bool e)   { enabled = e }
    func set_visible(bool v)    { visible = v }
    func is_visible(): bool     { return visible }
    func set_shadow(bool s)    { _showShadow = s }
    func set_border(bool b)    { _showBorder = b }
    func set_cursor(int cur)   { _cursor = cur }

    // ==================== 图片设置方法 ====================
    func set_image(string path) {
        if _imgTex != null { _release_image() }
        _imagePath = path; _imgTex = null; _imgLoadPath = ""
    }
    func set_image_pos(string pos) {
        switch pos {
            case "left"   { _imgPos = 0 }
            case "right"  { _imgPos = 1 }
            case "top"    { _imgPos = 2 }
            case "bottom" { _imgPos = 3 }
            default       { _imgPos = 0 }
        }
    }
    func set_image_size(float s) { _imgSize = s }
    func set_image_gap(float g)  { _imgGap = g }
    func set_image_alpha(int a)  { _imgAlpha = a }
    func set_image_tint(int r, int g, int b) { _imgTintR = r; _imgTintG = g; _imgTintB = b }
    // 内容模式：0=aspectFit 1=stretch 2=aspectFill
    func set_image_mode(int mode) { _imgMode = mode }
    // 状态图片（对齐 iOS setImage(_:forState:)）：state ∈ "hover" | "pressed" | "disabled" | "normal"(默认)
    func set_image_for_state(string path, string state) {
        switch state {
            case "hover" {
                if _imgTexHover != null { core.lib().SDL_DestroyTexture(_imgTexHover); _imgTexHover = null }
                _imgPathHover = path; _imgLoadHover = ""
            }
            case "pressed" {
                if _imgTexPressed != null { core.lib().SDL_DestroyTexture(_imgTexPressed); _imgTexPressed = null }
                _imgPathPressed = path; _imgLoadPressed = ""
            }
            case "disabled" {
                if _imgTexDisabled != null { core.lib().SDL_DestroyTexture(_imgTexDisabled); _imgTexDisabled = null }
                _imgPathDisabled = path; _imgLoadDisabled = ""
            }
            default {
                if _imgTex != null { core.lib().SDL_DestroyTexture(_imgTex); _imgTex = null }
                _imagePath = path; _imgLoadPath = ""
            }
        }
    }
    // 背景图（对齐 iOS setBackgroundImage / Android background）
    func set_background_image(string path) {
        if _bgTex != null { core.lib().SDL_DestroyTexture(_bgTex); _bgTex = null }
        _bgImagePath = path; _bgLoadPath = ""
    }
    func _release_image() {
        if _imgTex != null { core.lib().SDL_DestroyTexture(_imgTex); _imgTex = null }
    }
    func _release_all_images() {
        if _imgTex != null { core.lib().SDL_DestroyTexture(_imgTex); _imgTex = null }
        if _imgTexHover != null { core.lib().SDL_DestroyTexture(_imgTexHover); _imgTexHover = null }
        if _imgTexPressed != null { core.lib().SDL_DestroyTexture(_imgTexPressed); _imgTexPressed = null }
        if _imgTexDisabled != null { core.lib().SDL_DestroyTexture(_imgTexDisabled); _imgTexDisabled = null }
        if _bgTex != null { core.lib().SDL_DestroyTexture(_bgTex); _bgTex = null }
    }

    // 应用预设类型
    func set_type(string t) { _apply_type(t) }

    // ==================== 查询方法 ====================
    func is_hover(): bool    { return hover }
    func is_pressed(): bool  { return _pressed }
    func is_enabled(): bool  { return enabled }
    func get_text(): string  { return text }
    func get_x(): float      { return x }
    func get_y(): float      { return y }
    func get_w(): float      { return w }
    func get_h(): float      { return h }

    // ==================== 交互 ====================
    func on_click(func():void callback) { _onClick = callback }

    func contains(float mx, float my): bool {
        return mx >= x and mx <= x + w and my >= y and my <= y + h
    }

    // 处理事件（run 内部调用）
    func process(Event ev) {
        if not _loaded { return }
        if not visible { return }
        if not enabled { return }
        // 弹层捕获：事件落在“他人的弹层（如打开的菜单/下拉）范围内时忽略，避免穿透到下层控件
        float mx = ev.mouseX(); float my = ev.mouseY()
        if ev.isMouseWheel() { mx = ev.wheelMouseX(); my = ev.wheelMouseY() }
        if core.inPopupCapture(mx, my) { return }
        if ev.isMouseMotion() {
            _wasHover = hover
            hover = contains(ev.mouseX(), ev.mouseY())
            // hover 状态变化需请求重绘：run 循环已优化为 motion 不整窗重绘，
            // 由控件在视觉状态变化时自行 markFrameRedraw()（对齐 table/edit 等控件）
            if hover != _wasHover { core.markFrameRedraw() } else { core.markFrameMotion() }
            // 鼠标样式切换
            if _cursor >= 0 {
                if hover and not _wasHover { core.setSystemCursor(_cursor) }
                if not hover and _wasHover { core.setSystemCursor(SystemCursor.DEFAULT) }
            }
            // 悬停提示：进入上报、离开清除
            if hover and _tip != "" { tip.tipReport(_tip, ev.mouseX(), ev.mouseY()) }
            else if _wasHover and not hover { tip.tipClear() }
        }
        if ev.isMouseButtonDown() {
            if contains(ev.mouseX(), ev.mouseY()) {
                hover = true
                _pressed = true
                core.markFrameRedraw()   // 按下状态变化需重绘
                if _onClick != null { _onClick() }
            }
        }
        if ev.isMouseButtonUp() {
            if _pressed { core.markFrameRedraw() }   // 释放状态变化需重绘
            _pressed = false
        }
    }

    // ==================== 渲染 ====================
    func render(Renderer r) {
        if not _loaded { return }
        if not visible { return }
        _ensure_font()
        _ensure_image(r)

        int br = cr; int bg = cg; int bb = cb
        int tr2 = tr; int tg2 = tg; int tb2 = tb

        if hover {
            if hvr > 0 or hvg > 0 or hvb > 0 {
                br = hvr; bg = hvg; bb = hvb
            } else {
                br = cr + 40; bg = cg + 40; bb = cb + 40
            }
        }
        // 按下态：优先级高于 hover，背景变暗（模拟按压凹陷感）
        if _pressed and enabled {
            if _prR > 0 or _prG > 0 or _prB > 0 {
                br = _prR; bg = _prG; bb = _prB
            } else {
                br = cr - 30; bg = cg - 30; bb = cb - 30
                if br < 0 { br = 0 }; if bg < 0 { bg = 0 }; if bb < 0 { bb = 0 }
            }
        }
        if not enabled { br = cr / 2; bg = cg / 2; bb = cb / 2 }
        if br > 255 { br = 255 }; if bg > 255 { bg = 255 }; if bb > 255 { bb = 255 }

        // 阴影（按下时消除阴影，模拟按压贴合感）
        if _showShadow and not (_pressed and enabled) {
            r.setColor(0, 0, 0, 40)
            r.fillRoundedRect(x + 2, y + 2, w, h, _radius)
        }

        // 背景
        r.setColor(br, bg, bb, 255)
        r.fillRoundedRect(x, y, w, h, _radius)

        // 背景图（对齐 iOS setBackgroundImage / Android background）：覆盖在纯色背景之上、填满按钮矩形
        if _bgTex != null {
            r.setTextureAlpha(_bgTex, 255)
            r.setTextureColor(_bgTex, 255, 255, 255)
            r.drawTextureAt(_bgTex, x, y, w, h)
        }

        // 边框（按下态使用深色内凹边框，区别于 hover 的亮色高亮边框）
        if _showBorder {
            if _pressed and enabled { r.setColor(0, 0, 0, 150) }
            else if hover { r.setColor(255, 255, 255, 200) }
            else {
                int bbr = br + 30; int bbg = bg + 30; int bbb = bb + 30
                if bbr > 255 { bbr = 255 }; if bbg > 255 { bbg = 255 }; if bbb > 255 { bbb = 255 }
                r.setColor(bbr, bbg, bbb, 180)
            }
            r.drawRoundedRect(x, y, w, h, _radius)
        }

        // ============ 图标 + 文字布局 ============
        // 内容裁剪到按钮矩形内，防止图标/文字溢出按钮（对齐 sdl_edit / sdl_panel 做法）
        var _btnClip = core.SDL_Rect.malloc()
        _btnClip.x = _int(x); _btnClip.y = _int(y)
        _btnClip.w = _int(w) + 1; _btnClip.h = _int(h) + 1   // +1 覆盖浮点截断的亚像素
        r.pushClipRect(_btnClip.to_ptr())

        float pad = 6.0
        // 提前测量文字，供图标尺寸自适应（防止图标挤占文字 / 内容溢出按钮）
        float textW = 0.0; float textH = 0.0
        if _font.ok {
            var ms0 = _font.measureString(text)
            textW = ms0.w; textH = ms0.h
        }

        // 选择当前状态的图标纹理（disabled > pressed > hover > normal）
        Ptr[u8] itex = _imgTex
        bool imgAutoDim = false
        if not enabled and _imgTexDisabled != null { itex = _imgTexDisabled }
        else if not enabled { itex = _imgTex; imgAutoDim = true }
        else if _pressed and _imgTexPressed != null { itex = _imgTexPressed }
        else if hover and _imgTexHover != null { itex = _imgTexHover }

        // 图标尺寸（对齐 Qt setIconSize / Material iconSize）
        // 自动尺寸须按布局约束，确保图标与文字都能容纳在按钮内：
        //  - 左右布局：图标纵向占满（留 padding）
        //  - 上下布局：图标须给文字预留 (h - 2pad - gap - textH) 高度
        float isize = _imgSize
        if isize <= 0.0 and itex != null {
            var ts = r.getTextureSize(itex)
            isize = ts["h"]
        }
        if isize <= 0.0 { isize = h - 2.0 * pad }   // 无图兜底
        if isize > w - 2.0 * pad { isize = w - 2.0 * pad }
        if _imgPos == 0 or _imgPos == 1 {
            if isize > h - 2.0 * pad { isize = h - 2.0 * pad }
        } else {
            float maxI = h - 2.0 * pad - _imgGap - textH
            if maxI < 0.0 { maxI = 0.0 }
            if isize > maxI { isize = maxI }
        }
        if isize < 0.0 { isize = 0.0 }

        // 实际绘制尺寸（按内容模式保持/拉伸比例，避免非正方形图变形）+ alpha/tint 调制
        float dw = isize; float dh = isize
        if itex != null {
            int effA = _imgAlpha
            if imgAutoDim { effA = _int(_imgAlpha * 0.5) }
            r.setTextureAlpha(itex, effA)
            if _imgTintR >= 0 { r.setTextureColor(itex, _imgTintR, _imgTintG, _imgTintB) }
            else if imgAutoDim { r.setTextureColor(itex, 128, 128, 128) }   // 禁用态自动变灰
            else { r.setTextureColor(itex, 255, 255, 255) }
            if _imgMode != 1 {   // 0=aspectFit / 2=aspectFill：保持原始比例
                var nats = r.getTextureSize(itex)
                float nw = nats["w"]; float nh = nats["h"]
                if nw > 0.0 and nh > 0.0 {
                    if _imgMode == 2 {   // aspectFill：覆盖填满（可能裁剪，居中绘制）
                        float s = isize / nw; if isize / nh > s { s = isize / nh }
                        dw = nw * s; dh = nh * s
                    } else {             // aspectFit：完整显示（可能留边，居中绘制）
                        float s = isize / nw; if isize / nh < s { s = isize / nh }
                        dw = nw * s; dh = nh * s
                    }
                }
            }
        }

        if _font.ok {
            var ms = _font.measureString(text)
            if itex == null {
                // 纯文字：整按钮居中
                float cy = y + (h - ms.h) / 2.0
                r.drawTextCentered(_font, text, x, w, cy, tr2, tg2, tb2)
            } else if _imgPos == 0 {
                // 图标在左（对齐 Material iconGravity=start / WinForms ImageBeforeText）
                float ix = x + pad
                float iy = y + (h - isize) / 2.0
                r.drawTextureAt(itex, ix + (isize - dw) / 2.0, iy + (isize - dh) / 2.0, dw, dh)
                float tx = ix + isize + _imgGap
                float tw = (x + w) - tx - pad
                float ty = y + (h - ms.h) / 2.0
                r.drawTextCentered(_font, text, tx, tw, ty, tr2, tg2, tb2)
            } else if _imgPos == 1 {
                // 图标在右（Material iconGravity=end / WinForms TextBeforeImage）
                float ix = x + w - pad - isize
                float iy = y + (h - isize) / 2.0
                r.drawTextureAt(itex, ix + (isize - dw) / 2.0, iy + (isize - dh) / 2.0, dw, dh)
                float tx = x + pad
                float tw = ix - _imgGap - tx
                float ty = y + (h - ms.h) / 2.0
                r.drawTextCentered(_font, text, tx, tw, ty, tr2, tg2, tb2)
            } else if _imgPos == 2 {
                // 图标在上（Material iconGravity=top / WinForms ImageAboveText）
                float ix = x + (w - isize) / 2.0
                float iy = y + pad
                r.drawTextureAt(itex, ix + (isize - dw) / 2.0, iy + (isize - dh) / 2.0, dw, dh)
                float ty = iy + isize + _imgGap
                float th = (y + h) - ty - pad
                float cy = ty + (th - ms.h) / 2.0
                r.drawTextCentered(_font, text, x, w, cy, tr2, tg2, tb2)
            } else {
                // 图标在下（WinForms TextAboveImage）
                float ix = x + (w - isize) / 2.0
                float iy = y + h - pad - isize
                r.drawTextureAt(itex, ix + (isize - dw) / 2.0, iy + (isize - dh) / 2.0, dw, dh)
                float ty = y + pad
                float th = iy - _imgGap - ty
                float cy = ty + (th - ms.h) / 2.0
                r.drawTextCentered(_font, text, x, w, cy, tr2, tg2, tb2)
            }
        } else if itex != null {
            // 仅图标、无文字：居中绘制
            float ix = x + (w - isize) / 2.0
            float iy = y + (h - isize) / 2.0
            if _imgPos == 0 { ix = x + pad; iy = y + (h - isize) / 2.0 }
            else if _imgPos == 1 { ix = x + w - pad - isize; iy = y + (h - isize) / 2.0 }
            else if _imgPos == 2 { ix = x + (w - isize) / 2.0; iy = y + pad }
            else { ix = x + (w - isize) / 2.0; iy = y + h - pad - isize }
            r.drawTextureAt(itex, ix + (isize - dw) / 2.0, iy + (isize - dh) / 2.0, dw, dh)
        }

        // 恢复裁剪区
        r.popClipRect(); _btnClip.free()
    }

    // 释放字体与图片资源
    func dispose() {
        if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null
        _release_all_images()
    }
}

// 工厂
export func createButton(Dict opts): Button {
    Button btn = new Button(); btn.set(opts); return btn
}
