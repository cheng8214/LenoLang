// sdl_widget.leno — 控件统一接口（face）
// 任何希望被 Window.run() 自动管理（接收事件 + 自动渲染）的控件都必须 impl Widget。
// 这样新增控件只需 win.add(widget) 一行，无需再修改 sdl_window.leno。
import "sdl_event.leno" as evt; use evt.Event
import "sdl_renderer.leno" as ren; use ren.Renderer

export face Widget {
    // 布局所需：返回控件的自然尺寸（用于自动排版）
    func get_w(): float
    func get_h(): float
    // 布局所需：设置控件位置（左上角）
    func set_pos(float x, float y)
    // 布局所需：设置控件尺寸（HBox/VBox 的 expand / stretch 会调用）
    func set_size(float w, float h)
    // 处理一个事件（鼠标/键盘/窗口等）
    func process(Event ev)
    // 用给定渲染器绘制自身
    func render(Renderer r)
    // 释放资源（字体、纹理等）
    func dispose()
    // ★ 窗口尺寸变化时回调（可选实现，默认空）
    // 用于 Table/TreeView 等内部有上下文菜单的控件同步窗口尺寸到菜单
    func on_window_resize(int ww, int hh)
}
