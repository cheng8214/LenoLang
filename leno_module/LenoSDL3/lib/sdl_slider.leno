// sdl_slider.leno — 滑块控件
// 通过 win.addSlider({...}) 创建，拖拽 thumb 或在轨道上点击设定数值，回调 on_change(float)
import "sdl_renderer.leno" as ren; use ren.Renderer
import "sdl_font.leno" as fnt; use fnt.Font
import "sdl_event.leno" as evt; use evt.Event
import "sdl_core.leno" as core; use core.SystemCursor
import "sdl_widget.leno" as wgt; use wgt.Widget
import "sdl_tooltip.leno" as tip
import "sdl_theme.leno" as theme; use theme.(Theme, Themeable)
use theme.Color
import maths

export struct Slider impl Widget, Themeable {
    float x = 0.0, y = 0.0, w = 200.0, h = 24.0
    float minV = 0.0, maxV = 100.0, value = 0.0
    float step = 0.0
    bool _vertical = false
    string _fontPath = ""; float _fontSize = 15.0; int _fontStyle = 0; Font? _font
    Color _trkColor = #2C2E36FF     // 轨道背景色
    Color _fillColor = #3C96EBFF     // 已选填充色
    Color _thumbColor = #EBEBF5FF   // 滑块色
    Color _txtColor = #EBEBF5FF     // 文字色
    int _cursor = SystemCursor.POINTER
    bool hover = false; bool _wasHover = false; bool _dragging = false; bool enabled = true; bool visible = true; bool _loaded = false
    string _tip = ""           // 悬停提示文本（空 = 不提示）
    float _fontH = 0.0          // 字体行高缓存（字体不变时为常量，避免每帧 measureString）
    func(float):void _onChange

    func _quantize(float v): float {
        if step > 0.0 { v = maths.round(v / step) * step }
        return maths.max(minV, maths.min(v, maxV))
    }

    func _ensure_font() {
        if _font == null or not _font.ok {
            if _font != null and _font.ok { fnt.releaseFont(_font) }
            if _fontPath != "" { _font = fnt.acquireFont(_fontPath, _fontSize) }
            else { _font = fnt.acquireFontAuto(_fontSize) }
            if _font.ok and _fontStyle != 0 { _font.setStyle(_fontStyle) }
            if _font.ok { _fontH = _font.measureString("Ag").h }
        }
    }

    // ==================== set 初始化 ====================
    func set(Dict opts) {
        Theme th = theme.getTheme()
        _trkColor = th.bgAlt
        _fillColor = th.accent
        _thumbColor = th.txt
        _txtColor = th.txt
        x      = opts.get("x", 0)
        y      = opts.get("y", 0)
        w      = opts.get("w", 200)
        h      = opts.get("h", 24)
        minV   = opts.get("min", 0.0)
        maxV   = opts.get("max", 100.0)
        value  = opts.get("value", 0.0)
        step   = opts.get("step", 0.0)
        _vertical = opts.get("vertical", false)
        _fontSize = opts.get("font_size", 15)
        _fontPath = opts.get("font_path", "")
        _fontStyle = opts.get("font_style", 0)

        // 颜色：opts 未传则保持默认值
        if opts.get("track_color") is Color => t { _trkColor = t }
        if opts.get("fill_color") is Color => t { _fillColor = t }
        if opts.get("thumb_color") is Color => t { _thumbColor = t }
        if opts.get("text_color") is Color => t { _txtColor = t }

        _cursor = opts.get("cursor", SystemCursor.POINTER)
        enabled = opts.get("enabled", true)
        visible = opts.get("visible", true)
        // hover/_wasHover/_dragging 默认见字段声明
        _tip = opts.get("tip", "")
        value = maths.max(minV, maths.min(value, maxV))
        _ensure_font()
        _loaded = true
    }

    // ==================== 设置方法 ====================
    func set_value(float v)    { float nv = _quantize(v); if nv != value { value = nv; if _onChange != null { _onChange(value) } } }
    func set_tip(string t)      { _tip = t }
    func get_value(): float     { return value }
    func set_range(float lo, float hi) { minV = lo; maxV = hi; value = maths.max(minV, maths.min(value, maxV)) }
    func set_enabled(bool e)     { enabled = e }
    func set_visible(bool v)      { visible = v }
    func is_visible(): bool       { return visible }
    func set_font_size(float s)  { _fontSize = s; if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null }
    func get_x(): float          { return x }
    func get_y(): float          { return y }
    func get_w(): float          { return w }
    func get_h(): float          { return h }
    func set_pos(float px, float py) { x = px; y = py }
    func set_size(float sw, float sh) { w = sw; h = sh }

    func on_change(func(float):void cb) { _onChange = cb }

    // 当前值在轴上的归一化比例 [0,1]
    func _ratio(): float {
        float span = maxV - minV
        if span <= 0.0 { return 0.0 }
        return maths.max(0.0, maths.min((value - minV) / span, 1.0))
    }

    func _thumb_radius(): float {
        if _vertical { return maths.max(6.0, maths.min(w * 0.45, 40.0)) }
        return maths.max(6.0, maths.min(h * 0.45, 40.0))
    }

    func contains(float mx, float my): bool {
        float pad = _thumb_radius() + 4.0
        if _vertical { return mx >= x - pad and mx <= x + w + pad and my >= y and my <= y + h }
        return mx >= x and mx <= x + w and my >= y - pad and my <= y + h + pad
    }

    // 把鼠标坐标换算为值（用于拖拽与点击）
    func _value_from_pos(float p): float {
        float rad = _thumb_radius()
        float span
        if _vertical { span = h - 2.0 * rad } else { span = w - 2.0 * rad }
        float t
        if _vertical { t = (y + h - rad - p) / span } else { t = (p - (x + rad)) / span }
        if t < 0.0 { t = 0.0 }
        if t > 1.0 { t = 1.0 }
        return _quantize(minV + t * (maxV - minV))
    }

    // ==================== 交互 ====================
    func process(Event ev) {
        if not _loaded { return }
        if not visible { return }
        if not enabled { hover = false; _dragging = false; return }
        // 弹层捕获：事件落在“他人的弹层（如打开的菜单/下拉）范围内时忽略，避免穿透到下层控件
        float mx = ev.mouseX(), my = ev.mouseY()
        if ev.isMouseWheel() { mx = ev.wheelMouseX(); my = ev.wheelMouseY() }
        if core.inPopupCapture(mx, my) { return }


        if ev.isMouseMotion() {
            _wasHover = hover
            hover = contains(mx, my)
            // 拖拽中：即使移出控件也要继续更新
            // 注意：motion 事件不触发整窗重绘，控件必须主动 markFrameRedraw()
            if _dragging {
                if _vertical { value = _value_from_pos(my) } else { value = _value_from_pos(mx) }
                if _onChange != null { _onChange(value) }
                core.markFrameRedraw()
            } else if _wasHover != hover {
                core.markFrameRedraw()   // hover 状态变化也需重绘（thumb 高亮）
            }
            if _cursor >= 0 {
                if hover or _dragging {
                    core.requestCursor(_cursor)
                }
            }
            // 悬停提示：hover 时上报；离开由 tipEndMotion 统一清除
            if hover and _tip != "" { tip.tipReport(_tip, ev.mouseX(), ev.mouseY()) }
        }

        if ev.isMouseButtonUp() { _dragging = false }

        if ev.isMouseButtonDown() and not _dragging {
            if contains(ev.mouseX(), ev.mouseY()) {
                _dragging = true
                if _vertical { value = _value_from_pos(ev.mouseY()) } else { value = _value_from_pos(ev.mouseX()) }
                if _onChange != null { _onChange(value) }
            }
        }
    }

    // ==================== 渲染 ====================
    func render(Renderer r) {
        if not _loaded { return }
        if not visible { return }
        _ensure_font()
        float rad = _thumb_radius()
        float baseWH
        if _vertical { baseWH = w } else { baseWH = h }
        float tk = maths.max(3.0, maths.min(baseWH * 0.4, 30.0))   // 轨道厚度
        float span
        if _vertical { span = h - 2.0 * rad } else { span = w - 2.0 * rad }

        // 轨道背景
        Color tC = _trkColor
        if not enabled { tC = theme.darken(_trkColor, 60) }
        r.setColor(tC)
        if _vertical {
            float tx = x + (w - tk) / 2.0
            r.fillRoundedRect(tx, y + rad, tk, span, tk / 2.0)
        } else {
            float ty = y + (h - tk) / 2.0
            r.fillRoundedRect(x + rad, ty, span, tk, tk / 2.0)
        }

        // 已选填充
        float ratio = _ratio()
        Color fC = _fillColor
        if not enabled { fC = theme.darken(_fillColor, 60) }
        r.setColor(fC)
        if _vertical {
            float tx = x + (w - tk) / 2.0
            float fillH = tk / 2.0 + ratio * span   // 从底向上填充
            r.fillRoundedRect(tx, y + h - rad - fillH, tk, fillH, tk / 2.0)
        } else {
            float ty = y + (h - tk) / 2.0
            float fillW = tk / 2.0 + ratio * span
            r.fillRoundedRect(x + rad, ty, fillW, tk, tk / 2.0)
        }

        // thumb
        float cx, cy
        if _vertical { cx = x + w / 2.0; cy = y + h - rad - ratio * span }
        else         { cx = x + rad + ratio * span; cy = y + h / 2.0 }
        Color kC = _thumbColor
        if hover or _dragging { kC = theme.brighten(_thumbColor, 15) }
        if not enabled { kC = theme.darken(_thumbColor, 60) }
        r.setColor(kC)
        r.fillCircle(cx, cy, rad)

        // 数值文字
        if _font != null and _font.ok {
            string label = value as string
            float th = _fontH
            float ty; float tx
            if _vertical { ty = y + h + 6.0; tx = x + w / 2.0 - _font.measureString(label).w / 2.0 }
            else { ty = y + h / 2.0 - th / 2.0; tx = x + w + 8.0 }
            Color tcC = _txtColor
            if not enabled { tcC = theme.darken(_txtColor, 60) }
            r.drawText(_font, label, tx, ty, tcC)
        }
    }

    func dispose() {
        if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null
    }

    func applyTheme(Theme t) {
        _trkColor = t.bgAlt
        _fillColor = t.accent
        _thumbColor = t.txt
        _txtColor = t.txt
    }
}

// 工厂
export func createSlider(Dict opts): Slider {
    Slider s = new Slider(); s.set(opts); return s
}
