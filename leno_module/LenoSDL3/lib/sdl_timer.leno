// sdl_timer.leno — 基于 getTicks() 的定时器，Array 存回调

import "../lib/sdl_core.leno" as core
use core.sdl3
sdl3 _lib = core.lib()

export alias TimerCallback = func():void

export struct Timer {
    float   _ms = 0.0     // 定时间隔（毫秒）
    float   _next = 0.0    // 下次触发时间（getTicks 毫秒）
    bool    running       // 是否运行中
    bool    once          // true=一次性
    Array   _cb           // 回调存 [0]

    // 设置并启动（循环），ms=毫秒，=0 只存回调不启动
    func set(int ms, TimerCallback cb) {
        _cb.clear(); _cb.add(cb); _ms = _float(ms)
        if ms > 0 { _next = _float(_lib.SDL_GetTicks()) + _ms; running = true }
        else { running = false }
        once = false
    }

    // 设置一次性定时器
    func setOnce(int ms, TimerCallback cb) {
        _cb.clear(); _cb.add(cb); _ms = _float(ms)
        _next = _float(_lib.SDL_GetTicks()) + _ms
        running = true; once = true
    }

    // 暂停
    func stop() { running = false }

    // 恢复（需先有间隔）
    func start() {
        if _ms <= 0.0 { return }
        _next = _float(_lib.SDL_GetTicks()) + _ms; running = true
    }

    // 修改间隔 + 立即重启计时
    func reset(int ms) {
        _ms = _float(ms)
        _next = _float(_lib.SDL_GetTicks()) + _ms; running = true
    }

    // 每帧调用，自动触发回调
    func tick() {
        if not running or _cb.len() == 0 or _ms <= 0.0 { return }
        float now = _float(_lib.SDL_GetTicks())
        var cb = _cb[0]
        while now >= _next {
            cb()
            if once { running = false; return }
            _next = _next + _ms
        }
    }
}
