// sdl_timer.leno — 基于 getTicks() 的定时器，Array 存回调

import "../lib/sdl_core.leno" as core
use core.sdl3
sdl3 _lib = core.lib()

export struct Timer {
    float   interval_ms   // 定时间隔（毫秒）
    float   next_time     // 下次触发时间（秒）
    bool    running       // 是否运行中
    bool    once          // true=一次性
    Array   _cb           // 回调存在 [0]（编译器已自动初始化为 []）
    // 设置并启动（循环），ms=毫秒，=0 只存回调不启动
    func set(int ms, var cb) {
        _cb.add(cb)
        interval_ms = _float(ms)
        if ms > 0 { next_time = _float(_lib.SDL_GetTicks()) / 1000.0 + _float(ms) / 1000.0; running = true }
        else { running = false }
        once = false
    }

    // 设置一次性定时器
    func setOnce(int ms, var cb) {
        _cb.add(cb)
        interval_ms = _float(ms)
        next_time = _float(_lib.SDL_GetTicks()) / 1000.0 + _float(ms) / 1000.0
        running = true; once = true
    }

    // 暂停
    func stop() { running = false }

    // 恢复（需先有间隔，否则忽略）
    func start() {
        if interval_ms <= 0.0 { return }
        next_time = _float(_lib.SDL_GetTicks()) / 1000.0 + interval_ms / 1000.0
        running = true
    }

    // 修改间隔（毫秒，不改变回调）
    func reset(int ms) { interval_ms = _float(ms) }

    // 每帧调用，自动触发回调
    func tick() {
        if not running or _cb.len() == 0 or interval_ms <= 0.0 { return }
        float now = _float(_lib.SDL_GetTicks()) / 1000.0
        var cb = _cb[0]
        while now >= next_time {
            cb()
            if once { running = false; return }
            next_time = next_time + interval_ms / 1000.0
        }
    }
}
