// sdl_edit.leno — 文本编辑控件
// 通过 win.addEdit({...}) 创建，run() 自动处理交互和渲染
import "sdl_renderer.leno" as ren; use ren.Renderer
import "sdl_font.leno" as fnt; use fnt.Font
import "sdl_event.leno" as evt; use evt.Event
import "sdl_core.leno" as core; use core.Scancode

export struct Edit {
    string text
    float x; float y; float w; float h
    float _radius                // 圆角半径
    float _fontSize              // 字体大小
    string _fontPath
    int _fontStyle
    Font  _font                  // 字体缓存
    Ptr[u8] _hwnd                // 窗口句柄（供输入法定位）
    int cr, cg, cb               // 背景色
    int tr, tg; int tb           // 文字色
    int _cursorPos               // 光标字符位置
    float _scrollX               // 水平滚动偏移
    string _placeholder          // 占位文字
    bool _focused
    int _blinkTime               // 上次闪烁切换的 tick
    bool _showCursor             // 当前是否显示光标
    bool _password               // 密码模式（显示 *）
    bool _readOnly               // 只读
    bool _loaded
    func():void _onChange        // 文字改变回调
    func():void _onEnter         // 回车回调

    func _ensure_font() {
        if _font == null or not _font.ok {
            if _font != null { _font.close() }
            if _fontPath != "" {
                _font = fnt.createFont(_fontPath, _fontSize)
            } else {
                _font = fnt.createFontAuto(_fontSize)
            }
            if _font.ok and _fontStyle != 0 { _font.setStyle(_fontStyle) }
        }
    }

    // 计算到 cursorPos 位置的文字像素宽度
    func _text_width_to(int pos): float {
        if _font == null or not _font.ok { return 0.0 }
        if pos <= 0 { return 0.0 }
        if pos > text.len() { pos = text.len() }
        var sub = text.slice(0, pos)
        if _password {
            var stars = ""
            for pos to _ { stars = stars + "*" }
            sub = stars
        }
        var ms = _font.measureString(sub)
        return _float(ms.w)
    }

    // 更新滚动偏移，确保光标在可见区域
    func _adjust_scroll() {
        float pad = 8.0      // 内边距
        float visW = w - pad * 2.0
        if visW <= 0 { return }
        float curX = _text_width_to(_cursorPos)

        // 光标超出右边界
        if curX - _scrollX > visW {
            _scrollX = curX - visW + 4.0
        }
        // 光标超出左边界
        if curX - _scrollX < 0 {
            _scrollX = curX - 4.0
        }
        if _scrollX < 0 { _scrollX = 0 }
    }

    // ==================== set 初始化 ====================
    func set(Dict opts) {
        text        = opts.get("text", "") as string
        x           = _float(opts.get("x", 0))
        y           = _float(opts.get("y", 0))
        w           = _float(opts.get("w", 180))
        h           = _float(opts.get("h", 36))
        _radius     = _float(opts.get("radius", 5))
        _fontSize   = _float(opts.get("font_size", 16))
        _fontPath   = opts.get("font_path", "") as string
        _fontStyle  = _int(opts.get("font_style", 0))

        // 颜色
        cr = 35; cg = 35; cb = 50
        tr = 220; tg = 220; tb = 240
        var c = opts.get("rgb")
        if c is Array { cr = _int(c[0]); cg = _int(c[1]); cb = _int(c[2]) }
        var tc = opts.get("text_rgb")
        if tc is Array { tr = _int(tc[0]); tg = _int(tc[1]); tb = _int(tc[2]) }

        // 占位文字
        _placeholder = opts.get("placeholder", "") as string

        // 状态
        _password   = _bool(opts.get("password", false))
        _readOnly   = _bool(opts.get("readonly", false))
        _focused    = false
        _showCursor = true
        _blinkTime  = core.getTicks()
        _cursorPos  = text.len()
        _scrollX    = 0.0

        _ensure_font()
        _loaded = true
    }

    // ==================== 设置方法 ====================
    func set_text(string t)      { text = t; _cursorPos = text.len(); _adjust_scroll() }
    func set_pos(float px, float py)    { x = px; y = py }
    func set_size(float sw, float sh)   { w = sw; h = sh }
    func set_rgb(int r, int g, int b)   { cr = r; cg = g; cb = b }
    func set_text_rgb(int r, int g, int b) { tr = r; tg = g; tb = b }
    func set_font_size(float s) {
        _fontSize = s
        if _font != null { _font.close(); _font = null }
    }
    func set_readonly(bool ro)  { _readOnly = ro }
    func set_password(bool pw)  { _password = pw }
    func set_placeholder(string p) { _placeholder = p }
    func set_window(Ptr[u8] hwnd) { _hwnd = hwnd }
    func focus()    { _focused = true }
    func blur()     { _focused = false }

    // ==================== 查询方法 ====================
    func is_focused(): bool { return _focused }
    func get_text(): string { return text }

    // ==================== 回调 ====================
    func on_change(func():void cb) { _onChange = cb }
    func on_enter(func():void cb)  { _onEnter = cb }

    // ==================== 交互 ====================
    func contains(float mx, float my): bool {
        return mx >= x and mx <= x + w and my >= y and my <= y + h
    }

    // 更新输入法候选框位置
    func _update_ime() {
        float pad = 8.0
        float cx = x + pad + _text_width_to(_cursorPos) - _scrollX
        var rect = core.SDL_Rect.malloc()
        rect.x = _int(x)
        rect.y = _int(y + h)         // 候选框放在编辑框下方
        rect.w = _int(w)
        rect.h = _int(h)
        // cursor 参数：光标在 rect 内相对于 rect 左上角的 x 偏移
        core.setTextInputArea(_hwnd, rect.to_ptr(), _int(cx - x))
        rect.free()
    }

    // 根据鼠标 x 坐标计算光标位置
    func _pos_from_x(float mx): int {
        if _font == null or not _font.ok { return 0 }
        if text.len() == 0 { return 0 }
        float relX = mx - x - 8.0 + _scrollX   // 相对文字起始的像素位置
        if relX <= 0 { return 0 }

        // 二分查找最接近的字符位置
        var lo = 0
        var hi = text.len()
        while lo < hi {
            var mid = (lo + hi + 1) / 2
            if _text_width_to(mid) <= relX { lo = mid } else { hi = mid - 1 }
        }
        return lo
    }

    // 处理事件（run 内部调用）
    func process(Event ev) {
        if not _loaded { return }

        // 鼠标点击
        if ev.isMouseButtonDown() {
            _focused = contains(ev.mouseX(), ev.mouseY())
            if _focused {
                _cursorPos = _pos_from_x(ev.mouseX())
                _adjust_scroll()
                _showCursor = true
                _blinkTime = core.getTicks()
                _update_ime()
            }
        }

        if not _focused { return }
        if _readOnly { return }

        // 键盘处理
        if ev.isKeyDown() {
            int sc = ev.scancode()
            bool changed = false

            if sc == Scancode.BACKSPACE {
                if _cursorPos > 0 {
                    text = text.slice(0, _cursorPos - 1) + text.slice(_cursorPos, text.len())
                    _cursorPos -= 1
                    changed = true
                }
            }

            if sc == Scancode.DELETE {
                if _cursorPos < text.len() {
                    text = text.slice(0, _cursorPos) + text.slice(_cursorPos + 1, text.len())
                    changed = true
                }
            }

            if sc == Scancode.LEFT {
                if _cursorPos > 0 { _cursorPos -= 1 }
            }

            if sc == Scancode.RIGHT {
                if _cursorPos < text.len() { _cursorPos += 1 }
            }

            if sc == Scancode.HOME { _cursorPos = 0 }
            if sc == Scancode.END  { _cursorPos = text.len() }

            if sc == Scancode.RETURN {
                if _onEnter != null { _onEnter() }
            }

            if changed {
                _adjust_scroll()
                _showCursor = true
                _blinkTime = core.getTicks()
                if _onChange != null { _onChange() }
            } else if sc == Scancode.LEFT or sc == Scancode.RIGHT or
                      sc == Scancode.HOME or sc == Scancode.END {
                _adjust_scroll()
                _showCursor = true
                _blinkTime = core.getTicks()
                _update_ime()
            }
        }

        // 文本输入
        if ev.isTextInput() {
            var ch = ev.text()
            if ch != "" and _cursorPos <= text.len() {
                text = text.slice(0, _cursorPos) + ch + text.slice(_cursorPos, text.len())
                _cursorPos += ch.len()
                _adjust_scroll()
                _showCursor = true
                _blinkTime = core.getTicks()
                if _onChange != null { _onChange() }
            }
        }
    }

    // ==================== 渲染 ====================
    func render(Renderer r) {
        if not _loaded { return }
        _ensure_font()
        if _font == null or not _font.ok { return }

        // 光标闪烁（500ms 周期）
        var now = core.getTicks()
        if now - _blinkTime >= 500 {
            _showCursor = not _showCursor
            _blinkTime = now
        }

        // 背景
        r.setColor(cr, cg, cb, 255)
        r.fillRoundedRect(x, y, w, h, _radius)

        // 边框
        if _focused {
            r.setColor(100, 180, 255, 255)
        } else {
            r.setColor(cr + 40, cg + 40, cb + 40, 220)
        }
        r.drawRoundedRect(x, y, w, h, _radius)

        // 文字内容或占位文字（裁剪区域防止溢出）
        float pad = 8.0
        var clip = core.SDL_Rect.malloc()
        clip.x = _int(x + pad)
        clip.y = _int(y)
        clip.w = _int(w - pad * 2.0)
        clip.h = _int(h)
        r.setClipRect(clip.to_ptr())

        if text == "" and not _focused and _placeholder != "" {
            // 占位文字
            var ms = _font.measureString(_placeholder)
            float py = y + (h - _float(ms.h)) / 2.0
            r.drawText(_font, _placeholder, x + pad, py,
                       tr / 2 + 50, tg / 2 + 50, tb / 2 + 50)
        } else if text != "" {
            var display = text
            if _password {
                var pw = ""
                for text.len() to _ { pw = pw + "*" }
                display = pw
            }
            var ms = _font.measureString(display)
            float ty = y + (h - _float(ms.h)) / 2.0
            r.drawText(_font, display, x + pad - _scrollX, ty, tr, tg, tb)
        }

        r.clearClip()
        clip.free()

        // 光标
        if _focused and _showCursor {
            float cx = x + pad + _text_width_to(_cursorPos) - _scrollX
            if cx < x + pad { cx = x + pad }
            if cx > x + w - pad { cx = x + w - pad }
            var ms = _font.measureString("Ag")
            float ch = _float(ms.h)
            r.setColor(220, 220, 240, 200)
            r.drawLine(cx, y + (h - ch) / 2.0, cx, y + (h + ch) / 2.0 - 2.0)
        }
    }

    // 释放资源
    func dispose() {
        if _font != null { _font.close(); _font = null }
    }
}

// 工厂
export func createEdit(Dict opts): Edit {
    Edit ed = new Edit(); ed.set(opts); return ed
}
