// sdl_edit.leno — 文本编辑控件（单行/多行 + 滚动条）
// 通过 win.addEdit({...}) 创建，run() 自动处理交互和渲染
import "sdl_renderer.leno" as ren; use ren.Renderer
import "sdl_font.leno" as fnt; use fnt.Font
import "sdl_event.leno" as evt; use evt.Event
import "sdl_core.leno" as core; use core.Scancode
use core.sdl3
import "sdl_widget.leno" as wgt; use wgt.Widget
import "sdl_tooltip.leno" as tip

export struct Edit impl Widget {
    string text
    float x; float y; float w; float h
    float _radius                // 圆角半径
    float _fontSize              // 字体大小
    string _fontPath
    int _fontStyle
    Font  _font                  // 字体缓存
    Ptr[u8] _hwnd                // 窗口句柄（IME 定位）
    int cr, cg, cb               // 背景色
    int tr, tg, tb               // 文字色
    int _focusR, _focusG, _focusB // 聚焦边框色

    // 单行模式
    int _cursorPos               // 光标字符位置（单行）
    float _scrollX               // 水平滚动偏移

    // 多行模式
    bool _multiline
    Array[string] _lines         // 行缓存
    int _cursorLine; int _cursorCol   // 多行光标
    float _scrollY               // 垂直滚动偏移
    float _lineHeight            // 行高缓存

    string _placeholder          // 占位文字
    bool _focused
    bool _mouseDown              // 鼠标左键是否按下
    bool _draggingVScroll        // 拖竖向滚动条
    bool _draggingHScroll        // 拖横向滚动条
    bool _hoverVScroll           // 鼠标悬停竖向滚动条
    float _hDragOffset           // 横向拖动：抓取点在滑块内的偏移（避免拖动跳变）
    bool  _hDragThumb            // 本次横向拖动是否抓在滑块上（false=抓在轨道）
    bool _hoverHScroll           // 鼠标悬停横向滚动条
    bool _hoverText              // 鼠标悬停编辑区（显示文本光标）
    int _blinkTime               // 光标闪烁 tick
    bool _showCursor
    bool _password               // 密码模式
    bool _readOnly               // 只读
    bool _loaded
    bool enabled
    bool visible
    string _tip             // 悬停提示文本（空 = 不提示）
    bool _dirty                  // 行缓存需重建
    bool _textDirty              // text 需要从 _lines 重建
    int  _cachedLen              // 缓存总字符数（不含换行符）
    float _cachedMaxW            // 缓存最大行宽（脏时重算）

    // 撤销/重做
    Array[Array[string]] _undoStack
    Array[Array[string]] _redoStack
    Array[int] _undoCursorStack       // 撤销光标栈：每项存 line*10000+col
    Array[int] _redoCursorStack
    bool _mergeUndo              // 连续输入可合并为一次撤销
    int  _mergePos               // 合并基准：上次输入结束处的光标字符位置
    int  _lastClickTime          // 上次点击 tick（双击检测）
    float _lastClickX; float _lastClickY

    // 自动换行
    bool _wordWrap
    // 显示行表（自动换行时一行逻辑行拆成多显示行）：每行 [逻辑行, 段起始列, 段结束列]
    Array[int] _drLi
    Array[int] _drC0
    Array[int] _drC1
    int _drCount
    bool _drDirty               // 显示行表需重建
    float _drVisW               // 上次构建显示行表用的可视宽度
    bool _drWrap                // 上次构建时的换行模式
    Array[int] _drLStart        // 每逻辑行在显示行表中的起始索引
    Array[int] _drLCnt          // 每逻辑行的显示行段数
    int _dirtyLine              // 仅单行内容变化时需增量重算的逻辑行（-1 表示无）
    Array[float] _lineW         // 每行像素宽度缓存（增量更新）
    float _maxLineW             // 当前最大行宽
    bool _lwDirty               // 行宽缓存需全量重算

    // 文本选取
    int  _selStart               // 选区起始（-1 表示无选区）
    int  _selEnd                 // 选区结束
    bool _selActive              // 有活跃选区

    func():void _onChange
    func():void _onEnter

    // ==================== 字体 ====================
    func _ensure_font() {
        if _font == null or not _font.ok {
            if _font != null { _font.close() }
            if _fontPath != "" {
                _font = fnt.createFont(_fontPath, _fontSize)
            } else {
                _font = fnt.createFontAuto(_fontSize)
            }
            if _font.ok and _fontStyle != 0 { _font.setStyle(_fontStyle) }
            _cachedMaxW = -1.0       // 字体变了，行宽缓存失效
            // 缓存行高
            if _font.ok {
                var ms = _font.measureString("Ag")
                _lineHeight = _float(ms.h) + 2.0
            }
        }
    }

    // 单行：测量到 pos 的宽度
    func _text_width_to(int pos): float {
        if _font == null or not _font.ok { return 0.0 }
        if pos <= 0 { return 0.0 }
        if pos > text.len() { pos = text.len() }
        var sub = text.slice(0, pos)
        if _password { sub = "*".rep(pos) }
        var ms = _font.measureString(sub)
        return _float(ms.w)
    }

    // 多行：测量某行到某列的宽度
    func _line_width_to(int line, int col): float {
        if _font == null or not _font.ok { return 0.0 }
        _rebuild_lines()
        if line < 0 { return 0.0 }
        if line >= _lines.len() { return 0.0 }
        var ln = _lines[line]
        if col <= 0 { return 0.0 }
        if col > ln.len() { col = ln.len() }
        var sub = ln.slice(0, col)
        if _password { sub = "*".rep(col) }
        var ms = _font.measureString(sub)
        return _float(ms.w)
    }

    // ==================== 行管理 ====================
    func _rebuild_lines() {
        if not _dirty { return }
        _dirty = false
        _cachedMaxW = -1.0
        _drDirty = true
        _lwDirty = true

        // 从 text 拆分行（用 split 处理所有 \n，包括末尾换行产生的空行）
        if text == "" { _lines = []; return }
        _lines = text.replace("\r", "").split("\n")
    }

    // 总内容高度
    func _content_height(): float {
        _rebuild_lines()
        if _lines.len() == 0 { return _lineHeight }
        if _wordWrap {
            if _drDirty or _drWrap != _wordWrap { _ensure_layout(w - 16.0) }
            if _drCount == 0 { return _lineHeight }
            return _lineHeight * _float(_drCount)
        }
        return _lineHeight * _float(_lines.len())
    }

    // ==================== 滚动 ====================
    func _adjust_scroll() {
        if _multiline {
            _adjust_scroll_ml()
        } else {
            _adjust_scroll_sl()
        }
    }

    func _adjust_scroll_sl() {
        float pad = 8.0
        float visW = w - pad * 2.0
        if visW <= 0 { return }
        float curX = _text_width_to(_cursorPos)
        if curX - _scrollX > visW { _scrollX = curX - visW + 4.0 }
        if curX - _scrollX < 0 { _scrollX = curX - 4.0 }
        if _scrollX < 0 { _scrollX = 0 }
    }

    func _adjust_scroll_ml() {
        float pad = 8.0
        // 先用不含滚动条的宽度构建显示行表，再算滚动条，避免每帧重排
        float provVisW = w - pad * 2.0
        if provVisW <= 0 { provVisW = 1.0 }
        _ensure_layout(provVisW)
        float sbW = _sb_width()
        float sbH = _sb_height()
        float visW = w - pad * 2.0 - sbW
        float visH = h - pad * 2.0 - sbH
        if visH <= 0 { return }

        // 构建显示行表并定位光标所在显示行
        if not _wordWrap { _ensure_layout(visW) }
        var di = _disp_row_of(_cursorLine, _cursorCol)

        // 垂直滚动
        float curY = _float(di) * _lineHeight
        if curY - _scrollY > visH - _lineHeight {
            _scrollY = curY - visH + _lineHeight
        }
        if curY - _scrollY < 0 {
            _scrollY = curY
        }
        if _scrollY < 0 { _scrollY = 0 }

        // 水平滚动（自动换行模式不横向滚动）
        if not _wordWrap {
            float curX = _line_width_to(_cursorLine, _cursorCol)
            if curX - _scrollX > visW { _scrollX = curX - visW + 4.0 }
            if curX - _scrollX < 0 { _scrollX = curX - 4.0 }
            if _scrollX < 0 { _scrollX = 0 }
        } else {
            _scrollX = 0.0
        }

        // 限制最大滚动
        float maxSY = _content_height() - visH
        if _scrollY > maxSY { _scrollY = maxSY }
        if maxSY < 0 { _scrollY = 0 }
    }

    // ==================== set 初始化 ====================
    func set(Dict opts) {
        text        = opts.get("text", "") as string
        x           = _float(opts.get("x", 0))
        y           = _float(opts.get("y", 0))
        w           = _float(opts.get("w", 180))
        h           = _float(opts.get("h", 36))
        _radius     = _float(opts.get("radius", 5))
        _fontSize   = _float(opts.get("font_size", 16))
        _fontPath   = opts.get("font_path", "") as string
        _fontStyle  = _int(opts.get("font_style", 0))

        // 颜色
        cr = 35; cg = 35; cb = 50
        tr = 220; tg = 220; tb = 240
        var c = opts.get("bg_rgb")
        if c is Array[int] { cr = _int(c[0]); cg = _int(c[1]); cb = _int(c[2]) }
        var tc = opts.get("text_rgb")
        if tc is Array[int] { tr = _int(tc[0]); tg = _int(tc[1]); tb = _int(tc[2]) }
        _focusR = 100; _focusG = 180; _focusB = 255
        var fc = opts.get("focus_rgb")
        if fc is Array[int] { _focusR = _int(fc[0]); _focusG = _int(fc[1]); _focusB = _int(fc[2]) }

        _placeholder = opts.get("placeholder", "") as string
        _tip = opts.get("tip", "") as string

        // 模式
        _multiline  = _bool(opts.get("multiline", false))
        _password   = _bool(opts.get("password", false))
        _readOnly   = _bool(opts.get("readonly", false))
        _wordWrap   = _bool(opts.get("wordWrap", false))

        // 状态
        _focused    = false
        _hoverText  = false
        _showCursor = true
        _blinkTime  = core.getTicks()
        _cursorPos  = text.len()
        _cursorLine = 0; _cursorCol = 0
        _scrollX    = 0.0; _scrollY  = 0.0
        _lines      = []
        _drLi = []; _drC0 = []; _drC1 = []; _drCount = 0
        _drDirty = true; _drVisW = 0.0; _drWrap = _wordWrap
        _drLStart = []; _drLCnt = []; _dirtyLine = -1
        _lineW = []; _maxLineW = 0.0; _lwDirty = true
        _dirty      = true
        _cachedLen  = -1
        _lastClickTime = 0; _lastClickX = 0; _lastClickY = 0
        _undoStack  = []; _redoStack = []; _undoCursorStack = []; _redoCursorStack = []
        _mergeUndo = false; _mergePos = 0
        _selStart   = -1; _selEnd = 0; _selActive = false

        _ensure_font()
        enabled = _bool(opts.get("enabled", true))
        visible = _bool(opts.get("visible", true))
        _loaded = true
    }

    // ==================== 设置方法 ====================
    func set_text(string t) {
        text = t; _cursorPos = text.len(); _cursorLine = 0; _cursorCol = 0
        _dirty = true; _adjust_scroll()
    }
    func set_pos(float px, float py)    { x = px; y = py }
    func set_size(float sw, float sh)   { w = sw; h = sh }
    func get_w(): float                 { return w }
    func get_h(): float                 { return h }
    func set_bg(int r, int g, int b)    { cr = r; cg = g; cb = b }
    func set_text_rgb(int r, int g, int b) { tr = r; tg = g; tb = b }
    func set_font_size(float s) {
        _fontSize = s
        if _font != null { _font.close(); _font = null }
    }
    func set_readonly(bool ro)  { _readOnly = ro }
    func set_password(bool pw)  { _password = pw }
    func set_multiline(bool ml) {
        if not ml { text = get_text() }   // 切单行前 flush lines → text
        _multiline = ml; _dirty = true
    }
    func set_placeholder(string p) { _placeholder = p }
    func set_tip(string t) { _tip = t }
    func set_enabled(bool e) { enabled = e }
    func set_visible(bool v) { visible = v }
    func is_visible(): bool { return visible }
    func set_window(Ptr[u8] hwnd) { _hwnd = hwnd }
    func set_word_wrap(bool w)  { _wordWrap = w; _scrollX = 0.0; _drDirty = true }
    func focus()    { _focused = true }
    func blur()     { _focused = false }

    // 保存当前状态到撤销栈
    func _save_undo() {
        _undoStack.add(_lines.copy())
        _undoCursorStack.add(_cursorLine * 10000 + _cursorCol)
        if _undoStack.len() > 200 { _undoStack.remove(0); _undoCursorStack.remove(0) }
        _redoStack.clear(); _redoCursorStack.clear()
    }

    // Ctrl+Z
    func _undo() {
        if _undoStack.len() == 0 { return }
        // 保存当前状态到 redo 栈
        _redoStack.add(_lines.copy())
        _redoCursorStack.add(_cursorLine * 10000 + _cursorCol)
        // 恢复行内容
        _lines = _undoStack[_undoStack.len() - 1]
        _undoStack.remove(_undoStack.len() - 1)
        // 恢复光标位置
        var cursorInfo = _undoCursorStack[_undoCursorStack.len() - 1]
        _undoCursorStack.remove(_undoCursorStack.len() - 1)
        _cursorLine = cursorInfo / 10000
        _cursorCol = cursorInfo % 10000
        _textDirty = true; _cachedLen = -1; _cachedMaxW = -1; _mergeUndo = false
        _clear_sel()
        if _lines.len() > 0 {
            if _cursorLine >= _lines.len() { _cursorLine = _lines.len() - 1 }
            if _cursorLine < 0 { _cursorLine = 0 }
            if _cursorCol > _lines[_cursorLine].len() { _cursorCol = _lines[_cursorLine].len() }
        } else { _cursorLine = 0; _cursorCol = 0 }
        _cursorPos = _col_to_pos(_cursorLine, _cursorCol)
        text = get_text()
        _drDirty = true; _lwDirty = true
        _adjust_scroll()
    }

    // Ctrl+Y
    func _redo() {
        if _redoStack.len() == 0 { return }
        // 保存当前状态到 undo 栈
        _undoStack.add(_lines.copy())
        _undoCursorStack.add(_cursorLine * 10000 + _cursorCol)
        // 恢复行内容
        _lines = _redoStack[_redoStack.len() - 1]
        _redoStack.remove(_redoStack.len() - 1)
        // 恢复光标位置
        var cursorInfo = _redoCursorStack[_redoCursorStack.len() - 1]
        _redoCursorStack.remove(_redoCursorStack.len() - 1)
        _cursorLine = cursorInfo / 10000
        _cursorCol = cursorInfo % 10000
        _textDirty = true; _cachedLen = -1; _cachedMaxW = -1; _mergeUndo = false
        _clear_sel()
        if _lines.len() > 0 {
            if _cursorLine >= _lines.len() { _cursorLine = _lines.len() - 1 }
            if _cursorLine < 0 { _cursorLine = 0 }
            if _cursorCol > _lines[_cursorLine].len() { _cursorCol = _lines[_cursorLine].len() }
        } else { _cursorLine = 0; _cursorCol = 0 }
        _cursorPos = _col_to_pos(_cursorLine, _cursorCol)
        text = get_text()             // 同步 text
        _drDirty = true; _lwDirty = true
        _adjust_scroll()
    }

    // ==================== 查询 ====================
    func is_focused(): bool { return _focused }
    func get_text_length(): int {
        if _cachedLen < 0 {
            _rebuild_lines()
            var len = 0
            for _lines.len() to li { len = len + _lines[li].len() }
            if _lines.len() > 1 { len = len + _lines.len() - 1 }
            _cachedLen = len
        }
        return _cachedLen
    }
    func get_text(): string {
        if _textDirty {
            _rebuild_lines()
            text = _lines.join("\n")
            _textDirty = false
        }
        return text
    }

    // ==================== 回调 ====================
    func on_change(func():void cb) { _onChange = cb }
    func on_enter(func():void cb)  { _onEnter = cb }

    // ==================== 交互 ====================
    func contains(float mx, float my): bool {
        return mx >= x and mx <= x + w and my >= y and my <= y + h
    }

    // 判断鼠标是否悬停在可编辑区域（多行模式排除滚动条）
    func _edit_hit(float mx, float my): bool {
        if not contains(mx, my) { return false }
        if _multiline {
            float pad = 8.0
            float sbW = _sb_width(); float sbH = _sb_height()
            float visW = w - pad * 2.0 - sbW
            float visH = h - pad * 2.0 - sbH
            if sbW > 0.0 {
                float vsbX = x + w - sbW - 4.0
                if mx >= vsbX and mx <= vsbX + sbW
                   and my >= y + pad and my <= y + pad + visH { return false }
            }
            if sbH > 0.0 {
                float hsbY = y + h - sbH - 4.0
                if my >= hsbY and my <= hsbY + sbH
                   and mx >= x + pad and mx <= x + pad + visW { return false }
            }
        }
        return true
    }

    func _update_ime() {
        float pad = 8.0
        float cx
        var rect = core.SDL_Rect.malloc()
        if _multiline {
            _rebuild_lines()
            cx = x + pad + _line_width_to(_cursorLine, _cursorCol) - _scrollX
            float cy = y + pad + _float(_cursorLine) * _lineHeight - _scrollY
            rect.x = _int(x)
            rect.y = _int(cy)
            rect.w = _int(w)
            rect.h = _int(_lineHeight)
        } else {
            cx = x + pad + _text_width_to(_cursorPos) - _scrollX
            rect.x = _int(x)
            rect.y = _int(y + h)
            rect.w = _int(w)
            rect.h = _int(h)
        }
        core.setTextInputArea(_hwnd, rect.to_ptr(), _int(cx - x))
        rect.free()
    }

    // 单行：从 x 算光标位置
    func _pos_from_x(float mx): int {
        if _font == null or not _font.ok { return 0 }
        if text.len() == 0 { return 0 }
        float relX = mx - x - 8.0 + _scrollX
        if relX <= 0 { return 0 }
        var lo = 0
        var hi = text.len()
        while lo < hi {
            var mid = (lo + hi + 1) / 2
            if _text_width_to(mid) <= relX { lo = mid } else { hi = mid - 1 }
        }
        return lo
    }

    // 多行：从 mx,my 算 (line, col)
    func _pos_from_xy(float mx, float my) {
        float pad = 8.0; float sbW = _sb_width()
        float visW = w - pad * 2.0 - sbW
        if _wordWrap { visW = w - pad * 2.0 }   // 换行模式布局宽度与渲染一致（不含滚动条）
        float relX = mx - x - pad + _scrollX
        float relY = my - y - pad + _scrollY
        if relY < 0 { relY = 0 }
        _rebuild_lines()
        _ensure_layout(visW)
        if _drCount == 0 { _cursorLine = 0; _cursorCol = 0; _cursorPos = 0; return }

        var di = _int(relY / _lineHeight)
        if di < 0 { di = 0 }
        if di >= _drCount { di = _drCount - 1 }

        var li = _drLi[di]; var c0 = _drC0[di]; var c1 = _drC1[di]
        _cursorLine = li

        if _lines.len() == 0 { _cursorCol = c0; _cursorPos = _col_to_pos(li, c0); return }
        if relX <= 0 { _cursorCol = c0; _cursorPos = _col_to_pos(li, c0); return }

        // 在段 [c0, c1] 内二分查找列
        var lo = c0
        var hi = c1
        while lo < hi {
            var mid = (lo + hi + 1) / 2
            var segW = _line_width_to(li, mid) - _line_width_to(li, c0)
            if segW <= relX { lo = mid } else { hi = mid - 1 }
        }
        _cursorCol = lo
        _cursorPos = _col_to_pos(li, lo)
    }

    // ==================== 滚动条尺寸 ====================
    // 一次性计算横/竖滚动条尺寸（双向耦合，用两段式避免相互递归）：
    // 竖条存在会挤占横向轨道宽度，横条存在会挤占竖向轨道高度，
    // 两者“是否出现”需互相参考对方的存在性，否则任一存在时另一个会判断错。
    func _compute_sb(): Array[float] {
        if not _multiline { return [0.0, 0.0] }
        float contentH = _content_height()
        float visH0 = h - 16.0
        float visW0 = w - 16.0
        float sbW = 0.0
        float sbH = 0.0
        if _wordWrap {
            // 自动换行模式不出现横向滚动条（sbH 恒为 0），竖向轨道高度不受影响
            if contentH > visH0 { sbW = 10.0 }
        } else {
            // 第一段：先忽略对方，各自判断是否超出
            if contentH > visH0          { sbW = 10.0 }
            if _max_line_width() > visW0 { sbH = 10.0 }
            // 第二段：竖条存在 → 横向轨道变窄 → 可能需横条；
            //         横条存在 → 竖向轨道变矮 → 可能需竖条
            if sbW > 0.0 and _max_line_width() > visW0 - sbW { sbH = 10.0 }
            if sbH > 0.0 and contentH > visH0 - sbH           { sbW = 10.0 }
        }
        return [sbW, sbH]
    }

    func _sb_width(): float {
        var s = _compute_sb()
        return s[0]
    }

    func _sb_height(): float {
        var s = _compute_sb()
        return s[1]
    }

    func _max_line_width(): float {
        _rebuild_lines()
        if _cachedMaxW >= 0.0 { return _cachedMaxW }
        _ensure_line_widths()
        return _cachedMaxW
    }

    // 全量重算每行宽度并得出最大行宽（仅在行结构/字体变化时触发）
    func _ensure_line_widths() {
        if not _lwDirty and _cachedMaxW >= 0.0 { return }
        _rebuild_lines()
        _lineW = []
        _maxLineW = 0.0
        for _lines.len() to li {
            var w0 = _float(_font.measureString(_lines[li]).w)
            _lineW.add(w0)
            if w0 > _maxLineW { _maxLineW = w0 }
        }
        _lwDirty = false
        _cachedMaxW = _maxLineW
    }

    // 单行内容变化时的增量更新（避免每次按键全量重测所有行）
    func _update_line_width(int li) {
        if li < 0 or li >= _lines.len() { return }
        if _lineW.len() != _lines.len() { _lwDirty = true }
        _ensure_line_widths()
        var w0 = _float(_font.measureString(_lines[li]).w)
        var old = _lineW[li]
        _lineW[li] = w0
        if w0 > _maxLineW {
            _maxLineW = w0; _cachedMaxW = w0
        } else if old >= _maxLineW - 0.5 {
            // 该行可能曾是最大值，安全起见重扫一次
            _maxLineW = 0.0
            for _lineW.len() to i { if _lineW[i] > _maxLineW { _maxLineW = _lineW[i] } }
            _cachedMaxW = _maxLineW
        }
    }

    // ==================== 事件处理 ====================
    func process(Event ev) {
        if not _loaded { return }
        if not visible { return }
        if not enabled { return }

        // 弹层捕获：光标落在“他人的下拉弹层”范围内时，本控件忽略该事件（避免穿透到下层）
        float emx = ev.mouseX(); float emy = ev.mouseY()
        if ev.isMouseWheel() { emx = ev.wheelMouseX(); emy = ev.wheelMouseY() }
        if core.inPopupCapture(emx, emy) { return }

        // ---- 悬停光标：鼠标移入编辑框 → 文本(I型)光标；移出 → 默认光标 ----
        // 走集中式光标决策（requestCursor），由 Window 帧末统一 apply，避免多控件互相覆盖
        if ev.isMouseMotion() {
            bool hit = _edit_hit(ev.mouseX(), ev.mouseY())
            _hoverText = hit
            core.markFrameMotion()
            if hit { core.requestCursor(core.SystemCursor.TEXT) }
            // 悬停提示：命中编辑区上报、离开清除
            if hit and _tip != "" { tip.tipReport(_tip, ev.mouseX(), ev.mouseY()) }
            else if not hit { tip.tipClear() }
        }

        // ---- 鼠标滚轮（所有模式，仅当光标在本控件内才响应）----
        if ev.isMouseWheel() {
            if not contains(ev.wheelMouseX(), ev.wheelMouseY()) { return }
            if _multiline {
                float sy = _scrollY - ev.wheelY() * _lineHeight * 3.0
                if sy < 0 { sy = 0 }
                // 可见高度需减去横向滚动条高度（sbH），否则横条存在时滚不到底
                float maxSY = _content_height() - (h - 16.0 - _sb_height())
                if maxSY < 0 { maxSY = 0 }
                if sy > maxSY { sy = maxSY }
                _scrollY = sy
            } else {
                float sx = _scrollX - ev.wheelX() * 20.0
                if sx < 0 { sx = 0 }
                _scrollX = sx
            }
            return
        }

        // ---- 滚动条交互（多行模式）----
        if _multiline {
            float pad = 8.0
            float sbW = _sb_width()
            float sbH = _sb_height()
            float visW = w - pad * 2.0 - sbW
            float visH = h - pad * 2.0 - sbH
            float contentH = _content_height()

            // hover 检测
            _hoverVScroll = false; _hoverHScroll = false
            if sbW > 0.0 {
                float vsbX = x + w - sbW - 4.0
                if ev.mouseX() >= vsbX and ev.mouseX() <= vsbX + sbW
                   and ev.mouseY() >= y + pad and ev.mouseY() <= y + pad + visH {
                    _hoverVScroll = true
                }
            }
            if sbH > 0.0 {
                float hsbY = y + h - sbH - 4.0
                if ev.mouseY() >= hsbY and ev.mouseY() <= hsbY + sbH
                   and ev.mouseX() >= x + pad and ev.mouseX() <= x + pad + visW {
                    _hoverHScroll = true
                }
            }

            // 竖向拖动
            if sbW > 0.0 and ev.isMouseButtonDown() and _hoverVScroll and not _draggingHScroll {
                _draggingVScroll = true; _mouseDown = false
            }
            if _draggingVScroll {
                if ev.isMouseButtonUp() { _draggingVScroll = false }
                else if ev.isMouseMotion() {
                    float maxSY = contentH - visH
                    if maxSY < 0 { maxSY = 0 }
                    float thumbH = visH * visH / contentH
                    if thumbH < 20 { thumbH = 20 }
                    float relY = ev.mouseY() - y - pad
                    _scrollY = relY * maxSY / (visH - thumbH)
                    if _scrollY < 0 { _scrollY = 0 }
                    if _scrollY > maxSY { _scrollY = maxSY }
                }
            }

            // 横向拖动：在横向滚动条区域内按下即开始（直接命中测试，不依赖每事件 hover 布尔，
            // 避免点击稍偏时“有时拖不动”）；抓在滑块上记录偏移，做到抓哪拖哪不跳变。
            if sbH > 0.0 {
                var maxLineW = _max_line_width() + 8.0
                float maxSX = maxLineW - visW
                if maxSX < 0 { maxSX = 0 }
                float thumbW = visW * visW / maxLineW
                if thumbW < 20 { thumbW = 20 }
                float hsbY = y + h - sbH - 4.0
                float trackX0 = x + pad
                float trackX1 = x + pad + visW
                float thumbX = trackX0
                if maxSX > 0 { thumbX = trackX0 + _scrollX * visW / maxLineW }
                if thumbX + thumbW > trackX1 { thumbX = trackX1 - thumbW }

                if ev.isMouseButtonDown() and not _draggingVScroll {
                    bool onBar = ev.mouseY() >= hsbY and ev.mouseY() <= hsbY + sbH
                                and ev.mouseX() >= trackX0 and ev.mouseX() <= trackX1
                    if onBar {
                        _draggingHScroll = true; _mouseDown = false
                        if ev.mouseX() >= thumbX and ev.mouseX() <= thumbX + thumbW {
                            _hDragThumb = true
                            _hDragOffset = ev.mouseX() - thumbX
                        } else {
                            _hDragThumb = false
                        }
                    }
                }
            }
            if _draggingHScroll {
                if ev.isMouseButtonUp() { _draggingHScroll = false }
                else if ev.isMouseMotion() {
                    var maxLineW = _max_line_width() + 8.0
                    float maxSX = maxLineW - visW
                    if maxSX < 0 { maxSX = 0 }
                    float thumbW = visW * visW / maxLineW
                    if thumbW < 20 { thumbW = 20 }
                    float trackX0 = x + pad
                    float trackX1 = x + pad + visW
                    float tx
                    if _hDragThumb { tx = ev.mouseX() - _hDragOffset }
                    else { tx = ev.mouseX() - thumbW * 0.5 }
                    if tx < trackX0 { tx = trackX0 }
                    if tx > trackX1 - thumbW { tx = trackX1 - thumbW }
                    if maxSX <= 0 { _scrollX = 0 }
                    else { _scrollX = (tx - trackX0) * maxSX / (trackX1 - thumbW - trackX0) }
                    if _scrollX < 0 { _scrollX = 0 }
                    if _scrollX > maxSX { _scrollX = maxSX }
                }
            }
        }

        // ---- 选区 + 聚焦 ----
        if ev.isMouseButtonDown() {
            var inside = contains(ev.mouseX(), ev.mouseY())
            _focused = inside
            if inside and not _draggingVScroll and not _draggingHScroll {
                // 双击检测（400ms 内，位置接近）
                var now = core.getTicks()
                var isDbl = now - _lastClickTime < 400
                        and ev.mouseX() >= _lastClickX - 10 and ev.mouseX() <= _lastClickX + 10
                        and ev.mouseY() >= _lastClickY - 10 and ev.mouseY() <= _lastClickY + 10
                _lastClickTime = now
                _lastClickX = ev.mouseX(); _lastClickY = ev.mouseY()
                if isDbl {
                    if _multiline { _pos_from_xy(ev.mouseX(), ev.mouseY()) }
                    else { _cursorPos = _pos_from_x(ev.mouseX()) }
                    _select_word()
                    return
                } else {
                    _mouseDown = true
                }
                if not isDbl and _focused {
                    if _multiline {
                        _pos_from_xy(ev.mouseX(), ev.mouseY())
                    } else {
                        _cursorPos = _pos_from_x(ev.mouseX())
                    }
                    _selStart = _cursorPos; _selEnd = _cursorPos; _selActive = false
                    _adjust_scroll()
                    _showCursor = true; _blinkTime = core.getTicks()
                    _update_ime()
                } else {
                    _selActive = false; _selStart = -1
                }
            }
        }

        // 按住拖动扩展选区
        if _mouseDown and ev.isMouseMotion() and _focused and not _draggingVScroll and not _draggingHScroll {
            if ev.mouseX() >= x and ev.mouseX() <= x + w
               and ev.mouseY() >= y and ev.mouseY() <= y + h {
                var oldEnd = _selEnd
                if _multiline {
                    _pos_from_xy(ev.mouseX(), ev.mouseY())
                } else {
                    _cursorPos = _pos_from_x(ev.mouseX())
                }
                if _cursorPos != _selEnd {
                    _selEnd = _cursorPos
                    _selActive = true
                    _adjust_scroll()
                }
            }
        }

        if ev.isMouseButtonUp() {
            _mouseDown = false
            if _selStart == _selEnd { _selActive = false; _selStart = -1 }
        }

        if not _focused { return }
        if _readOnly { return }

        if _multiline {
            _process_ml(ev)
        } else {
            _process_sl(ev)
        }
    }

    // 清除选区
    func _clear_sel() {
        _selActive = false
        _selStart = -1
    }

    // 双击选词
    func _select_word() {
        if not _multiline {
            // 单行模式：直接基于 text 和 _cursorPos
            if text.len() == 0 { return }
            var s = _cursorPos; var e = _cursorPos
            while s > 0 and _is_word_char(text.slice(s - 1, s)) { s -= 1 }
            while e < text.len() and _is_word_char(text.slice(e, e + 1)) { e += 1 }
            if s >= e { return }
            _selStart = s; _selEnd = e; _selActive = true
            return
        }
        _rebuild_lines()
        if _lines.len() == 0 or _cursorLine >= _lines.len() { return }
        var ln = _lines[_cursorLine]
        if ln.len() == 0 { return }
        var s = _cursorCol; var e = _cursorCol
        while s > 0 and _is_word_char(ln.slice(s - 1, s)) { s -= 1 }
        while e < ln.len() and _is_word_char(ln.slice(e, e + 1)) { e += 1 }
        if s >= e { return }
        _selStart = _line_pos(_cursorLine) + s
        _selEnd = _line_pos(_cursorLine) + e
        _selActive = true
    }

    func _is_word_char(string c): bool {
        if c == "" or c == " " or c == "\n" or c == "\r" or c == "\t" { return false }
        if ".,!?:;()[]\"'：。，！？（）【】；".has(c) { return false }
        return true
    }

    // 获取选中的文本
    func _sel_text(): string {
        if not _selActive or _selStart < 0 { return "" }
        var s = _selStart; var e = _selEnd
        if s > e { var t = s; s = e; e = t }
        if s < 0 { s = 0 }
        var t = get_text()
        if e > t.len() { e = t.len() }
        if s >= e { return "" }
        return t.slice(s, e)
    }

    // 删除选区并返回删除的起始位置
    func _del_sel(): int {
        if not _selActive or _selStart < 0 { return _cursorPos }
        var s = _selStart; var e = _selEnd
        if s > e { var t = s; s = e; e = t }
        if s < 0 { s = 0 }
        if e > text.len() { e = text.len() }
        if s < e { text = text.slice(0, s) + text.slice(e, text.len()) }
        _clear_sel()
        return s
    }

    // ---- 单行事件处理 ----
    func _process_sl(Event ev) {
        if ev.isKeyDown() {
            int sc = ev.scancode()
            bool changed = false

            // Ctrl 组合键
            int mod = ev.keyMod()
            bool ctrl = (mod & 64) != 0 or (mod & 128) != 0
            if ctrl {
                if sc == Scancode.A {
                    _selStart = 0; _selEnd = text.len(); _selActive = true
                    return
                }
                if sc == Scancode.C {
                    var sel = _sel_text()
                    if sel != "" { core.setClipboardText(sel) }
                    else { core.setClipboardText(text) }
                    return
                }
                if sc == Scancode.X {
                    var sel = _sel_text()
                    if sel != "" { core.setClipboardText(sel) }
                    else { core.setClipboardText(text) }
                    _save_undo(); _cursorPos = _del_sel()
                    changed = true
                }
                if sc == Scancode.V {
                    var paste = core.getClipboardText()
                    if paste != "" {
                        paste = paste.replace("\r", "").replace("\n", " ")
                        _cursorPos = _del_sel()
                        text = text.slice(0, _cursorPos) + paste + text.slice(_cursorPos, text.len())
                        _cursorPos += paste.len()
                        changed = true
                    }
                }
            }

            if sc == Scancode.BACKSPACE {
                if _selActive and _selStart != _selEnd {
                    _cursorPos = _del_sel(); changed = true
                } else if _cursorPos > 0 {
                    text = text.slice(0, _cursorPos - 1) + text.slice(_cursorPos, text.len())
                    _cursorPos -= 1; changed = true
                }
            }
            if sc == Scancode.DELETE {
                if _selActive and _selStart != _selEnd {
                    _cursorPos = _del_sel(); changed = true
                } else if _cursorPos < text.len() {
                    text = text.slice(0, _cursorPos) + text.slice(_cursorPos + 1, text.len())
                    changed = true
                }
            }
            if sc == Scancode.LEFT  { if _cursorPos > 0 { _cursorPos -= 1; _clear_sel() } }
            if sc == Scancode.RIGHT { if _cursorPos < text.len() { _cursorPos += 1; _clear_sel() } }
            if sc == Scancode.HOME  { _cursorPos = 0; _clear_sel() }
            if sc == Scancode.END   { _cursorPos = text.len(); _clear_sel() }
            _adjust_scroll()
            if sc == Scancode.RETURN {
                if _onEnter != null { _onEnter() }
            }

            if changed { _dirty = true; _on_text_changed() }
        }

        if ev.isTextInput() {
            var ch = ev.text()
            if ch != "" {
                _cursorPos = _del_sel()
                text = text.slice(0, _cursorPos) + ch + text.slice(_cursorPos, text.len())
                _cursorPos += ch.len()
                _on_text_changed()
                _dirty = true
            }
        }
    }

    // ---- 多行事件处理（直接改 _lines，O(行长度) 非 O(全文)）----
    func _process_ml(Event ev) {
        if ev.isKeyDown() {
            int sc = ev.scancode()
            bool moved = false; bool changed = false

            _rebuild_lines()

            // Ctrl 组合键
            int mod = ev.keyMod()
            bool ctrl = (mod & 64) != 0 or (mod & 128) != 0
            if ctrl {
                if sc == Scancode.A { _selStart = 0; _selEnd = get_text().len(); _selActive = true; return }
                if sc == Scancode.Z { _undo(); return }
                if sc == Scancode.Y { _redo(); return }
                if sc == Scancode.C {
                    var t = get_text()
                    var sel = _sel_text()
                    if sel != "" { core.setClipboardText(sel) }
                    else { core.setClipboardText(t) }
                    return
                }
                if sc == Scancode.X {
                    var t = get_text()
                    var sel = _sel_text()
                    if sel != "" { core.setClipboardText(sel) }
                    else { core.setClipboardText(t) }
                    _save_undo(); _mergeUndo = false; _del_sel_lines(); _cachedLen = -1; _lwDirty = true; changed = true
                }
                if sc == Scancode.V {
                    var paste = core.getClipboardText()
                    if paste != "" {
                        _save_undo(); _mergeUndo = false
                        _del_sel_lines()
                        if _lines.len() == 0 { _lines.add("") }
                        var left = _lines[_cursorLine].slice(0, _cursorCol)
                        var right = _lines[_cursorLine].slice(_cursorCol, _lines[_cursorLine].len())
                        var full = left + paste
                        var plines = full.replace("\r", "").split("\n")
                        _lines.remove(_cursorLine)
                        for plines.len() to pi {
                            _lines.insert(_cursorLine + pi, plines[pi] as string)
                        }
                        // 末行拼右侧
                        var li = _cursorLine + plines.len() - 1
                        _lines[li] = _lines[li] + right
                        _cursorLine = li
                        _cursorCol = (plines[plines.len() - 1] as string).len()
                        _cachedLen = -1; _cachedMaxW = -1; _lwDirty = true; changed = true
                    }
                }
            }

            // 退格
            if sc == Scancode.BACKSPACE {
                if _selActive and _selStart != _selEnd {
                    _save_undo(); _mergeUndo = false; _del_sel_lines(); _cachedLen = -1; _lwDirty = true; changed = true
                } else if _cursorCol > 0 {
                    _save_undo(); _mergeUndo = false; var ln = _lines[_cursorLine]
                    _lines[_cursorLine] = ln.slice(0, _cursorCol - 1) + ln.slice(_cursorCol, ln.len())
                    _cursorCol -= 1; _cachedLen -= 1; _update_line_width(_cursorLine); _dirtyLine = _cursorLine; changed = true
                } else if _cursorLine > 0 {
                    _save_undo(); _mergeUndo = false; _cursorCol = _lines[_cursorLine - 1].len()
                    _lines[_cursorLine - 1] = _lines[_cursorLine - 1] + _lines[_cursorLine]
                    _lines.remove(_cursorLine)
                    _cursorLine -= 1; _cachedLen -= 1; _cachedMaxW = -1; _lwDirty = true; changed = true
                }
            }

            // Delete
            if sc == Scancode.DELETE {
                if _selActive and _selStart != _selEnd {
                    _save_undo(); _mergeUndo = false; _del_sel_lines(); _cachedLen = -1; _cachedMaxW = -1; _lwDirty = true; changed = true
                } else if _cursorCol < _lines[_cursorLine].len() {
                    _save_undo(); _mergeUndo = false; var ln = _lines[_cursorLine]
                    _lines[_cursorLine] = ln.slice(0, _cursorCol) + ln.slice(_cursorCol + 1, ln.len())
                    _cachedLen -= 1; _update_line_width(_cursorLine); _dirtyLine = _cursorLine; changed = true
                } else if _cursorLine < _lines.len() - 1 {
                    _save_undo(); _mergeUndo = false; _lines[_cursorLine] = _lines[_cursorLine] + _lines[_cursorLine + 1]
                    _lines.remove(_cursorLine + 1)
                    _cachedLen -= 1; _cachedMaxW = -1; _lwDirty = true; changed = true
                }
            }

            // 方向键
            if sc == Scancode.LEFT {
                if _cursorCol > 0 { _cursorCol -= 1; moved = true; _clear_sel() }
                else if _cursorLine > 0 { _cursorLine -= 1; _cursorCol = _lines[_cursorLine].len(); moved = true; _clear_sel() }
                _mergeUndo = false
            }
            if sc == Scancode.RIGHT {
                if _cursorCol < _lines[_cursorLine].len() { _cursorCol += 1; moved = true; _clear_sel() }
                else if _cursorLine < _lines.len() - 1 { _cursorLine += 1; _cursorCol = 0; moved = true; _clear_sel() }
                _mergeUndo = false
            }
            if sc == Scancode.UP     { _move_up(); moved = true; _clear_sel(); _mergeUndo = false }
            if sc == Scancode.DOWN   { _move_down(); moved = true; _clear_sel(); _mergeUndo = false }
            if sc == Scancode.HOME   { _cursorCol = 0; moved = true; _clear_sel(); _mergeUndo = false }
            if sc == Scancode.END    { _cursorCol = _lines[_cursorLine].len(); moved = true; _clear_sel(); _mergeUndo = false }

            // 回车
            if sc == Scancode.RETURN {
                _save_undo(); _mergeUndo = false; var ln = _lines[_cursorLine]
                var rest = ln.slice(_cursorCol, ln.len())
                _lines[_cursorLine] = ln.slice(0, _cursorCol)
                _lines.insert(_cursorLine + 1, rest)
                _cursorLine += 1; _cursorCol = 0; _cachedLen += 1; _cachedMaxW = -1; _lwDirty = true; changed = true
            }

            if _cursorLine >= _lines.len() { _cursorLine = _lines.len() - 1 }
            if _cursorLine < 0 { _cursorLine = 0 }

            if changed {
                if _dirtyLine < 0 { _drDirty = true }
                _cursorPos = _col_to_pos(_cursorLine, _cursorCol)
                _textDirty = true
                _adjust_scroll()
                _showCursor = true; _blinkTime = core.getTicks()
                _update_ime()
                if _onChange != null { _onChange() }
            } else if moved {
                _cursorPos = _col_to_pos(_cursorLine, _cursorCol)
                _adjust_scroll()
                _showCursor = true; _blinkTime = core.getTicks()
                _update_ime()
            }
        }

        // 文本输入
        if ev.isTextInput() {
            var ch = ev.text()
            if ch != "" {
                _rebuild_lines()
                // 连续输入合并撤销：仅当上次也是文本输入、无选区删除、且光标紧接上次结束位置
                bool canMerge = _mergeUndo and not _selActive and _cursorPos == _mergePos
                if not canMerge { _save_undo() }
                _del_sel_lines()
                if _lines.len() == 0 { _lines.add("") }
                var ln = _lines[_cursorLine]
                _lines[_cursorLine] = ln.slice(0, _cursorCol) + ch + ln.slice(_cursorCol, ln.len())
                _cursorCol += ch.len()
                _cachedLen = -1; _update_line_width(_cursorLine)
                _dirtyLine = _cursorLine
                _cursorPos = _col_to_pos(_cursorLine, _cursorCol)
                _textDirty = true
                _adjust_scroll()
                _showCursor = true; _blinkTime = core.getTicks()
                _update_ime()
                if _onChange != null { _onChange() }
                _mergeUndo = true; _mergePos = _cursorPos
            }
        }
    }

    // 计算某行在全文中的起始字节位置
    func _line_pos(int line): int {
        return _col_to_pos(line, 0)
    }

    // 总字符数（用于 Ctrl+A）
    func _line_count_pos(): int {
        _rebuild_lines()
        var pos = 0
        for _lines.len() to li { pos = pos + _lines[li].len() + 1 }
        if pos > 0 { pos -= 1 }    // 去掉最后一个 \n
        return pos
    }

    // 删除选区(行级别)
    func _del_sel_lines() {
        if not _selActive or _selStart < 0 { return }
        var s = _selStart; var e = _selEnd
        if s > e { var t = s; s = e; e = t }
        if s < 0 { s = 0 }
        if s >= e { _clear_sel(); return }
        // 转换为行列
        var cs = _pos_to_col(s)
        var ce = _pos_to_col(e)
        var ls = _pos_to_line(s)
        var le = _pos_to_line(e)
        if ls < 0 or le < 0 or ls >= _lines.len() or le >= _lines.len() { _clear_sel(); return }
        // 删除选区
        if ls == le {
            var ln = _lines[ls]
            _lines[ls] = ln.slice(0, cs) + ln.slice(ce, ln.len())
        } else {
            _lines[ls] = _lines[ls].slice(0, cs) + _lines[le].slice(ce, _lines[le].len())
            var cnt = le - ls
            for cnt to _ { _lines.remove(ls + 1) }
        }
        _cursorLine = ls; _cursorCol = cs
        _clear_sel()
    }

    func _pos_to_line(int pos): int {
        var p = 0
        for _lines.len() to li {
            var len = _lines[li].len() + 1
            if pos < p + len { return li }
            p += len
        }
        return _lines.len() - 1
    }

    func _pos_to_col(int pos): int {
        var p = 0
        for _lines.len() to li {
            var len = _lines[li].len() + 1
            if pos < p + len {
                var col = pos - p
                if col > _lines[li].len() { col = _lines[li].len() }
                return col
            }
            p += len
        }
        return _lines[_lines.len() - 1].len()
    }

    // ---- 多行方向键辅助（基于 _cursorPos）----
    func _move_up() {
        _sync_line_col()
        _rebuild_lines()
        float visW = w - 16.0 - _sb_width()
        if _wordWrap { visW = w - 16.0 }
        _ensure_layout(visW)
        var di = _disp_row_of(_cursorLine, _cursorCol)
        if di > 0 {
            // 在同一逻辑行内的上一显示行，或上一逻辑行的末显示行
            var pli = _drLi[di - 1]; var pc0 = _drC0[di - 1]; var pc1 = _drC1[di - 1]
            var off = _cursorCol - _drC0[di]
            if off < 0 { off = 0 }
            var ncol = pc0 + off
            if ncol > pc1 { ncol = pc1 }
            _cursorLine = pli; _cursorCol = ncol
            _cursorPos = _col_to_pos(_cursorLine, _cursorCol)
        } else if _cursorLine > 0 {
            _cursorLine -= 1
            if _cursorCol > _lines[_cursorLine].len() { _cursorCol = _lines[_cursorLine].len() }
            _cursorPos = _col_to_pos(_cursorLine, _cursorCol)
            _adjust_scroll()
        }
    }

    func _move_down() {
        _sync_line_col()
        _rebuild_lines()
        float visW = w - 16.0 - _sb_width()
        if _wordWrap { visW = w - 16.0 }
        _ensure_layout(visW)
        var di = _disp_row_of(_cursorLine, _cursorCol)
        if di < _drCount - 1 {
            var nli = _drLi[di + 1]; var nc0 = _drC0[di + 1]; var nc1 = _drC1[di + 1]
            var off = _cursorCol - _drC0[di]
            if off < 0 { off = 0 }
            var ncol = nc0 + off
            if ncol > nc1 { ncol = nc1 }
            _cursorLine = nli; _cursorCol = ncol
            _cursorPos = _col_to_pos(_cursorLine, _cursorCol)
        } else if _cursorLine < _lines.len() - 1 {
            _cursorLine += 1
            if _cursorCol > _lines[_cursorLine].len() { _cursorCol = _lines[_cursorLine].len() }
            _cursorPos = _col_to_pos(_cursorLine, _cursorCol)
            _adjust_scroll()
        }
    }

    func _move_home() {
        _sync_line_col()
        _cursorCol = 0
        _cursorPos = _col_to_pos(_cursorLine, 0)
    }

    func _move_end() {
        _sync_line_col()
        _rebuild_lines()
        _cursorCol = _lines[_cursorLine].len()
        _cursorPos = _col_to_pos(_cursorLine, _cursorCol)
    }

    // 从 _cursorPos 同步 _cursorLine / _cursorCol
    func _sync_line_col() {
        _rebuild_lines()
        var pos = 0
        _cursorLine = 0; _cursorCol = 0
        for _lines.len() to li {
            var len = _lines[li].len() + 1   // +1 for \n
            if _cursorPos < pos + len {
                _cursorLine = li
                _cursorCol = _cursorPos - pos
                if _cursorCol > _lines[li].len() { _cursorCol = _lines[li].len() }
                return
            }
            pos = pos + len
        }
        // 光标在末尾
        if _lines.len() > 0 {
            _cursorLine = _lines.len() - 1
            _cursorCol = _lines[_cursorLine].len()
        }
    }

    // 根据 line/col 计算 _cursorPos
    func _col_to_pos(int line, int col): int {
        if _lines.len() == 0 { return 0 }
        var pos = 0
        var end = line
        if end > _lines.len() { end = _lines.len() }
        if end > 0 {
            for 0 : end - 1 to i {
                pos = pos + _lines[i].len() + 1
            }
        }
        if line < _lines.len() {
            var c = col
            if c > _lines[line].len() { c = _lines[line].len() }
            pos = pos + c
        }
        return pos
    }

    // 数组中指定位置插入元素
    func _on_text_changed() {
        _adjust_scroll()
        _showCursor = true
        _blinkTime = core.getTicks()
        _update_ime()
        if _onChange != null { _onChange() }
    }

    // ==================== 渲染 ====================
    func render(Renderer r) {
        if not _loaded { return }
        if not visible { return }
        _ensure_font()
        if _font == null or not _font.ok { return }

        // 光标闪烁
        var now = core.getTicks()
        if now - _blinkTime >= 500 {
            _showCursor = not _showCursor
            _blinkTime = now
        }

        // 背景
        r.setColor(cr, cg, cb, 255)
        r.fillRoundedRect(x, y, w, h, _radius)

        // 边框
        if _focused { r.setColor(_focusR, _focusG, _focusB, 255) }
        else         { r.setColor(cr + 40, cg + 40, cb + 40, 220) }
        r.drawRoundedRect(x, y, w, h, _radius)

        if _multiline {
            _render_ml(r)
        } else {
            _render_sl(r)
        }
    }

    // ---- 单行渲染 ----
    func _render_sl(Renderer r) {
        _font.setSSAA(r.getSSAA())   // 让 measureString 与 SSAA 绘制宽度一致，光标/选区对齐且不变形
        float pad = 8.0
        // 裁剪
        var clip = core.SDL_Rect.malloc()
        clip.x = _int(x + pad); clip.y = _int(y)
        clip.w = _int(w - pad * 2.0); clip.h = _int(h)
        r.setClipRect(clip.to_ptr())

        // 文字几何（先算，供选区/光标对齐）
        var ms0 = _font.measureString("Ag")
        float textH = _float(ms0.h)
        float ty = y + (h - textH) / 2.0
        var display = text
        if _password and text != "" { display = "*".rep(text.len()) }
        if text != "" {
            var ms = _font.measureString(display)
            textH = _float(ms.h)
            ty = y + (h - textH) / 2.0
        }

        // 选区高亮（画在文字【后面】，文字再叠上去仍可见）
        if _selActive and _selStart >= 0 and _selStart != _selEnd and text != "" {
            var ss = _selStart; var se = _selEnd
            if ss > se { var t = ss; ss = se; se = t }
            if ss < 0 { ss = 0 }
            if se > text.len() { se = text.len() }
            float sx = r.snapX(x + pad + _text_width_to(ss) - _scrollX)
            float ex = r.snapX(x + pad + _text_width_to(se) - _scrollX)
            float rx = sx; float rw = ex - sx
            if rw < 0 { rx = ex; rw = -rw }
            r.setColor(60, 100, 180, 180)
            r.fillRect(rx, r.snapY(ty), rw, textH)
        }

        // 文字（叠在选区之上）
        if text == "" and not _focused and _placeholder != "" {
            var ms = _font.measureString(_placeholder)
            float py = y + (h - _float(ms.h)) / 2.0
            r.drawText(_font, _placeholder, r.snapX(x + pad), r.snapY(py),
                       tr / 2 + 50, tg / 2 + 50, tb / 2 + 50)
        } else if text != "" {
            r.drawText(_font, display, r.snapX(x + pad - _scrollX), r.snapY(ty), tr, tg, tb)
        }

        r.clearClip(); clip.free()

        // 光标（与文字同高、垂直对齐）
        if _focused and _showCursor {
            float cx = r.snapX(x + pad + _text_width_to(_cursorPos) - _scrollX)
            if cx < x + pad { cx = x + pad }
            if cx > x + w - pad { cx = x + w - pad }
            r.setColor(220, 220, 240, 200)
            r.drawLine(cx, r.snapY(ty), cx, r.snapY(ty + textH))
        }
    }

    // ---- 多行渲染 ----
    func _render_ml(Renderer r) {
        _font.setSSAA(r.getSSAA())   // 让 measureString 与 SSAA 绘制宽度一致，光标/选区对齐且不变形
        _rebuild_lines()
        _sync_line_col()                // 进入渲染时统一同步行列
        float pad = 8.0
        // 先用不含滚动条的宽度构建显示行表（仅脏时重建），再算滚动条
        float provVisW = w - pad * 2.0
        if provVisW <= 0 { provVisW = 1.0 }
        _ensure_layout(provVisW)
        float sbW = _sb_width()
        float sbH = _sb_height()
        float visW = w - pad * 2.0 - sbW
        float visH = h - pad * 2.0 - sbH
        if visW <= 0 { visW = 1.0 }
        if visH <= 0 { visH = 1.0 }
        if not _wordWrap { _ensure_layout(visW) }


        // 裁剪区域
        var clip = core.SDL_Rect.malloc()
        clip.x = _int(x + pad); clip.y = _int(y + pad)
        clip.w = _int(visW); clip.h = _int(visH)
        r.setClipRect(clip.to_ptr())

        // 计算可见行范围（选区和文本渲染共用）
        var firstLine = _int(_scrollY / _lineHeight)
        var lastLineV = firstLine + _int(visH / _lineHeight) + 2
        if lastLineV > _drCount { lastLineV = _drCount }
        if firstLine < 0 { firstLine = 0 }

        // ---- 选区高亮（画在文字后面）----
        if _selActive and _selStart >= 0 and _selStart != _selEnd and _lines.len() > 0 {
            var ss = _selStart; var se = _selEnd
            if ss > se { var t = ss; ss = se; se = t }
            for firstLine : lastLineV - 1 to di {
                if di >= _drCount { break }
                var li = _drLi[di]; var c0 = _drC0[di]; var c1 = _drC1[di]
                var segStart = _line_pos(li) + c0
                var segEnd = _line_pos(li) + c1
                var selS = ss; var selE = se
                if selS > segEnd { continue }
                if selE < segStart { continue }
                if selS < segStart { selS = segStart }
                if selE > segEnd { selE = segEnd }
                if selS >= selE { continue }
                var colS = selS - segStart
                var colE = selE - segStart
                var full = _lines[li]
                var ms1 = _font.measureString(full.slice(c0, c0 + colS))
                var ms2 = _font.measureString(full.slice(c0, c0 + colE))
                float sx = r.snapX(x + pad + _float(ms1.w) - _scrollX)
                float ew = _float(ms2.w) - _float(ms1.w)
                float sy = r.snapY(y + pad + _float(di) * _lineHeight - _scrollY)
                if ew < 0 { ew = 0 }
                r.setColor(60, 100, 180, 180)
                r.fillRect(sx, sy, ew, _lineHeight)
            }
        }

        // 占位文字 / 内容
        if _lines.len() == 0 and not _focused and _placeholder != "" {
            var phLines = _placeholder.split("\n")
            var dy = 0
            for phLines.len() to pl {
                var seg = phLines[pl] as string
                var wraps = _wrap_line(seg, visW)
                for wraps.len() to wi {
                    float ly = y + pad + _float(dy) * _lineHeight - _scrollY
                    r.drawText(_font, wraps[wi] as string, r.snapX(x + pad), r.snapY(ly), tr / 2 + 50, tg / 2 + 50, tb / 2 + 50)
                    dy += 1
                }
            }
        } else if _lines.len() > 0 {
            for firstLine : lastLineV - 1 to di {
                if di >= _drCount { break }
                var li = _drLi[di]; var c0 = _drC0[di]; var c1 = _drC1[di]
                var seg = _lines[li].slice(c0, c1)
                if _password { seg = "*".rep(seg.len()) }
                float ly = y + pad + _float(di) * _lineHeight - _scrollY
                r.drawText(_font, seg, r.snapX(x + pad - _scrollX), r.snapY(ly), tr, tg, tb)
            }
        }

        // 光标（在裁剪区域内）
        _cursorPos = _col_to_pos(_cursorLine, _cursorCol)
        if _focused and _showCursor {
            if _lines.len() > 0 and _drCount > 0 {
                var cdi = _disp_row_of(_cursorLine, _cursorCol)
                float cy = r.snapY(y + pad + _float(cdi) * _lineHeight - _scrollY)
                if cy + _lineHeight > y + pad and cy < y + pad + visH {
                    var ms = _font.measureString("Ag")
                    float ch = _float(ms.h)
                    float cx = x + pad
                    if _wordWrap {
                        // 直接测量段内子串（ln.slice(c0, col)）作为段内偏移，
                        // 不能用 整行slice - 整行slice(c0) 相减：跨段边界的字偶距
                        // 不计入，会随换行段数累积误差导致光标错位。
                        var cm0 = 0
                        if cdi >= 0 and cdi < _drC0.len() { cm0 = _drC0[cdi] }
                        if _cursorCol < cm0 { cm0 = _cursorCol }
                        var ln = _lines[_cursorLine]
                        var seg = ln.slice(cm0, _cursorCol)
                        cx = cx + _float(_font.measureString(seg).w) - _scrollX
                    } else {
                        cx = cx + _line_width_to(_cursorLine, _cursorCol) - _scrollX
                    }
                    cx = r.snapX(cx)
                    r.setColor(220, 220, 240, 200)
                    r.drawLine(cx, cy, cx, cy + ch)
                }
            } else {
                // 空内容：光标固定在左上角
                float cy = r.snapY(y + pad)
                var ms = _font.measureString("Ag")
                float ch = _float(ms.h)
                float cx = r.snapX(x + pad)
                r.setColor(220, 220, 240, 200)
                r.drawLine(cx, cy, cx, cy + ch)
            }
        }

        r.clearClip(); clip.free()

        // ---- 竖向滚动条 ----
        if sbW > 0.0 {
            float sbX = x + w - sbW - 4.0
            float contentH = _content_height()

            r.setColor(50, 50, 60, 180)
            r.fillRect(sbX, y + pad, sbW, visH)

            float thumbH = visH * visH / contentH
            if thumbH < 20 { thumbH = 20 }
            float maxSY = contentH - visH
            float thumbY = y + pad
            if maxSY > 0 { thumbY = y + pad + _scrollY * visH / contentH }
            if thumbY + thumbH > y + pad + visH { thumbY = y + pad + visH - thumbH }

            if _hoverVScroll or _draggingVScroll {
                r.setColor(160, 160, 180, 240)
            } else {
                r.setColor(120, 120, 140, 220)
            }
            r.fillRect(sbX, thumbY, sbW, thumbH)
        }

        // ---- 横向滚动条 ----
        if sbH > 0.0 {
            float sbY = y + h - sbH - 4.0
            float maxLineW = _max_line_width() + 8.0

            r.setColor(50, 50, 60, 180)
            r.fillRect(x + pad, sbY, visW, sbH)

            float thumbW = visW * visW / maxLineW
            if thumbW < 20 { thumbW = 20 }
            float maxSX = maxLineW - visW
            if maxSX < 0 { maxSX = 0 }
            float thumbX = x + pad
            if maxSX > 0 { thumbX = x + pad + _scrollX * visW / maxLineW }
            if thumbX + thumbW > x + pad + visW { thumbX = x + pad + visW - thumbW }

            if _hoverHScroll or _draggingHScroll {
                r.setColor(160, 160, 180, 240)
            } else {
                r.setColor(120, 120, 140, 220)
            }
            r.fillRect(thumbX, sbY, thumbW, sbH)
        }

        // ---- 滚动条交叉角落 ----
        if sbW > 0.0 and sbH > 0.0 {
            float cornerX = x + w - sbW - 4.0
            float cornerY = y + h - sbH - 4.0
            r.setColor(40, 40, 50, 200)
            r.fillRect(cornerX, cornerY, sbW, sbH)
        }
    }

    // 按像素宽度拆分一行（逐字符累加宽度，O(n) 而非 O(n^2)）
    func _wrap_line(string ln, float maxW): Array[string] {
        var result = []
        if ln == "" { result.add(""); return result }
        var n = ln.len()
        var segStart = 0
        var curW = 0.0
        for :n to i {
            var ch = ln.slice(i, i + 1)
            var cw = _float(_font.measureString(ch).w)
            if curW + cw > maxW and i > segStart {
                result.add(ln.slice(segStart, i))
                segStart = i
                curW = cw
            } else {
                curW = curW + cw
            }
        }
        if segStart < n { result.add(ln.slice(segStart, n)) }
        return result
    }

    // 仅在行表脏（内容/字体/换行模式/可视宽度变化）时全量重建，避免每帧重排全文；
    // 否则若仅单行内容变化则增量重算该行（O(该行) 而非 O(全文)）
    func _ensure_layout(float visW): int {
        if _drDirty or _drWrap != _wordWrap or (_wordWrap and _drVisW != visW) {
            _build_display_rows(visW)
            _drVisW = visW
            _drWrap = _wordWrap
            _drDirty = false
            _dirtyLine = -1
        } else if _dirtyLine >= 0 {
            _rebuild_line_segment(_dirtyLine, visW)
            _dirtyLine = -1
        }
        return _drCount
    }

    // 仅重算单个逻辑行的显示行段（增量），代价 O(该行长度) 而非 O(全文)
    func _rebuild_line_segment(int li, float visW) {
        if _drLStart.len() != _lines.len() or li < 0 or li >= _lines.len() or visW != _drVisW {
            _build_display_rows(visW); _drVisW = visW; _drWrap = _wordWrap
            _drDirty = false; _dirtyLine = -1; return
        }
        int pos = _drLStart[li]
        int oldCnt = _drLCnt[li]
        Array[int] nc0 = []; Array[int] nc1 = []
        var ln = _lines[li]
        if not _wordWrap {
            nc0.add(0); nc1.add(ln.len())
        } else {
            var wl = _wrap_line(ln, visW)
            var col0 = 0
            for wl.len() to wi {
                var segLen = (wl[wi] as string).len()
                nc0.add(col0); nc1.add(col0 + segLen); col0 = col0 + segLen
            }
            if wl.len() == 0 { nc0.add(0); nc1.add(0) }
        }
        int newCnt = nc0.len()
        // 删除旧段
        for oldCnt to k { _drLi.remove(pos); _drC0.remove(pos); _drC1.remove(pos) }
        // 插入新段
        for newCnt to s {
            _drLi.insert(pos + s, li)
            _drC0.insert(pos + s, nc0[s])
            _drC1.insert(pos + s, nc1[s])
        }
        int delta = newCnt - oldCnt
        if delta != 0 and li + 1 <= _lines.len() - 1 {
            for li + 1 : _lines.len() - 1 to k { _drLStart[k] = _drLStart[k] + delta }
        }
        _drLCnt[li] = newCnt
        _drCount = _drLi.len()
    }

    // 构建显示行表：自动换行时一行逻辑行会被拆成多显示行。
    // 非换行模式下显示行与逻辑行 1:1。结果存入 _drLi/_drC0/_drC1，并维护 _drLStart/_drLCnt。
    func _build_display_rows(float visW): int {
        _drLi = []; _drC0 = []; _drC1 = []
        _drLStart = []; _drLCnt = []
        if visW <= 0 { visW = 1.0 }
        for _lines.len() to li {
            var ln = _lines[li]
            _drLStart.add(_drLi.len())
            if not _wordWrap {
                _drLi.add(li); _drC0.add(0); _drC1.add(ln.len())
                _drLCnt.add(1)
            } else {
                var wl = _wrap_line(ln, visW)
                var col0 = 0
                for wl.len() to wi {
                    var seg = wl[wi] as string
                    var segLen = seg.len()
                    _drLi.add(li); _drC0.add(col0); _drC1.add(col0 + segLen)
                    col0 = col0 + segLen
                }
                if wl.len() == 0 { _drLi.add(li); _drC0.add(0); _drC1.add(0) }
                _drLCnt.add(wl.len())
            }
        }
        _drCount = _drLi.len()
        return _drCount
    }

    // 给定逻辑行列，返回其所在的显示行索引
    func _disp_row_of(int li, int col): int {
        var best = -1
        for _drCount to di {
            if _drLi[di] == li {
                if col >= _drC0[di] and col <= _drC1[di] { return di }
                best = di
            }
        }
        if best >= 0 { return best }
        return 0
    }

    func dispose() {
        if _font != null { _font.close(); _font = null }
    }
}

// 工厂
export func createEdit(Dict opts): Edit {
    Edit ed = new Edit(); ed.set(opts); return ed
}
