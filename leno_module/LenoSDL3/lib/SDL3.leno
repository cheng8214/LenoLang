// LenoSDL3 — SDL3 绑定入口（用户只需导入此模块）
import "sdl_core.leno" as core
import "sdl_window.leno" as wnd
import "sdl_renderer.leno" as r
import "sdl_font.leno" as fnt
import "sdl_event.leno" as evt

// ==================== 重新导出类型 ====================
// 用户可通过 use SDL3.xxx 导入
// 注：必须导出至少一个返回该类型的函数，模块符号表才能识别

use core.SDL_FRect
use core.SDL_Rect
use core.SDL_FPoint
use core.SDL_Point
use core.SDL_Color

use evt.Event
use r.Renderer
use wnd.Window
use fnt.Font
use fnt.TextTexture


// ==================== 重新导出常量 ====================
// INIT 标志
export var INIT_VIDEO  = core.INIT_VIDEO
export var INIT_AUDIO  = core.INIT_AUDIO
export var INIT_EVENTS = core.INIT_EVENTS

// 窗口标志
export var WINDOW_FULLSCREEN        = core.WINDOW_FULLSCREEN
export var WINDOW_OPENGL            = core.WINDOW_OPENGL
export var WINDOW_HIDDEN            = core.WINDOW_HIDDEN
export var WINDOW_BORDERLESS        = core.WINDOW_BORDERLESS
export var WINDOW_RESIZABLE         = core.WINDOW_RESIZABLE
