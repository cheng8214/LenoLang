export var BLENDMODE_MUL   = 0x00000008

// ============================================================================
// DLL 加载
// ============================================================================

sdl3 g_lib = null

func lib(): sdl3 {
    if g_lib == null {
        // DLL 在 lib/ 目录（与 SDL3.leno 同目录）
        var path = dirs.script_dir() + "/SDL3.dll"
        if not files.exists(path) {
            path = "SDL3.dll"  // 系统PATH搜索
        }
        g_lib = ffi.load(path)
        if g_lib == null {
            print("[LenoSDL3] 无法加载 SDL3.dll: " + path)
        }
    }
    return g_lib
}

// ============================================================================
// 初始化 / 退出
// ============================================================================

export func init(int flags): bool {
    sdl3 l = lib()
    if l == null { return false }
    return l.SDL_Init(flags) != 0
}

export func initVideo(): bool { return init(INIT_VIDEO) }

export func quit() {
    if g_lib != null {
        ffi.free(g_lib)
        g_lib = null
    }
}

export func getError(): string {
    sdl3 l = lib()
    if l == null { return "SDL3 not loaded" }
    return l.SDL_GetError() as string
}

export func delay(int ms) { lib().SDL_Delay(ms) }
export func getTicks(): int { return lib().SDL_GetTicks() as int }

// ============================================================================
// Renderer — 渲染器封装
// ============================================================================

export struct Renderer {
    Ptr handle; bool ok

    func initDefault(Ptr window): bool {
        handle = lib().SDL_CreateRenderer(window, null as string)
        ok = handle != null
        if not ok { print("[LenoSDL3] 创建渲染器失败: " + getError()) }
        return ok
    }

    func destroy() {
        if ok { lib().SDL_DestroyRenderer(handle); handle = null; ok = false }
    }

    func clear(): bool  { return lib().SDL_RenderClear(handle) != 0 }
    func present(): bool { return lib().SDL_RenderPresent(handle) != 0 }

    func setColor(int r, int g, int b, int a): bool {
        return lib().SDL_SetRenderDrawColor(handle, r, g, b, a) != 0
    }

    func setColorFloat(float r, float g, float b, float a): bool {
        return lib().SDL_SetRenderDrawColorFloat(handle, r, g, b, a) != 0
    }

    func fillRect(float x, float y, float w, float h): bool {
        var rect = SDL_FRect.malloc()
        rect.x = x; rect.y = y; rect.w = w; rect.h = h
        var result = lib().SDL_RenderFillRect(handle, rect.to_ptr()) != 0
        rect.free()
        return result
    }

    func fillRectPtr(Ptr rect): bool {
        return lib().SDL_RenderFillRect(handle, rect) != 0
    }

    func fillFull(): bool {
        return lib().SDL_RenderFillRect(handle, null) != 0
    }

    func drawRect(float x, float y, float w, float h): bool {
        var rect = SDL_FRect.malloc()
        rect.x = x; rect.y = y; rect.w = w; rect.h = h
        var result = lib().SDL_RenderRect(handle, rect) != 0
        rect.free()
        return result
    }

    func drawLine(float x1, float y1, float x2, float y2): bool {
        return lib().SDL_RenderLine(handle, x1, y1, x2, y2) != 0
    }

    func drawPoint(float x, float y): bool {
        return lib().SDL_RenderPoint(handle, x, y) != 0
    }

    func setVSync(int mode): bool {
        return lib().SDL_SetRenderVSync(handle, mode) != 0
    }

    // 画圆（轮廓）— 用 SDL_RenderLines + maths 近似
    func drawCircle(float cx, float cy, float radius): bool {
        var segs = 64                     // 线段数
        var pts  = segs + 1               // 点数（首尾相接需要 +1）
        var buf  = ffi.malloc(pts * 8)    // 每个点 2 个 f32
        if buf == null { return false }
        var two_pi = 6.283185307
        for 0 : segs to i {
            var a = two_pi * _float(i) / _float(segs)
            ffi.write_float(buf, i * 8,     cx + radius * maths.cos(a))
            ffi.write_float(buf, i * 8 + 4, cy + radius * maths.sin(a))
        }
        var ok = lib().SDL_RenderLines(handle, buf, pts) != 0
        ffi.free(buf)
        return ok
    }

    // 画圆（填充）— 水平扫描线
    func fillCircle(float cx, float cy, float radius): bool {
        var ok = true
        var r  = _int(radius)
        for 0 : r * 2 to i {
            var dy = i - r
            var half = maths.sqrt(radius * radius - _float(dy * dy))
            if not drawLine(cx - half, cy + _float(dy), cx + half, cy + _float(dy)) {
                ok = false
            }
        }
        return ok
    }

    // 画多条线（pts 是 SDL_FPoint 数组指针, count 为点数）
    func drawLines(Ptr pts, int count): bool {
        return lib().SDL_RenderLines(handle, pts, count) != 0
    }

    // 画多个点
    func drawPoints(Ptr pts, int count): bool {
        return lib().SDL_RenderPoints(handle, pts, count) != 0
    }

    // 画多个矩形轮廓
    func drawRects(Ptr rects, int count): bool {
        return lib().SDL_RenderRects(handle, rects, count) != 0
    }

    // 填充多个矩形
    func fillRects(Ptr rects, int count): bool {
        return lib().SDL_RenderFillRects(handle, rects, count) != 0
    }

    // 设置渲染缩放
    func setScale(float scaleX, float scaleY): bool {
        return lib().SDL_SetRenderScale(handle, scaleX, scaleY) != 0
    }

    // 设置混合模式
    func setBlendMode(int mode): bool {
        return lib().SDL_SetRenderDrawBlendMode(handle, mode) != 0
    }

    // 设置裁剪矩形；传 null 清除裁剪
    func setClipRect(Ptr rect): bool {
        return lib().SDL_SetRenderClipRect(handle, rect) != 0
    }

    func clearClip(): bool {
        return lib().SDL_SetRenderClipRect(handle, null) != 0
    }

    // 设置逻辑分辨率
    func setLogicalSize(int w, int h): bool {
        return lib().SDL_SetRenderLogicalSize(handle, w, h) != 0
    }

    // 设置视口
    func setViewport(Ptr rect): bool {
        return lib().SDL_SetRenderViewport(handle, rect) != 0
    }

    func resetViewport(): bool {
        return lib().SDL_SetRenderViewport(handle, null) != 0
    }
}

// ============================================================================
// Event — 事件封装
// ============================================================================

export struct Event {
    Ptr raw; bool has

    func init(): bool {
        raw = ffi.malloc(128)  // SDL_Event = 128 bytes
        has = false
        return true
    }

    func poll(): bool {
        has = lib().SDL_PollEvent(raw) != 0
        return has
    }

    func type(): int { return ffi.read_int(raw, 0) }

    func isQuit(): bool           { return type() == EVENT_QUIT }
    func isKeyDown(): bool        { return type() == EVENT_KEY_DOWN }
    func isKeyUp(): bool          { return type() == EVENT_KEY_UP }
    func isWindowClose(): bool    { return type() == EVENT_WINDOW_CLOSE_REQUESTED }
    func isWindowResized(): bool  { return type() == EVENT_WINDOW_RESIZED }
    func isMouseMotion(): bool    { return type() == EVENT_MOUSE_MOTION }
    func isMouseButtonDown(): bool { return type() == EVENT_MOUSE_BUTTON_DOWN }
    func isMouseButtonUp(): bool  { return type() == EVENT_MOUSE_BUTTON_UP }

    func scancode(): int { return ffi.read_int(raw, 24) }

    // 鼠标事件 — 坐标偏移参考 SDL_MouseMotionEvent / SDL_MouseButtonEvent
    func mouseX(): float     { return ffi.read_float(raw, 28) }
    func mouseY(): float     { return ffi.read_float(raw, 32) }
    func mouseDX(): float    { return ffi.read_float(raw, 36) } // 鼠标相对移动 x (仅 motion 有效)
    func mouseDY(): float    { return ffi.read_float(raw, 40) } // 鼠标相对移动 y (仅 motion 有效)
    func mouseButton(): int  { return ffi.read_int(raw, 24) }  // 按钮 (1=左,2=中,3=右)

    // 窗口事件
    func windowID(): int { return ffi.read_int(raw, 16) }

    func uninit() {
        if raw != null { ffi.free(raw); raw = null; has = false }
    }
}

// ============================================================================
// Window — 窗口封装（自动 initVideo/quit）
// ============================================================================

export struct Window {
    Ptr handle; bool ok

    func init(string title, int w, int h, int flags): bool {
        if not initVideo() {
            print("[LenoSDL3] SDL3 初始化失败: " + getError())
            return false
        }
        handle = lib().SDL_CreateWindow(title, w, h, flags)
        ok = handle != null
        if not ok { print("[LenoSDL3] 创建窗口失败: " + getError()) }
        return ok
    }

    func destroy() {
        if ok { lib().SDL_DestroyWindow(handle); handle = null; ok = false }
        quit()
    }

    // win.run(func(Event e):bool {}, func(Renderer r) {})
    func run(var onEvent, var onRender) {
        var ren = new Renderer()
        if not ren.initDefault(handle) { destroy(); return }
        ren.setVSync(1)

        var ev = new Event()
        ev.init()

        var running = true
        while running {
            while ev.poll() {
                if ev.isQuit() or ev.isWindowClose() { running = false }
                else if not onEvent(ev) { running = false }
            }
            onRender(ren)
            ren.present()
        }

        ev.uninit()
        ren.destroy()
        destroy()
    }
}

// ============================================================================
// 工厂函数
// ============================================================================

export func createWindow(string title, int w, int h, int flags): Window {
    var win = new Window(); win.init(title, w, h, flags); return win
}

export func createRenderer(Ptr window): Renderer {
    var ren = new Renderer(); ren.initDefault(window); return ren
}

export func createEvent(): Event {
    var ev = new Event(); ev.init(); return ev
}

// cstruct 大小
export var SDL_FRect_SIZE  = 16   // 4 * f32
export var SDL_Rect_SIZE   = 16   // 4 * i32
export var SDL_FPoint_SIZE = 8    // 2 * f32
export var SDL_Point_SIZE  = 8    // 2 * i32
