export var WINDOW_HIGH_PIXEL_DENSITY = core.WINDOW_HIGH_PIXEL_DENSITY
export var WINDOW_TRANSPARENT       = core.WINDOW_TRANSPARENT

// 事件
export var EVENT_QUIT                   = core.EVENT_QUIT
export var EVENT_KEY_DOWN               = core.EVENT_KEY_DOWN
export var EVENT_KEY_UP                 = core.EVENT_KEY_UP
export var EVENT_MOUSE_MOTION           = core.EVENT_MOUSE_MOTION
