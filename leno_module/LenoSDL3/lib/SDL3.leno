// LenoSDL3 — SDL3 绑定入口（用户只需导入此模块）
import "sdl_core.leno" as core
import "sdl_window.leno" as wnd
import "sdl_renderer.leno" as r
import "sdl_font.leno" as fnt
import "sdl_event.leno" as evt
import "sdl_timer.leno" as tm
import "sdl_image.leno" as img
import "sdl_button.leno" as btn
import "sdl_label.leno" as lbl
import "sdl_edit.leno" as edt
import "sdl_checkbox.leno" as chk
import "sdl_radio.leno" as rb
import "sdl_toggle.leno" as tgl
import "sdl_slider.leno" as sld
import "sdl_progress.leno" as prg
import "sdl_listbox.leno" as lb
import "sdl_combobox.leno" as cbb
import "sdl_panel.leno" as pnl
import "sdl_tab.leno" as tab
import "sdl_layout.leno" as lay
import "sdl_menu.leno" as menu
import "sdl_tooltip.leno" as tip
import "sdl_scrollview.leno" as scv
import "sdl_widget.leno" as wgt


// ==================== 重新导出类型 ====================
// 用户可通过 use SDL3.xxx 导入
// 注：必须导出至少一个返回该类型的函数，模块符号表才能识别

use core.SDL_FRect
use core.SDL_Rect
use core.SDL_FPoint
use core.SDL_Point
use core.SDL_Color
use core.SDL_FColor
use core.SDL_GlyphMetrics
use core.SDL_Vertex

use core.SDL_KeyboardEvent
use core.SDL_MouseButtonEvent
use core.SDL_MouseMotionEvent
use core.SDL_MouseWheelEvent
use core.SDL_TextInputEvent
use core.SDL_WindowEvent
use core.SDL_DropEvent

use evt.Event
use r.Renderer
use wnd.Window
use fnt.Font
use fnt.TextTexture
use tm.Timer
use tm.TimerCallback
use btn.Button
use lbl.Label
use edt.Edit
use chk.CheckBox
use rb.RadioButton
use tgl.Toggle
use sld.Slider
use prg.ProgressBar
use lb.ListBox
use cbb.ComboBox
use pnl.Panel
use tab.TabControl
use menu.MenuBar
use scv.ScrollView
use lay.HBox
use lay.VBox
use lay.AnchorBox
use wgt.Widget
use wnd.EventHandler
export func createCheckBox(Dict opts): CheckBox     { return chk.createCheckBox(opts) }
export func createButton(Dict opts): Button          { return btn.createButton(opts) }
export func createLabel(Dict opts): Label            { return lbl.createLabel(opts) }
export func createEdit(Dict opts): Edit              { return edt.createEdit(opts) }
export func createRadioButton(Dict opts): RadioButton { return rb.createRadioButton(opts) }
export func createToggle(Dict opts): Toggle          { return tgl.createToggle(opts) }
export func createSlider(Dict opts): Slider          { return sld.createSlider(opts) }
export func createProgressBar(Dict opts): ProgressBar { return prg.createProgressBar(opts) }
export func createListBox(Dict opts): ListBox     { return lb.createListBox(opts) }
export func createComboBox(Dict opts): ComboBox  { return cbb.createComboBox(opts) }
export func createPanel(Dict opts): Panel        { return pnl.createPanel(opts) }
export func createTabControl(Dict opts): TabControl { return tab.createTabControl(opts) }
export func createMenuBar(Dict opts): MenuBar      { return menu.createMenuBar(opts) }
export func createScrollView(Dict opts): ScrollView { return scv.createScrollView(opts) }
export func setTipDelay(int ms)                     { tip.setTipDelay(ms) }
export func createHBox(Dict opts): HBox          { return lay.createHBox(opts) }
export func createVBox(Dict opts): VBox          { return lay.createVBox(opts) }
export func createAnchorBox(Dict opts): AnchorBox { return lay.createAnchorBox(opts) }
use wnd.RenderCallback
import "sdl_dialog.leno" as dlg
export func createDialogWindow(Dict style): Window { return dlg.createDialogWindow(style) }
export func runModal(Window win, var onEvent, var onRender) { dlg.runModal(win, onEvent, onRender) }


// ==================== 重新导出类型别名 ====================

use core.Color
use core.FColor
use core.Size
use core.FSize
use core.StringSize
use core.GlyphInfo

// ==================== 重新导出枚举 ====================
use core.InitFlag
use core.WindowFlag
use core.EventType
use core.Scancode
use core.MouseButton
use core.BlendMode
use core.Flip
use core.SystemCursor
use core.TextureAccess
use core.FlashOp

export var PIXELFORMAT_RGBA8888 = core.PIXELFORMAT_RGBA8888
export var SDL_FRect_SIZE  = core.SDL_FRect_SIZE
export var SDL_Rect_SIZE   = core.SDL_Rect_SIZE
export var SDL_FPoint_SIZE = core.SDL_FPoint_SIZE
export var SDL_Point_SIZE  = core.SDL_Point_SIZE
export var SDL_Color_SIZE  = core.SDL_Color_SIZE

// ==================== 重新导出核心函数 ====================

export func init(int flags): bool   { return core.init(flags) }
export func initVideo(): bool        { return core.initVideo() }
export func quit()                   { core.quit(); fnt.ttfQuit() }
export func getError(): string       { return core.getError() }
export func delay(int ms)            { core.delay(ms) }
export func getTicks(): int          { return core.getTicks() }

export func startTextInput(Ptr[u8] w): bool  { return core.startTextInput(w) }
export func stopTextInput(Ptr[u8] w): bool   { return core.stopTextInput(w) }
export func setTextInputArea(Ptr[u8] w, Ptr rect, int cursor): bool {
    return core.setTextInputArea(w, rect, cursor)
}

export func getMouseState(): int         { return core.getMouseState() }
export func getGlobalMouseState(): int   { return core.getGlobalMouseState() }
export func showCursor(): bool           { return core.showCursor() }
export func hideCursor(): bool           { return core.hideCursor() }
export func cursorVisible(): bool        { return core.cursorVisible() }
export func warpMouse(Ptr[u8] w, float x, float y): bool { return core.warpMouse(w, x, y) }

export func setSystemCursor(int kind): Ptr[u8] { return core.setSystemCursor(kind) as Ptr[u8] }
export func showMessageBox(string title, string msg, int flags) { core.showMessageBox(title, msg, flags) }



export func getClipboardText(): string   { return core.getClipboardText() }
export func setClipboardText(string t): bool { return core.setClipboardText(t) }

export func getPerfCounter(): int    { return core.getPerfCounter() }
export func getPerfFrequency(): int  { return core.getPerfFrequency() }
export func getTicksNS(): int        { return core.getTicksNS() }
export func hasClipboardText(): bool { return core.hasClipboardText() }



// ==================== 重新导出工厂函数 ====================

export func createWindow(Dict opts): Window    { return wnd.createWindow(opts) }
export func setModalWid(int w)                 { wnd.setModalWid(w) }
export func getModalWid(): int                 { return wnd.getModalWid() }
export func createRenderer(Ptr[u8] w): Renderer     { return r.createRenderer(w) }
export func createEvent(): Event                { return evt.createEvent() }
export func createFont(string p, float s): Font { return fnt.createFont(p, s) }
export func createFontAuto(float s): Font    { return fnt.createFontAuto(s) }
export func packColor(int r, int g, int b): int { return fnt.packColor(r, g, b) }
use fnt.SDL_SurfaceInfo

export func createTextTexture(Ptr[u8] ren, Font f, string t, int r, int g, int b): TextTexture {
    return fnt.createTextTexture(ren, f, t, r, g, b)
}

export func createTextTextureWrapped(Ptr[u8] ren, Font f, string t, int r, int g, int b, int wrapW): TextTexture {
    return fnt.createTextTextureWrapped(ren, f, t, r, g, b, wrapW)
}

export func createGlyphTexture(Ptr[u8] ren, Font f, int glyph, int r, int g, int b): TextTexture {
    return fnt.createGlyphTexture(ren, f, glyph, r, g, b)
}

export func createTextTextureSolid(Ptr[u8] ren, Font f, string t, int r, int g, int b): TextTexture {
    return fnt.createTextTextureSolid(ren, f, t, r, g, b)
}

export func createTextTextureShaded(Ptr[u8] ren, Font f, string t, int fr, int fg, int fb, int br, int bg, int bb): TextTexture {
    return fnt.createTextTextureShaded(ren, f, t, fr, fg, fb, br, bg, bb)
}

// ==================== TTF ====================

export func ttfInit(): bool  { return fnt.ttfInit() }
export func ttfQuit()        { fnt.ttfQuit() }

export var STYLE_NORMAL        = fnt.STYLE_NORMAL
export var STYLE_BOLD          = fnt.STYLE_BOLD
export var STYLE_ITALIC        = fnt.STYLE_ITALIC
export var STYLE_UNDERLINE     = fnt.STYLE_UNDERLINE
export var STYLE_STRIKETHROUGH = fnt.STYLE_STRIKETHROUGH

export var HINTING_NORMAL = fnt.HINTING_NORMAL
export var HINTING_LIGHT  = fnt.HINTING_LIGHT
export var HINTING_MONO   = fnt.HINTING_MONO
export var HINTING_NONE   = fnt.HINTING_NONE

export var WRAP_ALIGN_LEFT   = fnt.WRAP_ALIGN_LEFT
export var WRAP_ALIGN_CENTER = fnt.WRAP_ALIGN_CENTER
export var WRAP_ALIGN_RIGHT  = fnt.WRAP_ALIGN_RIGHT

// ==================== Image ====================

export func loadImage(string path): Ptr[u8]                  { return img.load(path) as Ptr[u8] }
export func loadImageTexture(Ptr[u8] ren, string path): Ptr[u8]  { return img.loadTexture(ren, path) as Ptr[u8] }
export func saveImagePNG(Ptr[u8] surface, string path): bool           { return img.savePNG(surface, path) }
export func saveImageJPG(Ptr[u8] surface, string path, int q): bool    { return img.saveJPG(surface, path, q) }
export func saveImageBMP(Ptr[u8] surface, string path): bool           { return img.saveBMP(surface, path) }
export func saveImageWEBP(Ptr[u8] surface, string path, float q): bool { return img.saveWEBP(surface, path, q) }
export func imageVersion(): int { return img.version() }
