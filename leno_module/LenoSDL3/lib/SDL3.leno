// LenoSDL3 — SDL3 绑定入口（用户只需导入此模块）
import "sdl_core.leno" as core
import "sdl_window.leno" as wnd
import "sdl_renderer.leno" as r
import "sdl_font.leno" as fnt
import "sdl_event.leno" as evt

// ==================== 重新导出类型 ====================
// 用户可通过 use SDL3.xxx 导入
// 注：必须导出至少一个返回该类型的函数，模块符号表才能识别

use core.SDL_FRect
use core.SDL_Rect
use core.SDL_FPoint
use core.SDL_Point
use core.SDL_Color

use evt.Event
use r.Renderer
use wnd.Window
use fnt.Font
use fnt.TextTexture

// 导出工厂函数（提供返回类型给模块符号表）
export func newRenderer(Ptr w):   Renderer    { return r.createRenderer(w) }
export func newEvent():           Event       { return evt.createEvent() }
export func newWindow(Dict o):    Window      { return wnd.createWindow(o) }
export func newFont(string p, float s): Font  { return fnt.createFont(p, s) }
export func newTextTexture(Ptr ren, Font f, string t, int r, int g, int b): TextTexture {
    return fnt.createTextTexture(ren, f, t, r, g, b)
}

// ==================== 重新导出常量 ====================
// INIT 标志
export var INIT_VIDEO  = core.INIT_VIDEO
export var INIT_AUDIO  = core.INIT_AUDIO
export var INIT_EVENTS = core.INIT_EVENTS

// 窗口标志
export var WINDOW_FULLSCREEN        = core.WINDOW_FULLSCREEN
export var WINDOW_OPENGL            = core.WINDOW_OPENGL
export var WINDOW_HIDDEN            = core.WINDOW_HIDDEN
export var WINDOW_BORDERLESS        = core.WINDOW_BORDERLESS
export var WINDOW_RESIZABLE         = core.WINDOW_RESIZABLE
export var WINDOW_MINIMIZED         = core.WINDOW_MINIMIZED
export var WINDOW_MAXIMIZED         = core.WINDOW_MAXIMIZED
export var WINDOW_MOUSE_GRABBED     = core.WINDOW_MOUSE_GRABBED
export var WINDOW_ALWAYS_ON_TOP     = core.WINDOW_ALWAYS_ON_TOP
export var WINDOW_HIGH_PIXEL_DENSITY = core.WINDOW_HIGH_PIXEL_DENSITY
export var WINDOW_TRANSPARENT       = core.WINDOW_TRANSPARENT

// 事件
export var EVENT_QUIT                   = core.EVENT_QUIT
export var EVENT_KEY_DOWN               = core.EVENT_KEY_DOWN
export var EVENT_KEY_UP                 = core.EVENT_KEY_UP
export var EVENT_MOUSE_MOTION           = core.EVENT_MOUSE_MOTION
export var EVENT_MOUSE_BUTTON_DOWN      = core.EVENT_MOUSE_BUTTON_DOWN
export var EVENT_MOUSE_BUTTON_UP        = core.EVENT_MOUSE_BUTTON_UP
export var EVENT_WINDOW_CLOSE_REQUESTED = core.EVENT_WINDOW_CLOSE_REQUESTED

// 扫描码
export var SCANCODE_ESCAPE = core.SCANCODE_ESCAPE
export var SCANCODE_RETURN = core.SCANCODE_RETURN
export var SCANCODE_SPACE  = core.SCANCODE_SPACE

// 鼠标
export var MOUSE_LEFT   = core.MOUSE_LEFT
export var MOUSE_MIDDLE = core.MOUSE_MIDDLE
export var MOUSE_RIGHT  = core.MOUSE_RIGHT

// 混合模式
export var BLENDMODE_NONE  = core.BLENDMODE_NONE
export var BLENDMODE_BLEND = core.BLENDMODE_BLEND

// ==================== 重新导出核心函数 ====================

export func init(int flags): bool   { return core.init(flags) }
export func initVideo(): bool        { return core.initVideo() }
export func quit()                   { core.quit(); fnt.ttfQuit() }
export func getError(): string       { return core.getError() }
export func delay(int ms)            { core.delay(ms) }
export func getTicks(): int          { return core.getTicks() }

// ==================== 重新导出工厂函数 ====================

export func createWindow(Dict opts): Window    { return wnd.createWindow(opts) }
export func createRenderer(Ptr w): Renderer     { return r.createRenderer(w) }
export func createEvent(): Event                { return evt.createEvent() }
export func createFont(string p, float s): Font { return fnt.createFont(p, s) }
export func createTextTexture(Ptr ren, Font f, string t, int r, int g, int b): TextTexture {
    return fnt.createTextTexture(ren, f, t, r, g, b)
}

// ==================== TTF ====================

export func ttfInit(): bool  { return fnt.ttfInit() }
export func ttfQuit()        { fnt.ttfQuit() }
