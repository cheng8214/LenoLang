// LenoSDL3 - SDL3 绑定（clib + cstruct 直接调用 SDL3.dll）
import ffi
import strings
import files
import dirs
import maths

// ============================================================================
// cstruct — SDL3 核心数据结构
// ============================================================================

// 矩形（浮点坐标）
export cstruct SDL_FRect {
    f32 x
    f32 y
    f32 w
    f32 h
}

// 矩形（整数坐标）
export cstruct SDL_Rect {
    i32 x
    i32 y
    i32 w
    i32 h
}

// 浮点坐标点
export cstruct SDL_FPoint {
    f32 x
    f32 y
}

// 整数坐标点
export cstruct SDL_Point {
    i32 x
    i32 y
}

// SDL_Event 联合体（只定义公共头部，事件数据通过偏移读取）
cstruct SDL_Event {
    u32 type
    u32 _reserved
    u64 _timestamp
    u32 _window_id
    u8  _data[108]
}

// ============================================================================
// clib — SDL3.dll 导出函数
// ============================================================================

clib sdl3 {
    // 初始化 / 退出
    i32 SDL_Init(u32 flags)
    void SDL_Quit()
    str8 SDL_GetError()

    // 窗口
    Ptr SDL_CreateWindow(str8 title, i32 w, i32 h, u64 flags)
    void SDL_DestroyWindow(Ptr window)

    // 渲染器
    Ptr SDL_CreateRenderer(Ptr window, str8 name)
    void SDL_DestroyRenderer(Ptr renderer)
    i32 SDL_RenderClear(Ptr renderer)
    i32 SDL_RenderPresent(Ptr renderer)
    i32 SDL_SetRenderDrawColor(Ptr renderer, u8 r, u8 g, u8 b, u8 a)
    i32 SDL_SetRenderDrawColorFloat(Ptr renderer, f32 r, f32 g, f32 b, f32 a)
    i32 SDL_RenderFillRect(Ptr renderer, Ptr rect)
    i32 SDL_RenderRect(Ptr renderer, Ptr rect)
    i32 SDL_RenderLine(Ptr renderer, f32 x1, f32 y1, f32 x2, f32 y2)
    i32 SDL_RenderPoint(Ptr renderer, f32 x, f32 y)
    i32 SDL_SetRenderVSync(Ptr renderer, i32 vsync)

    // 绘图 — 批量
    i32 SDL_RenderLines(Ptr renderer, Ptr points, i32 count)
    i32 SDL_RenderPoints(Ptr renderer, Ptr points, i32 count)
    i32 SDL_RenderRects(Ptr renderer, Ptr rects, i32 count)
    i32 SDL_RenderFillRects(Ptr renderer, Ptr rects, i32 count)

    // 渲染状态
    i32 SDL_SetRenderScale(Ptr renderer, f32 scaleX, f32 scaleY)
    i32 SDL_SetRenderDrawBlendMode(Ptr renderer, i32 blendMode)
    i32 SDL_SetRenderClipRect(Ptr renderer, Ptr rect)
    i32 SDL_SetRenderLogicalSize(Ptr renderer, i32 w, i32 h)

    // 视口
    i32 SDL_SetRenderViewport(Ptr renderer, Ptr rect)

    // 获取绘制颜色
    i32 SDL_GetRenderDrawColor(Ptr renderer, Ptr r, Ptr g, Ptr b, Ptr a)
    i32 SDL_GetRenderDrawColorFloat(Ptr renderer, Ptr r, Ptr g, Ptr b, Ptr a)

    // 键盘状态
    Ptr SDL_GetKeyboardState(Ptr numkeys)

    // 事件
    i32 SDL_PollEvent(SDL_Event event)

    // 延时
    void SDL_Delay(u32 ms)

    // 计时
    u64 SDL_GetTicks()

    // 窗口大小（int 输出参数用 Ptr）
    i32 SDL_GetWindowSize(Ptr window, Ptr w, Ptr h)
}

// ============================================================================
// 常量 — 用 var 定义
// ============================================================================

