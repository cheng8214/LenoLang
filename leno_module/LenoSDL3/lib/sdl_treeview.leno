// sdl_treeview.leno — 树视图控件（层级节点、展开/折叠、单选/多选、可选复选框、右键节点菜单）
// 通过 win.addTreeView({...}) 创建。
//   items: Array[Dict]，每个节点 {text, children:[...], expanded, checked, checkable,
//                                has_children(懒加载标记), data, id(可选)}
//   on_change(func(Array[int]))  : 选择变化时回调，收到选中节点 id 数组
//   on_context(func(int,float,float)) : 右键节点回调（节点 id, 鼠标 x, y）
//   on_toggle(func(int,bool))    : 节点展开/折叠时回调（节点 id, 是否展开）
//   on_check(func(int,bool))     : 节点勾选状态变化时回调（节点 id, 是否勾选）
//   右键菜单：opts.context_menu = true 启用内置 MenuBar，之后用
//             tv.get_context_menu().addContextItem(tv.get_context_handle(), {...}) 添加项，
//             tv.get_context_menu().on_select(func(s,id){...}) 处理选择。
//
// 数据模型：嵌套 Array[TreeViewNode] 树（_roots）为唯一数据源；节点字段（含 image）即唯一真相。
// 渲染/命中用的拍平视图（_flatIds/_flatText/...）只是一层"渲染缓存"——基础类型按下标访问安全、
// 且可避免每帧重建数组（鼠标移动高频重绘抖动的主因）。
// ★ Leno 结构体语义已验证（见 lang_struct_semantics_test.leno）：
//   赋值/传参/返回/数组下标读取全部为引用传递（不拷贝），
//   list[i].children / list[i].image 等变量下标访问可靠，
//   循环变量下标读取同样可靠。.copy() 方法做显式深拷贝。
import maths
import "sdl_renderer.leno" as ren; use ren.Renderer
import "sdl_font.leno" as fnt; use fnt.Font
import "sdl_event.leno" as evt; use evt.Event
import "sdl_core.leno" as core; use core.SystemCursor; use core.SDL_Rect
import "sdl_widget.leno" as wgt; use wgt.Widget
import "sdl_tooltip.leno" as tip
import "sdl_theme.leno" as theme; use theme.(Theme, Themeable)
use theme.Color
import "sdl_menu.leno" as menu; use menu.MenuBar
import "sdl_image.leno" as img

// 节点结构：children 递归构成树；_parent/_depth 为拍平遍历与连接线提供便利
export struct TreeViewNode {
    int id = -1
    string text = ""
    string image = ""    // 节点图标路径（空 = 无图）；作为唯一数据源
string imageExpanded = ""  // 展开状态图标（空 = 用 image）
    int imageMode = -1   // 图标内容模式：-1=用全局 _imgMode；0=aspectFit 1=stretch 2=aspectFill
    Array[TreeViewNode] children = []
    bool expanded = false
    bool hasChildren = false
    bool checkable = false
    bool checked = false
    Dict data = {}
    int _depth = 0
    int _parent = -1
}

export struct TreeView impl Widget, Themeable {
    float x = 0.0, y = 0.0, w = 200.0, h = 200.0
    int _nextId = 1
    // ===== 规范状态：嵌套树（唯一数据源）=====
    Array[TreeViewNode] _roots = []
    // ===== 当前可见行的拍平视图（基础类型并行数组，渲染/命中复用）=====
    // 这层是"渲染缓存"而非数据来源：基础类型按下标访问安全、且可只在结构变更时重建，
    // 避免每帧重建数组导致高频重绘抖动/闪烁。源数据始终存于 _roots 树（节点 image 等字段）。
    Array[int] _flatIds = []
    Array[string] _flatText = []
    Array[int] _flatParent = []     // 每行直接父节点 id（-1=根）
    Array[int] _flatDepth = []
    Array[bool] _flatHas = []
    Array[bool] _flatCheck = []
    Array[bool] _flatOn = []
    Array[bool] _flatExpanded = []
    Array[string] _flatImage = []      // 每行图片路径（渲染缓存，源在节点 image 字段）
    Array[int] _flatImgMode = []       // 每行图片内容模式（节点 imageMode，<0 时回退全局 _imgMode）
    Array[bool] _flatSel = []          // 每行是否选中（拍平时从 _sel/_sel2 生成，render 中 O(1) 读取）
    bool _flatDirty = true      // 拍平视图是否过期：结构/选中变更后置位，render 时按需重建，避免每帧重建数组

    // 节点图标（image）绘制参数
    float _imgSize = 0.0      // 图标边长（0 = 自动：取 _rowH - 8）
    float _imgGap = 4.0       // 图标与文字间距
    int   _imgMode = 0        // 内容模式：0=aspectFit(保持比例) 1=stretch(拉伸) 2=aspectFill(覆盖裁剪)
    // 纹理缓存（path -> tex 平行数组）：跨拍平重建持久存在，避免每帧重载与纹理泄漏
    Array[string] _imgCachePaths = []
    Array[Ptr[u8]] _imgCacheTex = []
    // ★ MRU 快路径：连续多行常共用同一图标（如全部是文件夹），单槽快路径将 O(n) 线性扫描降为 O(1)
    string _imgLastPath = ""
    Ptr[u8] _imgLastTex = null
    float _textH = 16.0         // 缓存字体行高，避免渲染时每行重复 measureString

    float _rowH = 24.0
    float _indent = 16.0
    float _padX = 6.0
    float _scroll = 0.0
    int _hover = -1
    int _sel = -1
    Array[int] _sel2 = []
    int _mode = 0
    bool _showCheck = false
    float _fontSize = 15.0; string _fontPath = ""; int _fontStyle = 0; Font? _font
    Color _bgColor = #262830FF
    Color _bdrColor = #5A5F6EFF
    Color _selColor = #343A46FF
    Color _chkColor = #46B278FF   // 勾选框填充色（独立于选中色，避免选中行上蓝框融进蓝背景）
    Color _hovColor = #464E5CFF
    Color _txtColor = #EBEBF5FF
    Color _arrColor = #B0B5C0FF
    Color _markColor = #EBEBF5FF   // 勾选标记颜色
    Color _sbColor = #787D8CFF
    Color _lineColor = #404654FF   // 连接线颜色
    bool _showLines = true                              // 是否显示层级连接线
    int _cursor = SystemCursor.POINTER
    bool enabled = true, visible = true, _loaded = false
    string _tip = ""
    bool _draggingScroll = false; float _sbDragOffset = 0.0
    // 右键上下文菜单
    bool _ctxMenuEnabled = false
    MenuBar? _ctxMenu
    int _ctxHandle = -1
    Ptr[u8]? _hwnd           // 所属窗口句柄（供内嵌右击菜单按窗口隔离绘制）
    int _winW = 0, _winH = 0
    func(Array[int]):void _onChange
    func(int, float, float):void _onContext
    func(int, bool):void _onToggle
    func(int, bool):void _onCheck

    func _ensure_font() {
        if _font == null or not _font.ok {
            if _font != null and _font.ok { fnt.releaseFont(_font) }
            if _fontPath != "" { _font = fnt.acquireFont(_fontPath, _fontSize) }
            else { _font = fnt.acquireFontAuto(_fontSize) }
            if _font != null and _font.ok {
                if _fontStyle != 0 { _font.setStyle(_fontStyle) }
                _textH = _font.measureString("Ag").h   // 字体加载时缓存行高，避免每帧渲染中调用 measureString
            }
        }
    }

    // ==================== 规范状态构建（嵌套树）====================
    func _build_node(Dict d, int parentId, int depth): TreeViewNode {
        TreeViewNode n = new TreeViewNode()
        n.id = _nextId; _nextId = _nextId + 1
        n.text = d.get("text", "")
        n.image = d.get("image", "")
n.imageExpanded = d.get("imageExpanded", "")
        n.imageMode = d.get("imageMode", -1)
        n._parent = parentId
        n._depth = depth
        n.expanded = d.get("expanded", false)
        bool hasCh = false
        var ch = d.get("children", [])
        if ch is Array[Dict] { if ch.len() > 0 { hasCh = true } }
        if d.has("has_children") { hasCh = d.get("has_children", false) or hasCh }
        n.hasChildren = hasCh
        bool chk = false, on = false
        if d.has("checkable") { chk = d.get("checkable", false) }
        if d.has("checked") { chk = true; on = d.get("checked", false) }
        n.checkable = chk
        n.checked = on
        n.data = d.get("data", {})
        if ch is Array[Dict] {
            for ch.len() to k { n.children.add(_build_node(ch[k], n.id, depth + 1)) }
        }
        return n
    }
    func _build_from_dicts(Array[Dict] ds) {
        _roots = []
        _nextId = 1
        for ds.len() to i { _roots.add(_build_node(ds[i], -1, 0)) }
    }

    // 递归复制整棵子列表（创建独立快照，供 _find 等返回只读副本避免外部误改原始树）
    func _snap_children(Array[TreeViewNode] list): Array[TreeViewNode] {
        Array[TreeViewNode] out = []
        for list.len() to i {
            TreeViewNode o = new TreeViewNode()
            o.id = list[i].id; o.text = list[i].text; o.image = list[i].image; o.imageExpanded = list[i].imageExpanded; o.imageMode = list[i].imageMode; o.expanded = list[i].expanded
            o.hasChildren = list[i].hasChildren; o.checkable = list[i].checkable; o.checked = list[i].checked
            o._depth = list[i]._depth; o._parent = list[i]._parent; o.data = list[i].data
            o.children = _snap_children(list[i].children)
            out.add(o)
        }
        return out
    }
    // 按 id 查找节点：返回独立快照（逐字段拷贝，避免外部修改影响原始树；Leno 返回值为引用传递，
    // 此处手动拷贝是设计选择而非语言限制——见 lang_struct_semantics_test.leno 测试 8 验证）
    func _find(int id): TreeViewNode { return _find_r(_roots, id) }
    func _find_r(Array[TreeViewNode] list, int id): TreeViewNode {
        for list.len() to i {
            if list[i].id == id {
                TreeViewNode o = new TreeViewNode()
                o.id = list[i].id; o.text = list[i].text; o.image = list[i].image; o.imageExpanded = list[i].imageExpanded; o.imageMode = list[i].imageMode; o.expanded = list[i].expanded
                o.hasChildren = list[i].hasChildren; o.checkable = list[i].checkable; o.checked = list[i].checked
                o._depth = list[i]._depth; o._parent = list[i]._parent; o.data = list[i].data
                o.children = _snap_children(list[i].children)
                return o
            }
            TreeViewNode c = _find_r(list[i].children, id)
            if c.id >= 0 { return c }
        }
        TreeViewNode empty = new TreeViewNode()
        return empty
    }

    // ==================== 拍平（仅收集已展开节点的可见行）====================
    func _flatten() {
        if not _flatDirty { return }   // 结构未变则跳过，避免每帧重建 8 个数组（鼠标移动高频重绘时抖动/闪烁的主因）
        _flatIds = []; _flatText = []; _flatParent = []; _flatDepth = []
        _flatHas = []; _flatCheck = []; _flatOn = []; _flatExpanded = []; _flatImage = []; _flatImgMode = []; _flatSel = []
        _flatten_r(_roots, -1, 0)
        _flatDirty = false
    }
    func _flatten_r(Array[TreeViewNode] list, int par, int depth) {
        for list.len() to i {
            _flatIds.add(list[i].id)
            _flatText.add(list[i].text)
            _flatImage.add(if list[i].expanded and list[i].imageExpanded != "" then list[i].imageExpanded else list[i].image)
            _flatImgMode.add(list[i].imageMode)
            _flatParent.add(par)
            _flatDepth.add(depth)
            _flatHas.add(list[i].hasChildren)
            _flatCheck.add(list[i].checkable)
            _flatOn.add(list[i].checked)
            _flatExpanded.add(list[i].expanded)
            // ★ 拍平时预计算选中状态，render 中 _is_selected 变为 O(1) 按下标读
            bool seld = false
            if _mode == 0 { seld = (list[i].id == _sel) }
            else { for _sel2.len() to s { if _sel2[s] == list[i].id { seld = true; break } } }
            _flatSel.add(seld)
            if list[i].expanded {
                _flatten_r(list[i].children, list[i].id, depth + 1)
            }
        }
    }

    // 纹理缓存：按 path 取/载纹理，跨拍平重建持久存在，避免每帧重载与纹理泄漏
    // ★ MRU 快路径：文件管理器中连续多行常共用同一图标（如全部是文件夹），
    //   单槽快路径将 O(n) 线性扫描降为 O(1)，消除每行 string 比较开销
    func _get_tex(Renderer r, string path): Ptr[u8] {
        if path == _imgLastPath and _imgLastTex != null { return _imgLastTex }
        for _imgCachePaths.len() to i {
            if _imgCachePaths[i] == path {
                _imgLastPath = path; _imgLastTex = _imgCacheTex[i]
                return _imgCacheTex[i]
            }
        }
        Ptr[u8] t = img.loadTexture(r.handle, path)
        _imgCachePaths.add(path); _imgCacheTex.add(t)
        _imgLastPath = path; _imgLastTex = t
        return t
    }

    func _total_h(): float { return _flatIds.len() * _rowH }
    func _max_scroll(): float {
        float m = _total_h() - h
        if m < 0.0 { m = 0.0 }
        return m
    }
    func _clamp_scroll() {
        float m = _max_scroll()
        if _scroll < 0.0 { _scroll = 0.0 }
        if _scroll > m { _scroll = m }
    }

    // ==================== 布局接口 ====================
    func get_w(): float { return w }
    func get_h(): float { return h }
    func get_x(): float { return x }
    func get_y(): float { return y }
    func set_pos(float px, float py) { x = px; y = py }
    func set_size(float sw, float sh) { w = sw; h = sh }

    // ==================== 滚动条几何 ====================
    func _sb_geom(): Array[float] {
        float maxs = _max_scroll()
        float sw = 8.0
        float sx = x + w - sw - 2.0
        float ty0 = y + 2.0
        float ty1 = y + h - 2.0
        float trk = ty1 - ty0
        float thH = maths.max(20.0, maths.min(h * h / _total_h(), h - 4.0))
        float thy = ty0 + (_scroll / maxs) * (trk - thH)
        return [sx, sw, ty0, ty1, thH, thy, maxs]
    }
    func _in_vscroll(float mx, float my): bool {
        if _max_scroll() <= 0.0 { return false }
        var g = _sb_geom()
        return mx >= g[0] - 2.0 and mx <= g[0] + g[1] + 2.0 and my >= g[2] and my <= g[3]
    }
    func _in_thumb(float mx, float my): bool {
        if _max_scroll() <= 0.0 { return false }
        var g = _sb_geom()
        return mx >= g[0] - 2.0 and mx <= g[0] + g[1] + 2.0 and my >= g[5] and my <= g[5] + g[4]
    }

    // ==================== 命中测试 ====================
    func contains(float mx, float my): bool {
        return mx >= x and mx <= x + w and my >= y and my <= y + h
    }
    func _row_at(float my): int {
        int idx = _int((my - y + _scroll) / _rowH)
        if idx < 0 or idx >= _flatIds.len() { return -1 }
        return idx
    }
    func _id_at(float mx, float my): int {
        if not contains(mx, my) { return -1 }
        int idx = _row_at(my)
        if idx < 0 { return -1 }
        return _flatIds[idx]
    }
    func _in_toggle(int idx, float mx, float my): bool {
        int depth = _flatDepth[idx]
        float cx = x + _padX + depth * _indent
        float rowY = y - _scroll + idx * _rowH
        return mx >= cx and mx <= cx + 16.0 and my >= rowY and my <= rowY + _rowH
    }
    func _in_check(int idx, float mx, float my): bool {
        if not _showCheck { return false }
        if not _flatCheck[idx] { return false }
        int depth = _flatDepth[idx]
        float cx = x + _padX + depth * _indent
        float rowY = y - _scroll + idx * _rowH
        float bx = cx + 18.0
        float by = rowY + (_rowH - 14.0) / 2.0
        return mx >= bx and mx <= bx + 14.0 and my >= by and my <= by + 14.0
    }

    func _is_selected(int id): bool {
        if _mode == 0 { return id == _sel }
        for _sel2.len() to i { if _sel2[i] == id { return true } }
        return false
    }
    // ★ 拍平后按下标读选中状态，render 中调用，避免 _is_selected 线性扫描
    func _is_flat_sel(int idx): bool {
        if idx < 0 or idx >= _flatSel.len() { return false }
        return _flatSel[idx]
    }

    // ==================== set 初始化 ====================
    func set(Dict opts) {
        Theme th = theme.getTheme()
        _bgColor = th.bg
        _bdrColor = th.border
        _selColor = th.bgSel
        _hovColor = th.bgHover
        _txtColor = th.txt
        _sbColor = th.sb
        _lineColor = th.sep
        _arrColor = theme.darken(th.txt, 60)
        _markColor = th.txtOnAccent
        x         = opts.get("x", 0)
        y         = opts.get("y", 0)
        w         = opts.get("w", 200)
        h         = opts.get("h", 200)
        _rowH     = opts.get("row_h", 24)
        _indent    = opts.get("indent", 16)
        _padX      = opts.get("pad_x", 6)
        _fontSize = opts.get("font_size", 15)
        _fontPath = opts.get("font_path", "")
        _fontStyle = opts.get("font_style", 0)
        _mode     = opts.get("mode", 0)
        _showCheck = opts.get("show_check", false)

        var its = opts.get("items", [])
        if its is Array[Dict] { _build_from_dicts(its) }
        else { _roots = [] }

        _scroll = 0.0; _hover = -1; _sel = -1; _sel2 = []

        // 颜色：opts 未传则保持默认值
        _bgColor = opts.get("bg_color", _bgColor)
        _bdrColor = opts.get("border_color", _bdrColor)
        _selColor = opts.get("sel_color", _selColor)
        _hovColor = opts.get("hover_color", _hovColor)
        _txtColor = opts.get("text_color", _txtColor)
        _arrColor = opts.get("arrow_color", _arrColor)
        _sbColor = opts.get("scroll_color", _sbColor)
        _lineColor = opts.get("line_color", _lineColor)
        _chkColor = opts.get("check_color", _chkColor)
        _showLines = opts.get("show_lines", true)

        _cursor = _int(opts.get("cursor", SystemCursor.POINTER))
        enabled = opts.get("enabled", true)
        visible = opts.get("visible", true)
        _tip = opts.get("tip", "")

        _ctxMenuEnabled = opts.get("context_menu", false) and opts.has("context_menu")
        if _ctxMenuEnabled and _ctxMenu == null {
            _ctxMenu = menu.createMenuBar({})
            _ctxMenu.setWindowSize(_winW, _winH)
            _ctxHandle = _ctxMenu.addContextMenu("tv_ctx")
            menu.registerContextMenu(_ctxMenu)   // 登记（含面板嵌套场景），由窗口第二遍按窗口隔离绘制
        }

        _ensure_font()
        _flatten()
        _clamp_scroll()
        _loaded = true
    }

    // ==================== 设置方法 ====================
    func set_items(Array[Dict] ds) {
        if ds is Array[Dict] { _build_from_dicts(ds) }
        else { _roots = [] }
        _scroll = 0.0; _hover = -1; _sel = -1; _sel2 = []
        _flatten(); _clamp_scroll()
    }
    func clear() {
        _roots = []
        _scroll = 0.0; _hover = -1; _sel = -1; _sel2 = []; _flatDirty = true; _flatten()
    }
    func set_enabled(bool e) { enabled = e }
    func set_visible(bool v) { visible = v }
    func is_visible(): bool { return visible }
    func set_font_size(float s) { _fontSize = s; if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null }
    func set_scroll(float p) { _scroll = p; _clamp_scroll() }
    func get_scroll(): float { return _scroll }
    // 层级连接线
    func set_show_lines(bool v) { _showLines = v }
    func get_show_lines(): bool { return _showLines }

    // 节点图标（image）绘制参数
    func set_image_size(float s) { _imgSize = s }
    func set_image_gap(float g) { _imgGap = g }
    // 内容模式：0=aspectFit(保持比例,默认) 1=stretch(拉伸) 2=aspectFill(覆盖裁剪)
    func set_image_mode(int m) { _imgMode = m }

    // 展开/折叠（写操作原地递归修改）
    func _get_expanded(int id): bool { return _get_expanded_r(_roots, id) }
    func _get_expanded_r(Array[TreeViewNode] list, int id): bool {
        for list.len() to i {
            if list[i].id == id { return list[i].expanded }
            if _get_expanded_r(list[i].children, id) { return true }
        }
        return false
    }
    func expand(int id, bool e) {
        bool cur = _get_expanded(id)
        if cur != e {
            _set_expanded_r(_roots, id, e)
            _flatDirty = true; _flatten(); _clamp_scroll()
            if _onToggle != null { _onToggle(id, e) }
        }
    }
    func _set_expanded_r(Array[TreeViewNode] list, int id, bool v): bool {
        for list.len() to i {
            if list[i].id == id { list[i].expanded = v; return true }
            if _set_expanded_r(list[i].children, id, v) { return true }
        }
        return false
    }
    func expand_all() { _set_all_expanded(true) }
    func collapse_all() { _set_all_expanded(false) }
    func _set_all_expanded(bool e) {
        _set_all_r(_roots, e)
        _flatDirty = true; _flatten(); _clamp_scroll()
    }
    func _set_all_r(Array[TreeViewNode] list, bool e) {
        for list.len() to i {
            list[i].expanded = e
            _set_all_r(list[i].children, e)
        }
    }
    func _toggle_node(int id) {
        bool e = not _get_expanded(id)
        _set_expanded_r(_roots, id, e)
        _flatDirty = true; _flatten(); _clamp_scroll()
        if _onToggle != null { _onToggle(id, e) }
    }
    func toggle(int id) { _toggle_node(id) }

    // 复选框（写操作原地递归修改，避免跨函数返回结构体副本导致写不回）
    func set_checked(int id, bool c) { _set_checked_r(_roots, id, c); _flatDirty = true }
    func _set_checked_r(Array[TreeViewNode] list, int id, bool v): bool {
        for list.len() to i {
            if list[i].id == id { list[i].checked = v; return true }
            if _set_checked_r(list[i].children, id, v) { return true }
        }
        return false
    }
    func is_checked(int id): bool { return _is_checked_r(_roots, id) }
    func _is_checked_r(Array[TreeViewNode] list, int id): bool {
        for list.len() to i {
            if list[i].id == id { return list[i].checked }
            if _is_checked_r(list[i].children, id) { return true }
        }
        return false
    }
    func get_checked_ids(): Array[int] {
        Array[int] out = []
        _collect_checked_r(_roots, out)
        return out
    }
    func _collect_checked_r(Array[TreeViewNode] list, Array[int] out) {
        for list.len() to i {
            if list[i].checkable and list[i].checked { out.add(list[i].id) }
            _collect_checked_r(list[i].children, out)
        }
    }

    // 选择与查询
    func get_selected_id(): int {
        if _mode == 0 { return _sel }
        if _sel2.len() > 0 { return _sel2[_sel2.len() - 1] }
        return -1
    }
    func get_selected_ids(): Array[int] {
        if _mode == 0 { if _sel >= 0 { return [_sel] } return [] }
        return _sel2
    }
    func get_visible_count(): int { return _flatIds.len() }
    func get_node(int id): TreeViewNode {
        TreeViewNode src = _find(id)
        TreeViewNode n = new TreeViewNode()
        if src.id >= 0 {
            n.id = src.id; n.text = src.text; n.image = src.image; n.imageMode = src.imageMode; n.expanded = src.expanded; n.hasChildren = src.hasChildren
            n.checkable = src.checkable; n.checked = src.checked; n._depth = src._depth; n.data = src.data
            for src.children.len() to i { n.children.add(get_node(src.children[i].id)) }
        }
        return n
    }
    func get_selected_node(): TreeViewNode { return get_node(_sel) }
    func select(int id) { _select(id, false) }
    func _select(int id, bool ctrl) {
        if id < 0 { return }
        _flatDirty = true   // ★ 选中变更后标记拍平视图过期，下次 render 重建 _flatSel
        if _mode == 0 {
            if _sel != id { _sel = id; _ensure_visible(id); if _onChange != null { _onChange([id]) } }
        } else {
            if ctrl {
                bool found = false
                for _sel2.len() to i { if _sel2[i] == id { _sel2.remove(i); found = true; break } }
                if not found { _sel2.add(id) }
            } else { _sel2 = [id] }
            _sel = id
            _ensure_visible(id)
            if _onChange != null { _onChange(_sel2.copy()) }
        }
    }
    func _ensure_visible(int id) {
        for _flatIds.len() to i {
            if _flatIds[i] == id {
                float iy = i * _rowH
                if iy < _scroll { _scroll = iy }
                else if iy + _rowH > _scroll + h { _scroll = iy + _rowH - h }
                _clamp_scroll(); return
            }
        }
    }
    func set_data(int id, Dict d) { _set_data_r(_roots, id, d) }
    func _set_data_r(Array[TreeViewNode] list, int id, Dict d): bool {
        for list.len() to i {
            if list[i].id == id { list[i].data = d; return true }
            if _set_data_r(list[i].children, id, d) { return true }
        }
        return false
    }
    func get_data(int id): Dict { return _get_data_r(_roots, id) }
    func _get_data_r(Array[TreeViewNode] list, int id): Dict {
        for list.len() to i {
            if list[i].id == id { return list[i].data }
            Dict d = _get_data_r(list[i].children, id)
            if d.len() > 0 { return d }
        }
        return {}
    }
    // 增删（支持懒加载）—— 原地递归修改树结构
    func add_child(int parentId, Dict d): int {
        int id = _add_child_r(_roots, parentId, d)
        if id >= 0 { _flatDirty = true; _flatten(); _clamp_scroll() }
        return id
    }
    func _add_child_r(Array[TreeViewNode] list, int parentId, Dict d): int {
        for list.len() to i {
            if list[i].id == parentId {
                TreeViewNode n = _build_node(d, parentId, list[i]._depth + 1)
                list[i].children.add(n)
                list[i].hasChildren = true
                return n.id
            }
            int r = _add_child_r(list[i].children, parentId, d)
            if r >= 0 { return r }
        }
        return -1
    }
    func _remove_r(TreeViewNode node, int id): TreeViewNode {
        if node.id == id { TreeViewNode e = new TreeViewNode(); e.id = -1; return e }
        TreeViewNode cp = new TreeViewNode()
        cp.id = node.id; cp.text = node.text; cp.image = node.image; cp.imageMode = node.imageMode; cp._parent = node._parent; cp._depth = node._depth
        cp.expanded = node.expanded; cp.hasChildren = node.hasChildren; cp.checkable = node.checkable
        cp.checked = node.checked; cp.data = node.data
        for node.children.len() to i {
            TreeViewNode c = _remove_r(node.children[i], id)
            if c.id >= 0 { cp.children.add(c) }
        }
        return cp
    }
    func remove_node(int id) {
        Array[TreeViewNode] out = []
        for _roots.len() to i {
            TreeViewNode c = _remove_r(_roots[i], id)
            if c.id >= 0 { out.add(c) }
        }
        _roots = out
        if _is_selected(id) { _sel = -1 }
        for _sel2.len() to i { if _sel2[i] == id { _sel2.remove(i); i = i - 1 } }
        _flatDirty = true; _flatten(); _clamp_scroll()
    }

    func on_change(func(Array[int]):void cb) { _onChange = cb }
    func on_context(func(int, float, float):void cb) { _onContext = cb }
    func on_toggle(func(int, bool):void cb) { _onToggle = cb }
    func on_check(func(int, bool):void cb) { _onCheck = cb }

    // ==================== 右键菜单接入 ====================
    func set_window(int ww, int hh) { _winW = ww; _winH = hh; _ctxMenu?.setWindowSize(ww, hh) }
    // ★ Widget 接口：窗口 resize 时自动同步尺寸到内部菜单
    func on_window_resize(int ww, int hh) { set_window(ww, hh) }
    // 记录所属窗口句柄，供内嵌右击菜单按窗口隔离绘制
    func set_window_handle(Ptr[u8] hwnd) {
        _hwnd = hwnd
        _ctxMenu?.setWindowHandle(hwnd)
    }
    func get_context_menu(): MenuBar { return _ctxMenu }
    func get_context_handle(): int { return _ctxHandle }
    func set_context_menu_enabled(bool en) { _ctxMenuEnabled = en }
    func is_context_menu_enabled(): bool { return _ctxMenuEnabled }
    func _open_ctx_menu(float mx, float my) {
        if _ctxMenu == null or _ctxHandle < 0 { return }
        _ctxMenu.openContext(_ctxHandle, mx, my)
    }

    // ==================== 交互 ====================
    func process(Event ev) {
        if not _loaded { return }
        if not visible { return }
        if not enabled { _hover = -1; _draggingScroll = false; return }

        if _ctxMenuEnabled and _ctxMenu != null and _ctxMenu.isOpen() {
            if ev.isMouseButtonDown() and ev.mouseButton() == 3 {
                if contains(ev.mouseX(), ev.mouseY()) { _open_ctx_menu(ev.mouseX(), ev.mouseY()) }
                else { _ctxMenu.close() }
                return
            }
            _ctxMenu.process(ev)
            return
        }

        float mx = ev.mouseX(), my = ev.mouseY()
        if ev.isMouseWheel() { mx = ev.wheelMouseX(); my = ev.wheelMouseY() }
        if core.inPopupCapture(mx, my) { return }

        if ev.isMouseButtonUp() and _draggingScroll { _draggingScroll = false; return }

        if ev.isMouseButtonDown() and _in_vscroll(mx, my) {
            var g = _sb_geom()
            float maxs = g[6], trk = g[3] - g[2], thH = g[4]
            if _in_thumb(mx, my) {
                _draggingScroll = true; _sbDragOffset = my - g[5]
            } else {
                _draggingScroll = true; _sbDragOffset = thH / 2.0
                float rel = my - g[2] - thH / 2.0
                if trk - thH > 0.0 { _scroll = rel * maxs / (trk - thH) }
                _clamp_scroll()
            }
            return
        }
        if _draggingScroll {
            if ev.isMouseMotion() {
                var g = _sb_geom()
                float maxs = g[6], trk = g[3] - g[2], thH = g[4]
                float rel = my - g[2] - _sbDragOffset
                if trk - thH > 0.0 { _scroll = rel * maxs / (trk - thH) }
                _clamp_scroll()
                core.markFrameRedraw()
            }
            return
        }

        if ev.isMouseWheel() {
            if not contains(ev.wheelMouseX(), ev.wheelMouseY()) { return }
            _scroll = _scroll - ev.wheelY() * _rowH
            _clamp_scroll()
            return
        }

        if ev.isMouseMotion() {
            int prevHover = _hover
            _hover = _id_at(mx, my)
            if _hover != prevHover { core.markFrameRedraw() } else { core.markFrameMotion() }
            if _hover >= 0 and _cursor >= 0 { core.requestCursor(_cursor) }
            if _tip != "" {
                if _hover >= 0 {
                    // ★ 同一节点内移动用 tipKeep 避免重置延迟计时器（与 Table 同优化）
                    if _hover != prevHover { tip.tipReport(_tip, mx, my) }
                    else { tip.tipKeep(mx, my) }
                }
            }
        }

        if _ctxMenuEnabled and _ctxMenu != null and ev.isMouseButtonDown() and ev.mouseButton() == 3 {
            int id = _id_at(mx, my)
            if id >= 0 {
                _select(id, false)
                if _onContext != null { _onContext(id, mx, my) }
                _open_ctx_menu(mx, my)
                return
            }
        }

        if ev.isMouseButtonDown() and ev.mouseButton() == 1 {
            if not contains(mx, my) { return }   // 守卫：仅当点击落在控件内才处理
            int idx = _row_at(my)
            if idx < 0 { return }
            int id = _flatIds[idx]                   // 基础类型数组，按下标读安全
            bool hasCh = _flatHas[idx]
            bool chkable = _flatCheck[idx]
            if ev.mouseClicks() == 2 and hasCh { _toggle_node(id); return }
            if hasCh and _in_toggle(idx, mx, my) { _toggle_node(id); return }
            if _showCheck and chkable and _in_check(idx, mx, my) {
                bool nv = not is_checked(id)
                set_checked(id, nv)
                _select(id, false)
                if _onCheck != null { _onCheck(id, nv) }
                return
            }
            bool ctrl = (ev.keyMod() & 64) != 0 or (ev.keyMod() & 128) != 0
            _select(id, ctrl)
        }
    }

    // ==================== 渲染 ====================
    func render(Renderer r) {
        if not _loaded { return }
        if not visible { return }
        _ensure_font()
        if _font == null or not _font.ok { return }   // 字体无效时跳过渲染，避免"有背景无文字"的闪烁
        _flatten()

        Color bgC = _bgColor
        if not enabled { bgC = theme.darken(_bgColor, 60) }
        r.setColor(bgC)
        r.fillRoundedRect(x, y, w, h, 6.0)

        SDL_Rect clip = SDL_Rect.malloc()
        clip.x = _int(x); clip.y = _int(y)
        clip.w = _int(w) + 1; clip.h = _int(h) + 1   // +1 覆盖浮点截断的亚像素
        r.pushClipRect(clip.to_ptr())

        // ★ 仅遍历可见行区间，避免大树（上万可见行）每帧全量遍历
        int startRow = _int(_scroll / _rowH)
        if startRow < 0 { startRow = 0 }
        int endRow = startRow + _int(h / _rowH) + 2
        if endRow > _flatIds.len() { endRow = _flatIds.len() }
        for startRow : endRow - 1 to i {
            int id = _flatIds[i]
            float rowY = r.snapY(y - _scroll + i * _rowH)
            if rowY + _rowH < y or rowY > y + h { continue }
            float checkOff = if _showCheck then 18.0 else 0.0

            bool seld = _is_flat_sel(i)   // ★ O(1) 按下标读拍平时预计算的选中状态
            Color rowC = bgC
            if seld { rowC = _selColor }
            else if id == _hover { rowC = _hovColor }
            if seld or id == _hover { r.setColor(rowC); r.fillRoundedRect(x + 2.0, rowY + 1.0, w - 4.0, _rowH - 2.0, 4.0) }

            int depth = _flatDepth[i]

            // 层级连接线：竖线贯穿各层级、横线连接父到本节点（最后子节点拐弯 └）
            if _showLines and depth >= 1 {
                int nx = if (i + 1 < _flatIds.len()) then _flatDepth[i + 1] else 0
                for depth to kk {
                    int k = kk
                    bool within = (i + 1 < _flatIds.len()) and (nx >= k)
                    float seg = if within then _rowH else (_rowH / 2.0)
                    // 本节点所在列（k==depth）正是展开三角所在的列：竖线若画满整行，
                    // 展开后会从向下三角的底尖穿出。钳制为只画到三角中心（上半段），
                    // 下半段由子节点各自的列（depth+1）继续连接，既去掉穿透又保持主干连续。
                    if k == depth and _flatHas[i] { seg = _rowH / 2.0 }
                    float lx = r.snapX(x + _padX + k * _indent + 8.0)
                    int la = if enabled then 255 else 120
                    r.setColor(theme.withAlpha(_lineColor, la))
                    r.drawLine(lx, r.snapY(rowY), lx, r.snapY(rowY + seg))
                }
                float lx0 = r.snapX(x + _padX + (depth - 1) * _indent + 8.0)
                float lx1 = r.snapX(x + _padX + depth * _indent + 8.0)
                float ly = r.snapY(rowY + _rowH / 2.0)
                int la2 = if enabled then 255 else 120
                r.setColor(theme.withAlpha(_lineColor, la2))
                r.drawLine(lx0, ly, lx1, ly)
            }

            if _flatHas[i] {
                float tcx = x + _padX + depth * _indent + 8.0
                float tcy = rowY + _rowH / 2.0
                Color ar = _arrColor
                if not enabled { ar = theme.darken(_arrColor, 60) }
                r.setColor(ar)
                r.drawTriangle(tcx, tcy, 5.0, if _flatExpanded[i] then 180.0 else 90.0,
                    theme.colorR(ar), theme.colorG(ar), theme.colorB(ar), 255)
            }
            if _showCheck and _flatCheck[i] {
                float cx = x + _padX + depth * _indent
                float bx = cx + 18.0
                float by = rowY + (_rowH - 14.0) / 2.0
                if _flatOn[i] {
                    Color cr = _chkColor
                    if not enabled { cr = theme.darken(_chkColor, 60) }
                    r.setColor(cr)
                    r.fillRoundedRect(bx, by, 14.0, 14.0, 3.0)
                    Color mr = _markColor
                    if not enabled { mr = theme.darken(_markColor, 60) }
                    r.setColor(mr)
                    r.drawLine(r.snapX(bx + 3.0), r.snapY(by + 7.5), r.snapX(bx + 6.0), r.snapY(by + 10.5))
                    r.drawLine(r.snapX(bx + 6.0), r.snapY(by + 10.5), r.snapX(bx + 11.0), r.snapY(by + 4.5))
                } else {
                    Color br2 = _bdrColor
                    if not enabled { br2 = theme.darken(_bdrColor, 60) }
                    r.setColor(br2)
                    r.drawRoundedRect(bx, by, 14.0, 14.0, 3.0)
                }
            }
            // 节点图标（image）：绘制在 缩进/展开箭头/复选框 之后、文字之前
            float imgX = x + _padX + depth * _indent + 16.0 + checkOff
            float imgSize = _imgSize
            if imgSize <= 0.0 { imgSize = _rowH - 8.0 }
            float imgDrawY = rowY + (_rowH - imgSize) / 2.0
            string ipath = _flatImage[i]
            if ipath != "" {
                Ptr[u8] itex = _get_tex(r, ipath)
                if itex != null {
                    r.setTextureAlpha(itex, 255)
                    r.setTextureColor(itex, #FFFFFFFF)
                    int mode = _flatImgMode[i]
                    if mode < 0 { mode = _imgMode }   // 节点未指定则用全局模式
                    var nats = r.getTextureSize(itex)
                    float nw = nats["w"], nh = nats["h"]
                    if mode == 1 {
                        // stretch：直接拉伸填满（会变形）
                        r.drawTextureFromTo(itex, 0.0, 0.0, nw, nh, imgX, imgDrawY, imgSize, imgSize)
                    } else if mode == 2 {
                        // aspectFill（裁边填满）：覆盖缩放 + 居中裁剪源矩形
                        float s = imgSize / nw; if imgSize / nh > s { s = imgSize / nh }
                        float sw = imgSize / s, sh = imgSize / s
                        float sx = (nw - sw) / 2.0, sy = (nh - sh) / 2.0
                        r.drawTextureFromTo(itex, sx, sy, sw, sh, imgX, imgDrawY, imgSize, imgSize)
                    } else {
                        // aspectFit（默认，留边）：保持比例完整显示
                        float s = imgSize / nw; if imgSize / nh < s { s = imgSize / nh }
                        float dw = nw * s, dh = nh * s
                        r.drawTextureFromTo(itex, 0.0, 0.0, nw, nh,
                            imgX + (imgSize - dw) / 2.0, imgDrawY + (imgSize - dh) / 2.0, dw, dh)
                    }
                    checkOff = checkOff + imgSize + _imgGap   // 文字右移，给图标让位
                }
            }
            if _font != null and _font.ok {
                float tx = x + _padX + depth * _indent + 16.0 + checkOff + 4.0
                float th = _textH
                Color tcR = _txtColor
                if not enabled { tcR = theme.darken(_txtColor, 60) }
                float ty = r.snapY(rowY + (_rowH - th) / 2.0)
                r.drawText(_font, _flatText[i], r.snapX(tx), ty, tcR)
            }
        }

        r.popClipRect()
        clip.free()

        r.setColor(_bdrColor)
        r.drawRoundedRect(x, y, w, h, 6.0)

        float maxs = _max_scroll()
        if maxs > 0.0 {
            float sw = 8.0
            float sx = x + w - sw - 2.0
            r.setColor(theme.withAlpha(_sbColor, 180))
            r.fillRoundedRect(sx, y + 2.0, sw, h - 4.0, sw / 2.0)
            float ratio = _scroll / maxs
            float thH = maths.max(20.0, maths.min(h * h / _total_h(), h - 4.0))
            float thy = y + 2.0 + ratio * (h - 4.0 - thH)
            r.setColor(theme.brighten(_sbColor, 60))
            r.fillRoundedRect(sx, thy, sw, thH, sw / 2.0)
        }
    }

    func dispose() {
        if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null
        _ctxMenu?.dispose(); _ctxMenu = null
        // 纹理缓存仅清空引用：其由所属渲染器在销毁时统一释放，
        // 此处再 SDL_DestroyTexture 会造成 double-free/崩溃（见 sdl_font.leno 注释）
        _imgCacheTex = []; _imgCachePaths = []
        _imgLastPath = ""; _imgLastTex = null
    }

// ==================== 运行时主题切换 ====================
func applyTheme(Theme t) {
    _bgColor = t.bg
    _bdrColor = t.border
    _selColor = t.bgSel
    _hovColor = t.bgHover
    _txtColor = t.txt
    _sbColor = t.sb
    _lineColor = t.sep
    _arrColor = theme.darken(t.txt, 60)
    _markColor = t.txtOnAccent
    // 同步内嵌右键菜单的配色
    _ctxMenu?.applyTheme(t)
}
}

// 工厂
export func createTreeView(Dict opts): TreeView {
    TreeView t = new TreeView(); t.set(opts); return t
}
