// sdl_renderer.leno — SDL3 渲染器封装
// 封装 SDL_Renderer 的绘制、颜色、纹理等操作
import ffi
import maths
import "sdl_core.leno" as core
import "sdl_font.leno" as font
use core.sdl3
use core.SDL_FRect
use core.SDL_Color
use core.SDL_FColor
use core.SDL_FPoint
use core.SDL_Point
use core.Color
use core.FColor
use core.Size
use core.FSize
use font.Font
use font.TextTexture

// 模块加载时一次性初始化 DLL，后续直接用 _lib
sdl3 _lib = core.lib()

export struct Renderer {
    Ptr handle; bool ok

    // 创建默认渲染器（关联到窗口）
    func initDefault(Ptr window): bool {
        handle = _lib.SDL_CreateRenderer(window, null as string) as Ptr
        ok = handle != null
        return ok
    }

    // 销毁渲染器，释放资源
    func destroy() {
        if ok { _lib.SDL_DestroyRenderer(handle); handle = null; ok = false }
    }

    // 清空渲染目标（用当前颜色填充整个画面）
    func clear(): bool   { return _lib.SDL_RenderClear(handle) }

    // 呈现渲染结果到屏幕（交换缓冲区）
    func present(): bool { return _lib.SDL_RenderPresent(handle) }

    // 设置绘制颜色（整数 RGBA，0~255）
    func setColor(int r, int g, int b, int a): bool {
        return _lib.SDL_SetRenderDrawColor(handle, r, g, b, a)
    }

    // 设置绘制颜色（浮点 RGBA，0.0~1.0）
    func setColorFloat(float r, float g, float b, float a): bool {
        return _lib.SDL_SetRenderDrawColorFloat(handle, r, g, b, a)
    }

    // 获取当前绘制颜色（整数 RGBA），返回 {r, g, b, a}
    func getColor(): Color {
        SDL_Color c = SDL_Color.malloc()
        _lib.SDL_GetRenderDrawColor(handle, &c.r, &c.g, &c.b, &c.a)
        var d = {r: c.r as int, g: c.g as int, b: c.b as int, a: c.a as int}
        c.free(); return d
    }

    // 获取当前绘制颜色（浮点 RGBA），返回 {r, g, b, a}
    func getColorFloat(): FColor {
        SDL_FColor c = SDL_FColor.malloc()
        _lib.SDL_GetRenderDrawColorFloat(handle, &c.r, &c.g, &c.b, &c.a)
        var d = {r: c.r as float, g: c.g as float, b: c.b as float, a: c.a as float}
        c.free(); return d
    }

    // 获取渲染器输出尺寸，返回 {w, h}
    func getOutputSize(): Size {
        SDL_Point pt = SDL_Point.malloc()
        _lib.SDL_GetRenderOutputSize(handle, &pt.x, &pt.y)
        var d = {w: pt.x as int, h: pt.y as int}
        pt.free(); return d
    }

    // 填充矩形（x, y, w, h）
    func fillRect(float x, float y, float w, float h): bool {
        SDL_FRect rect = SDL_FRect.malloc()
        rect.x = x; rect.y = y; rect.w = w; rect.h = h
        bool result = _lib.SDL_RenderFillRect(handle, rect.to_ptr())
        rect.free(); return result
    }

    // 填充矩形（传入 SDL_FRect 指针，避免重复创建）
    func fillRectPtr(Ptr rect): bool {
        return _lib.SDL_RenderFillRect(handle, rect)
    }

    // 填充整个渲染目标（传 null 给 SDL 即表示全屏）
    func fillFull(): bool {
        return _lib.SDL_RenderFillRect(handle, null)
    }

    // 绘制矩形边框（x, y, w, h）
    func drawRect(float x, float y, float w, float h): bool {
        SDL_FRect rect = SDL_FRect.malloc()
        rect.x = x; rect.y = y; rect.w = w; rect.h = h
        bool result = _lib.SDL_RenderRect(handle, rect)
        rect.free(); return result
    }

    // 绘制线段（x1, y1）→（x2, y2）
    func drawLine(float x1, float y1, float x2, float y2): bool {
        return _lib.SDL_RenderLine(handle, x1, y1, x2, y2)
    }

    // 绘制点（x, y）
    func drawPoint(float x, float y): bool {
        return _lib.SDL_RenderPoint(handle, x, y)
    }

    // 设置垂直同步模式：0=关闭, 1=开启, -1=自适应
    func setVSync(int mode): bool {
        return _lib.SDL_SetRenderVSync(handle, mode)
    }

    // 绘制圆形边框（cx, cy 圆心，radius 半径，64 段逼近）
    func drawCircle(float cx, float cy, float radius): bool {
        var segs = 64
        var pts  = segs + 1
        Ptr buf  = ffi.malloc(pts * 8)
        if buf == null { return false }
        var two_pi = 6.283185307
        for 0 : segs to i {
            var a = two_pi * _float(i) / _float(segs)
            ffi.write_float(buf, i * 8,     cx + radius * maths.cos(a))
            ffi.write_float(buf, i * 8 + 4, cy + radius * maths.sin(a))
        }
        var ok = _lib.SDL_RenderLines(handle, buf, pts)
        ffi.free(buf); return ok
    }

    // 填充实心圆形（逐行画线近似）
    func fillCircle(float cx, float cy, float radius): bool {
        var ok = true; var r = _int(radius)
        for 0 : r * 2 to i {
            var dy = i - r
            var half = maths.sqrt(radius * radius - _float(dy * dy))
            if not drawLine(cx - half, cy + _float(dy), cx + half, cy + _float(dy)) { ok = false }
        }
        return ok
    }

    // 批量绘制线段（pts 为 float 对数组，count 为点数）
    func drawLines(Ptr pts, int count): bool { return _lib.SDL_RenderLines(handle, pts, count) }

    // 批量绘制点
    func drawPoints(Ptr pts, int count): bool { return _lib.SDL_RenderPoints(handle, pts, count) }

    // 批量绘制矩形边框
    func drawRects(Ptr rects, int count): bool { return _lib.SDL_RenderRects(handle, rects, count) }

    // 批量填充矩形
    func fillRects(Ptr rects, int count): bool { return _lib.SDL_RenderFillRects(handle, rects, count) }

    // 设置渲染缩放（sx, sy 缩放因子）
    func setScale(float sx, float sy): bool { return _lib.SDL_SetRenderScale(handle, sx, sy) }

    // 设置混合模式：NONE=0, BLEND=1, ADD=2, MOD=4, MUL=8
    func setBlendMode(int mode): bool { return _lib.SDL_SetRenderDrawBlendMode(handle, mode) }

    // 设置裁剪矩形（只在此区域内绘制）
    func setClipRect(Ptr rect): bool { return _lib.SDL_SetRenderClipRect(handle, rect) }

    // 清除裁剪区域（恢复全屏绘制）
    func clearClip(): bool { return _lib.SDL_SetRenderClipRect(handle, null) }

    // 设置逻辑分辨率（坐标映射到 w×h，自动缩放）
    func setLogicalSize(int w, int h): bool { return _lib.SDL_SetRenderLogicalSize(handle, w, h) }

    // 设置视口区域
    func setViewport(Ptr rect): bool { return _lib.SDL_SetRenderViewport(handle, rect) }

    // 重置视口为全屏
    func resetViewport(): bool { return _lib.SDL_SetRenderViewport(handle, null) }

    // 在指定位置绘制纹理（按 w×h 缩放）
    func drawTextureAt(Ptr texture, float x, float y, float w, float h): bool {
        SDL_FRect rect = SDL_FRect.malloc()
        rect.x = x; rect.y = y; rect.w = w; rect.h = h
        bool ok = _lib.SDL_RenderTexture(handle, texture, null, rect.to_ptr())
        rect.free(); return ok
    }

    // 绘制纹理（指定源矩形和目标矩形，null 表示完整）
    func drawTextureRect(Ptr texture, Ptr srcrect, Ptr dstrect): bool {
        return _lib.SDL_RenderTexture(handle, texture, srcrect, dstrect)
    }

    // 旋转+翻转绘制纹理
    // angle: 角度（度），顺时针；center: null 则绕目标中心旋转
    // flip: FLIP_NONE / FLIP_HORIZONTAL / FLIP_VERTICAL
    func drawTextureRotated(Ptr texture, float x, float y, float w, float h,
                            float angle, float cx, float cy, int flip): bool {
        SDL_FRect dst = SDL_FRect.malloc()
        dst.x = x; dst.y = y; dst.w = w; dst.h = h

        SDL_FPoint center = SDL_FPoint.malloc()
        center.x = cx; center.y = cy

        bool ok = _lib.SDL_RenderTextureRotated(handle, texture, null, dst.to_ptr(),
                                                  angle, center.to_ptr(), flip)
        dst.free(); center.free(); return ok
    }

    // 获取纹理尺寸，返回 {w, h}（浮点）
    func getTextureSize(Ptr texture): FSize {
        SDL_FPoint pt = SDL_FPoint.malloc()
        _lib.SDL_GetTextureSize(texture, &pt.x, &pt.y)
        var d = {w: pt.x as float, h: pt.y as float}
        pt.free(); return d
    }

    // 便捷绘制文字（创建纹理→绘制→销毁一步完成）
    func drawText(Font f, string text, float x, float y, int r, int g, int b) {
        TextTexture tex = font.createTextTexture(handle, f, text, r, g, b)
        if tex.ok { drawTextureAt(tex.texture, x, y, tex.width, tex.height); tex.destroy() }
    }

    // 居中绘制文字（水平居中于窗口宽度 winW）
    func drawTextCentered(Font f, string text, float winW, float y, int r, int g, int b) {
        var ms = f.measureString(text)
        float cx = (winW - _float(ms.w)) / 2.0
        drawText(f, text, cx, y, r, g, b)
    }

    // 设置背景色并清屏（setColor + clear 一步完成）
    func clearColor(int r, int g, int b, int a) {
        setColor(r, g, b, a); clear()
    }

    // 渲染到纹理（null 恢复渲染到窗口）
    func setRenderTarget(Ptr texture): bool {
        return _lib.SDL_SetRenderTarget(handle, texture)
    }

    // 设置纹理透明度调制（0~255）
    func setTextureAlpha(Ptr texture, int alpha): bool {
        return _lib.SDL_SetTextureAlphaMod(texture, alpha)
    }

    // 设置纹理颜色调制（RGB 0~255）
    func setTextureColor(Ptr texture, int r, int g, int b): bool {
        return _lib.SDL_SetTextureColorMod(texture, r, g, b)
    }

    // 强制刷新渲染命令
    func flush(): bool {
        return _lib.SDL_FlushRenderer(handle)
    }

    // 截取当前渲染画面
    func readPixels(Ptr rect): Ptr {
        return _lib.SDL_RenderReadPixels(handle, rect) as Ptr
    }

    // 创建纹理（返回 Ptr，用完 SDL_DestroyTexture）
    func createTexture(int format, int access, int w, int h): Ptr {
        return _lib.SDL_CreateTexture(handle, format, access, w, h) as Ptr
    }

    // 更新纹理像素数据
    func updateTexture(Ptr texture, Ptr rect, Ptr pixels, int pitch): bool {
        return _lib.SDL_UpdateTexture(texture, rect, pixels, pitch)
    }

    // 锁定/解锁纹理以直接操作像素（需 TEXTUREACCESS_STREAMING）
    func lockTexture(Ptr texture, Ptr rect): bool {
        return _lib.SDL_LockTexture(texture, rect, null, null)
    }
    func unlockTexture(Ptr texture) {
        _lib.SDL_UnlockTexture(texture)
    }

    // 设置颜色缩放（HDR/亮度调节，不影响 alpha）
    func setColorScale(float scale): bool {
        return _lib.SDL_SetRenderColorScale(handle, scale)
    }

    // 九宫格渲染（UI 边框不拉伸）
    func drawTexture9Grid(Ptr texture, float lw, float rw, float th, float bh, float scale, Ptr dst): bool {
        return _lib.SDL_RenderTexture9Grid(handle, texture, null, lw, rw, th, bh, scale, dst)
    }

    // 平铺渲染
    func drawTextureTiled(Ptr texture, float scale, Ptr dst): bool {
        return _lib.SDL_RenderTextureTiled(handle, texture, null, scale, dst)
    }
}

// 创建渲染器实例
export func createRenderer(Ptr window): Renderer {
    Renderer ren = new Renderer(); ren.initDefault(window); return ren
}
