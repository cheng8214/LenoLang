// sdl_renderer.leno — SDL3 渲染器封装
// 封装 SDL_Renderer 的绘制、颜色、纹理等操作
import ffi
import maths
import "sdl_core.leno" as core
import "sdl_font.leno" as font
use core.sdl3
use core.SDL_FRect
use core.SDL_Color
use core.SDL_FColor
use core.SDL_FPoint
use core.SDL_Point
use core.SDL_Rect
use core.SDL_Vertex
use core.Color
use core.FColor
use core.Size
use core.FSize
use font.Font
use font.TextTexture

// 模块加载时一次性初始化 DLL，后续直接用 _lib
sdl3 _lib = core.lib()

export struct Renderer {
    Ptr handle; bool ok
    // 超采样抗锯齿（SSAA）：整帧渲染到 scale 倍离屏纹理，再以 1x 缩放贴回窗口得到平滑边缘
    Ptr[u8] _ssaaTex; float _ssaaScale; int _ssaaWinW; int _ssaaWinH; bool _ssaa

    // 创建默认渲染器（关联到窗口）
    func initDefault(Ptr[u8] window): bool {
        // 说明：SDL3 的 2D 渲染 API 本身不支持图元抗锯齿，
        // SDL_HINT_RENDER_LINE_METHOD="2" 只是切换为 driver 线算法，并不产生 AA。
        // 真正的抗锯齿靠 enableSSAA()（超采样：渲染到 2x 离屏纹理再降采样贴回）。
        _lib.SDL_SetHint("SDL_HINT_RENDER_DRIVER", "direct3d")
        _lib.SDL_SetHint("SDL_HINT_RENDER_LINE_METHOD", "2")
        handle = _lib.SDL_CreateRenderer(window, null as string)
        ok = handle != null
        return ok
    }

    // 销毁渲染器，释放资源
    func destroy() {
        if ok {
            if _ssaaTex != null { _lib.SDL_DestroyTexture(_ssaaTex); _ssaaTex = null }
            _lib.SDL_DestroyRenderer(handle); handle = null; ok = false
        }
    }

    // 清空渲染目标（用当前颜色填充整个画面）
    // SSAA 开启时：清的是离屏高分辨率纹理，并把坐标缩放切到 scale
    func clear(): bool {
        if _ssaa { setRenderTarget(_ssaaTex); setScale(_ssaaScale, _ssaaScale) }
        return _lib.SDL_RenderClear(handle)
    }

    // 呈现渲染结果到屏幕（交换缓冲区）
    // SSAA 开启时：把高分辨率离屏纹理以 1x 缩放贴回窗口，GPU 双线性降采样 -> 平滑边缘
    func present(): bool {
        if _ssaa {
            setRenderTarget(null)
            setScale(1.0, 1.0)
            SDL_FRect dst = SDL_FRect.malloc()
            dst.x = 0.0; dst.y = 0.0; dst.w = _float(_ssaaWinW); dst.h = _float(_ssaaWinH)
            _lib.SDL_RenderTexture(handle, _ssaaTex, null, dst.to_ptr())
            dst.free()
        }
        return _lib.SDL_RenderPresent(handle)
    }

    // 开启超采样抗锯齿：把整帧渲染到 scale 倍离屏纹理，再以 1x 缩放贴回窗口
    // scale 建议 2.0（=4x 像素，兼顾画质与性能）；纹理创建失败则自动回退普通渲染
    func enableSSAA(int winW, int winH, float scale): bool {
        if scale <= 0.0 { return false }
        int tw = _int(_float(winW) * scale)
        int th = _int(_float(winH) * scale)
        if tw <= 0 or th <= 0 { return false }
        // SDL_TEXTUREACCESS_TARGET = 2
        Ptr[u8] tex = createTexture(core.PIXELFORMAT_RGBA8888, 2, tw, th)
        if tex == null {
            print("[LenoSDL3] SSAA 离屏纹理创建失败，回退普通渲染")
            return false
        }
        _ssaaTex = tex
        _ssaaScale = scale
        _ssaaWinW = winW; _ssaaWinH = winH
        _ssaa = true
        setRenderTarget(_ssaaTex)
        setScale(scale, scale)
        return true
    }

    // 设置绘制颜色（整数 RGBA，0~255）
    func setColor(int r, int g, int b, int a): bool {
        return _lib.SDL_SetRenderDrawColor(handle, r, g, b, a)
    }

    // 设置绘制颜色（浮点 RGBA，0.0~1.0）
    func setColorFloat(float r, float g, float b, float a): bool {
        return _lib.SDL_SetRenderDrawColorFloat(handle, r, g, b, a)
    }

    // 获取当前绘制颜色（整数 RGBA），返回 {r, g, b, a}
    func getColor(): Color {
        SDL_Color c = SDL_Color.malloc()
        _lib.SDL_GetRenderDrawColor(handle, &c.r, &c.g, &c.b, &c.a)
        var d = {r: c.r, g: c.g, b: c.b, a: c.a}
        c.free(); return d
    }

    // 获取当前绘制颜色（浮点 RGBA），返回 {r, g, b, a}
    func getColorFloat(): FColor {
        SDL_FColor c = SDL_FColor.malloc()
        _lib.SDL_GetRenderDrawColorFloat(handle, &c.r, &c.g, &c.b, &c.a)
        var d = {r: c.r as float, g: c.g as float, b: c.b as float, a: c.a as float}
        c.free(); return d
    }

    // 获取渲染器输出尺寸，返回 {w, h}
    func getOutputSize(): Size {
        SDL_Point pt = SDL_Point.malloc()
        _lib.SDL_GetRenderOutputSize(handle, &pt.x, &pt.y)
        var d = {w: pt.x, h: pt.y}
        pt.free(); return d
    }

    // 填充矩形（x, y, w, h）
    func fillRect(float x, float y, float w, float h): bool {
        SDL_FRect rect = SDL_FRect.malloc()
        rect.x = x; rect.y = y; rect.w = w; rect.h = h
        bool result = _lib.SDL_RenderFillRect(handle, rect.to_ptr())
        rect.free(); return result
    }

    // 填充矩形（传入 SDL_FRect 指针，避免重复创建）
    func fillRectPtr(Ptr rect): bool {
        return _lib.SDL_RenderFillRect(handle, rect)
    }

    // 填充整个渲染目标（传 null 给 SDL 即表示全屏）
    func fillFull(): bool {
        return _lib.SDL_RenderFillRect(handle, null)
    }

    // 绘制矩形边框（x, y, w, h）
    func drawRect(float x, float y, float w, float h): bool {
        SDL_FRect rect = SDL_FRect.malloc()
        rect.x = x; rect.y = y; rect.w = w; rect.h = h
        bool result = _lib.SDL_RenderRect(handle, rect)
        rect.free(); return result
    }

    // 绘制线段（x1, y1）→（x2, y2）
    func drawLine(float x1, float y1, float x2, float y2): bool {
        return _lib.SDL_RenderLine(handle, x1, y1, x2, y2)
    }

    // 绘制点（x, y）
    func drawPoint(float x, float y): bool {
        return _lib.SDL_RenderPoint(handle, x, y)
    }

    // 设置垂直同步模式：0=关闭, 1=开启, -1=自适应
    func setVSync(int mode): bool {
        return _lib.SDL_SetRenderVSync(handle, mode)
    }

    // 绘制圆形边框（cx, cy 圆心，radius 半径，64 段逼近）
    func drawCircle(float cx, float cy, float radius): bool {
        var segs = 64
        var pts  = segs + 1
        Ptr buf  = ffi.malloc(pts * 8)
        if buf == null { return false }
        var two_pi = 6.283185307
        for 0 : segs to i {
            var a = two_pi * _float(i) / _float(segs)
            ffi.write_float(buf, i * 8,     cx + radius * maths.cos(a))
            ffi.write_float(buf, i * 8 + 4, cy + radius * maths.sin(a))
        }
        var ok = _lib.SDL_RenderLines(handle, buf, pts)
        ffi.free(buf); return ok
    }

    // 填充实心圆形（逐行画线近似，保留小数半径并覆盖完整上下行）
    func fillCircle(float cx, float cy, float radius): bool {
        if radius <= 0.0 { return true }
        var r = _int(radius)
        var ok = true
        for 0 : (2 * r + 1) to i {
            var dy = _float(i - r)
            var inside = radius * radius - dy * dy
            if inside <= 0.0 { continue }
            var half = maths.sqrt(inside)
            if not drawLine(cx - half, cy + dy, cx + half, cy + dy) { ok = false }
        }
        return ok
    }

    // 批量绘制线段（pts 为 float 对数组，count 为点数）
    func drawLines(Ptr pts, int count): bool { return _lib.SDL_RenderLines(handle, pts, count) }

    // 批量绘制点
    func drawPoints(Ptr pts, int count): bool { return _lib.SDL_RenderPoints(handle, pts, count) }

    // 批量绘制矩形边框
    func drawRects(Ptr rects, int count): bool { return _lib.SDL_RenderRects(handle, rects, count) }

    // 批量填充矩形
    func fillRects(Ptr rects, int count): bool { return _lib.SDL_RenderFillRects(handle, rects, count) }

    // 设置渲染缩放（sx, sy 缩放因子）
    func setScale(float sx, float sy): bool { return _lib.SDL_SetRenderScale(handle, sx, sy) }

    // 设置混合模式：NONE=0, BLEND=1, ADD=2, MOD=4, MUL=8
    func setBlendMode(int mode): bool { return _lib.SDL_SetRenderDrawBlendMode(handle, mode) }

    // 设置裁剪矩形（只在此区域内绘制）
    func setClipRect(Ptr rect): bool { return _lib.SDL_SetRenderClipRect(handle, rect) }

    // 清除裁剪区域（恢复全屏绘制）
    func clearClip(): bool { return _lib.SDL_SetRenderClipRect(handle, null) }

    // 设置逻辑分辨率（坐标映射到 w×h，自动缩放）
    func setLogicalSize(int w, int h): bool { return _lib.SDL_SetRenderLogicalSize(handle, w, h) }

    // 设置视口区域
    func setViewport(Ptr rect): bool { return _lib.SDL_SetRenderViewport(handle, rect) }

    // 重置视口为全屏
    func resetViewport(): bool { return _lib.SDL_SetRenderViewport(handle, null) }

    // 在指定位置绘制纹理（按 w×h 缩放）
    func drawTextureAt(Ptr[u8] texture, float x, float y, float w, float h): bool {
        SDL_FRect rect = SDL_FRect.malloc()
        rect.x = x; rect.y = y; rect.w = w; rect.h = h
        bool ok = _lib.SDL_RenderTexture(handle, texture, null, rect.to_ptr())
        rect.free(); return ok
    }

    // 绘制纹理（指定源矩形和目标矩形，null 表示完整）
    func drawTextureRect(Ptr[u8] texture, Ptr srcrect, Ptr dstrect): bool {
        return _lib.SDL_RenderTexture(handle, texture, srcrect, dstrect)
    }

    // 绘制纹理的裁剪区域到目标位置
    // sx, sy, sw, sh: 源矩形；dx, dy, dw, dh: 目标矩形
    func drawTextureFromTo(Ptr[u8] texture,
                          float sx, float sy, float sw, float sh,
                          float dx, float dy, float dw, float dh): bool {
        SDL_FRect src = SDL_FRect.malloc()
        SDL_FRect dst = SDL_FRect.malloc()
        src.x = sx; src.y = sy; src.w = sw; src.h = sh
        dst.x = dx; dst.y = dy; dst.w = dw; dst.h = dh
        bool ok = _lib.SDL_RenderTexture(handle, texture, src.to_ptr(), dst.to_ptr())
        src.free(); dst.free()
        return ok
    }

    // 旋转+翻转绘制纹理
    // angle: 角度（度），顺时针；center: null 则绕目标中心旋转
    // flip: FLIP_NONE / FLIP_HORIZONTAL / FLIP_VERTICAL
    func drawTextureRotated(Ptr[u8] texture, float x, float y, float w, float h,
                            float angle, float cx, float cy, int flip): bool {
        SDL_FRect dst = SDL_FRect.malloc()
        dst.x = x; dst.y = y; dst.w = w; dst.h = h

        SDL_FPoint center = SDL_FPoint.malloc()
        center.x = cx; center.y = cy

        bool ok = _lib.SDL_RenderTextureRotated(handle, texture, null, dst.to_ptr(),
                                                  angle, center.to_ptr(), flip)
        dst.free(); center.free(); return ok
    }

    // 获取纹理尺寸，返回 {w, h}（浮点）
    func getTextureSize(Ptr[u8] texture): FSize {
        SDL_FPoint pt = SDL_FPoint.malloc()
        _lib.SDL_GetTextureSize(texture, &pt.x, &pt.y)
        var d = {w: pt.x as float, h: pt.y as float}
        pt.free(); return d
    }

    // 便捷绘制文字（创建纹理→绘制→销毁一步完成）
    func drawText(Font f, string text, float x, float y, int r, int g, int b) {
        TextTexture tex = font.createTextTexture(handle, f, text, r, g, b)
        if tex.ok { drawTextureAt(tex.texture, x, y, tex.width, tex.height); tex.destroy() }
    }

    // 居中绘制文字（在 [x, x+w] 范围内水平居中）
    func drawTextCentered(Font f, string text, float x, float w, float y, int r, int g, int b) {
        var ms = f.measureString(text)
        float cx = x + (w - _float(ms.w)) / 2.0
        drawText(f, text, cx, y, r, g, b)
    }

    // 便捷版：使用 [r, g, b] 数组传色（可预定义颜色变量复用）
    func drawTextRgb(Font f, string text, float x, float y, Array c) {
        drawText(f, text, x, y, _int(c[0]), _int(c[1]), _int(c[2]))
    }

    func drawTextCenteredRgb(Font f, string text, float x, float w, float y, Array c) {
        drawTextCentered(f, text, x, w, y, _int(c[0]), _int(c[1]), _int(c[2]))
    }

    // 设置背景色并清屏（setColor + clear 一步完成）
    func clearColor(int r, int g, int b, int a) {
        setColor(r, g, b, a); clear()
    }

    // 渲染到纹理（null 恢复渲染到窗口）
    func setRenderTarget(Ptr[u8] texture): bool {
        return _lib.SDL_SetRenderTarget(handle, texture)
    }

    // 设置纹理透明度调制（0~255）
    func setTextureAlpha(Ptr[u8] texture, int alpha): bool {
        return _lib.SDL_SetTextureAlphaMod(texture, alpha)
    }

    // 设置纹理颜色调制（RGB 0~255）
    func setTextureColor(Ptr[u8] texture, int r, int g, int b): bool {
        return _lib.SDL_SetTextureColorMod(texture, r, g, b)
    }

    // 强制刷新渲染命令
    func flush(): bool {
        return _lib.SDL_FlushRenderer(handle)
    }

    // 截取当前渲染画面
    func readPixels(Ptr rect): Ptr[u8] {
        return _lib.SDL_RenderReadPixels(handle, rect) as Ptr[u8]
    }

    // 截取当前渲染画面（便捷重载：直接传入 x, y, w, h）
    func readPixelsAt(int x, int y, int w, int h): Ptr[u8] {
        SDL_Rect rect = SDL_Rect.malloc()
        rect.x = x; rect.y = y; rect.w = w; rect.h = h
        var surface = _lib.SDL_RenderReadPixels(handle, rect.to_ptr())
        rect.free()
        return surface
    }

    // 创建纹理（返回 Ptr，用完 SDL_DestroyTexture）
    func createTexture(int format, int access, int w, int h): Ptr[u8] {
        return _lib.SDL_CreateTexture(handle, format, access, w, h) as Ptr[u8]
    }

    // 更新纹理像素数据
    func updateTexture(Ptr[u8] texture, Ptr rect, Ptr pixels, int pitch): bool {
        return _lib.SDL_UpdateTexture(texture, rect, pixels, pitch)
    }

    // 锁定/解锁纹理以直接操作像素（需 TEXTUREACCESS_STREAMING）
    func lockTexture(Ptr[u8] texture, Ptr rect): bool {
        return _lib.SDL_LockTexture(texture, rect, null, null)
    }
    func unlockTexture(Ptr[u8] texture) {
        _lib.SDL_UnlockTexture(texture)
    }

    // 设置颜色缩放（HDR/亮度调节，不影响 alpha）
    func setColorScale(float scale): bool {
        return _lib.SDL_SetRenderColorScale(handle, scale)
    }

    // 九宫格渲染（UI 边框不拉伸）
    func drawTexture9Grid(Ptr[u8] texture, float lw, float rw, float th, float bh, float scale, Ptr dst): bool {
        return _lib.SDL_RenderTexture9Grid(handle, texture, null, lw, rw, th, bh, scale, dst)
    }

    // 平铺渲染
    func drawTextureTiled(Ptr[u8] texture, float scale, Ptr dst): bool {
        return _lib.SDL_RenderTextureTiled(handle, texture, null, scale, dst)
    }

    // 几何渲染（三角形/多边形），vertices 为 SDL_Vertex 数组 to_ptr()
    func drawGeometry(Ptr vertices, int count, Ptr indices, int idxCount): bool {
        return _lib.SDL_RenderGeometry(handle, null, vertices, count, indices, idxCount)
    }

    // 绘制三角形（单色填充，支持旋转和缩放）→ 每顶点独立颜色见 drawTriangleGradient
    func drawTriangle(float cx, float cy, float size, float angle, float r, float g, float b, float a): bool {
        float rad = angle * 3.14159265 / 180.0
        float c = maths.cos(rad); float s = maths.sin(rad)

        float p0x = c * 0.0  - s * (-size) + cx
        float p0y = s * 0.0  + c * (-size) + cy
        float p1x = c * size - s * size   + cx
        float p1y = s * size + c * size   + cy
        float p2x = c * (-size) - s * size + cx
        float p2y = s * (-size) + c * size + cy

        var verts = SDL_Vertex.malloc_array(3)
        verts[0].x = p0x; verts[0].y = p0y
        verts[0].r = r; verts[0].g = g; verts[0].b = b; verts[0].a = a
        verts[1].x = p1x; verts[1].y = p1y
        verts[1].r = r; verts[1].g = g; verts[1].b = b; verts[1].a = a
        verts[2].x = p2x; verts[2].y = p2y
        verts[2].r = r; verts[2].g = g; verts[2].b = b; verts[2].a = a

        var ok = _lib.SDL_RenderGeometry(handle, null, verts.to_ptr(), 3, null, 0)
        verts.free(); return ok
    }

    // 绘制渐变三角形（每个顶点可独立设色）
    func drawTriangleGradient(float cx, float cy, float size, float angle,
                               float r0, float g0, float b0, float a0,
                               float r1, float g1, float b1, float a1,
                               float r2, float g2, float b2, float a2): bool {
        float rad = angle * 3.14159265 / 180.0
        float c = maths.cos(rad); float s = maths.sin(rad)

        float p0x = c * 0.0  - s * (-size) + cx
        float p0y = s * 0.0  + c * (-size) + cy
        float p1x = c * size - s * size   + cx
        float p1y = s * size + c * size   + cy
        float p2x = c * (-size) - s * size + cx
        float p2y = s * (-size) + c * size + cy

        var verts = SDL_Vertex.malloc_array(3)
        verts[0].x = p0x; verts[0].y = p0y
        verts[0].r = r0; verts[0].g = g0; verts[0].b = b0; verts[0].a = a0
        verts[1].x = p1x; verts[1].y = p1y
        verts[1].r = r1; verts[1].g = g1; verts[1].b = b1; verts[1].a = a1
        verts[2].x = p2x; verts[2].y = p2y
        verts[2].r = r2; verts[2].g = g2; verts[2].b = b2; verts[2].a = a2

        var ok = _lib.SDL_RenderGeometry(handle, null, verts.to_ptr(), 3, null, 0)
        verts.free(); return ok
    }

    // 填充圆角矩形（使用当前绘制颜色）→ 单次 alloc + 单次 Geometry 提交
    func fillRoundedRect(float x, float y, float w, float h, float r): bool {
        if r <= 0.0 { return fillRect(x, y, w, h) }
        if r > w * 0.5 { r = w * 0.5 }
        if r > h * 0.5 { r = h * 0.5 }

        // 直边区域（3 个矩形批量填充）
        fillRect(x + r, y, w - 2.0 * r, h)
        fillRect(x, y + r, r, h - 2.0 * r)
        fillRect(x + w - r, y + r, r, h - 2.0 * r)

        // 动态分段：小半径减段数
        var segs = 16
        if r > 32.0 { segs = 32 }
        if r > 64.0 { segs = 48 }

        // 获取当前颜色
        var col = getColorFloat()
        float cr = col.r; float cg = col.g; float cb = col.b; float ca = col.a

        var half_pi = 1.57079633
        var v_per_corner = 3 * segs  // 每个角需要的顶点数（segs 个三角形 × 3 顶点）
        var vcnt = 4 * v_per_corner // 四个角总顶点数
        var verts = SDL_Vertex.malloc_array(vcnt)

        // 一次性生成四个角的三角扇顶点
        for 0 : 3 to ci {
            float cx, cy, sa
            switch ci {
                case 0 { cx = x + r; cy = y + r; sa = half_pi * 2.0 }               // 左上 π→3π/2
                case 1 { cx = x + w - r; cy = y + r; sa = half_pi * 3.0 }           // 右上 3π/2→2π
                case 2 { cx = x + w - r; cy = y + h - r; sa = 0.0 }                 // 右下 0→π/2
                case 3 { cx = x + r; cy = y + h - r; sa = half_pi }                 // 左下 π/2→π
            }

            var step = half_pi / _float(segs)
            for 0 : segs - 1 to i {
                var a1 = sa + step * _float(i)
                var a2 = sa + step * _float(i + 1)
                var vi = ci * v_per_corner + i * 3
                verts[vi].x = cx; verts[vi].y = cy
                verts[vi].r = cr; verts[vi].g = cg; verts[vi].b = cb; verts[vi].a = ca
                verts[vi+1].x = cx + r * maths.cos(a1); verts[vi+1].y = cy + r * maths.sin(a1)
                verts[vi+1].r = cr; verts[vi+1].g = cg; verts[vi+1].b = cb; verts[vi+1].a = ca
                verts[vi+2].x = cx + r * maths.cos(a2); verts[vi+2].y = cy + r * maths.sin(a2)
                verts[vi+2].r = cr; verts[vi+2].g = cg; verts[vi+2].b = cb; verts[vi+2].a = ca
            }
        }
        // 单次几何提交：四个角所有三角形
        var ok = _lib.SDL_RenderGeometry(handle, null, verts.to_ptr(), vcnt, null, 0)
        verts.free(); return ok
    }

    // 绘制圆角矩形边框（使用当前绘制颜色）
    func drawRoundedRect(float x, float y, float w, float h, float r): bool {
        if r <= 0.0 { return drawRect(x, y, w, h) }
        if r > w * 0.5 { r = w * 0.5 }
        if r > h * 0.5 { r = h * 0.5 }

        // 动态分段
        var segs = 16
        if r > 32.0 { segs = 32 }

        var pts = segs + 1; var half_pi = 1.57079633
        var total = 4 * pts + 1  // 4 圆弧 + 闭合左直边
        Ptr buf = ffi.malloc(total * 8)
        if buf == null { return false }

        // 一次性写入 4 个圆角弧的连续顶点
        for 0 : 3 to ci {
            float cx, cy, sa
            switch ci {
                case 0 { cx = x + r; cy = y + r; sa = half_pi * 2.0 }               // 左上
                case 1 { cx = x + w - r; cy = y + r; sa = half_pi * 3.0 }           // 右上
                case 2 { cx = x + w - r; cy = y + h - r; sa = 0.0 }                 // 右下
                case 3 { cx = x + r; cy = y + h - r; sa = half_pi }                 // 左下
            }

            var step = half_pi / _float(segs)
            for 0 : segs to i {
                var a = sa + step * _float(i)
                var off = (ci * pts + i) * 8
                ffi.write_float(buf, off,     cx + r * maths.cos(a))
                ffi.write_float(buf, off + 4, cy + r * maths.sin(a))
            }
        }
        // 闭合左直边：左下弧终点 (x, y+h-r) → 左上弧起点 (x, y+r)
        ffi.write_float(buf, (4 * pts) * 8,     x)
        ffi.write_float(buf, (4 * pts) * 8 + 4, y + r)

        var ok = _lib.SDL_RenderLines(handle, buf, total)
        ffi.free(buf); return ok
    }
}

// 创建渲染器实例
export func createRenderer(Ptr[u8] window): Renderer {
    Renderer ren = new Renderer(); ren.initDefault(window); return ren
}