// sdl_renderer.leno — SDL3 渲染器封装
import ffi
import maths
import "sdl_core.leno" as core
use core.sdl3
use core.SDL_FRect

// 本地缓存 core.lib()，避免每次渲染调用都走函数链路
sdl3 _lib = null
func _l(): sdl3 { if _lib == null { _lib = core.lib() } return _lib }

export struct Renderer {
    Ptr handle; bool ok

    func initDefault(Ptr window): bool {
        handle = _l().SDL_CreateRenderer(window, null as string) as Ptr
        ok = handle != null
        return ok
    }

    func destroy() {
        if ok { _l().SDL_DestroyRenderer(handle); handle = null; ok = false }
    }

    func clear(): bool   { return _l().SDL_RenderClear(handle) != 0 }
    func present(): bool { return _l().SDL_RenderPresent(handle) != 0 }

    func setColor(int r, int g, int b, int a): bool {
        return _l().SDL_SetRenderDrawColor(handle, r, g, b, a) != 0
    }

    func setColorFloat(float r, float g, float b, float a): bool {
        return _l().SDL_SetRenderDrawColorFloat(handle, r, g, b, a) != 0
    }

    func fillRect(float x, float y, float w, float h): bool {
        var rect = SDL_FRect.malloc()
        rect.x = x; rect.y = y; rect.w = w; rect.h = h
        var result = _l().SDL_RenderFillRect(handle, rect.to_ptr()) != 0
        rect.free(); return result
    }

    func fillRectPtr(Ptr rect): bool {
        return _l().SDL_RenderFillRect(handle, rect) != 0
    }

    func fillFull(): bool {
        return _l().SDL_RenderFillRect(handle, null) != 0
    }

    func drawRect(float x, float y, float w, float h): bool {
        var rect = SDL_FRect.malloc()
        rect.x = x; rect.y = y; rect.w = w; rect.h = h
        var result = _l().SDL_RenderRect(handle, rect) != 0
        rect.free(); return result
    }

    func drawLine(float x1, float y1, float x2, float y2): bool {
        return _l().SDL_RenderLine(handle, x1, y1, x2, y2) != 0
    }

    func drawPoint(float x, float y): bool {
        return _l().SDL_RenderPoint(handle, x, y) != 0
    }

    func setVSync(int mode): bool {
        return _l().SDL_SetRenderVSync(handle, mode) != 0
    }

    func drawCircle(float cx, float cy, float radius): bool {
        var segs = 64
        var pts  = segs + 1
        var buf  = ffi.malloc(pts * 8)
        if buf == null { return false }
        var two_pi = 6.283185307
        for 0 : segs to i {
            var a = two_pi * _float(i) / _float(segs)
            ffi.write_float(buf, i * 8,     cx + radius * maths.cos(a))
            ffi.write_float(buf, i * 8 + 4, cy + radius * maths.sin(a))
        }
        var ok = _l().SDL_RenderLines(handle, buf, pts) != 0
        ffi.free(buf); return ok
    }

    func fillCircle(float cx, float cy, float radius): bool {
        var ok = true; var r = _int(radius)
        for 0 : r * 2 to i {
            var dy = i - r
            var half = maths.sqrt(radius * radius - _float(dy * dy))
            if not drawLine(cx - half, cy + _float(dy), cx + half, cy + _float(dy)) { ok = false }
        }
        return ok
    }

    func drawLines(Ptr pts, int count): bool {
        return _l().SDL_RenderLines(handle, pts, count) != 0
    }

    func drawPoints(Ptr pts, int count): bool {
        return _l().SDL_RenderPoints(handle, pts, count) != 0
    }

    func drawRects(Ptr rects, int count): bool {
        return _l().SDL_RenderRects(handle, rects, count) != 0
    }

    func fillRects(Ptr rects, int count): bool {
        return _l().SDL_RenderFillRects(handle, rects, count) != 0
    }

    func setScale(float sx, float sy): bool {
        return _l().SDL_SetRenderScale(handle, sx, sy) != 0
    }

    func setBlendMode(int mode): bool {
        return _l().SDL_SetRenderDrawBlendMode(handle, mode) != 0
    }

    func setClipRect(Ptr rect): bool {
        return _l().SDL_SetRenderClipRect(handle, rect) != 0
    }

    func clearClip(): bool {
        return _l().SDL_SetRenderClipRect(handle, null) != 0
    }

    func setLogicalSize(int w, int h): bool {
        return _l().SDL_SetRenderLogicalSize(handle, w, h) != 0
    }

    func setViewport(Ptr rect): bool {
        return _l().SDL_SetRenderViewport(handle, rect) != 0
    }

    func resetViewport(): bool {
        return _l().SDL_SetRenderViewport(handle, null) != 0
    }

    func drawTextureAt(Ptr texture, float x, float y, float w, float h): bool {
        var rect = SDL_FRect.malloc()
        rect.x = x; rect.y = y; rect.w = w; rect.h = h
        var ok = _l().SDL_RenderTexture(handle, texture, null, rect.to_ptr()) != 0
        rect.free(); return ok
    }

    func drawTextureRect(Ptr texture, Ptr srcrect, Ptr dstrect): bool {
        return _l().SDL_RenderTexture(handle, texture, srcrect, dstrect) != 0
    }
}

export func createRenderer(Ptr window): Renderer {
    var ren = new Renderer(); ren.initDefault(window); return ren
}
