// sdl_renderer.leno — SDL3 渲染器封装
// 封装 SDL_Renderer 的绘制、颜色、纹理等操作
import ffi
import maths
import "sdl_core.leno" as core
import "sdl_font.leno" as font
use core.(sdl3, SDL_FRect, SDL_Color, SDL_FColor, SDL_FPoint, SDL_Point, SDL_Rect, SDL_Vertex, Color, FColor, Size, FSize, ScaleMode)
use font.(Font, TextTexture)

// 模块加载时一次性初始化 DLL，后续直接用 _lib
sdl3 _lib = core.lib()

// 批处理统计（性能分析 / 测试用，模块级全局；单渲染器场景精确）
// Submits = 提交 SDL 批量调用的次数；Batched = 累计经批处理提交的图元数
int _gFillSubmits = 0, _gFillBatched = 0
int _gOutSubmits = 0, _gOutBatched = 0
int _gLineSubmits = 0, _gLineBatched = 0

// 批处理统计对外接口（模块级全局函数，避免依赖 struct 方法跨模块可见性）
export func getBatchFillSubmits(): int { return _gFillSubmits }
export func getBatchFillBatched(): int { return _gFillBatched }
export func getBatchOutSubmits(): int { return _gOutSubmits }
export func getBatchOutBatched(): int { return _gOutBatched }
export func getBatchLineSubmits(): int { return _gLineSubmits }
export func getBatchLineBatched(): int { return _gLineBatched }

// 调试：暴露行批处理缓冲，供坐标级回归测试直接读回 float 比对（前缀 _dbg，验证后可删除）
export func _dbgLinePtr(Renderer r): Ptr[f32] { return r._bxLine }
export func _dbgLineCount(Renderer r): int { return r._bxLineN }

// ==================== PixelBuffer（逐像素直写，对标 surface.set_at） ====================
// 自己管理一块 RGBA8888 像素内存（SDL3 little-endian 内存字节序 = [A,B,G,R]，即 u32 = (r<<24)|(g<<16)|(b<<8)|a），
// 逐点 ffi.write_int 写内存（无 SDL 调用开销），整帧一次性上传纹理绘制。
// 用途：烟花/粒子/分形/画板等需要海量逐点绘制的场景，性能远超逐点 SDL_RenderPoint。
export struct PixelBuffer {
    Ptr[u8] pixels   // 像素内存（ffi.malloc，w*h*4 字节）
    int w; int h     // 尺寸
    int pitch        // 每行字节数 = w*4
    bool ok

    // 创建像素缓冲（w,h 为宽高），失败返回 ok=false
    func init(int w_, int h_): bool {
        w = w_; h = h_; pitch = w * 4
        pixels = ffi.malloc(w * h * 4)
        ok = pixels != null
        return ok
    }
    // 释放内存
    func free() { if pixels != null { ffi.free(pixels); pixels = null; ok = false } }

    // 整块填充单色（r,g,b,a 0~255）
    func fill(int r, int g, int b, int a) {
        // 全 0（透明黑）用 memset 一次清零，比逐像素 write_int 快一个量级
        if r == 0 and g == 0 and b == 0 and a == 0 {
            ffi.memset(pixels, 0, w * h * 4)
            return
        }
        int color = (r << 24) | (g << 16) | (b << 8) | a
        var total = w * h
        for 0 : total - 1 to i {
            ffi.write_int(pixels, i * 4, color)
        }
    }
    // 整块清零（全透明黑），用 memset 极快
    func clear() { ffi.memset(pixels, 0, w * h * 4) }
    // 从另一个像素缓冲整块拷贝（尺寸需一致），用 memcpy 极快
    func fillCopy(PixelBuffer src) {
        ffi.memcpy(pixels, src.pixels, w * h * 4)
    }
    // 写单个像素（越界安全：超出则忽略），对标 Python 的 surface.set_at
    func setPixel(int x, int y, int r, int g, int b, int a) {
        if 0 <= x and x < w and 0 <= y and y < h {
            ffi.write_int(pixels, (y * pitch + x * 4), (r << 24) | (g << 16) | (b << 8) | a)
        }
    }
    // 读回单个像素的 R 通道（0~255；越界返回 0）。常用于把灰度/亮度掩码存进 R 通道再读回上色。
    // 像素布局 [A,B,G,R]，R 在最高字节（offset+3）
    func getR(int x, int y): int {
        if 0 <= x and x < w and 0 <= y and y < h {
            return ffi.read_byte(pixels, y * pitch + x * 4 + 3)
        }
        return 0
    }
}

export struct Renderer {
    // ==================== 关联常量 ====================
    const BX_EMPTY  = 0   // 批处理空闲
    const BX_FILL   = 1   // 批处理填充矩形
    const BX_STROKE = 2   // 批处理描边矩形
    const BX_LINE   = 3   // 批处理线段

    Ptr[u8] handle; bool ok
    // 超采样抗锯齿（SSAA）：整帧渲染到 scale 倍离屏纹理，再以 1x 缩放贴回窗口得到平滑边缘
    Ptr[u8] _ssaaTex; float _ssaaScale; int _ssaaWinW; int _ssaaWinH; bool _ssaa
    // PixelBuffer 复用纹理（懒创建）：blitBuffer 上传用，尺寸匹配时复用
    Ptr[u8] _pixTex; int _pixTexW; int _pixTexH

    // ---- 批处理缓冲：透明自动合并连续同材质 fillRect/drawRect/drawLine ----
    Ptr[f32] _bxFill; int _bxFillN, _bxFillCap
    Ptr[f32] _bxOut;  int _bxOutN, _bxOutCap
    Ptr[f32] _bxLine; int _bxLineN, _bxLineCap
    int _bxCur            // 批处理状态（BX_EMPTY/FILL/STROKE/LINE，切换即 flush 保序）
    int _bxR, _bxG, _bxB, _bxA
    bool _bxIsFloat
    float _bxFr, _bxFg, _bxFb, _bxFa
    int _bxBlend
    Ptr[u8] _bxClipPtr 
    bool _bxClip, _bxClipOwned  // _bxClipOwned：_bxClipPtr 是否由我们 alloc（需 free）
    // 裁剪栈：每个入口存储 {ptr: Ptr[u8], owned: bool}
    Array[Ptr[u8]] _clipStack
    Array[bool]    _clipStackOwned
    Ptr[u8] _bxTarget
    float _bxSx, _bxSy, _bxCScale

    // 创建默认渲染器（关联到窗口）
    func initDefault(Ptr[u8] window): bool {
        // 说明：SDL3 的 2D 渲染 API 本身不支持图元抗锯齿，
        // SDL_HINT_RENDER_LINE_METHOD="2" 只是切换为 driver 线算法，并不产生 AA。
        // 真正的抗锯齿靠 enableSSAA()（超采样：渲染到 2x 离屏纹理再降采样贴回）。
        _lib.SDL_SetHint("SDL_HINT_RENDER_DRIVER", "direct3d")
        _lib.SDL_SetHint("SDL_HINT_RENDER_LINE_METHOD", "2")
        handle = _lib.SDL_CreateRenderer(window, null as string)
        ok = handle != null
        if ok {
            // ★ 设置默认混合模式为 BLEND（SDL3 创建渲染器后默认为 NONE，alpha 被忽略）
            // 若保持 NONE，按钮阴影 setColor(0,0,0,40) 的 alpha=40 会被丢弃→纯黑，
            // 阴影偏移 2px 在右下角露出两条纯黑线条（而非预期的半透明灰色阴影）。
            // 同理影响所有带 alpha 的图元绘制（边框 alpha、tooltip 半透明背景等）。
            _lib.SDL_SetRenderDrawBlendMode(handle, core.BlendMode.BLEND)
            // 批处理状态快照复位为 SDL 默认绘制状态
            _bxR = 255; _bxG = 255; _bxB = 255; _bxA = 255; _bxIsFloat = false
            _bxFr = 1.0; _bxFg = 1.0; _bxFb = 1.0; _bxFa = 1.0
            _bxBlend = core.BlendMode.BLEND; _bxClip = false; _bxClipPtr = null; _bxClipOwned = false; _bxTarget = null
            _clipStack = []; _clipStackOwned = []
            _bxSx = 1.0; _bxSy = 1.0; _bxCScale = 1.0; _bxCur = BX_EMPTY
            _pixTex = null; _pixTexW = 0; _pixTexH = 0
            _gFillSubmits = 0; _gFillBatched = 0
            _gOutSubmits = 0;  _gOutBatched = 0
            _gLineSubmits = 0; _gLineBatched = 0
            // 预分配批处理缓冲（ffi 连续内存）：fill/out 各 2048 个矩形，line 8192 个点
            _bxFillCap = 2048; _bxFill = ffi.malloc(_bxFillCap * 16)
            _bxOutCap  = 2048; _bxOut  = ffi.malloc(_bxOutCap * 16)
            _bxLineCap = 4096; _bxLine = ffi.malloc(_bxLineCap * 16)
            _bxFillN = 0; _bxOutN = 0; _bxLineN = 0
        }
        return ok
    }

    // 销毁渲染器，释放资源
    func destroy() {
        if ok {
            _flushBatches()
            // 释放裁剪栈里残留的 rect
            for _clipStack.len() to i {
                if _clipStackOwned[i] and _clipStack[i] != null { ffi.free(_clipStack[i]) }
            }
            _clipStack.clear(); _clipStackOwned.clear()
            // 释放当前裁剪 rect（如果由我们拥有）
            if _bxClipOwned and _bxClipPtr != null { ffi.free(_bxClipPtr); _bxClipOwned = false }
            _bxClip = false; _bxClipPtr = null
            if _bxFill != null { ffi.free(_bxFill); _bxFill = null }
            if _bxOut != null { ffi.free(_bxOut); _bxOut = null }
            if _bxLine != null { ffi.free(_bxLine); _bxLine = null }
            if _ssaaTex != null { _lib.SDL_DestroyTexture(_ssaaTex); _ssaaTex = null }
            if _pixTex != null { _lib.SDL_DestroyTexture(_pixTex); _pixTex = null }
            // 渲染器销毁前：先使字体库中由本渲染器创建的纹理缓存失效。
            // 否则销毁后这些纹理悬空，SDL 复用同一指针再建渲染器时会命中失效纹理 → 字体不显示。
            font.invalidateRendererTextures(handle)
            _lib.SDL_DestroyRenderer(handle); handle = null; ok = false
        }
    }

    // 清空渲染目标（用当前颜色填充整个画面）
    // SSAA 开启时：清的是离屏高分辨率纹理，并把坐标缩放切到 scale
    func clear(): bool {
        _flushBatches()
        if _ssaa { setRenderTarget(_ssaaTex); setScale(_ssaaScale, _ssaaScale) }
        return _lib.SDL_RenderClear(handle)
    }

    // 呈现渲染结果到屏幕（交换缓冲区）
    // SSAA 开启时：把高分辨率离屏纹理以 1x 缩放贴回窗口，GPU 双线性降采样 -> 平滑边缘
    func present(): bool {
        _flushBatches()
        if _ssaa {
            setRenderTarget(null)
            setScale(1.0, 1.0)
            SDL_FRect dst = SDL_FRect.malloc()
            dst.x = 0.0; dst.y = 0.0; dst.w = _ssaaWinW; dst.h = _ssaaWinH
            _lib.SDL_RenderTexture(handle, _ssaaTex, null, dst.to_ptr())
            dst.free()
        }
        return _lib.SDL_RenderPresent(handle)
    }

    // 开启超采样抗锯齿：把整帧渲染到 scale 倍离屏纹理，再以 1x 缩放贴回窗口
    // scale 建议 2.0（=4x 像素，兼顾画质与性能）；纹理创建失败则自动回退普通渲染
    func enableSSAA(int winW, int winH, float scale): bool {
        if scale <= 0.0 { return false }
        int tw = _int(winW * scale)
        int th = _int(winH * scale)
        if tw <= 0 or th <= 0 { return false }
        // SDL_TEXTUREACCESS_TARGET = 2
        Ptr[u8] tex = createTexture(core.PIXELFORMAT_RGBA8888, 2, tw, th)
        if tex == null {
            print("[LenoSDL3] SSAA 离屏纹理创建失败，回退普通渲染")
            return false
        }
        // ★ 关键：显式设置线性缩放模式，确保降采样时 GPU 使用双线性插值平滑边缘
        _lib.SDL_SetTextureScaleMode(tex, core.ScaleMode.LINEAR)
        _ssaaTex = tex
        _ssaaScale = scale
        _ssaaWinW = winW; _ssaaWinH = winH
        _ssaa = true
        setRenderTarget(_ssaaTex)
        setScale(scale, scale)
        return true
    }

    // 窗口缩放时重建离屏 SSAA 纹理，使其匹配新的逻辑尺寸（否则内容只覆盖旧尺寸区域）
    // 仅 SSAA 开启时有效；非 SSAA（直接绘制到窗口）由 SDL 自动跟随窗口，无需处理
    func resizeSSAA(int newW, int newH): bool {
        if not _ssaa { return false }
        if newW <= 0 or newH <= 0 { return false }
        int tw = _int(newW * _ssaaScale)
        int th = _int(newH * _ssaaScale)
        if tw <= 0 or th <= 0 { return false }
        Ptr[u8] tex = createTexture(core.PIXELFORMAT_RGBA8888, 2, tw, th)
        if tex == null { return false }
        _lib.SDL_SetTextureScaleMode(tex, core.ScaleMode.LINEAR)   // 重建纹理也需设置线性缩放
        if _ssaaTex != null { _lib.SDL_DestroyTexture(_ssaaTex) }
        _ssaaTex = tex
        _ssaaWinW = newW; _ssaaWinH = newH
        setRenderTarget(_ssaaTex)
        setScale(_ssaaScale, _ssaaScale)
        return true
    }

    // ★ 帧开始：SSAA 开启时，重新设置渲染目标到离屏纹理 + 设置缩放
    // present() 每帧执行后会重置渲染目标为 null（窗口）和缩放为 1.0，
    // 下一帧开始前必须重新切回 SSAA 离屏纹理，否则所有绘制直接画到窗口、SSAA 失效。
    // 窗口主循环在每帧绘制前调用此方法。
    func beginFrame() {
        if _ssaa {
            _flushBatches()
            setRenderTarget(_ssaaTex)
            setScale(_ssaaScale, _ssaaScale)
        }
    }

    // 返回当前 SSAA 倍数（未真正开启/回退为 0.0）；供控件将字体测量与 SSAA 渲染对齐
    func getSSAA(): float { return if _ssaa then _ssaaScale else 0.0 }

    // 把逻辑坐标吸附到 SSAA 物理整数像素边界（physical = logical*scale 取整），
    // 避免文字/图元在亚像素位置被双线性重采样导致的发虚与滚动抖动；
    // 各互相对齐的偏移量均为整数倍 1/scale，独立吸附后仍严格对齐。
    func snapX(float v): float {
        if _ssaa and _ssaaScale > 0.0 {
            float p = v * _ssaaScale
            float rp = _int(p + 0.5)
            if p < 0.0 { rp = _int(p - 0.5) }
            return rp / _ssaaScale
        }
        return v
    }
    func snapY(float v): float {
        if _ssaa and _ssaaScale > 0.0 {
            float p = v * _ssaaScale
            float rp = _int(p + 0.5)
            if p < 0.0 { rp = _int(p - 0.5) }
            return rp / _ssaaScale
        }
        return v
    }


    // 设置绘制颜色（#RRGGBBAA 打包整数，Alpha 在最高字节）
    func setColor(Color color): bool {
        int aa = (color >> 24) & 0xFF
        int rr = (color >> 16) & 0xFF
        int gg = (color >> 8) & 0xFF
        int bb = color & 0xFF
        if not _bxIsFloat and rr == _bxR and gg == _bxG and bb == _bxB and aa == _bxA {
            return true
        }
        _flushBatches()
        _bxIsFloat = false; _bxR = rr; _bxG = gg; _bxB = bb; _bxA = aa
        return _lib.SDL_SetRenderDrawColor(handle, rr, gg, bb, aa)
    }

    // 设置绘制颜色（浮点 RGBA，0.0~1.0；a 默认完全不透明）
    func setColorFloat(float r, float g, float b, float a = 1.0): bool {
        if _bxIsFloat and r == _bxFr and g == _bxFg and b == _bxFb and a == _bxFa {
            return true
        }
        _flushBatches()
        _bxIsFloat = true; _bxFr = r; _bxFg = g; _bxFb = b; _bxFa = a
        return _lib.SDL_SetRenderDrawColorFloat(handle, r, g, b, a)
    }

    // 获取当前绘制颜色（打包为 0xAARRGGBB 整数）
    func getColor(): Color {
        SDL_Color c = SDL_Color.malloc()
        _lib.SDL_GetRenderDrawColor(handle, &c.r, &c.g, &c.b, &c.a)
        Color d = (c.a << 24) | (c.r << 16) | (c.g << 8) | c.b
        c.free(); return d
    }

    // 获取当前绘制颜色（浮点 RGBA）
    func getColorFloat(): [float, float, float, float] {
        SDL_FColor c = SDL_FColor.malloc()
        _lib.SDL_GetRenderDrawColorFloat(handle, &c.r, &c.g, &c.b, &c.a)
        var r = c.r; var g = c.g; var b = c.b; var a = c.a
        c.free(); return r, g, b, a
    }

    // 获取渲染器输出尺寸
    func getOutputSize(): [int, int] {
        SDL_Point pt = SDL_Point.malloc()
        _lib.SDL_GetRenderOutputSize(handle, &pt.x, &pt.y)
        var w = pt.x; var h = pt.y
        pt.free(); return w, h
    }

    // 填充矩形（x, y, w, h）—— 透明自动批处理：同材质连续调用合并为一次 SDL_RenderFillRects
    func fillRect(float x, float y, float w, float h): bool {
        if _bxFill == null { return _emitFill(x, y, w, h) }
        if _bxCur != BX_EMPTY and _bxCur != BX_FILL { _flushBatches() }
        if _bxFillN >= _bxFillCap { _flushBatches() }
        int off = _bxFillN * 16
        ffi.write_float(_bxFill, off,      x)
        ffi.write_float(_bxFill, off + 4,  y)
        ffi.write_float(_bxFill, off + 8,  w)
        ffi.write_float(_bxFill, off + 12, h)
        _bxFillN = _bxFillN + 1
        _bxCur = BX_FILL
        return true
    }

    // 填充矩形（传入 SDL_FRect 指针，避免重复创建）—— 立即提交
    func fillRectPtr(Ptr[u8] rect): bool {
        _flushBatches()
        return _lib.SDL_RenderFillRect(handle, rect)
    }

    // 填充整个渲染目标（传 null 给 SDL 即表示全屏）—— 立即提交
    func fillFull(): bool {
        _flushBatches()
        return _lib.SDL_RenderFillRect(handle, null)
    }

    // 绘制矩形边框（x, y, w, h）—— 透明自动批处理：同材质连续调用合并为一次 SDL_RenderRects
    func drawRect(float x, float y, float w, float h): bool {
        if _bxOut == null { return _emitRect(x, y, w, h) }
        if _bxCur != BX_EMPTY and _bxCur != BX_STROKE { _flushBatches() }
        if _bxOutN >= _bxOutCap { _flushBatches() }
        int off = _bxOutN * 16
        ffi.write_float(_bxOut, off,      x)
        ffi.write_float(_bxOut, off + 4,  y)
        ffi.write_float(_bxOut, off + 8,  w)
        ffi.write_float(_bxOut, off + 12, h)
        _bxOutN = _bxOutN + 1
        _bxCur = BX_STROKE
        return true
    }

    // 绘制线段（x1, y1）→（x2, y2）—— 透明自动批处理：连续调用先收集进 _bxLine，
    // 刷新时逐条 SDL_RenderLine 提交（避免连续折线把独立线段连成斜线）
    func drawLine(float x1, float y1, float x2, float y2): bool {
        if _bxLine == null { return _emitLine(x1, y1, x2, y2) }
        if _bxCur != BX_EMPTY and _bxCur != BX_LINE { _flushBatches() }
        if _bxLineN >= _bxLineCap { _flushBatches() }
        int off = _bxLineN * 16
        ffi.write_float(_bxLine, off,      x1)
        ffi.write_float(_bxLine, off + 4,  y1)
        ffi.write_float(_bxLine, off + 8,  x2)
        ffi.write_float(_bxLine, off + 12, y2)
        _bxLineN = _bxLineN + 1
        _bxCur = BX_LINE
        return true
    }

    // 绘制点（x, y）—— 立即提交（点通常不批量，且需在后续图元前生效）
    func drawPoint(float x, float y): bool {
        _flushBatches()
        return _lib.SDL_RenderPoint(handle, x, y)
    }

    // 设置垂直同步模式：0=关闭, 1=开启, -1=自适应
    func setVSync(int mode): bool {
        return _lib.SDL_SetRenderVSync(handle, mode)
    }

    // 绘制圆形边框（cx, cy 圆心，radius 半径，64 段逼近）
    func drawCircle(float cx, float cy, float radius): bool {
        _flushBatches()
        var segs = 64
        var pts  = segs + 1
        Ptr[f32] buf  = ffi.malloc(pts * 8)
        if buf == null { return false }
        var two_pi = 6.283185307
        for 0 : segs to i {
            var a = two_pi * i / _float(segs)
            ffi.write_float(buf, i * 8,     cx + radius * maths.cos(a))
            ffi.write_float(buf, i * 8 + 4, cy + radius * maths.sin(a))
        }
        var ok = _lib.SDL_RenderLines(handle, buf, pts)
        ffi.free(buf); return ok
    }

    // 填充实心圆形（逐行画线近似，保留小数半径并覆盖完整上下行）
    func fillCircle(float cx, float cy, float radius): bool {
        _flushBatches()
        if radius <= 0.0 { return true }
        var r = _int(radius)
        var ok = true
        for 0 : (2 * r) to i {
            var dy = i - r
            var inside = radius * radius - dy * dy
            if inside <= 0.0 { continue }
            var half = maths.sqrt(inside)
            if not _emitLine(cx - half, cy + dy, cx + half, cy + dy) { ok = false }
        }
        return ok
    }

    // 填充扇形（饼图/环形图）：圆心(cx,cy)，半径 r，起止角度 a0→a1（单位：度，0=正右，顺时针为正）
    // 用三角扇（每小段一个三角形）批量提交几何，并把 0~255 整数色归一化为 SDL_Vertex 所需浮点色
    func fillPie(float cx, float cy, float r, float a0, float a1, int cr, int cg, int cb, int ca): bool {
        _flushBatches()
        if r <= 0.0 { return true }
        var span = a1 - a0
        if span >= 360.0 { span = 359.999; a1 = a0 + span }
        if span <= 0.0 { return true }
        float fr = cr / 255.0, fg = cg / 255.0
        float fb = cb / 255.0, fa = ca / 255.0
        int segs = _int(span / 6.0)
        if segs < 6 { segs = 6 }
        if segs > 120 { segs = 120 }
        var vcnt = segs * 3
        var verts = SDL_Vertex.malloc_array(vcnt)
        float d2r = 3.14159265 / 180.0
        for 0 : segs - 1 to i {
            float aa = a0 + span * i / _float(segs)
            float ab = a0 + span * (i + 1) / _float(segs)
            int vi = i * 3
            verts[vi].x = cx; verts[vi].y = cy
            verts[vi].r = fr; verts[vi].g = fg; verts[vi].b = fb; verts[vi].a = fa
            verts[vi+1].x = cx + r * maths.cos(aa * d2r)
            verts[vi+1].y = cy + r * maths.sin(aa * d2r)
            verts[vi+1].r = fr; verts[vi+1].g = fg; verts[vi+1].b = fb; verts[vi+1].a = fa
            verts[vi+2].x = cx + r * maths.cos(ab * d2r)
            verts[vi+2].y = cy + r * maths.sin(ab * d2r)
            verts[vi+2].r = fr; verts[vi+2].g = fg; verts[vi+2].b = fb; verts[vi+2].a = fa
        }
        var ok = _lib.SDL_RenderGeometry(handle, null, verts.to_ptr(), vcnt, null, 0)
        verts.free(); return ok
    }

    // 批量绘制线段（pts 为 float 对数组，count 为点数）
    func drawLines(Ptr[u8] pts, int count): bool { _flushBatches(); return _lib.SDL_RenderLines(handle, pts, count) }

    // 批量绘制点
    func drawPoints(Ptr[u8] pts, int count): bool { _flushBatches(); return _lib.SDL_RenderPoints(handle, pts, count) }

    // 批量绘制矩形边框
    func drawRects(Ptr[u8] rects, int count): bool { _flushBatches(); return _lib.SDL_RenderRects(handle, rects, count) }

    // 批量填充矩形
    func fillRects(Ptr[u8] rects, int count): bool { _flushBatches(); return _lib.SDL_RenderFillRects(handle, rects, count) }

    // 设置渲染缩放（sx, sy 缩放因子）
    func setScale(float sx, float sy): bool {
        if sx == _bxSx and sy == _bxSy { return true }
        _flushBatches(); _bxSx = sx; _bxSy = sy
        return _lib.SDL_SetRenderScale(handle, sx, sy)
    }

    // 设置混合模式：NONE=0, BLEND=1, ADD=2, MOD=4, MUL=8
    func setBlendMode(int mode): bool {
        if mode == _bxBlend { return true }
