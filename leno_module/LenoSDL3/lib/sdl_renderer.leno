    }

    // 设置纹理颜色调制（打包色 0xAARRGGBB，提取 RGB 分量传给 SDL）
    func setTextureColor(Ptr[u8] texture, Color color): bool {
        int r = (color >> 16) & 0xFF
        int g = (color >> 8) & 0xFF
        int b = color & 0xFF
        return _lib.SDL_SetTextureColorMod(texture, r, g, b)
    }

    // 强制刷新渲染命令
    // ---- 批处理：立即提交（供复合图元内部使用，避免嵌套进缓冲打乱顺序） ----
    func _emitFill(float x, float y, float w, float h): bool {
        SDL_FRect rect = SDL_FRect.malloc()
        rect.x = x; rect.y = y; rect.w = w; rect.h = h
        bool r = _lib.SDL_RenderFillRect(handle, rect.to_ptr())
        rect.free(); return r
    }
    func _emitRect(float x, float y, float w, float h): bool {
        SDL_FRect rect = SDL_FRect.malloc()
        rect.x = x; rect.y = y; rect.w = w; rect.h = h
        bool r = _lib.SDL_RenderRect(handle, rect)
        rect.free(); return r
    }
    func _emitLine(float x1, float y1, float x2, float y2): bool {
        return _lib.SDL_RenderLine(handle, x1, y1, x2, y2)
    }

    // ---- 批处理：提交缓冲（切换绘制状态 / 立即绘制 / 帧末时调用） ----
    // 三种图元各自缓冲，但 _bxCur 保证「跨类型切换即 flush」，从而不破坏绘制顺序：
    // 同类型连续调用合并为一次 SDL 批量提交，不同类型按调用先后分段提交。
    func _flushBatches(): bool {
        bool ok = true
        if _bxFill != null and _bxFillN > 0 {
            if not _lib.SDL_RenderFillRects(handle, _bxFill, _bxFillN) { ok = false }
            _gFillSubmits = _gFillSubmits + 1
            _gFillBatched = _gFillBatched + _bxFillN
            _bxFillN = 0
        }
        if _bxOut != null and _bxOutN > 0 {
            if not _lib.SDL_RenderRects(handle, _bxOut, _bxOutN) { ok = false }
            _gOutSubmits = _gOutSubmits + 1
            _gOutBatched = _gOutBatched + _bxOutN
            _bxOutN = 0
        }
        if _bxLine != null and _bxLineN > 0 {
            // 注意：SDL_RenderLines 绘制的是「连续折线」（p0->p1->p2->…），
            // 若把多条独立线段塞进同一数组，相邻线段端点会被斜线相连 -> 出现多余斜线。
            // 因此逐条用 SDL_RenderLine 提交：既保留缓冲收集（减少调用方每帧提交次数），
            // 又保证每条线段彼此独立、不相连。
            for 0 : _bxLineN - 1 to i {
                int off = i * 16
                float lx1 = ffi.read_float(_bxLine, off)
                float ly1 = ffi.read_float(_bxLine, off + 4)
                float lx2 = ffi.read_float(_bxLine, off + 8)
                float ly2 = ffi.read_float(_bxLine, off + 12)
                if not _emitLine(lx1, ly1, lx2, ly2) { ok = false }
            }
            _gLineSubmits = _gLineSubmits + 1
            _gLineBatched = _gLineBatched + _bxLineN
            _bxLineN = 0
        }
        _bxCur = BX_EMPTY
        return ok
    }

    // 批处理统计：fill/drawRect/drawLine 各自的「批量提交次数」与「经批处理提交的图元总数」


    // 强制刷新渲染命令：先提交批处理缓冲，再让 SDL 把已入队命令刷到 GPU
    func flush(): bool {
        _flushBatches()
        return _lib.SDL_FlushRenderer(handle)
    }

    // 截取当前渲染画面
    func readPixels(Ptr[u8] rect): Ptr[u8] {
        _flushBatches()
        return _lib.SDL_RenderReadPixels(handle, rect)
    }

    // 截取当前渲染画面（便捷重载：直接传入 x, y, w, h）
    func readPixelsAt(int x, int y, int w, int h): Ptr[u8] {
        _flushBatches()
        SDL_Rect rect = SDL_Rect.malloc()
        rect.x = x; rect.y = y; rect.w = w; rect.h = h
        var surface = _lib.SDL_RenderReadPixels(handle, rect.to_ptr())
        rect.free()
        return surface
    }

    // 创建纹理（返回 Ptr，用完 SDL_DestroyTexture）
    func createTexture(int format, int access, int w, int h): Ptr[u8] {
        return _lib.SDL_CreateTexture(handle, format, access, w, h)
    }

    // 更新纹理像素数据
    func updateTexture(Ptr[u8] texture, Ptr[u8] rect, Ptr[u8] pixels, int pitch): bool {
        return _lib.SDL_UpdateTexture(texture, rect, pixels, pitch)
    }

    // 将 PixelBuffer 像素一次性上传并绘制到 (dx, dy)（尺寸可选缩放）
    // 内部复用流式纹理：尺寸匹配时懒创建一次，全程零分配。返回 false 表示失败。
    func blitBuffer(PixelBuffer buf, float dx, float dy, float dw, float dh): bool {
        if not buf.ok or buf.w <= 0 or buf.h <= 0 { return false }
        if _pixTex == null or _pixTexW != buf.w or _pixTexH != buf.h {
            if _pixTex != null { _lib.SDL_DestroyTexture(_pixTex); _pixTex = null }
            // SDL_TEXTUREACCESS_STREAMING = 1
            _pixTex = createTexture(core.PIXELFORMAT_RGBA8888, 1, buf.w, buf.h)
            if _pixTex == null { return false }
            _pixTexW = buf.w; _pixTexH = buf.h
            // 设为 BLEND：透明像素可透出底下的已绘制内容（用于字符特效叠加等场景）
            _lib.SDL_SetTextureBlendMode(_pixTex, core.BlendMode.BLEND)
        }
        _flushBatches()
        if not _lib.SDL_UpdateTexture(_pixTex, null, buf.pixels, buf.pitch) { return false }
        return drawTextureAt(_pixTex, dx, dy, dw, dh)
    }

    // 锁定/解锁纹理以直接操作像素（需 TEXTUREACCESS_STREAMING）
    func lockTexture(Ptr[u8] texture, Ptr[u8] rect): bool {
        return _lib.SDL_LockTexture(texture, rect, null, null)
    }
    func unlockTexture(Ptr[u8] texture) {
        _lib.SDL_UnlockTexture(texture)
    }

    // 设置颜色缩放（HDR/亮度调节，不影响 alpha）
    func setColorScale(float scale): bool {
        if scale == _bxCScale { return true }
        _flushBatches(); _bxCScale = scale
        return _lib.SDL_SetRenderColorScale(handle, scale)
    }

    // 九宫格渲染（UI 边框不拉伸）
    func drawTexture9Grid(Ptr[u8] texture, float lw, float rw, float th, float bh, float scale, Ptr[u8] dst): bool {
        return _lib.SDL_RenderTexture9Grid(handle, texture, null, lw, rw, th, bh, scale, dst)
    }

    // 平铺渲染
    func drawTextureTiled(Ptr[u8] texture, float scale, Ptr[u8] dst): bool {
        return _lib.SDL_RenderTextureTiled(handle, texture, null, scale, dst)
    }

    // 几何渲染（三角形/多边形），vertices 为 SDL_Vertex 数组 to_ptr()
    func drawGeometry(Ptr[u8] vertices, int count, Ptr[u8] indices, int idxCount): bool {
        _flushBatches()
        return _lib.SDL_RenderGeometry(handle, null, vertices, count, indices, idxCount)
    }

    // 绘制三角形（单色填充，支持旋转和缩放，a 默认完全不透明）→ 每顶点独立颜色见 drawTriangleGradient
    func drawTriangle(float cx, float cy, float size, float angle, float r, float g, float b, float a = 1.0): bool {
        _flushBatches()
        float rad = angle * 3.14159265 / 180.0
        float c = maths.cos(rad); float s = maths.sin(rad)

        float p0x = c * 0.0  - s * (-size) + cx
        float p0y = s * 0.0  + c * (-size) + cy
        float p1x = c * size - s * size   + cx
        float p1y = s * size + c * size   + cy
        float p2x = c * (-size) - s * size + cx
        float p2y = s * (-size) + c * size + cy

        var verts = SDL_Vertex.malloc_array(3)
        verts[0].x = p0x; verts[0].y = p0y
        verts[0].r = r; verts[0].g = g; verts[0].b = b; verts[0].a = a
        verts[1].x = p1x; verts[1].y = p1y
        verts[1].r = r; verts[1].g = g; verts[1].b = b; verts[1].a = a
        verts[2].x = p2x; verts[2].y = p2y
        verts[2].r = r; verts[2].g = g; verts[2].b = b; verts[2].a = a

        var ok = _lib.SDL_RenderGeometry(handle, null, verts.to_ptr(), 3, null, 0)
        verts.free(); return ok
    }

    // 绘制渐变三角形（每个顶点可独立设色）
    func drawTriangleGradient(float cx, float cy, float size, float angle,
                               float r0, float g0, float b0, float a0,
                               float r1, float g1, float b1, float a1,
                               float r2, float g2, float b2, float a2): bool {
        _flushBatches()
        float rad = angle * 3.14159265 / 180.0
        float c = maths.cos(rad); float s = maths.sin(rad)

        float p0x = c * 0.0  - s * (-size) + cx
        float p0y = s * 0.0  + c * (-size) + cy
        float p1x = c * size - s * size   + cx
        float p1y = s * size + c * size   + cy
        float p2x = c * (-size) - s * size + cx
        float p2y = s * (-size) + c * size + cy

        var verts = SDL_Vertex.malloc_array(3)
        verts[0].x = p0x; verts[0].y = p0y
        verts[0].r = r0; verts[0].g = g0; verts[0].b = b0; verts[0].a = a0
        verts[1].x = p1x; verts[1].y = p1y
        verts[1].r = r1; verts[1].g = g1; verts[1].b = b1; verts[1].a = a1
        verts[2].x = p2x; verts[2].y = p2y
        verts[2].r = r2; verts[2].g = g2; verts[2].b = b2; verts[2].a = a2

        var ok = _lib.SDL_RenderGeometry(handle, null, verts.to_ptr(), 3, null, 0)
        verts.free(); return ok
    }

    // 填充圆角矩形（使用当前绘制颜色）→ 单次 alloc + 单次 Geometry 提交
    func fillRoundedRect(float x, float y, float w, float h, float r): bool {
        _flushBatches()
        if r <= 0.0 { return _emitFill(x, y, w, h) }
        if r > w * 0.5 { r = w * 0.5 }
        if r > h * 0.5 { r = h * 0.5 }

        // 直边区域（3 个矩形批量填充）
        _emitFill(x + r, y, w - 2.0 * r, h)
        _emitFill(x, y + r, r, h - 2.0 * r)
        _emitFill(x + w - r, y + r, r, h - 2.0 * r)

        // 动态分段：小半径减段数
        var segs = 16
        if r > 32.0 { segs = 32 }
        if r > 64.0 { segs = 48 }

        // 获取当前颜色
        var[float, float, float, float](cr, cg, cb, ca) = getColorFloat()

        var half_pi = 1.57079633
        var v_per_corner = 3 * segs  // 每个角需要的顶点数（segs 个三角形 × 3 顶点）
        var vcnt = 4 * v_per_corner // 四个角总顶点数
        var verts = SDL_Vertex.malloc_array(vcnt)

        // 一次性生成四个角的三角扇顶点
        for 0 : 3 to ci {
            float cx, cy, sa
            switch ci {
                case 0 { cx = x + r; cy = y + r; sa = half_pi * 2.0 }               // 左上 π→3π/2
                case 1 { cx = x + w - r; cy = y + r; sa = half_pi * 3.0 }           // 右上 3π/2→2π
                case 2 { cx = x + w - r; cy = y + h - r; sa = 0.0 }                 // 右下 0→π/2
                case 3 { cx = x + r; cy = y + h - r; sa = half_pi }                 // 左下 π/2→π
            }

            var step = half_pi / segs
            for 0 : segs - 1 to i {
                var a1 = sa + step * i
                var a2 = sa + step * (i + 1)
                var vi = ci * v_per_corner + i * 3
                verts[vi].x = cx; verts[vi].y = cy
                verts[vi].r = cr; verts[vi].g = cg; verts[vi].b = cb; verts[vi].a = ca
                verts[vi+1].x = cx + r * maths.cos(a1); verts[vi+1].y = cy + r * maths.sin(a1)
                verts[vi+1].r = cr; verts[vi+1].g = cg; verts[vi+1].b = cb; verts[vi+1].a = ca
                verts[vi+2].x = cx + r * maths.cos(a2); verts[vi+2].y = cy + r * maths.sin(a2)
                verts[vi+2].r = cr; verts[vi+2].g = cg; verts[vi+2].b = cb; verts[vi+2].a = ca
            }
        }
        // 单次几何提交：四个角所有三角形
        var ok = _lib.SDL_RenderGeometry(handle, null, verts.to_ptr(), vcnt, null, 0)
        verts.free(); return ok
    }

    // 绘制圆角矩形边框（使用当前绘制颜色）
    func drawRoundedRect(float x, float y, float w, float h, float r): bool {
        _flushBatches()
        if r <= 0.0 { return _emitRect(x, y, w, h) }
        if r > w * 0.5 { r = w * 0.5 }
        if r > h * 0.5 { r = h * 0.5 }

        // 动态分段
        var segs = 16
        if r > 32.0 { segs = 32 }

        var pts = segs + 1; var half_pi = 1.57079633
        var total = 4 * pts + 1  // 4 圆弧 + 闭合左直边
        Ptr[f32] buf = ffi.malloc(total * 8)
        if buf == null { return false }

        // 一次性写入 4 个圆角弧的连续顶点
        for 0 : 3 to ci {
            float cx, cy, sa
            switch ci {
                case 0 { cx = x + r; cy = y + r; sa = half_pi * 2.0 }               // 左上
                case 1 { cx = x + w - r; cy = y + r; sa = half_pi * 3.0 }           // 右上
                case 2 { cx = x + w - r; cy = y + h - r; sa = 0.0 }                 // 右下
                case 3 { cx = x + r; cy = y + h - r; sa = half_pi }                 // 左下
            }

            var step = half_pi / segs
            for 0 : segs to i {
                var a = sa + step * i
                var off = (ci * pts + i) * 8
                ffi.write_float(buf, off,     cx + r * maths.cos(a))
                ffi.write_float(buf, off + 4, cy + r * maths.sin(a))
            }
        }
        // 闭合左直边：左下弧终点 (x, y+h-r) → 左上弧起点 (x, y+r)
        ffi.write_float(buf, (4 * pts) * 8,     x)
        ffi.write_float(buf, (4 * pts) * 8 + 4, y + r)

        var ok = _lib.SDL_RenderLines(handle, buf, total)
        ffi.free(buf); return ok
    }
}

// 创建渲染器实例
export func createRenderer(Ptr[u8] window): Renderer {
    Renderer ren = new Renderer(); ren.initDefault(window); return ren
}