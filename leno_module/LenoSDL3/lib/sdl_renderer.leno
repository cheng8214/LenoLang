    // 绘制纹理的裁剪区域到目标位置
    // sx, sy, sw, sh: 源矩形；dx, dy, dw, dh: 目标矩形
    func drawTextureFromTo(Ptr[u8] texture,
                          float sx, float sy, float sw, float sh,
                          float dx, float dy, float dw, float dh): bool {
        _flushBatches()
        SDL_FRect src = SDL_FRect.malloc()
        SDL_FRect dst = SDL_FRect.malloc()
        src.x = sx; src.y = sy; src.w = sw; src.h = sh
        dst.x = dx; dst.y = dy; dst.w = dw; dst.h = dh
        bool ok = _lib.SDL_RenderTexture(handle, texture, src.to_ptr(), dst.to_ptr())
        src.free(); dst.free()
        return ok
    }

    // 旋转+翻转绘制纹理
    // angle: 角度（度），顺时针；center: null 则绕目标中心旋转
    // flip: FLIP_NONE / FLIP_HORIZONTAL / FLIP_VERTICAL
    func drawTextureRotated(Ptr[u8] texture, float x, float y, float w, float h,
                            float angle, float cx, float cy, int flip): bool {
        _flushBatches()
        SDL_FRect dst = SDL_FRect.malloc()
        dst.x = x; dst.y = y; dst.w = w; dst.h = h

        SDL_FPoint center = SDL_FPoint.malloc()
        center.x = cx; center.y = cy

        bool ok = _lib.SDL_RenderTextureRotated(handle, texture, null, dst.to_ptr(),
                                                  angle, center.to_ptr(), flip)
        dst.free(); center.free(); return ok
    }

    // 获取纹理尺寸（浮点）
    func getTextureSize(Ptr[u8] texture): [float, float] {
        SDL_FPoint pt = SDL_FPoint.malloc()
        _lib.SDL_GetTextureSize(texture, &pt.x, &pt.y)
        var w = pt.x; var h = pt.y
        pt.free(); return w, h
    }

    // 便捷绘制文字（创建/复用纹理→绘制一步完成）
    // SSAA 激活时：临时把字号放大到 _ssaaScale 倍渲染，使文字纹理本身为 2x 分辨率，
    // 再按逻辑尺寸绘制（被 setScale 映射回 1:1 的离屏像素），下采样后清晰不糊。
    // 文字纹理经 Font 内部缓存（_getCachedTex），命中时跳过每帧 2x 栅格化与 GPU 上传，显著省 CPU/带宽。
    func drawText(Font f, string text, float x, float y, Color color) {
        _flushBatches()
        int r = (color >> 16) & 0xFF
        int g = (color >> 8) & 0xFF
        int b = color & 0xFF
        if _ssaa and _ssaaScale > 0.0 {
            float origPt = f._pt
            f.setFontSize(origPt * _ssaaScale)   // _pt 临时变 2x，作为缓存 key 维度
            TextTexture tex = f._getCachedTex(handle, text, r, g, b)
            f.setFontSize(origPt)                // 还原，避免影响后续 measureString/其它绘制
            if tex.ok {
                float dw = tex.width  / _ssaaScale
                float dh = tex.height / _ssaaScale
                // Alpha 调制：用颜色中的 Alpha 通道
                if ((color >> 24) & 0xFF) < 255 { _lib.SDL_SetTextureAlphaMod(tex.texture, (color >> 24) & 0xFF) }
                drawTextureAt(tex.texture, x, y, dw, dh)
            }
            return
        }
        // 1x 模式（无 SSAA）：逻辑像素 == 物理像素。把文字吸附到整数像素，
        // 避免纹理在亚像素位置被双线性重采样而发虚（SSAA 模式由调用方 snapX/snapY 已处理）。
        x = _int(x + 0.5)
        y = _int(y + 0.5)
        TextTexture tex = f._getCachedTex(handle, text, r, g, b)
        if tex.ok {
            // Alpha 调制：用颜色中的 Alpha 通道
            if ((color >> 24) & 0xFF) < 255 { _lib.SDL_SetTextureAlphaMod(tex.texture, (color >> 24) & 0xFF) }
            drawTextureAt(tex.texture, x, y, tex.width, tex.height)
        }
    }

    // 居中绘制文字（在 [x, x+w] 范围内水平居中）
    func drawTextCentered(Font f, string text, float x, float w, float y, Color color) {
        var[float, float](msw, msh) = f.measureString(text)
        float cx = x + (w - msw) / 2.0
        drawText(f, text, cx, y, color)
    }

    // 设置背景色并清屏（setColor + clear 一步完成）
    func clearColor(Color color) {
        setColor(color); clear()
    }

    // 渲染到纹理（null 恢复渲染到窗口）
    func setRenderTarget(Ptr[u8] texture): bool {
        _flushBatches(); _bxTarget = texture
        return _lib.SDL_SetRenderTarget(handle, texture)
    }

    // 设置纹理透明度调制（0~255）
    func setTextureAlpha(Ptr[u8] texture, int alpha): bool {
