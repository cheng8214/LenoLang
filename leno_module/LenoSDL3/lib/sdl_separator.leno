// sdl_separator.leno — 分隔线控件
// 通过 win.addSeparator({...}) 创建，支持水平/垂直方向、自定义颜色与粗细
// 布局容器中常用作间距视觉分隔
import "sdl_renderer.leno" as ren; use ren.Renderer
import "sdl_event.leno" as evt; use evt.Event
import "sdl_widget.leno" as wgt; use wgt.Widget
import "sdl_theme.leno" as theme; use theme.(Theme, Themeable)

export struct Separator impl Widget {
    const HORIZONTAL = 0      // 水平方向
    const VERTICAL   = 1      // 垂直方向
    const DEFAULT_THICKNESS = 1   // 默认线条粗细
    const DEFAULT_ALPHA = 200     // 默认透明度

    float x = 0.0, y = 0.0
    float _w = 200.0, _h = 1.0
    int _dir = HORIZONTAL
    int _thickness = DEFAULT_THICKNESS
    int _color = #464A54FF   // 颜色（默认主题分隔色）
    int _alpha = DEFAULT_ALPHA
    float _margin = 0.0       // 内缩边距（两端留白）
    bool _loaded = false, visible = true

    func set(Dict opts) {
        Theme th = theme.getTheme()
        _color = th.sep
        x      = opts.get("x", 0)
        y      = opts.get("y", 0)
        _dir   = opts.get("dir", Separator.HORIZONTAL)
        _thickness = opts.get("thickness", Separator.DEFAULT_THICKNESS)
        _margin = opts.get("margin", 0.0)
        visible = opts.get("visible", true)
        // 根据方向设定默认尺寸
        if _dir == Separator.HORIZONTAL { _w = opts.get("w", 200); _h = _float(_thickness) }
        else { _w = _float(_thickness); _h = opts.get("h", 200) }
        // 颜色覆盖
        var c = opts.get("color")
        if c is int { _color = c }
        _alpha = opts.get("alpha", Separator.DEFAULT_ALPHA)
        _loaded = true
    }

    // ==================== 设置方法 ====================
    func set_horizontal() { _dir = Separator.HORIZONTAL; _h = _float(_thickness) }
    func set_vertical()   { _dir = Separator.VERTICAL;   _w = _float(_thickness) }
    func set_thickness(int t) {
        _thickness = t
        if _dir == Separator.HORIZONTAL { _h = _float(t) } else { _w = _float(t) }
    }
    func set_color(int color) { _color = color }
    func set_alpha(int a) { _alpha = a }
    func set_margin(float m) { _margin = m }
    func set_visible(bool v) { visible = v }
    func is_visible(): bool { return visible }
    func set_enabled(bool e) {}

    // ==================== 查询方法 ====================
    func get_x(): float { return x }
    func get_y(): float { return y }
    func get_w(): float { return _w }
    func get_h(): float { return _h }
    func set_pos(float px, float py) { x = px; y = py }
    func set_size(float sw, float sh) {
        if _dir == Separator.HORIZONTAL { _w = sw; _h = _float(_thickness) }
        else { _w = _float(_thickness); _h = sh }
    }

    func process(Event ev) {}

    // ==================== 渲染 ====================
    func render(Renderer r) {
        if not _loaded or not visible { return }
        r.setColor(theme.withAlpha(_color, _alpha))
        if _dir == Separator.HORIZONTAL {
            // 水平线：沿 x 方向延伸，居中绘制粗细
            float yy = y + (_h - _float(_thickness)) / 2.0
            r.fillRect(x + _margin, yy, _w - 2.0 * _margin, _float(_thickness))
        } else {
            // 垂直线：沿 y 方向延伸，居中绘制粗细
            float xx = x + (_w - _float(_thickness)) / 2.0
            r.fillRect(xx, y + _margin, _float(_thickness), _h - 2.0 * _margin)
        }
    }

    func dispose() {}
}

// 工厂
export func createSeparator(Dict opts): Separator {
    Separator s = new Separator(); s.set(opts); return s
}
