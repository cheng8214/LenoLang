// sdl_listbox.leno — 列表框控件（可滚动、单选/多选）
// 通过 win.addListBox({...}) 创建，鼠标点击选择、滚轮滚动，回调 on_change(Array[int])
import maths
import "sdl_renderer.leno" as ren; use ren.Renderer
import "sdl_font.leno" as fnt; use fnt.Font
import "sdl_event.leno" as evt; use evt.Event
import "sdl_core.leno" as core; use core.SystemCursor; use core.SDL_Rect
import "sdl_widget.leno" as wgt; use wgt.Widget
import "sdl_tooltip.leno" as tip
import "sdl_theme.leno" as theme; use theme.(Theme, Themeable)

export struct ListBox impl Widget, Themeable {
    // ==================== 关联常量 ====================
    const MODE_SINGLE = 0   // 单选模式
    const MODE_MULTI  = 1   // 多选模式

    float x = 0.0, y = 0.0, w = 200.0, h = 200.0
    Array[string] items = []
    Array[int] _sel = []          // 已选中索引集合（保持顺序，供回调使用）
    Dict[int, bool] _selMap = {}  // 选中索引映射（O(1) 查找，与 _sel 同步维护）
    float _itemH = 24.0          // 行高
    float _scroll = 0.0          // 已向下滚动的像素（0 = 顶部）
    int _hover = -1              // 当前悬停行索引（-1 无）
    float _fontSize = 15.0; string _fontPath = ""; int _fontStyle = 0; Font? _font
    int _mode = MODE_SINGLE       // 选择模式（MODE_SINGLE/MODE_MULTI）
    int _bgColor = #262830FF       // 背景色
    int _bdrColor = #5A5F6EFF      // 边框色
    int _selColor = #343A46FF      // 选中行底色
    int _hovColor = #464E5CFF      // 悬停行底色
    int _txtColor = #EBEBF5FF     // 文字色
    int _sbColor = #787D8CFF      // 滚动条色
    int _cursor = SystemCursor.POINTER
    bool enabled = true, visible = true, _loaded = false
    string _tip = ""
    bool _draggingScroll = false   // 正在拖拽竖向滚动条
    float _sbDragOffset = 0.0      // 拖拽起点距滑块顶的相对偏移
    func(Array[int]):void _onChange

    func _ensure_font() {
        if _font == null or not _font.ok {
            if _font != null and _font.ok { fnt.releaseFont(_font) }
            if _fontPath != "" { _font = fnt.acquireFont(_fontPath, _fontSize) }
            else { _font = fnt.acquireFontAuto(_fontSize) }
            if _font.ok and _fontStyle != 0 { _font.setStyle(_fontStyle) }
        }
    }

    func _max_scroll(): float {
        float total = items.len() * _itemH
        float m = total - h
        if m < 0.0 { m = 0.0 }
        return m
    }

    func _clamp_scroll() {
        float m = _max_scroll()
        if _scroll < 0.0 { _scroll = 0.0 }
        if _scroll > m { _scroll = m }
    }

    // ==================== 布局接口 ====================
    func get_w(): float          { return w }
    func get_h(): float          { return h }
    func set_pos(float px, float py) { x = px; y = py }
    func set_size(float sw, float sh) { w = sw; h = sh }

    // 竖向滚动条几何：返回 [sx, sw, ty0, ty1, thH, thy, maxs]
    func _sb_geom(): Array[float] {
        float maxs = _max_scroll()
        float sw = 8.0
        float sx = x + w - sw - 2.0
        float ty0 = y + 2.0
        float ty1 = y + h - 2.0
        float trk = ty1 - ty0
        float thH = maths.max(20.0, maths.min(h * h / _total_h(), h - 4.0))
        float thy = ty0 + (_scroll / maxs) * (trk - thH)
        return [sx, sw, ty0, ty1, thH, thy, maxs]
    }
    // 鼠标是否落在竖向滚动条（轨道）上
    func _in_vscroll(float mx, float my): bool {
        if _max_scroll() <= 0.0 { return false }
        var g = _sb_geom()
        return mx >= g[0] - 2.0 and mx <= g[0] + g[1] + 2.0 and my >= g[2] and my <= g[3]
    }
    // 鼠标是否落在滚动条滑块上
    func _in_thumb(float mx, float my): bool {
        if _max_scroll() <= 0.0 { return false }
        var g = _sb_geom()
        return mx >= g[0] - 2.0 and mx <= g[0] + g[1] + 2.0 and my >= g[5] and my <= g[5] + g[4]
    }

    // O(1) 选中判定：直接查 _selMap 映射，避免线性扫描 _sel
    func _is_selected(int idx): bool {
        return _selMap.get(idx, false)
    }

    // 同步添加选中索引到 _sel 和 _selMap
    func _sel_add(int idx) { _sel.add(idx); _selMap[idx] = true }
    // 同步清空选中集合
    func _sel_clear() { _sel = []; _selMap = {} }

    func _total_h(): float { return items.len() * _itemH }

    // ==================== set 初始化 ====================
    func set(Dict opts) {
        Theme th = theme.getTheme()
        _bgColor = th.bg
        _bdrColor = th.border
        _selColor = th.bgSel
        _hovColor = th.bgHover
        _txtColor = th.txt
        _sbColor = th.sb
        x         = opts.get("x", 0)
        y         = opts.get("y", 0)
        w         = opts.get("w", 200)
        h         = opts.get("h", 200)
        _itemH    = opts.get("item_h", 24)
        _fontSize = opts.get("font_size", 15)
        _fontPath = opts.get("font_path", "")
        _fontStyle = opts.get("font_style", 0)
        _mode     = opts.get("mode", MODE_SINGLE)     // MODE_SINGLE 单选 / MODE_MULTI 多选

        var its = opts.get("items", [])
        if its is Array[string] { items = its } else { items = [] }
        _sel_clear()
        var sel = opts.get("selected", -1)
        if sel is Array[int] {
            for sel.len() to i { _sel_add(sel[i]) }
        } else {
            int s = _int(sel)
            if s >= 0 { _sel_add(s) }
        }

        // 默认颜色见字段声明（_bgColor/_bdrColor/_selColor/_hovColor/_txtColor/_sbColor 等均有默认，以下仅 opts 覆盖）

        // 颜色可被 dict 覆盖
        var bgc = opts.get("bg_color")
        if bgc is int { _bgColor = bgc }
        var bdc = opts.get("border_color")
        if bdc is int { _bdrColor = bdc }
        var slc = opts.get("sel_color")
        if slc is int { _selColor = slc }
        var hvc = opts.get("hover_color")
        if hvc is int { _hovColor = hvc }
        var ctc = opts.get("text_color")
        if ctc is int { _txtColor = ctc }
        var sbc = opts.get("scroll_color")
        if sbc is int { _sbColor = sbc }

        _cursor  = _int(opts.get("cursor", SystemCursor.POINTER))
        enabled  = opts.get("enabled", true)
        visible  = opts.get("visible", true)
        _tip = opts.get("tip", "")
        _scroll  = 0.0; _hover = -1   // 重置滚动与悬停行（二次 set 时归零）
        _ensure_font()
        _clamp_scroll()
        _loaded = true
    }

    // ==================== 设置方法 ====================
    // 刷新数据：清空选择但【保留当前滚动位置】（仅在超出时夹紧），避免列表“跳回顶部”
    func set_items(Array[string] its) { items = its; _sel_clear(); _clamp_scroll() }
    // 追加单条（不自动滚屏，仅夹紧到有效范围）
    func add_item(string s)           { items.add(s); _clamp_scroll() }

    // 智能追加：若用户当前已停在底部（跟随实时流），追加后保持贴底；
    // 否则（用户在翻看历史）保留其当前滚动位置不跳动。maxKeep>0 时超出则从顶部丢弃最旧一条。
    func append_item(string s, int maxKeep) {
        float oldMax = _max_scroll()
        bool atBottom = _scroll >= oldMax - 0.5
        items.add(s)
        if maxKeep > 0 and items.len() > maxKeep {
            items.remove(0)
            _scroll = _scroll - _itemH      // 顶部丢弃一条：把滚动量同步减一行，冻结视口内“内容”
        }
        if atBottom { _scroll = _max_scroll() }   // 跟随模式：贴到底部
        _clamp_scroll()
    }
    // 强制追加到最底部并滚到最底部（适合“日志总在底部”的场景）
    func append_bottom(string s, int maxKeep) {
        items.add(s)
        if maxKeep > 0 and items.len() > maxKeep { items.remove(0) }
        _scroll = _max_scroll()
        _clamp_scroll()
    }
    func scroll_to_bottom() { _scroll = _max_scroll(); _clamp_scroll() }
    func scroll_to_top()    { _scroll = 0.0; _clamp_scroll() }
    func is_at_bottom(): bool { return _scroll >= _max_scroll() - 0.5 }

    func remove_item(int idx) {
        if idx >= 0 and idx < items.len() {
            // 删除顶部项时整体内容上移一行，把滚动量同步减一行以"冻结"视口内容
            if idx == 0 { _scroll = _scroll - _itemH }
            items.remove(idx)
            // 同步更新选中集合：删除 ==idx 的项，>idx 的项索引减一
            Array[int] newSel = []
            for _sel.len() to i {
                if _sel[i] == idx { continue }   // 删除被移除的项
                if _sel[i] > idx { newSel.add(_sel[i] - 1) }
                else { newSel.add(_sel[i]) }
            }
            _sel_clear()
            for newSel.len() to i { _sel_add(newSel[i]) }
            _clamp_scroll()
        }
    }
    func clear() { items = []; _sel_clear(); _scroll = 0.0; _hover = -1 }
    func set_enabled(bool e)     { enabled = e }
    func set_visible(bool v)      { visible = v }
    func is_visible(): bool       { return visible }
    func set_font_size(float s)  { _fontSize = s; if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null }
    func get_x(): float          { return x }
    func get_y(): float          { return y }

    func set_scroll(float p)     { _scroll = p; _clamp_scroll() }
    func get_scroll(): float     { return _scroll }
    func get_selected_indices(): Array[int] { return _sel }
    func get_selected_index(): int {
        if _sel.len() > 0 { return _sel[0] }
        return -1
    }
    func get_selected_text(): string {
        int i = get_selected_index()
        if i >= 0 and i < items.len() { return items[i] }
        return ""
    }
    func set_selected(int idx) {
        if idx < 0 or idx >= items.len() { return }
        _sel_clear(); _sel_add(idx)
        float iy = idx * _itemH
        if iy < _scroll { _scroll = iy }
        else if iy + _itemH > _scroll + h { _scroll = iy + _itemH - h }
        _clamp_scroll()
        if _onChange != null { _onChange(_sel) }
    }

    func on_change(func(Array[int]):void cb) { _onChange = cb }

    func contains(float mx, float my): bool {
        return mx >= x and mx <= x + w and my >= y and my <= y + h
    }

    func _index_at(float mx, float my): int {
        if not contains(mx, my) { return -1 }
        int idx = _int((my - y + _scroll) / _itemH)
        if idx < 0 or idx >= items.len() { return -1 }
        return idx
    }

    // ==================== 交互 ====================
    func process(Event ev) {
        if not _loaded { return }
        if not visible { return }
        if not enabled { _hover = -1; _draggingScroll = false; return }

        // 弹层捕获：光标落在“他人的下拉弹层”范围内时，本控件忽略该事件（避免穿透到下层）
        float mx = ev.mouseX(), my = ev.mouseY()
        if ev.isMouseWheel() { mx = ev.wheelMouseX(); my = ev.wheelMouseY() }
        if core.inPopupCapture(mx, my) { return }


        // 拖拽结束
        if ev.isMouseButtonUp() and _draggingScroll { _draggingScroll = false; return }

        // 滚动条优先于列表项
        if ev.isMouseButtonDown() and _in_vscroll(mx, my) {
            var g = _sb_geom()
            float maxs = g[6], trk = g[3] - g[2], thH = g[4]
            if _in_thumb(mx, my) {
                _draggingScroll = true
                _sbDragOffset = my - g[5]                  // 记录起点相对滑块顶的偏移，避免跳动
            } else {
                _draggingScroll = true
                _sbDragOffset = thH / 2.0
                float rel = my - g[2] - thH / 2.0
                if trk - thH > 0.0 { _scroll = rel * maxs / (trk - thH) }
                _clamp_scroll()
            }
            return
        }

        // 拖拽中：跟随鼠标移动滑块
        if _draggingScroll {
            if ev.isMouseMotion() {
                var g = _sb_geom()
                float maxs = g[6], trk = g[3] - g[2], thH = g[4]
                float rel = my - g[2] - _sbDragOffset
                if trk - thH > 0.0 { _scroll = rel * maxs / (trk - thH) }
                _clamp_scroll()
                core.markFrameRedraw()
            }
            return
        }

        if ev.isMouseWheel() {
            // 滚轮只作用于光标当前所在的列表框，避免同一事件被所有列表框共享而一起滚动
            if not contains(ev.wheelMouseX(), ev.wheelMouseY()) { return }
            float d = ev.wheelY() * _itemH
            _scroll = _scroll - d
            _clamp_scroll()
        }

        if ev.isMouseMotion() {
            int prevHover = _hover
            if _in_vscroll(mx, my) { _hover = -1 }
            else { _hover = _index_at(mx, my) }
            bool hv = _hover >= 0
            if _hover != prevHover { core.markFrameRedraw() } else { core.markFrameMotion() }
            if hv and _cursor >= 0 { core.requestCursor(_cursor) }
            if hv and _tip != "" { tip.tipReport(_tip, mx, my) }
        }

        if ev.isMouseButtonDown() {
            int idx = _index_at(mx, my)
            if idx >= 0 {
                if _mode == MODE_SINGLE {
                    if not _is_selected(idx) {
                        _sel_clear(); _sel_add(idx)
                        if _onChange != null { _onChange(_sel) }
                    }
                } else {
                    if _is_selected(idx) {
                        // 多选模式取消选中：从 _sel 和 _selMap 同步移除
                        for _sel.len() to i { if _sel[i] == idx { _sel.remove(i); break } }
                        _selMap[idx] = false
                    } else { _sel_add(idx) }
                    if _onChange != null { _onChange(_sel) }
                }
            }
        }
    }

    // ==================== 渲染 ====================
    func render(Renderer r) {
        if not _loaded { return }
        if not visible { return }
        _ensure_font()

        int bgC = _bgColor
        if not enabled { bgC = theme.darken(_bgColor, 60) }
        r.setColor(bgC)
        r.fillRoundedRect(x, y, w, h, 6.0)

        SDL_Rect clip = SDL_Rect.malloc()
        clip.x = _int(x); clip.y = _int(y)
        clip.w = _int(w) + 1; clip.h = _int(h) + 1   // +1 覆盖浮点截断的亚像素
        r.pushClipRect(clip.to_ptr())

        float pad = 8.0
        float radius = 6.0
        // 行高为常量，循环外测量一次避免每行重复测量
        float textH = 0.0
        if _font != null and _font.ok { textH = _font.measureString("Ag").h }
        for items.len() to i {
            float iy = r.snapY(y - _scroll + i * _itemH)
            if iy + _itemH < y or iy > y + h { continue }
            int rowC = bgC
            if _is_selected(i) { rowC = _selColor }
            else if i == _hover { rowC = _hovColor }
            r.setColor(rowC)
            bool atTop = (iy <= y + 0.5)
            bool atBottom = (iy + _itemH >= y + h - 0.5)
            if atTop and atBottom {
                // 唯一一行：全圆角
                r.fillRoundedRect(x, iy, w, _itemH, radius)
            } else if atTop {
                // 首行：全圆角 + 填充底部左右圆角缺口
                r.fillRoundedRect(x, iy, w, _itemH, radius)
                r.fillRect(x, iy + _itemH - radius, radius, radius)          // 左下缺口
                r.fillRect(x + w - radius, iy + _itemH - radius, radius, radius)  // 右下缺口
            } else if atBottom {
                // 末行：全圆角矩形 + 填补顶部左右圆角缺口（使顶部为直角，与上行衔接）
                r.fillRoundedRect(x, iy, w, _itemH, radius)
                r.fillRect(x, iy, radius, radius)                              // 左上缺口
                r.fillRect(x + w - radius, iy, radius, radius)                 // 右上缺口
            } else {
                r.fillRect(x, iy, w, _itemH)
            }

            if textH > 0.0 and i < items.len() {
                string t = items[i]
                int tcC = _txtColor
                if not enabled { tcC = theme.darken(_txtColor, 60) }
                float ty = r.snapY(iy + (_itemH - textH) / 2.0)
                r.drawText(_font, t, r.snapX(x + pad), ty, tcC)
            }
        }

        r.popClipRect()
        clip.free()

        // 边框
        r.setColor(_bdrColor)
        r.drawRoundedRect(x, y, w, h, 6.0)

        // 滚动条（内容超出时）
        float maxs = _max_scroll()
        if maxs > 0.0 {
            float sw = 8.0
            float sx = x + w - sw - 2.0
            r.setColor(theme.withAlpha(_sbColor, 180))
            r.fillRoundedRect(sx, y + 2.0, sw, h - 4.0, sw / 2.0)
            float ratio = _scroll / maxs
            float thH = maths.max(20.0, maths.min(h * h / _total_h(), h - 4.0))
            float thy = y + 2.0 + ratio * (h - 4.0 - thH)
            r.setColor(theme.brighten(_sbColor, 60))
            r.fillRoundedRect(sx, thy, sw, thH, sw / 2.0)
        }
    }

    func dispose() {
        if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null
    }

    func applyTheme(Theme t) {
        _bgColor = t.bg
        _bdrColor = t.border
        _selColor = t.bgSel
        _hovColor = t.bgHover
        _txtColor = t.txt
        _sbColor = t.sb
    }
}

// 工厂
export func createListBox(Dict opts): ListBox {
    ListBox lb = new ListBox(); lb.set(opts); return lb
}
