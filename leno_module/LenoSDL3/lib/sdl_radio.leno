// sdl_radio.leno — 单选按钮（同组互斥）
// 通过 win.addRadioButton({...}) 创建，同一 group 内只能选中一个。
// 互斥依赖模块级注册表：Leno 的 struct 数组为引用语义，注册 self 即共享同一实例。
import "sdl_renderer.leno" as ren; use ren.Renderer
import "sdl_font.leno" as fnt; use fnt.Font
import "sdl_event.leno" as evt; use evt.Event
import "sdl_core.leno" as core; use core.SystemCursor
import "sdl_widget.leno" as wgt; use wgt.Widget
import "sdl_tooltip.leno" as tip

// 模块级注册表 + 自增 id，用于同组互斥（按 id 排除自身，避免值比较误判）
Array[RadioButton] _radioRegistry = []
int _radioIdSeq = 0

export struct RadioButton impl Widget {
    string text = ""
    string group = "default"
    float x = 0.0; float y = 0.0
    float _box = 22.0
    float _gap = 8.0
    float _fontSize = 15.0
    string _fontPath = ""
    int _fontStyle = 0
    Font  _font
    bool _checked = false
    int _id = 0
    int cr = 60; int cg = 60; int cb = 72
    int cc = 60; int ck = 170; int cbl = 245
    int tr = 235; int tg = 235; int tb = 245
    int _brdR = 130; int _brdG = 130; int _brdB = 150
    int _cursor = SystemCursor.DEFAULT
    bool hover = false
    bool _wasHover = false
    bool _pressed = false
    bool enabled = true
    bool visible = true
    bool _loaded = false
    string _tip = ""        // 悬停提示文本（空 = 不提示）
    func(bool):void _onChange

    func _ensure_font() {
        if _font == null or not _font.ok {
            if _font != null { _font.close() }
            if _fontPath != "" { _font = fnt.createFont(_fontPath, _fontSize) }
            else { _font = fnt.createFontAuto(_fontSize) }
            if _font.ok and _fontStyle != 0 { _font.setStyle(_fontStyle) }
        }
    }

    func set(Dict opts) {
        text      = opts.get("text", "") as string
        group     = opts.get("group", "default") as string
        x         = _float(opts.get("x", 0))
        y         = _float(opts.get("y", 0))
        _box      = _float(opts.get("box", 22))
        _gap      = _float(opts.get("gap", 8))
        _fontSize = _float(opts.get("font_size", 15))
        _fontPath = opts.get("font_path", "") as string
        _fontStyle = _int(opts.get("font_style", 0))

        // 默认颜色见字段声明（cr/cg/cb/cc/ck/cbl/tr/tg/tb/_brdR 等均有默认，以下仅 opts 覆盖）

        // 颜色可被 dict 覆盖（[r,g,b]）
        var unk = opts.get("unchecked_rgb")
        if unk is Array[int] { cr = _int(unk[0]); cg = _int(unk[1]); cb = _int(unk[2]) }
        var chk = opts.get("checked_rgb")
        if chk is Array[int] { cc = _int(chk[0]); ck = _int(chk[1]); cbl = _int(chk[2]) }
        var ctc = opts.get("text_rgb")
        if ctc is Array[int] { tr = _int(ctc[0]); tg = _int(ctc[1]); tb = _int(ctc[2]) }
        var cbd = opts.get("border_rgb")
        if cbd is Array[int] { _brdR = _int(cbd[0]); _brdG = _int(cbd[1]); _brdB = _int(cbd[2]) }

        _cursor = _int(opts.get("cursor", SystemCursor.DEFAULT))
        _checked = _bool(opts.get("checked", false))
        enabled = _bool(opts.get("enabled", true))
        visible = _bool(opts.get("visible", true))
        // hover/_wasHover/_pressed 默认见字段声明
        _tip = opts.get("tip", "") as string

        _radioIdSeq = _radioIdSeq + 1
        _id = _radioIdSeq
        _ensure_font()
        _loaded = true
        _radioRegistry.add(self)   // 引用语义：与窗口数组同一实例
    }

    func set_text(string t)     { text = t }
    func set_tip(string t)       { _tip = t }
    func set_checked(bool c)     { _checked = c }
    func is_checked(): bool      { return _checked }
    func set_enabled(bool e)      { enabled = e }
    func set_visible(bool v)       { visible = v }
    func is_visible(): bool        { return visible }
    func set_font_size(float s)   { _fontSize = s; if _font != null { _font.close(); _font = null } }
    func get_x(): float           { return x }
    func get_y(): float           { return y }
    func get_w(): float {
        _ensure_font()
        float tw = 0.0
        if _font != null and _font.ok and text != "" { tw = _float(_font.measureString(text).w) }
        return _box + _gap + tw
    }
    func get_h(): float          { return _box }
    func set_pos(float px, float py) { x = px; y = py }
    func set_size(float sw, float sh) {}

    func on_change(func(bool):void cb) { _onChange = cb }

    func contains(float mx, float my): bool {
        float tw = 0.0
        if _font != null and _font.ok and text != "" { tw = _float(_font.measureString(text).w) }
        float totalW = _box + _gap + tw
        return mx >= x and mx <= x + totalW and my >= y and my <= y + _box
    }

    // 选中自己并取消同组其它
    func _select() {
        if _checked { return }   // 已选中保持不动
        _checked = true
        for _radioRegistry.len() to i {
            RadioButton rb = _radioRegistry[i]
            if rb != null and rb.group == group and rb._id != _id {
                rb._checked = false
            }
        }
        if _onChange != null { _onChange(true) }
    }

    func process(Event ev) {
        if not _loaded { return }
        if not visible { return }
        if not enabled { hover = false; _pressed = false; return }
        // 弹层捕获：事件落在“他人的弹层（如打开的菜单/下拉）范围内时忽略，避免穿透到下层控件
        float mx = ev.mouseX(); float my = ev.mouseY()
        if ev.isMouseWheel() { mx = ev.wheelMouseX(); my = ev.wheelMouseY() }
        if core.inPopupCapture(mx, my) { return }


        if ev.isMouseMotion() {
            _wasHover = hover
            hover = contains(ev.mouseX(), ev.mouseY())
            if _cursor >= 0 {
                if hover and not _wasHover { core.setSystemCursor(_cursor) }
                if not hover and _wasHover { core.setSystemCursor(SystemCursor.DEFAULT) }
            }
            // 悬停提示：进入上报、离开清除
            if hover and _tip != "" { tip.tipReport(_tip, ev.mouseX(), ev.mouseY()) }
            else if _wasHover and not hover { tip.tipClear() }
        }

        if ev.isMouseButtonUp() { _pressed = false }

        if ev.isMouseButtonDown() and hover and not _pressed {
            _pressed = true
            _select()
        }
    }

    func render(Renderer r) {
        if not _loaded { return }
        if not visible { return }
        _ensure_font()
        float bx = x; float by = y; float bs = _box

        // 外环
        int br = cr; int bg = cg; int bb = cb
        if hover { br = br + 25; bg = bg + 25; bb = bb + 25
                   if br > 255 { br = 255 }; if bg > 255 { bg = 255 }; if bb > 255 { bb = 255 } }
        if not enabled { br = cr / 2; bg = cg / 2; bb = cb / 2 }
        r.setColor(br, bg, bb, 255)
        r.fillRoundedRect(bx, by, bs, bs, bs / 2.0)

        r.setColor(_brdR, _brdG, _brdB, 220)
        r.drawRoundedRect(bx, by, bs, bs, bs / 2.0)

        // 选中内点
        if _checked {
            int dr = cc; int dg = ck; int db = cbl
            if not enabled { dr = cc / 2; dg = ck / 2; db = cbl / 2 }
            r.setColor(dr, dg, db, 255)
            float ins = bs * 0.30
            r.fillRoundedRect(bx + ins, by + ins, bs - ins * 2.0, bs - ins * 2.0, (bs - ins * 2.0) / 2.0)
        }

        // 文字
        if _font != null and _font.ok and text != "" {
            float cy = by + (bs - _float(_font.measureString("Ag").h)) / 2.0
            int tcR = tr; int tcG = tg; int tcB = tb
            if not enabled { tcR = tr / 2; tcG = tg / 2; tcB = tb / 2 }
            r.drawText(_font, text, bx + bs + _gap, cy, tcR, tcG, tcB)
        }
    }

    func dispose() {
        if _font != null { _font.close(); _font = null }
    }
}

export func createRadioButton(Dict opts): RadioButton {
    RadioButton rb = new RadioButton(); rb.set(opts); return rb
}
