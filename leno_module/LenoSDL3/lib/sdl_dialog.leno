// sdl_dialog.leno — 模态对话框: new Dialog(style={...}) → dlg.run(onEv, onRend)
import "sdl_window.leno" as wnd; use wnd.EventHandler; use wnd.RenderCallback

export struct Dialog {
    Dict style = {}

    func run(EventHandler onEvent, RenderCallback onRender) {
        var win = wnd.createWindow(style)
        if not win.ok { return }
        win.setAlwaysOnTop(true)
        wnd.setModalWid(win.getID())
        win.run(onEvent, onRender)
    }
}
