// sdl_blend2d.leno — Blend2D 高质量抗锯齿矢量绘制（替代 SDL3 原生锯齿图元）
//
// 思路：
//   Blend2D 渲染到一块内存像素缓冲（BLImage, PRGB32 = 小端 BGRA），
//   再用 SDL_UpdateTexture 上传到 SDL3 的流式纹理（PIXELFORMAT_BGRA8888），
//   最后用 SDL_RenderTexture 贴到窗口。
//   Blend2D 的 PRGB32 内存字节序 = BGRA，与 SDL 的 BGRA8888 完全一致，
//   因此像素无需任何格式转换，直接上传即可。
//
// 用法：
//   import "sdl_blend2d.leno" as b2d
//   use b2d.B2DCanvas
//   ...
//   // 在 onRender(Renderer ren) 中：
//   if not myCanvas { myCanvas = new B2DCanvas(); myCanvas.init(ren.handle, winW, winH) }
//   myCanvas.clear(0xFF202830)            // 不透明底（0xAARRGGBB）
//   myCanvas.fillCircle(200, 200, 80, 0xFF40C0FF)
//   myCanvas.strokeRect(50, 50, 120, 90, 3.0, 0xFFE0E0E0)
//   myCanvas.line(60, 400, 520, 320, 2.5, 0xFF90FF90)
//   myCanvas.present(ren.handle)          // 上传纹理并贴到窗口

import ffi
import dirs
import files
import "sdl_core.leno" as core
use core.(sdl3)
// 模块加载时一次性加载 SDL3 库实例（保持引用，避免“库对象已释放”）
sdl3 _sdl = core.lib()

// ----------------------------------------------------------------------------
// Blend2D C API 绑定（blend2d.dll，已用 C 接口 extern "C" 导出）
// ----------------------------------------------------------------------------
clib b2d {
    // 注意：Blend2D 实际导出的 C 函数名为下划线命名（bl_image_init_as 等）
    // BLFormat: BL_FORMAT_PRGB32 = 1（小端 x86 内存布局为 BGRA）
    i32  bl_image_init_as(Ptr[u8] self, i32 w, i32 h, u32 format)
    i32  bl_image_reset(Ptr[u8] self)
    i32  bl_image_get_data(Ptr[u8] self, Ptr[u8] dataOut)

    i32  bl_context_init_as(Ptr[u8] self, Ptr[u8] image, Ptr[u8] createInfo)
    i32  bl_context_end(Ptr[u8] self)
    i32  bl_context_clear_all(Ptr[u8] self)

    i32  bl_context_set_fill_style_rgba32(Ptr[u8] self, u32 rgba32)
    i32  bl_context_set_stroke_style_rgba32(Ptr[u8] self, u32 rgba32)
    i32  bl_context_set_stroke_width(Ptr[u8] self, f64 width)

    i32  bl_context_fill_rect_d(Ptr[u8] self, Ptr[u8] rect)
    i32  bl_context_stroke_rect_d(Ptr[u8] self, Ptr[u8] rect)
    i32  bl_context_fill_path_d(Ptr[u8] self, Ptr[u8] origin, Ptr[u8] path)
    i32  bl_context_stroke_path_d(Ptr[u8] self, Ptr[u8] origin, Ptr[u8] path)

    i32  bl_path_init(Ptr[u8] self)
    i32  bl_path_reset(Ptr[u8] self)
    i32  bl_path_add_geometry(Ptr[u8] self, u32 geometryType, Ptr[u8] geometryData, Ptr[u8] matrix, u32 dir)
}

// ----------------------------------------------------------------------------
// DLL 加载（blend2d.dll，文件名与块名 b2d 不一致，需显式 ffi.load）
// ----------------------------------------------------------------------------
b2d g_b2d = null

export func lib(): b2d {
    if g_b2d == null {
        // 多种运行场景下的候选路径（源码运行 script_dir=lib；.lenb 运行 script_dir=examples/图形绘制）
        var base = dirs.script_dir()
        var cands = [
            base + "/blend2d.dll",
            base + "/../blend2d.dll",
            base + "/../../blend2d.dll",
            base + "/../lib/blend2d.dll",
            base + "/../../lib/blend2d.dll",
            base + "/../../../lib/blend2d.dll",
            "blend2d.dll"
        ]
        for cands.len() to i {
            var path = cands[i]
            if files.exists(path) {
                g_b2d = ffi.load(path)
                if(g_b2d == null)
                {
                    print("b2d.leno: load blend2d.dll failed: " + path)
                }
                else{
                    print("b2d.leno: load blend2d.dll success: " + path)
                }
                break
            }
            else{}
        }
        if g_b2d == null {
            print("b2d.leno: 错误 — 所有候选路径均未找到/加载 blend2d.dll，g_b2d 保持 null。")
            print("b2d.leno: 请将 blend2d.dll 放到 sdl_blend2d.leno 所在目录（lib/）或主程序目录。")
            print("b2d.leno: 候选路径列表:")
            for cands.len() to j {
                print("  - " + cands[j])
            }
        }
    }
    return g_b2d
}
// 模块级持有 Blend2D 实例（sdl3 模式：clib 实例须用模块级变量直接持有才能调用方法）
// 注意：模块加载时可能尚未就绪而为 null，须在 init() 里重新赋值
b2d _b2d = lib()

// ----------------------------------------------------------------------------
// 结构体（仅描述 C 端内存布局，用于按指针传递）
// ----------------------------------------------------------------------------
// BLImageCore / BLContextCore / BLPathCore 在 C 模式下都是 16 字节不透明句柄
cstruct B2DCore { u8 _impl[16] }

// BLImageData：blImageGetData 的输出（32 字节）
cstruct B2DImageData {
    Ptr[u8] pixelData
    i64    stride       // 行字节数 = SDL 上传时的 pitch
    i32    w
    i32    h
    u32    format
    u32    flags
}

// BLRect (double)
cstruct B2DRect { f64 x; f64 y; f64 w; f64 h }
// BLCircle
cstruct B2DCircle { f64 cx; f64 cy; f64 r }
// BLLine
cstruct B2DLine { f64 x0; f64 y0; f64 x1; f64 y1 }
// BLPoint (origin)
cstruct B2DPoint { f64 x; f64 y }

// Blend2D 几何类型 / 方向常量
export const BL_GEOMETRY_TYPE_LINE    = 11
export const BL_GEOMETRY_TYPE_CIRCLE  = 5
export const BL_GEOMETRY_DIRECTION_CW = 1
export const BL_FORMAT_PRGB32         = 1
// SDL3 纹理访问标志
export const SDL_TEXTUREACCESS_STATIC    = 0
export const SDL_TEXTUREACCESS_STREAMING = 1
export const SDL_TEXTUREACCESS_TARGET    = 2

// ----------------------------------------------------------------------------
// B2DCanvas：抗锯齿画布
// ----------------------------------------------------------------------------
export struct B2DCanvas {
    Ptr[u8]      _img            // BLImageCore（16 字节不透明句柄，堆指针）
    Ptr[u8]      _ctx            // BLContextCore（16 字节不透明句柄，堆指针）
    Ptr[u8]      _tex            // SDL 纹理（streaming, BGRA8888）
    Ptr[u8]      _data           // BLImageData（含像素指针、宽高、stride，堆指针）
    bool         ok

    // 初始化：绑定 SDL 渲染器、创建画布与纹理
    //   renderer : SDL_Renderer*（通常是 ren.handle）
    //   w, h     : 画布尺寸（建议与窗口一致）
    func init(Ptr[u8] renderer, int w, int h): bool {
        // 确保 Blend2D 实例已加载（模块加载时可能尚未就绪）
        _b2d = lib()
        ok = false
        _img = ffi.malloc(16)     // BLImageCore（16 字节不透明句柄）
        _ctx = ffi.malloc(16)     // BLContextCore（16 字节不透明句柄）
        _data = ffi.malloc(32)    // BLImageData（32 字节）

        _b2d.bl_image_init_as(_img, w, h, BL_FORMAT_PRGB32)
        _b2d.bl_context_init_as(_ctx, _img, null)
        // 创建流式纹理：BGRA8888 与 Blend2D PRGB32 字节序一致，无需转换
        _tex = _sdl.SDL_CreateTexture(renderer, core.PIXELFORMAT_BGRA8888, SDL_TEXTUREACCESS_STREAMING, w, h)
        ok = _tex != null
        return ok
    }

    // 用不透明颜色清屏（0xAARRGGBB；抗锯齿背景下建议 alpha=255）
    func clear(int rgba32): bool {
        _b2d.bl_context_set_fill_style_rgba32(_ctx, rgba32)
        B2DRect r = B2DRect.malloc(); r.x = 0; r.y = 0
        // 用画布尺寸填满：从 data 取宽高
        _b2d.bl_image_get_data(_img, _data)
        r.w = ffi.read_int(_data, 16); r.h = ffi.read_int(_data, 20)
        _b2d.bl_context_fill_rect_d(_ctx, r.to_ptr())
        r.free()
        return true
    }

    // 填充矩形（x, y, w, h, 颜色 0xAARRGGBB）
    func fillRect(float x, float y, float w, float h, int rgba32): bool {
        _b2d.bl_context_set_fill_style_rgba32(_ctx, rgba32)
        B2DRect r = B2DRect.malloc(); r.x = x; r.y = y; r.w = w; r.h = h
        _b2d.bl_context_fill_rect_d(_ctx, r.to_ptr())
        r.free()
        return true
    }

    // 描边矩形（线宽 lw，颜色 0xAARRGGBB，抗锯齿）
    func strokeRect(float x, float y, float w, float h, float lw, int rgba32): bool {
        _b2d.bl_context_set_stroke_style_rgba32(_ctx, rgba32)
        _b2d.bl_context_set_stroke_width(_ctx, lw)
        B2DRect r = B2DRect.malloc(); r.x = x; r.y = y; r.w = w; r.h = h
        _b2d.bl_context_stroke_rect_d(_ctx, r.to_ptr())
        r.free()
        return true
    }

    // 填充圆（圆心 cx,cy，半径 r，颜色 0xAARRGGBB）
    func fillCircle(float cx, float cy, float r, int rgba32): bool {
        _b2d.bl_context_set_fill_style_rgba32(_ctx, rgba32)
        Ptr[u8] path = ffi.malloc(16)
        _b2d.bl_path_init(path)
        B2DCircle c = B2DCircle.malloc(); c.cx = cx; c.cy = cy; c.r = r
        _b2d.bl_path_add_geometry(path, BL_GEOMETRY_TYPE_CIRCLE, c.to_ptr(), null, BL_GEOMETRY_DIRECTION_CW)
        B2DPoint o = B2DPoint.malloc(); o.x = 0; o.y = 0
        _b2d.bl_context_fill_path_d(_ctx, o.to_ptr(), path)
        c.free(); o.free(); _b2d.bl_path_reset(path); ffi.free(path)
        return true
    }

    // 描边圆（线宽 lw，颜色 0xAARRGGBB，抗锯齿）
    func strokeCircle(float cx, float cy, float r, float lw, int rgba32): bool {
        _b2d.bl_context_set_stroke_style_rgba32(_ctx, rgba32)
        _b2d.bl_context_set_stroke_width(_ctx, lw)
        Ptr[u8] path = ffi.malloc(16)
        _b2d.bl_path_init(path)
        B2DCircle c = B2DCircle.malloc(); c.cx = cx; c.cy = cy; c.r = r
        _b2d.bl_path_add_geometry(path, BL_GEOMETRY_TYPE_CIRCLE, c.to_ptr(), null, BL_GEOMETRY_DIRECTION_CW)
        B2DPoint o = B2DPoint.malloc(); o.x = 0; o.y = 0
        _b2d.bl_context_stroke_path_d(_ctx, o.to_ptr(), path)
        c.free(); o.free(); _b2d.bl_path_reset(path); ffi.free(path)
        return true
    }

    // 线段（x1,y1 -> x2,y2，线宽 lw，颜色 0xAARRGGBB，抗锯齿）
    func line(float x1, float y1, float x2, float y2, float lw, int rgba32): bool {
        _b2d.bl_context_set_stroke_style_rgba32(_ctx, rgba32)
        _b2d.bl_context_set_stroke_width(_ctx, lw)
        Ptr[u8] path = ffi.malloc(16)
        _b2d.bl_path_init(path)
        B2DLine l = B2DLine.malloc(); l.x0 = x1; l.y0 = y1; l.x1 = x2; l.y1 = y2
        _b2d.bl_path_add_geometry(path, BL_GEOMETRY_TYPE_LINE, l.to_ptr(), null, BL_GEOMETRY_DIRECTION_CW)
        B2DPoint o = B2DPoint.malloc(); o.x = 0; o.y = 0
        _b2d.bl_context_stroke_path_d(_ctx, o.to_ptr(), path)
        l.free(); o.free(); _b2d.bl_path_reset(path); ffi.free(path)
        return true
    }

    // 将抗锯齿绘制结果上传到 SDL 纹理并贴到窗口（在绘制完成后调用一次）
    //   renderer : SDL_Renderer*（通常是 ren.handle）
    func present(Ptr[u8] renderer): bool {
        // 注意：不要每帧 bl_context_end（会让上下文不可用），end 只在 destroy 调用
        _b2d.bl_image_get_data(_img, _data)
        bool okUpd = _sdl.SDL_UpdateTexture(_tex, null, ffi.read_ptr(_data, 0), ffi.read_int64(_data, 8))
        bool okDraw = _sdl.SDL_RenderTexture(renderer, _tex, null, null)
        return okUpd and okDraw
    }

    // 释放资源
    func destroy() {
        if ok {
            _b2d.bl_context_end(_ctx)
            _b2d.bl_image_reset(_img)
            _sdl.SDL_DestroyTexture(_tex); _tex = null
            ffi.free(_img); _img = null
            ffi.free(_ctx); _ctx = null
            ffi.free(_data); _data = null
            ok = false
        }
    }
}
