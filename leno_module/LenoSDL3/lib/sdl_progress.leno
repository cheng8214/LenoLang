// sdl_progress.leno — 进度条控件
// 通过 win.addProgressBar({...}) 创建，只读显示进度（可 set_value 设定）；
// 开启 clickable 后点击/拖拽可设定进度（像可交互进度条），回调 on_change(float)
import maths
import "sdl_renderer.leno" as ren; use ren.Renderer
import "sdl_font.leno" as fnt; use fnt.Font
import "sdl_event.leno" as evt; use evt.Event
import "sdl_core.leno" as core; use core.SystemCursor
import "sdl_widget.leno" as wgt; use wgt.Widget
import "sdl_theme.leno" as theme; use theme.(Theme, Themeable)
use theme.Color
import "sdl_tooltip.leno" as tip

export struct ProgressBar impl Widget {
    float x = 0.0, y = 0.0, w = 200.0, h = 20.0
    float minV = 0.0, maxV = 100.0, value = 0.0
    bool _clickable = false, _showText = true
    string _fontPath = ""; float _fontSize = 15.0; int _fontStyle = 0; Font? _font
    Color _trkColor = #3C3C48FF          // 轨道背景色
    Color _fillColor = #3CC850FF     // 已选填充色
    Color _txtColor = #EBEBF5FF                // 文字色
    int _cursor = SystemCursor.POINTER
    bool hover = false; bool _wasHover = false; bool _dragging = false; bool enabled = true; bool visible = true; bool _loaded = false
    string _tip = ""
    float _animVal = 0.0, _animTarget = 0.0, _animLast = 0.0, _animSpeed = 12.0; bool _animating = false
    float _fontH = 0.0          // 字体行高缓存（字体不变时为常量，避免每帧 measureString）
    func(float):void _onChange

    func _ratio(): float {
        float span = maxV - minV
        if span <= 0.0 { return 0.0 }
        return maths.max(0.0, maths.min((_animVal - minV) / span, 1.0))
    }

    func _ensure_font() {
        if _font == null or not _font.ok {
            if _font != null and _font.ok { fnt.releaseFont(_font) }
            if _fontPath != "" { _font = fnt.acquireFont(_fontPath, _fontSize) }
            else { _font = fnt.acquireFontAuto(_fontSize) }
            if _font.ok and _fontStyle != 0 { _font.setStyle(_fontStyle) }
            if _font.ok { _fontH = _font.measureString("Ag").h }
        }
    }

    // ==================== set 初始化 ====================
    func set(Dict opts) {
        Theme th = theme.getTheme()
        _trkColor = th.bgAlt
        _fillColor = th.btnSuccess
        _txtColor = th.txt
        x         = opts.get("x", 0)
        y         = opts.get("y", 0)
        w         = opts.get("w", 200)
        h         = opts.get("h", 20)
        minV      = opts.get("min", 0.0)
        maxV      = opts.get("max", 100.0)
        value     = opts.get("value", 0.0)
        _clickable = opts.get("clickable", false)
        _showText  = opts.get("show_text", true)
        _fontSize = opts.get("font_size", 15)
        _fontPath = opts.get("font_path", "")
        _fontStyle = opts.get("font_style", 0)

        // 默认颜色见字段声明，以下仅 opts 覆盖

        // 颜色可被 dict 覆盖
        var tkc = opts.get("track_color")
        if tkc is int { _trkColor = tkc }
        var flc = opts.get("fill_color")
        if flc is int { _fillColor = flc }
        var ptc = opts.get("text_color")
        if ptc is int { _txtColor = ptc }

        _cursor = _int(opts.get("cursor", SystemCursor.POINTER))
        enabled = opts.get("enabled", true)
        visible = opts.get("visible", true)
        // hover/_wasHover/_dragging 默认见字段声明
        value = maths.max(minV, maths.min(value, maxV))
        _animVal = value; _animTarget = value; _animating = false; _animLast = 0.0
        _animSpeed = opts.get("anim_speed", 12.0)
        _tip = opts.get("tip", "")
        _ensure_font()
        _loaded = true
    }

    // ==================== 设置方法 ====================
    func set_value(float v) {
        float nv = maths.max(minV, maths.min(v, maxV))
        if nv != value {
            value = nv
            _animTarget = nv
            _animating = true
            _animLast = 0.0
            if _onChange != null { _onChange(value) }
        }
    }
    func get_value(): float      { return value }
    func get_display_value(): float { return _animVal }   // 动画当前显示值（用于观察过渡）
    func set_enabled(bool e)      { enabled = e }
    func set_visible(bool v)       { visible = v }
    func is_visible(): bool        { return visible }
    func set_font_size(float s)   { _fontSize = s; if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null }
    func get_x(): float           { return x }
    func get_y(): float           { return y }
    func get_w(): float          { return w }
    func get_h(): float          { return h }
    func set_pos(float px, float py) { x = px; y = py }
    func set_size(float sw, float sh) { w = sw; h = sh }

    func on_change(func(float):void cb) { _onChange = cb }

    func contains(float mx, float my): bool {
        return mx >= x and mx <= x + w and my >= y and my <= y + h
    }

    func _value_from_x(float mx): float {
        float t = (mx - x) / w
        if t < 0.0 { t = 0.0 }
        if t > 1.0 { t = 1.0 }
        return maths.max(minV, maths.min(minV + t * (maxV - minV), maxV))
    }

    // ==================== 交互 ====================
    func process(Event ev) {
        if not _loaded { return }
        if not visible { return }
        if not enabled { hover = false; _dragging = false; return }
        if not _clickable {
            // 只读模式：仅处理悬停提示，不改变 hover 状态（避免与可交互模式的 hover 冲突）
            if ev.isMouseMotion() {
                float mx = ev.mouseX(); float my = ev.mouseY()
                if contains(mx, my) and _tip != "" { tip.tipReport(_tip, mx, my) }
                core.markFrameMotion()
            }
            hover = false; return
        }
        // 弹层捕获：事件落在“他人的弹层（如打开的菜单/下拉）范围内时忽略，避免穿透到下层控件
        float mx = ev.mouseX(); float my = ev.mouseY()
        if ev.isMouseWheel() { mx = ev.wheelMouseX(); my = ev.wheelMouseY() }
        if core.inPopupCapture(mx, my) { return }


        if ev.isMouseMotion() {
            float mx = ev.mouseX(); float my = ev.mouseY()
            _wasHover = hover
            hover = contains(mx, my)
            if _dragging {
                value = _value_from_x(mx)
                _animVal = value          // 拖拽时实时跟随，取消动画延迟
                _animating = false
                if _onChange != null { _onChange(value) }
                core.markFrameRedraw()
            } else if _wasHover != hover {
                core.markFrameRedraw()    // hover 变化也需重绘（颜色高亮）
            } else {
                core.markFrameMotion()
            }
            if _cursor >= 0 {
                if hover { core.requestCursor(_cursor) }
            }
        }

        if ev.isMouseButtonUp() { _dragging = false }

        if ev.isMouseButtonDown() and not _dragging {
            if contains(ev.mouseX(), ev.mouseY()) {
                _dragging = true
                value = _value_from_x(ev.mouseX())
                _animTarget = value
                _animating = true          // 单击跳转：从当前显示位置平滑动画过去
                _animLast = 0.0
                if _onChange != null { _onChange(value) }
            }
        }
    }

    // ==================== 动画步进（每帧由 render 调用） ====================
    func _step_anim() {
        if not _animating { return }
        if _animSpeed <= 0.0 { _animVal = _animTarget; _animating = false; return }  // 关闭动画：立即到位
        float now = _float(core.getTicks())
        float dt = 0.0
        if _animLast > 0.0 { dt = (now - _animLast) / 1000.0 }
        _animLast = now
        float diff = _animTarget - _animVal
        float ad = diff
        if ad < 0.0 { ad = -ad }
        float eps = (maxV - minV) * 0.001
        if eps < 0.0001 { eps = 0.0001 }
        if ad <= eps {
            _animVal = _animTarget
            _animating = false
        } else if dt > 0.0 {
            float f = _animSpeed * dt
            if f > 1.0 { f = 1.0 }
            _animVal += diff * f
        }
    }

    // ==================== 渲染 ====================
    func render(Renderer r) {
        if not _loaded { return }
        if not visible { return }
        _ensure_font()
        _step_anim()
        if _animating { core.requestRedraw() }

        // 轨道背景
        Color trkC = _trkColor
        if not enabled { trkC = theme.packColor(theme.colorR(_trkColor) / 2, theme.colorG(_trkColor) / 2, theme.colorB(_trkColor) / 2) }
        r.setColor(trkC)
        r.fillRoundedRect(x, y, w, h, h / 2.0)

        // 已选填充
        float ratio = _ratio()
        float fillW = ratio * w
        Color filC = _fillColor
        if not enabled { filC = theme.packColor(theme.colorR(_fillColor) / 2, theme.colorG(_fillColor) / 2, theme.colorB(_fillColor) / 2) }
        if fillW > 1.0 {
            r.setColor(filC)
            r.fillRoundedRect(x, y, fillW, h, h / 2.0)
        }

        // 文字（百分比）
        if _showText and _font != null and _font.ok {
            int pct = _int(ratio * 100.0)
            string label = $"{pct}%"
            float tw = _font.measureString(label).w
            float th = _fontH
            float tx = x + w / 2.0 - tw / 2.0
            float ty = y + h / 2.0 - th / 2.0
            Color tc = _txtColor
            if not enabled { tc = theme.packColor(theme.colorR(_txtColor) / 2, theme.colorG(_txtColor) / 2, theme.colorB(_txtColor) / 2) }
            r.drawText(_font, label, tx, ty, tc)
        }
    }

    func dispose() {
        if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null
    }
}

// 工厂
export func createProgressBar(Dict opts): ProgressBar {
    ProgressBar p = new ProgressBar(); p.set(opts); return p
}
