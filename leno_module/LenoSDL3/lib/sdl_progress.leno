// sdl_progress.leno — 进度条控件
// 通过 win.addProgressBar({...}) 创建，只读显示进度（可 set_value 设定）；
// 开启 clickable 后点击/拖拽可设定进度（像可交互进度条），回调 on_change(float)
import "sdl_renderer.leno" as ren; use ren.Renderer
import "sdl_font.leno" as fnt; use fnt.Font
import "sdl_event.leno" as evt; use evt.Event
import "sdl_core.leno" as core; use core.SystemCursor
import "sdl_widget.leno" as wgt; use wgt.Widget
import "sdl_tooltip.leno" as tip

export struct ProgressBar impl Widget {
    float x = 0.0; float y = 0.0; float w = 200.0; float h = 20.0
    float minV = 0.0; float maxV = 100.0; float value = 0.0
    bool _clickable = false
    bool _showText = true
    string _fontPath = ""; float _fontSize = 14.0; int _fontStyle = 0; Font _font
    int _trkR = 60; int _trkG = 60; int _trkB = 72          // 轨道背景色
    int _fillR = 80; int _fillG = 200; int _fillB = 120     // 已选填充色
    int tr = 235; int tg = 235; int tb = 245                // 文字色
    int _cursor = SystemCursor.POINTER
    bool hover = false; bool _wasHover = false; bool _dragging = false; bool enabled = true; bool visible = true; bool _loaded = false
    string _tip = ""
    float _animVal = 0.0; float _animTarget = 0.0; float _animLast = 0.0; float _animSpeed = 12.0; bool _animating = false
    func(float):void _onChange

    func _clamp(float v, float lo, float hi): float {
        if v < lo { return lo }
        if v > hi { return hi }
        return v
    }
    func _ratio(): float {
        float span = maxV - minV
        if span <= 0.0 { return 0.0 }
        return _clamp((_animVal - minV) / span, 0.0, 1.0)
    }

    func _ensure_font() {
        if _font == null or not _font.ok {
            if _font != null { _font.close() }
            if _fontPath != "" { _font = fnt.createFont(_fontPath, _fontSize) }
            else { _font = fnt.createFontAuto(_fontSize) }
            if _font.ok and _fontStyle != 0 { _font.setStyle(_fontStyle) }
        }
    }

    // ==================== set 初始化 ====================
    func set(Dict opts) {
        x         = _float(opts.get("x", 0))
        y         = _float(opts.get("y", 0))
        w         = _float(opts.get("w", 200))
        h         = _float(opts.get("h", 20))
        minV      = _float(opts.get("min", 0.0))
        maxV      = _float(opts.get("max", 100.0))
        value     = _float(opts.get("value", 0.0))
        _clickable = _bool(opts.get("clickable", false))
        _showText  = _bool(opts.get("show_text", true))
        _fontSize = _float(opts.get("font_size", 14))
        _fontPath = opts.get("font_path", "") as string
        _fontStyle = _int(opts.get("font_style", 0))

        // 默认颜色见字段声明（_trkR/_fillR/tr 等均有默认，以下仅 opts 覆盖）

        // 颜色可被 dict 覆盖（[r,g,b]）
        var tkc = opts.get("track_rgb")
        if tkc is Array[int] { _trkR = _int(tkc[0]); _trkG = _int(tkc[1]); _trkB = _int(tkc[2]) }
        var flc = opts.get("fill_rgb")
        if flc is Array[int] { _fillR = _int(flc[0]); _fillG = _int(flc[1]); _fillB = _int(flc[2]) }
        var ptc = opts.get("text_rgb")
        if ptc is Array[int] { tr = _int(ptc[0]); tg = _int(ptc[1]); tb = _int(ptc[2]) }

        _cursor = _int(opts.get("cursor", SystemCursor.POINTER))
        enabled = _bool(opts.get("enabled", true))
        visible = _bool(opts.get("visible", true))
        // hover/_wasHover/_dragging 默认见字段声明
        value = _clamp(value, minV, maxV)
        _animVal = value; _animTarget = value; _animating = false; _animLast = 0.0
        _animSpeed = _float(opts.get("anim_speed", 12.0))
        _tip = opts.get("tip", "") as string
        _ensure_font()
        _loaded = true
    }

    // ==================== 设置方法 ====================
    func set_value(float v) {
        float nv = _clamp(v, minV, maxV)
        if nv != value {
            value = nv
            _animTarget = nv
            _animating = true
            _animLast = 0.0
            if _onChange != null { _onChange(value) }
        }
    }
    func get_value(): float      { return value }
    func get_display_value(): float { return _animVal }   // 动画当前显示值（用于观察过渡）
    func set_enabled(bool e)      { enabled = e }
    func set_visible(bool v)       { visible = v }
    func is_visible(): bool        { return visible }
    func set_font_size(float s)   { _fontSize = s; if _font != null { _font.close(); _font = null } }
    func get_x(): float           { return x }
    func get_y(): float           { return y }
    func get_w(): float          { return w }
    func get_h(): float          { return h }
    func set_pos(float px, float py) { x = px; y = py }
    func set_size(float sw, float sh) { w = sw; h = sh }

    func on_change(func(float):void cb) { _onChange = cb }

    func contains(float mx, float my): bool {
        return mx >= x and mx <= x + w and my >= y and my <= y + h
    }

    func _value_from_x(float mx): float {
        float t = (mx - x) / w
        if t < 0.0 { t = 0.0 }
        if t > 1.0 { t = 1.0 }
        return _clamp(minV + t * (maxV - minV), minV, maxV)
    }

    // ==================== 交互 ====================
    func process(Event ev) {
        if not _loaded { return }
        if not visible { return }
        if ev.isMouseMotion() {
            float mx = ev.mouseX(); float my = ev.mouseY()
            bool hit = contains(mx, my)
            if hit and _tip != "" { tip.tipReport(_tip, mx, my) }
            _wasHover = hit
        }
        if not enabled { hover = false; _dragging = false; return }
        if not _clickable { hover = false; return }   // 只读时不响应
        // 弹层捕获：事件落在“他人的弹层（如打开的菜单/下拉）范围内时忽略，避免穿透到下层控件
        float mx = ev.mouseX(); float my = ev.mouseY()
        if ev.isMouseWheel() { mx = ev.wheelMouseX(); my = ev.wheelMouseY() }
        if core.inPopupCapture(mx, my) { return }


        if ev.isMouseMotion() {
            float mx = ev.mouseX(); float my = ev.mouseY()
            _wasHover = hover
            hover = contains(mx, my)
            if _dragging {
                value = _value_from_x(mx)
                _animVal = value          // 拖拽时实时跟随，取消动画延迟
                _animating = false
                if _onChange != null { _onChange(value) }
            }
            if _cursor >= 0 {
                if hover and not _wasHover { core.setSystemCursor(_cursor) }
                if not hover and _wasHover { core.setSystemCursor(SystemCursor.DEFAULT) }
            }
        }

        if ev.isMouseButtonUp() { _dragging = false }

        if ev.isMouseButtonDown() and not _dragging {
            if contains(ev.mouseX(), ev.mouseY()) {
                _dragging = true
                value = _value_from_x(ev.mouseX())
                _animTarget = value
                _animating = true          // 单击跳转：从当前显示位置平滑动画过去
                _animLast = 0.0
                if _onChange != null { _onChange(value) }
            }
        }
    }

    // ==================== 动画步进（每帧由 render 调用） ====================
    func _step_anim() {
        if not _animating { return }
        if _animSpeed <= 0.0 { _animVal = _animTarget; _animating = false; return }  // 关闭动画：立即到位
        float now = _float(core.getTicks())
        float dt = 0.0
        if _animLast > 0.0 { dt = (now - _animLast) / 1000.0 }
        _animLast = now
        float diff = _animTarget - _animVal
        float ad = diff
        if ad < 0.0 { ad = -ad }
        float eps = (maxV - minV) * 0.001
        if eps < 0.0001 { eps = 0.0001 }
        if ad <= eps {
            _animVal = _animTarget
            _animating = false
        } else if dt > 0.0 {
            float f = _animSpeed * dt
            if f > 1.0 { f = 1.0 }
            _animVal += diff * f
        }
    }

    // ==================== 渲染 ====================
    func render(Renderer r) {
        if not _loaded { return }
        if not visible { return }
        _ensure_font()
        _step_anim()
        if _animating { core.requestRedraw() }

        // 轨道背景
        int tR = _trkR; int tG = _trkG; int tB = _trkB
        if not enabled { tR = _trkR / 2; tG = _trkG / 2; tB = _trkB / 2 }
        r.setColor(tR, tG, tB, 255)
        r.fillRoundedRect(x, y, w, h, h / 2.0)

        // 已选填充
        float ratio = _ratio()
        float fillW = ratio * w
        int fR = _fillR; int fG = _fillG; int fB = _fillB
        if not enabled { fR = _fillR / 2; fG = _fillG / 2; fB = _fillB / 2 }
        if fillW > 1.0 {
            r.setColor(fR, fG, fB, 255)
            r.fillRoundedRect(x, y, fillW, h, h / 2.0)
        }

        // 文字（百分比）
        if _showText and _font != null and _font.ok {
            int pct = _int(ratio * 100.0)
            string label = pct as string + "%"
            float tw = _float(_font.measureString(label).w)
            float th = _float(_font.measureString("Ag").h)
            float tx = x + w / 2.0 - tw / 2.0
            float ty = y + h / 2.0 - th / 2.0
            int tcR = tr; int tcG = tg; int tcB = tb
            if not enabled { tcR = tr / 2; tcG = tg / 2; tcB = tb / 2 }
            r.drawText(_font, label, tx, ty, tcR, tcG, tcB)
        }
    }

    func dispose() {
        if _font != null { _font.close(); _font = null }
    }
}

// 工厂
export func createProgressBar(Dict opts): ProgressBar {
    ProgressBar p = new ProgressBar(); p.set(opts); return p
}
