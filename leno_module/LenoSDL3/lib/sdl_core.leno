// ==================== DLL 加载 ====================

sdl3 g_lib = null

export func lib(): sdl3 {
    if g_lib == null {
        // 从脚本目录和上级目录查找 DLL
        var path = dirs.script_dir() + "/../SDL3.dll"
        if not files.exists(path) { path = dirs.script_dir() + "/SDL3.dll" }
        if not files.exists(path) { path = "SDL3.dll" }
        g_lib = ffi.load(path)
    }
    return g_lib
}

// ==================== 核心函数 ====================

export func init(int flags): bool {
    sdl3 l = lib()
    if l == null { return false }
    return l.SDL_Init(flags)
}

export func initVideo(): bool { return init(INIT_VIDEO) }

export func quit() {
    // 不释放 DLL——其他模块的 _lib 还引用同一对象
    // ffi.free(g_lib) 会导致跨模块引用失效
}

export func getError(): string {
    sdl3 l = lib()
    if l == null { return "SDL3 not loaded" }
    return l.SDL_GetError() as string
}

export func delay(int ms) { lib().SDL_Delay(ms) }
export func getTicks(): int { return lib().SDL_GetTicks() as int }//这里为啥要转int因为SDL_GetTicks返回的是u64，是C语音的，这里需要转成int，因为leno的int是64位的，所以需要转换一下

export func startTextInput(Ptr window): bool  { return lib().SDL_StartTextInput(window) }
export func stopTextInput(Ptr window): bool   { return lib().SDL_StopTextInput(window) }
export func textInputActive(Ptr window): bool { return lib().SDL_TextInputActive(window) }

export func getMouseState(): int { return lib().SDL_GetMouseState(null, null) as int }
export func getClipboardText(): string { return lib().SDL_GetClipboardText() as string }
export func setClipboardText(string text): bool { return lib().SDL_SetClipboardText(text) }
