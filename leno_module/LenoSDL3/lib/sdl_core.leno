// sdl_core.leno — SDL3 核心绑定（cstruct/clib/常量/DLL）
import ffi
import dirs
import files

// ==================== cstruct ====================

export cstruct SDL_FRect {
    f32 x; f32 y; f32 w; f32 h
}

export cstruct SDL_Rect {
    i32 x; i32 y; i32 w; i32 h
}

export cstruct SDL_FPoint {
    f32 x; f32 y
}

export cstruct SDL_Point {
    i32 x; i32 y
}

cstruct SDL_Event {
    u32 type
    u32 _reserved
    u64 _timestamp
    u32 _window_id
    u8  _data[108]
}

export cstruct SDL_Color {
    u8 r; u8 g; u8 b; u8 a
}

// ==================== clib sdl3 ====================

clib sdl3 {
    bool SDL_Init(u32 flags)
    void SDL_Quit()
    str8 SDL_GetError()

    Ptr  SDL_CreateWindow(str8 title, i32 w, i32 h, u64 flags)
    void SDL_DestroyWindow(Ptr window)
    bool SDL_SetWindowResizable(Ptr window, bool resizable)
    bool SDL_GetWindowSize(Ptr window, Ptr w, Ptr h)

    Ptr  SDL_CreateRenderer(Ptr window, str8 name)
    void SDL_DestroyRenderer(Ptr renderer)
    bool SDL_RenderClear(Ptr renderer)
    bool SDL_RenderPresent(Ptr renderer)
    bool SDL_SetRenderDrawColor(Ptr renderer, u8 r, u8 g, u8 b, u8 a)
    bool SDL_SetRenderDrawColorFloat(Ptr renderer, f32 r, f32 g, f32 b, f32 a)
    bool SDL_RenderFillRect(Ptr renderer, Ptr rect)
    bool SDL_RenderRect(Ptr renderer, Ptr rect)
    bool SDL_RenderLine(Ptr renderer, f32 x1, f32 y1, f32 x2, f32 y2)
    bool SDL_RenderPoint(Ptr renderer, f32 x, f32 y)
    bool SDL_SetRenderVSync(Ptr renderer, i32 vsync)

    bool SDL_RenderLines(Ptr renderer, Ptr points, i32 count)
    bool SDL_RenderPoints(Ptr renderer, Ptr points, i32 count)
    bool SDL_RenderRects(Ptr renderer, Ptr rects, i32 count)
    bool SDL_RenderFillRects(Ptr renderer, Ptr rects, i32 count)

    bool SDL_SetRenderScale(Ptr renderer, f32 sx, f32 sy)
    bool SDL_SetRenderDrawBlendMode(Ptr renderer, i32 mode)
    bool SDL_SetRenderClipRect(Ptr renderer, Ptr rect)
    bool SDL_SetRenderLogicalSize(Ptr renderer, i32 w, i32 h)
    bool SDL_SetRenderViewport(Ptr renderer, Ptr rect)

    bool SDL_GetRenderDrawColor(Ptr renderer, Ptr r, Ptr g, Ptr b, Ptr a)
    bool SDL_GetRenderDrawColorFloat(Ptr renderer, Ptr r, Ptr g, Ptr b, Ptr a)

    Ptr  SDL_GetKeyboardState(Ptr numkeys)
    bool SDL_PollEvent(Ptr event)

    void SDL_Delay(u32 ms)
    u64  SDL_GetTicks()

    Ptr  SDL_CreateTextureFromSurface(Ptr renderer, Ptr surface)
    void SDL_DestroyTexture(Ptr texture)
    bool SDL_RenderTexture(Ptr renderer, Ptr texture, Ptr src, Ptr dst)
    void SDL_DestroySurface(Ptr surface)
}

