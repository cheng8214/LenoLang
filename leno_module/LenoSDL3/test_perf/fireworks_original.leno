// fireworks.leno — 烟花压力测试（FPS 统计）
import "SDL3_original.leno" as SDL3
use SDL3.Event
use SDL3.Renderer
import maths
import rands

struct Particle {
    float x; float y
    float vx; float vy
    int life; int r; int g; int b
    int ptype
}

struct Rocket {
    float x; float y
    float vy
    int r; int g; int b
    float burst_y
    int burst_count
}

struct Star {
    float x; float y
    float twinkle
    int r; int g; int b
}

main() {
    var win = SDL3.createWindow({title: "Fireworks", w: 800, h: 600, flags: SDL3.WINDOW_RESIZABLE})
    if not win.ok { return }

    // 关 vsync 测真实帧率
    var ren = SDL3.createRenderer(win.handle)
    if not ren.ok { win.destroy(); return }

    var colors = [
        [255, 50, 50], [255, 140, 0], [255, 220, 0],
        [50, 255, 50], [0, 200, 255], [180, 50, 255],
        [255, 50, 200], [100, 255, 100], [255, 255, 100]
    ]

    var MAX_P = 10000
    var particles = {}
    var pids = {}
    var pc = 0
    var nid = 0

    var rockets = {}
    var rids = {}
    var rc = 0
    var rid_next = 0

    var stars = {}
    var sids = {}
    var sc = 0
    var sid_next = 0

    var frame = 0
    var peak = 0

    // FPS 统计
    var start_ticks = SDL3.getTicks()
    var last_fps_time = start_ticks
    var fps_frames = 0
    var cur_fps = 0
    var min_fps = 9999
    var total_frames = 0
    var fps_samples = 0

    // 星空
    for 0 : 99 to i {
        var s = new Star(
            x=rands.floats(0.0, 800.0), y=rands.floats(0.0, 500.0),
            twinkle=rands.floats(0.0, 6.28),
            r=150 + rands.ints(0, 105), g=150 + rands.ints(0, 105), b=200 + rands.ints(0, 55)
        )
        stars[sid_next] = s
        sids[sc] = sid_next
        sc = sc + 1
        sid_next = sid_next + 1
    }

    func clamp(int v): int {
        if v < 0 { return 0 }
        if v > 255 { return 255 }
        return v
    }

    // 爆炸
    func burst(float x, float y, int cr, int cg, int cb, int count, int min_l, int max_l, int ptype, float smin, float smax) {
        for 0 : count - 1 to i {
            if pc >= MAX_P { return }
            var a = rands.floats(0.0, 6.283)
            var s = rands.floats(smin, smax)
            var p = new Particle(
                x=x, y=y, vx=maths.cos(a) * s, vy=maths.sin(a) * s,
                life=rands.ints(min_l, max_l),
                r=clamp(cr + rands.ints(-30, 30)),
                g=clamp(cg + rands.ints(-30, 30)),
                b=clamp(cb + rands.ints(-30, 30)),
                ptype=ptype
            )
            particles[nid] = p; pids[pc] = nid; pc = pc + 1; nid = nid + 1
        }
    }

    func secBurst(float x, float y, int cr, int cg, int cb) {
        burst(x, y, cr, cg, cb, rands.ints(10, 25), 10, 25, 0, 0.5, 3.0)
    }

    func remP(int i) {
        var last = pc - 1
        var id = pids[i]
        particles.remove(id)
        if i != last { pids[i] = pids[last] }
        pids.remove(last)
        pc = pc - 1
    }

    func remR(int i) {
        var last = rc - 1
        var id = rids[i]
        rockets.remove(id)
        if i != last { rids[i] = rids[last] }
        rids.remove(last)
        rc = rc - 1
    }

    var ev = SDL3.createEvent()
    var running = true

    while running {
        while ev.poll() {
            if ev.isQuit() or ev.isWindowClose() { running = false }
            if ev.isKeyDown() and ev.scancode() == SDL3.SCANCODE_ESCAPE { running = false }
        }

        frame = frame + 1

        // 暗蓝背景
        ren.setColor(2, 2, 15, 255)
        ren.clear()

        // ---- 星空 ----
        var si = 0
        while si < sc {
            var s = stars[sids[si]]
            s.twinkle = s.twinkle + 0.03
            var a = 80 + _int(maths.sin(s.twinkle) * 60.0 + 60.0)
            ren.setColor(s.r, s.g, s.b, a)
            ren.drawPoint(s.x, s.y)
            si = si + 1
        }

        // ---- 发射（高频多枚） ----
        if frame % 6 == 0 {
            var count = rands.ints(1, 3)  // 每次 1-3 枚
            for 0 : count - 1 to _ {
                var c = colors[rands.ints(0, 8)]
                var rk = new Rocket(
                    x=rands.floats(80.0, 720.0), y=600.0,
                    vy=rands.floats(-6.0, -10.0),
                    r=c[0], g=c[1], b=c[2],
                    burst_y=rands.floats(60.0, 450.0),
                    burst_count=rands.ints(200, 500)
                )
                rockets[rid_next] = rk
                rids[rc] = rid_next
                rc = rc + 1
                rid_next = rid_next + 1
            }
        }

        // ---- 火箭 ----
        var ri = 0
        while ri < rc {
            var rk = rockets[rids[ri]]
            rk.y = rk.y + rk.vy
            if rk.y <= rk.burst_y {
                burst(rk.x, rk.y, rk.r, rk.g, rk.b, rk.burst_count, 30, 70, 0, 1.5, 6.0)
                burst(rk.x, rk.y, 255, 255, 240, rands.ints(5, 15), 5, 12, 1, 0.3, 2.5)
                burst(rk.x, rk.y, rk.r, rk.g, rk.b, rands.ints(15, 30), 20, 40, 2, 0.5, 3.5)
                burst(rk.x + rands.floats(-30.0, 30.0), 595.0, rk.r, rk.g, rk.b, rands.ints(15, 35), 8, 20, 3, 0.5, 3.0)
                remR(ri)
            } else {
                ren.setColor(rk.r, rk.g, rk.b, 200)
                ren.drawPoint(rk.x, rk.y)
                ren.drawPoint(rk.x + 1, rk.y + 2)
                ri = ri + 1
            }
        }

        // ---- 粒子 ----
        if pc > peak { peak = pc }
        var i = 0
        while i < pc {
            var p = particles[pids[i]]
            p.x = p.x + p.vx
            p.y = p.y + p.vy + 0.04
            p.vy = p.vy * 0.98
            p.life = p.life - 1
            if p.ptype != 1 { p.r = clamp(p.r - 1); p.g = clamp(p.g - 1); p.b = clamp(p.b - 1) }

            if p.life <= 0 or p.r <= 0 or p.y > 610 or p.y < -10 {
                remP(i)
            } else {
                if p.ptype == 1 {
                    ren.setColor(p.r, p.g, p.b, 160)
                    ren.drawPoint(p.x, p.y); ren.drawPoint(p.x+1, p.y); ren.drawPoint(p.x, p.y+1)
                } else if p.ptype == 3 {
                    ren.setColor(p.r, clamp(p.g+50), p.b, 220)
                    ren.drawPoint(p.x, p.y)
                } else {
                    ren.setColor(p.r, p.g, p.b, 255)
                    ren.drawPoint(p.x, p.y)
                    // 二次爆炸
                    if p.ptype == 2 and p.life == _int(_float(p.life) * 0.3) and rands.ints(0, 100) < 5 {
                        secBurst(p.x, p.y, p.r, p.g, p.b)
                    }
                }
                i = i + 1
            }
        }

        ren.present()

        // ---- FPS 统计（每秒） ----
        fps_frames = fps_frames + 1
        var now = SDL3.getTicks()
        if now - last_fps_time >= 1000 {
            cur_fps = fps_frames
            if cur_fps < min_fps { min_fps = cur_fps }
            total_frames = total_frames + fps_frames
            fps_samples = fps_samples + 1
            fps_frames = 0
            last_fps_time = now
        }
    }

    var elapsed = SDL3.getTicks() - start_ticks
    var avg_fps = if fps_samples > 0 then total_frames / fps_samples else 0

    ren.destroy()
    win.destroy()
    ev.uninit()
    print("===== 烟花压力测试 =====")
    print("运行时间: " + _float(elapsed) / 1000.0 + "s")
    print("总帧数: " + frame)
    print("峰值粒子: " + peak)
    print("平均FPS: " + avg_fps)
    print("最低FPS: " + min_fps)
}
