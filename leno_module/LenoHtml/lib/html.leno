// LenoHtml - 纯 Leno 实现的 HTML 解析器
// 使用模块级全局变量管理解析状态
// 使用泛型类型 Array[string]/Dict[string,string] 提高类型安全性
// 支持：HTML 实体解码、DOCTYPE、CDATA、容错解析

import strings

// ==================== 模块级全局状态 ====================

var _g_pos = 0
var _g_html = ""

// ==================== 辅助函数 ====================

func _isAlpha(int b): bool {
    return (b >= 97 and b <= 122) or (b >= 65 and b <= 90)
}

func _isAlphaNum(int b): bool {
    return (b >= 97 and b <= 122) or (b >= 65 and b <= 90) or (b >= 48 and b <= 57)
}

func _isSpace(int b): bool {
    return b == 32 or b == 9 or b == 10 or b == 13
}

// ==================== 解析器 ====================

func _parseTagName(): string {
    string tag = ""
    int len = _g_html.len()
    while _g_pos < len {
        int b = _g_html.byte(_g_pos)
        if _isAlphaNum(b) or b == 45 or b == 95 {
            tag = tag + strings.char(b)
            _g_pos = _g_pos + 1
        } else {
            break
        }
    }
    return tag
}

func _skipWs() {
    int len = _g_html.len()
    while _g_pos < len {
        int b = _g_html.byte(_g_pos)
        if _isSpace(b) {
            _g_pos = _g_pos + 1
        } else {
            break
        }
    }
}

func _parseAttrs(): Dict[string, string] {
    Dict[string, string] attrs = {}
    int len = _g_html.len()
    while _g_pos < len {
        while _g_pos < len and _isSpace(_g_html.byte(_g_pos)) {
            _g_pos = _g_pos + 1
        }
        if _g_pos >= len {
            break
        }
        int b = _g_html.byte(_g_pos)
        if b == 62 or b == 47 {
            break
        }
        // 跳过非法字符
        if b == 60 or b == 38 {
            _g_pos = _g_pos + 1
            continue
        }
        string name = ""
        while _g_pos < len {
            int ch = _g_html.byte(_g_pos)
            if _isSpace(ch) or ch == 61 or ch == 62 or ch == 47 or ch == 60 or ch == 38 {
                break
            }
            name = name + strings.char(ch)
            _g_pos = _g_pos + 1
        }
        if name == "" {
            _g_pos = _g_pos + 1
            continue
        }
        // 属性名转小写
        name = name.to_lower()
        while _g_pos < len and _isSpace(_g_html.byte(_g_pos)) {
            _g_pos = _g_pos + 1
        }
        string val = ""
        if _g_pos < len and _g_html.byte(_g_pos) == 61 {
            _g_pos = _g_pos + 1
            while _g_pos < len and _isSpace(_g_html.byte(_g_pos)) {
                _g_pos = _g_pos + 1
            }
            int q = -1
            if _g_pos < len {
                q = _g_html.byte(_g_pos)
            }
            if q == 34 or q == 39 {
                _g_pos = _g_pos + 1
                while _g_pos < len {
                    int ch = _g_html.byte(_g_pos)
                    if ch == q {
                        _g_pos = _g_pos + 1
                        break
                    }
                    val = val + strings.char(ch)
                    _g_pos = _g_pos + 1
                }
            } else {
                // 无引号属性值
                while _g_pos < len {
                    int ch = _g_html.byte(_g_pos)
                    if _isSpace(ch) or ch == 62 or ch == 47 {
                        break
                    }
                    val = val + strings.char(ch)
                    _g_pos = _g_pos + 1
                }
            }
        } else {
            // 布尔属性：checked, disabled, selected 等
            // HTML 中布尔属性存在即表示 true，值设为属性名本身
            val = name
        }
        attrs[name] = val
    }
    return attrs
}

func _parseText(): string {
    string text = ""
    int len = _g_html.len()
    while _g_pos < len {
        int b = _g_html.byte(_g_pos)
        if b == 60 {
            break
        }
        text = text + strings.char(b)
        _g_pos = _g_pos + 1
    }
    return text
}

// 判断是否为 void 标签（不需要闭合标签）
func _isVoidTag(string tagName): bool {
    return tagName == "br" or tagName == "hr" or tagName == "img" or
           tagName == "input" or tagName == "meta" or tagName == "link" or
           tagName == "area" or tagName == "base" or tagName == "col" or
           tagName == "embed" or tagName == "source" or tagName == "track" or
           tagName == "wbr"
}

// ==================== HTML 实体解码 ====================

func _namedEntity(string name): string {
    if name == "amp" { return "&" }
    if name == "lt" { return "<" }
    if name == "gt" { return ">" }
    if name == "quot" { return "\"" }
    if name == "apos" { return "'" }
    if name == "nbsp" { return " " }
    if name == "copy" { return "©" }
    if name == "reg" { return "®" }
    if name == "trade" { return "™" }
    if name == "hellip" { return "…" }
    if name == "mdash" { return "—" }
    if name == "ndash" { return "–" }
    if name == "laquo" { return "«" }
    if name == "raquo" { return "»" }
    if name == "ldquo" { return "\u201C" }
    if name == "rdquo" { return "\u201D" }
    if name == "lsquo" { return "‘" }
    if name == "rsquo" { return "’" }
    if name == "bull" { return "•" }
    if name == "middot" { return "·" }
    if name == "deg" { return "°" }
    if name == "plusmn" { return "±" }
    if name == "times" { return "×" }
    if name == "divide" { return "÷" }
    if name == "frac14" { return "¼" }
    if name == "frac12" { return "½" }
    if name == "frac34" { return "¾" }
    return ""
}

func _hexDigit(int ch): int {
    if ch >= 48 and ch <= 57 { return ch - 48 }
    if ch >= 65 and ch <= 70 { return ch - 55 }
    if ch >= 97 and ch <= 102 { return ch - 87 }
    return -1
}

func _codepointToUtf8(int cp): string {
    if cp <= 127 {
        return strings.char(cp)
    }
    if cp <= 2047 {
        int b1 = 192 + (cp / 64)
        int b2 = 128 + (cp % 64)
        return strings.char(b1) + strings.char(b2)
    }
    if cp <= 65535 {
        int b1 = 224 + (cp / 4096)
        int b2 = 128 + ((cp / 64) % 64)
        int b3 = 128 + (cp % 64)
        return strings.char(b1) + strings.char(b2) + strings.char(b3)
    }
    int b1 = 240 + (cp / 262144)
    int b2 = 128 + ((cp / 4096) % 64)
    int b3 = 128 + ((cp / 64) % 64)
    int b4 = 128 + (cp % 64)
    return strings.char(b1) + strings.char(b2) + strings.char(b3) + strings.char(b4)
}

func _decodeEntities(string text): string {
    string result = ""
    int i = 0
    int len = text.len()
    while i < len {
        int b = text.byte(i)
        if b == 38 {
            int savePos = i
            i = i + 1
            if i < len and text.byte(i) == 35 {
                i = i + 1
                int codepoint = 0
                if i < len and (text.byte(i) == 120 or text.byte(i) == 88) {
                    i = i + 1
                    while i < len {
                        int ch = text.byte(i)
                        if ch == 59 {
                            i = i + 1
                            break
                        }
                        int d = _hexDigit(ch)
                        if d < 0 { break }
                        codepoint = codepoint * 16 + d
                        i = i + 1
                    }
                } else {
                    while i < len {
                        int ch = text.byte(i)
                        if ch == 59 {
                            i = i + 1
                            break
                        }
                        if ch >= 48 and ch <= 57 {
                            codepoint = codepoint * 10 + (ch - 48)
                            i = i + 1
                        } else {
                            break
                        }
                    }
                }
                if codepoint > 0 and codepoint <= 1114111 {
                    result = result + _codepointToUtf8(codepoint)
                } else {
                    i = savePos + 1
                    result = result + strings.char(38)
                }
            } else {
                string name = ""
                while i < len {
                    int ch = text.byte(i)
                    if ch == 59 {
                        i = i + 1
                        break
                    }
                    if ch == 38 or _isSpace(ch) or ch == 60 or ch == 62 {
                        break
                    }
                    name = name + strings.char(ch)
                    i = i + 1
                }
                string decoded = _namedEntity(name)
                if decoded != "" {
                    result = result + decoded
                } else {
                    i = savePos + 1
                    result = result + strings.char(38)
                }
            }
        } else {
            result = result + strings.char(b)
            i = i + 1
        }
    }
    return result
}

// ==================== 元素解析 ====================

func _parseElement(): any {
    int len = _g_html.len()
    if _g_pos >= len {
        return null
    }
    if _g_html.byte(_g_pos) != 60 {
        return null
    }

    // 注释 <!-- ... -->
    if _g_pos + 3 < len and _g_html.byte(_g_pos+1) == 33 and _g_html.byte(_g_pos+2) == 45 and _g_html.byte(_g_pos+3) == 45 {
        _g_pos = _g_pos + 4
        while _g_pos < len {
            if _g_html.byte(_g_pos) == 45 and _g_pos+2 < len and _g_html.byte(_g_pos+1) == 45 and _g_html.byte(_g_pos+2) == 62 {
                _g_pos = _g_pos + 3
                break
            }
            _g_pos = _g_pos + 1
        }
        return null
    }

    // CDATA <![CDATA[ ... ]]>
    if _g_pos + 8 < len and _g_html.byte(_g_pos+1) == 33 and _g_html.byte(_g_pos+2) == 91 and _g_html.byte(_g_pos+3) == 67 and _g_html.byte(_g_pos+4) == 68 and _g_html.byte(_g_pos+5) == 65 and _g_html.byte(_g_pos+6) == 84 and _g_html.byte(_g_pos+7) == 65 and _g_html.byte(_g_pos+8) == 91 {
        _g_pos = _g_pos + 9
        string cdata = ""
        while _g_pos < len {
            if _g_pos + 2 < len and _g_html.byte(_g_pos) == 93 and _g_html.byte(_g_pos+1) == 93 and _g_html.byte(_g_pos+2) == 62 {
                _g_pos = _g_pos + 3
                break
            }
            cdata = cdata + strings.char(_g_html.byte(_g_pos))
            _g_pos = _g_pos + 1
        }
        var node = {tag: "#text", attrs: {}, children: [], text: cdata}
        return node
    }

    // DOCTYPE / 其他声明 <!...>
    if _g_pos + 1 < len and _g_html.byte(_g_pos+1) == 33 {
        _g_pos = _g_pos + 2
        while _g_pos < len and _g_html.byte(_g_pos) != 62 {
            _g_pos = _g_pos + 1
        }
        if _g_pos < len and _g_html.byte(_g_pos) == 62 {
            _g_pos = _g_pos + 1
        }
        return null
    }

    // 闭合标签 </...>
    if _g_pos + 1 < len and _g_html.byte(_g_pos+1) == 47 {
        return null
    }

    _g_pos = _g_pos + 1

    string tagName = _parseTagName()
    if tagName == "" {
        return null
    }
    tagName = strings.to_lower(tagName)

    Dict[string, string] attrs = _parseAttrs()

    bool selfClosing = false
    if _g_pos < len and _g_html.byte(_g_pos) == 47 {
        selfClosing = true
        _g_pos = _g_pos + 1
    }
    if _g_pos < len and _g_html.byte(_g_pos) == 62 {
        _g_pos = _g_pos + 1
    }

    if selfClosing {
        var node = {tag: tagName, attrs: attrs, children: [], text: ""}
        return node
    }

    if _isVoidTag(tagName) {
        var node = {tag: tagName, attrs: attrs, children: [], text: ""}
        return node
    }

    // script/style 标签：原始内容直接读取
    if tagName == "script" or tagName == "style" {
        string rawContent = ""
        while _g_pos < len {
            if _g_html.byte(_g_pos) == 60 and _g_pos+1 < len and _g_html.byte(_g_pos+1) == 47 {
                int savePos = _g_pos
                _g_pos = _g_pos + 2
                string closeTag = _parseTagName()
                closeTag = strings.to_lower(closeTag)
                if closeTag == tagName {
                    _parseAttrs()
                    if _g_pos < len and _g_html.byte(_g_pos) == 62 {
                        _g_pos = _g_pos + 1
                    }
                    var node = {tag: tagName, attrs: attrs, children: [], text: rawContent}
                    return node
                } else {
                    _g_pos = savePos
                    rawContent = rawContent + strings.char(_g_html.byte(_g_pos))
                    _g_pos = _g_pos + 1
                }
            } else {
                rawContent = rawContent + strings.char(_g_html.byte(_g_pos))
                _g_pos = _g_pos + 1
            }
        }
        var node = {tag: tagName, attrs: attrs, children: [], text: rawContent}
        return node
    }

    // 普通标签
    var children = []
    string textContent = ""

    while _g_pos < len {
        if _g_html.byte(_g_pos) == 60 {
            if _g_pos + 3 < len and _g_html.byte(_g_pos+1) == 33 and _g_html.byte(_g_pos+2) == 45 and _g_html.byte(_g_pos+3) == 45 {
                _g_pos = _g_pos + 4
                while _g_pos < len {
                    if _g_html.byte(_g_pos) == 45 and _g_pos+2 < len and _g_html.byte(_g_pos+1) == 45 and _g_html.byte(_g_pos+2) == 62 {
                        _g_pos = _g_pos + 3
                        break
                    }
                    _g_pos = _g_pos + 1
                }
                continue
            }
            // CDATA in body
            if _g_pos + 8 < len and _g_html.byte(_g_pos+1) == 33 and _g_html.byte(_g_pos+2) == 91 and _g_html.byte(_g_pos+3) == 67 and _g_html.byte(_g_pos+4) == 68 and _g_html.byte(_g_pos+5) == 65 and _g_html.byte(_g_pos+6) == 84 and _g_html.byte(_g_pos+7) == 65 and _g_html.byte(_g_pos+8) == 91 {
                _g_pos = _g_pos + 9
                string cdata = ""
                while _g_pos < len {
                    if _g_pos + 2 < len and _g_html.byte(_g_pos) == 93 and _g_html.byte(_g_pos+1) == 93 and _g_html.byte(_g_pos+2) == 62 {
                        _g_pos = _g_pos + 3
                        break
                    }
                    cdata = cdata + strings.char(_g_html.byte(_g_pos))
                    _g_pos = _g_pos + 1
                }
                if cdata != "" {
                    textContent = textContent + cdata
                    var textNode = {tag: "#text", attrs: {}, children: [], text: cdata}
                    children.add(textNode)
                }
                continue
            }
            if _g_pos + 1 < len and _g_html.byte(_g_pos+1) == 47 {
                _g_pos = _g_pos + 2
                _parseTagName()
                while _g_pos < len and _g_html.byte(_g_pos) != 62 {
                    _g_pos = _g_pos + 1
                }
                if _g_pos < len and _g_html.byte(_g_pos) == 62 {
                    _g_pos = _g_pos + 1
                }
                break
            }
            var child = _parseElement()
            if child != null {
                children.add(child)
            }
        } else {
            string text = _parseText()
            if text != "" {
                text = _decodeEntities(text)
                textContent = textContent + text
                var textNode = {tag: "#text", attrs: {}, children: [], text: text}
                children.add(textNode)
            }
        }
    }

    var node = {tag: tagName, attrs: attrs, children: children, text: textContent}
    return node
}

// ==================== 对外接口 ====================

export func parse(string html): any {
    _g_html = html
    _g_pos = 0

    var root = {tag: "#document", attrs: {}, children: [], text: ""}
    int len = _g_html.len()

    while _g_pos < len {
        while _g_pos < len and _isSpace(_g_html.byte(_g_pos)) {
            _g_pos = _g_pos + 1
        }
        if _g_pos >= len {
            break
        }
        if _g_html.byte(_g_pos) == 60 {
            // 注释
            if _g_pos + 3 < len and _g_html.byte(_g_pos+1) == 33 and _g_html.byte(_g_pos+2) == 45 and _g_html.byte(_g_pos+3) == 45 {
                _g_pos = _g_pos + 4
                while _g_pos < len {
                    if _g_html.byte(_g_pos) == 45 and _g_pos+2 < len and _g_html.byte(_g_pos+1) == 45 and _g_html.byte(_g_pos+2) == 62 {
                        _g_pos = _g_pos + 3
                        break
                    }
                    _g_pos = _g_pos + 1
                }
                continue
            }
            // DOCTYPE / CDATA / 其他声明
            if _g_pos + 1 < len and _g_html.byte(_g_pos+1) == 33 {
                if _g_pos + 8 < len and _g_html.byte(_g_pos+2) == 91 and _g_html.byte(_g_pos+3) == 67 and _g_html.byte(_g_pos+4) == 68 and _g_html.byte(_g_pos+5) == 65 and _g_html.byte(_g_pos+6) == 84 and _g_html.byte(_g_pos+7) == 65 and _g_html.byte(_g_pos+8) == 91 {
                    // CDATA
                    _g_pos = _g_pos + 9
                    string cdata = ""
                    while _g_pos < len {
                        if _g_pos + 2 < len and _g_html.byte(_g_pos) == 93 and _g_html.byte(_g_pos+1) == 93 and _g_html.byte(_g_pos+2) == 62 {
                            _g_pos = _g_pos + 3
                            break
                        }
                        cdata = cdata + strings.char(_g_html.byte(_g_pos))
                        _g_pos = _g_pos + 1
                    }
                    if cdata != "" {
                        var textNode = {tag: "#text", attrs: {}, children: [], text: cdata}
                        var kidsRaw = root["children"]
                        if kidsRaw is Array {
                            kidsRaw.add(textNode)
                        }
                    }
                    continue
                }
                // 其他 <!...> 跳过
                _g_pos = _g_pos + 2
                while _g_pos < len and _g_html.byte(_g_pos) != 62 {
                    _g_pos = _g_pos + 1
                }
                if _g_pos < len and _g_html.byte(_g_pos) == 62 {
                    _g_pos = _g_pos + 1
                }
                continue
            }
            // 闭合标签（忽略孤立的）
            if _g_pos + 1 < len and _g_html.byte(_g_pos+1) == 47 {
                _g_pos = _g_pos + 2
                while _g_pos < len and _g_html.byte(_g_pos) != 62 {
                    _g_pos = _g_pos + 1
                }
                if _g_pos < len and _g_html.byte(_g_pos) == 62 {
                    _g_pos = _g_pos + 1
                }
                continue
            }
            var child = _parseElement()
            if child != null {
                var kidsRaw = root["children"]
                if kidsRaw is Array {
                    kidsRaw.add(child)
                }
            }
        } else {
            string text = _parseText()
            if text != "" {
                text = _decodeEntities(text)
                var textNode = {tag: "#text", attrs: {}, children: [], text: text}
                var kidsRaw = root["children"]
                if kidsRaw is Array {
                    kidsRaw.add(textNode)
                }
            }
        }
    }

    return root
}

// ==================== 便捷函数 ====================

export func tag(any node): string {
    if node is Dict {
        var v = node["tag"]
        if v is string {
            return v
        }
    }
    return ""
}

export func text(any node): string {
    if node is Dict {
        var v = node["text"]
        if v is string {
            return v
        }
    }
    return ""
}

export func allText(any node): string {
    if node == null {
        return ""
    }
    string result = ""
    if node is Dict {
        var t = node["tag"]
        if t is string {
            if t == "#text" {
                var txt = node["text"]
                if txt is string {
                    return txt
                }
            }
        }
        var kids = node["children"]
        if kids is Array {
            for kids to child {
                result = result + allText(child)
            }
        }
    }
    return result
}

export func attr(any node, string name): string {
    if node is Dict {
        var a = node["attrs"]
        if a is Dict[string, string] {
            var v = a[name]
            if v is string {
                return _decodeEntities(v)
            }
        }
    }
    return ""
}

export func children(any node): Array {
    if node is Dict {
        var kids = node["children"]
        if kids is Array {
            return kids
        }
    }
    return []
}

export func getLinks(string html): Array[string] {
    var root = parse(html)
    var links = []
    _collectLinks(root, links)
    return links
}

func _collectLinks(any node, Array links) {
    if node == null {
        return
    }
    if node is Dict {
        var t = node["tag"]
        if t is string {
            if t == "a" {
                var a = node["attrs"]
                if a is Dict[string, string] {
                    var href = a["href"]
                    if href != "" {
                        links.add(href)
                    }
                }
            }
        }
        var kids = node["children"]
        if kids is Array {
            for kids to child {
                _collectLinks(child, links)
            }
        }
    }
}

// ==================== CSS 选择器 ====================

func _parseSimple(string selector): Dict {
    var r = {tag: "", id: "", classes: [], attrName: "", attrValue: "", hasAttr: false}
    int i = 0
    int slen = selector.len()

    while i < slen {
        int b = selector.byte(i)
        if _isAlphaNum(b) or b == 42 or b == 45 or b == 95 {
            var tagRaw = r["tag"]
            if tagRaw is string {
                r["tag"] = tagRaw + strings.char(b)
            }
            i = i + 1
        } else {
            break
        }
    }

    while i < slen {
        int b = selector.byte(i)
        if b == 46 {
            i = i + 1
            string cls = ""
            while i < slen {
                int ch = selector.byte(i)
                if ch == 46 or ch == 35 or ch == 91 or ch == 58 {
                    break
                }
                cls = cls + strings.char(ch)
                i = i + 1
            }
            var classesRaw = r["classes"]
            if classesRaw is Array {
                classesRaw.add(cls)
            }
        } else if b == 35 {
            i = i + 1
            string idVal = ""
            while i < slen {
                int ch = selector.byte(i)
                if ch == 46 or ch == 35 or ch == 91 or ch == 58 {
                    break
                }
                idVal = idVal + strings.char(ch)
                i = i + 1
            }
            r["id"] = idVal
        } else if b == 91 {
            i = i + 1
            string attrName = ""
            while i < slen {
                int ch = selector.byte(i)
                if ch == 61 or ch == 93 {
                    break
                }
                attrName = attrName + strings.char(ch)
                i = i + 1
            }
            r["attrName"] = attrName
            r["hasAttr"] = true
            if i < slen and selector.byte(i) == 61 {
                i = i + 1
                string attrVal = ""
                while i < slen {
                    int ch = selector.byte(i)
                    if ch == 93 {
                        break
                    }
                    attrVal = attrVal + strings.char(ch)
                    i = i + 1
                }
                r["attrValue"] = attrVal
            }
            if i < slen and selector.byte(i) == 93 {
                i = i + 1
            }
        } else {
            break
        }
    }

    return r
}

func _splitSelector(string selector): Array {
    Array parts = []
    string current = ""
    int i = 0
    int slen = selector.len()
    bool lastWasChild = false

    while i < slen {
        int b = selector.byte(i)
        if b == 62 {
            if current != "" {
                Dict parsed = _parseSimple(current)
                parsed["isChild"] = false
                parts.add(parsed)
                current = ""
            }
            lastWasChild = true
            i = i + 1
        } else if _isSpace(b) {
            if current != "" {
                Dict parsed = _parseSimple(current)
                parsed["isChild"] = lastWasChild
                parts.add(parsed)
                current = ""
                lastWasChild = false
            }
            i = i + 1
        } else {
            current = current + strings.char(b)
            i = i + 1
        }
    }

    if current != "" {
        Dict parsed = _parseSimple(current)
        parsed["isChild"] = lastWasChild
        parts.add(parsed)
    }

    return parts
}

func _hasWord(string str, string word): bool {
    if str == "" or word == "" {
        return false
    }
    int i = 0
    int slen = str.len()
    while i < slen {
        while i < slen and _isSpace(str.byte(i)) {
            i = i + 1
        }
        string w = ""
        while i < slen {
            int b = str.byte(i)
            if _isSpace(b) {
                break
            }
            w = w + strings.char(b)
            i = i + 1
        }
        if w == word {
            return true
        }
    }
    return false
}

func _matchSimple(any node, Dict sel): bool {
    if node == null {
        return false
    }
    if node is Dict {
        var tagVal = sel["tag"]
        if tagVal is string {
            if tagVal != "" and tagVal != "*" {
                var nt = node["tag"]
                if nt is string {
                    if nt != tagVal {
                        return false
                    }
                } else {
                    return false
                }
            }
        }

        var idVal = sel["id"]
        if idVal is string {
            if idVal != "" {
                var a = node["attrs"]
                if a is Dict {
                    var nodeId = a["id"]
                    if nodeId is string {
                        if nodeId != idVal {
                            return false
                        }
                    } else {
                        return false
                    }
                } else {
                    return false
                }
            }
        }

        var classesRaw = sel["classes"]
        if classesRaw is Array {
            var nodeAttrs = node["attrs"]
            if nodeAttrs is Dict {
                var nodeClass = nodeAttrs["class"]
                if nodeClass is string {
                    for classesRaw to cls {
                        if cls is string {
                            if not _hasWord(nodeClass, cls) {
                                return false
                            }
                        }
                    }
                } else {
                    if classesRaw.len() > 0 {
                        return false
                    }
                }
            }
        }

        var hasAttr = sel["hasAttr"]
        if hasAttr is bool {
            if hasAttr {
                var attrName = sel["attrName"]
                if attrName is string {
                    if attrName != "" {
                        var nodeAttrs = node["attrs"]
                        if nodeAttrs is Dict {
                            var nodeAttrVal = nodeAttrs[attrName]
                            var selAttrVal = sel["attrValue"]
                            if selAttrVal is string {
                                if selAttrVal != "" {
                                    if nodeAttrVal is string {
                                        if nodeAttrVal != selAttrVal {
                                            return false
                                        }
                                    } else {
                                        return false
                                    }
                                }
                            }
                        } else {
                            return false
                        }
                    }
                }
            }
        }

        return true
    }
    return false
}

func _findDescendants(any node, Dict sel, Array results) {
    if node == null {
        return
    }
    if node is Dict {
        var kids = node["children"]
        if kids is Array {
            for kids to child {
                if _matchSimple(child, sel) {
                    results.add(child)
                }
                _findDescendants(child, sel, results)
            }
        }
    }
}

func _findDirectChildren(any node, Dict sel, Array results) {
    if node == null {
        return
    }
    if node is Dict {
        var kids = node["children"]
        if kids is Array {
            for kids to child {
                if _matchSimple(child, sel) {
                    results.add(child)
                }
            }
        }
    }
}

export func select(any root, string selector): Array[any] {
    var parts = _splitSelector(selector)
    if parts.len() == 0 {
        return []
    }

    var current = [root]
    int partsLen = parts.len()
    for 0:partsLen to pi {
        if pi >= partsLen {
            break
        }
        var p0raw = parts[pi]
        if p0raw is Dict {
            var next = []
            for current to node {
                var isChildVal = p0raw["isChild"]
                if isChildVal is bool {
                    if isChildVal {
                        _findDirectChildren(node, p0raw, next)
                    } else {
                        _findDescendants(node, p0raw, next)
                    }
                } else {
                    _findDescendants(node, p0raw, next)
                }
            }
            current = next
        }
    }

    return current
}

export func selectOne(any root, string selector): any {
    var results = select(root, selector)
    if results.len() > 0 {
        return results[0]
    }
    return null
}
