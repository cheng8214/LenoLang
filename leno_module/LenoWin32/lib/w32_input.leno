// w32_input.leno — Windows 模拟输入（SendInput）
// 封装 user32.dll 的 SendInput，模拟键盘按键和鼠标操作
// 参考：易语言的「模拟按键」模块、AutoHotKey 的 Send/Click 命令
// 用途：自动按键、连点、宏操作等
import ffi

// ==================== USER32 ====================
clib user32 {
    u32 SendInput(u32 count, Ptr inputs, i32 size)
    u32 MapVirtualKeyA(u32 code, u32 mapType)
    i16 GetAsyncKeyState(i32 vk)
}

user32 _usr = null
func _lib(): user32 {
    if _usr == null { _usr = ffi.load("user32.dll") }
    return _usr
}

// ==================== 常量 ====================
// 输入类型
const INPUT_KEYBOARD = 1
const INPUT_MOUSE    = 0

// 键盘事件标志
const KEYEVENTF_KEYDOWN  = 0x0000   // 按下
const KEYEVENTF_KEYUP     = 0x0002   // 释放
const KEYEVENTF_SCANCODE  = 0x0008   // 使用扫描码

// 鼠标事件标志
const MOUSEEVENTF_MOVE       = 0x0001
const MOUSEEVENTF_LEFTDOWN   = 0x0002
const MOUSEEVENTF_LEFTUP     = 0x0004
const MOUSEEVENTF_RIGHTDOWN  = 0x0008
const MOUSEEVENTF_RIGHTUP    = 0x0010
const MOUSEEVENTF_MIDDLEDOWN = 0x0020
const MOUSEEVENTF_MIDDLEUP   = 0x0040
const MOUSEEVENTF_ABSOLUTE   = 0x8000

// 虚拟键码（常用）
export const VK_BACK    = 0x08
export const VK_TAB     = 0x09
export const VK_RETURN  = 0x0D
export const VK_SHIFT   = 0x10
export const VK_CONTROL = 0x11
export const VK_MENU    = 0x12   // Alt
export const VK_ESCAPE  = 0x1B
export const VK_SPACE   = 0x20
export const VK_LEFT    = 0x25
export const VK_UP      = 0x26
export const VK_RIGHT   = 0x27
export const VK_DOWN    = 0x28
export const VK_0 = 0x30
export const VK_1 = 0x31
export const VK_2 = 0x32
export const VK_3 = 0x33
export const VK_4 = 0x34
export const VK_5 = 0x35
export const VK_6 = 0x36
export const VK_7 = 0x37
export const VK_8 = 0x38
export const VK_9 = 0x39
export const VK_A = 0x41
export const VK_B = 0x42
export const VK_C = 0x43
export const VK_D = 0x44
export const VK_E = 0x45
export const VK_F = 0x46
export const VK_G = 0x47
export const VK_H = 0x48
export const VK_I = 0x49
export const VK_J = 0x4A
export const VK_K = 0x4B
export const VK_L = 0x4C
export const VK_M = 0x4D
export const VK_N = 0x4E
export const VK_O = 0x4F
export const VK_P = 0x50
export const VK_Q = 0x51
export const VK_R = 0x52
export const VK_S = 0x53
export const VK_T = 0x54
export const VK_U = 0x55
export const VK_V = 0x56
export const VK_W = 0x57
export const VK_X = 0x58
export const VK_Y = 0x59
export const VK_Z = 0x5A
export const VK_F1  = 0x70
export const VK_F2  = 0x71
export const VK_F3  = 0x72
export const VK_F4  = 0x73
export const VK_F5  = 0x74
export const VK_F6  = 0x75
export const VK_F7  = 0x76
export const VK_F8  = 0x77
export const VK_F9  = 0x78
export const VK_F10 = 0x79
export const VK_F11 = 0x7A
export const VK_F12 = 0x7B

// ==================== INPUT 结构体 ====================
// KEYBDINPUT 结构 (sizeof = 32 bytes on x64)
// layout: wVk(2) + wScan(2) + dwFlags(4) + pad(4) + time(8) + dwExtraInfo(8) + pad(8) = 32
// MOUSEINPUT 结构 (sizeof = 40 bytes on x64)
// layout: dx(4) + dy(4) + mouseData(4) + dwFlags(4) + time(4) + pad(4) + dwExtraInfo(8) = 32
// 实际上 SendInput 的 INPUT 结构是 union，最大的是 MOUSEINPUT
// INPUT 结构 on x64: type(4) + pad(4) + ki/mi(32) = 40 bytes
// 但实际 sizeof(INPUT) on x64 = 40 bytes
//
// 我们用手动构造内存的方式来发送 INPUT

// INPUT 结构体大小 (x64)
const INPUT_SIZE = 40

// ==================== 内部辅助 ====================

// 构造键盘 INPUT 并发送
// vk: 虚拟键码, flags: KEYEVENTF_KEYDOWN 或 KEYEVENTF_KEYUP
func _sendKey(int vk, int flags): bool {
    // INPUT 结构: type(4) + pad(4) + wVk(2) + wScan(2) + dwFlags(4) + pad(4) + time(8) + dwExtraInfo(8)
    Ptr[u8] buf = ffi.malloc(INPUT_SIZE)
    if buf == null { return false }
    try {
        // type = INPUT_KEYBOARD = 1
        ffi.write_int(buf, 0, INPUT_KEYBOARD)
        // pad = 0 (offset 4-7)
        // wVk (offset 8, 2 bytes)
        ffi.write_int16(buf, 8, vk)
        // wScan (offset 10, 2 bytes) - 通过 MapVirtualKey 获取扫描码
        int scan = _int(_lib().MapVirtualKeyA(vk, 0))
        ffi.write_int16(buf, 10, scan)
        // dwFlags (offset 12, 4 bytes)
        ffi.write_int(buf, 12, flags)
        // time = 0 (offset 16, 8 bytes) - 系统自动填充
        // dwExtraInfo = 0 (offset 24, 8 bytes)
        int sent = _int(_lib().SendInput(1, buf, INPUT_SIZE))
        return sent > 0
    } finally {
        ffi.free(buf)
    }
}

// ==================== 公开 API - 键盘 ====================

// 按下按键
export func keyDown(int vk): bool {
    return _sendKey(vk, KEYEVENTF_KEYDOWN)
}

// 释放按键
export func keyUp(int vk): bool {
    return _sendKey(vk, KEYEVENTF_KEYUP)
}

// 按一下按键（按下后立即释放）
export func keyPress(int vk): bool {
    bool down = _sendKey(vk, KEYEVENTF_KEYDOWN)
    bool up = _sendKey(vk, KEYEVENTF_KEYUP)
    return down and up
}

// 按一下按键并等待间隔（毫秒）
export func keyPressDelay(int vk, int delayMs): bool {
    bool down = _sendKey(vk, KEYEVENTF_KEYDOWN)
    sleep(delayMs)
    bool up = _sendKey(vk, KEYEVENTF_KEYUP)
    return down and up
}

// 组合键（如 Ctrl+C: 按下Ctrl → 按下C → 释放C → 释放Ctrl）
export func keyCombo(Array[int] keys): bool {
    bool ok = true
    // 全部按下
    for keys to k {
        if not _sendKey(k, KEYEVENTF_KEYDOWN) { ok = false }
    }
    // 全部释放（逆序）
    int n = keys.len()
    for 0:(n-1) to i {
        int k = keys[n - 1 - i]
        if not _sendKey(k, KEYEVENTF_KEYUP) { ok = false }
    }
    return ok
}

// 连续按键（连按 N 次）
export func keyRepeat(int vk, int count, int intervalMs): bool {
    bool ok = true
    for 0:(count-1) to i {
        if not keyPress(vk) { ok = false }
        if i < count - 1 and intervalMs > 0 {
            sleep(intervalMs)
        }
    }
    return ok
}

// ==================== 公开 API - 鼠标 ====================

// 构造鼠标 INPUT 并发送
// dx, dy: 移动量（相对）或绝对坐标, flags: 鼠标事件标志
func _sendMouse(int dx, int dy, int mouseData, int flags): bool {
    // INPUT 结构 on x64:
    // type(4) + pad(4) + dx(4) + dy(4) + mouseData(4) + dwFlags(4) + time(4) + pad(4) + dwExtraInfo(8)
    Ptr[u8] buf = ffi.malloc(INPUT_SIZE)
    if buf == null { return false }
    try {
        // type = INPUT_MOUSE = 0
        ffi.write_int(buf, 0, INPUT_MOUSE)
        // pad (offset 4-7) = 0
        // dx (offset 8, 4 bytes)
        ffi.write_int(buf, 8, dx)
        // dy (offset 12, 4 bytes)
        ffi.write_int(buf, 12, dy)
        // mouseData (offset 16, 4 bytes)
        ffi.write_int(buf, 16, mouseData)
        // dwFlags (offset 20, 4 bytes)
        ffi.write_int(buf, 20, flags)
        // time = 0 (offset 24, 4 bytes)
        // pad (offset 28, 4 bytes)
        // dwExtraInfo = 0 (offset 32, 8 bytes)
        int sent = _int(_lib().SendInput(1, buf, INPUT_SIZE))
        return sent > 0
    } finally {
        ffi.free(buf)
    }
}

// 鼠标左键单击
export func leftClick(): bool {
    bool d = _sendMouse(0, 0, 0, MOUSEEVENTF_LEFTDOWN)
    bool u = _sendMouse(0, 0, 0, MOUSEEVENTF_LEFTUP)
    return d and u
}

// 鼠标左键双击
export func leftDoubleClick(): bool {
    leftClick()
    sleep(50)
    return leftClick()
}

// 鼠标右键单击
export func rightClick(): bool {
    bool d = _sendMouse(0, 0, 0, MOUSEEVENTF_RIGHTDOWN)
    bool u = _sendMouse(0, 0, 0, MOUSEEVENTF_RIGHTUP)
    return d and u
}

// 鼠标中键单击
export func middleClick(): bool {
    bool d = _sendMouse(0, 0, 0, MOUSEEVENTF_MIDDLEDOWN)
    bool u = _sendMouse(0, 0, 0, MOUSEEVENTF_MIDDLEUP)
    return d and u
}

// 鼠标左键按下
export func leftDown(): bool {
    return _sendMouse(0, 0, 0, MOUSEEVENTF_LEFTDOWN)
}

// 鼠标左键释放
export func leftUp(): bool {
    return _sendMouse(0, 0, 0, MOUSEEVENTF_LEFTUP)
}

// 鼠标相对移动
export func moveRelative(int dx, int dy): bool {
    return _sendMouse(dx, dy, 0, MOUSEEVENTF_MOVE)
}

// 鼠标绝对移动（0-65535 范围）
// screenW/screenH 为屏幕分辨率，x/y 为像素坐标
export func moveAbsolute(int x, int y, int screenW, int screenH): bool {
    int dx = _int(x * 65535 / screenW)
    int dy = _int(y * 65535 / screenH)
    return _sendMouse(dx, dy, 0, MOUSEEVENTF_MOVE | MOUSEEVENTF_ABSOLUTE)
}

// 鼠标滚轮滚动
// delta: 正值向上滚, 负值向下滚, 通常 ±120
export func mouseWheel(int delta): bool {
    return _sendMouse(0, 0, delta, 0x0800)  // MOUSEEVENTF_WHEEL = 0x0800
}

// ==================== 状态查询 ====================

// 检查按键是否按下
export func isKeyDown(int vk): bool {
    int s = _int(_lib().GetAsyncKeyState(vk))
    return (s & 0x8000) != 0
}

// 检查组合键是否同时按下
export func areKeysDown(Array[int] keys): bool {
    for keys to k {
        if not isKeyDown(k) { return false }
    }
    return true
}
