// w32_reg.leno — Windows 注册表操作（Unicode 版本）
// 封装 advapi32.dll 和 kernel32.dll 的注册表相关 API
// 支持基本键操作、值读写（字符串/DWORD/QWORD/二进制/MULTI_SZ）、枚举子键和值
import ffi

// ==================== ADVAPI32 ====================
clib advapi32 {
    i32 RegOpenKeyExW(Ptr hKey, Ptr subKey, i32 ulOptions, u32 samDesired, Ptr phkResult)
    i32 RegCreateKeyExW(Ptr hKey, Ptr subKey, i32 reserved, Ptr lpClass, i32 dwOptions, u32 samDesired, Ptr lpSecurity, Ptr phkResult, Ptr lpdwDisposition)
    i32 RegCloseKey(Ptr hKey)
    i32 RegDeleteKeyW(Ptr hKey, Ptr subKey)
    i32 RegEnumKeyExW(Ptr hKey, i32 index, Ptr name, Ptr nameLen, Ptr reserved, Ptr lpClass, Ptr lpcbClass, Ptr lpftLastWrite)
    i32 RegEnumValueW(Ptr hKey, i32 index, Ptr name, Ptr nameLen, Ptr reserved, Ptr type, Ptr data, Ptr dataLen)
    i32 RegQueryValueExW(Ptr hKey, Ptr valueName, Ptr reserved, Ptr type, Ptr data, Ptr dataSize)
    i32 RegSetValueExW(Ptr hKey, Ptr valueName, i32 reserved, u32 type, Ptr data, i32 dataSize)
    i32 RegDeleteValueW(Ptr hKey, Ptr valueName)
    i32 RegFlushKey(Ptr hKey)
}

advapi32 _adv = null
func _advLib(): advapi32 {
    if _adv == null { _adv = ffi.load("advapi32.dll") }
    return _adv
}

// ==================== KERNEL32 ====================
clib kernel32 {
    u32 ExpandEnvironmentStringsW(Ptr lpSrc, Ptr lpDst, u32 nSize)
}

kernel32 _krnl = null
func _krnlLib(): kernel32 {
    if _krnl == null { _krnl = ffi.load("kernel32.dll") }
    return _krnl
}

// ==================== 枚举定义 ==========================

// 访问权限
export enum KeyAccess {
    QUERY_VALUE        = 0x0001
    SET_VALUE          = 0x0002
    CREATE_SUB_KEY     = 0x0004
    ENUMERATE_SUB_KEYS = 0x0008
    READ               = 0x20019
    WRITE              = 0x20006
    ALL_ACCESS         = 0xF003F
}

// 值类型
export enum ValueType {
    NONE        = 0
    SZ          = 1
    EXPAND_SZ   = 2
    BINARY      = 3
    DWORD       = 4
    MULTI_SZ    = 7
    QWORD       = 11
}

// HKEY 根键枚举（主要用于文档目的，实际传参建议使用 HKEY_* Ptr 常量）
export enum HKey {
    CLASSES_ROOT   = 0x80000000
    CURRENT_USER   = 0x80000001
    LOCAL_MACHINE  = 0x80000002
    USERS          = 0x80000003
    CURRENT_CONFIG = 0x80000005
}

// Windows 错误码
export enum WinError {
    SUCCESS             = 0
    FILE_NOT_FOUND      = 2
    PATH_NOT_FOUND      = 3
    ACCESS_DENIED       = 5
    INVALID_HANDLE      = 6
    OUTOFMEMORY         = 14
    MORE_DATA           = 234
    NO_MORE_ITEMS       = 259
    KEY_DELETED         = 1018
}

// ==================== Struct 定义 ==========================

// 注册表值信息
export struct RegValueInfo {
    string name = ""
    int type = 0
    string typeName = ""
}

// 打开键结果
export struct OpenKeyResult {
    Ptr handle = null
    int errorCode = 0
}

// 创建键结果
export struct CreateKeyResult {
    Ptr handle = null
    int errorCode = 0
    bool created = false
}

// 读取字符串结果
export struct ReadStringResult {
    string value = ""
    int errorCode = 0
}

// 读取展开字符串结果
export struct ReadExpandStringResult {
    string value = ""
    int errorCode = 0
}

// 读取二进制结果
export struct ReadBinaryResult {
    Array data = []
    int errorCode = 0
}

// 读取多字符串结果
export struct ReadMultiStringResult {
    Array strings = []
    int errorCode = 0
}

// 读取 DWORD 结果
export struct ReadDwordResult {
    int value = 0
    int errorCode = 0
}

// 读取 QWORD 结果
export struct ReadQwordResult {
    int value = 0
    int errorCode = 0
}

// 枚举子键结果
export struct EnumSubKeysResult {
    Array subKeys = []
    int errorCode = 0
}

// 枚举值结果
export struct EnumValuesResult {
    Array values = []
    int errorCode = 0
}

// ==================== HKEY 根键常量 ==========================

// 预计算的 HKEY 根键指针，直接用于 openKey / createKey 等函数的 hKey 参数
export var HKEY_CLASSES_ROOT   = ffi.ptr_from_int(0x80000000)
export var HKEY_CURRENT_USER   = ffi.ptr_from_int(0x80000001)
export var HKEY_LOCAL_MACHINE  = ffi.ptr_from_int(0x80000002)
export var HKEY_USERS          = ffi.ptr_from_int(0x80000003)
export var HKEY_CURRENT_CONFIG = ffi.ptr_from_int(0x80000005)

// ==================== 内部辅助函数 ==========================

// 将 HKey enum 值或 Ptr 转换为 Ptr
func _getHKeyPtr(any hKey):Ptr {
    if hKey is Ptr {
        return hKey
    }
    switch hKey {
        case HKey.CLASSES_ROOT   { return HKEY_CLASSES_ROOT }
        case HKey.CURRENT_USER   { return HKEY_CURRENT_USER }
        case HKey.LOCAL_MACHINE  { return HKEY_LOCAL_MACHINE }
        case HKey.USERS          { return HKEY_USERS }
        case HKey.CURRENT_CONFIG { return HKEY_CURRENT_CONFIG }
        default {
            return ffi.ptr_from_int(hKey)
        }
    }
}

// 将错误码转为可读字符串
export func errorToString(int errorCode):string {
    switch errorCode {
        case WinError.SUCCESS { return "SUCCESS" }
        case WinError.FILE_NOT_FOUND { return "FILE_NOT_FOUND" }
        case WinError.PATH_NOT_FOUND { return "PATH_NOT_FOUND" }
        case WinError.ACCESS_DENIED { return "ACCESS_DENIED" }
        case WinError.INVALID_HANDLE { return "INVALID_HANDLE" }
        case WinError.OUTOFMEMORY { return "OUTOFMEMORY" }
        case WinError.MORE_DATA { return "MORE_DATA" }
        case WinError.NO_MORE_ITEMS { return "NO_MORE_ITEMS" }
        case WinError.KEY_DELETED { return "KEY_DELETED" }
        default { return "UNKNOWN_ERROR(" + errorCode + ")" }
    }
}

// ==================== 键操作 ==========================

// 打开注册表键
export func openKey(any hKey, string subKey, int samDesired):OpenKeyResult {
    Ptr hResult = ffi.malloc(8)
    try {
        Ptr wSubKey = ffi.utf8_to_utf16(subKey)
        try {
            Ptr hKeyPtr = _getHKeyPtr(hKey)
            int result = _advLib().RegOpenKeyExW(hKeyPtr, wSubKey, 0, samDesired, hResult)
            if result == WinError.SUCCESS {
                return new OpenKeyResult(handle = ffi.read_ptr(hResult, 0), errorCode = 0)
            }
            return new OpenKeyResult(handle = null, errorCode = result)
        } finally {
            ffi.free(wSubKey)
        }
    } finally {
        ffi.free(hResult)
    }
}

// 创建注册表键（如已存在则打开）
export func createKey(any hKey, string subKey, int samDesired):CreateKeyResult {
    Ptr hResult = ffi.malloc(8)
    Ptr disp = ffi.malloc(4)
    try {
        Ptr wSubKey = ffi.utf8_to_utf16(subKey)
        try {
            Ptr hKeyPtr = _getHKeyPtr(hKey)
            int result = _advLib().RegCreateKeyExW(hKeyPtr, wSubKey, 0, ffi.nullptr(), 0,
                samDesired, ffi.nullptr(), hResult, disp)
            if result == WinError.SUCCESS {
                return new CreateKeyResult(
                    handle = ffi.read_ptr(hResult, 0),
                    errorCode = 0,
                    created = ffi.read_int(disp, 0) == 1
                )
            }
            return new CreateKeyResult(handle = null, errorCode = result, created = false)
        } finally {
            ffi.free(wSubKey)
        }
    } finally {
        ffi.free(hResult)
        ffi.free(disp)
    }
}

// 关闭注册表键
export func closeKey(Ptr hKey):int {
    return _advLib().RegCloseKey(hKey)
}

// 删除注册表键
export func deleteKey(any hKey, string subKey):int {
    Ptr wSubKey = ffi.utf8_to_utf16(subKey)
    try {
        Ptr hKeyPtr = _getHKeyPtr(hKey)
        return _advLib().RegDeleteKeyW(hKeyPtr, wSubKey)
    } finally {
        ffi.free(wSubKey)
    }
}

// ==================== 枚举操作 ==========================

// 枚举子键名称
export func enumSubKeys(Ptr hKey):EnumSubKeysResult {
    var subKeys = []
    int index = 0

    while true {
        Ptr nameBuf = ffi.malloc(512)
        Ptr nameLen = ffi.malloc(4)
        ffi.write_int(nameLen, 0, 256)

        int result = _advLib().RegEnumKeyExW(hKey, index, nameBuf, nameLen,
            null, null, null, null)

        if result == WinError.NO_MORE_ITEMS {
            ffi.free(nameBuf)
            ffi.free(nameLen)
            break
        }

        if result == WinError.SUCCESS {
            var keyName = ffi.utf16_to_utf8(nameBuf)
            subKeys.add(keyName)
            index = index + 1
        }

        ffi.free(nameBuf)
        ffi.free(nameLen)

        if result != WinError.SUCCESS and result != WinError.NO_MORE_ITEMS {
            return new EnumSubKeysResult(subKeys = subKeys, errorCode = result)
        }
    }
    return new EnumSubKeysResult(subKeys = subKeys, errorCode = 0)
}

// 枚举值信息
export func enumValues(Ptr hKey):EnumValuesResult {
    var values = []
    int index = 0

    while true {
        Ptr nameBuf = ffi.malloc(512)
        Ptr nameLen = ffi.malloc(4)
        ffi.write_int(nameLen, 0, 256)

        Ptr typeBuf = ffi.malloc(4)
        Ptr dataBuf = ffi.malloc(2048)
        Ptr dataLen = ffi.malloc(4)
        ffi.write_int(dataLen, 0, 2048)

        int result = _advLib().RegEnumValueW(hKey, index, nameBuf, nameLen,
            null, typeBuf, dataBuf, dataLen)

        if result == WinError.NO_MORE_ITEMS {
            ffi.free(nameBuf)
            ffi.free(nameLen)
            ffi.free(typeBuf)
            ffi.free(dataBuf)
            ffi.free(dataLen)
            break
        }

        if result == WinError.SUCCESS {
            var valName = ffi.utf16_to_utf8(nameBuf)
            int valType = ffi.read_int(typeBuf, 0)

            var typeName = "UNKNOWN"
            switch valType {
                case ValueType.SZ { typeName = "SZ" }
                case ValueType.EXPAND_SZ { typeName = "EXPAND_SZ" }
                case ValueType.BINARY { typeName = "BINARY" }
                case ValueType.DWORD { typeName = "DWORD" }
                case ValueType.MULTI_SZ { typeName = "MULTI_SZ" }
                case ValueType.QWORD { typeName = "QWORD" }
            }

            var valueInfo = new RegValueInfo(
                name = valName,
                type = valType,
                typeName = typeName
            )
            values.add(valueInfo)
            index = index + 1
        }

        ffi.free(nameBuf)
        ffi.free(nameLen)
        ffi.free(typeBuf)
        ffi.free(dataBuf)
        ffi.free(dataLen)

        if result != WinError.SUCCESS and result != WinError.NO_MORE_ITEMS {
            return new EnumValuesResult(values = values, errorCode = result)
        }
    }
    return new EnumValuesResult(values = values, errorCode = 0)
}

// ==================== 值读取操作 ==========================

// 读取字符串值（REG_SZ）
export func readString(Ptr hKey, string valueName):ReadStringResult {
    Ptr dataType = ffi.malloc(4)
    Ptr dataSize = ffi.malloc(4)

    try {
        Ptr wValueName = if valueName == "" then ffi.nullptr() else ffi.utf8_to_utf16(valueName)
        try {
            ffi.write_int(dataSize, 0, 0)
            int result = _advLib().RegQueryValueExW(hKey, wValueName, null, dataType, null, dataSize)

            if result != WinError.SUCCESS {
                return new ReadStringResult(value = "", errorCode = result)
            }

            int actualType = ffi.read_int(dataType, 0)
            if actualType != ValueType.SZ {
                return new ReadStringResult(value = "", errorCode = _int(WinError.INVALID_HANDLE))
            }

            int requiredSize = ffi.read_int(dataSize, 0)
            Ptr dataBuffer = ffi.malloc(requiredSize)
            try {
                result = _advLib().RegQueryValueExW(hKey, wValueName, null, dataType, dataBuffer, dataSize)

                if result == WinError.SUCCESS {
                    return new ReadStringResult(value = ffi.utf16_to_utf8(dataBuffer), errorCode = 0)
                }
                return new ReadStringResult(value = "", errorCode = result)
            } finally {
                ffi.free(dataBuffer)
            }
        } finally {
            if wValueName != ffi.nullptr() {
                ffi.free(wValueName)
            }
        }
    } finally {
        ffi.free(dataType)
        ffi.free(dataSize)
    }
}

// 读取展开字符串值（REG_EXPAND_SZ），自动展开环境变量
export func readExpandString(Ptr hKey, string valueName):ReadExpandStringResult {
    Ptr dataType = ffi.malloc(4)
    Ptr dataSize = ffi.malloc(4)

    try {
        Ptr wValueName = if valueName == "" then ffi.nullptr() else ffi.utf8_to_utf16(valueName)
        try {
            ffi.write_int(dataSize, 0, 0)
            int result = _advLib().RegQueryValueExW(hKey, wValueName, null, dataType, null, dataSize)

            if result != WinError.SUCCESS {
                return new ReadExpandStringResult(value = "", errorCode = result)
            }

            int actualType = ffi.read_int(dataType, 0)
            if actualType != ValueType.EXPAND_SZ {
                return new ReadExpandStringResult(value = "", errorCode = _int(WinError.INVALID_HANDLE))
            }

            int requiredSize = ffi.read_int(dataSize, 0)
            Ptr dataBuffer = ffi.malloc(requiredSize)
            try {
                result = _advLib().RegQueryValueExW(hKey, wValueName, null, dataType, dataBuffer, dataSize)

                if result == WinError.SUCCESS {
                    // 展开环境变量
                    Ptr expandedBuf = ffi.malloc(32767)
                    try {
                        int expandedLen = _krnlLib().ExpandEnvironmentStringsW(dataBuffer, expandedBuf, 32767)
                        if expandedLen > 0 {
                            return new ReadExpandStringResult(value = ffi.utf16_to_utf8(expandedBuf), errorCode = 0)
                        }
                        // 展开失败，返回原始值
                        return new ReadExpandStringResult(value = ffi.utf16_to_utf8(dataBuffer), errorCode = 0)
                    } finally {
                        ffi.free(expandedBuf)
                    }
                }
                return new ReadExpandStringResult(value = "", errorCode = result)
            } finally {
                ffi.free(dataBuffer)
            }
        } finally {
            if wValueName != ffi.nullptr() {
                ffi.free(wValueName)
            }
        }
    } finally {
        ffi.free(dataType)
        ffi.free(dataSize)
    }
}

// 读取 DWORD 值（REG_DWORD）
export func readDword(Ptr hKey, string valueName):ReadDwordResult {
    Ptr dataType = ffi.malloc(4)
    Ptr dataSize = ffi.malloc(4)
    Ptr dataBuffer = ffi.malloc(4)

    try {
        ffi.write_int(dataSize, 0, 4)
        Ptr wValueName = if valueName == "" then ffi.nullptr() else ffi.utf8_to_utf16(valueName)
        try {
            int result = _advLib().RegQueryValueExW(hKey, wValueName, null, dataType, dataBuffer, dataSize)

            if result != WinError.SUCCESS {
                return new ReadDwordResult(value = 0, errorCode = result)
            }

            if ffi.read_int(dataType, 0) != ValueType.DWORD {
                return new ReadDwordResult(value = 0, errorCode = _int(WinError.INVALID_HANDLE))
            }

            return new ReadDwordResult(value = ffi.read_int(dataBuffer, 0), errorCode = 0)
        } finally {
            if wValueName != ffi.nullptr() {
                ffi.free(wValueName)
            }
        }
    } finally {
        ffi.free(dataType)
        ffi.free(dataSize)
        ffi.free(dataBuffer)
    }
}

// 读取 QWORD 值（REG_QWORD）
export func readQword(Ptr hKey, string valueName):ReadQwordResult {
    Ptr dataType = ffi.malloc(4)
    Ptr dataSize = ffi.malloc(4)
    Ptr dataBuffer = ffi.malloc(8)

    try {
        ffi.write_int(dataSize, 0, 8)
        Ptr wValueName = if valueName == "" then ffi.nullptr() else ffi.utf8_to_utf16(valueName)
        try {
            int result = _advLib().RegQueryValueExW(hKey, wValueName, null, dataType, dataBuffer, dataSize)

            if result != WinError.SUCCESS {
                return new ReadQwordResult(value = 0, errorCode = result)
            }

            if ffi.read_int(dataType, 0) != ValueType.QWORD {
                return new ReadQwordResult(value = 0, errorCode = _int(WinError.INVALID_HANDLE))
            }

            return new ReadQwordResult(value = ffi.read_int64(dataBuffer, 0), errorCode = 0)
        } finally {
            if wValueName != ffi.nullptr() {
                ffi.free(wValueName)
            }
        }
    } finally {
        ffi.free(dataType)
        ffi.free(dataSize)
        ffi.free(dataBuffer)
    }
}

// 读取二进制值（REG_BINARY）
export func readBinary(Ptr hKey, string valueName):ReadBinaryResult {
    Ptr dataType = ffi.malloc(4)
    Ptr dataSize = ffi.malloc(4)

    try {
        Ptr wValueName = if valueName == "" then ffi.nullptr() else ffi.utf8_to_utf16(valueName)
        try {
            ffi.write_int(dataSize, 0, 0)
            int result = _advLib().RegQueryValueExW(hKey, wValueName, null, dataType, null, dataSize)

            if result != WinError.SUCCESS {
                return new ReadBinaryResult(data = [], errorCode = result)
            }

            int actualType = ffi.read_int(dataType, 0)
            if actualType != ValueType.BINARY {
                return new ReadBinaryResult(data = [], errorCode = _int(WinError.INVALID_HANDLE))
            }

            int requiredSize = ffi.read_int(dataSize, 0)
            Ptr dataBuffer = ffi.malloc(requiredSize)
            try {
                result = _advLib().RegQueryValueExW(hKey, wValueName, null, dataType, dataBuffer, dataSize)

                if result == WinError.SUCCESS {
                    var byteArray = []
                    for 0 : requiredSize - 1 to i {
                        byteArray.add(ffi.read_byte(dataBuffer, i))
                    }
                    return new ReadBinaryResult(data = byteArray, errorCode = 0)
                }
                return new ReadBinaryResult(data = [], errorCode = result)
            } finally {
                ffi.free(dataBuffer)
            }
        } finally {
            if wValueName != ffi.nullptr() {
                ffi.free(wValueName)
            }
        }
    } finally {
        ffi.free(dataType)
        ffi.free(dataSize)
    }
}

// 读取多字符串值（REG_MULTI_SZ）
export func readMultiString(Ptr hKey, string valueName):ReadMultiStringResult {
    Ptr dataType = ffi.malloc(4)
    Ptr dataSize = ffi.malloc(4)

    try {
        Ptr wValueName = if valueName == "" then ffi.nullptr() else ffi.utf8_to_utf16(valueName)
        try {
            ffi.write_int(dataSize, 0, 0)
            int result = _advLib().RegQueryValueExW(hKey, wValueName, null, dataType, null, dataSize)

            if result != WinError.SUCCESS {
                return new ReadMultiStringResult(strings = [], errorCode = result)
            }

            int actualType = ffi.read_int(dataType, 0)
            if actualType != ValueType.MULTI_SZ {
                return new ReadMultiStringResult(strings = [], errorCode = _int(WinError.INVALID_HANDLE))
            }

            int requiredSize = ffi.read_int(dataSize, 0)
            Ptr dataBuffer = ffi.malloc(requiredSize)
            try {
                result = _advLib().RegQueryValueExW(hKey, wValueName, null, dataType, dataBuffer, dataSize)

                if result == WinError.SUCCESS {
                    // 解析多字符串（以双 null 结尾的字符串列表）
                    var resultStrings = []
                    int offset = 0
                    while offset < requiredSize - 2 {
                        if offset >= requiredSize {
                            break
                        }
                        string currentStr = ffi.utf16_to_utf8(ffi.offset(dataBuffer, offset))
                        if currentStr == "" {
                            break
                        }
                        resultStrings.add(currentStr)
                        int nextOffset = offset + (currentStr.len() + 1) * 2
                        if nextOffset <= offset {
                            break
                        }
                        offset = nextOffset
                    }
                    return new ReadMultiStringResult(strings = resultStrings, errorCode = 0)
                }
                return new ReadMultiStringResult(strings = [], errorCode = result)
            } finally {
                ffi.free(dataBuffer)
            }
        } finally {
            if wValueName != ffi.nullptr() {
                ffi.free(wValueName)
            }
        }
    } finally {
        ffi.free(dataType)
        ffi.free(dataSize)
    }
}

// ==================== 值写入操作 ==========================

// 写入字符串值（REG_SZ）
export func writeString(Ptr hKey, string valueName, string value):int {
    Ptr wValueName = if valueName == "" then ffi.nullptr() else ffi.utf8_to_utf16(valueName)
    Ptr wValue = ffi.utf8_to_utf16(value)

    try {
        int byteLen = ffi.sizeof(wValue)
        return _advLib().RegSetValueExW(hKey, wValueName, 0, ValueType.SZ, wValue, byteLen)
    } finally {
        if wValueName != ffi.nullptr() {
            ffi.free(wValueName)
        }
        ffi.free(wValue)
    }
}

// 写入展开字符串值（REG_EXPAND_SZ）
export func writeExpandString(Ptr hKey, string valueName, string value):int {
    Ptr wValueName = if valueName == "" then ffi.nullptr() else ffi.utf8_to_utf16(valueName)
    Ptr wValue = ffi.utf8_to_utf16(value)

    try {
        int byteLen = ffi.sizeof(wValue)
        return _advLib().RegSetValueExW(hKey, wValueName, 0, ValueType.EXPAND_SZ, wValue, byteLen)
    } finally {
        if wValueName != ffi.nullptr() {
            ffi.free(wValueName)
        }
        ffi.free(wValue)
    }
}

// 写入 DWORD 值（REG_DWORD）
export func writeDword(Ptr hKey, string valueName, int value):int {
    Ptr buffer = ffi.malloc(4)
    try {
        ffi.write_int(buffer, 0, value)
        Ptr wValueName = if valueName == "" then ffi.nullptr() else ffi.utf8_to_utf16(valueName)
        try {
            return _advLib().RegSetValueExW(hKey, wValueName, 0, ValueType.DWORD, buffer, 4)
        } finally {
            if wValueName != ffi.nullptr() {
                ffi.free(wValueName)
            }
        }
    } finally {
        ffi.free(buffer)
    }
}

// 写入 QWORD 值（REG_QWORD）
export func writeQword(Ptr hKey, string valueName, int value):int {
    Ptr buffer = ffi.malloc(8)
    try {
        ffi.write_int64(buffer, 0, value)
        Ptr wValueName = if valueName == "" then ffi.nullptr() else ffi.utf8_to_utf16(valueName)
        try {
            return _advLib().RegSetValueExW(hKey, wValueName, 0, ValueType.QWORD, buffer, 8)
        } finally {
            if wValueName != ffi.nullptr() {
                ffi.free(wValueName)
            }
        }
    } finally {
        ffi.free(buffer)
    }
}

// 写入二进制值（REG_BINARY）
export func writeBinary(Ptr hKey, string valueName, Array data):int {
    int dataLen = data.len()
    Ptr buffer = ffi.malloc(dataLen)
    try {
        for 0 : dataLen - 1 to i {
            ffi.write_byte(buffer, i, _int(data[i]))
        }

        Ptr wValueName = if valueName == "" then ffi.nullptr() else ffi.utf8_to_utf16(valueName)
        try {
            return _advLib().RegSetValueExW(hKey, wValueName, 0, ValueType.BINARY, buffer, dataLen)
        } finally {
            if wValueName != ffi.nullptr() {
                ffi.free(wValueName)
            }
        }
    } finally {
        ffi.free(buffer)
    }
}

// 写入多字符串值（REG_MULTI_SZ）
export func writeMultiString(Ptr hKey, string valueName, Array multiStrings):int {
    // 计算需要的总大小
    int totalSize = 0
    int strCount = multiStrings.len()
    for 0 : strCount - 1 to i {
        string s = _str(multiStrings[i])
        totalSize = totalSize + (s.len() + 1) * 2
    }
    totalSize = totalSize + 2  // 最后的双 null

    Ptr buffer = ffi.malloc(totalSize)
    try {
        // 清空缓冲区
        for 0 : totalSize - 1 to i {
            ffi.write_byte(buffer, i, 0)
        }

        // 写入字符串
        int offset = 0
        for 0 : strCount - 1 to j {
            string s = _str(multiStrings[j])
            Ptr wstr = ffi.utf8_to_utf16(s)
            try {
                int byteLen = ffi.sizeof(wstr)
                ffi.memcpy(ffi.offset(buffer, offset), wstr, byteLen)
                offset = offset + byteLen
            } finally {
                ffi.free(wstr)
            }
        }

        Ptr wValueName = if valueName == "" then ffi.nullptr() else ffi.utf8_to_utf16(valueName)
        try {
            return _advLib().RegSetValueExW(hKey, wValueName, 0, ValueType.MULTI_SZ, buffer, totalSize)
        } finally {
            if wValueName != ffi.nullptr() {
                ffi.free(wValueName)
            }
        }
    } finally {
        ffi.free(buffer)
    }
}

// 删除值
export func deleteValue(Ptr hKey, string valueName):int {
    Ptr wValueName = ffi.utf8_to_utf16(valueName)
    try {
        return _advLib().RegDeleteValueW(hKey, wValueName)
    } finally {
        ffi.free(wValueName)
    }
}

// ==================== 高级操作 ==========================

// 设置默认值
export func setDefaultValue(Ptr hKey, string value):int {
    return writeString(hKey, "", value)
}

// 读取默认值
export func getDefaultValue(Ptr hKey):ReadStringResult {
    return readString(hKey, "")
}

// 刷新键到磁盘
export func flushKey(Ptr hKey):int {
    return _advLib().RegFlushKey(hKey)
}

// 检查键是否存在
export func keyExists(any hKey, string subKey):bool {
    var result = openKey(hKey, subKey, KeyAccess.QUERY_VALUE)

    if result.handle != null {
        closeKey(result.handle)
        return true
    }
    return result.errorCode != WinError.FILE_NOT_FOUND and result.errorCode != WinError.PATH_NOT_FOUND
}

// 检查值是否存在
export func valueExists(Ptr hKey, string valueName):bool {
    var result = readString(hKey, valueName)
    return result.errorCode == 0
}

// 递归删除键及其所有子键和值
export func deleteKeyRecursive(any hKey, string subKey):int {
    // 打开要删除的键
    var openResult = openKey(hKey, subKey, KeyAccess.ALL_ACCESS)
    if openResult.errorCode != WinError.SUCCESS {
        return openResult.errorCode
    }

    var targetKey = openResult.handle

    try {
        // 1. 删除所有值
        var enumValuesResult = enumValues(targetKey)
        if enumValuesResult.errorCode == WinError.SUCCESS {
            for enumValuesResult.values to valueInfo {
                deleteValue(targetKey, _str(valueInfo.name))
            }
        }

        // 2. 递归删除所有子键
        var enumSubKeysResult = enumSubKeys(targetKey)
        if enumSubKeysResult.errorCode == WinError.SUCCESS {
            for enumSubKeysResult.subKeys to childKeyName {
                deleteKeyRecursive(targetKey, _str(childKeyName))
            }
        }
    } finally {
        closeKey(targetKey)
    }

    // 3. 删除空键
    return deleteKey(hKey, subKey)
}
