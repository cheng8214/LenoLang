// annotation.leno — 截图标注模块
// 提供：矩形、箭头、文字、马赛克标注工具
import ffi
import "../../../LenoSDL3/lib/SDL3.leno" as SDL3
use SDL3.(Renderer, Font)

// ==================== 标注类型 ====================
export const ANNO_RECT = 1
export const ANNO_ARROW = 2
export const ANNO_TEXT = 3
export const ANNO_MOSAIC = 4

// ==================== 标注结构 ====================
export struct Annotation {
    int type           // ANNO_RECT/ARROW/TEXT/MOSAIC
    float x1; float y1       // 起点
    float x2; float y2       // 终点
    string text        // 文字内容（仅 TEXT）
    int color          // 颜色 ARGB
    int lineWidth      // 线宽
    int mosaicSize     // 马赛克块大小（仅 MOSAIC）
}

// ==================== 标注列表 ====================
export struct AnnotationList {
    Array[Annotation] items = []

    func clear() { items.clear() }
    func add(Annotation a) { items.add(a) }
    func count(): int { return items.len() }
    func removeLast() { if items.len() > 0 { items.remove(items.len() - 1) } }

    // 绘制所有标注
    func drawAll(Renderer ren, Font font) {
        for items to a {
            _drawOne(ren, a, font)
        }
    }

    // 绘制单个标注（静态方法风格）
    func _drawOne(Renderer ren, Annotation a, Font font) {
        if a.type == ANNO_RECT {
            ren.setBlendMode(1)
            ren.setColor(_r(a.color), _g(a.color), _b(a.color), _a(a.color))
            ren.drawRect(a.x1, a.y1, a.x2 - a.x1, a.y2 - a.y1)
            ren.setBlendMode(0)
        }
        else if a.type == ANNO_ARROW {
            _drawArrow(ren, a.x1, a.y1, a.x2, a.y2, a.color, a.lineWidth)
        }
        else if a.type == ANNO_TEXT {
            if a.text.len() > 0 and font.ok {
                ren.setBlendMode(1)
                // 文字背景
                var sz = font.measureString(a.text)
                ren.setColor(0, 0, 0, 180)
                ren.fillRect(a.x1 - 2, a.y1 - 2, sz.w + 4, sz.h + 4)
                // 文字
                ren.drawText(font, a.text, a.x1, a.y1, _r(a.color), _g(a.color), _b(a.color))
                ren.setBlendMode(0)
            }
        }
        else if a.type == ANNO_MOSAIC {
            // 马赛克通过像素级处理，需要在最终保存时应用
            // 这里只绘制半透明矩形框作为占位
            ren.setBlendMode(1)
            ren.setColor(128, 128, 128, 100)
            ren.fillRect(a.x1, a.y1, a.x2 - a.x1, a.y2 - a.y1)
            ren.setBlendMode(0)
        }
    }

    // 绘制箭头
    func _drawArrow(Renderer ren, float x1, float y1, float x2, float y2, int color, int lineWidth) {
        ren.setBlendMode(1)
        ren.setColor(_r(color), _g(color), _b(color), _a(color))

        // 主线
        ren.drawLine(x1, y1, x2, y2)

        // 箭头头部
        float dx = x2 - x1; float dy = y2 - y1
        float len = _sqrt(dx * dx + dy * dy)
        if len < 10.0 { ren.setBlendMode(0); return }

        float ux = dx / len; float uy = dy / len
        float arrowLen = _min(len * 0.3, 20.0)
        float arrowAngle = 0.5  // 约 30 度

        // 左翼
        float lx = x2 - arrowLen * (ux * _cos(arrowAngle) + uy * _sin(arrowAngle))
        float ly = y2 - arrowLen * (uy * _cos(arrowAngle) - ux * _sin(arrowAngle))
        ren.drawLine(x2, y2, lx, ly)

        // 右翼
        float rx = x2 - arrowLen * (ux * _cos(arrowAngle) - uy * _sin(arrowAngle))
        float ry = y2 - arrowLen * (uy * _cos(arrowAngle) + ux * _sin(arrowAngle))
        ren.drawLine(x2, y2, rx, ry)

        ren.setBlendMode(0)
    }
}

// ==================== 工具栏配置 ====================
export struct ToolbarConfig {
    int toolType = 1           // 当前工具（ANNO_RECT = 1）
    int color = 0xFFFF0000     // 当前颜色（ARGB，默认红色）
    int lineWidth = 2          // 线宽
    int mosaicSize = 10        // 马赛克块大小
}

// ==================== 辅助函数 ====================
func _r(int argb): int { return argb & 0xFF }
func _g(int argb): int { return (argb >> 8) & 0xFF }
func _b(int argb): int { return (argb >> 16) & 0xFF }
func _a(int argb): int { return (argb >> 24) & 0xFF }

// 三角函数（简化版，用于箭头）
func _cos(float x): float {
    // 泰勒展开近似 cos(x)，精度足够用于箭头
    float x2 = x * x
    return 1.0 - x2/2.0 + x2*x2/24.0
}
func _sin(float x): float {
    // 泰勒展开近似 sin(x)
    float x2 = x * x
    return x - x*x2/6.0 + x2*x2*x/120.0
}
func _min(float a, float b): float { return if a < b then a else b }
func _sqrt(float x): float {
    // 牛顿法近似 sqrt
    if x <= 0 { return 0.0 }
    float r = x
    for 0:9 to i { r = (r + x / r) / 2.0 }
    return r
}

// ==================== 将标注渲染到像素缓冲区 ====================
// 用于最终保存时将标注"烧录"到图像
export func renderAnnotationsToPixels(Ptr[u8] pixels, int w, int h, AnnotationList list) {
    if pixels == null { return }
    // 遍历每个标注，修改像素
    for list.items to a {
        if a.type == ANNO_MOSAIC {
            _applyMosaic(pixels, w, h, _int(a.x1), _int(a.y1), _int(a.x2), _int(a.y2), a.mosaicSize)
        }
        // 矩形、箭头、文字需要光栅化，这里简化处理
        // 实际项目中可以用 SDL3 的 renderTarget 功能
    }
}

// 应用马赛克效果
func _applyMosaic(Ptr[u8] pixels, int w, int h, int x1, int y1, int x2, int y2, int blockSize) {
    if blockSize < 2 { blockSize = 2 }
    // 确保 x1 < x2, y1 < y2
    if x1 > x2 { var t = x1; x1 = x2; x2 = t }
    if y1 > y2 { var t = y1; y1 = y2; y2 = t }
    // 边界裁剪
    if x1 < 0 { x1 = 0 }; if y1 < 0 { y1 = 0 }
    if x2 > w { x2 = w }; if y2 > h { y2 = h }

    // 使用 for start:end:step 语法
    int bs = blockSize
    for y1 : y2 : bs to blockY {
        for x1 : x2 : bs to blockX {
            // 计算块内平均颜色
            int rSum = 0; int gSum = 0; int bSum = 0; int count = 0
            int ex = blockX + bs; int ey = blockY + bs
            if ex > x2 { ex = x2 }; if ey > y2 { ey = y2 }
            for blockY : ey - 1 to py {
                for blockX : ex - 1 to px {
                    int si = py * w * 4 + px * 4
                    rSum += _int(ffi.read_byte(pixels, si + 2))
                    gSum += _int(ffi.read_byte(pixels, si + 1))
                    bSum += _int(ffi.read_byte(pixels, si))
                    count += 1
                }
            }
            if count > 0 {
                int rAvg = rSum / count; int gAvg = gSum / count; int bAvg = bSum / count
                // 填充块
                for blockY : ey - 1 to py2 {
                    for blockX : ex - 1 to px2 {
                        int si = py2 * w * 4 + px2 * 4
                        ffi.write_byte(pixels, si, bAvg)
                        ffi.write_byte(pixels, si + 1, gAvg)
                        ffi.write_byte(pixels, si + 2, rAvg)
                    }
                }
            }
        }
    }
}