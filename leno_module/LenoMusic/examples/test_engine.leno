import "../src/audio.leno" as audio
main() {
    audio.audio_module_init("d:\\CLeno\\LenoC\\leno_module\\LenoMusic\\build\\miniaudio.dll")
    var e = audio.createEngine()
    print("init=" + e.isInit())
    print("sr=" + e.getSampleRate())
    print("ch=" + e.getChannels())
    print("play=" + e.play("d:\\1.flac"))
    sleep(3000)
    e.stop()
    e.uninit()
    audio.audio_module_uninit()
    print("done")
}
