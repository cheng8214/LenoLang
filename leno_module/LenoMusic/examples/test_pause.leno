// 暂停/恢复测试 — v2 clib (使用 Sound)
import "../src/audio.leno" as audio

main() {
    print("=== 暂停/恢复测试 v2 ===")
    audio.audio_module_init("../build/miniaudio.dll")

    var sound = audio.createSound("d:\\1.flac")
    if not sound.isInit() { print("Sound 初始化失败"); return }

    print("播放 3 秒...")
    sound.play()
    sleep(3000)

    print("暂停 2 秒...")
    sound.pause()
    sleep(2000)

    print("恢复播放 3 秒...")
    sound.resume()
    sleep(3000)

    print("停止...")
    sound.stop()
    sound.uninit()
    audio.audio_module_uninit()
    print("=== 测试结束 ===")
}
