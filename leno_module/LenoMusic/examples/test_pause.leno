// 播放/停止/跳转测试
import "../lib/LenoMusic.leno" as audio

main() {
    print("=== 播放控制测试 ===")

    var s = audio.createSound("d:\\1.flac")
    if not s.isInit() { print("加载失败"); return }

    print("时长: " + s.getDuration() + "s")
    print("播放 2 秒..."); s.play(); sleep(2000)
    print("位置: " + s.getPosition() + "s")

    print("跳到 10 秒..."); s.seek(10); sleep(500)
    print("位置: " + s.getPosition() + "s")

    print("播放 2 秒..."); sleep(2000)
    print("位置: " + s.getPosition() + "s")

    print("停止..."); s.stop(); s.uninit()
    print("=== 测试结束 ===")
}
