// 音量控制测试 — v2 clib
import "../lib/LenoMusic.leno" as audio

main() {
    print("=== 音量控制测试 ===")

    var engine = audio.createEngine()
    if not engine.isInit() { print("引擎初始化失败"); return }

    print("[1/4] 设置音量 0.5...")
    engine.setVolume(0.5)
    print("      当前音量: " + engine.getVolume())

    print("[2/4] 开始播放...")
    engine.play("d:\\1.flac")

    print("[3/4] 逐步降低音量...")
    for 0 : 4 to i {
        var vol = 1.0 - i * 0.2
        engine.setVolume(vol)
        print("      音量: " + vol)
        sleep(500)
    }

    print("[4/4] 停止...")
    engine.stop()
    engine.uninit()
    print("=== 测试结束 ===")
}
