// 多轨道同时播放
import "../src/audio.leno" as audio
main() {
    audio.audio_module_init("miniaudio.dll")
    var s1 = audio.createSound("d:\\1.flac")
    var s2 = audio.createSound("d:\\1.flac")
    if not s1.isInit() or not s2.isInit() { print("fail"); return }
    print("双轨播放: s1 vol=1.0, s2 vol=0.5")
    s1.play(); s2.play(); s2.setVolume(0.5)
    sleep(3000); s1.stop()
    sleep(3000); s2.stop()
    s1.uninit(); s2.uninit()
    audio.audio_module_uninit()
    print("done")
}
