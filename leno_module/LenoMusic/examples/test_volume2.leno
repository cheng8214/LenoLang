// 测试音量问题
import "../src/audio.leno" as audio

main() {
    print("=== 音量问题测试 ===")
    
    audio.audio_module_init("../build/miniaudio.dll")
    
    var engine = audio.createEngine()
    if not engine.isInit() {
        print("引擎初始化失败")
        return
    }
    
    // 测试1：不设置音量，直接播放
    print("\n[测试1] 不设置音量，直接播放...")
    engine.play("d:\\1.flac")
    print("播放 3 秒...")
    sleep(3000)
    engine.stop()
    print("停止")
    
    // 测试2：设置音量为1.0，然后播放
    print("\n[测试2] 设置音量为1.0，然后播放...")
    engine.setVolume(1.0)
    print("音量已设置")
    engine.play("d:\\1.flac")
    print("播放 3 秒...")
    sleep(3000)
    engine.stop()
    print("停止")
    
    // 测试3：设置音量为0.5，然后播放
    print("\n[测试3] 设置音量为0.5，然后播放...")
    engine.setVolume(0.5)
    print("音量已设置")
    engine.play("d:\\1.flac")
    print("播放 3 秒...")
    sleep(3000)
    engine.stop()
    print("停止")
    
    engine.uninit()
    audio.audio_module_uninit()
    
    print("\n=== 测试结束 ===")
}
