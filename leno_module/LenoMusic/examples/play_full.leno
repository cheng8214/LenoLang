// 完整播放FLAC音频 — v2 clib
import "../src/audio.leno" as audio

main() {
    var filepath = "d:\\1.flac"
    int duration = 355

    print("=== FLAC 完整播放器 ===")
    print("文件: " + filepath)

    var engine = audio.createEngine()
    if not engine.isInit() { print("[错误] 引擎初始化失败"); return }

    print("采样率: " + engine.getSampleRate() + " Hz")
    print("通道数: " + engine.getChannels())
    print("时长: " + duration + " 秒 (" + (duration / 60) + " 分)")

    print("开始播放...")
    engine.play(filepath)

    int m = 0; int s = 0
    for 0 : duration - 1 to i {
        sleep(1000)
        s = s + 1
        if s >= 60 { s = 0; m = m + 1 }
        if (i + 1) % 10 == 0 {
            print("      进度: " + m + "分" + s + "秒 (" + ((i + 1) * 100 / duration) + "%)")
        }
    }

    print("播放完成!")
    engine.uninit()
    print("=== 感谢收听! ===")
}
