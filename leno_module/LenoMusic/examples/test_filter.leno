// 滤波器测试 — v2 clib
import "../src/audio.leno" as audio
import ffi

main() {
    print("=== 滤波器测试 v2 ===")

    // 1. LPF
    print("[1/3] 低通 1000Hz...")
    var lpf = audio.createLPF(audio.FORMAT_F32, 2, 48000, 1000.0, 2)
    if lpf.isInit() {
        Ptr inp = ffi.malloc(4800 * 4 * 2)
        Ptr out = ffi.malloc(4800 * 4 * 2)
        var wf = audio.createWaveform(audio.FORMAT_F32, 2, 48000, audio.WAVEFORM_SINE, 0.5, 440.0)
        wf.read(inp, 4800); wf.uninit()
        print("      处理 " + lpf.process(out, inp, 4800) + " 帧")
        lpf.reinit(500.0, 2)
        ffi.free(inp); ffi.free(out); lpf.uninit()
    }

    // 2. HPF
    print("[2/3] 高通 500Hz...")
    var hpf = audio.createHPF(audio.FORMAT_F32, 2, 48000, 500.0, 2)
    if hpf.isInit() {
        Ptr inp = ffi.malloc(4800 * 4 * 2)
        Ptr out = ffi.malloc(4800 * 4 * 2)
        var wf2 = audio.createWaveform(audio.FORMAT_F32, 2, 48000, audio.WAVEFORM_SQUARE, 0.5, 220.0)
        wf2.read(inp, 4800); wf2.uninit()
        print("      处理 " + hpf.process(out, inp, 4800) + " 帧")
        hpf.reinit(1000.0, 2)
        ffi.free(inp); ffi.free(out); hpf.uninit()
    }

    // 3. 带通组合
    print("[3/3] 带通 200-2000Hz...")
    var lpf2 = audio.createLPF(audio.FORMAT_F32, 1, 48000, 2000.0, 2)
    var hpf2 = audio.createHPF(audio.FORMAT_F32, 1, 48000, 200.0, 2)
    if lpf2.isInit() and hpf2.isInit() {
        Ptr b1 = ffi.malloc(2400 * 4)
        Ptr b2 = ffi.malloc(2400 * 4)
        Ptr b3 = ffi.malloc(2400 * 4)
        var n = audio.createNoise(audio.FORMAT_F32, 1, audio.NOISE_WHITE, 12345, 0.5)
        n.read(b1, 2400); n.uninit()
        hpf2.process(b2, b1, 2400)
        lpf2.process(b3, b2, 2400)
        print("      带通完成!")
        ffi.free(b1); ffi.free(b2); ffi.free(b3)
        lpf2.uninit(); hpf2.uninit()
    }

    print("=== 测试完成! ===")
}
