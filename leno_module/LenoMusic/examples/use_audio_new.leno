// 使用新音频模块（全局单例模式）— v2 clib
import "../src/audio.leno" as audio

main() {
    print("================================")
    print("Audio 模块测试 - 全局单例模式 v2")
    print("================================")

    print("[1/7] 初始化...")
    if not audio.audio_module_init("../build/miniaudio.dll") {
        print("[错误] 初始化失败"); return
    }

    print("[2/7] 版本: " + audio.getVersion())

    print("[3/7] 音频信息...")
    audio.getInfo("d:\\1.flac")

    print("[4/7] Engine 播放...")
    var engine = audio.createEngine()
    if engine.isInit() {
        print("      采样率: " + engine.getSampleRate() + " Hz")
        print("      通道数: " + engine.getChannels())
        engine.play("d:\\1.flac")
        for 0 : 9 to i { sleep(1000); print("      进度: " + ((i + 1) * 10) + "%") }
        engine.stop(); engine.uninit()
    }

    print("[5/7] Decoder...")
    var decoder = audio.createDecoder("d:\\1.flac")
    if decoder.isOpen() {
        print("      采样率: " + decoder.getSampleRate())
        print("      时长: " + decoder.getDuration() + " 秒")
        decoder.close()
    }

    print("[6/7] 快速播放 3 秒...")
    audio.quickPlay("d:\\1.flac", 3)

    print("[7/7] 全局销毁...")
    audio.audio_module_uninit()
    print("================================")
    print("测试完成!")
    print("================================")
}
