// 波形/噪声生成器测试 — v2 clib
import "../lib/LenoMusic.leno" as audio
import ffi

main() {
    print("=== 波形/噪声生成器测试 v2 ===")

    // 1. 波形
    print("[1/3] 正弦波 440Hz...")
    var wf = audio.createWaveform(audio.FORMAT_F32, 2, 48000, audio.WAVEFORM_SINE, 0.5, 440.0)
    if wf.isInit() {
        Ptr buf = ffi.malloc(4800 * 4 * 2)
        print("      读取 " + wf.read(buf, 4800) + " 帧")
        wf.setFreq(880.0)
        wf.setType(audio.WAVEFORM_SQUARE)
        ffi.free(buf); wf.uninit()
    }

    // 2. 噪声
    print("[2/3] 粉噪声...")
    var noise = audio.createNoise(audio.FORMAT_F32, 2, audio.NOISE_PINK, 12345, 0.3)
    if noise.isInit() {
        Ptr buf = ffi.malloc(4800 * 4 * 2)
        print("      读取 " + noise.read(buf, 4800) + " 帧")
        noise.setAmp(0.5)
        ffi.free(buf); noise.uninit()
    }

    // 3. 四种波形
    print("[3/3] 遍历波形类型...")
    var types = [audio.WAVEFORM_SINE, audio.WAVEFORM_SQUARE, audio.WAVEFORM_TRIANGLE, audio.WAVEFORM_SAWTOOTH]
    for 0 : 3 to i {
        var w = audio.createWaveform(audio.FORMAT_F32, 1, 48000, types[i], 0.3, 220.0)
        if w.isInit() { Ptr b = ffi.malloc(2400 * 4); w.read(b, 2400); ffi.free(b); w.uninit() }
        sleep(100)
    }

    print("=== 测试完成! ===")
}
