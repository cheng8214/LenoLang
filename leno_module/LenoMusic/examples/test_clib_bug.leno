// 复现：clib 类型不能通过函数包装返回
import ffi

clib kernel32 {
    u32 GetTickCount()
}

// ❌ 包装函数——ffi.load 返回 Ptr，不能自动转为 clib kernel32
func get_k32(): kernel32 {
    return ffi.load("kernel32.dll")
}

main() {
    // ✅ 直接声明——这个能工作
    kernel32 k = ffi.load("kernel32.dll")
    print("直接: tick=" + k.GetTickCount())

    // ❌ 通过包装函数——会报类型不匹配
    kernel32 k2 = get_k32()
    print("包装: tick=" + k2.GetTickCount())
}
