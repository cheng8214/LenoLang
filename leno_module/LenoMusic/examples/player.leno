// ==================================
// LenoMusic Player — 完整播放器
// 零配置，import 即用
// ==================================
import "../src/audio.leno" as audio
import strings

string g_path = "d:\\1.flac"

// 格式化时间 mm:ss
func fmt_time(float sec): string {
    int m = _int(sec / 60)
    int s = _int(sec - m * 60)
    var ms = if m < 10 then "0" + m else "" + m
    var ss = if s < 10 then "0" + s else "" + s
    return ms + ":" + ss
}

// 显示 progress bar [====>     ] 50%
func progress_bar(float pos, float dur, int width): string {
    float pct = if dur > 0 then pos / dur else 0
    int filled = _int(pct * width)
    var bar = ""
    for 0 : width - 1 to i {
        bar = bar + (if i < filled then "=" else if i == filled then ">" else " ")
    }
    int p = _int(pct * 100)
    return "[" + bar + "] " + p + "%"
}

main() {
    print("")
    print("╔══════════════════════════════════╗")
    print("║     LenoMusic Player v1.0        ║")
    print("╚══════════════════════════════════╝")
    print("")

    // === 1. 文件信息 ===
    print("▶ 正在分析: " + g_path)
    var dec = audio.createDecoder(g_path)
    if not dec.isOpen() {
        print("✗ 无法打开文件: " + g_path)
        return
    }
    int sr   = dec.getSampleRate()
    int ch   = dec.getChannels()
    int dur  = dec.getDuration()
    int fmt  = dec.getFormat()
    dec.close()

    var fmt_names = ["未知","F32","S16","S24","S32","U8"]
    var ch_mode  = if ch == 1 then "单声道" else if ch == 2 then "立体声" else "" + ch + "声道"

    print("┌─ 文件信息 ───────────────────────┐")
    print("│ 路径 : " + g_path)
    print("│ 采样率: " + sr + " Hz")
    print("│ 声道  : " + ch + " (" + ch_mode + ")")
    print("│ 格式  : " + fmt_names[fmt])
    print("│ 时长  : " + fmt_time(dur as float) + " (" + dur + "秒)")
    print("└──────────────────────────────────┘")
    print("")

    // === 2. 播放控制 ===
    print("▶ 创建 Sound...")
    var s = audio.createSound(g_path)
    if not s.isInit() { print("✗ Sound 加载失败"); return }

    print("▶ 开始播放!")
    print("")
    s.play()

    float total  = s.getDuration()
    int   remain = _int(total)

    for 0 : remain to i {
        sleep(1000)

        float pos = s.getPosition()
        int r = _int(total - pos)
        if r < 0 { r = 0 }

        // 进度条
        var bar = progress_bar(pos, total, 30)
        print("  " + bar + "  " + fmt_time(pos) + " / " + fmt_time(total))

        // 每 10 秒显示详细信息
        if i % 10 == 0 and i > 0 {
            int ipos = _int(pos)
            print("  └─ 定位:" + ipos + "s | 剩余:" + fmt_time(r) + " | 音量:" + s.getVolume())
        }

        if not s.isPlaying() { break }
    }

    // === 3. 结束 ===
    s.stop()
    s.uninit()

    print("")
    print("╔══════════════════════════════════╗")
    print("║        播放完毕!                  ║")
    print("╚══════════════════════════════════╝")
    print("")
}
