import strings
main() {
    var s = _script()
    print("script=" + s)
    var parts = strings.split(s, "\\")
    print("parts=" + parts.len())
    for parts to p { print("  >" + p) }
    var last = parts.len() - 1
    var dir = ""
    for 0 : last - 1 to i { dir = dir + parts[i] + "\\" }
    print("dir=" + dir)
    print("dll=" + dir + "..\\..\\build\\miniaudio.dll")
}
