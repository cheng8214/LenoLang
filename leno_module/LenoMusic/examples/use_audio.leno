// 使用新的 audio 模块 — v2 clib
import "../src/audio.leno" as audio

main() {
    print("================================")
    print("Audio 模块完整测试 v2")
    print("================================")

    // 1. 版本
    print("[1/6] 获取版本...")
    print("      miniaudio 版本: " + audio.getVersion())

    // 2. 音频信息
    print("[2/6] 获取音频信息...")
    audio.getInfo("d:\\1.flac")

    // 3. Engine 播放
    print("[3/6] 使用 Engine 播放...")
    var engine = audio.createEngine()
    if engine.isInit() {
        print("      采样率: " + engine.getSampleRate() + " Hz")
        print("      通道数: " + engine.getChannels())
        print("      开始播放...")
        engine.play("d:\\1.flac")
        for 0 : 9 to i {
            sleep(1000)
            print("      进度: " + ((i + 1) * 10) + "%")
        }
        engine.stop()
        engine.uninit()
    }

    // 4. Decoder
    print("[4/6] 使用 Decoder...")
    var decoder = audio.createDecoder("d:\\1.flac")
    if decoder.isOpen() {
        print("      采样率: " + decoder.getSampleRate())
        print("      通道数: " + decoder.getChannels())
        print("      时长: " + decoder.getDuration() + " 秒")
        print("      总帧数: " + decoder.getLengthInFrames())
        decoder.close()
    }

    // 5. 快速播放
    print("[5/6] 快速播放 3 秒...")
    audio.quickPlay("d:\\1.flac", 3)

    // 6. 时间格式化
    print("[6/6] 时间格式化测试...")
    print("      60秒 = " + audio.formatTime(60))
    print("      125秒 = " + audio.formatTime(125))
    print("      355秒 = " + audio.formatTime(355))

    print("================================")
    print("测试完成!")
    print("================================")
}
