// Audio 模块完整功能测试
import "../lib/LenoMusic.leno" as audio

main() {
    print("================================")
    print("Audio 模块完整测试")
    print("================================")

    // 1. 版本
    print("[1/5] 版本: " + audio.getVersion())

    // 2. 音频信息
    print("[2/5] 音频信息...")
    audio.getInfo("d:\\1.flac")

    // 3. Engine 播放
    print("[3/5] Engine...")
    var engine = audio.createEngine()
    if engine.isInit() {
        print("      SR:" + engine.getSampleRate() + "Hz CH:" + engine.getChannels())
        engine.play("d:\\1.flac")
        for 0 : 9 to i { sleep(1000); print("      " + ((i + 1) * 10) + "%") }
        engine.stop(); engine.uninit()
    }

    // 4. Sound 播放(可多实例)
    print("[4/5] Sound...")
    var s = audio.createSound("d:\\1.flac")
    if s.isInit() {
        print("      DUR:" + s.getDuration() + "s POS:" + s.getPosition() + "s VOL:" + s.getVolume())
        s.play(); sleep(2000)
        print("      POS:" + s.getPosition() + "s")
        s.setVolume(0.5); print("      VOL:0.5")
        sleep(2000); s.stop(); s.uninit()
    }

    // 5. Decoder
    print("[5/5] Decoder...")
    var decoder = audio.createDecoder("d:\\1.flac")
    if decoder.isOpen() {
        print("      SR:" + decoder.getSampleRate() + " CH:" + decoder.getChannels() + " DUR:" + decoder.getDuration() + "s FRAMES:" + decoder.getLengthInFrames())
        decoder.close()
    }

    print("================================")
    print("测试完成!")
    print("================================")
}
