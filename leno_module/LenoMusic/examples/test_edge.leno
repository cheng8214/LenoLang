// LenoMusic 边界测试
import "../lib/LenoMusic.leno" as audio
import ffi

main() {
    print("=== 边界测试 ===")
    int ok = 0; int ng = 0

    // 1-5: Sound 边界
    print("[1] 未播放操作...")
    var s = audio.createSound("d:\\1.flac")
    s.stop(); s.seek(5.0); s.setVolume(0.5)
    s.uninit(); ok = ok + 1

    print("[2] 双 stop...")
    var s2 = audio.createSound("d:\\1.flac")
    s2.play(); sleep(200); s2.stop(); s2.stop(); s2.uninit(); ok = ok + 1

    print("[3] 双 play...")
    var s3 = audio.createSound("d:\\1.flac")
    s3.play(); s3.play(); sleep(200); s3.stop(); s3.uninit(); ok = ok + 1

    print("[4] seek 边界...")
    var s4 = audio.createSound("d:\\1.flac")
    s4.seek(s4.getDuration() - 2)
    s4.play(); sleep(1500); s4.stop(); s4.uninit(); ok = ok + 1

    print("[5] 非法音量...")
    var s5 = audio.createSound("d:\\1.flac")
    s5.setVolume(-1.0); s5.setVolume(2.0)
    s5.play(); sleep(200); s5.stop(); s5.uninit(); ok = ok + 1

    // 6-9: 信号处理
    print("[6] Waveform...")
    var w = audio.createWaveform(audio.FORMAT_F32,2,48000,audio.WAVEFORM_SINE,0.5,440.0)
    if w.isInit() { ok = ok + 1 } else { print("  FAIL"); ng = ng + 1 }
    var buf = ffi.malloc(4800 * 4 * 2)  // 足够大
    if w.read(buf, 1024) > 0 { ok = ok + 1 } else { print("  FAIL"); ng = ng + 1 }
    w.setAmp(0.3); w.setFreq(880.0); w.setType(audio.WAVEFORM_SQUARE)
    if w.read(buf, 1024) > 0 { ok = ok + 1 } else { print("  FAIL"); ng = ng + 1 }
    ffi.free(buf); w.uninit(); ok = ok + 1

    print("[7] Noise...")
    var n = audio.createNoise(audio.FORMAT_F32,2,audio.NOISE_PINK,12345,0.3)
    if n.isInit() { ok = ok + 1 } else { print("  FAIL"); ng = ng + 1 }
    var nb = ffi.malloc(4800 * 4 * 2)
    if n.read(nb, 1024) > 0 { ok = ok + 1 } else { print("  FAIL"); ng = ng + 1 }
    n.setAmp(0.8); n.setSeed(54321)
    ffi.free(nb); n.uninit(); ok = ok + 1

    print("[8] LPF...")
    var lpf = audio.createLPF(audio.FORMAT_F32,2,48000,1000.0,2)
    if lpf.isInit() { ok = ok + 1 } else { print("  FAIL"); ng = ng + 1 }
    var l_in = ffi.malloc(4800 * 4 * 2); var l_out = ffi.malloc(4800 * 4 * 2)
    var w2 = audio.createWaveform(audio.FORMAT_F32,2,48000,audio.WAVEFORM_SINE,0.5,440.0)
    w2.read(l_in, 1024); w2.uninit()
    if lpf.process(l_out, l_in, 1024) > 0 { ok = ok + 1 } else { print("  FAIL"); ng = ng + 1 }
    lpf.reinit(2000.0, 4)
    if lpf.process(l_out, l_in, 1024) > 0 { ok = ok + 1 } else { print("  FAIL"); ng = ng + 1 }
    ffi.free(l_in); ffi.free(l_out); lpf.uninit(); ok = ok + 1

    print("[9] HPF...")
    var hpf = audio.createHPF(audio.FORMAT_F32,2,48000,500.0,2)
    if hpf.isInit() { ok = ok + 1 } else { print("  FAIL"); ng = ng + 1 }
    var h_in = ffi.malloc(4800 * 4 * 2); var h_out = ffi.malloc(4800 * 4 * 2)
    var w3 = audio.createWaveform(audio.FORMAT_F32,2,48000,audio.WAVEFORM_SAWTOOTH,0.5,220.0)
    w3.read(h_in, 1024); w3.uninit()
    if hpf.process(h_out, h_in, 1024) > 0 { ok = ok + 1 } else { print("  FAIL"); ng = ng + 1 }
    ffi.free(h_in); ffi.free(h_out); hpf.uninit(); ok = ok + 1

    // 10-11: 压力
    print("[10] 快速创建/销毁...")
    for 0 : 9 to i { var sx = audio.createSound("d:\\1.flac"); sx.uninit() }
    ok = ok + 1

    print("[11] Engine 重用...")
    var e1 = audio.createEngine(); e1.uninit()
    var e2 = audio.createEngine()
    if e2.isInit() { ok = ok + 1 } else { print("  FAIL"); ng = ng + 1 }
    e2.uninit(); ok = ok + 1

    print("\n===== " + ok + "/" + (ok+ng) + " passed =====")
}
