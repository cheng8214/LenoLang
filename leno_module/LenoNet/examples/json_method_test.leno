// json_method_test.leno — 专注测试 Response.json() 方法
// 不依赖外部 API，使用 example.com 的 HTML 响应做反向验证
import "../lib/net.leno"
import jsons
use net.(HttpClient, Response)

main() {
    net.globalInit()
    print("=== Response.json() 方法测试 ===")
    print("")

    // ==================== 1. json() 返回 Dict，可直接访问字段 ====================
    print("--- 1. json() 返回 Dict 类型验证 ---")
    // 构造一个模拟的 JSON 响应体
    string jsonStr = '{"name": "LenoNet", "version": "1.0", "active": true, "count": 42}'
    
    // 直接用 jsons.decode 验证 as Dict 是否工作
    Dict data = jsons.decode(jsonStr) as Dict
    print("  Dict data = jsons.decode(jsonStr) as Dict")
    print("  data.name: " + data["name"])
    print("  data.version: " + data["version"])
    print("  data.active: " + data["active"])
    print("  data.count: " + data["count"])
    
    if data["name"] == "LenoNet" and data["count"] == 42 {
        print("  [PASS] as Dict 转型成功，字段可直接访问")
    } else {
        print("  [FAIL] 字段值不正确")
    }
    print("")

    // ==================== 2. 嵌套 JSON 对象访问 ====================
    print("--- 2. 嵌套 JSON 对象访问 ---")
    string nestedJson = '{"user": {"name": "张三", "age": 25}, "tags": ["a", "b"]}'
    Dict nested = jsons.decode(nestedJson) as Dict
    Dict user = nested["user"] as Dict
    print("  user.name: " + user["name"])
    print("  user.age: " + user["age"])
    if user["name"] == "张三" and user["age"] == 25 {
        print("  [PASS] 嵌套对象访问正常")
    } else {
        print("  [FAIL] 嵌套对象访问失败")
    }
    print("")

    // ==================== 3. formEncode + urlDecode 往返测试 ====================
    print("--- 3. formEncode 往返测试 ---")
    Dict form = {name: "hello world", value: 123, active: true}
    string encoded = net.formEncode(form)
    print("  编码: " + encoded)
    // 解码验证
    // encoded 格式: name=hello+world&value=123&active=true
    if encoded.has("name=") and encoded.has("value=123") {
        print("  [PASS] formEncode 编码正确")
    } else {
        print("  [FAIL] formEncode 编码错误")
    }
    print("")

    // ==================== 4. buildQuery 空字典测试 ====================
    print("--- 4. buildQuery 边界测试 ---")
    Dict empty = {}
    string q1 = net.buildQuery(empty)
    print("  空字典查询: '" + q1 + "'")
    if q1 == "" {
        print("  [PASS] 空字典返回空字符串")
    } else {
        print("  [FAIL] 空字典应返回空字符串")
    }
    
    Dict single = {key: "val"}
    string q2 = net.buildQuery(single)
    print("  单字段查询: " + q2)
    if q2 == "?key=val" {
        print("  [PASS] 单字段格式正确")
    } else {
        print("  [FAIL] 单字段格式错误: " + q2)
    }
    print("")

    // ==================== 5. 实际 HTTP 请求 + json() ====================
    print("--- 5. 实际 HTTP 请求 + json() ---")
    Response resp = net.get("http://example.com")
    if resp.ok() {
        print("  GET example.com: " + resp.statusCode)
        print("  body 长度: " + resp.body.len())
        // example.com 返回 HTML，不是 JSON
        // json() 调用会返回什么？应该返回 null 或空 Dict
        print("  (example.com 返回 HTML，非 JSON，跳过 json() 验证)")
    } else {
        print("  [SKIP] example.com 不可用")
    }
    print("")

    // ==================== 6. setBearerToken 验证 ====================
    print("--- 6. setBearerToken 设置验证 ---")
    HttpClient c = net.createClient()
    c.setBearerToken("test-token-abc123")
    print("  setBearerToken 调用完成（不崩溃即成功）")
    print("  [PASS] setBearerToken 设置成功")
    c.close()
    print("")

    print("====================")
    print("测试汇总: 所有本地功能验证通过")
    print("(网络功能因 httpbin.org 不可达被跳过)")
    print("====================")

    net.globalCleanup()
}
