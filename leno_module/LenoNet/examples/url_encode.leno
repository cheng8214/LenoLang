// url_encode.leno — LenoNet URL 编解码示例
import "../lib/net.leno"

main() {
    net.globalInit()

    string url = "https://httpbin.org/get?msg=hello world&name=张三"

    // URL 编码
    string encoded = net.urlEncode("hello world&name=张三")
    print("原始: hello world&name=张三")
    print("编码: " + encoded)

    // URL 解码
    string decoded = net.urlDecode(encoded)
    print("解码: " + decoded)

    // 使用编码后的 URL 发请求
    print("\n=== 带特殊字符的 GET ===")
    string fullUrl = "http://httpbin.org/get?msg=" + encoded
    print("请求 URL: " + fullUrl)

    var resp = net.get(fullUrl)
    if resp.ok() {
        print("状态码: " + resp.statusCode)
        print("响应: " + resp.body[:300])
    } else {
        print("失败: " + resp.error)
    }
}
