// LenoCrawler - 高级爬虫框架

import strings
import "../../LenoHtml/lib/html.leno" as htmls
import "../../LenoNet/lib/net.leno"
use net.(HttpClient, Response, createClient)

// ==================== URL 工具 ====================

func _s(any v): string {
    if v is string { return v }
    return ""
}

func _i(any v): int {
    if v is int { return v }
    return 0
}

export func parseUrl(string url): Dict {
    int pos = 0
    int len = url.len()
    string scheme = ""
    while pos < len {
        if url.byte(pos) == 58 {
            pos = pos + 1
            break
        }
        scheme = scheme + strings.char(url.byte(pos))
        pos = pos + 1
    }
    if pos >= len { return {} }
    if url.byte(pos) != 47 { return {} }
    if pos + 1 >= len { return {} }
    if url.byte(pos + 1) != 47 { return {} }
    pos = pos + 2
    
    string host = ""
    while pos < len {
        int b = url.byte(pos)
        if b == 58 or b == 47 or b == 63 or b == 35 { break }
        host = host + strings.char(b)
        pos = pos + 1
    }
    
    int port = -1
    if pos < len and url.byte(pos) == 58 {
        pos = pos + 1
        port = 0
        while pos < len {
            int b = url.byte(pos)
            if b >= 48 and b <= 59 {
                port = port * 10 + (b - 48)
                pos = pos + 1
            } else { break }
        }
    }
    
    string path = ""
    if pos < len { path = url[pos:] }
    if path == "" { path = "/" }
    
    Dict[string, any] r = {}
    r["scheme"] = scheme
    r["host"] = host
    r["port"] = port
    r["path"] = path
    return r
}

export func buildUrl(Dict parts): string {
    string scheme = _s(parts["scheme"])
    string host = _s(parts["host"])
    int port = _i(parts["port"])
    string path = _s(parts["path"])
    string result = scheme + "://" + host
    if (scheme == "http" and port != 80 and port > 0) or
       (scheme == "https" and port != 443 and port > 0) {
        result = result + ":" + format("%d", port)
    }
    result = result + path
    return result
}

export func domain(string url): string {
    return _s(parseUrl(url)["host"])
}

export func baseUrl(string url): string {
    Dict parts = parseUrl(url)
    string scheme = _s(parts["scheme"])
    string host = _s(parts["host"])
    int port = _i(parts["port"])
    string path = _s(parts["path"])
    int lastSlash = -1
    int i = 0
    while i < path.len() {
        if path.byte(i) == 47 { lastSlash = i }
        i = i + 1
    }
    string base = "/"
    if lastSlash > 0 { base = path[:lastSlash + 1] }
    string result = scheme + "://" + host
    if (scheme == "http" and port != 80 and port > 0) or
       (scheme == "https" and port != 443 and port > 0) {
        result = result + ":" + format("%d", port)
    }
    result = result + base
    return result
}

func _collapse(string path): string {
    Array segs = []
    string cur = ""
    int i = 0
    while i < path.len() {
        int b = path.byte(i)
        if b == 47 {
            if cur == ".." {
                if segs.len() > 0 { segs = segs[:segs.len() - 1] }
            } else if cur != "." and cur != "" {
                segs.add(cur)
            }
            cur = ""
        } else {
            cur = cur + strings.char(b)
        }
        i = i + 1
    }
    if cur == ".." {
        if segs.len() > 0 { segs = segs[:segs.len() - 1] }
    } else if cur != "." and cur != "" {
        segs.add(cur)
    }
    string result = ""
    if path.byte(0) == 47 { result = "/" }
    result = result + strings.join(segs, "/")
    if path.byte(path.len() - 1) == 47 and result != "/" {
        result = result + "/"
    }
    return result
}

export func resolveUrl(string base, string ref): string {
    if ref.len() > 4 {
        string prefix = ""
        int maxC = 10
        if ref.len() < maxC { maxC = ref.len() }
        int j = 0
        while j < maxC {
            prefix = prefix + strings.char(ref.byte(j))
            j = j + 1
        }
        if prefix.has("://") { return normalizeUrl(ref) }
    }
    if ref.len() > 2 and ref.byte(0) == 47 and ref.byte(1) == 47 {
        return normalizeUrl(_s(parseUrl(base)["scheme"]) + ":" + ref)
    }
    Dict bp = parseUrl(base)
    string scheme = _s(bp["scheme"])
    string host = _s(bp["host"])
    int port = _i(bp["port"])
    string basePath = _s(bp["path"])
    string bpo = basePath
    int qi = -1
    int fi = -1
    int bi = 0
    while bi < basePath.len() {
        int b = basePath.byte(bi)
        if b == 63 and qi < 0 { qi = bi }
        if b == 35 and fi < 0 { fi = bi }
        bi = bi + 1
    }
    if qi >= 0 { bpo = basePath.slice(0, qi) }
    else if fi >= 0 { bpo = basePath.slice(0, fi) }
    if bpo.len() > 0 and bpo.byte(bpo.len() - 1) != 47 {
        int ls = -1
        int si = 0
        while si < bpo.len() {
            if bpo.byte(si) == 47 { ls = si }
            si = si + 1
        }
        if ls >= 0 { bpo = bpo[:ls + 1] }
    }
    string resolved = ""
    if ref.byte(0) == 47 { resolved = ref }
    else { resolved = bpo + ref }
    resolved = _collapse(resolved)
    string result = scheme + "://" + host
    if (scheme == "http" and port != 80 and port > 0) or
       (scheme == "https" and port != 443 and port > 0) {
        result = result + ":" + format("%d", port)
    }
    result = result + resolved
    return normalizeUrl(result)
}

export func normalizeUrl(string url): string {
    Dict parts = parseUrl(url)
    string scheme = _s(parts["scheme"])
    string host = _s(parts["host"]).to_lower()
    int port = _i(parts["port"])
    string path = _s(parts["path"])
    int fi = -1
    int pi = 0
    while pi < path.len() {
        if path.byte(pi) == 35 { fi = pi; break }
        pi = pi + 1
    }
    if fi >= 0 { path = path.slice(0, fi) }
    if path == "" { path = "/" }
    Dict[string, any] r = {}
    r["scheme"] = scheme
    r["host"] = host
    r["port"] = port
    r["path"] = path
    return buildUrl(r)
}

// ==================== Crawler 核心 ====================

export func Crawler(Dict config): Dict {
    Dict[string, any] c = {}
    c["start_urls"] = []
    c["allowed_domains"] = []
    c["max_pages"] = 100
    c["max_depth"] = 3
    c["delay_ms"] = 0
    c["user_agent"] = "LenoCrawler/1.0"
    c["visited"] = {}
    c["queue"] = []
    c["page_count"] = 0
    c["running"] = false
    if config["start_urls"] is Array { c["start_urls"] = config["start_urls"] }
    if config["allowed_domains"] is Array { c["allowed_domains"] = config["allowed_domains"] }
    if config["max_pages"] is int { c["max_pages"] = config["max_pages"] }
    if config["max_depth"] is int { c["max_depth"] = config["max_depth"] }
    if config["delay_ms"] is int { c["delay_ms"] = config["delay_ms"] }
    if config["user_agent"] is string { c["user_agent"] = config["user_agent"] }
    return c
}

export func start(Dict[string, any] crawler): Dict {
    crawler["running"] = true
    crawler["page_count"] = 0
    var startRaw = crawler["start_urls"]
    if startRaw is Array {
        int idx = 0
        while idx < startRaw.len() {
            if startRaw[idx] is string {
                Dict[string, any] entry = {}
                entry["url"] = startRaw[idx]
                entry["depth"] = 0
                var queue = crawler["queue"]
                if queue is Array { queue.add(entry) }
            }
            idx = idx + 1
        }
    }
    return crawler
}

export func nextUrl(Dict[string, any] crawler): any {
    var queue = crawler["queue"]
    if queue is Array {
        return _nextUrlLoop(crawler, queue)
    }
    return null
}

func _nextUrlLoop(Dict[string, any] crawler, Array queue): any {
    while queue.len() > 0 {
        var entry = queue[0]
        crawler["queue"] = queue[1:]
        if entry is Dict {
            string url = _s(entry["url"])
            int depth = _i(entry["depth"])
            var visited = crawler["visited"]
            if visited is Dict {
                if visited[url] is bool {
                    if visited[url] { continue }
                }
            }
            if depth > crawler["max_depth"] { continue }
            var allowed = crawler["allowed_domains"]
            if allowed is Array and allowed.len() > 0 {
                string d = domain(url)
                if not allowed.has(d) { continue }
            }
            return entry
        }
    }
    return null
}

export func markVisited(Dict[string, any] crawler, string url) {
    var visited = crawler["visited"]
    if visited is Dict { visited[url] = true }
    crawler["page_count"] = crawler["page_count"] + 1
}

export func enqueue(Dict[string, any] crawler, string url, int depth) {
    var visited = crawler["visited"]
    if visited is Dict {
        if visited[url] is bool {
            if visited[url] { return }
        }
    }
    if depth > crawler["max_depth"] { return }
    Dict[string, any] entry = {}
    entry["url"] = url
    entry["depth"] = depth
    var queue = crawler["queue"]
    if queue is Array { queue.add(entry) }
}

export func shouldStop(Dict[string, any] crawler): bool {
    var running = crawler["running"]
    if running is bool {
        if not running { return true }
    }
    if crawler["page_count"] >= crawler["max_pages"] { return true }
    var queue = crawler["queue"]
    if queue is Array {
        if queue.len() == 0 { return true }
    } else {
        return true
    }
    return false
}

export func stop(Dict[string, any] crawler) {
    crawler["running"] = false
}

// ==================== 便捷组合函数 ====================

export func fetchPage(string url, string user_agent): any {
    HttpClient c = createClient()
    c.setHeaders(["User-Agent: " + user_agent])
    Response resp = c.get(url)
    c.close()
    if not resp.ok() { return null }
    string body = resp.body
    Dict[string, any] r = {}
    r["url"] = url
    r["status"] = resp.statusCode
    r["body"] = body
    r["html"] = htmls.parse(body)
    return r
}

export func extractLinks(Dict[string, any] page): Array[string] {
    if not page is Dict { return [] }
    var root = page["html"]
    string bu = _s(page["url"])
    Array links = []
    var allRaw = htmls.select(root, "a")
    if allRaw is Array {
        int i = 0
        while i < allRaw.len() {
            var node = allRaw[i]
            if node is Dict {
                string href = htmls.attr(node, "href")
                if href != "" { links.add(resolveUrl(bu, href)) }
            }
            i = i + 1
        }
    }
    return links
}
