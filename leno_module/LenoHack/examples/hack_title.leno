// hack_title.leno — LenoHack 运行时破解窗口标题
// 原理:
//   1. w32_process 查找目标进程
//   2. w32_memory 附加到进程内存
//   3. searchValue 搜索标题首4字节的 LE int 值, readBytes 逐个验证完整标题
//   4. writeBytes 写入新标题的 UTF-8 字节
//   5. FFI 调用 user32!SetWindowTextW 实时刷新窗口标题
//
// 用法:
//   leno hack_title.leno [进程名] [新标题] [旧标题]
//   leno hack_title.leno cache_cleaner.exe "DuMate 破解版-Crack!" "Leno 缓存清理工具"
//   leno hack_title.leno notepad.exe "Hacked!" "无标题 - 记事本"
//   leno hack_title.leno               # 使用默认值
//
// 参数说明:
//   进程名  — 目标进程的可执行文件名 (默认: cache_cleaner.exe)
//   新标题  — 要设置的新窗口标题 (默认: DuMate 破解版-Crack!)
//   旧标题  — 当前窗口的原始标题，用于内存搜索 (默认: Leno 缓存清理工具)

import ffi
import "../lib/w32_process.leno" as proc
import "../lib/w32_memory.leno" as mem

use mem.MemoryHandle

// ---- user32.dll FFI ----
clib user32 {
    Ptr FindWindowW(Ptr className, Ptr windowName)
    i32 SetWindowTextW(Ptr hWnd, Ptr text)
    i32 IsWindow(Ptr hWnd)
}

user32 _usr = null
func _u32(): user32 {
    if _usr == null { _usr = ffi.load("user32.dll") }
    return _usr
}

// ---- UTF-8 字节转十六进制字符串（调试用）----
func _bytes_to_hex(Array[int] bytes, int count): string {
    string s = ""
    for 0:count-1 to i {
        int b = bytes[i]
        string hex = _str(b)
        if b < 16 { hex = "0" + hex }
        s = s + hex + " "
    }
    return s
}

// ---- 将 string 转为 UTF-8 字节数组 ----
// 使用 string.byte_len() + string.byte(i) 直接获取 UTF-8 字节
// 注意：不能用 s.len()，它返回字符数（中文多字节），不是字节数
func _str_to_bytes(string s): Array[int] {
    Array[int] bytes = []
    int blen = s.byte_len()
    if blen == 0 { return bytes }
    for 0:blen-1 to i {
        bytes.add(s.byte(i))
    }
    return bytes
}

// ---- 将前4字节转为 LE int（用于 searchValue）----
func _first4_le_int(Array[int] bytes): int {
    if bytes.len() < 4 { return -1 }
    return bytes[0] | (bytes[1] << 8) | (bytes[2] << 16) | (bytes[3] << 24)
}

main() {
    // ---- 解析命令行参数 ----
    Array[string] args = _args()
    string targetProcess = "cache_cleaner.exe"
    string oldTitle = "Leno 缓存清理工具"
    string newTitle = "DuMate 破解版-Crack!"

    if args.len() >= 1 { targetProcess = args[0] }
    if args.len() >= 2 { newTitle = args[1] }
    if args.len() >= 3 { oldTitle = args[2] }

    print("========================================")
    print("  LenoHack 运行时标题破解")
    print("  目标进程: " + targetProcess)
    print("  新标题:   " + newTitle)
    print("========================================")
    print("")

    // ---- 1. 查找进程 ----
    print("[1] 查找 " + targetProcess + " ...")
    var pm = new proc.StandardProcessManager()
    var r = pm.findByName(targetProcess)
    if not r.found {
        print("  x 未找到! 请先运行 " + targetProcess)
        return
    }
    int pid = _int(r.pid)
    print("  v 找到! PID=" + pid)
    print("")

    // ---- 2. 附加进程 ----
    print("[2] 附加到进程内存...")
    MemoryHandle? h = mem.open(pid)
    if h == null or not h.valid {
        print("  x 附加失败! 需要管理员权限")
        return
    }
    print("  v 附加成功!")
    print("")

    // ---- 3. 搜索原始标题内存 ----
    print("[3] 搜索原始标题内存...")
    Array[int] oldBytes = _str_to_bytes(oldTitle)
    int oldLen = oldBytes.len()
    print("  原标题 UTF-8 字节数: " + oldLen)

    if oldLen < 4 {
        print("  x 标题太短，无法搜索")
        h.close()
        return
    }

    int searchVal = _first4_le_int(oldBytes)
    print("  搜索 LE 值: 0x" + _str(searchVal))
    Array[Dict] found = h.searchValue(searchVal, 2000)
    print("  找到 " + found.len() + " 个候选地址")

    int patchAddr = 0
    for found to f {
        if f is Dict {
            int addr = _int(f["address"])
            if addr == 0 { continue }
            // 读取完整标题字节数验证
            Ptr[u8] buf = h.readBytes(addr, oldLen)
            if buf != null {
                bool match = true
                for 0:oldLen-1 to i {
                    int b = ffi.read_byte(buf, i)
                    if b != oldBytes[i] {
                        match = false
                    }
                }
                ffi.free(buf)
                if match {
                    patchAddr = addr
                    print("  v 确认匹配! 地址: 0x" + _str(patchAddr))
                    break
                }
            }
        }
    }

    if patchAddr != 0 {
        // ---- 4. 写入新标题 ----
        print("")
        print("[4] 写入新标题到内存...")
        Array[int] newBytes = _str_to_bytes(newTitle)
        int newLen = newBytes.len()
        print("  新标题 UTF-8 字节数: " + newLen)

        if newLen > oldLen {
            // 新标题比旧标题长：内存补丁会导致后续字符串表错位或缺少 null 终止符
            // 跳过内存补丁，仅靠 SetWindowTextW 刷新窗口标题
            print("  ! 新标题比旧标题长 (" + newLen + " > " + oldLen + ")，跳过内存补丁")
            print("    （仅靠 SetWindowTextW 刷新，进程重启后标题恢复）")
        } else {
            // 新标题等于或短于旧标题：写入旧标题长度，不足部分用 0x00 填充
            int writeLen = oldLen
            Ptr[u8] wbuf = ffi.malloc(writeLen)
            if wbuf != null {
                for 0:writeLen-1 to i {
                    if i < newLen {
                        ffi.write_byte(wbuf, i, newBytes[i])
                    } else {
                        ffi.write_byte(wbuf, i, 0x00)  // null 填充剩余空间
                    }
                }
                bool ok = h.writeBytes(patchAddr, wbuf, writeLen)
                ffi.free(wbuf)
                if ok {
                    print("  v 内存补丁写入成功! (" + writeLen + " 字节, 含 " + (oldLen - newLen) + " 字节 null 填充)")
                } else {
                    print("  x 内存写入失败!")
                }
            }
        }
    } else {
        print("  x 未找到标题内存, 跳过内存补丁")
    }
    print("")

    // ---- 5. SetWindowTextW 实时刷新窗口标题 ----
    print("[5] 调用 SetWindowTextW 刷新窗口...")
    Ptr nullPtr = ffi.ptr_from_int(0)

    // 先用旧标题查找窗口
    Ptr wOld = ffi.utf8_to_utf16(oldTitle)
    Ptr hwnd = _u32().FindWindowW(nullPtr, wOld)
    ffi.free(wOld)

    // 如果旧标题找不到，尝试新标题（可能内存补丁已生效但窗口未刷新）
    if hwnd == null or _u32().IsWindow(hwnd) == 0 {
        Ptr wNew = ffi.utf8_to_utf16(newTitle)
        hwnd = _u32().FindWindowW(nullPtr, wNew)
        ffi.free(wNew)
    }

    if hwnd != null and _u32().IsWindow(hwnd) != 0 {
        print("  v 找到窗口!")
        Ptr wNew = ffi.utf8_to_utf16(newTitle)
        int ok = _u32().SetWindowTextW(hwnd, wNew)
        ffi.free(wNew)
        if ok != 0 {
            print("  v SetWindowTextW 成功!")
            print("  新标题: " + newTitle)
        } else {
            print("  x SetWindowTextW 失败!")
        }
    } else {
        print("  x 未找到窗口! (进程可能没有可见窗口)")
    }
    print("")

    // ---- 6. 清理 ----
    h.close()
    print("[6] 句柄已关闭")
    print("")
    print("========================================")
    print("  破解完成!")
    print("  新标题: " + newTitle)
    print("========================================")
}
