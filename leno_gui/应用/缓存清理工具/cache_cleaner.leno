// cache_cleaner.leno — Leno 缓存清理工具（struct 工程化版）
//
// 功能：
//   1. 选择一个目录，递归扫描其中的 .lenb 文件和 .lenocache 文件夹
//   2. 在 Table 中展示所有找到的缓存项（类型、大小、路径）
//   3. Table 内置复选框列，点击勾选/取消勾选
//   4. 表头复选框可全选/全不选，工具栏也有"全选"/"全不选"按钮
//   5. "清理选中" 按钮删除所有勾选的缓存项 —— **4 线程并行删除**（2026-09-28），
//      进度条按完成线程数推进；清理后自动重新扫描刷新列表
//   6. 「释放缓存」按钮（2026-09-28）：扫描 **Leno 单文件打包 exe 的资源释放缓存**
//      （`%LOCALAPPDATA%\<exe名>\pack\<hash16>\`，见 src/vm_main.c 的释放机制说明）——
//      只认"16 位 hex 目录名且带 .leno_pack_ok 哨兵/为空"或 "<hash>.tmp.<pid>" 崩溃残留，
//      不误伤同名的非 Leno 目录 ✓
//
// 布局结构：
//   Window
//   ├── TitleBar（自绘标题栏）
//   └── VBox root
//       ├── HBox toolbar（浏览按钮 + 目录标签 + 扫描 + 释放缓存 + 全选/全不选 + 清理）
//       ├── ProgressBar（扫描/清理进度）
//       ├── HBox statusBar（状态文字 + 统计文字）
//       └── Table（复选框列 + 类型 + 大小 + 路径）
//
// 运行：leno cache_cleaner.leno
import "SDL3" as SDL3
import "sdl_filedialog" as fdlg
use SDL3.(Event, Renderer, Window, TitleBar, Button, Table, Label, ProgressBar, HBox, VBox, Scancode)
import dirs
import strings
import threads

// ==================== 多线程清理（模块级 ⇒ threads.start 可直接引用 ✓） ====================
// 并行删除线程数：IO 密集型 ⇒ 4 线程足够吃满磁盘队列，再多收益趋零
const int CLEAN_THREADS = 4

// 清理 worker：chunk 元素 = [path, sizeStr]；返回 [cleaned, failed, freed]（全字符串 ⇒
// 跨线程回传免收窄 ✓）。try/catch 兜住权限/占用类错误 ⇒ 线程永不进入 error 态 ✓
func clean_worker(Array[Array[string]] chunk): Array[string] {
    int cleaned = 0
    int failed = 0
    int freed = 0
    for chunk to it {
        try {
            if dirs.delete(it[0]) {
                cleaned = cleaned + 1
                freed = freed + _int(it[1])
            } else {
                failed = failed + 1
            }
        } catch e {
            failed = failed + 1
        }
    }
    return [_str(cleaned), _str(failed), _str(freed)]
}

// ==================== 缓存清理器结构体 ====================
struct CacheCleaner {
    // ===== 布局常量 =====
    float PAD = 12.0

    // ===== UI 控件引用 =====
    Window      win
    TitleBar    titleBar
    Label       dirLbl
    Button      browseBtn
    Button      scanBtn
    Button      packScanBtn
    Button      selectAllBtn
    Button      selectNoneBtn
    Button      cleanBtn
    ProgressBar progressBar
    Label       statusLbl
    Label       countLbl
    Table       resultTable

    // ===== 业务状态 =====
    // 扫描结果：每项 = {path, type, size}
    Array[Dict] cacheItems = []
    string currentDir = ""
    bool scanning = false
    string scanMode = "dir"    // "dir" = 扫描用户选的目录；"pack" = 扫描单文件释放缓存（清理后按同源重扫 ✓）

    // ==================== 工具方法 ====================

    // 人类可读大小 ⇒ 已收编到标准库 strings.fmt_size()（2026-09-26，原来本地那份是
    //   与文件管理器/PE分析器逐字复制的 4 份之一）⇒ 本地定义删除，调用点直调标准库 ✓

    // 获取文件大小 ⇒ 用标准库 `dirs.stat(p).size`（2026-09-27 收敛）：
    //   `dirs.stat()` 旧形态是无类型 Dict ⇒ 原来要 `if st is Dict` + `if s is int` 手动收窄 ✗；
    //   后来 stat 返回 `DirInfo`（字段类型编译期已知）⇒ `.size` 直接是 int ✓。
    //   ⚠ 不要再找 `dirs.size()`：那个单键入口已于 2026-09-27 删除（它就是这里的重复入口）

    // 递归计算目录大小
    func calcDirSize(string path): int {
        int total = 0
        var entries = null
        try {
            entries = dirs.listdir(path)
        } catch e {
            return 0
        }
        if entries == null { return 0 }
        for entries to entry {
            if not (entry is string) { continue }
            string entryName = _str(entry)
            if entryName == "" { continue }
            string fullpath = ""
            try {
                fullpath = dirs.join(path, entryName)
            } catch e {
                continue
            }
            if fullpath == "" { continue }
            try {
                if dirs.is_dir(fullpath) {
                    total = total + calcDirSize(fullpath)
                } else {
                    total = total + dirs.stat(fullpath).size
                }
            } catch e {
                // 跳过权限不足的条目
                continue
            }
        }
        return total
    }

    // 递归扫描目录，收集 .lenb 文件和 .lenocache 文件夹
    func scanDir(string path) {
        var entries = null
        try {
            entries = dirs.listdir(path)
        } catch e {
            return
        }
        if entries == null { return }

        for entries to entry {
            if not (entry is string) { continue }
            string entryName = _str(entry)
            if entryName == "" { continue }

            string fullpath = ""
            try {
                fullpath = dirs.join(path, entryName)
            } catch e {
                continue
            }
            if fullpath == "" { continue }

            var isDir = false
            try {
                isDir = dirs.is_dir(fullpath)
            } catch e {
                continue
            }

            if isDir {
                // 检查是否为 .lenocache 文件夹
                if entryName == ".lenocache" {
                    int sz = calcDirSize(fullpath)
                    cacheItems.add({path: fullpath, type: "文件夹", size: sz})
                    // 不再递归进入 .lenocache 内部（整体作为一个清理单元）
                } else {
                    // 递归扫描子目录
                    scanDir(fullpath)
                }
            } else {
                // 检查是否为 .lenb 文件
                string ext = dirs.extname(entryName)
                if ext == ".lenb" {
                    int sz = dirs.stat(fullpath).size
                    cacheItems.add({path: fullpath, type: "文件", size: sz})
                }
            }
        }
    }

    // ==================== 单文件释放缓存扫描（⑦，2026-09-28） ====================
    // 释放目录 = `%LOCALAPPDATA%\<exeStem>\pack\<hash16>\`（跨平台缓存根 + 按 payload_hash
    // 分目录，见 src/vm_main.c 开头的机制说明）。识别判据（**保守**，不误伤同名目录 ✓）：
    //   · `pack\<16位hex>\` 且带 `.leno_pack_ok` 哨兵，或为空目录；
    //   · `pack\<16位hex>.tmp.<pid>\` —— 崩溃残留（释放中断没来得及原子改名 ✓）。
    // 清理单元 = 整个 hash 目录（与 VM 自己的惰性 GC 同口径 ✓）；正在运行的打包 exe
    //   的目录在 Windows 下文件被锁 ⇒ 删除会失败并计入"失败"，不会损坏它 ✓

    // 是否 16 位 hex（大小写都认；hash 名 ASCII ⇒ 字符下标 == 字节下标 ✓）
    func isPackHashName(string s): bool {
        if s.len() != 16 { return false }
        int i = 0
        while i < 16 {
            // ★ 2026-10-02 收编：原先 `byte_slice(i, i+1)` 造一个单字节临时串再跟字面量比字符串 ⇒
            //   改用 native `byte(i)` 取**字节值**、直接比数值区间（不分配）✓
            //   等价：0-255 全量对拍 0 分歧（字符串比较 ⇔ 字节值区间，见 cp_eq 对拍）✓
            int b = s.byte(i)
            bool ok = (b >= 48 and b <= 57) or (b >= 97 and b <= 102) or (b >= 65 and b <= 70)
            if not ok { return false }
            i = i + 1
        }
        return true
    }

    // 是否崩溃残留名：`<16hex>.tmp.<pid>`
    func isTmpResidue(string s): bool {
        if s.len() <= 21 { return false }                    // 最短 = 16 + 5 + 1 位 pid
        int p = strings.find(s, ".tmp.")
        if p != 16 { return false }
        return isPackHashName(s.byte_slice(0, 16))
    }

    // 扫描全部 Leno 单文件释放缓存（追加进 cacheItems；不需要用户选目录 ✓）
    func scanPackRelease() {
        var la = _env_or("LOCALAPPDATA", "")
        if la == "" { return }
        var apps = null
        try {
            apps = dirs.listdir(la)
        } catch e {
            return
        }
        if apps == null { return }
        for apps to name {
            if not (name is string) { continue }
            string appDir = dirs.join(la, _str(name))
            if not dirs.is_dir(appDir) { continue }
            var packDir = dirs.join(appDir, "pack")
            if not dirs.is_dir(packDir) { continue }
            var hashes = null
            try {
                hashes = dirs.listdir(packDir)
            } catch e {
                continue
            }
            if hashes == null { continue }
            for hashes to h {
                if not (h is string) { continue }
                string hn = _str(h)
                bool isItem = false
                if isPackHashName(hn) {
                    // 哨兵在（完整释放）或目录为空 ⇒ 都是 Leno 释放缓存 ✓
                    if dirs.exists(dirs.join(appDir + "\\pack\\" + hn, ".leno_pack_ok")) { isItem = true }
                    else {
                        var inner = null
                        try { inner = dirs.listdir(dirs.join(packDir, hn)) } catch e { inner = null }
                        if inner != null and inner.len() == 0 { isItem = true }
                    }
                } else if isTmpResidue(hn) {
                    isItem = true
                }
                if isItem {
                    string fullp = dirs.join(packDir, hn)
                    int sz = calcDirSize(fullp)
                    cacheItems.add({path: fullp, type: "释放缓存", size: sz})
                }
            }
        }
    }

    // 「释放缓存」扫描入口（不需要选目录 ✓）
    func onPackScan() {
        if scanning { return }
        scanning = true
        cacheItems = []
        scanMode = "pack"
        resultTable.set_rows([])
        scanBtn.set_enabled(false)
        packScanBtn.set_enabled(false)
        cleanBtn.set_enabled(false)
        selectAllBtn.set_enabled(false)
        selectNoneBtn.set_enabled(false)
        progressBar.set_value(50.0)
        statusLbl.set_text("扫描释放缓存中...")
        SDL3.markFrameRedraw()

        try {
            scanPackRelease()
        } catch e {
            return          // 扫描失败 ⇒ 保留已收集的部分结果（有意忽略 ✓）
        }

        scanning = false
        packScanBtn.set_enabled(true)
        scanBtn.set_enabled(true)
        progressBar.set_value(100.0)
        refreshTable()
        updateCount()
        if cacheItems.len() == 0 {
            statusLbl.set_text("扫描完成: 未发现 Leno 释放缓存（%LOCALAPPDATA% 下没有匹配的 pack 目录 ✓）")
        } else {
            int totalSize = 0
            for cacheItems.len() to i {
                totalSize = totalSize + cacheItems[i].get("size", 0)
            }
            statusLbl.set_text("扫描完成: 发现 " + cacheItems.len() + " 个释放缓存目录 (" + strings.fmt_size(totalSize) + ")")
            cleanBtn.set_enabled(true)
            selectAllBtn.set_enabled(true)
            selectNoneBtn.set_enabled(true)
        }
        SDL3.markFrameRedraw()
    }

    // 刷新 Table 数据
    func refreshTable() {
        if cacheItems.len() == 0 {
            resultTable.set_rows([])
            return
        }
        Array[Array[string]] rows = []
        for cacheItems.len() to i {
            Dict item = cacheItems[i]
            string tp = item.get("type", "")
            int sz = item.get("size", 0)
            string path = item.get("path", "")
            rows.add(["", tp, strings.fmt_size(sz), path])
        }
        resultTable.set_rows(rows)
        // 默认全部勾选
        resultTable.check_all()
    }

    // 更新统计标签（从 Table 的勾选行读取）
    func updateCount() {
        int total = cacheItems.len()
        Array[int] checkedRows = resultTable.get_checked_rows()
        int selCount = checkedRows.len()
        int selSize = 0
        for checkedRows to idx {
            if idx >= 0 and idx < cacheItems.len() {
                selSize = selSize + cacheItems[idx].get("size", 0)
            }
        }
        countLbl.set_text("选中: " + selCount + "/" + total + "  大小: " + strings.fmt_size(selSize))
        // 没有勾选时禁用清理按钮
        cleanBtn.set_enabled(selCount > 0)
    }

    // ==================== 事件回调 ====================

    // 浏览目录
    func onBrowse() {
        fdlg.showOpenFolderDialog(win, func(Array[string] paths, int filter) {
            if paths != null and paths.len() > 0 {
                currentDir = paths[0]
                dirLbl.set_text("目录: " + currentDir)
                scanBtn.set_enabled(true)
                statusLbl.set_text("已选择目录，点击[扫描]开始查找缓存")
                SDL3.markFrameRedraw()
            }
        }, {default_location: currentDir})
    }

    // 扫描缓存
    func onScan() {
        if scanning { return }
        if currentDir == "" {
            statusLbl.set_text("请先选择目录")
            SDL3.markFrameRedraw()
            return
        }
        if not dirs.exists(currentDir) or not dirs.is_dir(currentDir) {
            statusLbl.set_text("错误: 目录不存在或不是目录")
            SDL3.markFrameRedraw()
            return
        }

        scanning = true
        scanMode = "dir"
        cacheItems = []
        resultTable.set_rows([])
        scanBtn.set_enabled(false)
        packScanBtn.set_enabled(false)
        cleanBtn.set_enabled(false)
        selectAllBtn.set_enabled(false)
        selectNoneBtn.set_enabled(false)
        progressBar.set_value(50.0)
        statusLbl.set_text("扫描中...")
        SDL3.markFrameRedraw()

        // 执行扫描（同步，大目录可能稍慢但 Leno 单线程下足够快）
        try {
            scanDir(currentDir)
        } catch e {
            // 扫描中出现权限/IO 错误时保留已收集的部分结果，不中断后续恢复流程
            return
        }

        // 扫描完成：必须重新启用扫描按钮，否则扫描过一次后就永远无法再次扫描
        scanning = false
        scanBtn.set_enabled(true)
        packScanBtn.set_enabled(true)
        progressBar.set_value(100.0)
        refreshTable()
        updateCount()

        if cacheItems.len() == 0 {
            statusLbl.set_text("扫描完成: 未发现缓存文件")
        } else {
            int totalSize = 0
            for cacheItems.len() to i {
                totalSize = totalSize + cacheItems[i].get("size", 0)
            }
            statusLbl.set_text("扫描完成: 发现 " + cacheItems.len() + " 个缓存项 (" + strings.fmt_size(totalSize) + ")")
            cleanBtn.set_enabled(true)
            selectAllBtn.set_enabled(true)
            selectNoneBtn.set_enabled(true)
        }
        SDL3.markFrameRedraw()
    }

    // 全选
    func onSelectAll() {
        resultTable.check_all()
        updateCount()
        SDL3.markFrameRedraw()
    }

    // 全不选
    func onSelectNone() {
        resultTable.uncheck_all()
        updateCount()
        SDL3.markFrameRedraw()
    }

    // 复选框变化回调
    func onCheckChange(int col, Array[int] checkedRows) {
        updateCount()
        SDL3.markFrameRedraw()
    }

    // 清理勾选的缓存项 —— **4 线程并行删除**（2026-09-28）
    //   勾选项按序轮转均分成 4 个 chunk ⇒ 每线程一个 chunk（IO 密集 ⇒ 并行吃满磁盘队列 ✓）；
    //   主线程轮询 `state()` 推进进度条并 markFrameRedraw（界面不僵 ✓），全部 done 后 join
    //   取回 [cleaned, failed, freed] 求和。worker 内 try/catch 兜底 ⇒ 线程不会进 error 态 ✓
    func onClean() {
        Array[int] checkedRows = resultTable.get_checked_rows()
        if checkedRows.len() == 0 {
            statusLbl.set_text("请先勾选要清理的缓存项")
            SDL3.markFrameRedraw()
            return
        }

        // 收集勾选项 → [path, sizeStr]（跨线程传数组元素统一 string，回传免收窄 ✓）
        Array[Array[string]] items = []
        for checkedRows to idx {
            if idx >= 0 and idx < cacheItems.len() {
                Dict item = cacheItems[idx]
                items.add([item.get("path", ""), _str(item.get("size", 0))])
            }
        }

        // 轮转分配到 CLEAN_THREADS 个 chunk（空 chunk 的线程立刻返回 [0,0,0] ✓）
        Array[Array[string]] c1 = []
        Array[Array[string]] c2 = []
        Array[Array[string]] c3 = []
        Array[Array[string]] c4 = []
        int ci = 0
        for items.len() to i {
            if ci % 4 == 0 { c1.add(items[i]) }
            else if ci % 4 == 1 { c2.add(items[i]) }
            else if ci % 4 == 2 { c3.add(items[i]) }
            else { c4.add(items[i]) }
            ci = ci + 1
        }

        // 禁用按钮 + 起线程
        scanning = true
        cleanBtn.set_enabled(false)
        scanBtn.set_enabled(false)
        packScanBtn.set_enabled(false)
        selectAllBtn.set_enabled(false)
        selectNoneBtn.set_enabled(false)
        statusLbl.set_text("清理中...（" + (CLEAN_THREADS as string) + " 线程并行）")
        progressBar.set_value(10.0)
        SDL3.markFrameRedraw()

        var t1 = threads.start(clean_worker, c1)
        var t2 = threads.start(clean_worker, c2)
        var t3 = threads.start(clean_worker, c3)
        var t4 = threads.start(clean_worker, c4)

        // 轮询等待（80ms 一拍）：按完成线程数推进进度条 + 重绘 ⇒ 界面保持"活着" ✓
        while t1.state() == "running" or t2.state() == "running" or t3.state() == "running" or t4.state() == "running" {
            int done = 0
            if t1.state() != "running" { done = done + 1 }
            if t2.state() != "running" { done = done + 1 }
            if t3.state() != "running" { done = done + 1 }
            if t4.state() != "running" { done = done + 1 }
            progressBar.set_value(10.0 + 80.0 * _float(done) / 4.0)
            SDL3.markFrameRedraw()
            sleep(80)
        }
        progressBar.set_value(95.0)

        // join 取回结果求和（线程已 done ⇒ join 立即返回 ✓）
        // 2026-09-28 起 join 有真实返回类型（Thread[T]，T = worker 的返回类型）⇒ 直接赋值 ✓
        //   （修复前是 any，必须 `if t.join() is Array[string] => x {}` 手工收窄 ✗）
        int cleaned = 0
        int failed = 0
        int freedSize = 0
        Array[string] r1 = t1.join()
        Array[string] r2 = t2.join()
        Array[string] r3 = t3.join()
        Array[string] r4 = t4.join()
        Array[Array[string]] rs = []
        rs.add(r1)
        rs.add(r2)
        rs.add(r3)
        rs.add(r4)
        for rs to r {
            cleaned = cleaned + _int(r[0])
            failed = failed + _int(r[1])
            freedSize = freedSize + _int(r[2])
        }

        // 重新扫描以刷新列表（按**本次扫描来源**重扫：dir ⇒ 用户目录；pack ⇒ 释放缓存 ✓）
        cacheItems = []
        if scanMode == "pack" {
            scanPackRelease()
        } else if currentDir != "" and dirs.exists(currentDir) {
            scanDir(currentDir)
        }
        refreshTable()

        if cacheItems.len() > 0 {
            selectAllBtn.set_enabled(true)
            selectNoneBtn.set_enabled(true)
            cleanBtn.set_enabled(true)
        } else {
            cleanBtn.set_enabled(false)
            selectAllBtn.set_enabled(false)
            selectNoneBtn.set_enabled(false)
        }
        // 清理后扫描按钮恢复可用（目录仍存在时），避免停留在禁用状态
        scanBtn.set_enabled(currentDir != "" and dirs.exists(currentDir))
        packScanBtn.set_enabled(true)
        scanning = false
        progressBar.set_value(100.0)
        updateCount()

        string msg = "清理完成: 删除 " + (cleaned as string) + " 项"
        if failed > 0 {
            msg = msg + "，失败 " + (failed as string) + " 项（文件被占用/无权限）"
        }
        msg = msg + "，释放 " + strings.fmt_size(freedSize) + "（" + (CLEAN_THREADS as string) + " 线程 ✓）"
        statusLbl.set_text(msg)
        SDL3.markFrameRedraw()
    }

    // ==================== UI 构建 ====================

    func setupUI() {
        // 标题栏
        titleBar = SDL3.createTitleBar({title: "Leno 缓存清理工具 - 清理 .lenb 和 .lenocache", height: 32, font_size: 14})
        win.add(titleBar)
        float titleH = titleBar.get_h()

        // 顶部工具栏（自动布局：不指定 x/y/w，由父 VBox 分配）
        var toolbar = SDL3.createHBox({h: 36, padX: 4, padY: 2, spacing: 6})

        browseBtn = SDL3.createButton({w: 80, h: 28, text: "浏览...", font_size: 14})
        toolbar.add(browseBtn, {grow: 0, shrink: 0, basis: 80, align: 3})
        browseBtn.on_click(func() { onBrowse() })

        dirLbl = SDL3.createLabel({text: "目录: (未选择)", font_size: 13})
        toolbar.add(dirLbl, {grow: 1, shrink: 1, align: 3})

        scanBtn = SDL3.createButton({w: 70, h: 28, text: "扫描", font_size: 14})
        toolbar.add(scanBtn, {grow: 0, shrink: 0, basis: 70, align: 3})
        scanBtn.set_enabled(false)
        scanBtn.on_click(func() { onScan() })

        // 「释放缓存」：扫描 Leno 单文件打包 exe 的资源释放缓存（不需要选目录 ✓ 2026-09-28）
        packScanBtn = SDL3.createButton({w: 96, h: 28, text: "释放缓存", font_size: 14})
        toolbar.add(packScanBtn, {grow: 0, shrink: 0, basis: 96, align: 3})
        packScanBtn.on_click(func() { onPackScan() })

        selectAllBtn = SDL3.createButton({w: 60, h: 28, text: "全选", font_size: 14})
        toolbar.add(selectAllBtn, {grow: 0, shrink: 0, basis: 60, align: 3})
        selectAllBtn.set_enabled(false)
        selectAllBtn.on_click(func() { onSelectAll() })

        selectNoneBtn = SDL3.createButton({w: 70, h: 28, text: "全不选", font_size: 14})
        toolbar.add(selectNoneBtn, {grow: 0, shrink: 0, basis: 70, align: 3})
        selectNoneBtn.set_enabled(false)
        selectNoneBtn.on_click(func() { onSelectNone() })

        cleanBtn = SDL3.createButton({w: 90, h: 28, text: "清理选中", font_size: 14})
        toolbar.add(cleanBtn, {grow: 0, shrink: 0, basis: 90, align: 3})
        cleanBtn.set_enabled(false)
        cleanBtn.on_click(func() { onClean() })

        // 进度条（w 由 VBox stretch 自动分配）
        progressBar = SDL3.createProgressBar({h: 6, show_text: false})
        progressBar.set_value(0.0)

        // 状态栏（自动布局）
        var statusBar = SDL3.createHBox({h: 24, padX: 0, padY: 0, spacing: 12})
        statusLbl = SDL3.createLabel({text: "就绪 - 点击[浏览...]选择要清理的目录", font_size: 13})
        statusBar.add(statusLbl, {grow: 1, shrink: 1, align: 1})
        countLbl = SDL3.createLabel({text: "选中: 0/0  大小: 0 B", font_size: 13})
        statusBar.add(countLbl, {grow: 0, shrink: 1, basis: 220, align: 2})

        // 结果表格（第 0 列为复选框列；w/h 由 VBox grow:1 自动分配填满剩余空间）
        resultTable = SDL3.createTable({
            headers: ["", "类型", "大小", "路径"],
            col_widths: [40.0, 80.0, 100.0, 600.0],
            sortable: true, zebra: true, row_h: 26, header_h: 30, font_size: 14,
            check_col: 0,
            col_reorder: false, resizable: true
        })
        resultTable.on_check(func(int col, Array[int] checkedRows) { onCheckChange(col, checkedRows) })

        // 设置根布局（w/h 由 setRootAt 根据窗口尺寸自动设置）
        var root = SDL3.createVBox({padX: PAD, padY: PAD, spacing: 4})
        root.add(toolbar, {grow: 0, shrink: 0, align: 3})
        root.add(progressBar, {grow: 0, shrink: 0, align: 3})
        root.add(statusBar, {grow: 0, shrink: 0, align: 3})
        root.add(resultTable, {grow: 1, shrink: 1, align: 3})
        win.setRootAt(root, 0, titleH)
    }

    // ==================== 事件处理 ====================

    func handleEvent(Event ev): bool {
        if ev.isQuit() or ev.isWindowClose() { return false }
        if titleBar.is_close_requested() {
            titleBar.clear_close_request()
            return false
        }
        if ev.isKeyDown() and ev.scancode() == Scancode.ESCAPE { return false }
        return true
    }

    // ==================== 主入口 ====================

    func run() {
        _console(false)
        SDL3.ttfInit()

        int flags = 0x20  // RESIZABLE
        win = SDL3.createWindow({title: "Leno 缓存清理工具", w: 900, h: 600, flags: flags})
        if not win.ok { SDL3.ttfQuit(); return }

        win.setMinSize(600, 400)

        setupUI()

        win.run(
            func(Event ev): bool { return handleEvent(ev) },
            func(Renderer r) { }
        )

        SDL3.ttfQuit()
    }
}

// ==================== 程序入口 ====================
main() {
    CacheCleaner app = new CacheCleaner()
    app.run()
}
