// test_analyzer.leno — PE 分析器逻辑测试（命令行版）
// 验证 PE 尾部 LENB 检测和 XOR 字符串搜索逻辑
import files
import strings
import dirs

// LENB 魔数 0x424E454C ("LENB" little-endian)
const LENB_MAGIC = 0x424E454C

func xorKey(int i): int {
    if i == 0 { return 0x4C }
    if i == 1 { return 0x45 }
    if i == 2 { return 0x4E }
    return 0x4F
}

func readU32(string data, int off): int {
    int val = 0
    for 0:3 to i {
        val = val | (data.byte(off + i) << (i * 8))
    }
    return val
}

// 收编到标准库（2026-09-26）：调用点保留短名，函数体一行转发 ⇒ 逻辑单源 ✓
func toHex8(int v): string { return strings.hex(v, 8) }
func toHex2(int v): string { return strings.hex(v, 2) }

main() {
    // 夹具：取**第一个存在**的候选（原来只写死一个相对路径 ⇒ 换环境就跑不了 ✗）
    // 注意：本测试是**独立 CLI 版**（自带 LENB 检测 / XOR 逻辑）⇒ 它**不覆盖** GUI 里的
    // analyzeDisasm 那条路（那条的越界保护见 pe_analyzer.leno 的 safeByte/adv ✓）。
    // 夹具查找：**优先按脚本自身位置**拼绝对路径。
    //   ⚠ 原来只有相对路径 ⇒ 结果取决于"从哪个目录启动"：
    //     实测 CWD=仓库根 时全部候选都不存在 ⇒ 静默打印"(跳过)"并返回（失败还不报错，最坑 ✗）；
    //     CWD=应用目录 时第三条 `../../../build/leno.exe` 才命中。
    //   ⇒ 用 dirs.script_dir() 拼出来的路径与 CWD 无关；原相对路径保留在后作兼容兜底。
    string sdir = dirs.script_dir() + _sep()
    Array[string] candidates = []
    candidates.add(sdir + "leno_module" + _sep() + "LenoSDL3" + _sep() + "examples" + _sep() + "基础示例" + _sep() + "hello_window.exe")
    candidates.add(sdir + ".." + _sep() + ".." + _sep() + ".." + _sep() + "build" + _sep() + "leno.exe")
    candidates.add("leno_module/LenoSDL3/examples/基础示例/hello_window.exe")
    candidates.add("../../../build/leno.exe")   // 兼容旧行为（依赖 CWD）
    candidates.add("../../build/leno.exe")
    candidates.add("../build/leno.exe")
    string exePath = ""
    for candidates to c {
        if files.exists(c) {
            exePath = c
            break
        }
    }
    if exePath == "" {
        print("(跳过) 未找到可分析的 PE 夹具：")
        for candidates to c { print("    " + c) }
        return
    }
    
    print("========================================")
    print("  Leno PE 分析器 — 逻辑测试")
    print("  目标: " + exePath)
    print("========================================")
    print("")
    
    if not files.exists(exePath) {
        print("文件不存在!")
        return
    }
    
    File f = files.open(exePath, "rb")
    int fileSize = f.len()
    string data = f.read(fileSize)
    f.close()
    
    print("文件大小: " + fileSize + " bytes (" + fileSize / 1024 + " KB)")
    print("")
    
    // 1. 检测 LENB 尾部
    print("[1] 检测 LENB 尾部...")
    if fileSize < 8 {
        print("  x 文件太小，无法包含 LENB 尾部")
        return
    }
    
    int magicOff = fileSize - 4
    int sizeOff = fileSize - 8
    
    int magic = readU32(data, magicOff)
    int lenbSize = readU32(data, sizeOff)
    
    print("  尾部 Magic: 0x" + toHex8(magic))
    print("  LENB Magic: 0x" + toHex8(LENB_MAGIC))
    print("  匹配: " + (magic == LENB_MAGIC))
    
    if magic == LENB_MAGIC {
        int lenbOffset = fileSize - 8 - lenbSize
        print("  LENB 大小: " + lenbSize + " bytes")
        print("  LENB 偏移: 0x" + toHex8(lenbOffset))
        
        // 解析 LENB 头部
        int lenbMagic = readU32(data, lenbOffset)
        int lenbVersion = readU32(data, lenbOffset + 4)
        int lenbFlags = readU32(data, lenbOffset + 8)
        int lenbSrcHash = readU32(data, lenbOffset + 12)
        int globalVars = readU32(data, lenbOffset + 20)
        int globalFuncs = readU32(data, lenbOffset + 24)
        
        print("")
        print("[2] LENB 头部信息:")
        print("  Magic:    0x" + toHex8(lenbMagic) + " (LENB)")
        print("  Version:  0x" + toHex8(lenbVersion))
        print("  Flags:    0x" + toHex8(lenbFlags))
        print("  SrcHash:  0x" + toHex8(lenbSrcHash))
        print("  全局变量: " + globalVars)
        print("  全局函数: " + globalFuncs)
    }
    print("")
    
    // 3. XOR 字符串搜索
    print("[3] XOR 字符串搜索 (密钥: LENO)...")
    int pos = 0
    int maxPos = fileSize - 12
    int found = 0
    
    while pos < maxPos {
        int runStart = pos
        int runLen = 0
        string decrypted = ""
        
        while pos + runLen < fileSize and runLen < 256 {
            int b = data.byte(pos + runLen)
            int keyByte = xorKey(runLen % 4)
            int dec = b ^ keyByte
            
            if (dec >= 0x20 and dec <= 0x7E) or dec >= 0x80 {
                decrypted = decrypted + strings.char(dec)
                runLen = runLen + 1
            } else {
                break
            }
        }
        
        if runLen >= 12 {
            found = found + 1
            if found <= 20 {
                print("  [" + found + "] 偏移: 0x" + toHex8(runStart) + "  长度: " + runLen + "  解密: " + decrypted)
            }
            pos = runStart + runLen
        } else {
            pos = pos + 1
        }
    }
    
    print("  ...")
    print("  总计找到: " + found + " 个 XOR 加密字符串")
    print("")
    print("========================================")
    print("  分析完成!")
    print("========================================")
}
