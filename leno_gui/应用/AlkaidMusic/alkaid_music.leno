// alkaid_music.leno — AlkaidMusic（浅粉音乐库：侧栏导航 + 顶部搜索 + 卡片墙 + 底部播放条）
//
// 界面构成（照参考图搭 ✓）：
//   ① 自绘标题栏 TitleBar（浅粉底、去系统边框 ✓）
//   ② 左侧栏 VBox —— 品牌行 / 主导航（首页·我喜欢·最近·本地）/ 创建的歌单 / 底部「更多」
//   ③ 顶栏 HBox —— 前进后退圆钮 + 搜索胶囊
//   ④ 内容 ScrollView —— 页面标题 + 「继续收听」横卡 + 「为你推荐」卡片墙 + 「最近添加」
//   ⑤ 底部播放条 —— 封面 + 歌名/歌手 + 播放控制 + 进度条 + 音量
//
// 运行：build\leno.exe leno_gui\应用\AlkaidMusic\alkaid_music.leno
// 资源：images\coverNN.png（`tools\gen_covers.leno` 程序化生成；换真封面同名覆盖即可 ✓）
//
// 本次为界面补的**库能力**（都在 build/leno_module/LenoSDL3/lib/ 里，通用 ✓）：
//   · sdl_renderer.leno：`fillGradientRect` / `fillGradientRoundedRect`（线性渐变，此前只有三角形渐变）
//
// ★ 2026-10-25 晚：`sdl_icons`（矢量图标）已从公共库删除 —— 图标属应用资产，框架不背。
//   本界面**暂时改用文字占位**（`»`/`«`/`+`/`♥`/「乐」这类），等换成 PNG 或应用自带图标
//   再把这里的 `txt_btn(...)` 换回 `image_path`。
//
// 无头自检（照 影视海报墙 / 文件管理器 的惯例 ✓）：
//   set ALKAID_SHOT=%TEMP%\alkaid.png   # 第 N 步存一张 PNG 后退出（核对界面就靠它 ✓）
//   set ALKAID_AT=14                    # 第几步截（一步 = 100ms）
//   set ALKAID_SIZE=1000x680            # 指定窗口尺寸（验布局自适应 ✓）
//   set ALKAID_NAV=1                    # 启动就切到某个导航页（验"点导航真的换页" ✓）
//   set ALKAID_SEARCH=周杰伦            # 启动就搜酷我（联网；封面按拍补，缓存到临时目录 ✓）
import "SDL3" as SDL3
import "./music_data.leno" as data
import "web_net" as net
import "./lib/kuwo_core.leno" as kuwo   // 酷我音乐（搜索/直链；从 D:\CLeno\LenoMusic 取来 ✓）
import "./lib/kuwo_cover.leno" as cover // 酷我封面（详情页 pic120 → 500px 大图，单独模块 ✓）
import strings
import dirs
import files
import threads
import "Music" as audio        // miniaudio：真播放（LenoMusic 模块 ✓）
use audio.Sound
use SDL3.(Event, Renderer, Window, TitleBar, Button, Label, Edit, Card, ImageView, Table,
          HBox, VBox, ScrollView, ProgressBar, Slider, Color, Theme)
use data.(Song, Shelf, NavItem)

// ==================== 尺寸 ====================
const int WIN_W = 1200
const int WIN_H = 800
const int TB_H = 32          // 自绘标题栏
const int SIDE_W = 184       // 侧栏宽
const int TOP_H = 58         // 顶栏
const int BAR_H = 82         // 底部播放条
const int PAD = 24           // 内容区左右内边距
// ⚠ 卡片高度按 Card 的**不变式**算：图片区最终高 = h − needBottom
//   needBottom = 文字块(textH) + 12（不给 content_h 时就这么点）
//   实测 h=262 + content_h:44 时图片只剩 157（206 见方被压扁 ⇒ 一片白）✗
//   现在：h = 220 ⇒ 图片可用 173 ≥ 200×0.85 = 170 ⇒ 不压缩、也不留大空白 ✓
const int CARD_W = 152       // 卡片自然宽（5 张 + 4 个间距 = 824，贴合内容宽 840 ✓）
const int CARD_H = 200       // ⚠ 实测下限：图片要 129（152×0.85），文字块+内边距还要 ~71 ⇒ 196 时图片区被压成 0（整片白块）✗，200 才放得下
const int CARD_GAP = 16
const float CARD_ASPECT = 0.85   // 图片区 高/宽
const int PER_ROW = 5        // 每行卡片数（2026-10-25：4 → 5，图片按用户反馈改小 ✓）

// ==================== 调色板（浅粉，照参考图 ✓）====================
var C_BG_TOP   = #FFFDFDFF    // 内容区渐变上端（近白）
var C_BG_BOT   = #FBE8F0FF    // 渐变下端（浅粉）
var C_SIDE      = #FCEFF3FF   // 侧栏底
var C_TXT       = #35262BFF   // 主文字（暖黑）
var C_TXT_MID   = #6B5A60FF   // 次级文字
var C_TXT_DIM   = #A08992FF   // 弱文字
var C_ACCENT    = #E76F9BFF   // 主粉
var C_ACC_SOFT  = #FADBE6FF   // 主粉浅底（选中态）
var C_FIELD     = #FFFFFFD9   // 输入框/胶囊底
var C_LINE      = #F1DDE5FF   // 分隔线
var C_TRANS     = #00000000   // 透明

// ==================== 小工具 ====================
// 图片绝对路径（单文件打包后资源解包到 res_dir ⇒ 必须用它 ✓）
func img(string name): string {
    return dirs.join(dirs.res_dir(), "images/" + name)
}

// 图标路径（2026-10-25：图标从 LenoMusic 的图库里取，放在 images/icons/ 下 ✓）
func ico(string name): string {
    return dirs.join(dirs.res_dir(), "images/icons/" + name)
}

// 封面路径：绝对路径（酷我缓存）直接用，否则当 images/ 下的内置文件名
func coverPath(string c): string {
    if strings.has(c, "/") or strings.has(c, "\\") { return c }
    return img(c)
}

// 造一个标签（可选加粗）—— 全文件只有这一处建标签，样式不会各处漂移 ✓
func lbl(string t, float sz, Color c, bool bold): Label {
    Label l = SDL3.createLabel({text: t, font_size: sz, text_color: c})
    if bold { l.set_font_style(SDL3.STYLE_BOLD) }
    return l
}

// "mm:ss" → 秒（底栏初始时长用：还没真播放时先按歌曲自己的时长显示 ✓）
func parseDur(string t): float {
    int p = strings.byte_find(t, ":", 0)
    if p < 0 { return 0.0 }
    int m = _int(strings.byte_slice(t, 0, p - 1))
    int s = _int(strings.byte_slice(t, p + 1, t.len() - 1))
    return _float(m * 60 + s)
}

// 秒 → "mm:ss"
func fmtTime(float sec): string {
    int total = _int(sec)
    if total < 0 { total = 0 }
    int m = total / 60
    int s = total % 60
    string mm = _str(m)
    if m < 10 { mm = "0" + mm }
    string ss = _str(s)
    if s < 10 { ss = "0" + ss }
    return mm + ":" + ss
}

// ==================== 粉主题（给"只认主题"的控件用：Table / Edit / 滚动条 / tip）====================
//   为什么需要：`lightTheme()` 是中性灰（底 #F0F0F5、斑马 #ECECF2），而 Table 这类控件的颜色
//   **只从主题取**，本文件的 C_* 常量它们看不见 ⇒ 粉底窗口里摆出一块灰白表格 ✗
func appTheme(): Theme {
    Theme t = SDL3.lightTheme()
    t.name     = "alkaid-pink"
    t.bg       = C_BG_TOP
    t.bgAlt    = #FBEDF3FF
    t.bgInput  = #FFFFFFF2
    t.bgHover  = #F8E2EAFF
    t.bgSel    = C_ACC_SOFT
    t.bgZebra  = #FDF4F8FF
    t.bgHeader = C_SIDE
    t.txt      = C_TXT
    t.txtInput = C_TXT
    t.txtDim   = C_TXT_DIM
    t.txtHeader = C_TXT_MID
    t.accent   = C_ACCENT
    t.accentFocus = #F08CB0FF
    t.accentBright = #E76F9BFF
    t.border   = C_LINE
    t.sep      = C_LINE
    t.sb       = #E9CBD6FF
    t.tipBg    = #35262BFF
    t.tipTxt   = #FFF7FAFF
    t.tipBrd   = #C9A9B5FF
    t.fontSize = 13.0
    return t
}

// 缓存目录（照 LenoMusic 的规矩：按用途分**中文子目录**，用户能在文件管理器里单独清理）
//   LenoMusic：`<输出目录>/试听缓存/`（dl_flow.leno:105-109、dl_engine.leno:920-922）
//   这里没有"输出目录"这个概念（是播放器不是下载器）⇒ 根放 %TEMP%\AlkaidMusic，
//   音频进 `试听缓存\`，封面按同一口径进 `封面缓存\` ✓
// 缓存根：**应用目录下的 `缓存\`**（能在资源管理器里直接看到/清理）
//   LenoMusic 也是写到用户可见的输出目录（`<outdir>/试听缓存/`），而不是藏进 %TEMP% ✓
//   打包成单文件时 script_dir 可能是只读的/临时解包目录 ⇒ 那时退回 %TEMP%\AlkaidMusic
func cacheRoot(): string {
    var s = dirs.script_dir()
    if s != null and s != "" {
        try {
            var d = dirs.join(s, "缓存")
            dirs.mkdir_p(d)
            return d
        } catch e {
            print("[cache] 应用目录不可写，改用临时目录：" + _str(e))
        }
    }
    return dirs.join(_tmpdir(), "AlkaidMusic")
}
func audioCacheDir(): string { return dirs.join(cacheRoot(), "试听缓存") }
func coverCacheDir(): string { return dirs.join(cacheRoot(), "封面缓存") }

// 封面逻辑在 lib/kuwo_cover.leno（单独模块，别塞进界面文件 ✓）

// ==================== 搜索工作线程（照 LenoMusic dl_engine.search_entry 口径）====================
//   · 入口是**模块级函数**，参数只用纯值 + Channel —— 传闭包会把 self（Renderer / CachedTex…）
//     一起深克隆给新线程，运行期直接报「不能跨线程传递此类型」✗
//   · 回信走 Channel，UI 侧用 `try_receive()` **非阻塞**排空（LenoMusic dl_flow.leno:277 ✓）
//     ⚠ 不要用 `threads.select([ch])`：那是阻塞式接收，会把界面线程挂住 ✗
//   · 消息 = Array[Array[string]]：第 0 行是状态（["OK"] / ["ERR", 原因]），其后为数据行，
//     行内顺序：歌名 / 歌手 / 专辑 / 时长(秒) / 格式 / 体积 / id
func searchWorker(string kw, int limit, Channel ch) {
    Array[Array[string]] out = []
    try {
        var c = net.createClient()
        var list = kuwo.search(c, kw, limit)
        c.close()
        out.add(["OK", ""])
        for list to s {
            if not s.valid() { continue }
            out.add([s.name, s.artist, s.album, _str(s.duration), s.ext, s.sizeText, s.id])
        }
    } catch e {
        out = []
        out.add(["ERR", _str(e)])
    }
    ch.send(out)
}

// 封面工作线程（同 searchWorker 口径：模块级函数 + 纯值参数 + Channel 回信）
//   回信 = Array[string]：[歌曲 id, 本地路径]（路径为空串表示没取到）
//   ⇒ 界面线程只负责 `try_receive()` 排空后 set_image，**不阻塞** ✓
func coverWorker(string id, string cacheDir, Channel ch) {
    string p = cover.cover_of(id, cacheDir)
    Array[string] out = [id, p]
    ch.send(out)
}

// ==================== 首页分区工作线程（为你推荐 / 最近添加）====================
//   为什么走酷我：演示数据的歌没有 id ⇒ 卡片只能显示内置占位图、也点不出声。
//   用酷我搜索拉两批（带 id）⇒ 卡片有真封面、能真播放，和其它分区表现一致 ✓
//   回信：Array[Array[string]]，分组头是 ["REC",""] / ["NEW",""]，数据行同 searchWorker；
//         失败给 ["ERR", 原因]
func sectionsWorker(string kwRec, string kwNew, int n, string cacheDir, Channel ch) {
    Array[Array[string]] out = []
    try {
        var c = net.createClient()
        // ★ 列表**先回**（只两次搜索，约 1 秒）；封面交给分片线程并行拉（见 coverShardWorker）
        out.add(["REC", ""])
        var a = kuwo.search(c, kwRec, n)
        for a to s {
            if s.valid() { out.add([s.name, s.artist, s.album, _str(s.duration), s.ext, s.sizeText, s.id, ""]) }
        }
        out.add(["NEW", ""])
        var b = kuwo.search(c, kwNew, n)
        for b to s {
            if s.valid() { out.add([s.name, s.artist, s.album, _str(s.duration), s.ext, s.sizeText, s.id, ""]) }
        }
        c.close()
    } catch e {
        out = []
        out.add(["ERR", _str(e)])
    }
    ch.send(out)
}

// 封面分片线程：拿一小批 id，逐个取封面，**每取到一张就回一条** [id, 路径]
//   为什么分片：每张要一个详情页（~150 KB），串行 12 张 ≈ 10 秒；
//   按 3 片并行 ⇒ 约 1/3 时间（LenoMusic 的 `dl_entry_shard(jobs, …, shard, nshards)` 就是这个思路 ✓）
func coverShardWorker(Array[string] ids, string cacheDir, Channel ch) {
    for ids to id {
        if id == "" { continue }
        string p = cover.cover_of(id, cacheDir)
        if p != "" {
            Array[string] one = [id, p]
            ch.send(one)
        }
    }
}

// ==================== 应用 ====================
export struct Player {
    // ----- 窗口骨架 -----
    Window win
    TitleBar tb
    float tbH = 0.0
    VBox root
    HBox body
    VBox side
    VBox mainCol
    HBox topBar
    ScrollView sv
    VBox content
    HBox bar

    // ----- 侧栏状态 -----
    Array[Button] navBtns = []
    Array[Button] plBtns = []
    int curNav = 0

    // ----- 搜索 -----
    Edit search
    string query = ""
    Array[Song] netSongs = []      // 酷我搜索结果（非空就替代演示数据 ✓）
    // 最近播放（"继续收听"按这个顺序显示：最新播的排最前 ✓）
    Array[Song] recentSongs = []
    Table tbSearch                     // 搜索结果表（排序后显示行≠数据行 ⇒ 一律过 source_row ✓）
    bool hasTable = false              // 当前是否真的建过结果表（struct 值类型不能拿 null 判断 ✗）
    int curCols = 0                    // 上一次排版用的列数（resize 时比较，变了才重建 ✓）
    // ----- 「搜索结果」入口 + 上次搜索的快照（切页后还能点回来 ✓）-----
    Button searchBtn
    bool hasLastSearch = false
    Array[Song] lastSongs = []
    Array[Array[string]] lastRows = []
    Array[string] lastIds = []
    string lastKwSaved = ""
    Array[Array[string]] netRows = []  // 表格行：歌名/歌手/专辑/时长/格式/大小/来源
    string netMsg = ""             // 搜索状态：正在搜 / N 首 / 失败原因
    Array[string] netIds = []      // 与 netSongs 对应的酷我 id（取音源用）
    // ----- 搜索线程（LenoMusic 口径：工作线程跑网络，UI 用 try_receive 排空）-----
    Channel searchCh
    bool searching = false
    string lastKw = ""
    Channel coverCh                // 封面线程回信（[id, 路径]）
    string nowSid = ""             // 当前在播的酷我 id（判断封面回信是否过期 ✓）
    // 「为你推荐 / 最近添加」改成**酷我数据**（有 id ⇒ 真封面 + 真播放 ✓）
    Array[Song] recSongs = []
    Array[Song] newSongs = []
    Channel homeCh
    bool homeAsked = false
    bool homeLoaded = false
    bool coverDirty = false        // 有卡片封面到了（攒到下一拍再重建，避免每张都重建 ✓）
    // ----- 真播放（miniaudio）-----
    Sound snd
    bool sndOk = false
    bool durKnown = false          // 时长只取一次
    int shownSec = -1              // 只在秒数变化时重绘
    bool seekSyncing = false       // 程序化刷新进度条时不许回灌 on_seek

    // ----- 底栏播放器 -----
    ImageView coverView
    Label nowTitle
    Label nowArtist
    Button playBtn
    Button likeBtn
    bool liked = false
    ProgressBar seek
    Label curTime
    Label totTime
    Slider vol
    bool playing = false
    bool loopOne = false       // 循环模式：false = 列表循环 / true = 单曲循环
    // ★ 2026-10-25：起步必须是 **0**（原来写死 4.0 ⇒ 一打开就显示 00:04、
    //   进度条左边先挂一小块，和"还没开始播"对不上 —— 用户反馈"起步不一致"✗）
    float pos = 0.0
    float dur = 0.0            // 真实时长由播放时 getDuration() 给出；未播时 0 ⇒ 显示 00:00

    // ----- 无头自检（步数由**定时器**推进，不是帧号 ✓ 见 movie_wall 的注解）-----
    const int STEP_MS = 100
    string shotPath = ""
    int shotAt = 14
    int steps = 0

    // ==================== 入口 ====================
    func run() {
        SDL3.ttfInit()
        searchCh = threads.channel(4)         // 搜索回信通道（一次一条 ✓）
        coverCh = threads.channel(8)          // 封面回信通道
        homeCh = threads.channel(4)           // 首页分区（为你推荐/最近添加）回信通道
        SDL3.setTheme(appTheme())             // 粉主题：Table / Edit / 滚动条都跟着变粉 ✓

        win = SDL3.createWindow({title: "Music — LenoSDL3", w: WIN_W, h: WIN_H, flags: 0x20})
        if not win.ok { SDL3.ttfQuit(); return }
        win.setMinSize(980, 660)

        // ---- 自绘标题栏（win.add 后系统边框自动去掉 ✓）----
        tb = SDL3.createTitleBar({title: "LenoMusic", h: TB_H, font_size: 12,
                                  bg_color: C_SIDE, text_color: C_TXT_DIM,
                                  icon_color: C_TXT_MID, hover_color: C_ACC_SOFT,
                                  show_separator: false})
        win.add(tb)
        tbH = tb.get_h()

        // ---- 根：上=主体（撑满）/ 下=播放条（定高）----
        root = SDL3.createVBox({x: 0, y: 0, w: WIN_W, h: _float(WIN_H) - tbH,
                                pad_x: 0, pad_y: 0, spacing: 0})
        win.setRootAt(root, 0.0, tbH)

        body = SDL3.createHBox({x: 0, y: 0, w: WIN_W, h: 500, pad_x: 0, pad_y: 0, spacing: 0})
        root.add(body, {grow: 1, shrink: 1, align: 3})

        build_side()
        build_main()
        build_bar()

        start_timer()
        self_test()

        win.run(func(Event ev): bool { return on_event(ev) },
                func(Renderer r) { paint_bg(r) })
        shutdown_audio()          // 兜底（requestExit / SDL_QUIT 路径；重复调用无害 ✓）
        SDL3.ttfQuit()
    }

    // 背景渐变：**画在控件之下**（窗内回调在控件之前跑 ✓）—— 一次 RenderGeometry 提交 ✓
    pri func paint_bg(Renderer r) {
        var[float, float](ow, oh) = r.getOutputSize()
        r.clearColor(C_BG_BOT)
        r.fillGradientRect(0.0, 0.0, _float(ow), _float(oh) - tbH, C_BG_TOP, C_BG_BOT, 0)
    }

    // ==================== 侧栏 ====================
    pri func build_side() {
        side = SDL3.createVBox({x: 0, y: 0, w: SIDE_W, h: 400,
                                pad_x: 12, pad_y: 14, spacing: 2, bg_color: C_SIDE})
        body.add(side, {grow: 0, shrink: 0, basis: SIDE_W, align: 3})

        // ---- 品牌行：主色圆 + 名字（参考图左上的圆形头像位 ✓）----
        HBox brand = SDL3.createHBox({x: 0, y: 0, w: SIDE_W - 24, h: 34,
                                      pad_x: 0, pad_y: 0, spacing: 9})
        Button logo = SDL3.createButton({image_path: ico("music.png"), image_size: 16,
                                         w: 30, h: 30, radius: 15,
                                         bg_color: C_ACCENT, hover_color: C_ACCENT,
                                         padding: 0.0, border: false, shadow: false})
        brand.add(logo, {grow: 0, shrink: 0, basis: 30, align: 1})
        brand.add(lbl("LenoMusic", 15, C_TXT, true), {grow: 1, shrink: 1, align: 1})
        side.add(brand, {grow: 0, shrink: 0, basis: 46, align: 3})

        // ---- 主导航（图标 + 文字，选中 = 浅粉胶囊 + 主色字 ✓）----
        var mains = data.navMain()
        for 0 : mains.len() - 1 to i { new_nav(mains[i], i) }

        // ---- 「搜索结果」：紧跟在主导航下面（2026-10-25 用户要求）
        //   切页会退出搜索态、清空当前结果，但**上次搜索留快照** ⇒ 点这里能回到那张表 ✓
        //   没搜过时它是灰的（点了无动作），搜过之后变主色并带上首数
        searchBtn = SDL3.createButton({text: "搜索结果", font_size: 13,
                                       align: "left", padding: 12.0, radius: 9, h: 34,
                                       border: false, shadow: false,
                                       tip: "回到上次搜索的结果"})
        searchBtn.set_bg_color(C_TRANS)
        searchBtn.set_hover_color(#FFFFFFC8)
        searchBtn.set_text_color(C_TXT_DIM)
        searchBtn.on_click(func() { open_last_search() })
        side.add(searchBtn, {grow: 0, shrink: 0, basis: 34, align: 3})

        // ---- 歌单分组头「创建的歌单 +」----
        HBox plHead = SDL3.createHBox({x: 0, y: 0, w: SIDE_W - 24, h: 28,
                                       pad_x: 0, pad_y: 0, spacing: 4})
        plHead.add(lbl("创建的歌单", 11, C_TXT_DIM, false), {grow: 1, shrink: 1, align: 1})
        Button addBtn = SDL3.createButton({text: "+", font_size: 15.0, w: 22, h: 22, radius: 11,
                                           bg_color: C_TRANS, hover_color: #FFFFFFC8,
                                           text_color: C_TXT_DIM, padding: 0.0,
                                           border: false, shadow: false, tip: "新建歌单"})
        plHead.add(addBtn, {grow: 0, shrink: 0, basis: 22, align: 1})
        side.add(plHead, {grow: 0, shrink: 0, basis: 34, align: 3})

        // ---- 歌单列表（图标 + 名字 + 右侧曲目数 ✓）----
        var pls = data.navPlaylists()
        for 0 : pls.len() - 1 to i { new_pl(pls[i], i + navBtns.len()) }

        // ---- 底部：弹性空隙 + 「更多」----
        side.add(SDL3.createLabel({text: ""}), {grow: 1, shrink: 1, align: 3})
        Button more = SDL3.createButton({text: "更多", font_size: 12.5,
                                         align: "left", padding: 12.0, radius: 9,
                                         h: 32, bg_color: C_TRANS, hover_color: #FFFFFFC8,
                                         text_color: C_TXT_MID, border: false, shadow: false})
        side.add(more, {grow: 0, shrink: 0, basis: 32, align: 3})
    }

    // 建一个主导航项（idx 传进来 ⇒ 闭包按值记住它 ✓）
    pri func new_nav(NavItem it, int idx) {
        Button b = SDL3.createButton({text: it.name, font_size: 13,
                                      align: "left", padding: 12.0, radius: 9, h: 34,
                                      border: false, shadow: false})
        style_nav(b, idx == curNav)
        b.on_click(func() { set_nav(idx) })
        navBtns.add(b)
        side.add(b, {grow: 0, shrink: 0, basis: 34, align: 3})
    }

    // 建一个歌单项（按钮 + 右侧计数，整行是一个 HBox ✓）
    pri func new_pl(NavItem it, int idx) {
        HBox row = SDL3.createHBox({x: 0, y: 0, w: SIDE_W - 24, h: 30,
                                    pad_x: 0, pad_y: 0, spacing: 2})
        Button b = SDL3.createButton({text: it.name, font_size: 12,
                                      align: "left", padding: 12.0, radius: 8, h: 30,
                                      border: false, shadow: false})
        b.set_bg_color(C_TRANS)
        b.set_hover_color(#FFFFFFC8)
        b.set_text_color(C_TXT_MID)
        b.on_click(func() { set_nav(idx) })
        plBtns.add(b)
        row.add(b, {grow: 1, shrink: 1, align: 1})
        Label cnt = lbl(_str(it.count), 10, C_TXT_DIM, false)
        row.add(cnt, {grow: 0, shrink: 0, basis: 26, align: 1})
        side.add(row, {grow: 0, shrink: 0, basis: 30, align: 3})
    }

    // 导航项样式：选中 = 浅粉底 + 主色字/图标；未选中 = 透明 + 暖灰（悬停有底 ✓）
    //   初始化与切换都走这里 ⇒ 只有一处定义 ✓
    pri func style_nav(Button b, bool active) {
        if active {
            b.set_bg_color(C_ACC_SOFT)
            b.set_hover_color(C_ACC_SOFT)
            b.set_text_color(C_ACCENT)
        } else {
            b.set_bg_color(C_TRANS)
            b.set_hover_color(#FFFFFFC8)
            b.set_text_color(C_TXT_MID)
        }
    }

    pri func set_nav(int idx) {
        // ★ 2026-10-25：点了导航要真的**换页**（原来只改高亮 ⇒ 用户反馈"点了没切换"）
        //   内容区按新页面重建（标题 / 说明 / 卡片都跟着换），并回到顶部。
        bool changed = idx != curNav
        curNav = idx
        searchBtn.set_bg_color(C_TRANS)
        searchBtn.set_hover_color(#FFFFFFC8)
        if hasLastSearch { searchBtn.set_text_color(C_TXT_MID) }
        for 0 : navBtns.len() - 1 to i { style_nav(navBtns[i], i == idx) }
        for 0 : plBtns.len() - 1 to i {
            Button b = plBtns[i]
            if (i + navBtns.len()) == idx {
                b.set_text_color(C_ACCENT)
                b.set_bg_color(C_ACC_SOFT)
                b.set_hover_color(C_ACC_SOFT)
            } else {
                b.set_text_color(C_TXT_MID)
                b.set_bg_color(C_TRANS)
                b.set_hover_color(#FFFFFFC8)
            }
        }
        if changed {
            // ★ 切页必须**退出搜索态**：`build_content` 里"有 netSongs 就渲染结果表并 return"，
            //   不清空的话标题换了、内容还是那张表（用户截图：标题"最近播放"、下面是酷我结果 ✗）
            netSongs = []
            netRows = []
            netIds = []
            netMsg = ""
            lastKw = ""
            nowSid = ""
            hasTable = false
            // ★ 输入框里的关键词也是"搜索态"：`on_change` 会把它写进 query，
            //   而 build_content 在 query != "" 时走搜索分支 ⇒ 框里留着字，点哪个导航
            //   都显示"没有找到匹配的歌曲"（用户反馈：框里有内容就切不动 ✗）
            //   ⇒ 切页时**连输入框一起清空**（浏览器点新链接也是这个行为 ✓）
            query = ""
            search.set_text("")
            rebuild_content()
            sv.set_scroll(0.0, 0.0)      // 换页回顶部（否则停在上一个页面的位置 ✓）
        }
        SDL3.markFrameRedraw()
    }

    // 回到上次搜索（左侧「搜索结果」入口；curNav = -1 特指这一页）
    pri func open_last_search() {
        if not hasLastSearch { return }
        netSongs = lastSongs
        netRows = lastRows
        netIds = lastIds
        netMsg = "酷我「" + lastKwSaved + "」· " + _str(lastSongs.len()) + " 首（双击行播放）"
        curNav = -1
        for 0 : navBtns.len() - 1 to i { style_nav(navBtns[i], false) }
        for 0 : plBtns.len() - 1 to i {
            plBtns[i].set_text_color(C_TXT_MID)
            plBtns[i].set_bg_color(C_TRANS)
        }
        {
            searchBtn.set_bg_color(C_ACC_SOFT)
            searchBtn.set_hover_color(C_ACC_SOFT)
            searchBtn.set_text_color(C_ACCENT)
        }
        rebuild_content()
        sv.set_scroll(0.0, 0.0)
        SDL3.markFrameRedraw()
    }

    // ==================== 主区：顶栏 + 滚动内容 ====================
    pri func build_main() {
        mainCol = SDL3.createVBox({x: 0, y: 0, w: 900, h: 500, pad_x: 0, pad_y: 0, spacing: 0})
        body.add(mainCol, {grow: 1, shrink: 1, align: 3})

        // ---- 顶栏 ----
        topBar = SDL3.createHBox({x: 0, y: 0, w: 900, h: TOP_H, pad_x: PAD, pad_y: 0, spacing: 10})
        mainCol.add(topBar, {grow: 0, shrink: 0, basis: TOP_H, align: 3})

        Button back = SDL3.createButton({text: "‹", font_size: 15.0, w: 30, h: 30, radius: 15,
                                         bg_color: #FFFFFFAA, hover_color: #FFFFFFFF,
                                         text_color: C_TXT_MID, padding: 0.0,
                                         border: false, shadow: false, tip: "后退"})
        topBar.add(back, {grow: 0, shrink: 0, basis: 30, align: 1})
        Button fwd = SDL3.createButton({text: "›", font_size: 15.0, w: 30, h: 30, radius: 15,
                                        bg_color: #FFFFFFAA, hover_color: #FFFFFFFF,
                                        text_color: C_TXT_MID, padding: 0.0,
                                        border: false, shadow: false, tip: "前进"})
        topBar.add(fwd, {grow: 0, shrink: 0, basis: 30, align: 1})
        topBar.add(SDL3.createLabel({text: ""}), {grow: 1, shrink: 1, align: 1})

        search = SDL3.createEdit({w: 300, h: 36, font_size: 13, radius: 18,
                                  pad_x: 16.0,          // 圆角胶囊：光标别贴着左边框（反馈"光标太近"✓）
                                  placeholder: "搜索歌曲、歌手、歌单", bg_color: C_FIELD,
                                  border_color: C_LINE, text_color: C_TXT})
        search.on_change(func() { on_search() })
        search.on_enter(func() { on_kuwo_search() })   // 回车 = 搜酷我（联网 ✓）
        topBar.add(search, {grow: 0, shrink: 0, basis: 300, align: 1})

        // ---- 滚动内容 ----
        sv = SDL3.createScrollView({x: 0, y: 0, w: 900, h: 500, fit_w: true, step: 64,
                                    smooth: true, bg_color: C_TRANS, border: false,
                                    bar_color: #E9CBD6FF})
        mainCol.add(sv, {grow: 1, shrink: 1, align: 3})

        content = SDL3.createVBox({x: 0, y: 0, w: 900, h: 900, pad_x: PAD, pad_y: 4, spacing: 8})
        sv.set_content(content)

        build_content()
    }

    // 内容区：页面标题 + 三个分区（搜索时按关键词过滤 ✓）
    pri func build_content() {
        // ★ 2026-10-25：标题跟着**当前导航**走（原来写死"首页" ⇒ 点左侧「我喜欢」等
        //   只有高亮在动、页面内容一动不动，看起来就是"点了没切换" ✗）
        content.add(lbl(page_name(curNav), 25, C_TXT, true), {grow: 0, shrink: 0, basis: 36, align: 3})
        string sub = "共 " + _str(data.totalTracks()) + " 首 · 来自 " + _str(data.folderCount()) + " 个文件夹"
        if curNav != 0 { sub = "「" + page_name(curNav) + "」· 演示数据 · 共 " + _str(data.totalTracks()) + " 首" }
        if query != "" { sub = "搜索「" + query + "」" }
        if netMsg != "" { sub = netMsg }
        content.add(lbl(sub, 11, C_TXT_DIM, false), {grow: 0, shrink: 0, basis: 18, align: 3})
        content.add(SDL3.createLabel({text: ""}), {grow: 0, shrink: 0, basis: 8, align: 3})

        // 有酷我搜索结果 ⇒ **表格**列出（2026-10-25 按用户要求：搜索不加载封面）
        //   为什么不铺卡片：搜索要的是信息密度（歌名/歌手/时长/音质），封面要额外
        //   每首一次详情页 + 一次图片下载 ⇒ 一次搜索多花十秒，得不偿失 ✗
        if netSongs.len() > 0 {
            int rowH = 30
            int tbH = 32 + netSongs.len() * rowH
            // 列与 LenoMusic 的搜索页同一套口径（歌名/歌手/专辑/时长/格式/大小/来源），
            //   列宽合计 826 ≤ 内容宽 840 ⇒ 最右列不会被裁掉 ✓（LenoMusic 记过这个账）
            hasTable = true
            tbSearch = SDL3.createTable({x: 0, y: 0, w: 840, h: tbH,
                                         item_h: rowH, header_h: 32, font_size: 13,
                                         headers: ["歌名", "歌手", "专辑", "时长", "格式", "大小", "来源"],
                                         col_widths: [280.0, 140.0, 140.0, 56.0, 56.0, 94.0, 60.0],
                                         aligns: [0, 0, 0, 1, 1, 2, 1],
                                         header_aligns: [0, 0, 0, 1, 1, 2, 1],
                                         // 行图标：`image_col` 把该列画成 [图标 + 文字]，
                                         //   配 `image_path` 给**默认图标**⇒ 不用逐行 set_row_image ✓
                                         image_col: 0, image_size: 16, image_gap: 6,
                                         image_path: ico("music.png"),
                                         // 配色：透明底 + 关斑马纹 ⇒ 让窗口粉渐变透上来（不再是一块白板 ✓）
                                         //   其余（正文/悬停/滚动条）走 appTheme() 的粉主题 ✓
                                         sortable: true, zebra: false, resizable: true,
                                         bg_color: C_TRANS, header_color: #FFFFFFB8,
                                         sel_color: C_ACC_SOFT, sep_color: C_LINE,
                                         empty_text: "没有结果"})
                                         tbSearch.set_rows(netRows)
                                         // ★ 只有**双击**才播放：单击 = 选中、右键 = 菜单（之前挂 on_select 会让右击也开播 ✗）
                                         //   行号一律过 `source_row`（表头排序后显示行 ≠ 数据行 ✓）
                                         tbSearch.on_dbl_click(func(int row, int col) { play_net_row(row) })
                                         tbSearch.on_context_will_open(func(int row) {
                                         tbSearch.clearContextItems()
                                         tbSearch.addContextItem({label: "播放", id: "play"})
                                         tbSearch.addContextItem({label: "复制歌名", id: "copy"})
                                         })
                                         tbSearch.on_context_select(func(int row, string id) {
                                         int i = tbSearch.source_row(row)
                                         if i < 0 or i >= netSongs.len() { return }
                                         if id == "play" { play_net_song(i) }
                                         if id == "copy" { SDL3.setClipboardText(netSongs[i].title + " - " + netSongs[i].artist) }
                                         })
            content.add(tbSearch, {grow: 0, shrink: 0, basis: _float(tbH), align: 3})
            return
        }

        // 首页 = 原来的三个分区；搜索/其它页 = 单区（只放这一页的歌）
        if curNav == 0 and query == "" {
            var sh = data.shelves()
            for 0 : sh.len() - 1 to i {
                // 第一个分区 = 「继续收听」：**按最近播放时间**排（没有播放记录才退回演示切片 ✓）
                if i == 0 and recentSongs.len() > 0 {
                    var r0 = new Shelf()
                    r0.title = "继续收听"
                    r0.sub = "最近播放 · " + _str(recentSongs.len()) + " 首"
                    r0.items = recentSongs
                    add_shelf(r0, true)
                } else if i == 1 and recSongs.len() > 0 {
                    // 为你推荐：**酷我数据**（带 id ⇒ 真封面 + 真播放 ✓）
                    var r1 = new Shelf()
                    r1.title = sh[i].title
                    r1.sub = "根据最近 30 天的收听生成 · 酷我"
                    r1.items = recSongs
                    add_shelf(r1, false)
                } else if i == 2 and newSongs.len() > 0 {
                    var r2 = new Shelf()
                    r2.title = sh[i].title
                    r2.sub = "酷我新歌 · " + _str(newSongs.len()) + " 首"
                    r2.items = newSongs
                    add_shelf(r2, false)
                } else {
                    add_shelf(sh[i], i == 0)
                }
            }
            return
        }
        var songs = page_songs(curNav)
        if songs.len() == 0 {
            content.add(lbl("这里还没有歌曲", 11.5, C_TXT_DIM, false),
                        {grow: 0, shrink: 0, basis: 30, align: 3})
            return
        }
        var one = new Shelf()
        one.title = if query != "" then "搜索结果" else page_name(curNav)
        one.sub = "共 " + _str(songs.len()) + " 首"
        one.items = songs
        add_shelf(one, false)
    }

    // 当前导航页的名字（前 4 个是主导航，之后是歌单 ✓）
    pri func page_name(int idx): string {
        if idx < 0 { return "搜索结果" }        // -1 = 搜索结果页（见 open_last_search ✓）
        var m = data.navMain()
        if idx >= 0 and idx < m.len() { return m[idx].name }
        var p = data.navPlaylists()
        int k = idx - m.len()
        if k >= 0 and k < p.len() { return p[k].name }
        return "首页"
    }

    // 全部歌曲：**有酷我搜索结果就用它**，否则用演示数据（各分区拍平 ✓）
    pri func all_songs(): Array[Song] {
        if netSongs.len() > 0 { return netSongs }
        Array[Song] out = []
        var sh = data.shelves()
        for 0 : sh.len() - 1 to i {
            for 0 : sh[i].items.len() - 1 to j { out.add(sh[i].items[j]) }
        }
        return out
    }

    // ==================== 酷我音乐搜索（工作线程 + 通道回信）====================
    //   照 LenoMusic：网络在**工作线程**里跑，UI 只在这一拍 `try_receive()` 排空 ⇒ 搜索时界面不冻 ✓
    //   （原来在 UI 线程同步 `client.get()`：一次几秒，用户看到的就是"卡死" ✗）
    pri func on_kuwo_search() {
        string kw = strings.trim(search.get_text())
        if kw == "" { return }
        if searching { return }                 // 一次只跑一个，重复回车不排队 ✓
        searching = true
        lastKw = kw
        netMsg = "正在搜索「" + kw + "」…"
        SDL3.markFrameRedraw()                  // 先只改状态（这一帧不重建 ✓）
        threads.start(searchWorker, kw, 40, searchCh)
    }

    // 收工作线程的结果（tick 里调；非阻塞 ✓）
    pri func apply_search_result(Array[Array[string]] msg) {
        searching = false
        if msg.len() == 0 { netMsg = "搜索失败（工作线程没有回信）"; SDL3.markFrameRedraw(); return }
        string kind = if msg[0].len() > 0 then msg[0][0] else "ERR"
        string err = if msg[0].len() > 1 then msg[0][1] else ""
        Array[Song] got = []
        Array[string] ids = []
        Array[Array[string]] trows = []
        for 1 : msg.len() - 1 to k {
            Array[string] r = msg[k]
            if r.len() < 7 { continue }
            Song sg = new Song()
            sg.title = r[0]
            sg.artist = r[1]
            sg.dur = kuwo.formatduration(_int(r[3]))
            // 内置封面（酷我搜索不带图）—— ⚠ 必须带 .png，`img()` 只拼目录不补扩展名 ✗
            int n = 1 + (got.len() % 16)
            if n < 10 { sg.cover = "cover0" + _str(n) + ".png" } else { sg.cover = "cover" + _str(n) + ".png" }
            sg.tag = if r[4].to_lower() == "flac" then "无损" else ""
            got.add(sg)
            ids.add(r[6])
            trows.add([r[0], r[1], r[2], kuwo.formatduration(_int(r[3])),
                       (if r[4] == "" then "-" else r[4].to_upper()),
                       (if r[5] == "" then "-" else r[5]), "酷我"])
        }
        if kind == "OK" and got.len() > 0 {
            netSongs = got
            netRows = trows
            netIds = ids
            netMsg = "酷我「" + lastKw + "」· " + _str(got.len()) + " 首（双击行播放）"
            // 留快照：切页后点左侧「搜索结果」能回到这张表 ✓
            lastSongs = got
            lastRows = trows
            lastIds = ids
            lastKwSaved = lastKw
            hasLastSearch = true
            {
                searchBtn.set_text("搜索结果 (" + _str(got.len()) + ")")
                searchBtn.set_text_color(C_ACCENT)
            }
            query = ""
            curNav = 0
            for 0 : navBtns.len() - 1 to i { style_nav(navBtns[i], i == 0) }
            for 0 : plBtns.len() - 1 to i {
                plBtns[i].set_text_color(C_TXT_MID)
                plBtns[i].set_bg_color(C_TRANS)
            }
            rebuild_content()                    // 内容区按 netSongs 重建 ⇒ 变成结果表 ✓
        } else if kind == "ERR" and err != "" {
            netMsg = "酷我搜索失败（" + err + "），下面仍是演示数据"
            rebuild_content()
        } else {
            netMsg = "酷我里没有「" + lastKw + "」的结果，下面仍是演示数据"
            rebuild_content()
        }
        SDL3.markFrameRedraw()
    }

    // 表格里点一行 ⇒ 播放那首
    //   ⚠ 表格**排序后**显示行 ≠ 数据行（点表头就重排）⇒ 必须过 `source_row` 映射，
    //     直接把显示行当 netSongs 下标会"点 A 放 B"（LenoMusic 2026-10-20 踩过同一坑 ✓）
    pri func play_net_row(int row) {
        if row < 0 { return }
        int i = if hasTable then tbSearch.source_row(row) else row
        if i < 0 or i >= netSongs.len() { return }
        play_net_song(i)
    }

    // ==================== 真播放（miniaudio / LenoMusic 模块）====================
    //   取直链 → 落到 %TEMP%\leno_music_audio → createSound → play
    //   ⚠ 同步取源（4–5 MB 约 1 秒）：后台线程那版在这台机器上播放几秒后会卡死，
    //     而 LenoMusic 的线程+通道我抄错过两次 ⇒ 先把**播放本身**做对，再谈异步 ✓
    //   ⚠ 单实例：换歌时**先 stop+uninit 旧的**，再建新的（不留两台解码器）
    pri func play_net_song(int i) {
        if i < 0 or i >= netSongs.len() { return }
        Song sg = netSongs[i]
        if i < netIds.len() { sg.sid = netIds[i] }
        play_sid(sg)
    }

    // 按 `Song.sid` 播放 —— 搜索结果 / 为你推荐 / 最近添加 / 继续收听 **统一走这里** ✓
    pri func play_sid(Song sg) {
        // 封面已缓存过 ⇒ 直接挂上（让卡片立刻有真图，不用等线程回信 ✓）
        if sg.sid != "" {
            string cf = dirs.join(coverCacheDir(), sg.sid + ".jpg")
            if files.exists(cf) {
                sg.cover = cf
                for 0 : netSongs.len() - 1 to ni {
                    if netSongs[ni].sid == sg.sid { netSongs[ni].cover = cf }
                }
            }
        }
        push_recent(sg)              // 记进「继续收听」（最近播放倒序 ✓）
        nowTitle.set_text(sg.title)
        nowArtist.set_text(sg.artist)
        coverView.set_image(coverPath(sg.cover))
        pos = 0.0
        durKnown = false
        shownSec = -1
        sync_play_ui()
        if sg.sid == "" {
            nowArtist.set_text(sg.artist + " · 演示数据没有音源（搜一首再点）")
            playing = false
            playBtn.set_image(ico("play.png"))
            SDL3.markFrameRedraw()
            return
        }
        string id = sg.sid
        string f = dirs.join(audioCacheDir(), id + ".mp3")
        if not files.exists(f) {
            nowArtist.set_text(sg.artist + " · 正在取音源…（首次约 1–2 秒）")
            SDL3.markFrameRedraw()
            bool gotOne = false
            try {
                dirs.mkdir_p(audioCacheDir())
                var c = net.createClient()
                // ⚠ 先要 **mp3**（实测可播）。之前为了省流量先取 mp3128，结果某些歌
                //   下载下来 createSound 打不开（"文件坏了"）⇒ 那档不一定给真音频 ✗
                //   体积：mp3 4.6 MB / mp3128 3.3 MB / flac 65 MB
                string u = kuwo.officialurl(id, "mp3")
                if u == "" { u = kuwo.officialurl(id, "mp3128") }
                if u == "" { u = kuwo.getdirecturl(c, id) }
                if u != "" { gotOne = net.download(u, f) > 0 }
                c.close()
            } catch e {
                gotOne = false
            }
            if not gotOne or not files.exists(f) {
                nowArtist.set_text(sg.artist + " · 取音源失败（换一首试试）")
                playing = false
                playBtn.set_image(ico("play.png"))
                SDL3.markFrameRedraw()
                return
            }
        }
        bool ok = start_play_file(sg, f)
        if not ok {
            // mp3 打不开（少数歌给的是别的封装 / 截断了）⇒ 退回 **flac** 再试一次
            //   flac miniaudio 一定支持；代价是体积大（可能几十 MB），只在兜底时走 ✓
            nowArtist.set_text(sg.artist + " · mp3 打不开，改用无损再试…")
            SDL3.markFrameRedraw()
            string ff = dirs.join(audioCacheDir(), id + ".flac")
            bool got2 = files.exists(ff)
            if not got2 {
                try {
                    dirs.mkdir_p(audioCacheDir())
                    var c2 = net.createClient()
                    string u2 = kuwo.officialurl(id, "flac")
                    if u2 != "" { got2 = net.download(u2, ff) > 0 }
                    c2.close()
                } catch e {
                    got2 = false
                }
            }
            ok = if got2 then start_play_file(sg, ff) else false
            if not ok {
                nowArtist.set_text(sg.artist + " · 这首取不到可播放的音源")
                playing = false
                playBtn.set_image(ico("play.png"))
                SDL3.markFrameRedraw()
            }
        }
        // 封面：**异步**拉（线程 + 通道），不阻塞界面；
        //   回信在 on_tick 里排空，且只在「还是当前这首」时才贴图（防过期回信贴错歌 ✓）
        nowSid = id
        threads.start(coverWorker, id, coverCacheDir(), coverCh)
    }

    // 文件到位 ⇒ 开声（照 LenoMusic 的 open_local；成功返回 true）
    //   ★★ 关键：换歌时**只 `stop()` 旧声，绝不在建新的之前 `uninit()`** ——
    //      Music 模块的 `Sound.uninit()` 在**最后一个实例**销毁时会 `ma_engine_uninit()` 关掉引擎，
    //      引擎一关，下一次 `createSound` 要重开音频设备；重开一旦失败，模块把 `_engineFailed`
    //      永久置真 ⇒ **之后每首歌都"打不开音频"**（用户实测：第一首能播，之后全废 ✗）
    //      ⇒ 顺序必须是「先建新的、再 uninit 旧的」，让引擎引用计数在切换过程中始终 ≥ 1 ✓
    pri func start_play_file(Song sg, string f): bool {
        if sndOk { snd.stop() }                  // 只停，不销毁（引擎保活 ✓）
        Sound ns = audio.createSound(f)
        if not ns.isInit() {
            // 打不开多半是下载到的不是音频（错误页/截断）⇒ 删缓存，交给调用方换 flac 再试
            try { files.delete(f) } catch e { print("[music] 删缓存失败：" + _str(e)) }
            return false
        }
        // 再验一道：能 open 但**量不出时长**也不是真音频（mp3128 档实测 duration=0.0）
        float d = ns.getDuration()
        if d <= 0.0 {
            ns.uninit()
            try { files.delete(f) } catch e { print("[music] 删缓存失败：" + _str(e)) }
            return false
        }
        ns.setVolume(vol.get_value() / 100.0)
        ns.setLooping(false)
        ns.play()
        Sound old = snd
        bool hadOld = sndOk
        snd = ns
        sndOk = true
        if hadOld { old.uninit() }               // 新声已就位 ⇒ 再销毁旧的（引擎不断档 ✓）
        playing = true
        durKnown = true
        dur = d
        totTime.set_text(fmtTime(dur))
        // 开声成功 ⇒ 把"正在取音源…"那行换回歌手名（之前一直挂着提示 ✗）
        nowArtist.set_text(sg.artist)
        playBtn.set_image(ico("pause.png"))
        sync_play_ui()
        SDL3.markFrameRedraw()
        return true
    }

    // 某个导航页要显示的 8 首（按 idx 取不同切片：换页真的换歌，不是只换标题 ✓）
    pri func page_songs(int idx): Array[Song] {
        var all = all_songs()
        if all.len() == 0 { return [] }
        Array[Song] out = []
        int off = if idx <= 0 then 0 else idx * 3
        int want = if all.len() < 8 then all.len() else 8
        for 0 : want - 1 to k { out.add(all[(off + k) % all.len()]) }
        return out
    }

    // 内容区可用宽度
    //   ⚠ **必须用窗口尺寸算**：`sv.get_w()` 在 build_content 那一刻还是旧值
    //     （布局还没跑）⇒ 按它算出来的列宽永远偏小，看起来"改了没变化" ✗
    pri func content_w(): int {
        var ws = win.getSize()
        int w = ws.w - SIDE_W - PAD * 2 - 12
        if w < 320 { w = 320 }
        return w
    }

    // 当前宽度能放几列（最小卡宽 240、间距 14、最多 6）
    //   ⚠ 框架侧已给 GridLayout 加了 `min_col_width`（自动算列数）；这里还用手工分行，
    //     所以保留这个小函数供 resize 比较用 —— 等换到 GridLayout 就一起删 ✓
    pri func cols_for_width(): int {
        int avail = content_w()
        int c = (avail + 14) / (240 + 14)
        if c < 2 { c = 2 }
        if c > 6 { c = 6 }
        return c
    }

    // 小卡片（**用 Card 控件**，不自己拼 HBox）：图为 58 高，宽度由外面按列宽给
    //   image_h 固定 58 ⇒ 与「继续收听」的缩略图同高 ✓
    pri func mini_card(Song sg, int cw): Card {
        Card c = SDL3.createCard({x: 0, y: 0, w: _float(cw), h: 116,
                                  image_path: coverPath(sg.cover), image_h: 58,
                                  image_mode: 2, image_radius: 10,
                                  radius: 12, bg_color: #FFFFFFBB,
                                  title: sg.title, subtitle: sg.artist,
                                  title_size: 12, subtitle_size: 10.5, title_bold: true,
                                  text_color: C_TXT, subtitle_color: C_TXT_DIM,
                                  content_pad: 8, gap: 4,
                                  hover_lift: 2.0, border: false})
        if sg.tag != "" {
            c.add_badge({text: sg.tag, pos: 1, size: 9, bg: C_ACCENT, color: #FFFFFFFF})
        }
        c.on_click(func() { play_song(sg) })
        return c
    }

    // 一个分区：标题行（+ 右侧胶囊按钮）+ 内容（横卡 / 卡片墙）
    pri func add_shelf(Shelf s, bool compact) {
        HBox head = SDL3.createHBox({x: 0, y: 0, w: 800, h: 34, pad_x: 0, pad_y: 0, spacing: 10})
        head.add(lbl(s.title, 16.5, C_TXT, true), {grow: 0, shrink: 0, align: 1})
        head.add(lbl(s.sub, 10.5, C_TXT_DIM, false), {grow: 0, shrink: 0, align: 1})
        head.add(SDL3.createLabel({text: ""}), {grow: 1, shrink: 1, align: 1})
        if not compact {
            // 参考图右上那两颗胶囊：「换一批」「查看全部」✓
            Button swap = SDL3.createButton({text: "换一批", font_size: 11,
                                             w: 82, h: 26, radius: 13, padding: 9.0,
                                             bg_color: #FFFFFFB0, hover_color: #FFFFFFFF,
                                             text_color: C_TXT_MID, border: false, shadow: false})
            head.add(swap, {grow: 0, shrink: 0, basis: 82, align: 1})
            Button all = SDL3.createButton({text: "查看全部 ›", font_size: 11,
                                            w: 92, h: 26, radius: 13, padding: 9.0,
                                            bg_color: #FFFFFFB0, hover_color: #FFFFFFFF,
                                            text_color: C_TXT_MID, border: false, shadow: false})
            head.add(all, {grow: 0, shrink: 0, basis: 92, align: 1})
        }
        content.add(head, {grow: 0, shrink: 0, basis: 36, align: 3})

        var items = match_items(s.items)
        if items.len() == 0 {
            content.add(lbl("没有找到匹配的歌曲", 11.5, C_TXT_DIM, false),
                        {grow: 0, shrink: 0, basis: 30, align: 3})
            return
        }

        if compact {
            // 继续收听：**一行铺满**（卡宽同样按可用宽度均分，不再写死 250 ✓）
            int avail0 = content_w()
            int gap0 = 14
            // ★ 卡宽按**列数**算，不按"这行有几首"算：
            //   之前 n0 = items.len() ⇒ 只有 1 首时那张卡被拉成整行宽（截图里"继续收听"✗）
            //   现在列数下限 3（满宽最多 4）⇒ 1 首就只占 1/3 宽，右边留白 ✓
            int cols0 = cols_for_width()
            if cols0 > 4 { cols0 = 4 }
            if cols0 < 3 { cols0 = 3 }
            int cw0 = (avail0 - (cols0 - 1) * gap0) / cols0
            int n0 = items.len()
            if n0 > cols0 { n0 = cols0 }
            HBox row = SDL3.createHBox({x: 0, y: 0, w: _float(avail0), h: 78,
                                        pad_x: 0, pad_y: 0, spacing: _float(gap0)})
            for 0 : n0 - 1 to i {
                row.add(wide_card(items[i], cw0), {grow: 0, shrink: 0, basis: _float(cw0), align: 1})
            }
            content.add(row, {grow: 0, shrink: 0, basis: 78, align: 3})
        } else {
            // ★ 2026-10-25：横卡（58px 缩略图，与「继续收听」同款），但**列数按可用宽度算**：
            //   之前写死"每行 3 张、宽 260" ⇒ 宽窗口右侧空一大片、窄窗口又挤（用户反馈 ✓）
            //   现在：cols = (可用宽 + 间距) / (最小卡宽 + 间距)，卡宽再把剩余宽度均分 ⇒ 整行铺满
            int avail = content_w()
            int gap = 14
            int cols = cols_for_width()
            curCols = cols
            int cw = (avail - (cols - 1) * gap) / cols
            int k = 0
            while k < items.len() {
                HBox row = SDL3.createHBox({x: 0, y: 0, w: _float(avail), h: 116,
                                            pad_x: 0, pad_y: 0, spacing: _float(gap)})
                for 0 : cols - 1 to j {
                    int idx = k + j
                    if idx < items.len() {
                        // 横卡：58×58 缩略图 + 标题/歌手 + 播放钮（与「继续收听」同构 ✓）
                        row.add(wide_card(items[idx], cw), {grow: 0, shrink: 0, basis: _float(cw), align: 1})
                    } else {
                        row.add(SDL3.createLabel({text: ""}), {grow: 1, shrink: 1, align: 1})
                    }
                }
                content.add(row, {grow: 0, shrink: 0, basis: 74, align: 3})
                k = k + cols
            }
        }
    }

    // 搜索过滤（关键词空 = 全通过 ✓）
    pri func match_items(Array[Song] src): Array[Song] {
        if query == "" { return src }
        Array[Song] out = []
        for 0 : src.len() - 1 to i {
            if strings.has(src[i].title, query) or strings.has(src[i].artist, query) {
                out.add(src[i])
            }
        }
        return out
    }

    // 竖版卡片：方图 + 歌名 + 歌手（参考图那一列列的小卡 ✓ 无卡片底色，只有图 + 字）
    pri func song_card(Song sg): Card {
        Card c = SDL3.createCard({x: 0, y: 0, w: CARD_W, h: CARD_H,
                                  image_path: coverPath(sg.cover), image_aspect: CARD_ASPECT,
                                  image_radius: 14, radius: 16,
                                  bg_color: C_TRANS,
                                  title: sg.title, subtitle: sg.artist,
                                  title_size: 13.5, subtitle_size: 11,
                                  title_bold: true,
                                  text_color: C_TXT, subtitle_color: C_TXT_DIM,
                                  content_pad: 8, gap: 6,
                                  hover_lift: 2.0, border: false})
        if sg.tag != "" {
            c.add_badge({text: sg.tag, pos: 1, size: 10, bg: C_ACCENT, color: #FFFFFFFF})
        }
        c.on_click(func() { play_song(sg) })
        return c
    }

    // 横卡（继续收听）：圆角浅底 + 封面 + 歌名/歌手 + 播放圆钮
    pri func wide_card(Song sg, int cw): HBox {
        HBox row = SDL3.createHBox({x: 0, y: 0, w: _float(cw), h: 74, pad_x: 8, pad_y: 8,
                                    spacing: 10, bg_color: #FFFFFFBB, bg_radius: 14})
        ImageView iv = SDL3.createImageView({w: 58, h: 58, radius: 10, image_path: coverPath(sg.cover)})
        row.add(iv, {grow: 0, shrink: 0, basis: 58, align: 1})

        VBox tv = SDL3.createVBox({x: 0, y: 0, w: 120, h: 58, pad_x: 0, pad_y: 2, spacing: 2})
        tv.add(lbl(sg.title, 12.5, C_TXT, true), {grow: 0, shrink: 0, basis: 22, align: 3})
        tv.add(lbl(sg.artist, 10.5, C_TXT_DIM, false), {grow: 0, shrink: 0, basis: 18, align: 3})
        row.add(tv, {grow: 1, shrink: 1, align: 1})

        // 卡片上的播放按钮（用户反馈"太小"⇒ 28 → 38，图标 24 → 32 ✓）
        Button pb = SDL3.createButton({image_path: ico("play.png"), image_size: 32,
                                       w: 38, h: 38, radius: 19,
                                       bg_color: C_TRANS, hover_color: #FFFFFFC8,
                                       padding: 0.0, border: false, shadow: false,
                                       tip: "播放"})
        pb.on_click(func() { play_song(sg) })
        row.add(pb, {grow: 0, shrink: 0, basis: 38, align: 1})
        return row
    }

    // ==================== 底部播放条 ====================
    pri func build_bar() {
        bar = SDL3.createHBox({x: 0, y: 0, w: WIN_W, h: BAR_H, pad_x: 18, pad_y: 10,
                               spacing: 14, bg_color: #FFFFFFE8})
        root.add(bar, {grow: 0, shrink: 0, basis: BAR_H, align: 3})

        // ---- 左：封面 + 歌名/歌手 + 喜欢 ----
        Song np = data.nowPlaying()
        if dur <= 0.0 { dur = parseDur(np.dur) }   // 未真播放时先显示歌曲自身时长
        HBox left = SDL3.createHBox({x: 0, y: 0, w: 300, h: 60, pad_x: 0, pad_y: 0, spacing: 12})
        coverView = SDL3.createImageView({w: 56, h: 56, radius: 12, image_path: img(np.cover)})
        left.add(coverView, {grow: 0, shrink: 0, basis: 56, align: 1})

        VBox info = SDL3.createVBox({x: 0, y: 0, w: 160, h: 56, pad_x: 0, pad_y: 3, spacing: 3})
        nowTitle = lbl(np.title, 13, C_TXT, true)
        info.add(nowTitle, {grow: 0, shrink: 0, basis: 22, align: 3})
        nowArtist = lbl(np.artist + " · HRES", 10.5, C_TXT_DIM, false)
        info.add(nowArtist, {grow: 0, shrink: 0, basis: 18, align: 3})
        left.add(info, {grow: 1, shrink: 1, align: 1})

        // ⚠ 用 `☆/★` 而不是 `♥`：实测本界面用的字体里没有 U+2665（渲染成豆腐块 ▯），
        //   而 `☆/★`（U+2606/2605）在 CJK 字体里都有 ⇒ 换成"星标"语义，颜色仍表状态 ✓
        likeBtn = SDL3.createButton({text: "☆", font_size: 15.0, w: 28, h: 28, radius: 14,
                                     bg_color: C_TRANS, hover_color: #FFFFFFC8,
                                     text_color: C_TXT_MID, padding: 0.0,
                                     border: false, shadow: false, tip: "我喜欢"})
        likeBtn.on_click(func() { toggle_like() })
        left.add(likeBtn, {grow: 0, shrink: 0, basis: 28, align: 1})
        bar.add(left, {grow: 0, shrink: 0, basis: 300, align: 1})

        // ---- 中：控制行 + 进度行 ----
        VBox mid = SDL3.createVBox({x: 0, y: 0, w: 460, h: 60, pad_x: 0, pad_y: 0, spacing: 2})

        HBox ctrl = SDL3.createHBox({x: 0, y: 0, w: 460, h: 36, pad_x: 0, pad_y: 0, spacing: 10})
        ctrl.add(SDL3.createLabel({text: ""}), {grow: 1, shrink: 1, align: 1})
        ctrl.add(txt_btn("随", "随机播放", 26, C_TXT_DIM), {grow: 0, shrink: 0, basis: 26, align: 1})
        ctrl.add(img_btn("prev.png", "上一首", 30, 14.0), {grow: 0, shrink: 0, basis: 30, align: 1})

        // 播放/暂停：图标跟着状态换（play.png ⇄ pause.png）—— 2026-10-25 起用真图标 ✓
        playBtn = SDL3.createButton({image_path: ico("play.png"), image_size: 32,
                                     w: 38, h: 38, radius: 19,
                                     bg_color: C_TRANS, hover_color: #FFFFFFC8,
                                     padding: 0.0, border: false, shadow: false,
                                     tip: "播放 / 暂停"})
        playBtn.on_click(func() { toggle_play() })
        ctrl.add(playBtn, {grow: 0, shrink: 0, basis: 38, align: 1})

        ctrl.add(img_btn("next.png", "下一首", 30, 14.0), {grow: 0, shrink: 0, basis: 30, align: 1})

        // 循环：单曲 ⇄ 列表（图标 loop_one / loop_all ✓）
        Button loopBtn = img_btn("loop_all.png", "循环模式", 26, 13.0)
        loopBtn.on_click(func() {
            loopOne = not loopOne
            loopBtn.set_image(if loopOne then ico("loop_one.png") else ico("loop_all.png"))
            SDL3.markFrameRedraw()
        })
        ctrl.add(loopBtn, {grow: 0, shrink: 0, basis: 26, align: 1})
        ctrl.add(SDL3.createLabel({text: ""}), {grow: 1, shrink: 1, align: 1})
        mid.add(ctrl, {grow: 0, shrink: 0, basis: 38, align: 3})

        HBox seekRow = SDL3.createHBox({x: 0, y: 0, w: 460, h: 18, pad_x: 0, pad_y: 0, spacing: 8})
        curTime = lbl(fmtTime(pos), 10, C_TXT_DIM, false)
        seekRow.add(curTime, {grow: 0, shrink: 0, basis: 34, align: 1})
        // ★ 2026-10-25：起点必须是 **0**（原来写 `value: 2.0` ⇒ 一开就带 2% 填充，
        //   而左边时间写着 00:00 ⇒ "起步不一致"✗）
        seek = SDL3.createProgressBar({value: 0.0, min: 0.0, max: 100.0, h: 4,
                                       show_text: false, clickable: true,
                                       fill_color: C_ACCENT, track_color: #EFD8E1FF})
        seek.on_change(func(float v) { on_seek(v) })
        seekRow.add(seek, {grow: 1, shrink: 1, align: 1})
        totTime = lbl(fmtTime(dur), 10, C_TXT_DIM, false)
        seekRow.add(totTime, {grow: 0, shrink: 0, basis: 34, align: 1})
        mid.add(seekRow, {grow: 0, shrink: 0, basis: 18, align: 3})
        sync_play_ui()          // 建完立刻按当前状态刷一次（时间/填充/宽度都对齐 ✓）

        bar.add(mid, {grow: 1, shrink: 1, align: 1})

        // ---- 右：音量 + 播放列表 + 更多 ----
        //   宽度与左侧一样给 300 ⇒ 中间那块正好落在窗口正中（参考图的播放键是居中的 ✓）
        HBox right = SDL3.createHBox({x: 0, y: 0, w: 300, h: 30, pad_x: 0, pad_y: 0, spacing: 6})
        right.add(SDL3.createLabel({text: ""}), {grow: 1, shrink: 1, align: 1})   // 内容靠右 ✓
        right.add(txt_btn("音", "音量", 26, C_TXT_MID), {grow: 0, shrink: 0, basis: 26, align: 1})
        vol = SDL3.createSlider({w: 84, h: 18, value: 68.0, min: 0.0, max: 100.0,
                                 fill_color: C_ACCENT, track_color: #EFD8E1FF,
                                 thumb_color: C_ACCENT, show_value: false})
        vol.on_change(func(float v) { on_volume(v) })
        right.add(vol, {grow: 0, shrink: 0, basis: 84, align: 1})
        right.add(img_btn("list.png", "播放列表", 26, 14.0), {grow: 0, shrink: 0, basis: 26, align: 1})
        right.add(txt_btn("…", "更多", 26, C_TXT_MID), {grow: 0, shrink: 0, basis: 26, align: 1})
        bar.add(right, {grow: 0, shrink: 0, basis: 300, align: 1})
    }

    // 小圆钮（无底色，悬停有底 ✓）—— 底栏/顶栏那一片共用这一处。
    //   ★ 2026-10-25 晚：矢量图标已从公共库删除，这里**暂时用文字占位**（`«`/`»`/`随`/`音`…）。
    //     以后换成 PNG 图标时，把 `text`/`text_color` 换回 `image_path`/`image_size` 即可
    //     （参数名和尺寸口径保持不动，调用点一行都不用改）。
    // 图标小圆钮（2026-10-25：图标来自 LenoMusic 图库 ✓ 无底色、悬停有底）
    pri func img_btn(string iconName, string tipText, int sz, float isz): Button {
        return SDL3.createButton({image_path: ico(iconName), image_size: isz,
                                  w: _float(sz), h: _float(sz), radius: _float(sz) / 2.0,
                                  bg_color: C_TRANS, hover_color: #FFFFFFD0,
                                  padding: 0.0, border: false, shadow: false, tip: tipText})
    }

    pri func txt_btn(string label, string tipText, int sz, Color c): Button {
        Button b = SDL3.createButton({text: label, font_size: _float(sz) * 0.44 + 3.0,
                                      w: _float(sz), h: _float(sz),
                                      radius: _float(sz) / 2.0,
                                      bg_color: C_TRANS, hover_color: #FFFFFFD0,
                                      text_color: c, padding: 0.0,
                                      border: false, shadow: false, tip: tipText})
        return b
    }

    // ==================== 交互 ====================
    pri func toggle_play() {
        // 有真音频对象 ⇒ 交给 miniaudio（stop 保留位置 → pause/resume 就是它 ✓）
        if sndOk {
            if playing { snd.pause() } else { snd.resume() }
        }
        playing = not playing
        playBtn.set_image(if playing then ico("pause.png") else ico("play.png"))
        SDL3.markFrameRedraw()
    }

    pri func toggle_like() {
        liked = not liked
        // `☆`（未喜欢）↔ `★`（已喜欢）+ 主色 —— 与原来 heart/heart_fill 的对比同义
        if liked {
            likeBtn.set_text("★")
            likeBtn.set_text_color(C_ACCENT)
        } else {
            likeBtn.set_text("☆")
            likeBtn.set_text_color(C_TXT_MID)
        }
        SDL3.markFrameRedraw()
    }

    // 点歌 ⇒ 换掉底栏的"正在播放"（演示：只更新文字与封面 ✓）
    // 首页分区回信落地（为你推荐 / 最近添加）：解析成分组 Song 数组
    pri func apply_sections(Array[Array[string]] msg) {
        homeLoaded = true
        Array[Song] rec = []
        Array[Song] nw = []
        int mode = 0
        for 0 : msg.len() - 1 to k {
            Array[string] r = msg[k]
            if r.len() >= 1 and (r[0] == "REC" or r[0] == "NEW" or r[0] == "ERR") {
                mode = if r[0] == "REC" then 1 else (if r[0] == "NEW" then 2 else 0)
                continue
            }
            if r.len() < 7 or mode == 0 { continue }
            Song sg = new Song()
            sg.title = r[0]
            sg.artist = r[1]
            sg.dur = kuwo.formatduration(_int(r[3]))
            sg.sid = r[6]
            int n = 1 + ((rec.len() + nw.len()) % 16)
            sg.cover = if n < 10 then "cover0" + _str(n) + ".png" else "cover" + _str(n) + ".png"
            if r.len() >= 8 and r[7] != "" { sg.cover = r[7] }   // 线程里下好的真封面 ✓
            sg.tag = if r[4].to_lower() == "flac" then "无损" else ""
            if mode == 1 { rec.add(sg) } else { nw.add(sg) }
        }
        if rec.len() > 0 { recSongs = rec }
        if nw.len() > 0 { newSongs = nw }
        // 封面：两区 id 摊平后**按 3 片并行**拉（结果从 coverCh 回来，边到边贴 ✓）
        Array[string] ids = []
        for 0 : recSongs.len() - 1 to k2 {
            if recSongs[k2].sid != "" { ids.add(recSongs[k2].sid) }
        }
        for 0 : newSongs.len() - 1 to k2 {
            if newSongs[k2].sid != "" { ids.add(newSongs[k2].sid) }
        }
        if ids.len() > 0 {
            int shards = 3
            if ids.len() < shards { shards = ids.len() }
            for 0 : shards - 1 to sIdx {
                Array[string] part = []
                int j = sIdx
                while j < ids.len() {
                    part.add(ids[j])
                    j = j + shards
                }
                threads.start(coverShardWorker, part, coverCacheDir(), coverCh)
            }
        }
        if curNav == 0 and netSongs.len() == 0 { rebuild_content() }
        SDL3.markFrameRedraw()
    }

    // 记录"最近播放"：把这首歌提到最前（按 歌名+歌手 去重，最多留 12 首）
    //   ⇒ 「继续收听」直接按这个顺序显示 = 最近播放时间倒序 ✓
    pri func push_recent(Song sg) {
        Array[Song] out = [sg]
        for 0 : recentSongs.len() - 1 to i {
            Song r = recentSongs[i]
            if r.title == sg.title and r.artist == sg.artist { continue }
            if out.len() >= 12 { break }
            out.add(r)
        }
        recentSongs = out
    }

    // 卡片点播放：**有 sid 就走真播放**（推荐 / 最近添加 / 继续收听 里的酷我歌 ✓）
    pri func play_song(Song sg) {
        if sg.sid != "" {
            play_sid(sg)
            return
        }
        push_recent(sg)
        nowTitle.set_text(sg.title)
        nowArtist.set_text(sg.artist + " · HRES")
        coverView.set_image(coverPath(sg.cover))
        pos = 0.0
        playing = true
        playBtn.set_image(ico("pause.png"))
        sync_play_ui()
        SDL3.markFrameRedraw()
    }

    pri func on_seek(float v) {
        if seekSyncing { return }        // 这一拍只是界面在刷新，不是用户拖动 ✓
        float r = v / 100.0
        if r < 0.0 { r = 0.0 }
        if r > 1.0 { r = 1.0 }
        pos = dur * r
        // ⚠ 暂不做真 seek（miniaudio 的 seek+resume 是最重的一步，排查卡顿时先不启用）
        curTime.set_text(fmtTime(pos))
        SDL3.markFrameRedraw()
    }

    pri func on_volume(float v) {
        if sndOk { snd.setVolume(v / 100.0) }
        SDL3.markFrameRedraw()
    }

    pri func on_search() {
        query = strings.trim(search.get_text())
        rebuild_content()
    }

    // 重建内容区（clear 只清布局、不 dispose 子控件 ⇒ 纹理不重建 ✓）
    pri func rebuild_content() {
        content.clear()
        build_content()
        SDL3.markFrameRedraw()
    }

    // 每拍（200ms）推进播放进度
    pri func start_timer() {
        win.addTimer(200, func() { on_tick() })
    }

    pri func on_tick() {
        // ① 排空搜索线程的回信（`try_receive()` 非阻塞 —— 不要用 threads.select ✗）
        if searchCh != null {
            var m = searchCh.try_receive()
            while m != null {
                var rows = m as Array[Array[string]]
                if rows != null { apply_search_result(rows) }
                m = searchCh.try_receive()
            }
        }
        // ①a2 首页分区：启动几拍后拉一次（线程，避免首帧卡住），回信到了替换演示数据
        if not homeAsked and steps >= 3 {
            homeAsked = true
            threads.start(sectionsWorker, "热歌", "新歌", 9, coverCacheDir(), homeCh)
        }
        if homeCh != null and homeCh.len() > 0 {
            var h = homeCh.try_receive()
            while h != null {
                var rows = h as Array[Array[string]]
                if rows != null { apply_sections(rows) }
                h = homeCh.try_receive()
            }
        }
        // ①b 排空封面线程的回信（同样是非阻塞 ✓）；只在还是当前这首时才贴图
        if coverCh != null {
            var c = coverCh.try_receive()
            while c != null {
                var arr = c as Array[string]
                if arr != null and arr.len() >= 2 {
                    string cid = arr[0]
                    string cpath = arr[1]
                    if cpath != "" {
                        bool hitCur = nowSid != "" and cid == nowSid
                        if hitCur { coverView.set_image(cpath) }
                        // ★ 写回歌曲数据：卡片用的是 `sg.cover`（继续收听 / 为你推荐 / 最近添加）
                        bool touched = false
                        for 0 : netSongs.len() - 1 to ni {
                            if netSongs[ni].sid == cid { netSongs[ni].cover = cpath; touched = true }
                        }
                        for 0 : recentSongs.len() - 1 to ri {
                            if recentSongs[ri].sid == cid { recentSongs[ri].cover = cpath; touched = true }
                        }
                        for 0 : recSongs.len() - 1 to ri {
                            if recSongs[ri].sid == cid { recSongs[ri].cover = cpath; touched = true }
                        }
                        for 0 : newSongs.len() - 1 to ri {
                            if newSongs[ri].sid == cid { newSongs[ri].cover = cpath; touched = true }
                        }
                        if touched { coverDirty = true }
                        // 批量重建会打架 ⇒ 每 4 拍最多重建一次（12 张封面 ≈ 3 次重建 ✓）
                        if hitCur {
                            SDL3.markFrameRedraw()
                        } else if coverDirty and (steps % 4) == 0 {
                            rebuild_content()
                            coverDirty = false
                        }
                    }
                }
                c = coverCh.try_receive()
            }
        }
        // ② 推进播放进度
        if playing {
            if sndOk {
                float p2 = snd.getPosition()
                if p2 >= 0.0 { pos = p2 }
                if not durKnown {
                    float d2 = snd.getDuration()
                    if d2 > 0.0 { dur = d2; durKnown = true; totTime.set_text(fmtTime(dur)) }
                }
            } else {
                pos = pos + 0.2
            }
            if pos >= dur { pos = 0.0 }
            if _int(pos) != shownSec {          // 只在秒数变化时刷界面
                shownSec = _int(pos)
                sync_play_ui()
                SDL3.markFrameRedraw()
            }
        }
        steps = steps + 1
    }

    pri func sync_play_ui() {
        float r = if dur > 0.0 then pos / dur * 100.0 else 0.0   // dur=0 时不能除（会 NaN）
        if r < 0.0 { r = 0.0 }
        if r > 100.0 { r = 100.0 }
        seekSyncing = true                  // 程序化刷新：别回灌成 seek ✓
        seek.set_value(r)
        seekSyncing = false
        curTime.set_text(fmtTime(pos))
    }

    // ==================== 退出收尾 ====================
    //   释放音源：停声 → uninit 实例（释放 mp3 解码器与文件句柄）
    //   ⚠ 不调 `audio.uninit()` 关引擎：引擎还有 Sound 挂着时可能在 ma_engine_uninit 里等音频线程；
    //     进程退出本身会回收设备 ✓
    //   ⚠ 照 LenoMusic（musicdl_gui:1198）：`win.run` 要等**所有窗口销毁**才返回
    //     ⇒ 关窗那一刻就要收一次（可重复调用 ✓）
    pri func shutdown_audio() {
        if sndOk {
            snd.stop()
            snd.uninit()
            sndOk = false
        }
    }

    // ==================== 事件 ====================
    pri func on_event(Event ev): bool {
        // 窗口缩放 ⇒ 列数变了才重建（照海报墙原来的 sync_cols 口径：只比列数，不每帧重建 ✓）
        if ev.isWindowResized() {
            if hasTable == false and cols_for_width() != curCols {
                rebuild_content()
            }
        }
        if ev.isQuit() or ev.isWindowClose() {
            shutdown_audio()
            return false
        }
        // 自绘标题栏的 ✕ 必须自己接（TitleBar 只置标志位 ✓）
        if tb._loaded and tb.is_close_requested() {
            tb.clear_close_request()
            shutdown_audio()
            return false
        }
        return true
    }

    // ==================== 无头自检 ====================
    pri func self_test() {
        // 启动就切到某个导航页（下标：0 首页 / 1 我喜欢 / 2 最近播放 / 3 本地音乐 / 4+ 歌单）
        var nv = _env("ALKAID_NAV")
        if nv != null { set_nav(_int(_str(nv))) }
        // 启动就搜一次酷我（联网自检：ALKAID_SEARCH=周杰伦）
        var kwEnv = _env("ALKAID_SEARCH")
        if kwEnv != null {
            search.set_text(_str(kwEnv))
            on_kuwo_search()
        }
        var sh = _env("ALKAID_SHOT")
        if sh != null { shotPath = _str(sh) }
        var at = _env("ALKAID_AT")
        if at != null { shotAt = _int(_str(at)) }
        var sz = _env("ALKAID_SIZE")
        if sz != null {
            var parts = strings.split(_str(sz), "x")
            if parts.len() == 2 { win.setSize(_int(parts[0]), _int(parts[1])) }
        }
        var q = _env("ALKAID_Q")
        if q != null {
            search.set_text(_str(q))
            query = _str(q)
            rebuild_content()
        }
        // ALKAID_ACT=1 ⇒ 走一遍交互链路（点歌 ⇒ 底栏换歌 + 播放态 + 喜欢）
        //   这几条正是最容易"看代码没问题、跑起来不响应"的地方 ✓
        var act = _env("ALKAID_ACT")
        if act != null and _int(_str(act)) > 0 { demo_actions() }
        if shotPath != "" {
            win.setOverlay(func(Renderer r) { shot_overlay(r) })
        }
    }

    pri func demo_actions() {
        var sh = data.shelves()
        if sh.len() < 2 or sh[1].items.len() < 4 { return }
        play_song(sh[1].items[3])
        toggle_like()
    }

    // 叠加层：步数够了就存一张 PNG 并退出（在控件/弹层之后、present 之前 ✓）
    pri func shot_overlay(Renderer r) {
        if shotPath == "" or steps < shotAt { return }
        var sz = win.getSize()
        var s = r.readPixelsAt(0, 0, sz.w, sz.h)
        if s != null {
            bool ok = SDL3.saveImagePNG(s, shotPath)
            print("[music] 截图 " + shotPath + " ok=" + _str(ok) + " 语音=" + _str(playing))
        } else {
            print("[music] 读像素失败：" + SDL3.getError())
        }
        _exit(0)
    }
}

main() {
    Player p = new Player()
    p.run()
}
