// settings_win.leno — 设置对话框（**只画界面**；存哪儿、怎么钳位一律问 settings.leno ✓）
// ----------------------------------------------------------------------------
// 骨架照 LenoMusic `dl_settings_win.leno`：
//   createDialogWindow → dialogTitleBar → setRootAt(root, 0, tb.get_h()) → runModal
//   ⚠ runModal 在主循环已跑时**立即返回** ⇒ 收尾动作必须写在按钮回调里（别写成 if 判断 ✗）
//
// ★ 2026-10-26（用户要求）：改成 **TabControl 分页**，并加「外观」页可换肤
//   · 常规：并行线程数 / 缓存目录
//   · 下载：优先格式（互斥 RadioButton）
//   · 外观：皮肤（粉 / 浅色 / 深色）
//   Tab 内子控件用**绝对坐标**（相对内容区左上角），这是 TabControl 的约定 ✓
import "SDL3" as SDL3
import "sdl_filedialog" as fdlg
import "./settings.leno" as cfg
import strings
use SDL3.(Event, Renderer, Window, TitleBar, Label, Button, SpinBox, Edit, HBox, VBox, Slider,
          Scancode, RadioButton, TabControl)
use cfg.Settings

// 打开设置窗口。onSaved 在"保存成功且已写盘"后回调（调用方据此重读配置 ✓）
// tabIcons：三项页签图标（与「常规/下载/外观」对应；"" = 该页不显示图标）
export func show(string defaultCache, Array[string] tabIcons, func(Settings):void onSaved) {
    int dw = 620
    int dh = 450
    int tbH = SDL3.DIALOG_TB_H
    var dlg = SDL3.createDialogWindow({title: "设置", w: dw, h: tbH + dh})
    TitleBar tb = SDL3.dialogTitleBar(dlg, "设置")
    var root = SDL3.createVBox({x: 0, y: 0, w: dw, h: dh, pad_x: 18, pad_y: 12, spacing: 8})
    dlg.setRootAt(root, 0, tb.get_h())

    Settings cur = cfg.load()
    bool closing = false
    int cw = dw - 36                       // 内容区宽度（Tab 内部坐标上限）

    // 闭包里改局部变量可能按值捕获 ⇒ 用单元素数组（引用语义 ✓）
    Array[string] fmtBox = [cfg.clamp_fmt(cur.fmt)]

    // ==================== Tab 容器 ====================
    // ★ 2026-10-26（用户截图：内容区一块死白）：Tab 的 `bg_color` 默认取 `theme.bg`（纯白），
    //   而对话框底色是粉的 ⇒ 白块特别突兀 ✗ ⇒ 这里给**透明**，让对话框自己的底色透上来 ✓
    TabControl tabs = SDL3.createTabControl({x: 0, y: 0, w: _float(cw), h: 320,
                                             tabs: ["常规", "下载", "外观"], active: 0,
                                             tab_icons: tabIcons, tab_icon_size: 16.0,
                                             bg_color: #00000000, border: false})
    // ★ 固定 300 高：**不能再 grow** —— 和下面的 spacer 同时 grow:1 会平分剩余空间，
    //   Tab 只剩一半高 ⇒ 页内容被裁、看起来重叠（用户截图 ✓）
    root.add(tabs, {grow: 0, shrink: 0, basis: 320, align: 3})

    // ==================== 页 0：常规 ====================
    tabs.addToPage(0, SDL3.createLabel({text: "并行下载线程数（封面分片 / 多首并行）", font_size: 13}), 0, 20)
    SpinBox spin = SDL3.createSpinBox({w: 96, h: 30, min: cfg.WORKERS_MIN, max: cfg.WORKERS_MAX,
                                       step: 1, value: cur.workers, int_mode: true, font_size: 13})
    spin.set_tip("1–" + _str(cfg.WORKERS_MAX) + "：太大只会互相抢带宽")
    tabs.addToPage(0, spin, cw - 116, 14)

    tabs.addToPage(0, SDL3.createLabel({text: "缓存目录（试听音频 / 封面）", font_size: 13}), 0, 66)
    string shown = if cur.cachedir != "" then cur.cachedir else defaultCache
    Edit cacheEdit = SDL3.createEdit({text: shown, w: 330, h: 28, font_size: 12,
                                      tip: "留空 = 跟随默认目录；也可以选别的盘"})
    tabs.addToPage(0, cacheEdit, 0, 92)
    Button pickBtn = SDL3.createButton({w: 76, h: 28, text: "选择…", type: "dark", font_size: 12})
    Button defBtn = SDL3.createButton({w: 60, h: 28, text: "默认", type: "dark", font_size: 12})
    Button openBtn = SDL3.createButton({w: 60, h: 28, text: "打开", type: "dark", font_size: 12})
    openBtn.set_tip("在文件管理器里打开当前缓存目录")
    tabs.addToPage(0, pickBtn, 340, 92)
    tabs.addToPage(0, defBtn, 422, 92)
    tabs.addToPage(0, openBtn, 488, 92)

    Label cacheInfo = SDL3.dialogLabel("当前占用：" + strings.fmt_size(cfg.dir_size(shown)), 11)
    tabs.addToPage(0, cacheInfo, 0, 132)
    tabs.addToPage(0, SDL3.dialogLabel("默认缓存目录：" + defaultCache, 11), 0, 166)
    tabs.addToPage(0, SDL3.dialogLabel("配置文件：" + cfg.store_path(), 11), 0, 188)

    // ==================== 页 1：下载 ====================
    tabs.addToPage(1, SDL3.createLabel({text: "下载优先格式（对新加入的下载任务生效）", font_size: 13}), 0, 20)
    RadioButton rbLoss = SDL3.createRadioButton({text: "无损优先（flac→mp3）", group: "fmt",
                                                 checked: fmtBox[0] == cfg.FMT_LOSSLESS,
                                                 box: 18, gap: 8, font_size: 12.5})
    RadioButton rbMp3 = SDL3.createRadioButton({text: "MP3 优先（mp3→flac）", group: "fmt",
                                                checked: fmtBox[0] == cfg.FMT_MP3,
                                                box: 18, gap: 8, font_size: 12.5})
    rbLoss.set_tip("先取 flac，取不到再退 mp3（体积大、音质好）")
    rbMp3.set_tip("先取 mp3，打不开再退 flac（体积小、更快）")
    tabs.addToPage(1, rbLoss, 0, 60)
    tabs.addToPage(1, rbMp3, 240, 60)

    // ==================== 页 2：外观（★ 2026-10-26：只留「背景图 + 蒙版不透明度」）====================
    tabs.addToPage(2, SDL3.createLabel({text: "背景图片（留空 = 用应用自带的 images/bk.jpg）", font_size: 13}), 0, 18)
    Edit bgEdit = SDL3.createEdit({text: cur.bg, w: 372, h: 28, font_size: 12,
                                   tip: "支持 png / jpg；留空则用内置背景"})
    Button bgPick = SDL3.createButton({w: 94, h: 28, text: "选择图片…", type: "dark", font_size: 12})
    Button bgDef = SDL3.createButton({w: 58, h: 28, text: "默认", type: "dark", font_size: 12})
    bgDef.set_tip("恢复内置背景图 bk.jpg")
    tabs.addToPage(2, bgEdit, 0, 46)
    tabs.addToPage(2, bgPick, 384, 46)
    tabs.addToPage(2, bgDef, 486, 46)

    tabs.addToPage(2, SDL3.createLabel({text: "蒙版透明度（0 = 原图，255 = 全白；越高文字越好读）", font_size: 13}), 0, 96)
    // show_value: false —— Slider 自带的数值文本会和我们右侧的百分比 Label 重叠（截图里那个 191.0 ✗）
    // 轨道颜色必须**比对话框底色深一点**：默认 trkColor = theme.bgAlt（浅粉）= 对话框底色，
    //   未填充那半段看不见，看着就像"轨道和背景重叠"（用户截图 ✓）
    Slider veilS = SDL3.createSlider({w: 360, h: 20, min: cfg.VEIL_MIN, max: cfg.VEIL_MAX,
                                      value: cur.veil, step: 1, show_value: false,
                                      track_color: #E3CEDAFF, fill_color: #F7A8C4FF})
    veilS.set_tip("调整后点「保存」生效；越高界面越亮、背景越淡")
    Label veilTxt = SDL3.dialogLabel(cfg.veil_text(cur.veil), 11)
    tabs.addToPage(2, veilS, 0, 126)
    tabs.addToPage(2, veilTxt, 384, 130)
    tabs.addToPage(2, SDL3.dialogLabel("提示：背景图会按窗口比例裁切（保持填满，不拉伸变形）。", 11), 0, 172)

    // ==================== 底部：提示 + 按钮 ====================
    Label note = SDL3.dialogLabel("线程数 / 格式 / 皮肤对**下一次**生效（正在下的那批不动）", 11)
    root.add(note, {grow: 0, shrink: 0, basis: 22, align: 0})
    root.add(SDL3.dialogSpacer(), {grow: 1, shrink: 1, align: 3})

    Button cancelBtn = SDL3.createButton({w: 90, h: 32, text: "取消", type: "dark", font_size: 13})
    Button okBtn = SDL3.createButton({w: 90, h: 32, text: "保存", type: "primary", font_size: 13})
    root.add(SDL3.dialogButtonRow([cancelBtn, okBtn], 10), {grow: 0, shrink: 0, align: 3})

    // ==================== 回调 ====================
    rbLoss.on_change(func(bool on) {
        if on { fmtBox[0] = cfg.FMT_LOSSLESS; note.set_text("优先格式：无损优先（点「保存」才写盘）"); SDL3.markFrameRedraw() }
    })
    rbMp3.on_change(func(bool on) {
        if on { fmtBox[0] = cfg.FMT_MP3; note.set_text("优先格式：MP3 优先（点「保存」才写盘）"); SDL3.markFrameRedraw() }
    })

    pickBtn.on_click(func() {
        fdlg.showOpenFolderDialog(dlg, func(Array[string] paths, int filter) {
            if paths != null and paths.len() > 0 {
                cacheEdit.set_text(paths[0])
                cacheInfo.set_text("当前占用：" + strings.fmt_size(cfg.dir_size(paths[0])))
                note.set_text("缓存目录已选：" + paths[0] + "（点「保存」才写盘）")
                SDL3.markFrameRedraw()
            }
        }, {default_location: cacheEdit.get_text()})
    })
    defBtn.on_click(func() {
        cacheEdit.set_text(defaultCache)
        cacheInfo.set_text("当前占用：" + strings.fmt_size(cfg.dir_size(defaultCache)))
        note.set_text("已填回默认缓存目录（点「保存」才写盘）")
        SDL3.markFrameRedraw()
    })
    openBtn.on_click(func() {
        string d = trim_text(cacheEdit.get_text())
        if d == "" { d = defaultCache }
        if not cfg.open_folder(d) {
            note.set_text("打开失败（目录可能还不存在）：" + d)
            SDL3.markFrameRedraw()
        }
    })
    // 外观：选背景图 / 恢复默认 / 拖蒙版
    bgPick.on_click(func() {
        fdlg.showOpenFileDialog(dlg, func(Array[string] paths, int filter) {
            if paths != null and paths.len() > 0 {
                bgEdit.set_text(paths[0])
                note.set_text("背景图已选：" + paths[0] + "（点「保存」才生效）")
                SDL3.markFrameRedraw()
            }
        }, {default_location: ""})
    })
    bgDef.on_click(func() {
        bgEdit.set_text("")
        note.set_text("已恢复内置背景 bk.jpg（点「保存」才生效）")
        SDL3.markFrameRedraw()
    })
    veilS.on_change(func(float v) {
        veilTxt.set_text(cfg.veil_text(_int(v)))
        note.set_text("蒙版透明度：" + cfg.veil_text(_int(v)) + "（点「保存」才生效）")
        SDL3.markFrameRedraw()
    })

    cancelBtn.on_click(func() {
        closing = true
        dlg.requestClose()
    })
    okBtn.on_click(func() {
        // ⚠ 从**当前配置起手**再改（读-改-写），别 new 一个空的，否则其它字段被抹成默认 ✗
        Settings s = cfg.load()
        s.workers = cfg.clamp_workers(_int(spin.get_text()))
        string cd = trim_text(cacheEdit.get_text())
        if cd == defaultCache { cd = "" }          // 等于默认 ⇒ 存 ""
        s.cachedir = cd
        s.fmt = cfg.clamp_fmt(fmtBox[0])
        s.bg = trim_text(bgEdit.get_text())
        s.veil = cfg.clamp_veil(_int(veilS.get_value()))
        if cfg.save(s) {
            closing = true
            onSaved(s)
            dlg.requestClose()
        } else {
            note.set_text("保存失败（目录不可写？）：" + cfg.store_path())
            SDL3.markFrameRedraw()
        }
    })
    tb.on_close(func() {
        closing = true
        dlg.requestClose()
    })

    // 构造时 RadioButton 的初值会回调一次 on_change ⇒ 把提示语复位
    note.set_text("线程数 / 格式 / 皮肤对**下一次**生效（正在下的那批不动）")

    SDL3.runModal(dlg,
        func(Event ev): bool {
            if ev.isQuit() { return false }
            if ev.isWindowClose() { closing = true; return false }
            if ev.isKeyDown() and ev.scancode() == Scancode.ESCAPE { closing = true; return false }
            if closing { return false }
            return true
        },
        func(Renderer r) { SDL3.dialogFramePaint(r, dw, tbH + dh) })
    SDL3.markFrameRedraw()
}

// 去首尾空白
func trim_text(string s): string {
    if s == null { return "" }
    return strings.trim(s)
}
