// store.leno — 本地持久化（**只管序列化，不碰界面**）
// ----------------------------------------------------------------------------
// 为什么用 JSON 而不是 SQLite（现阶段）：
//   · 数据小（喜欢几百条、最近播放 12~200 条、设置十几项）⇒ 整体读写足够；
//   · 出问题能直接打开 `library.json` 改一行救回来；
//   · 切 SQLite 的成本被压在**这两个函数内部**（load / save 不变），
//     等做歌单/播放统计（需要部分更新与查询）再换实现 ✓
//
// 文件：<缓存根>\library.json
//   { "version": 1, "likes": ["661608480", …], "recent": [[sid,歌名,歌手,时长,封面], …] }
//
// 写入策略：先写 `.tmp` 再整段覆盖正式文件 —— 宁可多一次 IO，
//   也不要"写一半断电⇒整个收藏夹报废"（JSON 没有事务 ✗）
import jsons
import files
import dirs

export func path_of(string root): string { return dirs.join(root, "library.json") }

// 读：文件不存在 / 内容坏了 ⇒ 返回空 Dict（调用方按"没有数据"处理，不抛异常 ✓）
export func load(string root): Dict[string, any] {
    string f = path_of(root)
    if not files.exists(f) { return {} }
    try {
        string txt = files.read(f)
        if txt.len() == 0 { return {} }
        var d = jsons.decode(txt)
        var dd = d as Dict[string, any]
        if dd != null { return dd }
    } catch e {
        print("[store] 读取失败（按空处理）：" + _str(e))
    }
    return {}
}

export func save(string root, Dict[string, any] d): bool {
    try {
        dirs.mkdir_p(root)
        string f = path_of(root)
        string t = f + ".tmp"
        files.write(t, jsons.encode(d))
        // 没有 rename：先删旧再写新（窗口极小；tmp 还在 ⇒ 至少不会丢成 0 字节）
        if files.exists(f) { files.delete(f) }
        files.write(f, files.read(t))
        files.delete(t)
        return true
    } catch e {
        print("[store] 写入失败：" + _str(e))
        return false
    }
}

// ---------- 便捷读取（键不存在/类型不对 ⇒ 空，不让界面崩）----------
export func str_list(Dict[string, any] d, string key): Array[string] {
    var v = d.get(key, null)
    var a = v as Array[string]
    if a != null { return a }
    return []
}

// 用 values 设置键并返回同一个 Dict（链式写返回值，省一次局部变量 ✓）
export func set_str_list(Dict[string, any] d, string key, Array[string] vals): Dict[string, any] {
    d[key] = vals
    return d
}
