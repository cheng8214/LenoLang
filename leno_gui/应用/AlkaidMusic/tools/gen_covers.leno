// tools/gen_covers.leno — 程序化生成「AlkaidMusic」的专辑封面（离线、无窗口 ✓）
//
// 产物：..\images\cover01.png … cover16.png（320×320 方图）
//   参考图里是真照片；这里用**抽象几何封面**（渐变 + 圆/条带/网格 + 唱片）代替 ——
//   换成真封面只要覆盖同名文件，应用代码一行都不用改 ✓
//
// 用法：build\leno.exe "leno_gui\应用\AlkaidMusic\tools\gen_covers.leno"
//   ⚠ 每张图各自 clear → 画 → 立刻 readPixels → 存盘（同 gen_assets 的实测结论 ✓）
//   ⚠ 渐变用的是新加的 `Renderer.fillGradientRect`（一次 RenderGeometry 提交 ✓）
import "SDL3" as SDL3
import dirs
use SDL3.(Renderer, WindowFlag, Color)

// ==================== 尺寸 ====================
const int CW = 320
const int CH = 320
const int COUNT = 16
const float PI = 3.14159265358979

// ==================== 色板 ====================
//   ⚠ 第一版用了 #F7CBD6→#FFFFFF 这种**极浅**渐变，缩到 200px 挂到浅色界面上几乎看不到 ✗
//     （实测：卡片位一片白，只有角标看得见）⇒ 现在改成**中等饱和到偏深**的对角渐变，
//     浅色图标/文字压上去也清楚 ✓
Array[Color] PAL_A = [#F29AAF, #C79BE8, #F2B072, #8FAEE8,
                      #EC94AB, #B596E0, #EE9E78, #7FB4DC,
                      #E88FA8, #C4A0E8, #F0AE86, #92B6E0,
                      #EFA0B4, #B79AE0, #ECA47E, #88ACDC]
Array[Color] PAL_B = [#B84F70FF, #7A4FA0FF, #C06830FF, #3F5E9AFF,
                      #A84A6AFF, #6A4A9AFF, #B05A30FF, #2F5488FF,
                      #B05070FF, #7A5098FF, #B8603AFF, #3A5C90FF,
                      #A85070FF, #6E4A90FF, #B25A38FF, #35548AFF]

// ==================== 颜色工具 ====================
func with_a(Color c, int a): Color {
    return SDL3.packColor(SDL3.colorR(c), SDL3.colorG(c), SDL3.colorB(c), a)
}
func _cos(float a): float {
    float a2 = a * a
    return 1.0 - a2 / 2.0 + a2 * a2 / 24.0 - a2 * a2 * a2 / 720.0
}
func _sin(float a): float {
    float a2 = a * a
    return a - a * a2 / 6.0 + a * a2 * a2 / 120.0 - a * a2 * a2 * a2 / 5040.0
}

// ==================== 构图（4 种轮换 + 16 套配色 ⇒ 一排看过去不重样 ✓）====================
func cover(Renderer r, int idx) {
    Color a = PAL_A[idx % PAL_A.len()]
    Color b = PAL_B[idx % PAL_B.len()]
    int pat = idx % 4

    // ① 底：对角渐变（横向 + 竖向叠一层，比单一方向有层次 ✓）
    r.fillGradientRect(0.0, 0.0, 320.0, 320.0, with_a(a, 255), with_a(b, 255), 1)

    if pat == 0 {
        // 大圆 + 内圆（像"唱片"）
        r.setColor(with_a(#FFFFFFFF, 150))
        r.fillCircle(228.0, 96.0, 104.0)
        r.setColor(with_a(a, 190))
        r.fillCircle(228.0, 96.0, 74.0)
        r.setColor(with_a(#FFFFFFFF, 210))
        r.fillCircle(228.0, 96.0, 22.0)
        // 左下角斜纹
        r.setColor(with_a(#FFFFFF, 70))
        for 0 : 5 to k {
            r.fillRect(0.0, 214.0 + _float(k) * 20.0, 160.0 - _float(k) * 18.0, 5.0)
        }
    } else if pat == 1 {
        // 斜向宽带（三条）
        for 0 : 2 to k {
            r.setColor(with_a(#FFFFFFFF, 60 + k * 26))
            r.fillRect(0.0, 80.0 + _float(k) * 62.0, 320.0, 26.0)
        }
        r.setColor(with_a(a, 120))
        r.fillRect(0.0, 204.0, 320.0, 116.0)
        r.setColor(with_a(#FFFFFF, 180))
        r.fillCircle(74.0, 246.0, 30.0)
    } else if pat == 2 {
        // 圆角方块阵列（4×4，越靠右下越实）
        for 0 : 3 to gy {
            for 0 : 3 to gx {
                float t = (_float(gx) + _float(gy)) / 6.0
                r.setColor(with_a(#FFFFFFFF, 40 + _int(120.0 * t)))
                r.fillRoundedRect(30.0 + _float(gx) * 66.0, 30.0 + _float(gy) * 66.0,
                                  52.0, 52.0, 14.0)
            }
        }
        r.setColor(with_a(a, 90))
        r.fillRect(0.0, 0.0, 320.0, 320.0)
    } else {
        // 同心圆环（等宽环 ⇒ 视觉上是"声波"✓）
        for 0 : 5 to k {
            r.setColor(with_a(#FFFFFF, 26 + k * 16))
            r.fillCircle(160.0, 160.0, 26.0 + _float(k) * 30.0)
        }
        r.setColor(with_a(a, 220))
        r.fillCircle(160.0, 160.0, 20.0)
        // 顶部一道细光
        r.setColor(with_a(#FFFFFF, 120))
        r.fillRect(0.0, 20.0, 320.0, 2.0)
    }

    // ② 四角压暗（避免"平板一块"✓）
    r.setColor(with_a(#000000, 12))
    r.fillRect(0.0, 0.0, 320.0, 6.0)
    r.fillRect(0.0, 314.0, 320.0, 6.0)

    // ③ 右下角小唱片标记（每张都有的"厂牌位"✓）
    //   ★ 2026-10-25 晚：`SDL3.drawIconAt("disc")` 随 sdl_icons 一起删了 ⇒ 直接画"白圆 + 深芯"
    //     两个圆，视觉上仍是一张小唱片（纯图元，无依赖 ✓）
    r.setColor(with_a(#FFFFFF, 190))
    r.fillCircle(288.0, 288.0, 8.0)
    r.setColor(with_a(#2A2230, 200))
    r.fillCircle(288.0, 288.0, 2.6)
}

// ==================== 入口 ====================
main() {
    string appDir = dirs.dirname(dirs.res_dir())
    string outDir = dirs.join(appDir, "images")
    if not dirs.exists(outDir) {
        try {
            dirs.mkdir_p(outDir)
        } catch e {
            print("[gen] 建目录失败：" + outDir)
            return
        }
    }
    print("[gen] 输出目录：" + outDir)

    var win = SDL3.createWindow({title: "cover-gen", w: CW, h: CH, flags: WindowFlag.HIDDEN})
    if not win.ok {
        print("[gen] createWindow 失败：" + SDL3.getError())
        return
    }
    var r = SDL3.createRenderer(win.getHandle())

    int ok = 0
    for 0 : COUNT - 1 to i {
        r.clearColor(#00000000)
        cover(r, i)
        var s = r.readPixelsAt(0, 0, CW, CH)
        string name = "cover"
        if i + 1 < 10 { name = name + "0" }
        name = name + $"{i + 1}.png"
        if SDL3.saveImagePNG(s, dirs.join(outDir, name)) { ok = ok + 1 }
    }
    print($"[gen] 完成：{ok}/{COUNT} 张")
}
