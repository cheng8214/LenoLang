// tools/shrink_bg.leno — 把背景图压成 JPG（窗口背景用，不需要无损、也不需要原始分辨率）
//
// 用法：build\leno.exe "leno_gui\应用\AlkaidMusic\tools\shrink_bg.leno"
//   进：images\bk.png   出：images\bk.jpg（同名换扩展）
//
// 为什么需要它：`bk.png` 是 1092×613 的插画，无损 PNG 有 5.7MB。
//   ⚠ 只做 PNG→JPG 不够：实测 q=88 仍有 2.9MB（插画细节多、JPG 不吃这套）。
//   ⇒ 背景图**同时缩到 900 宽**再 q=82：窗口里它还要盖一层浅色遮罩（∝0.7 透明白），
//     放大到 1200 宽也看不出糊 ✓ 体积能降到百 KB 量级。
//
// ⚠ 换成别的背景图时，覆盖 images\bk.png 再跑一遍本脚本即可 ✓
import "SDL3" as SDL3
import dirs
import files
use SDL3.(Renderer, WindowFlag)

const int TARGET_W = 900      // 压缩后的宽（高按原图比例算）
const int QUALITY  = 82       // JPG 质量

main() {
    string dir = dirs.join(dirs.res_dir(), "images")
    if not files.exists(dirs.join(dir, "bk.png")) {
        dir = dirs.join(dirs.dirname(dirs.res_dir()), "images")
    }
    string src = dirs.join(dir, "bk.png")
    string dst = dirs.join(dir, "bk.jpg")
    if not files.exists(src) {
        print("[bg] 找不到源图：" + src)
        return
    }
    int oldKb = files.read(src).len() / 1024

    // 借一个隐藏窗口的渲染器做缩放 + 取像素（框架没有直接的 surface 缩放 API ✓）
    var win = SDL3.createWindow({title: "bg-shrink", w: TARGET_W, h: 500, flags: WindowFlag.HIDDEN})
    if not win.ok {
        print("[bg] 窗口失败：" + SDL3.getError())
        return
    }
    var r = SDL3.createRenderer(win.getHandle())
    var tex = SDL3.loadImageTexture(r.handle, src)   // Renderer.handle 是公开字段 ✓
    if tex == null {
        print("[bg] 解码失败：" + SDL3.getError())
        return
    }
    var[float, float](tw, th) = r.getTextureSize(tex)
    if tw < 1.0 or th < 1.0 {
        print("[bg] 取尺寸失败")
        return
    }
    int TW = TARGET_W
    int TH = _int(th * _float(TW) / tw + 0.5)
    win.setSize(TW, TH)

    r.clearColor(#00000000)
    r.drawTextureAt(tex, 0.0, 0.0, _float(TW), _float(TH))
    var s = r.readPixelsAt(0, 0, TW, TH)
    if s == null {
        print("[bg] 读像素失败：" + SDL3.getError())
        return
    }
    bool ok = SDL3.saveImageJPG(s, dst, QUALITY)
    if not ok {
        print("[bg] 保存失败：" + SDL3.getError())
        return
    }
    int newKb = files.read(dst).len() / 1024
    print("[bg] " + _str(_int(tw)) + "x" + _str(_int(th)) + " " + _str(oldKb) + "KB  ->  " +
          _str(TW) + "x" + _str(TH) + " " + _str(newKb) + "KB")
}
