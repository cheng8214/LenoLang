// test_clean_pipeline.leno — 清理管线线程化端到端验证（复刻 UI 的 beginClean/pollClean 机制）
// 后台 delete_worker 线程 + channel 进度 + 主线程轮询 ⇒ 验证「清理不卡 UI 线程、进度逐项推进」
// 运行：build\leno.exe --no-cache test\test_clean_pipeline.leno
import "../cleaner_rules.leno" as rules
import dirs
import files
import strings
import threads

var fails = 0
func check(string name, bool ok) {
    if ok {
        print($"[通过] {name}")
    } else {
        fails = fails + 1
        print($"[失败] {name}")
    }
}
func eq(string name, int got, int want) {
    if got == want {
        print($"[通过] {name} = {got}")
    } else {
        fails = fails + 1
        print($"[失败] {name} 期望 {want} 实际 {got}")
    }
}

// ==================== 造 50 个垃圾文件 ====================
string base = _tmpdir() + "\\cleaner_pipeline_e2e"
if dirs.exists(base) { dirs.delete(base) }
dirs.mkdir(base)
for 0 : 49 to i {
    files.write(base + "\\junk_" + _str(i) + ".tmp", "0123456789ABCDEF")   // 16 字节 × 50
}

// ==================== 扫描（同步）⇒ 切 chunk（同 UI beginClean） ====================
// ⚠ 起始下标必须用 `rules.SCAN_HDR`（成对明细在头部字段之后 ✓）
//   写死 3 的话，加 `kept` 字段后会从 kept 那一格开始切 ⇒ 成对错位
//   ⇒ 线程里对"路径"取 _int 直接抛错（实测：Thread error ✗）
var r = rules.scan_worker([base], "", null, 0, [])
Array[Array[string]] chunk = []
int j = rules.SCAN_HDR
while j + 1 < r.len() {
    chunk.add([r[j], r[j + 1]])
    j = j + 2
}
eq("chunk 单元数", chunk.len(), 50)

// ==================== 后台线程清理 + channel 进度 + 轮询（同 UI pollClean） ====================
// ★ 线程入口必须是**本文件**的具名函数 ✓（与 cleaner_master 的 delete_entry 同形 ✓）
//   ⚠ 实测（2026-09-28）：把**别的模块**的函数直接当线程入口会失败 ✗ ——
//     `join()` 只得到 "Thread error: unknown error"（信息全丢、且进不了函数体 ⇒ 连日志都写不出 ✗）
//     换成同形的本文件包装立刻正常 ✓；应用一直用包装写法所以没事 ✓
func del_entry(Array[Array[string]] chunk, Array[string] roots, any ch, Array[string] enc): Array[string] {
    return rules.delete_worker(chunk, roots, ch, enc)
}

Channel ch = threads.channel(65536)
var t = threads.start(del_entry, chunk, [base], ch, [])   // 第 5 参 = 保留清单编码（见 rules ✓）

int liveAttempted = 0
int liveCleaned = 0
int liveFreed = 0
int polls = 0
while t.state() == "running" or ch.len() > 0 {
    int n = 0
    while n < 4000 {
        var msg = ch.try_receive()
        if msg == null { break }
        if msg is Array => mv {
            liveAttempted = liveAttempted + _int(mv[0])
            liveCleaned = liveCleaned + _int(mv[1])
            liveFreed = liveFreed + _int(mv[2])
        }
        n = n + 1
    }
    polls = polls + 1
    threads.sleep(2)
}
var ret = t.join() as Array[string]

eq("实时: attempted", liveAttempted, 50)
eq("实时: cleaned", liveCleaned, 50)
eq("实时: freed", liveFreed, 800)
eq("join: cleaned", _int(ret[0]), 50)
eq("join: freed", _int(ret[2]), 800)
check("垃圾已全部删除", not files.exists(base + "\\junk_0.tmp"))
check("垃圾已全部删除(尾)", not files.exists(base + "\\junk_49.tmp"))
dirs.delete(base)

print("")
if fails > 0 {
    print($"共 {fails} 项失败")
    _exit(1)
}
print("全部通过")
