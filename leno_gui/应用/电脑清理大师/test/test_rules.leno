// test_rules.leno — cleaner_rules 纯逻辑单测（无 SDL）
// 造临时垃圾 → 换根扫描 → 断言大小/计数 → 删除 → 验证消失 + 白名单拦截
// 运行：build\leno.exe --no-cache test\test_rules.leno
import "../cleaner_rules.leno" as rules
import dirs
import files
import strings
import times as tms

var fails = 0
func check(string name, bool ok) {
    if ok {
        print($"[通过] {name}")
    } else {
        fails = fails + 1
        print($"[失败] {name}")
    }
}
func eq(string name, int got, int want) {
    if got == want {
        print($"[通过] {name} = {got}")
    } else {
        fails = fails + 1
        print($"[失败] {name} 期望 {want} 实际 {got}")
    }
}

// ==================== 1. fmt_size ====================
check("fmt_size 0", rules.fmt_size(0) == "0 B")
check("fmt_size 1023", rules.fmt_size(1023) == "1023 B")
check("fmt_size 1KB", rules.fmt_size(1024) == "1.0 KB")
check("fmt_size 1.5MB", rules.fmt_size(1572864) == "1.5 MB")
check("fmt_size 2GB", rules.fmt_size(2147483648) == "2.0 GB")

// ==================== 2. 造临时垃圾 ====================
string base = dirs.join(_tmpdir(), "cleaner_master_test")
if dirs.exists(base) { dirs.delete(base) }
dirs.mkdir(base)
// ⚠ 夹具路径一律 dirs.join：原实现写死 `"\\"` ⇒ Linux 下拼出的是"**文件名里带反斜杠**"
//   的怪文件（`/tmp/…_test\sub1`），扫描自然一个都看不到 ⇒ 整个用例从第一组断言就假红 ✗
string d1 = dirs.join(base, "sub1")
string d2 = dirs.join(base, "sub2")
dirs.mkdir(d1)
dirs.mkdir(d2)
files.write(dirs.join(d1, "a.log"), "0123456789")        // 10 字节
files.write(dirs.join(d1, "b.tmp"), "0123456789012345")  // 16 字节
files.write(dirs.join(base, "c.log"), "0123")            // 4 字节
files.write(dirs.join(base, "thumbcache_1.db"), "0123456789")  // 10 字节（前缀命中）
files.write(dirs.join(base, "other.txt"), "x")           // 1 字节（整层模式命中）

// ==================== 3. 整层清理模式扫描 ====================
var cat = new rules.CleanCategory(id = "t1", name = "整层", roots = [base])
var r = rules.scan_worker([base], [0], "", null, 0, [], 0)
int size = _int(r[0])
int cnt = _int(r[1])
int skip = _int(r[2])
// 5 个单元：sub1(26) sub2(0) c.log(4) thumbcache_1.db(10) other.txt(1) = 41
eq("整层: 单元数", cnt, 5)
eq("整层: 大小", size, 41)
eq("整层: 跳过", skip, 0)

// 单元清单含子目录与文件
// 布局：[size,cnt,skip,kept, 路径,大小, 路径,大小, ...] ⇒ 路径自 SCAN_HDR 起、奇偶相间 ✓
//   ⚠ 不要写死 3 ✗（2026-09-28 加 kept 字段时就靠 rules.SCAN_HDR 一次改齐 ✓）
bool hasSub1 = false
bool hasC = false
for rules.SCAN_HDR : r.len() - 1 to i {
    if (i - rules.SCAN_HDR) % 2 == 0 {
        if r[i] == d1 { hasSub1 = true }
        if r[i] == dirs.join(base, "c.log") { hasC = true }
    }
}
check("整层: 单元含子目录 sub1", hasSub1)
check("整层: 单元含文件 c.log", hasC)

// ==================== 4. 前缀过滤模式扫描 ====================
var cat2 = new rules.CleanCategory(id = "t2", name = "前缀", roots = [base], file_prefix = "thumbcache_")
var r2 = rules.scan_worker([base], [0], "thumbcache_", null, 0, [], 0)
eq("前缀: 单元数", _int(r2[1]), 1)
eq("前缀: 大小", _int(r2[0]), 10)
check("前缀: 单元是 thumbcache 文件", r2[rules.SCAN_HDR] == dirs.join(base, "thumbcache_1.db"))

// ==================== 5. 删除 + 白名单拦截 ====================
// 5a. 白名单外路径（伪造一个不在 roots 里的路径）必须被拦截
var chunkBad = [[dirs.join(_tmpdir(), "outside_target.txt"), "10"]]
var rb = rules.delete_worker(chunkBad, [base], null, [])
eq("白名单: 拦截计数", _int(rb[1]), 1)
check("白名单: 外部文件未动（不存在也不算删掉）", not files.exists(dirs.join(_tmpdir(), "outside_target.txt")))

// 5b. 正常删除整层清单（成对取出 路径/大小；下标从 SCAN_HDR 起 ✓ 别写死 3 ✗）
Array[Array[string]] chunk = []
for rules.SCAN_HDR : r.len() - 1 to i {
    if (i - rules.SCAN_HDR) % 2 == 0 { chunk.add([r[i], r[i + 1]]) }
}
var rd = rules.delete_worker(chunk, [base], null, [])
eq("删除: cleaned", _int(rd[0]), 5)
eq("删除: freed", _int(rd[2]), 41)   // 真实单元大小：26+0+4+10+1
check("删除: base 下已无 sub1", not dirs.exists(d1))
check("删除: base 下已无 c.log", not files.exists(dirs.join(base, "c.log")))

// 5c. 重复删除同一清单 ⇒ 全部计 failed（已不存在）
var rd2 = rules.delete_worker(chunk, [base], null, [])
eq("重复删除: 全部 failed", _int(rd2[1]), 5)

// ==================== 6. build_categories 基本合法性 ====================
var cats = rules.build_categories()
// 6 原有（系统临时文件/浏览器缓存/错误报告/着色器缓存/缩略图缓存/回收站）
// + 5 新增（崩溃转储/编辑器缓存/聊天缓存/包管理器缓存/网页离线缓存）
// + 4 Linux 独占（字体缓存/桌面缓存/沙箱应用缓存/游戏着色器缓存；Windows 表里是同 id 占位 ✓）
check("build_categories: 类别数 = 15", cats.len() == 15)
// ⚠ 顺序契约：前 6 项固定（`--autoclean` 取证模式用历史下标 [0..4] 与 5）；
//   新增类别必须**追加在回收站之后** ⇒ 这里也钉住"第 6 项（下标 5）是回收站"
check("build_categories: 下标 5 仍是回收站（autoclean 下标契约）", cats[5].id == "recyclebin")
bool foundRecycle = false
bool foundTemp = false
bool foundAllNew = true
for cats to c {
    if c.id == "recyclebin" and c.roots.len() == 0 { foundRecycle = true }
    if c.id == "temp" and c.roots.len() >= 1 { foundTemp = true }
}
for ["crashdump", "editorcache", "chatcache", "devcache", "swcache",
     "fontcache", "deskcache", "sandboxcache", "gamecache"] to need {
    bool hit = false
    for cats to c {
        if c.id == need { hit = true }
    }
    if not hit { foundAllNew = false }
}
check("build_categories: 有回收站(空根)", foundRecycle)
check("build_categories: 有临时目录(至少1根)", foundTemp)
check("build_categories: 9 个新增类别都在", foundAllNew)
// 新增的 9 类必须带提示（UI 行悬停用 ✓；老类别可留空 ✓）—— 含 Linux 独占那 4 类
bool newHint = true
for ["crashdump", "editorcache", "chatcache", "devcache", "swcache",
     "fontcache", "deskcache", "sandboxcache", "gamecache"] to need {
    for cats to c {
        if c.id == need and c.hint == "" { newHint = false }
    }
}
check("build_categories: 新增类别都带 hint", newHint)
// 根必须真实存在
bool allExist = true
for cats to c {
    for c.roots to rt {
        if not dirs.exists(rt) { allExist = false }
    }
}
check("build_categories: 所有登记根均存在", allExist)

// ==================== 7. 线程通道冒烟（try_send 不炸） ====================
import threads
Channel ch = threads.channel(16)
var r3 = rules.scan_worker([base], [0], "", ch, 0, [], 0)
ch.close()
check("通道: 扫描正常返回", _int(r3[1]) == 0)   // base 已被 5b 清空 ⇒ 0 单元

// ==================== 8. 删除进度通道（逐项 [attempted, cleaned, freed]） ====================
files.write(dirs.join(base, "p1.txt"), "0123456789")
files.write(dirs.join(base, "p2.txt"), "0123456789")
files.write(dirs.join(base, "p3.txt"), "0123456789")
Array[Array[string]] chunk2 = [[dirs.join(base, "p1.txt"), "10"], [dirs.join(base, "p2.txt"), "10"], [dirs.join(base, "p3.txt"), "10"]]
Channel ch2 = threads.channel(64)
var rd3 = rules.delete_worker(chunk2, [base], ch2, [])
eq("进度: 消息数 = 单元数", _int(ch2.len()), 3)
eq("进度: cleaned", _int(rd3[0]), 3)
eq("进度: freed", _int(rd3[2]), 30)
ch2.close()

// ==================== 9. top_items（明细清单"取最大 N 项"，纯逻辑 ✓） ====================
// 为什么能在这里测：top_items 放在 cleaner_rules.leno（不 import SDL3）⇒ 可直接单测 ✓
// res 布局：[size, cnt, skip, kept, 路径, 大小, 路径, 大小, ...]（自 SCAN_HDR 起成对 ✓）
Array[string] fake = ["60", "4", "0", "0",
    "c:\\a\\small.tmp", "5",
    "c:\\a\\big.bin", "30",
    "c:\\a\\mid.dat", "20",
    "c:\\a\\tiny.tmp", "1"]
var ti = rules.top_items(fake, 3)
eq("top_items: 条数 = limit", ti.len(), 3)
check("top_items: 第 1 大 = big.bin(30)", ti[0].path == "c:\\a\\big.bin" and ti[0].size == 30)
check("top_items: 第 2 大 = mid.dat(20)", ti[1].path == "c:\\a\\mid.dat" and ti[1].size == 20)
check("top_items: 第 3 大 = small.tmp(5)", ti[2].path == "c:\\a\\small.tmp" and ti[2].size == 5)
// 最小的 tiny.tmp(1) 必须被淘汰（否则"取最大"是假的 ✗）
bool hasTiny = false
for ti to it { if it.path == "c:\\a\\tiny.tmp" { hasTiny = true } }
check("top_items: 最小项被淘汰", not hasTiny)

// limit ≥ 项数 ⇒ 全给，且**仍按降序**
var ti2 = rules.top_items(fake, 10)
eq("top_items: limit > n ⇒ 全给", ti2.len(), 4)
check("top_items: 全给时仍降序", ti2[0].size == 30 and ti2[3].size == 1)

// limit = 0 ⇒ 空（不越界 ✗）
eq("top_items: limit=0 ⇒ 空", rules.top_items(fake, 0).len(), 0)

// 只有头三项（无明细）/ 空结果 ⇒ 不崩
Array[string] emptyRes = ["0", "0", "0"]
eq("top_items: 空结果 ⇒ 空", rules.top_items(emptyRes, 5).len(), 0)

// 同大小两项：都要收进来（不能因为相等就丢项 ✗）
Array[string] same = ["20", "2", "0", "0", "p1", "10", "p2", "10"]
eq("top_items: 同大小两项都收", rules.top_items(same, 2).len(), 2)

// ==================== 10. 保留清单：归一化与匹配语义（纯函数 ✓） ====================
import "../cleaner_whitelist.leno" as wl
use wl.WhitelistRule      // ⚠ 类型位置只吃裸名 ⇒ `Array[wl.WhitelistRule]` 是语法错误 ✗（同 cleaner_master 用 use rules.CleanCategory ✓）
check("norm: 大小写归一", wl.norm("C:\\Temp\\") == "c:\\temp")
check("norm: / 与 \\ 等价", wl.norm("C:/Temp") == "c:\\temp")
check("norm: 根目录归一", wl.norm("C:\\") == "c:")
check("norm: 空串", wl.norm("") == "")

Array[WhitelistRule] rs = [new wl.WhitelistRule(path = "c:\\temp", folder = true),
                           new wl.WhitelistRule(path = "c:\\a\\keep.txt", folder = false)]
check("match: 目录本身被保留", wl.match_in(rs, "C:\\Temp"))
check("match: 子树被保留", wl.match_in(rs, "c:\\temp\\sub\\x.log"))
check("match: 大小写不敏感", wl.match_in(rs, "C:\\TEMP\\SUB\\X.LOG"))
check("match: 单文件被保留", wl.match_in(rs, "c:\\a\\keep.txt"))
// ★★ 边界：`c:\temp2` **绝不**能被 `c:\temp` 命中
//    —— 这是白名单最经典的越界 bug ✗（只比裸前缀就会中招）
check("match: c:\\temp2 不被 c:\\temp 命中", not wl.match_in(rs, "c:\\temp2\\x"))
check("match: 文件规则不误伤同前缀名", not wl.match_in(rs, "c:\\a\\keep.txt.bak"))
check("match: 无关路径不命中", not wl.match_in(rs, "c:\\other\\x"))
check("match: 空目标不命中", not wl.match_in(rs, ""))

// ==================== 11. 保留清单对扫描/删除的**实际效果** ====================
// ⚠ 这一节会改模块全局状态 ⇒ 必须放在最后，并在收尾前清掉 ✓
string wbase = dirs.join(_tmpdir(), "cleaner_wl_test")
if dirs.exists(wbase) { dirs.delete(wbase) }
dirs.mkdir(wbase)
dirs.mkdir(dirs.join(wbase, "keepdir"))
files.write(dirs.join(wbase, "keepdir", "a.tmp"), "0123456789")   // 10 字节 ⇒ 应被豁免 ✓
files.write(dirs.join(wbase, "drop.tmp"), "0123456789")         // 10 字节 ⇒ 应被清 ✓

wl.clear()
wl.add(dirs.join(wbase, "keepdir"), true, "测试")

// 编码路径（worker 实际用的就是它 ✓ —— 纯字符串数组，可安全跨线程 ✓）
Array[string] enc = wl.encode()
eq("encode: 条数", enc.len(), 1)
//   匹配实现在 cleaner_rules（**不是** cleaner_whitelist）—— worker 只能用本模块内的一切 ✓
check("match_encoded: 目录命中", rules.match_encoded(enc, dirs.join(wbase, "keepdir", "x.tmp")))
check("match_encoded: 同前缀兄弟不命中", not rules.match_encoded(enc, dirs.join(wbase, "keepdir2", "x.tmp")))
check("match_encoded: 空规则表不命中", not rules.match_encoded([], dirs.join(wbase, "keepdir", "x.tmp")))

var rw = rules.scan_worker([wbase], [0], "", null, 0, wl.encode(), 0)
eq("保留: 只统计未豁免单元", _int(rw[1]), 1)
eq("保留: 大小只算未豁免", _int(rw[0]), 10)
eq("保留: kept 计数", _int(rw[3]), 1)

// 删除端**兜底**：把豁免项硬塞进 chunk（模拟"清单是清理中途才加的"）⇒ 也不能删 ✓
Array[Array[string]] bad = [[dirs.join(wbase, "keepdir", "a.tmp"), "10"], [dirs.join(wbase, "drop.tmp"), "10"]]
var rd = rules.delete_worker(bad, [wbase], null, wl.encode())
eq("保留: 只删了未豁免项", _int(rd[0]), 1)
eq("保留: 删除端 kept 计数", _int(rd[3]), 1)
check("保留: 豁免文件确实还在", dirs.stat(dirs.join(wbase, "keepdir", "a.tmp")).exists)
check("保留: 未豁免文件确实没了", not dirs.stat(dirs.join(wbase, "drop.tmp")).exists)

// 内置保护清单：必须非空（"读不到就零保护"是最危险的退化 ✗）
var bi = wl.builtin_rules()
check("内置保护: 至少 5 条", bi.len() >= 5)
// ★ 分平台断言：builtin_rules() 本身已按平台给表（Windows 系统目录 / Linux 系统目录）——
//   原先无条件拿 `C:\Windows\System32` 去断言 ⇒ Linux 上恒假（表里根本没有那个目录）✗
if _os() == "windows" {
    check("内置保护: 含 Windows 系统目录", wl.match_in(bi, _env_or("SystemRoot", "C:\\Windows") + "\\System32\\x.dll"))
    check("内置保护: 不误伤 AppData 缓存", not wl.match_in(bi, _env_or("LOCALAPPDATA", "C:\\x") + "\\Temp\\a.tmp"))
    check("内置保护: 不误伤 ProgramData(WER 住这儿)", not wl.match_in(bi, _env_or("ProgramData", "C:\\ProgramData") + "\\Microsoft\\Windows\\WER\\a.txt"))
} else {
    check("内置保护: 含 Linux 系统目录 /usr", wl.match_in(bi, "/usr/lib/x.so"))
    check("内置保护: 含 Linux 系统目录 /etc", wl.match_in(bi, "/etc/passwd"))
    check("内置保护: 不误伤用户缓存 (~/.cache)", not wl.match_in(bi, dirs.join(_env_or("HOME", "/root"), ".cache", "a.tmp")))
}

wl.clear()      // 收尾：别影响别的测试 ✓
dirs.delete(wbase)

// ==================== 12. 年龄过滤（按根的 rootDays + nowSec → 每根各自 cutoff） ====================
// 语义：某根的"够老"下界 = `nowSec - days*86400`（秒）；`days <= 0` 或 `nowSec <= 0` ⇒ 该根不过滤 ✓
//   ★ 2026-10-15 加。为什么必须有：`temp` 类（/tmp 与 /var/tmp）整层删"根的直接子项"
//     会连**别的进程正在用的**临时目录一起删 ✗ ⇒ 改为只收"超过 N 天"的 ✓
//   ★ 门槛**按根**给（/tmp 7 天、/var/tmp 30 天 —— FHS 要求后者跨重启保留 ✓）
//   ⚠ 夹具是**刚写出来的**（mtime ≈ 现在）⇒ 用"一天/两天前"这类远端门槛就能
//     **确定性**地判（不依赖秒级抖动 ✓）
string abase = dirs.join(_tmpdir(), "cmaster_age_test")
if dirs.exists(abase) { dirs.delete(abase) }
dirs.mkdir(abase)
files.write(dirs.join(abase, "old1.tmp"), "0123456789")            // 10 字节
files.write(dirs.join(abase, "old2.tmp"), "0123456789")            // 10 字节
dirs.mkdir(dirs.join(abase, "sub_new"))
files.write(dirs.join(dirs.join(abase, "sub_new"), "f.txt"), "0123456789")
//   ⚠ 本文件的时间模块别名是 `tms`，**不能叫 `ti`**：第 9 节已有个局部变量叫 `ti` ✗
int nowSec = tms.now()

// ① days = 0 ⇒ 该根不过滤 ⇒ 3 个单元（两个文件 + 一个子目录）全收 ✓（= 旧行为）
var ra0 = rules.scan_worker([abase], [0], "", null, 0, [], nowSec)
eq("年龄: days=0 ⇒ 单元数", _int(ra0[1]), 3)
eq("年龄: days=0 ⇒ 跳过", _int(ra0[2]), 0)
eq("年龄: days=0 ⇒ 大小", _int(ra0[0]), 30)

// ② days = 1（门槛 = 一天前，晚于夹具 mtime）⇒ 全都"太新" ⇒ 一个都不收，全部计入 skipped ✓
var ra1 = rules.scan_worker([abase], [1], "", null, 0, [], nowSec)
eq("年龄: 未到期 ⇒ 单元数 0", _int(ra1[1]), 0)
eq("年龄: 未到期 ⇒ 跳过 3", _int(ra1[2]), 3)
eq("年龄: 未到期 ⇒ 大小 0", _int(ra1[0]), 0)

// ③ **把 nowSec 往前推** ⇒ 门槛落回夹具 mtime **之后** ⇒ 全都"够老" ⇒ 3 个单元全收 ✓
//    ⚠ 方向别写反：门槛 = `nowSec - days*86400`，要它**变晚**得让 `nowSec` **变大** ✗
//      （第一版我把它写成"取过去时刻"，结果门槛更早 ⇒ 反而全被跳过 ⇒ 断言当场翻红 ✓）
var ra2 = rules.scan_worker([abase], [1], "", null, 0, [], nowSec + 2 * 86400)
eq("年龄: 已到期 ⇒ 单元数 3", _int(ra2[1]), 3)
eq("年龄: 已到期 ⇒ 跳过 0", _int(ra2[2]), 0)

// ④ nowSec = 0（基准缺失）⇒ **一律不过滤** ⇒ 收敛到旧行为，绝不能反过来"全跳过" ✗
var ra2b = rules.scan_worker([abase], [365], "", null, 0, [], 0)
eq("年龄: nowSec=0 ⇒ 不过滤（3 项）", _int(ra2b[1]), 3)
eq("年龄: nowSec=0 ⇒ 跳过 0", _int(ra2b[2]), 0)

// ⑤ 前缀模式**同样**受约束（两处分支都要覆盖 ✓）
var ra3 = rules.scan_worker([abase], [1], "old", null, 0, [], nowSec)
eq("年龄: 前缀模式 + 未到期 ⇒ 单元数 0", _int(ra3[1]), 0)
eq("年龄: 前缀模式 + 未到期 ⇒ 跳过 2", _int(ra3[2]), 2)
var ra4 = rules.scan_worker([abase], [0], "old", null, 0, [], nowSec)
eq("年龄: 前缀模式 + 不过滤 ⇒ 单元数 2", _int(ra4[1]), 2)

// ⑥ **同一类别内两个根门槛不同**（这才是本轮的重点）：
//    rootA 门槛 1 天（⇒ 夹具太新，全跳过）、rootB 不设（⇒ 照收）✓
string bbase = dirs.join(_tmpdir(), "cmaster_age_test_b")
if dirs.exists(bbase) { dirs.delete(bbase) }
dirs.mkdir(bbase)
files.write(dirs.join(bbase, "b1.tmp"), "0123456789")
var ra5 = rules.scan_worker([abase, bbase], [1, 0], "", null, 0, [], nowSec)
eq("年龄: 两个根门槛不同 ⇒ 只收不设门槛的那个根", _int(ra5[1]), 1)
eq("年龄: 两个根门槛不同 ⇒ 跳过 3", _int(ra5[2]), 3)
eq("年龄: 两个根门槛不同 ⇒ 大小只算第二个根", _int(ra5[0]), 10)

// ⑦ rootDays 比 roots **短**（理论上不该发生）⇒ 缺的那一项**不过滤**（不静默变成全跳过 ✓）
var ra6 = rules.scan_worker([abase, bbase], [1], "", null, 0, [], nowSec)
eq("年龄: rootDays 偏短 ⇒ 第二个根不过滤（1 项）", _int(ra6[1]), 1)

// ⑧ 类别上确实配了门槛，且 **temp 两个根的门槛不同** ✓
//   ⚠ 只有 **Linux 表**的 temp 配了门槛；Windows 侧刻意保持原样（行为零变化 ✓）⇒ 分平台断 ✓
if _os() != "windows" {
    for rules.build_categories() to c {
        if c.id == "temp" {
            check("年龄: temp 的 roots 与 root_age_days 逐位对齐", c.roots.len() == c.root_age_days.len())
            int dTmp = -1
            int dVar = -1
            for 0 : c.roots.len() - 1 to k {
                if strings.ends_with(c.roots[k], "var/tmp") { dVar = c.root_age_days[k] }
                else { dTmp = c.root_age_days[k] }
            }
            check("年龄: /tmp 门槛 = 7 天", dTmp == 7)
            check("年龄: /var/tmp 门槛 = 30 天（与 /tmp 不同 ✓）", dVar == 30)
            // effective_root_days：摊平结果必须与逐位取值一致 ✓
            var eff = rules.effective_root_days(c)
            check("年龄: effective_root_days 与 roots 等长", eff.len() == c.roots.len())
        }
    }
    // 没设 root_age_days 的类别 ⇒ 摊平结果应全部等于类别默认值（这里是 0）✓
    for rules.build_categories() to c {
        if c.id == "browser" {
            var eff2 = rules.effective_root_days(c)
            bool allZero = true
            for eff2 to d {
                if d != c.min_age_days { allZero = false }
            }
            check("年龄: 未设按根门槛的类别 ⇒ 摊平全用类别默认值", allZero)
        }
    }
}
dirs.delete(bbase)

dirs.delete(abase)

// ==================== 收尾 ====================
dirs.delete(base)
print("")
if fails > 0 {
    print($"共 {fails} 项失败")
    _exit(1)
}
print("全部通过")
