// test_rules.leno — cleaner_rules 纯逻辑单测（无 SDL）
// 造临时垃圾 → 换根扫描 → 断言大小/计数 → 删除 → 验证消失 + 白名单拦截
// 运行：build\leno.exe --no-cache test\test_rules.leno
import "../cleaner_rules.leno" as rules
import dirs
import files
import strings

var fails = 0
func check(string name, bool ok) {
    if ok {
        print($"[通过] {name}")
    } else {
        fails = fails + 1
        print($"[失败] {name}")
    }
}
func eq(string name, int got, int want) {
    if got == want {
        print($"[通过] {name} = {got}")
    } else {
        fails = fails + 1
        print($"[失败] {name} 期望 {want} 实际 {got}")
    }
}

// ==================== 1. fmt_size ====================
check("fmt_size 0", rules.fmt_size(0) == "0 B")
check("fmt_size 1023", rules.fmt_size(1023) == "1023 B")
check("fmt_size 1KB", rules.fmt_size(1024) == "1.0 KB")
check("fmt_size 1.5MB", rules.fmt_size(1572864) == "1.5 MB")
check("fmt_size 2GB", rules.fmt_size(2147483648) == "2.0 GB")

// ==================== 2. 造临时垃圾 ====================
string base = _tmpdir() + "\\cleaner_master_test"
if dirs.exists(base) { dirs.delete(base) }
dirs.mkdir(base)
string d1 = base + "\\sub1"
string d2 = base + "\\sub2"
dirs.mkdir(d1)
dirs.mkdir(d2)
files.write(d1 + "\\a.log", "0123456789")        // 10 字节
files.write(d1 + "\\b.tmp", "0123456789012345")  // 16 字节
files.write(base + "\\c.log", "0123")            // 4 字节
files.write(base + "\\thumbcache_1.db", "0123456789")  // 10 字节（前缀命中）
files.write(base + "\\other.txt", "x")           // 1 字节（整层模式命中）

// ==================== 3. 整层清理模式扫描 ====================
var cat = new rules.CleanCategory(id = "t1", name = "整层", roots = [base])
var r = rules.scan_worker([base], "", null, 0)
int size = _int(r[0])
int cnt = _int(r[1])
int skip = _int(r[2])
// 5 个单元：sub1(26) sub2(0) c.log(4) thumbcache_1.db(10) other.txt(1) = 41
eq("整层: 单元数", cnt, 5)
eq("整层: 大小", size, 41)
eq("整层: 跳过", skip, 0)

// 单元清单含子目录与文件（结果布局：[size,cnt,skip, 路径,大小, 路径,大小, ...] ⇒ 路径在奇数位）
bool hasSub1 = false
bool hasC = false
for 3 : r.len() - 1 to i {
    if i % 2 == 1 {
        if r[i] == d1 { hasSub1 = true }
        if r[i] == base + "\\c.log" { hasC = true }
    }
}
check("整层: 单元含子目录 sub1", hasSub1)
check("整层: 单元含文件 c.log", hasC)

// ==================== 4. 前缀过滤模式扫描 ====================
var cat2 = new rules.CleanCategory(id = "t2", name = "前缀", roots = [base], file_prefix = "thumbcache_")
var r2 = rules.scan_worker([base], "thumbcache_", null, 0)
eq("前缀: 单元数", _int(r2[1]), 1)
eq("前缀: 大小", _int(r2[0]), 10)
check("前缀: 单元是 thumbcache 文件", r2[3] == base + "\\thumbcache_1.db")

// ==================== 5. 删除 + 白名单拦截 ====================
// 5a. 白名单外路径（伪造一个不在 roots 里的路径）必须被拦截
var chunkBad = [[_tmpdir() + "\\outside_target.txt", "10"]]
var rb = rules.delete_worker(chunkBad, [base], null)
eq("白名单: 拦截计数", _int(rb[1]), 1)
check("白名单: 外部文件未动（不存在也不算删掉）", not files.exists(_tmpdir() + "\\outside_target.txt"))

// 5b. 正常删除整层清单（成对取出 路径/大小）
Array[Array[string]] chunk = []
for 3 : r.len() - 1 to i {
    if i % 2 == 1 { chunk.add([r[i], r[i + 1]]) }
}
var rd = rules.delete_worker(chunk, [base], null)
eq("删除: cleaned", _int(rd[0]), 5)
eq("删除: freed", _int(rd[2]), 41)   // 真实单元大小：26+0+4+10+1
check("删除: base 下已无 sub1", not dirs.exists(d1))
check("删除: base 下已无 c.log", not files.exists(base + "\\c.log"))

// 5c. 重复删除同一清单 ⇒ 全部计 failed（已不存在）
var rd2 = rules.delete_worker(chunk, [base], null)
eq("重复删除: 全部 failed", _int(rd2[1]), 5)

// ==================== 6. build_categories 基本合法性 ====================
var cats = rules.build_categories()
// 6 原有（系统临时文件/浏览器缓存/错误报告/着色器缓存/缩略图缓存/回收站）
// + 5 新增（崩溃转储/编辑器缓存/聊天缓存/包管理器缓存/网页离线缓存）
check("build_categories: 类别数 = 11", cats.len() == 11)
// ⚠ 顺序契约：前 6 项固定（`--autoclean` 取证模式用历史下标 [0..4] 与 5）；
//   新增类别必须**追加在回收站之后** ⇒ 这里也钉住"第 6 项（下标 5）是回收站"
check("build_categories: 下标 5 仍是回收站（autoclean 下标契约）", cats[5].id == "recyclebin")
bool foundRecycle = false
bool foundTemp = false
bool foundAllNew = true
for cats to c {
    if c.id == "recyclebin" and c.roots.len() == 0 { foundRecycle = true }
    if c.id == "temp" and c.roots.len() >= 1 { foundTemp = true }
}
for ["crashdump", "editorcache", "chatcache", "devcache", "swcache"] to need {
    bool hit = false
    for cats to c {
        if c.id == need { hit = true }
    }
    if not hit { foundAllNew = false }
}
check("build_categories: 有回收站(空根)", foundRecycle)
check("build_categories: 有临时目录(至少1根)", foundTemp)
check("build_categories: 5 个新增类别都在", foundAllNew)
// 新增的 5 类必须带提示（UI 行悬停用 ✓；老类别可留空 ✓）
bool newHint = true
for ["crashdump", "editorcache", "chatcache", "devcache", "swcache"] to need {
    for cats to c {
        if c.id == need and c.hint == "" { newHint = false }
    }
}
check("build_categories: 新增类别都带 hint", newHint)
// 根必须真实存在
bool allExist = true
for cats to c {
    for c.roots to rt {
        if not dirs.exists(rt) { allExist = false }
    }
}
check("build_categories: 所有登记根均存在", allExist)

// ==================== 7. 线程通道冒烟（try_send 不炸） ====================
import threads
Channel ch = threads.channel(16)
var r3 = rules.scan_worker([base], "", ch, 0)
ch.close()
check("通道: 扫描正常返回", _int(r3[1]) == 0)   // base 已被 5b 清空 ⇒ 0 单元

// ==================== 8. 删除进度通道（逐项 [attempted, cleaned, freed]） ====================
files.write(base + "\\p1.txt", "0123456789")
files.write(base + "\\p2.txt", "0123456789")
files.write(base + "\\p3.txt", "0123456789")
Array[Array[string]] chunk2 = [[base + "\\p1.txt", "10"], [base + "\\p2.txt", "10"], [base + "\\p3.txt", "10"]]
Channel ch2 = threads.channel(64)
var rd3 = rules.delete_worker(chunk2, [base], ch2)
eq("进度: 消息数 = 单元数", _int(ch2.len()), 3)
eq("进度: cleaned", _int(rd3[0]), 3)
eq("进度: freed", _int(rd3[2]), 30)
ch2.close()

// ==================== 9. top_items（明细清单"取最大 N 项"，纯逻辑 ✓） ====================
// 为什么能在这里测：top_items 放在 cleaner_rules.leno（不 import SDL3）⇒ 可直接单测 ✓
// res 布局：[size, cnt, skip, 路径, 大小, 路径, 大小, ...]
Array[string] fake = ["60", "4", "0",
    "c:\\a\\small.tmp", "5",
    "c:\\a\\big.bin", "30",
    "c:\\a\\mid.dat", "20",
    "c:\\a\\tiny.tmp", "1"]
var ti = rules.top_items(fake, 3)
eq("top_items: 条数 = limit", ti.len(), 3)
check("top_items: 第 1 大 = big.bin(30)", ti[0].path == "c:\\a\\big.bin" and ti[0].size == 30)
check("top_items: 第 2 大 = mid.dat(20)", ti[1].path == "c:\\a\\mid.dat" and ti[1].size == 20)
check("top_items: 第 3 大 = small.tmp(5)", ti[2].path == "c:\\a\\small.tmp" and ti[2].size == 5)
// 最小的 tiny.tmp(1) 必须被淘汰（否则"取最大"是假的 ✗）
bool hasTiny = false
for ti to it { if it.path == "c:\\a\\tiny.tmp" { hasTiny = true } }
check("top_items: 最小项被淘汰", not hasTiny)

// limit ≥ 项数 ⇒ 全给，且**仍按降序**
var ti2 = rules.top_items(fake, 10)
eq("top_items: limit > n ⇒ 全给", ti2.len(), 4)
check("top_items: 全给时仍降序", ti2[0].size == 30 and ti2[3].size == 1)

// limit = 0 ⇒ 空（不越界 ✗）
eq("top_items: limit=0 ⇒ 空", rules.top_items(fake, 0).len(), 0)

// 只有头三项（无明细）/ 空结果 ⇒ 不崩
Array[string] emptyRes = ["0", "0", "0"]
eq("top_items: 空结果 ⇒ 空", rules.top_items(emptyRes, 5).len(), 0)

// 同大小两项：都要收进来（不能因为相等就丢项 ✗）
Array[string] same = ["20", "2", "0", "p1", "10", "p2", "10"]
eq("top_items: 同大小两项都收", rules.top_items(same, 2).len(), 2)

// ==================== 收尾 ====================
dirs.delete(base)
print("")
if fails > 0 {
    print($"共 {fails} 项失败")
    _exit(1)
}
print("全部通过")
