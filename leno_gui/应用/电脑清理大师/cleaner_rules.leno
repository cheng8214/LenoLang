// cleaner_rules.leno — 电脑清理大师：清理类别定义 + 扫描/删除 worker
// 纯逻辑模块：不 import SDL3 ⇒ 可被 test\test_rules.leno 直接单测 ✓
//
// 删除安全红线（三道）：
//   1. 扫描根只在 build_categories 里解析，且逐个 dirs.exists 过滤
//   2. 整层清理模式的「单元」= 根目录的**直接子项**——不会碰根外的任何东西
//      前缀过滤模式只收**匹配前缀的文件**，绝不收目录（防误删 Explorer 整目录）
//   3. delete_worker 逐路径做 starts_with(roots) 白名单校验，不匹配即计 failed
// 全部 worker 为具名全局函数（threads.start 硬性要求，闭包会被 GC ✗）
import dirs
import strings
import threads
import files
// ⚠ **刻意不 import cleaner_whitelist**（2026-09-28 踩坑记录）：
//   worker 线程里"首次使用一个**尚未初始化**的模块"会直接抛错 ✗
//   （症状：join() 只得到 `Thread error: unknown error`，连长什么样都不知道，
//     且**进入函数体之前**就失败 ⇒ try/catch 也抓不到 ✗）
//   旧代码之所以没事：主线程先调过本模块的 scan_worker ⇒ 本模块已初始化 ✓；
//   一旦本模块新增对别的模块的依赖，那个依赖会在**线程里**才首次初始化 ⇒ 炸 ✓
//   ⇒ 结论：**worker 要用的一切（含保留清单匹配）都必须落在本模块内**（纯函数 ✓ 无状态 ✓）

// ==================== 数据结构 ====================
export struct CleanCategory {
    string id = ""
    string name = ""
    Array[string] roots = []    // 扫描根列表（构建时解析环境变量 + 存在性过滤）
    string file_prefix = ""     // 非空 ⇒ 只收该前缀的文件（如 thumbcache_）；空 ⇒ 整层清理
    string hint = ""            // 行悬停提示（讲清这类的性质/技巧）；纯 UI 用 ⇒ 不跨线程 ✓
}

// 每类别清理单元上限（正常垃圾远达不到；超出部分只计数不删）
const int MAX_UNITS = 20000

// scan_worker 返回的**头部字段数**：`[size, cnt, skip, kept, 然后成对 (路径, 大小)...]`
//   ⚠ 调用点**别写死 3** —— 2026-09-28 加 `kept`（保留清单计数）时，正是靠这个常量
//     把 `top_items` 与主界面的 `beginClean` 一次改齐 ✓（否则两处各写一份必然漂 ✗）
export const int SCAN_HDR = 4

// ==================== ② 预览·干跑：只算"将会发生什么"（纯逻辑 ⇒ 可单测 ✓）====================
// 为什么要有它：清理**不可撤销** ✗ ⇒ 点「一键清理」之前，用户该先看到一张账单：
//   本次将清理 N 项 / 释放 X / 其中 M 项会被跳过（占用）/ K 项被保留清单豁免 ✓
// ⚠ 本段**只读**已有扫描结果 ⇒ 不碰磁盘、不删除 ✓（"干跑"的本质 ✓）
//   唯一的碰盘动作在 alive_top（只 stat ✓，纯读 ✓）—— 用来指出"扫描之后文件还都在吗" ✓
export struct PreviewRow {
    int idx = -1         // 类别下标（主界面用它回查 results ⇒ 抽查存活 ✓）
    string name = ""     // 类别名（展示用 ✓）
    int cnt = 0          // 将清理项数
    int bytes = 0        // 将释放字节
    int skip = 0         // 将跳过（被占用 / 探测失败）
    int kept = 0         // 保留清单豁免（有意不删 ✓）
}

export struct PreviewSummary {
    int catCount = 0     // 参与预览的类别数
    int cnt = 0
    int bytes = 0
    int skip = 0
    int kept = 0
    Array[PreviewRow] rows = []
}

// 依据**已有扫描结果**汇总（cats/results 与主界面同源；checked = 用户勾选的类别下标 ✓）
//   回收站不参与（由系统托管 ⇒ 不在这里替系统编数字 ✗，主界面自己会提示 ✓）
export func build_preview(Array[CleanCategory] cats, Array[Array[string]] results, Array[int] checked): PreviewSummary {
    var out = new PreviewSummary()
    for checked to i {
        if i < 0 or i >= cats.len() { continue }
        if cats[i].id == "recyclebin" { continue }
        if i >= results.len() { continue }
        var res = results[i]
        if res.len() < SCAN_HDR { continue }     // 没扫到 ⇒ 不编数字（不写死 4 ✓）
        var one = new PreviewRow(
            idx = i,
            name = cats[i].name,
            cnt = _int(res[1]),
            bytes = _int(res[0]),
            skip = _int(res[2]),
            kept = _int(res[3])
        )
        out.rows.add(one)
        out.catCount = out.catCount + 1
        out.cnt = out.cnt + one.cnt
        out.bytes = out.bytes + one.bytes
        out.skip = out.skip + one.skip
        out.kept = out.kept + one.kept
    }
    return out
}

// 「文件还在不在」抽查：对该类别明细里**最大的 limit 项**逐个 stat，返回仍存在的项数 ✓
//   （从扫描到清理之间，文件可能已被系统清掉 / 被别的程序挪走 ⇒ 这个数能提示"情况变了" ✓）
//   ⚠ 依然是**纯读**：只 stat，绝不删除 ✓ —— 也是"干跑没动磁盘"的直接证据 ✓
//   为什么要 limit：明细最多 MAX_UNITS 对（2 万 ✓）⇒ 全量 stat 会明显卡顿 ✗；
//     取最大的 limit 项已足够代表变化（主界面用 200 ✓）
export func alive_top(Array[string] res, int limit): int {
    if res.len() < SCAN_HDR or limit <= 0 { return 0 }
    var picked = top_items(res, limit)
    int n = 0
    for picked to it {
        try {
            var di = dirs.stat(it.path)
            if di.exists { n = n + 1 }
        } catch e {
            continue        // stat 不到（已消失 / 无权限）⇒ 这一项不算"存活" ✓（不静默吞 ✗）
        }
    }
    return n
}

// ==================== 明细清单：取"最大的 N 项"（纯逻辑 ⇒ 可单测 ✓） ====================
// 为什么放**本文件**而不是 UI 模块：这里不 import SDL3（见文件头）⇒ 这段能被
//   test\test_rules.leno 直接单测 ✓；UI 只管把结果画出来（cleaner_detail.leno ✓）
export struct DetailItem {
    string path = ""
    int size = 0
}

// 从 scan_worker 的返回里挑出**最大的 limit 项**，按大小**降序**返回。
//   res 布局：`[size, cnt, skip, 路径, 大小, 路径, 大小, ...]`（路径在 j，大小在 j+1 ✓）
//   算法：维持"当前最小项"做插入淘汰（O(n·limit)，limit ≤ 100 ⇒ 够快 ✓，
//         且不必把上万元素全拷出来排序 ✓）
export func top_items(Array[string] res, int limit): Array[DetailItem] {
    Array[DetailItem] picked = []
    if limit <= 0 { return picked }
    int j = SCAN_HDR     // 成对明细从头部字段之后开始 ✓（不写死 3 ✓）
    while j + 1 < res.len() {
        int sz = _int(res[j + 1])
        if picked.len() < limit {
            picked.add(new DetailItem(path = res[j], size = sz))
        } else {
            int mn = 0
            int k = 1
            while k < picked.len() {
                if picked[k].size < picked[mn].size { mn = k }
                k = k + 1
            }
            if sz > picked[mn].size { picked[mn] = new DetailItem(path = res[j], size = sz) }
        }
        j = j + 2
    }
    // 内部按大小降序（limit ≤ 100 ⇒ 冒泡足够 ✓）
    int a = 0
    while a + 1 < picked.len() {
        int b = a + 1
        while b < picked.len() {
            if picked[b].size > picked[a].size {
                DetailItem t = picked[a]
                picked[a] = picked[b]
                picked[b] = t
            }
            b = b + 1
        }
        a = a + 1
    }
    return picked
}

// ==================== 小工具 ====================
func _in_list(Array[string] list, string s): bool {
    for list to it {
        if it == s { return true }
    }
    return false
}

func _add_roots(Array[string] out, Array[string] cand) {
    for cand to c {
        if c != "" and dirs.exists(c) and not _in_list(out, c) { out.add(c) }
    }
}

// 递归目录大小（stat 逐文件；无权限子树静默跳过）
func _dir_size(string p): int {
    int sum = 0
    for dirs.walk(p) to e {
        for e.files to f {
            try {
                sum = sum + dirs.stat(dirs.join(e.root, f)).size
            } catch e { continue }   // 无权限/被占用 ⇒ 跳过该文件，继续统计下一个 ✓
        }
    }
    return sum
}

// 字节数 → 人类可读（"1.2 GB"）
export func fmt_size(int b): string {
    float f = _float(b)
    if f >= 1073741824.0 { return $"{_round1(f / 1073741824.0)} GB" }
    if f >= 1048576.0 { return $"{_round1(f / 1048576.0)} MB" }
    if f >= 1024.0 { return $"{_round1(f / 1024.0)} KB" }
    return $"{b} B"
}

func _round1(float v): string {
    int whole = _int(v)
    int frac = _int((v - _float(whole)) * 10.0 + 0.5)
    if frac >= 10 { whole = whole + 1; frac = 0 }
    return $"{whole}.{frac}"
}

// ==================== 浏览器缓存根探测 ====================
// profile 名不定（Default / Profile 1 / ...）⇒ listdir 枚举；缓存子目录形态：
//   <profile>\Cache\Cache_Data（新版）或 <profile>\Cache（旧版，二选一防重复计数）
//   <profile>\Code Cache、<profile>\GPUCache
func _browser_cache_roots(string userData): Array[string] {
    Array[string] out = []
    if userData == "" or not dirs.exists(userData) { return out }
    for dirs.listdir(userData) to prof {
        string pdir = dirs.join(userData, prof)
        if not dirs.is_dir(pdir) { continue }
        string cacheData = dirs.join(pdir, "Cache\\Cache_Data")
        string cachePlain = dirs.join(pdir, "Cache")
        if dirs.exists(cacheData) { out.add(cacheData) }
        if not dirs.exists(cacheData) and dirs.exists(cachePlain) { out.add(cachePlain) }
        string codeCache = dirs.join(pdir, "Code Cache")
        if dirs.exists(codeCache) { out.add(codeCache) }
        string gpuCache = dirs.join(pdir, "GPUCache")
        if dirs.exists(gpuCache) { out.add(gpuCache) }
    }
    return out
}

// ==================== 浏览器 Service Worker / 网页离线缓存 ====================
// 现代网页缓存的大头（PWA / 站点离线资源）；与上面的 Cache 目录不同，独立成类 ⇒ 可单独勾选 ✓
func _browser_sw_roots(string userData): Array[string] {
    Array[string] out = []
    if userData == "" or not dirs.exists(userData) { return out }
    for dirs.listdir(userData) to prof {
        string pdir = dirs.join(userData, prof)
        if not dirs.is_dir(pdir) { continue }
        _add_roots(out, [dirs.join(pdir, "Service Worker\\CacheStorage"),
                         dirs.join(pdir, "Service Worker\\ScriptCache")])
    }
    return out
}

// ==================== 应用缓存根探测（通用：给根 + 一组子目录名） ====================
func _add_app_cache(Array[string] out, string root, Array[string] subs) {
    if root == "" or not dirs.exists(root) { return }
    for subs to s {
        _add_roots(out, [dirs.join(root, s)])
    }
}

// 编辑器缓存：VS Code 系（APPDATA 下的产品目录名各不同 ⇒ 逐个试 ✓）
func _editor_cache_roots(string appdata): Array[string] {
    Array[string] out = []
    if appdata == "" { return out }
    Array[string] names = ["Code", "Cursor", "VSCodium", "Windsurf", "Trae"]
    Array[string] subs = ["Cache", "CachedData", "Code Cache", "GPUCache"]
    for names to n {
        _add_app_cache(out, dirs.join(appdata, n), subs)
    }
    return out
}

// 聊天/协作类应用缓存（只收缓存目录 ⇒ **不碰聊天记录** ✓）
func _chat_cache_roots(string appdata): Array[string] {
    Array[string] out = []
    if appdata == "" { return out }
    Array[string] subs = ["Cache", "Code Cache", "GPUCache"]
    _add_app_cache(out, dirs.join(appdata, "discord"), subs)
    _add_app_cache(out, dirs.join(appdata, "Slack"), subs)
    _add_app_cache(out, dirs.join(appdata, "Microsoft\\Teams"), subs)
    return out
}

// 包管理器 / 构建工具缓存（删后下次安装重新下载，属安全类 ✓）
func _dev_cache_roots(string local, string appdata): Array[string] {
    Array[string] out = []
    if local != "" {
        _add_roots(out, [dirs.join(local, "npm-cache"), dirs.join(local, "pip\\cache"),
                         dirs.join(local, "Yarn\\Cache")])
    }
    if appdata != "" {
        _add_roots(out, [dirs.join(appdata, "npm-cache")])
    }
    return out
}

// ==================== 类别构建 ====================
// ★ 2026-10-01 分平台（跨平台改造）：
//   Windows 表 / Linux 表**各自独立**，但**同 id** ⇒ 应用侧（按 id 查类别、按 id 取图标、
//   `--autoclean` 的 phase 列表）**一行都不用改** ✓
//   ⚠ 本函数只在**主线程**构建期调用（解析环境变量 + 探测目录）；
//     worker（scan/delete）只吃 `roots` 字符串数组 ⇒ 与本函数无关 ✓（见文件头的线程踩坑记录）
export func build_categories(): Array[CleanCategory] {
    return build_categories_for(_os())
}

// ★ 可指定平台构建（**导出仅为单测** ✓）：让 Windows 上也能验 Linux 表的结构 ✓
export func build_categories_for(string osname): Array[CleanCategory] {
    if osname == "windows" { return _build_windows() }
    return _build_linux()
}

// ---------- Windows 表（原样保留 ⇒ 行为零变化 ✓）----------
// 全部用户级目录（_env 解析），无需管理员权限；不存在的不登记
func _build_windows(): Array[CleanCategory] {
    Array[CleanCategory] cats = []
    string local = _env_or("LOCALAPPDATA", "")
    string temp = _env_or("TEMP", "")

    // 1) 系统临时文件（%TEMP% 与 %LOCALAPPDATA%\Temp 通常同目录 ⇒ 去重）
    Array[string] tempRoots = []
    if temp != "" and dirs.exists(temp) { tempRoots.add(temp) }
    if local != "" {
        string lt = dirs.join(local, "Temp")
        if dirs.exists(lt) and not _in_list(tempRoots, lt) { tempRoots.add(lt) }
    }
    cats.add(new CleanCategory(id = "temp", name = "系统临时文件", roots = tempRoots))

    // 2) 浏览器缓存（Chrome / Edge）
    Array[string] broots = []
    if local != "" {
        _add_roots(broots, _browser_cache_roots(dirs.join(local, "Google\\Chrome\\User Data")))
        _add_roots(broots, _browser_cache_roots(dirs.join(local, "Microsoft\\Edge\\User Data")))
    }
    cats.add(new CleanCategory(id = "browser", name = "浏览器缓存", roots = broots))

    // 3) Windows 错误报告
    Array[string] werRoots = []
    if local != "" {
        string wer = dirs.join(local, "Microsoft\\Windows\\WER")
        _add_roots(werRoots, [dirs.join(wer, "ReportQueue"), dirs.join(wer, "ReportArchive")])
    }
    cats.add(new CleanCategory(id = "wer", name = "错误报告", roots = werRoots))

    // 4) DirectX 着色器缓存
    Array[string] d3dRoots = []
    if local != "" {
        _add_roots(d3dRoots, [dirs.join(local, "D3DSCache")])
    }
    cats.add(new CleanCategory(id = "d3d", name = "着色器缓存", roots = d3dRoots))

    // 5) 缩略图缓存（只认 thumbcache_ 前缀文件；被 Explorer 占用 ⇒ 删除时计 skipped）
    Array[string] thumbRoots = []
    if local != "" {
        _add_roots(thumbRoots, [dirs.join(local, "Microsoft\\Windows\\Explorer")])
    }
    cats.add(new CleanCategory(id = "thumbs", name = "缩略图缓存", roots = thumbRoots, file_prefix = "thumbcache_"))

    // 6) 回收站（特殊类别：roots 为空 ⇒ UI 侧走 Win32.emptyRecycleBin）
    cats.add(new CleanCategory(id = "recyclebin", name = "回收站"))

    // ==================== 以下为「更多类别」（全部 user-level ⇒ 无需管理员 ✓） ====================
    // ⚠ 一律**追加在回收站之后**：`--autoclean` 取证模式用的是历史下标
    //   （phase1 = [cats.len()-1, 5] / phase2 = [0..4]）⇒ 不能插到前面去 ✓

    // 7) 崩溃转储（程序崩溃时写的 dump；可安全清理）
    Array[string] dumpRoots = []
    if local != "" { _add_roots(dumpRoots, [dirs.join(local, "CrashDumps")]) }
    cats.add(new CleanCategory(id = "crashdump", name = "崩溃转储", roots = dumpRoots,
        hint = "程序崩溃时写的转储文件（可安全删除）"))

    // 8) 编辑器缓存（VS Code / Cursor / VSCodium / Windsurf / Trae）
    string appdata = _env_or("APPDATA", "")
    Array[string] edRoots = []
    _add_roots(edRoots, _editor_cache_roots(appdata))
    cats.add(new CleanCategory(id = "editorcache", name = "编辑器缓存", roots = edRoots,
        hint = "代码编辑器的索引/渲染缓存，删后会自动重建"))

    // 9) 聊天工具缓存（Discord / Slack / Teams；只收缓存目录，**不碰聊天记录**）
    Array[string] chatRoots = []
    _add_roots(chatRoots, _chat_cache_roots(appdata))
    cats.add(new CleanCategory(id = "chatcache", name = "聊天缓存", roots = chatRoots,
        hint = "聊天图片/表情的本地缓存（不会删聊天记录）"))

    // 10) 包管理器缓存（npm / pip / yarn）
    Array[string] devRoots = []
    _add_roots(devRoots, _dev_cache_roots(local, appdata))
    cats.add(new CleanCategory(id = "devcache", name = "包管理器缓存", roots = devRoots,
        hint = "npm/pip/yarn 下载缓存；删后下次安装需重新下载（不影响已装的包）"))

    // 11) 浏览器网页离线缓存（Service Worker / CacheStorage）
    Array[string] swRoots = []
    if local != "" {
        _add_roots(swRoots, _browser_sw_roots(dirs.join(local, "Google\\Chrome\\User Data")))
        _add_roots(swRoots, _browser_sw_roots(dirs.join(local, "Microsoft\\Edge\\User Data")))
    }
    cats.add(new CleanCategory(id = "swcache", name = "网页离线缓存", roots = swRoots,
        hint = "浏览器 Service Worker / 网页离线缓存（关掉浏览器后能清更多）"))

    return cats
}

// ==================== Linux 表（★ 2026-10-01 新增）====================
// 全部是 `$HOME` 下的**用户级**目录（XDG 规范）⇒ 与 Windows 表同一安全模型：不需要 root ✓
// 与 Windows 表的三处差异（都选"照实"，绝不编造假路径 ✗）：
//   · 错误报告（wer）/ 崩溃转储（crashdump）：Linux 没有 WER，core dump 在 /var/crash（需 root）
//     ⇒ 这两类**留空**（界面上就是 0 项，并给出 hint 说明为什么 ✓）
//   · 着色器缓存（d3d）：换成 Mesa / NVIDIA 的 shader cache ✓
//   · 缩略图（thumbs）：`~/.cache/thumbnails` 是**专用目录** ⇒ 不需要 `thumbcache_` 前缀过滤 ✓
func _build_linux(): Array[CleanCategory] {
    Array[CleanCategory] cats = []
    string home = _env_or("HOME", "")
    string cache = _xdg_dir("XDG_CACHE_HOME", ".cache")
    string cfg = _xdg_dir("XDG_CONFIG_HOME", ".config")

    // 1) 系统临时文件：$TMPDIR（默认 /tmp）+ /var/tmp
    Array[string] tempRoots = []
    _add_roots(tempRoots, [_env_or("TMPDIR", "/tmp"), "/var/tmp"])
    cats.add(new CleanCategory(id = "temp", name = "系统临时文件", roots = tempRoots))

    // 2) 浏览器缓存（Chromium 系 + Firefox）
    cats.add(new CleanCategory(id = "browser", name = "浏览器缓存",
        roots = linux_browser_roots(cache)))

    // 3) 错误报告：本平台无此类别（留空 ⇒ 不编造 ✓）
    cats.add(new CleanCategory(id = "wer", name = "错误报告",
        hint = "本平台没有 Windows 错误报告（WER）⇒ 该类别恒为空"))

    // 4) 着色器缓存：Mesa / NVIDIA
    Array[string] shRoots = []
    if cache != "" {
        _add_roots(shRoots, [dirs.join(cache, "mesa_shader_cache"),
                             dirs.join(cache, "mesa_shader_cache_db")])
    }
    if home != "" { _add_roots(shRoots, [dirs.join(dirs.join(home, ".nv"), "GLCache")]) }
    cats.add(new CleanCategory(id = "d3d", name = "着色器缓存", roots = shRoots,
        hint = "显卡着色器编译缓存；删后下次启动会自动重建（首帧可能略慢）"))

    // 5) 缩略图缓存（专用目录 ⇒ 整层清理 ✓ 文件管理器会自己重建）
    Array[string] thumbRoots = []
    if cache != "" { _add_roots(thumbRoots, [dirs.join(cache, "thumbnails")]) }
    if home != "" { _add_roots(thumbRoots, [dirs.join(home, ".thumbnails")]) }
    cats.add(new CleanCategory(id = "thumbs", name = "缩略图缓存", roots = thumbRoots,
        hint = "文件管理器的缩略图缓存（会自动重建）"))

    // 6) 回收站（与 Windows 同语义：roots 为空 ⇒ UI 侧走 Sys.emptyTrash ✓）
    cats.add(new CleanCategory(id = "recyclebin", name = "回收站"))

    // ==================== 以下为「更多类别」（一律追加在回收站之后 ✓）====================

    // 7) 崩溃转储：系统 core dump 需要 root ⇒ 留空（不列假路径 ✓）
    cats.add(new CleanCategory(id = "crashdump", name = "崩溃转储",
        hint = "系统 core dump 位于 /var/crash（需管理员权限）⇒ 本平台不处理"))

    // 8) 编辑器缓存（VS Code / Cursor / VSCodium / Windsurf / Trae）
    Array[string] edRoots = []
    if cfg != "" {
        _add_roots(edRoots, linux_app_caches(cfg,
            ["Code", "Cursor", "VSCodium", "Windsurf", "Trae"]))
    }
    cats.add(new CleanCategory(id = "editorcache", name = "编辑器缓存", roots = edRoots,
        hint = "代码编辑器的索引/渲染缓存，删后会自动重建"))

    // 9) 聊天工具缓存（Discord / Slack；只收缓存目录，**不碰聊天记录** ✓）
    Array[string] chatRoots = []
    if cfg != "" { _add_roots(chatRoots, linux_app_caches(cfg, ["discord", "Slack"])) }
    if cache != "" { _add_roots(chatRoots, linux_app_caches(cache, ["discord", "slack"])) }
    cats.add(new CleanCategory(id = "chatcache", name = "聊天缓存", roots = chatRoots,
        hint = "聊天图片/表情的本地缓存（不会删聊天记录）"))

    // 10) 包管理器缓存（npm / pip / yarn / uv / cargo）
    Array[string] devRoots = []
    if home != "" {
        _add_roots(devRoots, [dirs.join(dirs.join(home, ".npm"), "_cacache"),
                              dirs.join(dirs.join(dirs.join(home, ".cargo"), "registry"), "cache")])
    }
    if cache != "" {
        _add_roots(devRoots, [dirs.join(cache, "pip"), dirs.join(cache, "yarn"),
                              dirs.join(cache, "uv"), dirs.join(cache, "go-build")])
    }
    cats.add(new CleanCategory(id = "devcache", name = "包管理器缓存", roots = devRoots,
        hint = "npm/pip/yarn/cargo 下载缓存；删后下次安装需重新下载（不影响已装的包）"))

    // 11) 浏览器 Service Worker / 网页离线缓存
    cats.add(new CleanCategory(id = "swcache", name = "网页离线缓存",
        roots = linux_sw_roots(cache),
        hint = "浏览器 Service Worker / 网页离线缓存（关掉浏览器后能清更多）"))

    return cats
}

// XDG 目录：环境变量优先；为空则 `$HOME/<默认相对路径>` ✓
func _xdg_dir(string envName, string defRel): string {
    string v = _env_or(envName, "")
    if v != "" { return v }
    string home = _env_or("HOME", "")
    if home == "" { return "" }
    return dirs.join(home, defRel)
}

// 一组产品目录下的缓存子目录：`<base>/<产品>/{Cache,Code Cache,GPUCache,CachedData}` ✓
export func linux_app_caches(string base, Array[string] products): Array[string] {
    Array[string] out = []
    if base == "" { return out }
    Array[string] subs = ["Cache", "Code Cache", "GPUCache", "CachedData"]
    for products to n {
        string root = dirs.join(base, n)
        if not dirs.exists(root) { continue }
        for subs to s { _add_roots(out, [dirs.join(root, s)]) }
    }
    return out
}

// 一个"浏览器官 / profile"目录下的缓存子目录
//   判据与 Windows 侧一致：新版在 `Cache/Cache_Data`，旧版是 `Cache`（二选一，防重复计数 ✓）
//   ⚠ 逐段拼**只是风格**（分隔符统一、好读 ✓）：实测 `dirs.join(x, "a/b")` 与 `"a\\b"` 都能被解析
//     （Windows 侧 `dirs.exists` 同样成立 ✓）⇒ 这里逐段拼纯粹不想在路径里混两套分隔符 ✓
//     （我一度把别处的漏检归因到"内嵌分隔符"上 ✗ —— 真正原因是下钻层数不够，见 _linux_descend ✓）
export func linux_prof_caches(string pdir): Array[string] {
    Array[string] out = []
    string cacheData = dirs.join(dirs.join(pdir, "Cache"), "Cache_Data")
    string cachePlain = dirs.join(pdir, "Cache")
    if dirs.exists(cacheData) { out.add(cacheData) }
    eif dirs.exists(cachePlain) { out.add(cachePlain) }
    _add_roots(out, [dirs.join(pdir, "Code Cache"), dirs.join(pdir, "GPUCache")])
    return out
}

// 各发行版里浏览器的 cache 目录名（同一个浏览器在不同包装下名字不同 ⇒ 都列上 ✓）
func _linux_browser_products(): Array[string] {
    return ["google-chrome", "google-chrome-beta", "chromium", "chromium-browser",
            "microsoft-edge", "BraveSoftware", "vivaldi", "opera"]
}

// 在 base 下**逐层下钻找 profile**，直到某层命中缓存目录就停：
//   `<cache>/google-chrome/Cache`                     ← base 本身即 profile（1 层 ✓）
//   `<cache>/chromium/Profile 1/Cache`                ← 2 层 ✓
//   `<cache>/BraveSoftware/Brave-Browser/Default/…`   ← 3 层 ✓（Brave 真的这么深 ✓ 实测踩过）
//   ⚠ 「命中即停」是**性能考量**：真实 profile 里有上万个条目（IndexedDB / Local Storage …）
//     ⇒ 无脑深挖会很慢 ✗；而命中之后就没必要再往里找了 ✓
//   ⚠ 深度上限 4：防万一出现环形符号链接之类把目录扫爆 ✓
func _linux_descend(Array[string] out, string dir, int depth, bool swMode) {
    if depth > 4 { return }
    int before = out.len()
    if swMode {
        _add_roots(out, [dirs.join(dirs.join(dir, "Service Worker"), "CacheStorage"),
                         dirs.join(dirs.join(dir, "Service Worker"), "ScriptCache")])
    } else {
        _add_roots(out, linux_prof_caches(dir))
    }
    // 本层已命中 ⇒ 不再下钻（见上 ✓）
    if out.len() > before and depth > 0 { return }
    try {
        for dirs.listdir(dir) to sub {
            string p = dirs.join(dir, sub)
            if dirs.is_dir(p) { _linux_descend(out, p, depth + 1, swMode) }
        }
    } catch e { return }
}

// 浏览器缓存根：Chromium 系（逐层下钻找 profile ✓）+ Firefox（`…/<profile>/cache2` ✓）
export func linux_browser_roots(string cache): Array[string] {
    Array[string] out = []
    if cache == "" { return out }
    var products = _linux_browser_products()
    for products to prod {
        string base = dirs.join(cache, prod)
        if dirs.exists(base) { _linux_descend(out, base, 0, false) }
    }
    // Firefox：`<cache>/mozilla/firefox/<profile>/cache2`（该目录本身就是缓存 ⇒ 整层 ✓）
    //   ⚠ 跳过 `.parentlock`/`.` 开头的条目 ✓
    string ff = dirs.join(dirs.join(cache, "mozilla"), "firefox")
    if dirs.exists(ff) {
        try {
            for dirs.listdir(ff) to prof {
                if strings.starts_with(prof, ".") { continue }
                _add_roots(out, [dirs.join(dirs.join(ff, prof), "cache2")])
            }
        } catch e { return out }
    }
    return out
}

// Service Worker / 网页离线缓存（Chromium 系 `<profile>/Service Worker/{CacheStorage,ScriptCache}` ✓）
export func linux_sw_roots(string cache): Array[string] {
    Array[string] out = []
    if cache == "" { return out }
    var products = _linux_browser_products()
    for products to prod {
        string base = dirs.join(cache, prod)
        if dirs.exists(base) { _linux_descend(out, base, 0, true) }
    }
    return out
}

// ==================== 类别图标（文件名 → 用户放在 images\ 的资源 ✓）====================
// ⚠ 这些是**用户的资源**（iconfont 下载 ✓）⇒ 本模块只**读名字**、绝不写/改文件 ✗
//   返回 "" ⇒ 该类别暂时没有图标（界面按"无图标"处理 ✓ —— 宁可不画也不猜 ✗）
// 2026-09-29：按用户实际放置的文件名映射 ✓（含两个不太规整的名字，见注释 ✓）
export func icon_of(string id): string {
    // 图标文件名 = **类别 id + ".png"** ✓（2026-09-29 按用户要求，把中文名统一改成英文 ✓）
    //   ⇒ 以后新增类别只要往 images\ 放一张 `id.png` 就行 ✓，**不用改代码** ✓
    //   ⚠ 是否存在由调用方检查（应用层 files.exists ✓）—— 本模块保持"纯名字映射" ✓ 不做文件 IO ✓
    return id + ".png"
}

// ==================== 保留清单匹配（**放本模块内** —— 见文件头的踩坑记录 ✓） ====================
// 与 cleaner_whitelist.norm 同一语义（大小写不敏感 / `\` 与 `/` 等价 / 去尾斜杠 ✓）
export func norm_path(string p): string {
    string s = strings.replace(p, "/", "\\")
    s = strings.to_lower(s)
    s = strings.trim(s)
    while s.len() > 2 and strings.ends_with(s, "\\") {
        s = strings.slice(s, 0, (s.len() - 1) - 1)
    }
    if s.len() == 3 and strings.ends_with(s, "\\") { s = strings.slice(s, 0, 1) }
    return s
}

// 用**编码后**的保留清单判定（纯函数 ✓ 无模块状态 ⇒ worker 可安全调用 ✓）
//   编码格式：`"1|路径"` = 目录规则（含整棵子树）；`"0|路径"` = 单文件规则 ✓
//   ⚠ folder 规则必须比"前缀 + 分隔符"⇒ `c:\temp2` 不会被 `c:\temp` 命中 ✓
export func match_encoded(Array[string] enc, string p): bool {
    int n = enc.len()
    if n == 0 { return false }
    string t = norm_path(p)
    if t == "" { return false }
    for enc to e {
        int sep = strings.find(e, "|")
        if sep < 0 { continue }
        string tag = strings.slice(e, 0, sep - 1)
        string rp = strings.slice(e, sep + 1, e.len())
        if rp == "" { continue }
        if tag == "1" {
            if t == rp { return true }
            if strings.starts_with(t, rp + "\\") { return true }
        } else {
            if t == rp { return true }
        }
    }
    return false
}

// 保留清单判定（**带兜底** —— worker 的设计契约是"全部 try/catch ⇒ 线程永不进 error 态" ✓）
//   ① 清单为空（绝大多数情况）⇒ 直通返回 false，**不做任何字符串处理**（快 ✓ 且与旧路径逐字等价 ✓）
//   ② 解析/匹配抛错 ⇒ **保守当作"被保留"**（宁可不删 ✓ —— 白名单的失败方向必须偏安全 ✗ 不能反过来）
func _wl_kept(Array[string] wlEnc, string p): bool {
    if wlEnc.len() == 0 { return false }
    try {
        return match_encoded(wlEnc, p)
    } catch e {
        _plog("  whitelist check failed (" + _str(e.msg) + ") path=" + p)
        return true
    }
}

// ==================== 扫描 worker ====================
// 扫描一个类别。返回 [sizeStr, cntStr, skipStr, keptStr, 路径1, 大小1, 路径2, 大小2, ...]
//   skip = stat 失败/无权限（跳过 ✓）
//   kept = 命中**保留清单**（有意不收 ⇒ 用户可据此确认清单真的生效了 ✓）
//   成对明细从下标 `SCAN_HDR` 开始 ✓
// （单元大小供 delete_worker 免二次 stat 统计释放量 ✓）
// 参数用纯数组/字符串——**struct 实例不能跨线程传递** ✗ ⇒ 不收 CleanCategory
// ch 允许 null（单测直调）；进度经 ch.try_send([idx, sizeDelta, cntDelta]) 上报（非阻塞，满了就丢）
// ⚠ `wlEnc` **必须显式传**（不能给默认值 `= []`：本语言要求默认值是编译期常量 ✗ 实测报错）
//   它是保留清单的**编码快照**（纯字符串数组 ⇒ 可安全跨线程 ✓，见 cleaner_whitelist.encode ✓）
export func scan_worker(Array[string] roots, string file_prefix, any ch, int idx, Array[string] wlEnc): Array[string] {
    int totalSize = 0
    int totalCnt = 0
    int skipped = 0
    int kept = 0                        // ★ 命中保留清单的单元数（有意跳过 ⇒ 与 skip 分开计 ✓）
    Array[string] units = []
    Array[string] unitSizes = []

    for roots to root {
        if file_prefix != "" {
            // ---- 前缀白名单模式：递归收集匹配文件，绝不收目录 ----
            for dirs.walk(root) to e {
                for e.files to f {
                    if not strings.starts_with(f, file_prefix) { continue }
                    string p = dirs.join(e.root, f)
                    if _wl_kept(wlEnc, p) { kept = kept + 1; continue }   // ★ 保留清单：扫描期就不收 ✓
                    int sz = 0
                    try {
                        var di = dirs.stat(p)
                        if not di.exists { skipped = skipped + 1; continue }
                        sz = di.size
                    } catch {
                        skipped = skipped + 1
                        continue
                    }
                    totalSize = totalSize + sz
                    totalCnt = totalCnt + 1
                    if units.len() < MAX_UNITS {
                        units.add(p)
                        unitSizes.add(_str(sz))
                    }
                    _report(ch, idx, sz, 1)
                }
            }
        } else {
            // ---- 整层清理模式：单元 = 根目录的直接子项（文件/目录），大小递归统计 ----
            for dirs.listdir(root) to child {
                string p = dirs.join(root, child)
                if _wl_kept(wlEnc, p) { kept = kept + 1; continue }      // ★ 保留清单：整层模式同样过滤 ✓
                int sz = 0
                try {
                    var di = dirs.stat(p)
                    if not di.exists {
                        skipped = skipped + 1
                        continue
                    }
                    if di.is_file { sz = di.size } else { sz = _dir_size(p) }
                } catch {
                    skipped = skipped + 1
                    continue
                }
                totalSize = totalSize + sz
                totalCnt = totalCnt + 1
                if units.len() < MAX_UNITS {
                    units.add(p)
                    unitSizes.add(_str(sz))
                }
                _report(ch, idx, sz, 1)
            }
        }
    }

    Array[string] out = [_str(totalSize), _str(totalCnt), _str(skipped), _str(kept)]
    for 0 : units.len() - 1 to i {
        out.add(units[i])
        out.add(unitSizes[i])
    }
    return out
}

func _report(any ch, int idx, int sizeDelta, int cntDelta) {
    if ch is Channel {
        ch.try_send([idx, sizeDelta, cntDelta])
    }
}

// ==================== 删除 worker ====================
// 进度取证日志（与主程序 _dlog 同一文件；并发 open 共享冲突会丢行 ⇒ 仅诊断用）
func _plog(string s) {
    try {
        var f = files.open(dirs.join(_tmpdir(), "cmaster_debug.log"), "a")
        f.writeln(s)
        f.close()
    } catch e { return }    // 日志失败无处可报：有意忽略 ✓
}

// chunk 元素 = [path, sizeStr]（scan_worker 结果切出）；roots = 类别白名单根。
// 只删 starts_with(任一根) 的路径；全部 try/catch ⇒ 线程永不进 error 态。
// 进度：每处理完一项向 ch 发 [attempted增量, cleaned增量, freed增量]（非阻塞，满了就丢）
// 返回 [cleanedStr, failedStr, freedStr]
export func delete_worker(Array[Array[string]] chunk, Array[string] roots, any ch, Array[string] wlEnc): Array[string] {
    int cleaned = 0
    int failed = 0
    int freed = 0
    int kept = 0
    // ★ 整体兜底：worker 的契约是"线程永不进 error 态"✓ ——
    //   一旦有人在这里丢进未捕获异常，`join()` 只会得到 "Thread error: unknown error" ✗
    //   （消息丢失、极难定位）。所以这里既兜底、又把**真实消息**写进调试日志 ✓
    try {
    for chunk to item {
        string p = item[0]
        // ★ 保留清单**兜底**（纵深防御）：扫描期已经过滤过，但清单可能在**清理途中**才被加进来
        //   （或某类别根被改宽）⇒ 删除前再判一次 ✓ 计 kept 而不是 failed（语义不同 ✓）
        if _wl_kept(wlEnc, p) {
            kept = kept + 1
            if ch is Channel { ch.try_send([1, 0, 0]) }
            continue
        }
        bool allowed = false
        for roots to r {
            if strings.starts_with(p, r) { allowed = true }
        }
        if not allowed {
            failed = failed + 1
            if ch is Channel { ch.try_send([1, 0, 0]) }
            continue
        }
        try {
            if dirs.delete(p) {
                cleaned = cleaned + 1
                int sz = _int(item[1])
                freed = freed + sz
                if ch is Channel { ch.try_send([1, 1, sz]) }
                if (cleaned + failed) % 500 == 0 {
                    _plog($"  worker progress {cleaned + failed}/{chunk.len()} freed={freed}")
                }
            } else {
                failed = failed + 1      // 被占用/权限 ⇒ 计失败不中断
                if ch is Channel { ch.try_send([1, 0, 0]) }
            }
        } catch {
            failed = failed + 1
            if ch is Channel { ch.try_send([1, 0, 0]) }
        }
    }
    } catch e {
        _plog("  delete_worker 异常中断: " + _str(e.msg) + " cleaned=" + _str(cleaned) + " failed=" + _str(failed))
    }
    return [_str(cleaned), _str(failed), _str(freed), _str(kept)]
}
