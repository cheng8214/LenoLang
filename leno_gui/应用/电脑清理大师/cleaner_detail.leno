// cleaner_detail.leno — 电脑清理大师：**明细清单**弹窗（从 cleaner_master.leno 拧出来的独立模块 ✓）
//
// 分层（与 Trae签到 的 trae_gui.leno / trae_core.leno 同一路数 ✓）：
//   cleaner_rules.leno     ← **纯逻辑**：类别定义 + 扫描/删除 worker + `top_items`
//                            （不 import SDL3 ⇒ 能被 test\test_rules.leno 直接单测 ✓）
//   cleaner_whitelist.leno ← **纯逻辑**：保留清单（匹配/持久化 ✓，同样不 import SDL3 ✓）
//   cleaner_detail.leno    ← **本文件**：把明细画出来 + 提供"加入保留清单"的入口（SDL3 ✓）
//   cleaner_master.leno    ← 主界面：状态机 + 把点击接过来（调用本模块 ✓）
//
// 输入约定：`res` = 该类别 scan_worker 的返回
//           布局 `[size, cnt, skip, kept, 路径, 大小, 路径, 大小, ...]`（成对明细从 SCAN_HDR 起 ✓）
// ⚠ "这类能不能看明细"（如回收站由系统托管）属于**业务策略** ⇒ 留在主界面判断 ✓，
//    本模块只做"给数据就画" ✓（这样它才可被别处复用/单独改版 ✓）
import "SDL3" as SDL3
import "sdl_theme" as theme
import dirs
import "./cleaner_rules.leno" as rules
import "./cleaner_whitelist.leno" as wl
use SDL3.(Event, Renderer, Table, VBox, Button, Label, Scancode)

// 最多列多少项（按大小取前 N ✓；标题里会写明"只列最大的 N 项"以免误读 ✗）
const int DETAIL_LIMIT = 100

// ==================== 图标路径（本应用统一入口 ✓）====================
// 图标由 `tools/gen_icons.leno` 用 Leno 程序化生成 ⇒ 落在 应用目录\images\ ✓
//   `dirs.res_dir()`：未打包 = 脚本目录；打包后 = 内嵌资源释放目录 ✓（与本仓其它应用同款 ✓）
// ⚠ 菜单项的图标键是 **`image`**（不是 `icon` ✗ —— 传 icon 框架不读，图标永远不出现 ✓ 实测过）
export func icon(string n): string {
    return dirs.join(dirs.res_dir(), "images/" + n)
}

// ==================== 与外部系统打交道的小工具（主界面也复用 ⇒ 导出 ✓）====================
// ⚠ 这些都是**副作用**操作（开资源管理器 / 写剪贴板）⇒ 不能放进 cleaner_rules.leno ✗
//   （那边要保持"纯逻辑、可被 test_rules 单测" ✓），统一收在本模块 ✓

// 「打开到文件目录」：文件 ⇒ 打开所在目录并**选中**它；目录 ⇒ 直接打开
//   一律走 `cmd /c start "" …`（与本仓 `文件管理器` 同款写法 ✓）⇒ 子进程**脱离**本进程，
//   不会把 UI 卡住 ✓（直接同步调 explorer 有可能会一直等到资源管理器退出 ✗）
//   非 Windows 退回 `xdg-open <所在目录>` ✓
export func reveal_in_explorer(string path): bool {
    if path == "" { return false }
    bool isDir = false
    try { isDir = dirs.is_dir(path) } catch { isDir = false }
    string cmd = ""
    if _os() == "linux" {
        string where = path
        if not isDir { where = dirs.dirname(path) }
        if where == "" { return false }
        cmd = "xdg-open \"" + where + "\""
    } else if isDir {
        cmd = "cmd /c start \"\" \"" + path + "\""
    } else {
        cmd = "cmd /c start \"\" explorer /select,\"" + path + "\""
    }
    bool ok = true
    try { _exec(cmd) } catch { ok = false }
    return ok
}

// 文本写入系统剪贴板（走框架 SDL3 API ✓，不依赖 shell ✓）
export func copy_text(string text): bool {
    if text == "" { return false }
    return SDL3.setClipboardText(text)
}

// 该路径是否已在保留清单里（按**归一化路径**比对 ✓ —— RULES 里存的就是归一化值 ✓）
export func in_whitelist(string p): bool {
    string key = wl.norm(p)
    var snap = wl.snapshot()
    for 0 : snap.len() - 1 to i { if snap[i].path == key { return true } }
    return false
}

// 加入保留清单；返回一句给用户看的提示（调用方 set_text 即可 ✓）
//   「保留此路径」按钮与右键菜单的「加入保留清单」**共用这一个实现** ⇒ 不会两处漂移 ✓
export func add_to_whitelist(string p): string {
    if p == "" { return "没有选中路径 ✗" }
    // 目录还是文件：以**文件系统真实类型**为准（比猜后缀可靠 ✓）
    bool isDir = true
    try {
        var di = dirs.stat(p)
        if di.is_file { isDir = false }
    } catch {
        isDir = false        // stat 不到 ⇒ 按文件处理（影响面更小 ✓）
    }
    // ⚠ 弹窗字体没有 `✓`/`✗` 字形（实测渲染成方框 ✗）⇒ 这些文案**只写中文** ✓
    if not wl.add(p, isDir, "用户添加") { return "这个路径已经在保留清单里了" }
    wl.save()
    string kind = "该文件"
    if isDir { kind = "该目录及其全部内容" }
    return $"已加入保留清单：{kind} 以后不再被扫描/清理"
}

// 从保留清单移除；返回是否真的移除了 ✓
//   ⚠ 内置保护项也能被移除（用户有最终决定权 ✓）—— 提示里会照原样写路径 ✓
export func remove_from_whitelist(string p): bool {
    string key = wl.norm(p)
    var snap = wl.snapshot()
    int idx = -1
    for 0 : snap.len() - 1 to i { if snap[i].path == key { idx = i } }
    if idx < 0 { return false }
    if not wl.remove_at(idx) { return false }
    wl.save()
    return true
}

// 弹出某类别的明细清单（模态；阻塞到用户关闭 ✓）
//   catName = 类别显示名（标题/表头用）
//   res     = 该类别的扫描结果数组
// 返回 false ⇒ 数据不足，没什么可展示（调用方可据此写状态栏提示 ✓）
export func show_detail(string catName, Array[string] res): bool {
    if res.len() < rules.SCAN_HDR { return false }
    int totalBytes = _int(res[0])
    int totalCnt = _int(res[1])
    int keptCnt = _int(res[3])
    var picked = rules.top_items(res, DETAIL_LIMIT)

    int dw = 760
    int dh = 540
    var dlg = SDL3.createDialogWindow({title: "明细清单 — " + catName, w: dw, h: dh})
    var droot = SDL3.createVBox({x: 0, y: 0, w: dw, h: dh, padX: 16, padY: 14, spacing: 8})
    dlg.setRoot(droot)

    // 标题写清"共几项 / 多大 / 是否只列了前 N 项"⇒ 不误导成"只有这么多" ✓
    string head = $"{catName}：共 {totalCnt} 项 · {rules.fmt_size(totalBytes)}"
    if picked.len() < totalCnt { head = $"{head}（下面只列最大的 {picked.len()} 项）" }
    if keptCnt > 0 { head = $"{head} · 保留清单已豁免 {keptCnt} 项" }
    droot.add(SDL3.dialogLabel(head, 14), {grow: 0, shrink: 0, align: 0})

    // ⚠ 按钮要在 `dt.on_cell(...)` **之前**创建：回调闭包里会读它（先声明再引用 ✓）
    Button keepBtn = SDL3.createButton({w: 150, h: 34, text: "保留此路径", type: "dark"})
    keepBtn.set_enabled(false)
    keepBtn.set_tip("把选中的路径加入保留清单：以后扫描不再列出、清理也不会删 ✓")
    Button closeBtn = SDL3.createButton({w: 110, h: 34, text: "关闭", type: "dark"})
    Label noteLbl = SDL3.dialogLabel("点一行选中它，再点「保留此路径」即可豁免", 12)

    Table dt = SDL3.createTable({
        headers: ["路径", "大小", "占比"],
        col_widths: [530.0, 110.0, 80.0],
        zebra: true, row_h: 26, header_h: 28, font_size: 13,
        col_reorder: false, resizable: false
    })
    Array[Array[string]] rows = []
    for picked to it {
        string pct = "—"
        if totalBytes > 0 { pct = $"{_int(100.0 * _float(it.size) / _float(totalBytes))}%" }
        rows.add([it.path, rules.fmt_size(it.size), pct])
    }
    dt.set_rows(rows)

    // 选中行（UI 回调写、按钮读 ⇒ 先声明 ✓）
    string selPath = ""
    // 点一行 ⇒ 记下路径并启用"保留此路径"（框架 Table 自带 on_cell 单击回调 ✓）
    dt.on_cell(func(int row, int col) {
        if row >= 0 and row < rows.len() {
            selPath = rows[row][0]
            keepBtn.set_enabled(true)
            noteLbl.set_text("已选中：" + selPath)
            SDL3.markFrameRedraw()
        }
    })
    // ★ 明细清单**也要右键菜单**（2026-09-28 用户要求 ✓）：
    //   行上：在资源管理器中打开 / 复制路径 / 加入 ⇄ 从保留清单移除（**按当前状态切文案** ✓）
    //   空白：复制全部路径（批量取用 ✓）
    //   ⚠ 框架的上下文菜单由 `win.run` 统一登记与绘制 ⇒ **模态弹窗内同样可用** ✓
    //     （登记见 sdl_window.leno:852 ✓、绘制见 :1592 ✓ —— 与主界面同一套机制 ✓）
    dt.on_context_will_open(func(int row) {
        dt.clearContextItems()
        if row < 0 or row >= rows.len() {
            dt.addContextItem({label: "复制全部路径", id: "copyall", image: icon("copy.png")})
            return
        }
        dt.addContextItem({label: "在资源管理器中打开", id: "reveal", image: icon("folder.png")})
        dt.addContextItem({label: "复制路径", id: "copy", image: icon("copy.png")})
        dt.addContextSeparator()
        if in_whitelist(rows[row][0]) {
            dt.addContextItem({label: "从保留清单移除", id: "unkeep", image: icon("uncheck.png")})
        } else {
            dt.addContextItem({label: "加入保留清单", id: "keep", image: icon("check.png")})
        }
    })
    dt.on_context_select(func(int row, string id) {
        if id == "copyall" {
            string all = ""
            for rows to it { all = all + it[0] + "\n" }
            if copy_text(all) { noteLbl.set_text($"{rows.len()} 条路径已复制到剪贴板") }
            else { noteLbl.set_text("复制到剪贴板失败") }
            SDL3.markFrameRedraw()
            return
        }
        if row < 0 or row >= rows.len() { return }
        string p = rows[row][0]
        if id == "reveal" {
            if reveal_in_explorer(p) { noteLbl.set_text("已在资源管理器中打开：" + p) }
            else { noteLbl.set_text("打不开这个路径：" + p) }
        } eif id == "copy" {
            if copy_text(p) { noteLbl.set_text("已复制路径：" + p) }
            else { noteLbl.set_text("复制到剪贴板失败") }
        } eif id == "keep" {
            noteLbl.set_text(add_to_whitelist(p))
        } eif id == "unkeep" {
            if remove_from_whitelist(p) { noteLbl.set_text("已从保留清单移除：" + p) }
            else { noteLbl.set_text("移除失败（可能已不在清单里）") }
        }
        SDL3.markFrameRedraw()
    })

    // 「保留此路径」按钮与右键菜单的「加入保留清单」**共用同一个实现** ✓
    //   （add_to_whitelist 在本文件顶部 ✓ —— 两处各写一份必然漂移 ✗）
    keepBtn.on_click(func() {
        noteLbl.set_text(add_to_whitelist(selPath))
        SDL3.markFrameRedraw()
    })
    droot.add(dt, {grow: 1, shrink: 1, align: 3})
    droot.add(noteLbl, {grow: 0, shrink: 0, align: 0})
    droot.add(SDL3.dialogButtonRow([keepBtn, closeBtn], 16), {grow: 0, shrink: 0, align: 3})

    var done = false
    closeBtn.on_click(func() { done = true })
    SDL3.runModal(dlg,
        func(Event ev): bool {
            if ev.isQuit() or ev.isWindowClose() { return false }
            if ev.isKeyDown() and ev.scancode() == Scancode.ESCAPE { return false }
            return not done
        },
        func(Renderer r) { r.clearColor(theme.getTheme().bg) }
    )
    return true
}
