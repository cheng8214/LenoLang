// cleaner_master.leno — 电脑清理大师（模仿 360 垃圾清理）
//
// 界面：浅色主题 + 大圆环（RingProgress，框架新增控件 ✓）
//   idle    环中心「立即扫描」（点环即扫）
//   scanning 环 sweep 旋转光束，中心实时显示已扫大小
//   done    环 value 模式，中心显示可清理总量；右侧表格勾选清理项
//   cleaning 底部进度条推进
//   report  显示「已清理 X，释放 Y」，按钮变「再扫一次」
//
// 线程模型（照 file_search / cache_cleaner 套路）：
//   扫描 = 6 类别并行 threads.start(scan_worker) + channel 实时增量 + 50ms 定时器排空
//   清理 = 每勾选类别一条 delete_worker 线程，join 取权威结果
//   worker 必须具名全局函数（scan_entry / delete_entry，闭包会被 GC ✗）
//
// 运行：build\leno.exe cleaner_master.leno
import "SDL3" as SDL3
import "sdl_theme" as theme
import "./cleaner_rules.leno" as rules
import "./cleaner_detail.leno" as detail   // 明细清单弹窗（已从本文件拧出 ⇒ 独立模块 ✓）
import "./cleaner_whitelist.leno" as wl    // 保留清单（扫描 + 删除双端过滤 ✓）
import "./cleaner_registry.leno" as reg    // ③ 注册表清理（判定是纯函数 ⇒ 可单测 ✓）
import Sys                                  // ★ 跨平台系统能力（磁盘/回收站/进程…）—— 取代原先的 Win32 ★
import dirs
import strings
import files
import threads
import jsons
import times as ti
use SDL3.(Event, Renderer, Window, TitleBar, Label, Button, CheckBox, Table, ProgressBar, HBox, VBox, Scancode, Timer)
use SDL3.RingProgress
use rules.CleanCategory
use reg.(RegItem, RegScan, RegBackup, RegClean)

// ==================== 调试日志（--autoclean 用；主线程+worker 都可能调 ⇒ try/catch 兜底） ====================
func _dlog(string s) {
    try {
        // ★ 2026-10-01 换 `dirs.join`：原先写死 `"\\"` ⇒ Linux 下会生成一个名叫 `\cmaster_debug.log` 的怪文件 ✗
        string p = dirs.join(_tmpdir(), "cmaster_debug.log")
        var f = files.open(p, "a")
        f.writeln(s)
        f.close()
    } catch e { return }    // 日志失败无处可报：写 return 表明有意忽略（体非空 ⇒ 不触发「空catch吞异常」提示 ✓）
}

// ==================== 线程入口（具名全局 ✓；参数纯数组/字符串 ⇒ 可跨线程 ✓） ====================
func scan_entry(Array[string] roots, string prefix, any ch, int idx, Array[string] wlEnc): Array[string] {
    return rules.scan_worker(roots, prefix, ch, idx, wlEnc)
}

func delete_entry(Array[Array[string]] chunk, Array[string] roots, any ch, Array[string] wlEnc): Array[string] {
    _dlog($"  worker enter n={chunk.len()} wl={wlEnc.len()}")
    var r = rules.delete_worker(chunk, roots, ch, wlEnc)
    _dlog($"  worker exit cleaned={r[0]} failed={r[1]} freed={r[2]}")
    return r
}

// 回收站清空走后台线程（清空同步且可能耗时 ⇒ 主线程直调会冻结 UI ✗）
//   ★ 2026-10-01 跨平台：`Sys.emptyTrash()`
//     · Windows ⇒ SHEmptyRecycleBin（清空所有驱动器回收站）
//     · Linux   ⇒ freedesktop Trash 规范：清掉 `~/.local/share/Trash/{files,info}`
func recycle_entry(): bool {
    _dlog("  recycle enter")
    bool ok = Sys.emptyTrash()
    _dlog($"  recycle exit ok={ok}")
    return ok
}

// ==================== 主结构 ====================
struct CleanerMaster {
    // ===== UI 控件 =====
    Window win
    TitleBar titleBar
    RingProgress ring
    Table catTable
    ProgressBar driveBar
    ProgressBar cleanBar
    Label driveLbl
    Label statusLbl
    Label sumMain                      // 摘要卡主行（环下方空白利用 ✓）
    Label sumSub                       // 摘要卡副行
    Label lastLbl                      // 上次清理记录
    Label timeLbl                      // 清理耗时（进度条行右侧，清理中实时跳动 ✓）
    Button mainBtn
    // 三联图标按钮（**图标在上、文字在下** ✓）：预览 / 导出 / 注册表清理
    //   放在左列下方（2026-09-29 用户要求 ✓）⇒ 底部只剩一个主动作 ✓
    //   图标由 `tools/gen_icons.leno` 用 Leno 程序化生成 ✓（64×64 透明底白形状 ✓）
    Button previewBtn
    Button exportBtn
    Button regBtn
    Timer pollTimer

    // ===== 状态机：idle → scanning → done → cleaning → report =====
    string state = "idle"
    Array[CleanCategory] cats
    Array[Array[string]] results       // 每类别 scan_worker 返回（[size,cnt,skip,路径,大小,...]）
    // 类别图标路径（与 cats **同序** ✓）：createTable 时作为 row_images 给一份 ✓，
    //   之后每次 set_rows() 都要**再贴一遍** ✗ —— 见 refreshRows() 里的注释（掉过坑 ✓）
    Array[string] catIcons = []
    Array[Thread] scanThreads
    Channel? scanCh = null
    int liveSize = 0                   // 扫描实时累计（channel 增量，仅 UI 反馈）
    int liveCnt = 0
    int totalSize = 0                  // 权威总量（join 结果）
    int totalCnt = 0
    Array[Thread] cleanThreads
    Array[int] cleanCatIdx             // 清理线程序 → 类别序（与 cleanCatStats 平行）
    Array[Array[string]] cleanCatStats // 每类别清理结果 [cleaned, failed, freed]（join 后填）
    // 本次**用户勾选**的类别序。与 cleanCatIdx 的区别（修「结果列显示未勾选」那个 bug 的关键）：
    //   cleanCatIdx 只收录"真的起了删除线程"的类别 ⇒ **0 项可清的类别不在里面**，
    //   于是它们会被误标成"未勾选"✗（实测：错误报告 0 B/0 项 ⇒ 显示"未勾选"但复选框是勾着的）
    Array[int] cleanCheckedIdx = []
    int cumFreed = 0                   // 历史累计释放（last_clean.json 累加；摘要卡展示 ✓）
    Channel? cleanCh = null
    Thread? recycleThread = null       // 回收站清空线程（后台 ✓）
    int cleanTotalUnits = 0            // 勾选类别的清理单元总数（进度分母）
    int liveAttempted = 0              // 清理实时进度（channel 增量，仅 UI 反馈）
    int liveCleaned = 0
    int liveFreed = 0
    int cleanedTotal = 0
    int failedTotal = 0
    int freedTotal = 0
    int cleanStartTick = 0             // 清理耗时计时
    float cleanElapsedSec = 0.0
    bool recycleCleaned = false
    bool recycleTimedOut = false       // 回收站线程超时弃管（后台继续尝试，不拖住报告）
    int recycleTicks = 0
    int watchdogAttempted = 0          // 看门狗：上次记录的进度值 / tick
    int watchdogLastTick = 0
    bool autoTest = false              // --autotest：自动扫描到 done 即退出（不清理 ⇒ 不删任何文件）
    bool shotDone = false              // 已存过"扫描完成态"截图（避免每帧重复存盘 ✓）
    bool shotReport = false            // 已存过"报告态"截图（想看多段环 + 结果列 ⇒ 报告态才有 ✓）
    bool autoClean = false             // --autoclean：合成垃圾类别走真实清理管线（调试取证）
    bool injected = false
    bool phase2 = false                // phase2 = 真实类别清理取证
    string fixtureBase = ""
    int pollN = 0

    // ===== 自证截屏（★ 2026-10-01 跨平台改造：Win32 GDI 全屏 → SDL3 读本窗口帧）=====
    string shotPath = ""               // 非空 ⇒ 下一帧渲染完成后截图（跨平台 ✓）
    bool shotSaved = false             // 该帧已处理完（成功或失败都算 ✓）⇒ 自动化据此决定何时收工
    int shotWaitTicks = 0              // 已等待的定时器 tick 数（安全阀：等太久就照常收工，不卡死 ✓）

    // ==================== UI 构建 ====================
    func setupUI() {
        titleBar = SDL3.createTitleBar({title: "电脑清理大师", height: 32, font_size: 14})
        win.add(titleBar)
        float titleH = titleBar.get_h()

        // 顶部：C 盘空间条 —— **左对齐**（2026-09-29 用户要求 ✓）
        //   原来用 `driveGap`(grow:1) 把这一组顶到右边 ✗ ⇒ 现在直接从左边排起 ✓
        var driveRow = SDL3.createHBox({h: 26, padX: 4, padY: 2, spacing: 8})
        // ⚠ 左对齐这里必须**显式给盒宽**（w: 210）：标签是空文本创建 ⇒ 盒宽为 0 ✗
        //   那样就没给它留位置，文字会直接压在进度条上 ✗
        //   （右对齐那版靠"align:2 的锚点在右端"绕开了这点，左对齐没有等价技巧 ✓）
        // ⚠ 宽度要用 **add 的 basis**，不能写 `createLabel({w: ...})`
        //   —— 本文件 line 231 那条注释已经写明：**Label 创建时的 w 选项不被 set() 读取** ✗
        //   （实测：写 w:210 时盒宽仍是 0 ⇒ 文字被挤没、进度条顶到最左边 ✗）
        driveLbl = SDL3.createLabel({text: "", font_size: 12, align: 0})
        driveRow.add(driveLbl, {grow: 0, shrink: 0, basis: 210, align: 3})
        // ★ 进度条**内嵌百分比**（框架自带 `show_text` ✓ 绘制 `{pct}%` ✓）
        //   条高给到 18 才放得下数字（原来 h:10 + show_text:false ✗）✓
        driveBar = SDL3.createProgressBar({w: 240, h: 18, show_text: true, font_size: 11})
        driveBar.set_value(0.0)
        driveRow.add(driveBar, {grow: 0, shrink: 0, basis: 240, align: 3})

        // 中部：左圆环 + 摘要卡 + 右类别表
        var mainRow = SDL3.createHBox({padX: 8, padY: 4, spacing: 8})
        var leftCol = SDL3.createVBox({padX: 4, padY: 8, spacing: 10})
        ring = SDL3.createRingProgress({
            size: 220, thickness: 24, mode: "idle", font_size: 20, sub_font_size: 12,
            tip: "环 = 本次结果比例\n  绿段 = 已清理项 · 橙段 = 被占用跳过项\n（报告态显示；点环可重新扫描）",
            text_fn: func():string {
                if state == "scanning" { return rules.fmt_size(liveSize) }
                if state == "done" { return rules.fmt_size(totalSize) }
                if state == "cleaning" { return "已释放 " + rules.fmt_size(liveFreed) }
                if state == "report" { return "已释放 " + rules.fmt_size(freedTotal) }
                // ★ 空态环心不再写「立即扫描」✗ —— 那是**第二个**入口（唯一入口是底部主按钮 ✓）
                //   环心只报状态 ⇒ 用户不用先判断"点哪个" ✓
                return "待扫描"
            },
            // 副行（环中心第二行）：报告态显示「占可清理 x%」——和上面的「已释放 X MB」互补 ✓
            sub_text_fn: func():string {
                if state == "scanning" { return $"{liveCnt} 项" }
                if state == "done" { return $"共 {totalCnt} 项" }
                if state == "cleaning" { return $"{liveCleaned}/{cleanTotalUnits} 项" }
                if state == "report" {
                    if totalSize > 0 {
                        return $"占可清理 {_int(100.0 * _float(freedTotal) / _float(totalSize))}%"
                    }
                    return $"{cleanedTotal} 项"
                }
                // 空态：**不给操作指令**（唯一指令在底部状态栏 ✓）⇒ 只说"有几类待检查" ✓
                return _str(cats.len()) + " 类"
            },
            on_click: func() {
                if state == "idle" or state == "report" { startScan() }
            }
        })
        leftCol.add(ring, {grow: 0, shrink: 0, align: 1})

        // 摘要卡（利用环下空白 ✓）：主行强调 + 副行说明 + 分隔线 + 上次清理记录
        // 居中原理（关键）：VBox 的 _natW 只在 add() 时捕获一次 ⇒ 创建文本必须是 ""（natW=0），
        //   x 锚点才精确落在列中心；内部 align:1（ALIGN_CENTER）= 每行以 x 锚点为中心绘制
        //   ⇒ 之后 set_text 换任何文字（含 wrap 多行，每行各自居中）都绝对居中 ✓
        var th0 = theme.getTheme()
        sumMain = SDL3.createLabel({text: "", font_size: 16, font_style: 1, align: 1, text_color: th0.txt})
        sumSub = SDL3.createLabel({text: "", font_size: 12, align: 1, text_color: th0.txtDim, wrap: true, wrap_w: 270})
        // h: 34 —— 「上次清理 …」会折成**两行**（wrap_w 270 ✓）
        //   ⚠ 盒高不足时第二行会画到盒外、被左列下方的三联按钮压住 ✗（与状态栏那条同类 ✓）
        // ⚠ 这里原来还带 `h: 34` —— Label **不读** `h`（传了只会刷 [ui] 告警 ✗）
        //   盒高由下面 `add(..., {basis: 34})` 预留 ✓（那条注释 203 行讲的就是这个 ✓）
        lastLbl = SDL3.createLabel({text: "", font_size: 12, align: 1, text_color: th0.txtDim, wrap: true, wrap_w: 270})
        leftCol.add(sumMain, {grow: 0, shrink: 0, align: 1})
        // ⚠ **折行 Label 必须用 `add` 的 basis 预留盒高**（VBox 的主轴 = 竖直 ✓）
        //   创建时的 `h:` **不管用** ✗（实测：h:34 照样被压）—— 与"w 不被读取"是同一个坑 ✓
        //   不预留的话，布局按"一行高"分配 ⇒ 第二行画到盒外、被下方按钮压住 ✗
        leftCol.add(sumSub, {grow: 0, shrink: 0, basis: 34, align: 1})
        leftCol.add(SDL3.createSeparator({w: 220}), {grow: 0, shrink: 0, align: 1})
        leftCol.add(lastLbl, {grow: 0, shrink: 0, basis: 34, align: 1})
        // ★ 三联图标按钮（2026-09-29 按用户要求）：**图标在上、文字在下** ✓
        //   框架原生支持：`image_path` + `image_pos: "top"`（渲染见 sdl_button.leno:587 ✓）
        //   图标 key 注意是 `image_path` **不是** `icon` ✗（与菜单项的 `image` 同理 ✓）
        // ★ 2026-09-29 三联按钮（图标在上、文字在下；视觉上"无框"）✓
        //   ⚠ 走过的两个坑（都记在这儿，免得下次再踩 ✗）：
        //   ① 用 `background: false` 做透明底 ⇒ **文字/图标是白色**，落在浅色页面上根本看不见 ✗
        //      而且它把"背景 + hover + 按压"**整块**跳过（sdl_button.leno:437 ✓）
        //      ⇒ **hover 反馈也没了** ✗（用户立刻发现了 ✓）
        //   ② 只把按钮压矮不够 —— 图文只有 ~36+2+16 高，盒子太高时文字会被**居中推远** ✗
        //   ⇒ 现在改成**"看起来透明"的组合**（框架现成旋钮 ✓ 不改框架 ✓）：
        //        bg_color = 页面底色 ✓ + border/shadow 全关 ✓ ⇒ 视觉上纯图标+文字 ✓
        //        text_color / image_tint = 主题文字色 ✓ ⇒ 浅底上看得见 ✓
        //        （因为仍走正常背景分支 ⇒ hover / 按下 反馈照常 ✓）
        var toolRow = SDL3.createHBox({h: 70, padX: 0, padY: 0, spacing: 6})
        previewBtn = SDL3.createButton({w: 92, h: 70, text: "预览", font_size: 12, type: "dark",
            bg_color: th0.bg, border: false, shadow: false,     // 底色 = 页面色 ⇒ 平时"看着无框" ✓
            hover_color: #E8EAEEFF, pressed_color: #DCE0E6FF,   // ★ 显式给悬停/按压色 ⇒ 反馈一定看得见 ✓
            text_color: th0.txt,                                 // ★ 不给图标染色 ✗ ——
            //   图标是用户从 iconfont 下载的（可能是彩色 ✓）⇒ `image_tint` 会把它们压成单色 ✗
            //   "不可用"的表现改走 `set_image_alpha`（变淡 ✓，颜色保留 ✓），见 _dim()
            image_path: detail.icon("preview.png"), image_pos: "top", image_size: 36, image_gap: 2})
        exportBtn = SDL3.createButton({w: 92, h: 70, text: "导出", font_size: 12, type: "dark",
            bg_color: th0.bg, border: false, shadow: false,     // 底色 = 页面色 ⇒ 平时"看着无框" ✓
            hover_color: #E8EAEEFF, pressed_color: #DCE0E6FF,   // ★ 显式给悬停/按压色 ⇒ 反馈一定看得见 ✓
            text_color: th0.txt,                                 // ★ 不给图标染色 ✗ ——
            //   图标是用户从 iconfont 下载的（可能是彩色 ✓）⇒ `image_tint` 会把它们压成单色 ✗
            //   "不可用"的表现改走 `set_image_alpha`（变淡 ✓，颜色保留 ✓），见 _dim()
            image_path: detail.icon("export.png"), image_pos: "top", image_size: 36, image_gap: 2})
        regBtn = SDL3.createButton({w: 92, h: 70, text: "注册表", font_size: 12, type: "dark",
            bg_color: th0.bg, border: false, shadow: false,     // 底色 = 页面色 ⇒ 平时"看着无框" ✓
            hover_color: #E8EAEEFF, pressed_color: #DCE0E6FF,   // ★ 显式给悬停/按压色 ⇒ 反馈一定看得见 ✓
            text_color: th0.txt,                                 // ★ 不给图标染色 ✗ ——
            //   图标是用户从 iconfont 下载的（可能是彩色 ✓）⇒ `image_tint` 会把它们压成单色 ✗
            //   "不可用"的表现改走 `set_image_alpha`（变淡 ✓，颜色保留 ✓），见 _dim()
            image_path: detail.icon("registry.png"), image_pos: "top", image_size: 36, image_gap: 2})
        previewBtn.set_tip("预览（干跑）：先看账单，不删除任何文件 —— 扫描完成后可用")
        exportBtn.set_tip("把本次清理报告写到桌面 —— 清理完成后可用")
        regBtn.set_tip("注册表残留清理：先给清单，导出 .reg 备份，二次确认后才删除")
        // ★ 2026-10-01 跨平台：注册表是 Windows 独有的 ⇒ 非 Windows 上按本文件既有约定处理
        //   （**暗色 + 点击拦住并说明** ✓，不引入禁用灰底 —— 见上面 2026-09-29 那条原因 ✓）
        if not reg.supported() {
            regBtn.set_tip("注册表清理仅 Windows 可用（本平台 " + Sys.os() + " 没有注册表）")
            _dim(regBtn, true)
        }
        // ★ 2026-09-29（A 方案）：**不再用 set_enabled** ✗
        //   因为禁用态框架会画一圈灰底（Button 没有 disabled_bg 选项 ✗，与"无框"设计冲突 ✗）
        //   ⇒ 改成：按钮**始终 enabled** ✓，用 **暗色** 表示"当前不可用" ✓，
        //     点击时在回调里拦一下 + 状态栏给提示 ✓（用户不会点了没反应 ✗）
        _dim(previewBtn, true)   // idle 态：预览不可用 ✓
        _dim(exportBtn, true)    // idle 态：导出不可用 ✓
        previewBtn.on_click(func() {
            if state != "done" { statusLbl.set_text("先扫描一次，再看账单（预览）"); return }
            openPreview()
        })
        exportBtn.on_click(func() {
            if state != "report" { statusLbl.set_text("清理完成后才有报告可导出"); return }
            exportReport()
        })
        regBtn.on_click(func() {
            // ★ 跨平台：非 Windows 上**点得动、但点不进去** ⇒ 状态栏讲清为什么（不留"点了没反应" ✗）
            if not reg.supported() {
                statusLbl.set_text("注册表清理仅 Windows 可用：本平台（" + Sys.os() + "）没有注册表")
                return
            }
            openRegistry()
        })
        toolRow.add(previewBtn, {grow: 0, shrink: 0, basis: 92, align: 3})
        toolRow.add(exportBtn, {grow: 0, shrink: 0, basis: 92, align: 3})
        toolRow.add(regBtn, {grow: 0, shrink: 0, basis: 92, align: 3})
        leftCol.add(toolRow, {grow: 0, shrink: 0, basis: 70, align: 0})
        updateSummary()   // 空创建 ⇒ 首帧前先填摘要文案
        mainRow.add(leftCol, {grow: 0, shrink: 0, basis: 300, align: 3})

        // ★ 类别图标（2026-09-29 用户要求：**给类别文字前加上图标** ✓）
        //   框架的 `image_col` = 把该列画成 **[图标 + 文字]** ✓ ⇒ 图标自然落在类别文字**前面** ✓
        //   `row_images` 与行平行、**在 createTable 时一次性给** ✓；
        //   类别顺序是固定的（cats 顺序 ✓）⇒ 之后 set_rows 换数据也不会错位 ✓
        //   ⚠ 没有图标的类别给空串（不是给目录路径 ✗ —— 那会让框架去 load 一个目录 ✓）
        catIcons = []
        for cats to c {
            string ip = detail.icon(rules.icon_of(c.id))
            // 文件不存在（比如还没放 d3d.png ✓）⇒ 给空串 ⇒ 该行就不画图标 ✓
            //   （绝不能把不存在的路径塞进去 ✗ —— 框架会去 load 它 ✓）
            if files.exists(ip) { catIcons.add(ip) } else { catIcons.add("") }
        }
        catTable = SDL3.createTable({
            headers: ["", "类别", "大小", "项目数", "结果"],
            col_widths: [40.0, 160.0, 92.0, 64.0, 150.0],
            zebra: true, row_h: 34, header_h: 32, font_size: 14,
            check_col: 0,
            image_col: 1, image_size: 18, image_pad: 4, image_gap: 6,
            row_images: catIcons,
            col_reorder: false, resizable: false
        })
        // ★ 交互（2026-09-28 按用户要求调整）：
        //   · **双击**行 ⇒ 弹明细清单 ✓（原来单击就弹 ✗ ⇒ 现在单击只做"选中"，不打扰 ✓）
        //   · **右击**行 ⇒ 上下文菜单（勾选/明细/清理/导出 ✓）
        //   都是框架 Table 自带能力 ⇒ 没有为此改框架 ✓：
        //     on_dbl_click ✓（内置 400ms + 10px 判定）、addContextItem/on_context_select ✓
        catTable.on_dbl_click(func(int row, int col) { openDetail(row) })
        catTable.on_context_will_open(func(int row) { buildCatMenu(row) })
        catTable.on_context_select(func(int row, string id) { onCatMenuPick(row, id) })
        mainRow.add(catTable, {grow: 1, shrink: 1, align: 3})

        // 清理进度条 + 耗时（进度条行右侧 ✓）
        // ⚠ Label 的 align 是**锚点**语义（ALIGN_RIGHT: drawX = x - 文字宽），而 HBox 给子项的 x
        //   恒为「盒左边缘」⇒ 这里只能用 ALIGN_LEFT(0)：文字从盒内左边缘起画，恰在进度条右侧
        //   8px 处；用 align:2 会把文字画到盒外左边、压在进度条尾巴上 ✗
        // ★ 同样开启内嵌百分比（2026-09-29）⇒ 行高与条高一起抬到放得下数字 ✓
        var cleanRow = SDL3.createHBox({h: 22, padX: 0, padY: 0, spacing: 8})
        cleanBar = SDL3.createProgressBar({h: 18, show_text: true, font_size: 11})
        cleanBar.set_value(0.0)
        cleanRow.add(cleanBar, {grow: 1, shrink: 1, align: 3})
        // basis 预留 110（容纳最长文案「耗时 1 分 05 秒」）；Label 创建时的 w 选项不被 set() 读取
        timeLbl = SDL3.createLabel({text: "", font_size: 11, text_color: th0.txtDim})
        cleanRow.add(timeLbl, {grow: 0, shrink: 0, basis: 110, align: 3})

        // 底部：状态 + 主动作（**唯一入口** ⇒ 视觉焦点只有一个 ✓）
        //   次要动作（预览 / 导出 / 注册表）都在**左列下方**（2026-09-29 用户要求 ✓）
        //   ⇒ 这一行只剩状态 + 主按钮 ✓（原先那个「工具」收口窗已删除 ✓ 见文件末尾说明 ✓）
        // ⚠ `wrap_w` 必须 ≤ 状态格的**实得宽度**，否则折行会溢到按钮底下被压住 ✗（实测踩过 ✓）
        //   实得宽度 = 窗口 900 − root padX 12×2 − 本行 padX 4×2 − 190 − 间距 10 = 668
        //   ⇒ 取 660 留 8px 余量 ✓；盒高 42 = 行内高（54 − padY 6×2 ✓）⇒ **两行都在框内** ✓
        //   ⚠ 盒高是**父容器给的**（HBox h:54 − padY 6×2 ✓）—— 原来这里还写了 `h: 42` 是**无效**的 ✗
        //     （Label 不读 `h` ⇒ 只会刷一条 [ui] 告警 ✓）⇒ 删掉，语义不变 ✓
        //   注意：框架的 wrap_w 只认写死的值（0 才退回 max_w，**不会**用控件自身宽度 ✓）
        var bottomRow = SDL3.createHBox({h: 54, padX: 4, padY: 6, spacing: 10})
        statusLbl = SDL3.createLabel({
            text: "就绪 — 点「立即扫描」开始", font_size: 13,
            wrap: true, wrap_w: 660,
            tip: "「跳过 N 项」＝这些文件正被其他程序占用（如浏览器正在运行、系统临时文件在使用中）。\n关闭对应程序后点「再扫一次」即可清理。\n点表格任一行可看该类的明细清单。"
        })
        bottomRow.add(statusLbl, {grow: 1, shrink: 1, align: 3})
        mainBtn = SDL3.createButton({w: 190, h: 42, text: "立即扫描", type: "success", font_size: 16})
        mainBtn.on_click(func() {
            if state == "idle" or state == "report" { startScan() } else {
                if state == "done" { requestClean() }
            }
        })
        bottomRow.add(mainBtn, {grow: 0, shrink: 0, basis: 190, align: 3})

        var root = SDL3.createVBox({padX: 12, padY: 8, spacing: 6})
        root.add(driveRow, {grow: 0, shrink: 0, align: 3})
        root.add(mainRow, {grow: 1, shrink: 1, align: 3})
        root.add(cleanRow, {grow: 0, shrink: 0, align: 3})
        root.add(bottomRow, {grow: 0, shrink: 0, align: 3})
        win.setRootAt(root, 0, titleH)
    }

    // ==================== 摘要卡（环下空白利用 ✓） ====================
    func updateSummary() {
        if state == "idle" {
            sumMain.set_text("就绪")
            string wlTip = ""
            if wl.count() > 0 { wlTip = $" · 保留清单 {wl.count()} 条" }
            // ★ 空态这里**不讲操作**（唯一指令在底部状态栏 ✓）⇒ 只回答"将清理什么" ✓
            //   （改前这里是"点击圆环或「立即扫描」开始" ✗ —— 与环心、状态栏三处重复同一句话 ✗）
            sumSub.set_text($"{cats.len()} 类可清理{wlTip}")
        }
        if state == "scanning" {
            sumMain.set_text($"已发现 {rules.fmt_size(liveSize)}")
            sumSub.set_text($"{liveCnt} 项 · 正在扫描...")
        }
        if state == "done" {
            sumMain.set_text($"可释放 {rules.fmt_size(totalSize)}")
            sumSub.set_text($"共 {totalCnt} 项 · 已默认全选，可取消勾选")
        }
        if state == "cleaning" {
            sumMain.set_text($"已清理 {liveCleaned}/{cleanTotalUnits} 项")
            sumSub.set_text($"释放 {rules.fmt_size(liveFreed)} · 跳过项为被占用文件")
        }
        if state == "report" {
            sumMain.set_text($"已释放 {rules.fmt_size(freedTotal)}")
            sumSub.set_text($"成功 {cleanedTotal} 项 · 跳过 {failedTotal} 项（被占用）")
        }
    }

    // ==================== 上次清理记录（%APPDATA%\TraeCleaner\last_clean.json ✓） ====================
    pri func in_int(Array[int] arr, int v): bool {
        for arr to x {
            if x == v { return true }
        }
        return false
    }

    // 按 id 找类别下标（-1 = 不存在）。
    // 为什么需要：`--autoclean` 取证模式原先写死历史下标（[0..4] 与 5）⇒ 一加类别就会
    // 悄悄换掉它清理的对象 ✗（本轮就加了 5 类）。改成按 id 查 ⇒ 以后再改类别序也安全 ✓
    pri func cat_index(string id): int {
        for 0 : cats.len() - 1 to i {
            if cats[i].id == id { return i }
        }
        return -1
    }

    func _pad2(int v): string {
        if v < 10 { return "0" + _str(v) }
        return _str(v)
    }

    // 给悬停提示**追加一行**：空串不进 ✓
    //   为什么必须这样（实测截图）：有些类别**没写 hint**（如「缩略图缓存」）⇒ tip 初始是 "" ✗
    //   此时 `$"{tip}\n本次…"` 等于"空串 + 换行 + 内容" ⇒ 悬停框**第一行是空白** ✗
    //   （截图上就是 tooltip 顶部多出一条空行，然后才是"本次占比…"）
    //   加了本函数后：cur 为空则直接返回 line ⇒ **不可能**出现空首行 ✓
    pri func tip_add(string cur, string line): string {
        if line == "" { return cur }
        if cur == "" { return line }
        return $"{cur}\n{line}"
    }

    // 「上次清理」状态的存放目录（跨平台）
    // ★ 原实现无条件拼 "\\TraeCleaner\\"：Linux 上 APPDATA 为空 ⇒ 落到 `_tmpdir()` 之后
    //   变成 `/tmp\TraeCleaner\last_clean.json` 这种**文件名里带反斜杠**的怪文件 ✗
    //   POSIX 侧按 XDG 规范用 $XDG_CONFIG_HOME（缺省 ~/.config）✓
    pri func last_clean_dir(): string {
        if _os() == "windows" {
            return dirs.join(_env_or("APPDATA", _tmpdir()), "TraeCleaner")
        }
        string cfg = _env_or("XDG_CONFIG_HOME", "")
        if cfg == "" { cfg = dirs.join(_homedir(), ".config") }
        return dirs.join(cfg, "TraeCleaner")
    }

    pri func last_clean_path(): string {
        return dirs.join(last_clean_dir(), "last_clean.json")
    }

    func loadLastClean() {
        try {
            var d = jsons.read_file(last_clean_path())
            if d is Dict => j {
                int freed = _int(j.get("freed", 0))
                cumFreed = _int(j.get("total_freed", 0))     // 老文件没这字段 ⇒ 0（下一次保存补上 ✓）
                if freed > 0 {
                    string extra = ""
                    if cumFreed > freed { extra = $" · 累计 {rules.fmt_size(cumFreed)}" }
                    lastLbl.set_text($"上次清理：{j.get("time", "")} 释放 {rules.fmt_size(freed)}{extra}")
                } else {
                    if cumFreed > 0 { lastLbl.set_text($"累计释放 {rules.fmt_size(cumFreed)}") }
                }
            }
        } catch e {
            // ★ 别再静默吞：留一行日志（`catch { }` 曾把 ti.now 的类型错误一起吞掉 ⇒ 该功能静默失效很久 ✗）
            _dlog("loadLastClean 失败: " + _str(e.msg))
        }
    }

    func saveLastClean() {
        try {
            // ⚠ `ti.now()` 返回的是 **int 时间戳**，**不是** [年,月,日,时,分,秒] 数组 ——
            //   原先写 `ti.now() as Array[int]` 会**直接抛异常**，又被这里的 `catch { }` 吞掉 ⇒
            //   「上次清理」这项功能其实**从未生效** ✗（本轮查导出报告静默失败时才挖出来）。
            //   正确做法：`ti.format(时间戳, strftime 风格格式)` ✓
            string ts = ti.format(ti.now(), "%Y-%m-%d %H:%M:%S")
            cumFreed = cumFreed + freedTotal   // 跨次累加（"累计释放"✓）
            dirs.mkdir_p(last_clean_dir())
            jsons.write_file(last_clean_path(),
                {time: ts, freed: freedTotal, items: cleanedTotal, total_freed: cumFreed})
            lastLbl.set_text($"上次清理：{ts} 释放 {rules.fmt_size(freedTotal)} · 累计 {rules.fmt_size(cumFreed)}")
        } catch e {
            // ★ 同上：保存失败要留痕（否则"上次清理/累计"静默不更新 ✗）
            _dlog("saveLastClean 失败: " + _str(e.msg))
        }
    }

    // ==================== 扫描 ====================
    func startScan() {
        if state == "scanning" or state == "cleaning" { return }
        state = "scanning"
        cats = rules.build_categories()
        results = []
        scanThreads = []
        cleanCatIdx = []
        cleanCatStats = []
        liveSize = 0
        liveCnt = 0
        recycleCleaned = false
        recycleTimedOut = false
        catTable.set_rows([])
        mainBtn.set_enabled(false)
        mainBtn.set_text("扫描中...")
        statusLbl.set_text("正在扫描，请稍候...")
        cleanBar.set_value(0.0)
        timeLbl.set_text("")
        ring.set_mode("sweep")
        ring.clear_segments()          // 新一轮扫描 ⇒ 清掉上轮的"绿/橙"双色弧 ✓
        _dim(previewBtn, true)   // 旧扫描结果作废 ⇒ 预览变暗 ✓
        _dim(exportBtn, true)    // 旧报告作废 ⇒ 导出变暗 ✓
        cleanCheckedIdx = []           // 上轮勾选记录作废（结果列靠它区分「无垃圾/未勾选」✓）
        catTable.clear_cell_colors()
        updateSummary()
        scanCh = threads.channel(65536)
        // ★ 保留清单**取一次快照**再传给 worker（纯字符串数组 ⇒ 可安全跨线程 ✓）
        //   为什么不能在 worker 里读模块级状态：新线程视角下可能是未初始化值 ⇒ 直接抛错 ✗（实测过 ✓）
        Array[string] wlEnc = wl.encode()
        for 0 : cats.len() - 1 to i {
            scanThreads.add(threads.start(scan_entry, cats[i].roots, cats[i].file_prefix, scanCh, i, wlEnc))
        }
        SDL3.markFrameRedraw()
    }

    func finishScan() {
        totalSize = 0
        totalCnt = 0
        for 0 : scanThreads.len() - 1 to i {
            var res = scanThreads[i].join() as Array[string]
            results.add(res)
            totalSize = totalSize + _int(res[0])
            totalCnt = totalCnt + _int(res[1])
        }
        if scanCh is Channel { scanCh.close() }
        scanCh = null
        scanThreads = []
        refreshRows()
        catTable.check_all()
        ring.set_mode("value")
        ring.set_value(1.0)
        applyScanSegments()      // ★ 构成环（见其注释：替换掉"一整圈绿"那种无信息画法 ✓）
        state = "done"
        mainBtn.set_enabled(true)
        mainBtn.set_text("一键清理")
        updateSummary()
        _dim(previewBtn, totalCnt <= 0)   // 确实扫到东西才亮起 ✓
        _dim(exportBtn, true)             // 此刻还没有报告 ✓
        if autoTest {
            print($"AUTOTEST size={totalSize} cnt={totalCnt} cats={cats.len()} results={results.len()}")
        }
        if totalCnt == 0 {
            statusLbl.set_text("扫描完成：未发现可清理垃圾")
        } else {
            statusLbl.set_text($"扫描完成：{rules.fmt_size(totalSize)} 可清理（{totalCnt} 项）— 可先「预览（干跑）」看账单")
        }
        refreshDrive()
        SDL3.markFrameRedraw()
    }

    // ==================== done 态"构成环" ====================
    // 原来的 done 态是 `set_value(1.0)` ⇒ 画**一整圈绿**，但那个 100% 没有任何含义 ✗
    //   （截图里看起来"进度满"，其实只是占位）。
    // 改成：取**最大的 3 个类别**各占一段（12 点起顺时针），余量留轨道色 ✓
    //   ⇒ 一眼看出"5.5 GB 里大头是谁" ✓；颜色固定（蓝/橙/绿），顺序 = 大小降序 ✓
    func applyScanSegments() {
        if totalSize <= 0 { ring.clear_segments(); return }
        Array[float] ratios = []
        Array[int] used = []
        for 0 : 2 to k {
            int best = -1
            int bestSz = 0
            for 0 : cats.len() - 1 to i {
                if cats[i].id == "recyclebin" { continue }
                if i >= results.len() { continue }
                if in_int(used, i) { continue }
                int s = _int(results[i][0])
                if s > bestSz { bestSz = s; best = i }
            }
            if best < 0 or bestSz <= 0 { break }
            used.add(best)
            ratios.add(_float(bestSz) / _float(totalSize))
        }
        // 按段数分别传色（避免在此文件里引入 Color 类型名；与 finishClean 的调用风格一致 ✓）
        if ratios.len() == 1 { ring.set_segments(ratios, [#3B82F6FF]) }
        if ratios.len() == 2 { ring.set_segments(ratios, [#3B82F6FF, #E09A34FF]) }
        if ratios.len() == 3 { ring.set_segments(ratios, [#3B82F6FF, #E09A34FF, #3CC850FF]) }
        if ratios.len() == 0 { ring.clear_segments() }
    }

    func refreshRows() {
        Array[Array[string]] rows = []
        Array[string] tips = []
        Array[int] fgCols = []            // 结果列前景色（0 = 用默认色）
        for 0 : cats.len() - 1 to i {
            var c = cats[i]
            string szTxt = "—"
            string cntTxt = "—"
            string resTxt = ""
            if i < results.len() {
                var res = results[i]
                if c.id == "recyclebin" {
                    szTxt = "系统托管"
                } else {
                    szTxt = rules.fmt_size(_int(res[0]))
                    cntTxt = _str(_int(res[1]))
                }
            } else {
                // ★ 空态（未扫描）：结果列改放"这一类到底会清什么"（= c.hint ✓）
                //   空表只写「暂无数据」✗ 等于把最大一块屏浪费掉 ⇒ 这里顺手回答
                //   "这软件会清什么" ⇒ 用户不用先扫一遍才敢点 ✓
                resTxt = c.hint
            }
            string tip = c.hint            // 行悬停：类别说明（**可能为空** ⇒ 追加一律走 _tip_add ✓）
            // 行悬停再补一行"本次占比"：表格列宽有限（92px 放不下「5.4 GB · 96%」✗）
            //   ⇒ 把占比放到悬停提示里，看构成时不用心算 ✓
            //   ⚠ 必须用 _tip_add 追加（c.hint 可能是空串 ⇒ 直接拼 `\n` 会冒出空首行 ✗）
            if totalSize > 0 and i < results.len() and c.id != "recyclebin" {
                int shareB = _int(results[i][0])
                if shareB > 0 {
                    int pct = _int(100.0 * _float(shareB) / _float(totalSize))
                    string share = _str(pct) + "%"
                    if pct <= 0 { share = "<1%" }   // 2 MB / 5.5 GB 显示「0%」会被误读成"没有" ✗
                    tip = tip_add(tip, "本次占比 " + share)
                }
            }
            // 保留清单生效情况（被豁免的项**不会**出现在明细里 ⇒ 必须显式说一声，
            //   否则用户会以为"扫描漏了"或"明明有文件却查不到" ✗）
            if i < results.len() and results[i].len() > 3 {
                int keptN = _int(results[i][3])
                if keptN > 0 { tip = tip_add(tip, $"保留清单已豁免 {keptN} 项") }
            }
            int fg = 0
            // 结果列（report / cleaning 状态）：每类清理结果一目了然 ✓
            if state == "report" or state == "cleaning" {
                if c.id == "recyclebin" {
                    if recycleTimedOut { resTxt = "后台进行中" } else {
                        if recycleCleaned { resTxt = "已清空" } else { resTxt = "—" }
                    }
                } else {
                    // cleanCatIdx 与 cleanCatStats 平行 ⇒ 找到本类结果
                    int ci = -1
                    for 0 : cleanCatIdx.len() - 1 to k {
                        if cleanCatIdx[k] == i { ci = k }
                    }
                    if ci >= 0 and ci < cleanCatStats.len() {
                        var s = cleanCatStats[ci]
                        int cc = _int(s[0])
                        int cf = _int(s[1])
                        // 文案缩短（结果列窄 ⇒ 长的会被截断；完整说法进 tip ✓）
                        if cc > 0 and cf > 0 { resTxt = $"已清 {cc} · 跳过 {cf}" } else {
                            if cc > 0 { resTxt = $"已清 {cc} 项" } else {
                                if cf > 0 { resTxt = $"跳过 {cf} 项" } else { resTxt = "无垃圾" }
                            }
                        }
                        if cc > 0 { fg = theme.getTheme().btnSuccess }      // 清掉了 ⇒ 绿
                        if cf > 0 { fg = #E09A34FF }                        // 有跳过 ⇒ 橙（更需要你看一眼）
                        tip = tip_add(tip, $"本次：已清理 {cc} 项 · 跳过 {cf} 项（被占用）")
                        tip = tip_add(tip, "点本行看明细清单")
                    } else if in_int(cleanCheckedIdx, i) {
                        // ★ 勾了但没东西可清 ⇒ 说「无垃圾」。
                        //   原先这里一律落到 else ⇒ 显示「未勾选」✗（实测：错误报告 0 B/0 项、
                        //   复选框明明是勾着的却写"未勾选" ⇒ 因为 cleanCatIdx 只收录真起了删除线程的类别）
                        resTxt = "无垃圾"
                        tip = tip_add(tip, "本次扫描未发现可清理项")
                    } else {
                        resTxt = "未勾选"
                        fg = theme.getTheme().txtDim
                        tip = tip_add(tip, "本次清理未勾选本类")
                    }
                }
            }
            rows.add(["", c.name, szTxt, cntTxt, resTxt])
            tips.add(tip)
            fgCols.add(fg)
        }
        catTable.set_rows(rows)
        catTable.clear_cell_colors()
        for 0 : rows.len() - 1 to i {
            if i < tips.len() and tips[i] != "" { catTable.set_row_tip(i, tips[i]) }
            if i < fgCols.len() and fgCols[i] != 0 { catTable.set_cell_fg(i, 4, fgCols[i]) }
            // ★ 类别图标必须**每次刷新后重贴**（2026-09-29 用户反馈"扫描后图标不见了" ✓）
            //   根因：`set_rows()` 会同步 `_rowImages` 长度 ——
            //     `startScan()` 里的 `set_rows([])` 把图标数组**清空** ✗，
            //     之后 `set_rows(rows)` 只用空串补齐（sdl_table.leno:448-450 ✓）
            //   ⇒ 所以这里逐行 set_row_image 重贴一遍 ✓（和 tips/颜色同一处理 ✓）
            if i < catIcons.len() { catTable.set_row_image(i, catIcons[i]) }
        }
    }

    // ==================== 清理 ====================
    func requestClean() {
        if state != "done" { return }
        Array[int] checked = catTable.get_checked_rows()
        if checked.len() == 0 {
            statusLbl.set_text("请先勾选要清理的项目")
            return
        }
        // 弹确认框前先汇总：勾选类别的**预计项数 / 预计字节**，以及是否含回收站 ✓
        //   为什么一律确认：清理**不可撤销** ✗ —— 原先只在"勾了回收站"时才弹框，
        //   不勾回收站点一下「一键清理」就**直接开删**（实测：无任何提示删掉 5.5 GB ✗）。
        int n = 0
        int bytes = 0
        bool needRecycle = false
        for checked to i {
            if cats[i].id == "recyclebin" { needRecycle = true; continue }
            if i < results.len() {
                n = n + _int(results[i][1])
                bytes = bytes + _int(results[i][0])
            }
        }
        showCleanConfirm(checked, n, bytes, needRecycle)
    }

    func beginClean(Array[int] checked) {
        state = "cleaning"
        cleanStartTick = SDL3.getTicks()
        cleanedTotal = 0
        failedTotal = 0
        freedTotal = 0
        cleanThreads = []
        cleanCatIdx = []
        cleanCatStats = []
        // ★ 记下"用户勾选了哪些类"：结果列要靠它把「无垃圾」与「未勾选」分开
        //   （cleanCatIdx 只收录真起了删除线程的类别 ⇒ 0 项可清的类不在其中 ✗）
        cleanCheckedIdx = checked
        liveAttempted = 0
        liveCleaned = 0
        liveFreed = 0
        cleanTotalUnits = 0
        recycleThread = null
        recycleCleaned = false
        recycleTimedOut = false
        recycleTicks = 0
        watchdogAttempted = 0
        watchdogLastTick = 0
        mainBtn.set_enabled(false)
        mainBtn.set_text("清理中...")
        statusLbl.set_text("正在清理，请稍候...")
        cleanBar.set_value(0.0)
        _dim(previewBtn, true)   // 清理中/清理后都无预览意义 ⇒ 变暗 ✓
        _dim(exportBtn, true)
        cleanCh = threads.channel(65536)
        // 保留清单快照（清理途中用户新加的规则对**本次**不生效 ⇒ 语义明确 ✓）
        Array[string] wlEncClean = wl.encode()

        for checked to ri {
            int i = ri
            var c = cats[i]
            if c.id == "recyclebin" { continue }
            // 结果布局 [size,cnt,skip,kept, 路径,大小, ...] ⇒ 成对切出 chunk
            //   起始下标用 `rules.SCAN_HDR`（**不写死** ✓ —— 加 kept 字段时就是这么改一处的 ✓）
            var res = results[i]
            Array[Array[string]] chunk = []
            int j = rules.SCAN_HDR
            while j + 1 < res.len() {
                chunk.add([res[j], res[j + 1]])
                j = j + 2
            }
            if chunk.len() > 0 {
                cleanTotalUnits = cleanTotalUnits + chunk.len()
                cleanCatIdx.add(i)
                cleanThreads.add(threads.start(delete_entry, chunk, c.roots, cleanCh, wlEncClean))
            }
        }
        // 回收站：后台线程清空（主线程直调 SHEmptyRecycleBin 会冻结 UI ✗）
        bool doRecycle = false
        for checked to i {
            if cats[i].id == "recyclebin" { doRecycle = true }
        }
        if doRecycle {
            recycleThread = threads.start(recycle_entry)
        }
        _dlog($"beginClean: units={cleanTotalUnits} workers={cleanThreads.len()} recycle={doRecycle}")
        updateSummary()
        if cleanThreads.len() == 0 and recycleThread == null {
            finishClean()
        } else {
            cleanBar.set_value(2.0)
        }
        SDL3.markFrameRedraw()
    }

    // 耗时格式化：< 60 秒显示 "3.2 秒"，否则 "1 分 05 秒"
    func _round1(float v): string {
        int whole = _int(v)
        int frac = _int((v - _float(whole)) * 10.0 + 0.5)
        if frac >= 10 { whole = whole + 1; frac = 0 }
        return $"{whole}.{frac}"
    }

    func _fmt_secs(float sec): string {
        if sec < 60.0 { return $"{_round1(sec)} 秒" }
        int m = _int(sec / 60.0)
        int r = _int(sec) - m * 60
        return $"{m} 分 {_pad2(r)} 秒"
    }

    func finishClean() {
        _dlog($"finishClean entered (threads={cleanThreads.len()})")
        cleanElapsedSec = _float(SDL3.getTicks() - cleanStartTick) / 1000.0
        if cleanElapsedSec < 0.0 { cleanElapsedSec = 0.0 }
        for 0 : cleanThreads.len() - 1 to i {
            var r = cleanThreads[i].join() as Array[string]   // [cleaned, failed, freed]
            cleanCatStats.add(r)
            cleanedTotal = cleanedTotal + _int(r[0])
            failedTotal = failedTotal + _int(r[1])
            freedTotal = freedTotal + _int(r[2])
        }
        cleanThreads = []
        if cleanCh is Channel { cleanCh.close() }
        cleanCh = null
        if recycleThread is Thread => rt {
            if rt.state() != "running" {
                recycleCleaned = rt.join() as bool
            }
            recycleThread = null
        }
        cleanBar.set_value(100.0)
        ring.set_value(1.0)
        if totalSize > 0 {
            float ratio = _float(freedTotal) / _float(totalSize)   // 环 = 已释放 ÷ 已发现 ✓
            ring.set_value(ratio)
        }
        // ★ 双色环：绿 = 已清理**项数**占比，橙 = 被占用跳过**项数**占比（余量留轨道色 ✓）
        //   为什么按项数而非字节：跳过项多是被占用的小文件，用项数更能反映"还剩多少要处理" ✓
        if totalCnt > 0 {
            float okRatio = _float(cleanedTotal) / _float(totalCnt)
            float skipRatio = _float(failedTotal) / _float(totalCnt)
            ring.set_segments([okRatio, skipRatio], [theme.getTheme().btnSuccess, #E09A34FF])
        } else {
            ring.clear_segments()
        }
        _dim(exportBtn, false)   // 有报告了 ⇒ 导出亮起 ✓
        _dim(previewBtn, true)   // 结果已落地 ⇒ 不再"预览" ✓
        refreshRows()
        saveLastClean()
        state = "report"
        mainBtn.set_enabled(true)
        mainBtn.set_text("再扫一次")
        string msg = $"清理完成：已清理 {cleanedTotal} 项，释放 {rules.fmt_size(freedTotal)}"
        if recycleCleaned { msg = msg + "，回收站已清空" }
        if recycleTimedOut { msg = msg + "，回收站清理仍在后台进行" }
        if failedTotal > 0 { msg = $"{msg}（{failedTotal} 项被占用跳过 — 关闭浏览器等程序后「再扫一次」可清）" }
        statusLbl.set_text(msg)
        timeLbl.set_text($"耗时 {_fmt_secs(cleanElapsedSec)}")
        updateSummary()
        refreshDrive()
        SDL3.markFrameRedraw()
    }

    // ==================== 清理确认（模态；清理不可撤销 ⇒ 一律确认 ✓） ====================
    // 与旧 showRecycleConfirm 的区别：① 不含回收站时也确认 ✓ ② 明确给出**项数与预计释放量** ✓
    //   ③ 顺带提示"被占用文件会自动跳过"（避免用户以为失败 ✗）
    func showCleanConfirm(Array[int] checked, int n, int bytes, bool needRecycle) {
        // 第 1 行是结论行（msgBox 会居中放大 ✓），其余行左对齐 ✓
        Array[string] lines = ["确认清理选中项？", $"将清理 {n} 项，预计释放 {rules.fmt_size(bytes)}"]
        if needRecycle { lines.add("回收站中的内容将被永久清除。") }
        lines.add("清理不可撤销；正被其他程序占用的文件会自动跳过。")
        // ★ 用**公共确认弹窗**（SDL3.msgBox ✓，见 sdl_dialog.leno）替代原先手搓的那一套：
        //   同一个弹窗注册表那边也要用 ⇒ 抽成公共件 ✓（也顺手拿到它修好的"点确认当帧关窗" ✓）
        //   ⚠ 回调式：主循环已跑时 msgBox **立即返回** ⇒ 绝不能写成 `if msgBox(...) { }` ✗
        //     （那样恒判 false、点确认毫无反应 —— 实测踩过 ✓）
        SDL3.msgBox("确认清理", lines, "开始清理", "取消", true, func() { beginClean(checked) })
    }

    // ==================== 系统盘空间（★ 2026-10-01 跨平台）====================
    //   原先写死 `Win32.diskSpace("C:\\")` + 文案 "C盘" ⇒ 非 Windows 上恒不可用 ✗
    //   现在：盘根取 `Sys.systemRoot()`（Windows=SystemDrive 如 `C:\`；Linux=`/`）✓
    //         文案按平台给（Windows "C盘" / Linux "根分区"）✓
    func driveLabel(): string {
        if Sys.isWindows() {
            string root = Sys.systemRoot()
            if root.len() >= 1 { return strings.slice(root, 0, 0) + "盘" }
            return "系统盘"
        }
        if Sys.isMacos() { return "系统卷" }
        return "根分区"
    }

    func refreshDrive() {
        string label = driveLabel()
        try {
            Dict d = Sys.diskSpace(Sys.systemRoot())
            if d.ok {
                int total = _int(d.total)
                int freeB = _int(d.free)
                if total > 0 {
                    driveLbl.set_text($"{label} 剩余 {rules.fmt_size(freeB)} / 共 {rules.fmt_size(total)}")
                    driveBar.set_value(100.0 * _float(total - freeB) / _float(total))
                }
            } else {
                driveLbl.set_text(label + " 空间不可用")
            }
        } catch {
            driveLbl.set_text(label + " 空间读取失败")
        }
    }

    // ==================== 明细清单（点表格任一行 ⇒ on_cell 回调 ✓） ====================
    // **弹窗本体已拧成独立模块** `cleaner_detail.leno` ✓（分层见该文件头；与 Trae签到 同路数 ✓）
    //   本方法只保留**业务策略**：这类能不能看明细 / 有没有扫描结果 ✓
    //   （"给数据就画"的部分在模块里 ⇒ 那边可以单独改版/复用，这里不必跟着长 ✓）
    func openDetail(int row) {
        if row < 0 or row >= cats.len() { return }
        if row >= results.len() { statusLbl.set_text("该类别还没有扫描结果"); return }
        if cats[row].id == "recyclebin" {
            statusLbl.set_text("回收站由系统托管，不列出逐项清单")
            return
        }
        if not detail.show_detail(cats[row].name, results[row]) {
            statusLbl.set_text("该类别没有可展示的明细")
            return
        }
        // 模态弹窗关闭后主窗口要重绘（否则留下残影 ✗）
        SDL3.markFrameRedraw()
    }

    // ==================== ② 预览·干跑（只算不删 ✓）====================
    // 数据**全部来自已有扫描结果** ⇒ 不重新扫、不动磁盘、更不删除 ✓
    //   本函数里唯一碰盘的是 alive_top（只 stat 最大的 200 项 ✓ 纯读 ✓）
    //   入口：底部「预览（干跑）」按钮 + 右键菜单「预览已勾选项（干跑）…」✓
    func openPreview() {
        if state != "done" { statusLbl.set_text("先扫描一次，再看预览"); return }
        openPreviewFor(catTable.get_checked_rows())
    }

    // 预览"这些类别"（idx = 类别下标数组 ✓）—— 抽出来是为了将来能按行预览 ✓
    func openPreviewFor(Array[int] idxs) {
        if idxs.len() == 0 { statusLbl.set_text("请先勾选要预览的项目"); return }
        var sum = rules.build_preview(cats, results, idxs)
        if sum.catCount == 0 { statusLbl.set_text("勾选的类别里没有可清理项"); return }

        int dw = 860
        int dh = 520
        // ★ 自绘标题栏（与主窗口同款 ✓，公共件见 sdl_dialog.dialogTitleBar）：
        //   窗口高要多留 DIALOG_TB_H；内容根用 setRootAt 让出该高度 ✓
        int tbH = SDL3.DIALOG_TB_H
        var dlg = SDL3.createDialogWindow({title: "预览（干跑）— 只统计，不删除", w: dw, h: tbH + dh})
        TitleBar tb = SDL3.dialogTitleBar(dlg, "预览（干跑）— 只统计，不删除")
        var droot = SDL3.createVBox({x: 0, y: 0, w: dw, h: dh, padX: 16, padY: 14, spacing: 8})
        dlg.setRootAt(droot, 0, tb.get_h())

        droot.add(SDL3.dialogLabel(
            $"已勾选 {sum.catCount} 类：将清理 {sum.cnt} 项 · 释放 {rules.fmt_size(sum.bytes)}", 14),
            {grow: 0, shrink: 0, align: 0})
        droot.add(SDL3.dialogLabel(
            $"其中：跳过 {sum.skip} 项（被占用/读不到）· 保留清单豁免 {sum.kept} 项 —— 这两类都不会被删", 12),
            {grow: 0, shrink: 0, align: 0})
        // ★ 把"没删东西"写在最显眼处：预览最怕被误读成"已经在清理" ✗
        // ⚠ 弹窗字体没有 `✓` 字形（实测渲染成方框 ✗）⇒ 弹窗文案里一律不用 ✓，
        //   改用中文说明（主窗口的 label 不受影响 ✓）
        droot.add(SDL3.dialogLabel("预览只统计、不删除任何文件 —— 确认无误再点「开始清理…」", 12),
            {grow: 0, shrink: 0, align: 0})

        Table pt = SDL3.createTable({
            headers: ["类别", "将清理", "大小", "跳过", "保留清单", "抽查存活"],
            col_widths: [260.0, 90.0, 120.0, 80.0, 110.0, 120.0],
            zebra: true, row_h: 26, header_h: 28, font_size: 13,
            col_reorder: false, resizable: false
        })
        Array[Array[string]] rows = []
        for sum.rows to it {
            // 「抽查存活」：该类最大的 200 项里，现在还有几项真在（**只 stat** ✓ 纯读 ✓）
            string aliveTxt = "—"
            if it.cnt > 0 and it.idx >= 0 and it.idx < results.len() {
                int probe = it.cnt
                if probe > 200 { probe = 200 }
                aliveTxt = $"{rules.alive_top(results[it.idx], 200)}/{probe}"
            }
            rows.add([it.name, _str(it.cnt), rules.fmt_size(it.bytes), _str(it.skip), _str(it.kept), aliveTxt])
        }
        pt.set_rows(rows)

        Label note = SDL3.dialogLabel("「开始清理…」走的是和「一键清理」完全相同的二次确认（项数 + 预计释放量）", 12)
        Button backBtn = SDL3.createButton({w: 110, h: 34, text: "返回", type: "dark"})
        Button goBtn = SDL3.createButton({w: 170, h: 34, text: "开始清理…", type: "success"})
        goBtn.set_tip("进入与「一键清理」相同的确认弹窗；确认后才真正删除 ✓")
        var done = false
        // ⚠⚠ 原来是 `var go = false` + 回调里置 go + `runModal` 之后 `if go { requestClean() }` ——
        //   **那句永远不执行** ✗：`runModal` = pushModal + win.run()，而 win.run() 在主循环已跑时
        //   立即返回（见 sdl_window.leno）⇒ 读 `go` 时它仍是 false ⇒ 点「开始清理…」只关窗、
        //   什么也不发生（本次报的 bug 之一 ✓）⇒ 动作必须写在**按钮回调里** ✓
        //   `dlg.requestClose()` 也不能省（控件分发在窗口级 onEvent 之后 ⇒ 不补要等下一事件才关 ✗）
        backBtn.on_click(func() { done = true; dlg.requestClose() })
        goBtn.on_click(func() { done = true; dlg.requestClose(); requestClean() })
        // 标题栏 ✕ = 关闭 = 取消（TitleBar 的 ✕ 只置 closeRequested，得由调用方接 ✓）
        tb.on_close(func() { done = true; dlg.requestClose() })
        droot.add(pt, {grow: 1, shrink: 1, align: 3})
        droot.add(note, {grow: 0, shrink: 0, align: 0})
        droot.add(SDL3.dialogButtonRow([backBtn, goBtn], 16), {grow: 0, shrink: 0, align: 3})

        SDL3.runModal(dlg,
            func(Event ev): bool {
                if ev.isQuit() or ev.isWindowClose() { return false }
                if ev.isKeyDown() and ev.scancode() == Scancode.ESCAPE { return false }
                return not done
            },
            func(Renderer r) { SDL3.dialogFramePaint(r, dw, SDL3.DIALOG_TB_H + dh) }
        )
        SDL3.markFrameRedraw()
        // （「开始清理…」的动作已在按钮回调里 ⇒ 这里什么都不用做：返回/ESC/关窗 ⇒ 什么都没发生 ✓）
    }

    // ==================== ③ 注册表清理（与文件清理互相独立 ✓）====================
    // 安全三段式（缺一不可 ✓）：
    //   ① 扫描**只读** ✓（判定逻辑在 cleaner_registry.leno ⇒ 有单测 ✓）
    //   ② 点「导出备份并清理 N 项…」只把按钮变成**确认文案**（不在这一下动手 ✗）
    //   ③ **再点一次**才真删 —— 而且先把 .reg 备份写出来，**备份失败就一项都不删** ✓
    func openRegistry() {
        // ★ 纵深防御（按钮/右键菜单两处入口都要靠它兜底 ✓）：非 Windows 直接说明并返回
        if not reg.supported() {
            statusLbl.set_text("注册表清理仅 Windows 可用：本平台（" + Sys.os() + "）没有注册表")
            return
        }
        var scan = reg.scan(200)
        int dw = 1000
        int dh = 540
        // ★ 自绘标题栏（公共件 ✓）：窗口高多留 DIALOG_TB_H，内容根 setRootAt 让出该高度 ✓
        int tbH = SDL3.DIALOG_TB_H
        var dlg = SDL3.createDialogWindow({title: "注册表清理 — 先扫描，再备份，最后才删", w: dw, h: tbH + dh})
        TitleBar tb = SDL3.dialogTitleBar(dlg, "注册表清理 — 先扫描，再备份，最后才删")
        var droot = SDL3.createVBox({x: 0, y: 0, w: dw, h: dh, padX: 16, padY: 14, spacing: 8})
        dlg.setRootAt(droot, 0, tb.get_h())

        // 分类计数 + 表格行（一趟循环出 ✓）
        //   ★ 抽成闭包：**清理后要用新一轮扫描重算一遍** ✓
        //   （原来是"一次性算完就定死"⇒ 删完表格里还挂着刚删掉的项 ⇒ 看着像没生效 ✗）
        int nKey = 0
        int nRun = 0
        int nMui = 0
        Array[Array[string]] rows = []
        Label headLbl = SDL3.dialogLabel("", 14)
        var buildRows = func() {
            nKey = 0
            nRun = 0
            nMui = 0
            Array[Array[string]] rs = []
            for scan.items to it {
                string kindTxt = "MUICache"
                if it.kind == "key" {
                    kindTxt = "卸载项"
                    nKey = nKey + 1
                } eif it.reason == "开机自启指向的程序已不存在" {
                    kindTxt = "启动项"
                    nRun = nRun + 1
                } else {
                    nMui = nMui + 1
                }
                // 位置用**短形式**（只影响显示 ✓）⇒ 把宽度让给"指向的文件"这一列（最关键 ✓）
                rs.add([kindTxt, reg.short_location(it), it.name, it.target])
            }
            rows = rs
            headLbl.set_text($"扫描 {scan.keysScanned} 项：无效卸载项 {nKey} · 无效启动项 {nRun} · MUICache 失效 {nMui}")
        }
        buildRows()

        droot.add(headLbl, {grow: 0, shrink: 0, align: 0})
        droot.add(SDL3.dialogLabel(
            "判定很保守：只认「命令行里那个 exe 的绝对路径确实不存在」；cmd / msiexec / rundll32 这类宿主程序一律不判，系统组件（SystemComponent=1）直接跳过", 12),
            {grow: 0, shrink: 0, align: 0})

        Table rt = SDL3.createTable({
            headers: ["类别", "位置", "项目", "指向的（已不存在的）文件"],
            col_widths: [96.0, 210.0, 180.0, 480.0],
            zebra: true, row_h: 26, header_h: 28, font_size: 13,
            col_reorder: false, resizable: false
        })
        rt.set_rows(rows)

        // 弹窗字体没有 ✓/✗ 字形 ⇒ 文案里一律不用（实测会渲染成方框 ✗）
        // ★ 选择：删除前是否导出 .reg 备份（**默认勾上** = 安全默认 ✓）
        //   取消勾选 ⇒ "不备份直接删"：注册表**没有回收站、不可撤销** ⇒ 说明与确认文案都要讲透 ✓
        CheckBox bkChk = SDL3.createCheckBox({text: "清理前导出 .reg 备份（推荐）", checked: true, box: 18, font_size: 13})
        bkChk.set_tip("勾上：先把每一项导出成 .reg 落到桌面（备份未全部成功则一项都不删）；取消：直接删除，无法还原")
        Label note = SDL3.dialogLabel("", 12)
        Button backBtn = SDL3.createButton({w: 110, h: 34, text: "关闭", type: "dark"})
        Button goBtn = SDL3.createButton({w: 250, h: 34, text: "清理 " + _str(rows.len()) + " 项…", type: "success"})
        var done = false
        var backupOn = true      // 与勾选框同步（默认勾上 ✓）
        // 说明文案随勾选切换（把"不备份"的后果讲透 ✓）
        var refreshNote = func() {
            if rows.len() == 0 {
                note.set_text("没发现可清理的残留 —— 这台机器的卸载项 / 启动项 / MUICache 都是好的")
            } else if backupOn {
                note.set_text("点「清理 " + _str(rows.len()) + " 项…」会弹出确认框；备份写到桌面「注册表备份_<时间戳>」，双击 .reg 即可还原")
            } else {
                note.set_text("已取消备份：注册表没有回收站，删除后无法还原；若不确定，请勾回上面的备份")
            }
            SDL3.markFrameRedraw()
        }
        // 真正的清理（**确认框点了主按钮之后**才走到这里 ✓）
        var runRegClean = func() {
            if backupOn {
                // ① 先备份：**必须全部导出成功**才继续 ✓
                var bk = reg.backup(scan.items)
                if bk.exported == 0 or bk.failed > 0 {
                    goBtn.set_text("关闭")
                    note.set_text("备份未全部成功（成功 " + _str(bk.exported) + " · 失败 " + _str(bk.failed) + "）⇒ 已放弃删除，一个都没动")
                    SDL3.markFrameRedraw()
                    return
                }
            }
            // ② 再删除（用户在确认框里点过主按钮 ✓）
            var cl = reg.apply(scan.items)
            // ③ ★ 删完**立刻重扫一遍**，表格/计数按"删完的真实状态"刷新 ✓
            //   为什么不拿 cl.ok 手动剔行：注册表删除会**部分成功**（权限/占用）⇒
            //   以重新扫描为准才不会骗人 —— 删掉的不再出现，没删掉的还在表里 ✓
            scan = reg.scan(200)
            buildRows()
            rt.set_rows(rows)
            goBtn.set_text("关闭")
            goBtn.set_enabled(false)      // 已清完 ⇒ 不给再点（避免对同一批再删一次 ✓）
            string msg = "已清理 " + _str(cl.ok) + " 项（失败 " + _str(cl.failed) + "）"
            if backupOn { msg = msg + " · 备份已写到桌面，双击 .reg 可还原" }
            if cl.failed > 0 and cl.errors.len() > 0 { msg = msg + "　首条：" + cl.errors[0] }
            if rows.len() == 0 {
                msg = msg + " · 列表已刷新：已无残留"
            } else {
                msg = msg + " · 列表已刷新：还剩 " + _str(rows.len()) + " 项（多为权限不足）"
            }
            note.set_text(msg)
            SDL3.markFrameRedraw()
        }
        bkChk.on_change(func(bool v): void { backupOn = v; refreshNote() })
        // ⚠ 置 done 的按钮都要补 `dlg.requestClose()`：控件分发跑在窗口级 onEvent **之后**
        //   ⇒ 只置 done 的话，本次事件的关闭判定已经过去，弹窗要等**下一条事件**才关 ✗
        backBtn.on_click(func() { done = true; dlg.requestClose() })
        // 标题栏 ✕ = 关闭（TitleBar 的 ✕ 只置 closeRequested，得由调用方接 ✓）
        tb.on_close(func() { done = true; dlg.requestClose() })
        // ★ 点「清理」⇒ 弹**公共确认窗**（SDL3.msgBox ✓，见 sdl_dialog.leno）：文案随"是否备份"变 ✓
        goBtn.on_click(func() {
            if rows.len() == 0 { return }
            Array[string] lines = ["确认清理注册表残留？", "将删除 " + _str(rows.len()) + " 项（无效卸载项 / 启动项 / MUICache）"]
            if backupOn {
                lines.add("先导出 .reg 备份到桌面；备份未全部成功则一项都不删。")
            } else {
                lines.add("未备份：注册表没有回收站，删除后无法还原。")
            }
            lines.add("删除不可撤销；拿不准就点「取消」，回来把备份勾上。")
            SDL3.msgBox("确认清理注册表", lines,
                (if backupOn then "备份并清理" else "不备份，直接删除"),
                "取消", true, func() { runRegClean() })
        })
        if rows.len() == 0 { goBtn.set_enabled(false) }
        refreshNote()
        droot.add(rt, {grow: 1, shrink: 1, align: 3})
        droot.add(bkChk, {grow: 0, shrink: 0, align: 0})
        droot.add(note, {grow: 0, shrink: 0, align: 0})
        droot.add(SDL3.dialogButtonRow([backBtn, goBtn], 16), {grow: 0, shrink: 0, align: 0})

        SDL3.runModal(dlg,
            func(Event ev): bool {
                if ev.isQuit() or ev.isWindowClose() { return false }
                if ev.isKeyDown() and ev.scancode() == Scancode.ESCAPE { return false }
                return not done
            },
            func(Renderer r) { SDL3.dialogFramePaint(r, dw, SDL3.DIALOG_TB_H + dh) }
        )
        SDL3.markFrameRedraw()
    }

    // ==================== 工具窗（已于 2026-09-29 移除 ✓）====================
    // 历史：这里曾有一个「工具」模态窗（`openTools`）把次要动作收口，
    //   并在**打开时按当前状态**算可用性（避免常驻灰按钮像"软件坏了" ✗）。
    // 现状：那两个动作已各自成为左列的常驻按钮（预览 / 导出 / 注册表）✓，
    //   状态可用性也在各自的 on_click 里拦截 + 状态栏提示 ✓
    //   ⇒ 本函数**再无任何调用方**（真正的死代码 ✗）⇒ 删除 ✓（含只被它用到的 `_state_name` ✓）
    //   ⚠ 若将来想恢复这个"动作收口窗"，从 git 历史取即可 ✓（不必留半截代码 ✗）

    // 三联按钮的"不可用"表现：**用暗色，而不是 set_enabled** ✓
    //   为什么：Button 的禁用态会自己画一圈灰底（框架没有 disabled_bg 选项 ✗）
    //   ⇒ 与"看起来无框"的设计直接冲突 ✗；所以保持 enabled ✓、只换颜色 ✓
    //   （点击时由各自回调按状态拦截 + 状态栏提示 ✓）
    func _dim(Button b, bool dim) {
        // ⚠ 用 `var` 而不是 `Theme th` —— 本文件没有 `use ... Theme` ✗（会报未定义的类型 ✓）
        var th = theme.getTheme()
        // ★ 只调**文字色**与**图标透明度**，**绝不给图标染色** ✗
        //   原因：图标是用户从 iconfont 下载的（彩色 ✓）⇒ `image_tint` 会把它压成单色 ✗
        //   （2026-09-29 用户反馈"颜色不对"就是这个 ✓）
        if dim {
            b.set_text_color(th.txtDim)
            b.set_image_alpha(70)     // 变淡 ⇒ 一眼看出"现在不可用" ✓（颜色保留 ✓）
        } else {
            b.set_text_color(th.txt)
            b.set_image_alpha(255)
        }
    }

    // ==================== 类别行的右键菜单 ====================
    // 与 `应用/文件管理器` 同一套接线（ctxItem + on_context_will_open 动态重建 ✓）
    // ⚠ 菜单项的图标键是 **`image`**（不是 `icon` ✗）—— 之前传 `icon:` 框架根本不读，
    //   图标一直没出现 ✗（实测 + 源码 sdl_menu.leno:57 确认 ✓）⇒ 现在统一走这里 ✓
    //   图标文件由 `tools/gen_icons.leno` 生成 ✓（名字见本函数各调用点 ✓）
    func ctxItem(string label, string id, string file): Dict {
        return {label: label, id: id, image: detail.icon(file)}
    }

    // 菜单**弹出前**按行状态动态重建（框架先调本回调、再弹出 ✓）
    //   row < 0 ⇒ 右击空白处（只给全局项 ✓）
    func buildCatMenu(int row) {
        catTable.clearContextItems()
        if row < 0 {
            catTable.addContextItem(ctxItem("勾选全部类别", "checkall", "check.png"))
            catTable.addContextItem(ctxItem("全部取消勾选", "uncheckall", "uncheck.png"))
            catTable.addContextSeparator()
            // 预览作用于"已勾选项"（多选语义 ⇒ 与具体哪一行无关 ✓）⇒ 空白处也给入口 ✓
            catTable.addContextItem(ctxItem("预览已勾选项（干跑）…", "preview", "preview.png"))
            catTable.addContextItem(ctxItem("注册表清理…", "reg", "registry.png"))
            if state != "done" { catTable.setContextItemEnabled("preview", false) }
            return
        }
        bool hasRes = row < results.len()
        bool isRecycle = cats[row].id == "recyclebin"
        bool hasJunk = hasRes and _int(results[row][1]) > 0
        catTable.addContextItem(ctxItem("查看明细…（双击同效）", "detail", "detail.png"))
        catTable.addContextItem(ctxItem("打开该类目录", "opendir", "folder.png"))
        catTable.addContextItem(ctxItem("预览已勾选项（干跑）…", "preview", "preview.png"))
        catTable.addContextSeparator()
        if catTable.is_row_checked(row) {
            catTable.addContextItem(ctxItem("取消勾选本类", "uncheckrow", "uncheck.png"))
        } else {
            catTable.addContextItem(ctxItem("勾选本类", "checkrow", "check.png"))
        }
        catTable.addContextSeparator()
        catTable.addContextItem(ctxItem("清理已勾选项…", "clean", "clean.png"))
        catTable.addContextItem(ctxItem("导出报告", "export", "export.png"))
        // 按当前状态灰显（框架提供 setContextItemEnabled ✓）
        if not hasRes or isRecycle { catTable.setContextItemEnabled("detail", false) }
        if state != "done" { catTable.setContextItemEnabled("preview", false) }
        if state != "done" or not hasJunk { catTable.setContextItemEnabled("clean", false) }
        if state != "report" { catTable.setContextItemEnabled("export", false) }
    }

    // 菜单项分发（row 为右击命中的行 ✓）
    func onCatMenuPick(int row, string id) {
        if id == "detail" { openDetail(row); return }
        // 预览作用于"已勾选项"（多选语义 ✓）⇒ 与右击了哪一行无关 ✓
        if id == "preview" { openPreview(); return }
        if id == "reg" { openRegistry(); return }
        // 打开该类别的根目录（用户去人工看一眼/自己动手 ✓）
        if id == "opendir" {
            string root = ""
            if cats[row].roots.len() > 0 { root = cats[row].roots[0] }
            bool ok = detail.reveal_in_explorer(root)
            if ok { statusLbl.set_text("已在资源管理器中打开：" + root) }
            else { statusLbl.set_text("打不开这个目录 ✗：" + root) }
            SDL3.markFrameRedraw()
            return
        }
        if id == "checkrow" { catTable.set_row_checked(row, true); SDL3.markFrameRedraw(); return }
        if id == "uncheckrow" { catTable.set_row_checked(row, false); SDL3.markFrameRedraw(); return }
        if id == "checkall" { catTable.check_all(); SDL3.markFrameRedraw(); return }
        if id == "uncheckall" { catTable.uncheck_all(); SDL3.markFrameRedraw(); return }
        // 复用**既有安全路径**（requestClean 自带"项数+预计释放量"确认弹窗 ✓）
        if id == "clean" { requestClean(); return }
        if id == "export" { exportReport(); return }
    }

    // ==================== 导出报告（报告态可用 ✓） ====================
    // 直接存到桌面（不弹文件框 ⇒ 少一次交互、少一个失败点）；路径写回状态栏 ✓
    func exportReport() {
        try {
            // 同一个坑：`ti.now()` 是 int 时间戳（不是数组 ✗）⇒ 用 ti.format 格式化 ✓
            int nowTs = ti.now()
            string ts = ti.format(nowTs, "%Y-%m-%d %H:%M:%S")
            string fname = "清理报告_" + ti.format(nowTs, "%Y%m%d_%H%M%S") + ".txt"
            string desk = _env_or("USERPROFILE", _tmpdir()) + "\\Desktop"
            if not dirs.exists(desk) { desk = _tmpdir() }
            string path = desk + "\\" + fname
            var f = files.open(path, "w")
            f.writeln("电脑清理大师 — 清理报告")
            f.writeln($"时间：{ts}")
            f.writeln($"耗时：{_fmt_secs(cleanElapsedSec)}")
            f.writeln("")
            f.writeln($"已清理：{cleanedTotal} 项")
            f.writeln($"释放：{rules.fmt_size(freedTotal)}")
            f.writeln($"跳过：{failedTotal} 项（文件被其他程序占用）")
            string recy = "未处理"
            if recycleCleaned { recy = "已清空" }
            if recycleTimedOut { recy = "后台进行中" }
            f.writeln($"回收站：{recy}")
            if cumFreed > 0 { f.writeln($"累计释放：{rules.fmt_size(cumFreed)}") }
            f.writeln("")
            f.writeln("---- 分类明细 ----")
            for 0 : cats.len() - 1 to i {
                var c = cats[i]
                if c.id == "recyclebin" {
                    f.writeln($"  {c.name}：{recy}")
                    continue
                }
                int ci = -1
                for 0 : cleanCatIdx.len() - 1 to k {
                    if cleanCatIdx[k] == i { ci = k }
                }
                string line = $"  {c.name}："
                if ci >= 0 and ci < cleanCatStats.len() {
                    var s = cleanCatStats[ci]
                    line = line + $"已清理 {_int(s[0])} 项 · 跳过 {_int(s[1])} 项 · 释放 {rules.fmt_size(_int(s[2]))}"
                } else {
                    if in_int(cleanCheckedIdx, i) { line = line + "无垃圾" } else { line = line + "未勾选" }
                }
                if i < results.len() {
                    line = line + $"（扫描：{_int(results[i][1])} 项 / {rules.fmt_size(_int(results[i][0]))}）"
                }
                f.writeln(line)
            }
            f.writeln("")
            f.writeln("提示：跳过的项多为被程序占用的文件 —— 关闭浏览器/编辑器等程序后点「再扫一次」即可清理。")
            f.close()
            statusLbl.set_text($"报告已保存到桌面：{fname}")
        } catch e {
            statusLbl.set_text($"导出失败：{_str(e)}")
        }
        SDL3.markFrameRedraw()
    }

    // ==================== 自证截屏（★ 2026-10-01 跨平台）====================
    // 原先：`Win32.captureScreen()`（GDI 抓**整个桌面**）⇒ 仅 Windows 可用 ✗
    // 现在：SDL3 读**本窗口的渲染结果**（`Renderer.readPixelsAt`）⇒ Windows/Linux/macOS 通用 ✓
    //
    // ⚠ 时机是这里最讲究的一点（结论照抄自 `leno_gui\应用\数据看板\dashboard.leno` 的实测 ✓）：
    //   · 必须读在**所有控件/弹层绘制之后、present 之前** ⇒ 只有 `win.setOverlay` 满足 ✓
    //     放在 `win.run` 的 onRender 回调里读 ⇒ 只会拿到"只有底色"的空白帧 ✗
    //     放在**定时器**里读更不行：那时帧可能已提交，后台缓冲内容未定义 ✗（偶发黑图/花屏）
    //   · 而 `--autotest` 的收尾是定时器驱动的 ⇒ 定时器只**登记**路径，真正的读像素交给叠加层 ✓
    //   ⇒ 于是多了一个"等截图落地"的异步步骤（见 autoStep 与 shotWaitExpired ✓）
    func captureTo(string path) {
        shotPath = path
        shotSaved = false
        shotWaitTicks = 0
        SDL3.markFrameRedraw()      // 立刻出一帧（否则要等下一次交互才轮到叠加层 ✗）
    }

    // 叠加层：帧已完整 ⇒ 此刻读像素才是真画面 ✓（每帧被调用；没登记截图就立刻返回 ✓）
    func shotOverlay(Renderer r) {
        if shotPath == "" { return }
        string path = shotPath
        shotPath = ""
        try {
            var sz = win.getSize()
            var s = r.readPixelsAt(0, 0, sz.w, sz.h)
            if s == null {
                print("SHOT FAILED " + path + " : " + SDL3.getError())
                shotSaved = true               // 失败也算"处理完"⇒ 不让自动化一直等 ✗
                return
            }
            bool ok = SDL3.saveImagePNG(s, path)
            SDL3.destroySurface(s)             // ⚠ 读出来的 surface 要自己释放（否则每张漏一个 ✗）
            print("SHOT SAVED " + path + " ok=" + _str(ok))
            shotSaved = true
        } catch e {
            print("SHOT ERROR " + path + " : " + _str(e))
            shotSaved = true
        }
    }

    // 等截图落地：跨平台截屏是"下一帧"才完成 ⇒ 自动化必须等它再退 ✓
    //   返回 true = 可以继续（已落地 / 等太久放弃）；false = 再等一轮 ✓
    //   ⚠ 必须有安全阀：万一叠加层不跑（窗口被最小化等）也**绝不能卡死** ✓
    func shotWaitExpired(string tag): bool {
        if shotSaved { return true }
        shotWaitTicks = shotWaitTicks + 1
        if shotWaitTicks < 40 { return false }
        print("SHOT WAIT TIMEOUT (" + tag + ") —— 继续收工")
        return true
    }

    // ==================== 50ms 轮询 ====================
    func pollTick() {
        if state == "scanning" { pollScan() }
        if state == "cleaning" { pollClean() }
    }

    func pollScan() {
        try {
            // 1) 排空 channel 增量（[idx, sizeDelta, cntDelta]）
            if scanCh is Channel {
                var ch = scanCh
                int n = 0
                while n < 4000 {
                    var msg = ch.try_receive()
                    if msg == null { break }
                    if msg is Array => mv {
                        liveSize = liveSize + _int(mv[1])
                        liveCnt = liveCnt + _int(mv[2])
                    }
                    n = n + 1
                }
            }
            // 2) 全部线程完成且 channel 排空 ⇒ join 收尾
            bool allDone = true
            for 0 : scanThreads.len() - 1 to i {
                if scanThreads[i] is Thread => t {
                    if t.state() == "running" { allDone = false }
                }
            }
            if allDone {
                if scanCh is Channel {
                    if scanCh.len() > 0 { return }
                }
                finishScan()
            }
        } catch e {
            state = "idle"
            mainBtn.set_enabled(true)
            mainBtn.set_text("立即扫描")
            ring.set_mode("idle")
            statusLbl.set_text($"扫描出错: {_str(e)}")
            SDL3.markFrameRedraw()
        }
    }

    func pollClean() {
        try {
            pollN = pollN + 1
            if pollN % 25 == 0 {
                string st = "recycle=?"
                if recycleThread is Thread => rt { st = $"recycle={rt.state()}" } else { st = "recycle=null" }
                for 0 : cleanThreads.len() - 1 to i {
                    if cleanThreads[i] is Thread => t { st = $"{st} w{i}={t.state()}" }
                }
                int chLen = 0
                if cleanCh is Channel { chLen = cleanCh.len() }
                _dlog($"poll tick={pollN} {st} chLen={chLen} attempted={liveAttempted}")
            }
            // 1) 排空清理进度 channel（[attempted增量, cleaned增量, freed增量]）
            if cleanCh is Channel {
                var ch = cleanCh
                int n = 0
                while n < 4000 {
                    var msg = ch.try_receive()
                    if msg == null { break }
                    if msg is Array => mv {
                        liveAttempted = liveAttempted + _int(mv[0])
                        liveCleaned = liveCleaned + _int(mv[1])
                        liveFreed = liveFreed + _int(mv[2])
                    }
                    n = n + 1
                }
            }
            // 2) 回收站线程（超时弃管：SHEmptyRecycleBin 对大/被占用回收站可能阻塞很久
            //    ⇒ 8 秒没结束就不再等它，线程在后台继续尝试；VM active_threads 注册表保活 ⇒ 弃引安全 ✓）
            bool allDone = true
            if recycleThread is Thread => rt {
                if rt.state() == "running" {
                    recycleTicks = recycleTicks + 1
                    if recycleTicks > 160 {
                        _dlog("recycle TIMEOUT — abandon (thread continues in background)")
                        recycleTimedOut = true
                        recycleThread = null
                    } else {
                        allDone = false
                    }
                } else {
                    recycleCleaned = rt.join() as bool
                    recycleThread = null
                }
            }
            // 3) 删除线程
            for 0 : cleanThreads.len() - 1 to i {
                if cleanThreads[i] is Thread => t {
                    if t.state() == "running" { allDone = false }
                }
            }
            // 3b) 看门狗：30 秒零进度 ⇒ 弃管所有剩余线程，强制进报告（任何线程卡死都不会永久「清理中」）
            if liveAttempted != watchdogAttempted {
                watchdogAttempted = liveAttempted
                watchdogLastTick = pollN
            }
            if not allDone and pollN - watchdogLastTick > 600 {
                _dlog($"WATCHDOG: no progress for 30s (attempted={liveAttempted}/{cleanTotalUnits}) — abandon {cleanThreads.len()} workers + recycle")
                recycleTimedOut = true
                recycleThread = null
                cleanThreads = []
                allDone = true
            }
            // 4) 实时进度（按已处理单元数推进 + 状态栏逐项刷新）；环 = 已释放 ÷ 已发现 ✓
            if totalSize > 0 {
                float fr = _float(liveFreed) / _float(totalSize)
                if fr > 1.0 { fr = 1.0 }
                ring.set_value(fr)
            }
            if cleanTotalUnits > 0 {
                float frac = _float(liveAttempted) / _float(cleanTotalUnits)
                if frac > 1.0 { frac = 1.0 }
                cleanBar.set_value(2.0 + 96.0 * frac)
            }
            statusLbl.set_text($"清理中：已清理 {liveCleaned}/{cleanTotalUnits} 项 · 释放 {rules.fmt_size(liveFreed)}")
            timeLbl.set_text(_fmt_secs(_float(SDL3.getTicks() - cleanStartTick) / 1000.0))
            updateSummary()
            SDL3.markFrameRedraw()
            // 5) 全部完成且 channel 排空 ⇒ 收尾
            if allDone {
                if cleanCh is Channel {
                    if cleanCh.len() > 0 { return }
                }
                finishClean()
            }
        } catch e {
            state = "idle"
            mainBtn.set_enabled(true)
            mainBtn.set_text("立即扫描")
            statusLbl.set_text($"清理出错: {_str(e)}")
            SDL3.markFrameRedraw()
        }
    }

    // ==================== 自动化驱动（--autotest / --autoclean） ====================
    // ★ 为什么必须是**定时器**、而不能写在 `win.run` 的事件回调里（2026-09-28 实测踩坑）：
    //   事件回调只在**有事件**时才被调用 ✗ —— 无人值守跑自动化时，扫描完成（`done`）之后
    //   可能**长时间一个事件都没有**（没有鼠标移动、没有键盘、没有焦点变化）⇒
    //   收尾那几行（截图 + 退出）**永远轮不到执行** ✗ ⇒ 看起来就是"应用卡死不退"
    //   （作者本人据此误判成 VM 竞态，白白查了好几轮 ✗；真相：移动一下鼠标它立刻退出 ✓）
    //   定时器 150ms 一次、与事件无关 ⇒ 自动化变成**确定性** ✓
    func autoStep() {
        if not autoTest { return }
        if state == "idle" { startScan(); return }

        if autoClean {
            // ① 扫到 done ⇒ 注入合成类别 + 回收站，跑**真实清理管线**（只动 fixture ✓）
            if state == "done" and not injected {
                injected = true
                var res = rules.scan_worker([fixtureBase], "", null, 0, wl.encode())
                Array[string] froots = [fixtureBase]
                cats.add(new CleanCategory(id = "fixture", name = "测试垃圾", roots = froots))
                results.add(res)
                _dlog($"fixture scanned size={res[0]} elems={res.len()}")
                // fixture + 回收站；按 id 查而不是写死下标 ✓
                Array[int] ph1 = [cats.len() - 1]
                int rbIdx = cat_index("recyclebin")
                if rbIdx >= 0 { ph1.add(rbIdx) }
                beginClean(ph1)
                return
            }
            // ② 报告态：先**登记**截图（叠加层下一帧真存），存完再跑 phase2（真实类别，不含回收站）✓
            if state == "report" {
                if not shotReport {
                    shotReport = true
                    captureTo(dirs.join(_tmpdir(), "cleaner_master_report.png"))
                    return                       // ★ 让出一帧 ⇒ 叠加层才轮到截图 ✓
                }
                if not shotWaitExpired("report") { return }
                if not phase2 {
                    phase2 = true
                    _dlog("=== phase2: real categories (no recycle) ===")
                    Array[int] ph2 = []
                    for ["temp", "browser", "wer", "d3d", "thumbs"] to cid {
                        int ix = cat_index(cid)
                        if ix >= 0 { ph2.add(ix) }
                    }
                    beginClean(ph2)
                } else {
                    print("AUTOCLEAN FINISHED")
                    _dlog("=== autoclean finished ===")
                    _exit(0)
                }
            }
            return
        }

        // 纯 --autotest：扫到 done ⇒ **登记**截图；等叠加层真存完再退出 ✓
        //   （★ 不能"登记完立刻 _exit"：那样叠加层根本没机会跑 ⇒ 得到 0 字节或干脆没文件 ✗）
        if state == "done" and not shotDone {
            shotDone = true
            captureTo(dirs.join(_tmpdir(), "cleaner_master_autotest.png"))
            return                               // ★ 让出一帧给叠加层 ✓
        }
        if state == "done" and shotDone {
            if not shotWaitExpired("autotest") { return }
            print("AUTOTEST EXIT")
            _exit(0)
        }
    }

    // ==================== 主入口 ====================
    func run() {
        for _args() to a {
            if a == "--autotest" { autoTest = true }
            if a == "--autoclean" { autoClean = true; autoTest = true }
        }
        // 保留清单：启动即加载 ✓
        //   读不到/文件损坏 ⇒ 模块内部会退回**内置保护**（绝不能"读不到就零保护" ✗）
        wl.load()
        if not autoTest { _console(false) }
        if autoClean {
            // 造合成垃圾（只清这里 ⇒ 不动用户真实文件）
            fixtureBase = dirs.join(_tmpdir(), "cmaster_autoclean")
            if dirs.exists(fixtureBase) { dirs.delete(fixtureBase) }
            dirs.mkdir(fixtureBase)
            for 0 : 199 to i {
                files.write(dirs.join(fixtureBase, "junk_" + _str(i) + ".tmp"), "0123456789ABCDEF0123456789ABCDEF")
            }
            _dlog("=== autoclean start (fixture 200 files) ===")
        }
        SDL3.ttfInit()
        SDL3.setTheme(SDL3.lightTheme())
        win = SDL3.createWindow({title: "电脑清理大师", w: 900, h: 620, flags: 0x20})
        if not win.ok { SDL3.ttfQuit(); return }
        // ★ 先把类别建出来（2026-09-29 调整）：`setupUI()` 里要用它算**类别图标列表**
        //   （`row_images` ✓），`updateSummary()` 的 idle 文案也要报"几类可清理" ✓
        //   ⇒ 必须排在 setupUI 之前 ✓（顺带解决了空态表格没内容的问题 ✓）
        cats = rules.build_categories()
        setupUI()
        refreshDrive()
        loadLastClean()
        refreshRows()
        updateSummary()
        pollTimer = win.addTimer(50, func() { pollTick() })
        if autoTest {
            // ★ 自动化必须走**定时器**（与"有没有事件"无关 ✓）—— 详见 autoStep() 的注释 ✓
            win.addTimer(150, func() { autoStep() })
        }
        // ★ 截图钩子必须挂**叠加层**：它在所有控件/弹层之后、present 之前调用
        //   ⇒ 此刻的帧才是完整的（放 onRender 只会拿到空白底帧 ✗，见 shotOverlay 的注释 ✓）
        win.setOverlay(func(Renderer r) { shotOverlay(r) })
        win.run(
            func(Event ev): bool {
                // ⚠ 自动化（--autotest / --autoclean）**已全部搬到 autoStep()** ✓
                //   为什么：本回调只在**有事件**时被调用 ✗ —— 无人值守时 `done` 之后可能
                //   长时间没有任何事件（没有鼠标/键盘/焦点变化）⇒ 收尾判定永远轮不到 ⇒
                //   表现为"应用不退出"，极易被误判成卡死/VM 竞态 ✗
                //   （实测：移动一下鼠标它立刻退出 ⇒ 证实只是"在等事件" ✓）
                if ev.isQuit() or ev.isWindowClose() { return false }
                if titleBar.is_close_requested() {
                    titleBar.clear_close_request()
                    return false
                }
                if ev.isKeyDown() and ev.scancode() == Scancode.ESCAPE { return false }
                return true
            },
            func(Renderer r) { }
        )
        SDL3.ttfQuit()
    }
}

// ==================== 程序入口 ====================
main() {
    CleanerMaster app = new CleanerMaster()
    app.run()
}
