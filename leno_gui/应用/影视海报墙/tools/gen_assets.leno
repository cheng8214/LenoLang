// tools/gen_assets.leno — 程序化生成「影视海报墙」的演示海报 + 图标（离线、无窗口 ✓）
//
// 产物（都是普通 PNG ⇒ 换成真海报只要**覆盖同名文件**，应用代码一行都不用改 ✓）：
//   ..\images\p01.png … p22.png   竖版海报 300×450（抽象底图 + 片名 + 年份/分类 ✓）
//   ..\images\app.png             窗口图标 64×64（橙色圆角方块 + 白色胶片格 ✓）
//   ..\images\*.png（32×32 纯白形状，控件靠 image_tint 染色 ✓）：
//     search.png 放大镜 / funnel.png 漏斗 / chevron_left.png 左箭头
//     chevron_down.png 下箭头 / chevron_up.png 上箭头 / filter.png 筛选（三滑杆）/ play.png 播放三角
//
// 用法：build\leno.exe --no-cache "leno_gui\应用\影视海报墙\tools\gen_assets.leno"
//   ⚠ 片名清单来自 ..\movie_data.leno（**同一份数据** ⇒ 海报与应用不会两边漂移 ✓）
//   ⚠ 本脚本只写应用自己的 ..\images\（可随时重生成 ✓）
//   ⚠ 照 gen_icons.leno 的实测结论：**每张图各自 clear → 画 → 立刻 readPixels → 存盘** ✓
//     （一次 clear/setColor 覆盖多张图时，先画的几张会串色 ✗）
import "SDL3" as SDL3
import "../movie_data.leno" as data
import dirs
use SDL3.(Renderer, WindowFlag, Font, Color)
use data.Movie

// ==================== 尺寸 ====================
const int PW = 300          // 海报宽
const int PH = 450          // 海报高（2:3）
const int IC = 32           // 图标边长
const int AC = 64           // 窗口图标边长
const float PI = 3.14159265358979

// ==================== 调色板 ====================
// 海报底色（深→亮两段渐变）；下标 = 影片序 % len ✓
Array[Color] PAL_A = [#0E1A33FF, #240E16FF, #0C1A14FF, #1E1028FF, #241708FF,
                      #101018FF, #0A1A24FF, #201C0AFF, #180E20FF, #08161EFF]
Array[Color] PAL_B = [#1F4A8CFF, #7A1F35FF, #1F6B4AFF, #5A2A7AFF, #7A4A14FF,
                      #3A3A5CFF, #156A88FF, #6B5A14FF, #4A1E5CFF, #14607AFF]
// 强调色（半透明 ⇒ 压在渐变上自然 ✓）
Array[Color] ACC   = [#F5A62388, #4FC3F788, #E85A7188, #B07CFF88, #7CD67C88,
                      #FFD16688, #62D8C888, #FF8A6588]

// ==================== 颜色工具 ====================
func mix(Color a, Color b, float t): Color {
    if t < 0.0 { t = 0.0 }
    if t > 1.0 { t = 1.0 }
    float ar = _float(SDL3.colorR(a)), ag = _float(SDL3.colorG(a)), ab = _float(SDL3.colorB(a))
    float br = _float(SDL3.colorR(b)), bg = _float(SDL3.colorG(b)), bb = _float(SDL3.colorB(b))
    return SDL3.packColor(_int(ar + (br - ar) * t), _int(ag + (bg - ag) * t), _int(ab + (bb - ab) * t), 255)
}
func with_a(Color c, int a): Color { return SDL3.packColor(SDL3.colorR(c), SDL3.colorG(c), SDL3.colorB(c), a) }

// ==================== 绘制基元（照 gen_icons.leno 的既有手法 ✓）====================
// 粗线：中线 + 两侧各偏一条（模拟线宽 ✓）
func thickLine(Renderer r, float x1, float y1, float x2, float y2, float w) {
    var dx = x2 - x1
    var dy = y2 - y1
    var len = dx * dx + dy * dy
    if len < 0.0001 { return }
    var ln = _sqrt(len)
    var nx = (0.0 - dy) / ln
    var ny = dx / ln
    var o = w / 2.0
    r.drawLine(x1 + nx * o, y1 + ny * o, x2 + nx * o, y2 + ny * o)
    r.drawLine(x1, y1, x2, y2)
    r.drawLine(x1 - nx * o, y1 - ny * o, x2 - nx * o, y2 - ny * o)
}
func _sqrt(float v): float {
    // 牛顿迭代（3 次足够画图用；避免为一个开方引入 maths 模块 ✓）
    if v <= 0.0 { return 0.0 }
    float x = v
    for 0 : 9 to i { x = (x + v / x) / 2.0 }
    return x
}
func ring(Renderer r, float cx, float cy, float rad, float w, int segs) {
    float step = 2.0 * PI / _float(segs)
    for 0 : segs - 1 to i {
        float a1 = _float(i) * step
        float a2 = _float(i + 1) * step
        thickLine(r, cx + rad * _cos(a1), cy + rad * _sin(a1),
                     cx + rad * _cos(a2), cy + rad * _sin(a2), w)
    }
}
// 用泰勒级数算 cos/sin（同上：不引 maths 模块也能画 ✓）
func _cos(float a): float {
    float a2 = a * a
    return 1.0 - a2 / 2.0 + a2 * a2 / 24.0 - a2 * a2 * a2 / 720.0
}
func _sin(float a): float {
    float a2 = a * a
    return a - a * a2 / 6.0 + a * a2 * a2 / 120.0 - a * a2 * a2 * a2 / 5040.0
}
// 竖直渐变：逐行填 1px 高的矩形（300 行 ≈ 300 次 fillRect，离线生成不在乎这点开销 ✓）
func vgrad(Renderer r, float w, float h, Color top, Color bot) {
    for 0 : _int(h) - 1 to i {
        float t = _float(i) / (h - 1.0)
        r.setColor(mix(top, bot, t))
        r.fillRect(0.0, _float(i), w, 1.0)
    }
}

// ==================== 海报（300×450）====================
// 构图按序轮换（4 种），保证一排看过去不重样 ✓
func poster(Renderer r, int idx, string title, string year, string cat,
            Array[Font] bigs, Array[float] sizes, Font small, Font tiny) {
    // ① 底色渐变
    vgrad(r, _float(PW), _float(PH), PAL_A[idx % PAL_A.len()], PAL_B[idx % PAL_B.len()])

    // ② 抽象图形
    Color ac = ACC[idx % ACC.len()]
    int pat = idx % 4
    if pat == 0 {
        r.setColor(ac)
        r.fillCircle(232.0, 132.0, 118.0)
        r.setColor(with_a(ac, 60))
        r.fillCircle(232.0, 132.0, 190.0)
    } eif pat == 1 {
        r.setColor(with_a(ac, 150))
        r.fillRect(0.0, 96.0, 300.0, 26.0)
        r.setColor(with_a(ac, 90))
        r.fillRect(0.0, 138.0, 300.0, 26.0)
        r.setColor(with_a(ac, 50))
        r.fillRect(0.0, 180.0, 300.0, 26.0)
    } eif pat == 2 {
        r.setColor(ac)
        r.drawTriangleC(96.0, 170.0, 300.0, 0.0, with_a(ac, 170))
        r.setColor(with_a(ac, 90))
        r.drawTriangleC(232.0, 300.0, 210.0, 180.0, with_a(ac, 90))
    } else {
        for 0 : 5 to k {
            r.setColor(with_a(ac, 150 - k * 22))
            r.fillCircle(150.0, 176.0, 26.0 + _float(k) * 26.0)
        }
        r.setColor(with_a(#FFFFFF, 26))
        r.fillRect(238.0, 0.0, 10.0, 450.0)
    }

    // ③ 底部渐隐（压暗 ⇒ 片名可读 ✓）
    r.setColor(#00000055)
    r.fillRect(0.0, 250.0, 300.0, 200.0)
    r.setColor(#00000066)
    r.fillRect(0.0, 320.0, 300.0, 130.0)
    r.setColor(#00000088)
    r.fillRect(0.0, 386.0, 300.0, 64.0)

    // ④ 顶部装饰：小圆点 + 细线（像片头的"上映标记"✓）
    r.setColor(with_a(#FFFFFF, 120))
    r.fillCircle(24.0, 26.0, 4.0)
    r.fillRect(34.0, 24.5, 26.0, 3.0)

    // ⑤ 片名（按实测宽度选字号 ⇒ 长片名也不会溢出 ✓）
    Font ft = pick_font(bigs, title, 252.0)
    var[float, float](tw, th) = ft.measureString(title)
    float tx = (300.0 - tw) / 2.0
    float ty = 342.0 - th
    r.setColor(#00000099)                       // 先画一层阴影（压在渐变上也清楚 ✓）
    r.drawText(ft, title, tx + 1.5, ty + 2.0, #00000099)
    r.setColor(#FFFFFFFF)
    r.drawText(ft, title, tx, ty, #FFFFFFFF)

    // ⑥ 年份 / 分类（片名下方小字，居中 ✓）
    string sub = year + "  " + cat
    var[float, float](sw, sh) = tiny.measureString(sub)
    r.drawText(tiny, sub, (300.0 - sw) / 2.0, 360.0, #E8ECF4CC)

    // ⑦ 左下角一条强调色短线（当作海报的"厂标"✓）
    r.setColor(ac)
    r.fillRect(20.0, 404.0, 34.0, 4.0)
    r.setColor(with_a(#FFFFFF, 150))
    r.drawText(small, "LENO  PICTURES", 20.0, 416.0, with_a(#FFFFFF, 150))
}

// 按宽度挑字号（字号梯子预先建好 ⇒ 每张海报不再新建字体 ✓）
func pick_font(Array[Font] fs, string t, float maxW): Font {
    for 0 : fs.len() - 1 to i {
        var[float, float](w, h) = fs[i].measureString(t)
        if w <= maxW { return fs[i] }
    }
    return fs[fs.len() - 1]
}

// ==================== 图标（纯白形状 ⇒ 控件可 tint 染色 ✓）====================
func icon_search(Renderer r) {
    ring(r, 14.0, 14.0, 8.0, 2.6, 40)
    thickLine(r, 19.5, 19.5, 26.0, 26.0, 3.2)
}
func icon_funnel(Renderer r) {
    r.fillRect(5.0, 8.0, 22.0, 3.0)
    r.fillRect(8.5, 15.0, 15.0, 3.0)
    r.fillRect(12.0, 22.0, 8.0, 3.0)
}
func icon_chevron_left(Renderer r) {
    thickLine(r, 20.0, 8.0, 12.0, 16.0, 2.8)
    thickLine(r, 12.0, 16.0, 20.0, 24.0, 2.8)
}
func icon_chevron_down(Renderer r) {
    thickLine(r, 8.0, 13.0, 16.0, 21.0, 2.8)
    thickLine(r, 16.0, 21.0, 24.0, 13.0, 2.8)
}
func icon_chevron_up(Renderer r) {
    thickLine(r, 8.0, 21.0, 16.0, 13.0, 2.8)
    thickLine(r, 16.0, 13.0, 24.0, 21.0, 2.8)
}
// 筛选：三条滑杆 + 各自的手柄（比"漏斗"更贴参考图的"菜单键筛选"✓）
func icon_filter(Renderer r) {
    r.fillRect(5.0, 9.0, 22.0, 2.4)
    r.fillRect(5.0, 16.0, 22.0, 2.4)
    r.fillRect(5.0, 23.0, 22.0, 2.4)
    r.fillCircle(11.0, 10.2, 4.0)
    r.fillCircle(22.0, 17.2, 4.0)
    r.fillCircle(14.0, 24.2, 4.0)
}
// 播放：三点连成的右向三角（比 drawTriangle 的朝向更可控 ✓）
func icon_play(Renderer r) {
    thickLine(r, 11.0, 7.0, 11.0, 25.0, 2.6)
    thickLine(r, 11.0, 7.0, 25.0, 16.0, 2.6)
    thickLine(r, 25.0, 16.0, 11.0, 25.0, 2.6)
}
// 窗口图标：橙色圆角方块 + 白色胶片格
func icon_app(Renderer r) {
    r.setColor(#F5A623FF)
    r.fillRoundedRect(2.0, 2.0, 60.0, 60.0, 14.0)
    r.setColor(#FFFFFFFF)
    r.fillRoundedRect(12.0, 14.0, 40.0, 36.0, 5.0)
    r.setColor(#F5A623FF)
    r.fillRect(16.0, 20.0, 6.0, 6.0)
    r.fillRect(16.0, 30.0, 6.0, 6.0)
    r.fillRect(16.0, 40.0, 6.0, 6.0)
    r.fillRect(42.0, 20.0, 6.0, 6.0)
    r.fillRect(42.0, 30.0, 6.0, 6.0)
    r.fillRect(42.0, 40.0, 6.0, 6.0)
}

// ==================== 入口 ====================
main() {
    // 产物目录 = 应用目录下的 images\（本脚本在 tools\ 里跑 ⇒ 先退一层 ✓）
    string appDir = dirs.dirname(dirs.res_dir())
    string outDir = dirs.join(appDir, "images")
    if not dirs.exists(outDir) {
        try {
            dirs.mkdir_p(outDir)
        } catch e {
            print("[gen] 建目录失败：" + outDir)
            return
        }
    }
    print("[gen] 输出目录：" + outDir)

    SDL3.ttfInit()
    var win = SDL3.createWindow({title: "asset-gen", w: PW, h: PH, flags: WindowFlag.HIDDEN})
    if not win.ok {
        print("[gen] createWindow 失败：" + SDL3.getError())
        SDL3.ttfQuit()
        return
    }
    var r = SDL3.createRenderer(win.getHandle())

    // 字体：小字 2 个 + 片名字号梯子（由大到小 ⇒ pick_font 取第一个放得下的 ✓）
    Font fSmall = SDL3.acquireFontAuto(11.0)
    Font fTiny = SDL3.acquireFontAuto(15.0)
    Array[float] sizes = [54.0, 46.0, 40.0, 34.0, 29.0, 25.0, 21.0]
    Array[Font] bigs = []
    for 0 : sizes.len() - 1 to i { bigs.add(SDL3.acquireFontAuto(sizes[i])) }

    // ---------- 海报（每张：清屏 → 画 → 取像素 → 存盘 ✓）----------
    var ms = data.movies()
    int ok = 0
    for 0 : ms.len() - 1 to i {
        Movie m = ms[i]
        r.clearColor(#00000000)
        poster(r, i, m.title, m.year, m.cat, bigs, sizes, fSmall, fTiny)
        var s = r.readPixelsAt(0, 0, PW, PH)
        if SDL3.saveImagePNG(s, dirs.join(outDir, m.file)) { ok = ok + 1 }
        else { print("[gen] 海报失败：" + m.file) }
    }
    print("[gen] 海报 " + _str(ok) + "/" + _str(ms.len()))

    // ---------- 图标 ----------
    Array[string] names = ["search.png", "funnel.png", "chevron_left.png",
                           "chevron_down.png", "filter.png", "play.png", "chevron_up.png"]
    int iok = 0
    for 0 : names.len() - 1 to i {
        r.clearColor(#00000000)
        r.setColor(#FFFFFFFF)                 // 纯白形状（控件用 image_tint 染色 ✓）
        if i == 0 { icon_search(r) }
        eif i == 1 { icon_funnel(r) }
        eif i == 2 { icon_chevron_left(r) }
        eif i == 3 { icon_chevron_down(r) }
        eif i == 4 { icon_filter(r) }
        eif i == 5 { icon_play(r) }
        eif i == 6 { icon_chevron_up(r) }
        var s = r.readPixelsAt(0, 0, IC, IC)
        if SDL3.saveImagePNG(s, dirs.join(outDir, names[i])) { iok = iok + 1 }
        else { print("[gen] 图标失败：" + names[i]) }
    }
    print("[gen] 图标 " + _str(iok) + "/" + _str(names.len()))

    // ---------- 窗口图标（64×64，窗要能装下 ⇒ 换一个 64×64 的隐藏窗 ✓）----------
    win.destroy()
    var w2 = SDL3.createWindow({title: "icon-gen", w: AC, h: AC, flags: WindowFlag.HIDDEN})
    if w2.ok {
        var r2 = SDL3.createRenderer(w2.getHandle())
        r2.clearColor(#00000000)
        icon_app(r2)
        var s2 = r2.readPixelsAt(0, 0, AC, AC)
        if SDL3.saveImagePNG(s2, dirs.join(outDir, "app.png")) { print("[gen] app.png ok") }
        else { print("[gen] app.png 失败") }
    }

    print("[gen] 完成 ⇒ " + outDir)
    SDL3.quit()
}
