// movie_wall.leno — 影视海报墙（暗色媒体库：顶栏 + 左侧分类导航 + 可滚动海报网格）
//
// 界面构成（对着参考图搭的 ✓）：
//   ① 自绘标题栏 TitleBar —— 窗口控制（去系统边框 ✓）
//   ② 顶栏 HBox —— 返回箭头 + 「电影（共 N 部）」+ 搜索框 + 「菜单键筛选」
//   ③ 左侧导航 VBox（整条底色带 ✓）—— 来源选择 / 搜索 / 全部（橙色胶囊）/ 分类项 / 底部「更多」
//   ④ 右侧 ScrollView + GridLayout —— 海报网格（**列数随窗口宽度自适应** ✓）
//      卡片 = 库里的新控件 `Card`（图片 + 片名 + 年份/分类 + 右上角评分角标 ✓）
//
// 运行：build\leno.exe leno_gui\应用\影视海报墙\movie_wall.leno
// 资源：images\*.png（`tools\gen_assets.leno` 程序化生成；可直接换成真海报同名覆盖 ✓）
//
// 几个实现要点（都是踩过才写下的 ✓）：
//   · 侧栏用 **VBox + bg_color**（框架 2026-10-09 起容器自带底色 ✓）而不是 Panel：
//     Panel 的子控件走**绝对坐标**、且 `Panel.set_pos()` 只挪自己 ⇒ 放进自动布局就错位 ✗
//   · 卡片不复用「Panel + ImageView + Label」拼：同样会错位（见 sdl_card.leno 头部说明 ✓）
//     ⇒ 用新加的 `Card` 控件（一个 Widget 自己画完图/角标/文字 ✓）
//   · 网格列数自适应：`GridLayout.set_cols()`（本次补的运行时 setter ✓）+
//     每帧用 ScrollView 的**实际宽度**反推列数（窗口缩放 ⇒ 列数立刻跟着变 ✓）
//   · 筛选/搜索都是「同一批 Card 对象重新 add 进网格」（`grid.clear()` 只清布局，
//     不 dispose 卡片 ⇒ 纹理不会来回重建/泄漏 ✓ —— 见 sdl_gridlayout.leno 的 clear ✓）
//   · 闭包捕获**按位置分叉**（2026-10-13 实测澄清 ✓）：**循环体内声明的变量 = 值捕获**
//     （每轮各一份 ⇒ 循环里每个回调各记各的下标，不会互相串 ✓）；
//     循环外的局部量/模块级/字段 = **by-upvalue（实时）** ⇒ 后改也读得到 ✓
//     （金标准 `assert/test_closure_value_capture.leno`；别再说成"闭包一律按值捕获" ✗）
import "SDL3" as SDL3
import "./movie_data.leno" as data
import strings
use SDL3.(Event, Renderer, Scancode, Window, TitleBar, Button, Label, Edit, Card,
          HBox, VBox, ScrollView, GridLayout, RingProgress, Font, TabControl, Table)
use data.Movie

// ==================== 尺寸 / 调色板 ====================
const int WIN_W = 1180
const int WIN_H = 780
const int TB_H = 34          // 自绘标题栏高度
const int HEADER_H = 62      // 顶栏高度
const int SIDE_W = 200       // 侧栏宽度
const int CARD_W = 172       // 卡片自然宽（网格会等分列宽后拉伸它 ✓）
const int CARD_H = 300       // 卡片自然高（行高取该行最高子项 ⇒ 统一才对齐 ✓）
const int HERO_W = 280       // 详情页大海报宽
const int HERO_H = 420       // 详情页大海报高（2:3 ⇒ image_aspect = 1.5 ✓；矮窗口 600 高也放得下 ✓）
const int SIM_W = 132        // 详情页「相似推荐」小卡宽
const int SIM_H = 196        // 相似小卡高（≈2:3 ✓）
const int SIM_GAP = 12       // 相似小卡间距
const int SIM_MAX = 6        // 相似位最多放几张（横向滚动 ✓）
const int SIM_PADX = 28      // 相似行的左右内边距（必须计入内容宽 ✗ 见 refresh_similar ✓）
const float CARD_ASPECT = 1.45   // 图片区 高/宽（2:3 竖版海报 ✓）
const int GRID_PAD = 18      // 网格内边距
const int GRID_GAP = 18      // 卡片间距
const float BAR_W = 12.0     // ScrollView 滚动条宽（算内容宽用，与 sdl_scrollview 的 barW 一致 ✓）

var C_BG      = #0E1116FF    // 内容区底（参考图的近黑深蓝 ✓）
var C_PANEL   = #141821FF    // 侧栏 / 顶栏底
var C_CARD    = #171C25FF    // 卡片底
var C_CARD_HV = #232B38FF    // 卡片悬停底
var C_ACCENT  = #F5A623FF    // 主色（橙色胶囊 = 选中项 ✓）
var C_ACC_TXT = #20180AFF    // 主色上的文字（深色 ✓）
var C_TXT     = #E9EDF4FF    // 主文字
var C_TXT_DIM = #8B94A5FF    // 次要文字
var C_NAV     = #B9C2D0FF    // 导航常规文字
var C_NAV_HV  = #1E2531FF    // 导航悬停底
var C_FIELD   = #1B202BFF    // 搜索框/次要按钮底
var C_FIELD_B = #2A3242FF    // 搜索框描边
var C_BAR     = #39404EFF    // 滚动条
var C_TRANS   = #00000000    // 透明
var SEL_ROW   = #2A2318FF    // 列表选中行底（暗琥珀 ⇒ 与橙色主色同族 ✓）
var SEP_LINE  = #1B212BFF    // 列表分隔线（贴近底色 ⇒ 不要"Excel 网格"感 ✓）

// 图标路径（只读随包资源 ⇒ 一律 res_dir() ✓ 见 movie_data.leno 的 poster_path/images_dir）
func icon(string n): string {
    return data.poster_path(n)
}

// ==================== 详情页的动态文案（模块级变量 ✓）====================
//   ⚠ 圆环的 `text_fn` / `sub_text_fn` 是**闭包**：读的是**实时值** —— 循环外的局部量 / 模块级 /
//     字段都是 **by-upvalue** ✓（捕获之后改它，闭包读到的是新值 ✓ 实测见 `docs/语言陷阱速查.md` ㊱）；
//     **只有「循环体内声明的变量」才是值捕获**（每轮各一份，金标准 `assert/test_closure_value_capture.leno` ✓）
//   ⇒ 这里用模块级只是"少带一个 self"的写法选择，**不是**必需（写成局部量同样实时 ✓）
var D_RING_TXT = "—"
var D_RING_SUB = "评分"

// ==================== 主结构 ====================
struct Wall {
    // ----- 控件 -----
    Window win
    TitleBar tb
    HBox header
    VBox side
    ScrollView sv
    GridLayout grid
    Label titleLbl
    Label totalLbl
    Edit search
    Button backBtn
    Button filterBtn
    Button moreBtn
    HBox secBox
    Label secLbl
    Button searchBtn
    Label gapLbl

    // ----- 详情页（点卡片进入 ✓ 见 build_detail / open_detail）-----
    VBox root                    // 海报墙的根（切页后要切回来 ⇒ 必须存字段 ✓）
    VBox dpage                   // 详情页的根
    HBox dtop                    //   顶栏（返回 / 标题 / 收藏 / 播放）
    HBox dbody                   //   主体（左海报 + 右信息）
    Card hero                    //   大海报（复用 Card：自带圆角 + 评分角标 ✓）
    Label dTitle
    Label dMeta
    RingProgress dRing           //   评分环（value 模式 ✓）
    Label dKV1
    Label dKV2
    Label dKV3
    Label dCap
    Label dDesc                  //   简介（wrap 自动折行 ✓）
    Button dPlay
    Button dFav
    bool dOpen = false           // 详情页是否在前台（Esc / 渲染回调都要看它 ✓）
    int dIdx = -1                // 当前详情的影片下标
    float dWrapW = 0.0           // 简介折行宽度（随窗口校正 ✓）
    float tbH = 0.0              // 自绘标题栏高度（详情页根要让开它 ✓）

    // ----- 详情页：相似推荐（横向 ScrollView ✓ 用上框架的 content_w + 横向条）-----
    ScrollView simSv
    HBox simRow
    Array[Card] simCards = []
    int simCount = 0             // 本次推荐了几张（决定 content_w ✓）

    // ----- 网格页：底部状态栏 + 空态 -----
    HBox statusBar
    Label statLbl
    Label sortLbl
    bool emptyNow = false        // 当前筛选/搜索命中 0 部 ⇒ 网格区画空态提示 ✓
    Font? emptyFont              // 空态提示用的字体（懒建；run 收尾时 close ✓）

    // ----- 视图页签：页 0 = 海报墙网格 / 页 1 = 列表（Table ✓）-----
    TabControl tabs
    Table tbList
    int curView = 0
    Array[int] tbMap = []        // 列表行号 → movies 下标（重建时同步 ⇒ 两个视图永不错位 ✓）

    // ----- 数据 -----
    Array[Movie] movies = []
    Array[Card] cards = []        // 与 movies **同序**（筛选时只换 add 名单 ⇒ 控件不重建 ✓）
    Array[HBox] actRows = []      // 每张卡的「卡内操作」行（v2 容器化 ✓；只建一次、开关只挂/摘 ✓）
    Button actBtn                // 顶栏「卡内操作」开关
    bool cardActions = false
    Array[Button] navs = []       // 分类导航按钮（含「更多」展开出来的 ✓）
    Array[string] navNames = []   // 与 navs 同序的名字（判选中态用 ✓）
    bool moreOpen = false
    string curCat = ""            // 当前分类（"" = 全部，见 run() 里赋 data.CAT_ALL ✓）
    string query = ""             // 搜索关键词（空 = 不筛 ✓）
    int sortMode = 0              // 0 默认 / 1 评分优先 / 2 年份优先
    int cols = 5                  // 当前网格列数（sync_cols 每帧校正 ✓）

    // ----- 无头自检状态（见 self_test ✓）-----
    //   ★ 时间基准 = **定时器**（`STEP_MS` 一拍 = 一步），**不是帧号**：
    //     本框架是**事件驱动重绘** —— 没有重绘请求时帧号根本不走 ⇒ "第 N 帧"既不定时、
    //     还可能截到**旧画面** ✗（2026-10-13 用户点出 ✓；仓里既有惯例见 cleaner_master 的
    //     `autoStep`（"自动化必须走定时器，与有没有事件无关 ✓"）与 dashboard_sidebar 那条
    //     "无头下没有事件就永不重绘"的注释 ✓）。定时器触发时会自动 `requestRedraw` ⇒ 一定刷到 ✓
    const int STEP_MS = 100      // 自检每步间隔（毫秒）
    string shotPath = ""
    int shotAt = 10              // 第几步截图（步 × 100ms ⇒ 确定 ✓）
    int closeAt = 0              // >0 ⇒ 第几步模拟点标题栏 ✕（WALL_CLOSE ✓）
    int clickSelAt = 0           // >0 ⇒ 第几步点第 0 张卡的「收藏」按钮（WALL_CLICKSEL ✓）
    int rclickAt = 0             // >0 ⇒ 第几步在第 1 张卡上注入右键（WALL_RCLICK ✓）
    float rcX = 0.0, rcY = 0.0   // 注入的右键坐标（3 步后按它推菜单项位置 ⇒ 验动作 ✓）
    int detailAt = 0             // >0 ⇒ 第几步进详情页（WALL_DETAIL ✓）
    int backAt = 0               // >0 ⇒ 第几步从详情页返回（WALL_BACK ✓）
    int maxSteps = 0             // >0 ⇒ 走到第几步就退出（WALL_FRAMES，语义=步数 ✓）
    int steps = 0                // 已走步数（由步进定时器推进 ✓）

    // ==================== 入口 ====================
    func run() {
        SDL3.ttfInit()
        SDL3.setTheme(SDL3.darkTheme())      // 暗色（本文件颜色基本显式指定，主题只管兜底 ✓）
        curCat = data.CAT_ALL

        win = SDL3.createWindow({title: "影视海报墙 — LenoSDL3", w: WIN_W, h: WIN_H,
                                 flags: 0x20,                     // RESIZABLE
                                 icon: icon("app.png")})
        if not win.ok { SDL3.ttfQuit(); return }
        win.setMinSize(820, 560)

        // ---- 自绘标题栏（win.add 后自动去掉系统标题栏边框 ✓）----
        tb = SDL3.createTitleBar({title: "影视海报墙", h: TB_H, font_size: 13})
        win.add(tb)
        tbH = tb.get_h()                     // 存字段：详情页换根时也要让开它 ✓

        // ---- 根布局：顶栏（固定高）+ 主体（撑满）----
        root = SDL3.createVBox({x: 0, y: 0, w: WIN_W, h: WIN_H - tbH,
                                pad_x: 0, pad_y: 0, spacing: 0})
        win.setRootAt(root, 0, tbH)
        build_header(root)

        HBox body = SDL3.createHBox({x: 0, y: 0, w: WIN_W, h: WIN_H - tbH - HEADER_H,
                                     pad_x: 0, pad_y: 0, spacing: 0})
        root.add(body, {grow: 1, shrink: 1, align: 3})
        build_side(body)
        build_grid(body)
        build_status(root)   // 底部状态栏（应用"现在是什么状态"的单一出口 ✓）

        movies = data.movies()
        make_cards()
        rebuild_side()
        rebuild()
        update_total()
        build_detail()       // 详情页也先建好：切页只是换根 ⇒ 建一次、之后只改数据 ✓
        self_test()

        // ---- 主循环 ----
        win.run(
            func(Event ev): bool { return on_event(ev) },
            func(Renderer r) {
                r.clearColor(C_BG)        // 画在控件之下（网格区没铺满时露出的就是它 ✓）
                sync_cols()               // 每帧一次比较：窗口缩放 ⇒ 网格列数跟着变 ✓
                sync_detail_layout()      // 详情页开着时：简介折行宽度跟着窗口宽 ✓
            }
        )
        if emptyFont != null and emptyFont.ok { emptyFont.close() }; emptyFont = null   // 自建字体自己收 ✓
        SDL3.ttfQuit()
    }

    // ==================== 无头自检（照 dashboard_sidebar / cleaner_master 的惯例 ✓）====================
    //   ★★ **数字全是"步号"，一步 = 100ms（`STEP_MS`）** —— 由**定时器**驱动，不是帧号！
    //      本框架是事件驱动重绘：没有重绘请求时帧号根本不走 ⇒ "第 N 帧"既不定时、还可能截到
    //      旧画面 ✗（2026-10-13 用户点出；仓里惯例见 cleaner_master 的 autoStep、
    //      dashboard_sidebar 的"无头下没事件就永不重绘"注解 ✓）
    //   set SDL_VIDEODRIVER=dummy          # 无窗口跑（无头也能验布局 ✓）
    //   set WALL_SHOT=%TEMP%\wall.png      # 存一张界面 PNG 后退出（核对界面正是靠它 ✓）
    //   set WALL_AT=12                     # 第 12 步（≈1.2s）再截（默认 10 ✓）
    //   set WALL_CAT=科幻 / WALL_CATIDX=6 / WALL_Q=星 / WALL_SORT=1   # 切分类（名字或下标）/ 搜索 / 换排序
    //     ⚠ Windows 控制台传中文 env 可能被代码页折损 ⇒ 自检脚本请用 WALL_CATIDX ✓
    //   set WALL_SIZE=900x600              # 启动就改窗口尺寸（验证列数自适应 ✓）
    //   set WALL_ACTIONS=1                 # 启动就打开「卡内操作」（验证 Card 容器化 ✓）
    //   set WALL_CLICKSEL=20               # 第 20 步点第 1 张卡的「收藏」按钮（验证"不穿透整卡" ✓）
    //   set WALL_DETAIL=3                  # 第 3 步进详情页（序号 = "当前筛选/排序下的第 n 部" ⇒ 确定 ✓）
    //   set WALL_RCLICK=4                  # 第 4 步在第 1 张卡上注入右键（验 Card 右键菜单 ✓）
    //   set WALL_BACK=8                    # 第 8 步从详情页返回（验"切得回来" ✓，配合 WALL_DETAIL）
    //   set WALL_VIEW=1                    # 启动切到「列表」页签（验 TabControl + Table ✓）
    //   set WALL_TSORT=3 / WALL_TFILTER=1  # 列表按第 3 列（评分）降序；再换一批数据压"排序状态残留" ✓
    //   set WALL_CLOSE=1                   # 第 1 步模拟点标题栏 ✕（验证"能退出" ✓）
    //   set WALL_FRAMES=40                 # 走到第 40 步就退出（冒烟；数字=步数 ✓）
    pri func self_test() {
        var sh = _env("WALL_SHOT")
        if sh != null { shotPath = _str(sh) }
        var at = _env("WALL_AT")
        if at != null { shotAt = _int(_str(at)) }
        var ca = _env("WALL_CAT")
        if ca != null { set_cat(_str(ca)) }
        var ci = _env("WALL_CATIDX")     // 按下标切分类（纯 ASCII ⇒ 自检脚本不受控制台编码影响 ✓）
        if ci != null {
            int k = _int(_str(ci))
            if k >= 0 and k < navNames.len() { set_cat(navNames[k]) }
        }
        var q = _env("WALL_Q")
        if q != null {
            search.set_text(_str(q))
            query = _str(q)
            rebuild(); update_total()
        }
        var sm = _env("WALL_SIZE")
        if sm != null {
            var parts = strings.split(_str(sm), "x")         // 形如 "900x600"（验列数自适应 ✓）
            if parts.len() == 2 { win.setSize(_int(parts[0]), _int(parts[1])) }
        }
        var so = _env("WALL_SORT")
        if so != null { for 0 : _int(_str(so)) to i { on_filter() } }   // 走同一条路径（按钮文案一起同步 ✓）
        var cl = _env("WALL_CLOSE")
        if cl != null { closeAt = _int(_str(cl)) }       // >0 ⇒ 该帧模拟点标题栏 ✕ ✓
        var ac = _env("WALL_ACTIONS")
        if ac != null and _int(_str(ac)) > 0 { set_card_actions(true) }
        var cs = _env("WALL_CLICKSEL")
        if cs != null { clickSelAt = _int(_str(cs)) }    // >0 ⇒ 该帧点第 0 张卡的「收藏」按钮 ✓
        var dt = _env("WALL_DETAIL")
        if dt != null { detailAt = _int(_str(dt)) }      // >0 ⇒ 该帧进详情页（验详情页布局 ✓）
        var rc = _env("WALL_RCLICK")
        if rc != null { rclickAt = _int(_str(rc)) }      // >0 ⇒ 该帧注入右键（验 Card 右键菜单 ✓）
        var bk = _env("WALL_BACK")
        if bk != null { backAt = _int(_str(bk)) }        // >0 ⇒ 该帧返回（验"切得回来" ✓）
        var vw = _env("WALL_VIEW")
        if vw != null { on_view_change(_int(_str(vw))) }  // 0=海报墙 / 1=列表（验 TabControl 切页 ✓）
        var ts = _env("WALL_TSORT")
        if ts != null {
            // ★ 压 Table 的"排序状态"：先按某列降序排，再**换一批数据**（rebuild ⇒ set_rows）
            //   ⇒ 表头箭头与数据还对得上吗？（`set_rows` 不重置 sortCol/sortDesc ✗ 见速查 ✓）
            tbList.sort_by(_int(_str(ts)), true)
            Array[string] r0 = tbList.get_row(0)
            if r0.len() > 3 { print("[墙] 列表按列 " + _str(_int(_str(ts))) + " 降序 ⇒ 首行 " + r0[0] + " 评分=" + r0[3]) }
            var tf = _env("WALL_TFILTER")
            if tf != null and _int(_str(tf)) > 0 {
                rebuild()                                // 模拟"换了筛选/搜索" ⇒ 重新 set_rows ✓
                Array[string] r1 = tbList.get_row(0)
                if r1.len() > 3 { print("[墙] 换数据后 首行 " + r1[0] + " 评分=" + r1[3]) }
            }
        }
        var fr = _env("WALL_FRAMES")
        if fr != null { maxSteps = _int(_str(fr)) }        // 语义 = **步数**（不是帧数 ✓）
        // ★★ 自检的每一步都挂**定时器**（STEP_MS 一拍）—— 这是本框架做自动化的**唯一可靠时基**：
        //   事件驱动重绘 ⇒ 没有重绘请求时帧号不走，"第 N 帧"不定时、还可能截到旧画面 ✗
        //   （2026-10-13 用户点出 ✓；同 cleaner_master 的 autoStep 与 dashboard_sidebar 的注释 ✓）
        //   只开任一自检开关才挂：纯交互运行不挂（否则每 100ms 一次无谓全量重绘 ✗）
        bool anyTest = (shotPath != "") or (maxSteps > 0) or (closeAt > 0) or (clickSelAt > 0) or (rclickAt > 0) or (detailAt > 0) or (backAt > 0)
        if anyTest { win.addTimer(STEP_MS, func() { selftest_step() }) }
        // ★ 叠加层**常驻**：空态提示也得画在控件之上 —— ScrollView 自己铺底色，
        //   放在 onRender（控件层之下）会被它整块盖掉 ✗（实测：文字一个像素都不出来 ✓）。
        //   这与"截图钩子必须放 setOverlay、放 onRender 只会拿到空白帧"是同一条规律 ✓
        win.setOverlay(func(Renderer r) {
            draw_empty_hint(r)
            if shotPath != "" { selftest_overlay(r) }
        })
    }

    // 自检**每一步**：由 100ms 的步进定时器驱动（`WALL_*` 里的数字都是**步号** ✓）
    //   ⚠ 别把它搬回渲染回调：渲染回调只在**真的重绘**时才被调用 ⇒ 步子会随"有没有事件"飘 ✗
    pri func selftest_step() {
        steps = steps + 1
        // 模拟点标题栏 ✕（窗口右上角那一格 ✓）：验证"关得掉" —— 没接 is_close_requested 时
        //   这里会一直跑到 WALL_FRAMES（步数）才退（日志里就看得出 ✗ ✓）
        if closeAt > 0 and steps == closeAt {
            var wsz = win.getSize()
            bool cok = SDL3.testClickAt(win.getID(), _float(wsz.w - 20), 17.0)
            print("[墙] 注入点击标题栏 ✕ ok=" + _str(cok))
        }
        // 容器化的关键断言：点**卡内按钮**应只触发按钮自己的回调，
        //   绝不顺带触发整卡 on_click（后者会打印 "[海报墙] 选中：…" ⇒ 日志里看得出来 ✓）
        if clickSelAt > 0 and steps == clickSelAt and cards.len() > 0 {
            Array[float] rct = cards[0].content_rect()   // [x, y, w, h]（窗口绝对坐标 ✓）
            // `_float(...)`：纯为兼容"符号表还没刷新的 LSP"（它会把返回值当 any ✗ 见文末备注）
            float px = _float(rct[0]) + 93.0             // 第 2 个按钮「收藏」的中心（58 + 6 + 58/2 ✓）
            float py = _float(rct[1]) + _float(rct[3]) / 2.0
            bool cok2 = SDL3.testClickAt(win.getID(), px, py)
            print("[墙] 注入点击卡内『收藏』(" + _str(px) + ", " + _str(py) + ") ok=" + _str(cok2))
        }
        if clickSelAt > 0 and steps == clickSelAt + 3 and cards.len() > 0 {
            print("[墙] 点卡内按钮后：card0.selected=" + _str(cards[0].is_selected()))
        }
        // 注入右键（验 Card 右键菜单 ✓）：点第 1 张卡**图片区**（内容区上方 12px ⇒ 仍在卡内 ✓）
        if rclickAt > 0 and steps == rclickAt and cards.len() > 0 {
            Array[float] rct = cards[0].content_rect()
            rcX = _float(rct[0]) + 40.0
            rcY = _float(rct[1]) - 12.0
            bool rok = SDL3.testRightClickAt(win.getID(), rcX, rcY)
            print("[墙] 注入右键(" + _str(rcX) + ", " + _str(rcY) + ") ok=" + _str(rok))
        }
        // 3 步后点菜单第 3 项「加入收藏」（走完"弹出 → 命中 → 动作 → 重绘"整条链 ✓）
        //   菜单锚在右键点 ⇒ 第 3 项中心 ≈ 锚点 + (2*itemH + itemH/2)，itemH 默认 26 ✓
        if rclickAt > 0 and steps == rclickAt + 3 and cards.len() > 0 {
            bool mok = SDL3.testClickAt(win.getID(), rcX + 60.0, rcY + 2.0 * 26.0 + 13.0)
            print("[墙] 点菜单第 3 项 ok=" + _str(mok) + " ⇒ card0.selected=" + _str(cards[0].is_selected()) +
                  " 菜单还开着=" + _str(cards[0].is_context_menu_open()))
        }
        // 进详情页（验详情页布局 ✓）：序号指"当前筛选/排序下的第 n 部" ⇒ 与界面所见一致 ✓
        if detailAt > 0 and steps == detailAt {
            Array[int] ids = collect()
            int n = detailAt - 1
            if n >= 0 and n < ids.len() { open_detail(ids[n]) }
            else { print("[墙] WALL_DETAIL=" + _str(detailAt) + " 越界（命中 " + _str(ids.len()) + " 部）") }
        }
        // 返回海报墙（验证 round trip：换根 ⇒ 换回来 ✓）
        if backAt > 0 and steps == backAt { close_detail() }
        // 走到步数上限就退（冒烟 ✓；`WALL_FRAMES` 的语义已改为**步数** ✓）
        if maxSteps > 0 and steps >= maxSteps {
            print("[墙] 步数=" + _str(steps) + " 命中=" + _str(collect().len()) + " 列=" + _str(cols))
            _exit(0)
        }
    }

    // 叠加层：空态提示 + 截图（**必须在控件之上** —— 它在所有控件/弹层之后、present 之前 ✓）
    pri func selftest_overlay(Renderer r) {
        if shotPath == "" or steps < shotAt { return }
        var sz = win.getSize()
        var s = r.readPixelsAt(0, 0, sz.w, sz.h)
        if s != null {
            bool ok = SDL3.saveImagePNG(s, shotPath)
            print("[墙] 截图 " + shotPath + " ok=" + _str(ok) +
                  "  分类=" + curCat + " 命中=" + _str(collect().len()) + " 列=" + _str(cols) +
                  "  页签=" + _str(tabs.get_active()) + "  详情=" + _str(dOpen))
        } else {
            print("[墙] 读像素失败：" + SDL3.getError())
        }
        _exit(0)
    }

    // ==================== 事件 ====================
    pri func on_event(Event ev): bool {
        if ev.isQuit() or ev.isWindowClose() { return false }
        // ★ 自绘标题栏的 ✕ **必须自己接**：TitleBar 只把 `closeRequested` 置真，
        //   没人查它就等于"点了 ✕ 毫无反应" ✗（见 sdl_titlebar.leno 头部"默认行为"那条 ✓；
        //   file_manager / IDE布局 / sdl_dialog 都是这么接的 ✓）
        if tb._loaded and tb.is_close_requested() {
            tb.clear_close_request()
            print("[墙] 标题栏 ✕ ⇒ 退出")
            return false
        }
        // Esc：详情页里 = **返回海报墙**（别顺手退出程序 ✗）；海报墙里 = 退出 ✓
        if ev.isKeyDown() and ev.scancode() == Scancode.ESCAPE {
            if dOpen { close_detail(); return true }
            return false
        }
        if ev.isWindowResized() { sync_cols(); sync_detail_layout() }
        return true
    }

    // 网格列数 = 用 ScrollView 的**实际宽度**反推（卡片宽 = 列宽，尽量贴近 CARD_W ✓）
    pri func sync_cols() {
        float svw = sv.get_w()
        if svw < 120.0 { return }                      // 首帧前尺寸还没排 ⇒ 不猜 ✓
        float innerW = svw - BAR_W - 2.0 * _float(GRID_PAD)
        int want = _int((innerW + _float(GRID_GAP)) / (_float(CARD_W) + _float(GRID_GAP)))
        if want < 2 { want = 2 }
        if want != cols {
            cols = want
            grid.set_cols(want)
            SDL3.markFrameRedraw()
        }
    }

    // ==================== 顶栏 ====================
    pri func build_header(VBox root) {
        header = SDL3.createHBox({x: 0, y: 0, w: WIN_W, h: HEADER_H,
                                  pad_x: 14, pad_y: 0, spacing: 10, bg_color: C_PANEL})
        root.add(header, {grow: 0, shrink: 0, basis: HEADER_H, align: 3})

        // 返回（参考图左上角 ✓）：清空搜索 + 回到「全部」
        backBtn = SDL3.createButton({text: "", w: 34, h: 34, radius: 8, border: false, shadow: false,
                                     bg_color: C_TRANS, hover_color: C_NAV_HV,
                                     image_path: icon("chevron_left.png"), image_size: 18,
                                     image_tint: C_TXT_DIM, tip: "返回（清空筛选）"})
        backBtn.on_click(func() { go_home() })
        header.add(backBtn, {grow: 0, shrink: 0, basis: 34, align: 1})

        titleLbl = SDL3.createLabel({text: "电影", font_size: 19, font_style: SDL3.STYLE_BOLD,
                                     text_color: C_TXT})
        header.add(titleLbl, {grow: 0, shrink: 0, align: 1})

        totalLbl = SDL3.createLabel({text: "（共 0 部）", font_size: 13, text_color: C_TXT_DIM})
        header.add(totalLbl, {grow: 0, shrink: 0, align: 1})

        // 中间弹性空隙（把搜索/筛选推到右边 ✓）
        header.add(SDL3.createLabel({text: ""}), {grow: 1, shrink: 1, align: 1})

        // 搜索框（输入即时筛选 ✓）
        search = SDL3.createEdit({w: 210, h: 32, font_size: 13, radius: 16,
                                  placeholder: "搜索片名 / 分类", bg_color: C_FIELD,
                                  border_color: C_FIELD_B, text_color: C_TXT})
        search.on_change(func() { on_search() })
        header.add(search, {grow: 0, shrink: 0, basis: 210, align: 1})

        // 「菜单键筛选」：点一下切换排序（默认 → 评分优先 → 年份优先 ✓）
        filterBtn = SDL3.createButton({text: "菜单键筛选", w: 124, h: 32, font_size: 13,
                                       align: "left", padding: 10.0, radius: 8,
                                       bg_color: C_FIELD, hover_color: C_NAV_HV, text_color: C_TXT,
                                       image_path: icon("filter.png"), image_size: 14,
                                       image_tint: C_ACCENT, border: false, shadow: false,
                                       tip: "切换排序：默认 / 评分优先 / 年份优先"})
        filterBtn.on_click(func() { on_filter() })
        header.add(filterBtn, {grow: 0, shrink: 0, basis: 124, align: 1})

        // ★ 「卡内操作」：演示 **Card 容器化**（给每张卡挂一行「播放 / 收藏」）
        //   默认关 ⇒ 界面与参考图一致；打开 ⇒ 卡片变高、图片让位（不变式 ① 的实拍验证 ✓）
        actBtn = SDL3.createButton({text: "卡内操作", w: 116, h: 32, font_size: 13, align: "left",
                                    padding: 10.0, radius: 8, bg_color: C_FIELD, hover_color: C_NAV_HV,
                                    text_color: C_TXT, image_path: icon("play.png"), image_size: 13,
                                    image_tint: C_ACCENT, border: false, shadow: false,
                                    tip: "在卡片底部挂一行按钮（验证 Card.set_content ✓）"})
        actBtn.on_click(func() { set_card_actions(not cardActions) })
        header.add(actBtn, {grow: 0, shrink: 0, basis: 116, align: 1})
    }

    // ==================== 侧栏 ====================
    pri func build_side(HBox body) {
        side = SDL3.createVBox({x: 0, y: 0, w: SIDE_W, h: 400,
                                pad_x: 12, pad_y: 14, spacing: 4, bg_color: C_PANEL})
        body.add(side, {grow: 0, shrink: 0, basis: SIDE_W, align: 3})

        // 「来源选择」小标题：漏斗图标 + 文字（参考图左侧顶部就是这样 ✓）
        secLbl = SDL3.createLabel({text: "来源选择", font_size: 12, text_color: #6E7789FF})
        secBox = SDL3.createHBox({x: 0, y: 0, w: 100, h: 20, pad_x: 8, pad_y: 0, spacing: 5})
        secBox.add(SDL3.createImageView({w: 13, h: 13, image_path: icon("funnel.png"),
                                         image_tint: #6E7789FF}), {grow: 0, shrink: 0, basis: 13, align: 1})
        secBox.add(secLbl, {grow: 1, shrink: 1, align: 1})
        gapLbl = SDL3.createLabel({text: ""})

        // 「搜索」：点了把焦点丢给顶栏的搜索框（参考图里它是导航第一项 ✓）
        searchBtn = SDL3.createButton({text: "搜索", font_size: 14, align: "left", padding: 14.0,
                                       radius: 8, image_path: icon("search.png"), image_size: 15,
                                       image_tint: C_NAV})
        style_nav(searchBtn, false)
        searchBtn.on_click(func() { search.focus(); SDL3.markFrameRedraw() })

        // 「更多」：展开/收起额外分类（图标随状态换 ✓）
        moreBtn = SDL3.createButton({text: "更多分类", font_size: 13, align: "left", padding: 14.0,
                                     radius: 8, image_path: icon("chevron_down.png"), image_size: 15,
                                     image_tint: C_NAV})
        style_nav(moreBtn, false)
        moreBtn.on_click(func() { toggle_more() })

        // 分类按钮（先建好 ⇒ 展开/收起只改「加不加进布局」✓）
        navs = []
        navNames = []
        new_nav(data.CAT_ALL)
        var base = data.cats_base()
        for 0 : base.len() - 1 to i { new_nav(base[i]) }
        var more = data.cats_more()
        for 0 : more.len() - 1 to i { new_nav(more[i]) }
    }

    // 建一个分类按钮并登记（**不**进布局 —— 由 rebuild_side 决定谁上场 ✓）
    pri func new_nav(string name) {
        Button b = SDL3.createButton({text: name, font_size: 14, align: "left", padding: 14.0, radius: 8})
        style_nav(b, name == curCat)
        b.on_click(func() { set_cat(name) })     // 循环量每轮独立 ⇒ 每个按钮各记各的名字 ✓
        navs.add(b)
        navNames.add(name)
    }

    // 侧栏内容 = 小标题 + 搜索 + 分类（常驻 / 展开）+ 弹性空隙 + 「更多」（**固定末尾** ✓）
    //   ⚠ VBox/HBox **只能 append**（没有 insert）⇒ 展开的分类要排在「更多」**上面**，
    //     只能整条重排（`clear()` + 按顺序重新 add ✓ —— clear 只清布局数组，不 dispose 子控件 ✓）
    pri func rebuild_side() {
        side.clear()
        side.add(secBox, {grow: 0, shrink: 0, basis: 26, align: 3})
        side.add(searchBtn, {grow: 0, shrink: 0, basis: 40, align: 3})

        int keep = 1 + data.cats_base().len()      // 「全部」+ 常驻分类
        for 0 : keep - 1 to i { side.add(navs[i], {grow: 0, shrink: 0, basis: 40, align: 3}) }
        if moreOpen {
            for keep : navs.len() - 1 to i { side.add(navs[i], {grow: 0, shrink: 0, basis: 40, align: 3}) }
        }

        side.add(gapLbl, {grow: 1, shrink: 1, align: 3})    // 弹性空隙 ⇒ 「更多」贴底 ✓
        side.add(moreBtn, {grow: 0, shrink: 0, basis: 36, align: 3})
    }

    // 导航项样式：选中 = 橙色胶囊 + 深色字；未选中 = 透明底 + 浅灰字（悬停有底 ✓）
    //   初始化与切换都走这里 ⇒ 只有一处定义，不会漂移 ✓
    pri func style_nav(Button b, bool active) {
        b.set_background(true)
        b.set_border(false)
        b.set_shadow(false)
        if active {
            b.set_bg_color(C_ACCENT)
            b.set_hover_color(SDL3.brighten(C_ACCENT, 20))
            b.set_text_color(C_ACC_TXT)
        } else {
            b.set_bg_color(C_TRANS)
            b.set_hover_color(C_NAV_HV)
            b.set_text_color(C_NAV)
        }
    }

    pri func toggle_more() {
        moreOpen = not moreOpen
        sync_more_btn()
        rebuild_side()
        SDL3.markFrameRedraw()
    }

    pri func sync_more_btn() {
        if moreOpen { moreBtn.set_image(icon("chevron_up.png")); moreBtn.set_text("收起分类") }
        else { moreBtn.set_image(icon("chevron_down.png")); moreBtn.set_text("更多分类") }
    }

    // ==================== 右侧：视图页签（海报墙 / 列表）====================
    //   页内容一律走**布局模式**（`setPageLayout` + `addToPageLayout`）——
    //   ⚠ 别和绝对定位模式（`addToPage`）混用：混用后绝对子控件**再也不会被 set_pos** ✗
    //     （`sdl_tab.leno` 的 applyOffsets 对"布局页"直接 return ✓）⇒ 一页只用一种方式 ✓
    //   ⚠ 容器用 `createXxx` + `add`（不要 `win.addXxx`：那会同时进窗口控件表 ⇒ 双重绘制/处理 ✗）
    pri func build_grid(HBox body) {
        //   配色上让页签**融进应用**：标签栏/标签底一律 = 内容底色 ⇒ 只剩文字 + 激活页的橙色下划线
        //   （默认那套"灰条 + 方框标签"是主题色 ⇒ 顶在暗色海报墙上像外挂的一块 ✗）
        tabs = SDL3.createTabControl({x: 0, y: 0, w: 900, h: 500, tab_h: 36,
                                      tabs: ["  海报墙  ", "  列表  "], active: 0,
                                      font_size: 14, bg_color: C_BG,
                                      bar_color: C_BG, tab_color: C_BG,
                                      active_color: C_BG, accent_color: C_ACCENT,
                                      text_color: C_TXT_DIM, active_text_color: C_TXT,
                                      border_color: C_TRANS})
        body.add(tabs, {grow: 1, shrink: 1, align: 3})
        tabs.on_change(func(int p) { on_view_change(p) })

        // ---- 页 0：海报墙网格（原样搬进来 ✓）----
        VBox gpage = SDL3.createVBox({x: 0, y: 0, w: 900, h: 460, pad_x: 0, pad_y: 0, spacing: 0})
        tabs.setPageLayout(0, gpage)
        sv = SDL3.createScrollView({x: 0, y: 0, w: 900, h: 460, fit_w: true,
                                    step: 64, smooth: true, bg_color: C_BG,
                                    border: false, bar_color: C_BAR})
        tabs.addToPageLayout(0, sv, {grow: 1, shrink: 1, align: 3})
        grid = SDL3.createGridLayout({x: 0, y: 0, w: 900, h: 460, cols: cols,
                                      spacing: GRID_GAP, pad_x: GRID_PAD, pad_y: GRID_PAD})
        sv.set_content(grid)     // ★ 内容控件用 createXxx（不要 win.addXxx ⇒ 会双重绘制/处理 ✗）

        // ---- 页 1：列表（Table：同一份数据、同一套右键菜单语义 ✓）----
        VBox lpage = SDL3.createVBox({x: 0, y: 0, w: 900, h: 460, pad_x: 0, pad_y: 0, spacing: 0})
        tabs.setPageLayout(1, lpage)
        build_table(lpage)
    }

    // 列表视图：表头可点排序 ✓、双击进详情 ✓、右键菜单与卡片**同名同义** ✓
    //   ★ 2026-10-13：**照"媒体库列表"的样子调**（原来 5 列等宽 + 默认灰底 ⇒ 像外挂一块后台表格 ✗）：
    //     ① 第 0 列带**海报缩略图**（`image_col` + 逐行 `set_row_image` ✓）；② 行高 46（不是 24 ✓）；
    //     ③ 去掉空荡荡的「收藏」列 ⇒ 收藏改用片名前的 ★ 表达 ✓（省得 21/22 行都是空白 ✗）；
    //     ④ 底/表头/选中/分隔线**全部对齐本应用色板**（默认那套是主题色，跟海报墙不是一家人 ✗）
    pri func build_table(VBox page) {
        tbList = SDL3.createTable({x: 0, y: 0, w: 900, h: 460, item_h: 46, header_h: 34,
                                   font_size: 14, image_size: 32, image_mode: 2,
                                   headers: ["片名", "年份", "分类", "评分"], image_col: 0,
                                   sortable: true, zebra: false, resizable: true,
                                   bg_color: C_BG, header_color: C_PANEL,
                                   sel_color: SEL_ROW, sep_color: SEP_LINE,
                                   empty_text: "没有匹配的影片（换个词，或点左栏分类）",
                                   tip: "双击进详情 · 点表头排序"})
        page.add(tbList, {grow: 1, shrink: 1, align: 3})
        tbList.on_dbl_click(func(int row, int col) { open_list_row(row) })
        // 右键：文案/语义与卡片菜单**保持一致**（框架侧同名 API ⇒ 应用侧写法也一致 ✓）
        //   ⚠ 行号必须在 `will_open` 里**当场**取：菜单弹出后用户还能滚动表 ⇒ 用旧行号会张冠李戴 ✗
        tbList.on_context_will_open(func(int row) {
            tbList.clearContextItems()
            tbList.addContextItem({label: "进详情页", id: "open"})
            tbList.addContextItem({label: "播放", id: "play"})
            tbList.addContextItem({label: "复制片名", id: "copy"})
        })
        tbList.on_context_select(func(int row, string id) { on_list_menu(row, id) })
    }

    // 列表数据 = **同一份**命中名单（`collect()` ✓）⇒ 网格与列表永不各说各话 ✓
    //   ⚠ 行号与 movies 下标不是一回事（筛选/排序后顺序不同 ✓）⇒ 一律过 `tbMap` ✓
    pri func rebuild_table() {
        tbMap = collect()
        Array[Array[string]] rows = []
        for 0 : tbMap.len() - 1 to i {
            Movie m = movies[tbMap[i]]
            string star = if cards[tbMap[i]].is_selected() then "★ " else ""   // 收藏用 ★ 表达（省一列 ✓）
            rows.add([star + m.title, m.year, m.cat, m.score])
        }
        // ★ 用**批量**接口 `set_rows`（会重放当前排序 ✓）—— 逐行 `clear()` + `add_row()` 是另一条路：
        //   `clear/add_row` 会**撤销**排序状态 ⇒ 换数据后表头箭头与数据对不上 ✗（见 sdl_table 的注释 ✓）
        tbList.set_rows(rows)
        // 缩略图**逐行**贴，且必须在 `set_rows` **之后**（它会把 rowImages 冲成空串 ✗ 见 sdl_table ✓）
        for 0 : tbMap.len() - 1 to i {
            tbList.set_row_image(i, data.poster_path(movies[tbMap[i]].file))
        }
    }

    pri func on_view_change(int p) {
        // ★ 这个函数是**双向**入口：用户点页签时由 `on_change` 回调进来、程序化切页（自检钩子）时
        //   也要真的把页签切过去 —— 只改自己的 `curView` 的话，界面还停在第 0 页 ✗（实测踩过 ✓）
        //   `set_active` 对**同值**直接 return ⇒ 上面那条回调不会递归 ✓
        if tabs.get_active() != p { tabs.set_active(p) }
        curView = p
        if p == 1 { rebuild_table() }        // 切到列表：按当前筛选/排序刷一次 ✓
        SDL3.markFrameRedraw()
    }

    pri func open_list_row(int row) {
        if row < 0 or row >= tbMap.len() { return }
        open_detail(tbMap[row])
    }

    pri func on_list_menu(int row, string id) {
        if row < 0 or row >= tbMap.len() { return }
        on_card_menu(tbMap[row], id)         // 与卡片右键**走同一条分发**（收藏/复制/播放一处定义 ✓）
        rebuild_table()                      // 收藏列跟着变（否则列表上还是旧的 "★" ✗）
    }

    // ==================== 详情页（点卡片进入 ✓ 2026-10-13）====================
    //   整页切换 = 换**根容器**：`win.setRootAt(dpage, 0, tbH)` / 切回 `win.setRootAt(root, 0, tbH)` ✓
    //   为什么不做"隐藏/显示"：VBox/HBox 只按子项**尺寸**排版，看不见的页照样占位 ✗
    //     （框架没有"停用排版"开关；而换根是它自己的既有能力 ✓ 标题栏是 win.add 的 ⇒ 不受影响 ✓）
    pri func build_detail() {
        dpage = SDL3.createVBox({x: 0, y: 0, w: WIN_W, h: WIN_H - tbH, pad_x: 0, pad_y: 0, spacing: 0,
                                 bg_color: C_BG})

        // ---- 顶部条：与海报墙顶栏**同高同色** ⇒ 切页时视觉不跳 ✓ ----
        dtop = SDL3.createHBox({x: 0, y: 0, w: WIN_W, h: HEADER_H, pad_x: 14, pad_y: 0, spacing: 10,
                                bg_color: C_PANEL})
        dpage.add(dtop, {grow: 0, shrink: 0, basis: HEADER_H, align: 3})

        Button dBack = SDL3.createButton({text: "返回", w: 84, h: 34, font_size: 13, radius: 8,
                                          bg_color: C_FIELD, hover_color: C_NAV_HV, text_color: C_TXT,
                                          image_path: icon("chevron_left.png"), image_size: 16,
                                          image_tint: C_TXT, border: false, shadow: false,
                                          align: "left", padding: 10.0, tip: "回到海报墙（Esc 同效）"})
        dBack.on_click(func() { close_detail() })
        dtop.add(dBack, {grow: 0, shrink: 0, basis: 84, align: 1})

        dtop.add(SDL3.createLabel({text: "影片详情", font_size: 19, font_style: SDL3.STYLE_BOLD,
                                    text_color: C_TXT}), {grow: 0, shrink: 0, align: 1})
        dtop.add(SDL3.createLabel({text: ""}), {grow: 1, shrink: 1, align: 1})

        dFav = SDL3.createButton({text: "收藏", w: 92, h: 32, font_size: 13, radius: 8,
                                  bg_color: C_FIELD, hover_color: C_NAV_HV, text_color: C_TXT,
                                  border: false, shadow: false, tip: "收藏 ⇄ 取消（同一份状态：卡片会亮橙边 ✓）"})
        dFav.on_click(func() { toggle_detail_fav() })
        dtop.add(dFav, {grow: 0, shrink: 0, basis: 92, align: 1})

        dPlay = SDL3.createButton({text: "播放", w: 96, h: 32, font_size: 13, radius: 8,
                                   bg_color: C_ACCENT, text_color: C_ACC_TXT, border: false, shadow: false,
                                   image_path: icon("play.png"), image_size: 14, image_tint: C_ACC_TXT,
                                   align: "left", padding: 10.0, tip: "播放（示例只打印 ✓）"})
        dPlay.on_click(func() { play_current() })
        dtop.add(dPlay, {grow: 0, shrink: 0, basis: 96, align: 1})

        // ---- 主体：左大海报（复用 Card ⇒ 自带圆角 + 评分角标 ✓）+ 右信息 ----
        dbody = SDL3.createHBox({x: 0, y: 0, w: WIN_W, h: 520, pad_x: 28, pad_y: 24, spacing: 30})
        dpage.add(dbody, {grow: 1, shrink: 1, align: 3})

        hero = SDL3.createCard(hero_opts(movies[0]))
        dbody.add(hero, {grow: 0, shrink: 0, basis: HERO_W, align: 1})

        VBox dinfo = SDL3.createVBox({x: 0, y: 0, w: 600, h: 480, pad_x: 0, pad_y: 0, spacing: 12})
        dbody.add(dinfo, {grow: 1, shrink: 1, align: 3})

        dTitle = SDL3.createLabel({text: "", font_size: 30, font_style: SDL3.STYLE_BOLD, text_color: C_TXT})
        dinfo.add(dTitle, {grow: 0, shrink: 0, align: 0})
        dMeta = SDL3.createLabel({text: "", font_size: 14, text_color: C_TXT_DIM})
        dinfo.add(dMeta, {grow: 0, shrink: 0, align: 0})

        // 评分环 + 三条键值（同一行 ⇒ 信息密度像"详情页" ✓）
        HBox drow = SDL3.createHBox({x: 0, y: 0, w: 600, h: 132, pad_x: 0, pad_y: 0, spacing: 22})
        dinfo.add(drow, {grow: 0, shrink: 0, basis: 132, align: 3})
        dRing = SDL3.createRingProgress({size: 132, thickness: 13, mode: "value",
                                         font_size: 26, sub_font_size: 12,
                                         fill_color: C_ACCENT, track_color: #262C38FF, text_color: C_TXT,
                                         text_fn: func(): string { return D_RING_TXT },
                                         sub_text_fn: func(): string { return D_RING_SUB },
                                         tip: "评分（满分 10 ⇒ 环 = 分数 ÷ 10 ✓）"})
        drow.add(dRing, {grow: 0, shrink: 0, basis: 132, align: 1})
        VBox dkv = SDL3.createVBox({x: 0, y: 0, w: 300, h: 132, pad_x: 0, pad_y: 0, spacing: 7})
        drow.add(dkv, {grow: 1, shrink: 1, align: 3})
        dKV1 = SDL3.createLabel({text: "", font_size: 14, text_color: C_TXT})
        dKV2 = SDL3.createLabel({text: "", font_size: 14, text_color: C_TXT})
        dKV3 = SDL3.createLabel({text: "", font_size: 13, text_color: C_TXT_DIM})
        dkv.add(dKV1, {grow: 0, shrink: 0, align: 0})
        dkv.add(dKV2, {grow: 0, shrink: 0, align: 0})
        dkv.add(dKV3, {grow: 0, shrink: 0, align: 0})

        dCap = SDL3.createLabel({text: "简介", font_size: 12, text_color: #6E7789FF})
        dinfo.add(dCap, {grow: 0, shrink: 0, align: 0})
        // 简介：**自动折行**（Label 的 wrap ✓；宽度由 sync_detail_layout 跟着窗口校正 ✓）
        dDesc = SDL3.createLabel({text: "", font_size: 15, text_color: C_NAV, wrap: true, wrap_w: 640.0})
        dinfo.add(dDesc, {grow: 0, shrink: 0, align: 0})
        dinfo.add(SDL3.createLabel({text: ""}), {grow: 1, shrink: 1, align: 1})
        dinfo.add(SDL3.createLabel({text: "点「返回」或按 Esc 回到海报墙", font_size: 12,
                                    text_color: #6E7789FF}), {grow: 0, shrink: 0, align: 0})

        // ---- 相似推荐：横向滚动行（换片时由 refresh_similar 重建名单 ✓）----
        dpage.add(SDL3.createLabel({text: "  相似推荐（同分类）", font_size: 12, text_color: #6E7789FF}),
                  {grow: 0, shrink: 0, basis: 22, align: 0})
        simSv = SDL3.createScrollView({x: 0, y: 0, w: WIN_W - 56, h: SIM_H + 18, radius: 0,
                                       bg_color: C_BG, border: false, bar_color: C_BAR,
                                       content_w: _float(SIM_W * SIM_MAX), content_h: _float(SIM_H),
                                       step: 96.0})
        dpage.add(simSv, {grow: 0, shrink: 0, basis: SIM_H + 18, align: 3})
        simRow = SDL3.createHBox({x: 0, y: 0, w: _float(SIM_W * SIM_MAX), h: _float(SIM_H),
                                  pad_x: SIM_PADX, pad_y: 0, spacing: SIM_GAP})
        simSv.set_content(simRow)
        simCards = []
        for 0 : SIM_MAX - 1 to k { simCards.add(SDL3.createCard(sim_opts(movies[0]))) }
        for 0 : SIM_MAX - 1 to k { wire_card_menu(simCards[k], k) }   // 首次接线（open_detail 会重接 ✓）
    }

    // 大海报的选项（Card.set 会**按默认值补齐**缺的键 ⇒ 每次都给全 ⚠ 否则颜色/圆角被重置 ✗）
    pri func hero_opts(Movie m): Dict {
        return {x: 0, y: 0, w: HERO_W, h: HERO_H, pad: 0,
                image_path: data.poster_path(m.file), image_aspect: 1.5,
                image_radius: 14, radius: 14, hover_lift: 0.0,
                bg_color: C_CARD, border: true, border_color: #232A36FF,
                badge: m.score, badge_pos: 0, badge_size: 15.0,
                badge_bg: #000000B0, badge_color: #F5C451FF,
                tip: m.title + "（" + m.year + "）评分 " + m.score}
    }

    // 打开详情页（idx = movies 里的下标 ✓）
    pri func open_detail(int idx) {
        if idx < 0 or idx >= movies.len() { return }
        dIdx = idx
        Movie m = movies[idx]
        hero.set(hero_opts(m))
        if m.year == "2026" {      // 与卡片一致：最新年份挂「新」（set() 会清 badges ⇒ 重新挂 ✓）
            hero.add_badge({text: "新", pos: 1, size: 11.0, bg: #C8102EFF, color: #FFFFFFFF})
        }
        dTitle.set_text(m.title)
        dMeta.set_text(m.year + " · " + m.cat + " · " + m.score + " 分")
        D_RING_TXT = m.score
        D_RING_SUB = "评分"
        dRing.set_value(_float(m.score) / 10.0)
        dKV1.set_text("年份：" + m.year)
        dKV2.set_text("分类：" + m.cat)
        dKV3.set_text("海报：" + m.file)
        dDesc.set_text(m.desc)
        sync_detail_fav()
        refresh_similar(idx)                 // 相似推荐跟着换（同分类 ✓）
        dOpen = true
        win.setRootAt(dpage, 0, tbH)
        SDL3.markFrameRedraw()
        print("[墙] 进入详情页：" + m.title + "（" + m.year + " / " + m.cat + "）评分 " + m.score +
              "  收藏=" + _str(cards[idx].is_selected()))
    }

    pri func close_detail() {
        if not dOpen { return }
        dOpen = false
        win.setRootAt(root, 0, tbH)      // 换回海报墙的根 ✓（网格/卡片都是同一批对象 ⇒ 状态原样保留 ✓）
        SDL3.markFrameRedraw()
        print("[墙] 返回海报墙")
    }

    // 收藏状态与网格里的卡片**同一份**（详情页 ⇄ 卡片橙边联动 ✓）
    pri func sync_detail_fav() {
        if dIdx < 0 or dIdx >= cards.len() { return }
        dFav.set_text(if cards[dIdx].is_selected() then "已收藏" else "收藏")
    }
    pri func toggle_detail_fav() {
        if dIdx < 0 { return }
        toggle_card_sel(dIdx)
        sync_detail_fav()
        SDL3.markFrameRedraw()
    }
    pri func play_current() {
        if dIdx < 0 { return }
        print("[墙] 播放：" + movies[dIdx].title)
    }

    // 简介折行宽度跟随窗口（只在详情页开着时做；值没变就早退 ⇒ 零开销 ✓）
    pri func sync_detail_layout() {
        if not dOpen { return }
        float w = _float(win.getSize().w) - HERO_W - 28.0 * 2.0 - 30.0 - 46.0
        if w < 240.0 { w = 240.0 }
        if _int(w) == _int(dWrapW) { return }
        dWrapW = w
        dDesc.set_wrap_w(w)
        SDL3.markFrameRedraw()
    }

    // ==================== 详情页：相似推荐（横向滚动 ✓）====================
    //   为什么单独做一行：横向列表是"推荐位 / 时间轴 / 缩略图条"的通用形态 ✓
    //   框架侧用 `content_w`（虚拟内容宽 > 视口 ⇒ 自动出横向条 ✓；滚轮/拖动/Home/End 都通 ✓）
    pri func sim_opts(Movie m): Dict {
        return {x: 0, y: 0, w: SIM_W, h: SIM_H, pad: 0,
                image_path: data.poster_path(m.file), image_aspect: 1.5,
                image_radius: 10, radius: 10, hover_lift: 0.0,
                bg_color: C_CARD, border: true, border_color: #232A36FF,
                badge: m.score, badge_pos: 0, badge_size: 12.0,
                badge_bg: #000000B0, badge_color: #F5C451FF,
                tip: m.title + "（" + m.year + "）"}
    }

    // 同分类里除自己以外的前 SIM_MAX 部（点进去可以一路跳 ✓）
    //   ⚠ 每次都 `simRow.clear()` 重建名单：**不 dispose 卡片** ⇒ 纹理复用、不来回重建 ✓
    //     （与网格页"同一批 Card 重新 add"是同一手法 ✓）
    pri func refresh_similar(int idx) {
        Array[int] same = []
        string cat = movies[idx].cat
        for 0 : movies.len() - 1 to i { if i != idx and movies[i].cat == cat { same.add(i) } }
        while same.len() > SIM_MAX { same.remove(same.len() - 1) }
        simRow.clear()
        for 0 : same.len() - 1 to k {
            int mi = same[k]
            simCards[k].set(sim_opts(movies[mi]))
            wire_card_menu(simCards[k], mi)          // 推荐位也能右键（同一套菜单 ✓）
            simRow.add(simCards[k], {align: 1})
        }
        simCount = same.len()
        // ⚠ 内容宽必须把 `simRow` 自己的**左右内边距**也算进去 ✗：只算"n 张 + 间距"的话，
        //   容器内宽 = 内容宽 − 2×28 ⇒ 卡片被压扁（实测：132 宽的卡被压成 76 ✗）
        int gaps = if simCount > 0 then simCount - 1 else 0
        float cw = _float(SIM_PADX * 2 + simCount * SIM_W + gaps * SIM_GAP)
        simSv.set_content_size(cw, _float(SIM_H))
        simSv.set_scroll(0.0, 0.0)                   // 换片后回到最左（否则停在上一部的偏移 ✓）
    }

    // ==================== 卡片右键菜单接线（网格卡与推荐位**共用一份** ✓）====================
    //   为什么抽出来：两处各写一份必然漂移 ✗（菜单项/回调一改就得改两遍）
    pri func wire_card_menu(Card c, int idx) {
        c.on_context_will_open(func() {
            c.clearContextItems()
            c.addContextItem({label: "进详情页", id: "open"})
            c.addContextItem({label: "播放", id: "play"})
            c.addContextItem({label: if c.is_selected() then "取消收藏" else "加入收藏", id: "fav"})
            c.addContextSeparator()
            c.addContextItem({label: "复制片名", id: "copy"})
        })
        c.on_context_select(func(string id) { on_card_menu(idx, id) })   // 闭包按值 ⇒ 每张卡各记各的下标 ✓
    }

    // ==================== 底部状态栏 ====================
    pri func build_status(VBox root) {
        statusBar = SDL3.createHBox({x: 0, y: 0, w: WIN_W, h: 28, pad_x: 14, pad_y: 0, spacing: 12,
                                     bg_color: C_PANEL})
        root.add(statusBar, {grow: 0, shrink: 0, basis: 28, align: 3})
        statLbl = SDL3.createLabel({text: "", font_size: 12, text_color: C_TXT_DIM})
        statusBar.add(statLbl, {grow: 0, shrink: 1, align: 1})
        // ★ 中间放一个 `grow:1` 的空标签吃掉自由空间 —— **别让文字标签去 grow** ✗：
        //   实测它会把右侧那项挤到只剩几十像素（文字被窗口右边裁掉 ✓）；同款撑位见顶部栏的 gapLbl ✓
        statusBar.add(SDL3.createLabel({text: ""}), {grow: 1, shrink: 1, align: 1})
        sortLbl = SDL3.createLabel({text: "", font_size: 12, text_color: C_TXT_DIM})
        // ⚠ 右侧这项必须给**显式 basis** ✗：`Label` 是"按加入时的自然宽"参与排版的 ——
        //   空文本建出来自然宽 = 0 ⇒ 盒子宽 0 ⇒ 之后 `set_text` 的文字**从盒子里溢出去**，
        //   被窗口右边缘裁掉（实测症状：右边那串只剩「默…」✓）。给了 basis 就有固定盒子 ✓
        statusBar.add(sortLbl, {grow: 0, shrink: 1, basis: 300, align: 1})
        update_status()
    }

    // 状态栏文案（**唯一出口**：筛选 / 搜索 / 排序 / 收藏 变化都调它 ✓）
    pri func update_status() {
        int fav = 0
        for 0 : cards.len() - 1 to i { if cards[i].is_selected() { fav = fav + 1 } }
        statLbl.set_text("共 " + _str(movies.len()) + " 部 · 当前 " + _str(collect().len()) +
                         " 部 · 收藏 " + _str(fav) + " 部")
        string sm = "默认排序"
        if sortMode == 1 { sm = "评分优先" }
        eif sortMode == 2 { sm = "年份优先" }
        string tail = if query != "" then " · 搜索：" + query else ""
        sortLbl.set_text(sm + " · 分类：" + curCat + tail)
    }

    // 空态提示：网格区一张卡都没有时画一行字（画在控件层之下 ⇒ 网格空了才看得见 ✓）
    //   ⚠ 不能拿 Label 藏在网格里：布局容器**不认 `visible=false`** ⇒ 它会照样占一排格子 ✗
    //     （这条同"详情页换根而不是隐藏"的取舍 ✓）
    pri func draw_empty_hint(Renderer r) {
        if not emptyNow or dOpen { return }
        if emptyFont == null { emptyFont = SDL3.createFontAuto(15.0) }
        if emptyFont == null or not emptyFont.ok { return }
        string t = "没有匹配的影片 —— 换个词，或点左栏的分类看看"
        var[float, float](tw, th) = emptyFont.measureString(t)
        // 直接量网格视口（`sv` 自己就知道在哪 ⇒ 不写死坐标 ✓）
        r.drawText(emptyFont, t, sv.x + (sv.w - tw) / 2.0, sv.y + (sv.h - th) / 2.0, #6E7789FF)
    }

    pri func make_cards() {
        cards = []
        actRows = []
        for 0 : movies.len() - 1 to i {
            Movie m = movies[i]
            Card c = SDL3.createCard({x: 0, y: 0, w: CARD_W, h: CARD_H,
                                      image_path: data.poster_path(m.file),
                                      image_aspect: CARD_ASPECT,
                                      title: m.title,
                                      subtitle: m.year + " / " + m.cat,
                                      badge: m.score, badge_pos: 0,      // 0 = 右上（v2 可配 ✓）
                                      image_radius: 10,                  // 图片自身圆角（v2.1 ✓ 不再把卡片圆角盖掉）
                                      radius: 10,
                                      border: true, border_color: #232A36FF,   // 常态近乎看不见 ✓
                                      border_selected_color: C_ACCENT,         // 选中 ⇒ 橙色描边（selected 态 ✓）
                                      content_h: 32, content_pad: 6, gap: 6,   // 容器化预留（先不挂 ✓）
                                      hover_lift: 3.0,                   // 悬停视觉上移（只动绘制 ✓）
                                      bg_color: C_CARD, hover_color: C_CARD_HV,
                                      text_color: C_TXT, subtitle_color: C_TXT_DIM,
                                      badge_bg: #000000B0, badge_color: #F5C451FF,
                                      tip: m.title + "（" + m.year + "）评分 " + m.score})
            // ★ 多角标（v2.1 ✓）：最新年份的片子左上角再挂一个「新」
            if m.year == "2026" {
                c.add_badge({text: "新", pos: 1, size: 11.0, bg: #C8102EFF, color: #FFFFFFFF})
            }
            c.on_click(func() { on_card_click(i) })
            // ★ 右键上下文菜单（Card 2026-10-13 新增能力 ✓）：
            //   详情 / 播放 / 收藏 ⇄ 取消 / 复制片名（接线与推荐位**共用 wire_card_menu** ✓）
            wire_card_menu(c, i)
            cards.add(c)
            actRows.add(build_actions(i))     // 只建一次，开关只负责挂/摘 ✓（避免反复 new 泄漏）
        }
    }

    // 卡内操作行（容器化的实拍件 ✓）：播放 + 收藏
    //   ⚠ 这两个按钮的点击**不会**顺带触发整卡 on_click（见 sdl_card.leno 的 inBody 闸门 ✓）
    pri func build_actions(int idx): HBox {
        HBox row = SDL3.createHBox({x: 0, y: 0, w: 100, h: 32, pad_x: 0, pad_y: 0, spacing: 6})
        Button pb = SDL3.createButton({text: "播放", w: 58, h: 26, font_size: 12, radius: 6,
                                       bg_color: C_ACCENT, text_color: C_ACC_TXT,
                                       border: false, shadow: false, tip: "打开详情（这里就是挂点 ✓）"})
        pb.on_click(func() { open_movie(idx) })
        row.add(pb, {grow: 0, shrink: 0, basis: 58, align: 1})
        Button fb = SDL3.createButton({text: "收藏", w: 58, h: 26, font_size: 12, radius: 6,
                                       bg_color: C_FIELD, hover_color: C_NAV_HV, text_color: C_TXT,
                                       border: false, shadow: false, tip: "选中 / 取消选中（selected 态 ✓）"})
        fb.on_click(func() { toggle_card_sel(idx) })
        row.add(fb, {grow: 0, shrink: 0, basis: 58, align: 1})
        row.add(SDL3.createLabel({text: ""}), {grow: 1, shrink: 1, align: 1})
        return row
    }

    // 开/关「卡内操作」：卡片变高（图片让位）、内容行挂上/摘下
    //   ⚠ 卡片高度变了 ⇒ 必须让 GridLayout **重新捕获**行高：`grid.clear()` 后再 add（见 rebuild ✓）
    pri func set_card_actions(bool on) {
        cardActions = on
        actBtn.set_text(if on then "收起操作" else "卡内操作")
        for 0 : cards.len() - 1 to i {
            if on {
                cards[i].set_size(CARD_W, CARD_H + 38)
                cards[i].set_content(actRows[i])
            } else {
                cards[i].clear_content()
                cards[i].set_size(CARD_W, CARD_H)
            }
        }
        rebuild()
        SDL3.markFrameRedraw()
    }

    // 单选：点卡片本体 = 选中它（其余取消）**并进入详情页** ✓（2026-10-13：原来是只打印 ✓）
    pri func on_card_click(int idx) {
        for 0 : cards.len() - 1 to i { cards[i].set_selected(i == idx) }
        open_detail(idx)
    }
    pri func toggle_card_sel(int idx) {
        cards[idx].set_selected(not cards[idx].is_selected())
        update_status()                  // 收藏数变了 ⇒ 底栏跟着走 ✓
    }

    // 卡片右键菜单的动作分发（菜单项 id 见 make_cards 的 on_context_will_open ✓）
    pri func on_card_menu(int idx, string id) {
        if idx < 0 or idx >= movies.len() { return }
        string t = movies[idx].title
        if id == "open" { on_card_click(idx); return }        // 走同一条路：选中 + 进详情 ✓
        eif id == "play" { print("[墙] 右键播放：" + t) }
        eif id == "fav" {
            toggle_card_sel(idx)
            print("[墙] 右键收藏切换：" + t + " ⇒ " + _str(cards[idx].is_selected()))
        }
        eif id == "copy" {
            SDL3.setClipboardText(t)                          // 真复制到系统剪贴板 ✓
            print("[墙] 已复制片名：" + t)
        }
        SDL3.markFrameRedraw()
    }

    // ==================== 筛选 / 排序 ====================
    pri func match(Movie m): bool {
        if curCat != data.CAT_ALL and m.cat != curCat { return false }
        if query != "" {
            // 片名 / 分类 / 简介 / 年份 都能搜（年份是纯数字 ⇒ 输入 "2024" 也能筛出来 ✓）
            if strings.has(m.title, query) or strings.has(m.cat, query)
               or strings.has(m.desc, query) or strings.has(m.year, query) {
                return true
            }
            return false
        }
        return true
    }

    // 命中下标（按当前排序 ✓）。★ 数值排序用 `_float(字符串)`：把 "9.1" 解析成浮点
    //   ⇒ 比字符串比较可靠（"10.0" < "9.1" 那种坑不会出现 ✓；`_float` 支持字符串 ✓）
    pri func collect(): Array[int] {
        Array[int] idx = []
        for 0 : movies.len() - 1 to i { if match(movies[i]) { idx.add(i) } }
        if sortMode != 0 { sort_idx(idx) }
        return idx
    }

    // 插入排序（数据量小 ⇒ 够用 ✓）。sortMode 1 = 评分降序 / 2 = 年份降序
    pri func sort_idx(Array[int] idx) {
        int n = idx.len()
        for 1 : n - 1 to i {
            int key = idx[i]
            float kv = if sortMode == 1 then _float(movies[key].score) else _float(movies[key].year)
            int j = i - 1
            while j >= 0 {
                float jv = if sortMode == 1 then _float(movies[idx[j]].score) else _float(movies[idx[j]].year)
                if jv >= kv { break }
                idx[j + 1] = idx[j]
                j = j - 1
            }
            idx[j + 1] = key
        }
    }

    // 按命中名单重排网格（只换 add 名单 ⇒ 卡片对象/纹理都复用 ✓）
    pri func rebuild() {
        grid.clear()
        Array[int] idx = collect()
        emptyNow = idx.len() == 0        // 命中 0 部 ⇒ 网格区走空态提示（见 draw_empty_hint ✓）
        for 0 : idx.len() - 1 to i { grid.add(cards[idx[i]], {align: 3}) }
        sv.set_scroll(0.0, 0.0)     // 换筛选后回到顶部（否则停在"上一批"的位置 ✓）
        rebuild_table()             // 列表视图同一份名单 ⇒ 一起刷（两视图永不错位 ✓）
        SDL3.markFrameRedraw()
    }

    pri func update_total() {
        int n = collect().len()
        if curCat == data.CAT_ALL { totalLbl.set_text("（共 " + _str(n) + " 部）") }
        else { totalLbl.set_text("（" + curCat + " / " + _str(n) + " 部）") }
        if query != "" { totalLbl.set_text(totalLbl.get_text() + "  搜索：" + query) }
        update_status()                  // 顶栏总数与底栏状态**同一出口**更新 ⇒ 不会各说各话 ✓
    }

    // ==================== 交互回调 ====================
    pri func set_cat(string c) {
        curCat = c
        // 选中的分类若藏在「更多」里 ⇒ 自动展开（否则侧栏上**看不到任何选中态** ✗）
        if not moreOpen {
            var more = data.cats_more()
            for 0 : more.len() - 1 to i {
                if more[i] == c {
                    moreOpen = true
                    sync_more_btn()
                    rebuild_side()
                    break
                }
            }
        }
        for 0 : navs.len() - 1 to i { style_nav(navs[i], navNames[i] == curCat) }
        rebuild()
        update_total()
    }

    pri func on_search() {
        query = strings.trim(search.get_text())
        rebuild()
        update_total()
    }

    pri func on_filter() {
        sortMode = (sortMode + 1) % 3
        if sortMode == 0 { filterBtn.set_text("菜单键筛选") }
        eif sortMode == 1 { filterBtn.set_text("评分优先") }
        else { filterBtn.set_text("年份优先") }
        rebuild()
        SDL3.markFrameRedraw()
    }

    pri func go_home() {
        search.set_text("")
        query = ""
        sortMode = 0
        filterBtn.set_text("菜单键筛选")
        set_cat(data.CAT_ALL)
    }

    // 卡内「播放」按钮的挂点：直接进详情页（真实应用里可换成"起播 + 进详情" ✓）
    pri func open_movie(int idx) {
        open_detail(idx)
    }
}

// ==================== 程序入口 ====================
main() {
    Wall w = new Wall()
    w.run()
}
