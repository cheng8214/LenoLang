// trae_core.leno — TraeSign 共享核心（CLI 与 GUI 用**同一份**实现）
//
// 为什么单独成文件：② 读登录态、③ 签到接口要被 CLI（`trae_sign.leno`）与 GUI（`trae_gui.leno`）
// 共用 ⇒ 抽到这里，避免两套实现漂移（见 `docs/待办_单一事实来源与重复实现收敛.md`）✓
//
// 约定：本文件**不打印任何东西**、不含 `main()`、不解析命令行参数 ⇒ 可安全被多方 import ✓
// 安全：只**读** Trae 登录态文件；**不打印 token**；不修改登录态文件 ✓
import jsons
import strings
import files
import times
import rands
import "web_net" as net
use net.(HttpClient, Response)
import "trae_crypto.leno" as crypt

var BRANDS = ["TRAE SOLO CN", "Trae CN", "TraeWork"]
var DEFAULT_API_BASE = "https://api.trae.cn"
var DC_PREFIX = "iCubeAuthInfo://icube-dc:"
var CLOUD_PREFIX = "iCubeAuthInfo://icube.cloudide"

// 接口地址做成**函数**（而不是常量）的唯一原因：让 ③b 的"9074 换设备号重试"能**离线端到端**验证 ✓
// —— `TRAE_API_BASE` 指向 `tools/test_9074_retry.js` 起的本地 stub 服务，就能在完全不碰真接口的
// 前提下验证"第一次 9074 → 换设备号 → 第二次成功"这条链路 ✓（不设该环境变量 ⇒ 与以前完全一致 ✓）
export func api_base(): string {
    var b = _env("TRAE_API_BASE")
    if b == null { return DEFAULT_API_BASE }        // 注意：`_env` 返回 any ⇒ 先判 null 再 _str ✓
    var s = _str(b)                                 // （`_str(null)` 会得到字符串 "null" ✗）
    if s == "" { return DEFAULT_API_BASE }
    return s
}
export func status_url(): string { return api_base() + "/trae/api/v2/ug/checkin_credits/status" }
export func claim_url(): string { return api_base() + "/trae/api/v2/ug/checkin_credits/claim" }

// ==================== ① JSON 取值助手 ====================
// 为什么要这一层：`jsons.decode/read_file` 返回 `any` ✗，语言不允许把 any 直接当 Dict 用
// （也不能赋给 Dict 变量），必须**显式类型收窄**（`if x is Dict { ... }`）。
// 收窄都收在这一层里，业务代码就只跟 string / Array[string] 打交道 ✓。
export func json_get(any obj, string key): string {
    if obj is Dict {
        Dict d = obj
        if d.has(key) {
            var v = d[key]
            if v != null { return _str(v) }
        }
    }
    return ""
}
export func json_obj(any obj, string key): any {
    if obj is Dict {
        Dict d = obj
        if d.has(key) { return d[key] }
    }
    return null
}
export func json_keys(any obj): Array[string] {
    var out = []
    if obj is Dict {
        Dict d = obj
        var ks = d.keys()
        for ks to k {
            out.add(_str(k))
        }
    }
    return out
}

// ==================== ② 读登录态（只读） ====================

export func storage_path(string brand): string {
    var appdata = _env("APPDATA")
    if appdata == null { return "" }
    return appdata + "\\" + brand + "\\User\\globalStorage\\storage.json"
}

// 读某个品牌的登录态 → [enc, dcId]；没找到 ⇒ []
export func pick_auth(string brand): Array[string] {
    var p = storage_path(brand)
    if p == "" { return [] }
    if not files.exists(p) { return [] }
    var s = jsons.read_file(p)
    var keys = json_keys(s)
    var enc = ""
    var dc = ""
    for keys to k {
        if strings.starts_with(k, DC_PREFIX) {
            dc = k.byte_slice(DC_PREFIX.byte_len(), k.byte_len())
        } else if strings.starts_with(k, CLOUD_PREFIX) {
            enc = json_get(s, k)
        }
    }
    if enc == "" { return [] }
    if dc == "" {
        dc = json_get(s, "telemetry.devDeviceId")
        if dc == "" { dc = json_get(s, "telemetry.machineId") }
    }
    return [enc, dc]
}

// 登录态 → [brand, username, token, region, dcId]；失败 ⇒ []
export func load_account(string brand): Array[string] {
    var a = pick_auth(brand)
    if a.len() == 0 { return [] }
    var json = crypt.trae_decrypt_auth(a[0])
    if json == "" { return [] }
    var ad = jsons.decode(json)
    var token = json_get(ad, "token")
    var username = json_get(json_obj(ad, "account"), "username")
    var region = json_get(json_obj(ad, "userRegion"), "region")
    return [brand, username, token, region, a[1]]
}

// 各品牌可用的登录态（只读扫描；不打印 token）→ Array[[brand, username, hasToken]]
export func scan_accounts(): Array[Array[string]] {
    var out = []
    for BRANDS to brand {
        var a = pick_auth(brand)
        if a.len() == 0 { continue }
        var json = crypt.trae_decrypt_auth(a[0])
        var username = ""
        var has_token = "false"
        if json != "" {
            var ad = jsons.decode(json)
            if json_get(ad, "token") != "" { has_token = "true" }
            username = json_get(json_obj(ad, "account"), "username")
        }
        out.add([brand, username, has_token])
    }
    return out
}

// 缺省账号（第一个可用的）→ 同 load_account
export func default_account(): Array[string] {
    for BRANDS to b {
        var acc = load_account(b)
        if acc.len() > 0 { return acc }
    }
    return []
}

// ==================== ③ 签到接口 ====================

// 建好鉴权头的一次性客户端
// ⚠ 必须**一次**设完所有头：`setHeaders` 是**替换**语义，分两次调用会把 Authorization /
// x-device-id 覆盖掉 ⇒ 服务端看到未鉴权请求，返回 `code:1001 not able to authenticate you`
// （实测踩过这个坑 ✗）⇒ 这里按有无 region 走两条完整列表，绝不追加第二次 ✓。
export func authed_client(string token, string dc_id, string region): HttpClient {
    net.globalInit()
    HttpClient c = net.createClient()
    c.setTimeout(20000)
    if region != "" {
        c.setHeaders([
            "Content-Type: application/json",
            "Authorization: Cloud-IDE-JWT " + token,
            "x-device-id: " + dc_id,
            "X-User-Region: " + region
        ])
    } else {
        c.setHeaders([
            "Content-Type: application/json",
            "Authorization: Cloud-IDE-JWT " + token,
            "x-device-id: " + dc_id
        ])
    }
    return c
}

// 一次 JSON POST（带 Trae 的鉴权头）；HTTP 层失败 ⇒ 返回带 _http_error 的对象
export func api_post(HttpClient c, string url, string body): any {
    Response r = c.post(url, body)
    if not r.ok() {
        return {"_http_error": _str(r.statusCode), "_error": _str(r.error), "_raw": r.body}
    }
    var d = jsons.decode(r.body)
    if d is Dict {
        Dict dd = d
        dd["_status"] = _str(r.statusCode)
        dd["_raw"] = r.body
    }
    return d
}

export func jval(any d, string key): string {
    return json_get(d, key)
}

// 查状态 → [ok, httpErr, err, code, raw, base, extra, checkedIn, msg]
export func fetch_status(HttpClient c): Array[string] {
    var st = api_post(c, status_url(), "{}")
    var he = jval(st, "_http_error")
    if he != "" {
        return ["false", he, jval(st, "_error"), jval(st, "_status"), jval(st, "_raw"),
                "", "", "false", "HTTP " + he]
    }
    var base = jval(st, "credits")
    var extra = jval(st, "extra_credits")
    var checked = jval(st, "checked_in")
    var code = jval(st, "code")
    var raw = jval(st, "_raw")
    if base == "" and extra == "" {
        // 9074 单独给文案：它**不是**"token 过期"（重登没用、换设备号才有用 ✓）⇒ 别误导用户 ✗
        if code == "9074" {
            return ["false", "", "", code, raw, "", "", checked, "命中风控 9074（参与用户太多）"]
        }
        return ["false", "", "", code, raw, "", "", checked,
                "账号状态异常（token 可能已过期），请重新登录该软件"]
    }
    return ["true", "", "", code, raw, base, extra, checked, ""]
}

// 签到（含二次确认：防 token 过期导致 claim 假成功）
//   → [ok, code, httpErr, base, extra, msg, already]
//   slot 6 `already`（**追加在末尾** ⇒ 旧消费者按下标 0..5 读不受影响 ✓）：
//     "true" = 服务端**本来就已签到**（本次并没有真的签到）⇒ 调用方据此**不要**记成一次新成功 ✓
//
// ⚠ 为什么用"提交前先查状态"而不是看 claim 响应：实测 claim 响应只有
//   `{"code":0,"message":"success"}` —— **没有** `checked_in` / `did_checked_in` ✗
//   （那两个字段只在 **status** 响应里有 ✓）⇒ 无法从 claim 响应判断"本次是否真的签到了" ✓。
//   于是与 CLI **口径一致**：状态说已签 ⇒ **不重复提交** ✓（CLI 早就这么做 ✓，见 trae_sign.leno）。
export func do_claim(HttpClient c): Array[string] {
    // ① 提交前先查状态：已签到 ⇒ 直接返回（不重复提交 ✓、也不冒充"本次签到成功" ✓）
    var pre = fetch_status(c)
    if st_ok(pre) and st_checked(pre) {
        return ["true", "0", "", st_base(pre), st_extra(pre),
                "服务端显示今日已签到（本次未重复提交）", "true"]
    }
    var cl = api_post(c, claim_url(), "{\"req_source\":1}")
    var he = jval(cl, "_http_error")
    if he != "" { return ["false", "", he, "", "", "HTTP " + he, "false"] }
    var code = jval(cl, "code")
    var cchecked = jval(cl, "checked_in")
    if code == "0" or cchecked == "true" {
        var cf = api_post(c, status_url(), "{}")
        if jval(cf, "checked_in") == "true" {
            return ["true", "0", "", jval(cf, "credits"), jval(cf, "extra_credits"), "签到成功", "false"]
        }
        // 错误码 -6 与参考件/旧 CLI **逐字一致** ✓（"假成功"分支）
        return ["false", "-6", "", "", "", "签到结果异常（token 可能已过期），请重新登录该软件", "false"]
    }
    if code == "9095" {
        return ["false", "9095", "", "", "", "本设备今日已有账号签到（同机每天只允许一个账号）", "false"]
    }
    var mf = jval(cl, "message")
    if mf == "" { mf = "签到失败" }
    return ["false", code, "", "", "", mf, "false"]
}

// ---- fetch_status 结果字段访问（下标集中在函数里，业务代码不写魔法数字）----
export func st_ok(Array[string] r): bool            { return r[0] == "true" }
export func st_http_err(Array[string] r): string    { return r[1] }
// 注意：slot 3 是 **HTTP 状态码**（原 CLI 的 `--debug` 打印它）✓ 不是业务 code
export func st_http_code(Array[string] r): string   { return r[3] }
export func st_err(Array[string] r): string         { return r[2] }
export func st_raw(Array[string] r): string         { return r[4] }
export func st_base(Array[string] r): string        { return r[5] }
export func st_extra(Array[string] r): string       { return r[6] }
export func st_checked(Array[string] r): bool       { return r[7] == "true" }
export func st_msg(Array[string] r): string         { return r[8] }
// 积分展示串（base + extra）；没数据 ⇒ ""
export func st_score_text(Array[string] r): string {
    if not st_ok(r) { return "" }
    return "今日积分 " + r[5] + "（基础 " + r[5] + " + 额外 " + r[6] + "）"
}

// ---- do_claim 结果字段访问 ----
export func cl_ok(Array[string] r): bool            { return r[0] == "true" }
export func cl_code(Array[string] r): string        { return r[1] }
export func cl_http_err(Array[string] r): string    { return r[2] }
export func cl_base(Array[string] r): string        { return r[3] }
export func cl_extra(Array[string] r): string       { return r[4] }
export func cl_msg(Array[string] r): string         { return r[5] }
// slot 6（新增）：服务端本来就已签到 ⇒ 本次并没有真的签到（调用方别记成新成功 ✓）
export func cl_already(Array[string] r): bool       { return r[6] == "true" }

// ==================== ③b 风控 9074：换设备号重试（③ 的失败重试） ====================
// 9074 =「参与用户太多」的风控拒绝。被拒的是**设备号**、不是 token ⇒ 换一个全新设备号即可继续，
// **不需要**重新登录 ✓（对标参考实现 `TraeTools/Services/Checkin` 的 checkin.py L145-154：
// 随机设备号 + 最多 5 次 + 每次间隔 0.8~1.5s ✓）。
//
// 两条硬约束（都来自参考件，别想当然 ✗）：
//   ① 设备号必须是**16 位数字**（首位非 0）：GUID/UUID 之类会**直接**被判风控 ⇒ 必然 9074 ✗
//      （参考件注释：「x-device-id 必须是 16 位数字；使用 GUID/UUID 会触发 9074」）；
//   ② 换了号要**重做整套流程**（查状态 → claim → 二次确认），不能只重发 claim：
//      本项目口径是"状态说已签就不重复提交"，若状态那一步被 9074 挡掉，单发 claim 就变成在
//      "不知道服务端是否已签"的情况下盲提交 ⇒ 结果无法解释 ✗（见 do_claim 的注释）
//      ⇒ 下面两个 wrapper 都是"换号后从查状态重做" ✓。
//
// 为什么必须换而不是重试同一个号：风控是**按设备号**标记的（本机登录态里的 `dcId` 就是客户端
// 给的号），同一个号重发多少次都还是 9074 ✗。
export const int MAX_TRY_9074 = 5

// 16 位数字风控设备号（首位 1~9 ⇒ 恰好 16 位；对齐 checkin.py 的 random.randint(10^15, 10^16-1) ✓）
export func random_device_id(): string {
    return rands.ints(1000000000000000, 9999999999999999) as string
}

// 是否是合法的 16 位数字设备号（首位非 0）：用来校验 `TRAE_DEVICE_ID` 覆盖值与登录态里的 dcId ✓
// ⚠ 这里**逐字符**校验，两个"看起来能用"的写法都有坑 ✗：
//   ① `_int(s)`：本机对超过 INT32_MAX 的数字串会**饱和**成 2147483647（探针实测
//      `_int("9999999999999999")` = 2147483647）⇒ 根本区分不出来 ✗；
//   ② `_float(s)` 比范围：**double 在 1e16 附近间距是 2** ⇒ `9999999999999999` 会被舍入成 `1e16`
//      正好撞上上界（探针实测），`f < 1e16` 就会把合法号判成非法 ✗（本测试第 6 节踩到过）。
//   ⇒ 干脆只做"长度 + 首位 + 每个字符都是 0~9"这三件事，精确且与数值范围无关 ✓
export func is_valid_device_id(string s): bool {
    if s.len() != 16 { return false }
    if s.byte_slice(0, 1) == "0" { return false }
    var digits = "0123456789"
    int i = 0
    while i < 16 {
        if not strings.has(digits, s.byte_slice(i, i + 1)) { return false }
        i = i + 1
    }
    return true
}

// 是否该"换设备号重试"（纯逻辑 ⇒ 可离线自测 ✓）：只有 9074 会重试，且总次数不超过 max_try ✓
// 9095（本设备今日已有账号签到）/ 1001（未鉴权）/ 0 都**不**重试 ✓（换号解决不了 ✗）
export func need_retry_9074(string code, int attempt, int max_try): bool {
    return code == "9074" and attempt < max_try
}

// 换号间隔：0.8~1.5s 随机（对齐 checkin.py 的 random.uniform(0.8, 1.5) ✓），降低再次被风控的概率
// 用**全局** `sleep(ms)`（注意：它是全局原生函数，**不在** `times` 模块里 ⇒ `times.sleep` 会报
// "未找到模块方法" ✗，直接写 `sleep(ms)` 就行 ✓；探针实测 sleep(300) ≈ 305ms ✓）
// 返回值 = 实际睡了多少毫秒（调用方一般不关心；留着便于诊断 ✓）
export func risk_sleep(): int {
    var ms = rands.ints(800, 1500)
    sleep(ms)
    return ms
}

// ---- 结果数组里"本次实际用的设备号"（**追加在末尾** ⇒ 旧消费者按下标 0..N 读不受影响 ✓，
//      与 do_claim 新增 slot 6 `already` 是同一个加法约定 ✓）----
export func st_device(Array[string] r): string { return r[9] }
export func cl_device(Array[string] r): string { return r[7] }

// fetch_status 的结果是否"业务层 9074"：
// ⚠ fetch_status 的 slot 3 在**业务错误**分支里装的是**业务 code**（只有 HTTP 层错误才是 HTTP 码，
//   那种情况 slot 1 非空）⇒ 这里用"slot 1 为空"把两种情况分开 ✓
export func st_risk_9074(Array[string] r): bool {
    if r[1] != "" { return false }
    return r[3] == "9074"
}
export func st_need_retry_9074(Array[string] r, int attempt, int max_try): bool {
    return st_risk_9074(r) and attempt < max_try
}

// 查状态 + 9074 换设备号重试 → fetch_status 的 9 个 slot ＋ 追加 slot 9 = 实际用的设备号 ✓
// 注意每次都**重建 client**：设备号在请求头里，而 `setHeaders` 是替换语义 ⇒ 改号必须重建 ✓
export func fetch_status_retry(string token, string dc_id, string region, int max_try): Array[string] {
    var dc = dc_id
    int attempt = 1
    var st = fetch_status(authed_client(token, dc, region))
    while st_need_retry_9074(st, attempt, max_try) {
        risk_sleep()
        dc = random_device_id()
        attempt = attempt + 1
        st = fetch_status(authed_client(token, dc, region))
    }
    st.add(dc)
    return st
}

// 签到（含二次确认）+ 9074 换设备号重试 → do_claim 的 7 个 slot ＋ 追加 slot 7 = 实际用的设备号 ✓
// 每次重试都是**整跑一遍 do_claim**（查状态 → claim → 二次确认）⇒ 口径与单次流程完全一致 ✓
export func do_claim_retry(string token, string dc_id, string region, int max_try): Array[string] {
    var dc = dc_id
    int attempt = 1
    var r = do_claim(authed_client(token, dc, region))
    while need_retry_9074(cl_code(r), attempt, max_try) {
        risk_sleep()
        dc = random_device_id()
        attempt = attempt + 1
        r = do_claim(authed_client(token, dc, region))
    }
    r.add(dc)
    return r
}

// ==================== ④ 日期助手（日历用；纯整数算法） ====================
// Howard Hinnant 的 days_from_civil：1970-01-01 = 0
// 星期 = (days + 4) % 7 ⇒ 0=周日 ✓（1970-01-01 是周四 ✓，验证过）
export func days_from_civil(int y, int m, int d): int {
    int yy = y
    if m <= 2 { yy = y - 1 }
    int era = yy / 400
    if yy < 0 and yy % 400 != 0 { era = era - 1 }
    int yoe = yy - era * 400
    int mp = m + 9
    if m > 2 { mp = m - 3 }
    int doy = (153 * mp + 2) / 5 + d - 1
    int doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468
}
export func weekday_of(int y, int m, int d): int {
    return (days_from_civil(y, m, d) + 4) % 7
}
export func days_in_month(int y, int m): int {
    if m == 2 {
        if (y % 4 == 0 and y % 100 != 0) or y % 400 == 0 { return 29 }
        return 28
    }
    if m == 4 or m == 6 or m == 9 or m == 11 { return 30 }
    return 31
}
export func pad2(int n): string {
    if n < 10 { return "0" + (n as string) }
    return n as string
}
export func date_str(int y, int m, int d): string {
    return (y as string) + "-" + pad2(m) + "-" + pad2(d)
}
// 某月的前缀（历史键用）："2026-09-"
export func month_prefix(int y, int m): string {
    return (y as string) + "-" + pad2(m) + "-"
}
// 今天：[y, m, d]（用 times.format 取本地日期，避开 datetime() 的数组元素类型不确定性 ✓）
export func today_parts(): Array[int] {
    var t = times.now()
    return [_int(times.format(t, "%Y")), _int(times.format(t, "%m")), _int(times.format(t, "%d"))]
}
export func today_str(): string {
    var p = today_parts()
    return date_str(p[0], p[1], p[2])
}
// 上一个月 / 下一个月的 [y, m]
export func prev_month(int y, int m): Array[int] {
    if m <= 1 { return [y - 1, 12] }
    return [y, m - 1]
}
export func next_month(int y, int m): Array[int] {
    if m >= 12 { return [y + 1, 1] }
    return [y, m + 1]
}
