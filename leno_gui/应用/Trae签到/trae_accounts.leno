// trae_accounts.leno — ⑨ 账号持久化（登录态 15 天有效 ⇒ 客户端登出后仍可签）
//
// 为什么需要（2026-09-28 用户反馈）：`core.scan_accounts()` 只扫各品牌的 `storage.json` ——
//   客户端一旦登出，那个账号就从列表里消失 ✗；而 token 是 15 天有效的 JWT，登出并不让它
//   立刻失效 ⇒ 本工具把**见过的账号**（token/region）落盘到**自己的目录**，列表 = 在线扫描 ∪ 已保存。
//   在线的账号每次启动都刷新落盘（token 重登会变 ⇒ 永远以在线扫描为准 ✓）。
//
// 落盘：`%APPDATA%\TraeSignLeno\accounts.json`（与 devices.json/history.json 同款**扁平**
//   `string → string` 表 ✓ 只由本工具写 ⇒ 值恒为 string ⇒ `is Dict[string, string]` 恒成立 ✓；
//   "为什么扁平"与"避开收窄那条早已不是理由"见 `trae_history.leno` 顶上 ✓）：
//   key：`"<brand>|<user>|token"`  → token（JWT，敏感：只落自己的目录、绝不打印 ✓）
//        `"<brand>|<user>|region"` → region（请求头 `X-User-Region` 用；可空串）
//        `"<brand>|<user>|seen"`   → 最近一次**在线**见到的日期（2026-09-28）
//   枚举：扫 `|token` 结尾的键 ⇒ 去掉后缀即 `brand|user`（brand/user 不含 `|`，
//   与 devices.json 的 key 约定同一假设 ✓）
//
// 安全：不打印 token；不改 Trae 的任何文件 ✓
import jsons
import files
import dirs
import strings
import "trae_devices.leno" as dev        // 复用 devices_dir()（同一个数据目录 ✓）

// 全部记录（扁平表）；文件不存在 / 结构不符 ⇒ null（与 devices.load_all 同口径 ✓）
func load_all(): Dict[string, string]? {
    var p = path()
    if p == "" { return null }
    if not files.exists(p) { return null }
    if jsons.read_file(p) is Dict[string, string] => db { return db }
    return null
}

export func path(): string {
    var d = dev.devices_dir()
    if d == "" { return "" }
    return d + "\\accounts.json"
}

// 保存/刷新一个账号（upsert：保留其它账号 ✓）；seen = 最近在线日期（调用方传 core.today_str() ✓）
export func save(string brand, string user, string token, string region, string seen): bool {
    var p = path()
    if p == "" { return false }
    var d = dev.devices_dir()
    if not dirs.is_dir(d) { dirs.mkdir_p(d) }
    var db = load_all() ?? {}
    var base = brand + "|" + user
    db[base + "|token"] = token
    db[base + "|region"] = region
    db[base + "|seen"] = seen
    return jsons.write_file(p, db)
}

// 某账号的保存凭据 → [token, region]；没有 ⇒ ["", ""]
export func get(string brand, string user): Array[string] {
    var all = load_all()
    var base = brand + "|" + user
    return [jsons.get_str(all, base + "|token", ""), jsons.get_str(all, base + "|region", "")]
}

// 删除某账号的保存凭据（GUI「删除该账号」用）⇒ true 表示删掉了（本来就没有 ⇒ false）
// 只动 accounts.json：签到历史（history.json）与设备号（devices.json）都保留 ——
//   历史是既成事实；设备号同账号重加时沿用更稳（风控按设备号，换新号反而易撞 9074 ✓）
export func remove(string brand, string user): bool {
    var p = path()
    if p == "" { return false }
    var db = load_all() ?? {}
    var base = brand + "|" + user
    if jsons.get_str(db, base + "|token", "") == "" { return false }
    db.remove(base + "|token")
    db.remove(base + "|region")
    db.remove(base + "|seen")
    return jsons.write_file(p, db)
}

// 全部已保存账号 → Array[[brand, user, token, region]]（顺序 = 文件键序 ✓）
export func all_accounts(): Array[Array[string]] {
    Array[Array[string]] out = []
    var all = load_all()
    var ks = jsons.keys(all)
    for ks to k {
        // 只认 "|token" 结尾的键（每个账号恰好一条 ✓）；base = "brand|user"
        if not strings.ends_with(k, "|token") { continue }
        var base = strings.slice(k, 0, k.len() - 6)
        var brand = ""
        var user = ""
        // 第一个 "|" 切 brand / user（brand 是固定三个品牌名，不含 "|" ✓）
        int cut = strings.find(base, "|")
        if cut < 0 { continue }
        brand = strings.slice(base, 0, cut)
        user = strings.slice(base, cut + 1, base.len())
        var token = jsons.get_str(all, k, "")
        if token == "" { continue }
        out.add([brand, user, token, jsons.get_str(all, base + "|region", "")])
    }
    return out
}
