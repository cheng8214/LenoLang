// trae_devices.leno — ⑧ 设备号（`x-device-id`）**按账号独立**存储
//
// 为什么需要（这是"同机两个账号只有一个能签到"的根因）：
//   Trae 签到接口的风控/额度是按 `x-device-id` 判的 ——
//     ① 同机同一天只允许**一个**账号签到 ⇒ 第二个账号返回 `9095`（"本设备今日已有账号签到"）；
//     ② 多账号**共用**一个设备号容易被判 `9074`（"参与用户太多"）。
//   而登录态 `storage.json` 里的 `dcId` 是**机器级**的 ⇒ 两个品牌读出来是**同一个**号 ✗
//   ⇒ 必须在本工具**自己的目录**里给每个账号记一个独立号 ✓。
//
// 对标参考件（TraeTools-main，全部有据）：
//   - `TraeAccount.cs`：「x-device-id（16 位数字，风控关键），**每账号独立**」✓
//   - `AccountHelpers.EnsureDeviceId()`：「缺号则生成**不与其它账号重复**的 16 位数字设备号
//     （风控要求，多账号共用会触发 9074）」＋ `do { … } while (used.Contains(id))` ✓
//   - `AppConfig.TryResolveAhaDeviceId()`：「**优先复用官方客户端的真实 Aha 设备 ID**」✓ ⇒ 本文件的
//     "首个来分配的账号沿用 Aha 号，其余发新号" 就是这条 ✓
//   - `SettingsViewModel.RegenerateDeviceId()`：被 9074 标记时可**手动换号并落盘** ✓
//
// 落盘：`%APPDATA%\TraeSignLeno\devices.json`（**自己的目录**，绝不改 Trae 的任何文件 ✓）
// 结构（与 `history.json` 同款**扁平**键 ⇒ 避开嵌套 JSON 的类型收窄 ✗）：
//   { "TRAE SOLO CN|cheng8214": "2029015639819002", "Trae CN|用户6834498633": "7914448225945861" }
import jsons
import files
import dirs
import "trae_core.leno" as core

export func devices_dir(): string {
    var appdata = _env("APPDATA")
    if appdata == null { return "" }
    return appdata + "\\TraeSignLeno"
}
export func devices_path(): string {
    var d = devices_dir()
    if d == "" { return "" }
    return d + "\\devices.json"
}

// 全部记录（`any`；读取一律走 core.json_get / core.json_keys ✓）
export func load_all(): any {
    var p = devices_path()
    if p == "" { return null }
    if not files.exists(p) { return null }
    return jsons.read_file(p)
}

export func key_of(string brand, string user): string {
    return brand + "|" + user
}

// 某账号已分配的设备号；没有 ⇒ ""
export func get(string brand, string user): string {
    return core.json_get(load_all(), key_of(brand, user))
}

// 已分配的**全部**设备号（"新号不许与别人重复"要靠它 ✓）
export func used_ids(): Array[string] {
    Array[string] out = []
    var all = load_all()
    var ks = core.json_keys(all)
    for ks to k {
        var v = core.json_get(all, k)
        if v != "" { out.add(v) }
    }
    return out
}

func in_arr(Array[string] a, string v): bool {
    for a to x {
        if x == v { return true }
    }
    return false
}

// 写某账号的设备号（保留其它账号 ✓）；成功 ⇒ true
// 注意起始对象**必须**用 `jsons.decode("{}")` 或读回旧文件（`jsons.write_file` 会把参数再 JSON
// 编码一次 ⇒ 传字符串 "{}" 会落盘成带引号的 `"{}"` ✗，读回来是 string 而不是对象 —— 见 README）
export func set(string brand, string user, string dc): bool {
    var p = devices_path()
    if p == "" { return false }
    var d = devices_dir()
    if not dirs.is_dir(d) { dirs.mkdir_p(d) }
    var cur = jsons.decode("{}")
    var old = load_all()
    if old is Dict { cur = old }
    if cur is Dict {
        Dict db = cur
        db[key_of(brand, user)] = dc
        return jsons.write_file(p, db)
    }
    return false
}

// 删除某账号的记录（自测清理用）⇒ true 表示删掉了
export func remove(string brand, string user): bool {
    var p = devices_path()
    if p == "" { return false }
    var all = load_all()
    if all is Dict {
        Dict db = all
        var k = key_of(brand, user)
        if not db.has(k) { return false }
        db.remove(k)
        return jsons.write_file(p, db)
    }
    return false
}

// 解析某账号本次要用的设备号 → [id, source]（**会落盘** ⇒ 幂等：下次取到同一个号 ✓）
//   source = "stored"（已有记录）/ "aha"（首次分配：沿用登录态里的 Aha 号）/ "new"（首次分配：发了新号）
// 规则：
//   ① 已有记录 ⇒ 直接用（换过号之后也一直用新号，不会退回旧号 ✓）；
//   ② 没有记录 ⇒ Aha 号**合法**且**没被别的账号占用**就沿用它（对齐参考件的"优先复用真实 Aha 号"✓），
//      否则发一个与**全部已记录号**都不重复的新号 ✓。
//   ⚠ "首个来分配的账号"实际是**确定性**的：GUI 启动查的是列表第一个账号、CLI 缺省用
//     `core.default_account()`（都按 `core.BRANDS` 顺序 ✓）⇒ 第一个品牌沿用 Aha 号 ✓。
export func ensure(string brand, string user, string aha_id): Array[string] {
    var have = get(brand, user)
    if have != "" { return [have, "stored"] }
    var dc = ""
    var src = "new"
    if core.is_valid_device_id(aha_id) and not in_arr(used_ids(), aha_id) {
        dc = aha_id
        src = "aha"
    } else {
        dc = core.random_device_id()
        while in_arr(used_ids(), dc) { dc = core.random_device_id() }
    }
    set(brand, user, dc)
    return [dc, src]
}

// 手动换一个全新设备号（GUI「更换设备号」/ 被 9074 标记时用 ✓，对齐参考件 RegenerateDeviceId ✓）
// 返回新号；换号后**立刻落盘** ⇒ 后续运行都沿用新号 ✓
export func regenerate(string brand, string user): string {
    var dc = core.random_device_id()
    while in_arr(used_ids(), dc) { dc = core.random_device_id() }
    set(brand, user, dc)
    return dc
}
