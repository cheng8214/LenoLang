// 回归：用金标 fixture 验证 Trae 派生解密（**合成数据、非机密** ⇒ 可进仓库 ✓）
//
// fixture 由 `tools/gen_fixture.js` 生成（用同一算法正向加密合成 payload，并用参考实现反向自校验）；
// 断言是**绝对期望值** ⇒ 任何执行配置下都必须 PASS ✓
// 跑（在仓库根）：build\leno.exe leno_module\LenoSDL3\examples\应用示例\Trae签到\test\test_trae_decrypt_fixture.leno
import "../trae_crypto.leno" as crypt
import files
import strings

main() {
    var dir = "leno_module/LenoSDL3/examples/应用示例/Trae签到/tools/"
    var args = _args()
    if args.len() > 0 { dir = args[0] }

    string enc = files.read(dir + "fixture_enc.txt")
    string exp = files.read(dir + "fixture_expect_json.txt")
    if enc.len() < 32 or exp.len() == 0 {
        print("读不到 fixture ⇒ 先在 tools 下运行 `node gen_fixture.js`\n")
        assert_eq(1, 0)
        return
    }

    var got = crypt.trae_decrypt_auth(enc)
    if got != exp {
        print("---- 解密结果与期望不一致 ----\n")
        print("期望: " + exp + "\n")
        print("实际: " + got + "\n")
    }
    assert_eq(got, exp)
    assert_eq(strings.has(got, "\"token\":\"FAKE-TOKEN-0000-1111-2222-333344445555\""), true)
    assert_eq(strings.has(got, "合成夹具"), true)

    print("test_trae_decrypt_fixture passed")
}
