    cAcc.add(SDL3.createButton({x:0, y:0, w:88.0, h:32.0, text:"＋ 添加", font_size:12, radius:6,
                                bg_color:C_BLUE, text_color:#FFFFFFFF, border_color:C_BLUE_BR, shadow:false}),
             {right:18.0, top:16.0})

    // ---- 关于 ----
    var about = SDL3.createAnchorBox({})
    box.add(about, {basis:36.0, align:3})
    about.add(SDL3.createLabel({x:0, y:0, text:"关于 TraeTools", font_size:18, font_style:1, text_color:C_TXT}),
              {left:2.0, top:6.0})
    var cAbout = mk_card(box, 92.0, "", "")
    cAbout.add(SDL3.createPanel({clip:false, x:0, y:0, w:44.0, h:44.0, bg_color:C_BLUE, radius:10.0, border:false}), {left:18.0, top:24.0})
    cAbout.add(SDL3.createLabel({x:0, y:0, text:"TraeTools", font_size:16, font_style:1, text_color:C_TXT}), {left:78.0, top:36.0})
    cAbout.add(SDL3.createButton({x:0, y:0, w:88.0, h:34.0, text:"检查更新", font_size:12, radius:6,
                                  bg_color:C_CARD, text_color:C_BTN_T, border_color:C_BTN_BR, shadow:false}),
               {right:18.0, top:29.0})
    cAbout.add(SDL3.createButton({x:0, y:0, w:88.0, h:34.0, text:"重置软件", font_size:12, radius:6,
                                  bg_color:C_CARD, text_color:C_DANGER, border_color:C_BTN_BR, shadow:false}),
               {right:114.0, top:29.0})
    cAbout.add(SDL3.createButton({x:0, y:0, w:88.0, h:34.0, text:"重置协议", font_size:12, radius:6,
                                  bg_color:C_CARD, text_color:C_BTN_T, border_color:C_BTN_BR, shadow:false}),
               {right:210.0, top:29.0})
}

// ==================== 自适应版布局助手 ====================
// 与上面的绝对坐标助手**并存**：那些是"老页面"（页 1..5，尚未改造）用的 ✓；下面这几个是给布局容器用的 ✓
// 共同点：**卡片自身的子控件仍用绝对坐标** —— 卡片的左上角在缩放时并不移动 ✓
//   ⇒ 只有"需要拉伸"的东西（卡片本身、图表、右上按钮）才交给布局/锚点 ✓

// 统计卡（布局版）：作为 HBox 的子项，宽度由 `{grow:1}` 分配 ✓
// 内部几何与绝对版 `stat_card` **完全一致**（label +12 / 数字 +38 / 单位 +53 ✓）⇒ 1080 下逐像素相同 ✓
func stat_card_l(HBox row, string label, string num, string unit, Color numColor, float num_size) {
    // ★ 卡片内必须挂一个**内 AnchorBox**：模块里子控件用的是「窗口绝对坐标」✗，
    //   直接把 label 放在 (16,12) 会画到窗口左上角 ✗（实测踩到 ✓）。
    //   内 AnchorBox 的子项才是**相对卡片**的 left/top ⇒ 卡片被布局挪到哪，文字跟到哪 ✓
    var ca = SDL3.createAnchorBox({})
    var p = SDL3.createPanel({clip:false, x:0, y:0, w:263.0, h:90.0, bg_color:C_CARD, radius:10, border_color:C_LINE})
    p.setLayout(ca)
    row.add(p, {grow:1, shrink:0, align:3})
    ca.add(SDL3.createLabel({x:0, y:0, text:label, font_size:13, text_color:C_TXT3}), {left:16.0, top:12.0})
    float ny = 38.0 + (28.0 - num_size) / 2.0
    ca.add(SDL3.createLabel({x:0, y:0, text:num, font_size:num_size, text_color:numColor}), {left:16.0, top:ny})
    if unit != "" {
        var nf = SDL3.createFontAuto(num_size)
        var[float, float](nw, nh) = nf.measureString(num)
        ca.add(SDL3.createLabel({x:0, y:0, text:unit, font_size:13, text_color:C_TXT3}), {left:20.0 + nw, top:53.0})
    }
}

// 卡片（布局版）：圆角白底 + 左上角标题；`opts` 直接透传给布局的 add
//   （如 `{grow:1, shrink:1, align:3}` = 吃满 ✓ / `{basis:314.0, shrink:0, align:3}` = 固定宽 ✓）
//   ⚠ 形参必须是**具体容器类型**（HBox/VBox…）✗ 不能写 `Widget` —— `Widget` 是 face，
//     只有 face 里那几个方法（get_w/render/…），**没有 `add`** ✓（编译报"不能在 any 上调用 add"✗）
func card_l(HBox parent, Dict opts, string title): Panel {
    var ca = SDL3.createAnchorBox({})       // 内布局（相对锚点 ✓，理由同 stat_card_l ✓）
    var p = SDL3.createPanel({clip:false, x:0, y:0, w:200.0, h:200.0, bg_color:C_CARD, radius:10, border_color:C_LINE})
    p.setLayout(ca)
    parent.add(p, opts)
    if title != "" {
        ca.add(SDL3.createLabel({x:0, y:0, text:title, font_size:14, text_color:C_TXT2}), {left:16.0, top:14.0})
    }
    return p
}

// ==================== 页面 ====================

// 页 0：仪表盘（对着截图做的那页）
// ★ 自适应版：整页交给一个 VBox（`setPageLayout(0, box)` ⇒ 模块**每帧**把它同步成内容区尺寸 ✓）
//   · 页头 135 + 统计行 90 固定高（与原版同位置 ✓）；末行 `grow:1` ⇒ **窗口变高时卡片跟着长** ✓
//   · 左右内边距 24/21：原版页面就是"左 24、右到 1059（卡片右缘）"⇒ 1080 宽下逐像素还原 ✓
func page_dashboard() {
    var box = SDL3.createVBox({padLeft:24.0, padRight:21.0, padTop:0.0, padBottom:24.0, spacing:0.0})
    TAB.setPageLayout(0, box)

    // ---- 页头：标题 + 日期 + 右上两个按钮（按钮锚右 ⇒ 跟着右边缘走 ✓）----
    var head = SDL3.createAnchorBox({})
    box.add(head, {basis:135.0, shrink:0, align:3})
    head.add(SDL3.createLabel({x:0, y:0, text:"仪表盘", font_size:26, text_color:C_TXT}), {left:0.0, top:50.0})
    head.add(SDL3.createLabel({x:0, y:0, text:"2026-09-25 周五", font_size:13, text_color:C_TXT3}), {left:0.0, top:90.0})
    // ⚠ 这两个按钮**必须同高、同一 top**（原先 34/68 与 36/66 ✗ ⇒ 蓝色那颗高 2px 且偏高 2px ⇒
    //   看起来"外观不一致" ✗）。宽度仍按原版 86/96（主按钮略宽是设计 ✓），统一 h=36、top=66 ⇒ 中心线对齐 ✓
    head.add(SDL3.createButton({x:0, y:0, w:86.0, h:36.0, text:"刷新状态", font_size:13, radius:8,
                                bg_color:C_CARD, text_color:C_BTN_T, border_color:C_BTN_BR, shadow:false}),
             {right:111.0, top:66.0})      // 1080 下 = 原版 x=862 ✓（右边距 111 = 1059-948）
    head.add(SDL3.createButton({x:0, y:0, w:86.0, h:36.0, text:"立即签到", font_size:13, radius:8,
                                bg_color:C_BLUE, text_color:#FFFFFFFF, border_color:C_BLUE_BR, shadow:false}),
             {right:15.0, top:66.0})       // 宽与「刷新状态」一致（86 ✓）；right:15 ⇒ 左边仍是 958 ✓

    // ---- 三张统计卡（HBox + grow 平分 ✓；间距 28 = 原版 ✓）----
    var row = SDL3.createHBox({padX:0.0, padY:0.0, spacing:28.0})
    box.add(row, {basis:90.0, shrink:0, align:3})
    stat_card_l(row, "剩余积分", "0", "分", C_TXT, 28.0)
    stat_card_l(row, "今日签到", "未登录", "", C_GREEN, 18.0)
    stat_card_l(row, "连续签到", "0", "天", C_ORANGE, 28.0)

    // ---- 原版这里是 33px 行距（VBox 只有一个 spacing ⇒ 用空 AnchorBox 当间隔 ✓）----
    box.add(SDL3.createAnchorBox({}), {basis:33.0, shrink:0, align:3})

    // ---- 第二行：折线图卡（吃满）+ 账号概览卡（固定 314 ✓）
    //   整行 `grow:1` ⇒ 窗口变高时卡片一起变高 ✓（原版写死 277 ✗ —— 这就是"不变高"的原因 ✓）
    var row2 = SDL3.createHBox({padX:0.0, padY:0.0, spacing:25.0})
    box.add(row2, {grow:1, shrink:1, align:3})

    //   ⚠ 卡片的内布局只能有一个（`setLayout` 是**替换** ✗）⇒ 标题也一并放进 `ta` ✓
    var trend = card_l(row2, {grow:1, shrink:1, align:3}, "")
    var tTitle = SDL3.createLabel({x:0, y:0, text:"近 14 天积分趋势", font_size:14, text_color:C_TXT2})
    // 卡片内用 **AnchorBox** 作内布局 ✓ —— 它支持 `left/right/top/bottom` ⇒ 折线图**四边拉伸** ✓
    //   原版坐标（相对卡片）精确换算：标题 (16,14)（由 card_l 画 ✓）；
    //   「…」按钮：右边距 14 / 上 12；图表：(16,44) 尺寸 471x213（卡片 503x277）⇒ 右 16 / 下 20 ✓
    //   ⚠ `Panel.add` 只收 1 个参数 ✗（带布局 opts 的是 AnchorBox/HBox/VBox ✓）—— 栽过一次 ✓
    var ta = SDL3.createAnchorBox({})
    trend.setLayout(ta)
    ta.add(tTitle, {left:16.0, top:14.0})
    ta.add(SDL3.createButton({x:0, y:0, w:26.0, h:26.0, text:"…", font_size:13, radius:13,
                              bg_color:C_CARD, text_color:C_BLUE, border_color:C_BLUE_L, shadow:false}),
           {right:14.0, top:12.0})
    var lc = SDL3.createLineChart({title:"", font_size:11, show_grid:true, show_points:true})
    ta.add(lc, {left:16.0, right:16.0, top:44.0, bottom:20.0})
    lc.set_data(XS, [YS], [""])

    card_l(row2, {basis:314.0, shrink:0, align:3}, "账号概览")   // 截图里这里是空的 ⇒ 保持空 ✓
}

// ==================== 页 2 的两个小助手 ====================

// 在「距右边缘 centerRight」处**居中**放一个标签
//   Label 的 x 是左边缘锚点 ⇒ 量出文字宽反推（与 label_right 同一套路 ✓）
func label_center(AnchorBox ca, float centerRight, float top, string text, float size, Color col) {
    var f = SDL3.createFontAuto(size)
    var[float, float](tw, th) = f.measureString(text)
    ca.add(SDL3.createLabel({x:0, y:0, text:text, font_size:size, text_color:col}),
           {right:centerRight - tw * 0.5, top:top})
}

// 连续天数圆环（Canvas 自绘 ✓）
//   为什么不用现成控件：模块没有环形图 ✗，PieChart 也不支持挖空 ✓
//   怎么画：轨道用 3 圈同心圆叠出约 3px 的带（渲染器**没有线宽参数** ✓）；
//          进度 arc 用 180 条**沿半径方向的短线**填满环带 —— 数量够多 ⇒ 视觉连续 ✓，
//          且线段走抗锯齿路径 ⇒ 边缘平滑 ✓（与斜线 AA 是同一套 ✓）
//   progress = 0 时仍给一小段"起点帽"，否则空环看着像坏了 ✗
func draw_streak_ring(Renderer r, float ox, float oy, float cw, float ch, float progress) {
    float cx = ox + cw * 0.5
    float cy = oy + ch * 0.5
    float rad = cw * 0.5 - 4.0
    // 轨道（浅灰）
    r.setColor(#CBD5E1FF)
    r.drawCircle(cx, cy, rad - 1.1)
    r.drawCircle(cx, cy, rad)
    r.drawCircle(cx, cy, rad + 1.1)
    // 进度弧（白）
    float p = progress
    if p < 0.06 { p = 0.06 }
    if p > 1.0 { p = 1.0 }
    r.setColor(#FFFFFFFF)
    float twoPi = maths.pi() * 2.0
    float start = -1.5707963            // -90° ⇒ 从 12 点开始、顺时针 ✓
    int segs = 180
    for 0 : segs to i {
        float t = _float(i) / _float(segs)
        if t > p { break }
        float a = start + twoPi * t
        float ca2 = maths.cos(a)
        float sa2 = maths.sin(a)
        r.drawLine(cx + (rad - 1.1) * ca2, cy + (rad - 1.1) * sa2,
                   cx + (rad + 1.1) * ca2, cy + (rad + 1.1) * sa2)
    }
}

// 页 2：每日签到（照 TraeTools 截图做的 ✓第 6 页）
// ★ 日期取**系统当天**，不再写死：截图那天正好是 2026-09-26、星期六 ✓；
//   写死的话明天这一页就过期了 ✗（页 0 的 "2026-09-25 周五" 就是这个问题 ✓）
// ★ 日历本体是模块控件 `SDL3.createCalendar` ✓ —— 原先这一页是"没拿到截图 ⇒ 留空"的占位页 ✓；
//   现在做成控件而不是写在本文件里：Trae 应用里也手写过一份简化版 ⇒ 两处必然漂移 ✗
func page_checkin() {
    var box = scroll_page(2)

    var dt = times.datetime()               // [年, 月, 日, 时, 分, 秒] ✓
    int ty = dt[0] as int
    int tm = dt[1] as int
    int td = dt[2] as int
    // ⚠ 星期不要用 `times.format(now, "%w")`：实测它返回字面量 "%w" ⇒ `as int` 会**静默变 0** ✗
    //   （页头因此把"星期六"显示成"星期日" ✗）⇒ 改用模块控件的蔡勒公式 ✓
    //   名字表由页面给（通用控件不预设语言 ✓）
    Array[string] WK_FULL = ["星期日", "星期一", "星期二", "星期三", "星期四", "星期五", "星期六"]
    var head = page_head(box, "每日签到",
                         times.format(times.now(), "%Y-%m-%d") + " · " + SDL3.weekdayName(ty, tm, td, WK_FULL))
    head_button(head, 0.0, 88.0, "一键签到", true)

    // ---- 账号选择条：整行浅底 + 描边（纯界面 ⇒ Panel + Label 复刻外观 ✓）----
    var sa = SDL3.createAnchorBox({})
    var sp = SDL3.createPanel({clip:false, x:0, y:0, w:200.0, h:44.0, bg_color:C_CARD, radius:8, border_color:C_LINE})
    sp.setLayout(sa)
    box.add(sp, {basis:44.0, shrink:0, align:3})
    sa.add(SDL3.createLabel({x:0, y:0, text:"选择签到账号（自动签到与此一致）", font_size:13, text_color:C_TXT2}),
           {left:16.0, top:14.0})

    // ---- 今日奖励卡：深底 + 右侧连续天数圆环 ----
    var ra = SDL3.createAnchorBox({})
    var rp = SDL3.createPanel({clip:false, x:0, y:0, w:200.0, h:132.0, bg_color:C_LOGBG, radius:12, border:false})
    rp.setLayout(ra)
    box.add(rp, {basis:132.0, shrink:0, align:3})
    ra.add(SDL3.createLabel({x:0, y:0, text:"今日奖励", font_size:13, text_color:#9AA6B8FF}), {left:24.0, top:34.0})
    ra.add(SDL3.createLabel({x:0, y:0, text:"-- 积分", font_size:22, text_color:#E8EDF5FF}), {left:24.0, top:62.0})
    // 圆环：Canvas 的绘制原点是**内容区**（窗口绝对坐标 ✓）⇒ 回调里用 ox/oy 当圆心基准 ✓
    var ring = SDL3.createCanvas({x:0, y:0, w:88.0, h:88.0, bg_color:#00000000, border:false})
    ra.add(ring, {right:20.0, top:22.0, w:88.0, h:88.0})
    ring.on_draw(func(Renderer rr, float ox, float oy, float rw, float rh) {
        draw_streak_ring(rr, ox, oy, rw, rh, 0.0)
    })
    // 环内文字：圆环中心距卡片右边缘 = 20 + 88/2 = 64 ✓ ⇒ 按此居中 ✓
    label_center(ra, 64.0, 40.0, "0", 24.0, #FFFFFFFF)
    label_center(ra, 64.0, 70.0, "连续天数", 10.0, #9AA6B8FF)

    // ---- 底部一行：日历卡（吃满剩余宽 + 吸收多余高）+ 签到记录卡（固定 306 ✓）----
    var row = SDL3.createHBox({padX:0.0, padY:0.0, spacing:16.0})
    box.add(row, {grow:1.0, shrink:1.0, align:3})
    var calCard = mk_card_h(row, 520.0, 452.0, "本月签到日历", "")
    // 通用控件不认识"签到"✗ ⇒ 文案、状态色、图例全部由这里传进去 ✓
    // （不传就是中性外观：无图例、未标记的日子没有底色 ✓）
    var cal = SDL3.createCalendar({year:ty, month:tm, today:td, pad:16.0, rows:6,
                                   month_fmt:"%d 年 %d 月", arrow_left:"←", arrow_right:"→",
                                   plain_bg:#F1F5F9FF, plain_fg:#6B7280FF,
                                   filled_bg:#2B6BE4FF, filled_fg:#FFFFFFFF,
                                   alert_bg:#FEE4E2FF, alert_fg:#D92D20FF,
                                   today_bg:#FFFFFFFF, today_fg:#2B6BE4FF, today_border:#2B6BE4FF})
    cal.set_legend([1, SDL3.Calendar.LEG_TODAY, 2, 0], ["已签", "今日", "漏签", "未签"])
    calCard.add(cal, {left:16.0, right:16.0, top:8.0, bottom:14.0})
    mk_card_h(row, 306.0, 452.0, "签到记录", "")
}

// ==================== 界面 ====================
func build_ui(Window wt) {
    // ---- ★ 根布局：侧栏（固定 190） + 内容区（吃满剩余）----
    //   `wt.setRoot(root)` 之后：窗口被拖动缩放时，模块把根控件同步成新尺寸并**驱动内部重排** ✓
    //   ⚠ 两个子控件**不能再** `wt.add(...)`：进了 root 就由布局渲染，重复挂载会画两遍 ✗
    var root = SDL3.createHBox({padX:0.0, padY:0.0, spacing:0.0})

    // ---- 左侧深色导航栏（它是普通 Panel，与内容区 Tab 无关 ✓）----
    var side = SDL3.createPanel({clip:false, x:0, y:0, w:SIDE_W, h:WIN_H, bg_color:C_SIDE, radius:0, border:false})
    root.add(side, {basis:SIDE_W, align:3})      // 固定宽 190 + 交叉轴拉伸 ⇒ 高度随窗口 ✓

    side.add(SDL3.createPanel({clip:false, x:16, y:66, w:14, h:14, bg_color:C_BLUE, radius:3, border:false}))
    side.add(SDL3.createLabel({x:36, y:60, text:"TraeTools", font_size:19, text_color:#FFFFFFFF}))
    side.add(SDL3.createLabel({x:16, y:89, text:"签到 · 账号切换 · 用量统计", font_size:11, text_color:C_SIDE_D}))
    side.add(SDL3.createPanel({clip:false, x:0, y:112, w:SIDE_W, h:1, bg_color:C_DIV, radius:0, border:false}))

    // 图标用**实测能渲染**的符号（探针逐个验过 ✓）：
    //   ■ ● ◆ ▲ ○ ◎ ※ √ × ∑ ☆ ★ → ← § 可用 ✓；▦ ✓ ⇄ ☁ ⚙ 等扩展区符号全是豆腐块 □ ✗
    // 想要真图标：用 examples/UI组件/按钮/gen_icons.leno 生成 PNG + 按钮的 image_path ✓
    nav_item(side, 128, "■  仪表盘", 0)
    nav_item(side, 170, "∑  用量统计", 1)
    nav_item(side, 212, "√  每日签到", 2)
    nav_item(side, 254, "→  账号切换", 3)
    nav_item(side, 296, "◎  云端签到", 4)
    nav_item(side, 338, "◆  设置", 5)

    // 提示放在**侧栏空白区**（原先挂在窗口层 y=656，会压住卡片 ✗）。
    // ★ 自适应版改成**锚底**：原来写死 y=606/622/636/710 ✗ —— 窗口一变高就飘在半空 ✗
    //   手法与卡片内部一致：Panel.setLayout(AnchorBox) + 子项用 left/bottom ✓
    var sfa = SDL3.createAnchorBox({})
    side.setLayout(sfa)
    // ⚠ bottom 值是**按原坐标反推 + 逐像素 diff 校正**的（不是拍脑袋 ✗）：
    //   原 y = 606/622/636/710，735 高的窗口 ⇒ bottom = 115/99/85/10 时与旧版**逐像素一致** ✓
    sfa.add(SDL3.createLabel({x:0, y:0, text:"左键点导航切页 · Esc 退出", font_size:10, text_color:C_SIDE_D}), {left:16.0, bottom:115.0})
    sfa.add(SDL3.createLabel({x:0, y:0, text:"数据目录", font_size:10, text_color:C_SIDE_V}), {left:16.0, bottom:99.0})
    sfa.add(SDL3.createLabel({x:0, y:0, text:"%APPDATA%\\TraeSignLeno\\", font_size:10, text_color:C_SIDE_V}), {left:16.0, bottom:85.0})
    sfa.add(SDL3.createLabel({x:0, y:0, text:"v1.3.3", font_size:11, text_color:C_SIDE_V}), {left:16.0, bottom:10.0})

    // ---- 内容区：TabControl 当页面容器，**标签栏隐藏** ⇒ 界面上只看得到当前页 ✓ ----
    // `clip:false`：页面内容自己就有裁剪（滚动页是整页 ScrollView ✓），Tab 这层是**冗余**的 ⇒
    // 少一层裁剪 = 少一次 flush/malloc（"过多裁剪会闪烁" ✗）⇒ 每个页面最多只剩 1 层裁剪 ✓
    TAB = SDL3.createTabControl({x:0, y:0, w:TAB_W, h:TAB_H,
                                 tabs:["仪表盘", "用量统计", "每日签到", "账号切换", "云端签到", "设置"],
                                 active:0, show_header:false, border:false, clip:false, bg_color:C_BG})
    root.add(TAB, {grow:1.0, align:3})           // 吃满剩余宽 + 交叉轴拉伸 ⇒ 高度随窗口 ✓

    // ★ 交给模块托管：窗口缩放 ⇒ 自动同步根控件尺寸并驱动内部重排 ✓
    wt.setRoot(root)
    // ⚠ `tabs` 仍要照常传：`set_active` 按下标校验（`idx < _tabs.len()`）✓；标题本身不显示 ✓
    // ⚠ `bg_color` 要显式给内容区底色：Tab 的内容区会用自己的 `_bgColor` 打底（默认取主题色，
    //   这里比 C_BG 更白 ✗ —— 漏了它内容区就不是截图那种浅灰了 ✓）
    TAB.on_change(func(int idx) {
        CUR_PAGE = idx
        sync_nav()
    })

    page_dashboard()
    page_usage()                       // 页 1：用量统计
    page_checkin()                      // 页 2：每日签到（照截图实现 ✓ 日历用模块控件 Calendar ✓）
    page_accounts()                    // 页 3：账号切换
    page_cloud()                       // 页 4：云端签到
    page_settings()                    // 页 5：设置


}

main() {
    var sh = _env("DSHOT")
    if sh != null { SHOT = _str(sh) }
    var au = _env("DAUTO")
    if au != null { AUTO = _int(_str(au)) }
    var sa = _env("DSHOT_AT")
    if sa != null { SHOT_AT = _int(_str(sa)) }
    var sn = _env("DSHOT_N")
    if sn != null { SHOT_N = _int(_str(sn)) }
    var cy = _env("DCYCLE")
    if cy != null { CYCLE = _int(_str(cy)) }
    // 自检：DWIN=宽x高 ⇒ `build_ui` 之后把窗口改到该尺寸（验证"缩放 ⇒ 自动重排"整条链 ✓）
    // ⚠ 解析必须在这里（建窗之前 ✓）—— 放到后面 `DESK_W` 就还是 0，apply 等于空跑 ✗（踩过 ✓）
    var dw = _env("DWIN")
    if dw != null {
        var sp = _str(dw).split("x")
        if sp.len() >= 2 {
            DESK_W = _int(_str(sp[0]))
            DESK_H = _int(_str(sp[1]))
        }
    }

    var wt = SDL3.createWindow({title:"TraeTools —— LenoSDL3 复刻（自适应布局：窗口可缩放 ✓）",
                                w:WIN_W, h:WIN_H, resizable:true})   // ★ 可拖拽 ⇒ 布局自动重排 ✓
    if not wt.ok {
        print("创建窗口失败: " + SDL3.getError() + "\n")
        return
    }
    build_ui(wt)

    // 自检：改窗口尺寸（此时根布局已由 setRoot 挂好 ⇒ 模块会自动同步根尺寸并驱动重排 ✓）
    if DESK_W > 0 and DESK_H > 0 {
        wt.setSize(DESK_W, DESK_H)
        print("[dash] 自检 DWIN=" + _str(DESK_W) + "x" + _str(DESK_H) + " ⇒ setSize 完成 ✓\n")
    }

    // 启动页（自检用）：`set_active` 会回调 on_change ⇒ 导航选中态一起同步 ✓
    var dp = _env("DPAGE")
    if dp != null {
        int dpi = _int(_str(dp))
        if dpi > 0 { set_page(dpi) }
    }
    // 自检：DSCROLL=n ⇒ **第 2 帧**再把当前页滚到 y=n（验证滚动 + 卡片内 AnchorBox 跟随 ✓）
    // ⚠ 不能在 build 之后立刻滚：那一刻内容尺寸还没测量（`_contentH = -1`），
    //   `get_max_scroll_y()` 是 0 ⇒ 会被当成"没有可滚空间"钳成 0 ✗（这条踩过，见 README ✓）
    var dsc = _env("DSCROLL")
    if dsc != null {
        PENDING_SCROLL = _float(_str(dsc))
        if SHOT_AT < 4 { SHOT_AT = 4 }      // 截图要晚于"滚动生效的那一帧" ✓
    }
    // 自检：DSCROLL_SMOOTH=n ⇒ 用"滚轮语义"朝目标滚 n 像素（平滑动画；配 DSCROLL_TRACE=1 看缓动曲线 ✓）
    var dss = _env("DSCROLL_SMOOTH")
    if dss != null {
        PENDING_SMOOTH = _float(_str(dss))
        if SHOT_AT < 4 { SHOT_AT = 4 }
    }
    var dst = _env("DSCROLL_TRACE")
    if dst != null { if _int(_str(dst)) != 0 { SMOOTH_TRACE = true } }
    var dfl = _env("DSCROLL_FLIP")
    if dfl != null { FLIP = _float(_str(dfl)) }
    // 自检：DFPS=0 ⇒ 关掉窗口内 FPS HUD（**逐像素截图比对时必须关** ✓ —— HUD 会进画面 ✓）
    var dfp = _env("DFPS")
    if dfp != null { if _int(_str(dfp)) == 0 { FPS_ON = false } }
    // 自检：DWIN=宽x高 ⇒ build_ui 之后把窗口改成该尺寸（验证"缩放 ⇒ 自动重排"整条链 ✓）
    // ⚠ 解析必须放在**建窗/apply 之前**（这里已经晚了 ✗ —— 搬到了上面 DCYCLE 旁边 ✓）

    // 定时器**只在自检模式下**挂：`win.run` 是事件驱动重绘，无头（dummy）下没有事件就永不重绘 ✗
    // 但交互运行时它没用了 —— 加了等于每秒 20 次**无谓的全量重绘**（每次带一批 flush ✗，
    // 是"闪烁感/卡顿感"的常见来源）⇒ 只有开了自检开关才加 ✓
    if SHOT != "" or AUTO > 0 or CYCLE > 0 {
        wt.addTimer(50, func():void { })
    }

    // 自检：DRESIZE=帧号 ⇒ 在该帧**程序化改窗口尺寸**（等价于 OS 最大化/还原时连发的
    //   RESIZED 事件 ✓，而且**全程没有任何鼠标输入** ✗✓）⇒ 验证"布局自己跟上、不用动鼠标" ✓
    //   打印对比：帧号 / 真实窗口宽 / TabControl 宽 / 页 1 滚动视图宽 ⇒ 看它几帧内跟上 ✓
    int RESIZE_AT = 0
    var drs = _env("DRESIZE")
    if drs != null { RESIZE_AT = _int(_str(drs)) }
    // 自检：DMAX=1 ⇒ 第 20 帧**最大化**、第 40 帧**还原**（真实窗口 ✓，就是用户的操作 ✓）
    //   并在还原前后逐帧打印"真实窗口尺寸 / 框架宽 / 内容宽" ⇒ 分清是"尺寸没同步"还是
    //   "同步了但画面没重画" ✓
    int MAXIMIZE_TEST = 0
    var dmx = _env("DMAX")
    if dmx != null { MAXIMIZE_TEST = _int(_str(dmx)) }

    // ★ 截图 / 自动退出必须放在**叠加层**（setOverlay）：
    //   它在所有控件/弹层/Tooltip **之后**、present 之前调用 ⇒ 此刻帧才是完整的 ✓
    //   ⚠ 放在 onRender 回调里读会得到「只有底色」的空白图 ✗（控件在回调**之后**才绘制）
    wt.setOverlay(func(Renderer r) {
        FRAMES = FRAMES + 1
        // 自检：改窗口尺寸 + 随后几帧打印"真实窗口宽 / 框架宽 / 内容宽" ⇒ 几帧内跟上 ✓
        if RESIZE_AT > 0 and FRAMES == RESIZE_AT {
            wt.setSize(1400, 900)
            print("[dash] 自检 DRESIZE：已请求窗口 1400x900 ✓\n")
        }
        if RESIZE_AT > 0 and FRAMES >= RESIZE_AT and FRAMES <= RESIZE_AT + 5 {
            print("[dash]   帧 " + _str(FRAMES) + "：win=" + _str(wt.getSize().w) + "x" + _str(wt.getSize().h)
                  + "  TAB.w=" + _str(TAB.get_w()) + "  SV(页1).w=" + _str(SV_LIST[0].get_w()) + "\n")
        }
        // 自检：真实窗口的"最大化 → 还原"（等价于用户点右上角 ✓），还原前后逐帧打点 ✓
        if MAXIMIZE_TEST > 0 {
            if FRAMES == 20 { wt.maximize(); print("[dash] DMAX：第 20 帧已请求**最大化** ✓\n") }
            if FRAMES == 40 { wt.restore();  print("[dash] DMAX：第 40 帧已请求**还原** ✓（之后每帧打点）\n") }
            if FRAMES == 38 or FRAMES == 39 or FRAMES == 40 or FRAMES == 41 or FRAMES == 42 or FRAMES == 43 {
                string svs0 = ""
                int k0 = 0
                for SV_LIST to s { svs0 = svs0 + "  SV" + _str(SV_PAGES[k0]) + "=" + _str(s.get_w()); k0 = k0 + 1 }
                print("[dash]   帧 " + _str(FRAMES) + " t=" + _str(SDL3.getTicks())
                      + "：win=" + _str(wt.getSize().w) + "x" + _str(wt.getSize().h)
                      + "  TAB.w=" + _str(TAB.get_w()) + svs0 + "  页=" + _str(CUR_PAGE) + "\n")
            }
        }
        if FRAMES == 1 {
            print("[dash] 首帧完成（控件已绘制）" + (WIN_W as string) + "x" + (WIN_H as string) + "  当前页=" + _str(CUR_PAGE) + "\n")
            int k = 0
            for SV_LIST to s {
                print("[dash]   滚动页 " + _str(SV_PAGES[k]) + "：maxScrollY=" + _str(s.get_max_scroll_y()) + "\n")
                k = k + 1
            }
        }
        // 自检：内容尺寸已量完（第 2 帧）⇒ 这时滚动才作数 ✓
        if FRAMES == 2 and PENDING_SCROLL >= 0.0 {
            apply_scroll(CUR_PAGE, PENDING_SCROLL)
            PENDING_SCROLL = -1.0
            SDL3.markFrameRedraw()
        }
        // 自检：平滑滚动（走滚轮同一条路径）⇒ 之后逐帧逼近，可打印缓动曲线 ✓
        if FRAMES == 2 and PENDING_SMOOTH != 0.0 {
            apply_scroll_by(CUR_PAGE, PENDING_SMOOTH)
            PENDING_SMOOTH = 0.0
        }
        // 自检：快速来回滚（每 2 帧反向）—— 模拟"快速上下滚动滑轮" ✓
        if FLIP > 0.0 {
            FLIP_TICK = FLIP_TICK + 1
            if FLIP_TICK >= 2 {
                FLIP_TICK = 0
                if FLIP_POS { apply_scroll_by(CUR_PAGE, FLIP) } else { apply_scroll_by(CUR_PAGE, 0.0 - FLIP) }
                FLIP_POS = not FLIP_POS
            }
        }
        if SMOOTH_TRACE { trace_scroll(CUR_PAGE) }
        // 自检：每 CYCLE 帧自动切下一页（走的是导航按钮的**同一个** set_page ✓）
        //   打印出来的 `当前页` 是从 `on_change` 回填的 ⇒ 顺带验证了"切页 → 导航同步"整条链 ✓
        if CYCLE > 0 {
            CYCLE_TICK = CYCLE_TICK + 1
            if CYCLE_TICK >= CYCLE {
                CYCLE_TICK = 0
                int nx = CUR_PAGE + 1
                if nx >= NAVS.len() { nx = 0 }
                set_page(nx)
                print("[dash] 自动切页 → 请求 " + _str(nx) + " / 当前页 " + _str(CUR_PAGE) + "\n")
            }
        }
        // 窗口内 FPS HUD：每帧更新 + 画在最上层（叠加层在控件之后 ✓）
        // ⚠ 它会被截进 PNG（因为截图读的是整窗像素 ✓）⇒ 做逐像素比对时请带 `DFPS=0` ✓
        var wsz = wt.getSize()        // 窗口可能刚被缩放 ⇒ 每帧刷新，HUD 才会跟着走 ✓
        CUR_W = _float(wsz.w)
        CUR_H = _float(wsz.h)
        fps_tick()
        fps_draw(r)

        if SHOT != "" and SHOT_N > 0 and FRAMES >= SHOT_AT {
            // 连拍：`DSHOT_N` 张连续帧（第 0 张 = 原 `DSHOT` 名字，其余加 `_1`、`_2`…）
            // 用途：逐像素比对连续帧 ⇒ 把"闪烁"变成可复现的数字 ✓
            var idx = FRAMES - SHOT_AT
            var path = SHOT
            if idx > 0 { path = SHOT.byte_slice(0, SHOT.len() - 4) + "_" + _str(idx) + ".png" }
            var s = r.readPixelsAt(0, 0, _int(CUR_W), _int(CUR_H))   // 用**动态**尺寸：窗口缩放后截图才跟得上 ✓
            if s == null {
                print("[dash] 读像素失败: " + SDL3.getError() + "\n")
            } else {
                bool ok = SDL3.saveImagePNG(s, path)
                print("[dash] 截图 " + path + " ok=" + _str(ok) + "  当前页=" + _str(CUR_PAGE) + "\n")
            }
            if idx >= SHOT_N - 1 { _exit(0) }
        }
        if AUTO > 0 and FRAMES >= AUTO {
            print("[dash] frames=" + _str(FRAMES) + "\n")
            _exit(0)
        }
    })

    wt.run(
        func(Event ev): bool {
            if ev.isQuit() or ev.isWindowClose() { return false }
            if ev.isKeyDown() and ev.scancode() == Scancode.ESCAPE { return false }
            return true
        },
        func(Renderer r) {
            r.clearColor(C_BG)               // 内容区浅底（侧栏/卡片各自盖在上面 ✓）
        }
    )
}
