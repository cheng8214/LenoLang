// tools/test_ffapi.leno — 飞飞API「163 解析站」端到端自测（签名 → 搜索 → 解析 → 下载）
//
// 用法：build\leno.exe "leno_gui\应用\Aria\tools\test_ffapi.leno"
//
// 验四件事：① 本地算的签名站方认（不认就是 403）；② 搜索回来的是网易云同款 SongInfo；
//          ③ 能解析出真实音频直链（含音质档）；④ 直链能真的落盘 ✓
import "../lib/ffapi_core.leno" as ff
import "web_net" as net

func head(string s, int n): string {
    if s.len() <= n { return s }
    return s.slice(0, n - 1)
}

main() {
    print("=== ⓪ 签名自检（不联网）")
    string ts = ff.stamp()
    print("    timestamp=" + ts + "   长度=" + _str(ts.len()) + "（必须是 10）")
    print("    signature=" + ff.signature(ts))

    var c = ff.newClient()

    print("=== ① 搜索：周杰伦")
    var list = ff.search(c, "周杰伦", 3)
    print("    命中 " + _str(list.len()) + " 首")
    for list to s {
        print("    " + s.display() + "  id=" + s.id + "  fee=" + _str(s.fee))
    }
    if list.len() == 0 {
        print("    搜索为空 —— 签名不被认 / 站方改版，后面的没法测")
        c.close()
        return
    }

    print("=== ② 解析直链（standard → exhigh → lossless 逐档试）")
    var p = ff.music_best(c, list[0].id, [])
    if not p.valid() {
        print("    没解析出直链")
    } else {
        print("    name=" + p.name + "  artist=" + p.artist + "  album=" + p.album)
        print("    level=" + p.level + "  size=" + p.size)
        print("    url=" + head(p.url, 96))
        print("    lyric=" + _str(p.lyric.len()) + " 字节  tlyric=" + _str(p.tlyric.len()) + " 字节")
    }

    print("=== ②b 各音质档实测（看站方到底给哪档）")
    Array[string] lv = [ff.LEVEL_STANDARD, ff.LEVEL_EXHIGH, ff.LEVEL_LOSSLESS, ff.LEVEL_HIRES, ff.LEVEL_JYMASTER]
    var probe = list[0]
    for list to s { if s.playable() { probe = s; break } }
    for lv to one {
        var q = ff.music(c, probe.id, one)
        if q.valid() {
            string tag = if q.lossless() then "  [真无损]" else "  [有损]"
            print("    " + one + "  ⇒  标签<" + q.level + ">  实际 ." + q.ext() + "  " + q.size + tag)
        } else {
            print("    " + one + "  ⇒  拿不到（无版权/需更高会员）")
        }
    }

    print("=== ③ 下载")
    if p.valid() {
        string tmp = _str(_env("TEMP"))
        if tmp == "" { tmp = "." }
        string f = tmp + "\\ffapi_probe.mp3"
        int n = ff.download_parsed(c, p, f)
        print("    落盘 " + f + "  " + _str(n) + " 字节")
    } else {
        print("    没有直链，跳过")
    }

    print("=== ④ 无损直链可达性（只探 Content-Length，不真下 60MB）")
    var hq = ff.music(c, probe.id, ff.LEVEL_LOSSLESS)
    if hq.valid() {
        int sz = net.remoteSize(hq.url)
        print("    ." + hq.ext() + "  remoteSize=" + _str(sz) + " 字节（≈" + _str(sz / 1048576) + " MB）")
    } else {
        print("    无损拿不到")
    }

    c.close()
    print("=== 完成")
}
