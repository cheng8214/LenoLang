// tools/dl_hq.leno — 搜一首歌、取**最高音质**、下载（验解析站的真实能力上限）
//
// 用法：build\leno.exe "leno_gui\应用\Aria\tools\dl_hq.leno" 青衣
//   参数 1 = 关键词（默认"青衣"）；参数 2 = 输出目录（默认 %TEMP%）
import "../lib/ffapi_core.leno" as ff
import dirs

func trimq(string q): string {
    if q.starts_with("?") { return q.slice(1, q.len() - 1) }
    return q
}

main() {
    var a = _args()
    string kw = "青衣"
    if a.len() > 0 { kw = a[0] }
    string outDir = _str(_env("TEMP"))
    if a.len() > 1 { outDir = a[1] }
    if outDir == "" { outDir = "." }

    var c = ff.newClient()

    print("=== 搜索：" + kw)
    var list = ff.search(c, kw, 5)
    print("    命中 " + _str(list.len()) + " 首")
    for list to s {
        print("    " + s.display() + "  id=" + s.id + "  fee=" + _str(s.fee))
    }
    if list.len() == 0 { c.close(); print("没有结果"); return }

    var song = list[0]
    print("=== 逐档解析（高 → 低）：" + song.name + " / " + song.artist)
    Array[string] order = [ff.LEVEL_SKY, ff.LEVEL_DOLBY, ff.LEVEL_JYMASTER, ff.LEVEL_HIRES,
                           ff.LEVEL_LOSSLESS, ff.LEVEL_JYEFFECT, ff.LEVEL_EXHIGH, ff.LEVEL_STANDARD]
    var best = ff.music(c, song.id, ff.LEVEL_STANDARD)     // 兜底
    bool got = false
    for order to lv {
        var q = ff.music(c, song.id, lv)
        if q.valid() {
            print("    " + lv + "  ⇒  ." + q.ext() + "  " + q.size + "  标签<" + q.level + ">")
            if not got { best = q; got = true }   // 顺序是高→低 ⇒ 第一个能拿到的就是最高档 ✓
        } else {
            print("    " + lv + "  ⇒  拿不到")
        }
    }

    if not best.valid() {
        c.close()
        print("没解析出任何直链")
        return
    }

    bool doDL = false
    if a.len() > 2 and a[2] == "dl" { doDL = true }
    if not doDL {
        print("=== 只解析不下载（要真下就在参数后加 dl）")
        print("    最高可用：" + best.size + "  ." + best.ext() + "  " + best.url.slice(0, 60))
        c.close()
        return
    }

    string f = outDir + "\\" + ff.safe_filename(best.name, best.artist, best.ext())
    print("=== 下载最高可用档：" + best.size + "  ." + best.ext())
    print("    → " + f)
    int n = ff.download_parsed(c, best, f)
    print("=== 完成：" + _str(n) + " 字节（" + _str(n / 1048576) + " MB）")

    c.close()
}
