// tools/test_library.leno — 收藏（library.json）数据层自测
//
// 用法：build\leno.exe "leno_gui\应用\Aria\tools\test_library.leno"
//
// 验三件事（这次"排行榜收藏后「我喜欢」里没有"就是从这儿坏的）：
//   ① 新格式往返：存**整首歌快照** ⇒ 读回来歌名/歌手/音源都在（不再只有 id）
//   ② 老格式兼容：旧 library.json 只有 `likes` 键列表 ⇒ 能读进来并标记 likedLegacy
//   ③ 增删按 like_key 生效（同一首不会被收两次）
import "../lib/library.leno" as lib
import "../lib/store.leno" as store
import "../music_data.leno" as data
import files
import dirs
import jsons
use data.Song

func song(string sid, string t, string a): Song {
    Song s = new Song()
    s.sid = sid
    s.title = t
    s.artist = a
    s.cover = "cover01.png"
    s.dur = "03:20"
    s.ext = "flac"
    s.src = "ff"
    s.sizeBytes = 12345678
    s.sampleRate = 96000
    return s
}

main() {
    string root = dirs.join(_str(_env("TEMP")), "aria_lib_test")
    string f = store.path_of(root)
    if files.exists(f) { files.delete(f) }

    print("=== ① 新格式往返（整首歌快照）")
    Array[Song] liked = []
    liked.add(song("1001", "榜单里的歌", "某歌手"))
    liked.add(song("1002", "另一首", "另一个"))
    lib.save(root, liked, [])
    var ld = lib.load(root)
    print("    liked 条数=" + _str(ld.liked.len()) + "  legacy=" + _str(ld.likedLegacy))
    for ld.liked to s {
        print("    " + s.sid + "  " + s.title + " / " + s.artist +
              "  src=" + s.src + "  ext=" + s.ext +
              "  size=" + _str(s.sizeBytes) + "  sr=" + _str(s.sampleRate))
    }
    bool ok1 = ld.liked.len() == 2 and ld.liked[0].title == "榜单里的歌" and ld.liked[0].src == "ff"

    print("=== ② 老格式兼容（只有 likes 键列表）")
    Dict[string, any] old = {}
    old["version"] = 1
    old["likes"] = ["2001", "file:/tmp/x.mp3"]
    old["recent"] = []
    files.write(f, jsons.encode(old))
    var l2 = lib.load(root)
    print("    legacy=" + _str(l2.likedLegacy) + "  条数=" + _str(l2.liked.len()))
    for l2.liked to s {
        print("    sid=" + s.sid + "  path=" + s.path + "  title=<空, 待回填>")
    }
    bool ok2 = l2.likedLegacy and l2.liked.len() == 2

    print("=== ③ 增删按 like_key（同一首不重复）")
    Array[Song] arr = []
    arr = lib.add_song(arr, song("3001", "重复测试", "A"))
    arr = lib.add_song(arr, song("3001", "重复测试（新封面）", "A"))
    print("    加两次后条数=" + _str(arr.len()) + "  title=" + (if arr.len() > 0 then arr[0].title else "-"))
    bool ok3 = arr.len() == 1 and arr[0].title == "重复测试（新封面）"
    arr = lib.remove_song(arr, "3001")
    bool ok4 = arr.len() == 0

    print("=== 结果")
    print("    ① 快照往返: " + (if ok1 then "PASS" else "FAIL"))
    print("    ② 老格式兼容: " + (if ok2 then "PASS" else "FAIL"))
    print("    ③ 增删去重: " + (if ok3 and ok4 then "PASS" else "FAIL"))
    if files.exists(f) { files.delete(f) }
    print(if ok1 and ok2 and ok3 and ok4 then "全部通过" else "有失败项")
}
