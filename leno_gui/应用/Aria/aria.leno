// aria.leno — Aria（浅粉音乐库：侧栏导航 + 顶部搜索 + 卡片墙 + 底部播放条）
//
// 界面构成（照参考图搭 ✓）：
//   ① 自绘标题栏 TitleBar（浅粉底、去系统边框 ✓）
//   ② 左侧栏 VBox —— 品牌行 / 主导航（首页·我喜欢·最近·本地）/ 创建的歌单 / 底部「更多」
//   ③ 顶栏 HBox —— 前进后退圆钮 + 搜索胶囊
//   ④ 内容 ScrollView —— 页面标题 + 「继续收听」横卡 + 「为你推荐」卡片墙 + 「最近添加」
//   ⑤ 底部播放条 —— 封面 + 歌名/歌手 + 播放控制 + 进度条 + 音量
//
// 运行：build\leno.exe leno_gui\应用\Aria\aria.leno
// 资源：images\coverNN.png（`tools\gen_covers.leno` 程序化生成；换真封面同名覆盖即可 ✓）
//
// 本次为界面补的**库能力**（都在 build/leno_module/LenoSDL3/lib/ 里，通用 ✓）：
//   · sdl_renderer.leno：`fillGradientRect` / `fillGradientRoundedRect`（线性渐变，此前只有三角形渐变）
//
// ★ 2026-10-25 晚：`sdl_icons`（矢量图标）已从公共库删除 —— 图标属应用资产，框架不背。
//   本界面**暂时改用文字占位**（`»`/`«`/`+`/`♥`/「乐」这类），等换成 PNG 或应用自带图标
//   再把这里的 `txt_btn(...)` 换回 `image_path`。
//
// 无头自检（照 影视海报墙 / 文件管理器 的惯例 ✓）：
//   set ARIA_SHOT=%TEMP%\aria.png   # 第 N 步存一张 PNG 后退出（核对界面就靠它 ✓）
//   set ARIA_AT=14                    # 第几步截（一步 = 100ms）
//   set ARIA_SIZE=1000x680            # 指定窗口尺寸（验布局自适应 ✓）
//   set ARIA_NAV=1                    # 启动就切到某个导航页（验"点导航真的换页" ✓）
//   set ARIA_SEARCH=周杰伦            # 启动就搜酷我（联网；封面按拍补，缓存到临时目录 ✓）
import "SDL3" as SDL3
import "./music_data.leno" as data
import "web_net" as net
import "./lib/kuwo_core.leno" as kuwo   // 酷我音乐（搜索/直链；从 D:\CLeno\LenoMusic 取来 ✓）
import "./lib/kuwo_cover.leno" as cover // 酷我封面（详情页 pic120 → 500px 大图，单独模块 ✓）
import "./lib/net_workers.leno" as workers  // 后台线程入口（搜索/首页分区/封面分片）
import "./lib/downloads.leno" as dl         // 下载 + 本地曲库扫描
import "./lib/store.leno" as store          // 本地持久化（喜欢 / 最近播放 → 缓存\library.json）
import "./lib/settings.leno" as cfgset       // 应用设置（线程数 / 缓存目录 / 优先格式）
import "./lib/session.leno" as session       // 会话持久化（播放队列 / 当前曲目 / 进度 ✓）
use session.PlaySession
import "./lib/settings_win.leno" as cfgwin   // 设置对话框（独立窗口）
import "./lib/probes.leno" as probe             // 无头验证用的假数据（假歌词 / 压力歌单）
import "./lib/library.leno" as lib            // 收藏 / 最近播放的持久化（纯数据）
import "./lib/row_view.leno" as rv          // 列表行的长相（封面 + 两行字 + 操作）
import "./lib/cards.leno" as cards          // 卡片尺寸 + 竖版卡片 / 横卡
import files                                 // 本地文件的 .lrc 读取（本地音乐歌词 ✓）
import "./lib/page_widgets.leno" as pw      // 页面级纯函数（格式化 / 榜单配置）—— 拆分第一步 ✓
import "./lib/pages/home.leno" as page_home  // 首页（拆分第二步：页面构建搬到独立模块 ✓）
import "./lib/pages/discover.leno" as page_disc  // 发现页 + 歌单详情（拆分第三步 ✓）
import "./lib/pages/rank.leno" as page_rank      // 排行榜（拆分第四步 ✓）
import "./lib/pages/overlays.leno" as page_ov    // 播放列表浮层 / 音量浮窗的控件（拆分第七步 ✓）
use page_home.HomeCtx
use page_disc.(DiscoverCtx, PlaylistCtx)
use page_rank.RankCtx
import "./lib/lyric_view.leno" as lv
import "./lib/ui_kit.leno" as ui            // 无状态小工具：路径 / 标签 / 时间 / 颜色 / 曲库 key
import "./lib/lyric.leno" as lyr             // 歌词解析 + 逐字定位（**移植自 LenoMusic** ✓）
import strings
import dirs
import times
import files
import threads
import Sys                       // 自检探针用：读本进程内存（ARIA_STRESS ✓）
import "Music" as audio        // miniaudio：真播放（LenoMusic 模块 ✓）
use audio.Sound
use SDL3.(Event, Renderer, Window, TitleBar, Button, Label, Edit, Card, ImageView, Table,
          HBox, VBox, AnchorBox, ScrollView, ProgressBar, Slider, Color, Theme, ComboBox,
          VirtualGrid, Canvas, Font, Widget, TabControl, Panel)
use data.(Song, Shelf, NavItem)
use lyr.Lrc
use lv.LyricView
use cards.(CardSize, CardHooks)
use rv.RowHooks
use lib.LibraryData

// ==================== 尺寸 ====================
const int WIN_W = 1200
const int WIN_H = 800
const int TB_H = 32          // 自绘标题栏
const int SIDE_W = 184       // 侧栏宽
// 发现页「加载更多」最多拉几页（每页 18 张）
//   ★ 已改成虚拟滚动（只保留可见区附近的卡片）⇒ 页数不再受内存限制，
//     给个很大的上值只为防止接口无限返回同内容（真正兜底靠 near_bottom 判空页 ✓）
const int PL_MAX_PAGE = 200

const int TOP_H = 58         // 顶栏
const int BAR_H = 66         // 底部播放条（82 太高，参考图约 60~66）
const int PAD = 24           // 内容区左右内边距
// ⚠ 卡片高度按 Card 的**不变式**算：图片区最终高 = h − needBottom
//   needBottom = 文字块(textH) + 12（不给 content_h 时就这么点）
//   实测 h=262 + content_h:44 时图片只剩 157（206 见方被压扁 ⇒ 一片白）✗
//   现在：h = 220 ⇒ 图片可用 173 ≥ 200×0.85 = 170 ⇒ 不压缩、也不留大空白 ✓
const int CARD_W = 152       // 卡片自然宽（5 张 + 4 个间距 = 824，贴合内容宽 840 ✓）
const int CARD_H = 200       // ⚠ 实测下限：图片要 129（152×0.85），文字块+内边距还要 ~71 ⇒ 196 时图片区被压成 0（整片白块）✗，200 才放得下
const int CARD_GAP = 16
const float CARD_ASPECT = 0.85   // 图片区 高/宽
const int PER_ROW = 5        // 每行卡片数（2026-10-25：4 → 5，图片按曾出现改小 ✓）
// 卡片墙的**基准卡宽**与列间距 —— 列数是**算出来的**，不写死列数：
//   cols = round(可用宽 ÷ (基准宽 + 间距))  ⇒ 1200 宽窗口 4 列（卡 ~228）、1000 宽 3 列、
//   1600 宽 6 列、1920 宽 8 列；窗口一变列数自己跟着变 ✓
//   卡里的内边距/封面/按钮也一律按卡宽**按比例**推（见 card_pad/card_thumb/card_btn）
const int CARD_BASE_W = 220
const int CELL_GAP = 14

// ==================== 调色板（浅粉 + 背景插画透出 ✓）====================
// 改成"背景图 + 浅色遮罩"后，各容器的底色一律换成**半透明白** ——
//   叠起来是"内容区最透、侧栏/播放条略实、卡片最实"的层次，插画从缝里透出来 ✓
var C_VEIL      = #FFFFFF9E   // 全窗遮罩（62% 白）：55% 时插画亮部的次级文字会糊 ✗
var C_BG_TOP    = #FFFDFDFF   // 没有背景图时的兜底渐变（上）
var C_BG_BOT    = #FBE8F0FF   // 兜底渐变（下）
var C_SIDE      = #FFFFFF38   // 侧栏底（遮罩之上再叠 22% 白）
var C_BAR       = #FFFFFF4D   // 底部播放条底（30% 白）
var C_CARD      = #FFFFFF73   // 卡片/横卡底（45% 白，要能看出"块"的边界 ✓）
var C_TXT       = #35262BFF   // 主文字（暖黑）
// ★ 有背景图之后，次级/弱文字都**加深**了：原来的 #6B5A60 / #A08992 压在插画亮部上就糊了 ✗
var C_TXT_MID   = #55454BFF   // 次级文字
var C_TXT_DIM   = #77646DFF   // 弱文字
var C_ACCENT    = #E76F9BFF   // 主粉
var C_ACC_SOFT  = #FADBE6FF   // 主粉浅底（选中态）
var C_FIELD     = #FFFFFFD9   // 输入框/胶囊底
var C_LINE      = #F1DDE5FF   // 分隔线
var C_TRANS     = #00000000   // 透明

// ==================== 小工具 ====================
// 路径 / 标签 / 时间 / 颜色 / 曲库 key 这些**无状态**工具已抽到 lib/ui_kit.leno ✓
//   （主文件只留"页面与交互"，工具跟着数据格式走，改一处就够）

// ==================== 粉主题（给"只认主题"的控件用：Table / Edit / 滚动条 / tip）====================
//   为什么需要：`lightTheme()` 是中性灰（底 #F0F0F5、斑马 #ECECF2），而 Table 这类控件的颜色
//   **只从主题取**，本文件的 C_* 常量它们看不见 ⇒ 粉底窗口里摆出一块灰白表格 ✗
func appTheme(): Theme {
    Theme t = SDL3.lightTheme()
    t.name     = "aria-pink"
    t.bg       = C_BG_TOP
    t.bgAlt    = #FBEDF3FF
    t.bgInput  = #FFFFFFF2
    t.bgHover  = #F8E2EAFF
    t.bgSel    = C_ACC_SOFT
    t.bgZebra  = #FDF4F8FF
    // 标题栏专用色（弹窗顶部那条）：原来借的是 C_SIDE（半透明白），压在插画上糊成一片 ⇒
    //   给一个**实色粉**，和小界面的粉同色系
    t.bgHeader = #F6CFE0FF
    t.txt      = C_TXT
    t.txtInput = C_TXT
    t.txtDim   = C_TXT_DIM
    t.txtHeader = C_TXT_MID
    t.accent   = C_ACCENT
    t.accentFocus = #F08CB0FF
    t.accentBright = #E76F9BFF
    t.border   = C_LINE
    t.sep      = C_LINE
    t.sb       = #E9CBD6FF
    t.tipBg    = #35262BFF
    t.tipTxt   = #FFF7FAFF
    t.tipBrd   = #C9A9B5FF
    t.fontSize = 13.0
    return t
}

// （2026-10-26：皮肤选择已去掉 —— 外观只留「背景图 + 蒙版不透明度」，见 settings.leno ✓）

// 缓存目录已移到 lib/ui_kit.leno（cacheRoot / audioCacheDir / coverCacheDir）✓
//   设置里的缓存目录由 ui.set_cache_override(...) 注入
// 下载优先格式 / 并行线程数（同上，来自 settings.json）
var g_preferFmt = "lossless"
// 试听音质（在线播放的档位；standard / high / lossless）
var g_audioQ = "high"
// 下载附加（设置项）：同时存 .lrc / 把封面与歌词内嵌进音频文件 ✓
var g_dlLyric = true
var g_embedTag = false
// 「最近播放」保留条数（设置项；超出按时间顶替，丢最旧 ✓）
var g_recentMax = 60
var g_workers = 4
// 外观：背景图（"" = 内置 bk.jpg）与蒙版不透明度 ✓
var g_bgPath = ""
var g_veil = 158

// 封面逻辑在 lib/kuwo_cover.leno（单独模块，别塞进界面文件 ✓）

// ==================== 应用 ====================
export struct Player {
    // ----- 窗口骨架 -----
    Window win
    TitleBar tb
    float tbH = 0.0
    // 背景插画纹理（懒加载；只在 paint_bg 里用，退出时销毁 ✓）
    Ptr[u8]? bgTex
    bool bgTried = false
    VBox root
    HBox body
    VBox side
    VBox mainCol
    // 上一页的页面容器（只有表格页建 VBox）——换页要 dispose 它，见 drop_last_page()
    VBox lastPage
    bool hasLastPage = false
    // 虚拟网格页也有自己的容器（它不在 lastPage 里，单独记一份 ✓）
    VirtualGrid lastGrid
    bool hasLastGrid = false
    HBox topBar
    ScrollView sv
    VBox content
    HBox bar

    // ----- 侧栏状态 -----
    Array[Button] navBtns = []
    Array[Button] plBtns = []
    int curNav = 0

    // ----- 搜索 -----
    // 搜索框：**可编辑下拉**（边输边给建议，见 sug_* 那一组 ✓）
    ComboBox search
    Channel sugCh                 // 建议搜索的回信
    int sugAt = -1                // 防抖：等输入停下来再发请求（on_tick 拍数）
    string sugKw = ""             // 上一次发出去的关键词（同一个词不重复发）
    string query = ""
    Array[Song] netSongs = []      // 酷我搜索结果（非空就替代演示数据 ✓）
    // 最近播放（"继续收听"按这个顺序显示：最新播的排最前 ✓）
    Array[Song] recentSongs = []
    // 喜欢的歌（存酷我 id；卡片上的 ♥ 与「我喜欢」页都看它 ✓）
    Array[string] likedSids = []
    Table tbSearch                     // 搜索结果表（排序后显示行≠数据行 ⇒ 一律过 source_row ✓）
    bool hasTable = false              // 当前是否真的建过结果表（struct 值类型不能拿 null 判断 ✗）
    // 窗口缩放处理：resize 事件只置标记，on_tick 里比宽度、真变了才重建
    int lastBuildW = 0                 // 上次重建时的窗口宽（见 rebuild_content ✓）
    bool resizePending = false
    // ----- 「搜索结果」入口 + 上次搜索的快照（切页后还能点回来 ✓）-----
    Button searchBtn
    // ----- 下载列表（侧栏第二个入口；队列数据在 lib/downloads.leno 的协议里）-----
    Button dlBtn
    Array[Array[string]] dlJobs = []      // 行：[id, 歌名, 歌手, 状态, 说明]
    bool dlBusy = false                   // 是否正在下载（一次只下一个 ✓）
    // 本地音乐列表**建表时**的扫描结果 —— 点击/右击都按它取行，
    // 避免"再扫一次顺序变了、点 A 放 B"（2026-10-26 实测踩到 ✗）
    Array[Song] localCache = []

    // ----- 前进 / 后退（卡片文字点进详情页后就有历史了）-----
    //   只记录"用户点进去的页面"（首页 / 歌手页 / 歌曲页）；侧栏导航不记录 ⇒ 后退栈干净 ✓
    Button backBtn
    Button fwdBtn
    Array[int] histNav = []               // 页面类型：0 首页 / -3 歌手页 / -4 歌曲页
    Array[string] histArg = []            // 歌手名 / 歌曲 sid
    int histPos = -1
    string artistArg = ""                 // 当前歌手页的歌手名
    string songArg = ""                   // 当前歌曲页的 sid
    // 当前页的参数（nav_apply 每次进来记一次）—— 进歌词页时要把"来源页"压进历史栈，
    //   否则从「本地音乐/搜索结果」进歌词后关闭会回到首页（而不是来源页 ✗）
    string curArg = ""
    // 歌曲页为了补"相关歌曲"会后台搜一次同歌手 ——
    //   那次回信**不能**把页面切到结果表（否则点歌名进去又被弹回搜索页 ✗）
    bool relatedSearch = false
    // 下载工作线程回传（["P",已下,总] / ["D",字节,总] / ["E",原因,""]）；分片下载才能有进度 ✓
    Channel dlCh
    // 播放前取音源的回信（取直链+下载试听放线程，别再卡 UI ✓）
    Channel playCh
    Song pendingSong               // 正在准备的那首
    bool playPending = false
    int dlCur = -1                        // 正在下载的队列行号（-1 = 空闲）
    bool hasLastSearch = false
    Array[Song] lastSongs = []
    Array[Array[string]] lastRows = []
    Array[string] lastIds = []
    string lastKwSaved = ""
    Array[Array[string]] netRows = []  // 表格行：歌名/歌手/专辑/时长/格式/大小/来源
    string netMsg = ""             // 搜索状态：正在搜 / N 首 / 失败原因
    Array[string] netIds = []      // 与 netSongs 对应的酷我 id（取音源用）
    // ----- 搜索线程（LenoMusic 口径：工作线程跑网络，UI 用 try_receive 排空）-----
    Channel searchCh
    bool searching = false
    string lastKw = ""
    Channel coverCh                // 封面线程回信（[id, 路径]）
    string nowSid = ""             // 当前在播的酷我 id（判断封面回信是否过期 ✓）
    // 「为你推荐 / 最近添加」改成**酷我数据**（有 id ⇒ 真封面 + 真播放 ✓）
    Array[Song] recSongs = []
    Array[Song] newSongs = []
    Channel homeCh
    bool homeAsked = false
    bool homeLoaded = false
    bool homeLoading = false       // 首页推荐正在拉（内容区显示"正在加载"✓）
    int recBatch = 0               // 「换一批」轮换到第几组关键词（为你推荐）
    int newBatch = 0               // 同上（最近添加）
    // ----- 卡片控件登记表：收藏 / 封面回信一律**就地改图标**，不整页重建 -----
    //   为什么：rebuild_content() 把整页控件（含「换一批」胶囊、所有卡片）销毁重建
    //   ⇒ 点一次 ♥ 就"闪一下"（2026-10-27 反馈 ✗）
    //   只在**卡片页**（ScrollView 里长驻的卡片）登记；网格页卡片会被 vg 回收复用，
    //   拿旧引用去改会改错卡 ⇒ 网格页改成 pageRebuildOnLike，仍走重建 ✓
    bool trackCards = false
    bool pageRebuildOnLike = false
    Array[Button] cardLikeBtns = []
    Array[string] cardLikeKeys = []
    Array[ImageView] cardCovers = []
    Array[string] cardCoverKeys = []
    // 列表行里的 ♥（本地音乐/搜索/下载/相关歌曲）：收藏状态变了要就地换图，
    //   不能指望整页重建（表格页 pageRebuildOnLike = false ⇒ 图标会一直停在旧状态 ✗）
    Array[Button] rowLikeBtns = []
    Array[string] rowLikeKeys = []
    // ----- 真播放（miniaudio）-----
    Sound snd
    bool sndOk = false
    bool durKnown = false          // 时长只取一次
    int shownSec = -1              // 只在秒数变化时重绘
    bool seekSyncing = false       // 程序化刷新进度条时不许回灌 on_seek

    // ----- 底栏播放器 -----
    ImageView coverView
    Label nowTitle
    Label nowArtist
    Button playBtn
    Button likeBtn
    bool liked = false
    // 卡片尺寸（窗口宽度一变换就重算）+ 卡片回调（lib/cards.leno 不认识 Player，全由这里注入 ✓）
    CardSize cardSize
    CardHooks hooks

    // ----- 歌词页（curNav = -6：点底栏头像 / 歌词按钮进来）-----
    Channel lyrCh                 // 歌词线程回信（Array[string]，每行 "秒|文本"）
    // ---- 排行榜（curNav = 4）----
    Channel bangCh                // 榜单回信（与搜索同构：首条 [bid,""]，之后每首一行）
    int bangIdx = 0               // 当前榜单下标（对应 kuwo.bangmenu()）
    bool bangLoading = false
    Array[Song] bangSongs = []
    Array[Array[string]] bangRows = []
    // 卡片墙：每行 [bid, 榜名, 歌1, 歌2, 歌3]（每首已拼成 "歌名 — 歌手"）
    Channel bangCardsCh
    Array[Array[string]] bangCards = []
    bool bangCardsLoading = false
    bool bangDetail = false       // true = 正在看某个榜的完整列表（否则是卡片墙）
    // ---- 发现页（curNav = 5）：推荐歌单 ----
    Channel plCh                  // 推荐歌单回信（每行 [id,名,封面路径,播放量,曲目数,作者]）
    bool plAsked = false
    bool plLoading = false
    Array[Array[string]] plCards = []
    int plPage = 0                // 已加载到第几页（滚到底 → +1 继续拉 ✓）
    float plScrollY = 0.0         // 加载更多前的滚动位置（重建后要恢复，否则跳回顶部 ✗）
    // 发现页当前 Tab（0=精选 / 1=新歌速递 / 2=热门歌手）
    //   ⚠ 必须存字段：点卡片 ♥ / 播放会 rebuild_content()，Tab 会重建回第 0 页 ✗
    int discTab = 0
    // 歌单详情（curNav = 6）
    Channel plSongsCh
    string plArg = ""             // 当前打开的歌单 id
    string plTitle = ""           // 歌单名
    string plCover = ""           // 歌单封面（本地路径）
    bool plSongsLoading = false
    Array[Song] plSongs = []
    Array[Array[string]] plSongsRows = []
    // 卡片墙上的大封面：榜的第一首封面（异步拉，回信就地 set_image ✓）
    Array[Button] rankCovers = []
    Array[string] rankCoverSids = []
    ComboBox rankBox              // 选榜下拉（在 run 里建一次，页面里 add ⇒ 展开状态不会丢 ✓）
    // 歌词页左侧的大圆封面：**必须留句柄** —— 封面是异步回来的，
    //   底栏那张会就地 set_image，这里不跟着更新就会一直空着 ✗
    ImageView lyricBigCover
    // 歌词视图（字体 / 解析结果 / 逐字缓存 / 滚动状态）全在 lib/lyric_view.leno 的 LyricView 里 ✓
    LyricView lyric
    // 当前在播的**整首歌**（底栏 ♥ 要按它的 like_key 判断收藏状态；
    //   只靠 nowSid 的话，本地文件（sid 为空）没法判断 ✓）
        // ---- 播放列表（右侧浮层，参考主流播放器那种）----
    //   `queue` 是当前队列；`qIdx` 是正在播的那一项在队列里的下标（-1 = 不在队列里）
    //   列表页点行播放时用 `play_from(list, i)` 一次性把整张表塞进队列 ✓
    Array[Song] queue = []
    int qIdx = -1
    // 当前播放行的「跳动音柱」：一个 Canvas 复用给所有表格（同一时刻只有一行在播 ✓）
    //   相位放在数组里——闭包按**元素**读写才拿得到最新值（直接读 float 字段会捕获成副本 ✗）
    Canvas beatCv
    Array[float] beatPhase = [0.0]
    // 音量浮窗（点底栏音量图标弹出；与播放列表面板互斥）
    Card volRoot
    Slider volSld
    Label volPct
    bool volOpen = false
    // 播放列表浮层每行：hover 时把「时长」换成「×」（移除这一行）
    Array[Card] qRows = []
    Array[Label] qRowDur = []
    Array[Button] qRowX = []
    Array[Panel] qRowMark = []        // 封面上的「播放」标记（hover 时显示 ✓）
    Array[bool] qRowHot = []
    bool qOpen = false
    Panel qRoot                // 浮层卡片外壳（Panel 才有 set_visible ✓）
    VBox qPanel                // 浮层里的内容（标题 / 副标题 / 滚动区）
    VBox qList                 // 浮层里的行容器（每次打开重建）
    Label qSub                 // 「3 首 · 11 分钟」

Song nowSong
    ProgressBar seek
    Label curTime
    Label totTime
    float g_vol = 68.0            // 当前音量（0~100）—— 旧实现是底栏那条横向 Slider，现在只留值 ✓
    Button volBtn                 // 音量图标（yl.png 开 / yl1.png 静音）
    bool muted = false
    float lastVol = 68.0          // 静音前的音量，取消静音时恢复
    bool playing = false
    bool loopOne = false       // 循环模式：false = 列表循环 / true = 单曲循环
    // 起步必须是 **0**（原来写死 4.0 ⇒ 一打开就显示 00:04、
    //   进度条左边先挂一小块，和"还没开始播"对不上 —— 曾出现"起步不一致"✗）
    float pos = 0.0
    float dur = 0.0            // 真实时长由播放时 getDuration() 给出；未播时 0 ⇒ 显示 00:00

    // ----- 无头自检（步数由**定时器**推进，不是帧号 ✓ 见 movie_wall 的注解）-----
    const int STEP_MS = 100
    string shotPath = ""
    int shotAt = 14
    int shotExitAt = 0        // 截图后第几拍退出（不在渲染回调里 _exit ✓）
    int steps = 0
    // ----- 切页内存探针（ARIA_STRESS=N ⇒ 每拍交替切页一次，跑完报进程内存增量 ✓）-----
    int stressLeft = 0
    int stressMem0 = 0
    int stressReport = 0      // >0 ⇒ 停手后再等这么多拍才报（让 GC 有机会回收 ⇒ 区分"真泄漏"和"GC 水位"✓）
    bool stressWarm = false   // 首页渲染几帧后才记基线（首帧纹理加载不算进增量 ✓）
    int rclickAt = 0          // >0 ⇒ 第 N 拍在结果表上注入一次右键（验证 dispose 没让菜单悬空 ✓）
    int hoverAt = 0           // >0 ⇒ 第 N 拍把鼠标移到表格某行上（验证行级 hover 提示 ✓）
    int coverTestAt = 0       // >0 ⇒ 第 N 拍删掉封面缓存并重新请求（验证"回信时就地换歌词页大封面" ✓）
    // 第二段点击：ARIA_CLICK2=x,y + ARIA_CLICK2_AT=N —— 用来验"点进去 → 再点返回"这种两步操作 ✓
    int click2At = 0
    string click2Raw = ""
    // 第三段点击（验"播一首 → 开面板 → 点面板里的行"这种三步操作 ✓）
    int click3At = 0
    string click3Raw = ""
    int lyricAt = 0           // >0 ⇒ 第 N 拍切到歌词页（只切页，不碰播放 ✓）


    // ==================== 入口 ====================
    func run() {
        SDL3.ttfInit()
        searchCh = threads.channel(4)         // 搜索回信通道（一次一条 ✓）
        coverCh = threads.channel(8)          // 封面回信通道
        dlCh = threads.channel(64)            // 下载进度回传（分片下载每 1MB 一条 ✓）
        playCh = threads.channel(8)           // 播放前取音源（一次一首 ✓）
        sugCh = threads.channel(4)            // 搜索建议（一个词一条 ✓）
        homeCh = threads.channel(4)           // 首页分区（为你推荐/最近添加）回信通道
        lyrCh = threads.channel(4)            // 歌词回信（一首一条 ✓）
        bangCh = threads.channel(4)           // 排行榜回信（单个榜）
        bangCardsCh = threads.channel(4)      // 卡片墙回信（多榜前 3 首）
        plCh = threads.channel(4)             // 发现页：推荐歌单回信
        plSongsCh = threads.channel(4)        // 歌单详情：歌曲回信
        SDL3.setTheme(appTheme())             // 粉主题：Table / Edit / 滚动条都跟着变粉 ✓

        // 字体可切换（必须在建任何控件**之前**设定，字体会在控件创建时加载）：
        //   ARIA_FONT=light  ⇒ 雅黑 Light（msyhl.ttc）：笔画更细、大标题更秀气
        //   ARIA_FONT=<路径> ⇒ 任意 ttf/ttc（自带字体也能这么挂）
        var fenv = _env("ARIA_FONT")
        if fenv != null {
            string fv = _str(fenv)
            if fv == "light" {
                string lp = SDL3.defaultCjkFontLight()
                if lp != "" { SDL3.setUiFont(lp) }
            } else if fv != "" {
                SDL3.setUiFont(fv)
            }
        }

        win = SDL3.createWindow({title: "Aria — LenoSDL3", w: WIN_W, h: WIN_H, flags: 0x20})
        if not win.ok { SDL3.ttfQuit(); return }
        win.setMinSize(980, 660)

        // 排行榜下拉：榜单菜单固定 31 个（kuwo.bangmenu()），启动时建一次
        //   页面里只 add ⇒ 展开/滚动状态不会因为重建而丢 ✓
        Array[Array[string]] bmenus = kuwo.bangmenu()
        Array[string] bnames = []
        for bmenus to bm { bnames.add(bm[1]) }
        rankBox = SDL3.createComboBox({w: 220, h: 34, font_size: 13, radius: 17, pad_x: 14.0,
                                       items: bnames, popup_h: 280, item_h: 28,
                                       bg_color: C_FIELD, border_color: C_LINE, text_color: C_TXT,
                                       hover_color: #F3D3E2FF, sel_color: #F7C3D8FF})
        rankBox.set_selected(0)
        rankBox.on_change(func(int idx) { load_bang(idx) })

        // ---- 自绘标题栏（win.add 后系统边框自动去掉 ✓）----
        tb = SDL3.createTitleBar({title: "Aria", h: TB_H, font_size: 12,
                                  bg_color: C_SIDE, text_color: C_TXT_DIM,
                                  icon_color: C_TXT_MID, hover_color: C_ACC_SOFT,
                                  show_separator: false})
        win.add(tb)
        tbH = tb.get_h()

        // ---- 播放列表面板（右侧浮层，默认隐藏）----
        //   为什么用 `win.add` 而不是塞进 body：它要**盖在**内容区上面（z 更高），
        //   而且不该占布局空间 ✓；坐标是窗口绝对坐标（右下角贴底栏上方）
        qRoot = SDL3.createPanel({x: WIN_W - 284, y: WIN_H - 560, w: 268, h: 470,
                                  bg_color: #FFFFFFF7, radius: 16,
                                  border: true, border_color: #E8D5DEFF, clip: true})
        qPanel = SDL3.createVBox({x: 0, y: 0, w: 268, h: 470, pad_x: 12, pad_y: 10, spacing: 6})
        HBox qh = SDL3.createHBox({x: 0, y: 0, w: 244, h: 30, pad_x: 0, pad_y: 0, spacing: 8})
        qh.add(ui.lbl("播放列表", 14, C_TXT, true), {grow: 0, shrink: 0, align: 1})
        qh.add(SDL3.createLabel({text: ""}), {grow: 1, shrink: 1, align: 1})
        Button qClear = SDL3.createButton({image_path: ui.ico("menu_delete_all.png"), image_size: 16,
                                           w: 26, h: 26, radius: 8,
                                           bg_color: C_TRANS, hover_color: #FFFFFFC8,
                                           padding: 0.0, border: false, shadow: false, tip: "清空列表"})
        qClear.on_click(func() { queue_clear() })
        qh.add(qClear, {grow: 0, shrink: 0, basis: 26, align: 1})
        Button qClose = SDL3.createButton({text: "×", font_size: 16, w: 26, h: 26, radius: 8,
                                          bg_color: C_TRANS, hover_color: #FFFFFFC8,
                                          text_color: C_TXT_DIM, padding: 0.0,
                                          border: false, shadow: false, tip: "关闭"})
        qClose.on_click(func() { toggle_queue() })
        qh.add(qClose, {grow: 0, shrink: 0, basis: 26, align: 1})
        qPanel.add(qh, {grow: 0, shrink: 0, basis: 30, align: 3})
        qSub = ui.lbl("0 首", 10.5, C_TXT_DIM, false)
        qPanel.add(qSub, {grow: 0, shrink: 0, basis: 18, align: 3})
        // 滚动条：宽度 6 + 半透明（默认 12 的实心条在小面板里又粗又抢眼 ✗）
        ScrollView qsv = SDL3.createScrollView({x: 0, y: 0, w: 244, h: 396, smooth: true,
                                                bg_color: C_TRANS, border: false,
                                                bar_w: 6.0,
                                                bar_color: #C9A9B880,
                                                bar_hover_color: #B98FA0B0})
        qList = SDL3.createVBox({x: 0, y: 0, w: 244, h: 396, pad_x: 0, pad_y: 0, spacing: 2})
        qsv.set_content(qList)
        qPanel.add(qsv, {grow: 1, shrink: 1, align: 3})
        qRoot.setLayout(qPanel)
        win.add(qRoot)
        qOpen = false
        qRoot.set_visible(false)

        // 当前播放行的跳动音柱（**一个实例**给所有表格复用：同一时刻只有一行在播 ✓）
        beatCv = page_ov.make_beat(beatPhase)

        // ---- 恢复上次的播放队列（★ 不自动播：只把队列和「当前曲目」摆回来 ✓）----
        //   进度也恢复（底栏时长从断点开始显示），点播放键就接着播
        var sess0 = session.load(cfgset.store_path())
        if sess0.queue.len() > 0 {
            queue = sess0.queue
            qIdx = sess0.cur
            if qIdx >= 0 and qIdx < queue.len() {
                nowSong = queue[qIdx]
                nowSid = nowSong.sid
                pos = sess0.pos
                sync_play_ui()
            }
        }

        // ---- 音量浮窗：**竖条**（参考图：白圆角条 + 顶部数字 + 竖直滑块）----
        //   贴在底栏音量图标正上方，宽度只有按钮那么宽（不挡内容 ✓）
        volRoot = SDL3.createCard({x: WIN_W - 128, y: WIN_H - 300, w: 52, h: 188,
                                   bare: true, radius: 18, content_pad: 6,
                                   bg_color: #FFFFFFF2, border: true, border_color: #E8D5DEFF})
        // 用 AnchorBox **显式**给尺寸：VBox 的 grow 会把滑块撑宽（thumb 直径 = w*0.45，
        //   被撑到容器宽就变成一根"温度计" ✗）
        AnchorBox vcol = SDL3.createAnchorBox({x: 0, y: 0, w: 40, h: 176})
        // 数字要**水平居中**：Label 自己是左对齐的 ⇒ 外面套一层 justify:1 的 HBox ✓
        HBox vtop = SDL3.createHBox({x: 0, y: 0, w: 40, h: 22, pad_x: 0, pad_y: 0,
                                     spacing: 0, justify: 1})
        volPct = ui.lbl("68", 13, C_TXT, true)
        vtop.add(volPct, {grow: 0, shrink: 0, basis: 26, align: 1})
        vcol.add(vtop, {left: 0, top: 0, w: 40, h: 22})
        // 竖直滑块：细杆 + 紫色填充 + 底部圆点（配色照参考图）
        volSld = SDL3.createSlider({x: 0, y: 0, w: 12, h: 146, vertical: true,
                                    value: g_vol, min: 0.0, max: 100.0,   // 用恢复后的音量 ✓
                                    show_value: false,
                                    fill_color: #6E4E9EFF, track_color: #E6DEF3FF,
                                    thumb_color: #6E4E9EFF})
        volSld.on_change(func(float v) {
            on_volume(v)              // 里面会写 g_vol ✓
            sync_vol_ui()
        })
        vcol.add(volSld, {left: 14, top: 28, w: 12, h: 146})   // 居中：40 宽里 12 宽 → left 14
        volRoot.set_content(vcol)
        win.add(volRoot)
        volOpen = false
        volRoot.set_visible(false)

        // ---- 根：上=主体（撑满）/ 下=播放条（定高）----
        root = SDL3.createVBox({x: 0, y: 0, w: WIN_W, h: _float(WIN_H) - tbH,
                                pad_x: 0, pad_y: 0, spacing: 0})
        win.setRootAt(root, 0.0, tbH)

        body = SDL3.createHBox({x: 0, y: 0, w: WIN_W, h: 500, pad_x: 0, pad_y: 0, spacing: 0})
        root.add(body, {grow: 1, shrink: 1, align: 3})

        // 先读设置（缓存目录 / 优先格式 / 线程数）—— ui.cacheRoot() 依赖它，必须在建界面之前 ✓
        apply_settings(cfgset.load())
        // 卡片回调注入（lib/cards.leno 不认识 Player，播放/收藏/下载都由这里接上 ✓）
        init_card_hooks()
        // 再把喜欢/最近播放读回来（必须在建界面之前，否则首页第一帧是空的 ✓）
        load_library()
        build_side()
        build_main()
        build_bar()

        // 历史栈的起点 = 首页（之后点歌名/歌手才有"后退"可回 ✓）
        nav_push(0, "")
        nav_update_btns()

        start_timer()
        self_test()

        win.run(func(Event ev): bool { return on_event(ev) },
                func(Renderer r) { paint_bg(r) })
        save_user_state()         // ★ 退出前落盘：音量 / 队列 / 当前曲目 / 进度
                                  //   （放在这里 = 所有退出路径都会走到 ✓：✕ 按钮 / SDL_QUIT / requestExit）
        shutdown_audio()          // 兜底（requestExit / SDL_QUIT 路径；重复调用无害 ✓）
        if bgTex != null { SDL3.destroyTexture(bgTex); bgTex = null }   // 背景纹理自己收 ✓
        SDL3.ttfQuit()
    }

    // 背景：**画在控件之下**（窗内回调在控件之前跑 ✓）
    //   ① 背景插画 bk.jpg：ASPECT_FILL 取源图一块 ⇒ 不变形；取景**偏右**（人物在右侧，别裁脸 ✓）
    //   ② 压一层 65% 白遮罩 ⇒ 深色插画上仍用深色文字也看得清（"毛玻璃"观感 ✓）
    //   ③ 没有 bk.jpg 就退回原来的粉色渐变（删了图也不会黑屏 ✓）
    pri func paint_bg(Renderer r) {
        var[float, float](ow, oh) = r.getOutputSize()
        r.clearColor(C_BG_BOT)
        if bgTex == null and not bgTried {
            bgTried = true
            // 设置里选了背景图就用它，否则用内置 bk.jpg（两个都失败 ⇒ 退回粉色渐变 ✓）
            string path = if g_bgPath != "" then g_bgPath else ui.img("bk.jpg")
            bgTex = SDL3.loadImageTexture(r.handle, path)
        }
        if bgTex != null {
            var[float, float](tw, th) = r.getTextureSize(bgTex)
            if tw > 1.0 and th > 1.0 {
                float sc = ow / tw
                if oh / th > sc { sc = oh / th }
                float sw = ow / sc
                float sh = oh / sc
                float sx = (tw - sw) * 0.60          // 0.5 = 正中；偏右一些保住人物脸部 ✓
                float sy = (th - sh) * 0.5
                if sx < 0.0 { sx = 0.0 }
                if sy < 0.0 { sy = 0.0 }
                if sx + sw > tw { sx = tw - sw }
                if sy + sh > th { sy = th - sh }
                r.drawTextureFromTo(bgTex, sx, sy, sw, sh, 0.0, 0.0, ow, oh)
                // 遮罩透明度来自设置（0 = 原图，255 = 全白）；用 withAlpha 明确构造 Color，
                //   ⚠ 别写 `#FFFFFF00 + veil` —— 字面量+int 的类型推断会让 alpha 丢失（实测遮罩变没了 ✗）
                r.setColor(SDL3.withAlpha(#FFFFFFFF, g_veil))
                r.fillRect(0.0, 0.0, ow, oh)
                return
            }
        }
        r.fillGradientRect(0.0, 0.0, ow, oh, C_BG_TOP, C_BG_BOT, 0)
    }

    // ==================== 侧栏 ====================
    pri func build_side() {
        side = SDL3.createVBox({x: 0, y: 0, w: SIDE_W, h: 400,
                                pad_x: 12, pad_y: 14, spacing: 2, bg_color: C_SIDE})
        body.add(side, {grow: 0, shrink: 0, basis: SIDE_W, align: 3})

        // ---- 品牌行：主色圆 + 名字（参考图左上的圆形头像位 ✓）----
        HBox brand = SDL3.createHBox({x: 0, y: 0, w: SIDE_W - 24, h: 34,
                                      pad_x: 0, pad_y: 0, spacing: 9})
        Button logo = SDL3.createButton({image_path: ui.ico("music.png"), image_size: 16,
                                         w: 30, h: 30, radius: 15,
                                         bg_color: C_ACCENT, hover_color: C_ACCENT,
                                         padding: 0.0, border: false, shadow: false})
        brand.add(logo, {grow: 0, shrink: 0, basis: 30, align: 1})
        brand.add(ui.lbl("Aria", 15, C_TXT, true), {grow: 1, shrink: 1, align: 1})
        side.add(brand, {grow: 0, shrink: 0, basis: 46, align: 3})

        // ---- 主导航（图标 + 文字，选中 = 浅粉胶囊 + 主色字 ✓）----
        //   分成三段建：①首页 ②「我的音乐」组 +（下载 / 搜索结果）③「发现」组
        //   为什么要拆：参考图里"下载管理"属于「我的音乐」组，而它现在是单独建的按钮，
        //   如果全在主循环后追加，就会跑到「发现」组下面 ✗
        //   ⚠ 段边界写死 0..3 / 4..，与 data.navMain() 的顺序绑定（i 就是页面号）✓
        var mains = data.navMain()
        for 0 : 3 to i {
            if mains[i].group != "" {
                side.add(group_head(mains[i].group), {grow: 0, shrink: 0, basis: 30, align: 3})
            }
            new_nav(mains[i], i)
        }

        // ---- 「下载」：搜索结果 / 继续收听里右击「下载」的东西都进这里 ----
        dlBtn = SDL3.createButton({text: "下载管理", font_size: 14,
                                   align: "left", padding: 14.0, radius: 10, h: 40,
                                   image_path: ui.ico("download.png"), image_size: 17,
                                   image_gap: 9, image_pos: "left", image_tint: C_TXT_DIM,
                                   border: false, shadow: false, tip: "下载队列与历史"})
        dlBtn.set_bg_color(C_TRANS)
        dlBtn.set_hover_color(#FFFFFFC8)
        dlBtn.set_text_color(C_TXT_DIM)
        dlBtn.on_click(func() { open_downloads() })
        side.add(dlBtn, {grow: 0, shrink: 0, basis: 40, align: 3})

        // ---- 「搜索结果」：回到上次搜索的那张表（没搜过时是灰的 ✓）----
        searchBtn = SDL3.createButton({text: "搜索结果", font_size: 14,
                                       align: "left", padding: 14.0, radius: 10, h: 40,
                                       image_path: ui.ico("search.png"), image_size: 17,
                                       image_gap: 9, image_pos: "left", image_tint: C_TXT_DIM,
                                       border: false, shadow: false,
                                       tip: "回到上次搜索的结果"})
        searchBtn.set_bg_color(C_TRANS)
        searchBtn.set_hover_color(#FFFFFFC8)
        searchBtn.set_text_color(C_TXT_DIM)
        searchBtn.on_click(func() { open_last_search() })
        side.add(searchBtn, {grow: 0, shrink: 0, basis: 40, align: 3})

        // 第二段：排行榜 / 发现
        for 4 : mains.len() - 1 to i {
            if mains[i].group != "" {
                side.add(group_head(mains[i].group), {grow: 0, shrink: 0, basis: 30, align: 3})
            }
            new_nav(mains[i], i)
        }

        // ---- 歌单分组头「创建的歌单 +」----
        HBox plHead = SDL3.createHBox({x: 0, y: 0, w: SIDE_W - 24, h: 28,
                                       pad_x: 0, pad_y: 0, spacing: 4})
        plHead.add(ui.lbl("创建的歌单", 11, C_TXT_DIM, false), {grow: 1, shrink: 1, align: 1})
        Button addBtn = SDL3.createButton({text: "+", font_size: 15.0, w: 22, h: 22, radius: 11,
                                           bg_color: C_TRANS, hover_color: #FFFFFFC8,
                                           text_color: C_TXT_DIM, padding: 0.0,
                                           border: false, shadow: false, tip: "新建歌单"})
        plHead.add(addBtn, {grow: 0, shrink: 0, basis: 22, align: 1})
        side.add(plHead, {grow: 0, shrink: 0, basis: 34, align: 3})

        // ---- 歌单列表（图标 + 名字 + 右侧曲目数 ✓）----
        var pls = data.navPlaylists()
        for 0 : pls.len() - 1 to i { new_pl(pls[i], i + navBtns.len()) }

        // ---- 底部：弹性空隙（「更多」按钮已去掉，没接任何功能 ✓ 2026-10-26）----
        side.add(SDL3.createLabel({text: ""}), {grow: 1, shrink: 1, align: 3})
    }

    // 侧栏分组小标题（灰色小字 + 左边距，与参考图一致 ✓）
    pri func group_head(string t): HBox {
        HBox h = SDL3.createHBox({x: 0, y: 0, w: SIDE_W - 24, h: 30,
                                  pad_x: 14, pad_y: 0, spacing: 0})
        h.add(ui.lbl(t, 11, C_TXT_DIM, false), {grow: 0, shrink: 0, align: 1})
        return h
    }

    // 建一个主导航项（idx 传进来 ⇒ 闭包按值记住它 ✓）
    pri func new_nav(NavItem it, int idx) {
        // 与 CoCo Music 的侧栏对齐：14px / 高 40 / 圆角 10 / 左内边距 14 ——
        //   原来 13px+34 行高偏紧，读起来"挤" ✓
        // 图标（参考图那种：图标在左、文字在后，灰色线框感）
        string ip = if it.icon != "" then ui.ico(it.icon) else ""
        Button b = SDL3.createButton({text: it.name, font_size: 14,
                                      align: "left", padding: 14.0, radius: 10, h: 40,
                                      image_path: ip, image_size: 17, image_gap: 9,
                                      image_pos: "left", image_tint: C_TXT_DIM,   // 统一灰色（彩色图标凑在一起太花 ✗）
                                      border: false, shadow: false})
        style_nav(b, idx == curNav)
        b.on_click(func() { set_nav(idx) })
        navBtns.add(b)
        side.add(b, {grow: 0, shrink: 0, basis: 40, align: 3})
    }

    // 建一个歌单项（**只有名字**，不再显示右侧曲目数 —— 那些数字是编的，2026-10-26 去掉 ✓）
    pri func new_pl(NavItem it, int idx) {
        Button b = SDL3.createButton({text: it.name, font_size: 13,
                                      align: "left", padding: 14.0, radius: 9, h: 34,
                                      border: false, shadow: false})
        b.set_bg_color(C_TRANS)
        b.set_hover_color(#FFFFFFC8)
        b.set_text_color(C_TXT_MID)
        b.on_click(func() { set_nav(idx) })
        plBtns.add(b)
        side.add(b, {grow: 0, shrink: 0, basis: 34, align: 3})
    }

    // 导航项样式：选中 = 浅粉底 + 主色字/图标；未选中 = 透明 + 暖灰（悬停有底 ✓）
    //   初始化与切换都走这里 ⇒ 只有一处定义 ✓
    pri func style_nav(Button b, bool active) {
        if active {
            b.set_bg_color(C_ACC_SOFT)
            b.set_hover_color(C_ACC_SOFT)
            b.set_text_color(C_ACCENT)
        } else {
            b.set_bg_color(C_TRANS)
            b.set_hover_color(#FFFFFFC8)
            b.set_text_color(C_TXT_MID)
        }
    }

    pri func set_nav(int idx) {
        // 点了导航要真的**换页**（原来只改高亮 ⇒ 曾出现"点了没切换"）
        //   内容区按新页面重建（标题 / 说明 / 卡片都跟着换），并回到顶部。
        bool changed = idx != curNav
        curNav = idx
        // 排行榜 / 发现：侧栏走的是 set_nav（不经过 nav_apply）⇒ 在这里触发首屏拉取 ✓
        if idx == 4 { enter_rank() }
        if idx == 5 { enter_discover() }
        // 切到大列表页 ⇒ 从第一批重新开始（否则上次翻到 300 条会一直背着 ✓）
        searchBtn.set_bg_color(C_TRANS)
        searchBtn.set_hover_color(#FFFFFFC8)
        if hasLastSearch { searchBtn.set_text_color(C_TXT_MID) }
        dlBtn.set_bg_color(C_TRANS)              // 离开下载页 ⇒ 它的高亮也要撤 ✓
        dlBtn.set_hover_color(#FFFFFFC8)
        dlBtn.set_text_color(C_TXT_MID)          // ⚠ 文字色也得撤：原来只撤了底色 ⇒
                                                 //   点了下载管理再点别的，「下载管理」几个字仍是粉色 ✗
        for 0 : navBtns.len() - 1 to i { style_nav(navBtns[i], i == idx) }
        for 0 : plBtns.len() - 1 to i {
            Button b = plBtns[i]
            if (i + navBtns.len()) == idx {
                b.set_text_color(C_ACCENT)
                b.set_bg_color(C_ACC_SOFT)
                b.set_hover_color(C_ACC_SOFT)
            } else {
                b.set_text_color(C_TXT_MID)
                b.set_bg_color(C_TRANS)
                b.set_hover_color(#FFFFFFC8)
            }
        }
        if changed {
            // ★ 切页必须**退出搜索态**：`build_content` 里"有 netSongs 就渲染结果表并 return"，
            //   不清空的话标题换了、内容还是那张表（标题"最近播放"、下面是酷我结果）
            netSongs = []
            netRows = []
            netIds = []
            netMsg = ""
            lastKw = ""
            nowSid = ""
            hasTable = false
            // ★ 输入框里的关键词也是"搜索态"：`on_change` 会把它写进 query，
            //   而 build_content 在 query != "" 时走搜索分支 ⇒ 框里留着字，点哪个导航
            //   都显示"没有找到匹配的歌曲"（框里有内容就切不动）
            //   ⇒ 切页时**连输入框一起清空**（浏览器点新链接也是这个行为 ✓）
            query = ""
            search.set_text("")
            rebuild_content()
            sv.set_scroll(0.0, 0.0)      // 换页回顶部（否则停在上一个页面的位置 ✓）
        }
        SDL3.markFrameRedraw()
    }

    // 回到上次搜索（左侧「搜索结果」入口；curNav = -1 特指这一页）
    pri func open_last_search() {
        if not hasLastSearch { return }
        netSongs = lastSongs
        netRows = lastRows
        netIds = lastIds
        netMsg = "酷我「" + lastKwSaved + "」· " + _str(lastSongs.len()) + " 首（双击行播放）"
        curNav = -1
        for 0 : navBtns.len() - 1 to i { style_nav(navBtns[i], false) }
        for 0 : plBtns.len() - 1 to i {
            plBtns[i].set_text_color(C_TXT_MID)
            plBtns[i].set_bg_color(C_TRANS)
        }
        {
            searchBtn.set_bg_color(C_ACC_SOFT)
            searchBtn.set_hover_color(C_ACC_SOFT)
            searchBtn.set_text_color(C_ACCENT)
        }
        rebuild_content()
        sv.set_scroll(0.0, 0.0)
        SDL3.markFrameRedraw()
    }

    // 打开下载列表（curNav = -2 特指这一页）
    pri func open_downloads() {
        curNav = -2
        netSongs = []
        netRows = []
        netMsg = ""
        hasTable = false
        for 0 : navBtns.len() - 1 to i { style_nav(navBtns[i], false) }
        for 0 : plBtns.len() - 1 to i {
            plBtns[i].set_text_color(C_TXT_MID)
            plBtns[i].set_bg_color(C_TRANS)
        }
        searchBtn.set_bg_color(C_TRANS)
        searchBtn.set_hover_color(#FFFFFFC8)
        if hasLastSearch { searchBtn.set_text_color(C_TXT_MID) }
        dlBtn.set_bg_color(C_ACC_SOFT)
        dlBtn.set_hover_color(C_ACC_SOFT)
        dlBtn.set_text_color(C_ACCENT)
        rebuild_content()
        sv.set_scroll(0.0, 0.0)
        SDL3.markFrameRedraw()
    }

    // 侧栏「下载 (N)」角标
    pri func refresh_dl_btn() {
        int p = dl.pending(dlJobs)
        if p > 0 { dlBtn.set_text("下载 (" + _str(p) + ")") } else { dlBtn.set_text("下载") }
        dlBtn.set_text_color(if p > 0 then C_ACCENT else C_TXT_MID)
        SDL3.markFrameRedraw()
    }

    // ==================== 主区：顶栏 + 滚动内容 ====================
    pri func build_main() {
        mainCol = SDL3.createVBox({x: 0, y: 0, w: 900, h: 500, pad_x: 0, pad_y: 0, spacing: 0})
        body.add(mainCol, {grow: 1, shrink: 1, align: 3})

        // ---- 顶栏 ----
        topBar = SDL3.createHBox({x: 0, y: 0, w: 900, h: TOP_H, pad_x: PAD, pad_y: 0, spacing: 10})
        mainCol.add(topBar, {grow: 0, shrink: 0, basis: TOP_H, align: 3})

        // 前进/后退：用图标（48 源图按 1/3 显示为 16，整数倍不糊 ✓）
        backBtn = SDL3.createButton({image_path: ui.ico("houtui.png"), image_size: 16,
                                     w: 30, h: 30, radius: 15,
                                     bg_color: #FFFFFFAA, hover_color: #FFFFFFFF,
                                     padding: 0.0, border: false, shadow: false, tip: "后退"})
        backBtn.on_click(func() { nav_back() })
        topBar.add(backBtn, {grow: 0, shrink: 0, basis: 30, align: 1})
        fwdBtn = SDL3.createButton({image_path: ui.ico("qianjin.png"), image_size: 16,
                                    w: 30, h: 30, radius: 15,
                                    bg_color: #FFFFFFAA, hover_color: #FFFFFFFF,
                                    padding: 0.0, border: false, shadow: false, tip: "前进"})
        fwdBtn.on_click(func() { nav_fwd() })
        topBar.add(fwdBtn, {grow: 0, shrink: 0, basis: 30, align: 1})
        topBar.add(SDL3.createLabel({text: ""}), {grow: 1, shrink: 1, align: 1})

        // 可编辑下拉：外观与原来的胶囊输入框一致（radius 18 / pad_x 16），
        //   下拉里放**搜索建议**（输入停下 400ms 后后台搜 8 条，取歌名去重 ✓）
        // 当作搜索框用 ⇒ **不要下拉箭头、不要外框**（视觉上就是一个胶囊输入框 ✓）；
        //   下拉里的 hover/选中色要给足对比，否则白底上"划过去没反应"（实测 ✗）
        search = SDL3.createComboBox({w: 300, h: 36, font_size: 13, radius: 18, pad_x: 16.0,
                                      editable: true, items: [],
                                      placeholder: "搜索歌曲、歌手、歌单",
                                      popup_h: 232, item_h: 28,
                                      show_arrow: false, border: false,
                                      icon: ui.ico("sousuo.png"), icon_size: 16.0, icon_gap: 6.0,
                                      bg_color: C_FIELD, border_color: C_LINE, text_color: C_TXT,
                                      hover_color: #F3D3E2FF, sel_color: #F7C3D8FF})
        // 文本变化 ⇒ 本地过滤 + 排一次建议请求（防抖）
        search.on_text_change(func() {
            on_search()
            string kw = strings.trim(search.get_text())
            if kw.len() == 0 {
                search.set_suggestions([])     // 空词 ⇒ 收起列表 ✓
                sugAt = -1
            } else {
                sugAt = steps + 2              // 约 400ms 后再发请求（每拍 200ms）
            }
        })
        // 选中某条建议 ⇒ 直接用它搜酷我（文本已由控件填好 ✓）
        search.on_change(func(int idx) { on_kuwo_search() })
        search.on_enter(func(string t) { on_kuwo_search() })   // 回车 = 搜酷我（联网 ✓）
        topBar.add(search, {grow: 0, shrink: 0, basis: 300, align: 1})

        // ---- 设置（齿轮，2026-10-26 需求）----
        topBar.add(SDL3.createLabel({text: ""}), {grow: 0, shrink: 0, basis: 6, align: 1})
        Button gear = SDL3.createButton({image_path: ui.ico("setting.png"), image_size: 24,
                                         w: 30, h: 30, radius: 15,
                                         bg_color: C_TRANS, hover_color: #FFFFFFC8,
                                         padding: 0.0, border: false, shadow: false,
                                         tip: "设置"})
        gear.on_click(func() { open_settings() })
        topBar.add(gear, {grow: 0, shrink: 0, basis: 34, align: 1})

        // ---- 滚动内容 ----
        sv = SDL3.createScrollView({x: 0, y: 0, w: 900, h: 500, fit_w: true, step: 64,
                                    smooth: true, bg_color: C_TRANS, border: false,
                                    bar_color: #E9CBD6FF})
        mainCol.add(sv, {grow: 1, shrink: 1, align: 3})

        content = SDL3.createVBox({x: 0, y: 0, w: 900, h: 900, pad_x: PAD, pad_y: 4, spacing: 8})
        sv.set_content(content)

        build_content()
    }

    // ==================== 内容区两种形态 ====================
    //   · 卡片页：顶栏 + ScrollView（内容自己往下排）
    //   · 表格页：顶栏 + Table **直接占满剩余高度**（grow:1，表格内部滚动）
    //   表格以前塞在 ScrollView 的 content 里、高度按行数写死
    //     ⇒ 只有 2 行时就是一条小横条
    pri func show_scroll() {
        trackCards = true                  // 卡片页：卡片长驻，可登记引用做就地更新 ✓
        pageRebuildOnLike = false
        drop_last_page()
        mainCol.clear()
        // ⚠ `mainCol.clear()` 只把控件移出布局，**Window 的渲染列表里还留着**
        //   ⇒ 换页后旧控件会继续画在原来的坐标上（卡片页/网格页互相叠在一起 ✗）
        //   所以复用控件进出页面时必须自己管 visible ✓
        sv.set_visible(true)
        mainCol.add(topBar, {grow: 0, shrink: 0, basis: TOP_H, align: 3})
        mainCol.add(sv, {grow: 1, shrink: 1, align: 3})
    }

    // 表格页：顶栏 + 「标题/副标题」+ 表格（表格吃满剩余高度，内部自己滚 ✓）
    //   ⚠ 不能只放表格：那样页面标题会被顶掉（截图里表头直接贴着顶栏 ✗）
    // 只有加载中的页面：标题 + 副标题 + Spinner 行
    //   （与首页/排行榜的加载观感完全一致 —— 任何"等数据"的地方都用它 ✓）
    pri func show_loading_page(string title, string sub, string text) {
        trackCards = false
        pageRebuildOnLike = false
        drop_last_page()
        mainCol.clear()
        sv.set_visible(false)
        mainCol.add(topBar, {grow: 0, shrink: 0, basis: TOP_H, align: 3})
        VBox page = SDL3.createVBox({x: 0, y: 0, w: 900, h: 500,
                                     pad_x: PAD, pad_y: 6, spacing: 8})
        page.add(ui.lbl(title, 25, C_TXT, true), {grow: 0, shrink: 0, basis: 36, align: 3})
        page.add(ui.lbl(sub, 11, C_TXT_DIM, false), {grow: 0, shrink: 0, basis: 18, align: 3})
        page.add(pw.loading_row(text, _float(cardSize.content_w())), {grow: 0, shrink: 0, basis: 40, align: 3})
        page.add(SDL3.createLabel({text: ""}), {grow: 1, shrink: 1, align: 3})
        mainCol.add(page, {grow: 1, shrink: 1, align: 3})
        lastPage = page
        hasLastPage = true
        SDL3.markFrameRedraw()
    }

    pri func show_table_page(string title, string sub, Table t) {
        trackCards = false                 // 表格页：没有卡片，表里也没有 ♥ 列 ✓
        pageRebuildOnLike = false
        drop_last_page()
        mainCol.clear()
        sv.set_visible(false)          // 表格页不用 ScrollView（见 show_scroll 的注释 ✓）
        mainCol.add(topBar, {grow: 0, shrink: 0, basis: TOP_H, align: 3})
        VBox page = SDL3.createVBox({x: 0, y: 0, w: 900, h: 500,
                                     pad_x: PAD, pad_y: 6, spacing: 8})
        page.add(ui.lbl(title, 25, C_TXT, true), {grow: 0, shrink: 0, basis: 36, align: 3})
        page.add(ui.lbl(sub, 11, C_TXT_DIM, false), {grow: 0, shrink: 0, basis: 18, align: 3})
        page.add(t, {grow: 1, shrink: 1, align: 3})
        mainCol.add(page, {grow: 1, shrink: 1, align: 3})
        lastPage = page
        hasLastPage = true
        SDL3.markFrameRedraw()
    }

    // ==================== 歌词页 ====================
    //   点底栏**头像**或**歌词按钮**进来：左=大圆封面（播放时慢转），右=歌词，当前行高亮 ✓
    //   截图参考：唱片在左、歌词在右、当前行橙色加粗
    const float LYR_LINE_H = 42.0      // 每行歌词高（当前行 20px 粗体，行距要跟着松 ✓）
    const float LYR_PAD = 24.0         // 歌词区上内边距（让首行也能滚到正中 ✓）

    pri func show_lyric_page() {
        show_scroll()
        content.add(ui.lbl("歌词", 25, C_TXT, true), {grow: 0, shrink: 0, basis: 36, align: 3})
        string sub = if nowSid != "" then nowTitle.get_text() + " · " + nowArtist.get_text() else "还没有在播的歌"
        content.add(ui.lbl(sub, 11, C_TXT_DIM, false), {grow: 0, shrink: 0, basis: 18, align: 3})

        // 歌词视口高：窗口高 −（顶栏 58 + 标题区 ~56 + 底栏 ~90 + 边距）—— 尽量吃满剩余高度 ✓
        float lvh = _float(win.getSize().h) - 240.0
        if lvh < 240.0 { lvh = 240.0 }
        lyric.viewH = lvh
        HBox row = SDL3.createHBox({x: 0, y: 0, w: _float(cardSize.content_w()), h: lvh,
                                    pad_x: 0, pad_y: 10, spacing: PAD})
        // 左：大圆封面 + **图片下方**歌名 / 歌手（整体顶对齐 ⇒ 图片上移 ✓）
        int cs = 240
        VBox left = SDL3.createVBox({x: 0, y: 0, w: _float(cs), h: lvh,
                                     pad_x: 0, pad_y: 0, spacing: 10})
        // 封面优先用**已在本地缓存**的那张（纯本地判断，不联网 —— cover_of() 是会下网的 ✗）：
        //   点播一首刚搜到的歌时 nowSong.cover 往往还是空的，此时缓存里若已有就直接用 ✓
        string cp0 = ui.coverPath(nowSong.cover)
        if nowSong.sid != "" {
            string lc = dirs.join(ui.coverCacheDir(), cover.cache_name(nowSong.sid, "120"))
            if files.exists(lc) { cp0 = lc }
        }
        lyricBigCover = SDL3.createImageView({w: _float(cs), h: _float(cs), radius: _float(cs) / 2.0,
                                             image_path: cp0,
                                             bg_color: #F3E4EBFF, tip: "点击返回"})
        lyricBigCover.on_click(func() { open_lyrics(false) })   // 再点一下收回去 ✓
        lyricBigCover.set_spin(if playing then 10.0 else 0.0)   // 比底栏更慢，歌词页安静一点 ✓
        left.add(lyricBigCover, {grow: 0, shrink: 0, basis: _float(cs), align: 3})
        // 歌名（粗体）/ 歌手（小灰）—— 居中的做法：外层 HBox `justify: 1` + 子项宽度 = 量出来的文本宽
        //   ⚠ 不能直接给 Label 传 align:1：Label 的 align 把 x 当**中心点**，在 VBox 里 x 是左边界 ⇒ 会偏左 ✗
        lyric.ensure_fonts()
        string tname = nowTitle.get_text()
        if tname == "" { tname = "—" }
        // 歌名（图片正下方，粗体、居中）
        var[float, float](nw, nh) = lyric.fTitle.measureString(tname)
        HBox trow = SDL3.createHBox({x: 0, y: 0, w: _float(cs), h: 26,
                                     pad_x: 0, pad_y: 0, spacing: 0, justify: 1})
        trow.add(ui.lbl(tname, 15, C_TXT, true),
                 {grow: 0, shrink: 0, basis: if nw < _float(cs) then nw + 2.0 else _float(cs), align: 3})
        left.add(trow, {grow: 0, shrink: 0, basis: 26, align: 3})
        if nowArtist.get_text() != "" {
            var[float, float](aw, ah) = lyric.fArtist.measureString(nowArtist.get_text())

            HBox arow = SDL3.createHBox({x: 0, y: 0, w: _float(cs), h: 20,
                                         pad_x: 0, pad_y: 0, spacing: 0, justify: 1})
            // 歌手用 MID 而不是 DIM：浅色背景插画上 DIM 几乎看不见（实测截图发虚 ✗）
            arow.add(ui.lbl(nowArtist.get_text(), 12.5, C_TXT_MID, false),
                     {grow: 0, shrink: 0, basis: if aw < _float(cs) then aw + 2.0 else _float(cs), align: 3})
            left.add(arow, {grow: 0, shrink: 0, basis: 20, align: 3})
        }
        row.add(left, {grow: 0, shrink: 0, basis: _float(cs), align: 0})

        // 右：歌词 —— **Canvas 自绘**（照洛雪音乐的观感 ✓）
        //   居中 / 当前行 20px 粗体橙 / 其它行 15px 按距离渐隐 / 当前行按时间逐字扫光 / 滚动缓动
        float lw0 = _float(cardSize.content_w() - cs - PAD * 2)
        if lw0 < 200.0 { lw0 = 200.0 }
        // 画布交给 LyricView 建；**回调挂在 Player 这边**（闭包能读到 pos / nowSid 的最新值 ✓）
        lyric.canvas = lyric.build(lw0, lvh)
        lyric.canvas.on_draw(func(Renderer r, float ox, float oy, float cw, float ch) {
            string noMsg = if nowSid == "" then "还没有在播的歌" else "（这首歌没有歌词，或还没加载）"
            lyric.draw(r, ox, oy, cw, ch, noMsg, pos)
        })
        row.add(lyric.canvas, {grow: 1, shrink: 1, align: 0})
        content.add(row, {grow: 0, shrink: 0, basis: lvh, align: 3})

        lyric.reset_idx()               // 重排后重新定位/上色 ✓
        SDL3.markFrameRedraw()
    }

    // 打开/关闭歌词页 —— **开关式**：已经在歌词页时，再点就关掉并退回"进歌词前那一页" ✓
    //   ⚠ 旧实现每次点都 `nav_push(-6)`，关闭又 `nav_push(0)` ⇒ 连点 10 次要退 10 次才回到原页 ✗
    //   ⚠ 关闭必须走 `nav_back()`（出栈），不能再 push 一页首页（否则栈越来越深 ✗）
    pri func open_lyrics(bool enter) {
        if curNav == -6 {
            // 已经在歌词页 ⇒ 不论 enter 传什么，都当"关闭"
            if histPos > 0 {
                nav_back()                  // 回到进歌词前那一页
            } else {
                set_nav(0)                  // 极端情况（栈里没有上一页）⇒ 直回首页
            }
            SDL3.markFrameRedraw()
            return
        }
        if enter {
            // ① 先把**来源页**压进栈（栈顶不是当前页时）：
            //    切页走的是 set_nav（只改 curNav、不入栈），所以从「本地音乐」进歌词后，
            //    栈里没有它 ⇒ nav_back 会一路退到首页（不是用户期望的"歌词前那一页" ✗）
            if histPos < 0 or histPos >= histNav.len() or histNav[histPos] != curNav {
                nav_push(curNav, curArg)
            }
            // ② 再进歌词页（没在播也允许：页面里会写"还没有在播的歌"，比点了没反应好 ✓）
            nav_push(-6, "")
            nav_apply(-6, "")
        }
    }

    // 无头验证专用：把底栏"假装"指向一首歌（**不打开音频**，只改文字/封面/进度）
    //   只在 ARIA_LYRIC 探针、且当前没在播时调用 ✓
    pri func fake_now_song() {
        Song s = new Song()
        s.sid = "228908"
        s.title = "晴天"
        s.artist = "周杰伦"
        s.cover = "cover05.png"
        nowSong = s
        nowSid = s.sid
        nowTitle.set_text(s.title)
        nowArtist.set_text(s.artist)
        coverView.set_image(ui.coverPath(s.cover))
        dur = 269.0
        durKnown = true
        pos = 0.0
        totTime.set_text(ui.fmtTime(dur))
        sync_like_icon()
        SDL3.markFrameRedraw()
    }

    // 本地音频 → 同目录同名 .lrc 的路径（不存在则返回 ""）
    //   下载时勾了「同时存 .lrc」才有；扩展名就这几种，直接替换 ✓
    pri func lrc_path_of(string filePath): string {
        // ⚠ 形参别叫 `audio`：会和 `import "Music" as audio` 撞名（报"模块 audio 中没有方法 replace"）
        if filePath == "" { return "" }
        string p = filePath.replace(".mp3", ".lrc").replace(".MP3", ".lrc")
                            .replace(".flac", ".lrc").replace(".FLAC", ".lrc")
                            .replace(".m4a", ".lrc").replace(".M4A", ".lrc")
        if p == filePath { return "" }               // 没替换成功 = 不认识的扩展名
        if files.exists(p) { return p }
        return ""
    }

    // 取歌词（后台线程；同一首不重复取 ✓）
    pri func request_lyric() {
        // ---- 本地文件：读**同目录同名 .lrc**（在线歌那条路要 sid，本地没有 ⇒ 原来直接 return ✗）----
        if nowSong.path != "" {
            string key = nowSong.path
            if lyric.sid == key { return }           // 已经加载过这一首
            lyric.sid = key                           // 拿路径当"哪一首"的标识
            lyric.clear()
            string lp = lrc_path_of(key)
            if lp != "" {
                try {
                    lyric.set_text(files.read(lp))
                } catch e {
                    print("[lyric] 读本地 .lrc 失败：" + _str(e))
                }
            }
            lyric.loading = false
            return
        }
        string sid = nowSid
        if sid == "" { return }
        if sid == lyric.sid { return }
        lyric.sid = sid
        lyric.clear()                       // 换歌先清空，避免上一首的歌词留在屏幕上 ✗
        lyric.loading = true
        threads.start(workers.lyric, sid, lyrCh)
    }

    // 歌词推进（33ms 定时器）：读位置 → 交给 LyricView 走一步（换行 / 缓动滚动 / 淡入）✓
    pri func lyr_ui_tick() {
        if curNav != -6 { return }
        if playing and sndOk {
            float p2 = snd.getPosition()
            if p2 >= 0.0 { pos = p2 }
        }
        lyric.tick(pos, playing)
    }

    pri func drop_last_page() {
        if hasLastPage {
            lastPage.dispose()
            hasLastPage = false
        }
        if hasLastGrid {
            lastGrid.dispose()
            hasLastGrid = false
        }
        SDL3.closeContextMenus(null)   // 兜底：任何控件正在弹出的菜单都收起
    }

    // 内容区：页面标题 + 三个分区（搜索时按关键词过滤 ✓）
    pri func build_content() {
        // 旧页面的控件马上要被移出布局/销毁 ⇒ 登记表先清空（否则留着已销毁控件的引用 ✗）
        cardLikeBtns = []
        cardLikeKeys = []
        cardCovers = []
        cardCoverKeys = []
        rowLikeBtns = []
        rowLikeKeys = []
        rankCovers = []
        rankCoverSids = []
        // ★ 大列表（我喜欢 / 最近播放）走**虚拟网格页**：卡片是真控件（每张 7 个），
        //   上百张之后每帧布局/绘制就会拖垮界面（1000 张实测一帧几百毫秒 ✗）
        //   vg 只构建可见的十几张，滚动时回收复用 ⇒ 几千条也稳 ✓
        if curNav == 1 or curNav == 2 {
            var bigSongs = page_songs(curNav)
            if bigSongs.len() > 0 {
                // 只有「我喜欢」页给删除钮（删 = 取消收藏）；「最近播放」删了没意义 ✓
                show_grid_page(page_name(curNav), "共 " + _str(bigSongs.len()) + " 首",
                               bigSongs, curNav == 1)
                return
            }
        }
        // 歌词页（curNav = -6）：**自己带标题**，所以在"默认标题"之前就分流 ✓
        //   （放在后面的话会多出一行 page_name() 的标题 + "共 N 首" 副标题 ✗）
        if curNav == -6 {
            show_lyric_page()
            return
        }
        // 默认回到"卡片页"形态（顶栏 + ScrollView）；表格分支稍后会换成 show_table ✓
        show_scroll()
        // 标题跟着**当前导航**走（原来写死"首页" ⇒ 点左侧「我喜欢」等
        //   只有高亮在动、页面内容一动不动，看起来就是"点了没切换" ✗）
        content.add(ui.lbl(page_name(curNav), 25, C_TXT, true), {grow: 0, shrink: 0, basis: 36, align: 3})
        // **不再有演示数据** —— 副标题只说真实情况，
        //   没有内容就留空（页面正文会给"这里还没有歌曲"）✓
        string sub = ""
        if curNav == 0 {
            int tot = recentSongs.len() + recSongs.len() + newSongs.len()
            if homeLoading { sub = "正在加载推荐…" }
            else { sub = if tot > 0 then "继续收听 / 为你推荐 / 最近添加 · 共 " + _str(tot) + " 首" else "还没有内容 · 搜一首歌开始听" }
        } else if curNav == 2 {
            sub = if recentSongs.len() > 0 then "最近播放 · " + _str(recentSongs.len()) + " 首" else "还没有播放记录"
        } else if curNav == 3 {
            int dn = dl.scan(ui.cacheRoot()).len()
            sub = if dn > 0 then "已下载 · " + _str(dn) + " 首（cache\\downloads）" else "还没有下载 · 搜索后右击歌曲「下载」"
        } else if curNav == -3 {
            sub = "歌手：" + artistArg
        } else if curNav == -4 {
            Song one = find_song(songArg)
            sub = if one.artist != "" then one.artist else "歌曲详情"
        } else if curNav == 4 {
            sub = "听见此刻的热门 · 点卡片看完整榜单"
        } else if curNav > 4 {
            sub = "歌单还是空的"
        } else {
            // 「我喜欢」：按实际收藏数说话（原来固定写"还没有喜欢的歌"，有内容也对不上 ✗）
            int ln = liked_songs().len()
            // ⚠ 别用 `♡`（U+2661）：本界面用的中文字体没有这个字形 ⇒ 渲染成豆腐块 ▯
            //   （同类坑之前踩过：♥/☆ 都不全，图标请用 images/icons 里的 PNG ✓）
            sub = if ln > 0 then "共 " + _str(ln) + " 首" else "还没有喜欢的歌 · 点卡片上的爱心图标"
        }
        if query != "" { sub = "搜索「" + query + "」" }
        // 歌曲页的副标题固定是歌手名，别被"酷我「周杰伦」· 12 首"顶掉 ✓
        if netMsg != "" and curNav != -4 { sub = netMsg }
        content.add(ui.lbl(sub, 11, C_TXT_DIM, false), {grow: 0, shrink: 0, basis: 18, align: 3})
        content.add(SDL3.createLabel({text: ""}), {grow: 0, shrink: 0, basis: 8, align: 3})

        // 搜索中且没有旧结果 ⇒ 整页显示"正在搜索…"
        //   ⚠ 首页的 `homeLoading` **不能**在这里拦截：那样整页都被占位替换，
        //     「继续收听」会跟着消失（"点换一批，继续收听也不见了"）
        //     ⇒ 它只在首页的"为你推荐"那一段里显示占位（见下面首页分支 ✓）
        if netSongs.len() == 0 and searching {
            loading_row("正在搜索…")
            return
        }

        // 有酷我搜索结果 ⇒ **表格**列出
        //   为什么不铺卡片：搜索要的是信息密度（歌名/歌手/时长/音质），封面要额外
        //   每首一次详情页 + 一次图片下载 ⇒ 一次搜索多花十秒，得不偿失 ✗
        //   ⚠ 但**歌曲页 / 下载页**不能用这张表：它们自己的分支在后面，
        //     而这里只看 `netSongs.len()` —— 歌曲页为了补"相关歌曲"会把 netSongs 填满，
        //     于是先命中这张表、把歌曲页顶掉（点歌名后跳到"搜索结果"）
        if netSongs.len() > 0 and curNav != -4 and curNav != -2 and curNav != -6 {
            int rowH = 58
            // 每行一个行控件（封面 + 歌名/歌手 + ♥/⬇）—— 第 0 列交给它渲染 ✓
            Array[HBox] srowV = []
            RowHooks shk = new RowHooks()
            shk.isLiked = func(Song sg2): bool { return is_liked(ui.like_key(sg2)) }
            shk.onLike = func(Song sg2) { toggle_song_like(sg2) }
            shk.onTrack = func(Song sg2, Button b) { track_row_like(sg2, b) }     // ♥ 登记：取消喜欢时就地换图标 ✓
            shk.revealIcon = "download.png"
            shk.revealTip = "下载到本地"
            shk.onReveal = func(Song sg2) { queue_song(sg2) }
            shk.showCover = false          // 不要行首那枚占位音符图（列表更干净 ✓）
            for netSongs to it {
                srowV.add(rv.song_row(it, _float(rowH), shk))
            }
            // 序号列：数字 ↔ 播放图（点了播这一行）
            Array[HBox] numL = []
            Array[Canvas] numI = []
            for 0 : netSongs.len() - 1 to i {
                int ri0 = i
                // 序号列：数字 ↔ 播放钮（工厂在 `page_widgets`，五张表共用一套 ✓）
                Array[Widget] nc = pw.number_cell(i, rowH, func() { play_net_row(ri0) })
                numL.add(nc[0] as HBox)
                numI.add(nc[1] as Canvas)
            }
            // 列与 LenoMusic 的搜索页同一套口径（歌名/歌手/专辑/时长/格式/大小/来源），
            //   列宽合计 826 ≤ 内容宽 840 ⇒ 最右列不会被裁掉 ✓（LenoMusic 记过这个账）
            hasTable = true
            // 列宽**按内容区宽度按比例分**，
            //   不再写死 826 —— 写死的话窗口一宽，右侧就多出一条空列，整张表看着偏左 ✗
            //   比例：歌名 33% / 歌手 16% / 专辑 16% / 时长 9% / 格式 7% / 大小 12% / 来源 7%
            // 用**比例列宽**（`col_ratios`）：控件按当前宽度实时折算 ⇒ 窗口缩放自动跟随，
            //   不用再监听 resize 重建；图标列（16+6）由控件自己从总宽里扣掉 ✓
            float tw2 = _float(cardSize.content_w())
            tbSearch = SDL3.createTable({x: 0, y: 0, w: tw2, h: 420.0,   // 高度由布局撑满 ✓
                                         item_h: rowH, header_h: 32, font_size: 13,
                                         headers: ["", "歌曲", "专辑", "时长", "大小"],
                                         row_numbers: false,             // 序号改成普通列（数字 / 播放图切换 ✓）
                                        // 右击菜单样式透传（Table 内部自建 MenuBar）：图标 24 = 48 源图的一半 ✓
                                        // 字号 12.5：菜单默认 15 在浅色小面板里又大又粗，看着别扭 ✗
                                        ctx_image_size: 16.0, ctx_item_h: 28.0, ctx_font_size: 12.5,
                                         // 合计 0.99（留 1% 余量，避免浮点累加恰好顶满 ✓）
                                         col_ratios: [0.06, 0.52, 0.22, 0.10, 0.09],
                                         aligns: [1, 0, 0, 1, 1],
                                         // **表头文字居中**（表体仍按列语义对齐 ✓）
                                         // 表头与数据列**同对齐** ——
                                         //   原来表头一律居中、下面内容左对齐，看着是两套排版 ✗
                                         header_aligns: [1, 0, 0, 1, 1],
                                         // 行图标：`image_col` 把该列画成 [图标 + 文字]，
                                         //   配 `image_path` 给**默认图标**⇒ 不用逐行 set_row_image ✓
                                         // 封面由**行控件**自己画（见下面的 set_cell_builder）✓
                                         // 配色：透明底 + 关斑马纹 ⇒ 让窗口粉渐变透上来（不再是一块白板 ✓）
                                         //   其余（正文/悬停/滚动条）走 appTheme() 的粉主题 ✓
                                         sortable: false, zebra: false, resizable: false,   // 排序会打乱"显示行 vs 数据行"，行控件按数据行建，先关 ✓
                                         bg_color: C_TRANS, header_color: C_TRANS,   // 表头不铺底色（半透明背景上那块浅灰太突兀 ✓）
                                         // 行块：圆角 + 左右内缩（列表卡片观感）；悬停用浅色实底 ✓
                                         row_radius: 12, row_pad_x: 10,
                                         sel_color: #E6DCF7CC, hover_color: #EDE7FBD9, solid_sel: false,
                                         sep_color: C_TRANS, border: false,          // 去外框/分隔线 ✓
                                         empty_text: "没有结果"})
                                         tbSearch.set_rows(netRows)
                                         // 第 0 列交给行控件；`cell_interactive` 让 ♥/⬇ 能点 ✓
                                         tbSearch.set_cell_builder(func(int row, int col, float cw, float ch, bool hovered): Widget? {
                                             if row < 0 or row >= srowV.len() { return null }
                                             if col == 0 {
                                                 Widget? nw = null
                                                 // 正在播的这一行 ⇒ 跳动音柱（优先于 hover 的播放钮 ✓）
                                                 if row < netSongs.len() and is_now_playing(netSongs[row]) { nw = beatCv }
                                                 else if hovered { nw = numI[row] }
                                                 else { nw = numL[row] }
                                                 return nw
                                             }
                                             if col == 1 { return srowV[row] }
                                             return null
                                             })
                                         tbSearch.set_cell_interactive(true)
                                          // ★ 只有**双击**才播放：单击 = 选中、右键 = 菜单（之前挂 on_select 会让右击也开播 ✗）
                                         //   行号一律过 `source_row`（表头排序后显示行 ≠ 数据行 ✓）
                                         tbSearch.on_dbl_click(func(int row, int col) { play_net_row(row) })
                                         // 右击菜单（与歌曲页相关歌曲表同一套口径 ✓）
                                         //   用**声明式** builder：框架先清空再填 ⇒ 不用手写 clearContextItems，
                                         //   也就不会出现"上一行/上一页的项串进来"✗
                                         tbSearch.set_context_builder(func(int row): Array[Dict] {
                                             // row < 0 = 右击**空白处**（表格下半截没行的地方）⇒ 只给整页级动作 ✓
                                             //   照 文件管理器 的口径：空白处不给"针对某一行"的项，否则点了也不知道作用于哪行 ✗
                                             if row < 0 {
                                                 return [ui.mi("下载全部结果", "dlall", "download.png")]
                                             }
                                             return [ui.mi("播放", "play", "menu_play.png"),
                                                     ui.mi("下载", "dl", "download.png"),
                                                     ui.mi("下载全部", "dlall", "add.png"),
                                                     ui.mi("搜索这首歌", "sw", "search.png"),
                                                     ui.mi("搜索这位歌手", "sa", "sousuo.png"),
                                                     ui.mi("复制歌名", "copy", "list.png")]
                                         })
                                         tbSearch.on_context_select(func(int row, string id) {
                                             if id == "dlall" {
                                                 int n = 0
                                                 string qf = if g_preferFmt == "lossless" then "FLAC" else "MP3"
                                                 for netSongs to s {
                                                     if s.sid != "" { n = n + dl.enqueue(dlJobs, s.sid, s.title, s.artist, qf) }
                                                 }
                                                 refresh_dl_btn()
                                                 nowArtist.set_text(if n > 0 then "已加入下载队列 " + _str(n) + " 首" else "这些歌都已经在下载列表里了")
                                                 SDL3.markFrameRedraw()
                                                 return
                                             }
                                             int i = tbSearch.source_row(row)
                                             if i < 0 or i >= netSongs.len() { return }
                                             if id == "play" { play_net_song(i) }
                                             else if id == "dl" { enqueue_download(i) }
                                             else if id == "sw" {
                                                 search.set_text(netSongs[i].title)
                                                 on_kuwo_search()
                                             } else if id == "sa" {
                                                 search.set_text(netSongs[i].artist)
                                                 on_kuwo_search()
                                             } else if id == "copy" {
                                                 SDL3.setClipboardText(netSongs[i].title + " - " + netSongs[i].artist)
                                             }
                                         })
            // 搜索进行中 ⇒ 用统一的 Spinner 加载页；回来后再换成表格 ✓
            //   （表格占满剩余高度、内部滚动，标题用 netMsg 里的搜索状态）
            if searching {
                show_loading_page("搜索结果", netMsg, "正在搜索…")
            } else {
                show_table_page("搜索结果", netMsg, tbSearch)
            }
            return
        }

        // ==================== 歌曲页（curNav = -4，点卡片歌名进来）====================
        if curNav == -4 {
            // 这一页只有大封面 + 播放/下载按钮 + 下面那张相关歌曲表，**没有 ♥**
            //   ⇒ 底栏 ♥ 变化时别重建它（否则相关歌曲表会被整个再造一遍 ✗）
            trackCards = false
            Song sg = find_song(songArg)
            if sg.title == "" {
                content.add(ui.lbl("这首歌找不到了（换个页面再试）", 11.5, C_TXT_DIM, false),
                            {grow: 0, shrink: 0, basis: 30, align: 3})
                return
            }
            HBox head = SDL3.createHBox({x: 0, y: 0, w: _float(cardSize.content_w()), h: 200,
                                         pad_x: 0, pad_y: 0, spacing: 20})
            // 大封面上的钮也用固定像素（48 = 源图原尺寸，1:1 最清晰 ✓）
            bool bigCur = is_now_playing(sg)
            ImageView big = SDL3.createImageView({w: 180, h: 180, radius: 16,
                                                  image_path: ui.coverPath(sg.cover),
                                                  overlay_path: ui.ico(if bigCur then "pause.png" else "play.png"),
                                                  overlay_size: 48.0,
                                                  tip: if bigCur then "暂停" else "播放"})
            big.on_click(func() {
                if is_now_playing(sg) { toggle_play(); rebuild_content() }
                else { play_song(sg); rebuild_content() }
            })
            head.add(big, {grow: 0, shrink: 0, basis: 180, align: 1})

            VBox info = SDL3.createVBox({x: 0, y: 0, w: 400, h: 180, pad_x: 0, pad_y: 6, spacing: 6})
            Label st = SDL3.createLabel({text: sg.title, font_size: 22, text_color: C_TXT})
            st.set_font_style(SDL3.STYLE_BOLD)
            info.add(st, {grow: 0, shrink: 0, basis: 34, align: 3})
            // 歌手：点它 = 搜这个歌手（表格在下面出结果，等于"更多该歌手的歌"✓）
            Label sa = SDL3.createLabel({text: sg.artist, font_size: 13, text_color: C_TXT_MID,
                                         hover_color: C_ACCENT, cursor: SDL3.SystemCursor.POINTER,
                                         tip: "查看这个歌手的更多歌"})
            sa.on_click(func() { open_artist(sg.artist) })
            info.add(sa, {grow: 0, shrink: 0, basis: 24, align: 0})
            info.add(ui.lbl("时长 " + sg.dur, 11.5, C_TXT_DIM, false), {grow: 0, shrink: 0, basis: 20, align: 0})

            // 相关歌曲要**先算出来**：下面「下载全部」的回调要用它（闭包按引用捕获数组 ✓）
            var rel = related_songs(sg)

            // ⚠ align 必须是 0/1（左/中），写 3 会被 VBox **横向拉满** ⇒ 截图中那条整行的蓝条 ✗
            HBox btnRow = SDL3.createHBox({x: 0, y: 0, w: 300, h: 36, pad_x: 0, pad_y: 0, spacing: 10})
            Button pb = SDL3.createButton({text: "播放", w: 104, h: 34, radius: 17,
                                           type: "primary", font_size: 13})
            pb.on_click(func() { play_song(sg) })
            btnRow.add(pb, {grow: 0, shrink: 0, basis: 104, align: 1})
            // 播放旁边加「下载全部」——当前这首 + 相关歌曲整批入队
            Button dall = SDL3.createButton({text: "下载全部", w: 112, h: 34, radius: 17,
                                             type: "dark", font_size: 13})
            dall.set_tip("把当前这首和相关歌曲全部加入下载队列")
            dall.on_click(func() {
                int n = 0
                string qfmt = if g_preferFmt == "lossless" then "FLAC" else "MP3"
                if sg.sid != "" { n = n + dl.enqueue(dlJobs, sg.sid, sg.title, sg.artist, qfmt) }
                for rel to s {
                    if s.sid != "" { n = n + dl.enqueue(dlJobs, s.sid, s.title, s.artist, qfmt) }
                }
                refresh_dl_btn()
                nowArtist.set_text(if n > 0 then "已加入下载队列 " + _str(n) + " 首" else "这些歌都已经在下载列表里了")
                SDL3.markFrameRedraw()
            })
            btnRow.add(dall, {grow: 0, shrink: 0, basis: 112, align: 1})
            btnRow.add(SDL3.createLabel({text: ""}), {grow: 1, shrink: 1, align: 1})
            info.add(btnRow, {grow: 0, shrink: 0, basis: 42, align: 0})
            head.add(info, {grow: 1, shrink: 1, align: 1})
            content.add(head, {grow: 0, shrink: 0, basis: 200, align: 3})

            // ---- 相关歌曲（按歌名搜到的结果；搜索在 nav_apply 里发起 ✓）----
            content.add(ui.lbl("相关歌曲", 13.5, C_TXT, true), {grow: 0, shrink: 0, basis: 26, align: 3})
            if rel.len() == 0 {
                content.add(ui.lbl("列表里还没有同歌手的其它歌 —— 用上面的搜索框搜「" + sg.artist + "」", 11, C_TXT_DIM, false),
                            {grow: 0, shrink: 0, basis: 30, align: 3})
                return
            }
            // ⚠ 歌曲页在 ScrollView 里 ⇒ 宽度要减掉竖滚动条，否则比视口宽 12px，
            //   会触发**横向滚动条**（截图里表格底部那条粗白线 ✗）
            float rw = _float(cardSize.content_w() - 12)
            Array[Array[string]] rrows = []
            Array[HBox] rrowV = []
            RowHooks rhk = new RowHooks()
            rhk.isLiked = func(Song sg2): bool { return is_liked(ui.like_key(sg2)) }
            rhk.onLike = func(Song sg2) { toggle_song_like(sg2) }
            rhk.onTrack = func(Song sg2, Button b) { track_row_like(sg2, b) }     // ♥ 登记：取消喜欢时就地换图标 ✓
            rhk.revealIcon = "download.png"
            rhk.revealTip = "下载到本地"
            rhk.onReveal = func(Song sg2) { queue_song(sg2) }
            rhk.showCover = false          // 相关歌曲没有封面 ⇒ 不要那枚占位音符图 ✓
            // 序号列：数字 ↔ 播放钮（同一套 ✓）
            Array[HBox] numL = []
            Array[Canvas] numI = []
            for 0 : rel.len() - 1 to i {
                int ri0 = i
                Array[Widget] nc = pw.number_cell(i, 58, func() { play_song(rel[ri0]) })
                numL.add(nc[0] as HBox)
                numI.add(nc[1] as Canvas)
            }
            for rel to s {
                rrows.add(["", "", s.dur, if s.sid != "" then "在线" else "本地"])
                rrowV.add(rv.song_row(s, 58.0, rhk))
            }
            // 高度留 8px 余量：正好卡满时 Table 会判定"需要竖向滚动条"，
            //   竖条一占位又会连锁触发横向滚动条（截图里周围那圈白线 ✗）
            float rh = _float(32 + rel.len() * 58 + 8)
            Table rt = SDL3.createTable({x: 0, y: 0, w: rw, h: rh,
                                         item_h: 58, header_h: 32, font_size: 13,
                                         headers: ["", "歌曲", "时长", "来源"],
                                         row_numbers: false,                     // 序号改成普通列（数字/播放钮切换 ✓）
                                         ctx_image_size: 16.0, ctx_item_h: 28.0, ctx_font_size: 12.5,   // 菜单字号与正文一致（默认 15 又大又粗 ✗）
                                         col_ratios: [0.06, 0.60, 0.17, 0.16],   // 合计 0.99（比例，随宽度自适应 ✓）
                                         aligns: [1, 0, 1, 1], header_aligns: [1, 0, 1, 1],   // 表头跟数据列同对齐 ✓
                                         sortable: false, zebra: false, resizable: false,
                                         text_color: C_TXT,
                                         bg_color: C_TRANS, header_color: C_TRANS,   // 表头不铺底色（半透明背景上那块浅灰太突兀 ✓）
                                         // 选中 / 悬停都**半透明**：压在背景插画上淡淡的才不刺眼
                                         //   （白色那行是 hover，不是选中 ⇒ hover_color 一起给 ✓）
                                         row_radius: 12, row_pad_x: 8,
                                         sel_color: #E6DCF7CC, hover_color: #EDE7FBD9, solid_sel: false,
                                         sep_color: C_TRANS, border: false,
                                         empty_text: "暂无相关歌曲"})
            rt.set_rows(rrows)
            rt.set_cell_builder(func(int row, int col, float cw, float ch, bool hovered): Widget? {
                if row < 0 or row >= rrowV.len() { return null }
                if col == 0 {
                    Widget? nw = null
                    // 正在播的这一行 ⇒ 跳动音柱（同搜索结果 / 本地音乐 ✓）
                    if row < rel.len() and is_now_playing(rel[row]) { nw = beatCv }
                    else if hovered { nw = numI[row] }
                    else { nw = numL[row] }
                    return nw
                }
                if col == 1 { return rrowV[row] }
                return null
            })
            rt.set_cell_interactive(true)
             rt.on_dbl_click(func(int row, int col) {
                if row >= 0 and row < rel.len() { play_song(rel[row]) }
            })
            // ---- 右击菜单----
            rt.set_context_builder(func(int row): Array[Dict] {
                // row < 0 = 右击在**空白处** ⇒ 只给整页级动作（照 文件管理器 的口径 ✓）
                //   行级动作（播放/下载/搜索这首…）是"针对某一行"的，空白处弹出来就是假动作 ✗
                if row < 0 {
                    return [ui.mi("下载全部相关歌曲", "dlall", "download.png")]
                }
                return [ui.mi("播放", "play", "menu_play.png"),
                        ui.mi("下载", "dl", "download.png"),
                        ui.mi("下载全部", "dlall", "add.png"),
                        ui.mi("搜索这首歌", "sw", "search.png"),
                        ui.mi("搜索这位歌手", "sa", "sousuo.png"),
                        ui.mi("复制歌名", "copy", "list.png")]
            })
            rt.on_context_select(func(int row, string id) {
                string qfmt = if g_preferFmt == "lossless" then "FLAC" else "MP3"
                if id == "dlall" {
                    int n = 0
                    for rel to s {
                        if s.sid != "" { n = n + dl.enqueue(dlJobs, s.sid, s.title, s.artist, qfmt) }
                    }
                    refresh_dl_btn()
                    nowArtist.set_text(if n > 0 then "已加入下载队列 " + _str(n) + " 首" else "这些歌都已经在下载列表里了")
                    SDL3.markFrameRedraw()
                    return
                }
                if row < 0 or row >= rel.len() { return }
                Song one = rel[row]
                if id == "play" {
                    play_song(one)
                } else if id == "dl" {
                    int n = dl.enqueue(dlJobs, one.sid, one.title, one.artist, qfmt)
                    refresh_dl_btn()
                    nowArtist.set_text(if n > 0 then "已加入下载队列：" + one.title else "已在下载列表里：" + one.title)
                    SDL3.markFrameRedraw()
                } else if id == "sw" {
                    // 用这首歌的名字重新搜（进搜索结果表 ✓）
                    search.set_text(one.title)
                    on_kuwo_search()
                } else if id == "sa" {
                    search.set_text(one.artist)
                    on_kuwo_search()
                } else if id == "copy" {
                    SDL3.setClipboardText(one.title)
                    nowArtist.set_text("已复制歌名：" + one.title)
                    SDL3.markFrameRedraw()
                }
            })
            // 相关歌曲还在路上 ⇒ 同一套 Spinner 加载行（不再是一行灰字 ✓）
            if relatedSearch {
                content.add(pw.loading_row("正在加载相关歌曲…", _float(cardSize.content_w())),
                            {grow: 0, shrink: 0, basis: 40, align: 3})
            } else {
                content.add(rt, {grow: 0, shrink: 0, basis: rh, align: 3})
            }
            return
        }

        // ==================== 下载列表（curNav = -2）====================
        if curNav == -2 {
            if dlJobs.len() == 0 {
                content.add(ui.lbl("还没有下载任务 · 在搜索结果里右击「下载」", 11.5, C_TXT_DIM, false),
                            {grow: 0, shrink: 0, basis: 30, align: 3})
                return
            }
            float dw = _float(cardSize.content_w())
            Array[Array[string]] rows = []
            Array[HBox] rowV = []
            RowHooks hk = new RowHooks()
            hk.isLiked = func(Song sg2): bool { return is_liked(ui.like_key(sg2)) }
            hk.onLike = func(Song sg2) { toggle_song_like(sg2) }
            hk.onTrack = func(Song sg2, Button b) { track_row_like(sg2, b) }     // ♥ 登记：取消喜欢时就地换图标 ✓
            hk.revealIcon = "menu_open_dir.png"
            hk.revealTip = "打开下载目录"
            hk.onReveal = func(Song sg2) {
                if not dl.open_dir(ui.cacheRoot()) {
                    nowArtist.set_text("打开目录失败：" + ui.cacheRoot())
                    SDL3.markFrameRedraw()
                }
            }
            // 序号列：数字 ↔ 播放钮（与本地音乐页同一套 ✓）
            Array[HBox] numL = []
            Array[Canvas] numI = []
            for 0 : dlJobs.len() - 1 to i {
                int ri0 = i
                Array[Widget] nc = pw.number_cell(i, 58, func() { play_dl_row(ri0) })
                numL.add(nc[0] as HBox)
                numI.add(nc[1] as Canvas)
            }
            for dlJobs to j {
                // 列：序号（控件）/ 歌曲（行控件）/ 格式 / 大小 / 进度 / 状态
                rows.add(["", "", j[5], dl.size_of(j), dl.percent_of(j), dl.state_text(j)])
                Song dsg = new Song()
                dsg.title = j[1]
                dsg.artist = j[2]
                rowV.add(rv.song_row(dsg, 58.0, hk))
            }
            Table t = SDL3.createTable({x: 0, y: 0, w: dw, h: 420.0,   // 高度由布局撑满 ✓
                                        item_h: 58, header_h: 32, font_size: 13,
                                        headers: ["", "歌曲", "格式", "大小", "进度", "状态"],
                                        row_numbers: false,                         // 序号改成普通列（数字/播放钮切换 ✓）
                                        col_ratios: [0.06, 0.46, 0.10, 0.14, 0.12, 0.10],
                                        aligns: [1, 0, 1, 2, 1, 1],
                                        header_aligns: [1, 0, 1, 2, 1, 1],   // 与数据列同对齐 ✓
                                        // 第 4 列（下标 4）= 进度条单元格：值写 "0"~"100" ✓
                                        cell_types: ["", "", "", "", "progress", ""],
                                        sortable: false, zebra: false, resizable: false,
                                        text_color: C_TXT,
                                        bg_color: C_TRANS, header_color: C_TRANS,   // 表头不铺底色（半透明背景上那块浅灰太突兀 ✓）
                                        row_radius: 12, row_pad_x: 10,
                                        sel_color: #E6DCF7CC, hover_color: #EDE7FBD9, solid_sel: false,
                                        sep_color: C_TRANS, border: false,          // 去外框/分隔线 ✓
                                        empty_text: "还没有下载任务"})
            t.set_rows(rows)
            t.set_cell_builder(func(int row, int col, float cw, float ch, bool hovered): Widget? {
                if row < 0 or row >= rowV.len() { return null }
                if col == 0 {
                    Widget? nw = null
                    if hovered { nw = numI[row] } else { nw = numL[row] }
                    return nw
                }
                if col == 1 { return rowV[row] }
                return null
            })
            t.set_cell_interactive(true)
             // 已完成的行双击 ⇒ 播本地文件（不联网 ✓）
            t.on_dbl_click(func(int row, int col) { play_dl_row(row) })
            show_table_page("下载列表",
                            (if dl.pending(dlJobs) > 0 then "排队 " + _str(dl.pending(dlJobs)) + " 个 · "
                             else "") + "共 " + _str(dlJobs.len()) + " 个任务",
                            t)
            return
        }

        // ==================== 本地音乐：**列表**====================
        //   为什么不再用卡片：本地曲库是"我的文件"，用户要看名字/歌手/来源，
        //   卡片一屏只放得下几首；列表 + 每行封面缩略图更合适 ✓
        if curNav == 3 {
            var lsongs = dl.scan(ui.cacheRoot())
            localCache = lsongs          // ★ 记住这次顺序：点击/右击都按它取行 ✓
            if lsongs.len() == 0 {
                content.add(ui.lbl("还没有下载 · 搜索结果里右击「下载」", 11.5, C_TXT_DIM, false),
                            {grow: 0, shrink: 0, basis: 30, align: 3})
                return
            }
            int lh = 58                    // 行高：40 的封面 + 上下留白（对齐主流列表的密度 ✓）
            float lw = _float(cardSize.content_w())
            // 每行一个**行控件**：封面 + 歌名/歌手两行 + ♥/⬇
            //   Table 只负责摆位置、滚动、右键菜单、行 hover 底色；行内长什么样由这里决定 ✓
            Array[HBox] rowV = []
            Array[Array[string]] lrows = []
            // 行的动作注入（模块不认识 Player，全部从这里接上 ✓）
            RowHooks hk = new RowHooks()
            hk.isLiked = func(Song sg2): bool { return is_liked(ui.like_key(sg2)) }
            hk.onLike = func(Song sg2) { toggle_song_like(sg2) }
            hk.onTrack = func(Song sg2, Button b) { track_row_like(sg2, b) }     // ♥ 登记：取消喜欢时就地换图标 ✓
            hk.onReveal = func(Song sg2) {
                if not dl.reveal(sg2.path) {
                    nowArtist.set_text("定位失败：" + sg2.path)
                    SDL3.markFrameRedraw()
                }
            }
            // 序号列（第 0 列）用**两个控件切换**：平时是数字，鼠标停在这行就换成播放图
            //   （Table 不内建"序号变按钮"，它就是普通一列 + cell_builder ✓）
            Array[HBox] numL = []
            Array[Canvas] numI = []
            for 0 : lsongs.len() - 1 to i {
                Song si = lsongs[i]
                // 序号列：数字 ↔ 播放钮（工厂在 `page_widgets` ✓）
                //   ⚠ 数字必须包一层居中容器：`cell_builder` 返回的控件直接用列 `aligns` 不生效 ✗
                Array[Widget] nc = pw.number_cell(i, lh, func() { play_song(si) })
                numL.add(nc[0] as HBox)
                numI.add(nc[1] as Canvas)
            }
            for lsongs to it {
                rowV.add(rv.song_row(it, _float(lh), hk))
                // 第 0 列（序号）交给控件，第 1 列交给行控件，后面是时长 / 来源
                lrows.add(["", "", it.dur, "本地"])
            }
            Table lt = SDL3.createTable({x: 0, y: 0, w: lw, h: 420.0,   // 高度由布局撑满 ✓
                                         item_h: lh, header_h: 32, font_size: 13,
                                         headers: ["", "歌曲", "时长", "来源"],
                                         row_numbers: false,                             // 序号改成普通列（见上面的 numL/numI）
                                         ctx_image_size: 16.0, ctx_item_h: 28.0, ctx_font_size: 12.5,          // 菜单字号与正文一致
                                         col_ratios: [0.07, 0.66, 0.12, 0.14],
                                         aligns: [1, 0, 1, 1], header_aligns: [1, 0, 1, 1],
                                         sortable: false, zebra: false, resizable: false,
                                         text_color: C_TXT,
                                         bg_color: C_TRANS, header_color: C_TRANS,   // 表头不铺底色（半透明背景上那块浅灰太突兀 ✓）
                                         // 行块：圆角 + 左右内缩（列表卡片观感）；悬停用浅色实底 ✓
                                         row_radius: 12, row_pad_x: 10,
                                         // 悬停底色用**淡紫**（压在插画上比纯白自然 ✓）
                                         sel_color: #E6DCF7CC, hover_color: #EDE7FBD9, solid_sel: false,
                                         sep_color: C_TRANS, border: false,          // 去外框/分隔线 ✓
                                         empty_text: "还没有下载"})
            lt.set_rows(lrows)
            // 单元格交给控件；`cell_interactive` 让序号图/♥/⬇ 能点（双击播放、右键菜单照旧 ✓）
            lt.set_cell_builder(func(int row, int col, float cw, float ch, bool hovered): Widget? {
                if row < 0 or row >= rowV.len() { return null }
                if col == 0 {
                    // hovered 由框架传进来（闭包里读 lt.hoverRow 拿到的是副本 ✗）
                    // 两个分支是不同 struct ⇒ 必须落到共同接口 Widget? ✓
                    Widget? nw = null
                    // 正在播的这一行 ⇒ 跳动音柱（优先于 hover 的播放钮 ✓）
                    if row < localCache.len() and is_now_playing(localCache[row]) { nw = beatCv }
                    else if hovered { nw = numI[row] }
                    else { nw = numL[row] }
                    return nw
                }
                if col == 1 { return rowV[row] }
                return null
            })
            lt.set_cell_interactive(true)
            // ---- 悬停整行提示：格式 / 大小 / 修改时间 / 完整路径 ----
            //   列表只有「歌名/歌手/来源」三列，文件本身的信息（多大、什么格式、放哪）看不到 ⇒
            //   用 Table 的**行级 tip**（set_row_tip，多行用 \n，气泡按行渲染 ✓）
            for 0 : lsongs.len() - 1 to i {
                Song s = lsongs[i]
                string ext = dirs.extname(s.path).to_lower()       // ".mp3"
                string fmt = if ext.len() > 1 then strings.to_upper(ext.slice(1, ext.len())) else "未知"
                var inf = dirs.stat(s.path)                        // DirInfo{exists,size,is_file,is_dir,mtime}
                string tip = s.title + "\n"
                          + "歌手：" + s.artist + "\n"
                          + "格式：" + fmt + " · 大小：" + dl.fmt_size(inf.size)
                          + "（" + _str(inf.size) + " 字节）\n"
                if inf.mtime > 0 {
                    tip = tip + "修改：" + times.format(inf.mtime, "%Y-%m-%d %H:%M") + "\n"
                }
                tip = tip + "路径：" + s.path
                lt.set_row_tip(i, tip)
            }
            lt.on_dbl_click(func(int row, int col) { play_local_row(row) })
            // ---- 右击菜单----
            lt.set_context_builder(func(int row): Array[Dict] {
                // row < 0 = 右击**空白处**（行下面那片区域）⇒ 只给整页级动作，别弹"播放/删除这一行"的假动作
                //   口径照 文件管理器 onContextWillOpen：空白处给新建/刷新那种页面动作 ✓
                if row < 0 {
                    return [ui.mi("打开音乐目录", "dir", "menu_open_dir.png"),
                            ui.mi("全部删除…", "delall", "menu_delete_all.png")]
                }
                return [ui.mi("播放", "play", "menu_play.png"),
                        ui.mi("打开所在目录", "dir", "menu_open_dir.png"),
                        ui.mi("在资源管理器中选中", "reveal", "menu_reveal.png"),
                        ui.mi("删除本地文件", "del", "menu_delete.png"),
                        ui.mi("全部删除…", "delall", "menu_delete_all.png")]
            })
            lt.on_context_select(func(int row, string id) {
                string dirNow = dl.dir_of(ui.cacheRoot())
                if id == "dir" {
                    if not dl.open_dir(dirNow) { nowArtist.set_text("打开目录失败：" + dirNow); SDL3.markFrameRedraw() }
                    return
                }
                if id == "delall" {
                    SDL3.msgBox("全部删除",
                        ["会删掉「cache\\downloads」里的音频与封面（当前 " + _str(localCache.len()) + " 首）",
                         "文件会进回收站，可以从那里恢复。"],
                        "全部删除", "取消", true, func() {
                            int n = dl.delete_all(ui.cacheRoot())
                            nowArtist.set_text("已删除 " + _str(n) + " 个文件")
                            rebuild_content()
                        })
                    return
                }
                // ⚠ 用本地缓存（与表格同一份顺序），不要重新 scan ✓
                if row < 0 or row >= localCache.len() { return }
                Song one = localCache[row]
                if id == "play" {
                    play_song(one)
                } else if id == "reveal" {
                    if not dl.reveal(one.path) { nowArtist.set_text("定位失败：" + one.path); SDL3.markFrameRedraw() }
                } else if id == "del" {
                    string nm = one.title
                    if dl.delete_one(one) {
                        nowArtist.set_text("已删除：" + nm)
                        rebuild_content()
                    } else {
                        nowArtist.set_text("删除失败（文件可能已被占用）：" + nm)
                        SDL3.markFrameRedraw()
                    }
                }
            })
            show_table_page("本地音乐", "已下载 · " + _str(lsongs.len()) + " 首（cache\\downloads）", lt)
            return
        }

        // ==================== 排行榜（curNav = 4）====================
        //   两种形态：
        //     ① 卡片墙：6 个常用榜，各显示前 3 首（一次线程拉完）
        //     ② 点卡片进某榜 → 完整列表（复用"序号列 + 行控件"的表格）
        if curNav == 4 {
            // ★ 本页**不走 sv**：sv 的内容高是"自然高"，放里面的表格 grow 也撑不满 ⇒
            //   改用独立 page 容器（同 show_table_page）✓
            // 整页构建在 `lib/pages/rank.leno`（拆分第四步 ✓）
            trackCards = false
            pageRebuildOnLike = false
            drop_last_page()
            mainCol.clear()
            sv.set_visible(false)
            mainCol.add(topBar, {grow: 0, shrink: 0, basis: TOP_H, align: 3})
            VBox page = page_rank.build_page(rank_ctx())
            mainCol.add(page, {grow: 1, shrink: 1, align: 3})
            lastPage = page
            hasLastPage = true
            SDL3.markFrameRedraw()
            return
        }
        // ==================== 发现（curNav = 5）====================
        //   参考「发现好音乐」：Tab（精选 / 新歌速递 / 热门歌手）
        //   精选 = 推荐歌单卡片墙（kuwo_playlist.recommend → workers.playlists）
        if curNav == 5 {
            // 整页构建在 `lib/pages/discover.leno`（拆分第三步 ✓）
            trackCards = false
            pageRebuildOnLike = false
            drop_last_page()
            mainCol.clear()
            sv.set_visible(false)
            mainCol.add(topBar, {grow: 0, shrink: 0, basis: TOP_H, align: 3})
            VBox page = page_disc.build_page(disc_ctx())
            mainCol.add(page, {grow: 1, shrink: 1, align: 3})
            lastPage = page
            hasLastPage = true
            SDL3.markFrameRedraw()
            return
        }

        // ==================== 歌单详情（curNav = 6）====================
        //   头部（封面 + 名称 + 曲目数）+ 歌曲表格（复用"序号列 + 行控件"）
        if curNav == 6 {
            trackCards = false
            pageRebuildOnLike = false
            drop_last_page()
            mainCol.clear()
            sv.set_visible(false)
            mainCol.add(topBar, {grow: 0, shrink: 0, basis: TOP_H, align: 3})
            // 整页构建在 `lib/pages/discover.leno` 的 `build_playlist_page()`（拆分第三步 ✓）
            VBox page = page_disc.build_playlist_page(pl_ctx())
            mainCol.add(page, {grow: 1, shrink: 1, align: 3})
            lastPage = page
            hasLastPage = true
            SDL3.markFrameRedraw()
            return
        }
        // 首页：**只有真实数据**（继续收听 / 为你推荐 / 最近添加），没有就留空 ✓
        //   演示数据全部撤掉
        if curNav == 0 and query == "" {
            // 整页构建搬到 `lib/pages/home.leno`（拆分第二步 ✓）：这里只打包状态、交给它铺
            page_home.build(content, home_ctx())
            return
        }
        var songs = page_songs(curNav)
        if songs.len() == 0 {
            content.add(ui.lbl("这里还没有歌曲", 11.5, C_TXT_DIM, false),
                        {grow: 0, shrink: 0, basis: 30, align: 3})
            return
        }
        var one = new Shelf()
        one.title = if query != "" then "搜索结果" else page_name(curNav)
        one.sub = "共 " + _str(songs.len()) + " 首"
        one.items = songs
        page_home.shelf(content, one, false, 0, home_ctx())   // 分区布局在 page_home（同一套 ✓）
    }

    // 当前导航页的名字（前 4 个是主导航，之后是歌单 ✓）
    pri func page_name(int idx): string {
        if idx == -1 { return "搜索结果" }
        if idx == -2 { return "下载列表" }      // 见 open_downloads ✓
        if idx == -3 { return "歌手" }          // 点卡片上的歌手名进来（见 open_artist ✓）
        if idx == -4 { return "歌曲" }          // 点卡片上的歌名进来（见 open_song ✓）
        var m = data.navMain()
        if idx >= 0 and idx < m.len() { return m[idx].name }
        var p = data.navPlaylists()
        int k = idx - m.len()
        if k >= 0 and k < p.len() { return p[k].name }
        return "首页"
    }

    // 全部歌曲：**只用真实数据**（搜索结果优先，其次最近播放 / 推荐 / 新歌）✓
    pri func all_songs(): Array[Song] {
        if netSongs.len() > 0 { return netSongs }
        Array[Song] out = []
        for recentSongs to s { out.add(s) }
        for recSongs to s { out.add(s) }
        for newSongs to s { out.add(s) }
        return out
    }

    // ==================== 酷我音乐搜索（工作线程 + 通道回信）====================
    //   照 LenoMusic：网络在**工作线程**里跑，UI 只在这一拍 `try_receive()` 排空 ⇒ 搜索时界面不冻 ✓
    //   （原来在 UI 线程同步 `client.get()`：一次几秒，表现的就是"卡死" ✗）
    pri func on_kuwo_search() {
        string kw = strings.trim(search.get_text())
        if kw == "" { return }
        if searching { return }                 // 一次只跑一个，重复回车不排队 ✓
        searching = true
        lastKw = kw
        netMsg = "正在搜索「" + kw + "」…"
        rebuild_content()                       // 立刻出现「正在搜索…」（无旧结果时 ✓）
        SDL3.markFrameRedraw()
        threads.start(workers.search, kw, 40, searchCh)
    }

    // 收工作线程的结果（tick 里调；非阻塞 ✓）
    pri func apply_search_result(Array[Array[string]] msg) {
        searching = false
        // 这次回信是不是"歌曲页补相关歌曲"发起的（先在开头取走并复位，任何分支都不会残留 ✓）
        bool wasRelated = relatedSearch
        relatedSearch = false
        if msg.len() == 0 { netMsg = "搜索失败（工作线程没有回信）"; SDL3.markFrameRedraw(); return }
        string kind = if msg[0].len() > 0 then msg[0][0] else "ERR"
        string err = if msg[0].len() > 1 then msg[0][1] else ""
        Array[Song] got = []
        Array[string] ids = []
        Array[Array[string]] trows = []
        for 1 : msg.len() - 1 to k {
            Array[string] r = msg[k]
            if r.len() < 7 { continue }
            Song sg = new Song()
            sg.title = r[0]
            sg.artist = r[1]
            // ★ 2026-10-26 修：`sg.sid` 原来**没赋值**（只进了 netIds 数组）⇒ 搜索结果里的歌
            //   sid 全是 ""，相关歌曲按 sid 去重时会当成同一首、只剩 1 条（看着像"只有 14 首"✗）
            sg.sid = r[6]
            sg.dur = kuwo.formatduration(_int(r[3]))
            // 内置封面（酷我搜索不带图）—— ⚠ 必须带 .png，`ui.img()` 只拼目录不补扩展名 ✗
            int n = 1 + (got.len() % 16)
            if n < 10 { sg.cover = "cover0" + _str(n) + ".png" } else { sg.cover = "cover" + _str(n) + ".png" }
            // 封面缓存里已经有这张 ⇒ 直接挂真图（搜索页/歌曲页都不必再等线程 ✓）
            if r[6] != "" {
                string cf = dirs.join(ui.coverCacheDir(), r[6] + ".jpg")
                if files.exists(cf) { sg.cover = cf }
            }
            sg.tag = if r[4].to_lower() == "flac" then "无损" else ""
            // 音质标签的数据源：`ext` 优先（flac/ape/wav 直接判无损）；
            //   体积用来兜底算码率（接口只给 "52.83 MB" 这种文本 ⇒ 自己换字节 ✓）
            sg.ext = r[4].to_lower()
            if r[5] != "" {
                sg.sizeBytes = _int(_float(r[5].replace(" MB", "")) * 1048576.0)
            }
            got.add(sg)
            ids.add(r[6])
            // 第 0 列 = 序号（控件切换）／第 1 列 = 行控件（封面+歌名/歌手+♥/⬇）⇒ 都留空串占位 ✓
            trows.add(["", "", r[2], kuwo.formatduration(_int(r[3])),
                       (if r[5] == "" then "-" else r[5])])
        }
        if kind == "OK" and got.len() > 0 {
            netSongs = got
            netRows = trows
            netIds = ids
            // ★ 歌曲页的"补相关歌曲"搜索：只更新数据，**保持当前页**（不改标题/不高亮搜索入口）
            if wasRelated {
                rebuild_content()
                SDL3.markFrameRedraw()
                return
            }
            netMsg = "酷我「" + lastKw + "」· " + _str(got.len()) + " 首（双击行播放）"
            // 留快照：切页后点左侧「搜索结果」能回到这张表 ✓
            lastSongs = got
            lastRows = trows
            lastIds = ids
            lastKwSaved = lastKw
            hasLastSearch = true
            {
                searchBtn.set_text("搜索结果 (" + _str(got.len()) + ")")
                searchBtn.set_text_color(C_ACCENT)
            }
            query = ""
            curNav = 0
            for 0 : navBtns.len() - 1 to i { style_nav(navBtns[i], i == 0) }
            for 0 : plBtns.len() - 1 to i {
                plBtns[i].set_text_color(C_TXT_MID)
                plBtns[i].set_bg_color(C_TRANS)
            }
            rebuild_content()                    // 内容区按 netSongs 重建 ⇒ 变成结果表 ✓
        } else if kind == "ERR" and err != "" {
            netMsg = "酷我搜索失败（" + err + "），下面仍是演示数据"
            rebuild_content()
        } else {
            netMsg = "酷我里没有「" + lastKw + "」的结果，下面仍是演示数据"
            rebuild_content()
        }
        SDL3.markFrameRedraw()
    }

    // 表格里点一行 ⇒ 播放那首
    //   ⚠ 表格**排序后**显示行 ≠ 数据行（点表头就重排）⇒ 必须过 `source_row` 映射，
    //     直接把显示行当 netSongs 下标会"点 A 放 B"（LenoMusic 2026-10-20 踩过同一坑 ✓）
    pri func play_net_row(int row) {
        if row < 0 { return }
        int i = if hasTable then tbSearch.source_row(row) else row
        if i < 0 or i >= netSongs.len() { return }
        play_net_song(i)
    }

    // 下载列表里双击已完成的行 ⇒ 播本地文件
    pri func play_dl_row(int row) {
        if row < 0 or row >= dlJobs.len() { return }
        Array[string] j = dlJobs[row]
        if j.len() < 4 or j[3] != "1" { return }
        string f = dirs.join(dl.dir_of(ui.cacheRoot()), dl.safe_name(j[2] + " - " + j[1]) + ".mp3")
        if not files.exists(f) { return }
        Song sg = new Song()
        sg.title = j[1]
        sg.artist = j[2]
        sg.path = f
        play_song(sg)
    }

    // 本地音乐列表里双击一行 ⇒ 播那个文件（顺序与 dl.scan 一致 ✓）
    // 本地音乐列表里双击一行 ⇒ 播那个文件
    //   ⚠ 必须用**建表时那次**的扫描结果（`localCache`），不能重新 `dl.scan`：
    //     `dirs.listdir` 的顺序不保证稳定，第二次扫出来顺序一变，
    //     行号就指到别的歌上（点「夜曲」放出来是「后来」）
    pri func play_local_row(int row) {
        if row < 0 or row >= localCache.len() { return }
        play_song(localCache[row])
    }

    // 加入下载队列（右击菜单「下载」）
    pri func enqueue_download(int i) {
        if i < 0 or i >= netSongs.len() { return }
        Song sg = netSongs[i]
        if i >= netIds.len() or netIds[i] == "" {
            nowArtist.set_text("演示数据没有音源，下载不了")
            SDL3.markFrameRedraw()
            return
        }
        int n = dl.enqueue(dlJobs, netIds[i], sg.title, sg.artist,
                           if g_preferFmt == "lossless" then "FLAC" else "MP3")
        if n > 0 {
            nowArtist.set_text("已加入下载队列：" + sg.title)
        } else {
            nowArtist.set_text("已在下载列表里：" + sg.title)
        }
        refresh_dl_btn()
        if curNav == -2 { rebuild_content() }
        SDL3.markFrameRedraw()
    }

    // ==================== 真播放（miniaudio / LenoMusic 模块）====================
    //   取直链 → 落到 %TEMP%\leno_music_audio → createSound → play
    //   ⚠ 同步取源（4–5 MB 约 1 秒）：后台线程那版在这台机器上播放几秒后会卡死，
    //     而 LenoMusic 的线程+通道我抄错过两次 ⇒ 先把**播放本身**做对，再谈异步 ✓
    //   ⚠ 单实例：换歌时**先 stop+uninit 旧的**，再建新的（不留两台解码器）
    pri func play_net_song(int i) {
        if i < 0 or i >= netSongs.len() { return }
        Song sg = netSongs[i]
        if i < netIds.len() { sg.sid = netIds[i] }
        play_sid(sg)
    }

    // 按 `Song.sid` 播放 —— 搜索结果 / 为你推荐 / 最近添加 / 继续收听 **统一走这里** ✓
    pri func play_sid(Song sg) {
        // 封面已缓存过 ⇒ 直接挂上（让卡片立刻有真图，不用等线程回信 ✓）
        if sg.sid != "" {
            // 文件名走 cover.cache_name（带尺寸后缀）—— 别在这里另拼一份，否则改了尺寸对不上 ✓
            string cf = dirs.join(ui.coverCacheDir(), cover.cache_name(sg.sid, "120"))
            if files.exists(cf) {
                sg.cover = cf
                for 0 : netSongs.len() - 1 to ni {
                    if netSongs[ni].sid == sg.sid { netSongs[ni].cover = cf }
                }
            }
        }
        push_recent(sg)              // 记进「继续收听」（最近播放倒序 ✓）
        nowTitle.set_text(sg.title)
        nowArtist.set_text(sg.artist)
        coverView.set_image(ui.coverPath(sg.cover))
        pos = 0.0
        durKnown = false
        shownSec = -1
        sync_play_ui()
        if sg.sid == "" {
            nowArtist.set_text(sg.artist + " · 演示数据没有音源（搜一首再点）")
            playing = false
            playBtn.set_image(ui.ico("play.png"))
            SDL3.markFrameRedraw()
            return
        }
        string id = sg.sid
        // 缓存名跟着**试听音质**走：无损落 .flac，其余 .mp3（换档位不会误用旧缓存 ✓）
        string extAq = if g_audioQ == "lossless" then ".flac" else ".mp3"
        string f = dirs.join(ui.audioCacheDir(), id + extAq)
        // 已缓存 ⇒ 直接开声（createSound 是毫秒级，不会卡 ✓）
        if files.exists(f) {
            play_ready(sg, f)
            return
        }
        // 取直链 + 下载试听要 1–3 秒，
        //   原来整段跑在 UI 线程里 ⇒ 窗口直接冻住 ✗
        //   现在交给工作线程（`workers.prepare`），回信到了再开声 ✓
        pendingSong = sg
        playPending = true
        nowArtist.set_text(sg.artist + " · 正在取音源…")
        SDL3.markFrameRedraw()
        threads.start(workers.prepare, id, ui.audioCacheDir(), g_audioQ, playCh)
    }

    // 音源就绪 ⇒ 真正开声（解码失败退 flac；封面仍异步拉 ✓）
    pri func play_ready(Song sg, string f) {
        string id = sg.sid
        bool ok = start_play_file(sg, f)
        if not ok {
            // mp3 打不开（少数歌给的是别的封装 / 截断了）⇒ 退回 **flac** 再试一次
            //   flac miniaudio 一定支持；代价是体积大（可能几十 MB），只在兜底时走 ✓
            nowArtist.set_text(sg.artist + " · mp3 打不开，改用无损再试…")
            SDL3.markFrameRedraw()
            string ff = dirs.join(ui.audioCacheDir(), id + ".flac")
            bool got2 = files.exists(ff)
            if not got2 {
                try {
                    dirs.mkdir_p(ui.audioCacheDir())
                    var c2 = net.createClient()
                    string u2 = kuwo.officialurl(id, "flac")
                    if u2 != "" { got2 = net.download(u2, ff) > 0 }
                    c2.close()
                } catch e {
                    got2 = false
                }
            }
            ok = if got2 then start_play_file(sg, ff) else false
            if not ok {
                nowArtist.set_text(sg.artist + " · 这首取不到可播放的音源")
                playing = false
                playBtn.set_image(ui.ico("play.png"))
                SDL3.markFrameRedraw()
            }
        }
        // 封面：**异步**拉（线程 + 通道），不阻塞界面；
        //   回信在 on_tick 里排空，且只在「还是当前这首」时才贴图（防过期回信贴错歌 ✓）
        nowSid = id
        threads.start(workers.cover_shard, [id], ui.coverCacheDir(), coverCh)
    }

    // 文件到位 ⇒ 开声（照 LenoMusic 的 open_local；成功返回 true）
    //   ★★ 关键：换歌时**只 `stop()` 旧声，绝不在建新的之前 `uninit()`** ——
    //      Music 模块的 `Sound.uninit()` 在**最后一个实例**销毁时会 `ma_engine_uninit()` 关掉引擎，
    //      引擎一关，下一次 `createSound` 要重开音频设备；重开一旦失败，模块把 `_engineFailed`
    //      永久置真 ⇒ **之后每首歌都"打不开音频"**（第一首能播，之后全废）
    //      ⇒ 顺序必须是「先建新的、再 uninit 旧的」，让引擎引用计数在切换过程中始终 ≥ 1 ✓
    pri func start_play_file(Song sg, string f): bool {
        if sndOk { snd.stop() }                  // 只停，不销毁（引擎保活 ✓）
        Sound ns = audio.createSound(f)
        if not ns.isInit() {
            // 打不开多半是下载到的不是音频（错误页/截断）⇒ 删缓存，交给调用方换 flac 再试
            try { files.delete(f) } catch e { print("[music] 删缓存失败：" + _str(e)) }
            return false
        }
        // 再验一道：能 open 但**量不出时长**也不是真音频（mp3128 档实测 duration=0.0）
        float d = ns.getDuration()
        if d <= 0.0 {
            ns.uninit()
            try { files.delete(f) } catch e { print("[music] 删缓存失败：" + _str(e)) }
            return false
        }
        ns.setVolume(g_vol / 100.0)
        ns.setLooping(false)
        ns.play()
        Sound old = snd
        bool hadOld = sndOk
        snd = ns
        sndOk = true
        if hadOld { old.uninit() }               // 新声已就位 ⇒ 再销毁旧的（引擎不断档 ✓）
        playing = true
        durKnown = true
        dur = d
        totTime.set_text(ui.fmtTime(dur))
        // 开声成功 ⇒ 把"正在取音源…"那行换回歌手名（之前一直挂着提示 ✗）
        nowArtist.set_text(sg.artist)
        playBtn.set_image(ui.ico("pause.png"))
        sync_play_ui()
        SDL3.markFrameRedraw()
        return true
    }

    // 某个导航页要显示的歌曲 —— **只用真实数据**，没有就返回空（界面显示空状态）✓
    pri func page_songs(int idx): Array[Song] {
        // 这两个页面走**虚拟网格**（只建可见卡片，几千条也不卡 ✓）⇒ 这里返回全量
        if idx == 1 { return liked_songs() }                // 我喜欢
        if idx == 2 { return recentSongs }                  // 最近播放
        if idx == 3 { return dl.scan(ui.cacheRoot()) }         // 本地音乐 = 已下载
        return []                                           // 歌单：还没有实现来源
    }

    // 大列表页：标题 + 副标题 + **虚拟网格**（只建可见卡片 ⇒ 上千条也不卡 ✓）
    //   与 show_table_page 同构，只是中间换成卡片墙；
    //   卡片怎么画仍归应用（`wide_card`），网格只管"哪些可见、摆哪、回收" ✓
    // showDel：卡片上要不要多一颗「删除」按钮（只有「我喜欢」页给 —— 那里删 = 取消收藏 ✓）
    pri func show_grid_page(string title, string sub, Array[Song] songs, bool showDel) {
        trackCards = false                 // 网格页：卡片会被 vg 回收复用 ⇒ 不登记引用
        pageRebuildOnLike = true           // 收藏变化会改列表成员（少一张/顺序）⇒ 只能重建 ✓
        drop_last_page()
        mainCol.clear()
        sv.set_visible(false)          // 网格页不用 ScrollView（见 show_scroll 的注释 ✓）
        mainCol.add(topBar, {grow: 0, shrink: 0, basis: TOP_H, align: 3})
        // 标题/副标题也直接挂 mainCol（横向留 PAD）—— 交给同一个 VBox 累计 y，
        //   免得外面再套一层 page 时 vg 的坐标算不到（实测会画到标题上 ✗）
        HBox hrow = SDL3.createHBox({x: 0, y: 0, w: 900, h: 36,
                                     pad_x: PAD, pad_y: 0, spacing: 8})
        hrow.add(ui.lbl(title, 25, C_TXT, true), {grow: 0, shrink: 0, align: 1})
        hrow.add(SDL3.createLabel({text: ""}), {grow: 1, shrink: 1, align: 1})
        mainCol.add(hrow, {grow: 0, shrink: 0, basis: 36, align: 3})
        HBox srow = SDL3.createHBox({x: 0, y: 0, w: 900, h: 18,
                                     pad_x: PAD, pad_y: 0, spacing: 8})
        srow.add(ui.lbl(sub, 11, C_TXT_DIM, false), {grow: 0, shrink: 0, align: 1})
        srow.add(SDL3.createLabel({text: ""}), {grow: 1, shrink: 1, align: 1})
        mainCol.add(srow, {grow: 0, shrink: 0, basis: 18, align: 3})
        // ★ 卡宽/卡高/列数跟卡片墙**用同一套**（card_cw / card_h，可用宽同样是 shelf_avail）：
        //   原来写死 item_w 236 ⇒ 1200 宽只排得下 3 列，而首页是 4 列（实测不一致 ✗）
        //   vg 的卡区 = w − pad_x×2，所以 w 要把左右 PAD 加回去，卡片才和首页**同宽同起点** ✓
        int gavail = cardSize.shelf_avail()
        int gridW = gavail + PAD * 2
        int gcw = cardSize.card_cw(gavail)
        int gch = cardSize.h_of(gcw)
        VirtualGrid vg = SDL3.createVirtualGrid({x: 0, y: 0, w: _float(gridW), h: 400.0,
                                                item_w: _float(gcw), item_h: _float(gch),
                                                gap_x: _float(CELL_GAP), gap_y: 8.0,
                                                pad_x: PAD, pad_y: 6,
                                                count: songs.len(),
                                                bar_w: 10.0, scroll_color: #C08FA6D0,
                                                bar_auto_hide: true, bar_hover_color: #A96E86F0})
        vg.set_builder(func(int i): any {
            if i < 0 or i >= songs.len() { return SDL3.createLabel({text: ""}) }
            return cards.wide_card(songs[i], gcw, showDel, cardSize, hooks)
        })
        mainCol.add(vg, {grow: 1, shrink: 1, align: 3})
        lastGrid = vg                 // 记下来，下次换页要 dispose ✓
        hasLastGrid = true
        SDL3.markFrameRedraw()
    }

    // 加载占位：转圈 + 文案（整行居中，上面留一点白，别顶着标题 ✓）
    //   加载期间不能让内容区空着（用户会以为"没数据 / 界面坏了"）
    pri func loading_row(string text) {
        content.add(SDL3.createLabel({text: ""}), {grow: 0, shrink: 0, basis: 24, align: 3})
        HBox row = SDL3.createHBox({x: 0, y: 0, w: _float(cardSize.content_w()), h: 40,
                                    pad_x: 0, pad_y: 0, spacing: 12, justify: 1})
        row.add(SDL3.createSpinner({size: 22, thickness: 2.5, color: C_ACCENT,
                                    track_color: #F6DCE5FF, running: true}),
                {grow: 0, shrink: 0, basis: 22, align: 1})
        row.add(ui.lbl(text, 12.5, C_TXT_MID, false), {grow: 0, shrink: 0, align: 1})
        content.add(row, {grow: 0, shrink: 0, basis: 40, align: 3})
    }

    // 加载行已统一到 `page_widgets.loading_row(text, w)`（宽度由调用方传）✓

    // 一个分区：标题行（+ 右侧胶囊按钮）+ 内容（横卡 / 卡片墙）
    // kind：0 = 不给「换一批」（继续收听 / 单区页）/ 1 = 为你推荐 / 2 = 最近添加
    //   原来两个区共用 `refresh_recommend()` ⇒
    //     点「最近添加」的换一批会连「为你推荐」一起刷 ✗ ⇒ 按区分别刷新 ✓
    // 打包排行榜要的状态 + 回调 ✓
    pri func rank_ctx(): RankCtx {
        var c = new RankCtx()
        c.contentW = cardSize.content_w()
        c.pad = PAD
        c.detail = bangDetail
        c.loading = bangLoading
        c.cardsLoading = bangCardsLoading
        Array[Array[string]] menus0 = kuwo.bangmenu()
        c.title = if bangIdx >= 0 and bangIdx < menus0.len() then menus0[bangIdx][1] else "榜单"
        c.songs = bangSongs
        c.rows = bangRows
        c.cards = bangCards
        c.onOpenRank = func(int i2) { open_rank(i2) }
        c.onPlayItem = func(string sid, string disp) { play_rank_item(sid, disp) }
        c.onPlay = func(Song sg) { play_song(sg) }
        c.isLiked = func(Song sg): bool { return is_liked(ui.like_key(sg)) }
        c.onLike = func(Song sg) { toggle_song_like(sg) }
        c.onTrack = func(Song sg, Button b) { track_row_like(sg, b) }
        c.onReveal = func(Song sg) { queue_song(sg) }
        // 封面按钮登记（`apply_bang_cards` 贴图时按 sid 找它们 ✓）
        c.onTrackCover = func(Button b, string sid) {
            rankCovers.add(b)
            rankCoverSids.add(sid)
        }
        // 正在播的行显示跳动音柱（与本地音乐 / 搜索同一套 ✓）
        c.beat = [beatCv]
        c.isNow = func(Song sg): bool { return is_now_playing(sg) }
        return c
    }

    // 打包发现页要的状态 + 回调（页面模块不碰 Player 字段 ✓）
    pri func disc_ctx(): DiscoverCtx {
        var c = new DiscoverCtx()
        c.cardSize = cardSize
        c.hooks = hooks
        c.pad = PAD
        c.tab = discTab
        c.cards = plCards
        c.loading = plLoading
        c.newSongs = newSongs
        c.newLoading = homeLoading
        c.onOpenPlaylist = func(string id, string nm, string cp) { open_playlist(id, nm, cp) }
        c.onTab = func(int ti) { discTab = ti }
        c.onNotice = func(string t) {
            nowArtist.set_text(t)
            SDL3.markFrameRedraw()
        }
        return c
    }

    // 打包歌单详情要的状态 + 回调 ✓
    pri func pl_ctx(): PlaylistCtx {
        var c = new PlaylistCtx()
        c.cardSize = cardSize
        c.pad = PAD
        c.title = plTitle
        c.cover = plCover
        c.loading = plSongsLoading
        c.songs = plSongs
        c.rows = plSongsRows
        c.onPlay = func(Song sg) { play_song(sg) }
        c.onPlayAll = func() { if c.songs.len() > 0 { play_song(c.songs[0]) } }
        c.isLiked = func(Song sg): bool { return is_liked(ui.like_key(sg)) }
        c.onLike = func(Song sg) { toggle_song_like(sg) }
        c.onTrack = func(Song sg, Button b) { track_row_like(sg, b) }
        c.onReveal = func(Song sg) { queue_song(sg) }
        // 正在播的行显示跳动音柱（与本地音乐 / 搜索同一套 ✓）
        c.beat = [beatCv]
        c.isNow = func(Song sg): bool { return is_now_playing(sg) }
        return c
    }

    // 打包首页要的状态 + 回调（页面模块不碰 Player 字段 ⇒ 全部从参数进 ✓）
    pri func home_ctx(): HomeCtx {
        var c = new HomeCtx()
        c.cardSize = cardSize
        c.hooks = hooks
        c.cellGap = CELL_GAP
        c.filter = query
        c.recent = recentSongs
        c.rec = recSongs
        c.nw = newSongs
        c.loading = homeLoading
        c.maxRecent = cardSize.cols()
        c.onRefresh = func(int kind) { refresh_section(kind) }
        return c
    }

    // `add_shelf` 已搬到 `lib/pages/home.leno` 的 `shelf()`（拆分第二步 ✓）
    //   调用处：首页 → `page_home.build()`；其它列表页 → `page_home.shelf()`

    // 搜索过滤（关键词空 = 全通过 ✓）
    pri func match_items(Array[Song] src): Array[Song] {
        if query == "" { return src }
        Array[Song] out = []
        for 0 : src.len() - 1 to i {
            if strings.has(src[i].title, query) or strings.has(src[i].artist, query) {
                out.add(src[i])
            }
        }
        return out
    }

    // 竖版卡片：方图 + 歌名 + 歌手（参考图那一列列的小卡 ✓ 无卡片底色，只有图 + 字）

    // ==================== 设置（线程数 / 缓存目录 / 优先格式）====================
    //   数据在 lib/settings.leno（%APPDATA%\Aria\settings.json），
    //   界面在 lib/settings_win.leno（独立对话框窗口），这里只做"落到全局 + 重扫"✓
    // 退出前落盘：音量 / 静音 / 播放队列 / 当前曲目 / 播放进度
    //   ⚠ 必须先 `load()` 再改字段再 `save()`：settings.json 里还有背景图、缓存目录、
    //     线程数等，直接 new 一份去覆盖会把它们全清空 ✗
    pri func save_user_state() {
        cfgset.Settings st = cfgset.load()
        st.vol = cfgset.clamp_vol(_int(g_vol))
        st.muted = muted
        cfgset.save(st)

        var sess = new PlaySession()
        sess.queue = queue
        sess.cur = qIdx
        sess.pos = pos
        session.save(sess, cfgset.store_path())
    }

    pri func apply_settings(cfgset.Settings s) {
        ui.set_cache_override(s.cachedir)   // 缓存目录归 ui_kit 管（cacheRoot 读它）
        g_preferFmt = cfgset.clamp_fmt(s.fmt)
        g_workers = cfgset.clamp_workers(s.workers)
        g_audioQ = cfgset.clamp_aq(s.aq)
        g_recentMax = cfgset.clamp_recent(s.recent)
        g_dlLyric = s.dl_lyric      // 下载时同时存 .lrc
        g_embedTag = s.embed_tag    // 把封面/歌词内嵌进音频文件
        // ★ 音量 / 静音从配置恢复（原来每次启动都回到 68 ✗）
        //   注意：这里只填「值」，滑块控件可能还没建（启动时先 apply_settings、后建 UI）✓
        g_vol = _float(cfgset.clamp_vol(s.vol))
        muted = s.muted
        lastVol = if g_vol > 1.0 then g_vol else 68.0
        if sndOk { snd.setVolume(if muted then 0.0 else g_vol / 100.0) }
        // 背景图 / 蒙版变了 ⇒ 丢掉旧纹理，下一帧按新设置重画 ✓
        bool bgChanged = (g_bgPath != s.bg) or (g_veil != cfgset.clamp_veil(s.veil))
        g_bgPath = s.bg
        g_veil = cfgset.clamp_veil(s.veil)
        if bgChanged {
            bgTried = false
            if bgTex != null { SDL3.destroyTexture(bgTex); bgTex = null }
            SDL3.markFrameRedraw()
        }
    }

    // ==================== 导航历史（前进 / 后退）====================
    //   只记"点进去的页面"：0 首页 / -3 歌手页 / -4 歌曲页；侧栏导航不记 ⇒ 栈干净 ✓
    pri func nav_push(int nav, string arg) {
        Array[int] nv = []
        Array[string] ag = []
        for 0 : histPos to i {
            nv.add(histNav[i])
            ag.add(histArg[i])
        }
        nv.add(nav)
        ag.add(arg)
        histNav = nv
        histArg = ag
        histPos = nv.len() - 1
    }

    pri func nav_update_btns() {
        // ← 除了"历史栈还能退"，**排行榜详情页也能退**（退到卡片墙，见 nav_back 开头）
        //   不加这一条的话：从侧栏直接进排行榜（set_nav 不入栈）⇒ histPos=0 ⇒ 按钮灰着点不动 ✗
        backBtn.set_enabled(histPos > 0 or (curNav == 4 and bangDetail) or curNav == 6)
        fwdBtn.set_enabled(histPos >= 0 and histPos < histNav.len() - 1)
        SDL3.markFrameRedraw()
    }

    pri func nav_back() {
        // 歌单详情页：顶栏 ← 先回发现页（与排行榜详情同一套处理 ✓）
        if curNav == 6 {
            curNav = 5
            rebuild_content()
            nav_update_btns()
            return
        }
        // 排行榜详情页：顶栏的 ← 先退回**卡片墙**（它只是页内的一层，不该占历史栈 ✓）
        if curNav == 4 and bangDetail {
            bangDetail = false
            rebuild_content()
            nav_update_btns()          // 回到卡片墙后 ← 该变灰（没东西可退了 ✓）
            return
        }
        if histPos <= 0 { return }
        histPos = histPos - 1
        nav_apply(histNav[histPos], histArg[histPos])
    }

    pri func nav_fwd() {
        if histPos < 0 or histPos >= histNav.len() - 1 { return }
        histPos = histPos + 1
        nav_apply(histNav[histPos], histArg[histPos])
    }

    pri func nav_apply(int nav, string arg) {
        curArg = arg                    // 记住当前页的参数（进歌词页时要把"来源页"压进栈 ✓）
        if nav == -3 {
            artistArg = arg
            curNav = -3
            netMsg = "歌手：" + arg + " · 正在搜索…"
            searching = true
            rebuild_content()
            sv.set_scroll(0.0, 0.0)
            threads.start(workers.search, arg, 30, searchCh)
        } else if nav == -6 {
            // 歌词页：进页面就取歌词（同一首不重复取，见 request_lyric ✓）
            curNav = -6
            rebuild_content()
            sv.set_scroll(0.0, 0.0)
            request_lyric()
        } else if nav == -4 {
            songArg = arg
            curNav = -4
            rebuild_content()
            sv.set_scroll(0.0, 0.0)
            // 相关歌曲：**按歌名搜**（同曲的其他版本/翻唱/同专辑），不是按歌手 ✗
            //   之前传的是 `one.artist` ⇒ 搜出来全是同一歌手的歌，
            //     看着像"点歌曲却进了歌手搜索"；改成歌名 + 30 条 ✓
            Song one = find_song(arg)
            string kwRel = one.title
            if kwRel != "" {
                relatedSearch = true          // 回信后只刷相关歌曲表，**不切页** ✓
                threads.start(workers.search, kwRel, 30, searchCh)
            }
        } else {
            songArg = ""
            set_nav(if nav < 0 then 0 else nav)
        }
        // 排行榜：第一次进页面就拉当前榜（之后靠下拉 / 刷新按钮 ✓）
        if nav == 4 { enter_rank() }
        nav_update_btns()
    }

    // 点卡片上的**歌名** ⇒ 歌曲页；点**歌手** ⇒ 歌手页（两者都进历史 ✓）
    pri func open_song(Song sg) {
        if sg.sid == "" and sg.path == "" { return }
        nav_push(-4, if sg.sid != "" then sg.sid else sg.path)
        nav_apply(-4, if sg.sid != "" then sg.sid else sg.path)
    }

    pri func open_artist(string name) {
        if name == "" { return }
        nav_push(-3, name)
        nav_apply(-3, name)
    }

    // 是不是同一个歌手：相等或**包含**（合唱写法「A/B」「A、B」都算 ✓）
    pri func same_artist(Song s, string name): bool {
        if name == "" or s.artist == "" { return false }
        if s.artist == name { return true }
        // `strings` 没有 contains ⇒ 用 split 切一下，切出 2 段以上就是包含 ✓
        var parts = strings.split(s.artist, name)
        return parts.len() > 1
    }

    // 按 sid / 本地路径找回 Song（歌曲页要用）
    //   ⚠ 查找顺序很重要：**先找"带真封面"的那几个列表**（最近播放 / 推荐 / 新歌），
    //     最后才查 netSongs —— 搜索结果是占位封面，先命中它就会把真封面覆盖成紫色占位图 ✗
    pri func find_song(string key): Song {
        for recentSongs to s { if s.sid == key or s.path == key { return s } }
        for recSongs to s { if s.sid == key or s.path == key { return s } }
        for newSongs to s { if s.sid == key or s.path == key { return s } }
        for netSongs to s { if s.sid == key or s.path == key { return s } }
        Song empty = new Song()
        return empty
    }

    // 相关歌曲（歌曲页底部表格）
    //   应以**这首歌的搜索结果**为主（同曲其他版本/翻唱/同专辑），
    //     不再只挑"同歌手"——否则看起来就像点歌曲却只看到歌手列表 ✗
    //   · 优先：netSongs（歌曲页那次按**歌名**搜到的 30 条），排除自己
    //   · 兜底：还没搜回来时，用本地已有的同歌手歌凑数（避免空白）
    pri func related_songs(Song cur): Array[Song] {
        Array[Song] out = []
        for netSongs to s {
            if s.sid != cur.sid and not ui.has_sid(out, s.sid) { out.add(s) }
        }
        if out.len() == 0 {
            for recSongs to s {
                if same_artist(s, cur.artist) and s.sid != cur.sid and not ui.has_sid(out, s.sid) { out.add(s) }
            }
            for newSongs to s {
                if same_artist(s, cur.artist) and s.sid != cur.sid and not ui.has_sid(out, s.sid) { out.add(s) }
            }
            for recentSongs to s {
                if same_artist(s, cur.artist) and s.sid != cur.sid and not ui.has_sid(out, s.sid) { out.add(s) }
            }
        }
        // 上限 30 首：歌曲页表格内部会滚动 ✓
        if out.len() > 30 {
            Array[Song] top = []
            for 0 : 29 to i { top.add(out[i]) }
            return top
        }
        return out
    }

    // 「换一批」：**只刷新被点的那一个区**
    //   kind 1 = 为你推荐（关键词 4 组轮换）/ 2 = 最近添加
    pri func refresh_section(int kind) {
        // 取多少首也**跟着列数走**:推荐 6 行、新歌 2 行（写死 24/9 时换列数就会留半行 ✗）
        int colsNow = cardSize.cols()
        if kind == 1 {
            Array[string] kws = ["热歌", "新歌榜", "流行", "经典"]
            recBatch = (recBatch + 1) % kws.len()
            homeLoading = true                                   // 只让推荐段显示占位 ✓
            threads.start(workers.section, "REC", kws[recBatch], colsNow * 6, homeCh)
        } else if kind == 2 {
            Array[string] kws2 = ["新歌", "新歌榜", "最新", "首发"]
            newBatch = (newBatch + 1) % kws2.len()
            threads.start(workers.section, "NEW", kws2[newBatch], colsNow * 2, homeCh)
        }
        if curNav == 0 { rebuild_content() }
        SDL3.markFrameRedraw()
    }

    pri func open_settings() {
        string def = dirs.join(dirs.script_dir(), "cache")
        // 页签图标：常规=齿轮、下载=download、外观=pifu（皮肤 ✓ 48×48 源图按 1/3 显示为 16）
        Array[string] icons = [ui.ico("setting.png"), ui.ico("download.png"), ui.ico("pifu.png")]
        cfgwin.show(def, icons, func(cfgset.Settings s) {
            apply_settings(s)
            rebuild_content()          // 缓存目录可能变了 ⇒ 本地音乐/下载列表要重扫 ✓
            SDL3.markFrameRedraw()
        })
    }

    // ==================== 持久化（缓存\library.json：喜欢 + 最近播放）====================
    //   原来只在内存里，重启就没了 ✗
    // 落盘 / 读回都在 lib/library.leno（存成什么形状归它管 ✓）
    pri func save_library() {
        lib.save(ui.cacheRoot(), likedSids, recentSongs)
    }

    pri func load_library() {
        LibraryData ld = lib.load(ui.cacheRoot())
        likedSids = ld.likes
        recentSongs = ld.recent
    }

    // ==================== 喜欢 / 添加（卡片上的两个小按钮）====================
    pri func is_liked(string key): bool {
        return lib.is_liked(likedSids, key)
    }

    // 「我喜欢」页的数据：在线（sid）与本地（path）都能进（按 like_key 去重 ✓）
    pri func liked_songs(): Array[Song] {
        Array[Song] out = []
        for recentSongs to s {
            if is_liked(ui.like_key(s)) { out.add(s) }
        }
        // 本地曲库也扫一遍 —— 否则本地收藏的歌永远不出现 ✓
        for dl.scan(ui.cacheRoot()) to s {
            if is_liked(ui.like_key(s)) and not ui.has_key(out, ui.like_key(s)) { out.add(s) }
        }
        for recSongs to s {
            if is_liked(ui.like_key(s)) and not ui.has_key(out, ui.like_key(s)) { out.add(s) }
        }
        for newSongs to s {
            if is_liked(ui.like_key(s)) and not ui.has_key(out, ui.like_key(s)) { out.add(s) }
        }
        for netSongs to s {
            if is_liked(ui.like_key(s)) and not ui.has_key(out, ui.like_key(s)) { out.add(s) }
        }
        return out
    }

    // 搜索建议回信 ⇒ 取歌名去重填进下拉（最多 8 条，同名的只留一条 ✓）
    pri func apply_suggestions(Array[Array[string]] rows) {
        Array[string] out = []
        for rows to r {
            // ⚠ 回信第一行是状态标记 ["OK",""]（2 项）—— 数据行是 7 项，
            //   不挡掉的话列表里会冒出一条 "OK" ✗
            if r.len() < 7 { continue }
            string t = r[0]
            if t == "" { continue }
            bool dup = false
            for out to o { if o == t { dup = true } }
            if not dup { out.add(t) }
            if out.len() >= 8 { break }
        }
        // 用户可能已经在输入别的词了 ⇒ 下拉内容不符就丢掉，别闪一下又变 ✗
        if sugKw != strings.trim(search.get_text()) { return }
        search.set_suggestions(out)
        SDL3.markFrameRedraw()
    }

    // 点 ♥：加/取消喜欢（在线用 sid、本地用 file:路径 ⇒ 两种情况都能收藏 ✓）
    pri func toggle_song_like(Song sg) {
        string key = ui.like_key(sg)
        if key == "" {
            nowArtist.set_text("这首歌既没有音源 id 也没有本地文件，收不了")
            SDL3.markFrameRedraw()
            return
        }
        bool was = lib.is_liked(likedSids, key)
        likedSids = lib.toggle(likedSids, key)      // 有则删、无则加（集合运算归 lib/library.leno ✓）
        save_library()                   // ★ 立刻落盘（重启后「我喜欢」还在 ✓）
        nowArtist.set_text(if was then "已取消喜欢：" + sg.title else "已喜欢：" + sg.title)
        sync_like_icon()                 // 底栏 ♥ 跟着变（它和卡片共用一份数据 ✓）
        refresh_after_like(sg)
    }

    // 收藏状态变了之后怎么刷新 —— **能不重建就不重建**（整页重建会让「换一批」胶囊闪一下 ✗）
    //   · 卡片页：登记表里同 key 的 ♥ 就地换图标（同一首可能在"继续收听/为你推荐"各出现一次 ✓）
    //   · 网格页（我喜欢/最近播放）：列表成员会变 ⇒ 只能重建
    //   · 表格页 / 歌曲页：没有 ♥ 可刷 ⇒ 只重绘底栏，页面一个字都不动 ✓
    // ==================== 发现页（推荐歌单）====================
    pri func enter_discover() {
        if plCards.len() == 0 and not plLoading {
            plLoading = true
            plAsked = true
            plPage = 1
            threads.start(workers.playlists, plPage, 18, ui.coverCacheDir(), plCh)
        }
    }

    // 滚到底 ⇒ 拉下一页（防重入靠 plLoading；页码自增 ✓）
    //   ⚠ 页数必须封顶：滚动区**不做虚拟化**，每页 18 张卡的控件全都留在内容树里
    //     ⇒ 页数越多内存越线性涨（纹理有 LRU 兜底，控件没有 ✗）
    pri func load_more_playlists() {
        if plLoading { return }
        if plPage >= PL_MAX_PAGE { return }        // 到顶了，不再拉 ✓
        plScrollY = page_disc.scroll_y()          // 记住位置，重建后恢复
        plLoading = true
        plPage = plPage + 1
        threads.start(workers.playlists, plPage, 18, ui.coverCacheDir(), plCh)
    }

    // 回信：每行 [id, 名称, 本地封面, 播放量, 曲目数, 作者]
    pri func apply_playlists(Array[Array[string]] rows) {
        plLoading = false
        if rows.len() == 0 {
            // 第 1 页就空 ⇒ 真没有；后续页空 ⇒ **没有更多了**（页码退回，别清空已有卡片 ✗）
            if plPage <= 1 { plCards = [] } else { plPage = plPage - 1 }
            if curNav == 5 { rebuild_content() }
            return
        }
        if rows[0].len() > 0 and rows[0][0] == "ERR" {
            string why = if rows[0].len() > 1 then rows[0][1] else "?"
            nowArtist.set_text("推荐歌单加载失败：" + why)
            SDL3.markFrameRedraw()
            return
        }
        // 第 1 页：整表替换；第 2 页起：**追加**（加载更多 ✓）
        if plPage <= 1 { plCards = rows }
        else { for rows to r { plCards.add(r) } }
        if curNav == 5 {
            rebuild_content()
            page_disc.restore_scroll(plScrollY)   // 恢复滚动位置（否则跳回顶部 ✗）
            plScrollY = 0.0
        } else {
            SDL3.markFrameRedraw()
        }
    }

    // 点歌单卡片 ⇒ 进歌单详情（curNav = 6）
    pri func open_playlist(string id, string nm, string cp) {
        if id == "" { return }
        plArg = id
        plTitle = nm
        plCover = cp
        plSongsLoading = true
        plSongs = []
        plSongsRows = []
        curNav = 6
        threads.start(workers.playlistsongs, id, 100, plSongsCh)
        rebuild_content()
        sv.set_scroll(0.0, 0.0)
        nav_update_btns()
    }

    // 歌单歌曲回信：[sid, 歌名, 歌手, 专辑, 时长秒]
    pri func apply_playlist_songs(Array[Array[string]] rows) {
        plSongsLoading = false
        if rows.len() == 0 { if curNav == 6 { rebuild_content() }; return }
        if rows[0].len() > 0 and rows[0][0] == "ERR" {
            string why = if rows[0].len() > 1 then rows[0][1] else "?"
            nowArtist.set_text("歌单加载失败：" + why)
            SDL3.markFrameRedraw()
            return
        }
        Array[Song] songs = []
        Array[Array[string]] trs = []
        for rows to r {
            if r.len() < 5 { continue }
            Song sg = new Song()
            sg.sid = r[0]
            sg.title = r[1]
            sg.artist = r[2]
            sg.dur = kuwo.formatduration(_int(r[4]))
            songs.add(sg)
            // 列：序号（控件）/ 歌曲（行控件）/ 专辑 / 时长
            trs.add(["", "", r[3], kuwo.formatduration(_int(r[4]))])
        }
        plSongs = songs
        plSongsRows = trs
        if curNav == 6 { rebuild_content() } else { SDL3.markFrameRedraw() }
    }

    // 歌单卡片 `pl_card` 已搬到 `lib/pages/discover.leno`（拆分第三步 ✓）

    // ==================== 排行榜 ====================
    // 榜名/榜单 id 见 `lib/page_widgets.leno`（拆分第一步已挪走 ✓）

    // 进排行榜页：先亮卡片墙（没数据就起线程拉）
    pri func enter_rank() {
        bangDetail = false
        if bangCards.len() == 0 and not bangCardsLoading {
            bangCardsLoading = true
            threads.start(workers.bangcards, pw.rank_bids(), pw.rank_names(), 4, bangCardsCh)
        }
    }

    // 卡片回信：每行 [bid, 榜名, 歌1, 歌2, …]
    pri func apply_bang_cards(Array[Array[string]] rows) {
         bangCardsLoading = false
        if rows.len() == 0 { bangCards = []; return }
        if rows[0].len() > 0 and rows[0][0] == "ERR" {
            string why = if rows[0].len() > 1 then rows[0][1] else "?"
            nowArtist.set_text("榜单加载失败：" + why)
            SDL3.markFrameRedraw()
            return
        }
        bangCards = rows
        // 顺手把这 6 张榜封面拉下来（走现成的分片 worker，回信就地贴图 ✓）
        Array[string] ids = []
        for rows to r { if r.len() > 2 and r[2] != "" { ids.add(r[2]) } }
        if ids.len() > 0 { threads.start(workers.cover_shard, ids, ui.coverCacheDir(), coverCh) }
        if curNav == 4 { rebuild_content() } else { SDL3.markFrameRedraw() }
    }

    // 榜单卡片里点**歌名** ⇒ 直接播这一首
    //   卡片上只有 sid 与 "歌名 — 歌手" 文本（见 workers.bangcards 的编码），现场拼个 Song ✓
    pri func play_rank_item(string sid, string disp) {
        if sid == "" { return }
        int sep = strings.byte_find(disp, " — ", 0)
        Song sg = new Song()
        sg.sid = sid
        if sep >= 0 {
            sg.title = strings.byte_slice(disp, 0, sep - 1)
            sg.artist = strings.byte_slice(disp, sep + 3, disp.len() - 1)
        } else {
            sg.title = disp
        }
        play_song(sg)
    }

    // 点卡片 ⇒ 进这个榜的完整列表（卡片里的 bid → bangmenu 里的下标）
    pri func open_rank(int cardIdx) {
        if cardIdx < 0 or cardIdx >= bangCards.len() { return }
        string bid = bangCards[cardIdx][0]
        Array[Array[string]] menus = kuwo.bangmenu()
        int hit = 0
        for 0 : menus.len() - 1 to i { if menus[i][0] == bid { hit = i } }
        bangDetail = true
        load_bang(hit)
        sv.set_scroll(0.0, 0.0)          // 进详情从第一首开始看 ✓
        nav_update_btns()                // 进详情后 ← 要变可点（能退回卡片墙 ✓）
    }

    // `rank_cover_path` / `rank_card` 已搬到 `lib/pages/rank.leno`（拆分第四步 ✓）

    // 切榜 / 刷新：起线程去拉（UI 线程只改状态 + 请求重绘 ✓）
    pri func load_bang(int idx) {
        Array[Array[string]] menus = kuwo.bangmenu()
        if idx < 0 or idx >= menus.len() { return }
        bangIdx = idx
        bangLoading = true
        bangSongs = []
        bangRows = []
        threads.start(workers.bang, menus[idx][0], 100, bangCh)
        if curNav == 4 { rebuild_content() } else { SDL3.markFrameRedraw() }
    }

    // 回信：首条是 [bid,""]，之后每首一行（与搜索同构 ✓）
    pri func apply_bang(Array[Array[string]] rows) {
        bangLoading = false
        if rows.len() == 0 { if curNav == 4 { rebuild_content() }; return }
        string kind = rows[0][0]
        if kind == "ERR" {
            string why = if rows[0].len() > 1 then rows[0][1] else "?"
            nowArtist.set_text("排行榜加载失败：" + why)
            SDL3.markFrameRedraw()
            return
        }
        Array[Song] songs = []
        Array[Array[string]] trs = []
        for 1 : rows.len() - 1 to i {
            var r = rows[i]
            if r.len() < 7 { continue }
            Song sg = new Song()
            sg.title = r[0]
            sg.artist = r[1]
            sg.sid = r[6]
            sg.dur = kuwo.formatduration(_int(r[3]))
            songs.add(sg)
            // 列：序号（控件）/ 歌曲（行控件）/ 专辑 / 时长
            trs.add(["", "", r[2], kuwo.formatduration(_int(r[3]))])
        }
        bangSongs = songs
        bangRows = trs
        if curNav == 4 { rebuild_content() } else { SDL3.markFrameRedraw() }
    }

    pri func refresh_after_like(Song sg) {
        string key = ui.like_key(sg)
        bool on = is_liked(key)
        // ① 卡片墙 / 虚拟网格上的 ♥（就地换图，不整页重建 ⇒ 不闪 ✓）
        for cardLikeKeys.len() to i {
            if cardLikeKeys[i] == key {
                cardLikeBtns[i].set_image(ui.ico(if on then "sc1.png" else "sc.png"))
                cardLikeBtns[i].set_tip(if on then "取消喜欢" else "喜欢")
            }
        }
        // ② **列表行**里的 ♥（本地音乐/搜索/下载/相关歌曲）
        //    表格页 pageRebuildOnLike = false ⇒ 原来这里什么都不做，点了 ♥ 图标还是红的 ✗
        for rowLikeKeys.len() to i {
            if rowLikeKeys[i] == key {
                rowLikeBtns[i].set_image(ui.ico(if on then "sc1.png" else "sc.png"))
                rowLikeBtns[i].set_tip(if on then "取消喜欢" else "喜欢")
            }
        }
        if not trackCards and pageRebuildOnLike { rebuild_content() }
        SDL3.markFrameRedraw()
    }

    // 行控件建好后登记 ♥（由 row_view 的 onTrack 回调进来 ✓）
    pri func track_row_like(Song sg, Button b) {
        rowLikeBtns.add(b)
        rowLikeKeys.add(ui.like_key(sg))
    }

    // 封面回信 ⇒ 就地换图（原来靠 coverDirty 整页重建：每来一张封面就闪一次 ✗）
    pri func sync_card_covers(string sid, string path) {
        if sid == "" or path == "" { return }
        bool hit = false
        for cardCoverKeys.len() to i {
            if cardCoverKeys[i] == sid { cardCovers[i].set_image(path); hit = true }
        }
        if hit { SDL3.markFrameRedraw() }
    }

    // 「我喜欢」卡片上的删除钮：**只删不加**（不复用 toggle —— 那页的卡本来就都是喜欢的，
    //   万一状态已经变了，toggle 反而会把它加回去 ✗）
    pri func unlike_song(Song sg) {
        string key = ui.like_key(sg)
        if key == "" { return }
        if not lib.is_liked(likedSids, key) { return }   // 已经不在收藏里 ⇒ 什么都不用做
        likedSids = lib.remove(likedSids, key)
        save_library()                    // ★ 立刻落盘，重启后不会又冒出来 ✓
        nowArtist.set_text("已从「我喜欢」删除：" + sg.title)
        sync_like_icon()                  // 底栏 ♥ 跟着变（若删的就是在播这首 ✓）
        refresh_after_like(sg)            // 网格页会按新列表重建：少一张、副标题数字也减 ✓
    }

    // 点 +：加进下载队列（目前没有歌单系统，先落到"下载"，等于收藏到本地 ✓）
    pri func queue_song(Song sg) {
        if sg.sid == "" { return }
        int n = dl.enqueue(dlJobs, sg.sid, sg.title, sg.artist,
                           if g_preferFmt == "lossless" then "FLAC" else "MP3")
        nowArtist.set_text(if n > 0 then "已加入下载队列：" + sg.title else "已在下载列表里：" + sg.title)
        refresh_dl_btn()
        SDL3.markFrameRedraw()
    }

    // 横卡：封面 | 歌名 / 歌手 / ♥＋⬇
    //   三颗按钮**放到歌手下面**（原来贴右侧，4 列时挤到 20px 看不清 ✗）
    //   竖排三行后按钮单独占一行 ⇒ 图标回到 24px（48 源图的一半），歌名也拿回整列宽 ✓
    //   尺寸一律由卡宽按比例推（card_pad/thumb/btn/gap/h）⇒ 换列数不用改这里 ✓
    // showDel：多一颗「删除」钮（只有「我喜欢」页传 true ✓）

    // ==================== 底部播放条 ====================
    pri func build_bar() {
        // 外层改 VBox
        //   ① 顶部一条**横贯整宽**的细进度条（可点击 seek）
        //   ② 下面三栏：左=封面/歌名(♥ ☰)、中=上一首/播放/下一首、右=时间 + 工具
        VBox barBox = SDL3.createVBox({x: 0, y: 0, w: WIN_W, h: BAR_H, pad_x: 0, pad_y: 0,
                                       spacing: 0, bg_color: C_BAR})
        root.add(barBox, {grow: 0, shrink: 0, basis: BAR_H, align: 3})

        seek = SDL3.createProgressBar({value: 0.0, min: 0.0, max: 100.0, h: 4,
                                      show_text: false, clickable: true,
                                      // 视觉只有 4px，但**命中区**上下各外扩 10px ⇒ 才点得中、悬停得住 ✓
                                      hit_pad_y: 10.0,
                                      fill_color: C_ACCENT, track_color: #E9C6D4FF})
        seek.on_change(func(float v) { on_seek(v) })
        // 悬停提示：显示**光标位置**对应的时间（值 < 0 = 鼠标离开 ⇒ 收掉气泡 ✓）
        //   进度条本体只有静态 tip 文案，这里靠框架的 on_hover 拿到光标处的值 ✓
        seek.on_hover(func(float v, float mx, float my) {
            // 用**带归属者**的 tip（"seek"）：气泡归进度条所有 ⇒ 别处的鼠标移动清不掉它，
            //   它也只用 tipClearEx("seek") 清自己
            //   ⚠ 原来用的是无条件 `SDL3.tipClear()`：鼠标每次移动都会把表格的**行级提示**
            //     （大小/格式/路径）一起清掉 ⇒ 表格 tip 永远弹不出来 ✗✗（2026-10-27 实测）
            if v < 0.0 or dur <= 0.0 { SDL3.tipClearEx("seek"); return }
            SDL3.tipReportEx("seek", ui.fmtTime(dur * v / 100.0), mx, my)
        })
        barBox.add(seek, {grow: 0, shrink: 0, basis: 4, align: 3})

        bar = SDL3.createHBox({x: 0, y: 0, w: WIN_W, h: BAR_H - 4, pad_x: 18, pad_y: 5,
                               spacing: 12, bg_color: C_TRANS})
        barBox.add(bar, {grow: 1, shrink: 1, align: 3})

        // ---- 左：封面 + 「歌名 ♥ ☰」+ 第二行 ----
        HBox left = SDL3.createHBox({x: 0, y: 0, w: 330, h: 50, pad_x: 0, pad_y: 0, spacing: 12})
        // 底色走 `fillRoundedRect`（radius>0）⇒ 圆角；图片现在也会自己裁圆角（见 sdl_imageview ✓）
        // 圆形"唱片"头像：radius = 边长一半 ⇒ 正圆；播放时自转（见 sync_play_ui 的 set_spin ✓）
        //   ⚠ 旋转要靠**圆角合成纹理**转，直接把方图转起来四个角会露出来 ✗
        coverView = SDL3.createImageView({w: 46, h: 46, radius: 23, bg_color: #F3E4EBFF,
                                         tip: "歌词页"})
        // 点头像 = 进歌词页（再点一次（页面里的大封面）退出 ✓）
        coverView.on_click(func() { open_lyrics(true) })
        left.add(coverView, {grow: 0, shrink: 0, basis: 46, align: 1})

        // 
        //   ① 歌名/歌手**显式限宽 + 省略号**（原来没 truncate，只靠 shrink 会画到按钮上 ✗）
        //   ② ♥ / ≡ 从"文字行里"挪到**整行右端** —— 标题区只放文字，按钮永远贴右侧，
        //      两者之间天然有空隙，不会再挤在一起 ✓
        //   文字区宽 = 330 − 封面 46 − 间距 12×3 − 按钮 24×2 = 200（**必须算准**，
        //   算大了整个 left 会溢出、封面和标题被挤出可视区 ✗）
        VBox info = SDL3.createVBox({x: 0, y: 0, w: 200, h: 50, pad_x: 0, pad_y: 2, spacing: 1})
        // 超出就**跑马灯**（truncate: 2 = TRUNCATE_SCROLL；scroll_always 不等悬停 ✓）
        nowTitle = SDL3.createLabel({text: "未在播放", font_size: 13.5, text_color: C_TXT,
                                     max_w: 200.0, truncate: 2, scroll_always: true})
        nowTitle.set_font_style(SDL3.STYLE_BOLD)
        info.add(nowTitle, {grow: 0, shrink: 0, basis: 28, align: 3})
        // 歌手名同理：长名字省略，别冲出去
        nowArtist = SDL3.createLabel({text: "搜一首歌开始听", font_size: 10.5,
                                      text_color: C_TXT_DIM, max_w: 200.0, truncate: 2,
                                      scroll_always: true})
        info.add(nowArtist, {grow: 0, shrink: 0, basis: 18, align: 3})
        left.add(info, {grow: 1, shrink: 1, align: 1})

        // ♥ 用卡片同款心形图标（sc.png 未喜欢 / sc1.png 已喜欢）
        likeBtn = img_btn("sc.png", "我喜欢", 24, 15.0)   // 初值随后由 sync_play_ui → sync_like_icon 校正 ✓
        likeBtn.on_click(func() { toggle_like() })
        left.add(likeBtn, {grow: 0, shrink: 0, basis: 24, align: 1})
        // ☰ = 打开当前这首歌的页面（歌词/相关歌曲都在那儿 ✓ 不说话的空按钮不要）
        // 歌词/歌曲页按钮：原来是用文字 "≡" 画出来的，现在换成图标 lyrics.png
        //   尺寸跟旁边的 ♥ 对齐（都是 24）—— 小了看着不协调
        //   ⚠ 这张源图只有 16×16，放到 24 会有轻微发虚；想要锐利给一张 48×48 的替换即可 ✓
        Button lyBtn = img_btn("lyrics.png", "歌曲页（歌词 / 相关）", 24, 24.0)
        // 歌词按钮 = 进歌词页（跟点头像同一个入口 ✓）
        lyBtn.on_click(func() { open_lyrics(true) })
        left.add(lyBtn, {grow: 0, shrink: 0, basis: 24, align: 1})
        bar.add(left, {grow: 0, shrink: 0, basis: 330, align: 1})

        // ---- 中：只有三个按钮（上一首 / 播放暂停 / 下一首）----
        HBox ctrl = SDL3.createHBox({x: 0, y: 0, w: 260, h: 54, pad_x: 0, pad_y: 0,
                                     spacing: 20, justify: 1})
        ctrl.add(img_btn("prev.png", "上一首", 32, 16.0), {grow: 0, shrink: 0, basis: 32, align: 1})
        playBtn = SDL3.createButton({image_path: ui.ico("play.png"), image_size: 30,
                                     w: 44, h: 44, radius: 22,
                                     bg_color: #FFFFFFD8, hover_color: #FFFFFFFF,
                                     padding: 0.0, border: false, shadow: false,
                                     tip: "播放 / 暂停"})
        playBtn.on_click(func() { toggle_play() })
        ctrl.add(playBtn, {grow: 0, shrink: 0, basis: 44, align: 1})
        ctrl.add(img_btn("next.png", "下一首", 32, 16.0), {grow: 0, shrink: 0, basis: 32, align: 1})
        bar.add(ctrl, {grow: 1, shrink: 1, align: 1})

        // ---- 右：时间 + 循环 + 音量 + 列表 ----
        HBox right = SDL3.createHBox({x: 0, y: 0, w: 330, h: 54, pad_x: 0, pad_y: 0,
                                      spacing: 6, justify: 2})   // 靠右排
        curTime = ui.lbl(ui.fmtTime(pos), 10, C_TXT_DIM, false)
        right.add(curTime, {grow: 0, shrink: 0, basis: 34, align: 1})
        right.add(ui.lbl("/", 10, C_TXT_DIM, false), {grow: 0, shrink: 0, basis: 8, align: 1})
        totTime = ui.lbl(ui.fmtTime(dur), 10, C_TXT_DIM, false)
        right.add(totTime, {grow: 0, shrink: 0, basis: 34, align: 1})
        right.add(SDL3.createLabel({text: ""}), {grow: 0, shrink: 0, basis: 4, align: 1})

        // 循环：单曲 ⇄ 列表

        Button loopBtn = img_btn("loop_all.png", "循环模式", 26, 14.0)
        loopBtn.on_click(func() {
            loopOne = not loopOne
            loopBtn.set_image(if loopOne then ui.ico("loop_one.png") else ui.ico("loop_all.png"))
            SDL3.markFrameRedraw()
        })
        right.add(loopBtn, {grow: 0, shrink: 0, basis: 26, align: 1})
        // 音量图标（yl.png 开 / yl1.png 静音）—— 点一下弹**音量浮窗**（滑条 + 静音 ✓）
        volBtn = img_btn(if muted then "yl1.png" else "yl.png", "音量", 26, 16.0)
        volBtn.on_click(func() { toggle_vol() })
        right.add(volBtn, {grow: 0, shrink: 0, basis: 26, align: 1})
        // 底栏不再放横向滑块（旧实现已删）：音量统一从**浮窗**里调 ✓
        // 播放列表（右下角那个 ≡ 图标）：展开/收起右侧浮层 ✓
        Button queueBtn = img_btn("list.png", "播放列表", 26, 14.0)
        queueBtn.on_click(func() { toggle_queue() })
        right.add(queueBtn, {grow: 0, shrink: 0, basis: 26, align: 1})
        bar.add(right, {grow: 0, shrink: 0, basis: 330, align: 1})

        sync_play_ui()          // 建完立刻按当前状态刷一次（时间/填充/宽度都对齐 ✓）
    }

    // 小圆钮（无底色，悬停有底 ✓）—— 底栏/顶栏那一片共用这一处。
    //   ★ 2026-10-25 晚：矢量图标已从公共库删除，这里**暂时用文字占位**（`«`/`»`/`随`/`音`…）。
    //     以后换成 PNG 图标时，把 `text`/`text_color` 换回 `image_path`/`image_size` 即可
    //     （参数名和尺寸口径保持不动，调用点一行都不用改）。
    // 图标小圆钮（2026-10-25：图标来自 LenoMusic 图库 ✓ 无底色、悬停有底）
    pri func img_btn(string iconName, string tipText, int sz, float isz): Button {
        return SDL3.createButton({image_path: ui.ico(iconName), image_size: isz,
                                  w: _float(sz), h: _float(sz), radius: _float(sz) / 2.0,
                                  bg_color: C_TRANS, hover_color: #FFFFFFD0,
                                  padding: 0.0, border: false, shadow: false, tip: tipText})
    }

    pri func txt_btn(string label, string tipText, int sz, Color c): Button {
        Button b = SDL3.createButton({text: label, font_size: _float(sz) * 0.44 + 3.0,
                                      w: _float(sz), h: _float(sz),
                                      radius: _float(sz) / 2.0,
                                      bg_color: C_TRANS, hover_color: #FFFFFFD0,
                                      text_color: c, padding: 0.0,
                                      border: false, shadow: false, tip: tipText})
        return b
    }

    // ==================== 交互 ====================
    pri func toggle_play() {
        // 有真音频对象 ⇒ 交给 miniaudio（stop 保留位置 → pause/resume 就是它 ✓）
        if sndOk {
            if playing { snd.pause() } else { snd.resume() }
        }
        playing = not playing
        playBtn.set_image(if playing then ui.ico("pause.png") else ui.ico("play.png"))
        SDL3.markFrameRedraw()
    }

    // 这首是不是"当前正在播放"的（卡片上的 play/pause 叠加钮要靠它判断 ✓）
    pri func is_now_playing(Song sg): bool {
        if not playing { return false }
        // 在线歌：比 sid
        if sg.sid != "" and nowSid != "" { return sg.sid == nowSid }
        // 本地文件：sid 是空的 ⇒ 必须按**路径**比，否则本地列表永远认不出“正在播放”✗
        if sg.path != "" and nowSong.path != "" { return sg.path == nowSong.path }
        return false
    }

    // 底栏 ♥ 的图标 = **当前在播那首歌**的收藏状态（不是独立开关 ✓）
    pri func sync_like_icon() {
        if likeBtn.get_w() <= 0.0 { return }
        bool on = is_liked(ui.like_key(nowSong))
        liked = on
        likeBtn.set_image(ui.ico(if on then "sc1.png" else "sc.png"))
    }

    // 底栏 ♥：走和卡片**同一条**收藏逻辑（likedSids + 落盘），
    //   否则底栏和卡片是两套状态、互相看不见（卡片红心、底栏还是灰）
    pri func toggle_like() {
        if ui.like_key(nowSong) == "" {
            nowArtist.set_text("还没有在播的歌")
            SDL3.markFrameRedraw()
            return
        }
        toggle_song_like(nowSong)
        sync_like_icon()
        SDL3.markFrameRedraw()
    }

    // 点歌 ⇒ 换掉底栏的"正在播放"（演示：只更新文字与封面 ✓）
    // 首页分区回信落地（为你推荐 / 最近添加）：解析成分组 Song 数组
    pri func apply_sections(Array[Array[string]] msg) {
        homeLoaded = true
        homeLoading = false            // 回信到了 ⇒ "正在加载"收起来 ✓
        Array[Song] rec = []
        Array[Song] nw = []
        int mode = 0
        for 0 : msg.len() - 1 to k {
            Array[string] r = msg[k]
            if r.len() >= 1 and (r[0] == "REC" or r[0] == "NEW" or r[0] == "ERR") {
                mode = if r[0] == "REC" then 1 else (if r[0] == "NEW" then 2 else 0)
                continue
            }
            if r.len() < 7 or mode == 0 { continue }
            Song sg = new Song()
            sg.title = r[0]
            sg.artist = r[1]
            sg.dur = kuwo.formatduration(_int(r[3]))
            sg.sid = r[6]
            int n = 1 + ((rec.len() + nw.len()) % 16)
            sg.cover = if n < 10 then "cover0" + _str(n) + ".png" else "cover" + _str(n) + ".png"
            if r.len() >= 8 and r[7] != "" { sg.cover = r[7] }   // 线程里下好的真封面 ✓
            sg.tag = if r[4].to_lower() == "flac" then "无损" else ""
            if mode == 1 { rec.add(sg) } else { nw.add(sg) }
        }
        if rec.len() > 0 { recSongs = rec }
        if nw.len() > 0 { newSongs = nw }
        // 封面：两区 id 摊平后**按 3 片并行**拉（结果从 coverCh 回来，边到边贴 ✓）
        Array[string] ids = []
        for 0 : recSongs.len() - 1 to k2 {
            if recSongs[k2].sid != "" { ids.add(recSongs[k2].sid) }
        }
        for 0 : newSongs.len() - 1 to k2 {
            if newSongs[k2].sid != "" { ids.add(newSongs[k2].sid) }
        }
        if ids.len() > 0 {
            // 分片数按数量走：每片约 6 张（24 首推荐 ⇒ 5~6 片并行，别串行拉 24 次 ✓）
            // 线程数来自设置（上限仍压到 6：一次开太多线程拉详情页反而更慢 ✓）
            int shards = g_workers
            if shards < 3 { shards = 3 }
            if shards > 6 { shards = 6 }
            if ids.len() < shards { shards = ids.len() }
            for 0 : shards - 1 to sIdx {
                Array[string] part = []
                int j = sIdx
                while j < ids.len() {
                    part.add(ids[j])
                    j = j + shards
                }
                threads.start(workers.cover_shard, part, ui.coverCacheDir(), coverCh)
            }
        }
        if curNav == 0 and netSongs.len() == 0 { rebuild_content() }
        SDL3.markFrameRedraw()
    }

    // 记录"最近播放"：把这首歌提到最前（按 歌名+歌手 去重，最多留 12 首）
    //   ⇒ 「继续收听」直接按这个顺序显示 = 最近播放时间倒序 ✓
    pri func push_recent(Song sg) {
        Array[Song] out = [sg]
        for 0 : recentSongs.len() - 1 to i {
            Song r = recentSongs[i]
            // 同歌（歌名 + 歌手）不重复占位 —— 重播只是把它提到最前 ✓
            if r.title == sg.title and r.artist == sg.artist { continue }
            // 超过设置里的条数 ⇒ 按**时间**顶替（丢弃最旧的那条，FIFO ✓）
            if out.len() >= g_recentMax { break }
            out.add(r)
        }
        recentSongs = out
        save_library()               // 最近播放也落盘（重启后「继续收听」还在 ✓）
    }

    // 卡片点播放：**有 sid 就走真播放**（推荐 / 最近添加 / 继续收听 里的酷我歌 ✓）
    // ==================== 播放列表（队列）====================
    // 从某个列表的第 idx 首开始播：整张表进队列（之后面板里能看到全部 ✓）
    pri func play_from(Array[Song] list, int idx) {
        if idx < 0 or idx >= list.len() { return }
        queue = list
        qIdx = idx
        play_song(list[idx])
        if qOpen { build_queue_rows() }
    }

    // 按**队列下标**播放（浮层行点击专用）
    //   闭包只传 int，队列在方法里从 self 读 ⇒ 不会捕获到旧副本 ✓
    pri func play_from_index(int idx) {
        if idx < 0 or idx >= queue.len() { return }
        qIdx = idx
        play_song(queue[idx])
        if qOpen { build_queue_rows() }
    }

    // 「跳动音柱」已搬到 `lib/pages/overlays.leno` 的 `make_beat(phase)`（拆分第七步 ✓）

    // 加到播放列表（不打断当前播放；已在列表里就只提示 ✓）
    pri func add_to_queue(Song sg) {
        string k = ui.like_key(sg)
        for queue to q {
            if ui.like_key(q) == k {
                nowArtist.set_text("已在播放列表里：" + sg.title)
                SDL3.markFrameRedraw()
                return
            }
        }
        queue.add(sg)
        if qIdx < 0 { qIdx = queue.len() - 1 }
        nowArtist.set_text("已加入播放列表：" + sg.title)
        if qOpen { build_queue_rows() }
        SDL3.markFrameRedraw()
    }

    pri func queue_clear() {
        queue = []
        qIdx = -1
        build_queue_rows()
        SDL3.markFrameRedraw()
    }

    // 从播放列表移除第 idx 首（不影响磁盘文件 ✓）
    pri func queue_remove(int idx) {
        if idx < 0 or idx >= queue.len() { return }
        Array[Song] nq = []
        for 0 : queue.len() - 1 to i {
            if i != idx { nq.add(queue[i]) }
        }
        queue = nq
        // 当前播放项的位置跟着挪：删的是它 ⇒ 没"当前项"了（播放不停，只是列表里不再高亮）
        if qIdx == idx { qIdx = -1 }
        else if qIdx > idx { qIdx = qIdx - 1 }
        build_queue_rows()
        SDL3.markFrameRedraw()
    }

    // 音量浮窗：开关（与播放列表面板互斥，同时只开一个 ✓）
    pri func toggle_vol() {
        volOpen = not volOpen
        if volOpen {
            if qOpen { toggle_queue() }              // 先关播放列表
            volSld.set_value(g_vol)
            sync_vol_ui()
            // ★ 对准音量按钮**正上方**：按钮的实际位置只有布局跑完才知道 ⇒ 打开时现算
            //   （x 取按钮中心减浮窗半宽；y 取按钮顶再往上让一个浮窗高 + 8px 间隔 ✓）
            float bx = volBtn.get_x() + volBtn.get_w() / 2.0 - volRoot.get_w() / 2.0
            float by = volBtn.get_y() - volRoot.get_h() - 8.0
            volRoot.set_pos(bx, by)
            volRoot.set_visible(true)
            win.set_modal(volRoot, volRoot.get_x(), volRoot.get_y(), volRoot.get_w(), volRoot.get_h())
            // 点外面 ⇒ 自动收起（同播放列表 ✓）
            win.set_click_outside(volRoot.get_x(), volRoot.get_y(), volRoot.get_w(), volRoot.get_h(),
                                  func() { toggle_vol() })
        } else {
            volRoot.set_visible(false)
            win.clear_modal()
            win.clear_click_outside()
        }
        SDL3.markFrameRedraw()
    }

    // 浮窗顶部的数字（参考图就是纯数字，不带 %）
    pri func sync_vol_ui() {
        if volPct.get_w() <= 0.0 { return }
        volPct.set_text(_str(_int(g_vol)))
    }

    // 收起两个浮层（窗口尺寸变化时调；再点按钮会按新尺寸重新弹出 ✓）
    pri func close_overlays() {
        if qOpen {
            qOpen = false
            qRoot.set_visible(false)
        }
        if volOpen {
            volOpen = false
            volRoot.set_visible(false)
        }
        win.clear_modal()
        win.clear_click_outside()      // 收起时一并撤掉"点外面"回调（否则下次点击会误触发 ✓）
        SDL3.markFrameRedraw()
    }

    pri func toggle_queue() {
        qOpen = not qOpen
        if qOpen {
            if volOpen { toggle_vol() }              // 先关音量浮窗（互斥 ✓）
            build_queue_rows()
            // 按**当前**尺寸定位：建面板时用的是常量，窗口放大后那个坐标就飘在中间了 ✗
            //   取根布局的实时宽高（root 会随窗口拉伸），y 再加标题栏高度才是窗口底部 ✓
            qRoot.set_pos(root.get_w() - 284.0, tbH + root.get_h() - 560.0)
            // 点外面 ⇒ 自动收起（框架在派发处拦：这一下不会再喂给底下的控件 ✓）
            win.set_click_outside(qRoot.get_x(), qRoot.get_y(), qRoot.get_w(), qRoot.get_h(),
                                  func() { toggle_queue() })
        } else {
            win.clear_click_outside()
        }
        qRoot.set_visible(qOpen)
        // 防穿透：展开时把浮层登记成"模态"——落在它矩形内的事件只给它 ✓
        if qOpen {
            win.set_modal(qRoot, qRoot.get_x(), qRoot.get_y(), qRoot.get_w(), qRoot.get_h())
        } else {
            win.clear_modal()
        }
        SDL3.markFrameRedraw()
    }

    // 重建浮层里的行（打开面板 / 换歌 / 队列变化时调）
    pri func build_queue_rows() {
        qList.clear()
        // 登记表跟着一起清（旧控件已销毁，留着引用会悬空 ✗）
        qRows = []
        qRowDur = []
        qRowX = []
        qRowMark = []
        qRowHot = []
        if queue.len() == 0 {
            qList.add(ui.lbl("播放列表是空的 · 点任意歌曲开始", 11.5, C_TXT_DIM, false),
                      {grow: 0, shrink: 0, basis: 34, align: 3})
            qSub.set_text("0 首")
            return
        }
        int total = 0
        for queue to q { total = total + pw.dur_secs(q.dur) }
        qSub.set_text(_str(queue.len()) + " 首 · " + _str(total / 60) + " 分钟")
        for 0 : queue.len() - 1 to i {
            int qi = i
            // 行控件在 `lib/pages/overlays.leno`（拆分第七步 ✓）
            //   闭包里**只传 int**：队列在 play_from_index / queue_remove 里从 self 读，
            //   把 `queue` 写进闭包会捕获创建时的副本 ⇒ 点了像"没反应" ✗
            Card row = page_ov.queue_row(queue[i], i == qIdx, qi, 244.0,
                                         func(int k) { play_from_index(k) },
                                         func(int k) { queue_remove(k) },
                                         func(Label dl, Button xb, Panel mk) {
                                             // 登记：on_tick 里按 is_hover() 切
                                             //   「时长 ↔ ×」+ 封面上的播放标记 ✓
                                             qRowDur.add(dl)
                                             qRowX.add(xb)
                                             qRowMark.add(mk)
                                         })
            qRows.add(row)
            qRowHot.add(false)
            qList.add(row, {grow: 0, shrink: 0, basis: 50, align: 3})
        }
    }

    pri func play_song(Song sg) {
        nowSong = sg                    // 底栏 ♥ 按它判断收藏状态 ✓
        // 队列位置：在列表里就高亮那一项；队列还空就把它当第一首 ✓
        int qFound = -1
        for 0 : queue.len() - 1 to qk {
            if ui.like_key(queue[qk]) == ui.like_key(sg) { qFound = qk }
        }
        if qFound >= 0 { qIdx = qFound }
        else if queue.len() == 0 { queue = [sg]; qIdx = 0 }
        if qOpen { build_queue_rows() }
        // 本地文件（下载列表 / 本地音乐）⇒ 直接播磁盘上的，不走网络 ✓
        if sg.path != "" {
            push_recent(sg)
            nowTitle.set_text(sg.title)
            nowArtist.set_text(sg.artist)
            coverView.set_image(ui.coverPath(sg.cover))
            pos = 0.0
            durKnown = false
            shownSec = -1
            sync_play_ui()
            nowSid = ""
            start_play_file(sg, sg.path)
            request_lyric()          // 本地文件也取歌词（读同目录 .lrc；原来这里没有 ⇒ 歌词页一直空 ✗）
            return
        }
        if sg.sid != "" {
            play_sid(sg)
            return
        }
        push_recent(sg)
        nowTitle.set_text(sg.title)
        nowArtist.set_text(sg.artist + " · HRES")
        coverView.set_image(ui.coverPath(sg.cover))
        pos = 0.0
        playing = true
        playBtn.set_image(ui.ico("pause.png"))
        sync_play_ui()
        SDL3.markFrameRedraw()
    }

    pri func on_seek(float v) {
        if seekSyncing { return }        // 这一拍只是界面在刷新，不是用户拖动 ✓
        float r = v / 100.0
        if r < 0.0 { r = 0.0 }
        if r > 1.0 { r = 1.0 }
        float target = dur * r
        pos = target
        // ★ 真 seek（2026-10-27）：之前这里只改 `pos` 不做跳转，下一拍 sync_play_ui 又按实际播放位置
        //   把进度条拉回去 ⇒ 用户看到的就是「点了没反应/跳不过去」✗
        //   `Sound.seek(秒)` 走 miniaudio 的 ma_sound_seek_to_second（一次调用，代价可接受）
        if sndOk and dur > 0.0 {
            if not snd.seek(target) { nowArtist.set_text("这个格式不支持跳转") }
        }
        shownSec = _int(pos)
        curTime.set_text(ui.fmtTime(pos))
        SDL3.markFrameRedraw()
    }

    // 音量图标跟着状态走（yl.png = 有声 / yl1.png = 静音）
    pri func sync_vol_icon() {
        // Button 是值类型（不能和 null 比）⇒ 用宽度判断"建过没"（没建时 w=0 ✓）
        if volBtn.get_w() <= 0.0 { return }
        volBtn.set_image(ui.ico(if muted then "yl1.png" else "yl.png"))
    }

    // 点图标切换静音（记住静音前的音量 ✓）
    pri func toggle_mute() {
        muted = not muted
        if muted {
            lastVol = g_vol
            if lastVol <= 1.0 { lastVol = 68.0 }
            g_vol = 0.0
            if sndOk { snd.setVolume(0.0) }
        } else {
            g_vol = lastVol
            if sndOk { snd.setVolume(lastVol / 100.0) }
        }
        sync_vol_icon()
        SDL3.markFrameRedraw()
    }

    pri func on_volume(float v) {
        g_vol = v
        if sndOk { snd.setVolume(v / 100.0) }
        // 拖到 0 视为静音；拖回来就恢复图标（不用再点按钮 ✓）
        muted = v <= 1.0
        if not muted { lastVol = v }
        sync_vol_icon()
        SDL3.markFrameRedraw()
    }

    pri func on_search() {
        query = strings.trim(search.get_text())
        rebuild_content()
    }

    // 重建内容区
    //   修内存泄漏（现象：每点一次首页，内存就涨）：
    //     `clear()` **只清布局数组**，不会 dispose 子控件 —— 而这里每次重建都是**新建**一批
    //     Card / ImageView / Table，每个都带一张封面纹理（酷我 500px 封面解码后 ≈1MB，
    //     一屏 17 张）⇒ 旧控件的 SDL_Texture 永远没人释放 ✗
    //     （GC 只回收 Leno 对象，**不会**调 dispose；海报墙那边是"卡片建一次、只换 add 名单"，
    //       所以它用 clear() 是对的 —— 两种用法不能混 ✓）
    //     实测：交替切页 24 次，进程内存 68MB → 398MB（≈13.7MB/次）
    //   ⚠ 顺序不能反：先 dispose（逐个释放纹理/字体引用），再 clear（清空布局数组）；
    //     反过来 dispose 就遍历不到子控件了。
    // 卡片要触发的动作全部注入到这里（lib/cards.leno 只管长什么样，不知道 Player ✓）
    //   ⚠ 必须在建界面**之前**调用：第一屏卡片就要用这些回调
    pri func init_card_hooks() {
        hooks.onPlay = func(Song sg) {
            if is_now_playing(sg) { toggle_play() } else { play_song(sg) }
            rebuild_content()          // 图标跟着换 play/pause ✓
        }
        hooks.onOpen = func(Song sg) { open_song(sg) }
        hooks.onLike = func(Song sg) { toggle_song_like(sg) }
        hooks.onQueue = func(Song sg) { queue_song(sg) }
        // 「+」= 加入播放列表（不打断当前播放 ✓）
        hooks.onAddList = func(Song sg) { add_to_queue(sg) }
        hooks.onDelete = func(Song sg) { unlike_song(sg) }
        hooks.isPlaying = func(Song sg): bool { return is_now_playing(sg) }
        hooks.isLiked = func(Song sg): bool { return is_liked(ui.like_key(sg)) }
        hooks.onTrack = func(Song sg, Button b, ImageView iv) {
            if trackCards {
                cardLikeBtns.add(b)
                cardLikeKeys.add(ui.like_key(sg))
                cardCovers.add(iv)
                cardCoverKeys.add(sg.sid)
            }
        }
    }

    pri func rebuild_content() {
        // 记下这次是按多宽的窗口排的版 —— resize 后拿它比较，尺寸不同才重建 ✓
        lastBuildW = _int(win.getSize().w)
        cardSize.winW = lastBuildW                  // 卡片尺寸按新窗口宽重算（lib/cards.leno）
        content.dispose()
        content.clear()
        build_content()
        // **内容区高度要按实际内容撑开** —— 原来固定 900，
        //   歌曲页 30 行表格（≈940）超出部分直接被裁，滚轮也滚不下去（看着像"只有 14 首"✗）
        //   `fit_w` 只管宽，高必须自己给；ScrollView 按 content 高度算滚动范围 ✓
        float ch = content.measure_h()
        if ch < 200.0 { ch = 200.0 }
        content.set_size(_float(cardSize.content_w() + PAD * 2), ch)
        SDL3.markFrameRedraw()
    }

    // 每拍（200ms）推进播放进度
    pri func start_timer() {
        win.addTimer(200, func() { on_tick() })
        // 歌词刷新**独立定时器**（33ms ≈ 30fps）：帧间隔由定时器保证均匀，
        //   不依赖"渲染回调里再请求下一帧"那条链路（那条会忽快忽慢 ⇒ 一顿一顿 ✗）
        win.addTimer(33, func() { lyr_ui_tick() })
    }

    pri func on_tick() {
        // ⓪0 窗口缩放：宽度真变了才重建（表格宽/列宽都是按宽度算死的，必须重建才归位 ✓）
        //   放在每拍最前面：拖动时最多每 200ms 重建一次，不会卡；松手后最后一拍一定对齐 ✓
        if resizePending {
            int ww = _int(win.getSize().w)
            resizePending = false                  // 无论是否重建都复位，避免标记悬着 ✓
            if ww > 0 and ww != lastBuildW {
                rebuild_content()
                SDL3.markFrameRedraw()
            }
        }
        // ⓪0b 搜索建议：输入停下约 400ms 才发一次请求（同一个词不重复发 ✓）
        if sugAt > 0 and steps >= sugAt {
            sugAt = -1
            string kw = strings.trim(search.get_text())
            if kw != "" and kw != sugKw {
                sugKw = kw
                threads.start(workers.search, kw, 8, sugCh)
            }
        }
        if sugCh != null {
            var smsg = sugCh.try_receive()
            while smsg != null {
                var srows = smsg as Array[Array[string]]
                if srows != null { apply_suggestions(srows) }
                smsg = sugCh.try_receive()
            }
        }
        // ⓪a 右键注入（ARIA_RCLICK=N）：在结果表第一行上右击，验证"重建时 dispose 子控件"
        //   没有把 Table 自己的弹层菜单搞成悬空（菜单宿主被 dispose ⇒ 点一下会崩 ✓）
        if rclickAt > 0 and steps == rclickAt {
            rclickAt = 0
            SDL3.testRightClickAt(win.getID(), 320.0, 200.0)
            print("[rc] 已注入右键 @ (320,200)")
        }
        // ⓪b 悬停注入（ARIA_HOVERAT=N）：鼠标停在表格第 1 行上，验证**行级 tip**（大小/格式/路径）
        //   提示气泡有延迟（默认 500ms）⇒ 截图要在这之后再拍 ✓
        // ⓪d 歌词页探针（ARIA_LYRIC=N）：第 N 拍进歌词页（只切页，不碰播放 ✓）
        if lyricAt > 0 and steps == lyricAt {
            lyricAt = 0
            // 无头验证用：没在播时假一首歌（**只改界面文字/封面，不碰音频** ✓），
            //   否则歌词页只会显示"还没有在播的歌"，看不到歌词排版
            if nowSid == "" { fake_now_song() }
            // 直接把进度摆到 70 秒（**不动音频**）：一进页面就能看到"滚到中部 + 中部那行高亮"，
            //   无头验证自动滚动有没有生效 ✓
            open_lyrics(true)
            // ARIA_LYFAKE=1：造一份**带逐字标签**的 LRC 文本走真实解析链路
            //   ⇒ 不依赖网络也能验"居中 / 当前行放大 / 逐字扫光 / 缓动滚动" ✓
            //   ⚠ 必须放在 open_lyrics 之后：进页面会 request_lyric()，它会把 lrcData 清空 ✗
            var lf = _env("ARIA_LYFAKE")
            if lf != null and _int(_str(lf)) > 0 {
                // 40 行 × 5 秒、每字 0.4 秒：形状与酷我 lrcx 一致（生成函数在 lib/probes.leno ✓）
                lyric.set_text(probe.fake_lyric(40, 5, 400))
                lyric.sid = nowSid
                lyric.fakeOn = true               // 忽略后台回信，别把假歌词覆盖掉 ✓
                pos = 102.2                       // 落在第 6 个字的中间 ⇒ 能看到"字内渐变" ✓
                rebuild_content()
                print("[lyric] 已造假歌词（40 行 / 逐字）pos=" + _str(pos))
            }
            print("[lyric] 已切到歌词页 sid=" + nowSid)
        }
        // ⓪e 封面联动探针（ARIA_COVERTEST=N）：第 N 拍删掉当前歌的封面缓存并重新请求
        //   ⇒ 复现"进歌词页时封面还没回来"，再验证回信时**歌词页大封面就地更新** ✓
        if coverTestAt > 0 and steps == coverTestAt {
            coverTestAt = 0
            string f = dirs.join(ui.coverCacheDir(), cover.cache_name(nowSid, "120"))
            try { files.delete(f) } catch e { print("[covertest] 删缓存失败：" + _str(e)) }
            if curNav != -6 { open_lyrics(true) }
            threads.start(workers.cover_shard, [nowSid], ui.coverCacheDir(), coverCh)
            print("[covertest] 已删封面缓存并请求 sid=" + nowSid + "（进歌词页时应该是空的）")
        }
        if hoverAt > 0 and steps == hoverAt {
            hoverAt = 0
            SDL3.testMoveAt(win.getID(), 320.0, 200.0)
            print("[hover] 已注入鼠标移动 @ (320,200)")
            // ARIA_CLICK=x,y：顺手注入一次点击（验证"点 ♥ 之后图标就地切换"这类联动 ✓）
            var ck = _env("ARIA_CLICK")
            if ck != null {
                var xy = strings.split(_str(ck), ",")
                if xy.len() >= 2 {
                    SDL3.testClickAt(win.getID(), _float(xy[0]), _float(xy[1]))
                    print("[click] 已注入点击 @ (" + xy[0] + "," + xy[1] + ")")
                }
            }
        }

        // ARIA_CLICK3=x,y + ARIA_CLICK3_AT=N：第三段点击
        if click3At > 0 and steps == click3At {
            click3At = 0
            var xy3 = strings.split(click3Raw, ",")
            if xy3.len() >= 2 {
                SDL3.testClickAt(win.getID(), _float(xy3[0]), _float(xy3[1]))
                print("[click3] 已注入点击 @ (" + xy3[0] + "," + xy3[1] + ")")
            }
        }

        // ARIA_CLICK2=x,y + ARIA_CLICK2_AT=N：第 N 拍再点一次
        //   用来验"点卡片进详情 → 再点顶栏 ← 回来"这种**两步**操作 ✓
        if click2At > 0 and steps == click2At {
            click2At = 0
            var xy2 = strings.split(click2Raw, ",")
            if xy2.len() >= 2 {
                SDL3.testClickAt(win.getID(), _float(xy2[0]), _float(xy2[1]))
                print("[click2] 已注入点击 @ (" + xy2[0] + "," + xy2[1] + ")")
            }
        }

        // ⓪ 切页内存探针（ARIA_STRESS）：交替 首页(0) / 最近播放(2) ⇒ 每次 set_nav 都真的 rebuild
        if stressLeft > 0 {
            if not stressWarm {
                // 先让首页按固定数据渲染几帧（首帧要建纹理，那部分不算增量 ✓）
                if steps >= 6 {
                    stressWarm = true
                    stressMem0 = Sys.processMemoryKb(Sys.currentPid())
                }
            } else {
                stressLeft = stressLeft - 1
                set_nav(if stressLeft % 2 == 0 then 0 else 2)
                if stressLeft == 0 { stressReport = 10 }   // 停手后再等 10 拍才报（留给 GC ✓）
            }
        } else if stressReport > 0 {
            stressReport = stressReport - 1
            if stressReport == 0 {
                int nowKb = Sys.processMemoryKb(Sys.currentPid())
                print("[leak] 交替切页完成（静置 2s 后）：" + _str(stressMem0) + "KB -> " +
                      _str(nowKb) + "KB  共 +" + _str(nowKb - stressMem0) + "KB")
            }
        }
        // ① 排空「歌单详情」线程的回信
        if plSongsCh != null {
            var mps = plSongsCh.try_receive()
            while mps != null {
                var psr = mps as Array[Array[string]]
                if psr != null { apply_playlist_songs(psr) }
                mps = plSongsCh.try_receive()
            }
        }
        // ① 排空「推荐歌单」线程的回信（发现页）
        if plCh != null {
            var mpl = plCh.try_receive()
            while mpl != null {
                var prw = mpl as Array[Array[string]]
                if prw != null { apply_playlists(prw) }
                mpl = plCh.try_receive()
            }
        }
        // ① 排空排行榜**卡片墙**线程的回信
        if bangCardsCh != null {
            var mbc = bangCardsCh.try_receive()
            while mbc != null {
                var crows = mbc as Array[Array[string]]
                if crows != null { apply_bang_cards(crows) }
                mbc = bangCardsCh.try_receive()
            }
        }
        // ① 排空排行榜线程的回信
        if bangCh != null {
            var mb = bangCh.try_receive()
            while mb != null {
                var brows = mb as Array[Array[string]]
                if brows != null { apply_bang(brows) }
                mb = bangCh.try_receive()
            }
        }
        // ① 排空搜索线程的回信（`try_receive()` 非阻塞 —— 不要用 threads.select ✗）
        if searchCh != null {
            var m = searchCh.try_receive()
            while m != null {
                var rows = m as Array[Array[string]]
                if rows != null { apply_search_result(rows) }
                m = searchCh.try_receive()
            }
        }
        // ①a2 首页分区：启动几拍后拉一次（线程，避免首帧卡住），回信到了替换演示数据
        if not homeAsked and steps >= 3 {
            homeAsked = true
            homeLoading = true
            if curNav == 0 and netSongs.len() == 0 { rebuild_content() }   // 立刻显示"正在加载"✓
            // 为你推荐 6 行、最近添加 2 行（数量 = 列数 × 行数，列数随窗口宽变 ✓ 不留半行）
            int cols0 = cardSize.cols()
            threads.start(workers.sections, "热歌", "新歌", cols0 * 6, cols0 * 2, homeCh)
        }
        if homeCh != null and homeCh.len() > 0 {
            var h = homeCh.try_receive()
            while h != null {
                var rows = h as Array[Array[string]]
                if rows != null { apply_sections(rows) }
                h = homeCh.try_receive()
            }
        }
        // ①b 排空封面线程的回信（同样是非阻塞 ✓）；只在还是当前这首时才贴图
        if coverCh != null {
            var c = coverCh.try_receive()
            while c != null {
                var arr = c as Array[string]
                if arr != null and arr.len() >= 2 {
                    string cid = arr[0]
                    string cpath = arr[1]
                    if cpath != "" {
                        bool hitCur = nowSid != "" and cid == nowSid
                        if hitCur {
                            coverView.set_image(cpath)
                            // ★ 三个地方都要跟着换（否则歌词页大封面会一直空着）：
                            //   ① 底栏头像 ② nowSong.cover（数据写回 ⇒ 之后重建页面也拿到真封面）
                            //   ③ 歌词页大圆封面（正在歌词页时**就地** set_image，不重建页面 ✓）
                            nowSong.cover = cpath
                            if curNav == -6 { lyricBigCover.set_image(cpath) }
                        }
                        // 榜卡片上的大封面：命中就贴（不是当前播放那首也要贴 ✓）
                        for rankCoverSids.len() to rk {
                            if rankCoverSids[rk] == cid { rankCovers[rk].set_image(cpath) }
                        }
                        // ★ 写回歌曲数据：卡片用的是 `sg.cover`（继续收听 / 为你推荐 / 最近添加）
                        bool touched = false
                        for 0 : netSongs.len() - 1 to ni {
                            if netSongs[ni].sid == cid { netSongs[ni].cover = cpath; touched = true }
                        }
                        for 0 : recentSongs.len() - 1 to ri {
                            if recentSongs[ri].sid == cid { recentSongs[ri].cover = cpath; touched = true }
                        }
                        for 0 : recSongs.len() - 1 to ri {
                            if recSongs[ri].sid == cid { recSongs[ri].cover = cpath; touched = true }
                        }
                        for 0 : newSongs.len() - 1 to ri {
                            if newSongs[ri].sid == cid { newSongs[ri].cover = cpath; touched = true }
                        }
                        // 数据写回后**就地换图**（不再整页重建 ⇒ 卡片墙不会每来一张封面闪一下 ✓）
                        if touched { sync_card_covers(cid, cpath) }
                        if hitCur { SDL3.markFrameRedraw() }
                    }
                }
                c = coverCh.try_receive()
            }
        }
        // ①b' 封面**不再触发整页重建**（原来 `coverDirty` ⇒ 每 4 拍 rebuild 一次，卡片墙一直闪 ✗）：
        //   收到一张就按 sid 就地 set_image（见上面那个循环）；当前不是卡片页时数据也已写回，
        //   下次进那页自然拿到真封面 ✓
        // ①c 歌词回信（后台线程）：整份歌词文本 ⇒ LenoMusic 的解析器（含逐字标签 ✓）
        if lyrCh != null {
            var lmsg = lyrCh.try_receive()
            while lmsg != null {
                var rawLines = lmsg as Array[string]
                if rawLines != null and not lyric.fakeOn {
                    if rawLines.len() > 0 {
                        lyric.set_text(rawLines[0])
                    } else {
                        lyric.clear()
                    }
                    lyric.reset_idx()
                    if curNav == -6 { rebuild_content() }
                }
                lmsg = lyrCh.try_receive()
            }
        }
        // ①d 排空下载进度（分片下载每 1MB 回一条；非阻塞 ✓）
        if dlCh != null {
            var pm = dlCh.try_receive()
            while pm != null {
                var pa = pm as Array[string]
                if pa != null and pa.len() >= 2 and dlCur >= 0 and dlCur < dlJobs.len() {
                    Array[string] j = dlJobs[dlCur]
                    string kind = pa[0]
                    if kind == "P" {
                        j[6] = pa[1]
                        if pa.len() >= 3 { j[7] = pa[2] }
                        dlJobs[dlCur] = j
                        if curNav == -2 { rebuild_content() }      // 进度条跟着走 ✓
                    } else if kind == "D" {
                        j[3] = "1"
                        j[4] = ""
                        j[6] = pa[1]
                        j[7] = pa[1]      // 完成 = 100%（服务端 Content-Range 总长会有偏差，别用它算 ✓）
                        // 第 4 项是**实际落盘的格式**（flac 取不到会退 mp3）⇒ 覆盖入队时的预判 ✓
                        if pa.len() >= 4 and pa[3] != "" { j[5] = pa[3].to_upper() }
                        dlJobs[dlCur] = j
                        dlBusy = false
                        dlCur = -1
                        refresh_dl_btn()
                        if curNav == -2 { rebuild_content() }
                    } else if kind == "E" {
                        j[3] = "2"
                        j[4] = pa[1]
                        dlJobs[dlCur] = j
                        dlBusy = false
                        dlCur = -1
                        refresh_dl_btn()
                        if curNav == -2 { rebuild_content() }
                    }
                    SDL3.markFrameRedraw()
                }
                pm = dlCh.try_receive()
            }
        }
        // ①d2 播放前的音源回信（取直链/下载试听都在工作线程，回来才开声 ✓）
        if playCh != null {
            var pmsg = playCh.try_receive()
            while pmsg != null {
                var pa = pmsg as Array[string]
                if pa != null and pa.len() >= 2 {
                    // 第 3 项是音源 id ⇒ 丢弃过期回信（连点两首时不会把 A 的路径贴给 B ✓）
                    string rid = if pa.len() >= 3 then pa[2] else ""
                    bool fresh = rid == "" or rid == pendingSong.sid
                    if pa[0] == "OK" {
                        if playPending and fresh {
                            playPending = false
                            play_ready(pendingSong, pa[1])      // 同一拍里开声（几个毫秒 ✓）
                        }
                    } else {
                        playPending = false
                        nowArtist.set_text(pa[1])
                        playing = false
                        playBtn.set_image(ui.ico("play.png"))
                    }
                    SDL3.markFrameRedraw()
                }
                pmsg = playCh.try_receive()
            }
        }
        // ①e 空闲且队列里有排队的 ⇒ 起一个**下载线程**（分片下载才有进度；主线程不阻塞 ✓）
        if not dlBusy {
            int di = dl.next_index(dlJobs)
            if di >= 0 {
                dlBusy = true
                dlCur = di
                Array[string] j = dlJobs[di]
                j[3] = "5"                                   // 5 = 下载中（不是排队）
                j[6] = "0"
                dlJobs[di] = j
                if curNav == -2 { rebuild_content() }
                // 位标志：1 = 同时存 .lrc，2 = 内嵌封面/歌词（设置里两个开关 ✓）
                int dlTags = 0
                if g_dlLyric { dlTags = dlTags | 1 }
                if g_embedTag { dlTags = dlTags | 2 }
                threads.start(dl.save_shard, j[0], j[1], j[2], ui.cacheRoot(), g_preferFmt, dlTags, dlCh)
                SDL3.markFrameRedraw()
            }
        }
        // ② 推进播放进度
        if playing {
            if sndOk {
                float p2 = snd.getPosition()
                if p2 >= 0.0 { pos = p2 }
                if not durKnown {
                    float d2 = snd.getDuration()
                    if d2 > 0.0 { dur = d2; durKnown = true; totTime.set_text(ui.fmtTime(dur)) }
                }
            } else {
                pos = pos + 0.2
            }
            if pos >= dur { pos = 0.0 }
            // ★ 每拍（100ms）都刷进度条 —— 原来"只在整秒变化时刷"，一秒跳一格看着**一顿一顿** ✗
            //   文字仍在 sync_play_ui 里按秒门控（没必要 10 次/秒重设同一个字符串 ✓）
            sync_play_ui()
            SDL3.markFrameRedraw()
        }
        // 歌词高亮跟着进度走（只改颜色 + 滚动，不重建 ✓）

        // 播放中：推进「跳动音柱」的相位（暂停就停住，柱子定住不动 ✓）
        if playing {
            beatPhase[0] = beatPhase[0] + 0.045
            if beatPhase[0] > 1000.0 { beatPhase[0] = 0.0 }
        }

        // 发现页「精选」：① 虚拟滚动（只保留可见区附近的卡片）
        //                 ② 滚到接近底部 ⇒ 自动加载下一页（无限滚 ✓）
        if curNav == 5 and discTab == 0 and plCards.len() > 0 {
            float sy = page_disc.scroll_y()
            page_disc.sync_visible(sy)               // 换页/滚动的行填收（没变化时是空转 ✓）
            if not plLoading and page_disc.near_bottom(200.0) {
                load_more_playlists()
            }
        }

        // 播放列表浮层：鼠标移到哪一行，
        //   ① 行尾「时长」换成「×」（移除）
        //   ② 封面上盖上「播放」标记 ✓
        for 0 : qRows.len() - 1 to i {
            bool hot = qRows[i].is_hover()
            if hot != qRowHot[i] {
                qRowHot[i] = hot
                qRowDur[i].set_visible(not hot)
                qRowX[i].set_visible(hot)
                qRowMark[i].set_visible(hot)
                SDL3.markFrameRedraw()
            }
        }

        steps = steps + 1
        // 截图完成后再让出几拍（present 落地）⇒ 从 tick 里干净退出 ✓
        if shotExitAt > 0 and steps >= shotExitAt { _exit(0) }
    }

    pri func sync_play_ui() {
        float r = if dur > 0.0 then pos / dur * 100.0 else 0.0   // dur=0 时不能除（会 NaN）
        if r < 0.0 { r = 0.0 }
        if r > 100.0 { r = 100.0 }
        seekSyncing = true                  // 程序化刷新：别回灌成 seek ✓
        seek.set_value(r)
        seekSyncing = false
        // 文字**按秒**门控：每拍都 set_text 同一个字符串是白费（标签会重新测量/重建纹理 ✓）
        int sec = _int(pos)
        if sec != shownSec {
            shownSec = sec
            curTime.set_text(ui.fmtTime(pos))
        }
        sync_like_icon()        // 换歌时 ♥ 跟着变（收藏过就红心 ✓）
        // 播放时头像自转（唱片效果），暂停就停 —— 24°/s ≈ 一圈 15 秒，不晃眼 ✓
        if coverView.get_w() > 0.0 { coverView.set_spin(if playing then 24.0 else 0.0) }
        // 换歌了且正停在歌词页 ⇒ 重新取歌词（request_lyric 内部按 sid 去重 ✓）
        if curNav == -6 and nowSid != "" and nowSid != lyric.sid { request_lyric() }
    }

    // ==================== 退出收尾 ====================
    //   释放音源：停声 → uninit 实例（释放 mp3 解码器与文件句柄）
    //   ⚠ 不调 `audio.uninit()` 关引擎：引擎还有 Sound 挂着时可能在 ma_engine_uninit 里等音频线程；
    //     进程退出本身会回收设备 ✓
    //   ⚠ 照 LenoMusic（musicdl_gui:1198）：`win.run` 要等**所有窗口销毁**才返回
    //     ⇒ 关窗那一刻就要收一次（可重复调用 ✓）
    pri func shutdown_audio() {
        if sndOk {
            snd.stop()
            snd.uninit()
            sndOk = false
        }
    }

    // ==================== 事件 ====================
    pri func on_event(Event ev): bool {
        // 窗口缩放 ⇒ 标记一下，交给 on_tick 在尺寸稳定后重建（拖动时每拍最多一次 ✓）
        //   ⚠ 原来这里只处理**卡片页**（`hasTable == false` 且列数变了）：
        //     表格/歌曲页的宽和列宽都是**按当时窗口宽算死的**，resize 后没人重算 ⇒
        //     表不跟随、右边空一条；只有重建才会归位（最小化再恢复也不重建 ⇒ 一直歪 ✗）
        //   ⇒ 任何页面都标记，由 on_tick 比对宽度后重建 ✓
        if ev.isWindowResized() {
            resizePending = true
            // 浮层（播放列表 / 音量）是按**弹出那一刻**的窗口尺寸定位的 ⇒
            //   窗口一变就收起（再点按钮时按新尺寸重新弹出 ✓）
            //   不收的话它们会钉在旧坐标上（放大窗口后飘在中间 ✗）
            close_overlays()
        }
        if ev.isQuit() or ev.isWindowClose() {
            shutdown_audio()
            return false
        }
        // 自绘标题栏的 ✕ 必须自己接（TitleBar 只置标志位 ✓）
        if tb._loaded and tb.is_close_requested() {
            tb.clear_close_request()
            shutdown_audio()
            return false
        }
        return true
    }

    // ==================== 无头自检 ====================
    pri func self_test() {
        // 启动就切到某个导航页（下标：0 首页 / 1 我喜欢 / 2 最近播放 / 3 本地音乐 / 4+ 歌单）
        var nv = _env("ARIA_NAV")
        if nv != null { set_nav(_int(_str(nv))) }
        // ⚠ 这里**不要再加会阻塞的自检钩子**（如"启动就 play_song"）：
        //   play_song → play_sid 会同步取直链 + 解码，跑在 UI 线程上 ⇒ 窗口直接卡死 ✗
        //   （2026-10-26 实测；要验播放就手动点，或写独立探针脚本）
        // 启动就搜一次酷我（联网自检：ARIA_SEARCH=周杰伦）
        var kwEnv = _env("ARIA_SEARCH")
        if kwEnv != null {
            search.set_text(_str(kwEnv))
            on_kuwo_search()
        }
        var sh = _env("ARIA_SHOT")
        if sh != null { shotPath = _str(sh) }
        var at = _env("ARIA_AT")
        if at != null { shotAt = _int(_str(at)) }
        var sz = _env("ARIA_SIZE")
        if sz != null {
            var parts = strings.split(_str(sz), "x")
            if parts.len() == 2 { win.setSize(_int(parts[0]), _int(parts[1])) }
        }
        var q = _env("ARIA_Q")
        if q != null {
            search.set_text(_str(q))
            query = _str(q)
            rebuild_content()
        }
        // ARIA_ACT=1 ⇒ 走一遍交互链路（点歌 ⇒ 底栏换歌 + 播放态 + 喜欢）
        //   这几条正是最容易"看代码没问题、跑起来不响应"的地方 ✓
        var act = _env("ARIA_ACT")
        if act != null and _int(_str(act)) > 0 { demo_actions() }
        // ARIA_STRESS=N ⇒ 每拍"首页 ⇄ 最近播放"交替切一次（走真实 set_nav ⇒ 真 rebuild），
        //   跑完打印进程内存增量。用它是为了把"点一下涨多少"变成数字，而不是靠肉眼看任务管理器 ✓
        var rc = _env("ARIA_RCLICK")
        if rc != null { rclickAt = _int(_str(rc)) }
        var hv = _env("ARIA_HOVERAT")
        if hv != null { hoverAt = _int(_str(hv)) }
        var ly = _env("ARIA_LYRIC")
        if ly != null { lyricAt = _int(_str(ly)) }
        var cvt = _env("ARIA_COVERTEST")
        if cvt != null { coverTestAt = _int(_str(cvt)) }
        var c2 = _env("ARIA_CLICK2")
        if c2 != null { click2Raw = _str(c2) }
        var c2a = _env("ARIA_CLICK2_AT")
        if c2a != null { click2At = _int(_str(c2a)) }
        var c3 = _env("ARIA_CLICK3")
        if c3 != null { click3Raw = _str(c3) }
        var c3a = _env("ARIA_CLICK3_AT")
        if c3a != null { click3At = _int(_str(c3a)) }
        var st = _env("ARIA_STRESS")
        if st != null {
            stressLeft = _int(_str(st))
            if stressLeft > 0 {
                // 默认用固定离线数据（可比 ✓）；`ARIA_SEED=0` ⇒ 用真实网络数据（量封面成本用）
                var sd = _env("ARIA_SEED")
                bool seedIt = true
                if sd != null and _str(sd) == "0" { seedIt = false }
                if seedIt { stress_seed(); rebuild_content() }
            }
        }
        if shotPath != "" {
            win.setOverlay(func(Renderer r) { shot_overlay(r) })
        }
    }

    // 探针用的固定数据：18 首 + 本地封面、**不联网** ⇒ 每次重建的工作量恒定，能精确量净增量 ✓
    //   （真数据会随网络回信不断变化，内存曲线没法比）
    pri func stress_seed() {
        homeAsked = true
        homeLoading = false
        recentSongs = []
        newSongs = []
        recSongs = probe.stress_songs(18)     // 18 首测试歌（生成函数在 lib/probes.leno ✓）
    }

    // 自检：点一下「喜欢」（在没有演示数据之后，只验按钮状态切换 ✓）
    pri func demo_actions() {
        toggle_like()
    }

    // 叠加层：步数够了就存一张 PNG（在控件/弹层之后、present 之前 ✓）
    //   ⚠ **不能在这里 `_exit()`**：此刻还在渲染回调里、GPU 命令没提交，
    //   直接退出会让进程卡住或返回异常码 ⇒ 只记一个"几拍后退出"，交回 tick 处理 ✓
    pri func shot_overlay(Renderer r) {
        if shotPath == "" or steps < shotAt { return }
        var sz = win.getSize()
        var s = r.readPixelsAt(0, 0, sz.w, sz.h)
        if s != null {
            bool ok = SDL3.saveImagePNG(s, shotPath)
            // ★ 顺带打帧数：动画（头像自转/进度条）是否真的在跑，用"帧号 ÷ 时长"看 ✓
            print("[music] 截图 " + shotPath + " ok=" + _str(ok) + " 语音=" + _str(playing) +
                  " 帧=" + _str(SDL3.frameId()) +
                  " 内存=" + _str(Sys.processMemoryKb(Sys.currentPid())) + "KB")
        } else {
            print("[music] 读像素失败：" + SDL3.getError())
        }
        shotPath = ""                 // 只截一次
        shotExitAt = steps + 6        // 再走几拍（让 present 落地）才退出 ✓
    }
}

main() {
    Player p = new Player()
    p.run()
}
