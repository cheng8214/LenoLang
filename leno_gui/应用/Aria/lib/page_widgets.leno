// page_widgets.leno — 页面级小工具（纯函数，不碰 Player 状态）
//
// 拆分 `aria.leno` 的第一步：先把"与界面状态无关"的格式化/常量挪出来，
// 后面每个页面模块（pages/*.leno）都能直接用，不必各自复制一份。
//
// 规矩：这里的函数**只依赖参数与标准库**，不许引用 Player 的字段或方法 ✓
import strings
import "SDL3" as SDL3
import "../music_data.leno" as data
use data.Song
use SDL3.(HBox, Spinner, Label, Color, Canvas, Renderer, Widget)

// 颜色：与 aria.leno 的 C_TXT / C_TXT_DIM / C_ACCENT 同值
//   （本轮各模块自带一份，等全部页面搬完再统一收到 theme 模块，避免中途几百处引用一起改 ✗）
const Color TXT_MID = #6B5B63FF
const Color TXT_DIM = #77646DFF
const Color ACCENT = #E76F9BFF
const Color TRANS = #00000000

// 播放量：3689446 → "368.9万"（与参考图 "230.9万" 同一口径 ✓）
export func fmt_wan(string v): string {
    int n = _int(v)
    if n >= 10000 { return _str(n / 10000) + "." + _str((n % 10000) / 1000) + "万" }
    return _str(n)
}

// "03:45" → 225 秒（算总时长用；解析不了就 0）
//   ⚠ 必须容错：`formatduration(0)` 会给出 **"-"** 这种串（备用音源的搜索结果
//     常常没带时长），而 `_int("-")` 在运行期直接抛错、整个页面崩掉 ✗
//   ⇒ p<1（冒号在开头 / 没有冒号）一律当 0；整段用 try 兜底 ✓
export func dur_secs(string d): int {
    if d == "" { return 0 }
    try {
        int p = strings.byte_find(d, ":", 0)
        if p < 1 { return 0 }
        string ms = strings.byte_slice(d, 0, p - 1)
        string ss = strings.byte_slice(d, p + 1, d.len() - 1)
        // 非纯数字（"-" / "  " 之类）直接放弃，别让 _int 抛错 ✓
        if ms == "" or ms == "-" or ss == "" or ss == "-" { return 0 }
        return _int(ms) * 60 + _int(ss)
    } catch e {
        return 0
    }
}

// 卡片墙拉哪些榜：挑 12 个常用榜（`kuwo.bangmenu()` 里一共 31 个，全拉要 31 个请求）
//   每榜只要前 4 首 ⇒ 12 个请求串行约 5 秒；再多就把首屏拖慢了
export func rank_bids(): Array[string] {
    return ["16", "93", "17", "104", "182", "22",
            "183", "184", "242", "278", "26", "64"]
}

export func rank_names(): Array[string] {
    return ["热歌榜", "飙升榜", "新歌榜", "华语榜", "粤语榜", "欧美榜",
            "日语榜", "韩语榜", "电音榜", "古风榜", "经典怀旧", "影视金曲"]
}

// 「正在加载…」行：Spinner + 文案（与首页 `loading_row` 同一套观感 ✓）
//   `w` 传内容区宽度（原来直接从 cardSize 取，抽走后由调用方给）
export func loading_row(string text, float w): HBox {
    HBox row = SDL3.createHBox({x: 0, y: 0, w: w, h: 40,
                                pad_x: 0, pad_y: 0, spacing: 12, justify: 1})
    row.add(SDL3.createSpinner({size: 22, thickness: 2.5, color: ACCENT,
                                track_color: #F6DCE5FF, running: true}),
            {grow: 0, shrink: 0, basis: 22, align: 1})
    row.add(SDL3.createLabel({text: text, font_size: 12.5, text_color: TXT_MID}),
            {grow: 0, shrink: 0, align: 1})
    return row
}

// 序号列里那枚**圆形播放钮**（淡紫圆 + 主色三角）
//   搜索 / 本地 / 下载 / 榜单 / 歌单 五张表都用同一套 ⇒ 只在这里画一次 ✓
export func play_dot(func():void onClick): Canvas {
    Canvas cv = SDL3.createCanvas({x: 0, y: 0, w: 26, h: 26, pad: 0,
                                   bg_color: TRANS, border: false})
    cv.on_draw(func(Renderer rr, float ox, float oy, float cw2, float ch2) {
        float d = 26.0
        if d > cw2 { d = cw2 }
        if d > ch2 { d = ch2 }
        float bx0 = ox + (cw2 - d) / 2.0
        float by0 = oy + (ch2 - d) / 2.0
        rr.setColor(#DCCBF2FF)
        rr.fillRoundedRect(bx0, by0, d, d, d / 2.0)
        rr.setColor(ACCENT)
        float s3 = d * 0.30
        float px0 = bx0 + d / 2.0 - s3 * 0.38
        float py0 = by0 + d / 2.0 - s3 * 0.72
        rr.drawLine(px0, py0, px0, py0 + s3 * 1.44)
        rr.drawLine(px0, py0, px0 + s3 * 1.24, py0 + s3 * 0.72)
        rr.drawLine(px0, py0 + s3 * 1.44, px0 + s3 * 1.24, py0 + s3 * 0.72)
    })
    cv.on_click(func(float cx2, float cy2, int btn2) { if btn2 == 1 { onClick() } })
    return cv
}

// 序号列：数字（默认）/ 播放钮（悬停时）
//   返回 [数字行, 播放钮]，调用方按 hovered 二选一 ✓
export func number_cell(int idx, int rowH, func():void onPlay): Array[Widget] {
    string txt = if idx + 1 < 10 then "0" + _str(idx + 1) else _str(idx + 1)
    HBox nb = SDL3.createHBox({x: 0, y: 0, w: 60, h: _float(rowH),
                               pad_x: 0, pad_y: 0, spacing: 0, justify: 1})
    nb.add(SDL3.createLabel({text: txt, font_size: 12.5, text_color: TXT_DIM}),
           {grow: 0, shrink: 0, basis: 20, align: 1})
    Array[Widget] out = []
    out.add(nb)
    out.add(play_dot(onPlay))
    return out
}

// 音质档位：返回 "无损" / "HQ" / "标准" / ""（空 = 不显示）
//   ① 优先用接口给的 `ext`（flac / ape / wav = 无损；mp3 再按码率分）
//   ② 没有 ext 就用「字节数 ÷ 时长」算码率兜底
//   `dur` 是 "4:29" 这种文本，先换成秒
export func quality_of(Song sg): string {
    // ★ 有体积就**按码率分档**（唯一可靠的口径）：
    //   ffapi 的 `level` 标签是错的（实测 exhigh 也标"无损(SQ)"），
    //   但体积不会骗人 —— 60MB 的 flac 和 115MB 的母带必须区分开 ✓
    int sec = dur_secs(sg.dur)
    if sg.sizeBytes > 0 and sec > 0 {
        int kbps = _int(_float(sg.sizeBytes) * 8.0 / _float(sec) / 1000.0)
        if kbps >= 2000 { return "超清母带" }   // jymaster 那档（115MB / 6:00 ≈ 2560k）
        if kbps >= 900 { return "无损" }
        if kbps >= 320 { return "HQ" }
        if kbps >= 192 { return "标准" }
        return ""
    }
    // 没体积时退回只看格式（能判"无损"，但分不出母带）
    string e = sg.ext
    if e == "flac" or e == "ape" or e == "wav" or e == "FLAC" or e == "APE" or e == "WAV" {
        return "无损"
    }
    return ""
}

// 音质小标签（矩形底 + 文字）：无损 = 主色，HQ = 浅粉，标准 = 灰
//   ⚠ 调用方必须先用 `quality_of(sg) != ""` 判一下（这里返回非空 HBox，不返回 null ✓）
export func quality_tag(Song sg, float h): HBox {
    string q = quality_of(sg)
    if q == "" { q = "标准" }        // 兜底（正常不会被调到）
    // 宽度：汉字按 10px/字、字母按 8px/字估；再加左右各 5 的内边距
    float tw = 16.0
    if q == "超清母带" { tw = 40.0 }
    else if q == "无损" { tw = 20.0 }
    float w = tw + 10.0
    Color bgc = ACCENT                       // 无损：主色
    if q == "超清母带" { bgc = #C94C7AFF }    // 更深一档，与「无损」区分开 ✓
    else if q == "HQ" { bgc = #F09CB8FF }
    else if q == "标准" { bgc = #B8A9B0FF }
    HBox box = SDL3.createHBox({x: 0, y: 0, w: w, h: h, pad_x: 5, pad_y: 0,
                                spacing: 0, bg_color: bgc, bg_radius: h / 2.0, justify: 1})
    box.add(SDL3.createLabel({text: q, font_size: 9.5, text_color: #FFFFFFFF}),
            {grow: 0, shrink: 0, align: 1})
    return box
}

// 搜索过滤（关键词空 = 全通过 ✓）
export func match_items(Array[Song] src, string filter): Array[Song] {
    if filter == "" { return src }
    Array[Song] out = []
    for 0 : src.len() - 1 to i {
        if strings.has(src[i].title, filter) or strings.has(src[i].artist, filter) {
            out.add(src[i])
        }
    }
    return out
}
