// net_workers.leno — 后台线程入口（搜索 / 首页分区 / 封面分片）
// ----------------------------------------------------------------------------
// 为什么单独一个文件：这些函数要在**工作线程**里跑，规矩和 UI 完全不同：
//   · 入口必须是**模块级函数**（不能是 self 的方法）——闭包会捕获 self，跨线程克隆会炸
//   · 参数只用纯值 + Channel；结果一律 `ch.send(...)`
//   · 绝不碰 Renderer / 控件 / 全局 UI 状态
// UI 侧在 `on_tick` 里用 `try_receive()` 非阻塞排空（**不要** threads.select，那是阻塞接收）。
//
// 协议（都是 Array[Array[string]]）：
//   搜索：   ["OK",""] / ["ERR",原因]  + 数据行 [歌名,歌手,专辑,时长秒,格式,体积,id]
//   首页：   ["REC",""] …数据行… ["NEW",""] …数据行…   （失败 ["ERR",原因]）
//   封面：   ["REC"] 之外的普通消息是 [id, 本地路径]
import "web_net" as net
import "kuwo_core.leno" as kuwo
import "kuwo_playlist.leno" as plq      // 歌单（推荐列表 / 详情）
import dirs
import files
import "kuwo_lyric.leno" as klyr      // 官方 newlyric 接口（逐字 lrcx=1 优先 ✓，移植自 LenoMusic）
import "kuwo_cover.leno" as cover
import "ffapi_core.leno" as ff        // 飞飞解析站（高音质试听 / 下载 ✓）
import strings
import dirs
import files

// ==================== 播放前准备音源（★ 2026-10-26）====================
// 为什么放线程：`play_sid` 原来在 UI 线程里「取直链 + 下载试听」，一首 1–3 秒，
//   点播放整个窗口就卡住
// 回信：["OK", 本地路径, id] / ["ERR", 原因, id]
//   quality：standard（128k）/ high（320k）/ lossless（flac）—— 来自设置里的「试听音质」✓
export func prepare(string id, string cacheDir, string quality, Channel ch) {
    if id == "" {
        ch.send(["ERR", "没有音源 id", ""])
        return
    }
    // 目标扩展名由音质决定（无损落 .flac，其余 .mp3）⇒ 缓存文件名也带这个后缀
    bool lossless = quality == "lossless"
    string ext = if lossless then ".flac" else ".mp3"
    string f = dirs.join(cacheDir, id + ext)
    // 已缓存 ⇒ 立刻回信（UI 那边只是 createSound，很快 ✓）
    // ⚠ 回信第 3 项带 **id**：用户连点两首时，UI 靠它丢弃过期回信（别把 A 的路径贴给 B ✓）
    if files.exists(f) {
        ch.send(["OK", f, id])
        return
    }
    // 另一种格式的旧缓存在 ⇒ 直接复用（切片换音质时不必重新下载 ✓）
    string alt = dirs.join(cacheDir, id + (if lossless then ".mp3" else ".flac"))
    if files.exists(alt) {
        ch.send(["OK", alt, id])
        return
    }
    try { dirs.mkdir_p(cacheDir) } catch e { print("[play] 建缓存目录失败：" + _str(e)) }

    // 候选档位顺序：无损先 flac；标准先 128k；高品先 320k —— 后面都留兜底 ✓
    Array[string] cands = ["mp3", "mp3128", "flac"]
    if lossless { cands = ["flac", "mp3", "mp3128"] }
    else if quality == "standard" { cands = ["mp3128", "mp3", "flac"] }

    string u = ""
    string gotExt = ext
    try {
        var c = net.createClient()
        for cands to fm {
            u = kuwo.officialurl(id, fm)
            if u != "" {
                gotExt = if fm == "flac" then ".flac" else ".mp3"
                break
            }
        }
        if u == "" {
            u = kuwo.getdirecturl(c, id)
            gotExt = ".mp3"
        }
        c.close()
    } catch e {
        ch.send(["ERR", "取直链失败：" + _str(e), id])
        return
    }
    if u == "" {
        ch.send(["ERR", "取不到音源", id])
        return
    }
    string target = dirs.join(cacheDir, id + gotExt)
    bool ok = false
    try { ok = net.download(u, target) > 0 } catch e { ok = false }
    if ok and files.exists(target) { ch.send(["OK", target, id]) }
    else { ch.send(["ERR", "下载试听失败", id]) }
}

// 一行数据（统一在这里拼，避免三处各写一遍 ✓）
func row(kuwo.SongInfo s): Array[string] {
    return [s.name, s.artist, s.album, _str(s.duration), s.ext, s.sizeText, s.id]
}

// 搜索线程
export func search(string kw, int limit, Channel ch) {    Array[Array[string]] out = []
    try {
        var c = net.createClient()
        var list = kuwo.search(c, kw, limit)
        c.close()
        out.add(["OK", ""])
        for list to s {
            if s.valid() { out.add(row(s)) }
        }
    } catch e {
        out = []
        out.add(["ERR", _str(e)])
    }
    ch.send(out)
}

// 排行榜：按榜单 id 取前 n 首（走酷我老接口 ksong.s，免登录免签名 ✓）
//   回信格式与搜索一致：第一条 [bid, ""]，之后每首一行 row(s)
export func bang(string bid, int limit, Channel ch) {
    Array[Array[string]] out = []
    try {
        var c = net.createClient()
        out.add([bid, ""])
        var a = kuwo.bang(c, bid, limit)
        for a to s {
            if s.valid() { out.add(row(s)) }
        }
        c.close()
    } catch e {
        out = []
        out.add(["ERR", _str(e)])
    }
    ch.send(out)
}

// 高音质音源搜索（独立音源，**不和酷我混在一个列表** ✓）
//   `levels`：试听要取的档位顺序，由调用方按**设置里的音质**传进来
//     · standard  → [standard, exhigh]
//     · high      → [exhigh, lossless]
//     · lossless  → [lossless, hires, jymaster]
//   渐进回信：**每解析完一条就 send 一行**，UI 边收边显示（不用等 10 条全好 ✓）
//   全部结束：send [["DONE"]]
//   ⚠ 站方对没版权的档返回空 url ⇒ `music_best` 会依次试下一个 ✓
//   行格式：[歌名, 歌手, 专辑, 秒, ext, 体积文本, id, 档位, 直链, 歌词, 本地封面路径]
//   ★ 一次 `music` 请求就带回 **直链 + 体积 + 歌词 + 封面** —— 不用再回填一轮 ✓
//   慢（每条一次请求，10 条约 10 秒），但渐进回信、边收边显示 ✓
export func ffsearch(string kw, int n, Array[string] levels, string coverDir, Channel ch) {
    // ★★ **攒完再一次性发**：原来每条 `ch.send` ⇒ aria 收到第一条就把
    //   `searching` 设 false 并重建表格 ⇒ 界面上一行行往外蹦 ✗
    //   用户要的是"全部解析完、一次性出结果" ✓
    Array[Array[string]] out = []
    try {
        var c = ff.newClient()
        var hits = ff.search(c, kw, n)
        Array[string] order = levels
        if order.len() == 0 { order = [ff.LEVEL_EXHIGH, ff.LEVEL_LOSSLESS] }
        int done = 0
        for hits to h {
            if done >= 10 { break }              // 默认最多 10 首 ✓
            done = done + 1
            // h = [id, 名, 歌手, 专辑, 秒, picUrl]
            var p = ff.music_best(c, h[0], order)
            if not p.valid() { continue }
            // 封面：**搜索响应就给了 picUrl** ⇒ 先按它下；没有再用 music 响应里的 ✓
            string cov = ""
            string picUrl = h[5]
            if picUrl == "" { picUrl = p.pic }
            if picUrl != "" {
                string cp = dirs.join(coverDir, "ff_" + h[0] + ".jpg")
                if files.exists(cp) {
                    cov = cp
                } else {
                    try {
                        dirs.mkdir_p(coverDir)
                        net.download(picUrl, cp)
                        cov = cp
                    } catch e {
                        cov = ""
                    }
                }
            }
            out.add([h[1], h[2], h[3], h[4], p.ext(), p.size, h[0], p.level, p.url,
                     p.lyric, cov])
        }
        c.close()
    } catch e {
        out = [["ERR", _str(e)]]
    }
    // 空结果也要明确回一条（否则界面永远停在"正在解析" ✗）
    if out.len() == 0 { out = [["EMPTY"]] }
    ch.send(out)
}

// 网易云搜索（**快**：一次请求回整页，不用逐条解析 ✓）
//   回信每行：[歌名, 歌手, 专辑, 秒, 扩展名, 体积文本, id, 档位, 直链(空)]
//   `直链` 这里恒为空 —— 试听/下载时才用 ffapi 按需解析（网易云直连不能下载 ✗）
//   大小/格式来自搜索响应的最高档（hr > sq > h > m > l），不用额外请求 ✓

// 搜索**之后**回填真实最高档体积（网易云搜索只给 320k 的大小 ✗）
//   逐条解析 `jymaster → lossless`，**每好一条就回一条**：[id, ext, 体积文本]
//   慢（每首 1~2 次请求），但渐进回填，列表能一条条变 ✓
//   拿不到的（没版权/免费曲）不发 ⇒ 保持原样
//   回信：[id, ext, 体积文本, 本地封面路径(空=没拿到)] —— 每好一条回一条
//   封面顺手在这里下：`Parsed.pic` 是网易云封面 URL，下到 coverDir 后回本地路径 ✓
//   （列表里先显示占位图，封面到了再贴上，不用等整页 ✓）
export func ffsizes(Array[string] ids, string coverDir, Channel ch) {
    if ids.len() == 0 { ch.send([["DONE"]]); return }
    try {
        var c = ff.newClient()
        for ids to id {
            var p = ff.music_best(c, id, [ff.LEVEL_JYMASTER, ff.LEVEL_LOSSLESS])
            if not p.valid() { continue }
            // 封面：已经有缓存就复用，没有就下（失败不影响其它字段 ✓）
            string cov = ""
            if p.pic != "" {
                string cp = dirs.join(coverDir, "ne_" + id + ".jpg")
                if files.exists(cp) {
                    cov = cp
                } else {
                    try {
                        dirs.mkdir_p(coverDir)
                        net.download(p.pic, cp)
                        cov = cp
                    } catch e {
                        cov = ""
                    }
                }
            }
            if p.size != "" or cov != "" {
                ch.send([[id, p.ext(), p.size, cov]])
            }
        }
        c.close()
    } catch e {
        ch.send([["ERR", _str(e)]])
    }
    ch.send([["DONE"]])
}

// 按指定的音质档解析直链（**试听 / 下载共用**，只是 levels 不同）
//   试听：按设置音质（standard / high / lossless）
//   下载：固定最高（jymaster → hires → lossless）
//   回信：[[歌名, 歌手, 专辑, 秒, 扩展名, 体积文本, id, 档位, 直链, 歌词, 封面URL]] 或 [["ERR", …]]
//   ★ 2026-10-30：末尾补 **歌词 / 封面**（解析站的 music 响应本来就带着）——
//     下载完成后的"存 .lrc / 存封面 / 内嵌"全靠这两项，不然设置里那几个开关对小易形同虚设 ✗
export func ffplay(string id, string name, string artist, string album, int dur,
                   Array[string] levels, Channel ch) {
    Array[Array[string]] out = []
    try {
        var c = ff.newClient()
        var p = ff.music_best(c, id, levels)
        c.close()
        if p.valid() {
            out.add([name, artist, album, _str(dur), p.ext(), p.size, id, p.level, p.url,
                     p.lyric, p.pic])
        } else {
            out.add(["ERR", "该曲目没有可用的音质版本"])
        }
    } catch e {
        out.add(["ERR", _str(e)])
    }
    ch.send(out)
}

// 备用音源的直链 → 下到指定文件（`path` 由调用方拼好，扩展名跟着解析结果走 ✓）
//   回信：[["OK", 路径]] 或 [["ERR", 原因]]
//   ⚠ 直链有时效：失败时调用方应**重新解析一次**再试，别直接报错
//   ★ 分片下载（每 1MB 发一条进度）：`net.download` 是一次性整文件拿，
//     中间毫无反馈 ⇒ 界面只能从 0 直接跳到 100% ✗
//   回信：["P", 已下字节, 总字节, 路径]（多次）→ 最后 ["OK", 路径] 或 ["ERR", 原因]
//   ★ 2026-10-30：进度回信补上**路径** —— 界面层用它反查是哪一条任务（`urlTarget`
//     是单槽，连着下多首时会被后一首覆盖 ⇒ 进度/完成状态会打到错的行上 ✗）
//   ⚠ 服务端不认 Range 时（返回整包）第一片就下完 ⇒ 自动 break ✓
const int FF_SHARD = 1048576

func ff_total_of(string cr): int {
    var p = strings.split(cr, "/")
    if p.len() < 2 { return 0 }
    return _int(strings.trim(p[1]))
}

// ★ 2026-10-30：加 `ctl`（可空）—— 界面点「暂停」时发一条命令过来，
//   每片开始前收一次 ⇒ 真的停手（原来没有这个通道，"暂停"只是改了个状态字，
//   线程照样下到底，用户点了继续又从头排一遍，才会出现"瞬间下好 + 变成 mp3" ✗）
export func fetch_url(string url, string path, Channel ch, Channel? ctl = null) {
    if url == "" {
        print("[net] fetch_url 收到空直链（调用方没把 sg.url 传进来）")
        ch.send([["ERR", "直链为空", path]])
        return
    }
    string acc = ""
    int off = 0
    int total = 0
    int guard = 0
    // ★★ 整个下载**只建一个客户端**：
    //   原来每片都 `createClient()` + `close()` ⇒ 100MB 要建 100 次，
    //   框架对客户端实例数有上限 ⇒ 抛「回调次数已上限 / createClient 失败」，
    //   而且会把名额占满，害得**别的功能**（榜单加载）也创建失败 ✗（实测症状）
    var c = net.createClient()
    while guard < 2000 {                       // 防死循环（2GB 顶天 ✓）
        guard = guard + 1
        // ① 暂停检查（每片前一次）：收到命令就关客户端、回 "Z" 收工 ✓
        if ctl != null {
            var cmd = ctl.try_receive()
            if cmd != null {
                try { c.close() } catch e0 { print("[net] 暂停时关客户端失败：" + _str(e0)) }
                ch.send([["Z", _str(off), _str(total), path]])
                return
            }
        }
        string chunk = ""
        int crTotal = 0
        try {
            // 每片重设头：`replaceHeaders` 是**覆盖**（`addHeaders` 会叠加成两个 ✗）
            c.replaceHeaders(["Range: bytes=" + _str(off) + "-" + _str(off + FF_SHARD - 1)])
            var r = c.get(url)
            if not r.ok() {
                print("[net] 第 " + _str(guard) + " 片请求失败（ok=false，off=" + _str(off) + "）")
                break
            }
            crTotal = ff_total_of(r.getHeader("Content-Range"))
            chunk = r.rawBody()
        } catch e {
            print("[net] 第 " + _str(guard) + " 片抛异常：" + _str(e))
            break
        }
        int n = chunk.byte_len()
        if n <= 0 {
            print("[net] 第 " + _str(guard) + " 片拿到 0 字节（off=" + _str(off)
                  + " 响应 ok / Content-Range 已取）⇒ 停止")
            break
        }
        acc = acc + chunk
        off = off + n
        if total <= 0 and crTotal > 0 { total = crTotal }
        // ⚠ 不要在这里 print 每片进度：一首无损近百片 ⇒ 控制台被刷屏（2026-10-30 移除 ✓）
        //   进度本来就走 `ch.send` 回给界面（下载列表里那根进度条），日志没有额外价值
        ch.send([["P", _str(off), _str(total), path]])
        if total > 0 and off >= total { break }
        if n < FF_SHARD { break }              // 没按 Range 给 ⇒ 已拿全
    }
    try { c.close() } catch e1 { print("[net] 关客户端失败：" + _str(e1)) }   // 用完才关（break 也会走到这里 ✓）
    if off <= 0 {
        // ★ 分片一片都没成 ⇒ **退回整文件下载**（能拿到就行，进度没了但别让功能死）
        //   常见原因：服务端不认 Range、`replaceHeaders` 把 UA 覆盖掉被拒、直链过期 ✓
        print("[net] 分片下载失败，改用整文件下载：" + path)
        try {
            net.download(url, path)
            ch.send([["OK", path]])
        } catch e2 {
            ch.send([["ERR", "下载失败：" + _str(e2), path]])
        }
        return
    }
    try {
        files.write(path, acc)
    } catch e {
        // ★ 这里失败过（目录不存在之类）⇒ 报 ERR 被上层当成"直链失效"，很误导
        print("[net] 写盘失败：" + _str(e) + "   路径=" + path + "   字节=" + _str(acc.byte_len()))
        ch.send([["ERR", "写盘失败：" + _str(e), path]])
        return
    }
    // 成功这条也不打日志：界面已经有"下载完成"的系统通知 + 列表状态（2026-10-30 移除 ✓）
    ch.send([["OK", path]])
}

// 推荐歌单（发现页「精选」卡片墙）：拉列表 + 每张封面下到 cacheDir
//   回信每行：[id, 名称, 本地封面路径(空=没下到), 播放量, 曲目数, 作者]
//   `page` 从 1 开始 —— 滚到底"加载更多"时传 2、3…（接口支持 pn 翻页 ✓）
export func playlists(int page, int n, string cacheDir, Channel ch) {
    Array[Array[string]] out = []
    try {
        var c = net.createClient()
        plq.prepare(c)
        var lists = plq.recommend(c, page, n)
        for lists to p {
            string local = ""
            if p.img != "" {
                local = dirs.join(cacheDir, "pl_" + p.id + ".jpg")
                if not files.exists(local) {
                    try { net.download(p.img, local) } catch e { local = "" }
                }
            }
            out.add([p.id, p.name, local, _str(p.plays), _str(p.total), p.author])
        }
        c.close()
    } catch e {
        out = []
        out.add(["ERR", _str(e)])
    }
    ch.send(out)
}

// 歌单里的歌（点卡片进详情）：回信每行 [sid, 歌名, 歌手, 专辑, 时长秒]
export func playlistsongs(string pid, int n, Channel ch) {
    Array[Array[string]] out = []
    try {
        var c = net.createClient()
        plq.prepare(c)
        var songs = plq.songs(c, pid, n)
        for songs to s {
            out.add([s.id, s.name, s.artist, s.album, _str(s.duration)])
        }
        c.close()
    } catch e {
        out = []
        out.add(["ERR", _str(e)])
    }
    ch.send(out)
}

// 排行榜**卡片墙**：一次拉多个榜的前 per 首（每榜一个请求，串行 6 个约 2~3 秒）
//   回信每行：`[bid, "榜名", "首曲封面 id", "歌1", "歌2", ...]`
//   封面 id 用来给卡片左上的大图（拉不到时上层用占位图 ✓）
export func bangcards(Array[string] bids, Array[string] names, int per, Channel ch) {
    Array[Array[string]] out = []
    try {
        var c = net.createClient()
        for 0 : bids.len() - 1 to i {
            var a = kuwo.bang(c, bids[i], per)
            string lead = ""
            Array[string] line = [bids[i], names[i]]
            for a to s {
                if not s.valid() { continue }
                if lead == "" { lead = s.id }
                // 每首编码成 `sid \u001F 显示文本`：上层要能**点歌名直接播放**，
                //   没有 sid 就只能进榜单、播不了这一首 ✓
                line.add(s.id + "\u001F" + s.name + " — " + s.artist)
            }
            // 第三格插封面 id（放在榜名之后，歌曲之前）
            if line.len() >= 2 { line[1] = names[i] }
            Array[string] full = [line[0], line[1], lead]
            for 2 : line.len() - 1 to k { full.add(line[k]) }
            out.add(full)
        }
        c.close()
    } catch e {
        out = []
        Array[string] err = ["ERR", _str(e)]
        out.add(err)
    }
    ch.send(out)
}

// 只刷**一个**分区：kind = "REC"（为你推荐）/ "NEW"（最近添加）
//   协议与 `sections` 一致：[[kind,""], 数据行…] ⇒ apply_sections 能直接吃 ✓
//   为什么不复用 `search`：它发的是 ["OK"]，没有分区标记 ⇒ apply_sections 解析不到 ✗
export func section(string kind, string kw, int n, Channel ch) {
    Array[Array[string]] out = []
    try {
        var c = net.createClient()
        out.add([kind, ""])
        var a = kuwo.search(c, kw, n)
        for a to s {
            if s.valid() { out.add(row(s)) }
        }
        c.close()
    } catch e {
        out = []
        out.add(["ERR", _str(e)])
    }
    ch.send(out)
}

// 首页两个分区（为你推荐 / 最近添加）：只搜两次，封面交给 cover_shard 并行拉
//   两个分区的数量**分开传，由调用方按列数算**（为你推荐 = 列数×6 行，最近添加 = 列数×2 行）
export func sections(string kwRec, string kwNew, int nRec, int nNew, Channel ch) {
    Array[Array[string]] out = []
    try {
        var c = net.createClient()
        out.add(["REC", ""])
        var a = kuwo.search(c, kwRec, nRec)
        for a to s {
            if s.valid() { out.add(row(s)) }
        }
        out.add(["NEW", ""])
        var b = kuwo.search(c, kwNew, nNew)
        for b to s {
            if s.valid() { out.add(row(s)) }
        }
        c.close()
    } catch e {
        out = []
        out.add(["ERR", _str(e)])
    }
    ch.send(out)
}

// 封面分片：拿一小批 id，取到一张就回一条 [id, 路径]
//   分片是照 LenoMusic 的 dl_entry_shard(jobs, …, shard, nshards) 思路：
//   每张封面要一个详情页（~150 KB），串行 12 张要十几秒，分 3 片约 1/3 ✓
export func cover_shard(Array[string] ids, string cacheDir, Channel ch) {
    // ⚠ 去重：同一 sid 出现在多个列表里时，两个线程会**同时写同一个文件** ⇒ 内容交错、
    //   解出来只剩左上角一块（"封面加载不出来"的元凶之一 ✗）
    Array[string] seen = []
    for ids to id {
        if id == "" { continue }
        bool dup = false
        for seen to sn { if sn == id { dup = true } }
        if dup { continue }
        seen.add(id)
        string p = cover.cover_of(id, cacheDir)
        if p != "" {
            Array[string] one = [id, p]
            ch.send(one)
        }
    }
}

// ==================== 歌词（★ 2026-10-27，v2）====================
// 回信：Array[string]（每行 "秒|文本"）—— 失败也回数组，但首行是 ["ERR", 原因] 便于上层区分 ✓

// ==================== 歌词（★ 2026-10-27 重做：移植 LenoMusic 的官方 newlyric 接口）====================
// 回信：Array[string]，**只有一条** = 整份歌词文本（"秒|文本" 那套作废 ✗）
//   · 先试逐字版（lrcx=1，带 <起点,时长> 标签）⇒ 有就用 ✓
//   · 逐字解不出来 ⇒ 退回标准 LRC ✓（LenoMusic 的既有规矩：绝不把歌词搞没）
//   · 两次都失败 ⇒ 回空数组（UI 显示"没有歌词"）
export func lyric(string sid, Channel ch) {
    Array[string] out = []
    try {
        string txt = klyr.fetchlyric_lrcx(sid)
        bool word = txt != ""
        if txt == "" { txt = klyr.fetchlyric(sid) }
        if txt != "" { out.add(txt) }
        print("[lyric-worker] sid=" + sid + " 逐字=" + _str(word) + " 字节=" + _str(txt.byte_len()))
    } catch e {
        out = []
        print("[lyric-worker] 异常：" + _str(e))
    }
    ch.send(out)
}

// ==================== 手动「搜索歌词」（★ 2026-10-30）====================
// 什么时候用：自动取歌词失败（本地文件没 sid / 接口没返回 / 缓存里没有）⇒ 歌词页那颗按钮兜底。
//   两个来源依次试：**小酷（酷我）→ 网易云（飞飞解析站）**，谁先有就用谁。
// 回信（**只有一条**）：["OK", 来源, 歌词文本] / ["ERR", 原因]
//   来源值 = "小酷" / "网易云"（UI 拿它做提示，用户知道歌词是从哪捞的 ✓）
export func lyric_find(string title, string artist, string kuwoSid, Channel ch) {
    Array[string] out = []
    string t = title.trim()
    if t == "" {
        out.add("ERR")
        out.add("不知道歌名，搜不了歌词")
        ch.send(out)
        return
    }
    string a = artist.trim()
    string kw = if a == "" then t else (t + " " + a)

    // ---------- ① 小酷：有 rid 直接取；没有就按"歌名 歌手"搜一首最像的 ----------
    try {
        string ksid = kuwoSid
        if ksid == "" {
            var kc = net.createClient()
            var hits = kuwo.search(kc, kw, 5)
            kc.close()
            // 歌名完全相同的优先（搜索结果里常混进翻唱/伴奏）；都没有就取第一条（按相关度排 ✓）
            for hits to h {
                if h.valid() and h.name == t { ksid = h.id; break }
            }
            if ksid == "" and hits.len() > 0 and hits[0].valid() { ksid = hits[0].id }
        }
        if ksid != "" {
            string txt = klyr.fetchlyric_lrcx(ksid)          // 逐字优先
            if txt == "" { txt = klyr.fetchlyric(ksid) }     // 退回标准 LRC
            if txt != "" {
                out.add("OK")
                out.add("小酷")
                out.add(txt)
                ch.send(out)
                return
            }
        }
    } catch e {
        print("[lyric-find] 小酷失败：" + _str(e))
    }

    // ---------- ② 网易云（飞飞解析站）：搜一首 → 解析响应里自带 lyric ----------
    try {
        var fc = ff.newClient()
        var rows = ff.search(fc, kw, 5)          // 每行 [id, 歌名, 歌手, 专辑, 秒]
        string nid = ""
        for rows to r {
            if r.len() >= 2 and r[1] == t { nid = r[0]; break }
        }
        if nid == "" and rows.len() > 0 and rows[0].len() >= 1 { nid = rows[0][0] }
        if nid != "" {
            var p = ff.music(fc, nid, ff.LEVEL_STANDARD)
            if p.lyric != "" {
                fc.close()
                out.add("OK")
                out.add("网易云")
                out.add(p.lyric)
                ch.send(out)
                return
            }
        }
        fc.close()
    } catch e2 {
        print("[lyric-find] 网易云失败：" + _str(e2))
    }

    out.add("ERR")
    out.add("小酷和网易云都没有找到歌词")
    ch.send(out)
}

// ==================== 按 id 反查歌曲信息（2026-10-31）====================
// 干什么：老版本收藏只存了 id（library.json 里 `likes` 是纯 id 列表），歌名/歌手全丢了。
//   这里按 id 去查一次，能把**网易云 id**（小易那套）的歌名/歌手/封面补回来。
//
// 回信：Array[string] = [id, 歌名, 歌手, 封面URL, "ff"]；查不到就只回 [id]（长度 1）
//   ⇒ 上层按长度区分，不用额外通道传错误 ✓
//
// ⚠ 酷我 id 补不了：`www.kuwo.cn/api/www/music/musicInfo` 现在一律回
//   `{"success":false,"message":"The request is illegal!"}`（带 kw_token/csrf 也一样，实测 2026-10-31），
//   而取直链的 antiserver 只给 url、不给元数据 ⇒ 只能让它在界面上显示「未知歌曲 <id>」占位。
export func id_info(string id, Channel ch) {
    Array[string] out = [id]
    if id != "" {
        try {
            var c = ff.newClient()
            var p = ff.music(c, id, ff.LEVEL_STANDARD)
            c.close()
            if p.valid() and p.name != "" {
                out = [id, p.name, p.artist, p.pic, "ff"]
            }
        } catch e {
            print("[idinfo] 反查失败 " + id + "：" + _str(e))
        }
    }
    ch.send(out)
}
