// downloads.leno — 下载与本地曲库（不碰界面，可在任何线程里调用）
// ----------------------------------------------------------------------------
// 口径照 LenoMusic：取直链 → 落盘，文件名 `<歌手> - <歌名>.<ext>`；
//   「本地音乐」页直接扫这个目录，**不再有任何演示数据** ✓
//
// 用法：
//   import "./lib/downloads.leno" as dl
//   bool ok = dl.save("661608480", "晴天", "周杰伦", root)      // 返回是否成功落盘
//   Array[Song] songs = dl.scan(root)                          // 扫已下载的
import "web_net" as net
import "kuwo_core.leno" as kuwo
import "kuwo_cover.leno" as cover          // 下载时顺带把封面落成同名 .jpg ✓
import "kuwo_lyric.leno" as kuwo_lyric     // 歌词（逐字优先，退回标准 LRC ✓）
import "Music" as audio                    // 标签读写走 LenoMusic 的 writeTag；时长读它的 decoder ✓
import "./ui_kit.leno" as ui                // fmtTime（秒 → mm:ss）
import "../music_data.leno" as data
import dirs
import files
import strings
import jsons
import "Sys" as Sys        // 打开目录 / 选中文件 / 删到回收站 —— 模块里本来就有，
                           //   不要再自己拼 `cmd /c start` 那套（跨平台分支白写一遍 ✗）
use data.Song

// ==================== 文件管理器相关（全部走 LenoSys，跨平台由它处理 ✓）====================
// 打开目录：Sys.openWith 在 Windows 上是 ShellExecute ⇒ 目录会用资源管理器打开 ✓
export func open_dir(string d): bool {
    if d == "" { return false }
    bool ok = true
    try { ok = Sys.openWith(d) } catch e { ok = false }
    return ok
}

// 在资源管理器里**选中**这个文件（Windows 走 explorer /select ✓）
export func reveal(string path): bool {
    if path == "" or not files.exists(path) { return false }
    bool ok = true
    try { ok = Sys.revealInFolder(path) } catch e { ok = false }
    return ok
}

// 删除结果：调用方要能区分"**文件本来就不在**"和"真删失败"（2026-10-30 ✓）
//   前者 = 列表是旧的（用户在资源管理器里删过）⇒ 刷新列表 + 提示一声就对了；
//   后者才是错误（被占用 / 无权限）⇒ 提示重试。
//   以前只有 bool ⇒ 两种情况都是"删除失败"，行还赖在列表里，用户没法清 ✗
export const int DEL_OK = 0
export const int DEL_GONE = 1        // 路径为空 / 文件已不存在
export const int DEL_FAIL = 2        // 提交到回收站失败

// 删掉一首本地歌（音频 + 同名封面）—— **进回收站**，误删还能捞回来 ✓
export func delete_one_result(Song sg): int {
    if sg.path == "" or not files.exists(sg.path) { return DEL_GONE }
    Array[string] targets = [sg.path]
    // 同名 .jpg 一起删（没有就算了 ✓）
    var dot = strings.split(sg.path, ".")
    if dot.len() >= 2 {
        string art = dot[0]
        for 1 : dot.len() - 2 to k { art = art + "." + dot[k] }
        art = art + ".jpg"
        if files.exists(art) { targets.add(art) }
    }
    var r = Sys.deleteToTrash(targets)
    // ⚠ 返回结构是 {ok, count, aborted, errors}（见 LenoSys/lib/Sys.leno 的 deleteToTrash）
    //   这里原来读的是老口径的 "moved" ⇒ **恒为 0** ⇒ 文件明明进了回收站却返回 false，
    //   调用方（行内删除钮 / 右键菜单）就不刷新 ⇒ 表现为"点了删除，列表里那行还在"（2026-10-30 实测 ✗）
    if not jsons.get_bool(r, "ok", false) { return DEL_FAIL }
    if jsons.get_int(r, "count", 0) <= 0 { return DEL_FAIL }
    return DEL_OK
}

// 老口径：只关心"删掉了没"（列表里其实已经没人用了，留着给外部/老调用点 ✓）
export func delete_one(Song sg): bool { return delete_one_result(sg) == DEL_OK }

// 清空下载目录里的音频/封面（子目录不动）；返回提交删除的个数
export func delete_all(string root): int {
    string d = dir_of(root)
    if not dirs.exists(d) { return 0 }
    Array[string] targets = []
    var names = dirs.listdir(d)
    for names to nm {
        string p = dirs.join(d, _str(nm))
        if dirs.is_dir(p) { continue }
        string ext = dirs.extname(p).to_lower()
        if ext != ".mp3" and ext != ".flac" and ext != ".wav" and ext != ".ogg" and ext != ".jpg" { continue }
        targets.add(p)
    }
    if targets.len() == 0 { return 0 }
    var r = Sys.deleteToTrash(targets)
    if not jsons.get_bool(r, "ok", false) { return 0 }     // 同上：键是 ok/count，不是 moved ✓
    return jsons.get_int(r, "count", 0)
}

// 下载目录：<缓存根>\downloads（目录名统一英文 ✓）
export func dir_of(string root): string { return dirs.join(root, "downloads") }

// 文件名里不能出现的字符一律换下划线（Windows：/ \ : * ? " < > | 及换行）
export func safe_name(string s): string {
    string out = s
    var bad = ["/", "\\", ":", "*", "?", "\"", "<", ">", "|", "\n", "\r", "\t"]
    for bad to b { out = out.replace(b, "_") }
    return out
}

// 封面文件名：与 mp3 **同名**、只换扩展名 ⇒ 扫目录时按文件名就能配对 ✓
export func art_of(string dir, string title, string artist): string {
    string d = dir_of(dir)
    return dirs.join(d, safe_name(artist + " - " + title) + ".jpg")
}

// 下载一首：id → `dir/<歌手> - <歌名>.mp3`；已存在直接算成功（不重复下）
//   顺便把封面也落到**同名 .jpg**（本地音乐列表要用它显示缩略图 ✓）
//   ⚠ 同步、几百 KB/s：一首 4–5 MB 约 1–3 秒，调用方自行决定要不要放线程
export func save(string id, string title, string artist, string dir): bool {
    if id == "" { return false }
    string d = dir_of(dir)
    dirs.mkdir_p(d)
    string f = dirs.join(d, safe_name(artist + " - " + title) + ".mp3")
    string art = art_of(dir, title, artist)
    if not files.exists(art) { cover.cover_to(id, art) }      // 封面失败不影响音频下载 ✓
    if files.exists(f) { return true }
    bool ok = false
    try {
        var c = net.createClient()
        // mp3 优先（实测可播）；再退 mp3128 / 官方兜底（flac 会几十 MB，不做默认）
        string u = kuwo.officialurl(id, "mp3")
        if u == "" { u = kuwo.officialurl(id, "mp3128") }
        if u == "" { u = kuwo.getdirecturl(c, id) }
        if u != "" { ok = net.download(u, f) > 0 }
        c.close()
    } catch e {
        print("[dl] 下载失败：" + _str(e))
        ok = false
    }
    if not ok and files.exists(f) {
        try { files.delete(f) } catch e { print("[dl] 清理半截文件失败：" + _str(e)) }
    }
    return ok and files.exists(f)
}

// ==================== 分片下载（带进度，给工作线程用）====================
//   照 LenoMusic 的做法（dl_engine.leno:595）：web_net 的 downloadResume 内部 NOPROGRESS=1
//   拿不到任何字节进度 ⇒ 自己发 `Range: bytes=a-b`，每片 1 MB 报一次进度 ✓
//   回信（Channel，Array[string]）：
//     ["P", 已下字节, 总字节]   进行中
//     ["D", 最终字节, 总字节]   完成
//     ["E", 原因, ""]           失败
const int SHARD = 1048576

// 从 "bytes 0-1048575/4575235" 里取总字节（没有就 0）
func total_of(string cr): int {
    var p = strings.split(cr, "/")
    if p.len() < 2 { return 0 }
    return _int(strings.trim(p[1]))
}

// 文件字节数（打不开 ⇒ 0）
func fsize(string path): int {
    if not files.exists(path) { return 0 }
    try {
        return files.read(path).byte_len()
    } catch e {
        return 0
    }
}

// 取一首的直链：偏好格式优先，另一档兜底（无损体积大，播放端两种都支持 ✓）
//   ★ 2026-10-30 抽成函数：直链**会过期**，下载中途失败时要能再取一次（见 save_shard 的重试 ✓）
func resolve_url(string id, bool losslessFirst): string {
    string u = ""
    try {
        var c0 = net.createClient()
        if losslessFirst {
            u = kuwo.officialurl(id, "flac")
            if u == "" { u = kuwo.officialurl(id, "mp3") }
        } else {
            u = kuwo.officialurl(id, "mp3")
            if u == "" { u = kuwo.officialurl(id, "flac") }
        }
        if u == "" { u = kuwo.officialurl(id, "mp3128") }
        if u == "" { u = kuwo.getdirecturl(c0, id) }
        c0.close()
    } catch e {
        print("[dl] 取直链异常：" + _str(e))
        return ""
    }
    return u
}

// tags 位标志：1 = 存同名 .lrc，2 = 把封面/歌词内嵌进音频文件（见 LenoMusic/lib/music_tag.leno ✓）
// ★ 2026-10-30：加 `ctl`（控制通道：UI 只发、worker 只 try_receive）⇒ 支持中途暂停；
//   下载改成**边下边写 `<base>.part`**：暂停 / 关窗 / 断网都留下已下部分，下次从 .part 续传 ✓
export func save_shard(string id, string title, string artist, string root, string prefer, int tags,
                        Channel ch, Channel ctl): bool {
    if id == "" {
        ch.send(["E", "没有音源 id", ""])
        return false
    }
    string d = dir_of(root)
    dirs.mkdir_p(d)
    // 扩展名必须按**实际取到的直链格式**定，不能按"偏好"写死 ✗
    //   之前 prefer=lossless 就固定写 .flac，即使 flac 取不到、退到 mp3 也照样叫 .flac
    //   ⇒ 列表显示 MP3、磁盘上是 flac（或反过来）的错乱
    string base = dirs.join(d, safe_name(artist + " - " + title))
    string art = art_of(root, title, artist)
    if not files.exists(art) { cover.cover_to(id, art) }     // 封面失败不影响下载 ✓
    // 已有（两种扩展名都认）⇒ 直接完成，并把**实际格式**告诉界面 ✓
    if files.exists(base + ".flac") {
        int n = fsize(base + ".flac")
        ch.send(["D", _str(n), _str(n), "flac"])
        return true
    }
    if files.exists(base + ".mp3") {
        int n = fsize(base + ".mp3")
        ch.send(["D", _str(n), _str(n), "mp3"])
        return true
    }
    bool losslessFirst = prefer == "lossless"
    string u = resolve_url(id, losslessFirst)
    if u == "" {
        ch.send(["E", "取不到直链", ""])
        return false
    }
    // 实际格式**只认直链后缀**（MINFO 的档位标签实测会骗人 ✓）
    string gotFmt = kuwo.extfromurl(u)
    if gotFmt == "" { gotFmt = if losslessFirst then "flac" else "mp3" }
    string f = base + "." + gotFmt
    // 半成品文件：**格式无关**（同一首不会中途换格式）⇒ 续传只看它多大 ✓
    //   `.part` 扩展名不会被本地音乐扫描认成歌（scan 只认 mp3/flac/wav/ogg ✓）
    string part = base + ".part"
    int off = 0
    if files.exists(part) { off = dirs.stat(part).size }
    if off < 0 { off = 0 }
    int total = 0
    if off > 0 { ch.send(["P", _str(off), "0"]) }      // 续传起点先报一次，界面不会从 0% 重来
    // ★★ 整个下载**只建一个客户端**（原来每片 `createClient()` ⇒
    //   60MB 就建 60 个，框架有实例数上限 ⇒ 抛「createClient 失败 / 回调次数已上限」，
    //   还会把名额占满、拖累别的功能 ✗）
    var c1 = net.createClient()
    int round = 0
    while round < 2 {
        round = round + 1
        int before = off
        int guard = 0
        while guard < 4096 {                       // 1MB/片 ⇒ 4GB 也够（原来 64 片就封顶，无损根本下不完 ✗）
            guard = guard + 1
            // ① 暂停检查：UI 按一次"暂停"就往 ctl 发一条 ⇒ 这里立刻停手（已下部分留在 .part ✓）
            var cmd = ctl.try_receive()
            if cmd != null {
                try { c1.close() } catch e0 { print("[dl] 暂停时关客户端失败：" + _str(e0)) }
                ch.send(["Z", _str(off), _str(total)])
                return false
            }
            string chunk = ""
            int crTotal = 0
            try {
                // `replaceHeaders` 是覆盖（`addHeaders` 调多次会叠成两个 Range ✗）
                c1.replaceHeaders(["Range: bytes=" + _str(off) + "-" + _str(off + SHARD - 1)])
                var r = c1.get(u)
                if not r.ok() { break }
                crTotal = total_of(r.getHeader("Content-Range"))
                chunk = r.rawBody()
            } catch e {
                break
            }
            int n = chunk.byte_len()
            if n <= 0 { break }
            // ② **边下边写**（不再攒在内存里到最后一次性写）：暂停/关窗都不丢已下部分 ✓
            try {
                var fo = files.open(part, "ab")
                fo.write(chunk)
                fo.close()
            } catch ew {
                try { c1.close() } catch e1 { print("[dl] 写盘失败后关客户端失败：" + _str(e1)) }
                ch.send(["E", "写盘失败：" + _str(ew), ""])
                return false
            }
            off = off + n
            if total <= 0 and crTotal > 0 { total = crTotal }
            ch.send(["P", _str(off), _str(total)])
            if total > 0 and off >= total { break }
            if n < SHARD { break }                 // 服务端没按 Range 给 ⇒ 已经拿全了
        }
        if off > before { break }                  // 这一轮有进展 ⇒ 正常结束
        // ③ 一片都没下进来（直链多半过期 / 403）⇒ **重新取直链**再试一次 ✓
        string u2 = resolve_url(id, losslessFirst)
        if u2 == "" or u2 == u { break }
        u = u2
    }
    try { c1.close() } catch e1 { print("[dl] 关客户端失败：" + _str(e1)) }   // 用完才关（break 也会走到这里 ✓）
    if off <= 0 {
        ch.send(["E", "下载失败（0 字节）", ""])
        return false
    }
    // ④ 拿得到总长却没下满 ⇒ 网络断了：**保留 .part**，状态报失败，点"继续/全部开始"能接着下 ✓
    if total > 0 and off < total {
        ch.send(["E", "下载中断（" + fmt_size(off) + " / " + fmt_size(total) + "），点继续可续传", ""])
        return false
    }
    // ⑤ 完成：.part 改名成正式文件
    try {
        if files.exists(f) { files.delete(f) }
        dirs.rename(part, f)
    } catch e3 {
        ch.send(["E", "收尾改名失败：" + _str(e3), ""])
        return false
    }
    // ---- 收尾：歌词 / 内嵌标签（都**不影响下载结果**：失败只在控制台记一行 ✓）----
    if (tags & 1) != 0 {
        try {
            string lrc = kuwo_lyric.lrcpath(f)
            int n = kuwo_lyric.savelyric(id, lrc)
            if n <= 0 { print("[dl] 这首没有歌词可取：" + title) }
        } catch e {
            print("[dl] 存歌词失败：" + _str(e))
        }
    }
    if (tags & 2) != 0 {
        try {
            string lyrTxt = ""
            try { lyrTxt = kuwo_lyric.fetchlyric(id) } catch e2 { print("[dl] 取歌词失败：" + _str(e2)) }
            string err = audio.writeTag(f, title, artist, art, lyrTxt)
            if err != "" { print("[dl] 内嵌跳过：" + err) }
        } catch e {
            print("[dl] 内嵌失败：" + _str(e))
        }
    }
    // D 消息带**实际格式**，且"总字节 = 已下字节" —— 服务端 Content-Range 的总长偶尔偏大，
    //   按它算进度会停在 76% 之类的数字上；已完成就该是 100% ✓
    ch.send(["D", _str(off), _str(off), gotFmt])
    return true
}

// 字节数 → "4.4 MB"（下载列表的"大小"列 ✓）
export func fmt_size(int b): string {
    if b <= 0 { return "—" }
    if b >= 1048576 { return _str(b / 1048576) + "." + _str((b / 104858) % 10) + " MB" }
    if b >= 1024 { return _str(b / 1024) + " KB" }
    return _str(b) + " B"
}

// ==================== 下载队列（纯数据，行协议 Array[string]）====================
//   一行 = [id, 歌名, 歌手, 状态, 说明, 格式, 已下字节, 总字节]
//   状态： "0" 排队 / "1" 完成 / "2" 失败
//   为什么用行而不是 struct 数组：字段要**原地更新**（状态 0→1、进度 0→N），字符串行最好改 ✓
// fmt = 入队时的**优先格式**（"FLAC" / "MP3"）—— 列表先按它显示，
//   下载完成后由 D 消息回传**实际格式**覆盖（flac 取不到会退 mp3 ✓）
export func job_new(string id, string title, string artist, string fmt): Array[string] {
    return [id, title, artist, "0", "", fmt, "0", "0"]
}

// 进度百分比文本（给 Table 的 progress 单元格：写 "37" 或 "100" ✓）
export func percent_of(Array[string] j): string {
    if j.len() < 8 { return "0" }
    if j[3] == "1" { return "100" }          // 已完成一律 100%（不受服务端总长误差影响 ✓）
    int got = _int(j[6])
    int tot = _int(j[7])
    if tot <= 0 { return "0" }
    int p = got * 100 / tot
    if p > 100 { p = 100 }
    return _str(p)
}

// 大小文本：完成了就显示实际字节，否则 "—"
export func size_of(Array[string] j): string {
    if j.len() < 8 { return "—" }
    return fmt_size(_int(j[6]))
}

// 加入队列（同 id 且在排队/已完成 ⇒ 不重复加）；返回加了几个
export func enqueue(Array[Array[string]] q, string id, string title, string artist, string fmt): int {
    if id == "" { return 0 }
    for q to j {
        if j.len() >= 2 and j[0] == id { return 0 }
    }
    q.add(job_new(id, title, artist, fmt))
    return 1
}

// 下一个待下载的下标（-1 = 没有）
export func next_index(Array[Array[string]] q): int {
    for 0 : q.len() - 1 to i {
        Array[string] j = q[i]
        if j.len() >= 4 and j[3] == "0" { return i }
    }
    return -1
}

// 待下载数量（侧栏角标用）
// 「还在下」的任务数（侧栏角标用）
//   ⚠ "0"=排队 / "5"=下载中 **都算**：ff 源直链下载用的是 "5"，
//     只认 "0" 的话侧栏永远显示「下载」而不是「下载 (1)」✗
export func pending(Array[Array[string]] q): int {
    int n = 0
    for q to j {
        if j.len() >= 4 and (j[3] == "0" or j[3] == "5") { n = n + 1 }
    }
    return n
}

// 状态文案（下载列用）
//   0 排队 / 1 完成 / 2 失败 / 3 **已暂停** / 5 下载中
export func state_text(Array[string] j): string {
    if j.len() < 4 { return "" }
    if j[3] == "0" { return "排队中" }
    if j[3] == "5" { return "下载中" }
    if j[3] == "1" { return "已完成" }
    if j[3] == "3" { return "已暂停" }
    return if j.len() >= 5 and j[4] != "" then "失败：" + j[4] else "失败"
}

// ==================== 队列的暂停 / 恢复 / 持久化（★ 2026-10-30）====================
// 为什么需要：下载列表原来只在内存里 ⇒ 关掉应用记录全丢、下到一半也没法续。
//   现在整条队列落盘到 `<缓存根>/downloads.json`，重启后原样恢复（"下载中"降级成"已暂停"✓）。

// 队列文件路径
export func store_path(string root): string { return dirs.join(root, "downloads.json") }

// 有没有"还在进行"的任务（排队 0 / 下载中 5）—— 关窗提示用它判断 ✓
export func has_active(Array[Array[string]] q): bool {
    for q to j {
        if j.len() >= 4 and (j[3] == "0" or j[3] == "5") { return true }
    }
    return false
}

// 全部暂停：排队 / 下载中 → 3。返回改了几条
export func pause_all(Array[Array[string]] q): int {
    int n = 0
    for 0 : q.len() - 1 to i {
        Array[string] j = q[i]
        if j.len() >= 4 and (j[3] == "0" or j[3] == "5") {
            j[3] = "3"
            q[i] = j
            n = n + 1
        }
    }
    return n
}

// 全部开始：已暂停(3) / 失败(2) → 排队(0)。返回改了几条
//   失败的一起放开：多数失败是"链接过期"，重下时会重新取直链 ⇒ 值得再试一次 ✓
export func resume_all(Array[Array[string]] q): int {
    int n = 0
    for 0 : q.len() - 1 to i {
        Array[string] j = q[i]
        if j.len() >= 4 and (j[3] == "3" or j[3] == "2") {
            j[3] = "0"
            j[4] = ""
            q[i] = j
            n = n + 1
        }
    }
    return n
}

// 单条切换暂停：排队/下载中 → 3；已暂停/失败 → 0。返回改后的状态
export func toggle_pause(Array[Array[string]] q, string id): string {
    for 0 : q.len() - 1 to i {
        Array[string] j = q[i]
        if j.len() >= 4 and j[0] == id {
            if j[3] == "0" or j[3] == "5" { j[3] = "3" } else if j[3] == "3" or j[3] == "2" { j[3] = "0"; j[4] = "" }
            q[i] = j
            return j[3]
        }
    }
    return ""
}

// 落盘（整份写；队列只有几十条 ⇒ 一次写很小 ✓）
//   ⚠ 存成**对象数组**而不是行数组：JSON 读回来的是 Array[any]，按行下标取要反复收窄，
//     字段名一改就静默错位；对象逐字段读（jsons.get_str 给默认值）最稳 ✓
export func save_jobs(string root, Array[Array[string]] q) {
    try {
        dirs.mkdir_p(root)
        Array[Dict] rows = []
        for q to j {
            if j.len() >= 8 {
                rows.add({id: j[0], title: j[1], artist: j[2], state: j[3],
                          note: j[4], fmt: j[5], got: j[6], total: j[7]})
            }
        }
        jsons.write_file(store_path(root), {version: 1, jobs: rows})
    } catch e {
        print("[dl] 存下载队列失败：" + _str(e))
    }
}

// 读盘。读不出来 ⇒ 空队列（坏文件不该让应用起不来 ✓）
//   ⚠ "下载中"(5) 重启后一律降级成"已暂停"(3)：那条线程早没了，留着 5 会显示成"永远在下"的假象 ✗
//
// ★ 2026-10-30：加 `_load_bad` 标志 —— 区分两种"空队列"：
//     · 文件不存在 / 结构正常但 jobs 为空 ⇒ 真的是空，**允许**后续落盘
//     · 文件在、但 JSON 读坏了 ⇒ 内存里只能给空，但**绝不能**拿它覆盖磁盘
//   为什么：旧链路是「读失败 → 内存空 → 某次 refresh_dl_btn → save → 磁盘被空数组覆盖」，
//   一次解析失败就会把几十条任务永久抹掉（不可恢复 ✗）。调用方用 `load_bad()` 判一下即可 ✓
export var _load_bad = false
export func load_bad(): bool { return _load_bad }

export func load_jobs(string root): Array[Array[string]] {
    Array[Array[string]] out = []
    _load_bad = false
    string p = store_path(root)
    if not files.exists(p) { return out }
    try {
        var d = jsons.read_file(p)
        if d is Dict[string, any] => m {
            var arr = m["jobs"]
            if arr is Array {
                for arr to it {
                    if it is Dict => r {
                        string id = jsons.get_str(r, "id", "")
                        if id == "" { continue }
                        string st = jsons.get_str(r, "state", "0")
                        if st == "5" { st = "3" }
                        out.add([id,
                                 jsons.get_str(r, "title", ""),
                                 jsons.get_str(r, "artist", ""),
                                 st,
                                 jsons.get_str(r, "note", ""),
                                 jsons.get_str(r, "fmt", "MP3"),
                                 jsons.get_str(r, "got", "0"),
                                 jsons.get_str(r, "total", "0")])
                    }
                }
            } else {
                _load_bad = true          // 有字典但 jobs 不是数组 ⇒ 结构不对，别覆盖 ✓
            }
        } else {
            _load_bad = true
        }
    } catch e {
        _load_bad = true
        print("[dl] 读下载队列失败：" + _str(e))
    }
    return out
}

// 扫已下载目录 → Song 列表（按文件名拆 `歌手 - 歌名`，没有就整名当歌名）
// 扫描结果缓存：签名 = 目录 + 文件数 + 最新 mtime
//   为什么要缓存：读时长要开解码器（每首 1~3ms），几十首每次切页都扫会明显卡 ✗
var _scanSig = ""
var _scanCache = []            // Array[Song]

// 让下一次 `scan` 一定重扫（本地音乐页的「刷新」钮用 ✓）
//   缓存的签名只看"文件数 + 最新 mtime"：万一文件数没变、mtime 也没变（比如拷进来一个
//   时间戳更旧的文件），签名相同就会一直返回旧列表 ⇒ 用户只能重启才行 ✗
export func invalidate_scan() { _scanSig = "" }

export func scan(string root): Array[Song] {
    Array[Song] out = []
    string d = dir_of(root)
    if not dirs.exists(d) { return out }
    var names = dirs.listdir(d)
    // 缓存签名：文件数 + 最新修改时间 ⇒ 下载完 / 删文件才失效 ✓
    int newest = 0
    for names to nm0 {
        var st0 = dirs.stat(dirs.join(d, nm0))
        if st0.mtime > newest { newest = st0.mtime }
    }
    string sig = d + "|" + _str(names.len()) + "|" + _str(newest)
    if sig == _scanSig { return _scanCache }
    for names to n {
        string ext = dirs.extname(n).to_lower()
        if ext != ".mp3" and ext != ".flac" and ext != ".wav" and ext != ".ogg" { continue }
        string base = dirs.basename(n)
        Song sg = new Song()
        // ⚠ 不能用 `byte_slice` 切文件名：中文是多字节，按字节切会把字切断（实测显示成 `刘若@@` ✗）
        //   ⇒ 一律走 `split`（按码点/子串处理，不涉及偏移 ✓）
        string t = base
        var dot = strings.split(base, ".")
        if dot.len() >= 2 {
            t = dot[0]
            for 1 : dot.len() - 2 to k { t = t + "." + dot[k] }
        }
        var parts = strings.split(t, " - ")
        if parts.len() >= 2 {
            sg.artist = parts[0]
            string tt = ""
            for 1 : parts.len() - 1 to k {
                tt = if tt == "" then parts[k] else tt + " - " + parts[k]
            }
            sg.title = tt
        } else {
            sg.title = t
            sg.artist = "本地文件"
        }
        sg.path = dirs.join(d, n)
        // ★ 2026-10-30：给「本地音乐」页补音质数据 —— 本地文件不必问接口：
        //   `ext` 判无损（flac/ape/wav），`sizeBytes` 是真实体积 ⇒ `page_widgets.quality_of`
        //   用「体积 ÷ 时长」算出码率档位（无损 / HQ / 标准）✓
        //   ⚠ 用**字符** slice 去点（".mp3" → "mp3"）：按字节切会把中文文件名切坏 ✗
        if ext.len() > 1 { sg.ext = ext.slice(1, ext.len()) }
        var inf0 = dirs.stat(sg.path)
        if inf0.size > 0 { sg.sizeBytes = inf0.size }
        // 同名封面（下载时落下的 `<歌手> - <歌名>.jpg`）⇒ 列表里显示真图 ✓
        string art = dirs.join(d, t + ".jpg")
        if files.exists(art) { sg.cover = art }
        // 时长：读容器头即可（不解码音频）——扫描结果有缓存，不会每次切页都读 ✓
        try {
            var dec = audio.createDecoder(sg.path)
            if dec.isOpen() {
                sg.dur = ui.fmtTime(dec.getDuration())
                // ★ 2026-10-30：顺手读真实采样率 / 声道（解码器本来就开着，不额外花时间）
                //   `ma_decoder` 用默认 config ⇒ 采样率不做重采样，拿到的就是源文件的 ✓
                //   ⚠ 别把 `getFormat()` 当位深：它返回的是**解码输出**格式（flac 固定 f32），
                //     按它判档会让所有 flac 都变"32bit 母带"✗（实测打脸，见 music_data 注释）
                sg.sampleRate = dec.getSampleRate()
                sg.channels = dec.getChannels()
                dec.close()
            }
        } catch e {
            print("[scan] 读时长失败：" + _str(e))
        }
        out.add(sg)
    }
    _scanSig = sig
    _scanCache = out
    return out
}
