// library.leno — 「我的收藏 / 最近播放」的**持久化与集合运算**（纯数据，不懂界面）
// ----------------------------------------------------------------------------
// 为什么抽出来：主文件里的 save_library/load_library/is_liked 只是"读写一个 json + 查数组"，
// 和界面无关；放在主文件里每次都要在 3000 行里翻。抽出来后：
//   · 主文件只负责"什么时候存/取"（换歌、收藏、退出）
//   · 这里负责"存成什么形状"（键名、字段顺序、容错）
// 收藏键的口径见 ui_kit.like_key：在线用 sid、本地用 file:<路径> ✓
//
// ★ 2026-10-31 修（用户反馈"排行榜里点了喜欢，「我喜欢」页没有"）：
//   老实现里 `likes` **只存 like_key 字符串**，界面上的「我喜欢」页靠"拿 key 去几个现有
//   数组里反查"重建列表（recentSongs / recSongs / newSongs / netSongs / 本地曲库）。
//   于是两处必然丢：
//     ① 在**排行榜 / 歌单**里收藏的歌 —— 那两个数组（bangSongs / plSongs）压根没参与反查；
//     ② 切走榜单 / 重新搜索后，原数组被覆盖 ⇒ 连"已经收藏好的"也一起消失。
//   根因是**存的东西不完整**：只有 id，没有歌名/歌手/封面 ⇒ 无从重建。
//   ⇒ 现在 `liked` 存**整首歌的快照**（按字段名存 Dict，不用位置数组，以后加字段不会错位）；
//     老文件里的 `likes`（纯 key 列表）仍然读得进来，标记 `likedLegacy` 让上层做回填 ✓
import "./store.leno" as store
import "../music_data.leno" as data
use data.Song

// 一次读出来的东西（最近播放按时间从新到旧）
export struct LibraryData {
    Array[Song] liked = []       // ★ 收藏的**歌曲快照**（不再只有 key）
    Array[Song] recent = []
    bool likedLegacy = false     // true = liked 来自老格式（只有 key，title 是空的）⇒ 上层可回填
}

// 与 ui_kit.like_key 同口径（这里不 import ui_kit：library 是纯数据层，别反向依赖界面工具）
func key_of(Song sg): string {
    if sg.sid != "" { return sg.sid }
    if sg.path != "" { return "file:" + sg.path }
    return ""
}

// ---------- Song ⇄ Dict（收藏快照用）----------
func song_dict(Song s): Dict[string, any] {
    Dict[string, any] d = {}
    d["sid"] = s.sid
    d["title"] = s.title
    d["artist"] = s.artist
    d["dur"] = s.dur
    d["cover"] = s.cover
    d["tag"] = s.tag
    d["path"] = s.path
    d["url"] = s.url
    d["ext"] = s.ext
    d["src"] = s.src
    d["sizeBytes"] = _str(s.sizeBytes)
    d["sampleRate"] = _str(s.sampleRate)
    d["channels"] = _str(s.channels)
    return d
}

// 取字符串字段（缺 / null ⇒ 空串，绝不抛）
func gs(Dict[string, any] d, string k): string {
    var v = d.get(k, null)
    if v == null { return "" }
    return _str(v)
}

func song_from_dict(any raw): Song {
    Song sg = new Song()
    var d = raw as Dict[string, any]
    if d == null { return sg }
    sg.sid = gs(d, "sid")
    sg.title = gs(d, "title")
    sg.artist = gs(d, "artist")
    sg.dur = gs(d, "dur")
    sg.cover = gs(d, "cover")
    sg.tag = gs(d, "tag")
    sg.path = gs(d, "path")
    sg.url = gs(d, "url")
    sg.ext = gs(d, "ext")
    sg.src = gs(d, "src")
    sg.sizeBytes = _int(gs(d, "sizeBytes"))
    sg.sampleRate = _int(gs(d, "sampleRate"))
    sg.channels = _int(gs(d, "channels"))
    return sg
}

// 存：liked / recent 都是**整首歌**（recent 仍用老的位置数组格式，没坏就别动 ✓）
export func save(string cacheRoot, Array[Song] liked, Array[Song] recent) {
    Dict[string, any] d = {}
    d["version"] = 2

    // ① 新格式：liked = 完整快照
    Array[any] lk = []
    for liked to s { lk.add(song_dict(s)) }
    d["liked"] = lk
    // ② 老格式字段照写（纯 key 列表）—— 降级到旧版本时还能认出"收过哪些" ✓
    Array[string] keys = []
    for liked to s {
        string k = key_of(s)
        if k != "" { keys.add(k) }
    }
    d["likes"] = keys

    Array[Array[string]] rs = []
    for recent to s {
        // 第 6 项 = 音源标记（`"ff"` = 小易 / `"kuwo"` = 小酷）：不存它的话，重启后 ff 源的歌
        //   `url` 是空的、`src` 也没了 ⇒ 会被当成酷我歌去解析、必失败 ✗
        //   ⚠ 显式写 `"kuwo"` 而不是空串：
        //     ① 实测某次落盘出现过**数字 `0`**（`[...,"…jpg",0]`，来源未查明 ——
        //        单独用探针验过 `Array[Array[string]]` 经 `Dict[string,any]` 编码，
        //        空串能正常输出 `""`，所以不是"空串被编成 0"那么简单，暂存疑）；
        //     ② 更要紧的是**读取端的坑**：`as Array[Array[string]]` 遇到行里混着数字会
        //        直接返回 `null` ⇒ 整个 recent 列表被静默丢弃（一条不剩，也不报错 ✗）。
        //   写死成两个固定字符串，两边都不会踩到 ✓
        rs.add([s.sid, s.title, s.artist, s.dur, s.cover, if s.src == "ff" then "ff" else "kuwo"])
    }
    d["recent"] = rs
    store.save(cacheRoot, d)
}

// 读：文件不存在/坏了 ⇒ 空数据（配置坏了不该让应用起不来 ✓）
export func load(string cacheRoot): LibraryData {
    LibraryData out = new LibraryData()
    var d = store.load(cacheRoot)

    // ---------- 收藏：优先新格式（快照）----------
    var la = d.get("liked", null) as Array[any]
    if la != null {
        for la to it {
            Song sg = song_from_dict(it)
            if key_of(sg) != "" { out.liked.add(sg) }
        }
    }
    // ---------- 收藏：退化到老格式（只有 key）----------
    if out.liked.len() == 0 {
        var keys = store.str_list(d, "likes")
        if keys.len() > 0 {
            out.likedLegacy = true
            for keys to k {
                Song sg = new Song()
                if k.starts_with("file:") {
                    sg.path = k.slice(5, k.len() - 1)
                } else {
                    sg.sid = k
                }
                if key_of(sg) != "" { out.liked.add(sg) }
            }
        }
    }

    // ---------- 最近播放（沿用位置数组 + 宽松解析）----------
    var rv = d.get("recent", null)
    // ★ 2026-10-31 修（对应 docs/语言与框架问题 L1）：**宽松解析**
    //   原来写 `rv as Array[Array[string]]` —— 这是"整组严格匹配"，只要有一行混进了
    //   数字（实测出现过第 6 项为 `0`），整个 recent 就返回 `null`：
    //   「继续收听」全空、一句日志都没有，用户只会以为数据自己没了 ✗
    //   改成：先 `as Array[any]`（任何元素都放得下，一定成功），再逐元素 `_str()` 转，
    //   转换永不失败 ⇒ 一条脏数据只影响它自己那一格 ✓
    var arr = rv as Array[any]
    if arr != null {
        for arr to it {
            var row = it as Array[any]
            if row == null or row.len() < 5 { continue }
            Song sg = new Song()
            sg.sid = _str(row[0])
            sg.title = _str(row[1])
            sg.artist = _str(row[2])
            sg.dur = _str(row[3])
            sg.cover = _str(row[4])
            // 老格式没有第 6 项 ⇒ 保持空（当酷我歌 ✓）；
            // 只认 "ff"，其它（"kuwo" / 空 / 历史遗留的 "0"）一律归成空串 ✓
            if row.len() > 5 and _str(row[5]) == "ff" { sg.src = "ff" }
            out.recent.add(sg)
        }
    }
    return out
}

export func is_liked(Array[string] likes, string key): bool {
    if key == "" { return false }
    for likes to s {
        if s == key { return true }
    }
    return false
}

// 收藏/取消收藏（返回新数组：Leno 的数组按引用传，但显式返回更清楚 ✓）
export func toggle(Array[string] likes, string key): Array[string] {
    if key == "" { return likes }
    Array[string] out = []
    bool had = false
    for likes to s {
        if s == key { had = true } else { out.add(s) }
    }
    if not had { out.add(key) }
    return out
}

export func remove(Array[string] likes, string key): Array[string] {
    Array[string] out = []
    for likes to s {
        if s != key { out.add(s) }
    }
    return out
}

// 追加 key（不重复）
export func add_key(Array[string] keys, string key): Array[string] {
    if key == "" { return keys }
    for keys to s { if s == key { return keys } }
    Array[string] out = []
    for keys to s { out.add(s) }
    out.add(key)
    return out
}

// ---------- 快照数组的增删（按 like_key 判同一首）----------
export func add_song(Array[Song] arr, Song sg): Array[Song] {
    string k = key_of(sg)
    if k == "" { return arr }
    Array[Song] out = []
    for arr to s { if key_of(s) != k { out.add(s) } }
    out.add(sg)          // 已存在时**替换成最新的这份**（封面/直链可能是后补的 ✓）
    return out
}

export func remove_song(Array[Song] arr, string key): Array[Song] {
    Array[Song] out = []
    for arr to s {
        if key_of(s) != key { out.add(s) }
    }
    return out
}
