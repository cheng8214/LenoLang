// probes.leno — 无头验证用的**纯数据**（假歌词 / 压力测试歌单）
// ----------------------------------------------------------------------------
// 为什么单独抽：这些只在 `ARIA_*` 环境变量探针里用，产品逻辑一行都用不到。
// 抽出来主文件就不用为"造 40 行假歌词"这类事占几十行；而且这里是纯函数，好改好删。
//   · 假歌词带**逐字标签** <起点,时长>，形状和酷我 lrcx 一致 ⇒ 走的是真实解析链路 ✓
//   · 压力歌单用**本地封面**、不联网 ⇒ 每次重建工作量恒定，内存增量才可比 ✓
import "../music_data.leno" as data
import strings
use data.Song

// 造一份带逐字标签的 LRC（每行 secPerLine 秒、每个字 wordMs 毫秒）
//   ⇒ 不依赖网络也能验"居中 / 当前行放大 / 逐字扫光 / 缓动滚动" ✓
export func fake_lyric(int lines, int secPerLine, int wordMs): string {
    string out = ""
    for 0 : lines - 1 to i {
        int sec = i * secPerLine
        string mm = _str(sec / 60)
        if mm.len() < 2 { mm = "0" + mm }
        int ss = sec - (sec / 60) * 60
        string tail = if ss < 10 then "0" + _str(ss) else _str(ss)
        string body = ""
        string txt = "第 " + _str(i + 1) + " 行歌词 假数据 用来验逐字扫光"
        var cps = strings.to_codepoints(txt)
        int k = 0
        for cps to cp {
            string one = strings.from_codepoint(cp)
            body = body + "<" + _str(sec * 1000 + k * wordMs) + "," + _str(wordMs) + ">" + one
            k = k + 1
        }
        out = out + "[" + mm + ":" + tail + ".00]" + body + "\n"
    }
    return out
}

// 造 n 首"测试歌曲"（封面用内置 cover01..16.png，不联网）
export func stress_songs(int n): Array[Song] {
    Array[Song] out = []
    for 0 : n - 1 to i {
        Song sg = new Song()
        sg.title = "测试歌曲 " + _str(i + 1)
        sg.artist = "测试歌手"
        int c = (i % 16) + 1
        string num = _str(c)
        if c < 10 { num = "0" + num }
        sg.cover = "cover" + num + ".png"
        out.add(sg)
    }
    return out
}
