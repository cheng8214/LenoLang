// ui_kit.leno — 跨页面复用的**无状态**小工具（路径 / 标签 / 时间 / 颜色 / 曲库 key）
// ----------------------------------------------------------------------------
// 为什么抽出来：这些函数都不依赖 Player 的界面状态，留在主文件里只是把 3500 行撑得更大。
// 抽走后主文件只关心"页面与交互"，这些跟着数据格式走的东西放一处改一处 ✓
//
// ⚠ Leno 的 `use` 只能导类型（`use mod.func` 不支持，见 docs/import使用指南.md 规则表）
//   ⇒ 调用方统一写 `ui.xxx(...)`
import "SDL3" as SDL3
import "../music_data.leno" as data
import dirs
import strings
use SDL3.(Label, Theme, Color)
use data.Song

// ==================== 资源路径 ====================
// 图片绝对路径（单文件打包后资源解包到 res_dir ⇒ 必须用它 ✓）
export func img(string name): string {
    return dirs.join(dirs.res_dir(), "images/" + name)
}

// 图标路径（图标都在 images/icons/ 下 ✓）
export func ico(string name): string {
    return dirs.join(dirs.res_dir(), "images/icons/" + name)
}

// 封面路径：绝对路径（酷我缓存）直接用，否则当 images/ 下的内置文件名
//   ⚠ 空串必须落到**占位图标**：原来直接 `img("")` 会拼出 `images/`（一个目录），
//     纹理加载必然失败 ⇒ 卡片那块就是纯空白（连音符占位都没有 ✗）
export func coverPath(string c): string {
    if c == "" { return ico("music.png") }
    if strings.has(c, "/") or strings.has(c, "\\") { return c }
    return img(c)
}

// 右击菜单项（照 文件管理器的 ctxItem：菜单项带图标 ✓）
//   为什么统一走这里：Table/MenuBar 认的是 {label, id, image}，散着写容易漏掉 image
//   或拼错路径；图标一律用 ico()（单文件打包后也能找到 ✓）
export func mi(string label, string id, string icon): Dict {
    return {label: label, id: id, image: ico(icon)}
}

// 造一个标签（可选加粗）—— 全应用只有这一处建标签，样式不会各处漂移 ✓
export func lbl(string t, float sz, Color c, bool bold): Label {
    Label l = SDL3.createLabel({text: t, font_size: sz, text_color: c})
    if bold { l.set_font_style(SDL3.STYLE_BOLD) }
    return l
}

// 「像链接一样」的文字：超宽截断 + 悬停变手型 + 文字微微右移（网页链接那种反馈）
//   注意：只是**外观**；要真的能点，调用处再 `set_on_click` / `on_click` ✓
export func lblLink(string t, float sz, Color c, bool bold): Label {
    Label l = SDL3.createLabel({text: t, font_size: sz, text_color: c, truncate: 1,
                                 cursor: SDL3.SystemCursor.POINTER, hover_shift: 3.0})
    if bold { l.set_font_style(SDL3.STYLE_BOLD) }
    return l
}

// 同 lbl，但**超宽自动省略号**（按布局分配到的宽度裁，不必自己算 max_w）
//   行控件 / 卡片里的歌名歌手都用它 —— 否则长名字会直接画到隔壁卡片上 ✗
export func lblFit(string t, float sz, Color c, bool bold): Label {
    Label l = SDL3.createLabel({text: t, font_size: sz, text_color: c, truncate: 1})
    if bold { l.set_font_style(SDL3.STYLE_BOLD) }
    return l
}

// ==================== 时间 ====================
// "mm:ss" → 秒（底栏初始时长用：还没真播放时先按歌曲自己的时长显示 ✓）
export func parseDur(string t): float {
    int p = strings.byte_find(t, ":", 0)
    if p < 0 { return 0.0 }
    int m = _int(strings.byte_slice(t, 0, p - 1))
    int s = _int(strings.byte_slice(t, p + 1, t.len() - 1))
    return _float(m * 60 + s)
}

// 秒 → "mm:ss"
export func fmtTime(float sec): string {
    int total = _int(sec)
    if total < 0 { total = 0 }
    int m = total / 60
    int s = total % 60
    string mm = _str(m)
    if m < 10 { mm = "0" + mm }
    string ss = _str(s)
    if s < 10 { ss = "0" + ss }
    return mm + ":" + ss
}

// ==================== 缓存目录 ====================
//   <应用目录>/cache/           根
//   <应用目录>/cache/preview/   试听音频
//   <应用目录>/cache/covers/    封面缓存
//   <应用目录>/cache/downloads/ 下载（见 downloads.leno 的 dir_of ✓）
//   打包成单文件时 script_dir 可能只读/是临时解包目录 ⇒ 退回 %TEMP%\Aria
var _cacheOverride = ""        // 设置里的缓存目录（空 = 跟随应用目录下的 cache）

export func set_cache_override(string p) { _cacheOverride = p }

export func cacheRoot(): string {
    if _cacheOverride != "" { return _cacheOverride }
    var s = dirs.script_dir()
    if s != null and s != "" {
        try {
            var d = dirs.join(s, "cache")
            dirs.mkdir_p(d)
            return d
        } catch e {
            print("[cache] 应用目录不可写，改用临时目录：" + _str(e))
        }
    }
    return dirs.join(_tmpdir(), "Aria")
}

export func audioCacheDir(): string { return dirs.join(cacheRoot(), "preview") }
export func coverCacheDir(): string { return dirs.join(cacheRoot(), "covers") }

// ==================== 颜色 ====================
// 加/改透明度（Color 是 0xAARRGGBB）
export func fade_color(Color c, int a): Color {
    if a > 255 { a = 255 }
    if a < 0 { a = 0 }
    return (a << 24) | (c & 0x00FFFFFF)
}

// 两色线性插值（含 alpha）—— 歌词逐字扫光靠它做"字内渐变"，不是整字硬切 ✓
export func lerp_color(Color c1, Color c2, float t): Color {
    if t <= 0.0 { return c1 }
    if t >= 1.0 { return c2 }
    int r1 = (c1 >> 16) & 255
    int g1 = (c1 >> 8) & 255
    int b1 = c1 & 255
    int a1 = (c1 >> 24) & 255
    int r2 = (c2 >> 16) & 255
    int g2 = (c2 >> 8) & 255
    int b2 = c2 & 255
    int a2 = (c2 >> 24) & 255
    int r = r1 + _int(_float(r2 - r1) * t + 0.5)
    int g = g1 + _int(_float(g2 - g1) * t + 0.5)
    int b = b1 + _int(_float(b2 - b1) * t + 0.5)
    int a = a1 + _int(_float(a2 - a1) * t + 0.5)
    if r < 0 { r = 0 }
    if r > 255 { r = 255 }
    if g < 0 { g = 0 }
    if g > 255 { g = 255 }
    if b < 0 { b = 0 }
    if b > 255 { b = 255 }
    if a < 0 { a = 0 }
    if a > 255 { a = 255 }
    return (a << 24) | (r << 16) | (g << 8) | b
}

// ==================== 曲库 key ====================
// "同一首歌"的判据：在线用 sid，本地用 path（本地歌 sid 为空，不能只看 sid ✓）
export func like_key(Song sg): string {
    if sg.sid != "" { return sg.sid }
    if sg.path != "" { return "file:" + sg.path }
    return ""
}

// 按 like_key 去重（本地歌 sid 为空，不能用 has_sid ✓）
export func has_key(Array[Song] arr, string key): bool {
    for arr to a {
        if like_key(a) == key { return true }
    }
    return false
}

export func has_sid(Array[Song] arr, string sid): bool {
    for arr to a {
        if a.sid == sid { return true }
    }
    return false
}
