// music_data.leno — Aria 的演示数据（歌曲 / 歌单 / 导航）
//
// 为什么单独一份：界面代码只管"怎么画"，数据只管"画什么" ⇒ 换成真数据（扫库/API）
//   只要替换本文件的几个函数，界面一行都不用动 ✓
//
// ⚠ 封面只存**文件名**（如 "cover05.png"），真实路径由界面用 dirs 拼 ——
//   这样打包（resource.toml 把 images/** 解包到 res_dir）后依然找得到 ✓

// ==================== 结构 ====================
export struct Song {
    string title = ""
    string artist = ""
    string dur = ""
    string cover = ""     // images/ 下的文件名，或酷我封面缓存**绝对路径**
    string tag = ""       // 角标：新 / HQ / 无损（空 = 无）
    // ★ 2026-10-25：酷我歌曲 id（""= 演示数据，没有音源）。
    //   有了它，卡片不必依赖"搜索结果的下标"也能真播放 / 拉封面（推荐、最近添加、
    //   继续收听里的歌都来自酷我 ⇒ 各分区表现一致 ✓）
    string sid = ""
    // ★ 2026-10-26：本地文件**绝对路径**（"本地音乐"页用；非空 ⇒ 直接播这个文件，不走网络）
    string path = ""
    // ★ 2026-10-29：音质标签用（来自酷我 MINFO 的最高音质档）
    //   `ext` 如 flac / mp3；`sizeBytes` 用来算码率（接口没给 ext 时兜底推算 ✓）
    string ext = ""
    int sizeBytes = 0
    // ★ 2026-10-30：本地文件的**真实采样率**（LenoMusic 的 `Decoder` 读出来）
    //   为什么要加：音质档位原来只靠「体积 ÷ 时长」估，小体积的 flac 被算成 200 多 kbps
    //   ⇒ 显示成 "HQ"（用户实测 ✗）。无损格式该看采样率（≥88.2kHz 才算 Hi-Res），
    //   有损格式才看文件码率 ✓
    //   ⚠ **不要**用 `Decoder.getFormat()` 当位深：它给的是**解码输出**格式，
    //     dr_flac 固定输出 f32 ⇒ 所有 flac 都会变成"32 位音源"、一律被判成母带 ✗
    //     （2026-10-30 实测：两个 44.1k/48k 的 flac 全被标成"超清母带"）
    //     真要源文件位深得自己解析 STREAMINFO / wav 的 fmt 块，收益不值当 ✓
    int sampleRate = 0
    int channels = 0
    // ★ 2026-10-29：备用音源（ffapi）的**音频直链**
    //   非空 ⇒ 播放时直接下它（`sid` 那套是酷我的，别混用 ✓）
    //   ⚠ 直链有时效（几分钟），下载失败要重新解析一次
    string url = ""
    // ★ 2026-10-29：音源标记 —— `"ff"` = 高音质源（网易云 id），空 = 酷我
    //   为什么要它：`url` 不持久化（直链会过期），重启后 `url` 是空的 ⇒
    //   光看 url 分不出这首歌该走哪条播放路，会被当成酷我歌去解析 ⇒ 必失败 ✗
    string src = ""
}

export struct Shelf {
    string title = ""
    string sub = ""
    Array[Song] items = []
}

export struct NavItem {
    string name = ""
    int count = 0
    string icon = ""          // 图标文件名（images/icons 下；"" = 不画图标）
    string group = ""         // 分组标题（同一组只在**第一项**上写，侧栏据此插小标题）
}

// ==================== 构造辅助 ====================
func mk(string t, string a, string d, string c, string tag): Song {
    Song s = new Song()
    s.title = t
    s.artist = a
    s.dur = d
    s.cover = c
    s.tag = tag
    return s
}

func nav(string name, int count): NavItem {
    NavItem n = new NavItem()
    n.name = name
    n.count = count
    return n
}

// 带图标 + 分组的主导航项（参考图那种「小标题 + 图标 + 文字」✓）
func navi(string name, int count, string icon, string group): NavItem {
    NavItem n = new NavItem()
    n.name = name
    n.count = count
    n.icon = icon
    n.group = group
    return n
}

// ==================== 侧栏：主导航 ====================
//   分三组（与参考图一致）：第一组无标题 / 「我的音乐」/「发现」
//   ⚠ 顺序与 curNav 索引**绑定**（i 就是页面号）⇒ 只插标题、不重排 ✓
export func navMain(): Array[NavItem] {
    return [navi("首页", 674, "music.png", ""),
            navi("我喜欢", 128, "sc.png", "我的音乐"),
            navi("最近播放", 64, "loop_all.png", ""),
            navi("本地音乐", 674, "music.png", ""),
            navi("排行榜", 0, "list.png", "发现"),
            navi("发现", 0, "menu_open_dir.png", "")]
}

// 侧栏：**用户自己的歌单**（空 = 侧栏不显示这一组）
//   原来那 6 个（华语经典 / 粤语金曲 / …）全是编的占位，点了也没内容 ⇒ 已删除 ✓
//   真实歌单由 `lib/playlists.leno` 从 `cache/playlists.json` 读出来再填进来
export func navPlaylists(): Array[NavItem] {
    return []
}

// ==================== 内容区：三个分区 ====================
export func shelves(): Array[Shelf] {
    Array[Shelf] out = []

    // ① 继续收听（参考图 3 张横卡 ✓）
    Shelf s1 = new Shelf()
    s1.title = "继续收听"
    s1.sub = "接着上次的位置"
    s1.items = [mk("心动信号", "林晚舟", "04:13", "cover05.png", "HQ"),
                mk("晚风信箱", "苏辞", "03:48", "cover14.png", ""),
                mk("云层之上", "陈屿", "05:02", "cover16.png", "无损")]
    out.add(s1)

    // ② 为你推荐（参考图一屏 8 张 ✓）
    Shelf s2 = new Shelf()
    s2.title = "为你推荐"
    s2.sub = "根据最近 30 天的收听生成"
    s2.items = [mk("心动信号", "林晚舟", "04:13", "cover05.png", "HQ"),
                mk("霓虹旅客", "海盐苏打", "03:12", "cover01.png", "新"),
                mk("午夜霓虹", "陈屿", "04:44", "cover02.png", ""),
                mk("纸飞机", "苏辞", "03:35", "cover04.png", ""),
                mk("雨后街角", "林晚舟", "04:02", "cover05.png", "新"),
                mk("第七个夏天", "白榆", "03:57", "cover06.png", ""),
                mk("晚风信箱", "苏辞", "03:48", "cover14.png", "HQ"),
                mk("慢速列车", "海盐苏打", "04:29", "cover08.png", "")]
    out.add(s2)

    // ③ 最近添加
    Shelf s3 = new Shelf()
    s3.title = "最近添加"
    s3.sub = "近 30 天新增 674 首 · 累计收录 674 首"
    s3.items = [mk("云层之上", "陈屿", "05:02", "cover16.png", "无损"),
                mk("星尘旅人", "白榆", "03:26", "cover09.png", "新"),
                mk("玻璃海", "海盐苏打", "04:18", "cover10.png", ""),
                mk("回声房", "林晚舟", "03:52", "cover12.png", ""),
                mk("旧磁带", "苏辞", "04:36", "cover13.png", ""),
                mk("灯下楼台", "白榆", "03:21", "cover14.png", "新")]
    out.add(s3)

    return out
}

// ==================== 正在播放（底栏）====================
export func nowPlaying(): Song {
    return mk("心动信号", "林晚舟", "04:13", "cover05.png", "HQ")
}

// 总曲目数（首页副标题用 ✓）
export func totalTracks(): int { return 674 }

// 歌单总数
export func folderCount(): int { return 1 }
