// pvz.leno — 植物大战僵尸（Leno + SDL3）
//
// 操作：
//   鼠标左键 — 选卡片 / 种植物 / 点阳光收集 / 点铲子后铲除植物
//   1~5      — 选择对应卡片        S — 铲子        ESC — 取消选择
//   P 暂停   R 重开   M 静音
//
// 规则：
//   收集阳光种植物，阻止僵尸走到屋前。僵尸啃掉一路植物后会被小推车碾平，
//   小推车用完的那一路再被突破就输了；撑过全部 10 波即通关。
//
// 素材：image/ 与 anim/ 与 sound/
//   anim/ 由 gen_anim.ps1 从官方 reanim 骨骼动画导出（本目录执行该脚本可重新生成）

import "SDL3" as SDL3
import "sdl_core" as core
import "Music" as audio
use SDL3.(Event, Renderer, WindowFlag, Scancode, Font, Flip)
use audio.(Sound, Sfx)
import maths
import rands
import dirs
import "pvz_types.leno" as types
import "pvz_art.leno" as art
use types.(Anim, Plant, Zombie, Pea, Sun, Mower, Particle, FloatText, Game)

// ==================== 布局常量 ====================
// 背景原图 1400x600：x∈[0,240] 是房子，x∈[245,995] 是草坪，y∈[80,580] 是草坪
// 取源图 (0,0,1000,600) 铺满 1000x640 窗口，房子与草坪一并入画

var WIN_W  = 1000
var WIN_H  = 640
var COLS   = 9
var ROWS   = 5
var GRID_X = 246.0
var GRID_Y = 90.0
var GRID_W = 748.0
var GRID_H = 526.0
var CELL_W = GRID_W / 9.0
var CELL_H = GRID_H / 5.0

var CARD_X0  = 252.0
var CARD_Y   = 5.0
var CARD_W   = 72.0
var CARD_H   = 76.0
var CARD_GAP = 78.0
var N_CARD   = 5

var SHOVEL_X = 660.0
var SHOVEL_Y = 6.0
var SHOVEL_W = 64.0

var FLAG_X = 744.0
var FLAG_Y = 10.0

var SUNBANK_X = 12.0
var SUNBANK_Y = 2.0
var SUNBANK_W = 76.0
var SUNBANK_H = 84.0

var MOWER_X    = 222.0
var MOWER_TRIG = GRID_X - 6.0
var LOSE_X     = 186.0
var SPAWN_X    = 1000.0

// ==================== 植物 ====================

var P_SUNFLOWER  = 0
var P_PEASHOOTER = 1
var P_WALLNUT    = 2
var P_SNOWPEA    = 3
var P_CHERRY     = 4

var PLANT_NAME  = ["向日葵", "豌豆射手", "坚果墙", "寒冰射手", "樱桃炸弹"]
var PLANT_COST  = [50, 100, 50, 175, 150]
var PLANT_CD    = [45, 5, 18, 45, 30]
var PLANT_HP    = [300.0, 300.0, 4000.0, 300.0, 300.0]
var PLANT_S     = [1.28, 1.28, 1.28, 1.28, 1.05]   // 种植后的缩放
var CARD_ICON_S = [0.60, 0.60, 0.58, 0.60, 0.48]   // 卡片预览缩放

var SUN_MAKE_CD = 144
var SUN_FIRST   = 300
var CHERRY_FUSE = 66
var CHERRY_DMG  = 1800.0
var PEA_DMG     = 20.0
var PEA_SPEED   = 7.0
var SHOOT_FIRE  = 14.0          // 射击动画第几帧出豆
var ANIM_SPEED  = 1.5           // 射击动画倍速（让 25 帧动画 ≈ 1.4 秒射速）

// ==================== 僵尸 ====================

var Z_NORMAL = 0
var Z_CONE   = 1
var Z_BUCKET = 2

var Z_HP  = [270.0, 270.0, 270.0]
var Z_HAT = [0, 370, 1100]
var Z_SPD = [0.30, 0.30, 0.28]
var Z_SCALE = 0.88
var Z_EAT = 1.67

// ==================== 关卡 ====================

var WAVE_TOTAL = 10
var START_SUN  = 5000
var SKY_SUN_CD = 570
var SUN_VALUE  = 25

var ST_MENU = 0
var ST_PLAY = 1
var ST_PAUSE = 2
var ST_WIN = 3
var ST_LOSE = 4
var ST_HELP = 5   // 从主菜单进入的操作说明页

// 菜单按钮布局参数
var MENU_BTN_W = 280.0
var MENU_BTN_H = 52.0
var MENU_BTN_GAP = 62.0

// ==================== 工具 ====================

func rowCenterY(int row): float {
    return GRID_Y + _float(row) * CELL_H + CELL_H * 0.5
}

func colCenterX(int col): float {
    return GRID_X + _float(col) * CELL_W + CELL_W * 0.5
}

func plantFootY(int row): float {
    return GRID_Y + _float(row + 1) * CELL_H - 14.0
}

func zombieFootY(int row): float {
    return GRID_Y + _float(row + 1) * CELL_H - 8.0
}

func peaLineY(int row): float {
    return plantFootY(row) - 63.0
}

func inRect(float x, float y, float rx, float ry, float rw, float rh): bool {
    return x >= rx and x <= rx + rw and y >= ry and y <= ry + rh
}

func animOf(Game g, int ptype, int act): Anim {
    if ptype == P_SUNFLOWER  { return g.anSunflower }
    if ptype == P_WALLNUT    { return g.anWallnut }
    if ptype == P_CHERRY     { return g.anCherry }
    if ptype == P_SNOWPEA {
        if act == 1 { return g.anSnowShoot }
        return g.anSnowPea
    }
    if act == 1 { return g.anPeaShoot }
    return g.anPeashooter
}

// ==================== 初始化 ====================

func newGame(): Game {
    var g = new Game()
    g.state = ST_MENU
    g.frameCount = 0
    g.muted = false
    g.quitReq = false
    g.loaded = false
    g.audioOk = false
    resetLevel(g)
    return g
}

func resetLevel(Game g) {
    g.sun = START_SUN
    g.wave = 0
    g.killed = 0
    g.waveState = 0
    g.waveTimer = 900
    g.spawnQueue = []
    g.spawnIdx = 0
    g.spawnTimer = 0
    g.skyTimer = SKY_SUN_CD
    g.bannerTimer = 0
    g.bannerText = ""
    g.hugeWave = false
    g.selCard = -1
    g.shovelMode = false
    g.mouseX = 0.0
    g.mouseY = 0.0
    g.pCount = 0
    g.plants = []
    g.zombies = []
    g.peas = []
    g.suns = []
    g.particles = []
    g.floats = []
    g.cardCd = []
    for 0 : N_CARD - 1 to i { g.cardCd.add(0) }
    g.mowers = []
    for 0 : ROWS - 1 to rw {
        var m = new Mower()
        m.row = rw
        m.x = MOWER_X
        m.y = zombieFootY(rw) - 26.0
        m.active = false
        m.alive = true
        g.mowers.add(m)
    }
}

// ==================== 资源 ====================

func loadResources(Game g, Renderer r) {
    g.texBg        = art.loadTex(r, "background1.jpg")
    g.texTitle     = art.loadTex(r, "titlescreen.jpg")
    g.texSun       = art.loadTex(r, "Sun1.png")
    g.texPea       = art.loadTex(r, "ProjectilePea.png")
    g.texSnowPea   = art.loadTex(r, "ProjectileSnowPea.png")
    g.texShovel    = art.loadTex(r, "Shovel.png")
    g.texShovelBank= art.loadTex(r, "ShovelBank.png")
    g.texSunBank   = art.loadTex(r, "SunBank.png")
    g.texSeedBank  = art.loadTex(r, "SeedBank.png")
    g.texFlagMeter = art.loadTex(r, "FlagMeter.png")
    g.texProgress  = art.loadTex(r, "FlagMeterLevelProgress.png")
    g.texCone      = art.loadTex(r, "Zombie_cone1.png")
    g.texBucket    = art.loadTex(r, "Zombie_bucket1.png")
    g.texMowerBody = art.loadTex(r, "LawnMower_body.png")
    g.texMowerWheel1 = art.loadTex(r, "LawnMower_wheel1.png")
    g.texMowerWheel2 = art.loadTex(r, "LawnMower_wheel2.png")

    if g.texCone != null {
        var[float, float](cw, ch) = r.getTextureSize(g.texCone)
        g.coneW = cw; g.coneH = ch
    }
    if g.texBucket != null {
        var[float, float](bw, bh) = r.getTextureSize(g.texBucket)
        g.bucketW = bw; g.bucketH = bh
    }
    // 护具在僵尸骨架坐标系里的挂点（取自 Zombie.reanim 的 anim_cone / anim_bucket）
    g.coneOx = 13.1
    g.coneOy = -18.7
    g.bucketOx = 1.5
    g.bucketOy = -8.0

    // 动画
    g.anPeashooter = art.loadAnim(r, "peashooter_idle.txt")
    g.anPeaShoot   = art.loadAnim(r, "peashooter_shoot.txt")
    g.anSnowPea    = art.loadAnim(r, "snowpea_idle.txt")
    g.anSnowShoot  = art.loadAnim(r, "snowpea_shoot.txt")
    g.anSunflower  = art.loadAnim(r, "sunflower_idle.txt")
    g.anWallnut    = art.loadAnim(r, "wallnut_idle.txt")
    g.anCherry     = art.loadAnim(r, "cherry_idle.txt")
    g.anSun        = art.loadAnim(r, "sun_idle.txt")
    g.anZWalk      = art.loadAnim(r, "zombie_walk.txt")
    g.anZEat       = art.loadAnim(r, "zombie_eat.txt")
    g.anZDeath     = art.loadAnim(r, "zombie_death.txt")

    // 僵尸三个动作共用一套原点（以走路为准），避免切动作时跳位
    var[float, float](zx, zy) = art.calcOrigin(g.anZWalk)
    art.setOrigin(g.anZEat, zx, zy)
    art.setOrigin(g.anZDeath, zx, zy)
    // 豌豆射手两个动作同理
    var[float, float](px, py) = art.calcOrigin(g.anPeashooter)
    art.setOrigin(g.anPeaShoot, px, py)
    var[float, float](sx, sy) = art.calcOrigin(g.anSnowPea)
    art.setOrigin(g.anSnowShoot, sx, sy)

    // 音频
    // 音效是随包资源 ⇒ res_dir()（未打包 == script_dir()，打包后 = 内嵌资源释放目录）
    var sd = dirs.res_dir() + "/sound/"
    g.bgm     = audio.createSound(sd + "ZombiesOnYourLawn.ogg")
    g.winMus  = audio.createSound(sd + "winmusic.ogg")
    g.loseMus = audio.createSound(sd + "losemusic.ogg")
    g.sfxPlant   = audio.createSfx(sd + "plant.ogg", 4, 0.45)
    g.sfxThrow   = audio.createSfx(sd + "throw.ogg", 6, 0.22)
    g.sfxSplat   = audio.createSfx(sd + "splat.ogg", 6, 0.20)
    g.sfxCherry  = audio.createSfx(sd + "cherrybomb.ogg", 2, 0.55)
    g.sfxShovel  = audio.createSfx(sd + "shovel.ogg", 3, 0.4)
    g.sfxCoin    = audio.createSfx(sd + "coin.ogg", 5, 0.35)
    g.sfxGroan   = audio.createSfx(sd + "groan.ogg", 4, 0.25)
    g.sfxPop     = audio.createSfx(sd + "limbs_pop.ogg", 4, 0.35)
    g.sfxAwooga  = audio.createSfx(sd + "awooga.ogg", 1, 0.5)
    g.sfxMower   = audio.createSfx(sd + "lawnmower.ogg", 2, 0.5)
    g.sfxChomp   = audio.createSfx(sd + "chomp.ogg", 4, 0.18)
    g.sfxBuzzer  = audio.createSfx(sd + "buzzer.ogg", 2, 0.3)

    g.audioOk = g.bgm.ok
    if g.audioOk {
        g.bgm.setLooping(true)
        g.bgm.setVolume(0.32)
        g.bgm.play()
    } else {
        print("[警告] 音频初始化失败，游戏将以静音模式运行")
    }

    g.loaded = true
    print("[OK] 资源加载完成")
}

func sfx(Game g, Sfx s) {
    if g.audioOk and not g.muted { s.play() }
}

// ==================== 特效 ====================

func addParticles(Game g, float x, float y, int n, int c) {
    if g.pCount > 500 { return }
    for 0 : n - 1 to i {
        var p = new Particle()
        var a = _float(rands.ints(0, 359)) * 3.14159265 / 180.0
        var sp = _float(rands.ints(10, 45)) / 10.0
        p.x = x; p.y = y
        p.vx = maths.cos(a) * sp
        p.vy = maths.sin(a) * sp
        p.size = _float(rands.ints(2, 6))
        p.life = rands.ints(16, 34)
        p.maxLife = p.life
        p.c = c
        g.particles.add(p)
        g.pCount = g.pCount + 1
    }
}

func addFloat(Game g, float x, float y, string text, int c) {
    var f = new FloatText()
    f.x = x; f.y = y
    f.text = text
    f.c = c
    f.life = 50
    f.maxLife = 50
    g.floats.add(f)
}

// ==================== 生成 ====================

func spawnSunAt(Game g, float x, float y, bool falling, float ty) {
    var s = new Sun()
    s.x = x
    s.y = y
    s.ty = ty
    s.falling = falling
    s.alive = true
    s.life = 700
    g.suns.add(s)
}

func spawnSkySun(Game g) {
    var x = GRID_X + 60.0 + _float(rands.ints(0, _int(GRID_W) - 140))
    var row = rands.ints(0, ROWS - 1)
    var ty = rowCenterY(row) + _float(rands.ints(-20, 30))
    spawnSunAt(g, x, GRID_Y - 44.0, true, ty)
}

func spawnZombie(Game g, int row, int ztype) {
    var z = new Zombie()
    z.ztype = ztype
    z.row = row
    z.x = SPAWN_X
    z.y = zombieFootY(row)
    z.maxHp = Z_HP[ztype]
    z.hp = z.maxHp
    z.hatMax = Z_HAT[ztype]
    z.hatHp = z.hatMax
    z.speed = Z_SPD[ztype]
    z.alive = true
    z.eating = false
    z.eatTimer = 0
    z.slowTimer = 0
    z.slowAmt = 0.0
    z.anim = 0
    z.aframe = _float(rands.ints(0, 40))
    z.dying = false
    z.dieTimer = 0
    g.zombies.add(z)
}

func buildWave(Game g, int wave): Array[int] {
    Array[int] q = []
    var n = 3 + wave * 2
    if n > 26 { n = 26 }
    for 0 : n - 1 to i {
        var t = Z_NORMAL
        var r = rands.ints(0, 99)
        if wave >= 7 {
            if r < 40 { t = Z_NORMAL } else if r < 75 { t = Z_CONE } else { t = Z_BUCKET }
        } else if wave >= 4 {
            if r < 50 { t = Z_NORMAL } else if r < 85 { t = Z_CONE } else { t = Z_BUCKET }
        } else if wave >= 2 {
            if r < 70 { t = Z_NORMAL } else { t = Z_CONE }
        }
        q.add(t)
    }
    return q
}

func startWave(Game g) {
    g.wave = g.wave + 1
    g.spawnQueue = buildWave(g, g.wave)
    g.spawnIdx = 0
    g.spawnTimer = 0
    g.waveState = 1
    g.hugeWave = g.wave >= WAVE_TOTAL
    if g.hugeWave {
        g.bannerText = "一大波僵尸正在接近！"
        sfx(g, g.sfxAwooga)
        for 0 : 7 to i { g.spawnQueue.add(Z_CONE) }
    } else {
        g.bannerText = "第 " + g.wave + " 波"
        if g.wave % 3 == 0 { sfx(g, g.sfxAwooga) }
    }
    g.bannerTimer = 130
}

// ==================== 更新 ====================

func updateWaves(Game g) {
    if g.waveState == 0 {
        g.waveTimer = g.waveTimer - 1
        if g.waveTimer <= 0 { startWave(g) }
    } else if g.waveState == 1 {
        g.spawnTimer = g.spawnTimer - 1
        if g.spawnTimer <= 0 {
            if g.spawnIdx < g.spawnQueue.len() {
                var t = g.spawnQueue[g.spawnIdx]
                g.spawnIdx = g.spawnIdx + 1
                spawnZombie(g, rands.ints(0, ROWS - 1), t)
                var gap = 90 - g.wave * 4
                if gap < 26 { gap = 26 }
                if g.hugeWave { gap = 20 }
                g.spawnTimer = gap
            } else {
                g.waveState = 2
            }
        }
    } else if g.waveState == 2 {
        if g.zombies.len() == 0 {
            if g.wave >= WAVE_TOTAL {
                g.state = ST_WIN
                if g.audioOk { g.bgm.stop(); g.winMus.play() }
            } else {
                g.waveState = 0
                g.waveTimer = 1100 - g.wave * 45
                if g.waveTimer < 480 { g.waveTimer = 480 }
            }
        }
    }
}

func findPlantAhead(Game g, Zombie z): int {
    var best = -1
    var bestX = -9999.0
    var i = 0
    for g.plants to p {
        if p.row == z.row and p.alive {
            if p.x > z.x - 56.0 and p.x < z.x + 20.0 {
                if p.x > bestX { bestX = p.x; best = i }
            }
        }
        i = i + 1
    }
    return best
}

func damagePlant(Game g, int idx, float dmg) {
    if idx < 0 or idx >= g.plants.len() { return }
    var i = 0
    for g.plants to p {
        if i == idx {
            if not p.alive { return }
            p.hp = p.hp - dmg
            if p.hp <= 0 {
                p.alive = false
                addParticles(g, p.x, p.y - 30.0, 14, #7CB342FF)
            }
            return
        }
        i = i + 1
    }
}

func damageZombie(Game g, int idx, float dmg, bool ice) {
    if idx < 0 or idx >= g.zombies.len() { return }
    var i = 0
    for g.zombies to z {
        if i == idx {
            if not z.alive or z.dying { return }
            if z.hatHp > 0 {
                z.hatHp = z.hatHp - _int(dmg)
                if z.hatHp < 0 { z.hatHp = 0 }
            } else {
                z.hp = z.hp - dmg
            }
            if ice {
                z.slowTimer = 360
                z.slowAmt = 0.5
            }
            if z.hp <= 0 {
                z.dying = true
                z.anim = 2
                z.aframe = 0.0
                z.dieTimer = 0
                g.killed = g.killed + 1
                addParticles(g, z.x, z.y - 60.0, 16, #8D6E63FF)
                sfx(g, g.sfxPop)
            }
            return
        }
        i = i + 1
    }
}

func updateZombies(Game g) {
    Array[Zombie] live = []
    for g.zombies to z {
        if not z.alive { continue }
        if z.dying {
            // 死亡动画：加速播放，播完移除
            z.aframe = z.aframe + _float(g.anZDeath.fps) / 60.0 * 1.7
            z.dieTimer = z.dieTimer + 1
            if z.aframe < _float(g.anZDeath.nFrame) { live.add(z) }
            continue
        }

        var spd = z.speed
        if z.slowTimer > 0 {
            spd = spd * (1.0 - z.slowAmt)
            z.slowTimer = z.slowTimer - 1
        }

        var pi = findPlantAhead(g, z)
        if pi >= 0 {
            if z.anim != 1 { z.anim = 1; z.aframe = 0.0 }
            z.eating = true
            z.eatTimer = z.eatTimer + 1
            damagePlant(g, pi, Z_EAT)
            if z.eatTimer % 24 == 0 { sfx(g, g.sfxChomp) }
            z.aframe = art.stepFrame(g.anZEat, z.aframe)
            live.add(z)
            continue
        }
        if z.eating or z.anim == 1 {
            z.eating = false
            z.anim = 0
        }

        z.x = z.x - spd
        z.aframe = art.stepFrame(g.anZWalk, z.aframe)
        if _int(z.aframe) == 0 and rands.ints(0, 3) == 0 { sfx(g, g.sfxGroan) }

        if z.x < MOWER_TRIG {
            var mi = -1
            var k = 0
            for g.mowers to m {
                if m.row == z.row and m.alive and not m.active { mi = k }
                k = k + 1
            }
            if mi >= 0 {
                g.mowers[mi].active = true
                sfx(g, g.sfxMower)
            } else if z.x < LOSE_X {
                g.state = ST_LOSE
                if g.audioOk { g.bgm.stop(); g.loseMus.play() }
            }
        }
        live.add(z)
    }
    g.zombies = live
}

func updatePlants(Game g) {
    Array[Plant] live = []
    for g.plants to p {
        if not p.alive { continue }

        if p.ptype == P_CHERRY {
            p.fuse = p.fuse - 1
            p.aframe = art.stepFrame(g.anCherry, p.aframe)
            if p.fuse <= 0 {
                explode(g, p.x, p.y)
                continue
            }
        }

        if p.ptype == P_PEASHOOTER or p.ptype == P_SNOWPEA {
            var has = false
            for g.zombies to z {
                if z.alive and not z.dying and z.row == p.row and z.x > p.x - 10.0 {
                    has = true
                    break
                }
            }
            if has {
                // 射击动画驱动出豆：跨过 SHOOT_FIRE 帧时发射一颗
                if p.anim != 1 { p.anim = 1; p.aframe = 0.0 }
                var prev = p.aframe
                p.aframe = p.aframe + 12.0 / 60.0 * ANIM_SPEED
                if prev < SHOOT_FIRE and p.aframe >= SHOOT_FIRE {
                    var b = new Pea()
                    b.row = p.row
                    b.x = p.x + 26.0
                    b.y = peaLineY(p.row)
                    b.vx = PEA_SPEED
                    b.kind = if p.ptype == P_SNOWPEA then 1 else 0
                    b.alive = true
                    g.peas.add(b)
                    sfx(g, g.sfxThrow)
                }
                if p.aframe >= 25.0 { p.aframe = p.aframe - 25.0 }
            } else {
                p.anim = 0
                p.aframe = art.stepFrame(g.anPeashooter, p.aframe)
            }
            live.add(p)
            continue
        }

        if p.ptype == P_SUNFLOWER {
            p.timer = p.timer + 1
            p.aframe = art.stepFrame(g.anSunflower, p.aframe)
            var need = SUN_MAKE_CD
            if p.fuse == 0 { need = SUN_FIRST }
            if p.timer >= need {
                p.timer = 0
                p.fuse = 1
                spawnSunAt(g, p.x - 6.0, p.y - 60.0, false, p.y - 8.0)
            }
            live.add(p)
            continue
        }

        p.aframe = art.stepFrame(animOf(g, p.ptype, 0), p.aframe)
        live.add(p)
    }
    g.plants = live
}

func explode(Game g, float x, float y) {
    addParticles(g, x, y - 40.0, 40, #E53935FF)
    addParticles(g, x, y - 40.0, 24, #FFB300FF)
    sfx(g, g.sfxCherry)
    var i = 0
    for g.zombies to z {
        if z.alive and not z.dying {
            if z.x > x - 170.0 and z.x < x + 170.0 {
                var dy = z.y - y
                if dy > -180.0 and dy < 180.0 { damageZombie(g, i, CHERRY_DMG, false) }
            }
        }
        i = i + 1
    }
}

func rowOfY(float y): int {
    var r = _int((y - (CELL_H - 8.0) - GRID_Y) / CELL_H)
    if r < 0 { r = 0 }
    if r > ROWS - 1 { r = ROWS - 1 }
    return r
}

func updatePeas(Game g) {
    Array[Pea] live = []
    for g.peas to b {
        if not b.alive { continue }
        b.x = b.x + b.vx
        if b.x > WIN_W + 20.0 { continue }
        var hit = false
        var i = 0
        for g.zombies to z {
            if z.alive and not z.dying and z.row == b.row {
                // 僵尸本体宽约 42px（原点在包围盒中心），命中窗口略放宽到手臂
                if b.x > z.x - 26.0 and b.x < z.x + 14.0 {
                    damageZombie(g, i, PEA_DMG, b.kind == 1)
                    addParticles(g, b.x, b.y, 5, if b.kind == 1 then #4FC3F7FF else #66BB6AFF)
                    sfx(g, g.sfxSplat)
                    hit = true
                    break
                }
            }
            i = i + 1
        }
        if not hit { live.add(b) }
    }
    g.peas = live
}

func updateSuns(Game g) {
    Array[Sun] live = []
    for g.suns to s {
        if not s.alive { continue }
        if s.collecting {
            // 飞向阳光库，抵达后入账
            var dx = s.targetX - s.x
            var dy = s.targetY - s.y
            var dist = maths.hypot(dx, dy)
            if dist < 5.0 {
                g.sun = g.sun + SUN_VALUE
                addFloat(g, s.x - 12.0, s.y - 10.0, "+" + SUN_VALUE, #FFD54FFF)
                addParticles(g, s.x, s.y, 8, #FFD54FFF)
                sfx(g, g.sfxCoin)
                s.alive = false
                continue
            }
            var speed = 9.0
            s.x = s.x + dx / dist * speed
            s.y = s.y + dy / dist * speed
            live.add(s)
            continue
        }
        if s.falling {
            s.y = s.y + 1.1
            if s.y >= s.ty { s.y = s.ty; s.falling = false }
            live.add(s)
        } else {
            s.life = s.life - 1
            if s.life > 0 { live.add(s) }
        }
    }
    g.suns = live
}

func updateMowers(Game g) {
    Array[Mower] live = []
    for g.mowers to m {
        if not m.alive { continue }
        if m.active {
            m.x = m.x + 7.0
            var i = 0
            for g.zombies to z {
                if z.alive and not z.dying and z.row == m.row {
                    if z.x > m.x - 46.0 and z.x < m.x + 46.0 {
                        z.hp = 0.0
                        z.hatHp = 0
                        z.dying = true
                        z.anim = 2
                        z.aframe = 0.0
                        g.killed = g.killed + 1
                        addParticles(g, z.x, z.y - 56.0, 18, #8D6E63FF)
                        sfx(g, g.sfxPop)
                    }
                }
                i = i + 1
            }
            if m.x > WIN_W + 30.0 { continue }
        }
        live.add(m)
    }
    g.mowers = live
}

func updateEffects(Game g) {
    Array[Particle] lp = []
    for g.particles to p {
        p.x = p.x + p.vx
        p.y = p.y + p.vy
        p.vy = p.vy + 0.08
        p.life = p.life - 1
        if p.life > 0 { lp.add(p) }
    }
    g.particles = lp
    g.pCount = lp.len()

    Array[FloatText] lf = []
    for g.floats to f {
        f.y = f.y - 0.5
        f.life = f.life - 1
        if f.life > 0 { lf.add(f) }
    }
    g.floats = lf
}

func updateGame(Game g) {
    g.frameCount = g.frameCount + 1
    if g.bannerTimer > 0 { g.bannerTimer = g.bannerTimer - 1 }
    for 0 : N_CARD - 1 to i {
        if g.cardCd[i] > 0 { g.cardCd[i] = g.cardCd[i] - 1 }
    }
    g.skyTimer = g.skyTimer - 1
    if g.skyTimer <= 0 {
        g.skyTimer = SKY_SUN_CD
        spawnSkySun(g)
    }
    updateWaves(g)
    updateZombies(g)
    updatePlants(g)
    updatePeas(g)
    updateSuns(g)
    updateMowers(g)
    updateEffects(g)
}

// ==================== 种植 ====================

func plantAt(Game g, int row, int col): int {
    var i = 0
    for g.plants to p {
        if p.alive and p.row == row and p.col == col { return i }
        i = i + 1
    }
    return -1
}

func tryPlant(Game g, int row, int col) {
    var t = g.selCard
    if t < 0 { return }
    if g.cardCd[t] > 0 {
        addFloat(g, colCenterX(col) - 20.0, rowCenterY(row), "冷却中", #FF8A65FF)
        sfx(g, g.sfxBuzzer)
        return
    }
    if g.sun < PLANT_COST[t] {
        addFloat(g, colCenterX(col) - 24.0, rowCenterY(row), "阳光不足", #FF8A65FF)
        sfx(g, g.sfxBuzzer)
        return
    }
    if plantAt(g, row, col) >= 0 { return }
    g.sun = g.sun - PLANT_COST[t]
    g.cardCd[t] = PLANT_CD[t]
    var p = new Plant()
    p.ptype = t
    p.row = row
    p.col = col
    p.x = colCenterX(col)
    p.y = plantFootY(row)
    p.maxHp = PLANT_HP[t]
    p.hp = p.maxHp
    p.timer = 0
    p.fuse = if t == P_CHERRY then CHERRY_FUSE else 0
    p.anim = 0
    p.aframe = _float(rands.ints(0, 20))
    p.alive = true
    g.plants.add(p)
    sfx(g, g.sfxPlant)
    addParticles(g, p.x, p.y - 6.0, 8, #A5D6A7FF)
    g.selCard = -1
}

func doShovel(Game g, int row, int col) {
    var i = plantAt(g, row, col)
    if i < 0 { return }
    var p = g.plants[i]
    addParticles(g, p.x, p.y - 20.0, 12, #A5D6A7FF)
    g.sun = g.sun + PLANT_COST[p.ptype] / 2
    Array[Plant] keep = []
    for 0 : g.plants.len() - 1 to k {
        if k != i { keep.add(g.plants[k]) }
    }
    g.plants = keep
    sfx(g, g.sfxShovel)
    g.shovelMode = false
}

func collectSunAt(Game g, float mx, float my): bool {
    // 点击阳光：半径内重叠的所有阳光全部起飞飞向阳光库（不在点击瞬间入账）
    var anyHit = false
    var targetX = SUNBANK_X + SUNBANK_W * 0.5
    var targetY = SUNBANK_Y + SUNBANK_H * 0.5
    for g.suns to s {
        if not s.alive or s.collecting { continue }
        var dx = mx - s.x
        var dy = my - s.y
        if dx > -28.0 and dx < 28.0 and dy > -28.0 and dy < 28.0 {
            s.collecting = true
            s.targetX = targetX
            s.targetY = targetY
            anyHit = true
        }
    }
    return anyHit
}

// ==================== 渲染 ====================

func drawBackground(Game g, Renderer r) {
    if g.texBg != null {
        // 源图 1400x600，取左侧 1000 宽（房子 + 草坪）铺满窗口
        r.drawTextureFromTo(g.texBg, 0.0, 0.0, 1000.0, 600.0,
                            0.0, 0.0, _float(WIN_W), _float(WIN_H))
    } else {
        r.clearColor(#4E8B3AFF)
    }
    // 顶部工具条（压在房子墙面上）
    r.setColor(#3B2412CC)
    r.fillRect(0.0, 0.0, _float(WIN_W), GRID_Y - 6.0)
    r.setColor(#8D6E63FF)
    r.fillRect(0.0, GRID_Y - 8.0, _float(WIN_W), 3.0)
}

func drawPlants(Game g, Renderer r, int row) {
    for g.plants to p {
        if p.row != row { continue }
        var an = animOf(g, p.ptype, p.anim)
        var s = PLANT_S[p.ptype]
        if p.ptype == P_CHERRY {
            var k = 1.0 - _float(p.fuse) / _float(CHERRY_FUSE)
            s = s * (1.0 + 0.18 * k)
            if p.fuse % 12 < 6 { s = s + 0.05 }
        }
        art.drawAnim(r, an, p.aframe, p.x, p.y, s)
        if p.hp < p.maxHp {
            var ratio = p.hp / p.maxHp
            r.setColor(#00000099)
            r.fillRect(p.x - 22.0, p.y + 4.0, 44.0, 4.0)
            if ratio > 0.5 { r.setColor(#66BB6AFF) }
            else if ratio > 0.25 { r.setColor(#FFCA28FF) }
            else { r.setColor(#EF5350FF) }
            r.fillRect(p.x - 22.0, p.y + 4.0, 44.0 * ratio, 4.0)
        }
    }
}

func drawZombies(Game g, Renderer r, int row) {
    for g.zombies to z {
        if z.row != row { continue }
        var an = g.anZWalk
        if z.anim == 1 { an = g.anZEat }
        else if z.anim == 2 { an = g.anZDeath }
        art.drawAnim(r, an, z.aframe, z.x, z.y, Z_SCALE)

        if z.hatHp > 0 and not z.dying {
            if z.ztype == Z_CONE {
                art.drawHat(r, g.texCone, g.coneW, g.coneH, an,
                            z.x, z.y, Z_SCALE, g.coneOx, g.coneOy)
            } else if z.ztype == Z_BUCKET {
                art.drawHat(r, g.texBucket, g.bucketW, g.bucketH, an,
                            z.x, z.y, Z_SCALE, g.bucketOx, g.bucketOy)
            }
        }
        if z.slowTimer > 0 and not z.dying {
            r.setColor(#4FC3F755)
            r.fillCircle(z.x, z.y - 56.0 * Z_SCALE, 34.0)
        }
        if not z.dying {
            var ratio = z.hp / z.maxHp
            if z.hatHp > 0 { ratio = _float(z.hatHp) / _float(z.hatMax) }
            r.setColor(#00000099)
            r.fillRect(z.x - 24.0, z.y + 6.0, 48.0, 4.0)
            if z.hatHp > 0 { r.setColor(#B0BEC5FF) }
            else if ratio > 0.5 { r.setColor(#66BB6AFF) }
            else if ratio > 0.25 { r.setColor(#FFCA28FF) }
            else { r.setColor(#EF5350FF) }
            r.fillRect(z.x - 24.0, z.y + 6.0, 48.0 * ratio, 4.0)
        }
    }
}

func drawRowEntities(Game g, Renderer r) {
    for 0 : ROWS - 1 to row {
        drawPlants(g, r, row)
        drawZombies(g, r, row)
    }
}

func drawPeas(Game g, Renderer r) {
    for g.peas to b {
        var t = g.texPea
        if b.kind == 1 { t = g.texSnowPea }
        if t == null { continue }
        r.drawTextureAt(t, b.x - 14.0, b.y - 14.0, 28.0, 28.0)
    }
}

func drawSuns(Game g, Renderer r) {
    if g.anSun.nPart == 0 {
        if g.texSun != null {
            for g.suns to s {
                r.drawTextureAt(g.texSun, s.x - 22.0, s.y - 22.0, 44.0, 44.0)
            }
        }
        return
    }
    var af = _float((g.frameCount / 5) % g.anSun.nFrame)
    for g.suns to s {
        art.drawSun(r, g.anSun, af, s.x, s.y, 0.7)
    }
}

func drawShovelPreview(Game g, Renderer r) {
    // 铲除模式：把铲子贴在鼠标上
    if not g.shovelMode { return }
    if g.state != ST_PLAY { return }
    var w = 64.0
    var h = 64.0
    if g.texShovel != null {
        r.drawTextureAt(g.texShovel, g.mouseX - w * 0.5, g.mouseY - h * 0.5, w, h)
    } else {
        r.setColor(#3E2A10CC)
        r.fillRoundedRect(g.mouseX - w * 0.5, g.mouseY - h * 0.5, w, h, 8.0)
        r.drawTextCentered(g.font, "铲", g.mouseX - w * 0.5, w, g.mouseY - 12.0, #FFFFFFFF)
    }
    // 在鼠标下方高亮当前格子
    if g.mouseX > GRID_X and g.mouseX < GRID_X + GRID_W and g.mouseY > GRID_Y and g.mouseY < GRID_Y + GRID_H {
        var col = _int((g.mouseX - GRID_X) / CELL_W)
        var row = _int((g.mouseY - GRID_Y) / CELL_H)
        if col >= 0 and col < COLS and row >= 0 and row < ROWS {
            if plantAt(g, row, col) >= 0 {
                r.setColor(#EF535066)
                r.fillRect(GRID_X + _float(col) * CELL_W, GRID_Y + _float(row) * CELL_H, CELL_W, CELL_H)
            }
        }
    }
}

func drawMowers(Game g, Renderer r) {
    for g.mowers to m {
        if not m.alive { continue }
        // 阴影
        r.setColor(#00000044)
        r.fillRect(m.x - 26.0, m.y + 20.0, 52.0, 8.0)
        if g.texMowerBody != null {
            var[float, float](bw, bh) = r.getTextureSize(g.texMowerBody)
            var s = 48.0 / bw
            r.drawTextureAt(g.texMowerBody, m.x - 24.0, m.y - 6.0, bw * s, bh * s)
            if g.texMowerWheel1 != null {
                r.drawTextureAt(g.texMowerWheel1, m.x - 14.0 - 9.0, m.y + 14.0, 18.0, 18.0)
            }
            if g.texMowerWheel2 != null {
                r.drawTextureAt(g.texMowerWheel2, m.x + 14.0 - 9.0, m.y + 14.0, 18.0, 18.0)
            }
        } else {
            r.setColor(#8D6E63FF)
            r.fillRect(m.x - 24.0, m.y - 6.0, 48.0, 26.0)
            r.setColor(#5D4037FF)
            r.fillRect(m.x - 24.0, m.y - 10.0, 48.0, 6.0)
            r.setColor(#212121FF)
            r.fillCircle(m.x - 14.0, m.y + 24.0, 9.0)
            r.fillCircle(m.x + 14.0, m.y + 24.0, 9.0)
            r.setColor(#9E9E9EFF)
            r.fillCircle(m.x - 14.0, m.y + 24.0, 4.0)
            r.fillCircle(m.x + 14.0, m.y + 24.0, 4.0)
        }
    }
}

func drawCard(Game g, Renderer r, int i, float x, float y, float w, float h) {
    var cost = PLANT_COST[i]
    var afford = g.sun >= cost
    var cd = g.cardCd[i]
    var ready = cd <= 0 and afford
    var sel = g.selCard == i

    r.setColor(if sel then #6D4C1BFF else #3E2A10FF)
    r.fillRoundedRect(x, y, w, h, 6.0)
    r.setColor(if ready then #F2C86BFF else #6B5431FF)
    r.drawRoundedRect(x, y, w, h, 6.0)
    r.setColor(#F5E3B8FF)
    r.fillRect(x + 3.0, y + 3.0, w - 6.0, h - 6.0)

    var an = animOf(g, i, 0)
    art.drawAnim(r, an, _float(g.frameCount / 6) , x + w * 0.5, y + h - 10.0, CARD_ICON_S[i])

    if not ready {
        r.setColor(#000000AA)
        r.fillRect(x + 3.0, y + 3.0, w - 6.0, h - 6.0)
    }
    if cd > 0 {
        var k = _float(cd) / _float(PLANT_CD[i])
        r.setColor(#00000099)
        r.fillRect(x + 3.0, y + 3.0, w - 6.0, (h - 6.0) * k)
    }
    r.drawTextCentered(g.font, "" + cost, x, w, y + h - 15.0,
                       if afford then #FFD54FFF else #EF5350FF)
}

func drawHUD(Game g, Renderer r) {
    // 种子栏背景
    if g.texSeedBank != null {
        r.drawTextureAt(g.texSeedBank, CARD_X0 - 6.0, 0.0, _float(N_CARD) * CARD_GAP + 12.0, CARD_H + 8.0)
    }
    // 阳光库
    if g.texSunBank != null {
        r.drawTextureAt(g.texSunBank, SUNBANK_X, SUNBANK_Y, SUNBANK_W, SUNBANK_H)
    } else {
        r.setColor(#00000088)
        r.fillRoundedRect(SUNBANK_X, SUNBANK_Y, SUNBANK_W, SUNBANK_H, 8.0)
    }
    r.drawTextCentered(g.font, "" + g.sun, SUNBANK_X, SUNBANK_W, SUNBANK_Y + 58.0, #FFFFFF)

    for 0 : N_CARD - 1 to i {
        var cx = CARD_X0 + _float(i) * CARD_GAP
        drawCard(g, r, i, cx, CARD_Y, CARD_W, CARD_H)
        r.drawTextCentered(g.font, "" + (i + 1), cx, CARD_W, CARD_Y + 2.0, #6D4C1BFF)
    }

    // 铲子区域背景
    if g.texShovelBank != null {
        r.drawTextureAt(g.texShovelBank, SHOVEL_X - 2.0, SHOVEL_Y - 2.0, SHOVEL_W + 4.0, SHOVEL_W + 4.0)
    } else {
        r.setColor(#3E2A10CC)
        r.fillRoundedRect(SHOVEL_X, SHOVEL_Y, SHOVEL_W, SHOVEL_W, 8.0)
    }
    if inRect(g.mouseX, g.mouseY, SHOVEL_X, SHOVEL_Y, SHOVEL_W, SHOVEL_W) or g.shovelMode {
        r.setColor(#FFD54F44)
        r.fillRoundedRect(SHOVEL_X, SHOVEL_Y, SHOVEL_W, SHOVEL_W, 8.0)
    }
    if g.texShovel != null {
        r.drawTextureAt(g.texShovel, SHOVEL_X + 3.0, SHOVEL_Y + 3.0, SHOVEL_W - 6.0, SHOVEL_W - 6.0)
    } else {
        r.drawTextCentered(g.font, "铲", SHOVEL_X, SHOVEL_W, SHOVEL_Y + 22.0, #FFFFFFFF)
    }

    // 波次进度：自绘进度条 + 旗帜标记，文字画在条下方，互不遮挡
    var prog = _float(g.wave) / _float(WAVE_TOTAL)
    if g.waveState == 1 {
        prog = prog + (_float(g.spawnIdx) / _float(g.spawnQueue.len() + 1)) / _float(WAVE_TOTAL)
    }
    if prog > 1.0 { prog = 1.0 }
    r.setColor(#00000099)
    r.fillRoundedRect(FLAG_X, FLAG_Y, 226.0, 24.0, 6.0)
    r.setColor(#5D4037FF)
    r.fillRoundedRect(FLAG_X + 4.0, FLAG_Y + 4.0, 218.0, 16.0, 4.0)
    r.setColor(#7CB342FF)
    r.fillRect(FLAG_X + 6.0, FLAG_Y + 6.0, 214.0 * prog, 12.0)
    if g.texProgress != null {
        r.drawTextureAt(g.texProgress, FLAG_X + 6.0 + 214.0 * prog - 12.0, FLAG_Y - 2.0, 24.0, 24.0)
    }
    r.drawText(g.font, "波次 " + g.wave + " / " + WAVE_TOTAL + "    击杀 " + g.killed,
               FLAG_X, FLAG_Y + 30.0, #FFFFFF)

    r.drawText(g.font, "左键选卡→种植物   点阳光收集   S/铲子 移除植物   P 暂停   R 重开   M 静音",
               12.0, _float(WIN_H) - 24.0, #E8F5E9FF)
}

func drawOverlay(Game g, Renderer r, string title, string sub) {
    r.setColor(#000000BB)
    r.fillRect(0.0, 0.0, _float(WIN_W), _float(WIN_H))
    // 中央面板
    var pw = 460.0
    var ph = 200.0
    var px = _float(WIN_W) * 0.5 - pw * 0.5
    var py = _float(WIN_H) * 0.5 - ph * 0.5
    r.setColor(#2D1B0FDD)
    r.fillRoundedRect(px, py, pw, ph, 14.0)
    r.setColor(#8D6E63FF)
    r.drawRoundedRect(px, py, pw, ph, 14.0)
    r.setColor(#FFD54FFF)
    r.drawRoundedRect(px + 3.0, py + 3.0, pw - 6.0, ph - 6.0, 12.0)
    r.drawTextCentered(g.fontBig, title, 0.0, _float(WIN_W), _float(WIN_H) * 0.5 - 40.0, #FFD54FFF)
    r.drawTextCentered(g.font, sub, 0.0, _float(WIN_W), _float(WIN_H) * 0.5 + 6.0, #F1F8E9FF)
}

// 通用菜单按钮：返回 hover 状态（true = 鼠标在按钮上）
func drawButton(Game g, Renderer r, float cx, float cy, string label, bool hov) {
    var bx = cx - MENU_BTN_W * 0.5
    var by = cy - MENU_BTN_H * 0.5
    r.setColor(if hov then #4CAF50FF else #2E7D32FF)
    r.fillRoundedRect(bx, by, MENU_BTN_W, MENU_BTN_H, 10.0)
    r.setColor(if hov then #81C784FF else #66BB6AFF)
    r.drawRoundedRect(bx, by, MENU_BTN_W, MENU_BTN_H, 10.0)
    r.drawTextCentered(g.fontBig, label, bx, MENU_BTN_W, by + MENU_BTN_H * 0.5 - 15.0, #FFFFFFFF)
}

func menuBtnHover(Game g, float cx, float cy): bool {
    return inRect(g.mouseX, g.mouseY, cx - MENU_BTN_W * 0.5, cy - MENU_BTN_H * 0.5, MENU_BTN_W, MENU_BTN_H)
}

func menuBtnHit(float mx, float my, float cx, float cy): bool {
    return inRect(mx, my, cx - MENU_BTN_W * 0.5, cy - MENU_BTN_H * 0.5, MENU_BTN_W, MENU_BTN_H)
}

func drawMenuButtons(Game g, Renderer r) {
    var cx = _float(WIN_W) * 0.5
    var cy1 = _float(WIN_H) * 0.5 + 30.0
    var cy2 = cy1 + MENU_BTN_GAP
    drawButton(g, r, cx, cy1, "开 始 游 戏", menuBtnHover(g, cx, cy1))
    drawButton(g, r, cx, cy2, "操 作 说 明", menuBtnHover(g, cx, cy2))
}

func drawPauseMenu(Game g, Renderer r) {
    var cx = _float(WIN_W) * 0.5
    var baseY = _float(WIN_H) * 0.5 - 20.0
    drawButton(g, r, cx, baseY, "继 续 战 斗", menuBtnHover(g, cx, baseY))
    drawButton(g, r, cx, baseY + MENU_BTN_GAP, "重 新 开 始", menuBtnHover(g, cx, baseY + MENU_BTN_GAP))
    drawButton(g, r, cx, baseY + MENU_BTN_GAP * 2.0, "返 回 主 菜 单", menuBtnHover(g, cx, baseY + MENU_BTN_GAP * 2.0))
}

func drawEndScreen(Game g, Renderer r, bool won) {
    var cx = _float(WIN_W) * 0.5
    var baseY = _float(WIN_H) * 0.5 + 40.0
    drawButton(g, r, cx, baseY, "再 来 一 局", menuBtnHover(g, cx, baseY))
    drawButton(g, r, cx, baseY + MENU_BTN_GAP, "返 回 主 菜 单", menuBtnHover(g, cx, baseY + MENU_BTN_GAP))
}

func drawHelpScreen(Game g, Renderer r) {
    if g.texTitle != null {
        r.drawTextureAt(g.texTitle, 0.0, 0.0, _float(WIN_W), _float(WIN_H))
    } else {
        r.setColor(#1B5E20FF)
        r.fillRect(0.0, 0.0, _float(WIN_W), _float(WIN_H))
    }
    r.setColor(#000000CC)
    r.fillRect(0.0, 0.0, _float(WIN_W), _float(WIN_H))
    // 面板
    var pw = 620.0
    var ph = 440.0
    var px = _float(WIN_W) * 0.5 - pw * 0.5
    var py = _float(WIN_H) * 0.5 - ph * 0.5
    r.setColor(#2D1B0FFF)
    r.fillRoundedRect(px, py, pw, ph, 14.0)
    r.setColor(#FFD54FFF)
    r.drawRoundedRect(px + 3.0, py + 3.0, pw - 6.0, ph - 6.0, 12.0)
    r.drawTextCentered(g.fontBig, "操 作 说 明", 0.0, _float(WIN_W), py + 40.0, #FFD54FFF)
    var ty = py + 84.0
    var lines = [
        "1. 点击种子卡片或按数字键 1~5 选择植物",
        "2. 在草坪格子上点击即可种植，消耗阳光",
        "3. 点击天空落下的阳光或向日葵产出的阳光收集",
        "4. 按 S 键或点击铲子进入铲除模式，再点植物移除",
        "5. 按 P 键暂停游戏",
        "6. 按 R 键重新开始本局",
        "7. 按 M 键静音/取消静音",
        "",
        "植物一览:",
        "  豌豆射手 (100)   - 直线射击，基础攻击",
        "  向日葵 (50)      - 产生阳光，经济核心",
        "  坚果墙 (50)      - 高血量，阻挡僵尸",
        "  寒冰射手 (175)   - 减速僵尸，控制防线",
        "  樱桃炸弹 (150)   - 范围爆炸，清场利器"
    ]
    for lines to line {
        r.drawText(g.font, line, px + 30.0, ty, #F1F8E9FF)
        ty = ty + 24.0
    }
    var cx = _float(WIN_W) * 0.5
    var by = py + ph - 40.0
    drawButton(g, r, cx, by, "返 回", menuBtnHover(g, cx, by))
}

func renderGame(Game g, Renderer r) {
    r.clearColor(#33502AFF)
    drawBackground(g, r)

    if g.selCard >= 0 and g.mouseY > GRID_Y and g.mouseX > GRID_X and g.mouseX < GRID_X + GRID_W {
        var col = _int((g.mouseX - GRID_X) / CELL_W)
        var row = _int((g.mouseY - GRID_Y) / CELL_H)
        if col >= 0 and col < COLS and row >= 0 and row < ROWS {
            var ok = plantAt(g, row, col) < 0
            var px = GRID_X + _float(col) * CELL_W
            var py = GRID_Y + _float(row) * CELL_H
            r.setColor(if ok then #FFFFFF33 else #EF535033)
            r.fillRect(px, py, CELL_W, CELL_H)
            r.setColor(if ok then #8BC34AFF else #EF5350FF)
            r.drawRect(px, py, CELL_W, CELL_H)
            if ok {
                art.drawAnim(r, animOf(g, g.selCard, 0), 0.0,
                             colCenterX(col), plantFootY(row), PLANT_S[g.selCard])
            }
        }
    }

    drawMowers(g, r)
    drawRowEntities(g, r)
    drawShovelPreview(g, r)
    drawPeas(g, r)
    drawSuns(g, r)

    for g.particles to p {
        var a = _int(255.0 * _float(p.life) / _float(p.maxLife))
        r.setColor((a << 24) | p.c)
        r.fillRect(p.x - p.size * 0.5, p.y - p.size * 0.5, p.size, p.size)
    }
    for g.floats to f {
        var a = _int(255.0 * _float(f.life) / _float(f.maxLife))
        if a > 255 { a = 255 }
        r.drawText(g.font, f.text, f.x, f.y, (a << 24) | f.c)
    }

    drawHUD(g, r)

    if g.bannerTimer > 0 {
        var fade = 1.0
        if g.bannerTimer < 30 { fade = _float(g.bannerTimer) / 30.0 }
        var ba = _int(120.0 * fade)
        r.setColor((ba << 24) | 0x000000)
        r.fillRect(0.0, GRID_Y + GRID_H * 0.5 - 30.0, _float(WIN_W), 56.0)
        var ta = _int(255.0 * fade)
        r.drawTextCentered(g.fontBig, g.bannerText, 0.0, _float(WIN_W),
                           GRID_Y + GRID_H * 0.5 - 14.0, (ta << 24) | 0xFFD54F)
    }

    if g.state == ST_MENU {
        if g.texTitle != null {
            r.drawTextureAt(g.texTitle, 0.0, 0.0, _float(WIN_W), _float(WIN_H))
        } else {
            r.setColor(#1B5E20FF)
            r.fillRect(0.0, 0.0, _float(WIN_W), _float(WIN_H))
        }
        r.setColor(#00000055)
        r.fillRect(0.0, _float(WIN_H) * 0.5 - 160.0, _float(WIN_W), 220.0)
        r.drawTextCentered(g.fontBig, "植 物 大 战 僵 尸", 0.0, _float(WIN_W), _float(WIN_H) * 0.5 - 120.0, #FFD54FFF)
        r.drawTextCentered(g.font, "收集阳光，种下植物，别让僵尸走进屋子", 0.0, _float(WIN_W), _float(WIN_H) * 0.5 - 76.0, #F1F8E9FF)
        drawMenuButtons(g, r)
    } else if g.state == ST_HELP {
        drawHelpScreen(g, r)
    } else if g.state == ST_PAUSE {
        drawOverlay(g, r, "暂 停", "点击按钮或按 P 继续")
        drawPauseMenu(g, r)
    } else if g.state == ST_WIN {
        drawOverlay(g, r, "通 关！", "击杀 " + g.killed + " 只僵尸   坚持到第 " + g.wave + " 波")
        drawEndScreen(g, r, true)
    } else if g.state == ST_LOSE {
        drawOverlay(g, r, "僵 尸 吃 掉 了 你 的 脑 子", "坚持到第 " + g.wave + " 波   击杀 " + g.killed + " 只僵尸")
        drawEndScreen(g, r, false)
    }
}

// ==================== 事件 ====================

func onClick(Game g, float mx, float my) {
    var cx = _float(WIN_W) * 0.5

    if g.state == ST_MENU {
        var cy1 = _float(WIN_H) * 0.5 + 30.0
        var cy2 = cy1 + MENU_BTN_GAP
        if menuBtnHit(mx, my, cx, cy1) {
            g.state = ST_PLAY
            g.bannerText = "准备种植物！"
            g.bannerTimer = 110
        } else if menuBtnHit(mx, my, cx, cy2) {
            g.state = ST_HELP
        }
        return
    }

    if g.state == ST_HELP {
        var pw = 620.0
        var ph = 440.0
        var py = _float(WIN_H) * 0.5 - ph * 0.5
        var by = py + ph - 40.0
        if menuBtnHit(mx, my, cx, by) {
            g.state = ST_MENU
        }
        return
    }

    if g.state == ST_PAUSE {
        var baseY = _float(WIN_H) * 0.5 - 20.0
        if menuBtnHit(mx, my, cx, baseY) {
            g.state = ST_PLAY
        } else if menuBtnHit(mx, my, cx, baseY + MENU_BTN_GAP) {
            restart(g)
        } else if menuBtnHit(mx, my, cx, baseY + MENU_BTN_GAP * 2.0) {
            resetLevel(g)
            g.state = ST_MENU
            if g.audioOk { g.bgm.stop() }
        }
        return
    }

    if g.state == ST_WIN or g.state == ST_LOSE {
        var baseY = _float(WIN_H) * 0.5 + 40.0
        if menuBtnHit(mx, my, cx, baseY) {
            restart(g)
        } else if menuBtnHit(mx, my, cx, baseY + MENU_BTN_GAP) {
            resetLevel(g)
            g.state = ST_MENU
            if g.audioOk { g.bgm.stop() }
        }
        return
    }

    if g.state != ST_PLAY { return }

    if collectSunAt(g, mx, my) { return }

    if inRect(mx, my, SHOVEL_X, SHOVEL_Y, SHOVEL_W, SHOVEL_W) {
        g.shovelMode = not g.shovelMode
        g.selCard = -1
        return
    }

    for 0 : N_CARD - 1 to i {
        var cx = CARD_X0 + _float(i) * CARD_GAP
        if inRect(mx, my, cx, CARD_Y, CARD_W, CARD_H) {
            if g.cardCd[i] > 0 or g.sun < PLANT_COST[i] {
                sfx(g, g.sfxBuzzer)
                return
            }
            g.selCard = i
            g.shovelMode = false
            return
        }
    }

    if mx < GRID_X or mx > GRID_X + GRID_W or my < GRID_Y or my > GRID_Y + GRID_H {
        g.selCard = -1
        g.shovelMode = false
        return
    }
    var col = _int((mx - GRID_X) / CELL_W)
    var row = _int((my - GRID_Y) / CELL_H)
    if col < 0 or col >= COLS or row < 0 or row >= ROWS { return }

    if g.shovelMode {
        doShovel(g, row, col)
        return
    }
    if g.selCard >= 0 {
        tryPlant(g, row, col)
        return
    }
}

func restart(Game g) {
    resetLevel(g)
    g.state = ST_PLAY
    if g.audioOk {
        g.winMus.stop()
        g.loseMus.stop()
        g.bgm.play()
    }
    g.bannerText = "准备种植物！"
    g.bannerTimer = 110
}

func toggleMute(Game g) {
    g.muted = not g.muted
    if g.audioOk {
        if g.muted { g.bgm.setVolume(0.0) } else { g.bgm.setVolume(0.32) }
    }
}

func handleEvent(Game g, Event e): bool {
    if g.quitReq { return false }
    if e.isQuit() or e.isWindowClose() { return false }

    if e.isMouseMotion() {
        var[float, float](mx, my) = e.mousePos()
        g.mouseX = mx
        g.mouseY = my
    }
    if e.isMouseButtonDown() {
        var[float, float](cx, cy) = e.mousePos()
        g.mouseX = cx
        g.mouseY = cy
        onClick(g, cx, cy)
        return true
    }
    if e.isKeyDown() {
        int sc = e.scancode()
        if sc == Scancode.ESCAPE {
            if g.state == ST_HELP { g.state = ST_MENU; return true }
            if g.state == ST_PAUSE { g.state = ST_PLAY; return true }
            if g.selCard >= 0 { g.selCard = -1; return true }
            if g.shovelMode { g.shovelMode = false; return true }
            return false
        }
        if sc == Scancode._1 { g.selCard = 0; g.shovelMode = false; return true }
        if sc == Scancode._2 { g.selCard = 1; g.shovelMode = false; return true }
        if sc == Scancode._3 { g.selCard = 2; g.shovelMode = false; return true }
        if sc == Scancode._4 { g.selCard = 3; g.shovelMode = false; return true }
        if sc == Scancode._5 { g.selCard = 4; g.shovelMode = false; return true }
        if sc == Scancode.S { g.shovelMode = not g.shovelMode; g.selCard = -1; return true }
        if sc == Scancode.P {
            if g.state == ST_PLAY { g.state = ST_PAUSE } else if g.state == ST_PAUSE { g.state = ST_PLAY }
            return true
        }
        if sc == Scancode.M { toggleMute(g); return true }
        if sc == Scancode.R {
            if g.state == ST_PLAY or g.state == ST_PAUSE or g.state == ST_WIN or g.state == ST_LOSE {
                restart(g); return true
            }
            return true
        }
        if sc == Scancode.D {
            // 一次性导出当前场景的僵尸/豌豆状态，便于排查"爆炸后隐形僵尸"等异常
            print("[DBG] === scene dump ===")
            for g.zombies to z {
                print("[DBG] zombie row=" + z.row + " x=" + _int(z.x) + " y=" + _int(z.y)
                      + " hp=" + _int(z.hp) + " alive=" + z.alive + " dying=" + z.dying
                      + " anim=" + z.anim + " hatHp=" + z.hatHp
                      + " fr=" + _int(z.aframe) + " dieTimer=" + z.dieTimer)
            }
            for g.peas to b {
                print("[DBG] pea row=" + b.row + " x=" + _int(b.x) + " y=" + _int(b.y)
                      + " alive=" + b.alive)
            }
            print("[DBG] === end dump ===")
            return true
        }
        if sc == Scancode.SPACE or sc == Scancode.RETURN {
            if g.state == ST_MENU { g.state = ST_PLAY; return true }
            if g.state == ST_HELP { g.state = ST_MENU; return true }
            if g.state == ST_WIN or g.state == ST_LOSE { restart(g); return true }
            if g.state == ST_PAUSE { g.state = ST_PLAY; return true }
        }
    }
    return true
}

// ==================== 主函数 ====================

main() {
    _console(false)
    var win = SDL3.createWindow({
        title: "植物大战僵尸 Plants vs. Zombies",
        w: WIN_W,
        h: WIN_H
    })
    if not win.ok {
        print("[错误] 窗口创建失败")
        return
    }

    SDL3.ttfInit()
    var fontPath = dirs.res_dir() + "/font/SmileySans-Oblique.ttf"
    var font = SDL3.createFont(fontPath, 15.0)
    if not font.ok { font = SDL3.createFontAuto(15.0) }
    var fontBig = SDL3.createFont(fontPath, 30.0)
    if not fontBig.ok { fontBig = SDL3.createFontAuto(30.0) }

    var g = newGame()
    g.font = font
    g.fontBig = fontBig

    win.setMaxFPS(60)

    print("[OK] 植物大战僵尸启动成功!")
    print("     1-5 选卡，左键种植；点阳光收集；S 铲子；P 暂停 / R 重开 / M 静音")

    win.run(
        func(Event ev): bool {
            return handleEvent(g, ev)
        },
        func(Renderer r) {
            core.markFrameRedraw()
            if not g.loaded { loadResources(g, r) }
            if g.state == ST_PLAY { updateGame(g) }
            else { g.frameCount = g.frameCount + 1 }
            renderGame(g, r)
        }
    )

    if g.audioOk {
        g.bgm.stop(); g.bgm.uninit()
        g.winMus.uninit(); g.loseMus.uninit()
        g.sfxPlant.uninit(); g.sfxThrow.uninit(); g.sfxSplat.uninit()
        g.sfxCherry.uninit(); g.sfxShovel.uninit(); g.sfxCoin.uninit()
        g.sfxGroan.uninit(); g.sfxPop.uninit(); g.sfxAwooga.uninit()
        g.sfxMower.uninit(); g.sfxChomp.uninit(); g.sfxBuzzer.uninit()
        audio.uninit()
    }
    if font.ok { font.close() }
    if fontBig.ok { fontBig.close() }
    win.destroy()
    SDL3.quit()
    print("退出游戏")
}
