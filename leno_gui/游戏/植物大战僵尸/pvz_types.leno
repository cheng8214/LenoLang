// pvz_types.leno — 植物大战僵尸 数据结构
//
// 动画：素材源自 PvZ 的 reanim 骨骼动画。gen_anim.ps1 已把每个动作的
// 「逐帧变换」导出到 anim/*.txt，运行时按帧播放，部件变换为：
//     绘制尺寸 = 原始尺寸 × (sx, sy)
//     左上角   = (x, y)                 ← reanim 的 x/y 就是部件左上角
//     旋转     = a 度，绕部件中心
// 骨架原点 (ox, oy) 取包围盒底部中心，绘制时对齐到屏幕锚点。

import "SDL3" as SDL3
import "../../../build/leno_module/LenoMusic/lib/Music.leno" as audio
use SDL3.Font
use audio.(Sound, Sfx)

// 一个动作（如 僵尸走路 / 豌豆射手射击）
// 逐帧数据按 part 主序存放：下标 = part * nFrame + frame
export struct Anim {
    int fps = 0
    int nFrame = 0
    int nPart = 0
    Array[Ptr[u8]] tex
    Array[float] tw            // 部件原始宽
    Array[float] th            // 部件原始高
    Array[float] px
    Array[float] py
    Array[float] pa
    Array[float] psx
    Array[float] psy
    Array[int] vis             // 0 = 该帧隐藏
    float ox = 0                   // 骨架原点（reanim 坐标）
    float oy = 0
    Array[string] names        // 每个部件的原始文件名（用于保存）
}

export struct Plant {
    int ptype = 0
    int row = 0
    int col = 0
    float x = 0
    float y = 0
    float hp = 0
    float maxHp = 0
    int timer = 0
    int fuse = 0               // 樱桃引信；向日葵用来标记已出过首颗阳光
    int anim = 0               // 0=idle 1=动作（射击）
    float aframe = 0           // 动画帧（浮点，按 fps 推进）
    bool alive = 0
}

export struct Zombie {
    int ztype = 0
    int row = 0
    float x = 0                // 脚底中心 x = 0
    float y = 0                // 脚底 y（行固定）
    float hp = 0
    float maxHp = 0
    int hatHp = 0
    int hatMax = 0
    float speed = 0
    bool alive = 0
    bool eating = 0
    int eatTimer = 0
    int slowTimer = 0
    float slowAmt = 0
    int anim = 0               // 0=walk 1=eat 2=death
    float aframe = 0
    bool dying = 0
    int dieTimer = 0
}

export struct Pea {
    int row = 0                // 发射豌豆的植物所在行（碰撞只打本行僵尸）
    float x = 0
    float y = 0
    float vx = 0
    int kind = 0               // 0=普通 1=寒冰
    bool alive = 0
}

export struct Sun {
    float x = 0
    float y = 0
    float ty = 0
    bool falling = 0
    bool alive = 0
    int life = 0
    bool collecting = 0          // 点击后正在飞向阳光库
    float targetX = 0            // 飞行目标 x（阳光库中心）
    float targetY = 0            // 飞行目标 y
}

export struct Mower {
    int row = 0
    float x = 0
    float y = 0
    bool active = 0
    bool alive = 0
}

export struct Particle {
    float x = 0
    float y = 0
    float vx = 0
    float vy = 0
    float size = 0
    int life = 0
    int maxLife = 0
    int c = 0
}

export struct FloatText {
    float x = 0
    float y = 0
    string text = 0
    int c = 0
    int life = 0
    int maxLife = 0
}

export struct Game {
    int state = 0
    int frameCount = 0
    int sun = 0
    int wave = 0
    int killed = 0
    int waveState = 0
    int waveTimer = 0
    Array[int] spawnQueue
    int spawnIdx = 0
    int spawnTimer = 0
    int skyTimer = 0
    int bannerTimer = 0
    string bannerText = 0
    bool hugeWave = 0

    int selCard = 0
    bool shovelMode = 0
    float mouseX = 0
    float mouseY = 0
    bool muted = 0
    bool quitReq = 0

    Array[int] cardCd
    Array[Plant] plants
    Array[Zombie] zombies
    Array[Pea] peas
    Array[Sun] suns
    Array[Mower] mowers
    Array[Particle] particles
    Array[FloatText] floats
    int pCount = 0

    // 纹理
    Ptr[u8] texBg
    Ptr[u8] texTitle
    Ptr[u8] texSun
    Ptr[u8] texPea
    Ptr[u8] texSnowPea
    Ptr[u8] texShovel
    Ptr[u8] texShovelBank
    Ptr[u8] texSunBank
    Ptr[u8] texSeedBank
    Ptr[u8] texFlagMeter
    Ptr[u8] texProgress
    Ptr[u8] texCone
    Ptr[u8] texBucket
    Ptr[u8] texMowerBody
    Ptr[u8] texMowerWheel1
    Ptr[u8] texMowerWheel2
    float coneW = 0
    float coneH = 0
    float bucketW = 0
    float bucketH = 0
    float coneOx = 0
    float coneOy = 0
    float bucketOx = 0
    float bucketOy = 0

    // 动画
    Anim anSunflower
    Anim anPeashooter
    Anim anPeaShoot
    Anim anWallnut
    Anim anSnowPea
    Anim anSnowShoot
    Anim anCherry
    Anim anSun
    Anim anZWalk
    Anim anZEat
    Anim anZDeath

    bool loaded = 0

    Sound bgm
    Sound winMus
    Sound loseMus
    Sfx sfxPlant
    Sfx sfxThrow
    Sfx sfxSplat
    Sfx sfxCherry
    Sfx sfxShovel
    Sfx sfxCoin
    Sfx sfxGroan
    Sfx sfxPop
    Sfx sfxAwooga
    Sfx sfxMower
    Sfx sfxChomp
    Sfx sfxBuzzer
    bool audioOk = 0

    Font font
    Font fontBig
}
