// pvz_art.leno — PvZ 素材与 reanim 动画播放
//
// anim/*.txt 由 gen_anim.ps1 从官方 reanim 导出，格式：
//   fps=12
//   frames=47
//   图片名|x,y,a,sx,sy|x,y,a,sx,sy|...     （每行一个部件，按绘制顺序；h = 该帧隐藏）
//
// 变换约定（与 PopCap Reanim 一致）：
//   reanim 的 x/y = 部件左上角；绘制尺寸 = 原始尺寸 × (sx, sy)；旋转 a 度绕部件中心。
// 骨架原点取包围盒「底部中心」，绘制时对齐到屏幕锚点，角色自然站在格子里。

import "SDL3" as SDL3
import "pvz_types.leno" as types
import files
import dirs
use SDL3.Renderer
use SDL3.Flip
use types.Anim

func imgPath(string file): string {
    return dirs.script_dir() + "/image/" + file
}

func animPath(string file): string {
    return dirs.script_dir() + "/anim/" + file
}

export func loadTex(Renderer r, string file): Ptr[u8] {
    return SDL3.loadImageTexture(r.handle, imgPath(file))
}

// 载入一个动作的逐帧数据
export func loadAnim(Renderer r, string file): Anim {
    var an = new Anim()
    an.fps = 12
    an.nFrame = 0
    an.nPart = 0
    an.ox = 0.0
    an.oy = 0.0
    an.tex = []
    an.tw = []
    an.th = []
    an.px = []
    an.py = []
    an.pa = []
    an.psx = []
    an.psy = []
    an.vis = []
    an.names = []

    if not files.exists(animPath(file)) {
        print("[警告] 缺少动画数据 " + file)
        return an
    }
    var src = files.read(animPath(file))
    Array[string] lines = src.split("\n")
    if lines.len() < 3 { return an }

    Array[string] fp = lines[0].split("=")
    if fp.len() > 1 { an.fps = _int(fp[1]) }
    Array[string] fr = lines[1].split("=")
    if fr.len() > 1 { an.nFrame = _int(fr[1]) }
    if an.nFrame <= 0 { return an }
    // 统计非空部件行，忽略尾部空行导致的 nPart 偏大
    var npart = 0
    for 2 : lines.len() - 1 to li {
        if lines[li].len() >= 3 { npart = npart + 1 }
    }
    an.nPart = npart

    for 0 : an.nPart - 1 to pi {
        string line = lines[pi + 2]
        if line.len() < 3 { continue }
        Array[string] cells = line.split("|")
        var t = SDL3.loadImageTexture(r.handle, imgPath(cells[0]))
        var w = 0.0
        var h = 0.0
        if t != null {
            var[float, float](tw, th) = r.getTextureSize(t)
            w = tw
            h = th
        }
        an.tex.add(t)
        an.tw.add(w)
        an.th.add(h)
        an.names.add(cells[0])
        for 0 : an.nFrame - 1 to fi {
            if fi + 1 >= cells.len() {
                an.vis.add(0)
                an.px.add(0.0); an.py.add(0.0); an.pa.add(0.0)
                an.psx.add(1.0); an.psy.add(1.0)
                continue
            }
            string cell = cells[fi + 1]
            if cell == "h" {
                an.vis.add(0)
                an.px.add(0.0); an.py.add(0.0); an.pa.add(0.0)
                an.psx.add(1.0); an.psy.add(1.0)
            } else {
                Array[string] v = cell.split(",")
                an.vis.add(1)
                an.px.add(_float(v[0]))
                an.py.add(_float(v[1]))
                an.pa.add(_float(v[2]))
                an.psx.add(_float(v[3]))
                an.psy.add(_float(v[4]))
            }
        }
    }
    var[float, float](ox, oy) = calcOrigin(an)
    an.ox = ox
    an.oy = oy
    return an
}

// 包围盒底部中心（reanim 坐标）：角色站立的锚点
export func calcOrigin(Anim an): [float, float] {
    var minX = 99999.0
    var maxX = -99999.0
    var minY = 99999.0
    var maxY = -99999.0
    for 0 : an.nPart - 1 to i {
        for 0 : an.nFrame - 1 to f {
            var idx = i * an.nFrame + f
            if an.vis[idx] == 0 { continue }
            var x0 = an.px[idx]
            var y0 = an.py[idx]
            var x1 = x0 + an.tw[i] * an.psx[idx]
            var y1 = y0 + an.th[i] * an.psy[idx]
            if x0 < minX { minX = x0 }
            if y0 < minY { minY = y0 }
            if x1 > maxX { maxX = x1 }
            if y1 > maxY { maxY = y1 }
        }
    }
    if minX > maxX { return 0.0, 0.0 }
    return (minX + maxX) * 0.5, maxY
}

// 同一角色的多个动作要共用同一个原点，否则切换动作时会跳位
export func setOrigin(Anim an, float ox, float oy) {
    an.ox = ox
    an.oy = oy
}

// 绘制第 frame 帧；(px, py) = 骨架原点（包围盒底部中心）对齐到的屏幕坐标
export func drawAnim(Renderer r, Anim an, float frame, float px, float py, float s) {
    if an.nPart == 0 or an.nFrame == 0 { return }
    var fi = _int(frame)
    if fi < 0 { fi = 0 }
    while fi >= an.nFrame { fi = fi - an.nFrame }
    for 0 : an.nPart - 1 to i {
        var idx = i * an.nFrame + fi
        if an.vis[idx] == 0 { continue }
        var t = an.tex[i]
        if t == null { continue }
        var dx = px + (an.px[idx] - an.ox) * s
        var dy = py + (an.py[idx] - an.oy) * s
        var dw = an.tw[i] * an.psx[idx] * s
        var dh = an.th[i] * an.psy[idx] * s
        int flip = Flip.NONE
        if dw < 0 { flip = flip | Flip.HORIZONTAL; dw = -dw }
        if dh < 0 { flip = flip | Flip.VERTICAL;   dh = -dh }
        r.drawTextureRotated(t, dx, dy, dw, dh, an.pa[idx], dw * 0.5, dh * 0.5, flip)
    }
}

// 僵尸的护具（路障/铁桶）：挂在骨架坐标系上，跟随原点
export func drawHat(Renderer r, Ptr[u8] tex, float w, float h, Anim zom,
                    float px, float py, float s, float hx, float hy) {
    if tex == null { return }
    var dx = px + (hx - zom.ox) * s
    var dy = py + (hy - zom.oy) * s
    var dw = w * 0.8 * s
    var dh = h * 0.8 * s
    int flip = Flip.NONE
    if dw < 0 { flip = flip | Flip.HORIZONTAL; dw = -dw }
    if dh < 0 { flip = flip | Flip.VERTICAL;   dh = -dh }
    r.drawTextureRotated(tex, dx, dy, dw, dh, 0.0, dw * 0.5, dh * 0.5, flip)
}

// 按 fps 推进动画帧（游戏 60fps）
export func stepFrame(Anim an, float cur): float {
    var nf = cur + _float(an.fps) / 60.0
    while nf >= _float(an.nFrame) { nf = nf - _float(an.nFrame) }
    return nf
}

// 阳光专用：三层光球同心叠放在锚点（忽略 reanim 里让它们绕核心大幅平移的坐标），
// 只保留各帧的缩放/旋转做呼吸闪烁，从而呈现一个完整居中的太阳。
// 绘制顺序为文件顺序（Sun3 大光晕底 → Sun2 → Sun1 核心顶）。
export func drawSun(Renderer r, Anim an, float frame, float px, float py, float s) {
    if an.nPart == 0 or an.nFrame == 0 { return }
    var fi = _int(frame)
    if fi < 0 { fi = 0 }
    while fi >= an.nFrame { fi = fi - an.nFrame }
    for 0 : an.nPart - 1 to i {
        var idx = i * an.nFrame + fi
        if an.vis[idx] == 0 { continue }
        var t = an.tex[i]
        if t == null { continue }
        var dw = an.tw[i] * an.psx[idx] * s
        var dh = an.th[i] * an.psy[idx] * s
        int flip = Flip.NONE
        if dw < 0 { flip = flip | Flip.HORIZONTAL; dw = -dw }
        if dh < 0 { flip = flip | Flip.VERTICAL;   dh = -dh }
        // 居中：让每层中心都落在 (px, py)，绕自身中心旋转
        r.drawTextureRotated(t, px - dw * 0.5, py - dh * 0.5, dw, dh, an.pa[idx], dw * 0.5, dh * 0.5, flip)
    }
}
