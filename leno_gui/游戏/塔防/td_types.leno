// td_types.leno — 塔防数据类（struct 定义集中处）
// 用法：import "td_types.leno" as types
//       use types.(Enemy, Wave, Tower, Bullet, Particle, FloatText, Arc, Coin, Chest, Game)
import "SDL3" as SDL3
import "../../../build/leno_module/LenoMusic/lib/Music.leno" as audio
use SDL3.Font
use audio.(Sound, Sfx)

export struct Enemy {
    int id = 0
    int etype = 0
    float x = 0
    float y = 0
    float hp = 0
    float maxHp = 0
    float speed = 0
    float armor = 0
    int gold = 0
    int dmg = 0
    int wpIdx = 0
    float dir = 0              // 朝向（度，素材默认朝下）
    int slowTimer = 0
    float slowAmount = 0
    bool alive = 0
    bool reached = 0
    int dying = 0              // 临终动画剩余帧：>0 表示已死亡但仍保留渲染（播放倒地动作）
    bool crying = 0            // 人物2：已进入「哭泣定身」状态（原地不动 + 释放声波）
    int waveTimer = 0          // 人物2：距离下次释放声波的帧数
    bool attacking = 0         // 人物3：正在播放攻击动作（原地不动）
    int atkTimer = 0           // 人物3：当前攻击动作已播放的帧数
    bool atkHit = 0            // 人物3：本轮伤害是否已结算（避免一次挥击多次命中）
    int atkCd = 0              // 人物3：攻击间隔倒计时
    int pm4State = 0           // 人物4：0=走路 1=跳跃 2=落地 3=爆炸
    int pm4Timer = 0           // 人物4：当前状态已播放帧数
    float pm4Sx = 0            // 人物4：起跳点坐标
    float pm4Sy = 0
    float pm4Tx = 0            // 人物4：目标塔坐标（跳过去爆炸）
    float pm4Ty = 0
    float lane = 0             // 横向车道偏移（单位：格，-0.45~0.45），双通道散开行走
    int bState = 0             // BOSS：0=走路 1=跳跃攻击 2=抓着战利品回位
    int bTimer = 0             // BOSS：当前状态已播放帧数
    int bCd = 0                // BOSS：突袭冷却倒计时
    float bAx = 0              // BOSS：触发点坐标（回位目标）
    float bAy = 0
    float bTx = 0              // BOSS：目标塔坐标
    float bTy = 0
    int bTowerType = 0         // BOSS：拆掉的塔类型（决定台词）
    bool bHit = 0              // BOSS：本次突袭伤害是否已结算
    int bRb = 0                // BOSS：原路返回/跑回时的路点游标
    int bWpIdx = 0             // BOSS：突袭触发时的路点位置（跑回终点）
}

export struct Wave {
    float x = 0
    float y = 0
    int life = 0
    int maxLife = 0
    float r = 0                // 当前半径（渲染用，逐帧向外扩张）
    float rMax = 0             // 最大半径
    bool alive = 0
}

export struct Tower {
    int ttype = 0
    int gx = 0
    int gy = 0
    float x = 0
    float y = 0
    int level = 0
    int cooldown = 0
    float angle = 0
    int kills = 0
    float hp = 0                // 当前血量（被人物3 攻击会掉）
    float maxHp = 0
    int fireAnim = 0            // 箭塔：塔上人物射箭动作剩余帧数（>0 时播放帧 1-4）
    float aimDir = 0            // 箭塔：当前目标方向（塔上人物据此翻转朝向）
}

export struct Bullet {
    int btype = 0
    float x = 0
    float y = 0
    float vx = 0
    float vy = 0
    float speed = 0
    float damage = 0
    float splash = 0
    float slowAmount = 0
    int slowFrames = 0
    int chain = 0
    int targetId = 0          // 目标敌人 id（-1 表示无目标）
    bool alive = 0
    bool bossShot = 0         // BOSS 扛炮台所发射：纯表现弹，不与敌人碰撞（避免误伤自己）
}

export struct Particle {
    float x = 0
    float y = 0
    float vx = 0
    float vy = 0
    float size = 0
    int life = 0
    int maxLife = 0
    int c = 0
    bool alive = 0
}

export struct FloatText {
    float x = 0
    float y = 0
    string text = 0
    int c = 0
    int life = 0
    bool alive = 0
    bool bg = 0                // true = 白底黑字气泡（人物台词）
}

export struct Arc {
    float x1 = 0
    float y1 = 0
    float x2 = 0
    float y2 = 0
    int life = 0
    bool alive = 0
}

export struct Coin {
    float sx = 0
    float sy = 0
    float x = 0
    float y = 0
    float tx = 0
    float ty = 0
    float p = 0
    int val = 0
    int delay = 0              // 出场延迟（帧）：宝箱金币雨逐枚迸出
    bool alive = 0
}

export struct Chest {
    float x = 0
    float y = 0
    int life = 0
    bool alive = 0
}

export struct Game {
    int state = 0
    int frameCount = 0

    int gold = 0
    int lives = 0
    int wave = 0
    int kills = 0
    int totalKilled = 0

    int waveState = 0              // 0=准备中 1=生成中 2=清理中
    int waveTimer = 0              // 准备倒计时
    Array[int] spawnQueue      // 本波待生成的敌人类型
    int spawnIdx = 0               // 生成游标
    int spawnTimer = 0
    int bannerTimer = 0
    string bannerText = 0

    int selType = 0                // 当前选中的塔类型（-1 无）
    int selTower = 0               // 当前选中的已建造塔索引（-1 无）
    int menuTower = 0              // 当前弹出的塔操作菜单所属塔索引（-1 无）
    float mouseX = 0
    float mouseY = 0

    int speedMul = 0              // 倍速：1 / 2 / 3
    bool muted = 0                // 是否静音
    bool quitReq = 0              // 主菜单「退出游戏」请求退出

    Array[int] map
    Array[Enemy] enemies
    Array[Tower] towers
    Array[Bullet] bullets
    Array[Particle] particles
    Array[FloatText] floats
    Array[Arc] arcs
    Array[Coin] coins
    Array[Chest] chests
    int pCount = 0

    // 纹理
    Ptr[u8] texGrass
    Ptr[u8] texPath
    Ptr[u8] texStart
    Ptr[u8] texBase
    Ptr[u8] texRock
    Array[Ptr[u8]] texTower
    Array[Ptr[u8]] texEnemy
    Array[Ptr[u8]] texSlime
    Array[Ptr[u8]] texPerson
    Array[Ptr[u8]] texPerson2
    Array[Ptr[u8]] texPerson3
    Array[Ptr[u8]] texPerson4
    Array[Ptr[u8]] texBoom4
    Array[Ptr[u8]] texGrunt
    Array[Ptr[u8]] texArrowTower
    Array[Ptr[u8]] texCannon
    Array[Ptr[u8]] texFrost
    Array[Ptr[u8]] texBossWalk
    Array[Ptr[u8]] texBossJump
    Array[Ptr[u8]] texBossReturn
    Array[Ptr[u8]] texBullet
    Ptr[u8] texCoin
    Ptr[u8] texHeart
    Ptr[u8] texStar
    Ptr[u8] texTree
    Ptr[u8] texTree2
    Ptr[u8] texUp
    Ptr[u8] texCoinFly
    Ptr[u8] texSell
    Ptr[u8] texChest
    Array[Wave] waves
    Ptr[u8] mapTex
    bool loaded = 0

    // 音频
    Sound bgm
    Sound bossBgm
    Sfx sfxShoot
    Sfx sfxBoom
    Sfx sfxLose
    Sfx sfxShootArrow      // 箭塔开火（射箭.mp3）
    Sfx sfxBuild           // 建造（放置.mp3）
    Sfx sfxFreeze          // 冰塔冰冻（冻住.wav）
    Sfx sfxWave            // 波次开始（波浪提示音.mp3）
    Sfx sfxDie             // 怪物死亡（怪物死亡.mp3）
    Sfx sfxUpgrade         // 塔升级（升级.mp3）
    Sfx sfxPickup          // 拾取：金币入账/开宝箱（拾取.mp3）
    Sfx sfxHit             // 小怪受击（小怪受击.mp3，带节流）
    Sfx sfxBoom4           // 人物4 自爆大爆炸（db.wav 降调变沉，与其他爆炸错开）
    Sfx sfxBossSmash       // BOSS 拆塔击打（db.wav 降调闷响）
    Sfx sfxBossFire        // BOSS 抢到炮塔开炮（anxia.mp3 较轻）
    int hitSfxCd = 0           // 受击音效节流倒计时（帧），避免连射时刷屏
    bool audioOk = 0

    Font font
    Font fontBig
}
