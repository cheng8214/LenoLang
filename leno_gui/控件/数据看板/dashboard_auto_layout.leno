    stat_card(0, 505, 135, 263, 90, "今日签到", "未登录", "", C_GREEN, 18.0)
    stat_card(0, 796, 135, 263, 90, "连续签到", "0", "天", C_ORANGE, 28.0)

    // 折线图卡 + 账号概览卡
    var trend = card(0, 214, 258, 503, 277, "近 14 天积分趋势")
    trend.add(SDL3.createButton({x:677, y:270, w:26, h:26, text:"…", font_size:13, radius:13,
                                 bg_color:C_CARD, text_color:C_BLUE, border_color:C_BLUE_L, shadow:false}))
