// test_tab_canvas.leno — Tab 选项卡内嵌 Canvas 画布测试
// 运行：leno 本文件（Esc 退出）
//
// 校验点：
//   1) 两个 Tab 页，每页内嵌一个 Canvas 画布控件
//   2) 页 0：绘图演示画布 —— 绘制矩形、圆形、线条、文字，鼠标点击画十字标记
//   3) 页 1：自由涂鸦画布 —— 鼠标拖拽画线，点击不同按钮可清空/切换颜色
//   4) 两个画布坐标独立，切换 Tab 不会互相干扰
//   5) 点击位置准确（画布内坐标 = 点击处显示的坐标值）
//   6) 裁剪正确（超出画布范围的绘制不可见）
import "SDL3" as SDL3
use SDL3.(Color,Event)
use SDL3.Renderer
use SDL3.Scancode
use SDL3.TabControl
use SDL3.Canvas
use SDL3.Button
use SDL3.Label
import maths

main() {
    SDL3.ttfInit()
    var win = SDL3.createWindow({title: "Tab + Canvas 画布测试", w: 900, h: 600, resizable: true})
    if not win.ok { SDL3.ttfQuit(); return }
    win.setMinSize(640, 460)

    var font = SDL3.createFontAuto(14.0)

    // ===================== Tab 控件 =====================
    Array[string] titles = ["绘图演示", "自由涂鸦"]
    var tab = win.addTabControl({
        x: 0, y: 0, w: 900, h: 600,
        tabs: titles, active: 0, tab_h: 34, font_size: 15
    })
    win.setRoot(tab)

    // ===================== 页 0：绘图演示画布 =====================
    // 点击位置记录（画十字标记用），存内容区相对坐标
    Array[Array[float]] marks0 = []

    var canvas0 = SDL3.createCanvas({
        x: 0, y: 0, w: 900, h: 490,
        bg_color: #1A1A22FF, border: true, border_color: #4A4F5EFF
    })
    tab.addToPage(0, canvas0, 0, 0)

    canvas0.on_draw(func(Renderer r, float ox, float oy, float cw, float ch) {
        // === 所有绘制用窗口绝对坐标：ox + 局部X, oy + 局部Y ===

        // 1. 背景网格线（每 40px 一条）
        r.setColor(#2A2A36FF)
        float step = 40.0
        float gx = step
        while gx < cw {
            r.drawLine(ox + gx, oy, ox + gx, oy + ch)
            gx = gx + step
        }
        float gy = step
        while gy < ch {
            r.drawLine(ox, oy + gy, ox + cw, oy + gy)
            gy = gy + step
        }

        // 2. 矩形演示
        r.setColor(#3C96EBFF)
        r.fillRect(ox + 20, oy + 20, 80, 50)
        r.setColor(#50D296FF)
        r.fillRect(ox + 120, oy + 20, 60, 60)
        r.setColor(#FF6E82FF)
        r.drawRect(ox + 20, oy + 90, 100, 40)

        // 3. 圆形演示
        r.setColor(#FFAA50FF)
        r.drawCircle(ox + 300, oy + 50, 30)
        r.setColor(#BE78FFFF)
        r.fillCircle(ox + 400, oy + 50, 25)

        // 4. 线条演示
        r.setColor(#58A0FFFF)
        r.drawLine(ox + 20, oy + 150, ox + 200, oy + 150)
        r.setColor(#50D296FF)
        r.drawLine(ox + 20, oy + 170, ox + 200, oy + 190)

        // 5. 三角形演示
        r.setColor(#FF6E82FF)
        r.drawTriangle(ox + 250, oy + 170, 40, 0, 1.0, 0.4, 0.3, 0.5)

        // 6. 圆角矩形演示
        r.setColor(#3C96EBFF)
        r.fillRoundedRect(ox + 350, oy + 130, 120, 60, 12)
        r.setColor(#50D296FF)
        r.drawRoundedRect(ox + 350, oy + 130, 120, 60, 12)

        // 7. 坐标轴示意
        r.setColor(#5A6070FF)
        r.drawLine(ox + 20, oy + 250, ox + cw - 20, oy + 250)   // 横轴
        r.drawLine(ox + 20, oy + 250, ox + 20, oy + 400)        // 纵轴
        // 刻度
        r.setColor(#78808CFF)
        float tx = 60
        while tx < cw - 20 {
            r.drawLine(ox + tx, oy + 248, ox + tx, oy + 252)
            tx = tx + 40
        }
        float ty = 290
        while ty < 400 {
            r.drawLine(ox + 18, oy + ty, ox + 22, oy + ty)
            ty = ty + 40
        }

        // 8. 正弦曲线
        r.setColor(#3C96EBFF)
        float prevX = -1.0; float prevY = -1.0
        float px = 30
        while px < cw - 30 {
            float norm = (px - 30) / (cw - 60)   // 0~1
            float py = 325 + 50 * maths.sin(norm * 6.28318 * 2.0)
            if prevX >= 0.0 {
                r.drawLine(ox + prevX, oy + prevY, ox + px, oy + py)
            }
            prevX = px; prevY = py
            px = px + 2
        }

        // 9. 点击标记（十字）—— marks0 存的是内容区相对坐标
        for marks0 to m {
            float mx = m[0]; float my = m[1]
            r.setColor(#FF6E82FF)
            r.drawLine(ox + mx - 10, oy + my, ox + mx + 10, oy + my)
            r.drawLine(ox + mx, oy + my - 10, ox + mx, oy + my + 10)
            r.setColor(#FFAA50FF)
            r.fillCircle(ox + mx, oy + my, 3)
        }

        // 10. 画布尺寸标注
        if font.ok {
            r.setColor(#78808CFF)
            r.drawText(font, $"画布尺寸: {_int(cw)} x {_int(ch)}", ox + 10, oy + ch - 20, #78808CFF)
        }
    })

    // on_click 的 cx, cy 是内容区相对坐标（0,0 起始）
    canvas0.on_click(func(float cx, float cy, int btn) {
        if btn == 1 {
            marks0.add([cx, cy])
            print($"[画布0] 左键点击: ({cx}, {cy})，标记数={marks0.len()}")
        } eif btn == 3 {
            marks0.clear()
            print("[画布0] 右键清空标记")
        }
        SDL3.markFrameRedraw()
    })

    canvas0.on_mouse_move(func(float cx, float cy) {
        // 鼠标移动时画布已自动重绘（motion 标记）
    })

    canvas0.on_mouse_enter(func(float cx, float cy) {
        SDL3.markFrameRedraw()
    })

    canvas0.on_mouse_leave(func() {
        SDL3.markFrameRedraw()
    })

    // 页 0 信息标签
    var info0 = SDL3.createLabel({
        w: 400, h: 24, text: "左键点击画十字标记 | 右键清空标记",
        color: #78808CFF, font_size: 13
    })
    tab.addToPage(0, info0, 30, 510)

    // 页 0 清空按钮
    var clrBtn0 = SDL3.createButton({w: 100, h: 30, text: "清空标记"})
    tab.addToPage(0, clrBtn0, 500, 508)
    clrBtn0.on_click(func() {
        marks0.clear()
        print("[画布0] 按钮清空标记")
        SDL3.markFrameRedraw()
    })

    // ===================== 页 1：自由涂鸦画布 =====================
    // 每条线段: [x1, y1, x2, y2]（内容区相对坐标），颜色单独存在平行数组
    Array[Array[float]] strokes = []
    Array[Color] strokeColors = []
    bool stroking = false
    float lastStrokeX = 0.0; float lastStrokeY = 0.0
    Color drawColor = #3C96EBFF         // 当前画笔颜色

    var canvas1 = SDL3.createCanvas({
        x: 0, y: 0, w: 900, h: 490,
        bg_color: #15151DFF, border: true, border_color: #4A4F5EFF
    })
    tab.addToPage(1, canvas1, 0, 0)

    canvas1.on_draw(func(Renderer r, float ox, float oy, float cw, float ch) {
        // 绘制所有已保存的线段（strokes 存的是内容区相对坐标）
        int n = strokes.len()
        for n to i {
            var s = strokes[i]
            r.setColor(strokeColors[i])
            r.drawLine(ox + s[0], oy + s[1], ox + s[2], oy + s[3])
        }

        // 画笔颜色预览
        r.setColor(drawColor)
        r.fillRect(ox + cw - 60, oy + 10, 50, 20)
        r.setColor(#5A5F6EFF)
        r.drawRect(ox + cw - 60, oy + 10, 50, 20)

        // 提示文字
        if font.ok {
            r.setColor(#78808CFF)
            r.drawText(font, "拖拽鼠标涂鸦 | 右键清空", ox + 10, oy + ch - 20, #78808CFF)
        }
    })

    // on_drag 的 cx, cy 是内容区相对坐标；dx, dy 是像素增量
    canvas1.on_drag(func(float cx, float cy, float dx, float dy) {
        if stroking {
            strokes.add([lastStrokeX, lastStrokeY, cx, cy])
            strokeColors.add(drawColor)
            lastStrokeX = cx; lastStrokeY = cy
            SDL3.markFrameRedraw()
        }
    })

    canvas1.on_mouse_down(func(float cx, float cy, int btn) {
        if btn == 1 {
            stroking = true
            lastStrokeX = cx; lastStrokeY = cy
            print($"[画布1] 开始涂鸦: ({cx}, {cy})")
        }
    })

    canvas1.on_mouse_up(func(float cx, float cy, int btn) {
        if btn == 1 {
            stroking = false
            print($"[画布1] 结束涂鸦: ({cx}, {cy})，共 {strokes.len()} 段线")
        }
        if btn == 3 {
            strokes.clear()
            strokeColors.clear()
            print("[画布1] 右键清空画布")
            SDL3.markFrameRedraw()
        }
    })

    canvas1.on_click(func(float cx, float cy, int btn) {
        print($"[画布1] 点击: ({cx}, {cy}) btn={btn}")
    })

    canvas1.on_mouse_enter(func(float cx, float cy) {
        SDL3.markFrameRedraw()
    })

    canvas1.on_mouse_leave(func() {
        stroking = false
        SDL3.markFrameRedraw()
    })

    // 页 1 颜色选择按钮
    var btnRed = SDL3.createButton({w: 60, h: 30, text: "红色", bg_color: #E04050FF})
    var btnGreen = SDL3.createButton({w: 60, h: 30, text: "绿色", bg_color: #50C878FF})
    var btnBlue = SDL3.createButton({w: 60, h: 30, text: "蓝色", bg_color: #3C96EBFF})
    var btnOrange = SDL3.createButton({w: 60, h: 30, text: "橙色", bg_color: #FFAA50FF})
    var clrBtn1 = SDL3.createButton({w: 100, h: 30, text: "清空画布"})
    tab.addToPage(1, btnRed, 30, 510)
    tab.addToPage(1, btnGreen, 100, 510)
    tab.addToPage(1, btnBlue, 170, 510)
    tab.addToPage(1, btnOrange, 240, 510)
    tab.addToPage(1, clrBtn1, 320, 510)

    btnRed.on_click(func() { drawColor = #E04050FF; print("[画布1] 切换画笔: 红色") })
    btnGreen.on_click(func() { drawColor = #50C878FF; print("[画布1] 切换画笔: 绿色") })
    btnBlue.on_click(func() { drawColor = #3C96EBFF; print("[画布1] 切换画笔: 蓝色") })
    btnOrange.on_click(func() { drawColor = #FFAA50FF; print("[画布1] 切换画笔: 橙色") })
    clrBtn1.on_click(func() {
        strokes.clear()
        strokeColors.clear()
        print("[画布1] 按钮清空画布")
        SDL3.markFrameRedraw()
    })

    // ===================== 事件循环 =====================
    win.run(
        func(Event e): bool {
            if e.isQuit() or e.isWindowClose() { return false }
            if e.isKeyDown() and e.scancode() == Scancode.ESCAPE { return false }
            return true
        },
        func(Renderer r) {
            // 不使用 r.clearColor()：窗口主循环已用 fillRect 做背景填充
        }
    )

    if font.ok { font.close() }
    SDL3.ttfQuit()
}
