// test_focus_nav.leno — 焦点链（键盘导航）验收：Tab / Shift+Tab / Enter / Space
//   ★ 2026-10-13 新加能力（八批）：
//     第一批：焦点链本体 + `Button`（Tab 换焦点 / Enter·Space 激活 / 焦点环自绘 ✓）
//     第二批：开关类进场 —— `CheckBox` / `Toggle` / `RadioButton`（激活语义 = **切一下** ✓）
//     第三批 `Slider` ✓  第四批 `ListBox`（含 `on_activate` ✓）✓  第五批 `ComboBox` ✓
//     第六批 `TabControl` + `Table` ✓  第七批 `TreeView` ✓
//     第八批：**递归进容器** —— 面板/卡片/滚动区/页签页里的控件也能 Tab 到 ✓
//        （病根：`_focusables()` 原来**只扫 `widgets`** ✗ ⇒ 链尾本该是"面板内的按钮"，
//          结果 Tab **直接回卷到 A** ✓；顺带补上**根布局 `root`** ✓）
//   口径（速查附录 C 有记 ✓）：焦点链 = **注册顺序**（容器内子控件接在容器位置之后 ✓）；
//     窗口只管 Tab/Shift+Tab + Enter/Space；"谁能聚焦"用一张类型表（在 sdl_window 一处 ✓）；
//     ring 由控件自绘 ✓
//   判据：注入真按键（`SDL3.testKeyDown` ✓），逐步骤断言
//     ① 焦点按注册顺序前进、末尾回卷、**跳过 `set_focusable(false)` 的** ✓
//     ② Shift+Tab 反向 ✓  ③ Enter/Space 走**与鼠标点击同一条路** ✓：
//        Button ⇒ on_click 计数 +1；CheckBox/Toggle ⇒ 值真的翻转；RadioButton ⇒ 选中自己 ✓
//     ④ 第八批：链尾 = **面板里的按钮**（只有递归才 Tab 得到 ✓）
//   用法：set SHOT=%TEMP%\focus.png & build\leno.exe leno_gui\自测\test_focus_nav.leno
import "SDL3" as SDL3
use SDL3.(Event, Renderer, Scancode, Window, Button, CheckBox, Toggle, RadioButton, Slider, ListBox, ComboBox, TabControl, Table, TreeView, Panel)

int steps = 0
string shot = ""
int hitsA = 0        // Button A 的点按次数
int hitsC = 0        // Button C 的点按次数
int hitsCk = 0       // 复选框的 on_change 次数
// ⚠ 这三个控件的 `checked` / `on` 是 **`pri` 私有字段** ✗（探针读不到 ✓ 编译器会直接拦下 ✓）
//   ⇒ 断言一律走**公开回调**（它们本来就是"值变了"的官方出口 ✓，比直读字段更接近使用者视角 ✓）
int ckVal = 0        // 复选框当前值（0/1）
int tgVal = 0        // 开关当前值（0/1）
int tgHits = 0
int rdHits = 0       // 单选被选中的回调次数

func snap(Button a, Button b, Button c, string tag) {
    print("[focus] " + tag + "  A=" + _str(a.is_focused()) + " B=" + _str(b.is_focused()) +
          " C=" + _str(c.is_focused()) + "  hitsA=" + _str(hitsA) + " hitsC=" + _str(hitsC))
}

func snapSw(CheckBox ck, Toggle tg, RadioButton rd, string tag) {
    print("[focus] " + tag + "  ck(focus=" + _str(ck.is_focused()) + " 回调=" + _str(hitsCk) +
          " 值=" + _str(ckVal) + ")  tg(focus=" + _str(tg.is_focused()) + " 回调=" + _str(tgHits) +
          " 值=" + _str(tgVal) + ")  rd(focus=" + _str(rd.is_focused()) + " 回调=" + _str(rdHits) + ")")
}

func run() {
    SDL3.ttfInit()
    SDL3.setTheme(SDL3.darkTheme())
    Window w = SDL3.createWindow({title: "test_focus_nav", w: 620, h: 560})
    if not w.ok { SDL3.ttfQuit(); return }

    // 第一行：注册顺序 A → B → C，其中 **B 退出焦点链** ⇒ Tab 必须跳过它 ✓
    Button a = w.addButton({x: 20, y: 30, w: 180, h: 40, text: "A（可聚焦）"})
    Button b = w.addButton({x: 220, y: 30, w: 180, h: 40, text: "B（不可聚焦）"})
    Button c = w.addButton({x: 420, y: 30, w: 180, h: 40, text: "C（可聚焦）"})
    b.set_focusable(false)
    a.on_click(func() { hitsA = hitsA + 1 })
    c.on_click(func() { hitsC = hitsC + 1 })

    // 第二行：开关类（第二批进链条 ✓）
    CheckBox ck = w.addCheckBox({x: 20, y: 110, w: 180, h: 26, text: "复选框", checked: false})
    Toggle tg = w.addToggle({x: 220, y: 110, w: 180, h: 28, text: "开关", on: false})
    RadioButton rd = w.addRadioButton({x: 420, y: 110, w: 180, h: 24, text: "单选", group: "g9", checked: false})
    ck.on_change(func(bool v) { hitsCk = hitsCk + 1; ckVal = if v then 1 else 0 })

    // 第三行：滑块（第三批进链条 ✓；键盘微调 ←/↓ 减、→/↑ 加、Home/End 两端 ✓）
    //   值用公开的 `get_value()` 断言 ✓（`value` 字段虽是公有 ✓，但走 getter 更贴使用者视角 ✓）
    Slider sl2 = w.addSlider({x: 20, y: 156, w: 400, h: 24, min: 0, max: 100, value: 50, step: 5})

    // 第四行：列表（第四批进链条 ✓；↑/↓/Home/End 移动选中 ✓、Enter = 激活选中项 ✓）
    //   列表原来只有 `on_change`（"选中变了"）⇒ 本轮补了 `on_activate`（"确认/打开" ✓）
    ListBox lb = w.addListBox({x: 20, y: 196, w: 240, h: 120,
                               items: ["甲", "乙", "丙", "丁", "戊", "己"], selected: 0})
    int hitsLb = 0       // on_change 次数
    int actLb = -1       // on_activate 收到的下标
    int actN = 0         // on_activate 次数（★ 用来盯"Enter 被处理两次"这类问题 ✓）
    lb.on_change(func(Array[int] v) { hitsLb = hitsLb + 1 })
    lb.on_activate(func(int i) { actLb = i; actN = actN + 1 })

    // 第五行：下拉框（第五批进链条 ✓；↓/↑ 移动选中 ✓、Enter 开关下拉 ✓、Esc 收起 ✓）
    //   ⚠ 语义：开着下拉时**键盘照常工作** ✓（鼠标事件会被弹层捕获区拦掉，但键盘不能受影响 ✓）
    ComboBox cb2 = w.addComboBox({x: 300, y: 196, w: 200, h: 30,
                                  items: ["北京", "上海", "广州", "深圳"], selected: 0})
    int hitsCb = 0
    cb2.on_change(func(int i) { hitsCb = hitsCb + 1 })

    // 第六行：页签（第六批 ✓；←/→ 切页 ✓ —— 走 `set_active`，与鼠标点页签**同一入口** ✓）
    TabControl tc = w.addTabControl({x: 20, y: 240, w: 260, h: 130,
                                     tabs: ["  甲页  ", "  乙页  ", "  丙页  "], active: 0})
    // 第七行：表格（第六批 ✓；↑/↓/Home/End 移动选中行 ✓；Enter = **无编辑列时**走"双击"那条回调 ✓）
    Table tb2 = w.addTable({x: 300, y: 240, w: 300, h: 130, row_h: 26, header_h: 28,
                            headers: ["名", "值"], sortable: false})
    tb2.set_rows([["一", "1"], ["二", "2"], ["三", "3"], ["四", "4"]])
    int dblN = 0
    tb2.on_dbl_click(func(int r, int c) { dblN = dblN + 1 })

    // 第八行：树（第七批 ✓；↑/↓ 走**可见行** ✓、→ 展开、← 收起、Enter 激活 ✓）
    //   ★ 根节点**折叠**起步 ⇒ "可见行数"就是展开/收起的客观判据 ✓（1 → 3 → 1 ✓）
    //   ⚠ 建树的键名是 **`items`**（不是 `nodes` ✗ —— 实测写成 nodes 会得到"可见行=0"的空树 ✓）
    TreeView tv = w.addTreeView({x: 20, y: 380, w: 260, h: 120,
                                 items: [{text: "根", expanded: false,
                                          children: [{text: "子1"}, {text: "子2"}]}]})
    int actTv = -1
    int actTvN = 0
    tv.on_activate(func(int i) { actTv = i; actTvN = actTvN + 1 })

    // 第九行：**装在面板里**的按钮（第八批 ✓ —— 容器内的子控件也必须进焦点链 ✓）
    //   病根（本轮实测）：`Window._focusables()` 原来**只扫 `widgets`** ✗ ⇒ 面板/卡片/滚动区/页签页
    //   里的控件 **Tab 永远到不了** ✗（甚至连根布局 `root` 都不扫 ✓）
    //   判据：焦点链的**最后一项**就是它 ⇒ 从树（倒数第二项）再 Tab 应停在它身上 ✓
    //        （未修时：Tab 直接**回卷到 A** ✗ —— 面板内的控件被跳过 ✓）
    Panel pn = w.addPanel({x: 300, y: 380, w: 300, h: 120})
    Button d = SDL3.createButton({text: "D（面板内 ⇒ 只有递归才 Tab 得到）", w: 270, h: 34})
    pn.add(d)
    int hitsD = 0
    d.on_click(func() { hitsD = hitsD + 1 })
    tg.on_change(func(bool v) { tgHits = tgHits + 1; tgVal = if v then 1 else 0 })
    rd.on_change(func(bool v) { if v { rdHits = rdHits + 1 } })     // 选中时回调 true ✓

    var s = _env("SHOT"); if s != null { shot = _str(s) }
    if shot == "" { shot = "focus.png" }

    int wid = w.getID()
    w.addTimer(100, func() {
        steps = steps + 1
        if steps == 1 { snap(a, b, c, "初始（应全 false）") }
        if steps == 2 { SDL3.testKeyDown(wid, Scancode.TAB, 0) }
        if steps == 3 { snap(a, b, c, "Tab×1（应 A）") }
        if steps == 4 { SDL3.testKeyDown(wid, Scancode.TAB, 0) }
        if steps == 5 { snap(a, b, c, "Tab×2（应 C —— 跳过 B ✓）") }
        if steps == 6 { SDL3.testKeyDown(wid, Scancode.TAB, 0) }
        // ⚠ 焦点链现在是 **A→C→ck→tg→rd 五个**（B 被排除 ✓）⇒ Tab×3 应走到**复选框** ✓
        //   （按钮行三个全 false 是**正确**的 ✓ —— 第一批只有三个按钮时这里才是"回卷到 A" ✓）
        if steps == 7 { snap(a, b, c, "Tab×3（按钮行应全 false ⇒ 焦点已交给第四项 ✓）"); snapSw(ck, tg, rd, "Tab×3（应轮到复选框 ck ✓）") }
        if steps == 8 { SDL3.testKeyDown(wid, Scancode.TAB, 3) }        // 3 = Shift 位掩码 ✓
        if steps == 9 { snap(a, b, c, "Shift+Tab（应反向到 C ✓）") }
        if steps == 10 { SDL3.testKeyDown(wid, Scancode.RETURN, 0) }    // Enter ⇒ 激活 C
        if steps == 11 { snap(a, b, c, "Enter（应 hitsC=1 ✓）") }
        if steps == 12 { SDL3.testKeyDown(wid, Scancode.SPACE, 0) }     // Space ⇒ 再激活 C
        if steps == 13 { snap(a, b, c, "Space（应 hitsC=2 ✓）") }

        // ---- 第二行：开关类 ----
        if steps == 14 { SDL3.testKeyDown(wid, Scancode.TAB, 0) }       // → 复选框
        if steps == 15 { snapSw(ck, tg, rd, "Tab→ 复选框（应 ck.focus=true ✓）") }
        if steps == 16 { SDL3.testKeyDown(wid, Scancode.RETURN, 0) }    // Enter ⇒ 切一下
        if steps == 17 { snapSw(ck, tg, rd, "Enter（应 checked=true、回调=1 ✓）") }
        if steps == 18 { SDL3.testKeyDown(wid, Scancode.TAB, 0) }       // → 开关
        if steps == 19 { snapSw(ck, tg, rd, "Tab→ 开关（应 tg.focus=true ✓）") }
        if steps == 20 { SDL3.testKeyDown(wid, Scancode.SPACE, 0) }     // Space ⇒ 切一下
        if steps == 21 { snapSw(ck, tg, rd, "Space（应 on=true ✓）") }
        if steps == 22 { SDL3.testKeyDown(wid, Scancode.TAB, 0) }       // → 单选
        if steps == 23 { snapSw(ck, tg, rd, "Tab→ 单选（应 rd.focus=true ✓）") }
        if steps == 24 { SDL3.testKeyDown(wid, Scancode.RETURN, 0) }    // Enter ⇒ 选中自己
        if steps == 25 { snapSw(ck, tg, rd, "Enter（应 checked=true ✓）") }
        // ---- 第三行：滑块（键盘微调 ✓）----
        if steps == 26 { SDL3.testKeyDown(wid, Scancode.TAB, 0) }       // → 滑块
        if steps == 27 { print("[focus] Tab→ 滑块（应 focus=true、值=50 ✓）  focus=" + _str(sl2.is_focused()) +
                                " 值=" + _str(sl2.get_value())) }
        if steps == 28 { SDL3.testKeyDown(wid, Scancode.RIGHT, 0) }     // → 加 5
        if steps == 29 { print("[focus] →（应 55 ✓）  值=" + _str(sl2.get_value())) }
        if steps == 30 { SDL3.testKeyDown(wid, Scancode.LEFT, 0) }      // ← 减 5
        if steps == 31 { print("[focus] ←（应 50 ✓）  值=" + _str(sl2.get_value())) }
        if steps == 32 { SDL3.testKeyDown(wid, Scancode.END, 0) }       // End ⇒ 上限
        if steps == 33 { print("[focus] End（应 100 ✓）  值=" + _str(sl2.get_value())) }
        if steps == 34 { SDL3.testKeyDown(wid, Scancode.HOME, 0) }      // Home ⇒ 下限
        if steps == 35 { print("[focus] Home（应 0 ✓）  值=" + _str(sl2.get_value())) }
        // ---- 第四行：列表（键盘选 + Enter 激活 ✓）----
        if steps == 36 { SDL3.testKeyDown(wid, Scancode.TAB, 0) }        // → 列表
        if steps == 37 { print("[focus] Tab→ 列表（应 focus=true、选中=0 ✓）  focus=" + _str(lb.is_focused()) +
                                " 选中=" + _str(lb.get_selected_index())) }
        if steps == 38 { SDL3.testKeyDown(wid, Scancode.DOWN, 0) }       // ↓ 下移一格
        if steps == 39 { print("[focus] ↓（应 1 ✓）  选中=" + _str(lb.get_selected_index()) +
                                " on_change次数=" + _str(hitsLb)) }
        if steps == 40 { SDL3.testKeyDown(wid, Scancode.UP, 0) }         // ↑ 上移一格
        if steps == 41 { print("[focus] ↑（应 0 ✓）  选中=" + _str(lb.get_selected_index())) }
        if steps == 42 { SDL3.testKeyDown(wid, Scancode.END, 0) }        // End ⇒ 末项
        if steps == 43 { print("[focus] End（应 5 ✓）  选中=" + _str(lb.get_selected_index())) }
        if steps == 44 { SDL3.testKeyDown(wid, Scancode.HOME, 0) }       // Home ⇒ 首项
        if steps == 45 { print("[focus] Home（应 0 ✓）  选中=" + _str(lb.get_selected_index())) }
        if steps == 46 { SDL3.testKeyDown(wid, Scancode.RETURN, 0) }     // Enter ⇒ 激活选中项
        if steps == 47 { print("[focus] Enter（应 actLb=0、且**次数=1** ✓ —— 两次就是双触发 ✗）  actLb=" +
                                _str(actLb) + " 次数=" + _str(actN)) }
        // ---- 第五行：下拉框（开合 + 选中 ✓）----
        if steps == 48 { SDL3.testKeyDown(wid, Scancode.TAB, 0) }        // → 下拉框
        if steps == 49 { print("[focus] Tab→ 下拉框（应 focus=true、选中=0、未展开 ✓）  focus=" + _str(cb2.is_focused()) +
                                " 选中=" + _str(cb2.get_selected()) + " 展开=" + _str(cb2.isOpen())) }
        if steps == 50 { SDL3.testKeyDown(wid, Scancode.DOWN, 0) }       // 收起态 ↓ ⇒ 换选中
        if steps == 51 { print("[focus] ↓（应 1、on_change=1 ✓）  选中=" + _str(cb2.get_selected()) +
                                " on_change次数=" + _str(hitsCb)) }
        if steps == 52 { SDL3.testKeyDown(wid, Scancode.RETURN, 0) }     // Enter ⇒ 展开
        if steps == 53 { print("[focus] Enter（应 展开=true ✓）  展开=" + _str(cb2.isOpen())) }
        if steps == 54 { SDL3.testKeyDown(wid, Scancode.DOWN, 0) }       // 展开态 ↓ 仍能换选中 ✓
        if steps == 55 { print("[focus] 展开后 ↓（应 2 ✓）  选中=" + _str(cb2.get_selected())) }
        if steps == 56 { SDL3.testKeyDown(wid, Scancode.RETURN, 0) }     // Enter ⇒ 收起（选定 ✓）
        if steps == 57 { print("[focus] Enter（应 展开=false ✓）  展开=" + _str(cb2.isOpen())) }
        if steps == 58 { SDL3.testKeyDown(wid, Scancode.RETURN, 0) }     // 再开
        if steps == 59 { SDL3.testKeyDown(wid, Scancode.ESCAPE, 0) }     // Esc ⇒ 收起
        if steps == 60 { print("[focus] Esc（应 展开=false ✓）  展开=" + _str(cb2.isOpen())) }
        // ---- 第六行：页签（←/→ 切页 ✓）----
        if steps == 61 { SDL3.testKeyDown(wid, Scancode.TAB, 0) }        // → 页签
        if steps == 62 { print("[focus] Tab→ 页签（应 focus=true、页=0 ✓）  focus=" + _str(tc.is_focused()) +
                                " 页=" + _str(tc.get_active())) }
        if steps == 63 { SDL3.testKeyDown(wid, Scancode.RIGHT, 0) }
        if steps == 64 { print("[focus] →（应 1 ✓）  页=" + _str(tc.get_active())) }
        if steps == 65 { SDL3.testKeyDown(wid, Scancode.RIGHT, 0) }
        if steps == 66 { print("[focus] →（应 2 ✓）  页=" + _str(tc.get_active())) }
        if steps == 67 { SDL3.testKeyDown(wid, Scancode.LEFT, 0) }
        if steps == 68 { print("[focus] ←（应 1 ✓）  页=" + _str(tc.get_active())) }

        // ---- 第七行：表格（移动选中行 + Enter 语义 ✓）----
        if steps == 69 { print("[focus] （进表格前）行=" + _str(tb2.get_selected_row()) + " 双击次数=" + _str(dblN));
                         SDL3.testKeyDown(wid, Scancode.TAB, 0) }        // → 表格
        if steps == 70 { print("[focus] Tab→ 表格（应 focus=true、行=-1 ✓）  focus=" + _str(tb2.is_focused()) +
                                " 行=" + _str(tb2.get_selected_row())) }
        if steps == 71 { print("[focus] （↓ 前）行=" + _str(tb2.get_selected_row()) + " 双击次数=" + _str(dblN));
                         SDL3.testKeyDown(wid, Scancode.DOWN, 0) }
        if steps == 72 { print("[focus] ↓（应 0 ✓）  行=" + _str(tb2.get_selected_row())) }
        if steps == 73 { SDL3.testKeyDown(wid, Scancode.DOWN, 0) }
        if steps == 74 { print("[focus] ↓（应 1 ✓）  行=" + _str(tb2.get_selected_row())) }
        if steps == 75 { SDL3.testKeyDown(wid, Scancode.END, 0) }
        if steps == 76 { print("[focus] End（应 3 ✓）  行=" + _str(tb2.get_selected_row())) }
        if steps == 77 { SDL3.testKeyDown(wid, Scancode.HOME, 0) }
        if steps == 78 { print("[focus] Home（应 0 ✓）  行=" + _str(tb2.get_selected_row())) }
        if steps == 79 { SDL3.testKeyDown(wid, Scancode.RETURN, 0) }
        if steps == 80 { print("[focus] Enter（应 双击回调=1 ✓ —— 本例没有可编辑列 ⇒ 走双击那条 ✓）  次数=" + _str(dblN)) }
        // ---- 第八行：树（可见行导航 + 展开/收起 + 激活 ✓）----
        if steps == 81 { SDL3.testKeyDown(wid, Scancode.TAB, 0) }        // → 树
        if steps == 82 { print("[focus] Tab→ 树（应 focus=true、可见行=1 ✓）  focus=" + _str(tv.is_focused()) +
                                " 可见行=" + _str(tv.get_visible_count())) }
        if steps == 83 { SDL3.testKeyDown(wid, Scancode.DOWN, 0) }
        if steps == 84 { print("[focus] ↓（应选中首行 id>=0 ✓）  选中=" + _str(tv.get_selected_id()) +
                                " 可见行=" + _str(tv.get_visible_count())) }
        if steps == 85 { SDL3.testKeyDown(wid, Scancode.RIGHT, 0) }      // → 展开
        if steps == 86 { print("[focus] →（应展开 ⇒ 可见行=3 ✓）  可见行=" + _str(tv.get_visible_count())) }
        if steps == 87 { SDL3.testKeyDown(wid, Scancode.DOWN, 0) }       // 展开后能走到子节点
        if steps == 88 { print("[focus] 展开后 ↓（应换到子节点 ✓）  选中=" + _str(tv.get_selected_id())) }
        if steps == 89 { SDL3.testKeyDown(wid, Scancode.UP, 0) }         // ↑ 回到根
        if steps == 90 { print("[focus] ↑（应回根 ✓）  选中=" + _str(tv.get_selected_id())) }
        //   ⚠ ← 只对"可收起的节点"有效：叶子上按 ← 不会跳回父级（标准行为 ✓ 本版未做 ⇒ 见速查 v1 边界 ✓）
        if steps == 91 { SDL3.testKeyDown(wid, Scancode.LEFT, 0) }       // ← 收起根
        if steps == 92 { print("[focus] ←（应收起根 ⇒ 可见行=1 ✓）  可见行=" + _str(tv.get_visible_count())) }
        if steps == 93 { SDL3.testKeyDown(wid, Scancode.RETURN, 0) }     // Enter ⇒ 激活
        if steps == 94 { print("[focus] Enter（应 激活次数=1 ✓）  次数=" + _str(actTvN) + " 收到 id=" + _str(actTv)) }
        // ---- 第九行：容器内的按钮（第八批 ✓）----
        //   ★ 这里就是**复现点**：树是 `widgets` 里最后一个"顶层可聚焦控件"，
        //     而链尾应该是**面板内的 D** ✓ ⇒ 再 Tab 应停在 D 上；
        //     若直接回卷到 A（A=true）⇒ 说明容器内的控件**没进链条** ✗
        if steps == 95 { SDL3.testKeyDown(wid, Scancode.TAB, 0) }
        if steps == 96 { snap(a, b, c, "Tab（应 D=false/A=true ✗ 未修；修后 D=true、A=false ✓）");
                         print("[focus] Tab（链尾应是**面板内**的 D ⇒ 第八批 ✓）  D.focus=" + _str(d.is_focused()) +
                               " 面板内按钮 hitsD=" + _str(hitsD)) }
        if steps == 97 { SDL3.testKeyDown(wid, Scancode.SPACE, 0) }       // Space ⇒ 激活 D
        if steps == 98 { print("[focus] Space（应 hitsD=1 ✓ —— 与鼠标点击同一条回调 ✓）  hitsD=" + _str(hitsD)) }
        if steps == 99 { SDL3.testKeyDown(wid, Scancode.TAB, 0) }         // 再 Tab ⇒ 这才该回卷到 A ✓
        if steps == 100 { snap(a, b, c, "Tab（应回卷到 A ✓ —— 链条末尾回卷 ✓）") }
        if steps >= 104 { _exit(0) }
    })

    // 截图（看焦点环 ✓）：钩子必须在 setOverlay（控件之上 ⇒ 像素含界面 ✓）
    w.setOverlay(func(Renderer r) {
        if steps >= 100 and shot != "" {
            var sz = w.getSize()
            var px = r.readPixelsAt(0, 0, sz.w, sz.h)
            if px != null { print("[focus] 截图 " + shot + " ok=" + _str(SDL3.saveImagePNG(px, shot))) }
            _exit(0)
        }
    })

    w.run(func(Event ev): bool { return true }, func(Renderer r) {})
    SDL3.ttfQuit()
}

main() { run() }
