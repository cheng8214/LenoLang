// test_progress_hover.leno — ProgressBar **悬停位置回调 / 点击跳转**验收（回归件 ✓）
//   由来：Aria 反馈「鼠标移上去应提示当前进度条位置的时间」「点击不能跳转」。
//   · 点击不跳转：应用侧 on_seek 之前只改 pos、没真 seek（已修）；框架侧 process 里点击→on_change 是通的，
//     本探针把它钉住 ✓
//   · 悬停时间：进度条原来只有静态 tip 文案 ⇒ 新增 `on_hover(值, x, y)`（离开传 -1）+
//     门面 `SDL3.tipReport / tipClear` 供应用自己格式化提示 ✓
//
//   判据（跑完看输出，全 OK）：
//     ① 鼠标移到轨道**正中** ⇒ on_hover 值 ≈ 50
//     ② 鼠标移出进度条 ⇒ on_hover 值 = -1（应用据此收气泡）
//     ③ 在 25% 处点击 ⇒ on_change 值 ≈ 25（点击跳转链路通）
//
//   跑法（项目根目录）：
//     build\leno.exe leno_gui\自测\test_progress_hover.leno
import "SDL3" as SDL3
use SDL3.(Event, Renderer, Window, ProgressBar)

const float BX = 20.0
const float BY = 40.0
const float BW = 360.0
const float BH = 8.0

int steps = 0
float hoverV = -999.0
float clickV = -999.0
Window w
ProgressBar pb

func near(float a, float b, float tol): bool {
    float d = a - b
    if d < 0.0 { d = -d }
    return d <= tol
}

func run() {
    SDL3.ttfInit()
    w = SDL3.createWindow({title: "probe_progress_hover", w: 420, h: 130})
    if not w.ok { SDL3.ttfQuit(); return }

    pb = w.addProgressBar({x: BX, y: BY, w: BW, h: BH, min: 0.0, max: 100.0,
                           value: 0.0, show_text: false, clickable: true,
                           hit_pad_y: 10.0})     // 命中区上下各外扩 10px（视觉仍是 8px ✓）
    pb.on_hover(func(float v, float mx, float my) { hoverV = v })
    pb.on_change(func(float v) { clickV = v })

    w.addTimer(100, func() {
        steps = steps + 1
        if steps == 4 {
            // ① 轨道正中（x = BX + BW/2）
            SDL3.testMoveAt(w.getID(), BX + BW / 2.0, BY + BH / 2.0)
        }
        if steps == 5 {
            if near(hoverV, 50.0, 2.0) { print("[pb] ① 悬停轨道正中 ⇒ " + _str(hoverV) + "（期望≈50）OK") }
            else { print("[pb] ① 悬停轨道正中 ✗ 实际 " + _str(hoverV) + "，期望≈50") }
            // ② 移出进度条（往下 60px）
            SDL3.testMoveAt(w.getID(), BX + BW / 2.0, BY + BH + 60.0)
        }
        if steps == 6 {
            if hoverV < 0.0 { print("[pb] ② 移出进度条 ⇒ " + _str(hoverV) + "（期望 -1）OK") }
            else { print("[pb] ② 移出进度条 ✗ 实际 " + _str(hoverV) + "，期望 -1") }
            // ③ 25% 处点击
            SDL3.testClickAt(w.getID(), BX + BW * 0.25, BY + BH / 2.0)
        }
        if steps == 7 {
            if near(clickV, 25.0, 2.0) { print("[pb] ③ 25% 处点击 ⇒ on_change " + _str(clickV) + "（期望≈25）OK") }
            else { print("[pb] ③ 25% 处点击 ✗ 实际 " + _str(clickV) + "，期望≈25") }
            // ④ 命中区外扩：在**视觉进度条下方 6px** 处点击（h=8 + pad 10 ⇒ 应该还能命中）
            clickV = -999.0
            SDL3.testClickAt(w.getID(), BX + BW * 0.75, BY + BH + 6.0)
        }
        if steps == 8 {
            if near(clickV, 75.0, 2.0) { print("[pb] ④ 视觉条下方 6px 点击 ⇒ on_change " + _str(clickV) + "（hit_pad_y 生效 ✓）OK") }
            else { print("[pb] ④ 视觉条下方 6px 点击 ✗ 实际 " + _str(clickV) + "，说明命中区没外扩") }
            _exit(0)
        }
    })

    w.run(func(Event ev): bool { return true }, func(Renderer r) { r.clearColor(#101418FF) })
    SDL3.ttfQuit()
}

main() { run() }
