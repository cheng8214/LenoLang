// Markdown.leno -- Markdown → HTML（纯 Leno，无原生依赖）
//
// 为什么需要：Leno 没有 markdown 库 ⇒ 文档站（LenoDocsSrc）只能让 Python 的 markdown 包生成 HTML，
//   于是"改个模板 / 加个页面"都要先装 Python 依赖。这个模块把那一步收回 Leno。
//
// 覆盖范围 = **文档站实际用到的语法**（不是 Complete Markdown）：
//   块级：ATX 标题(#..######，带锚点) / 段落 / 围栏代码(```lang) / 表格(GFM) /
//         无序与有序列表(含嵌套) / 引用(含嵌套) / 分隔线 / 原始 HTML 块
//   行内：`code` / **粗** / *斜* / [链接](url) / ![图](src) / \转义
//
// API：
//   md.to_html(text)      → HTML 片段
//   md.headings(text)     → Array[Heading]（level/text/id，给目录用）
//   md.slug(text)         → 锚点名（保留中文，与文档里手写的 `#基础语法` 一致）
//   md.escape(text)       → HTML 转义
//
// 刻意**不支持**（写了会原样输出，不会报错）：
//   · 下划线斜体 `_x_`：Leno 代码里 `snake_case` 满地都是，误判代价 >> 收益；
//   · 引用式链接 `[a][ref]` / 脚注 / 定义列表 / 任务列表；
//   · 行内原始 HTML（块级会把整段原样透传，这是文档站需要的能力）。
//
// 与 python-markdown 的一致性：输出形状（换行位置、`<th>` 一行一个、`<hr>` 不闭合…）
//   是照文档站现有 HTML 抄的，可以用 `bench/` 里的对拍脚本逐字节比。
import strings

// 字段必须写初值：Leno 的 struct 标量字段默认是 **null**（不是 0），不写会在参与运算时报错
export struct Heading {
    int level = 0
    string text = ""
    string id = ""
}

// ---------------------------------------------------------------- 转义

func esc_text(string s):string {
    if strings.find(s, "&") < 0 and strings.find(s, "<") < 0 and strings.find(s, ">") < 0 {
        return s
    }
    return strings.replace(strings.replace(strings.replace(s, "&", "&amp;"), "<", "&lt;"), ">", "&gt;")
}

// 代码块里连引号一起转（与 python-markdown 一致：`"` → `&quot;`）
func esc_code(string s):string {
    var t = esc_text(s)
    return strings.replace(t, "\"", "&quot;")
}

export func escape(string s):string {
    return esc_code(s)
}

// ---------------------------------------------------------------- 锚点

// 与 docs/build_html.py 的 _slug 同口径：小写；字母/数字/汉字/`_`/`-` 保留；
//   其余（空格、括号、斜杠、标点）压成 `-`；连续 `-` 合并；首尾 `-` 去掉；空则 `_`。
export func slug(string text):string {
    var lower = strings.to_lower(strings.trim(text))
    Array[string] chars = []
    var i = 0
    var n = lower.len()
    while i < n {
        var c = lower.slice(i, i)
        if is_word_char(c) or c == "_" or c == "-" {
            chars.add(c)
        } else {
            chars.add("-")
        }
        i += 1
    }
    var s = strings.join(chars, "")
    while strings.find(s, "--") >= 0 {
        s = strings.replace(s, "--", "-")
    }
    // 去首尾 `-`（stdlib 没有 trim_chars，手写；slug 串很短）
    while s.len() > 0 and s.slice(0, 0) == "-" {
        s = s.slice(1, s.len() - 1)
    }
    while s.len() > 0 and s.slice(s.len() - 1, s.len() - 1) == "-" {
        s = s.slice(0, s.len() - 2)
    }
    if s == "" { return "_" }
    return s
}

// 字母 / 数字 / 汉字
//   ⚠ 不能"多字节就算词字符"：中文**全角标点**（（）、，。！？：；《》…）也是多字节，
//     那样 `返回类型（跟接收者一致）` 的括号会留在锚点里，而 python 的 `isalnum()` 判 False
//     ⇒ 必须按**码点范围**分：ASCII 字母数字 / CJK 统一表意区 / 假名 / 全角字母数字
func is_word_char(string c):bool {
    var cp = codepoint_of(c)
    if cp >= 48 and cp <= 57 { return true }              // 0-9
    if cp >= 65 and cp <= 90 { return true }              // A-Z
    if cp >= 97 and cp <= 122 { return true }             // a-z
    if cp >= 0x4E00 and cp <= 0x9FFF { return true }      // CJK 统一表意
    if cp >= 0x3400 and cp <= 0x4DBF { return true }      // CJK 扩展 A
    if cp >= 0x3040 and cp <= 0x30FF { return true }      // 平假名 / 片假名
    if cp >= 0x3005 and cp <= 0x3007 { return true }      // 々〆〇
    if cp >= 0xFF10 and cp <= 0xFF19 { return true }      // 全角数字
    if cp >= 0xFF21 and cp <= 0xFF3A { return true }      // 全角大写
    if cp >= 0xFF41 and cp <= 0xFF5A { return true }      // 全角小写
    return false
}

// 取一个**字符**的 Unicode 码点（UTF-8 解码；非法序列返回 0xFFFD）
func codepoint_of(string c):int {
    var b = c.to_bytes()
    if b.len() == 0 { return 0xFFFD }
    var v = b[0]
    if b.len() == 1 { return v }
    if b.len() == 2 { return ((v & 0x1F) << 6) | (b[1] & 0x3F) }
    if b.len() == 3 { return ((v & 0x0F) << 12) | ((b[1] & 0x3F) << 6) | (b[2] & 0x3F) }
    if b.len() == 4 {
        return ((v & 0x07) << 18) | ((b[1] & 0x3F) << 12) | ((b[2] & 0x3F) << 6) | (b[3] & 0x3F)
    }
    return 0xFFFD
}

// 把行内标记剥掉，只留纯文本（给 slug 用）
func strip_inline(string s):string {
    var t = strings.replace(s, "`", "")
    t = strings.replace(t, "**", "")
    t = strings.replace(t, "*", "")
    t = strings.replace(t, "![", "")
    t = strings.replace(t, "]", "")
    return t
}

// ---------------------------------------------------------------- 行内

func find_from(string s, string needle, int from):int {
    var n = s.len()
    if from < 0 { from = 0 }
    if from >= n { return -1 }
    var idx = strings.find(s.slice(from, n - 1), needle)
    if idx < 0 { return -1 }
    return from + idx
}

func inline(string s):string {
    Array[string] out = []
    var i = 0
    var n = s.len()
    while i < n {
        var c = s.slice(i, i)

        // 反斜杠转义：`\*` 输出字面 `*`
        if c == "\\" and i + 1 < n {
            out.add(esc_text(s.slice(i + 1, i + 1)))
            i += 2
            continue
        }

        // 行内代码 `x` / ``x`` / ```x```（**开闭必须等长**，否则 ```lang 这种会被切错）
        if c == "`" {
            var ticks = 1
            while i + ticks < n and s.slice(i + ticks, i + ticks) == "`" { ticks += 1 }
            var fence_run = ""
            var t = 0
            while t < ticks { fence_run = fence_run + "`"; t += 1 }
            var close = find_from(s, fence_run, i + ticks)
            if close > i + ticks {
                var code = s.slice(i + ticks, close - 1)
                // ⚠ 行内代码**不转义引号**（python-markdown 只在代码块里把 `"` 变成 `&quot;`，
                //   行内 `<code>` 里保持原样 ⇒ 两边不一致会让每个带引号的例子都"看起来不同"）
                out.add("<code>" + esc_text(trim_one_space(code)) + "</code>")
                i = close + ticks
                continue
            }
            out.add(fence_run)
            i += ticks
            continue
        }

        // 行内 HTML 透传：`<br>` / `<kbd>Ctrl</kbd>` / `<sub>2</sub>` 原样输出
        //   （python-markdown 也透传；`a < b` 这种 `<` 后不是字母的仍照常转义）
        if c == "<" {
            var gt = find_from(s, ">", i + 1)
            if gt > i + 1 and looks_like_tag(s.slice(i + 1, gt - 1)) {
                out.add(s.slice(i, gt))
                i = gt + 1
                continue
            }
        }

        // 图片 ![alt](src) / ![alt](src "标题")
        if c == "!" and i + 1 < n and s.slice(i + 1, i + 1) == "[" {
            var img = parse_link(s, i + 1)
            if img.ok {
                // `src "title"`：地址后面跟一个**引号串**是 title（CommonMark）
                var src_url = img.url
                var title = ""
                var q = strings.find(src_url, " \"")
                if q > 0 and strings.ends_with(src_url, "\"") {
                    title = " title=\"" + esc_code(src_url.slice(q + 2, src_url.len() - 2)) + "\""
                    src_url = src_url.slice(0, q - 1)
                }
                out.add("<img alt=\"" + esc_code(img.text) + "\" src=\"" + esc_code(src_url) + "\"" + title + " />")
                i = img.next
                continue
            }
        }

        // 链接 [text](url)
        if c == "[" {
            var lk = parse_link(s, i)
            if lk.ok {
                out.add("<a href=\"" + esc_code(lk.url) + "\">" + inline(lk.text) + "</a>")
                i = lk.next
                continue
            }
        }

        // 删除线 ~~x~~（GFM 写法）—— python-markdown 核心**不支持**，它一直把 `~~` 原样输出；
        //   文档里用它标记"已废弃/已删"，读者看到一堆波浪线很别扭 ⇒ 本库补上
        if c == "~" and i + 1 < n and s.slice(i + 1, i + 1) == "~" {
            var close_t = find_from(s, "~~", i + 2)
            if close_t > i + 2 {
                out.add("<del>" + inline(s.slice(i + 2, close_t - 1)) + "</del>")
                i = close_t + 2
                continue
            }
        }

        // 粗体 **x**
        //   ⚠ CommonMark 的边界规则：**开标记后面不能是空格**、**闭标记前面不能是空格**。
        //   不遵守时，正文里像 `** 重点` 这种（`**` 后带空格）会被当成开头，一路错配到
        //   很远处的 `**`，输出里就会冒出孤立的 `</strong>` 和残留 `**`（实测多篇踩到 ✗）
        if c == "*" and i + 1 < n and s.slice(i + 1, i + 1) == "*" {
            var after_ok = (i + 2 < n) and s.slice(i + 2, i + 2) != " " and s.slice(i + 2, i + 2) != "\n"
            if after_ok {
                var close2 = find_em_close(s, "**", i + 2)
                if close2 > i + 2 {
                    out.add("<strong>" + inline(s.slice(i + 2, close2 - 1)) + "</strong>")
                    i = close2 + 2
                    continue
                }
            }
        }

        // 斜体 *x*
        //   左边界（CommonMark 的 left-flanking）：**前面必须是开头/空白/标点**。
        //   否则 `string→char*、cstruct` 里的 `char*` 会被当成斜体开头，一路错配到很远的
        //   `*`，把后面的正文整段吞进 `<em>`（实测 archive/FFI优化方案 就是这样 ✗）
        if c == "*" {
            var prev_ok = (i == 0) or (s.slice(i - 1, i - 1) != "*")
            if prev_ok and i > 0 and not can_open_em(s, i) { prev_ok = false }
            var after_ok2 = (i + 1 < n) and s.slice(i + 1, i + 1) != " " and s.slice(i + 1, i + 1) != "\n"
            if prev_ok and after_ok2 {
                var close3 = find_em_close(s, "*", i + 1)
                if close3 > i + 1 {
                    out.add("<em>" + inline(s.slice(i + 1, close3 - 1)) + "</em>")
                    i = close3 + 1
                    continue
                }
            }
        }

        out.add(esc_text(c))
        i += 1
    }
    return strings.join(out, "")
}

// `inner`（`<` 与 `>` 之间）是否像一个 HTML 标签的**起始**段：
//   可选 `/` + 字母开头的标签名（字母/数字/`-`），到结尾都合法 ⇒ 是标签；
//   遇到空格或 `/` ⇒ 有属性/自闭合，也算标签。
//   ⚠ 这样 `a < b`（`<` 后是空格）不会被误判成标签。
func looks_like_tag(string inner):bool {
    if inner == "" { return false }
    var k = 0
    if inner.slice(0, 0) == "/" { k = 1 }
    if k >= inner.len() { return false }
    if not is_ascii_alpha(inner.slice(k, k)) { return false }
    k += 1
    while k < inner.len() {
        var ch = inner.slice(k, k)
        var b = ch.to_bytes()
        if b.len() != 1 { return false }
        var v = b[0]
        if is_ascii_alpha(ch) or (v >= 48 and v <= 57) or v == 45 {
            k += 1
            continue
        }
        if v == 32 or v == 47 { return true }        // 属性 / 自闭合
        return false
    }
    return true
}

func is_ascii_alpha(string ch):bool {
    var b = ch.to_bytes()
    if b.len() != 1 { return false }
    var v = b[0]
    return (v >= 65 and v <= 90) or (v >= 97 and v <= 122)
}

// 去掉行首 0~3 个空格（4 个空格是缩进代码块的标记，不在这里处理）
func strip_upto3(string s):string {
    var i = 0
    while i < 3 and i < s.len() and s.slice(i, i) == " " { i += 1 }
    if i == 0 { return s }
    return s.slice(i, s.len() - 1)
}

// `*` 能否开启强调：前一个字符必须是 空白/换行 或常见左括类标点
//   （`char*` 这种"紧贴单词"的星号是**右**边界，不能当开头）
func can_open_em(string s, int i):bool {
    var prev = s.slice(i - 1, i - 1)
    if prev == " " or prev == "\n" or prev == "\t" { return true }
    Array[string] opens = ["(", "（", "[", "【", "「", "“", "\"", "'", "、", "，", "。", "：", "；", "！", "？", "/", "→", "-", "+", "="]
    for opens to o {
        if prev == o { return true }
    }
    return false
}

// 找**合法的闭标记**：
//   ① marker 前面的字符不能是空格/换行（CommonMark 的强调收尾规则）；
//   ② **必须跳过行内代码**——`` （C 的 `char**`）现状 `` 里的 `**` 是代码内容，
//      当闭标记的话会把前半句圈成 `<strong>`、后半句全乱（实测 archive/密集数据… 就是这样 ✗）
func find_em_close(string s, string marker, int from):int {
    var n = s.len()
    var k = from
    while k < n {
        var c = s.slice(k, k)
        if c == "`" {
            // 按 **run 长度**配对：`` `x` `` 与 `````` ```leno ``` ``` 都算代码；
            //   只按单个反引号切换状态的话，```` ``` ```` 会切 3 次 ⇒ 状态错位，闭标记找错位置
            var ticks = 1
            while k + ticks < n and s.slice(k + ticks, k + ticks) == "`" { ticks += 1 }
            var run = ""
            var t = 0
            while t < ticks {
                run = run + "`"
                t += 1
            }
            var close_code = find_from(s, run, k + ticks)
            if close_code < 0 { return -1 }          // 反引号没配对：后面都当代码，不找闭标记
            k = close_code + ticks
            continue
        }
        if strings.starts_with(s.slice(k, n - 1), marker) {
            var prev = s.slice(k - 1, k - 1)
            if prev != " " and prev != "\n" { return k }
        }
        k += 1
    }
    return -1
}

func trim_one_space(string s):string {
    if strings.starts_with(s, " ") and strings.ends_with(s, " ") and s.len() >= 2 {
        return s.slice(1, s.len() - 2)
    }
    return s
}

struct LinkParts {
    bool ok = false
    string text = ""
    string url = ""
    int next = 0
}

// 从 `[` 开始解析 `[text](url)`；失败返回 ok=false
func parse_link(string s, int open):LinkParts {
    LinkParts r = new LinkParts()
    r.ok = false
    r.text = ""
    r.url = ""
    r.next = open
    var n = s.len()
    // ⚠ 标签里可以**嵌套 `[`**（`[Ptr[T] 的区别](#…)'` 这种），必须按深度找**真正配对**的 `]`；
    //   直接找第一个 `]` 会让这类链接整条漏成纯文本（实测 FFI使用指南/入门教程 的目录全没转换 ✗）
    var depth = 0
    var k = open + 1
    var rb = -1
    while k < n {
        var ch = s.slice(k, k)
        if ch == "[" {
            depth += 1
        } else if ch == "]" {
            if depth == 0 {
                rb = k
                break
            }
            depth -= 1
        }
        k += 1
    }
    if rb < 0 or rb + 1 >= n or s.slice(rb + 1, rb + 1) != "(" { return r }
    var rp = find_from(s, ")", rb + 2)
    if rp < 0 { return r }
    r.ok = true
    r.text = s.slice(open + 1, rb - 1)
    r.url = s.slice(rb + 2, rp - 1)
    r.next = rp + 1
    return r
}

// ---------------------------------------------------------------- 块级判据

func is_blank(string l):bool {
    return strings.trim(l) == ""
}

// `#`..`######` + 空格；返回级别，非标题返回 0
func heading_level(string l):int {
    var n = 0
    while n < l.len() and n < 6 and l.slice(n, n) == "#" { n += 1 }
    if n == 0 { return 0 }
    if n >= l.len() { return n }                       // 全是 `#`：也当标题
    if l.slice(n, n) == " " { return n }
    return 0
}

func is_hr(string l):bool {
    var t = strings.trim(l)
    if t.len() < 3 { return false }
    var c = t.slice(0, 0)
    if c != "-" and c != "*" and c != "_" { return false }
    var i = 0
    while i < t.len() {
        if t.slice(i, i) != c { return false }
        i += 1
    }
    return true
}

// 列表项：`- ` / `* ` / `+ ` / `1. `；返回 marker 长度，非列表返回 0
func list_marker_len(string l):int {
    var t = strings.trim_start(l)
    if t.len() >= 2 {
        var c = t.slice(0, 0)
        if (c == "-" or c == "*" or c == "+") and t.slice(1, 1) == " " { return 2 }
    }
    var d = 0
    while d < t.len() and d < 9 and t.slice(d, d) >= "0" and t.slice(d, d) <= "9" { d += 1 }
    if d > 0 and d + 1 < t.len() and t.slice(d, d) == "." and t.slice(d + 1, d + 1) == " " {
        return d + 2
    }
    return 0
}

func is_ordered(string l):bool {
    var t = strings.trim_start(l)
    return t.slice(0, 0) >= "0" and t.slice(0, 0) <= "9"
}

func is_quote(string l):bool {
    return strings.starts_with(strings.trim_start(l), ">")
}

func is_fence(string l):bool {
    return strings.starts_with(strings.trim_start(l), "```")
}

// **闭合**围栏 = 只有反引号（允许缩进/行尾空格），**不能带语言**
//   ⚠ 这是 CommonMark 的规则，也是 python-markdown 的行为。按"任何 ``` 都算切换"会出事：
//   文档里漏写一个闭合围栏时，下一段的 ```` ```leno ```` 会被当成闭合 ⇒ 从此**奇偶颠倒**，
//   后面整篇都被吞进代码块（实测 module_cstructs.md 就是这样毁掉的）。
func is_fence_close(string l):bool {
    var t = strings.trim(l)
    if not strings.starts_with(t, "```") { return false }
    if t == "```" { return true }
    return strings.trim(t.slice(3, t.len() - 1)) == ""
}

// 表格分隔行：只含 `| - : 空格`，且至少一个 `-`
func is_table_sep(string l):bool {
    var t = strings.trim(l)
    if strings.find(t, "-") < 0 { return false }
    var i = 0
    while i < t.len() {
        var c = t.slice(i, i)
        if c != "|" and c != "-" and c != ":" and c != " " { return false }
        i += 1
    }
    return true
}

func is_table_row(string l):bool {
    return strings.find(l, "|") >= 0
}

func starts_block(Array[string] lines, int i):bool {
    var l = lines[i]
    if is_blank(l) { return true }
    if heading_level(l) > 0 { return true }
    if is_fence(l) { return true }
    if is_quote(l) { return true }
    if is_hr(l) { return true }
    if list_marker_len(l) > 0 {
        // ⚠ sane_lists：列表**前面必须有空行**才算新块。否则
        //   ```
        //   **参数**:
        //   - key (string): ...
        //   ```
        //   在 python-markdown 里是**同一个段落**（`- key` 只是段内文字），
        //   我们若把它当列表就会多出 <ul>/<li> ⇒ 整段结构都不一样。
        if i == 0 { return true }
        return is_blank(lines[i - 1])
    }
    if strings.starts_with(strings.trim(l), "<") and strings.ends_with(strings.trim(l), ">") { return true }
    if strings.starts_with(strings.trim(l), "|") and i + 1 < lines.len() and is_table_sep(lines[i + 1]) { return true }
    return false
}

// ---------------------------------------------------------------- 表格

// 拆一行表格：**支持单元格内 `\|` 转义**（否则单元格里写竖线就断开）
func split_row(string l):Array[string] {
    var t = strings.trim(l)
    if strings.starts_with(t, "|") { t = t.slice(1, t.len() - 1) }
    if strings.ends_with(t, "|") and t.len() >= 2 and t.slice(t.len() - 2, t.len() - 2) != "\\" {
        t = t.slice(0, t.len() - 2)
    }
    Array[string] cells = []
    Array[string] cur = []
    var in_code = false
    var i = 0
    while i < t.len() {
        var c = t.slice(i, i)
        // 行内代码里的 `|` 是**字面量**（`a|b` 这种），不能拆格
        if c == "`" {
            in_code = not in_code
            cur.add(c)
            i += 1
            continue
        }
        if c == "\\" and i + 1 < t.len() and t.slice(i + 1, i + 1) == "|" {
            cur.add("|")
            i += 2
            continue
        }
        if c == "|" and not in_code {
            cells.add(strings.trim(strings.join(cur, "")))
            cur.clear()
            i += 1
            continue
        }
        cur.add(c)
        i += 1
    }
    cells.add(strings.trim(strings.join(cur, "")))
    return cells
}

func align_of(string sep_cell):string {
    var t = strings.trim(sep_cell)
    var left = strings.starts_with(t, ":")
    var right = strings.ends_with(t, ":")
    if left and right { return " style=\"text-align: center;\"" }
    if right { return " style=\"text-align: right;\"" }
    if left { return " style=\"text-align: left;\"" }
    return ""
}

// 从第 i 行（表头）开始渲染表格，返回 HTML（调用方负责推进下标）
func render_table(Array[string] lines, int start, int end):string {
    var head = split_row(lines[start])
    var seps = split_row(lines[start + 1])
    Array[string] tv = []
    var k = 0
    while k < head.len() {
        var al = ""
        if k < seps.len() { al = align_of(seps[k]) }
        tv.add("<th" + al + ">" + inline(head[k]) + "</th>\n")
        k += 1
    }
    Array[string] out = ["<table>\n<thead>\n<tr>\n"]
    out.add(strings.join(tv, ""))
    out.add("</tr>\n</thead>\n<tbody>\n")
    var r = start + 2
    while r < end and not is_blank(lines[r]) and is_table_row(lines[r]) {
        var cells = split_row(lines[r])
        Array[string] tr = []
        var c = 0
        while c < head.len() {
            var al2 = ""
            if c < seps.len() { al2 = align_of(seps[c]) }
            var val = ""
            if c < cells.len() { val = cells[c] }
            tr.add("<td" + al2 + ">" + inline(val) + "</td>\n")
            c += 1
        }
        out.add("<tr>\n" + strings.join(tr, "") + "</tr>\n")
        r += 1
    }
    out.add("</tbody>\n</table>\n")
    return strings.join(out, "")
}

// ---------------------------------------------------------------- 列表

struct ListResult {
    string html = ""
    int next = 0
}

// 去掉行首 n 个空格的缩进（tab 记 4）
func drop_indent(string l, int n):string {
    var i = 0
    var removed = 0
    while i < l.len() and removed < n {
        var c = l.slice(i, i)
        if c == " " {
            removed += 1
            i += 1
        } else if c == "\t" {
            removed += 4
            i += 1
        } else {
            break
        }
    }
    if i == 0 { return l }
    return l.slice(i, l.len() - 1)
}

func indent_of(string l):int {
    var i = 0
    while i < l.len() {
        var c = l.slice(i, i)
        if c == " " { i += 1 }
        else if c == "\t" { i += 4 }
        else { break }
    }
    return i
}

// 从 start 开始解析一个列表（同一缩进、同一种 marker），返回 html 与下一行下标
func render_list(Array[string] lines, int start, int base_indent, bool ordered):ListResult {
    // 项内容先收起来：松散与否（项之间有没有空行）要到**扫完**才知道
    Array[string] item_text = []
    Array[string] item_nested = []
    Array[string] item_prefix = []       // 任务列表的勾选框（普通项是空串）
    var loose = false
    var i = start
    var n = lines.len()
    while i < n {
        var line = lines[i]
        if is_blank(line) {
            // 空行后面还是**同类列表项** ⇒ 这是**松散列表**（CommonMark：项要包 `<p>`），
            //   跳过空行继续扫；否则列表到此结束。
            var j = i
            while j < n and is_blank(lines[j]) { j += 1 }
            if j < n and indent_of(lines[j]) == base_indent and list_marker_len(lines[j]) > 0
               and is_ordered(lines[j]) == ordered {
                loose = true
                i = j
                continue
            }
            break
        }
        var ind = indent_of(line)
        if ind != base_indent or list_marker_len(line) == 0 { break }
        if is_ordered(line) != ordered { break }

        var ml = list_marker_len(line)
        var text = strings.trim_start(line).slice(ml, strings.trim_start(line).len() - 1)
        i += 1

        // 任务列表 `- [ ] 待办` / `- [x] 已办`（GFM 写法）
        var prefix = ""
        if strings.starts_with(text, "[ ] ") {
            prefix = "<input type=\"checkbox\" disabled> "
            text = text.slice(4, text.len() - 1)
        } else if strings.starts_with(text, "[x] ") or strings.starts_with(text, "[X] ") {
            prefix = "<input type=\"checkbox\" disabled checked> "
            text = text.slice(4, text.len() - 1)
        }

        // 续行：缩进更深的普通行（列表项里的第二段）
        while i < n and not is_blank(lines[i]) {
            // ⚠ 围栏代码**不能让列表吞掉**：一旦这里把开围栏收进 `<li>`、而关闭围栏留给外层，
            //   外层的围栏配对就错位 ⇒ 后面整段文档被当成代码块**原样输出**
            //   （实测 module_cstructs 的 `### 线程安全说明` 与整张表格就是这样漏出来的 ✗）
            if is_fence(lines[i]) { break }
            var ind2 = indent_of(lines[i])
            if ind2 <= base_indent { break }
            if list_marker_len(lines[i]) > 0 { break }         // 嵌套列表交给下面单独处理
            // 续行：用**换行**连接，且**保留原缩进**（python-markdown 就是这样：
            //   列表项里的续行缩进会原样进 HTML，见对拍里 `   ```leno` 那一行）
            text = text + "\n" + lines[i]
            i += 1
        }

        // 嵌套列表（缩进更深、且是列表项）
        var nested = ""
        while i < n and not is_blank(lines[i]) and not is_fence(lines[i])
              and indent_of(lines[i]) > base_indent and list_marker_len(lines[i]) > 0 {
            var sub = render_list(lines, i, indent_of(lines[i]), is_ordered(lines[i]))
            nested = nested + sub.html
            i = sub.next
        }
        item_text.add(text)
        item_nested.add(nested)
        item_prefix.add(prefix)
    }

    Array[string] items = []
    var k = 0
    while k < item_text.len() {
        if loose {
            // 松散列表：python-markdown 的形状是 `<li>\n<p>…</p>\n</li>`
            items.add("<li>\n<p>" + item_prefix[k] + inline(item_text[k]) + "</p>\n" + item_nested[k] + "</li>\n")
        } else {
            items.add("<li>" + item_prefix[k] + inline(item_text[k]) + item_nested[k] + "</li>\n")
        }
        k += 1
    }

    var tag = "ul"
    if ordered { tag = "ol" }
    ListResult r = new ListResult()
    r.html = "<" + tag + ">\n" + strings.join(items, "") + "</" + tag + ">\n"
    r.next = i
    return r
}

// ---------------------------------------------------------------- 块级主循环

// ⚠ 参数名不能叫 `to`（保留字，语法错误）；用 end_idx
func render(Array[string] lines, int from, int end_idx):string {
    Array[string] out = []
    var i = from
    while i < end_idx {
        var line = lines[i]
        if is_blank(line) { i += 1; continue }

        // 围栏代码
        if is_fence(line) {
            var tl = strings.trim_start(line)
            var lang = strings.trim(tl.slice(3, tl.len() - 1))
            Array[string] code = []
            i += 1
            while i < end_idx and not is_fence_close(lines[i]) {
                // ⚠ python-markdown 会把代码块里的**纯空白行规范化成空行**，
                //   但非空行的行尾空格**保留**（实测 `a   ` 保留、`   ` 变空）——
                //   不照做的话每段示例里的空行都会多出缩进，和站点对不上。
                if strings.trim(lines[i]) == "" {
                    code.add("")
                } else {
                    code.add(lines[i])
                }
                i += 1
            }
            if i < end_idx { i += 1 }
            var cls = ""
            if lang != "" { cls = " class=\"language-" + lang + "\"" }
            var body = strings.join(code, "\n")
            if body == "" {
                out.add("<pre><code" + cls + "></code></pre>\n")
            } else {
                out.add("<pre><code" + cls + ">" + esc_code(body) + "\n</code></pre>\n")
            }
            continue
        }

        // 缩进代码块（4 空格 / 1 tab）——只在**块首**生效（CommonMark：缩进代码不能打断段落，
        //   所以 `starts_block` 里**不**把它当新块，段落会照常吞掉缩进的续行）
        if indent_of(line) >= 4 {
            Array[string] code4 = []
            while i < end_idx {
                if is_blank(lines[i]) {
                    code4.add("")
                    i += 1
                    continue
                }
                if indent_of(lines[i]) < 4 { break }
                code4.add(drop_indent(lines[i], 4))
                i += 1
            }
            while code4.len() > 0 and code4[code4.len() - 1] == "" {
                code4.remove(code4.len() - 1)
            }
            var body4 = strings.join(code4, "\n")
            if body4 != "" {
                out.add("<pre><code>" + esc_code(body4) + "\n</code></pre>\n")
            }
            continue
        }

        // 标题
        var lvl = heading_level(line)
        if lvl > 0 {
            var raw = ""
            if lvl < line.len() { raw = strings.trim(line.slice(lvl, line.len() - 1)) }
            var id = slug(strip_inline(raw))
            var tagl = _str(lvl)
            out.add("<h" + tagl + " id=\"" + id + "\">" + inline(raw) + "</h" + tagl + ">\n")
            i += 1
            continue
        }

        // 分隔线
        if is_hr(line) {
            out.add("<hr>\n")
            i += 1
            continue
        }

        // 表格
        if strings.starts_with(strings.trim(line), "|") and i + 1 < end_idx and is_table_sep(lines[i + 1]) {
            var stop = i + 2
            while stop < end_idx and not is_blank(lines[stop]) and is_table_row(lines[stop]) { stop += 1 }
            out.add(render_table(lines, i, stop))
            i = stop
            continue
        }

        // 引用
        if is_quote(line) {
            Array[string] inner = []
            while i < end_idx and is_quote(lines[i]) {
                var t = strings.trim_start(lines[i])
                var body2 = t.slice(1, t.len() - 1)
                if strings.starts_with(body2, " ") { body2 = body2.slice(1, body2.len() - 1) }
                inner.add(body2)
                i += 1
            }
            // 懒续行（CommonMark / python-markdown 一致）：紧跟的正文行即使**没写 `>`**，
            //   也属于引用内的最后一段。只吃"纯文本行"—— 标题/围栏/列表/分隔线/表格/新引用
            //   都不算，否则会把后面的块结构吸进引用里。
            while i < end_idx and not is_blank(lines[i])
                  and heading_level(lines[i]) == 0 and not is_fence(lines[i])
                  and not is_hr(lines[i]) and not is_quote(lines[i])
                  and list_marker_len(lines[i]) == 0
                  and not strings.starts_with(strings.trim(lines[i]), "|") {
                inner.add(lines[i])
                i += 1
            }
            out.add("<blockquote>\n" + render(inner, 0, inner.len()) + "</blockquote>\n")
            continue
        }

        // 列表
        if list_marker_len(line) > 0 {
            var res = render_list(lines, i, indent_of(line), is_ordered(line))
            out.add(res.html)
            i = res.next
            continue
        }

        // 原始 HTML 块（`<div ...>` 这类，整段原样透传）
        if strings.starts_with(strings.trim(line), "<") {
            Array[string] raw_html = []
            while i < end_idx and not is_blank(lines[i]) {
                raw_html.add(lines[i])
                i += 1
            }
            out.add(strings.join(raw_html, "\n") + "\n")
            continue
        }

        // 段落：吃掉连续的非块起始行
        Array[string] para = [line]
        i += 1
        while i < end_idx and not starts_block(lines, i) {
            para.add(lines[i])
            i += 1
        }
        // 段落必须**整段 inline**：`**粗体**` / `` `code` `` 可能跨行，
        //   逐行 inline 会把跨行的标记当成普通字符（实测 `**在寄存器式改造中…` 原样漏出来 ✗）
        //   · 行首 0~3 空格先剥掉（4 个才是缩进代码块）
        //   · 行尾两个空格 = 硬换行：先换成哨兵，inline 之后再变 `<br>`（否则会被转义掉）
        Array[string] clean = []
        for para to pl {
            var tline = strip_upto3(pl)
            if strings.ends_with(pl, "  ") { tline = strings.trim_end(tline) + "\u0002" }
            clean.add(tline)
        }
        var phtml = inline(strings.join(clean, "\n"))
        phtml = strings.replace(phtml, "\u0002", "<br>")
        out.add("<p>" + phtml + "</p>\n")
    }
    return strings.join(out, "")
}

export func to_html(string text):string {
    var lines = strings.split(normalize(text), "\n")
    return render(lines, 0, lines.len())
}

func normalize(string text):string {
    var t = text
    if strings.find(t, "\r\n") >= 0 { t = strings.replace(t, "\r\n", "\n") }
    return t
}

// ---------------------------------------------------------------- 标题列表（目录用）

export func headings(string text):Array[Heading] {
    Array[Heading] result = []
    Array[string] seen = []
    var lines = strings.split(normalize(text), "\n")
    var in_fence = false
    var i = 0
    while i < lines.len() {
        var line = lines[i]
        i += 1
        if is_fence(line) {
            in_fence = not in_fence
            continue
        }
        if in_fence { continue }
        var lvl = heading_level(line)
        if lvl == 0 { continue }
        var raw = ""
        if lvl < line.len() { raw = strings.trim(line.slice(lvl, line.len() - 1)) }
        var id = unique_id(seen, slug(strip_inline(raw)))
        seen.add(id)
        Heading h = new Heading()
        h.level = lvl
        h.text = strip_inline(raw)
        h.id = id
        result.add(h)
    }
    return result
}

// 重名锚点：python-markdown 的 toc 用 `_1` / `_2` 后缀
func unique_id(Array[string] seen, string base):string {
    if not contains_str(seen, base) { return base }
    var k = 1
    while contains_str(seen, base + "_" + _str(k)) { k += 1 }
    return base + "_" + _str(k)
}

func contains_str(Array[string] arr, string want):bool {
    for arr to s {
        if s == want { return true }
    }
    return false
}

// ---------------------------------------------------------------- 未支持语法扫描

// 返回**人类可读**的问题列表（空数组 = 全部支持）。
// 用途：构建站点时把"我们没实现、于是被当普通文本输出"的写法**打出来** ——
//   否则缺口是静默的（渲染结果看着像正常文本，没人会发现少了什么）。
// 只报"确定不支持且常见"的几类，宁少勿滥（误报比漏报更烦）。
export func scan_unsupported(string text):Array[string] {
    Array[string] res = []
    var lines = strings.split(normalize(text), "\n")
    var in_fence = false
    var i = 0
    while i < lines.len() {
        var l = lines[i]
        var t = strings.trim(l)
        // `~~~` 完全不被支持（连围栏都不算）⇒ 先单独识别，并把整块跳过
        if strings.starts_with(t, "~~~") {
            res.add(line_msg(i, "`~~~` 围栏（本库只支持 ```）"))
            i += 1
            while i < lines.len() and not strings.starts_with(strings.trim(lines[i]), "~~~") { i += 1 }
            i += 1
            continue
        }
        if is_fence(l) {
            in_fence = not in_fence
            i += 1
            continue
        }
        if not in_fence {
            if link_def(t) {
                res.add(line_msg(i, "引用式链接定义 `[名字]: 地址`（本库只支持行内 `[文字](地址)`）"))
            }
            // `~~x~~` 已支持（<del>），不再告警
            if i > 0 and is_setext_underline(t, lines[i - 1]) {
                res.add(line_msg(i, "下划线式标题（`===`/`---` 在文字下一行；本库只支持 `#` 式）"))
            }
        }
        i += 1
    }
    return res
}

func line_msg(int idx, string what):string {
    return "第 " + _str(idx + 1) + " 行：" + what
}

// `[名字]: 地址`
func link_def(string t):bool {
    if not strings.starts_with(t, "[") { return false }
    var rb = strings.find(t, "]:")
    if rb < 0 { return false }
    return rb > 1
}

// 下划线式标题：整行只有 `=` 或只有 `-`（≥3 个），且**上一行是正文**（空行隔开时是分隔线 ✓）
func is_setext_underline(string t, string prev):bool {
    if t.len() < 3 { return false }
    var c0 = t.slice(0, 0)
    if c0 != "=" and c0 != "-" { return false }
    var k = 0
    while k < t.len() {
        if t.slice(k, k) != c0 { return false }
        k += 1
    }
    if is_blank(prev) { return false }
    if heading_level(prev) > 0 or list_marker_len(prev) > 0 or is_quote(prev) or is_fence(prev) { return false }
    return true
}
