// Validate.leno —— 声明式数据校验（纯 Leno）
//
// 为什么要有：Result 解决了"错误怎么表达"，Config 解决了"配置怎么读"，但"读进来的
//   JSON / 表单 / 环境变量怎么验字段"还是手写一堆 if（必填、类型、范围、长度、枚举、正则）。
//   这里给一套声明式规则，一次校验整个 Dict、把所有错误一次报出来。
//
// 用法：
//   import "Validate" as v
//   use v.(Rule, Schema)
//
//   Schema s = new Schema()
//   s.fields["name"] = new Rule(required = true, minLen = 1, maxLen = 20)
//   s.fields["age"]  = new Rule(required = true, typ = "int", minNum = 0, maxNum = 150)
//   s.fields["role"] = new Rule(oneOf = ["admin", "user"])
//   s.fields["email"] = new Rule(pattern = "^[^@]+@[^@]+$")
//
//   Array[string] errs = v.validate(data, s)
//   if errs.len() == 0 { /* 通过 */ } else { /* 逐条打印 errs */ }
//
// 规则（字段缺省 = 不检查该约束）：
//   required  缺失/显式 null ⇒ 必填错误
//   typ       "string"/"int"/"float"/"number"/"bool"/"array"/"dict"/"any"
//   minNum/maxNum  数值范围（int/float 都认）
//   minLen/maxLen  长度：string 按字符、Array/Dict 按元素数
//   oneOf     字符串枚举（值转字符串比较）
//   pattern   正则（regexs.match，从头部锚定；要全串匹配请自己写 ^…$）
//   check     自定义：func(any): string?，返回 null = 通过、否则错误消息

import strings
import regexs

// ==================== 规则 ====================

export struct Rule {
    bool required = false
    // ★ 2026-11-25：required 只拒"缺失 / 显式 null"，**空串能过**（常见坑）。
    //   要"非空"就加 notEmpty（空串 / 空数组 / 空 Dict 都拒）。
    bool notEmpty = false
    string typ = ""            // "" = 不检查类型
    float? minNum = null       // null = 不检查
    float? maxNum = null
    int minLen = -1            // -1 = 不检查
    int maxLen = -1
    Array[string] oneOf = []   // [] = 不检查枚举
    string pattern = ""        // "" = 不检查正则
    func(any): string? check = null
    // 嵌套：val 是 Dict ⇒ 按 sub 再验一层（错误字段名会拼成 `父.子`）
    Schema? sub = null
    // 数组元素：val 是 Array ⇒ 每个元素按 item 验（错误字段名 `父[i]`）
    Rule? item = null
}

export struct Schema {
    Dict[string, Rule] fields = {}
}

// ==================== 类型工具 ====================

func _typeName(any v): string {
    if v == null { return "null" }
    if v is bool { return "bool" }
    if v is int { return "int" }
    if v is float { return "float" }
    if v is string { return "string" }
    if v is Dict { return "dict" }
    if v is Array { return "array" }
    return "object"
}

func _typeOk(string typ, any v): bool {
    if typ == "string" { return v is string }
    if typ == "int" { return v is int }
    if typ == "float" { return v is float }
    if typ == "number" {
        if v is int { return true }
        if v is float { return true }
        return false
    }
    if typ == "bool" { return v is bool }
    if typ == "array" { return v is Array }
    if typ == "dict" { return v is Dict }
    if typ == "any" { return true }
    return false
}

func _asFloat(any v): float {
    if v is int { return _float(v as int) }
    return v as float
}

// string → 字符数、Array/Dict → 元素数，其它 → -1（不适用）
func _valLen(any v): int {
    if v is string { return (v as string).len() }
    if v is Array { Array a = v as Array; return a.len() }
    if v is Dict { Dict d = v as Dict; return d.len() }
    return -1
}

func _strVal(any v): string {
    if v == null { return "" }
    if v is string { return v as string }
    if v is bool { bool b = v as bool; return if b then "true" else "false" }
    if v is int { return _str(v as int) }
    if v is float { return _str(v as float) }
    return _str(v)
}

func _inList(any v, Array[string] list): bool {
    string s = _strVal(v)
    for list to item { if item == s { return true } }
    return false
}

// ==================== 结构化错误 ====================

// 一条错误：字段路径 + 消息 + 类别。字段路径对嵌套/数组是 `addr.city`、`tags[2]`。
// 为什么要有：只返回 "field: 消息" 字符串时，调用方要**自己拆字段名**才能把错误
//   标到表单控件上（split(":") 一遇到消息里有冒号就错）。
export struct FieldError {
    string field = ""
    string message = ""
    string kind = ""     // required / empty / type / range / len / enum / pattern / check
}

// ==================== 校验 ====================

// prefix 是"父字段路径"（顶层为空串、嵌套是 `addr.`、数组元素是 `tags[2]`）
func _chk(string prefix, string field, any val, bool has, Rule r, Array[FieldError] errs) {
    string full = prefix + field
    if r.required and (not has or val == null) {
        errs.add(new FieldError(field = full, message = "必填", kind = "required"))
        return
    }
    if not has or val == null { return }

    // 非空（空串 / 空数组 / 空 Dict）
    if r.notEmpty {
        bool empty = false
        if val is string { empty = (val as string).len() == 0 }
        else if val is Array { empty = (val as Array).len() == 0 }
        else if val is Dict { empty = (val as Dict).len() == 0 }
        if empty {
            errs.add(new FieldError(field = full, message = "不能为空", kind = "empty"))
            return
        }
    }

    // 类型
    if r.typ != "" and r.typ != "any" {
        if not _typeOk(r.typ, val) {
            errs.add(new FieldError(field = full,
                message = "期望 " + r.typ + "，实际 " + _typeName(val), kind = "type"))
            return
        }
    }

    // 数值范围。★ 2026-11-25：原来"值不是数值就静默跳过" ⇒ 给 string 字段配了
    // minNum 时规则等于没写（错误数据一路放过）。现在明确报错。
    if r.minNum != null or r.maxNum != null {
        if not _typeOk("number", val) {
            errs.add(new FieldError(field = full,
                message = "不是数值，无法比较范围（实际 " + _typeName(val) + "）", kind = "range"))
        } else {
            float f = _asFloat(val)
            if r.minNum != null {
                float mn = r.minNum ?? 0.0
                if f < mn {
                    errs.add(new FieldError(field = full, message = "小于最小值 " + _str(mn), kind = "range"))
                }
            }
            if r.maxNum != null {
                float mx = r.maxNum ?? 0.0
                if f > mx {
                    errs.add(new FieldError(field = full, message = "大于最大值 " + _str(mx), kind = "range"))
                }
            }
        }
    }

    // 长度
    if r.minLen >= 0 or r.maxLen >= 0 {
        int len = _valLen(val)
        if len >= 0 {
            if r.minLen >= 0 and len < r.minLen {
                errs.add(new FieldError(field = full, message = "长度小于 " + _str(r.minLen), kind = "len"))
            }
            if r.maxLen >= 0 and len > r.maxLen {
                errs.add(new FieldError(field = full, message = "长度大于 " + _str(r.maxLen), kind = "len"))
            }
        }
    }

    // 枚举
    if r.oneOf.len() > 0 {
        if not _inList(val, r.oneOf) {
            errs.add(new FieldError(field = full,
                message = "不在允许值内（" + r.oneOf.join(", ") + "）", kind = "enum"))
        }
    }

    // 正则
    if r.pattern != "" {
        if not (val is string) {
            errs.add(new FieldError(field = full, message = "不是字符串，无法正则匹配", kind = "pattern"))
        } else if not regexs.match(val as string, r.pattern) {
            errs.add(new FieldError(field = full, message = "不匹配 " + r.pattern, kind = "pattern"))
        }
    }

    // 自定义
    if r.check != null {
        var msg = r.check(val)
        if msg != null { errs.add(new FieldError(field = full, message = _str(msg), kind = "check")) }
    }

    // 嵌套对象：val 是 Dict ⇒ 逐个子字段再验一层（字段路径拼上 `父.`）
    if r.sub is Schema => sb {
        if val is Dict {
            var subData = val as Dict
            var skeys = sb.fields.keys()
            for skeys to sf {
                Rule sr = sb.fields[_str(sf)]
                bool sh = subData.has(_str(sf))
                var sv = subData.get(_str(sf), null)
                _chk(full + ".", _str(sf), sv, sh, sr, errs)
            }
        }
    }

    // 数组元素：val 是 Array ⇒ 每个元素按 item 验（字段路径拼上 `[i]`）
    if r.item is Rule => ir {
        if val is Array {
            Array arr = val as Array
            for 0 : arr.len() - 1 to i {
                _chk(full + "[" + _str(i) + "]", "", arr[i], true, ir, errs)
            }
        }
    }
}

// 校验整个 Dict，返回**结构化**错误列表（空 = 全部通过）。
// 只检查 schema 里声明的字段，未声明的字段不报错（容忍多余字段）。
export func validateDetailed(Dict[string, any] data, Schema schema): Array[FieldError] {
    Array[FieldError] errs = []
    var keys = schema.fields.keys()
    for keys to field {
        string f = _str(field)
        Rule r = schema.fields[f]
        bool has = data.has(f)
        var val = data.get(f, null)
        _chk("", f, val, has, r, errs)
    }
    return errs
}

// 校验整个 Dict，返回 "字段: 消息" 字符串列表（老接口，保持兼容）。
// 需要按字段定位（表单标红）就用 validateDetailed。
export func validate(Dict[string, any] data, Schema schema): Array[string] {
    Array[string] out = []
    var ds = validateDetailed(data, schema)
    for 0 : ds.len() - 1 to i {
        out.add(ds[i].field + ": " + ds[i].message)
    }
    return out
}

// 校验单值（不涉及必填）：给"只验一个字段"的调用点，返回错误列表（空 = 通过）
export func checkValue(any val, Rule r): Array[string] {
    Array[FieldError] errs = []
    _chk("", "value", val, true, r, errs)
    Array[string] out = []
    for 0 : errs.len() - 1 to i {
        out.add(errs[i].field + ": " + errs[i].message)
    }
    return out
}

// 便捷：错误列表是否为空
export func ok(Array[string] errs): bool { return errs.len() == 0 }
