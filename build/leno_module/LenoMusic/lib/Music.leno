// Music.leno -- LenoMusic entry point
// Streaming audio playback module based on miniaudio
// Usage: import "Music"
//        var s = createSound("song.mp3"); s.play(); ...

import "music_core.leno" as core
import "music_player.leno" as player
import "music_decoder.leno" as decoder
import "music_generator.leno" as gen
import "music_filter.leno" as flt
import "music_sfx.leno" as sfx
import "music_tag.leno" as tagger
import "music_spectrum.leno" as spec

// ==================== Re-export types ====================
use core.miniaudio
use player.(Sound, Engine)
use decoder.Decoder
use gen.(Waveform, Noise)
use flt.(LPF, HPF)
use sfx.Sfx
use tagger.TagInfo
use spec.Spectrum

// ==================== Re-export constants ====================
export var FORMAT_F32 = core.FORMAT_F32
export var FORMAT_S16 = core.FORMAT_S16
export var FORMAT_S24 = core.FORMAT_S24
export var FORMAT_S32 = core.FORMAT_S32
export var FORMAT_U8 = core.FORMAT_U8
export var WAVEFORM_SINE = core.WAVEFORM_SINE
export var WAVEFORM_SQUARE = core.WAVEFORM_SQUARE
export var WAVEFORM_TRIANGLE = core.WAVEFORM_TRIANGLE
export var WAVEFORM_SAWTOOTH = core.WAVEFORM_SAWTOOTH
export var NOISE_WHITE = core.NOISE_WHITE
export var NOISE_PINK = core.NOISE_PINK
export var NOISE_BROWNIAN = core.NOISE_BROWNIAN

// ==================== Core functions ====================
export func init(string dll): bool { return core.init(dll) }
export func uninit() { core.uninit() }
export func getVersion(): int { return core.getVersion() }
export func hasVorbis(): bool { return core.hasVorbis() }

// ==================== Player ====================
export func createSound(string p): Sound { return player.createSound(p) }
export func createEngine(): Engine { return player.createEngine() }
export func quickPlay(string p, int sec): bool { return player.quickPlay(p, sec) }

// ==================== SFX (音效池) ====================
// 预建多实例轮转，避免连续触发同一音效被吞。详见 music_sfx.leno
export func createSfx(string p, int n, float v): Sfx { return sfx.createSfx(p, n, v) }

// ==================== Spectrum（频谱可视化：每帧 update(getPosition())，取 0~1 柱高）====================
// 详见 music_spectrum.leno 顶部说明（旁路解码 + 自写 FFT，不打扰播放线程）
export func createSpectrum(string p, int nBands = 32, int fftSize = 2048): Spectrum {
    return spec.createSpectrum(p, nBands, fftSize)
}

// ==================== Decoder ====================
export func createDecoder(string p): Decoder { return decoder.createDecoder(p) }
export func getInfo(string p) { decoder.getInfo(p) }

// ==================== Tags（音频文件标签：读 / 写封面·歌词·标题·歌手）====================
// 为什么放在本模块：它只跟"音频容器格式"打交道（MP3 的 ID3v2、FLAC 的 VorbisComment/PICTURE），
//   和播放/解码同属音乐域；应用侧不必各自再写一份（详见 music_tag.leno 顶部说明）
//   · 支持 MP3(ID3v2.3) / FLAC(VorbisComment+PICTURE)；其它格式：read 返回 ok=false、write 返回原因
//   · FLAC 有 padding 时**原地只改头部**（55MB 文件 0ms）；没有则整文件重写并顺手留 16KB padding
export func readTag(string p): TagInfo { return tagger.read_tag(p) }
// 写标签：返回 "" = 成功，否则是给用户看的原因
export func writeTag(string p, string title, string artist, string coverPath, string lyricText): string {
    return tagger.write_tag(p, title, artist, coverPath, lyricText)
}

// ==================== Generator ====================
export func createWaveform(int f, int c, int s, int t, float a, float fr): Waveform {
    return gen.createWaveform(f, c, s, t, a, fr)
}
export func createNoise(int f, int c, int t, int s, float a): Noise {
    return gen.createNoise(f, c, t, s, a)
}

// ==================== Filter ====================
export func createLPF(int f, int c, int s, float cf, int o): LPF {
    return flt.createLPF(f, c, s, cf, o)
}
export func createHPF(int f, int c, int s, float cf, int o): HPF {
    return flt.createHPF(f, c, s, cf, o)
}
