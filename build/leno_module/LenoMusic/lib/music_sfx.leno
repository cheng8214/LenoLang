// music_sfx.leno -- 短音效池（基于 LenoMusic 的 Sound）
// 预建多个 Sound 实例轮转，每次播放挑一个空闲实例从头播，
// 解决“连续触发同一音效被吞没”的问题。任何游戏均可复用。
import "music_player.leno" as player
use player.Sound

export struct Sfx {
    Array[Sound] pool
    int idx
    bool ok
    float vol

    // 从同一音频文件预建 n 个实例，统一音量 v
    func setup(string path, int n, float v) {
        pool = []
        ok = false
        vol = v
        for 0 : n - 1 to i {
            Sound s = player.createSound(path)
            if s.ok {
                s.setVolume(v)
                pool.add(s)
                ok = true
            }
        }
        idx = 0
    }

    // 挑一个未在播放的实例从头播；全在播则轮转到下一个
    func play() {
        if not ok { return }
        int cnt = pool.len()
        if cnt == 0 { return }
        int chosen = -1
        int i = 0
        while i < cnt {
            int j = idx + 1 + i
            if j >= cnt { j = j - cnt }
            if not pool[j].isPlaying() { chosen = j; break }
            i = i + 1
        }
        if chosen == -1 {
            idx = idx + 1
            if idx >= cnt { idx = 0 }
            chosen = idx
        } else {
            idx = chosen
        }
        pool[chosen].stop()
        pool[chosen].seek(0)
        pool[chosen].play()
    }

    // 运行时调整音量（同步到池内所有实例）
    func setVolume(float v) {
        vol = v
        for 0 : pool.len() - 1 to i {
            if pool[i].ok { pool[i].setVolume(v) }
        }
    }

    func uninit() {
        if pool.len() > 0 {
            for 0 : pool.len() - 1 to i {
                pool[i].uninit()
            }
        }
        pool = []
    }
}

// 工厂：一步创建并初始化音效池
export func createSfx(string path, int n, float v): Sfx {
    Sfx s = new Sfx()
    s.setup(path, n, v)
    return s
}
