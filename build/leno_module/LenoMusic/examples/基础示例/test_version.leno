// test_version.leno -- 基础示例: 版本信息与 DLL 加载检测
import "Music" as audio
import files

main() {
    print("=== LenoMusic 版本信息 ===")

    // 检查库文件是否能找到（2026-11-19 起库文件按平台分目录存放：lib/win、lib/linux）
    string libRel = "../../lib/linux/miniaudio.so"
    if _os() == "windows" { libRel = "../../lib/win/miniaudio.dll" }
    bool found = files.exists(libRel)
    print("库文件 " + libRel + " 存在: " + _str(found))

    int ver = audio.getVersion()
    print("miniaudio 版本: " + _str(ver))

    bool vorbis = audio.hasVorbis()
    print("Vorbis 解码支持: " + _str(vorbis))

    print("\n=== 测试完成 ===")
}
