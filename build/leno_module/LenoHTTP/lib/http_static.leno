// http_static.leno -- 静态文件（纯 Leno）
//
// 安全要点：**必须先挡目录穿越**再拼路径
//   requested "/assets/../../secret.txt" ⇒ 归一化后可能跳出根目录 ⇒ 一律 403。
//   这里用"拒绝任何 .. 段"的保守策略（不做 realpath 归一化：那需要目录遍历，
//   而且在 Windows 上符号链接/短路径还有别的花样；静态站点用不到 ..）。
import files
import dirs
import strings
import "MIME" as mime

// 静态资源的 Content-Type。
//   · 扩展名表统一交给 LenoMIME（原先本文件手写了一份，LenoMusic 里还有另一份 ⇒ 改一处漏一处）
//   · 文本类补 `charset=utf-8`：不写的话浏览器按 latin-1 猜，中文直接乱码
//   · 认不出 ⇒ `application/octet-stream`（HTTP 语义：让浏览器下载或交给外部程序）
export func content_type(string path): string {
    string m = mime.byExt(path)
    if m == "" { return "application/octet-stream" }
    if m == "text/html" or m == "text/css" or m == "text/javascript"
        or m == "text/plain" or m == "text/markdown" or m == "text/csv"
        or m == "application/json" or m == "application/xml" {
        return m + "; charset=utf-8"
    }
    return m
}

func has_dotdot(string rel): bool {
    // 按 / 与 \ 切段，任何一段等于 ".." 就拒绝
    Array[int] bs = rel.to_bytes()
    var start = 0
    var i = 0
    while i <= bs.len() {
        if i == bs.len() or bs[i] == 47 or bs[i] == 92 {
            int segLen = i - start
            if segLen == 2 and bs[start] == 46 and bs[start + 1] == 46 { return true }
            start = i + 1
        }
        i = i + 1
    }
    return false
}

// 只算元信息（**不读内容**）—— 大文件靠它决定要不要分块发（2026-10-21）
// 返回 {found, path, ctype, size, mtime, etag, err}
export func meta(string root, string rel): Dict {
    if has_dotdot(rel) {
        return {found: false, path: "", ctype: "", size: 0, mtime: 0, etag: "", err: "403"}
    }
    var sub = rel
    if strings.starts_with(sub, "/") { sub = sub.byte_slice(1, sub.byte_len() - 1) }
    if sub == "" or strings.ends_with(sub, "/") { sub = sub + "index.html" }
    // 统一用 / 拼（dirs.join 在 Windows 上给 \，files 两种都认）
    string full = dirs.join(root, sub)
    if not files.exists(full) {
        return {found: false, path: "", ctype: "", size: 0, mtime: 0, etag: "", err: "404"}
    }

    // ETag = size-mtime：文件一改，mtime 必变 ⇒ 指纹必变；比每次读一遍算哈希便宜得多
    //   ⚠ 不发 Last-Modified：HTTP 要 GMT，而 times.format 是本地时区 ⇒ 宁可不发也不发错
    var st = dirs.stat(full)
    int size = st.size
    int mtime = st.mtime
    string etag = "\"" + _str(size) + "-" + _str(mtime) + "\""
    return {found: true, path: full, ctype: content_type(sub),
            size: size, mtime: mtime, etag: etag, err: ""}
}

// rel 形如 "/a/b.txt" 或 "/"（目录）；小文件走它（整读，能享受 gzip）
export func serve(string root, string rel): Dict {
    var m = meta(root, rel)
    if not (m["found"] as bool) {
        return {found: false, data: "", ctype: "", size: 0, mtime: 0, etag: "", err: m["err"]}
    }
    var data = ""
    try {
        data = files.read(m["path"] as string)
    } catch ex {
        return {found: false, data: "", ctype: "", size: 0, mtime: 0, etag: "", err: "读取失败"}
    }
    return {found: true, data: data, ctype: m["ctype"] as string,
            size: m["size"] as int, mtime: m["mtime"] as int,
            etag: m["etag"] as string, err: ""}
}
