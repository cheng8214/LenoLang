// http_server.leno -- 监听 / 收请求 / 发响应（纯 Leno，基于内置 sockets）
//
// 并发模型（0.2，2026-10-20 起）：
//   · `run/serve` —— 单线程顺序处理（保持原样，适合低流量/调试）
//   · `serve_workers/worker_loop` —— **线程池**：主线程只做 accept，把连接 fd 交给
//     worker 线程处理（`sock.detach()` → Channel[int] → `sockets.from_fd()`）。
//
//     `Socket` 对象仍不能跨线程（它在创建者的 GC 堆上），但 **fd 是整数**：
//     `detach()` 交出所有权（原对象立刻失效，不会 double close），
//     worker 侧 `from_fd(fd)` 在自己的堆上重建 ⇒ 每连接一线程在本语言里是可行的 ✓
//
//   ⚠ handler 是闭包，闭包同样不能跨线程 ⇒ **app 必须在 worker 线程内构建**
//     （`buildApp()` 里注册的路由只存在于那一个线程的堆上）。见 `worker_loop` 注释。
//
// 已对 sockets 做的修复（本模块的副产品）：
//   `sock.send()` 原来是单次 send + 忽略返回值 ⇒ 大响应被**静默截断**
//   （实测 1MB 文件客户端只收到前几十 KB）。现在改成循环发完（EINTR/EWOULDBLOCK 重试）
import sockets
import strings
import files
import times     // 2026-10-20：慢速连接的整体截止时间（单线程服务必须有个上界）
import threads   // 线程池（serve_workers / worker_loop）
import "http_parse.leno" as p
import "http_app.leno" as appmod
// gzip 响应（2026-10-18）：压缩端在 LenoCompress（纯 Leno 的 DEFLATE）
import "Compress" as z

var MAX_HEADER = 65536
var MAX_BODY = 8388608          // 8MB（v0.1 整包读进内存）
var MAX_REQ_PER_CONN = 100
// ★ 2026-10-20：**整个请求**的读入截止时间（秒）
//   为什么不能只靠 socket 的 5s 收包超时：慢速客户端可以每 4.9s 送一个字节，
//   单个 recv 永远不超时 ⇒ 单线程服务被**一个连接**卡死（slowloris）✗
var MAX_REQ_SECONDS = 10

// ==================== 监听 ====================
// 返回 {ok, sock, host, port, err}；端口传 0 由系统分配（测试用）
export func listen(string host, int port): Dict {
    Socket s = sockets.listen(host, port)
    if s == null {
        return {ok: false, sock: null, host: host, port: port,
                err: "监听失败（端口被占用 / 无权限 / 地址不可用）：" + host + ":" + _str(port)}
    }
    s.set_nonblocking(true)      // 让 accept 可被 select 驱动，便于 stop()
    return {ok: true, sock: s, host: host, port: s.local_port(), err: ""}
}

// ==================== 单个连接 ====================
func _status_text(int code): string {
    if code == 200 { return "OK" }
    if code == 201 { return "Created" }
    if code == 204 { return "No Content" }
    if code == 301 { return "Moved Permanently" }
    if code == 302 { return "Found" }
    if code == 304 { return "Not Modified" }
    if code == 400 { return "Bad Request" }
    // ★ 2026-10-20：原来缺 401/409/429/502/503 ⇒ 全被兜成 "OK"
    //   （实测写鉴权接口时发出 `HTTP/1.1 401 OK`，客户端/日志都很别扭）
    if code == 401 { return "Unauthorized" }
    if code == 403 { return "Forbidden" }
    if code == 404 { return "Not Found" }
    if code == 405 { return "Method Not Allowed" }
    if code == 409 { return "Conflict" }
    if code == 413 { return "Payload Too Large" }
    if code == 422 { return "Unprocessable Entity" }
    if code == 429 { return "Too Many Requests" }
    if code == 500 { return "Internal Server Error" }
    if code == 502 { return "Bad Gateway" }
    if code == 503 { return "Service Unavailable" }
    // 兜底：按类别给一个不会说谎的短语（别再把 4xx 说成 OK）
    if code >= 500 { return "Server Error" }
    if code >= 400 { return "Client Error" }
    return "OK"
}

func _put(Array[int] out, string s) {
    for s.to_bytes() to b { out.add(b) }
}

// 这个 Content-Type 值不值得压（图片/压缩包再压一遍纯属浪费 CPU）
func _compressible(string ct): bool {
    string c = ct.to_lower()
    if strings.has(c, "text/") { return true }
    if strings.has(c, "json") { return true }
    if strings.has(c, "javascript") { return true }
    if strings.has(c, "xml") { return true }
    if strings.has(c, "svg") { return true }
    return false
}

// acceptGzip：调用方按请求的 Accept-Encoding 传（不看请求头就不压 —— 有些老客户端不认）
//   判据三条：客户端要 gzip、体积 ≥ 1KB、类型可压，且响应**没自带** Content-Encoding
//   ⚠ Content-Length 必须写**压缩后**的长度（写错浏览器会一直等，表现为"页面转圈"✗）
func _write_response(Socket c, Dict res, bool keep, bool acceptGzip): bool {
    int st = res["status"] as int
    string ct = res["contentType"] as string
    Dict hs = res["headers"] as Dict

    // ★ 2026-10-21：大文件 / Range 走**分块发送**（res 带 file / offset / length）
    //   为什么不在 dispatch 里读完整文件：1MB 以上会同时存在"文件字符串 + Array[int] 逐字节副本"
    //   （原实现 `for body.to_bytes() to b { out.add(b) }`）⇒ 内存峰值约 2 倍文件大小，
    //   几个并发下载就能把进程顶满 ✗
    //   ⚠ 分块路径**不做 gzip**：流式压缩要边读边压，成本远高于收益（大文件多是图片/视频，本来不可压）
    if res.has("file") {
        string fpath = res["file"] as string
        int offset = res["offset"] as int
        int length = res["length"] as int

        Array[int] hout = []
        _put(hout, "HTTP/1.1 " + _str(st) + " " + _status_text(st) + "\r\n")
        _put(hout, "Content-Type: " + ct + "\r\n")
        _put(hout, "Content-Length: " + _str(length) + "\r\n")
        _put(hout, "Connection: " + (if keep then "keep-alive" else "close") + "\r\n")
        for hs.keys() to hk {
            var hv = hs.get(hk, "")
            if hv is Array {
                for (hv as Array[string]) to hline {
                    _put(hout, _str(hk) + ": " + hline + "\r\n")
                }
            } else {
                _put(hout, _str(hk) + ": " + _str(hv) + "\r\n")
            }
        }
        _put(hout, "\r\n")
        if not c.send(strings.from_bytes(hout)) { return false }

        // ⚠ 必须 **"rb"**：文本模式在 Windows 上会把 `\r\n` 折成 `\n` ⇒ 图片/压缩包会被改坏
        var f = files.open(fpath, "rb")
        if f == null { return false }
        f.seek(offset)
        var left = length
        while left > 0 {
            var want = 65536
            if left < want { want = left }
            var chunk = f.read(want)
            if chunk == "" { break }
            int n = chunk.byte_len()
            if not c.send(chunk) { f.close(); return false }
            left = left - n
            if n < want { break }
        }
        f.close()
        return true
    }

    var body = res["body"] as string
    var gz = false
    if acceptGzip and not hs.has("Content-Encoding") and body.byte_len() >= 1024 and _compressible(ct) {
        var packed = z.gzip(body)
        if packed.byte_len() < body.byte_len() {
            body = packed
            gz = true
        }
    }
    Array[int] out = []
    _put(out, "HTTP/1.1 " + _str(st) + " " + _status_text(st) + "\r\n")
    _put(out, "Content-Type: " + ct + "\r\n")
    _put(out, "Content-Length: " + _str(body.byte_len()) + "\r\n")
    _put(out, "Connection: " + (if keep then "keep-alive" else "close") + "\r\n")
    if gz {
        _put(out, "Content-Encoding: gzip\r\n")
        _put(out, "Vary: Accept-Encoding\r\n")
    }
    for hs.keys() to k {
        var hv = hs.get(k, "")
        // 2026-10-20：值可以是 Array[string] ⇒ 逐行写（多枚 Set-Cookie 要各占一行 ✓）
        if hv is Array {
            for (hv as Array[string]) to line {
                _put(out, k + ": " + line + "\r\n")
            }
        } else {
            _put(out, k + ": " + _str(hv) + "\r\n")
        }
    }
    _put(out, "\r\n")
    for body.to_bytes() to b { out.add(b) }
    return c.send(strings.from_bytes(out))
}

// 读一个完整请求（含请求体）。carry = 上个请求多读到的字节。
// 返回 {ok, req, rest, err}；对端关闭/超时 ⇒ ok=false 且 err=""（正常收尾，不报错）
func _read_request(Socket c, string carry): Dict {
    var buf = carry
    int t_start = _int(times.now())
    var he = p.header_end(buf)
    while he < 0 {
        // ★ 只靠 recv 的 5s 超时挡不住"每 4.9s 送一个字节"：单个 recv 永远不超时 ✗
        //   ⇒ 用 select 等"剩余时间"，到点就放弃（单线程服务不能被一个连接占死）
        int remain = MAX_REQ_SECONDS - (_int(times.now()) - t_start);
        if remain <= 0 {
            return {ok: false, req: null, rest: "", err: "读请求头超时（慢速连接占用 " + _str(MAX_REQ_SECONDS) + "s）"}
        }
        var ready = sockets.select([c], remain * 1000)
        if ready.len() == 0 {
            return {ok: false, req: null, rest: "", err: "读请求头超时（慢速连接占用 " + _str(MAX_REQ_SECONDS) + "s）"}
        }
        var chunk = c.recv(65536)
        if chunk == null { return {ok: false, req: null, rest: "", err: ""} }
        string s = chunk as string
        if s.byte_len() == 0 { return {ok: false, req: null, rest: "", err: ""} }
        buf = buf + s
        if buf.byte_len() > MAX_HEADER {
            return {ok: false, req: null, rest: "", err: "请求头超过 " + _str(MAX_HEADER) + " 字节"}
        }
        he = p.header_end(buf)
    }

    string head = buf.byte_slice(0, he - 5)          // 去掉尾部 \r\n\r\n
    var rest = ""
    if he <= buf.byte_len() - 1 { rest = buf.byte_slice(he, buf.byte_len() - 1) }

    Array[string] lines = p.split(head, "\r\n")
    if lines.len() == 0 { return {ok: false, req: null, rest: "", err: "空请求"} }
    Array[string] rl = p.split_request_line(lines[0])
    if rl.len() < 3 { return {ok: false, req: null, rest: "", err: "请求行不完整"} }

    string method = rl[0].to_upper()
    string target = rl[1]
    string version = rl[2]

    Array[string] headers = []
    for 1:lines.len()-1 to i { headers.add(lines[i]) }
    Dict h = p.parse_headers(headers)

    Array[string] pt = p.split_target(target)
    string path = p.url_decode(pt[0], false)
    Dict query = p.parse_kv(pt[1])

    // 请求体：按 Content-Length 补齐（chunked 不支持）
    var clen = 0
    if h.has("content-length") { clen = _int(h.get("content-length", "0")) }
    if clen > MAX_BODY {
        return {ok: false, req: null, rest: "", err: "请求体超过 " + _str(MAX_BODY) + " 字节"}
    }
    var raw = rest
    while raw.byte_len() < clen {
        int remain = MAX_REQ_SECONDS - (_int(times.now()) - t_start);
        if remain <= 0 {
            return {ok: false, req: null, rest: "", err: "读请求体超时（慢速连接占用 " + _str(MAX_REQ_SECONDS) + "s）"}
        }
        var ready = sockets.select([c], remain * 1000)
        if ready.len() == 0 {
            return {ok: false, req: null, rest: "", err: "读请求体超时（慢速连接占用 " + _str(MAX_REQ_SECONDS) + "s）"}
        }
        var chunk = c.recv(65536)
        if chunk == null { break }
        raw = raw + (chunk as string)
    }
    var body = ""
    if clen > 0 and raw.byte_len() >= clen { body = raw.byte_slice(0, clen - 1) }
    else if raw.byte_len() > 0 { body = raw }
    var leftover = ""
    if raw.byte_len() > clen { leftover = raw.byte_slice(clen, raw.byte_len() - 1) }

    // 表单：只在 urlencoded 时解析（multipart 见 README 的边界）
    Dict form = {}
    if h.has("content-type") {
        string ct = h.get("content-type", "") as string
        if p.find(ct.to_lower(), "application/x-www-form-urlencoded", 0) >= 0 {
            form = p.parse_kv(body)
        }
    }

    // keep-alive：HTTP/1.1 默认保持（除非 Connection: close）；HTTP/1.0 默认关闭
    string conn = ""
    if h.has("connection") { conn = (h.get("connection", "") as string).to_lower() }
    var keep = false
    if version == "HTTP/1.1" and conn != "close" { keep = true }
    if version == "HTTP/1.0" and conn == "keep-alive" { keep = true }

    Dict req = {
        method: method,
        target: target,
        path: path,
        query: query,
        headers: h,
        body: body,
        form: form,
        version: version,
        keepAlive: keep,
        remote: c.peer_addr() + ":" + _str(c.peer_port())
    }
    return {ok: true, req: req, rest: leftover, err: ""}
}

// 处理一个已接受的连接（含 keep-alive 的多次请求）
export func handle_conn(Socket c, Dict app): Dict {
    // ⚠ 两个坑（实测踩出来的）：
    //   ① **accept 出来的 socket 会继承监听端的 nonblocking**（Windows 尤其明显）⇒
    //      若不显式关掉，recv 在"数据还没到"时立刻返回 null，keep-alive 的第二个请求
    //      会被误判成"对端关闭"（症状：第一个请求正常，第二个永远收不到 ✗）。
    //   ② 必须先转回阻塞再设超时，顺序反了超时也不生效。
    var count = 0
    // ★ 2026-10-20：整个连接处理兜一层 —— 读/写/静态文件任何一步抛异常，
    //   都只应断掉**这一个连接**，不能让 accept 循环（整个服务）跟着退出 ✗
    try {
    c.set_nonblocking(false)
    c.set_timeout(5000)          // 5s 收包超时：防慢速连接长期占着
    var carry = ""
    while count < MAX_REQ_PER_CONN {
        var rr = _read_request(c, carry)
        if not (rr["ok"] as bool) {
            string e = rr["err"] as string
            if app.has("debug") and e != "" { print("[http] 读请求失败：" + e) }
            if e != "" {
                _write_response(c, appmod.status(400, "400 Bad Request：" + e), false, false)
            }
            break
        }
        Dict req = rr["req"] as Dict
        carry = rr["rest"] as string
        Dict res = appmod.dispatch(app, req)
        // gzip 协商：只有客户端声明要 gzip 才压（不看请求头就不压）
        var ae = ""
        Dict hhs = req["headers"] as Dict
        if hhs.has("accept-encoding") { ae = (hhs.get("accept-encoding", "") as string).to_lower() }
        bool acceptGzip = strings.has(ae, "gzip")
        bool keep = (req["keepAlive"] as bool) and count < MAX_REQ_PER_CONN - 1
        if app.has("debug") {
            print("[http] " + (req["method"] as string) + " " + (req["target"] as string)
                + " -> " + _str(res["status"] as int) + " keep=" + _str(keep)
                + " carry=" + _str(carry.byte_len()))
        }
        if not _write_response(c, res, keep, acceptGzip) {
            if app.has("debug") { print("[http] send 失败（连接被对端关闭？）") }
            break
        }
        count = count + 1
        if not keep { break }
    }
    } catch e {
        print("[http] 连接处理异常（只断这一个连接）：" + e + "\n")
    }
    c.close()
    return {ok: true, requests: count, err: ""}
}

// 接受一个连接并处理（测试/自定义循环用）
//   ★ 2026-10-20：监听器在 `listen` 里被设成**非阻塞**（便于 stop()），
//     所以这里**必须先 select 等可读**再 accept —— 否则客户端稍晚一点连上来，
//     `accept()` 会立刻返回 null，调用方以为"处理完了"，实际连接还躺在 backlog 里 ✗
//     （实测：测试里刚 `threads.start` 起客户端就调 acceptOne，客户端会一直卡在 recv）
export func accept_one(Dict server, Dict app, int timeout_ms = 5000): Dict {
    Socket srv = server["sock"] as Socket
    var ready = sockets.select([srv], timeout_ms)
    if ready.len() == 0 { return {ok: false, requests: 0, err: "等待连接超时"} }
    Socket c = srv.accept()
    if c == null { return {ok: false, requests: 0, err: "accept 失败"} }
    return handle_conn(c, app)
}

// 在**已有的监听器**上跑主循环（测试/自定义启动流程用，避免二次 bind）
export func run(Dict server, Dict app): Dict {
    Socket srv = server["sock"] as Socket
    app.set("running", true)
    while app["running"] as bool {
        var ready = sockets.select([srv], 200)
        if ready.len() == 0 { continue }
        var c = srv.accept()
        if c == null { continue }
        handle_conn(c, app)
    }
    srv.close()
    return {ok: true, requests: 0, err: ""}
}

// 阻塞式主循环（真正对外服务用）。app 里 running=false 或 http.stop(app) 可退出。
export func serve(Dict app, string host, int port): Dict {
    var server = listen(host, port)
    if not (server["ok"] as bool) { return server }
    return run(server, app)
}

// ==================== 线程池（多线程并发处理连接）====================
//
// 为什么必须"每线程自己建 app"：
//   `threads.start` 的**入口闭包**会被重建（upvalue 重新克隆），但**实参**走
//   `value_clone_for_channel`，其白名单是 标量/string/Array/Dict/struct/Channel ——
//   `OBJ_CLOSURE` / `OBJ_FUNCTION` 会被明确拒绝（跨堆引用会 double-free）。
//   路由表里存的正是 handler 闭包 ⇒ app 不能从主线程传进来 ✗
//   ⇒ 约定：worker 入口函数内部调 `buildApp()`，路由只建在本线程堆上 ✓
//
// 用法（worker 必须是**具名模块函数**，arity 恰好 2）：
//
//   func buildApp(): Dict { var app = http.newApp(); http.get(app, "/", h); return app }
//   func worker(int idx, Channel conns) { http.workerLoop(buildApp(), conns) }
//   main() { http.serveWorkers(app, "0.0.0.0", 8080, 8, worker) }
//
// ⚠ 共享状态：**模块级 `var` 是所有线程同一份且无锁**（`ObjModule.globals` 进程级共享）。
//   计数/缓存/session 表这类可变状态不要直接写，改用 Channel 汇到单点线程处理。

// worker 侧的消费循环：从 Channel 拿 fd → 重建 Socket → 处理 → close（handle_conn 负责）
// 返回本线程处理过的连接数（join 时汇总）
export func worker_loop(Dict app, Channel conns): int {
    var handled = 0
    while true {
        var v = conns.receive()
        if v == null { break }              // 通道被关闭
        int fd = _int(v)
        if fd < 0 { break }                 // 收工信号
        Socket c = sockets.from_fd(fd)
        if c == null { continue }           // fd 已被对端关掉 / 重建失败
        var t0 = times.ms()
        handle_conn(c, app)                 // 内部 try/catch + close（只断这一个连接）
        if app.has("debug") {
            print("[http] worker 处理完 fd " + _str(fd) + "（" + _str(times.ms() - t0) + "ms）")
        }
        handled = handled + 1
    }
    return handled
}

// 线程池主循环：主线程只 accept + 交接 fd，业务全在 worker 里跑。
//   app      —— 主线程那一份（只用它的 running 做退出开关、debug 打日志）
//   workers  —— worker 线程数（建议 = CPU 核数；I/O 重可适当放大）
//   entry    —— worker 入口，签名固定为 `func(int idx, Channel conns)`
//   queue    —— 待处理连接队列长度（默认 workers*4）；满了直接回 503，**不让 accept 阻塞**
//   maxConns —— 处理满 N 个连接就自动收工（0 = 不限；测试/一次性服务用）
// 返回 {ok, requests（worker 处理总数）, accepted, dropped, err}
export func serve_workers(Dict app, string host, int port, int workers, any entry,
                          int queue = 0, int maxConns = 0): Dict {
    var server = listen(host, port)
    if not (server["ok"] as bool) { return server }
    Socket srv = server["sock"] as Socket

    if workers < 1 { workers = 1 }
    if queue < 1 { queue = workers * 4 }

    var conns = threads.channel(queue)
    Array[Thread] ts = []
    for workers to i {
        var t = threads.start(entry, i, conns)
        if t == null { break }
        ts.add(t)
    }
    if ts.len() == 0 {
        srv.close()
        return {ok: false, requests: 0, accepted: 0, dropped: 0,
                err: "worker 线程一个都没起来（检查入口函数签名 func(int, Channel)）"}
    }

    var accepted = 0
    var dropped = 0
    app.set("running", true)
    while app["running"] as bool {
        if maxConns > 0 and accepted >= maxConns { break }
        var ready = sockets.select([srv], 200)
        if ready.len() == 0 { continue }
        var c = srv.accept()
        if c == null { continue }
        // ★ 交出 fd 所有权：原 Socket 立刻失效（GC 之后不会重复 close）
        int fd = c.detach()
        if fd < 0 { continue }
        if not conns.try_send(fd) {
            // 队列满 = 已经过载：立刻回 503 关掉，避免主线程被 send 阻塞住 accept
            Socket tmp = sockets.from_fd(fd)
            if tmp != null {
                _write_response(tmp, appmod.status(503, "503 Service Unavailable（连接队列已满）"), false, false)
                tmp.close()
            }
            dropped = dropped + 1
            continue
        }
        accepted = accepted + 1
    }

    // 收工：每个 worker 一个 -1（Channel 里可能还压着未处理的 fd，先让它们跑完）
    for ts.len() to i { conns.send(-1) }
    var handled = 0
    for ts to t { handled = handled + _int(t.join()) }
    return {ok: true, requests: handled, accepted: accepted, dropped: dropped, err: ""}
}
