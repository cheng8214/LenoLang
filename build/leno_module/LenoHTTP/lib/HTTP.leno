// HTTP.leno -- LenoHTTP entry point（纯 Leno，零原生依赖）
//
// 用法（阻塞式服务）：
//   import "HTTP" as http
//
//   var app = http.newApp()
//   http.get(app, "/", func(Dict req): Dict { return http.text("hello") })
//   http.get(app, "/echo", func(Dict req): Dict {
//       return http.json({"q": req["query"]["q"]})
//   })
//   http.static(app, "/assets", "D:/www")
//   http.serve(app, "0.0.0.0", 8080)
//
// 请求 Dict：{method, target, path, query, headers, body, form, version, keepAlive, remote}
// 响应 Dict：{status, body, contentType, headers}（handler 也可以直接返回 string）
//
// 边界（v0.1）：
//   · **单线程顺序处理**：Socket 不能跨线程（threads.start 只允许标量/string/Array/Dict/
//     struct/Channel）⇒ 无法"每连接一个线程"；慢客户端会占住后续连接
//   · 不做 chunked 请求体 / multipart / WebSocket / HTTP/2 / TLS
//   · 请求体上限 8MB、请求头上限 64KB、单连接最多 100 个请求（keep-alive）
//   · 静态文件整读进内存（大文件下载请用反向代理或自己流式发）
import "http_app.leno" as a
import "http_server.leno" as srv

// ==================== 应用与路由 ====================
export func newApp(): Dict { return a.new_app() }
// 第 4 参 opts = 声明式元数据（目前支持 `{auth: true}`），见下方「鉴权 / 中间件」
export func get(Dict app, string path, any handler, any opts = null): void { a.get(app, path, handler, opts) }
export func post(Dict app, string path, any handler, any opts = null): void { a.post(app, path, handler, opts) }
export func put(Dict app, string path, any handler, any opts = null): void { a.put(app, path, handler, opts) }
export func del(Dict app, string path, any handler, any opts = null): void { a.del(app, path, handler, opts) }
export func route(Dict app, string method, string path, any handler, any opts = null): void {
    a.route(app, method, path, handler, opts)
}
export func static(Dict app, string prefix, string dir): void { a.static(app, prefix, dir) }
export func stop(Dict app): void { a.stop(app) }

// ==================== 鉴权 / 中间件（2026-10-20）====================
// 声明式：路由注册第 4 参 `{auth: true}` 表示需要鉴权（等价 C# 的 [Authorize]）
//   http.auth(app, func(Dict req): string { ... })   注册唯一的检查器（返回用户名 / ""）
//   http.get(app, "/api/x", h, {auth: true})         该路由需要登录
//   handler 里 `req["user"] as string` 拿用户名
export func auth(Dict app, any fn): void { a.auth(app, fn) }

// 管道式：全局中间件，fn(req) 返回 null = 放行，返回响应 Dict = 短路
//   适合访问日志 / 耗时 / CORS / 维护模式；鉴权请用 {auth: true}
//   ⚠ 不叫 `use`（保留字），对外名字是 `before`
export func before(Dict app, any fn): void { a.before(app, fn) }

// 带状态码的 JSON（http.json 固定 200）
export func jsonStatus(int code, any obj): Dict { return a.json_status(code, obj) }

// ==================== 响应助手 ====================
export func text(string s): Dict { return a.text(s) }
export func html(string s): Dict { return a.html(s) }
export func json(any obj): Dict { return a.json(obj) }
export func bytes(string s, string ctype): Dict { return a.bytes(s, ctype) }
export func status(int code, string body): Dict { return a.status(code, body) }
export func redirect(string url, int code = 302): Dict { return a.redirect(url, code) }
export func notFound(): Dict { return a.not_found() }

// ==================== HTML 转义 / 模板（2026-10-18）====================
// `{{name}}` 转义输出（默认安全）、`{{{name}}}` 原样输出；缺键给空串
export func esc(string s): string { return a.esc(s) }
export func render(string tpl, Dict vars): string { return a.render(tpl, vars) }
export func htmlTemplate(string tpl, Dict vars): Dict { return a.html_template(tpl, vars) }

// ==================== 请求取值助手（2026-10-20）====================
// 以前取一个参数要四行（`req["query"] as Dict` + has + get + as string），现在一行：
//   var name = http.query(req, "name", "默认")
// 缺键 / 空串 ⇒ 默认值
export func query(Dict req, string name, string def = ""): string { return a.query(req, name, def) }
export func formValue(Dict req, string name, string def = ""): string { return a.form(req, name, def) }
export func header(Dict req, string name, string def = ""): string { return a.header(req, name, def) }

// ==================== 视图文件（2026-10-20）====================
//   http.views(app, "views")            —— 指定目录
//   http.view(app, "hello", {x: 1})     —— 渲染 views/hello.html，自动套 views/layout.html
//   layout.html 里用 `{{{body}}}` 插入页面内容
export func views(Dict app, string dir): void { a.views(app, dir) }
export func view(Dict app, string name, Dict vars): Dict { return a.view(app, name, vars) }

// ==================== Cookie（2026-10-20）====================
// `cookie(req, "sid", "")` 读；`setCookie(res, "sid", tok, "/", 0)` 写（0 = 会话 cookie）
export func cookie(Dict req, string name, string def = ""): string { return a.cookie(req, name, def) }
export func setCookie(Dict res, string name, string value, string path = "/", int maxAge = 0): Dict {
    return a.set_cookie(res, name, value, path, maxAge)
}
export func clearCookie(Dict res, string name): Dict { return a.clear_cookie(res, name) }

// ==================== 服务 ====================
// {ok, sock, host, port, err} —— 端口传 0 由系统分配（测试/临时服务常用）
export func listen(string host, int port): Dict { return srv.listen(host, port) }

// 等一个连接并处理（含 keep-alive）；timeout_ms 默认 5s
export func acceptOne(Dict server, Dict app, int timeout_ms = 5000): Dict {
    return srv.accept_one(server, app, timeout_ms)
}

// 在已有监听器上跑主循环（listen 之后用；避免 serve 再 bind 一次）
export func run(Dict server, Dict app): Dict { return srv.run(server, app) }

// 阻塞式主循环，直到 http.stop(app)
export func serve(Dict app, string host, int port): Dict { return srv.serve(app, host, port) }

// 便捷：只给端口（监听 127.0.0.1 之外的所有网卡用 "0.0.0.0"）
export func serveOn(Dict app, int port): Dict { return srv.serve(app, "0.0.0.0", port) }

// ==================== 线程池（多线程并发）====================
// entry 必须形如 `func worker(int idx, Channel conns)`，且是**具名模块函数**；
// 里面要自己 buildApp()（handler 闭包不能跨线程传），再调 http.workerLoop(app, conns)。
export func serveWorkers(Dict app, string host, int port, int workers, any entry,
                         int queue = 0, int maxConns = 0): Dict {
    return srv.serve_workers(app, host, port, workers, entry, queue, maxConns)
}
export func workerLoop(Dict app, Channel conns): int { return srv.worker_loop(app, conns) }
