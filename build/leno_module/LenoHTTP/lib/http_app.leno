// http_app.leno -- 应用对象、路由表、响应助手（纯 Leno）
//
// 设计取向（与 LenoQR/LenoCSV 一致）：**用 Dict 而不是类**
//   app   = {routes: Array[Dict], statics: Array[Dict], running: bool}
//   route = {method, path, handler}
//   req   = {method, target, path, query, headers, body, form, remote, version, keepAlive}
//   res   = {status, body, contentType, headers}
//
// 为什么 handler 是"函数值"：Leno 的函数可以存进变量/数组/字典并直接调用（已实测），
//   所以路由表不需要额外的闭包容器。
import strings
import jsons
import "http_static.leno" as st
import "http_parse.leno" as p        // 复用 find（模板扫描用）

// ==================== 应用 ====================
export func new_app(): Dict {
    return {routes: [], statics: [], running: false}
}

export func route(Dict app, string method, string path, any handler) {
    Array[Dict] routes = app["routes"] as Array[Dict]
    routes.add({method: method, path: path, handler: handler})
    app.set("routes", routes)
}

export func get(Dict app, string path, any handler): void { route(app, "GET", path, handler) }
export func post(Dict app, string path, any handler): void { route(app, "POST", path, handler) }
export func put(Dict app, string path, any handler): void { route(app, "PUT", path, handler) }
export func del(Dict app, string path, any handler): void { route(app, "DELETE", path, handler) }

export func stop(Dict app) {
    app.set("running", false)
}

// ==================== 响应助手 ====================
export func text(string s): Dict {
    return {status: 200, body: s, contentType: "text/plain; charset=utf-8", headers: {}}
}

export func html(string s): Dict {
    return {status: 200, body: s, contentType: "text/html; charset=utf-8", headers: {}}
}

export func json(any obj): Dict {
    return {status: 200, body: jsons.encode(obj), contentType: "application/json; charset=utf-8",
            headers: {}}
}

export func bytes(string s, string ctype): Dict {
    return {status: 200, body: s, contentType: ctype, headers: {}}
}

export func status(int code, string body): Dict {
    return {status: code, body: body, contentType: "text/plain; charset=utf-8", headers: {}}
}

export func redirect(string url, int code): Dict {
    Dict h = {}
    h.set("Location", url)
    return {status: code, body: "", contentType: "text/plain; charset=utf-8", headers: h}
}

export func not_found(): Dict { return status(404, "404 Not Found") }

// ==================== Cookie（2026-10-20）====================
// 为什么加：写"注册/留言板"这种有登录态的应用时，每个 handler 都要自己
//   ① 从 `req["headers"]["cookie"]` 里按 "a=1; b=2" 切字符串；
//   ② 想发**多枚** Set-Cookie 时无路可走（headers 只接受字符串）✗
//   ⇒ 提供读/写各一个助手，并把"数组值 header"支持进响应写出。
// 读：`http.cookie(req, "sid", "")`
export func cookie(Dict req, string name, string def): string {
    Dict hs = req["headers"] as Dict
    if not hs.has("cookie") { return def }
    string raw = hs.get("cookie", "") as string
    if raw == "" { return def }
    for strings.split(raw, ";") to part {
        string kv = part.trim()
        if kv == "" { continue }
        int eq = p.find(kv, "=", 0)
        if eq <= 0 { continue }
        if kv.byte_slice(0, eq - 1).trim() == name {
            return kv.byte_slice(eq + 1, kv.byte_len() - 1).trim()
        }
    }
    return def
}

// 写：`return http.set_cookie(http.redirect("/"), "sid", tok, "/", 0)`
//   maxAge = 0 ⇒ 会话 cookie（关浏览器就失效）；> 0 ⇒ Max-Age 秒
//   ⚠ 多枚 cookie：headers["Set-Cookie"] 存成 Array[string]，由 _write_response 逐行写出 ✓
export func set_cookie(Dict res, string name, string value, string path, int maxAge): Dict {
    string line = name + "=" + value + "; Path=" + path + "; HttpOnly; SameSite=Lax"
    if maxAge > 0 { line = line + "; Max-Age=" + _str(maxAge) }
    Dict hs = res["headers"] as Dict
    var existing = hs.get("Set-Cookie", null)
    if existing is Array {
        (existing as Array[string]).add(line)
    } else {
        Array[string] arr = []
        arr.add(line)
        hs.set("Set-Cookie", arr)
    }
    return res
}

// 删除 cookie（Max-Age=0 + 空值）
export func clear_cookie(Dict res, string name): Dict {
    return set_cookie(res, name, "", "/", 0)
}

// ==================== HTML 转义 / 模板（2026-10-18）====================
// 为什么要有：手写 `s + "<p>" + user_input` 是最常见的 XSS 来源（演示站里我专门写了
//   esc() 做对照）。这里把"转义"变成默认行为：
//     {{name}}    ⇒ **转义**输出（默认，安全）
//     {{{name}}}  ⇒ **原样**输出（明确信任时才用）
//   缺键 ⇒ 空串（模板里少给一个变量不该把 "{{x}}" 印到页面上 ✗）
export func esc(string s): string {
    Array[int] out = []
    for s.to_bytes() to b {
        if b == 38 { for "&amp;".to_bytes() to x { out.add(x) } }
        else if b == 60 { for "&lt;".to_bytes() to x { out.add(x) } }
        else if b == 62 { for "&gt;".to_bytes() to x { out.add(x) } }
        else if b == 34 { for "&quot;".to_bytes() to x { out.add(x) } }
        else if b == 39 { for "&#39;".to_bytes() to x { out.add(x) } }
        else { out.add(b) }
    }
    return strings.from_bytes(out)
}

export func render(string tpl, Dict vars): string {
    Array[int] out = []
    int n = tpl.byte_len()
    var i = 0
    while i < n {
        int open = p.find(tpl, "{{", i)
        if open < 0 {
            for tpl.byte_slice(i, n - 1).to_bytes() to b { out.add(b) }
            break
        }
        if open > i {
            for tpl.byte_slice(i, open - 1).to_bytes() to b { out.add(b) }
        }
        bool raw = false
        var kstart = open + 2
        var closer = "}}"
        if kstart < n and tpl.byte(kstart) == 123 {      // 第三个 '{'
            raw = true
            kstart = kstart + 1
            closer = "}}}"
        }
        int cend = p.find(tpl, closer, kstart)
        if cend < 0 {
            // 没闭合：原样输出剩余（不猜、不报错 —— 模板写错的排查成本比崩掉低）
            for tpl.byte_slice(open, n - 1).to_bytes() to b { out.add(b) }
            break
        }
        string key = tpl.byte_slice(kstart, cend - 1).trim()
        var val = ""
        if vars.has(key) { val = _str(vars.get(key, "")) }
        for (if raw then val else esc(val)).to_bytes() to b { out.add(b) }
        i = cend + closer.byte_len()
    }
    return strings.from_bytes(out)
}

// 便捷：模板 → text/html 响应
export func html_template(string tpl, Dict vars): Dict { return html(render(tpl, vars)) }

// handler 允许返回 Dict（推荐）、string（自动按 text/plain）或其它（_str 兜底）
// ⚠ 不要对 `res` 原地 set：裸 Dict 的元素类型会被**第一次写入**定死
//   （先 set int 的 status，再 set string 的 body 就编译报"期望 int"）。
//   这里改成"读出来 → 造一个新的响应 Dict"，类型各自独立 ✓
func normalize(any res): Dict {
    if res is Dict {
        Dict d = res as Dict
        var code = 200
        var body = ""
        var ct = "text/plain; charset=utf-8"
        var hs = {}
        if d.has("status") { code = _int(d.get("status", 200)) }
        if d.has("body") { body = d.get("body", "") as string }
        if d.has("contentType") { ct = d.get("contentType", "") as string }
        if d.has("headers") { hs = d.get("headers", {}) as Dict }
        return {status: code, body: body, contentType: ct, headers: hs}
    }
    if res is string { return text(res as string) }
    return text(_str(res))
}

// ==================== 路由分发 ====================
// 顺序：精确路由（按注册顺序）→ 静态目录（按注册顺序）→ 404
//   路径命中但方法不符 ⇒ 405（有路由表的情况下，这比 404 更容易排查）
export func dispatch(Dict app, Dict req): Dict {
    string method = req["method"] as string
    string path = req["path"] as string
    var pathMatched = false

    Array[Dict] routes = app["routes"] as Array[Dict]
    for routes to r {
        if (r["path"] as string) != path { continue }
        pathMatched = true
        string m = r["method"] as string
        if m == method or m == "*" {
            var out = (r["handler"] as any)(req)
            return normalize(out)
        }
    }

    Array[Dict] statics = app["statics"] as Array[Dict]
    for statics to sm {
        string prefix = sm["prefix"] as string
        if strings.starts_with(path, prefix) {
            string rel = path
            if path.byte_len() >= prefix.byte_len() {
                rel = path.byte_slice(prefix.byte_len(), path.byte_len() - 1)
            }
            var hit = st.serve(sm["dir"] as string, rel)
            if hit["found"] as bool {
                return {status: 200, body: hit["data"] as string,
                        contentType: hit["ctype"] as string, headers: {}}
            }
            return not_found()
        }
    }

    if pathMatched { return status(405, "405 Method Not Allowed") }
    return not_found()
}

// 注册静态目录（prefix 形如 "/assets"）
export func static(Dict app, string prefix, string dir) {
    Array[Dict] statics = app["statics"] as Array[Dict]
    statics.add({prefix: prefix, dir: dir})
    app.set("statics", statics)
}
