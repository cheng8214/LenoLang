// http_app.leno -- 应用对象、路由表、响应助手（纯 Leno）
//
// 设计取向（与 LenoQR/LenoCSV 一致）：**用 Dict 而不是类**
//   app   = {routes: Array[Dict], statics: Array[Dict], running: bool}
//   route = {method, path, handler}
//   req   = {method, target, path, query, headers, body, form, remote, version, keepAlive}
//   res   = {status, body, contentType, headers}
//
// 为什么 handler 是"函数值"：Leno 的函数可以存进变量/数组/字典并直接调用（已实测），
//   所以路由表不需要额外的闭包容器。
import strings
import jsons
import dirs
import files
import "http_static.leno" as st
import "http_parse.leno" as p        // 复用 find（模板扫描用）

// ==================== 应用 ====================
export func new_app(): Dict {
    return {routes: [], statics: [], running: false, middlewares: [], authFn: null}
}

// 路由注册：第 5 参 opts 是**声明式元数据**（等价 C# 的 [Authorize] 特性）
//   目前支持 `{auth: true}` —— 该路由需要鉴权；以后要加 role/rateLimit 就往这里塞
//   ⚠ 默认值不能写 `{}`（Leno 要求默认值是字面量常量）⇒ 用 null 表示"没有元数据"
export func route(Dict app, string method, string path, any handler, any opts = null): void {
    Dict meta = {}
    if opts is Dict { meta = opts as Dict }
    Array[Dict] routes = app["routes"] as Array[Dict]
    routes.add({method: method, path: path, handler: handler, meta: meta})
    app.set("routes", routes)
}

export func get(Dict app, string path, any handler, any opts = null): void { route(app, "GET", path, handler, opts) }
export func post(Dict app, string path, any handler, any opts = null): void { route(app, "POST", path, handler, opts) }
export func put(Dict app, string path, any handler, any opts = null): void { route(app, "PUT", path, handler, opts) }
export func del(Dict app, string path, any handler, any opts = null): void { route(app, "DELETE", path, handler, opts) }

// ==================== 集中式路由表（2026-10-20）====================
//   http.routes(app, [
//       {method: "GET",  path: "/api/search", handler: search, auth: true},
//       {method: "POST", path: "/api/login",  handler: login},
//   ])
//
// 为什么要有：一行一个 `http.get(...)` 时，路由散在 main 里、鉴权标注也散着，
//   review 要翻全文。集中成一张表后"哪些接口、哪些要鉴权"一眼看全
//   —— 这是不动编译器前提下，最接近 C# `[HttpGet]` + `MapGet` 集中声明的形态。
//
// 规则：
//   · `method` 缺省 = GET（大小写不敏感）；`path` / `handler` 必填，缺了就跳过该项
//   · `method` / `path` / `handler` 之外的所有键**原样作为路由元数据**（如 `auth: true`）
//   · 返回成功注册的条数（写测试/启动日志时能核对"我以为注册了 3 条"）
export func routes(Dict app, Array table): int {
    var n = 0
    for table to item {
        if not (item is Dict) { continue }
        Dict m = item as Dict

        string method = "GET"
        string path = ""
        var handler = null
        if m.has("method") { method = _str(m.get("method", "GET")).to_upper() }
        if m.has("path") { path = m.get("path", "") as string }
        if m.has("handler") { handler = m.get("handler", null) }
        if path == "" or handler == null { continue }

        // 除约定键以外，其余键都是元数据（auth / role / 未来扩展）
        Dict meta = {}
        var ks = m.keys()
        for ks to k {
            string key = _str(k)          // keys() 的元素是无类型 any ⇒ 显式转 string
            if key == "method" or key == "path" or key == "handler" { continue }
            meta.set(key, m.get(key, null))
        }

        route(app, method, path, handler, meta)
        n = n + 1
    }
    return n
}

// ==================== 鉴权（声明式）====================
//   http.auth(app, fn)                    —— 注册**唯一的**鉴权检查器：fn(req) -> 用户名 / ""（空串 = 未登录）
//   http.get(app, path, h, {auth: true})  —— 该路由需要鉴权
//
// 为什么是"路由上标"而不是"按路径前缀套中间件"：
//   ① 漏保护最难发生 —— 标注与路由写在同一行，review 一眼看见；前缀方案改了路径就静默失效 ✗
//   ② 没有前缀优先级问题（`/api/` 与 `/api/admin/` 谁先）
//   ③ 与 ASP.NET Core 的分工一致：鉴权用特性、日志用管道
//
// ⚠ 路由标了 `{auth: true}` 但没注册检查器 ⇒ **500 + 明确提示**（绝不静默放行，那是安全漏洞）
export func auth(Dict app, any fn) {
    app.set("authFn", fn)
}

// ==================== 全局中间件（管道）====================
//   http.before(app, fn) —— fn(req) 返回 null 表示放行；返回响应 Dict 表示**短路**（直接发出）
// 适用：访问日志、耗时统计、CORS、维护模式；鉴权请用 `{auth: true}`（见上）
// ⚠ 名字不叫 `use`：`use` 是**保留字**（`use m.Type`）⇒ `http.use(...)` 解析失败（实测）
export func before(Dict app, any fn) {
    Array mws = []
    if app.has("middlewares") { mws = app["middlewares"] as Array }
    mws.add(fn)
    app.set("middlewares", mws)
}

// 带状态码的 JSON 响应（http.json 固定 200，401/400 要自己搓）
export func json_status(int code, any obj): Dict {
    Dict res = json(obj)
    res.set("status", code)
    return res
}

export func stop(Dict app) {
    app.set("running", false)
}

export func stop(Dict app) {
    app.set("running", false)
}

// ==================== 响应助手 ====================
export func text(string s): Dict {
    return {status: 200, body: s, contentType: "text/plain; charset=utf-8", headers: {}}
}

export func html(string s): Dict {
    return {status: 200, body: s, contentType: "text/html; charset=utf-8", headers: {}}
}

export func json(any obj): Dict {
    return {status: 200, body: jsons.encode(obj), contentType: "application/json; charset=utf-8",
            headers: {}}
}

export func bytes(string s, string ctype): Dict {
    return {status: 200, body: s, contentType: ctype, headers: {}}
}

export func status(int code, string body): Dict {
    return {status: code, body: body, contentType: "text/plain; charset=utf-8", headers: {}}
}

export func redirect(string url, int code): Dict {
    Dict h = {}
    h.set("Location", url)
    return {status: code, body: "", contentType: "text/plain; charset=utf-8", headers: h}
}

export func not_found(): Dict { return status(404, "404 Not Found") }

// ==================== 请求取值助手（2026-10-20）====================
// 为什么加：以前每取一个参数都要四行样板 ——
//   var q = req["query"] as Dict
//   var v = ""
//   if q.has("name") { v = q.get("name", "") as string }
//   if v == "" { v = "默认" }
// 现在一行：`http.query(req, "name", "默认")`
//   缺键 / 值为空串 ⇒ 给默认值（表单里"留空"通常等于没填）

export func query(Dict req, string name, string def): string {
    Dict q = req["query"] as Dict
    if not q.has(name) { return def }
    string v = q.get(name, "") as string
    if v == "" { return def }
    return v
}

export func form(Dict req, string name, string def): string {
    Dict f = req["form"] as Dict
    if not f.has(name) { return def }
    string v = f.get(name, "") as string
    if v == "" { return def }
    return v
}

// 头部名不区分大小写（解析侧已统一小写，这里 also 兜一层）
export func header(Dict req, string name, string def): string {
    Dict hs = req["headers"] as Dict
    string k = name.to_lower()
    if not hs.has(k) { return def }
    string v = hs.get(k, "") as string
    if v == "" { return def }
    return v
}

// ==================== 视图文件（2026-10-20）====================
// 约定：
//   views(app, "views")          —— 指定视图目录
//   view(app, "hello", {x: 1})   —— 渲染 views/hello.html，并自动套 views/layout.html
//   layout.html 用 `{{{body}}}` 插入页面内容（三花括号 = 原样，不转义）
//
// 为什么值得：HTML 从此放独立文件（编辑器高亮 / 不用在字符串里数反斜杠），
//   handler 里一行出页面。缺文件时给 500 + 明确路径（不是静默空白页）。
// ⚠ 每次请求都读盘（本地几 KB 约 0.1ms）；要更快就自己在外面加缓存层。
export func views(Dict app, string dir) {
    app.set("viewsDir", dir)
}

export func view(Dict app, string name, Dict vars): Dict {
    string dir = ""
    if app.has("viewsDir") { dir = app.get("viewsDir", "") as string }
    if dir == "" {
        return status(500, "500 未配置视图目录（先调 http.views(app, \"views\")）")
    }

    string file = dirs.join(dir, name + ".html")
    if not files.exists(file) {
        return status(500, $"500 视图不存在：{file}")
    }

    string body = render(files.read(file), vars)

    string layout = dirs.join(dir, "layout.html")
    if files.exists(layout) {
        // layout 里除了 {{{body}}}，也可以直接用页面传进来的变量（title 等）
        Dict lv = {}
        var ks = vars.keys()
        for ks to k {
            string key = _str(k)          // keys() 的元素是无类型 any ⇒ 显式转 string
            lv.set(key, vars.get(key, ""))
        }
        lv.set("body", body)
        return html(render(files.read(layout), lv))
    }
    return html(body)
}

// ==================== Cookie（2026-10-20）====================
// 为什么加：写"注册/留言板"这种有登录态的应用时，每个 handler 都要自己
//   ① 从 `req["headers"]["cookie"]` 里按 "a=1; b=2" 切字符串；
//   ② 想发**多枚** Set-Cookie 时无路可走（headers 只接受字符串）✗
//   ⇒ 提供读/写各一个助手，并把"数组值 header"支持进响应写出。
// 读：`http.cookie(req, "sid", "")`
export func cookie(Dict req, string name, string def): string {
    Dict hs = req["headers"] as Dict
    if not hs.has("cookie") { return def }
    string raw = hs.get("cookie", "") as string
    if raw == "" { return def }
    for strings.split(raw, ";") to part {
        string kv = part.trim()
        if kv == "" { continue }
        int eq = p.find(kv, "=", 0)
        if eq <= 0 { continue }
        if kv.byte_slice(0, eq - 1).trim() == name {
            return kv.byte_slice(eq + 1, kv.byte_len() - 1).trim()
        }
    }
    return def
}

// 写：`return http.set_cookie(http.redirect("/"), "sid", tok, "/", 0)`
//   maxAge = 0 ⇒ 会话 cookie（关浏览器就失效）；> 0 ⇒ Max-Age 秒
//   ⚠ 多枚 cookie：headers["Set-Cookie"] 存成 Array[string]，由 _write_response 逐行写出 ✓
export func set_cookie(Dict res, string name, string value, string path, int maxAge): Dict {
    string line = name + "=" + value + "; Path=" + path + "; HttpOnly; SameSite=Lax"
    if maxAge > 0 { line = line + "; Max-Age=" + _str(maxAge) }
    Dict hs = res["headers"] as Dict
    var existing = hs.get("Set-Cookie", null)
    if existing is Array {
        (existing as Array[string]).add(line)
    } else {
        Array[string] arr = []
        arr.add(line)
        hs.set("Set-Cookie", arr)
    }
    return res
}

// 删除 cookie（Max-Age=0 + 空值）
export func clear_cookie(Dict res, string name): Dict {
    return set_cookie(res, name, "", "/", 0)
}

// ==================== HTML 转义 / 模板（2026-10-18）====================
// 为什么要有：手写 `s + "<p>" + user_input` 是最常见的 XSS 来源（演示站里我专门写了
//   esc() 做对照）。这里把"转义"变成默认行为：
//     {{name}}    ⇒ **转义**输出（默认，安全）
//     {{{name}}}  ⇒ **原样**输出（明确信任时才用）
//   缺键 ⇒ 空串（模板里少给一个变量不该把 "{{x}}" 印到页面上 ✗）
export func esc(string s): string {
    Array[int] out = []
    for s.to_bytes() to b {
        if b == 38 { for "&amp;".to_bytes() to x { out.add(x) } }
        else if b == 60 { for "&lt;".to_bytes() to x { out.add(x) } }
        else if b == 62 { for "&gt;".to_bytes() to x { out.add(x) } }
        else if b == 34 { for "&quot;".to_bytes() to x { out.add(x) } }
        else if b == 39 { for "&#39;".to_bytes() to x { out.add(x) } }
        else { out.add(b) }
    }
    return strings.from_bytes(out)
}

export func render(string tpl, Dict vars): string {
    Array[int] out = []
    int n = tpl.byte_len()
    var i = 0
    while i < n {
        int open = p.find(tpl, "{{", i)
        if open < 0 {
            for tpl.byte_slice(i, n - 1).to_bytes() to b { out.add(b) }
            break
        }
        if open > i {
            for tpl.byte_slice(i, open - 1).to_bytes() to b { out.add(b) }
        }
        bool raw = false
        var kstart = open + 2
        var closer = "}}"
        if kstart < n and tpl.byte(kstart) == 123 {      // 第三个 '{'
            raw = true
            kstart = kstart + 1
            closer = "}}}"
        }
        int cend = p.find(tpl, closer, kstart)
        if cend < 0 {
            // 没闭合：原样输出剩余（不猜、不报错 —— 模板写错的排查成本比崩掉低）
            for tpl.byte_slice(open, n - 1).to_bytes() to b { out.add(b) }
            break
        }
        string key = tpl.byte_slice(kstart, cend - 1).trim()
        var val = ""
        if vars.has(key) { val = _str(vars.get(key, "")) }
        for (if raw then val else esc(val)).to_bytes() to b { out.add(b) }
        i = cend + closer.byte_len()
    }
    return strings.from_bytes(out)
}

// 便捷：模板 → text/html 响应
export func html_template(string tpl, Dict vars): Dict { return html(render(tpl, vars)) }

// handler 允许返回 Dict（推荐）、string（自动按 text/plain）或其它（_str 兜底）
// ⚠ 不要对 `res` 原地 set：裸 Dict 的元素类型会被**第一次写入**定死
//   （先 set int 的 status，再 set string 的 body 就编译报"期望 int"）。
//   这里改成"读出来 → 造一个新的响应 Dict"，类型各自独立 ✓
func normalize(any res): Dict {
    if res is Dict {
        Dict d = res as Dict
        var code = 200
        var body = ""
        var ct = "text/plain; charset=utf-8"
        var hs = {}
        if d.has("status") { code = _int(d.get("status", 200)) }
        if d.has("body") { body = d.get("body", "") as string }
        if d.has("contentType") { ct = d.get("contentType", "") as string }
        if d.has("headers") { hs = d.get("headers", {}) as Dict }
        return {status: code, body: body, contentType: ct, headers: hs}
    }
    // 直接返回字符串 ⇒ 按 **text/html**（写网页的默认口味，省掉 http.html(...)）
    //   要纯文本请显式 `return http.text(...)`
    if res is string { return html(res as string) }
    return text(_str(res))
}

// ==================== 路由分发 ====================
// 顺序：精确路由（按注册顺序）→ 静态目录（按注册顺序）→ 404
//   路径命中但方法不符 ⇒ 405（有路由表的情况下，这比 404 更容易排查）
export func dispatch(Dict app, Dict req): Dict {
    string method = req["method"] as string
    string path = req["path"] as string

    // ① 全局中间件（注册顺序；返回非 null = 短路）。
    //    ⚠ 必须自己也兜 try/catch —— 一个坏中间件不能把整个服务带走
    //      （handler 那条 try 是后来补的，代价是一次"一个 throw 打死整个站点"）
    if app.has("middlewares") {
        Array mws = app["middlewares"] as Array
        for mws to mw {
            try {
                var out = (mw as any)(req)
                if out != null { return normalize(out) }
            } catch e {
                print("[http] 中间件异常 " + method + " " + path + "：" + _str(e) + "\n")
                return status(500, "500 Internal Server Error")
            }
        }
    }

    var pathMatched = false

    Array[Dict] routes = app["routes"] as Array[Dict]
    for routes to r {
        if (r["path"] as string) != path { continue }
        pathMatched = true
        string m = r["method"] as string
        if m == method or m == "*" {
            // ★★ 2026-10-20：handler 抛异常**不能把服务带走**。
            //   实测：一个 `throw` 的 handler 让进程直接没了 —— 之后的请求全部被拒（连接拒绝 ✗），
            //   也就是"一个坏请求打死整个站点"。这里兜成 500 + 一行日志。
            try {
                // ② 声明式鉴权（注册时 `{auth: true}`）
                var meta = r.get("meta", null)
                if meta is Dict {
                    Dict md = meta as Dict
                    var need = false
                    if md.has("auth") { need = md.get("auth", false) as bool }
                    if need {
                        if not app.has("authFn") or app["authFn"] == null {
                            // 标了要鉴权却没注册检查器：宁可 500 也不放行（静默放行 = 安全漏洞）
                            print("[http] 路由 " + method + " " + path
                                + " 标了 auth:true，但没调用 http.auth(app, fn)\n")
                            return status(500, "500 服务端未配置鉴权检查器（http.auth）")
                        }
                        var checker = app["authFn"] as any
                        var user = _str(checker(req))
                        if user == "" {
                            return json_status(401, {ok: false, error: "unauthorized"})
                        }
                        req.set("user", user)      // 交给 handler（等价 HttpContext.Items）
                    }
                }

                var out = (r["handler"] as any)(req)
                return normalize(out)
            } catch e {
                print("[http] handler 异常 " + method + " " + path + "：" + e + "\n")
                return status(500, "500 Internal Server Error")
            }
        }
    }

    Array[Dict] statics = app["statics"] as Array[Dict]
    for statics to sm {
        string prefix = sm["prefix"] as string
        if strings.starts_with(path, prefix) {
            string rel = path
            if path.byte_len() >= prefix.byte_len() {
                rel = path.byte_slice(prefix.byte_len(), path.byte_len() - 1)
            }
            var hit = st.serve(sm["dir"] as string, rel)
            if hit["found"] as bool {
                return {status: 200, body: hit["data"] as string,
                        contentType: hit["ctype"] as string, headers: {}}
            }
            return not_found()
        }
    }

    if pathMatched { return status(405, "405 Method Not Allowed") }
    return not_found()
}

// 注册静态目录（prefix 形如 "/assets"）
export func static(Dict app, string prefix, string dir) {
    Array[Dict] statics = app["statics"] as Array[Dict]
    statics.add({prefix: prefix, dir: dir})
    app.set("statics", statics)
}
