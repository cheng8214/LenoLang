// http_parse.leno -- HTTP 报文解析（纯 Leno，按字节）
//
// 只做 HTTP/1.x 的**常见形状**（RFC 7230 的子集）：
//   · 请求行 "METHOD target HTTP/1.1"
//   · 头部每行 "Name: Value"，名字统一转小写（查询时不必关心大小写）
//   · 查询串 & 表单用 application/x-www-form-urlencoded 解析（%XX 与 '+'）
// 明确不做：分块传输（chunked 请求体）、multipart、HTTP/2、头部折行（obs-fold）。
import strings

func lower(string s): string {
    Array[int] out = []
    for s.to_bytes() to b {
        if b >= 65 and b <= 90 { out.add(b + 32) } else { out.add(b) }
    }
    return strings.from_bytes(out)
}

// 去掉首尾空格 / 制表符
export func trim(string s): string {
    Array[int] bs = s.to_bytes()
    var a = 0
    var b = bs.len() - 1
    while a <= b and (bs[a] == 32 or bs[a] == 9) { a = a + 1 }
    while b >= a and (bs[b] == 32 or bs[b] == 9) { b = b - 1 }
    if b < a { return "" }
    return strings.byte_slice(s, a, b)
}

export func find(string hay, string needle, int from): int {
    Array[int] h = hay.to_bytes()
    Array[int] n = needle.to_bytes()
    if n.len() == 0 { return -1 }
    var i = from
    while i + n.len() <= h.len() {
        var hit = true
        for 0:n.len()-1 to k {
            if h[i + k] != n[k] { hit = false; break }
        }
        if hit { return i }
        i = i + 1
    }
    return -1
}

export func split(string s, string sep): Array[string] {
    Array[string] out = []
    var start = 0
    while true {
        int idx = find(s, sep, start)
        if idx < 0 {
            if start <= s.byte_len() - 1 { out.add(strings.byte_slice(s, start, s.byte_len() - 1)) }
            else if s.byte_len() == 0 { } else { }
            break
        }
        if idx == start { out.add("") }
        else { out.add(strings.byte_slice(s, start, idx - 1)) }
        start = idx + sep.byte_len()
        if start >= s.byte_len() { out.add(""); break }
    }
    return out
}

func _hexval(int b): int {
    if b >= 48 and b <= 57 { return b - 48 }
    if b >= 97 and b <= 102 { return b - 87 }
    if b >= 65 and b <= 70 { return b - 55 }
    return -1
}

// %XX 解码；plusAsSpace=true 时 '+' 也当空格（查询串/表单；路径里 '+' 是字面量）
export func url_decode(string s, bool plusAsSpace): string {
    Array[int] bs = s.to_bytes()
    Array[int] out = []
    var i = 0
    while i < bs.len() {
        int b = bs[i]
        if b == 37 and i + 2 < bs.len() {
            int hi = _hexval(bs[i + 1])
            int lo = _hexval(bs[i + 2])
            if hi >= 0 and lo >= 0 {
                out.add(hi * 16 + lo)
                i = i + 3
                continue
            }
        }
        if b == 43 and plusAsSpace { out.add(32) }
        else { out.add(b) }
        i = i + 1
    }
    return strings.from_bytes(out)
}

// "a=1&b=2" → {a:"1", b:"2"}（同键后者覆盖前者；空值保留为 ""）
export func parse_kv(string s): Dict {
    Dict d = {}
    if s == "" { return d }
    for split(s, "&") to part {
        if part == "" { continue }
        int eq = find(part, "=", 0)
        var k = part
        var v = ""
        if eq >= 0 {
            k = strings.byte_slice(part, 0, eq - 1)
            if eq + 1 <= part.byte_len() - 1 { v = strings.byte_slice(part, eq + 1, part.byte_len() - 1) }
        }
        d.set(url_decode(k, true), url_decode(v, true))
    }
    return d
}

// 头部行数组 → {小写名: 值}
export func parse_headers(Array[string] lines): Dict {
    Dict h = {}
    for lines to line {
        if line == "" { continue }
        int c = find(line, ":", 0)
        if c <= 0 { continue }
        string k = lower(trim(strings.byte_slice(line, 0, c - 1)))
        string v = trim(strings.byte_slice(line, c + 1, line.byte_len() - 1))
        h.set(k, v)
    }
    return h
}

// 请求行 → [method, target, version]
export func split_request_line(string line): Array[string] {
    Array[string] out = []
    var start = 0
    var i = 0
    while i < line.byte_len() {
        if line.byte(i) == 32 {
            if i > start { out.add(strings.byte_slice(line, start, i - 1)) }
            start = i + 1
        }
        i = i + 1
    }
    if start <= line.byte_len() - 1 { out.add(strings.byte_slice(line, start, line.byte_len() - 1)) }
    return out
}

// "path?x=1" → [path, "x=1"]（没有 ? 时第二项为 ""）
export func split_target(string target): Array[string] {
    int q = find(target, "?", 0)
    Array[string] out = []
    if q < 0 {
        out.add(target)
        out.add("")
        return out
    }
    out.add(strings.byte_slice(target, 0, q - 1))
    if q + 1 <= target.byte_len() - 1 {
        out.add(strings.byte_slice(target, q + 1, target.byte_len() - 1))
    } else {
        out.add("")
    }
    return out
}

// 返回 "\r\n\r\n" 的**结束位置**（即正文起点），找不到 -1
export func header_end(string buf): int {
    int i = find(buf, "\r\n\r\n", 0)
    if i < 0 { return -1 }
    return i + 4
}

// ==================== multipart/form-data（2026-10-21）====================
// 为什么全部按**字节数组**操作：body 里可能是图片/压缩包（非 UTF-8）
//   `find` / `byte_slice` 那套是字节级没错，但 `find` 每次调用都会 `to_bytes()` 整个正文
//   （8MB 正文 × 每段 2 次调用 ⇒ 上百 MB 的临时拷贝）⇒ 这里先把整份转成 Array[int]，
//   后续全在数组上扫。
func _find_arr(Array[int] h, Array[int] n, int from): int {
    int hn = h.len()
    int nn = n.len()
    if nn == 0 or hn < nn { return -1 }
    int first = n[0]
    var i = from
    if i < 0 { i = 0 }
    while i <= hn - nn {
        if h[i] == first {
            var hit = true
            for 0:nn-1 to k {
                if h[i + k] != n[k] { hit = false; break }
            }
            if hit { return i }
        }
        i = i + 1
    }
    return -1
}

func _slice_arr(Array[int] h, int start, int end): string {
    Array[int] out = []
    if start < 0 { start = 0 }
    if end >= h.len() { end = h.len() - 1 }
    if start <= end {
        for start:end to i { out.add(h[i]) }
    }
    return strings.from_bytes(out)
}

// 从 `Content-Disposition: form-data; name="x"; filename="y"` 取引号内的值（字节级）
func _quoted(string line, string key): string {
    Array[int] hb = line.to_bytes()
    Array[int] kn = (key + "=\"").to_bytes()
    int p = _find_arr(hb, kn, 0)
    if p < 0 { return "" }
    int s = p + kn.len()
    var e = s
    while e < hb.len() and hb[e] != 34 { e = e + 1 }
    if e <= s { return "" }
    return _slice_arr(hb, s, e - 1)
}

// 解析 multipart/form-data
//   返回 {fields: Dict[string,string], files: Array[Dict]}
//   files 每项：{name, filename, contentType, body}（body 是**原始字节**，落盘请直接 write）
//   同一 name 多次出现：文本字段后者覆盖；文件全部保留（顺序同请求）
export func parse_multipart(string body, string boundary): Dict {
    Dict fields = {}
    // ⚠ 变量别叫 `files`：本文件没导入 files 模块，但 `files.add(...)` 会被解析成
    //   "模块 files 的方法 add" ⇒ 报「模块 'files' 未导入」（2026-10-21 实测踩到）
    Array[Dict] upfiles = []
    if boundary == "" or body == "" { return {fields: fields, files: upfiles} }

    Array[int] hb = body.to_bytes()
    Array[int] dn = ("--" + boundary).to_bytes()
    Array[int] sepLF = []
    sepLF.add(13); sepLF.add(10)
    for dn to b { sepLF.add(b) }           // `\r\n--boundary`

    int pos = _find_arr(hb, dn, 0)
    while pos >= 0 {
        int seg = pos + dn.len()
        // 结束标记 `--boundary--`
        if seg + 1 < hb.len() and hb[seg] == 45 and hb[seg + 1] == 45 { break }
        // 段首 CRLF
        if seg + 1 < hb.len() and hb[seg] == 13 and hb[seg + 1] == 10 { seg = seg + 2 }

        // 头部与内容的分界
        int hdrEnd = _find_arr(hb, [13, 10, 13, 10], seg)
        if hdrEnd < 0 { break }
        string head = _slice_arr(hb, seg, hdrEnd - 1)
        int cstart = hdrEnd + 4

        // 下一个分隔符：`\r\n--boundary`
        int next = _find_arr(hb, sepLF, cstart)
        var content = ""
        if next < 0 {
            // 没有结束分隔符（畸形）⇒ 取到末尾，别把内容丢了
            content = _slice_arr(hb, cstart, hb.len() - 1)
            pos = -1
        } else {
            content = _slice_arr(hb, cstart, next - 1)
            pos = next + 2
        }

        var pname = ""
        var pfile = ""
        var ptype = ""
        for split(head, "\r\n") to line {
            string low = lower(trim(line))
            if strings.starts_with(low, "content-disposition:") {
                pname = _quoted(line, "name")
                pfile = _quoted(line, "filename")
            } else if strings.starts_with(low, "content-type:") {
                ptype = trim(strings.byte_slice(line, 13, line.byte_len() - 1))
            }
        }
        if pname != "" {
            if pfile != "" {
                upfiles.add({name: pname, filename: pfile, contentType: ptype, body: content})
            } else {
                fields.set(pname, content)
            }
        }
        if pos < 0 { break }
    }
    return {fields: fields, files: upfiles}
}

// `Content-Type: multipart/form-data; boundary=xxx` ⇒ "xxx"（没有 ⇒ ""）
export func multipart_boundary(string ct): string {
    string low = lower(ct)
    if find(low, "multipart/form-data", 0) < 0 { return "" }
    int p = find(ct, "boundary=", 0)
    if p < 0 { return "" }
    int s = p + 9
    string v = trim(strings.byte_slice(ct, s, ct.byte_len() - 1))
    // 可能带引号：boundary="xxx"
    if v.byte_len() >= 2 and v.byte(0) == 34 {
        var e = 1
        var out = ""
        while e < v.byte_len() and v.byte(e) != 34 {
            out = out + v.byte_slice(e, e)
            e = e + 1
        }
        return out
    }
    return v
}
