// w32_shell.leno — Windows Shell 轻量封装：磁盘空间 / 回收站 / 回收站式删除
// 依赖 shell32.dll + kernel32.dll，全部 W 版 API（UTF-16），经 ffi.utf8_to_utf16 转换 ✓
// FFI 模式照 w32_process.leno：clib 声明 + 惰性 ffi.load + malloc/try/finally free ✓
import ffi

// ==================== SHELL32 ====================
clib shell32 {
    // 清空回收站：root=null ⇒ 所有驱动器；flags = SHERB_* 组合
    // 返回 HRESULT（0=S_OK；空回收站常见 0x8000FFFF=E_UNEXPECTED，也算成功）
    i32 SHEmptyRecycleBinW(Ptr hwnd, Ptr[u16] root, u32 flags)

    // 通用文件操作（复制/移动/删除）：op = SHFILEOPSTRUCTW*（56 字节，手排布局见下）
    // 成功返回 0；fAnyOperationsAborted（偏移 36）=用户/系统中止
    i32 SHFileOperationW(Ptr op)

    // 取文件/目录的图标：psfi = SHFILEINFOW*（x64 = 696 字节），返回非 0 = 成功
    //   flags: SHGFI_ICON(0x100) | SHGFI_SMALLICON(0x1) 或 SHGFI_LARGEICON(0x0)
    //          | SHGFI_USEFILEATTRIBUTES(0x10)（路径可不存在，按 attrs 给通用图标）
    Ptr SHGetFileInfoW(Ptr[u16] path, u32 attrs, Ptr psfi, u32 cbFileInfo, u32 flags)
}

// ==================== USER32（图标）====================
clib user32 {
    i32 DestroyIcon(Ptr hIcon)
    // ICONINFO（x64 32 字节）：fIcon@0 xHotspot@4 yHotspot@8 pad@12 hbmMask@16 hbmColor@24
    i32 GetIconInfo(Ptr hIcon, Ptr pii)
}

// ==================== GDI32（位图取像素）====================
clib gdi32 {
    // BITMAP（x64 32 字节）：bmType@0 bmWidth@4 bmHeight@8 bmWidthBytes@12 bmPlanes@16 bmBitsPixel@18 ...
    i32 GetObjectW(Ptr h, i32 cb, Ptr out)
    Ptr CreateCompatibleDC(Ptr hdc)
    i32 DeleteDC(Ptr hdc)
    // BITMAPINFOHEADER（40 字节）；usage: DIB_RGB_COLORS = 0
    i32 GetDIBits(Ptr hdc, Ptr hbm, u32 start, u32 lines, Ptr bits, Ptr bmi, u32 usage)
}

// ==================== KERNEL32 ====================
clib kernel32 {
    // 磁盘空闲/总容量（出参均为 ULARGE_INTEGER = 8 字节 u64）
    i32 GetDiskFreeSpaceExW(Ptr[u16] dir, Ptr freeBytes, Ptr totalBytes, Ptr totalFreeBytes)

    // UTF-16 串长（不含结尾 null）——给 SHFileOperationW 拼「双 null 结尾」pFrom 用
    i32 lstrlenW(Ptr[u16] s)

    // 驱动器类型：2=可移动 3=固定 4=网络 5=光驱 6=RAM 0/1=未知
    u32 GetDriveTypeW(Ptr[u16] lpRootPathName)

    // 卷信息：卷标 / 序列号 / 最大组件长度 / 文件系统标志 / 文件系统名（NTFS、FAT32…）
    i32 GetVolumeInformationW(Ptr[u16] root, Ptr[u16] volName, u32 volNameSize,
                              Ptr volSerial, Ptr maxCompLen, Ptr fsFlags,
                              Ptr[u16] fsName, u32 fsNameSize)
}

shell32 _shell = null
func _shellLib(): shell32 {
    if _shell == null { _shell = ffi.load("shell32.dll") }
    return _shell
}
user32 _user = null
func _userLib(): user32 {
    if _user == null { _user = ffi.load("user32.dll") }
    return _user
}
gdi32 _gdi = null
func _gdiLib(): gdi32 {
    if _gdi == null { _gdi = ffi.load("gdi32.dll") }
    return _gdi
}

kernel32 _krnl = null
func _krnlLib(): kernel32 {
    if _krnl == null { _krnl = ffi.load("kernel32.dll") }
    return _krnl
}

// ==================== 常量 ====================
// SHEmptyRecycleBin flags
export const SHERB_NOCONFIRMATION = 0x1
export const SHERB_NOPROGRESSUI  = 0x2
export const SHERB_NOSOUND       = 0x4

// SHFileOperation
export const FO_DELETE = 3
// FOF_ALLOWUNDO(0x40 删除进回收站) | FOF_NOCONFIRMATION(0x10) | FOF_SILENT(0x4) | FOF_NOERRORUI(0x400)
export const FOF_DELETE_TO_BIN = 0x454

// 0x8000FFFF = E_UNEXPECTED —— 回收站已空时 SHEmptyRecycleBinW 的常见返回
const HR_BIN_EMPTY = -2147418113

// ==================== 磁盘空间 ====================
// root 形如 "C:\\"；返回 {ok:bool, total:int, free:int}（字节；free=当前用户可用额度）
export func diskSpace(string root): Dict {
    Ptr[u16] w = ffi.utf8_to_utf16(root)
    Ptr pFree    = ffi.malloc(8)     // ULARGE_INTEGER：调用者可用空闲
    Ptr pTotal   = ffi.malloc(8)     // 总容量
    Ptr pFreeAll = ffi.malloc(8)     // 全盘空闲
    try {
        int ret = _krnlLib().GetDiskFreeSpaceExW(w, pFree, pTotal, pFreeAll)
        if ret == 0 { return {ok: false, total: 0, free: 0} }
        return {ok: true, total: ffi.read_int64(pTotal, 0), free: ffi.read_int64(pFree, 0)}
    } finally {
        ffi.free(w)
        ffi.free(pFree)
        ffi.free(pTotal)
        ffi.free(pFreeAll)
    }
}

// ==================== 卷信息（卷标 / 文件系统 / 类型 / 序列号）====================
// root 形如 "C:\\"。返回
//   {ok, root, label, fsType, serial, driveType, kind}
//   · `ok=false` ⇒ 这个根取不到卷信息（光驱空、U 盘已拔出、权限不足）
//   · `kind`：removable / fixed / network / cdrom / ram / unknown（由 GetDriveTypeW 映射）
//   · **容量不在这里**（那是 diskSpace 的事，门面再合并 —— 与既有分层一致）
export func volumeInfo(string root): Dict {
    Ptr[u16] w = ffi.utf8_to_utf16(root)
    Ptr pVolName = ffi.malloc(512)     // 最多 128 个宽字符
    Ptr pFsName = ffi.malloc(512)      // 文件系统名（NTFS/FAT32/…），64 个宽字符够
    Ptr pSerial = ffi.malloc(4)
    Ptr pMaxComp = ffi.malloc(4)
    Ptr pFsFlags = ffi.malloc(4)
    try {
        int dt = _krnlLib().GetDriveTypeW(w)
        ffi.memset(pVolName, 0, 512)
        ffi.memset(pFsName, 0, 512)
        int okv = _krnlLib().GetVolumeInformationW(w, pVolName, 128, pSerial, pMaxComp, pFsFlags, pFsName, 64)
        string label = ""
        string fstype = ""
        int sn = 0
        if okv != 0 {
            label = ffi.utf16_to_utf8(pVolName)
            fstype = ffi.utf16_to_utf8(pFsName)
            sn = ffi.read_uint(pSerial, 0)
        }
        var kind = "unknown"
        if dt == 2 { kind = "removable" }
        else if dt == 3 { kind = "fixed" }
        else if dt == 4 { kind = "network" }
        else if dt == 5 { kind = "cdrom" }
        else if dt == 6 { kind = "ram" }
        return {ok: okv != 0, root: root, label: label, fsType: fstype,
                serial: sn, driveType: dt, kind: kind}
    } finally {
        ffi.free(w)
        ffi.free(pVolName)
        ffi.free(pFsName)
        ffi.free(pSerial)
        ffi.free(pMaxComp)
        ffi.free(pFsFlags)
    }
}

// ==================== 文件图标（2026-11-27）====================
// 取文件在资源管理器里显示的图标，转成 RGBA 像素。
//   返回 {ok, w, h, pixels}：pixels 是 Array[int]，每像素 4 个 0..255（R,G,B,A），行优先
//   · small=true ⇒ 16×16；false ⇒ 32×32（系统标准尺寸，不做缩放）
//   · **对存在的文件与目录都有效**（目录给文件夹图标）；不存在的路径 ⇒ ok=false
//     ⚠ 不要加 `SHGFI_USEFILEATTRIBUTES`：实测加了之后**目录反而拿不到 hIcon**
//   · 老图标没有 alpha 通道 ⇒ 该图标的 alpha 全补 255（不做 mask 合成）
//   · bpp 不是 32 的图标直接返回 ok=false（Win10 的图标都是 32bpp，极少遇到）
export func fileIcon(string path, bool small = false): Dict {
    Ptr shfi = ffi.calloc(1, 696)     // SHFILEINFOW(x64 696)：hIcon@0 iIcon@8 attrs@12 display@16 type@536
    Ptr pw = ffi.utf8_to_utf16(path)
    try {
        int flags = 0x100                        // SHGFI_ICON
        if small { flags = flags | 0x1 }         // SHGFI_SMALLICON（不带就是 LARGEICON 32×32）
        Ptr r = _shellLib().SHGetFileInfoW(pw, 0, shfi, 696, flags)
        if r == null { return {ok: false, w: 0, h: 0, pixels: []} }
        Ptr hIcon = ffi.read_ptr(shfi, 0)
        if hIcon == null { return {ok: false, w: 0, h: 0, pixels: []} }
        try {
            Ptr ii = ffi.calloc(1, 32)           // ICONINFO
            try {
                if _userLib().GetIconInfo(hIcon, ii) == 0 { return {ok: false, w: 0, h: 0, pixels: []} }
                Ptr hbm = ffi.read_ptr(ii, 24)   // hbmColor
                if hbm == null { return {ok: false, w: 0, h: 0, pixels: []} }
                Ptr bm = ffi.calloc(1, 32)       // BITMAP
                try {
                    _gdiLib().GetObjectW(hbm, 32, bm)
                    int w = ffi.read_int(bm, 4)
                    int h = ffi.read_int(bm, 8)
                    int bpp = ffi.read_uint16(bm, 18)
                    if w <= 0 or h <= 0 or w > 256 or h > 256 or bpp != 32 {
                        return {ok: false, w: 0, h: 0, pixels: []}
                    }
                    Ptr hdc = _gdiLib().CreateCompatibleDC(null)
                    Ptr bmi = ffi.calloc(1, 40)  // BITMAPINFOHEADER
                    Ptr buf = ffi.malloc(w * h * 4)
                    try {
                        ffi.write_int(bmi, 0, 40)
                        ffi.write_int(bmi, 4, w)
                        ffi.write_int(bmi, 8, 0 - h)   // 负高度 ⇒ 自上而下，省一次翻转
                        ffi.write_int16(bmi, 12, 1)    // planes
                        ffi.write_int16(bmi, 14, 32)   // bitcount
                        ffi.write_int(bmi, 16, 0)      // BI_RGB
                        if _gdiLib().GetDIBits(hdc, hbm, 0, h, buf, bmi, 0) == 0 {
                            return {ok: false, w: 0, h: 0, pixels: []}
                        }
                        // 先扫一遍看有没有 alpha（GDI 给的是 BGRA；老图标 alpha 全 0）
                        var anyAlpha = false
                        for 0:h-1 to y {
                            for 0:w-1 to x {
                                if ffi.read_byte(buf, (y * w + x) * 4 + 3) != 0 { anyAlpha = true }
                            }
                        }
                        Array[int] px = []
                        for 0:h-1 to y {
                            for 0:w-1 to x {
                                int o = (y * w + x) * 4
                                px.add(ffi.read_byte(buf, o + 2))   // R
                                px.add(ffi.read_byte(buf, o + 1))   // G
                                px.add(ffi.read_byte(buf, o))       // B
                                int a = ffi.read_byte(buf, o + 3)
                                if not anyAlpha { a = 255 }
                                px.add(a)
                            }
                        }
                        return {ok: true, w: w, h: h, pixels: px}
                    } finally {
                        ffi.free(bmi)
                        ffi.free(buf)
                        _gdiLib().DeleteDC(hdc)
                    }
                } finally {
                    ffi.free(bm)
                }
            } finally {
                ffi.free(ii)
            }
        } finally {
            _userLib().DestroyIcon(hIcon)
        }
    } finally {
        ffi.free(pw)
        ffi.free(shfi)
    }
}

// ==================== 清空回收站 ====================
// 默认无确认、无进度 UI、无声音；root=null ⇒ 清空所有驱动器的回收站。
// 回收站已空也返回 true（E_UNEXPECTED 视作成功）。
export func emptyRecycleBin(int flags = 7): bool {
    int hr = _shellLib().SHEmptyRecycleBinW(null, null, flags)
    return hr == 0 or hr == HR_BIN_EMPTY
}

// ==================== 删除进回收站 ====================
// 逐路径走 SHFileOperationW（FOF_ALLOWUNDO ⇒ 进回收站而非永久删除）。
// 返回 {ok:bool, count:int, aborted:bool}：count=提交的路径数。
// pFrom 要求「多串、每串 \0 结尾、整体再补一个 \0」——utf8_to_utf16 只带一个 null，
// 所以先 lstrlenW 量长，再 malloc 拼缓冲、write_int16 补齐双 null ✓
export func deleteToRecycleBin(Array[string] paths): Dict {
    if paths.len() == 0 { return {ok: true, count: 0, aborted: false} }

    // 1) 逐路径转 UTF-16 并累计所需 wchar 总数（每串 +1 结尾，整体再 +1）
    Array[Ptr[u16]] ws = []
    int total = 1
    for paths to p {
        Ptr[u16] w = ffi.utf8_to_utf16(p)
        ws.add(w)
        total = total + _krnlLib().lstrlenW(w) + 1
    }
    Ptr[u16] from = ffi.malloc(total * 2)
    Ptr op = ffi.malloc(56)          // sizeof(SHFILEOPSTRUCTW)
    try {
        // 2) 拼 pFrom：串1 \0 串2 \0 ... 串N \0 \0
        int cur = 0
        for ws to w {
            int n = _krnlLib().lstrlenW(w)
            ffi.memcpy(ffi.offset(from, cur), w, n * 2)
            ffi.write_int16(from, cur + n * 2, 0)
            cur = cur + (n + 1) * 2
        }
        ffi.write_int16(from, cur, 0)          // 整体结尾再补一个 null（双 null ✓）

        // 3) 手排 SHFILEOPSTRUCTW（x64：hwnd@0 wFunc@8 pFrom@16 pTo@24
        //    fFlags@36前4B? —— 布局：fFlags@32(4B) fAnyOperationsAborted@36(4B)
        //    hNameMappings@40 lpszProgressTitle@48）
        ffi.write_int64(op, 0, 0)              // hwnd = null
        ffi.write_int64(op, 8, FO_DELETE)      // wFunc（含 12-16 对齐垫 ✓）
        ffi.write_ptr(op, 16, from)            // pFrom
        ffi.write_int64(op, 24, 0)             // pTo = null
        ffi.write_int64(op, 32, FOF_DELETE_TO_BIN)   // fFlags + fAnyOperationsAborted(=0) ✓
        ffi.write_int64(op, 40, 0)             // hNameMappings = null
        ffi.write_int64(op, 48, 0)             // lpszProgressTitle = null

        // 4) 执行
        int ret = _shellLib().SHFileOperationW(op)
        bool aborted = ffi.read_int(op, 36) != 0
        return {ok: ret == 0 and not aborted, count: paths.len(), aborted: aborted}
    } finally {
        ffi.free(op)
        ffi.free(from)
        for ws to w { ffi.free(w) }
    }
}
