// w32_process.leno — Windows 进程管理
// 封装 kernel32.dll 和 psapi.dll 的进程相关 API
// 提供 ProcessManager face 及 StandardProcessManager / SafeProcessManager 实现
import ffi
import threads

// ==================== 线程局部库句柄（★ 2026-11-07 反哺）====================
//   为什么不能放模块全局变量：
//     · 模块对象在 `module_loader` 里是**进程级共享**的（非 THREAD_LOCAL），
//       所以 `xxx _lib = null` + 懒加载 得到的句柄是**所有线程共用同一个 clib 对象**；
//     · 而 **GC 是线程级的**（每线程一个堆/根集合）：A 线程 load 的对象不在 B 线程的
//       根集合里 ⇒ B 的 GC 会把它当垃圾回收（`ffi_library_free_resources` 置 `freed`）
//       ⇒ A 线程再用就抛「库对象已释放，不能再使用」✗
//   实测现场：deployd（HTTP worker 池）里 `GET /status` 第一次正常、第二次起全 500，
//   栈顶就是本文件 `_enumProcesses`。单线程（`http.serve`）永远不会遇到。
//   ⇒ 句柄放 `threads.local_*`：每线程各 load 一份、各归各的 GC 管 ✓

// ==================== KERNEL32 ====================
clib kernel32 {
    Ptr OpenProcess(u32 access, i32 inherit, i32 pid)
    i32 CloseHandle(Ptr handle)
    i32 TerminateProcess(Ptr hProcess, i32 exitCode)
    i32 GetExitCodeProcess(Ptr hProcess, Ptr exitCode)
    i32 GetCurrentProcessId()

    // 自身 exe 路径（UTF-16 出；转 UTF-8 走 ffi.utf16_to_utf8，见 exePath() ✓）
    i32 GetModuleFileNameW(Ptr hModule, Ptr buf, i32 nSize)
}

func _krnlLib(): kernel32 {
    var t = threads.local_get("w32.kernel32", null)
    if t != null { return t as kernel32 }
    kernel32 k = ffi.load("kernel32.dll")
    threads.local_set("w32.kernel32", k)
    return k
}

// 自己（当前进程）exe 的完整路径，UTF-8 出 ✓
// 用途：开机自启（注册表 Run 键里要写命令行 ✓）、"以管理员重启自己"等
// 取不到时给空串（调用方自己降级 ✓）
// 注意：用 W 版 + ffi.utf16_to_utf8 —— …FileNameA 给的是系统 ANSI（GBK）
//       ⇒ 按 UTF-8 读会乱码（路径里有中文时 ✗）
export func exePath(): string {
    Ptr[u16] w = ffi.malloc(2048)                 // UTF-16 缓冲（1024 wchar ✓）
    try {
        int n = _krnlLib().GetModuleFileNameW(null, w, 1024)
        if n <= 0 { return "" }
        return ffi.utf16_to_utf8(w)
    } finally {
        ffi.free(w)
    }
}

// ==================== PSAPI ====================
clib psapi {
    i32 EnumProcesses(Ptr lpidProcess, i32 cb, Ptr lpcbNeeded)
    i32 GetModuleBaseNameW(Ptr hProcess, Ptr hModule, Ptr lpBaseName, i32 nSize)
    i32 GetProcessMemoryInfo(Ptr hProcess, Ptr ppsmemCounters, i32 cb)
}

func _psapiLib(): psapi {
    var t = threads.local_get("w32.psapi", null)
    if t != null { return t as psapi }
    psapi p = ffi.load("psapi.dll")
    threads.local_set("w32.psapi", p)
    return p
}

// ==================== CSTRUCT ====================
// Windows PROCESS_MEMORY_COUNTERS 结构 (4 + 4 + 8*8 = 72 bytes)
cstruct PROCESS_MEMORY_COUNTERS {
    u32 cb
    u32 PageFaultCount
    u64 PeakWorkingSetSize
    u64 WorkingSetSize
    u64 QuotaPeakPagedPoolUsage
    u64 QuotaPagedPoolUsage
    u64 QuotaPeakNonPagedPoolUsage
    u64 QuotaNonPagedPoolUsage
    u64 PagefileUsage
    u64 PeakPagefileUsage
}

// ==================== 常量 ====================
// 进程访问权限
const PROCESS_QUERY_INFORMATION = 0x0400
const PROCESS_VM_READ           = 0x0010
const PROCESS_TERMINATE         = 0x0001
const STILL_ACTIVE              = 259

// ==================== face 定义 ==========================

// 进程管理器接口
export face ProcessManager {
    // 获取进程列表
    func listProcesses():Dict

    // 根据名称查找进程
    func findByName(string name):Dict

    // 终止进程
    func terminate(int pid):Dict

    // 检查进程是否存在
    func exists(int pid):bool
}

// ==================== 内部辅助函数 ====================

// 枚举所有进程 PID
func _enumProcesses():Dict {
    Ptr[u32] buffer = ffi.malloc(4096)
    Ptr[u32] needed = ffi.malloc(4)

    try {
        int result = _psapiLib().EnumProcesses(buffer, 4096, needed)

        if result == 0 {
            return {pids: [], errorCode: 5}
        }

        int count = _int(ffi.read_int(needed, 0) / 4)
        var pids = []

        for 0 : count - 1 to i {
            int pid = ffi.read_int(buffer, i * 4)
            if pid > 0 {
                pids.add(pid)
            }
        }

        return {pids: pids, errorCode: 0}
    } finally {
        ffi.free(buffer)
        ffi.free(needed)
    }
}

// 获取进程名称（通过 PID 打开进程后读取模块名）
func _getProcessName(int pid):string {
    if pid == 0 { return "System Idle Process" }

    Ptr hProcess = _krnlLib().OpenProcess(PROCESS_QUERY_INFORMATION | PROCESS_VM_READ, 0, pid)

    if not hProcess {
        return ""
    }

    try {
        Ptr[u16] buffer = ffi.malloc(512)
        try {
            int result = _psapiLib().GetModuleBaseNameW(hProcess, null, buffer, 256)

            if result > 0 {
                return ffi.utf16_to_utf8(buffer)
            }
            return ""
        } finally {
            ffi.free(buffer)
        }
    } finally {
        _krnlLib().CloseHandle(hProcess)
    }
}

// ==================== StandardProcessManager ==========================

// 标准进程管理器实现
export struct StandardProcessManager impl ProcessManager {

    // 获取进程列表（包含 PID 和名称）
    func listProcesses():Dict {
        var enumResult = _enumProcesses()
        if enumResult.errorCode != 0 {
            return {processes: [], errorCode: enumResult.errorCode}
        }

        var processes = []

        for enumResult.pids to pid {
            if pid is int {
                var name = _getProcessName(pid)
                if name != "" {
                    processes.add({pid: pid, name: name})
                }
            }
        }

        return {processes: processes, errorCode: 0}
    }

    // 根据名称查找进程（不区分大小写）
    func findByName(string name):Dict {
        var result = listProcesses()

        for result.processes to proc {
            if proc is Dict {
                if proc.name is string {
                    var pname = proc.name
                    // 2026-10-02 收编：改 native `eq_ignore_case`（逐字节 tolower、不造临时串）✓
                    if pname.eq_ignore_case(name) {
                        return {found: true, pid: proc.pid}
                    }
                }
            }
        }

        return {found: false, pid: 0}
    }

    // 终止进程
    func terminate(int pid):Dict {
        Ptr hProcess = _krnlLib().OpenProcess(PROCESS_TERMINATE, 0, pid)

        if not hProcess {
            return {success: false, errorCode: 5}
        }

        try {
            int result = _krnlLib().TerminateProcess(hProcess, 0)
            return {success: result != 0, errorCode: 0}
        } finally {
            _krnlLib().CloseHandle(hProcess)
        }
    }

    // 检查进程是否存在（通过退出码判断）
    func exists(int pid):bool {
        Ptr hProcess = _krnlLib().OpenProcess(PROCESS_QUERY_INFORMATION, 0, pid)

        if not hProcess {
            return false
        }

        Ptr[u32] exitCodePtr = ffi.malloc(4)
        int result = _krnlLib().GetExitCodeProcess(hProcess, exitCodePtr)
        int exitCode = ffi.read_int(exitCodePtr, 0)
        ffi.free(exitCodePtr)

        _krnlLib().CloseHandle(hProcess)

        if result == 0 {
            return false
        }

        return exitCode == STILL_ACTIVE
    }
}

// ==================== SafeProcessManager ==========================

// 安全的进程管理器（只读操作，不允许终止进程）
export struct SafeProcessManager impl ProcessManager {

    // 获取进程列表
    func listProcesses():Dict {
        var std = new StandardProcessManager()
        return std.listProcesses()
    }

    // 根据名称查找进程
    func findByName(string name):Dict {
        var std = new StandardProcessManager()
        return std.findByName(name)
    }

    // 终止进程 — 安全版本不允许终止
    func terminate(int pid):Dict {
        return {success: false, errorCode: 5, message: "SafeProcessManager does not support terminate"}
    }

    // 检查进程是否存在
    func exists(int pid):bool {
        var std = new StandardProcessManager()
        return std.exists(pid)
    }
}

// ==================== 辅助函数 ==========================

// 获取进程内存信息（KB 单位）
export func getProcessMemory(int pid):Dict {
    Ptr hProcess = _krnlLib().OpenProcess(PROCESS_QUERY_INFORMATION | PROCESS_VM_READ, 0, pid)

    if not hProcess {
        return {workingSet: 0, peakWorkingSet: 0, errorCode: 5}
    }

    try {
        var memCounters = PROCESS_MEMORY_COUNTERS.malloc()

        try {
            memCounters.cb = PROCESS_MEMORY_COUNTERS.size()

            int result = _psapiLib().GetProcessMemoryInfo(hProcess, memCounters.to_ptr(), PROCESS_MEMORY_COUNTERS.size())

            if result != 0 {
                return {
                    workingSet: _int(memCounters.WorkingSetSize / 1024),
                    peakWorkingSet: _int(memCounters.PeakWorkingSetSize / 1024),
                    errorCode: 0
                }
            }
            return {workingSet: 0, peakWorkingSet: 0, errorCode: 5}
        } finally {
            memCounters.free()
        }
    } finally {
        _krnlLib().CloseHandle(hProcess)
    }
}

// 获取当前进程 PID
export func getCurrentPid():int {
    return _krnlLib().GetCurrentProcessId()
}
