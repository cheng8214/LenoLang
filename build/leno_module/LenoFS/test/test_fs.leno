// LenoFS 0.1.0 自测：copytree / copy / rmtree / count（含二进制与嵌套目录）
//
// 跑法（仓库根目录）：
//   build\leno.exe build\leno_module\LenoFS\test\test_fs.leno
//
// ★ 2026-11-09（P2）：返回值从 `Dict{ok,files,dirs,err}` 改成 `Result[FsCount]`，
//   断言也一起改成 `r.isOk()` / `r.val.files` / `r.code` —— 顺带验证失败码分得清
//   （NOT_FOUND / INVALID_ARG / CONFLICT），不再只有一句 err 文本。
import files
import dirs
import strings
import "FS" as fs
import "Result" as res
use res.Result
use fs.FsCount

func fail(string msg) {
    print("[FAIL] " + msg)
    _exit(1)
}

func eqInt(int got, int want, string tag) {
    if got != want { fail(tag + "：得到 " + _str(got) + " 期望 " + _str(want)) }
}

func main_tree(string base) {
    dirs.mkdir_p(dirs.join(base, "a", "b"))
    files.write(dirs.join(base, "root.txt"), "root")
    files.write(dirs.join(base, "a", "x.txt"), "中文 x")
    files.write(dirs.join(base, "a", "b", "y.bin"), strings.from_bytes([0, 1, 2, 127, 128, 255]))
}

main() {
    string tmp = _tmpdir()
    string src = dirs.join(tmp, "lenofs_src")
    string dst = dirs.join(tmp, "lenofs_dst")

    // 清理上一次可能的残留（rmtree 幂等：不存在也算成功）
    fs.rmtree(src)
    fs.rmtree(dst)

    // ---------- ① count ----------
    main_tree(src)
    Result[FsCount] c1 = fs.count(src)
    if c1.isErr() { fail("① count 不该失败：" + c1.errText()) }
    eqInt(c1.val.fileCount, 3, "① 文件数")
    eqInt(c1.val.dirCount, 3, "① 目录数（src/a/b）")

    // ---------- ② copytree ----------
    Result[FsCount] cp = fs.copytree(src, dst)
    if cp.isErr() { fail("② copytree 失败：" + cp.errText()) }
    eqInt(cp.val.fileCount, 3, "② 复制文件数")
    eqInt(cp.val.dirCount, 3, "② 复制目录数")

    if files.read(dirs.join(dst, "root.txt")) != "root" { fail("② 根文件内容不符") }
    if files.read(dirs.join(dst, "a", "x.txt")) != "中文 x" { fail("② 中文文件内容不符") }
    string bin = files.read(dirs.join(dst, "a", "b", "y.bin"))
    eqInt(bin.byte_len(), 6, "② 二进制长度")
    if bin.byte(0) != 0 or bin.byte(5) != 255 { fail("② 二进制内容不符（NUL/0xFF）") }
    print("② copytree ok（3 文件 / 3 目录，含二进制）")

    // ---------- ③ copy 单文件 ----------
    string one = dirs.join(tmp, "lenofs_one.txt")
    Result[FsCount] c3 = fs.copy(dirs.join(src, "a", "x.txt"), one)
    if c3.isErr() { fail("③ copy 失败：" + c3.errText()) }
    if files.read(one) != "中文 x" { fail("③ copy 内容不符") }
    eqInt(c3.val.fileCount, 1, "③ 复制了 1 个文件")

    // ③b 失败码：源不存在 ⇒ NOT_FOUND
    Result[FsCount] c3b = fs.copy(dirs.join(tmp, "no_such_file_xyz"), one)
    if c3b.isOk() { fail("③b 源不存在应报错") }
    eqInt(c3b.code, res.ErrCode.NOT_FOUND, "③b 源不存在 ⇒ NOT_FOUND")

    // ③c 失败码：源是目录却用 copy ⇒ INVALID_ARG
    Result[FsCount] c3c = fs.copy(src, one)
    if c3c.isOk() { fail("③c 源是目录应报错") }
    eqInt(c3c.code, res.ErrCode.INVALID_ARG, "③c 源是目录 ⇒ INVALID_ARG")
    files.delete(one)

    // ---------- ④ rmtree ----------
    Result[FsCount] rm = fs.rmtree(dst)
    if rm.isErr() { fail("④ rmtree 失败：" + rm.errText()) }
    eqInt(rm.val.fileCount, 3, "④ 删除文件数")
    eqInt(rm.val.dirCount, 3, "④ 删除目录数")
    if files.exists(dst) { fail("④ 目标仍存在") }

    // ---------- ⑤ 删除不存在的路径：成功且计数 0（幂等）----------
    Result[FsCount] rm2 = fs.rmtree(dirs.join(tmp, "lenofs_nothing_here"))
    if rm2.isErr() { fail("⑤ 删除不存在路径应成功（幂等）") }
    eqInt(rm2.val.fileCount, 0, "⑤ 文件数")

    // ---------- ⑥ copytree 目标已被文件占用 ⇒ CONFLICT ----------
    string occupied = dirs.join(tmp, "lenofs_occupied")
    files.write(occupied, "x")
    Result[FsCount] bad = fs.copytree(src, occupied)
    if bad.isOk() { fail("⑥ 目标是文件应报错") }
    eqInt(bad.code, res.ErrCode.CONFLICT, "⑥ 目标不是目录 ⇒ CONFLICT")
    // 源不是目录 ⇒ NOT_FOUND
    Result[FsCount] bad2 = fs.copytree(occupied, dst)
    eqInt(bad2.code, res.ErrCode.NOT_FOUND, "⑥ 源是文件（非目录）⇒ NOT_FOUND")
    files.delete(occupied)

    // ---------- ⑦ 清掉源树 ----------
    Result[FsCount] rm3 = fs.rmtree(src)
    if rm3.isErr() { fail("⑦ 清理失败：" + rm3.errText()) }
    if files.exists(src) { fail("⑦ 源树仍存在") }

    print("test_fs passed（7 组断言 / Result + 失败码）")
}
