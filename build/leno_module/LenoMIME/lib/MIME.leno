// MIME.leno — 文件类型识别（纯 Leno，零原生依赖）
//
// 为什么单独成库：这张「扩展名 → MIME」表在仓库里被抄了好几份
//   （LenoHTTP/lib/http_static.leno、LenoMusic/lib/music_tag.leno …）
//   ⇒ 改一处漏一处，静态服务器和音乐标签对同一个 .jpg 可能给出不同答案。
//   而且只看扩展名识别不了"改过名的文件"——真正需要的是**魔数嗅探**。
//
// 三层 API：
//   byExt(path)    只看扩展名（快，不读盘）
//   byMagic(head)  看文件头字节（head 是字节串，前 512 字节就够）
//   detect(path)   先魔数、再扩展名（要读盘，但只读 512 字节）
//
// 取向（与仓库其它模块一致）：
//   · **识别不出就返回 ""**，不猜、不给 application/octet-stream 之类"看着像答案"的值
//   · `detect` 读不到文件（不存在/无权限）⇒ 返回 ""，不抛
//   · 魔数只做**前缀匹配**，不解析文件结构（那是 LenoImage / LenoZip / LenoXLSX 的事）
import files
import strings

// ==================== 扩展名 → MIME ====================
// 键不带点、全小写（`byExt` 会先规范化）
func _extTable(): Dict {
    return {
        // 文本 / 配置
        "txt": "text/plain", "log": "text/plain", "md": "text/markdown",
        "html": "text/html", "htm": "text/html", "css": "text/css",
        "js": "text/javascript", "mjs": "text/javascript", "json": "application/json",
        "xml": "application/xml", "csv": "text/csv", "tsv": "text/tab-separated-values",
        "yaml": "application/yaml", "yml": "application/yaml",
        "ini": "text/plain", "toml": "application/toml", "conf": "text/plain",
        "sql": "application/sql", "sh": "application/x-sh", "bat": "application/x-bat",
        "ps1": "application/x-powershell", "svg": "image/svg+xml",
        // 图片
        "png": "image/png", "jpg": "image/jpeg", "jpeg": "image/jpeg",
        "gif": "image/gif", "bmp": "image/bmp", "webp": "image/webp",
        "ico": "image/x-icon", "tif": "image/tiff", "tiff": "image/tiff",
        "avif": "image/avif", "heic": "image/heic",
        // 音频
        "mp3": "audio/mpeg", "wav": "audio/wav", "flac": "audio/flac",
        "ogg": "audio/ogg", "m4a": "audio/mp4", "aac": "audio/aac", "wma": "audio/x-ms-wma",
        // 视频
        "mp4": "video/mp4", "mkv": "video/x-matroska", "webm": "video/webm",
        "avi": "video/x-msvideo", "mov": "video/quicktime", "wmv": "video/x-ms-wmv",
        "flv": "video/x-flv", "m4v": "video/mp4",
        // 压缩 / 归档
        "zip": "application/zip", "7z": "application/x-7z-compressed",
        "rar": "application/vnd.rar", "tar": "application/x-tar",
        "gz": "application/gzip", "bz2": "application/x-bzip2",
        "xz": "application/x-xz", "zst": "application/zstd",
        // 文档 / 表格
        "pdf": "application/pdf",
        "doc": "application/msword",
        "docx": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "xls": "application/vnd.ms-excel",
        "xlsx": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
        "ppt": "application/vnd.ms-powerpoint",
        "pptx": "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "odt": "application/vnd.oasis.opendocument.text",
        "ods": "application/vnd.oasis.opendocument.spreadsheet",
        // 可执行 / 库 / 包
        "exe": "application/x-msdownload", "dll": "application/x-msdownload",
        "msi": "application/x-msi", "so": "application/x-sharedlib",
        "dylib": "application/x-sharedlib", "o": "application/x-object",
        "obj": "application/x-object", "lib": "application/x-archive",
        "a": "application/x-archive", "apk": "application/vnd.android.package-archive",
        "jar": "application/java-archive", "wasm": "application/wasm",
        "class": "application/java-vm",
        // 字体
        "ttf": "font/ttf", "otf": "font/otf", "woff": "font/woff", "woff2": "font/woff2",
        // 数据
        "db": "application/vnd.sqlite3", "sqlite": "application/vnd.sqlite3",
        "sqlite3": "application/vnd.sqlite3"
    }
}

// 扩展名规范化：取最后一个 '.' 之后、转小写；没有扩展名 ⇒ ""
func _extOfPath(string path): string {
    string name = path
    int slash = -1
    int i = 0
    while i < name.len() {
        if name[i] == "\\" or name[i] == "/" { slash = i }
        i = i + 1
    }
    if slash >= 0 { name = strings.slice(name, slash + 1, name.len() - 1) }
    int dot = -1
    i = 0
    while i < name.len() {
        if name[i] == "." { dot = i }
        i = i + 1
    }
    if dot < 0 or dot + 1 >= name.len() { return "" }
    return strings.to_lower(strings.slice(name, dot + 1, name.len() - 1))
}

// 只看扩展名（不读盘）。识别不出 ⇒ ""
export func byExt(string path): string {
    string e = _extOfPath(path)
    if e == "" { return "" }
    var t = _extTable()
    if t.has(e) { return t.get(e, "") as string }
    return ""
}

// ==================== 魔数 ====================
func _has(Array[int] b, int off, Array[int] sig): bool {
    if off < 0 or off + sig.len() > b.len() { return false }
    for 0:sig.len()-1 to i {
        if b[off + i] != sig[i] { return false }
    }
    return true
}

// 按文件头识别。head 传**字节串**（`files.open().read(512)` 的结果或其 to_bytes 均可）
//   · 识别不出 ⇒ ""
//   · ZIP 与 OOXML（docx/xlsx/pptx）魔数相同 ⇒ 只报 application/zip（要看内部结构才行）
export func byMagic(string head): string {
    if head == "" { return "" }
    Array[int] b = head.to_bytes()
    if b.len() < 2 { return "" }

    // 图片
    if _has(b, 0, [0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A]) { return "image/png" }
    if _has(b, 0, [0xFF, 0xD8, 0xFF]) { return "image/jpeg" }
    if _has(b, 0, [0x47, 0x49, 0x46, 0x38]) { return "image/gif" }
    if _has(b, 0, [0x42, 0x4D]) and b.len() > 14 { return "image/bmp" }
    if _has(b, 0, [0x49, 0x49, 0x2A, 0x00]) or _has(b, 0, [0x4D, 0x4D, 0x00, 0x2A]) { return "image/tiff" }
    if _has(b, 0, [0x00, 0x00, 0x01, 0x00]) and b.len() > 6 { return "image/x-icon" }
    if _has(b, 0, [0x52, 0x49, 0x46, 0x46]) {
        if _has(b, 8, [0x57, 0x45, 0x42, 0x50]) { return "image/webp" }
        if _has(b, 8, [0x57, 0x41, 0x56, 0x45]) { return "audio/wav" }
        if _has(b, 8, [0x41, 0x56, 0x49, 0x20]) { return "video/x-msvideo" }
    }
    // 文档
    if _has(b, 0, [0x25, 0x50, 0x44, 0x46]) { return "application/pdf" }
    // 归档
    if _has(b, 0, [0x50, 0x4B, 0x03, 0x04]) { return "application/zip" }
    if _has(b, 0, [0x37, 0x7A, 0xBC, 0xAF, 0x27, 0x1C]) { return "application/x-7z-compressed" }
    if _has(b, 0, [0x52, 0x61, 0x72, 0x21, 0x1A, 0x07]) { return "application/vnd.rar" }
    if _has(b, 0, [0x1F, 0x8B]) { return "application/gzip" }
    if _has(b, 0, [0x42, 0x5A, 0x68]) { return "application/x-bzip2" }
    if _has(b, 0, [0xFD, 0x37, 0x7A, 0x58, 0x5A, 0x00]) { return "application/x-xz" }
    if _has(b, 0, [0x28, 0xB5, 0x2F, 0xFD]) { return "application/zstd" }
    if _has(b, 257, [0x75, 0x73, 0x74, 0x61, 0x72]) { return "application/x-tar" }   // 257 处 "ustar"
    // 复合文档（老 Office：doc/xls/ppt/msi）
    if _has(b, 0, [0xD0, 0xCF, 0x11, 0xE0, 0xA1, 0xB1, 0x1A, 0xE1]) { return "application/x-ole-storage" }
    // 可执行 / 库
    if _has(b, 0, [0x7F, 0x45, 0x4C, 0x46]) { return "application/x-elf" }
    if _has(b, 0, [0x4D, 0x5A]) { return "application/x-msdownload" }              // MZ
    if _has(b, 0, [0x00, 0x61, 0x73, 0x6D]) { return "application/wasm" }
    if _has(b, 0, [0xCA, 0xFE, 0xBA, 0xBE]) { return "application/java-vm" }
    // 媒体
    if _has(b, 0, [0x49, 0x44, 0x33]) { return "audio/mpeg" }                      // ID3
    if b.len() > 2 and b[0] == 0xFF and (b[1] == 0xFB or b[1] == 0xF3 or b[1] == 0xF2) { return "audio/mpeg" }
    if _has(b, 0, [0x66, 0x4C, 0x61, 0x43]) { return "audio/flac" }                // fLaC
    if _has(b, 0, [0x4F, 0x67, 0x67, 0x53]) { return "audio/ogg" }                 // OggS
    if _has(b, 4, [0x66, 0x74, 0x79, 0x70]) { return "video/mp4" }                 // ftyp（mp4/mov/m4a）
    if _has(b, 0, [0x1A, 0x45, 0xDF, 0xA3]) { return "video/x-matroska" }          // mkv/webm
    // 数据
    if _has(b, 0, [0x53, 0x51, 0x4C, 0x69, 0x74, 0x65, 0x20, 0x66, 0x6F, 0x72, 0x6D, 0x61, 0x74, 0x20, 0x33, 0x00]) {
        return "application/vnd.sqlite3"
    }
    return ""
}

// ==================== 检测 ====================
// 先看文件头（读 512 字节），识别不出再退回扩展名。读不到文件 ⇒ ""
export func detect(string path): string {
    var head = ""
    try {
        var f = files.open(path, "rb")
        try {
            head = f.read(512)
        } finally {
            f.close()
        }
    } catch ex {
        return ""
    }
    string m = byMagic(head)
    if m != "" { return m }
    return byExt(path)
}

// 只看文件头（已知内容、不想再读盘时用；如 HTTP 静态服务已经有内容）
export func detectBytes(string head, string pathHint): string {
    string m = byMagic(head)
    if m != "" { return m }
    return byExt(pathHint)
}

// ==================== 分类 ====================
// "image" / "video" / "audio" / "text" / "archive" / "font" / "executable" / "document" / "other"
export func kindOf(string mime): string {
    if mime == "" { return "other" }
    if strings.starts_with(mime, "image/") { return "image" }
    if strings.starts_with(mime, "video/") { return "video" }
    if strings.starts_with(mime, "audio/") { return "audio" }
    if strings.starts_with(mime, "font/") { return "font" }
    if strings.starts_with(mime, "text/") { return "text" }
    if mime == "application/json" or mime == "application/xml" or mime == "application/yaml"
        or mime == "application/toml" or mime == "application/sql"
        or mime == "application/x-sh" or mime == "application/x-bat"
        or mime == "application/x-powershell" or mime == "image/svg+xml" { return "text" }
    if mime == "application/zip" or mime == "application/x-7z-compressed"
        or mime == "application/vnd.rar" or mime == "application/x-tar"
        or mime == "application/gzip" or mime == "application/x-bzip2"
        or mime == "application/x-xz" or mime == "application/zstd" { return "archive" }
    if mime == "application/x-msdownload" or mime == "application/x-elf"
        or mime == "application/x-sharedlib" or mime == "application/x-object"
        or mime == "application/x-archive" { return "executable" }
    if mime == "application/pdf" or mime == "application/x-ole-storage"
        or strings.starts_with(mime, "application/vnd.openxmlformats-")
        or strings.starts_with(mime, "application/vnd.oasis.")
        or mime == "application/msword" or mime == "application/vnd.ms-excel"
        or mime == "application/vnd.ms-powerpoint" { return "document" }
    return "other"
}

// 是否文本类（能当字符串安全读的）
//   ⚠ `image/svg+xml` 是**两边都算**的特例：`kindOf` 判 image（它确实当图片用），
//     但内容是可读 XML ⇒ `isText` 也 true（不然"预览 SVG 源码"就没法用）
export func isText(string mime): bool {
    if mime == "image/svg+xml" { return true }
    return kindOf(mime) == "text"
}

// 是否图片
export func isImage(string mime): bool {
    return kindOf(mime) == "image"
}

// 常用扩展名（不含点）。同一个 MIME 有多个扩展名时给最常用的那个
export func extOf(string mime): string {
    if mime == "image/jpeg" { return "jpg" }
    if mime == "text/plain" { return "txt" }
    if mime == "application/x-msdownload" { return "exe" }
    if mime == "application/vnd.sqlite3" { return "db" }
    if mime == "audio/mpeg" { return "mp3" }
    if mime == "video/mp4" { return "mp4" }
    if mime == "application/x-ole-storage" { return "doc" }
    if mime == "application/zip" { return "zip" }
    // 其余：反查表（第一个遇到的扩展名）
    var t = _extTable()
    for t to k {
        if (t.get(k, "") as string) == mime { return k as string }
    }
    return ""
}
