// sdl_progress.leno — 进度条控件
// 通过 win.addProgressBar({...}) 创建，只读显示进度（可 set_value 设定）；
// 开启 clickable 后点击/拖拽可设定进度（像可交互进度条），回调 on_change(float)
//
// ★ 2026-10-07 起，本文件同时是**进度条观感的唯一来源**（供别的控件复用 ✓）：
//   · `drawBar` / `barTrackColor` / `barFillColor` / `barTextColor` —— Table 的 `progress`
//     单元格就调它们画条（在那之前，表格只能把进度**写成文字** ✗）
//   · `parseProgress` —— "进度值写成文本"的解析规则（Table 的进度单元格靠它取值 ✓）
//   为什么必须同源：本仓两次踩过"单元格观感与真控件不一致"（见 sdl_table 里复选框那段注释）
//   ⇒ 轨道/填充/圆角的实现**只有这一份**，改这里两边一起变 ✓（再让调用方自己调色 = 又埋一次 ✗）
import maths
import strings   // parseProgress 用 `to_codepoints` 自校验（不直接 _float，理由见该函数 ✓）
import "sdl_opts.leno" as dochk    // 选项对账：不认识的键会报一行警告（见 sdl_opts.leno ✓）
import "sdl_renderer.leno" as ren; use ren.Renderer
import "sdl_font.leno" as fnt; use fnt.Font
import "sdl_event.leno" as evt; use evt.Event
import "sdl_core.leno" as core; use core.SystemCursor
import "sdl_widget.leno" as wgt; use wgt.Widget
import "sdl_theme.leno" as theme; use theme.(Theme, Themeable)
use theme.Color
import "sdl_tooltip.leno" as tip


// 本控件认的键 —— 由本文件全部 `.get("…")` **自动抽取**（是超集 ⇒ 可少报、不误报 ✓）
//   ⚠ 以后增删选项请重跑抽取（或人工核对），否则可能对合法用法误报 ✓
func _opts_keys(): Array[string] {
    return [
"anim_speed", "clickable", "cursor", "enabled", "fill_color", "font_path", "font_size", "font_style", "h", "max", "min", "show_text", "text_color", "tip", "track_color", "value", "visible", "w", "x", "y"
]
}
export struct ProgressBar impl Widget {
    float x = 0.0, y = 0.0, w = 200.0, h = 20.0
    float minV = 0.0, maxV = 100.0, value = 0.0
    pri bool clickable = false, showText = true
    pri string fontPath = ""; float _fontSize = 15.0; pri int fontStyle = 0; Font? _font
    pri Color trkColor = #3C3C48FF          // 轨道背景色
    pri Color fillColor = #3CC850FF     // 已选填充色
    pri Color txtColor = #EBEBF5FF                // 文字色
    pri int cursor = SystemCursor.POINTER
    bool hover = false; pri bool wasHover = false; bool _dragging = false; bool enabled = true; bool visible = true; bool _loaded = false
    string _tip = ""
    pri float animVal = 0.0, animTarget = 0.0, animLast = 0.0, animSpeed = 12.0; pri bool animating = false
    pri float fontH = 0.0          // 字体行高缓存（字体不变时为常量，避免每帧 measureString）
    pri func(float):void onChange

    pri func ratio(): float {
        float span = maxV - minV
        if span <= 0.0 { return 0.0 }
        return maths.max(0.0, maths.min((animVal - minV) / span, 1.0))
    }

    pri func ensure_font() {
        if _font == null or not _font.ok {
            if _font != null and _font.ok { fnt.releaseFont(_font) }
            if fontPath != "" { _font = fnt.acquireFont(fontPath, _fontSize) }
            else { _font = fnt.acquireFontAuto(_fontSize) }
            if _font.ok and fontStyle != 0 { _font.setStyle(fontStyle) }
            if _font.ok { var[float, float](_agw, _agh) = _font.measureString("Ag"); fontH = _agh }
        }
    }

    // ==================== set 初始化 ====================

    func set(Dict opts) {
        dochk.check("sdl_progress", opts, _opts_keys())   // ★ 选项对账（2026-09-29 铺开 ✓）
        Theme th = theme.getTheme()
        // ★ 走导出的取色函数（**同一处映射**）⇒ Table 的进度单元格与这里不会各调各的 ✓
        trkColor = barTrackColor(th)
        fillColor = barFillColor(th)
        txtColor = barTextColor(th)
        x         = opts.get("x", 0)
        y         = opts.get("y", 0)
        w         = opts.get("w", 200)
        h         = opts.get("h", 20)
        minV      = opts.get("min", 0.0)
        maxV      = opts.get("max", 100.0)
        value     = opts.get("value", 0.0)
        clickable = opts.get("clickable", false)
        showText  = opts.get("show_text", true)
        _fontSize = opts.get("font_size", 15)
        fontPath = opts.get("font_path", "")
        fontStyle = opts.get("font_style", 0)

        // 颜色：opts 未传或类型不匹配则保持默认值
        if opts.get("track_color") is Color => t { trkColor = t }
        if opts.get("fill_color") is Color => t { fillColor = t }
        if opts.get("text_color") is Color => t { txtColor = t }

        cursor = opts.get("cursor", SystemCursor.POINTER)
        enabled = opts.get("enabled", true)
        visible = opts.get("visible", true)
        // hover/_wasHover/_dragging 默认见字段声明
        value = maths.max(minV, maths.min(value, maxV))
        animVal = value; animTarget = value; animating = false; animLast = 0.0
        animSpeed = opts.get("anim_speed", 12.0)
        _tip = opts.get("tip", "")
        ensure_font()
        _loaded = true
    }

    // ==================== 设置方法 ====================
    func set_value(float v) {
        float nv = maths.max(minV, maths.min(v, maxV))
        if nv != value {
            value = nv
            animTarget = nv
            animating = true
            animLast = 0.0
            if onChange != null { onChange(value) }
        }
    }
    func get_value(): float      { return value }
    func get_display_value(): float { return animVal }   // 动画当前显示值（用于观察过渡）
    func set_enabled(bool e)      { enabled = e }
    func set_visible(bool v)       { visible = v }
    func is_visible(): bool        { return visible }
    func set_font_size(float s)   { _fontSize = s; if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null }
    func get_x(): float           { return x }
    func get_y(): float           { return y }
    func get_w(): float          { return w }
    func get_h(): float          { return h }
    func set_pos(float px, float py) { x = px; y = py }
    func set_size(float sw, float sh) { w = sw; h = sh }

    func on_change(func(float):void cb) { onChange = cb }

    func contains(float mx, float my): bool {
        return mx >= x and mx <= x + w and my >= y and my <= y + h
    }

    pri func value_from_x(float mx): float {
        float t = (mx - x) / w
        if t < 0.0 { t = 0.0 }
        if t > 1.0 { t = 1.0 }
        return maths.max(minV, maths.min(minV + t * (maxV - minV), maxV))
    }

    // ==================== 交互 ====================
    func process(Event ev) {
        if not _loaded { return }
        if not visible { return }
        if not enabled { hover = false; _dragging = false; return }
        if not clickable {
            // 只读模式：仅处理悬停提示，不改变 hover 状态（避免与可交互模式的 hover 冲突）
            if ev.isMouseMotion() {
                var[float, float](mx, my) = ev.mousePos()
                if contains(mx, my) and _tip != "" { tip.tipReport(_tip, mx, my) }
                core.markFrameMotion()
            }
            hover = false; return
        }
        // 弹层捕获：事件落在“他人的弹层（如打开的菜单/下拉）范围内时忽略，避免穿透到下层控件
        var[float, float](mx, my) = ev.mousePos()
        if ev.isMouseWheel() { mx = ev.wheelMouseX(); my = ev.wheelMouseY() }
        if core.inPopupCapture(mx, my) { return }


        if ev.isMouseMotion() {
            var[float, float](mx, my) = ev.mousePos()
            wasHover = hover
            hover = contains(mx, my)
            if _dragging {
                value = value_from_x(mx)
                animVal = value          // 拖拽时实时跟随，取消动画延迟
                animating = false
                if onChange != null { onChange(value) }
                core.markFrameRedraw()
            } else if wasHover != hover {
                core.markFrameRedraw()    // hover 变化也需重绘（颜色高亮）
            } else {
                core.markFrameMotion()
            }
            if cursor >= 0 {
                if hover { core.requestCursor(cursor) }
            }
        }

        if ev.isMouseButtonUp() { _dragging = false }

        if ev.isMouseButtonDown() and not _dragging {
            var[float, float](_dmx, _dmy) = ev.mousePos()
            if contains(_dmx, _dmy) {
                _dragging = true
                value = value_from_x(_dmx)
                animTarget = value
                animating = true          // 单击跳转：从当前显示位置平滑动画过去
                animLast = 0.0
                if onChange != null { onChange(value) }
            }
        }
    }

    // ==================== 动画步进（每帧由 render 调用） ====================
    pri func step_anim() {
        if not animating { return }
        if animSpeed <= 0.0 { animVal = animTarget; animating = false; return }  // 关闭动画：立即到位
        float now = _float(core.getTicks())
        float dt = 0.0
        if animLast > 0.0 { dt = (now - animLast) / 1000.0 }
        animLast = now
        float diff = animTarget - animVal
        float ad = diff
        if ad < 0.0 { ad = -ad }
        float eps = (maxV - minV) * 0.001
        if eps < 0.0001 { eps = 0.0001 }
        if ad <= eps {
            animVal = animTarget
            animating = false
        } else if dt > 0.0 {
            float f = animSpeed * dt
            if f > 1.0 { f = 1.0 }
            animVal += diff * f
        }
    }

    // ==================== 渲染 ====================
    func render(Renderer r) {
        if not _loaded { return }
        if not visible { return }
        ensure_font()
        step_anim()
        if animating { core.requestRedraw() }

        // 轨道 + 填充：几何与配色**统一走 drawBar** ✓（Table 的进度单元格调的就是这一份）
        //   disabled 时颜色减半 —— 仍是本控件的行为，原样保留 ✓
        float ratio = ratio()   // 下面的百分比文字还要用 ⇒ 这个局部保留 ✓
        Color trkC = trkColor
        if not enabled { trkC = theme.packColor(theme.colorR(trkColor) / 2, theme.colorG(trkColor) / 2, theme.colorB(trkColor) / 2) }
        Color filC = fillColor
        if not enabled { filC = theme.packColor(theme.colorR(fillColor) / 2, theme.colorG(fillColor) / 2, theme.colorB(fillColor) / 2) }
        drawBar(r, x, y, w, h, ratio, trkC, filC)

        // 文字（百分比）
        if showText and _font != null and _font.ok {
            int pct = _int(ratio * 100.0)
            string label = $"{pct}%"
            var[float, float](tw, th) = _font.measureString(label)
            float tx = x + w / 2.0 - tw / 2.0
            float ty = y + h / 2.0 - th / 2.0
            Color tc = txtColor
            if not enabled { tc = theme.packColor(theme.colorR(txtColor) / 2, theme.colorG(txtColor) / 2, theme.colorB(txtColor) / 2) }
            r.drawText(_font, label, tx, ty, tc)
        }
    }

    func dispose() {
        if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null
    }
}

// 工厂
export func createProgressBar(Dict opts): ProgressBar {
    ProgressBar p = new ProgressBar(); p.set(opts); return p
}

// ==================== 供其它控件复用的观感 / 取值规则（2026-10-07 新增）====================
// 见文件头：**这里是进度条观感的唯一来源**（Table 的 progress 单元格就调它 ✓）

// 默认配色（映射只写在这一处 ⇒ 两边不可能各调各的 ✓）
export func barTrackColor(Theme th): Color { return th.bgAlt }
export func barFillColor(Theme th): Color { return th.btnSuccess }
export func barTextColor(Theme th): Color { return th.txt }

// 把进度条画进**任意矩形**（轨道 + 填充；几何与 render() 完全一致 ⇒ 两处同源 ✓）
//   ratio 先夹到 0..1：调用方的比例来自解析/计算，夹一下省得画反 ✗
export func drawBar(Renderer r, float x, float y, float w, float h, float ratio, Color track, Color fill) {
    if w <= 0.0 or h <= 0.0 { return }
    float rt = ratio
    if rt < 0.0 { rt = 0.0 }
    if rt > 1.0 { rt = 1.0 }
    r.setColor(track)
    r.fillRoundedRect(x, y, w, h, h / 2.0)
    float fillW = rt * w
    if fillW > 1.0 {
        r.setColor(fill)
        r.fillRoundedRect(x, y, fillW, h, h / 2.0)
    }
}

// 进度值的**文本表示**规则（Table 的 progress 单元格靠它取值 ✓）
//   接受：`0.37` / `37` / `37%` / `  100  `（前后空白忽略）、`-1`（越界会夹住）
//   规则：带 `%` ⇒ 百分数；否则 **> 1 当百分数、≤ 1 当比例**（`1` 与 `100` 都是 100% ✓）
//   非法（字母/中文/两个小数点/空串，如"等待中"）一律当 **0** ⇒ 画成空条，**不抛错** ✓
//   ⚠ 为什么不直接 `_float(s)`：它对非法串会 `native_throw_error`（"无法将字符串转换为浮点数"）
//     —— 而这列文本是**应用随手写的**（"等待中"很常见）⇒ 不接住就把整帧打断 ✗
//     （`try/catch` 确实接得住 —— 本仓的 `sdl_table.to_float` 就是这么包的 ✓ —— 但那是"每格
//      每帧走一次异常"，在渲染循环里太重 ✗ ⇒ 还是先按码点自校验、再自己算数值更省也更明确 ✓
//      `to_codepoints` 一趟取完 ⇒ O(n) 且不造临时串 ✓）
export func parseProgress(string s): float {
    if s == null { return 0.0 }
    Array[int] cps = strings.to_codepoints(s)
    int i = 0
    int j = cps.len() - 1
    while i <= j and isBlank(cps[i]) { i = i + 1 }        // 前导空白
    bool percent = false
    if i <= j and cps[j] == 37 { percent = true; j = j - 1 }   // 37 = '%'
    while i <= j and isBlank(cps[j]) { j = j - 1 }        // 尾部空白
    if j < i { return 0.0 }
    bool neg = false
    if cps[i] == 45 { neg = true; i = i + 1 }             // 45 = '-'
    eif cps[i] == 43 { i = i + 1 }                        // 43 = '+'
    if j < i { return 0.0 }                               // 只有符号 ⇒ 非法
    float v = 0.0
    bool hasDigit = false        // ⚠ 不能叫 `any` —— 那是保留字（类型名）✗
    bool dot = false
    float div = 1.0
    for i : j to k {
        int c = cps[k]
        if c >= 48 and c <= 57 {                          // '0'..'9'
            hasDigit = true
            if dot {
                div = div * 10.0
                v = v + _float(c - 48) / div
            } else {
                v = v * 10.0 + _float(c - 48)
            }
        } eif c == 46 {                                   // 46 = '.'
            if dot { return 0.0 }                         // 两个小数点 ⇒ 非法
            dot = true
        } else {
            return 0.0                                    // 其它字符（字母/中文/中间夹空白…）⇒ 非法
        }
    }
    if not hasDigit { return 0.0 }
    if neg { v = 0.0 - v }
    if percent { v = v / 100.0 } eif v > 1.0 { v = v / 100.0 }
    if v < 0.0 { v = 0.0 }
    if v > 1.0 { v = 1.0 }
    return v
}

// 空白（空格 / 制表 / 换行 / 回车）—— `parseProgress` 两端修剪用
func isBlank(int c): bool { return c == 32 or c == 9 or c == 10 or c == 13 }


