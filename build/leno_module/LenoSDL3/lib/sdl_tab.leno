// sdl_tab.leno — 选项卡容器控件（TabControl）
// 多页签切换容器：顶部标签栏（点击切换页）+ 内容区（仅当前页子控件参与事件与绘制）。
//
// 用法（与 Panel/布局一致：子控件用 SDL3.createXxx 创建，不在窗口注册，避免双重处理）：
//   TabControl tab = win.addTabControl({x, y, w, h, tabs: ["常规", "高级"], active: 0})
//   // 子控件坐标按「内容区左上角」给出（dx, dy 相对内容区），Tab 移动/缩放时内部整体跟随：
//   tab.addToPage(0, SDL3.createButton({w: 120, h: 32, text: "页1按钮"}), 50, 80)
//   tab.addToPage(1, SDL3.createSlider({...}), 30, 20)
//   tab.on_change(func(int idx){ print($"切到页 {idx}") })
//
// 说明：每页子控件以「内容区左上角」为原点布置（创建时给定的坐标会被记录为相对偏移），
//       TabControl 每帧以「内容区原点 + 相对偏移」重排子控件，因此移动/缩放 Tab 时内部整体跟随，
//       与布局容器（HBox/VBox/AnchorBox）的每帧 _relayout 同一机制。内容区裁剪到 (x, y+tab_h, w, h-tab_h)。
import "sdl_renderer.leno" as ren; use ren.Renderer
import "sdl_opts.leno" as dochk    // 选项对账：不认识的键会报一行警告（见 sdl_opts.leno ✓）
import "sdl_event.leno" as evt; use evt.Event
import "sdl_font.leno" as fnt; use fnt.Font
import "sdl_core.leno" as core; use core.(SystemCursor, SDL_Rect, sdl3)
import "sdl_widget.leno" as wgt; use wgt.Widget
import "sdl_edit.leno" as edt; use edt.Edit
import "sdl_layout.leno" as lay; use lay.HBox; use lay.VBox; use lay.AnchorBox
import "sdl_combobox.leno" as cbx; use cbx.ComboBox
import "sdl_panel.leno" as pnl; use pnl.Panel
import "sdl_table.leno" as tbl; use tbl.Table
import "sdl_menu.leno" as menu     // 切页时收掉残留的右击菜单（见 closePopups 的注释 ✓）
import "sdl_treeview.leno" as tvlib; use tvlib.TreeView
import "sdl_image.leno" as img     // 标签图标纹理（tab_icons ✓ 2026-10-26）
import "sdl_theme.leno" as theme; use theme.(Theme, Themeable)
use theme.Color


// 本控件认的键 —— 由本文件全部 `.get("…")` **自动抽取**（是超集 ⇒ 可少报、不误报 ✓）
//   ⚠ 以后增删选项请重跑抽取（或人工核对），否则可能对合法用法误报 ✓
func _opts_keys(): Array[string] {
    return [
"accent_color", "active", "active_color", "active_text_color", "bar_color", "bg_color", "border", "border_color", "clip", "cursor", "enabled", "font_path", "font_size", "font_style", "h", "show_header", "tab_color", "tab_h", "tab_icon_size", "tab_icons", "tab_radius", "tabs", "text_color", "underline", "visible", "w", "x", "y"
]
}
export struct TabControl impl Widget, Themeable {
    float x = 0.0, y = 0.0, w = 400.0, h = 300.0
    pri float tabH = 32.0         // 标签栏高度
    pri bool showHeader = true    // 是否绘制标签栏：false = 只当「纯页面容器」用，靠外部按钮 set_active 切页 ✓
    bool _drawBorder = true    // 是否画内容区边框（默认 true = 老行为 ✓）
    pri bool clipContent = true   // 是否把页面内容裁剪到内容区（`clip:false` 关闭；默认 true = 老行为 ✓）
    Array[string] _tabs = []     // 各页标题
    // 标签图标（与 `_tabs` 并行的图片路径，"" = 该页无图标）
    //   纹理按需加载并缓存；`tab_icon_size` 默认 16（48 源图的 1/3，整数倍不丢线 ✓）
    Array[string] _tabIcons = []
    pri float tabIconSize = 16.0
    pri Array[Ptr[u8]?] _iconTex = []
    pri Array[string] _iconLoaded = []
    pri Array[Array[Widget]] pages = []  // 每页的子控件集合（仅当前页被处理/绘制）
    Array[VBox] _pageLayouts = []    // 每页的布局容器
    Array[bool] _hasLayout = []       // 每页是否设置了布局容器
    pri Array[Array[Array[float]]] rel = []  // 每页每子控件相对「内容区原点」的偏移 [relX, relY]
    // ==== 同页混用两种定位方式的自检（每页只提示一次 ✓）====
    //   本模块支持两种页面定位：
    //     ① 绝对：`addToPage(page, c, dx, dy)`
    //     ② 布局：`setPageLayout(page, VBox)` + `addToPageLayout(page, c, opts)`
    //   同一页**混用** ⇒ 绝对定位的控件不参与布局流 ⇒ 窗口缩放时与布局内容重叠/错位 ✗
    //   （`dashboard.leno` 头部注释记录的"中间状态"就是这一类 ✓）
    //   仓库现状：每页都只用一种 ⇒ 本检查在既有代码上**零命中**（已实跑全仓确认 ✓）
    pri Array[bool] mixWarned = []
    int _active = 0            // 当前激活页索引
    pri int hover = -1            // 悬停的标签索引，-1 无
    bool _loaded = false
    pri Ptr[u8] hwnd              // 绑定的窗口句柄，下发给需要它的子控件（如 Edit 的 IME）

    // 字体（画标签文字）
    float _fontSize = 15.0; pri string fontPath = ""; pri int fontStyle = 0; Font? _font
    // 标签宽度缓存（避免每次 _tabRects 都 measureString）
    pri Array[float] tabW = []
    pri bool tabDirty = true

    // 配色
    pri Color bgColor = #262830FF       // 内容区背景
    pri Color barColor = #232332FF      // 标签栏背景
    pri Color tabColor = #2C2E36FF      // 非激活标签
    // 标签底圆角：0 = 方角（老行为）；等于 tab_h/2 就是"胶囊" ✓
    pri float tabRadius = 8.0
    // 激活标签下方的下划线：默认画（老观感）；用胶囊底时应当关掉（有底色再加线很脏 ✓）
    pri bool showUnderline = true
    pri Color actColor = #3C96EBFF     // 激活标签
    pri Color txtColor = #78808CFF     // 文字色（非激活）
    pri Color actTxtColor = #EBEBF5FF  // 激活文字色
    pri Color accColor = #50A0F5FF     // 激活标签下划线
    pri Color brdColor = #5A5F6EFF     // 边框色
    pri int cursor = SystemCursor.POINTER
    bool enabled = true, visible = true
    pri func(int):void onChange

    pri func ensure_font() {
        if _font == null or not _font.ok {
            if _font != null and _font.ok { fnt.releaseFont(_font) }
            if fontPath != "" { _font = fnt.acquireFont(fontPath, _fontSize) }
            else { _font = fnt.acquireFontAuto(_fontSize) }
            if _font.ok and fontStyle != 0 { _font.setStyle(fontStyle) }
            tabDirty = true   // 字体变化，标签宽度需重算
        }
    }


    func set(Dict opts) {
        dochk.check("sdl_tab", opts, _opts_keys())   // ★ 选项对账（2026-09-29 铺开 ✓）
        Theme th = theme.getTheme()
        bgColor = th.bg
        barColor = th.bgInput
        tabColor = th.bgAlt
        actColor = th.accent
        txtColor = th.txtDim
        actTxtColor = th.txt
        accColor = th.accentBright
        brdColor = th.border
        x    = opts.get("x", 0)
        y    = opts.get("y", 0)
        w    = opts.get("w", 400)
        h    = opts.get("h", 300)
        tabH = opts.get("tab_h", 32)
        // 隐藏标签栏（默认 false 之外都是老行为 ✓）。用途：像侧栏导航那样用**外部按钮**切页时，
        // 标签栏是多余的；注意**不能**用 `tab_h:0` 代替 ✗ —— render 里标签文字画在 `y - 文字高/2`、
        // 下划线画在 `y - 3`，只是靠"Tab 恰好在窗口最上沿被裁掉"才看不见，一旦 Tab 不在最上沿
        // 就会画到 Tab 外面去 ✗（`show_header:false` 是整条不画 ✓）。
        // ⚠ `tabs` 仍然要照常传：`set_active` 会按 `_tabs.len()` 校验下标 ✓
        showHeader = opts.get("show_header", true)
        _drawBorder = opts.get("border", true)
        // 关掉内容区裁剪：页面内容（如整页 ScrollView）自己有裁剪时这层是冗余的 ✓
        clipContent = opts.get("clip", true)

        // 标签图标（与 `tabs` 并行的图片路径；"" = 该页无图标）
        //   原来只能传文字 ⇒ 设置页那种「常规/下载/外观」想带图标只能自己拼
        var ti = opts.get("tab_icons", [])
        if ti is Array[string] {
            _tabIcons = ti as Array[string]
            tabIconSize = opts.get("tab_icon_size", 16.0)
            _iconTex = []
            _iconLoaded = []
            for _tabIcons.len() to k { _iconTex.add(null); _iconLoaded.add("") }
        }

        var ts = opts.get("tabs", [])
        Array[string] newTabs = []
        if ts is Array[string] { newTabs = ts as Array[string] }
        bool samePages = (newTabs.len() == _tabs.len()) and (_pageLayouts.len() == newTabs.len())
        _tabs = newTabs
        tabDirty = true   // 标签列表变化，宽度需重算
        // ★ 2026-10-13 修：**页数没变就不重建页容器** —— 原来每次 `set()` 都把 `pages/rel/_pageLayouts`
        //   整个清空 ✗ ⇒ "运行时改配色/字号"（`set(同 opts + 改一个颜色)`）会把**整页内容丢掉**：
        //   实测页里的按钮**当场消失**、点击也不再响应 ✗（截图只剩标签条 ✓）。
        //   同数量的重配只该改外观，不该动内容 ✓ —— 这也与 `Card.set` 那种"运行时改样式"的用法一致 ✓
        //   ⚠ 页数**变了**才重建（此时旧的页子控件会被丢弃）：**故意不 dispose** —— 那些控件是
        //     应用创建并持有的（等会儿可能又要重新 add ✓），框架替它释会变成"释放后再用"✗
        if not samePages {
            pages = []
            rel = []
            _pageLayouts = []
            _hasLayout = []
            for _tabs.len() to i {
                pages.add([])
                rel.add([])
                _pageLayouts.add(new VBox())
                _hasLayout.add(false)
            }
        }

        // ⚠ `active` 缺省值取**当前页**（不是 0 ✓）：二次 set 只改配色时不该把页签跳回第 0 页 ✗
        //   （首次 set 时 `_active` 就是字段初值 0 ⇒ 与老行为一致 ✓）
        _active = opts.get("active", _active)
        if _active < 0 or _active >= _tabs.len() { _active = 0 }

        _fontSize = opts.get("font_size", 15)
        fontPath = opts.get("font_path", "")
        fontStyle = opts.get("font_style", 0)

        // 颜色：opts 未传则保持默认值
        if opts.get("bg_color") is Color => t { bgColor = t }
        if opts.get("border_color") is Color => t { brdColor = t }
        if opts.get("active_color") is Color => t { actColor = t }
        if opts.get("accent_color") is Color => t { accColor = t }
        // ★ 2026-10-13 补：**标签栏底 / 非激活标签底 / 两种文字色**以前**只能跟主题** ✗ ——
        //   应用想把页签融进自己的配色（暗色内容区 + 橙色下划线）时做不到，只能顶着主题那套灰条
        //   （海报墙实测："列表"那排看着像外挂进来的一块 ✗）⇒ 一并暴露成 opts ✓
        if opts.get("bar_color") is Color => t { barColor = t }
        if opts.get("tab_color") is Color => t { tabColor = t }
        tabRadius = opts.get("tab_radius", 8.0)
        if tabRadius < 0.0 { tabRadius = 0.0 }
        showUnderline = opts.get("underline", true)
        if opts.get("text_color") is Color => t { txtColor = t }
        if opts.get("active_text_color") is Color => t { actTxtColor = t }

        cursor = opts.get("cursor", SystemCursor.POINTER)
        hover = -1   // 重置悬停标签（二次 set 时归零）
        enabled = opts.get("enabled", true)
        visible = opts.get("visible", true)
        ensure_font()
        _loaded = true
    }

    // ==================== 布局接口（可被嵌套进其它布局） ====================
    func get_w(): float { return w }
    func get_h(): float { return h }
    func set_pos(float px, float py) { x = px; y = py }
    func set_size(float sw, float sh) { w = sw; h = sh }
    func get_x(): float { return x }
    func get_y(): float { return y }

    // ==================== 设置方法 ====================
    // 表头实际占用的高度：`show_header:false` 时内容区就从 (x, y) 开始 ⇒
    // 所有「内容区原点/高度」的计算都走这里，隐藏表头才不会有 32px 的空白 ✗
    pri func hdrH(): float {
        if showHeader { return tabH }
        return 0.0
    }

    // 添加子控件到指定页（page 从 0 起）。dx, dy 为「内容区左上角」相对坐标，
    // 同页混用提示（每页一次，避免刷屏 ✗）
    pri func warn_mix_once(int page, string detail) {
        while mixWarned.len() <= page { mixWarned.add(false) }
        if mixWarned[page] { return }
        mixWarned[page] = true
        print($"[TabControl 用法提示] 第 {page} 页：{detail}")
        print("\n  ⇒ 同一页请只用**一种**定位方式：绝对 addToPage(dx,dy) 或 布局 setPageLayout+addToPageLayout ✓")
        print("\n  （若这是**有意叠加的浮层**，忽略本提示即可。）\n")
    }

    // TabControl 每帧以内容区原点 (x, y+表头高) + (dx, dy) 重排，故移动/缩放 Tab 时内部整体跟随。
    func addToPage(int page, Widget c, float dx, float dy): Widget {
        if page < 0 or page >= pages.len() { return c }
        // ★ 该页已由布局驱动 ⇒ 再绝对定位会与布局流重叠 ✗（曾经只靠注释提醒，注释不会拦人 ✓）
        if _hasLayout[page] {
            warn_mix_once(page, "本页已用 setPageLayout 布局驱动，却又用 addToPage(dx,dy) 绝对定位")
        }
        pages[page].add(c)
        rel[page].add([dx, dy])
        if hwnd != null { _tab_pass_window(c, hwnd) }
        return c
    }
    // 添加到当前激活页（dx, dy 相对内容区左上角）
    func addToActivePage(Widget c, float dx, float dy): Widget { return addToPage(_active, c, dx, dy) }

    // 把某页的内容区设为布局容器（如 VBox），自动填满内容区
    // 布局容器接管该页的子控件排布，不再用手写 dx,dy
    func setPageLayout(int page, VBox layout) {
        if page < 0 or page >= pages.len() { return }
        // ★ 反向检查：本页**已有绝对定位子控件**（只能是 addToPage 加的 ⇒ addToPageLayout 在无布局时
        //   会直接 return，不会进 `_pages`）⇒ 布局接管后它们不参与排布 ✗
        //   `not _hasLayout[page]` 是必须的：重复 setPageLayout（重建/换布局）时 `_pages` 里已有
        //   布局加进来的子控件 ⇒ 不排除就会误报 ✗
        if pages[page].len() > 0 and not _hasLayout[page] {
            warn_mix_once(page, "本页已有 addToPage(dx,dy) 绝对定位的子控件，现在又用 setPageLayout 布局驱动")
        }
        _pageLayouts[page] = layout
        _hasLayout[page] = true
        // 初始位置和大小：内容区 = (x, y+表头高, w, h-表头高)
        layout.set_pos(x, y + hdrH())
        layout.set_size(w, h - hdrH())
        if hwnd != null { _tab_pass_window(layout as Widget, hwnd) }
    }

    // 向某页的布局容器添加子控件（opts 传给布局容器的 add 方法，如 {align:3, expand:true}）
    func addToPageLayout(int page, Widget c, Dict opts): Widget {
        if page < 0 or page >= pages.len() { return c }
        if not _hasLayout[page] { return c }
        var layout = _pageLayouts[page]
        // 调用布局容器的 add 方法
        layout.add(c, opts)
        // 同时加入该页的子控件列表（供 process/render 遍历）
        pages[page].add(c)
        rel[page].add([0.0, 0.0])  // 布局模式下偏移无效，但保持数组对齐
        if hwnd != null { _tab_pass_window(c, hwnd) }
        return c
    }
    // 动态新增一页，返回新页索引
    func addPage(string title): int {
        _tabs.add(title)
        pages.add([])
        rel.add([])
        _pageLayouts.add(new VBox())
        _hasLayout.add(false)
        tabDirty = true
        return _tabs.len() - 1
    }
    // 从某页移除子控件
    func removeFromPage(int page, Widget c) {
        if page < 0 or page >= pages.len() { return }
        var pg = pages[page]
        for pg.len() to i {
            if pg[i] == c { pg.remove(i); rel[page].remove(i); return }
        }
    }
    func set_active(int idx) {
        if idx < 0 or idx >= _tabs.len() { return }
        if idx == _active { return }
        _active = idx
        closePopups()   // 切页时关闭所有已展开的下拉框，避免弹层残留/错位（修复切 tab 下拉仍显示）
        core.markFrameRedraw()   // ★ 切页后强制请求重绘，避免节流跳帧时画面停留在旧页 → 闪烁
        if onChange != null { onChange(_active) }
    }
    func get_active(): int { return _active }
    func tab_count(): int  { return _tabs.len() }
    func set_enabled(bool e) { enabled = e }
    func set_visible(bool v) { visible = v }
    func is_visible(): bool { return visible }
    func set_font_size(float s) { _fontSize = s; if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null; tabDirty = true }
    func on_change(func(int):void cb) { onChange = cb }

    // ==================== 焦点与键盘（供窗口的"焦点链"调用 ✓ 2026-10-13 第六批）====================
    //   语义：←/→ 切页签（走 `set_active` ⇒ 与鼠标点页签**同一个入口** ⇒ `on_change` / 页内容切换都不漂 ✓）
    //   ⚠ 本版**让它可停靠**（进焦点链 ✓）：不然 ←/→ 根本没有触发时机 ✗
    //     （代价：焦点链里多一个停靠点 ✓；`show_header:false` 的页签控件也可以 `set_focusable(false)` 退出 ✓）
    //   ⚠ Enter/Space 归**窗口**（统一调 `activate()` ✓）⇒ 这里不处理 ✗
    bool focusable = true
    bool focused = false
    func set_focusable(bool b) { focusable = b; if not b { focused = false } }
    func is_focusable(): bool { return focusable }
    func focus() { if focusable and not focused { focused = true; core.markFrameRedraw() } }
    func blur() { if focused { focused = false; core.markFrameRedraw() } }
    func is_focused(): bool { return focused }
    func activate() { }                  // 页签栏按 Enter 无标准语义 ✓（切页用 ←/→ ✓）
    func draw_focus_ring(Renderer r) {
        if not focused { return }
        Theme th = theme.getTheme()
        r.setColor(th.accentFocus)
        r.drawRect(x - 2.0, y - 2.0, w + 4.0, h + 4.0)
    }
    // 绑定窗口句柄（由 Window.addTabControl 调用）
    func _bind_window(Ptr[u8] hwnd) {
        self.hwnd = hwnd      // 形参遮蔽字段 ⇒ 必须显式 self.
        for pages.len() to p {
            // 先把句柄下发给通过 setPageLayout 设置的布局容器，
            // 布局容器内部会递归传递给 Edit 等子控件
            if _hasLayout[p] {
                _tab_pass_window(_pageLayouts[p] as Widget, hwnd)
            }
            // 再下发给通过 addToPage 直接添加的子控件
            var pg = pages[p]
            for pg to c { _tab_pass_window(c, hwnd) }
        }
    }

    // 每帧把当前页子控件重排到「内容区原点 + 相对偏移」：
    // 外层布局/拖拽改了 Tab 位置（set_pos）后，内部子控件整体跟随，与布局容器 _relayout 同一机制。
    // 如果该页设置了布局容器（setPageLayout），则只更新布局容器位置/大小并触发布局重排，
    // 子控件的位置由布局容器内部管理。
    pri func applyOffsets(int page) {
        if page < 0 or page >= pages.len() { return }
        if _hasLayout[page] {
            // 布局页：更新布局容器位置和大小，触发内部重排
            var layout = _pageLayouts[page]
            layout.set_pos(x, y + hdrH())
            layout.set_size(w, h - hdrH())
            return
        }
        // 普通页：逐个更新子控件相对偏移
        var pg = pages[page]
        var of = rel[page]
        float ox = x
        float oy = y + hdrH()
        for pg.len() to i {
            var c = pg[i]
            var r = of[i]
            c.set_pos(ox + r[0], oy + r[1])
        }
    }

    func contains(float mx, float my): bool {
        return mx >= x and mx <= x + w and my >= y and my <= y + h
    }

    // 该页有没有图标（越界 / 空串 ⇒ 没有 ✓）
    pri func has_icon(int i): bool {
        return i >= 0 and i < _tabIcons.len() and _tabIcons[i] != ""
    }

    // 图标的纹理（按需加载 + 缓存；渲染器变了会重新加载 ✓）
    pri func tab_icon_tex(Renderer r, int i): Ptr[u8]? {
        if not has_icon(i) { return null }
        while _iconTex.len() <= i {
            _iconTex.add(null)
            _iconLoaded.add("")
        }
        if _iconTex[i] == null or _iconLoaded[i] != _tabIcons[i] {
            _iconTex[i] = img.loadTexture(r.handle, _tabIcons[i])
            _iconLoaded[i] = _tabIcons[i]
        }
        return _iconTex[i]
    }

    // 计算各标签矩形：[rx, ry, rw, rh]
    // ★ 使用缓存的标签宽度，避免每次调用都 measureString
    pri func tabRects(): Array[Array[float]] {
        Array[Array[float]] out = []
        int n = _tabs.len()
        if n == 0 { return out }
        ensure_font()
        if tabDirty and _font != null and _font.ok {
            tabW = []
            for n to i {
                float tw = 60.0
                var[float, float](_tw, _th) = _font.measureString(_tabs[i])
                // 有图标 ⇒ 标签宽多出「图标 16 + 间距 6」（见 draw 里同一套口径 ✓）
                float iw = if has_icon(i) then tabIconSize + 6.0 else 0.0
                tw = _tw + 28.0 + iw
                if tw < 48.0 { tw = 48.0 }
                tabW.add(tw)
            }
            tabDirty = false
        }
        float total = 0.0
        for tabW.len() to i { total = total + tabW[i] }
        float tx = x
        // 表头高 = 0（show_header:false）⇒ 标签矩形高度为 0 ⇒ 命中测试天然失效 ✓
        if total > w {
            // 放不下则等宽分配
            float ew = w / n
            for n to i { out.add([tx, y, ew, hdrH()]); tx = tx + ew }
        } else {
            for n to i { out.add([tx, y, tabW[i], hdrH()]); tx = tx + tabW[i] }
        }
        return out
    }

    // ==================== 交互 ====================
    func process(Event ev) {
        if not _loaded or not enabled or not visible { return }
        applyOffsets(_active)

        // 键盘（第六批）—— 只在**自己聚焦**时响应 ✓（键事件广播 ⇒ 必须自己过滤 ✓）
        //   ←/→ 切页签：走 `set_active` ⇒ 与鼠标点页签**同一个入口** ✓（页内容偏移、on_change 都在里面 ✓）
        if focused and ev.isKeyDown() {
            int _sc = ev.scancode()
            if _sc == core.Scancode.LEFT { set_active(get_active() - 1) }
            eif _sc == core.Scancode.RIGHT { set_active(get_active() + 1) }
        }
        var[float, float](mx, my) = ev.mousePos()


        // 标签栏交互（`show_header:false` 时整块跳过 ⇒ 不会误吞内容区的点击 ✓）
        if showHeader {
            var rs = tabRects()
            int hitTab = -1
            for rs.len() to i {
                var r = rs[i]
                if mx >= r[0] and mx <= r[0] + r[2] and my >= r[1] and my <= r[1] + r[3] { hitTab = i }
            }

            if ev.isMouseMotion() {
                int prevHover = hover
                hover = hitTab
                if cursor >= 0 and hover >= 0 { core.requestCursor(cursor) }
                if hover != prevHover { core.markFrameRedraw() } else { core.markFrameMotion() }
            }

            // 点击标签栏：切换页。若光标落在某打开的弹层（下拉/菜单）范围内则不切换，避免误触；
            // 同时关闭所有打开的下拉框，确保切页后弹层不残留/错位。
            if ev.isMouseButtonDown() and hitTab >= 0 {
                if not core.inPopupCapture(mx, my) {
                    set_active(hitTab)   // 内部会关闭所有已展开的下拉框
                } else {
                    closePopups()
                }
                return
            }
        }

        // 转发事件给当前页子控件（隐藏页不参与，避免误触）。
        // 注意：不再因「存在弹层」而整体跳过转发——否则 combo 自身展开的下拉层无法收到
        // 鼠标移动/点击（hover 高亮与选中失效）。各子控件（如 ComboBox）在 process 内自行
        // 通过 inPopupCapture(+_open) 守卫：只有自身的弹层会响应，其余控件因 inPopupCapture
        // 为真而忽略，与顶层 combo（win.addComboBox）的处理方式一致。
        if _hasLayout[_active] {
            (_pageLayouts[_active] as Widget).process(ev)
        } else {
            var page = pages[_active]
            for page to c { c.process(ev) }
        }
    }

    // 切页 / 关闭弹层时，关闭所有页（含嵌套在 Panel 内的）已展开的下拉框 **和残留的右击菜单**，
    // 避免弹层残留到其它页或停留在旧坐标（修复「切 tab 下拉框仍在」）。
    //   ★ 2026-10-09 补右击菜单（另一个同源 bug ✓）：table/edit/listbox/treeview 的右击菜单不是
    //     由宿主绘制的，而是 `menu.renderContextMenus` **第二遍按窗口统一画**、只认 `isOpen()` ✗
    //     ⇒ 切页后菜单**照旧显示**；又因隐藏页收不到事件（process 只转当前页 ✓）⇒ **点不动也关不掉** ✗✗
    //     （"table 里右击菜单后，切换 tab，菜单还在停留，虽然无法点击，但是能看到菜单"）
    pri func closePopups() {
        menu.closeContextMenus(self.hwnd)   // hwnd 为 null（未绑定窗口）时按"本窗口兜底"处理 ✓
        for pages.len() to p {
            var pg = pages[p]
            for pg to c { closePopupsIn(c) }
        }
    }
    pri func closePopupsIn(Widget w) {
        if w is ComboBox { w.close(); return }
        if w is Panel {
            for w.children to c { closePopupsIn(c) }
        }
    }

    // ==================== 渲染 ====================
    func render(Renderer r) {
        if not _loaded or not enabled or not visible { return }
        ensure_font()

        // 标签栏背景（`show_header:false` ⇒ 高度 0 ⇒ 等于不画 ✓）
        //   ⚠ `bar_color` 的 **alpha = 0 就不铺底**：浅色主题下默认的 bgInput 是白色，
        //     整条盖在插画上非常突兀（一组三个标签会顶着一条白带 ✗）
        if theme.colorA(barColor) > 0 {
            r.setColor(barColor)
            r.fillRect(x, y, w, hdrH())
        }

        // 各标签
        var rs = tabRects()
        for rs.len() to i {
            var rr = rs[i]
            Color bC = tabColor
            Color tC = txtColor
            if i == _active { bC = actColor; tC = actTxtColor }
            else if i == hover { bC = theme.brighten(tabColor, 15) }
            // 标签底：alpha=0 不画；`tab_radius` > 0 画圆角（默认 8，`tab_h/2` 就是胶囊 ✓）
            if theme.colorA(bC) > 0 {
                r.setColor(bC)
                if tabRadius > 0.0 { r.fillRoundedRect(rr[0], rr[1], rr[2], rr[3], tabRadius) }
                else { r.fillRect(rr[0], rr[1], rr[2], rr[3]) }
            }

            // 标签文字（居中裁剪）—— `show_header:false` 时**必须跳过** ✗
            // （否则文字会画到 `rr[1] + (0 - th)/2` = 标签栏上方；`tab_h:0` 那种"假隐藏"就是这么漏的）
            if showHeader and _font != null and _font.ok and _tabs[i] != "" {
                var[float, float](tw, th) = _font.measureString(_tabs[i])
                // ★ 有图标时「图标 + 间距 + 文字」作为**整体**居中（2026-10-26 ✓）
                bool hasI = has_icon(i)
                float iw = if hasI then tabIconSize else 0.0
                float gap = if hasI then 6.0 else 0.0
                float totalW = iw + gap + tw
                float bx = rr[0] + (rr[2] - totalW) / 2.0
                float ty = rr[1] + (rr[3] - th) / 2.0
                if hasI {
                    var tex = tab_icon_tex(r, i)
                    if tex != null {
                        float iy = rr[1] + (rr[3] - tabIconSize) / 2.0
                        // 落整像素：半像素偏移会让细线条被采样掉（和卡片图标同一个坑 ✓）
                        r.drawTextureAt(tex, _float(_int(bx + 0.5)), _float(_int(iy + 0.5)),
                                        tabIconSize, tabIconSize)
                    }
                    bx = bx + iw + gap
                }
                r.drawText(_font, _tabs[i], r.snapX(bx), r.snapY(ty), tC)
            }

            // 激活标签下划线（隐藏表头时同样不画 ✓）—— 圆角端点，配胶囊底不突兀
            if showHeader and showUnderline and i == _active {
                r.setColor(accColor)
                r.fillRoundedRect(rr[0], rr[1] + rr[3] - 3.0, rr[2], 3.0, 1.5)
            }
        }

        // 标签栏底边（隐藏表头时这条线会横在内容区顶上 ⇒ 跳过 ✓）
        //   ⚠ `border_color` 的 alpha = 0 时**也跳过**：用胶囊/下划线式标签时，
        //     这条横贯全宽的线是多余装饰（浅色插画上会成一根突兀的白线 ✗）
        if showHeader and theme.colorA(brdColor) > 0 {
            r.setColor(brdColor)
            r.drawLine(x, y + tabH, x + w, y + tabH)
        }

        // 内容区（表头隐藏时内容区就从 (x, y) 开始 ⇒ 没有 32px 空白 ✓）
        float cx = x, cy = y + hdrH(), cw = w, ch = h - hdrH()
        if cw < 0 { cw = 0 }
        if ch < 0 { ch = 0 }
        r.setColor(bgColor)
        r.fillRect(cx, cy, cw, ch)

        // 裁剪到内容区，绘制当前页子控件（`clip:false` 可关：页面内容自己会被 ScrollView 之类的
        // 容器裁掉时，这一层是**冗余**的 ⇒ 少一层裁剪就少一次 flush/malloc，是"闪烁"的常见来源 ✗）
        SDL_Rect? clip = null
        if clipContent {
            var cl = SDL_Rect.malloc()
            cl.x = _int(cx); cl.y = _int(cy); cl.w = _int(cw) + 1; cl.h = _int(ch) + 1   // +1 防止浮点坐标截断丢失亚像素，避免子控件边缘闪烁
            r.pushClipRect(cl.to_ptr())
            clip = cl
        }

        applyOffsets(_active)
        // 如果该页有布局容器，渲染布局容器（它内部会渲染子控件并调用 _relayout）
        if _hasLayout[_active] {
            (_pageLayouts[_active] as Widget).render(r)
        } else {
            var page = pages[_active]
            for page to c { c.render(r) }
        }

        if clipContent {
            r.popClipRect()
            clip?.free()
        }

        // 内容区边框（`border:false` 可关：纯页面容器场景不想要自己的框 ✓）
        if _drawBorder {
            r.setColor(brdColor)
            r.drawRect(cx, cy, cw, ch)
        }
    }

    func dispose() {
        for pages.len() to p {
            var pg = pages[p]
            for pg to c { c.dispose() }
        }
        if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null
        // 标签图标的纹理也要释放（否则每次销毁 Tab 都漏一张 ✓）
        for _iconTex.len() to k {
            var tx = _iconTex[k]
            if tx != null { core.lib().SDL_DestroyTexture(tx) }
        }
        _iconTex = []
        _iconLoaded = []
    }

    //   ★ 2026-10-13 补：原来只刷了**标签栏自己** ⇒ 页里的控件切主题后仍是旧色 ✗
    //     现在把每页的**布局容器**交给递归出口下钻 ✓（类型表仍然只在 sdl_window 一处 ✓）
    func applyTheme(Theme t) {
        bgColor = t.bg
        barColor = t.bgInput
        tabColor = t.bgAlt
        actColor = t.accent
        txtColor = t.txtDim
        actTxtColor = t.txt
        accColor = t.accentBright
        brdColor = t.border
        for _pageLayouts.len() to pi { lay.applyThemeChild(_pageLayouts[pi], t) }
        core.markFrameRedraw()
    }
}

// 把窗口句柄下发给需要它的子控件：委托给 sdl_layout 的统一函数，
// 确保所有容器类型（含 Panel/ScrollView/Splitter/GroupBox/SpinBox 等此前遗漏的类型）都能正确传递
func _tab_pass_window(Widget c, Ptr[u8] hwnd) {
    lay.passWindowHandle(c, hwnd)
}

// 工厂
export func createTabControl(Dict opts): TabControl {
    TabControl t = new TabControl(); t.set(opts); return t
}


