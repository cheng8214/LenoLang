// sdl_treeview.leno — 树视图控件（层级节点、展开/折叠、单选/多选、可选复选框、右键节点菜单）
// 通过 win.addTreeView({...}) 创建。
//   items: Array[Dict]，每个节点 {text, children:[...], expanded, checked, checkable,
//                                has_children(懒加载标记), data, id(可选)}
//   on_change(func(Array[int]))  : 选择变化时回调，收到选中节点 id 数组
//   on_context(func(int,float,float)) : 右键节点回调（节点 id, 鼠标 x, y）
//   on_toggle(func(int,bool))    : 节点展开/折叠时回调（节点 id, 是否展开）
//   on_check(func(int,bool))     : 节点勾选状态变化时回调（节点 id, 是否勾选）
//   右键菜单：opts.context_menu = true 启用内置 MenuBar，之后用
//             tv.get_context_menu().addContextItem(tv.get_context_handle(), {...}) 添加项，
//             tv.get_context_menu().on_select(func(s,id){...}) 处理选择。
//
// 数据模型：嵌套 Array[TreeViewNode] 树（_roots）为唯一数据源；节点字段（含 image）即唯一真相。
// 渲染/命中用的拍平视图（_flatIds/_flatText/...）只是一层"渲染缓存"——基础类型按下标访问安全、
// 且可避免每帧重建数组（鼠标移动高频重绘抖动的主因）。
// ★ Leno 结构体语义已验证（见 lang_struct_semantics_test.leno）：
//   赋值/传参/返回/数组下标读取全部为引用传递（不拷贝），
//   list[i].children / list[i].image 等变量下标访问可靠，
//   循环变量下标读取同样可靠。.copy() 方法做显式深拷贝。
import maths
import "sdl_opts.leno" as dochk    // 选项对账：不认识的键会报一行警告（见 sdl_opts.leno ✓）
import "sdl_renderer.leno" as ren; use ren.Renderer
import "sdl_font.leno" as fnt; use fnt.Font
import "sdl_event.leno" as evt; use evt.Event
import "sdl_core.leno" as core; use core.SystemCursor; use core.SDL_Rect
import "sdl_widget.leno" as wgt; use wgt.Widget
import "sdl_tooltip.leno" as tip
import "sdl_theme.leno" as theme; use theme.(Theme, Themeable)
use theme.Color
import "sdl_menu.leno" as menu; use menu.MenuBar
import "sdl_image.leno" as img

// 节点结构：children 递归构成树；_parent/_depth 为拍平遍历与连接线提供便利

// 本控件认的键 —— 由本文件全部 `.get("…")` **自动抽取**（是超集 ⇒ 可少报、不误报 ✓）
//   ⚠ 以后增删选项请重跑抽取（或人工核对），否则可能对合法用法误报 ✓
func _opts_keys(): Array[string] {
    return [
"arrow_color", "bg_color", "border_color", "check_color", "checkable", "checked", "children", "context_menu", "cursor", "data", "enabled", "expanded", "font_path", "font_size", "font_style", "h", "has_children", "hover_color", "image", "imageExpanded", "imageMode", "image_gap", "image_size", "indent", "items", "line_color", "mode", "pad_x", "row_h", "scroll_color", "sel_color", "show_check", "show_lines", "text", "text_color", "tip", "visible", "w", "x", "y"
]
}
export struct TreeViewNode {
    int id = -1
    string text = ""
    string image = ""    // 节点图标路径（空 = 无图）；作为唯一数据源
string imageExpanded = ""  // 展开状态图标（空 = 用 image）
    int imageMode = -1   // 图标内容模式：-1=用全局 _imgMode；0=aspectFit 1=stretch 2=aspectFill
    Array[TreeViewNode] children = []
    bool expanded = false
    bool hasChildren = false
    bool checkable = false
    bool checked = false
    Dict data = {}
    int _depth = 0
    int _parent = -1
}

export struct TreeView impl Widget, Themeable {
    float x = 0.0, y = 0.0, w = 200.0, h = 200.0
    pri int nextId = 1
    // ===== 规范状态：嵌套树（唯一数据源）=====
    pri Array[TreeViewNode] roots = []
    // ===== 当前可见行的拍平视图（基础类型并行数组，渲染/命中复用）=====
    // 这层是"渲染缓存"而非数据来源：基础类型按下标访问安全、且可只在结构变更时重建，
    // 避免每帧重建数组导致高频重绘抖动/闪烁。源数据始终存于 _roots 树（节点 image 等字段）。
    pri Array[int] flatIds = []
    pri Array[string] flatText = []
    pri Array[int] flatParent = []     // 每行直接父节点 id（-1=根）
    pri Array[int] flatDepth = []
    pri Array[bool] flatHas = []
    pri Array[bool] flatCheck = []
    pri Array[bool] flatOn = []
    pri Array[bool] flatExpanded = []
    pri Array[string] flatImage = []      // 每行图片路径（渲染缓存，源在节点 image 字段）
    pri Array[int] flatImgMode = []       // 每行图片内容模式（节点 imageMode，<0 时回退全局 _imgMode）
    pri Array[bool] flatSel = []          // 每行是否选中（拍平时从 _sel/_sel2 生成，render 中 O(1) 读取）
    pri bool flatDirty = true      // 拍平视图是否过期：结构/选中变更后置位，render 时按需重建，避免每帧重建数组

    // 节点图标（image）绘制参数
    float _imgSize = 0.0      // 图标边长（0 = 自动：取 _rowH - 8）
    pri float imgGap = 4.0       // 图标与文字间距
    pri int   imgMode = 0        // 内容模式：0=aspectFit(保持比例) 1=stretch(拉伸) 2=aspectFill(覆盖裁剪)
    // 纹理缓存（path -> tex 平行数组）：跨拍平重建持久存在，避免每帧重载与纹理泄漏
    pri Array[string] imgCachePaths = []
    pri Array[Ptr[u8]] imgCacheTex = []
    // ★ MRU 快路径：连续多行常共用同一图标（如全部是文件夹），单槽快路径将 O(n) 线性扫描降为 O(1)
    pri string imgLastPath = ""
    pri Ptr[u8] imgLastTex = null
    pri float textH = 16.0         // 缓存字体行高，避免渲染时每行重复 measureString

    pri float rowH = 24.0
    float _indent = 16.0
    pri float padX = 6.0
    pri float scroll = 0.0
    pri int hover = -1
    pri int sel = -1
    pri Array[int] sel2 = []
    int _mode = 0
    pri bool showCheck = false
    float _fontSize = 15.0; pri string fontPath = ""; pri int fontStyle = 0; Font? _font
    pri Color bgColor = #262830FF
    pri Color bdrColor = #5A5F6EFF
    pri Color selColor = #343A46FF
    pri Color chkColor = #46B278FF   // 勾选框填充色（独立于选中色，避免选中行上蓝框融进蓝背景）
    pri Color hovColor = #464E5CFF
    pri Color txtColor = #EBEBF5FF
    pri Color arrColor = #B0B5C0FF
    pri Color markColor = #EBEBF5FF   // 勾选标记颜色
    pri Color sbColor = #787D8CFF
    pri Color lineColor = #404654FF   // 连接线颜色
    pri bool showLines = true                              // 是否显示层级连接线
    int _cursor = SystemCursor.POINTER
    bool enabled = true, visible = true, _loaded = false
    string _tip = ""
    pri bool draggingScroll = false; pri float sbDragOffset = 0.0
    // 右键上下文菜单
    pri bool ctxMenuEnabled = false
    pri MenuBar? ctxMenu
    pri int ctxHandle = -1
    Ptr[u8]? _hwnd           // 所属窗口句柄（供内嵌右击菜单按窗口隔离绘制）
    pri int winW = 0, winH = 0
    pri func(Array[int]):void onChange
    pri func(int, float, float):void onContext
    pri func(int, bool):void onToggle
    pri func(int, bool):void onCheck

    pri func ensure_font() {
        if _font == null or not _font.ok {
            if _font != null and _font.ok { fnt.releaseFont(_font) }
            if fontPath != "" { _font = fnt.acquireFont(fontPath, _fontSize) }
            else { _font = fnt.acquireFontAuto(_fontSize) }
            if _font != null and _font.ok {
                if fontStyle != 0 { _font.setStyle(fontStyle) }
                var[float, float](_agw, _agh) = _font.measureString("Ag")   // 字体加载时缓存行高，避免每帧渲染中调用 measureString
                textH = _agh
            }
        }
    }

    // ==================== 规范状态构建（嵌套树）====================
    pri func build_node(Dict d, int parentId, int depth): TreeViewNode {
        TreeViewNode n = new TreeViewNode()
        n.id = nextId; nextId = nextId + 1
        n.text = d.get("text", "")
        n.image = d.get("image", "")
n.imageExpanded = d.get("imageExpanded", "")
        n.imageMode = d.get("imageMode", -1)
        n._parent = parentId
        n._depth = depth
        n.expanded = d.get("expanded", false)
        bool hasCh = false
        var ch = d.get("children", [])
        if ch is Array[Dict] { if ch.len() > 0 { hasCh = true } }
        if d.has("has_children") { hasCh = d.get("has_children", false) or hasCh }
        n.hasChildren = hasCh
        bool chk = false, on = false
        if d.has("checkable") { chk = d.get("checkable", false) }
        if d.has("checked") { chk = true; on = d.get("checked", false) }
        n.checkable = chk
        n.checked = on
        n.data = d.get("data", {})
        if ch is Array[Dict] {
            for ch.len() to k { n.children.add(build_node(ch[k], n.id, depth + 1)) }
        }
        return n
    }
    pri func build_from_dicts(Array[Dict] ds) {
        roots = []
        nextId = 1
        for ds.len() to i { roots.add(build_node(ds[i], -1, 0)) }
    }

    // 递归复制整棵子列表（创建独立快照，供 _find 等返回只读副本避免外部误改原始树）
    pri func snap_children(Array[TreeViewNode] list): Array[TreeViewNode] {
        Array[TreeViewNode] out = []
        for list.len() to i {
            TreeViewNode o = new TreeViewNode()
            o.id = list[i].id; o.text = list[i].text; o.image = list[i].image; o.imageExpanded = list[i].imageExpanded; o.imageMode = list[i].imageMode; o.expanded = list[i].expanded
            o.hasChildren = list[i].hasChildren; o.checkable = list[i].checkable; o.checked = list[i].checked
            o._depth = list[i]._depth; o._parent = list[i]._parent; o.data = list[i].data
            o.children = snap_children(list[i].children)
            out.add(o)
        }
        return out
    }
    // 按 id 查找节点：返回独立快照（逐字段拷贝，避免外部修改影响原始树；Leno 返回值为引用传递，
    // 此处手动拷贝是设计选择而非语言限制——见 lang_struct_semantics_test.leno 测试 8 验证）
    pri func find(int id): TreeViewNode { return find_r(roots, id) }
    pri func find_r(Array[TreeViewNode] list, int id): TreeViewNode {
        for list.len() to i {
            if list[i].id == id {
                TreeViewNode o = new TreeViewNode()
                o.id = list[i].id; o.text = list[i].text; o.image = list[i].image; o.imageExpanded = list[i].imageExpanded; o.imageMode = list[i].imageMode; o.expanded = list[i].expanded
                o.hasChildren = list[i].hasChildren; o.checkable = list[i].checkable; o.checked = list[i].checked
                o._depth = list[i]._depth; o._parent = list[i]._parent; o.data = list[i].data
                o.children = snap_children(list[i].children)
                return o
            }
            TreeViewNode c = find_r(list[i].children, id)
            if c.id >= 0 { return c }
        }
        TreeViewNode empty = new TreeViewNode()
        return empty
    }

    // ==================== 拍平（仅收集已展开节点的可见行）====================
    pri func flatten() {
        if not flatDirty { return }   // 结构未变则跳过，避免每帧重建 8 个数组（鼠标移动高频重绘时抖动/闪烁的主因）
        flatIds = []; flatText = []; flatParent = []; flatDepth = []
        flatHas = []; flatCheck = []; flatOn = []; flatExpanded = []; flatImage = []; flatImgMode = []; flatSel = []
        flatten_r(roots, -1, 0)
        flatDirty = false
    }
    pri func flatten_r(Array[TreeViewNode] list, int par, int depth) {
        for list.len() to i {
            flatIds.add(list[i].id)
            flatText.add(list[i].text)
            flatImage.add(if list[i].expanded and list[i].imageExpanded != "" then list[i].imageExpanded else list[i].image)
            flatImgMode.add(list[i].imageMode)
            flatParent.add(par)
            flatDepth.add(depth)
            flatHas.add(list[i].hasChildren)
            flatCheck.add(list[i].checkable)
            flatOn.add(list[i].checked)
            flatExpanded.add(list[i].expanded)
            // ★ 拍平时预计算选中状态，render 中 _is_selected 变为 O(1) 按下标读
            bool seld = false
            if _mode == 0 { seld = (list[i].id == sel) }
            else { for sel2.len() to s { if sel2[s] == list[i].id { seld = true; break } } }
            flatSel.add(seld)
            if list[i].expanded {
                flatten_r(list[i].children, list[i].id, depth + 1)
            }
        }
    }

    // 纹理缓存：按 path 取/载纹理，跨拍平重建持久存在，避免每帧重载与纹理泄漏
    // ★ MRU 快路径：文件管理器中连续多行常共用同一图标（如全部是文件夹），
    //   单槽快路径将 O(n) 线性扫描降为 O(1)，消除每行 string 比较开销
    pri func get_tex(Renderer r, string path): Ptr[u8] {
        if path == imgLastPath and imgLastTex != null { return imgLastTex }
        for imgCachePaths.len() to i {
            if imgCachePaths[i] == path {
                imgLastPath = path; imgLastTex = imgCacheTex[i]
                return imgCacheTex[i]
            }
        }
        Ptr[u8] t = img.loadTexture(r.handle, path)
        imgCachePaths.add(path); imgCacheTex.add(t)
        imgLastPath = path; imgLastTex = t
        return t
    }

    pri func total_h(): float { return flatIds.len() * rowH }
    pri func max_scroll(): float {
        float m = total_h() - h
        if m < 0.0 { m = 0.0 }
        return m
    }
    pri func clamp_scroll() {
        float m = max_scroll()
        if scroll < 0.0 { scroll = 0.0 }
        if scroll > m { scroll = m }
    }

    // ==================== 布局接口 ====================
    func get_w(): float { return w }
    func get_h(): float { return h }
    func get_x(): float { return x }
    func get_y(): float { return y }
    func set_pos(float px, float py) { x = px; y = py }
    func set_size(float sw, float sh) { w = sw; h = sh }

    // ==================== 滚动条几何 ====================
    pri func sb_geom(): Array[float] {
        float maxs = max_scroll()
        float sw = 8.0
        float sx = x + w - sw - 2.0
        float ty0 = y + 2.0
        float ty1 = y + h - 2.0
        float trk = ty1 - ty0
        float thH = maths.max(20.0, maths.min(h * h / total_h(), h - 4.0))
        float thy = ty0 + (scroll / maxs) * (trk - thH)
        return [sx, sw, ty0, ty1, thH, thy, maxs]
    }
    pri func in_vscroll(float mx, float my): bool {
        if max_scroll() <= 0.0 { return false }
        var g = sb_geom()
        return mx >= g[0] - 2.0 and mx <= g[0] + g[1] + 2.0 and my >= g[2] and my <= g[3]
    }
    pri func in_thumb(float mx, float my): bool {
        if max_scroll() <= 0.0 { return false }
        var g = sb_geom()
        return mx >= g[0] - 2.0 and mx <= g[0] + g[1] + 2.0 and my >= g[5] and my <= g[5] + g[4]
    }

    // ==================== 命中测试 ====================
    func contains(float mx, float my): bool {
        return mx >= x and mx <= x + w and my >= y and my <= y + h
    }
    pri func row_at(float my): int {
        int idx = _int((my - y + scroll) / rowH)
        if idx < 0 or idx >= flatIds.len() { return -1 }
        return idx
    }
    func _id_at(float mx, float my): int {
        if not contains(mx, my) { return -1 }
        int idx = row_at(my)
        if idx < 0 { return -1 }
        return flatIds[idx]
    }
    pri func in_toggle(int idx, float mx, float my): bool {
        int depth = flatDepth[idx]
        float cx = x + padX + depth * _indent
        float rowY = y - scroll + idx * rowH
        return mx >= cx and mx <= cx + 16.0 and my >= rowY and my <= rowY + rowH
    }
    pri func in_check(int idx, float mx, float my): bool {
        if not showCheck { return false }
        if not flatCheck[idx] { return false }
        int depth = flatDepth[idx]
        float cx = x + padX + depth * _indent
        float rowY = y - scroll + idx * rowH
        float bx = cx + 18.0
        float by = rowY + (rowH - 14.0) / 2.0
        return mx >= bx and mx <= bx + 14.0 and my >= by and my <= by + 14.0
    }

    pri func is_selected(int id): bool {
        if _mode == 0 { return id == sel }
        for sel2.len() to i { if sel2[i] == id { return true } }
        return false
    }
    // ★ 拍平后按下标读选中状态，render 中调用，避免 _is_selected 线性扫描
    pri func is_flat_sel(int idx): bool {
        if idx < 0 or idx >= flatSel.len() { return false }
        return flatSel[idx]
    }

    // ==================== set 初始化 ====================

    func set(Dict opts) {
        dochk.check("sdl_treeview", opts, _opts_keys())   // ★ 选项对账（2026-09-29 铺开 ✓）
        Theme th = theme.getTheme()
        bgColor = th.bg
        bdrColor = th.border
        selColor = th.bgSel
        hovColor = th.bgHover
        txtColor = th.txt
        sbColor = th.sb
        lineColor = th.sep
        arrColor = theme.darken(th.txt, 60)
        markColor = th.txtOnAccent
        x         = opts.get("x", 0)
        y         = opts.get("y", 0)
        w         = opts.get("w", 200)
        h         = opts.get("h", 200)
        rowH     = opts.get("row_h", 24)
        _indent    = opts.get("indent", 16)
        padX      = opts.get("pad_x", 6)
        _fontSize = opts.get("font_size", 15)
        fontPath = opts.get("font_path", "")
        fontStyle = opts.get("font_style", 0)
        _mode     = opts.get("mode", 0)
        showCheck = opts.get("show_check", false)
        // ★ 2026-09-30：补上图标尺寸/间距的**选项读取** ✓ —— 此前只有 set_image_size()
        //   setter ✗ ⇒ 应用写 `createTreeView({…, image_size:16, image_gap:4})` 是
        //   **静默无效** ✗（选项对账警告抓到的正是这条 ✓：真命中，不是误报 ✓）
        //   缺省取字段当前值 ⇒ 不传就保持原默认 ✓ 零破坏 ✓
        _imgSize  = opts.get("image_size", _imgSize)
        imgGap   = opts.get("image_gap", imgGap)

        var its = opts.get("items", [])
        if its is Array[Dict] { build_from_dicts(its) }
        else { roots = [] }

        scroll = 0.0; hover = -1; sel = -1; sel2 = []

        // 颜色：opts 未传则保持默认值
        if opts.get("bg_color") is Color => t { bgColor = t }
        if opts.get("border_color") is Color => t { bdrColor = t }
        if opts.get("sel_color") is Color => t { selColor = t }
        if opts.get("hover_color") is Color => t { hovColor = t }
        if opts.get("text_color") is Color => t { txtColor = t }
        if opts.get("arrow_color") is Color => t { arrColor = t }
        if opts.get("scroll_color") is Color => t { sbColor = t }
        if opts.get("line_color") is Color => t { lineColor = t }
        if opts.get("check_color") is Color => t { chkColor = t }
        showLines = opts.get("show_lines", true)

        _cursor = opts.get("cursor", SystemCursor.POINTER)
        enabled = opts.get("enabled", true)
        visible = opts.get("visible", true)
        _tip = opts.get("tip", "")

        ctxMenuEnabled = opts.get("context_menu", false) and opts.has("context_menu")
        if ctxMenuEnabled and ctxMenu == null {
            ctxMenu = menu.createMenuBar({})
            ctxMenu.setWindowSize(winW, winH)
            ctxHandle = ctxMenu.addContextMenu("tv_ctx")
            menu.registerContextMenu(ctxMenu)   // 登记（含面板嵌套场景），由窗口第二遍按窗口隔离绘制
        }

        ensure_font()
        flatten()
        clamp_scroll()
        _loaded = true
    }

    // ==================== 设置方法 ====================
    func set_items(Array[Dict] ds) {
        if ds is Array[Dict] { build_from_dicts(ds) }
        else { roots = [] }
        scroll = 0.0; hover = -1; sel = -1; sel2 = []
        flatten(); clamp_scroll()
    }
    func clear() {
        roots = []
        scroll = 0.0; hover = -1; sel = -1; sel2 = []; flatDirty = true; flatten()
    }
    func set_enabled(bool e) { enabled = e }
    func set_visible(bool v) { visible = v }
    func is_visible(): bool { return visible }
    func set_font_size(float s) { _fontSize = s; if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null }
    func set_scroll(float p) { scroll = p; clamp_scroll() }
    func get_scroll(): float { return scroll }
    // 层级连接线
    func set_show_lines(bool v) { showLines = v }
    func get_show_lines(): bool { return showLines }

    // 节点图标（image）绘制参数
    func set_image_size(float s) { _imgSize = s }
    func set_image_gap(float g) { imgGap = g }
    // 内容模式：0=aspectFit(保持比例,默认) 1=stretch(拉伸) 2=aspectFill(覆盖裁剪)
    func set_image_mode(int m) { imgMode = m }

    // 展开/折叠（写操作原地递归修改）
    pri func get_expanded(int id): bool { return get_expanded_r(roots, id) }
    pri func get_expanded_r(Array[TreeViewNode] list, int id): bool {
        for list.len() to i {
            if list[i].id == id { return list[i].expanded }
            if get_expanded_r(list[i].children, id) { return true }
        }
        return false
    }
    func expand(int id, bool e) {
        bool cur = get_expanded(id)
        if cur != e {
            set_expanded_r(roots, id, e)
            flatDirty = true; flatten(); clamp_scroll()
            if onToggle != null { onToggle(id, e) }
        }
    }
    pri func set_expanded_r(Array[TreeViewNode] list, int id, bool v): bool {
        for list.len() to i {
            if list[i].id == id { list[i].expanded = v; return true }
            if set_expanded_r(list[i].children, id, v) { return true }
        }
        return false
    }
    func expand_all() { set_all_expanded(true) }
    func collapse_all() { set_all_expanded(false) }
    pri func set_all_expanded(bool e) {
        set_all_r(roots, e)
        flatDirty = true; flatten(); clamp_scroll()
    }
    pri func set_all_r(Array[TreeViewNode] list, bool e) {
        for list.len() to i {
            list[i].expanded = e
            set_all_r(list[i].children, e)
        }
    }
    pri func toggle_node(int id) {
        bool e = not get_expanded(id)
        set_expanded_r(roots, id, e)
        flatDirty = true; flatten(); clamp_scroll()
        if onToggle != null { onToggle(id, e) }
    }
    func toggle(int id) { toggle_node(id) }

    // 复选框（写操作原地递归修改，避免跨函数返回结构体副本导致写不回）
    func set_checked(int id, bool c) { set_checked_r(roots, id, c); flatDirty = true }
    pri func set_checked_r(Array[TreeViewNode] list, int id, bool v): bool {
        for list.len() to i {
            if list[i].id == id { list[i].checked = v; return true }
            if set_checked_r(list[i].children, id, v) { return true }
        }
        return false
    }
    func is_checked(int id): bool { return is_checked_r(roots, id) }
    pri func is_checked_r(Array[TreeViewNode] list, int id): bool {
        for list.len() to i {
            if list[i].id == id { return list[i].checked }
            if is_checked_r(list[i].children, id) { return true }
        }
        return false
    }
    func get_checked_ids(): Array[int] {
        Array[int] out = []
        collect_checked_r(roots, out)
        return out
    }
    pri func collect_checked_r(Array[TreeViewNode] list, Array[int] out) {
        for list.len() to i {
            if list[i].checkable and list[i].checked { out.add(list[i].id) }
            collect_checked_r(list[i].children, out)
        }
    }

    // 选择与查询
    func get_selected_id(): int {
        if _mode == 0 { return sel }
        if sel2.len() > 0 { return sel2[sel2.len() - 1] }
        return -1
    }
    func get_selected_ids(): Array[int] {
        if _mode == 0 { if sel >= 0 { return [sel] } return [] }
        return sel2
    }
    func get_visible_count(): int { return flatIds.len() }
    func get_node(int id): TreeViewNode {
        TreeViewNode src = find(id)
        TreeViewNode n = new TreeViewNode()
        if src.id >= 0 {
            n.id = src.id; n.text = src.text; n.image = src.image; n.imageMode = src.imageMode; n.expanded = src.expanded; n.hasChildren = src.hasChildren
            n.checkable = src.checkable; n.checked = src.checked; n._depth = src._depth; n.data = src.data
            for src.children.len() to i { n.children.add(get_node(src.children[i].id)) }
        }
        return n
    }
    func get_selected_node(): TreeViewNode { return get_node(sel) }
    func select(int id) { _select(id, false) }
    func _select(int id, bool ctrl) {
        if id < 0 { return }
        flatDirty = true   // ★ 选中变更后标记拍平视图过期，下次 render 重建 _flatSel
        if _mode == 0 {
            if sel != id { sel = id; ensure_visible(id); if onChange != null { onChange([id]) } }
        } else {
            if ctrl {
                bool found = false
                for sel2.len() to i { if sel2[i] == id { sel2.remove(i); found = true; break } }
                if not found { sel2.add(id) }
            } else { sel2 = [id] }
            sel = id
            ensure_visible(id)
            if onChange != null { onChange(sel2.copy()) }
        }
    }
    pri func ensure_visible(int id) {
        for flatIds.len() to i {
            if flatIds[i] == id {
                float iy = i * rowH
                if iy < scroll { scroll = iy }
                else if iy + rowH > scroll + h { scroll = iy + rowH - h }
                clamp_scroll(); return
            }
        }
    }
    func set_data(int id, Dict d) { set_data_r(roots, id, d) }
    pri func set_data_r(Array[TreeViewNode] list, int id, Dict d): bool {
        for list.len() to i {
            if list[i].id == id { list[i].data = d; return true }
            if set_data_r(list[i].children, id, d) { return true }
        }
        return false
    }
    func get_data(int id): Dict { return get_data_r(roots, id) }
    pri func get_data_r(Array[TreeViewNode] list, int id): Dict {
        for list.len() to i {
            if list[i].id == id { return list[i].data }
            Dict d = get_data_r(list[i].children, id)
            if d.len() > 0 { return d }
        }
        return {}
    }
    // 增删（支持懒加载）—— 原地递归修改树结构
    func add_child(int parentId, Dict d): int {
        int id = add_child_r(roots, parentId, d)
        if id >= 0 { flatDirty = true; flatten(); clamp_scroll() }
        return id
    }
    pri func add_child_r(Array[TreeViewNode] list, int parentId, Dict d): int {
        for list.len() to i {
            if list[i].id == parentId {
                TreeViewNode n = build_node(d, parentId, list[i]._depth + 1)
                list[i].children.add(n)
                list[i].hasChildren = true
                return n.id
            }
            int r = add_child_r(list[i].children, parentId, d)
            if r >= 0 { return r }
        }
        return -1
    }
    pri func remove_r(TreeViewNode node, int id): TreeViewNode {
        if node.id == id { TreeViewNode e = new TreeViewNode(); e.id = -1; return e }
        TreeViewNode cp = new TreeViewNode()
        cp.id = node.id; cp.text = node.text; cp.image = node.image; cp.imageMode = node.imageMode; cp._parent = node._parent; cp._depth = node._depth
        cp.expanded = node.expanded; cp.hasChildren = node.hasChildren; cp.checkable = node.checkable
        cp.checked = node.checked; cp.data = node.data
        for node.children.len() to i {
            TreeViewNode c = remove_r(node.children[i], id)
            if c.id >= 0 { cp.children.add(c) }
        }
        return cp
    }
    func remove_node(int id) {
        Array[TreeViewNode] out = []
        for roots.len() to i {
            TreeViewNode c = remove_r(roots[i], id)
            if c.id >= 0 { out.add(c) }
        }
        roots = out
        if is_selected(id) { sel = -1 }
        for sel2.len() to i { if sel2[i] == id { sel2.remove(i); i = i - 1 } }
        flatDirty = true; flatten(); clamp_scroll()
    }

    func on_change(func(Array[int]):void cb) { onChange = cb }
    func on_context(func(int, float, float):void cb) { onContext = cb }
    func on_toggle(func(int, bool):void cb) { onToggle = cb }
    func on_check(func(int, bool):void cb) { onCheck = cb }

    // ==================== 右键菜单接入 ====================
    func set_window(int ww, int hh) { winW = ww; winH = hh; ctxMenu?.setWindowSize(ww, hh) }
    // ★ Widget 接口：窗口 resize 时自动同步尺寸到内部菜单
    func on_window_resize(int ww, int hh) { set_window(ww, hh) }
    // 记录所属窗口句柄，供内嵌右击菜单按窗口隔离绘制
    func set_window_handle(Ptr[u8] hwnd) {
        _hwnd = hwnd
        ctxMenu?.setWindowHandle(hwnd)
    }
    func get_context_menu(): MenuBar { return ctxMenu }
    func get_context_handle(): int { return ctxHandle }
    func set_context_menu_enabled(bool en) { ctxMenuEnabled = en }
    func is_context_menu_enabled(): bool { return ctxMenuEnabled }
    pri func open_ctx_menu(float mx, float my) {
        if ctxMenu == null or ctxHandle < 0 { return }
        ctxMenu.openContext(ctxHandle, mx, my)
    }

    // ==================== 交互 ====================
    func process(Event ev) {
        if not _loaded { return }
        if not visible { return }
        if not enabled { hover = -1; draggingScroll = false; return }

        if ctxMenuEnabled and ctxMenu != null and ctxMenu.isOpen() {
            if ev.isMouseButtonDown() and ev.mouseButton() == 3 {
                var[float, float](_ctx_mx, _ctx_my) = ev.mousePos()
                if contains(_ctx_mx, _ctx_my) { open_ctx_menu(_ctx_mx, _ctx_my) }
                else { ctxMenu.close() }
                return
            }
            ctxMenu.process(ev)
            return
        }

        var[float, float](mx, my) = ev.mousePos()
        if ev.isMouseWheel() { mx = ev.wheelMouseX(); my = ev.wheelMouseY() }
        if core.inPopupCapture(mx, my) { return }

        if ev.isMouseButtonUp() and draggingScroll { draggingScroll = false; return }

        if ev.isMouseButtonDown() and in_vscroll(mx, my) {
            var g = sb_geom()
            float maxs = g[6], trk = g[3] - g[2], thH = g[4]
            if in_thumb(mx, my) {
                draggingScroll = true; sbDragOffset = my - g[5]
            } else {
                draggingScroll = true; sbDragOffset = thH / 2.0
                float rel = my - g[2] - thH / 2.0
                if trk - thH > 0.0 { scroll = rel * maxs / (trk - thH) }
                clamp_scroll()
            }
            return
        }
        if draggingScroll {
            if ev.isMouseMotion() {
                var g = sb_geom()
                float maxs = g[6], trk = g[3] - g[2], thH = g[4]
                float rel = my - g[2] - sbDragOffset
                if trk - thH > 0.0 { scroll = rel * maxs / (trk - thH) }
                clamp_scroll()
                core.markFrameRedraw()
            }
            return
        }

        if ev.isMouseWheel() {
            if not contains(ev.wheelMouseX(), ev.wheelMouseY()) { return }
            scroll = scroll - ev.wheelY() * rowH
            clamp_scroll()
            return
        }

        if ev.isMouseMotion() {
            int prevHover = hover
            hover = _id_at(mx, my)
            if hover != prevHover { core.markFrameRedraw() } else { core.markFrameMotion() }
            if hover >= 0 and _cursor >= 0 { core.requestCursor(_cursor) }
            if _tip != "" {
                if hover >= 0 {
                    // ★ 同一节点内移动用 tipKeep 避免重置延迟计时器（与 Table 同优化）
                    if hover != prevHover { tip.tipReport(_tip, mx, my) }
                    else { tip.tipKeep(mx, my) }
                }
            }
        }

        if ctxMenuEnabled and ctxMenu != null and ev.isMouseButtonDown() and ev.mouseButton() == 3 {
            int id = _id_at(mx, my)
            if id >= 0 {
                _select(id, false)
                if onContext != null { onContext(id, mx, my) }
                open_ctx_menu(mx, my)
                return
            }
        }

        if ev.isMouseButtonDown() and ev.mouseButton() == 1 {
            if not contains(mx, my) { return }   // 守卫：仅当点击落在控件内才处理
            int idx = row_at(my)
            if idx < 0 { return }
            int id = flatIds[idx]                   // 基础类型数组，按下标读安全
            bool hasCh = flatHas[idx]
            bool chkable = flatCheck[idx]
            if ev.mouseClicks() == 2 and hasCh { toggle_node(id); return }
            if hasCh and in_toggle(idx, mx, my) { toggle_node(id); return }
            if showCheck and chkable and in_check(idx, mx, my) {
                bool nv = not is_checked(id)
                set_checked(id, nv)
                _select(id, false)
                if onCheck != null { onCheck(id, nv) }
                return
            }
            bool ctrl = (ev.keyMod() & 64) != 0 or (ev.keyMod() & 128) != 0
            _select(id, ctrl)
        }
    }

    // ==================== 渲染 ====================
    func render(Renderer r) {
        if not _loaded { return }
        if not visible { return }
        ensure_font()
        if _font == null or not _font.ok { return }   // 字体无效时跳过渲染，避免"有背景无文字"的闪烁
        flatten()

        Color bgC = bgColor
        if not enabled { bgC = theme.darken(bgColor, 60) }
        r.setColor(bgC)
        r.fillRoundedRect(x, y, w, h, 6.0)

        SDL_Rect clip = SDL_Rect.malloc()
        clip.x = _int(x); clip.y = _int(y)
        clip.w = _int(w) + 1; clip.h = _int(h) + 1   // +1 覆盖浮点截断的亚像素
        r.pushClipRect(clip.to_ptr())

        // ★ 仅遍历可见行区间，避免大树（上万可见行）每帧全量遍历
        int startRow = _int(scroll / rowH)
        if startRow < 0 { startRow = 0 }
        int endRow = startRow + _int(h / rowH) + 2
        if endRow > flatIds.len() { endRow = flatIds.len() }
        for startRow : endRow - 1 to i {
            int id = flatIds[i]
            float rowY = r.snapY(y - scroll + i * rowH)
            if rowY + rowH < y or rowY > y + h { continue }
            float checkOff = if showCheck then 18.0 else 0.0

            bool seld = is_flat_sel(i)   // ★ O(1) 按下标读拍平时预计算的选中状态
            Color rowC = bgC
            if seld { rowC = selColor }
            else if id == hover { rowC = hovColor }
            if seld or id == hover { r.setColor(rowC); r.fillRoundedRect(x + 2.0, rowY + 1.0, w - 4.0, rowH - 2.0, 4.0) }

            int depth = flatDepth[i]

            // 层级连接线：竖线贯穿各层级、横线连接父到本节点（最后子节点拐弯 └）
            if showLines and depth >= 1 {
                int nx = if (i + 1 < flatIds.len()) then flatDepth[i + 1] else 0
                for depth to kk {
                    int k = kk
                    bool within = (i + 1 < flatIds.len()) and (nx >= k)
                    float seg = if within then rowH else (rowH / 2.0)
                    // 本节点所在列（k==depth）正是展开三角所在的列：竖线若画满整行，
                    // 展开后会从向下三角的底尖穿出。钳制为只画到三角中心（上半段），
                    // 下半段由子节点各自的列（depth+1）继续连接，既去掉穿透又保持主干连续。
                    if k == depth and flatHas[i] { seg = rowH / 2.0 }
                    float lx = r.snapX(x + padX + k * _indent + 8.0)
                    int la = if enabled then 255 else 120
                    r.setColor(theme.withAlpha(lineColor, la))
                    r.drawLine(lx, r.snapY(rowY), lx, r.snapY(rowY + seg))
                }
                float lx0 = r.snapX(x + padX + (depth - 1) * _indent + 8.0)
                float lx1 = r.snapX(x + padX + depth * _indent + 8.0)
                float ly = r.snapY(rowY + rowH / 2.0)
                int la2 = if enabled then 255 else 120
                r.setColor(theme.withAlpha(lineColor, la2))
                r.drawLine(lx0, ly, lx1, ly)
            }

            if flatHas[i] {
                float tcx = x + padX + depth * _indent + 8.0
                float tcy = rowY + rowH / 2.0
                Color ar = arrColor
                if not enabled { ar = theme.darken(arrColor, 60) }
                r.setColor(ar)
                //   ⚠ 用 `drawTriangleC`（色尺度 0~255 已归一化 ✓）—— 别用 `drawTriangle`
                //     直接喂 colorR()：那会被钳成纯白 ⇒ 浅色主题下"白底白箭头、看不见" ✗
                r.drawTriangleC(tcx, tcy, 5.0, if flatExpanded[i] then 180.0 else 90.0, ar)
            }
            if showCheck and flatCheck[i] {
                float cx = x + padX + depth * _indent
                float bx = cx + 18.0
                float by = rowY + (rowH - 14.0) / 2.0
                if flatOn[i] {
                    Color cr = chkColor
                    if not enabled { cr = theme.darken(chkColor, 60) }
                    r.setColor(cr)
                    r.fillRoundedRect(bx, by, 14.0, 14.0, 3.0)
                    Color mr = markColor
                    if not enabled { mr = theme.darken(markColor, 60) }
                    r.setColor(mr)
                    r.drawLine(r.snapX(bx + 3.0), r.snapY(by + 7.5), r.snapX(bx + 6.0), r.snapY(by + 10.5))
                    r.drawLine(r.snapX(bx + 6.0), r.snapY(by + 10.5), r.snapX(bx + 11.0), r.snapY(by + 4.5))
                } else {
                    Color br2 = bdrColor
                    if not enabled { br2 = theme.darken(bdrColor, 60) }
                    r.setColor(br2)
                    r.drawRoundedRect(bx, by, 14.0, 14.0, 3.0)
                }
            }
            // 节点图标（image）：绘制在 缩进/展开箭头/复选框 之后、文字之前
            float imgX = x + padX + depth * _indent + 16.0 + checkOff
            float imgSize = _imgSize
            if imgSize <= 0.0 { imgSize = rowH - 8.0 }
            float imgDrawY = rowY + (rowH - imgSize) / 2.0
            string ipath = flatImage[i]
            if ipath != "" {
                Ptr[u8] itex = get_tex(r, ipath)
                if itex != null {
                    r.setTextureAlpha(itex, 255)
                    r.setTextureColor(itex, #FFFFFFFF)
                    int mode = flatImgMode[i]
                    if mode < 0 { mode = imgMode }   // 节点未指定则用全局模式
                    var[float, float](nw, nh) = r.getTextureSize(itex)
                    if mode == 1 {
                        // stretch：直接拉伸填满（会变形）
                        r.drawTextureFromTo(itex, 0.0, 0.0, nw, nh, imgX, imgDrawY, imgSize, imgSize)
                    } else if mode == 2 {
                        // aspectFill（裁边填满）：覆盖缩放 + 居中裁剪源矩形
                        float s = imgSize / nw; if imgSize / nh > s { s = imgSize / nh }
                        float sw = imgSize / s, sh = imgSize / s
                        float sx = (nw - sw) / 2.0, sy = (nh - sh) / 2.0
                        r.drawTextureFromTo(itex, sx, sy, sw, sh, imgX, imgDrawY, imgSize, imgSize)
                    } else {
                        // aspectFit（默认，留边）：保持比例完整显示
                        float s = imgSize / nw; if imgSize / nh < s { s = imgSize / nh }
                        float dw = nw * s, dh = nh * s
                        r.drawTextureFromTo(itex, 0.0, 0.0, nw, nh,
                            imgX + (imgSize - dw) / 2.0, imgDrawY + (imgSize - dh) / 2.0, dw, dh)
                    }
                    checkOff = checkOff + imgSize + imgGap   // 文字右移，给图标让位
                }
            }
            if _font != null and _font.ok {
                float tx = x + padX + depth * _indent + 16.0 + checkOff + 4.0
                float th = textH
                Color tcR = txtColor
                if not enabled { tcR = theme.darken(txtColor, 60) }
                float ty = r.snapY(rowY + (rowH - th) / 2.0)
                r.drawText(_font, flatText[i], r.snapX(tx), ty, tcR)
            }
        }

        r.popClipRect()
        clip.free()

        r.setColor(bdrColor)
        r.drawRoundedRect(x, y, w, h, 6.0)

        float maxs = max_scroll()
        if maxs > 0.0 {
            float sw = 8.0
            float sx = x + w - sw - 2.0
            r.setColor(theme.withAlpha(sbColor, 180))
            r.fillRoundedRect(sx, y + 2.0, sw, h - 4.0, sw / 2.0)
            float ratio = scroll / maxs
            float thH = maths.max(20.0, maths.min(h * h / total_h(), h - 4.0))
            float thy = y + 2.0 + ratio * (h - 4.0 - thH)
            r.setColor(theme.brighten(sbColor, 60))
            r.fillRoundedRect(sx, thy, sw, thH, sw / 2.0)
        }
    }

    func dispose() {
        if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null
        ctxMenu?.dispose(); ctxMenu = null
        // 纹理缓存仅清空引用：其由所属渲染器在销毁时统一释放，
        // 此处再 SDL_DestroyTexture 会造成 double-free/崩溃（见 sdl_font.leno 注释）
        imgCacheTex = []; imgCachePaths = []
        imgLastPath = ""; imgLastTex = null
    }

// ==================== 运行时主题切换 ====================
func applyTheme(Theme t) {
    bgColor = t.bg
    bdrColor = t.border
    selColor = t.bgSel
    hovColor = t.bgHover
    txtColor = t.txt
    sbColor = t.sb
    lineColor = t.sep
    arrColor = theme.darken(t.txt, 60)
    markColor = t.txtOnAccent
    // 同步内嵌右键菜单的配色
    ctxMenu?.applyTheme(t)
}
}

// 工厂
export func createTreeView(Dict opts): TreeView {
    TreeView t = new TreeView(); t.set(opts); return t
}


