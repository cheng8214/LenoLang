// sdl_event.leno — SDL3 事件封装（基于 cstruct，无需手动偏移）
//
// 用法：
//   var ev = SDL3.createEvent()
//   while ev.poll() {
//       if ev.isKeyDown() { print($"按下: {ev.scancode()}") }
//       if ev.isTextInput() { print($"输入: {ev.text()}") }
//   }
import ffi
import "sdl_core.leno" as core
use core.(sdl3, SDL_Event, SDL_KeyboardEvent, SDL_MouseButtonEvent, SDL_MouseMotionEvent, SDL_MouseWheelEvent, SDL_TextInputEvent, SDL_WindowEvent, SDL_DropEvent)

sdl3 _lib = core.lib()

export struct Event {
    Ptr[u8] raw     // SDL_Event 原始内存（128 字节）
    bool has = false    // 上次 poll 是否有事件（显式初值，消 [字段未初始化] 警告）
    // 分配事件内存
    func init(): bool {
        raw = ffi.malloc(128)
        has = false
        return true
    }

    // ★ 2026-11-12：`SDL_Event` 现在按 C 的样子定义成 **union** ⇒ 取事件数据时
    //   不再需要"每种事件类型各 from_ptr 一次"，一个视图就能按成员取：
    //     ev().type / ev().key.scancode / ev().motion.x / ev().text.text / ev().drop.data
    //   （`from_ptr` 只是造一个指向 raw 的轻量视图，偏移全 0，不拷贝内存。）
    func ev(): SDL_Event {
        return SDL_Event.from_ptr(raw)
    }

    // 从事件队列中轮询一个事件，返回是否有事件待处理
    func poll(): bool {
        has = _lib.SDL_PollEvent(raw)
        return has
    }

    // 阻塞等待事件，最多等待 timeoutMS 毫秒。返回是否有事件（事件数据已写入 raw）。
    // 配合 has 字段使用：if waitTimeout(16) { while has { ...; poll() } }
    func waitTimeout(int timeoutMS): bool {
        has = _lib.SDL_WaitEventTimeout(raw, timeoutMS)
        return has
    }

    // 获取事件类型（所有事件 cstruct 头部相同，故用 KeyboardEvent 读取）
    func sdl3_type(): int {
        return ev().type
    }

    // ==================== 通用 ====================

    // 是否退出事件（SDL_QUIT）
    func isQuit(): bool  { return sdl3_type() == core.EventType.QUIT }

    // 获取触发事件的窗口 ID
    func windowID(): int {
        return ev().key.windowID
    }

    // ==================== 窗口事件 ====================

    func isWindowClose(): bool       { return sdl3_type() == core.EventType.WINDOW_CLOSE_REQUESTED }

    // ★ 2026-11-08 框架缺陷修复：区分「用户点 X」与「程序 requestClose()」
    //   两者投递的是**同一个** WINDOW_CLOSE_REQUESTED，原来无法区分 ⇒ 应用里"登录成功后
    //   requestClose() 关掉对话框"被当成"用户关窗"，force 模式下直接 requestExit() 退了程序 ✗
    //   现在 requestClose 会先在 _selfCloseWids 里登记，这里据此判断来源 ✓
    func isUserClose(): bool {
        if not isWindowClose() { return false }
        int wid = windowID()
        if isSelfClose(wid) {
            // 一次性：查完就清掉，否则下次用户真的点 X 会被误判成"程序自己关" ✗
            clearSelfClose(wid)
            return false
        }
        return true
    }
    func isWindowResized(): bool     { return sdl3_type() == core.EventType.WINDOW_RESIZED }
    func isWindowMoved(): bool       { return sdl3_type() == core.EventType.WINDOW_MOVED }
    func isWindowMinimized(): bool   { return sdl3_type() == core.EventType.WINDOW_MINIMIZED }
    func isWindowMaximized(): bool   { return sdl3_type() == core.EventType.WINDOW_MAXIMIZED }
    func isWindowRestored(): bool    { return sdl3_type() == core.EventType.WINDOW_RESTORED }
    func isWindowFocusGained(): bool { return sdl3_type() == core.EventType.WINDOW_FOCUS_GAINED }
    func isWindowFocusLost(): bool   { return sdl3_type() == core.EventType.WINDOW_FOCUS_LOST }
    func isWindowMouseEnter(): bool  { return sdl3_type() == core.EventType.WINDOW_MOUSE_ENTER }
    func isWindowMouseLeave(): bool  { return sdl3_type() == core.EventType.WINDOW_MOUSE_LEAVE }

    // ==================== 键盘事件 ====================

    // 是否按键按下/抬起事件
    func isKeyDown(): bool { return sdl3_type() == core.EventType.KEY_DOWN }
    func isKeyUp(): bool   { return sdl3_type() == core.EventType.KEY_UP }

    // 获取物理扫描码（与键盘布局无关，如 SCANCODE_A, SCANCODE_ESCAPE）
    func scancode(): int {
        return ev().key.scancode
    }

    // 是否为按键重复事件（长按产生的自动重复）
    func keyRepeat(): bool {
        return ev().key.repeat != 0
    }

    // 获取修饰键状态（位掩码：Shift/Ctrl/Alt/GUI 等）
    func keyMod(): int {
        int t = sdl3_type()
        if t == core.EventType.KEY_DOWN or t == core.EventType.KEY_UP {
            return ev().key.mod
        }
        // 鼠标/滚轮等非键盘事件不含 mod 字段，改用全局修饰键状态
        return _lib.SDL_GetModState()
    }

    // ==================== 鼠标事件 ====================

    func isMouseMotion(): bool     { return sdl3_type() == core.EventType.MOUSE_MOTION }
    func isMouseButtonDown(): bool { return sdl3_type() == core.EventType.MOUSE_BUTTON_DOWN }
    func isMouseButtonUp(): bool   { return sdl3_type() == core.EventType.MOUSE_BUTTON_UP }
    func isMouseWheel(): bool      { return sdl3_type() == core.EventType.MOUSE_WHEEL }

    // 鼠标位置（相对于窗口，浮点精度）
    func mousePos(): [float, float] {
        var e = ev()
        return e.motion.x, e.motion.y
    }

    // 鼠标相对移动量（自上一帧的增量）
    func mouseDelta(): [float, float] {
        var e = ev()
        return e.motion.xrel, e.motion.yrel
    }

    // 鼠标按钮编号：1=左键, 2=中键, 3=右键
    func mouseButton(): int {
        return ev().button.button
    }

    // 点击次数：1=单击, 2=双击
    func mouseClicks(): int {
        return ev().button.clicks
    }

    // 滚轮滚动量（正值向右/远离用户，负值向左/朝向用户）
    func wheelX(): float {
        return ev().wheel.x
    }
    func wheelY(): float {
        return ev().wheel.y
    }

    // 滚轮事件发生时的鼠标坐标（注意：滚轮事件的结构与鼠标移动不同，
    // 必须用 SDL_MouseWheelEvent.mouse_x / mouse_y，不能用 mouseX()/mouseY()）
    func wheelMouseX(): float {
        return ev().wheel.mouse_x
    }
    func wheelMouseY(): float {
        return ev().wheel.mouse_y
    }
    // ==================== 文本输入 ====================
    // 注意：必须先调用 SDL_StartTextInput() 启用文本输入，否则不会收到此事件

    // 是否文本输入事件（处理输入法/IMM 产生的实际字符）
    func isTextInput(): bool { return sdl3_type() == core.EventType.TEXT_INPUT }

    // 获取输入的文本内容（UTF-8 字符串，只在此次 poll 内有效）
    func text(): string {
        return ffi.read_string(ev().text.text, 0)
    }

    // ==================== 拖放事件 ====================

    func isDropFile(): bool { return sdl3_type() == core.EventType.DROP_FILE }
    func isDropText(): bool { return sdl3_type() == core.EventType.DROP_TEXT }

    // 获取拖放的文件路径或文本内容
    func dropPath(): string {
        return ffi.read_string(ev().drop.data, 0)
    }

    // 将当前 raw 缓冲区内容复制到 dst（用于事件合并时保存/恢复事件数据）
    func saveRaw(Ptr[u8] dst) { ffi.memcpy(dst, raw, 128) }
    // 从 src 恢复 raw 缓冲区内容
    func restoreRaw(Ptr[u8] src) { ffi.memcpy(raw, src, 128) }

    // 释放事件内存
    func uninit() {
        if raw != null { ffi.free(raw); raw = null; has = false }
    }
}

// 创建事件对象
export func createEvent(): Event {
    Event ev = new Event(); ev.init(); return ev
}

// ==================== 程序主动关窗的窗口登记（★ 2026-11-08）====================
//   `Window.requestClose()` 会在投递事件前调 `markSelfClose(wid)`，
//   `Event.isUserClose()` 据此区分"用户点 X"和"程序自己关"。
//   事件被消费后由调用方 `clearSelfClose(wid)` 清掉，避免下次误判。
//
//   为什么放在 sdl_event 而不是 sdl_window：sdl_window 已经 import sdl_event，
//   反过来会形成循环依赖 ✗
var _selfCloseWids = []

export func markSelfClose(int wid) {
    if isSelfClose(wid) { return }
    _selfCloseWids.add(wid)
}

export func clearSelfClose(int wid) {
    for 0 : _selfCloseWids.len() - 1 to i {
        if _selfCloseWids[i] == wid {
            _selfCloseWids.remove(i)
            return
        }
    }
}

export func isSelfClose(int wid): bool {
    for _selfCloseWids to w {
        if w == wid { return true }
    }
    return false
}