// sdl_checkbox.leno — 复选框控件
// 通过 win.addCheckBox({...}) 创建，点击切换选中态，回调 on_change(bool)
import "sdl_renderer.leno" as ren; use ren.Renderer
import "sdl_opts.leno" as dochk    // 选项对账：不认识的键会报一行警告（见 sdl_opts.leno ✓）
import "sdl_font.leno" as fnt; use fnt.Font
import "sdl_event.leno" as evt; use evt.Event
import "sdl_core.leno" as core; use core.SystemCursor
import "sdl_widget.leno" as wgt; use wgt.Widget
import "sdl_tooltip.leno" as tip
import "sdl_theme.leno" as theme; use theme.(Theme, Themeable)
use theme.Color


// 本控件认的键 —— 由本文件全部 `.get("…")` **自动抽取**（是超集 ⇒ 可少报、不误报 ✓）
//   ⚠ 以后增删选项请重跑抽取（或人工核对），否则可能对合法用法误报 ✓
func _opts_keys(): Array[string] {
    return [
"border_color", "box", "checked", "checked_color", "cursor", "enabled", "font_path", "font_size", "font_style", "gap", "text", "text_color", "tip", "unchecked_color", "visible", "x", "y"
]
}
export struct CheckBox impl Widget, Themeable {
    string text = ""
    float x = 0.0, y = 0.0
    pri float box = 22.0       // 勾选框边长
    pri float gap = 8.0        // 框与文字间距
    float _fontSize = 15.0
    pri string fontPath = ""
    pri int fontStyle = 0
    Font? _font
    pri bool checked = false
    pri Color uncheckedColor = #3C3C48FF     // 未选中框背景
    pri Color checkedColor = #3CAAF5FF       // 选中框背景
    pri Color txtColor = #EBEBF5FF          // 文字色
    pri Color brdColor = #828296FF          // 框边框色
    pri Color markColor = #FFFFFFFF         // 勾选标记颜色
    pri int cursor = SystemCursor.POINTER
    pri bool hover = false, wasHover = false, pressed = false, enabled = true, visible = true, _loaded = false
    string _tip = ""        // 悬停提示文本（空 = 不提示）
    pri float fontH = 0.0          // 字体行高缓存（字体不变时为常量，避免每帧 measureString）
    pri func(bool):void onChange

    pri func ensure_font() {
        if _font == null or not _font.ok {
            if _font != null and _font.ok { fnt.releaseFont(_font) }
            if fontPath != "" { _font = fnt.acquireFont(fontPath, _fontSize) }
            else { _font = fnt.acquireFontAuto(_fontSize) }
            if _font.ok and fontStyle != 0 { _font.setStyle(fontStyle) }
            if _font.ok { var[float, float](_agw, _agh) = _font.measureString("Ag"); fontH = _agh }
        }
    }

    // ==================== set 初始化 ====================

    func set(Dict opts) {
        dochk.check("sdl_checkbox", opts, _opts_keys())   // ★ 选项对账（2026-09-29 铺开 ✓）
        Theme th = theme.getTheme()
        uncheckedColor = th.bgAlt
        checkedColor = th.accent
        txtColor = th.txt
        brdColor = th.border
        markColor = th.txtOnAccent
        text      = opts.get("text", "")
        x         = opts.get("x", 0)
        y         = opts.get("y", 0)
        box      = opts.get("box", 22)
        gap      = opts.get("gap", 8)
        _fontSize = opts.get("font_size", 15)
        fontPath = opts.get("font_path", "")
        fontStyle = opts.get("font_style", 0)

        // 默认颜色见字段声明，以下仅 opts 覆盖

        // 颜色：opts 未传则保持默认值
        if opts.get("unchecked_color") is Color => t { uncheckedColor = t }
        if opts.get("checked_color") is Color => t { checkedColor = t }
        if opts.get("text_color") is Color => t { txtColor = t }
        if opts.get("border_color") is Color => t { brdColor = t }

        cursor = opts.get("cursor", SystemCursor.POINTER)
        checked = opts.get("checked", false)
        enabled = opts.get("enabled", true)
        visible = opts.get("visible", true)
        // hover/_wasHover/_pressed 默认见字段声明
        _tip = opts.get("tip", "")
        ensure_font()
        _loaded = true
    }

    // ==================== 设置方法 ====================
    func set_text(string t)     { text = t }
    func set_tip(string t)       { _tip = t }
    func set_checked(bool c)     { checked = c }
    func is_checked(): bool     { return checked }
    func set_enabled(bool e)     { enabled = e }
    func set_visible(bool v)      { visible = v }
    func is_visible(): bool       { return visible }
    func set_font_size(float s)  { _fontSize = s; if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null }
    func get_x(): float          { return x }
    func get_y(): float          { return y }
    // ★ 2026-10-29 反哺：内部已有 hover 字段，但没暴露 ⇒ 补齐 ✓
    func is_hover(): bool        { return hover }
    func get_w(): float {
        ensure_font()
        float tw = 0.0
        if _font.ok and text != "" { var[float, float](_tw, _th) = _font.measureString(text); tw = _tw }
        return box + gap + tw
    }
    func get_h(): float          { return box }
    func set_pos(float px, float py) { x = px; y = py }
    // ⚠ 尺寸是**自量**的（方框 = `box`、总宽还要加文字宽 ⇒ 见 get_w ✓）⇒ 这里**故意**不接收
    //   布局给的尺寸（收了也没用 ✓，见 docs 速查"自量尺寸控件"那条 ✓）：
    //   `grow` / `basis` 只决定它**占的位置与间距**，改不了它画多大 ✓
    //   （实测：set_size(160,44) 之后 get_w 仍是 90、get_h 仍是 22 ✓）
    //   要改尺寸请在建的时候给：`createCheckBox({box: 26, font_size: 16})` ✓
    func set_size(float sw, float sh) {}

    func on_change(func(bool):void cb) { onChange = cb }

    // ==================== 焦点（供窗口的"焦点链"调用 ✓ 2026-10-13 第二批）====================
    //   框架的焦点链只认"声明了这套方法的控件"（类型表在 `sdl_window` 一处 ✓）
    //   ★ 激活语义 = **切一下**：与鼠标点击那条路**逐字段对齐**（切值 + 回调 + 重绘 ✓ 不写第二份逻辑 ✗）
    bool focusable = true
    bool focused = false
    func set_focusable(bool b) { focusable = b; if not b { focused = false } }
    func is_focusable(): bool { return focusable }
    func focus() { if focusable and not focused { focused = true; core.markFrameRedraw() } }
    func blur() { if focused { focused = false; core.markFrameRedraw() } }
    func is_focused(): bool { return focused }
    func activate() {
        checked = not checked
        if onChange != null { onChange(checked) }
        core.markFrameRedraw()
    }
    // 焦点环：本控件**没有 `w/h` 字段**（自量尺寸 ✓）⇒ 用 `get_w()/get_h()` 取实际大小 ✓
    func draw_focus_ring(Renderer r) {
        if not focused { return }
        Theme th = theme.getTheme()
        r.setColor(th.accentFocus)
        r.drawRect(x - 2.0, y - 2.0, get_w() + 4.0, get_h() + 4.0)
    }

    func contains(float mx, float my): bool {
        float tw = 0.0
        if _font.ok and text != "" { var[float, float](_tw, _th) = _font.measureString(text); tw = _tw }
        float totalW = box + gap + tw
        return mx >= x and mx <= x + totalW and my >= y and my <= y + box
    }

    // ==================== 交互 ====================
    func process(Event ev) {
        if not _loaded { return }
        if not visible { return }
        if not enabled { hover = false; pressed = false; return }
        // 弹层捕获：事件落在“他人的弹层（如打开的菜单/下拉）范围内时忽略，避免穿透到下层控件
        var[float, float](mx, my) = ev.mousePos()
        if ev.isMouseWheel() { mx = ev.wheelMouseX(); my = ev.wheelMouseY() }
        if core.inPopupCapture(mx, my) { return }


        if ev.isMouseMotion() {
            wasHover = hover
            hover = contains(mx, my)
            if cursor >= 0 {
                if hover { core.requestCursor(cursor) }
            }
            // 悬停提示：hover 时上报；离开由 tipEndMotion 统一清除
            if hover and _tip != "" { tip.tipReport(_tip, mx, my) }
        }

        if ev.isMouseButtonUp() { pressed = false }

        if ev.isMouseButtonDown() and hover and not pressed {
            pressed = true
            checked = not checked
            if onChange != null { onChange(checked) }
        }
    }

    // ==================== 渲染 ====================
    func render(Renderer r) {
        if not _loaded { return }
        if not visible { return }
        ensure_font()
        float bx = x, by = y, bs = box
        Theme th = theme.getTheme()

        // ★ 样式（2026-10-07 定）：**勾选态不再填满** —— 空心圆角框 + 主题色勾线 + 主题色边框。
        //   为什么去掉填充：工具栏里一排小复选框（音源选择之类）用实心块视觉重量过大，
        //   会跟旁边的**主按钮**抢注意力；空心 + 彩勾在 20px 尺寸下同样一眼可读 ✓
        Color fillC = uncheckedColor
        if hover { fillC = theme.brighten(fillC, 25) }
        Color brdC = if checked then checkedColor else brdColor
        Color markC = checkedColor          // ★ 旧的 markColor 是 txtOnAccent（白）—— 去掉蓝底后白勾会看不见
        Color txtC = txtColor
        if not enabled {
            // 禁用 = **向背景褪色**（不是"减半"，理由见 theme.mixbg 的注释）
            fillC = theme.mixbg(fillC, th.bg, 55)
            brdC  = theme.mixbg(brdC, th.bg, 55)
            markC = theme.mixbg(markC, th.bg, 55)
            txtC  = theme.mixbg(txtC, th.bg, 45)
        } else if hover {
            brdC = theme.brighten(brdC, 30)
        }

        // 框背景（勾选态 = 与未勾选**同色**，这正是"去掉蓝色填充"）
        r.setColor(fillC)
        r.fillRoundedRect(bx, by, bs, bs, 5.0)

        // 边框：勾选时用主题色，与勾线同色 ⇒ 小尺寸下也能一眼看出"已勾"
        r.setColor(theme.withAlpha(brdC, 220))
        r.drawRoundedRect(bx, by, bs, bs, 5.0)

        // 勾
        if checked {
            r.setColor(markC)
            float p = bs * 0.26
            r.drawLine(bx + p,                by + bs * 0.52, bx + bs * 0.42, by + bs * 0.72)
            r.drawLine(bx + bs * 0.42,        by + bs * 0.72, bx + bs - p,     by + bs * 0.30)
        }

        // 文字
        if _font.ok and text != "" {
            float cy = by + (bs - fontH) / 2.0
            r.drawText(_font, text, bx + bs + gap, cy, txtC)
        }
    }

    func dispose() {
        if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null
    }
    // ==================== 运行时主题切换 ====================
    //   ★ 2026-10-13 补：本控件以前**没有 `applyTheme`** ⇒ `applyThemeAll` 切主题后它纹丝不动 ✗
    //     映射与 `set()` 里"建时取主题"那一套**逐字段对齐**（改这里请同时改 set() ✓）；
    //     重绘由 `applyThemeAll` 结尾的 `core.requestRedraw()` 统一负责 ✓（与 Table 等一致 ✓）
    func applyTheme(Theme t) {
        uncheckedColor = t.bgAlt
        checkedColor = t.accent
        txtColor = t.txt
        brdColor = t.border
        markColor = t.txtOnAccent
    }
}

// 工厂
export func createCheckBox(Dict opts): CheckBox {
    CheckBox cb = new CheckBox(); cb.set(opts); return cb
}


