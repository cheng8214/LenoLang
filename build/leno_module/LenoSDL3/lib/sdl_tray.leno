// sdl_tray.leno — 系统托盘（System Tray）封装
//
// 回调机制（参照 sdl_filedialog.leno）：
//   - 一个共享的 C 回调 _cb（ffi.callback 只创建一次）
//   - 每个条目通过 userdata 传索引，_dispatch 读索引查 Array
//
// 用法：
//   import "SDL3" as SDL3
//   use SDL3.(Tray, TrayMenu)
//   Tray tray = SDL3.createTray({ tooltip: "My App" })
//   TrayMenu menu = tray.getMenu()
//   menu.addButton("显示", func() { win.show() })
//   menu.addButton("退出", func() { tray.destroy() })
//   // 必须用 win.run() 驱动事件循环

import ffi
import "sdl_core.leno" as core
use core.(sdl3, TrayEntryFlag)
sdl3 _lib = core.lib()

// ============ 托盘图标点击拦截（Windows；子类化 SDL 的托盘窗口 ✓）============
// 为什么需要它：
//   · SDL 的 windows 后端在托盘窗口的 WndProc 里**直接开自己的菜单**（TrackPopupMenu 是
//     **模态**消息循环）⇒ 菜单开着期间主循环被按住、画面冻结 ✗（见 docs 速查表 §六）
//   · SDL **不暴露**"托盘图标被点击"：3.4.10 的 SDL_tray.h 只有条目回调（SDL_TrayCallback），
//     没有 SDL_EVENT_TRAY_* ⇒ 想改用**自绘菜单**，只能把那个隐藏窗口的 WndProc 换掉 ✓
//
// ★ 关键前提：**不要调 tray.getMenu()** —— SDL 只在 `tray->menu` 非空时才开菜单
//   （源码：`if (tray->menu) { TrackPopupMenu(...) }`）⇒ 不建菜单 ⇒ 永远不会进模态循环 ✓
//
// 用法（见 leno_gui/应用/模拟时钟）：
//   Tray tray = SDL3.createTray(...)         // 只做图标 + tooltip，不建菜单 ✓
//   bool hooked = SDL3.interceptTrayClick()   // 失败（非 Windows/找不到窗口）⇒ 调用方自行决定退路 ✓
//   // 主循环（定时器）里：
//   var p = SDL3.pollTrayClick()              // [] = 没点；[x, y] = 该在 (x,y) 弹**自绘菜单** ✓
// 退出：Tray.destroy() 内部会先恢复原 WndProc（顺序不能反 ✗ 见其注释 ✓）

clib user32 {
    Ptr[u8] FindWindowA(str8 cls, str8 title)
    Ptr[u8] SetWindowLongPtrW(Ptr[u8] hwnd, i32 index, Ptr[u8] val)   // 返回旧值（原 WndProc ✓）
    i64     CallWindowProcW(Ptr[u8] proc, Ptr[u8] hwnd, u32 msg, u64 wp, i64 lp)
    bool    PostMessageW(Ptr[u8] hwnd, u32 msg, u64 wp, i64 lp)
    bool    GetCursorPos(Ptr[u8] pt)
}
cfunc _TrayWndProc(Ptr[u8] hwnd, u32 msg, u64 wp, i64 lp):i64

const WM_TRAYICON      = 0x0401   // WM_USER + 1（SDL 托盘窗口的回调消息 ✓）
const WM_CONTEXTMENU   = 0x007B   // 右击（NOTIFYICON_VERSION_4 ✓）
const WM_LBUTTONUP     = 0x0202   // 左键抬起（SDL 也用它开菜单 ✓）
const WM_RBUTTONUP     = 0x0205
const GWLP_WNDPROC_IDX = -4

user32 _u32lib = null
var _newProc = null               // 子类化用的 WndProc（ffi.callback，保持存活 ✓）
Ptr[u8] _trayHwnd = null
Ptr[u8] _oldProc  = null
bool _hooked = false
bool _pending = false             // 有"托盘被点"待取（主循环轮询 ✓）
int  _clickX = 0
int  _clickY = 0
int  _clickKind = 2               // 1 = 左键，2 = 右键（默认右键 ⇒ 弹菜单 ✓）

func _u32(): user32 {
    if _u32lib == null { _u32lib = ffi.load("user32.dll") }
    return _u32lib
}

// 开启拦截（幂等）。返回 false = 非 Windows / 找不到 SDL 的托盘窗口 ⇒ 调用方应回退 ✓
export func interceptTrayClick(): bool {
    if _hooked { return true }
    try {
        Ptr[u8] h = _u32().FindWindowA("SDL_TRAY", null as string)
        if h == null { return false }
        if _newProc == null { _newProc = ffi.callback(_trayWndProc, _TrayWndProc) }
        Ptr[u8] old = _u32().SetWindowLongPtrW(h, GWLP_WNDPROC_IDX, _newProc)
        if old == null { return false }
        _oldProc = old
        _trayHwnd = h
        _hooked = true
        return true
    } catch e {
        return false                  // 非 Windows / user32 不可用 ⇒ 静默降级 ✓
    }
}

// 恢复原 WndProc（Tray.destroy() 会先调它 ✓）
export func releaseTrayClick() {
    if not _hooked or _trayHwnd == null { return }
    if _oldProc != null { _u32().SetWindowLongPtrW(_trayHwnd, GWLP_WNDPROC_IDX, _oldProc) }
    _hooked = false
    _trayHwnd = null
    _oldProc = null
    _pending = false
}

// 取"托盘被点"：无 ⇒ 空数组；有 ⇒ [屏幕 x, 屏幕 y, 键(1=左键 2=右键)] ✓
// 常见用法：右键 ⇒ 弹自绘菜单；左键 ⇒ 直接切显示/隐藏（应用自己定 ✓）
export func pollTrayClick(): Array {
    if not _pending { return [] }
    _pending = false
    Array r = []
    r.add(_clickX); r.add(_clickY); r.add(_clickKind)
    return r
}

// 模拟"点托盘图标"（投递 WM_TRAYICON）—— 无头自测用 ✓
// 走真实消息路径 ⇒ 验证的是完整链路（含我们子类化的 WndProc ✓）
// kind：2 = 右键（WM_CONTEXTMENU ✓，默认）；1 = 左键（WM_LBUTTONUP ✓）
export func clickTrayIcon(int kind = 2): bool {
    if _trayHwnd == null { return false }
    int note = if kind == 1 then WM_LBUTTONUP else WM_CONTEXTMENU
    return _u32().PostMessageW(_trayHwnd, WM_TRAYICON, 0, note)
}

// 我们的 WndProc：只拦"图标被点"，其余消息原样交还 SDL ✓
// 注：Leno 侧的形参用 int（cfunc 那头才是 u32/u64/i64 的 C 布局 ✓）
func _trayWndProc(Ptr[u8] hwnd, int msg, int wp, int lp): int {
    if msg == WM_TRAYICON {
        int note = lp & 0xFFFF            // V4：通知码在 lParam 低 16 位 ✓
        if note == WM_CONTEXTMENU or note == WM_RBUTTONUP {
            _grabCursor(); _clickKind = 2; _pending = true
            return 0                       // ★ 不链回 SDL ⇒ 它不会弹原生菜单（也就不会冻结）✓
        }
        if note == WM_LBUTTONUP {
            _grabCursor(); _clickKind = 1; _pending = true
            return 0
        }
    }
    return _int(_u32().CallWindowProcW(_oldProc, hwnd, msg, wp, lp))
}

func _grabCursor() {
    Ptr[u8] pt = ffi.malloc(8)
    ffi.write_int(pt, 0, 0); ffi.write_int(pt, 4, 0)
    _u32().GetCursorPos(pt)
    _clickX = ffi.read_int(pt, 0)
    _clickY = ffi.read_int(pt, 4)
    ffi.free(pt)
}

// ============ 回调 ============
cfunc _TrayCb(Ptr[u8] userdata, Ptr[u8] entry):void

var _cb        = null       // 共享 C 回调（只创建一次）
Array _entryCbs = []        // 每个条目的用户回调，按创建顺序
Array _entryUds = []        // 每个条目的 userdata malloc 指针（用于释放）

func _ensureCb() {
    if _cb == null {
        _cb = ffi.callback(_dispatch, _TrayCb)
    }
}

func _dispatch(Ptr[u8] userdata, Ptr[u8] entry) {
    // userdata 是 malloc(sizeof(int)) 的地址，里面存了条目索引
    if userdata == null { return }
    int idx = ffi.read_int(userdata, 0)
    if idx < 0 or idx >= _entryCbs.len() { return }
    var cb = _entryCbs[idx]
    if cb != null { cb() }
}

// 为条目分配 userdata（malloc 一个 int，值为索引）
func _allocUd(int idx): Ptr[u8] {
    Ptr[u8] p = ffi.malloc(4)
    ffi.write_int(p, 0, idx)
    _entryUds.add(p)
    return p
}

func _bind(Ptr[u8] entry, any cb) {
    _ensureCb()
    int idx = _entryCbs.len()
    _entryCbs.add(cb)
    Ptr[u8] ud = _allocUd(idx)
    _lib.SDL_SetTrayEntryCallback(entry, _cb, ud)
}

// ============ TrayMenu ============

export struct TrayMenu {
	    Ptr[u8]? _ptr
	    bool    _isSub = false

    func _insert(string label, int flags, int pos): Ptr[u8] {
        if _ptr == null { return null }
        return _lib.SDL_InsertTrayEntryAt(_ptr, pos, label, flags)
    }

    func addButton(string label, any cb): Ptr[u8] {
        Ptr[u8] e = _insert(label, TrayEntryFlag.BUTTON, -1)
        if e != null and cb != null { _bind(e, cb) }
        return e
    }

    func addCheckbox(string label, bool checked, any cb): Ptr[u8] {
        int f = TrayEntryFlag.CHECKBOX
        if checked { f = f | TrayEntryFlag.CHECKED }
        Ptr[u8] e = _insert(label, f, -1)
        if e != null and cb != null { _bind(e, cb) }
        return e
    }

    func addSubmenu(string label): TrayMenu {
        Ptr[u8] entry = _insert(label, TrayEntryFlag.SUBMENU, -1)
        if entry == null { return null }
        Ptr[u8] subPtr = _lib.SDL_CreateTraySubmenu(entry)
        TrayMenu m = new TrayMenu()
        m._ptr = subPtr
        m._isSub = true
        return m
    }

    // 分隔符：label 传 null，SDL3 即渲染为原生分隔线
    func addSeparator(): Ptr[u8] {
        if _ptr == null { return null }
        return _lib.SDL_InsertTrayEntryAt(_ptr, -1, null, 0)
    }

    func removeEntry(Ptr[u8] entry) {
        if entry != null { _lib.SDL_RemoveTrayEntry(entry) }
    }

    func insertButtonAt(int pos, string label, any cb): Ptr[u8] {
        Ptr[u8] e = _insert(label, TrayEntryFlag.BUTTON, pos)
        if e != null and cb != null { _bind(e, cb) }
        return e
    }

    func rawPtr(): Ptr[u8] { return _ptr }
}

// ============ Tray ============

export struct Tray {
	    Ptr[u8]?   _ptr
	    TrayMenu?  _rootMenu
	    bool      _destroyed = false

    func getMenu(): TrayMenu {
        if _rootMenu == null {
            TrayMenu m = new TrayMenu()
            m._ptr = _lib.SDL_GetTrayMenu(_ptr)
            if m._ptr == null {
                m._ptr = _lib.SDL_CreateTrayMenu(_ptr)
            }
            m._isSub = false
            _rootMenu = m
        }
        return _rootMenu
    }

    func setIcon(Ptr[u8] surface) {
        if _ptr == null { return }
        _lib.SDL_SetTrayIcon(_ptr, surface)
    }

    func setTooltip(string text) {
        if _ptr == null { return }
        _lib.SDL_SetTrayTooltip(_ptr, text)
    }

    func rawPtr(): Ptr[u8] { return _ptr }

    func destroy() {
        if _destroyed or _ptr == null { return }
        _destroyed = true
        // ★ 顺序不能反：先恢复原 WndProc，再销毁托盘 ——
        //   否则托盘已释放，WM_TRAYICON 还会派到我们的 WndProc（里面还会用 SDL 的窗口数据 ✗）
        releaseTrayClick()
        _lib.SDL_DestroyTray(_ptr)
        _ptr = null
        _rootMenu = null
        // 释放所有 userdata malloc
        for _entryUds.len() to i { ffi.free(_entryUds[i]) }
        _entryUds = []
        _entryCbs = []
    }
}

// ============ 工厂 ============

export func createTray(Dict opts): Tray {
    _ensureCb()

    Ptr[u8] icon = null
    var iconOpt = opts.get("icon", null)
    if iconOpt != null and iconOpt is Ptr[u8] {
        icon = iconOpt
    }

    string tip = ""
    var tipOpt = opts.get("tooltip", null)
    if tipOpt != null { tip = tipOpt as string }

    Ptr[u8] p = _lib.SDL_CreateTray(icon, tip)
    if p == null { return null }

    Tray t = new Tray()
    t._ptr = p
    t._destroyed = false
    return t
}

// ============ 工具函数 ============

export func isEntryChecked(Ptr[u8] entry): bool    { return _lib.SDL_GetTrayEntryChecked(entry) }
export func isEntryEnabled(Ptr[u8] entry): bool    { return _lib.SDL_GetTrayEntryEnabled(entry) }
export func setEntryEnabled(Ptr[u8] entry, bool e) { _lib.SDL_SetTrayEntryEnabled(entry, e) }
export func setEntryLabel(Ptr[u8] entry, string l)  { _lib.SDL_SetTrayEntryLabel(entry, l) }
export func setEntryChecked(Ptr[u8] entry, bool c)  { _lib.SDL_SetTrayEntryChecked(entry, c) }

// 模拟点击一个条目（SDL_ClickTrayEntry）：**同步**执行该条目的回调，等价于用户点了它。
// 用途：托盘应用的无头自测 —— 菜单回调平时只能靠人手点，自动化测试没法触发 ✓
// ⚠ 只是"回调被调了"的等价物，不经过真实的菜单/消息循环（勾选态等由 SDL 的 WM_COMMAND
//   分支切换，本函数不会替它切）⇒ 测试里请自行 setEntryChecked 保持状态一致 ✓
export func clickEntry(Ptr[u8] entry) {
    if entry != null { _lib.SDL_ClickTrayEntry(entry) }
}
