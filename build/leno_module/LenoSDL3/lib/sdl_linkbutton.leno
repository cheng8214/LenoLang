// sdl_linkbutton.leno — 超链接按钮
// 通过 win.addLinkButton({...}) 创建，点击触发回调，悬停变色+下划线
import "sdl_renderer.leno" as ren; use ren.Renderer
import "sdl_opts.leno" as dochk    // 选项对账：不认识的键会报一行警告（见 sdl_opts.leno ✓）
import "sdl_font.leno" as fnt; use fnt.Font
import "sdl_event.leno" as evt; use evt.Event
import "sdl_core.leno" as core; use core.SystemCursor
import "sdl_widget.leno" as wgt; use wgt.Widget
import "sdl_tooltip.leno" as tip
import "sdl_theme.leno" as theme; use theme.(Theme, Themeable)
use theme.Color


// 本控件认的键 —— 由本文件全部 `.get("…")` **自动抽取**（是超集 ⇒ 可少报、不误报 ✓）
//   ⚠ 以后增删选项请重跑抽取（或人工核对），否则可能对合法用法误报 ✓
func _opts_keys(): Array[string] {
    return [
"color", "enabled", "font_path", "font_size", "font_style", "hover_color", "text", "tip", "underline", "underline_hover", "url", "visible", "visited", "x", "y"
]
}
export struct LinkButton impl Widget {
    string text = "Link"
    pri string url = ""             // 关联 URL（可空，纯文字链接）
    float x = 0.0, y = 0.0
    float _fontSize = 15.0
    pri string fontPath = ""
    pri int fontStyle = 0
    Font? _font
    Color _color = #64B4FFFF   // 默认链接色（浅蓝）
    pri Color hovColor = #82D2FFFF  // 悬停色
    pri Color visColor = #78808CFF   // 已访问色（暗淡）
    pri bool visited = false        // 是否已点击过（变色）
    pri bool underline = true       // 是否显示下划线
    pri bool ulOnHover = false      // 仅悬停时显示下划线（false=始终显示）
    pri func():void onClick
    pri bool hover = false, wasHover = false, pressed = false
    bool enabled = true, visible = true, _loaded = false
    string _tip = ""
    float _w = 0.0, _h = 16.0

    pri func ensure_font() {
        if _font == null or not _font.ok {
            if _font != null and _font.ok { fnt.releaseFont(_font) }
            if fontPath != "" { _font = fnt.acquireFont(fontPath, _fontSize) }
            else { _font = fnt.acquireFontAuto(_fontSize) }
            if _font.ok and fontStyle != 0 { _font.setStyle(fontStyle) }
        }
    }


    func set(Dict opts) {
        dochk.check("sdl_linkbutton", opts, _opts_keys())   // ★ 选项对账（2026-09-29 铺开 ✓）
        Theme th = theme.getTheme()
        _color = theme.brighten(th.accent, 30)
        hovColor = theme.brighten(_color, 30)
        visColor = th.txtDim
        text      = opts.get("text", "Link")
        url      = opts.get("url", "")
        x         = opts.get("x", 0)
        y         = opts.get("y", 0)
        _fontSize = opts.get("font_size", 15)
        fontPath = opts.get("font_path", "")
        fontStyle = opts.get("font_style", 0)
        underline = opts.get("underline", true)
        ulOnHover = opts.get("underline_hover", false)
        visited = opts.get("visited", false)
        enabled = opts.get("enabled", true)
        visible = opts.get("visible", true)
        _tip = opts.get("tip", "")
        if opts.get("color") is Color => t { _color = t }
        if opts.get("hover_color") is Color => t { hovColor = t }
        ensure_font()
        if _font.ok {
            if text != "" { var[float, float](_mw, _mh) = _font.measureString(text); _w = _mw } else { _w = 0.0 }
            var[float, float](_agw, _agh) = _font.measureString("Ag"); _h = _agh
        } else { _w = 0.0; _h = 16.0 }
        _loaded = true
    }

    // ==================== 设置方法 ====================
    func set_text(string t) {
        text = t
        if _font != null and _font.ok {
            if text != "" { var[float, float](_mw, _mh) = _font.measureString(text); _w = _mw } else { _w = 0.0 }
        }
    }
    func set_url(string u) { url = u }
    func set_text_color(Color color) { _color = color }
    func set_hover_color(Color color) { hovColor = color }
    func set_visited(bool v) { visited = v }
    func set_underline(bool u) { underline = u }
    func set_underline_hover(bool u) { ulOnHover = u }
    func set_font_size(float s) { _fontSize = s; if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null }
    func set_font_path(string p) { fontPath = p; if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null }
    func set_tip(string t) { _tip = t }
    func set_visible(bool v) { visible = v }
    func is_visible(): bool { return visible }
    func set_enabled(bool e) { enabled = e }
    func on_click(func():void cb) { onClick = cb }

    // ==================== 查询方法 ====================
    func get_text(): string { return text }
    func get_url(): string { return url }
    func is_hover(): bool { return hover }
    func get_x(): float { return x }
    func get_y(): float { return y }
    func get_w(): float { return _w }
    func get_h(): float { return _h }
    func set_pos(float px, float py) { x = px; y = py }
    func set_size(float sw, float sh) {}

    func contains(float mx, float my): bool {
        return mx >= x and mx <= x + _w and my >= y and my <= y + _h
    }

    // ==================== 交互 ====================
    func process(Event ev) {
        if not _loaded or not visible { return }
        if not enabled { hover = false; return }
        var[float, float](mx, my) = ev.mousePos()
        if ev.isMouseWheel() { mx = ev.wheelMouseX(); my = ev.wheelMouseY() }
        if core.inPopupCapture(mx, my) { return }

        if ev.isMouseMotion() {
            wasHover = hover
            hover = contains(mx, my)
            if hover != wasHover { core.markFrameRedraw() } else { core.markFrameMotion() }
            if hover { core.requestCursor(SystemCursor.POINTER) }
            // 悬停提示：hover 时上报；离开由 tipEndMotion 统一清除
            if hover and _tip != "" { tip.tipReport(_tip, mx, my) }
        }
        if ev.isMouseButtonDown() and contains(mx, my) {
            pressed = true
            core.markFrameRedraw()
        }
        if ev.isMouseButtonUp() {
            if pressed and contains(mx, my) {
                visited = true
                if onClick != null { onClick() }
                core.markFrameRedraw()
            }
            pressed = false
        }
    }

    // ==================== 渲染 ====================
    func render(Renderer r) {
        if not _loaded or not visible { return }
        ensure_font()
        if _font == null or not _font.ok { return }
        if text == "" { return }

        // 选择颜色
        Color c = _color
        if visited { c = visColor }
        if hover { c = hovColor }
        if not enabled { c = theme.packColor(theme.colorR(c) / 2, theme.colorG(c) / 2, theme.colorB(c) / 2) }

        r.drawText(_font, text, x, y, c)

        // 下划线
        bool showUl = underline
        if ulOnHover { showUl = hover }
        if showUl and text != "" {
            var[float, float](msw, msh) = _font.measureString(text)
            float uy = y + msh - 1.0
            int ulA = 255
            if pressed { ulA = 200 }
            r.setColor(theme.withAlpha(c, ulA))
            r.fillRect(x, uy, msw, 1.0)
        }
    }

    func dispose() {
        if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null
    }
}

// 工厂
export func createLinkButton(Dict opts): LinkButton {
    LinkButton lb = new LinkButton(); lb.set(opts); return lb
}


