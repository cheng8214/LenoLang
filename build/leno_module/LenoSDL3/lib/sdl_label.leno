// sdl_label.leno — 标签控件
// 通过 win.addLabel({...}) 创建，支持多行、对齐、自动换行
import "sdl_renderer.leno" as ren; use ren.Renderer
import "sdl_font.leno" as fnt; use fnt.Font
import "sdl_event.leno" as evt; use evt.Event
import "sdl_core.leno" as core
use core.SDL_Rect
import "sdl_widget.leno" as wgt; use wgt.Widget
import "sdl_tooltip.leno" as tip
import "sdl_theme.leno" as theme; use theme.(Theme, Themeable)
import "sdl_opts.leno" as dochk    // 选项对账（见 sdl_opts.leno 头部的来龙去脉 ✓）
use theme.Color

export struct Label impl Widget, Themeable {
    // ==================== 关联常量 ====================
    const ALIGN_LEFT   = 0   // 左对齐
    const ALIGN_CENTER = 1   // 居中对齐
    const ALIGN_RIGHT  = 2   // 右对齐

    const TRUNCATE_NONE     = 0   // 不截断
    const TRUNCATE_ELLIPSIS = 1   // 截断显示省略号
    const TRUNCATE_SCROLL   = 2   // 滚动显示

    string text = ""
    float x = 0.0, y = 0.0
    float _fontSize = 15.0       // 字体大小
    pri string fontPath = ""        // 字体路径（空则自动匹配）
    pri int fontStyle = 0           // 字体样式
    Font? _font                  // 字体缓存
    pri Color txtColor = #FFFFFFFF  // 文字色
    pri int textAlign = ALIGN_LEFT          // 对齐（ALIGN_LEFT/CENTER/RIGHT）
    float _w = 0.0; float _h = 16.0  // 缓存自然尺寸（供布局使用）
    bool _loaded = false
    bool visible = true
    bool enabled = true
    pri bool hover = false, wasHover = false
    string _tip = ""             // 悬停提示文本（空 = 不提示）
    // ── 截断/滚动支持 ──
    float max_w = 0.0            // 最大显示宽度（>0 时启用截断或滚动）
    pri int truncate = TRUNCATE_NONE    // 截断模式（TRUNCATE_NONE/ELLIPSIS/SCROLL）
    pri string fullText = ""        // 完整文本（截断模式下 tooltip 用）
    pri float scrollOffset = 0.0    // 滚动偏移（像素）
    pri int scrollDir = 1           // 滚动方向: 1=右→左, -1=左→右
    pri int scrollLastTick = 0      // 上次滚动时间戳
    // ★ 渲染测量缓存：text 不变时避免每帧 measureString(text)
    pri float cachedTextW = 0.0     // 缓存的文字宽度
    pri string cachedTextKey = "\x01"  // 缓存对应的 text（用不可见字符做初值避免空串歧义）
    pri string cachedTruncText = ""    // _truncatedText 结果缓存
    pri string cachedTruncKey = "\x01" // _truncatedText 对应的 text 键
    pri float cachedTruncW = -1.0
    // ── 多行 / 自动换行 ──
    // 两者都**默认关** ⇒ `_lines` 保持空 ⇒ 渲染走的还是原来的单行路径，老界面逐像素不变 ✓
    pri bool wrap = false             // 按宽度自动折行（宽度取 `wrap_w`，未给则取 `max_w`）
    pri float wrapW = 0.0             // 折行宽度（0 = 用 `max_w`）
    pri Array[string] lines = []      // 排版后的行（**仅在多行/换行启用时非空** ⇒ 空即老路径 ✓）
    pri float lineH = 0.0             // 行高（= "Ag" 自然高，与单行的垂直居中口径一致 ✓）

    pri func ensure_font() {
        if _font == null or not _font.ok {
            if _font != null and _font.ok { fnt.releaseFont(_font) }
            if fontPath != "" {
                _font = fnt.acquireFont(fontPath, _fontSize)
            } else {
                _font = fnt.acquireFontAuto(_fontSize)
            }
            if _font.ok and fontStyle != 0 { _font.setStyle(fontStyle) }
        }
    }

    // ==================== set 初始化 ====================
    // Label 认的键 ✓（含 `w`/`h` —— 它们**不在**这里被读取，见下面 set() 里的显式提示 ✓）
    pri func label_keys(): Array[string] {
        return ["x", "y", "w", "h", "text", "font_size", "font_path", "font_style",
                "text_color", "align", "wrap", "wrap_w", "max_w", "truncate",
                "tip", "visible", "enabled"]
    }

    func set(Dict opts) {
        // ★ 两个坑在这里显式提示（2026-09-29）：
        //   ① `w`/`h` 传入**不生效** ✗ —— 布局尺寸归**父容器**管（add(label, {basis: N}) ✓）
        //   ② 其他不认识的键 ⇒ 一行警告 + 近名提示 ✓（此前静默丢弃 ✗）
        for ["w", "h"] to sz {
            if opts.has(sz) {
                dochk.warn_once("Label", sz,
                    "Label：'" + sz + "' 不生效 —— 布局尺寸请写在 add(label, {basis: N}) 里 ✓（父容器决定尺寸）")
            }
        }
        dochk.check("Label", opts, label_keys())
        Theme th = theme.getTheme()
        txtColor = th.txt
        text      = opts.get("text", "")
        x         = opts.get("x", 0)
        y         = opts.get("y", 0)
        _fontSize = opts.get("font_size", 15)
        fontPath = opts.get("font_path", "")
        fontStyle = opts.get("font_style", 0)

        if opts.get("text_color") is Color => t { txtColor = t }

        // 对齐
        textAlign = opts.get("align", ALIGN_LEFT)

        ensure_font()
        if _font.ok {
            if text != "" { var[float, float](_mw, _mh) = _font.measureString(text); _w = _mw } else { _w = 0.0 }
            var[float, float](_agw, _agh) = _font.measureString("Ag"); _h = _agh
        } else { _w = 0.0; _h = 16.0 }
        // hover/_wasHover 默认见字段声明
        _tip = opts.get("tip", "")
        // 截断/滚动支持
        max_w = opts.get("max_w", 0.0)
        truncate = opts.get("truncate", TRUNCATE_NONE)
        fullText = text
        scrollOffset = 0.0
        scrollDir = 1
        scrollLastTick = 0
        // ── 多行 / 自动换行（都默认关 ⇒ `_lines` 为空 ⇒ 渲染仍走原单行路径 ✓）──
        wrap = opts.get("wrap", false)
        wrapW = opts.get("wrap_w", 0.0)
        relayout_lines()
        visible = opts.get("visible", true)
        enabled = opts.get("enabled", true)
        _loaded = true
    }

    // ==================== 多行排版 ====================
    // 该函数是「多行/自动换行」的唯一实现点，三个要点：
    //   ① 触发条件：显式 `wrap:true`，**或**文本里自带 `\n`；两者都不满足 ⇒ `_lines` 清空、
    //      走原来的单行绘制 ⇒ 老界面逐像素不变 ✓（所以它不会在任何老用法上产生副作用 ✓）
    //   ② 折行宽度：`wrap_w` > 0 用它，否则退回 `max_w`（都不给就没法折行 ⇒ 只按 `\n` 分行 ✓）
    //   ③ 排版结果写回 `_w/_h`（自然尺寸），这样布局容器/`_h` 垂直居中都能直接用 ✓
    pri func relayout_lines() {
        if _font == null or not _font.ok { lines = []; lineH = 0.0; return }
        // ⚠ `split()` 返回的元素是 `any` ⇒ 必须显式标注为 `Array[string]`（否则 `raw[i]` 拿到 any 会报类型不匹配 ✗；
        //   与 `sdl_edit.leno` 的 `_lines = text...split("\n")` 同款写法 ✓）
        Array[string] raw = text.replace("\r", "").split("\n")
        float bw = wrapW
        if bw <= 0.0 { bw = max_w }
        bool wantWrap = wrap and bw > 0.0
        if raw.len() <= 1 and not wantWrap { lines = []; lineH = 0.0; return }
        var[float, float](agw, agh) = _font.measureString("Ag")
        lineH = agh
        Array[string] out = []
        for raw.len() to i {
            string ln = raw[i]
            if not wantWrap {
                out.add(ln)
                continue
            }
            // 贪心折行：逐字符累加宽度，超宽就断行（不切词 —— 中文逐字断行、西文按字符断，
            // 对界面文案足够；真要按词断行是另一个量级的复杂度，此处不做 ✓）
            string cur = ""
            float curW = 0.0
            int n = ln.len()
            for n to k {
                string ch = ln.slice(k, k + 1)
                var[float, float](cw, chh) = _font.measureString(ch)
                if cur != "" and curW + cw > bw {
                    out.add(cur)
                    cur = ch; curW = cw
                } else {
                    cur = cur + ch; curW = curW + cw
                }
            }
            out.add(cur)
        }
        lines = out
        float mx = 0.0
        for out.len() to i {
            var[float, float](lw, lh) = _font.measureString(out[i])
            if lw > mx { mx = lw }
        }
        _w = mx
        _h = lineH * _float(out.len())
    }

    // ==================== 设置方法 ====================
    func set_text(string t)        {
        text = t
        fullText = t
        scrollOffset = 0.0
        scrollLastTick = 0
        cachedTextKey = "\x01"   // text 变化，缓存失效
        cachedTruncKey = "\x01"
        if _font != null and _font.ok {
            _w = textWidth()
            var[float, float](_agw, _agh) = _font.measureString("Ag"); _h = _agh
        }
        relayout_lines()         // 多行/换行启用时按新文本重排 ✓（未启用则只是清空 `_lines` ✓）
    }
    func set_text_color(Color color) { txtColor = color }
    func set_font_size(float s) {
        _fontSize = s
        if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null
        // 字号变了 ⇒ 行宽/行高全变 ⇒ 必须重排（`_ensure_font` 先补回字体，否则 `_relayout_lines` 会空转 ✓）
        ensure_font()
        relayout_lines()
    }
    func set_font_path(string p) {
        fontPath = p
        if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null
        ensure_font()
        relayout_lines()
    }
    func set_font_style(int style) {
        fontStyle = style
        ensure_font()
        if _font.ok { _font.setStyle(style) }
        relayout_lines()         // 加粗会改字宽 ⇒ 重排 ✓
    }
    func set_align(int a) { textAlign = a }
    func set_tip(string t) { _tip = t }
    func set_visible(bool v) { visible = v }
    func is_visible(): bool { return visible }
    func set_enabled(bool e) { enabled = e }
    func is_enabled(): bool { return enabled }
    func set_max_w(float w) { max_w = w; cachedTruncKey = "\x01"; relayout_lines() }
    func set_truncate(int mode) { truncate = mode; scrollOffset = 0.0; scrollLastTick = 0; cachedTruncKey = "\x01" }
    // 多行/换行开关（运行时可改 ✓）
    func set_wrap(bool v) { wrap = v; relayout_lines() }
    func set_wrap_w(float w) { wrapW = w; relayout_lines() }
    // 供上层查询是否处于多行模式（如按钮内嵌 Label 想按内容自适应高度 ✓）
    func is_multiline(): bool { return lines.len() > 1 }
    func get_lines(): int { return lines.len() }

    // ★ 获取文字宽度（带缓存，text 不变时直接复用）
    pri func textWidth(): float {
        if text == cachedTextKey { return cachedTextW }
        if _font != null and _font.ok {
            var[float, float](_mw, _mh) = _font.measureString(text)
            cachedTextW = _mw; cachedTextKey = text
            return _mw
        }
        return 0.0
    }

    // ── 截断文本：测量并裁剪出适合 max_w 的 "前缀...后缀" 形式 ──
    pri func truncatedText(): string {
        if max_w <= 0.0 or _font == null or not _font.ok { return text }
        // ★ 结果缓存：text + max_w 不变时直接复用
        if text == cachedTruncKey and max_w == cachedTruncW { return cachedTruncText }
        cachedTruncKey = text; cachedTruncW = max_w
        var[float, float](msw, msh) = _font.measureString(text)
        if msw <= max_w { cachedTruncText = text; return text }
        // 省略号宽度
        string ellipsis = "..."
        var[float, float](esw, esh) = _font.measureString(ellipsis)
        float avail = max_w - esw
        if avail <= 0.0 { return ellipsis }
        // 从尾部截取后缀（约占可用空间的 40%）
        int textLen = text.len()
        int tailStart = textLen
        float tailW = 0.0
        for textLen - 1 : 0 to i {
            string ch = text.slice(i, i + 1)
            var[float, float](csw, csh) = _font.measureString(ch)
            if tailW + csw > avail * 0.4 { tailStart = i + 1; break }
            tailW = tailW + csw
            tailStart = i
        }
        string tail = text.slice(tailStart, textLen)
        // 从头部截取前缀（填满剩余空间）
        float headW = 0.0
        int headEnd = 0
        for 0 : textLen - 1 to i {
            string ch = text.slice(i, i + 1)
            var[float, float](csw, csh) = _font.measureString(ch)
            if headW + csw > avail - tailW { headEnd = i; break }
            headW = headW + csw
            headEnd = i + 1
        }
        string head = text.slice(0, headEnd)
        string result = head + ellipsis + tail
        cachedTruncText = result
        return result
    }

    // ==================== 查询方法 ====================
    func get_text(): string  { return text }
    func get_x(): float      { return x }
    func get_y(): float      { return y }
    func get_w(): float      { return _w }
    func get_h(): float      { return _h }
    func set_pos(float px, float py) { x = px; y = py }
    func set_size(float sw, float sh) { _w = sw; _h = sh }

    // 标签仅用于悬停提示检测（其余输入不参与）
    func process(Event ev) {
        if not _loaded or not enabled or not visible { return }
        if not ev.isMouseMotion() { return }
        var[float, float](mx, my) = ev.mousePos()
        // ★ 弹层捕获：与 Button/Toggle 等控件一致，弹层打开时不响应 hover
        if core.inPopupCapture(mx, my) { hover = false; return }
        wasHover = hover
        hover = mx >= x and mx <= x + _w and my >= y and my <= y + _h
        // 截断模式：hover 时显示完整文本
        if hover and truncate == TRUNCATE_ELLIPSIS and max_w > 0.0 and fullText != "" {
            tip.tipReport(fullText, mx, my)
        } else if hover and _tip != "" {
            tip.tipReport(_tip, mx, my)
        }
        core.markFrameMotion()
    }

    // ==================== 渲染 ====================
    func render(Renderer r) {
        if not _loaded or not enabled or not visible { return }
        ensure_font()
        if _font == null or not _font.ok { return }
        if text == "" { return }

        // ── 多行 / 自动换行 ──
        // 只在 `_lines` 有 2 行以上时接管；单行 ⇒ 继续走下面的原路径（逐像素不变 ✓）。
        // 与截断/滚动互斥：那两个模式有自己的单行语义（省略号/横向滚动）✓
        if truncate == TRUNCATE_NONE and lines.len() > 1 {
            float lh = lineH
            if lh <= 0.0 {
                var[float, float](_aw, _ah) = _font.measureString("Ag")
                lh = _ah
            }
            float totalH = lh * _float(lines.len())
            float y0 = y
            // 与单行同一口径：控件高 `_h` 超过文字总高时整体垂直居中 ✓
            if _h > totalH { y0 = y + (_h - totalH) / 2.0 }
            for lines.len() to i {
                string ln = lines[i]
                var[float, float](lw, _lh2) = _font.measureString(ln)
                float dx = x                     // `align` 语义与单行一致：x 是锚点 ✓
                if textAlign == ALIGN_CENTER { dx = x - lw / 2.0 }
                if textAlign == ALIGN_RIGHT { dx = x - lw }
                r.drawText(_font, ln, dx, y0 + lh * _float(i), txtColor)
            }
            return
        }

        // ── 截断模式 ──
        if truncate == TRUNCATE_ELLIPSIS and max_w > 0.0 {
            float msw = textWidth()
            if msw <= max_w {
                // 不需要截断，正常绘制
                float drawX = x
                if textAlign == ALIGN_CENTER { drawX = x - msw / 2.0 }
                if textAlign == ALIGN_RIGHT { drawX = x - msw }
                r.drawText(_font, text, drawX, y, txtColor)
                return
            }
            // 截断绘制
            string truncText = truncatedText()
            r.drawText(_font, truncText, x, y, txtColor)
            return
        }

        // ── 滚动模式 ──
        if truncate == TRUNCATE_SCROLL and max_w > 0.0 {
            float msw = textWidth()
            if msw <= max_w {
                // 不需要滚动，正常绘制
                float drawX = x
                if textAlign == ALIGN_CENTER { drawX = x - msw / 2.0 }
                if textAlign == ALIGN_RIGHT { drawX = x - msw }
                r.drawText(_font, text, drawX, y, txtColor)
                return
            }
            // 更新滚动偏移
            int now = core.getTicks()
            if scrollLastTick == 0 { scrollLastTick = now }
            int dt = now - scrollLastTick
            if dt > 0 {
                scrollOffset = scrollOffset + _float(dt) * 0.03 * _float(scrollDir)
                scrollLastTick = now
            }
            // 滚动范围：从 0 到 -(textWidth - max_w + 20)
            float scrollRange = msw - max_w + 20.0
            if scrollDir == 1 {
                if scrollOffset >= scrollRange {
                    scrollOffset = scrollRange
                    scrollDir = -1
                }
            } else {
                if scrollOffset <= 0.0 {
                    scrollOffset = 0.0
                    scrollDir = 1
                }
            }
            // 用裁剪矩形绘制（同样需要垂直居中）
            float scrollDrawY = y
            if _font != null and _font.ok and _h > 0.0 {
                var[float, float](fh2, _) = _font.measureString("Ag")
                if fh2 < _h { scrollDrawY = y + (_h - fh2) / 2.0 }
            }
            SDL_Rect clip = SDL_Rect.malloc()
            clip.x = _int(x); clip.y = _int(y)
            clip.w = _int(max_w); clip.h = _int(_h + 2)
            r.pushClipRect(clip)
            r.drawText(_font, text, x - scrollOffset, scrollDrawY, txtColor)
            r.popClipRect()
            clip.free()
            core.markFrameRedraw()
            return
        }

        // ── 普通绘制 ──
        float msw = textWidth()
        float drawX = x
        if textAlign == ALIGN_LEFT { drawX = x }                          // 左对齐
        if textAlign == ALIGN_CENTER { drawX = x - msw / 2.0 }     // 居中
        if textAlign == ALIGN_RIGHT { drawX = x - msw }           // 右对齐

        // ★ 垂直居中：当控件高度 _h 大于文字自然高度时，文字垂直居中于控件区域内
        //    解决 HBox/VBox align:3(stretch) 或 align:1(center) 时 Label 文字与 Button 不对齐的问题
        float drawY = y
        if _font != null and _font.ok and _h > 0.0 {
            var[float, float](fh, _) = _font.measureString("Ag")  // 文字行高（ascender+descender）
            if fh < _h {
                drawY = y + (_h - fh) / 2.0
            }
        }

        r.drawText(_font, text, drawX, drawY, txtColor)
    }

// 释放字体资源
func dispose() {
if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null
}

// ==================== 运行时主题切换 ====================
func applyTheme(Theme t) {
txtColor = t.txt
}
}

// 工厂
export func createLabel(Dict opts): Label {
    Label lbl = new Label(); lbl.set(opts); return lbl
}
