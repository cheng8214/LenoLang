// sdl_listbox.leno — 列表框控件（可滚动、单选/多选）
// 通过 win.addListBox({...}) 创建，鼠标点击选择、滚轮滚动，回调 on_change(Array[int])
import maths
import "sdl_image.leno" as img      // ★ 行图标要加载纹理（2026-10-09 ✓ 与 sdl_table 的图标列同一个模块 ✓）
import "sdl_opts.leno" as dochk    // 选项对账：不认识的键会报一行警告（见 sdl_opts.leno ✓）
import "sdl_renderer.leno" as ren; use ren.Renderer
import "sdl_font.leno" as fnt; use fnt.Font
import "sdl_event.leno" as evt; use evt.Event
import "sdl_core.leno" as core; use core.SystemCursor; use core.SDL_Rect
import "sdl_widget.leno" as wgt; use wgt.Widget
import "sdl_tooltip.leno" as tip
import "sdl_menu.leno" as menu; use menu.MenuBar
import "sdl_theme.leno" as theme; use theme.(Theme, Themeable)
use theme.Color


// 本控件认的键 —— 由本文件全部 `.get("…")` **自动抽取**（是超集 ⇒ 可少报、不误报 ✓）
//   ⚠ 以后增删选项请重跑抽取（或人工核对），否则可能对合法用法误报 ✓
func _opts_keys(): Array[string] {
    return [
"bg_color", "border_color", "cursor", "enabled", "font_path", "font_size", "font_style", "h", "hover_color", "image_gap", "image_pad", "image_path", "image_size", "item_h", "items", "mode", "scroll_color", "sel_color", "selected", "text_color", "tip", "visible", "w", "x", "y"
]
}
export struct ListBox impl Widget, Themeable {
    // ==================== 关联常量 ====================
    const MODE_SINGLE = 0   // 单选模式
    const MODE_MULTI  = 1   // 多选模式

    float x = 0.0, y = 0.0, w = 200.0, h = 200.0
    Array[string] items = []
    pri Array[int] sel = []          // 已选中索引集合（保持顺序，供回调使用）
    Dict[int, bool] _selMap = {}  // 选中索引映射（O(1) 查找，与 _sel 同步维护）
    pri float itemH = 24.0          // 行高
    pri float scroll = 0.0          // 已向下滚动的像素（0 = 顶部）
    pri int hover = -1              // 当前悬停行索引（-1 无）
    float _fontSize = 15.0; pri string fontPath = ""; pri int fontStyle = 0; Font? _font
    int _mode = MODE_SINGLE       // 选择模式（MODE_SINGLE/MODE_MULTI）
    pri Color bgColor = #262830FF       // 背景色
    pri Color bdrColor = #5A5F6EFF      // 边框色
    pri Color selColor = #343A46FF      // 选中行底色
    pri Color hovColor = #464E5CFF      // 悬停行底色
    pri Color txtColor = #EBEBF5FF     // 文字色
    pri Color sbColor = #787D8CFF      // 滚动条色
    pri int cursor = SystemCursor.POINTER
    bool enabled = true, visible = true, _loaded = false
    string _tip = ""
    pri bool draggingScroll = false   // 正在拖拽竖向滚动条
    pri float sbDragOffset = 0.0      // 拖拽起点距滑块顶的相对偏移
    pri func(Array[int]):void onChange

    // ==================== 右击上下文菜单（2026-10-08 补 ✓）====================
    //   为什么补：先前**只有 Table / TreeView** 有右击菜单 ✗，ListBox 没有
    //     ⇒ 想在播放列表上挂「删除本地文件 / 在资源管理器里定位」就没辙 ✓（用户点名：这是框架缺口 ✓）
    //   实现**照 `sdl_table.leno` 那套原样搬**（菜单本体是共用的 `sdl_menu.leno` ✓
    //     弹出/命中/关闭由它管 ✓；绘制由窗口第二遍 `menu.renderContextMenus` 按窗口隔离统一画 ✓）
    //   ⚠ 用起来跟 Table 一模一样：`addContextItem({label, id})` + `on_context_select(...)` ✓
    pri MenuBar? ctxMenu
    pri int ctxMenuH = -1                    // 菜单句柄（-1 = 还没建）
    pri bool ctxMenuEnabled = true
    pri int ctxRow = -1                      // 右击命中的行（-1 = 空白处 ✓）
    pri int winW = 0
    pri int winH = 0
    pri func(int, string):void onCtxSelect   // 菜单项被点：参数是**命中行**与项 id ✓
    pri func(int):void onCtxWillOpen         // 弹出前回调：按行重建菜单项（不同行不同项 ✓）

    pri func ensure_font() {
        if _font == null or not _font.ok {
            if _font != null and _font.ok { fnt.releaseFont(_font) }
            if fontPath != "" { _font = fnt.acquireFont(fontPath, _fontSize) }
            else { _font = fnt.acquireFontAuto(_fontSize) }
            if _font.ok and fontStyle != 0 { _font.setStyle(fontStyle) }
        }
    }

    pri func max_scroll(): float {
        float total = items.len() * itemH
        float m = total - h
        if m < 0.0 { m = 0.0 }
        return m
    }

    pri func clamp_scroll() {
        float m = max_scroll()
        if scroll < 0.0 { scroll = 0.0 }
        if scroll > m { scroll = m }
    }

    // ==================== 布局接口 ====================
    func get_w(): float          { return w }
    func get_h(): float          { return h }
    func set_pos(float px, float py) { x = px; y = py }
    func set_size(float sw, float sh) { w = sw; h = sh }

    // 竖向滚动条几何：返回 [sx, sw, ty0, ty1, thH, thy, maxs]
    pri func sb_geom(): Array[float] {
        float maxs = max_scroll()
        float sw = 8.0
        float sx = x + w - sw - 2.0
        float ty0 = y + 2.0
        float ty1 = y + h - 2.0
        float trk = ty1 - ty0
        float thH = maths.max(20.0, maths.min(h * h / total_h(), h - 4.0))
        float thy = ty0 + (scroll / maxs) * (trk - thH)
        return [sx, sw, ty0, ty1, thH, thy, maxs]
    }
    // 鼠标是否落在竖向滚动条（轨道）上
    pri func in_vscroll(float mx, float my): bool {
        if max_scroll() <= 0.0 { return false }
        var g = sb_geom()
        return mx >= g[0] - 2.0 and mx <= g[0] + g[1] + 2.0 and my >= g[2] and my <= g[3]
    }
    // 鼠标是否落在滚动条滑块上
    pri func in_thumb(float mx, float my): bool {
        if max_scroll() <= 0.0 { return false }
        var g = sb_geom()
        return mx >= g[0] - 2.0 and mx <= g[0] + g[1] + 2.0 and my >= g[5] and my <= g[5] + g[4]
    }

    // O(1) 选中判定：直接查 _selMap 映射，避免线性扫描 _sel
    pri func is_selected(int idx): bool {
        return _selMap.get(idx, false)
    }

    // 同步添加选中索引到 _sel 和 _selMap
    pri func sel_add(int idx) { sel.add(idx); _selMap[idx] = true }
    // 同步清空选中集合
    pri func sel_clear() { sel = []; _selMap = {} }

    pri func total_h(): float { return items.len() * itemH }

    // ==================== ★ 行图标（2026-10-09 用户要求，**补进控件本体** ✓）====================
    //   用途：每行文字左侧画一个小图标（如歌单里的音符 ✓）。"每行都用同一个"这种需求
    //     一次给 `image_path` 就够 ⇒ 换数据（set_items）也不会掉 ✓（与 Table 的 image_path 同取舍 ✓）
    //   · image_size：0 = 自动（行高 − 8 ✓）
    //   · image_gap ：图标与文字之间的间距
    //   · image_pad ：图标距左边缘的内边距
    //   ⚠ 为什么必须补在控件里而不是应用每行自己画：行高 / 滚动偏移 / 裁剪 / 选中底纹都归本控件管，
    //     应用层拿不到"第 i 行现在画在哪" ✗ ⇒ 只能在渲染循环里画 ✓（同 Table 的图标列思路 ✓）
    pri string imgDefault = ""
    pri float  _imgSize = 0.0
    pri float  imgGap = 4.0
    pri float  imgPad = 6.0
    // 纹理按路径缓存：通常只有一张图标 ⇒ 第一次之后全部命中 ✓；再留"最近一次"做快速路径 ✓
    pri Array[string] imgCachePaths = []
    pri Array[Ptr[u8]] imgCacheTex = []
    pri string imgLastPath = ""
    pri Ptr[u8] imgLastTex = null

    // ==================== set 初始化 ====================

    func set(Dict opts) {
        dochk.check("sdl_listbox", opts, _opts_keys())   // ★ 选项对账（2026-09-29 铺开 ✓）
        Theme th = theme.getTheme()
        bgColor = th.bg
        bdrColor = th.border
        selColor = th.bgSel
        hovColor = th.bgHover
        txtColor = th.txt
        sbColor = th.sb
        x         = opts.get("x", 0)
        y         = opts.get("y", 0)
        w         = opts.get("w", 200)
        h         = opts.get("h", 200)
        itemH    = opts.get("item_h", 24)
        _fontSize = opts.get("font_size", 15)
        fontPath = opts.get("font_path", "")
        fontStyle = opts.get("font_style", 0)
        _mode     = opts.get("mode", MODE_SINGLE)     // MODE_SINGLE 单选 / MODE_MULTI 多选
        // ★ 行图标（2026-10-09 ✓ 与 Table 同名同义）：image_path = 每行的默认图标（"" = 不画 ✓）
        imgDefault = opts.get("image_path", "")
        _imgSize   = opts.get("image_size", 0.0)
        imgGap     = opts.get("image_gap", 4.0)
        imgPad     = opts.get("image_pad", 6.0)

        var its = opts.get("items", [])
        if its is Array[string] { items = its } else { items = [] }
        sel_clear()
        var sel = opts.get("selected", -1)
        if sel is Array[int] {
            for sel.len() to i { sel_add(sel[i]) }
        } else {
            int s = _int(sel)
            if s >= 0 { sel_add(s) }
        }

        // 颜色：opts 未传则保持默认值
        if opts.get("bg_color") is Color => t { bgColor = t }
        if opts.get("border_color") is Color => t { bdrColor = t }
        if opts.get("sel_color") is Color => t { selColor = t }
        if opts.get("hover_color") is Color => t { hovColor = t }
        if opts.get("text_color") is Color => t { txtColor = t }
        if opts.get("scroll_color") is Color => t { sbColor = t }

        cursor  = opts.get("cursor", SystemCursor.POINTER)
        enabled  = opts.get("enabled", true)
        visible  = opts.get("visible", true)
        _tip = opts.get("tip", "")
        scroll  = 0.0; hover = -1   // 重置滚动与悬停行（二次 set 时归零）
        ensure_font()
        clamp_scroll()
        // 右击上下文菜单：首次 set 时建（**避免重复登记**到全局菜单注册表 ✗ 照 Table 同款 ✓）
        if ctxMenu == null {
            ctxMenu = menu.createMenuBar({})
            ctxMenu.setWindowSize(winW, winH)
            ctxMenuH = ctxMenu.addContextMenu("listbox_ctx")
            ctxMenu.on_select(func(string m, string id) { ctx_select(id) })
            menu.registerContextMenu(ctxMenu)
        }
        _loaded = true
    }

    // ==================== 右击上下文菜单 API（与 Table **同名同义** ✓ 应用层照写就熟 ✓）====================
    // 设置所属窗口逻辑宽高（菜单弹出时做边界夹紧 ✓）
    func set_window_size(int ww, int hh) {
        winW = ww; winH = hh
        ctxMenu?.setWindowSize(ww, hh)
    }
    // ★ Widget 侧接口：窗口 resize 时自动同步（见 sdl_window / sdl_layout 的 `case is …` 列表 ✓）
    func on_window_resize(int ww, int hh) { set_window_size(ww, hh) }
    // 记录所属窗口句柄（菜单要按窗口隔离绘制 ✓ 见 menu.renderContextMenus ✓）
    func set_window_handle(Ptr[u8] hwnd) { ctxMenu?.setWindowHandle(hwnd) }
    // 启用/禁用右击菜单
    func set_context_menu_enabled(bool en) { ctxMenuEnabled = en }
    func is_context_menu_enabled(): bool { return ctxMenuEnabled }
    // 追加一项，返回项在菜单内的索引（可用于挂子菜单 ✓）
    func addContextItem(Dict opts): int {
        if ctxMenu == null or ctxMenuH < 0 { return -1 }
        return ctxMenu.addContextItem(ctxMenuH, opts)
    }
    func addContextSeparator() {
        if ctxMenu == null or ctxMenuH < 0 { return }
        ctxMenu.addContextSeparator(ctxMenuH)
    }
    func setContextItemEnabled(string id, bool en) {
        if ctxMenu != null and ctxMenuH >= 0 { ctxMenu.setContextItemEnabled(ctxMenuH, id, en) }
    }
    func clear_context_items() {
        if ctxMenu != null and ctxMenuH >= 0 { ctxMenu.clearContextItems(ctxMenuH) }
    }
    func get_context_menu(): MenuBar { return ctxMenu }
    func get_context_menu_handle(): int { return ctxMenuH }
    func get_context_menu_row(): int { return ctxRow }
    func is_context_menu_open(): bool { return ctxMenu != null and ctxMenu.isOpen() }
    func on_context_select(func(int, string):void cb) { onCtxSelect = cb }
    func on_context_will_open(func(int):void cb) { onCtxWillOpen = cb }

    // 在光标处弹出（照 Table 的 `open_ctx_menu` ✓ 只有"选中语义"换成 ListBox 自己那套 ✓）
    pri func open_ctx_menu(float mx, float my, int keyMod) {
        ctxRow = index_at(mx, my)
        if ctxRow >= 0 {
            // 右击某行顺手选它（跟左键一致 ✓）；多选模式下**不动已有多选** ✗（免得误清 ✓）
            if _mode == MODE_SINGLE {
                if not is_selected(ctxRow) {
                    sel_clear(); sel_add(ctxRow)
                    if onChange != null { onChange(sel) }
                }
            } else {
                if not is_selected(ctxRow) {
                    sel_add(ctxRow)
                    if onChange != null { onChange(sel) }
                }
            }
        }
        // 弹出前把命中行交给应用层 ⇒ 由它按行重建菜单项（有歌 / 没歌 / 空白处 各不同 ✓）
        if onCtxWillOpen != null { onCtxWillOpen(ctxRow) }
        if ctxMenu == null or ctxMenuH < 0 { return }
        // 重建后一个有效项都没有 ⇒ 不弹（免得留一条空白横线 ✗）
        if ctxMenu.contextItemCount(ctxMenuH) == 0 { return }
        ctxMenu.openContext(ctxMenuH, mx, my)
    }

    // 菜单项动作分发（把"点的是哪一行"一起给出去 ✓）
    pri func ctx_select(string id) {
        if onCtxSelect != null { onCtxSelect(ctxRow, id) }
    }

    // ==================== 设置方法 ====================
    // 刷新数据：清空选择但【保留当前滚动位置】（仅在超出时夹紧），避免列表“跳回顶部”
    func set_items(Array[string] its) { items = its; sel_clear(); clamp_scroll() }
    // 追加单条（不自动滚屏，仅夹紧到有效范围）
    func add_item(string s)           { items.add(s); clamp_scroll() }

    // 智能追加：若用户当前已停在底部（跟随实时流），追加后保持贴底；
    // 否则（用户在翻看历史）保留其当前滚动位置不跳动。maxKeep>0 时超出则从顶部丢弃最旧一条。
    func append_item(string s, int maxKeep) {
        float oldMax = max_scroll()
        bool atBottom = scroll >= oldMax - 0.5
        items.add(s)
        if maxKeep > 0 and items.len() > maxKeep {
            items.remove(0)
            scroll = scroll - itemH      // 顶部丢弃一条：把滚动量同步减一行，冻结视口内“内容”
        }
        if atBottom { scroll = max_scroll() }   // 跟随模式：贴到底部
        clamp_scroll()
    }
    // 强制追加到最底部并滚到最底部（适合“日志总在底部”的场景）
    func append_bottom(string s, int maxKeep) {
        items.add(s)
        if maxKeep > 0 and items.len() > maxKeep { items.remove(0) }
        scroll = max_scroll()
        clamp_scroll()
    }
    func scroll_to_bottom() { scroll = max_scroll(); clamp_scroll() }
    func scroll_to_top()    { scroll = 0.0; clamp_scroll() }
    func is_at_bottom(): bool { return scroll >= max_scroll() - 0.5 }

    func remove_item(int idx) {
        if idx >= 0 and idx < items.len() {
            // 删除顶部项时整体内容上移一行，把滚动量同步减一行以"冻结"视口内容
            if idx == 0 { scroll = scroll - itemH }
            items.remove(idx)
            // 同步更新选中集合：删除 ==idx 的项，>idx 的项索引减一
            Array[int] newSel = []
            for sel.len() to i {
                if sel[i] == idx { continue }   // 删除被移除的项
                if sel[i] > idx { newSel.add(sel[i] - 1) }
                else { newSel.add(sel[i]) }
            }
            sel_clear()
            for newSel.len() to i { sel_add(newSel[i]) }
            clamp_scroll()
        }
    }
    func clear() { items = []; sel_clear(); scroll = 0.0; hover = -1 }
    func set_enabled(bool e)     { enabled = e }
    func set_visible(bool v)      { visible = v }
    func is_visible(): bool       { return visible }
    func set_font_size(float s)  { _fontSize = s; if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null }
    func get_x(): float          { return x }
    func get_y(): float          { return y }

    func set_scroll(float p)     { scroll = p; clamp_scroll() }
    func get_scroll(): float     { return scroll }
    func get_selected_indices(): Array[int] { return sel }
    func get_selected_index(): int {
        if sel.len() > 0 { return sel[0] }
        return -1
    }
    func get_selected_text(): string {
        int i = get_selected_index()
        if i >= 0 and i < items.len() { return items[i] }
        return ""
    }
    func set_selected(int idx) {
        if idx < 0 or idx >= items.len() { return }
        sel_clear(); sel_add(idx)
        float iy = idx * itemH
        if iy < scroll { scroll = iy }
        else if iy + itemH > scroll + h { scroll = iy + itemH - h }
        clamp_scroll()
        if onChange != null { onChange(sel) }
    }

    // ==================== 多选批量操作 ====================
    // set_selected(idx) 会清空之前的选中（单选语义），多选模式下需要批量设置方法。

    // 批量设置选中索引（替换当前选中），在多选模式下用于编程式全选/批量选中
    func set_selected_indices(Array[int] indices) {
        sel_clear()
        for indices.len() to i {
            int idx = indices[i]
            if idx >= 0 and idx < items.len() { sel_add(idx) }
        }
        clamp_scroll()
        if onChange != null { onChange(sel) }
    }

    // 全选（多选模式下选中所有项）
    func select_all() {
        sel_clear()
        for items.len() to i { sel_add(i) }
        if onChange != null { onChange(sel) }
    }

    // 清空选中（不触发回调，避免 clear() 重建列表时连锁触发）
    func clear_selection() {
        sel_clear()
        if onChange != null { onChange(sel) }
    }

    func on_change(func(Array[int]):void cb) { onChange = cb }

    func contains(float mx, float my): bool {
        return mx >= x and mx <= x + w and my >= y and my <= y + h
    }

    // 光标在第几行（-1 = 不在列表里/空白 ✓）—— ★ 2026-10-08 由 pri 改**公开** ✓
    //   应用层先前只能"自己抄一遍这个公式" ✗（本仓音乐下载器的播放条就抄了一份 ✓）
    func index_at(float mx, float my): int {
        if not contains(mx, my) { return -1 }
        int idx = _int((my - y + scroll) / itemH)
        if idx < 0 or idx >= items.len() { return -1 }
        return idx
    }

    // ==================== 交互 ====================
    func process(Event ev) {
        if not _loaded { return }
        if not visible { return }
        if not enabled { hover = -1; draggingScroll = false; return }

        // 弹层捕获：光标落在“他人的下拉弹层”范围内时，本控件忽略该事件（避免穿透到下层）
        var[float, float](mx, my) = ev.mousePos()
        if ev.isMouseWheel() { mx = ev.wheelMouseX(); my = ev.wheelMouseY() }
        // ★ 右击菜单已展开：事件**先**交菜单（选择/关闭由菜单自身负责 ✓）
        //   ⚠⚠ 必须排在下面那句"弹层捕获"**之前** ✗✗ —— 菜单打开时它自己也算一个弹层 ✓
        //     先判捕获就会把菜单自己的事件全吃掉 ⇒ 菜单看着能弹、却点不动 ✗（照 Table 的顺序 ✓）
        if ctxMenuEnabled and ctxMenu != null and ctxMenu.isOpen() {
            if ev.isMouseButtonDown() and ev.mouseButton() == 3 {
                ctxMenu.close()                        // 再右击一次 ⇒ 关上并挪到新位置重开 ✓
                if contains(mx, my) { open_ctx_menu(mx, my, ev.keyMod()) }
                return
            }
            ctxMenu.process(ev)
            return
        }

        if core.inPopupCapture(mx, my) { return }


        // 拖拽结束
        if ev.isMouseButtonUp() and draggingScroll { draggingScroll = false; return }

        // 滚动条优先于列表项
        if ev.isMouseButtonDown() and in_vscroll(mx, my) {
            var g = sb_geom()
            float maxs = g[6], trk = g[3] - g[2], thH = g[4]
            if in_thumb(mx, my) {
                draggingScroll = true
                sbDragOffset = my - g[5]                  // 记录起点相对滑块顶的偏移，避免跳动
            } else {
                draggingScroll = true
                sbDragOffset = thH / 2.0
                float rel = my - g[2] - thH / 2.0
                if trk - thH > 0.0 { scroll = rel * maxs / (trk - thH) }
                clamp_scroll()
            }
            return
        }

        // 拖拽中：跟随鼠标移动滑块
        if draggingScroll {
            if ev.isMouseMotion() {
                var g = sb_geom()
                float maxs = g[6], trk = g[3] - g[2], thH = g[4]
                float rel = my - g[2] - sbDragOffset
                if trk - thH > 0.0 { scroll = rel * maxs / (trk - thH) }
                clamp_scroll()
                core.markFrameRedraw()
            }
            return
        }

        if ev.isMouseWheel() {
            // 滚轮只作用于光标当前所在的列表框，避免同一事件被所有列表框共享而一起滚动
            if not contains(ev.wheelMouseX(), ev.wheelMouseY()) { return }
            float d = ev.wheelY() * itemH
            scroll = scroll - d
            clamp_scroll()
        }

        if ev.isMouseMotion() {
            int prevHover = hover
            if in_vscroll(mx, my) { hover = -1 }
            else { hover = index_at(mx, my) }
            bool hv = hover >= 0
            if hover != prevHover { core.markFrameRedraw() } else { core.markFrameMotion() }
            if hv and cursor >= 0 { core.requestCursor(cursor) }
            if hv and _tip != "" { tip.tipReport(_tip, mx, my) }
        }

        if ev.isMouseButtonDown() {
            // 右击：在列表内弹出上下文菜单（默认无预置项 ⇒ 由应用层在 onCtxWillOpen 里重建 ✓）
            if ctxMenuEnabled and ctxMenu != null and ev.mouseButton() == 3 {
                if contains(mx, my) { open_ctx_menu(mx, my, ev.keyMod()) }
                return
            }
            int idx = index_at(mx, my)
            if idx >= 0 {
                if _mode == MODE_SINGLE {
                    if not is_selected(idx) {
                        sel_clear(); sel_add(idx)
                        if onChange != null { onChange(sel) }
                    }
                } else {
                    if is_selected(idx) {
                        // 多选模式取消选中：从 _sel 和 _selMap 同步移除
                        for sel.len() to i { if sel[i] == idx { sel.remove(i); break } }
                        _selMap[idx] = false
                    } else { sel_add(idx) }
                    if onChange != null { onChange(sel) }
                }
            }
        }
    }

    // ==================== 行图标的绘制辅助（2026-10-09 ✓）====================

    pri func tex_for(Renderer r, string path): Ptr[u8] {
        if path == "" { return null }
        if path == imgLastPath { return imgLastTex }
        for imgCachePaths.len() to i {
            if imgCachePaths[i] == path {
                imgLastPath = path
                imgLastTex = imgCacheTex[i]
                return imgCacheTex[i]
            }
        }
        Ptr[u8] t = img.loadTexture(r.handle, path)
        imgCachePaths.add(path)
        imgCacheTex.add(t)
        imgLastPath = path
        imgLastTex = t
        return t
    }

    // 在某一行左侧画图标；返回"图标 + 间距"占宽（0 = 没画 ⇒ 调用方不必右移文字 ✓）
    pri func draw_row_icon(Renderer r, float iy, float rh): float {
        if imgDefault == "" { return 0.0 }
        Ptr[u8] tex = tex_for(r, imgDefault)
        if tex == null { return 0.0 }
        float sz = _imgSize
        if sz <= 0.0 { sz = rh - 8.0 }
        if sz <= 0.0 { return 0.0 }
        float ix = x + imgPad
        float iy2 = iy + (rh - sz) / 2.0
        r.setTextureAlpha(tex, 255)
        r.setTextureColor(tex, #FFFFFFFF)
        var[float, float](nw, nh) = r.getTextureSize(tex)
        // 保持比例完整显示（aspectFit ✓ 与 Table 图标列的默认模式一致 ✓）
        float s = sz / nw
        if sz / nh < s { s = sz / nh }
        float dw = nw * s
        float dh = nh * s
        r.drawTextureFromTo(tex, 0.0, 0.0, nw, nh, ix + (sz - dw) / 2.0, iy2 + (sz - dh) / 2.0, dw, dh)
        return sz + imgGap
    }

    // 运行时开关（`set_image_path("")` = 取消图标 ✓）
    func set_image_path(string p) { imgDefault = p }
    func set_image_size(float s) { _imgSize = s }
    func set_image_gap(float g) { imgGap = g }
    func set_image_pad(float p) { imgPad = p }

    // ==================== 渲染 ====================
    func render(Renderer r) {
        if not _loaded { return }
        if not visible { return }
        ensure_font()

        Color bgC = bgColor
        if not enabled { bgC = theme.darken(bgColor, 60) }
        r.setColor(bgC)
        r.fillRoundedRect(x, y, w, h, 6.0)

        SDL_Rect clip = SDL_Rect.malloc()
        clip.x = _int(x); clip.y = _int(y)
        clip.w = _int(w) + 1; clip.h = _int(h) + 1   // +1 覆盖浮点截断的亚像素
        r.pushClipRect(clip.to_ptr())

        float pad = 8.0
        float radius = 6.0
        // 行高为常量，循环外测量一次避免每行重复测量
        float textH = 0.0
        if _font != null and _font.ok { var[float, float](_agw, _agh) = _font.measureString("Ag"); textH = _agh }
        for items.len() to i {
            float iy = r.snapY(y - scroll + i * itemH)
            if iy + itemH < y or iy > y + h { continue }
            Color rowC = bgC
            if is_selected(i) { rowC = selColor }
            else if i == hover { rowC = hovColor }
            r.setColor(rowC)
            bool atTop = (iy <= y + 0.5)
            bool atBottom = (iy + itemH >= y + h - 0.5)
            if atTop and atBottom {
                // 唯一一行：全圆角
                r.fillRoundedRect(x, iy, w, itemH, radius)
            } else if atTop {
                // 首行：全圆角 + 填充底部左右圆角缺口
                r.fillRoundedRect(x, iy, w, itemH, radius)
                r.fillRect(x, iy + itemH - radius, radius, radius)          // 左下缺口
                r.fillRect(x + w - radius, iy + itemH - radius, radius, radius)  // 右下缺口
            } else if atBottom {
                // 末行：全圆角矩形 + 填补顶部左右圆角缺口（使顶部为直角，与上行衔接）
                r.fillRoundedRect(x, iy, w, itemH, radius)
                r.fillRect(x, iy, radius, radius)                              // 左上缺口
                r.fillRect(x + w - radius, iy, radius, radius)                 // 右上缺口
            } else {
                r.fillRect(x, iy, w, itemH)
            }

            if textH > 0.0 and i < items.len() {
                string t = items[i]
                Color tcC = txtColor
                if not enabled { tcC = theme.darken(txtColor, 60) }
                float ty = r.snapY(iy + (itemH - textH) / 2.0)
                // ★ 行图标（2026-10-09）：先画图标，再把文字整体右移它的占宽 ✓
                float ioff = draw_row_icon(r, iy, itemH)
                r.drawText(_font, t, r.snapX(x + pad + ioff), ty, tcC)
            }
        }

        r.popClipRect()
        clip.free()

        // 边框
        r.setColor(bdrColor)
        r.drawRoundedRect(x, y, w, h, 6.0)

        // 滚动条（内容超出时）
        float maxs = max_scroll()
        if maxs > 0.0 {
            float sw = 8.0
            float sx = x + w - sw - 2.0
            r.setColor(theme.withAlpha(sbColor, 180))
            r.fillRoundedRect(sx, y + 2.0, sw, h - 4.0, sw / 2.0)
            float ratio = scroll / maxs
            float thH = maths.max(20.0, maths.min(h * h / total_h(), h - 4.0))
            float thy = y + 2.0 + ratio * (h - 4.0 - thH)
            r.setColor(theme.brighten(sbColor, 60))
            r.fillRoundedRect(sx, thy, sw, thH, sw / 2.0)
        }
    }

    func dispose() {
        if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null
        ctxMenu?.dispose(); ctxMenu = null; ctxMenuH = -1      // 连同上下文菜单一起释放 ✓（免得悬空登记 ✓）
    }

    func applyTheme(Theme t) {
        bgColor = t.bg
        bdrColor = t.border
        selColor = t.bgSel
        hovColor = t.bgHover
        txtColor = t.txt
        sbColor = t.sb
    }
}

// 工厂
export func createListBox(Dict opts): ListBox {
    ListBox lb = new ListBox(); lb.set(opts); return lb
}


