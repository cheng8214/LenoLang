// sdl_slider.leno — 滑块控件
// 通过 win.addSlider({...}) 创建，拖拽 thumb 或在轨道上点击设定数值，回调 on_change(float)
import "sdl_renderer.leno" as ren; use ren.Renderer
import "sdl_opts.leno" as dochk    // 选项对账：不认识的键会报一行警告（见 sdl_opts.leno ✓）
import "sdl_font.leno" as fnt; use fnt.Font
import "sdl_event.leno" as evt; use evt.Event
import "sdl_core.leno" as core; use core.SystemCursor
import "sdl_widget.leno" as wgt; use wgt.Widget
import "sdl_tooltip.leno" as tip
import "sdl_theme.leno" as theme; use theme.(Theme, Themeable)
use theme.Color
import maths


// 本控件认的键 —— 由本文件全部 `.get("…")` **自动抽取**（是超集 ⇒ 可少报、不误报 ✓）
//   ⚠ 以后增删选项请重跑抽取（或人工核对），否则可能对合法用法误报 ✓
func _opts_keys(): Array[string] {
    return [
"cursor", "enabled", "fill_color", "font_path", "font_size", "font_style", "h", "max", "min", "step", "text_color", "thumb_color", "tip", "track_color", "value", "vertical", "visible", "w", "x", "y"
]
}
export struct Slider impl Widget, Themeable {
    float x = 0.0, y = 0.0, w = 200.0, h = 24.0
    float minV = 0.0, maxV = 100.0, value = 0.0
    float step = 0.0
    pri bool vertical = false
    pri string fontPath = ""; float _fontSize = 15.0; pri int fontStyle = 0; Font? _font
    pri Color trkColor = #2C2E36FF     // 轨道背景色
    pri Color fillColor = #3C96EBFF     // 已选填充色
    pri Color thumbColor = #EBEBF5FF   // 滑块色
    pri Color txtColor = #EBEBF5FF     // 文字色
    pri int cursor = SystemCursor.POINTER
    bool hover = false; pri bool wasHover = false; bool _dragging = false; bool enabled = true; bool visible = true; bool _loaded = false
    string _tip = ""           // 悬停提示文本（空 = 不提示）
    pri float fontH = 0.0          // 字体行高缓存（字体不变时为常量，避免每帧 measureString）
    pri func(float):void onChange

    pri func quantize(float v): float {
        if step > 0.0 { v = maths.round(v / step) * step }
        return maths.max(minV, maths.min(v, maxV))
    }

    pri func ensure_font() {
        if _font == null or not _font.ok {
            if _font != null and _font.ok { fnt.releaseFont(_font) }
            if fontPath != "" { _font = fnt.acquireFont(fontPath, _fontSize) }
            else { _font = fnt.acquireFontAuto(_fontSize) }
            if _font.ok and fontStyle != 0 { _font.setStyle(fontStyle) }
            if _font.ok { var[float, float](_agw, _agh) = _font.measureString("Ag"); fontH = _agh }
        }
    }

    // ==================== set 初始化 ====================

    func set(Dict opts) {
        dochk.check("sdl_slider", opts, _opts_keys())   // ★ 选项对账（2026-09-29 铺开 ✓）
        Theme th = theme.getTheme()
        trkColor = th.bgAlt
        fillColor = th.accent
        thumbColor = th.txt
        txtColor = th.txt
        x      = opts.get("x", 0)
        y      = opts.get("y", 0)
        w      = opts.get("w", 200)
        h      = opts.get("h", 24)
        minV   = opts.get("min", 0.0)
        maxV   = opts.get("max", 100.0)
        value  = opts.get("value", 0.0)
        step   = opts.get("step", 0.0)
        vertical = opts.get("vertical", false)
        _fontSize = opts.get("font_size", 15)
        fontPath = opts.get("font_path", "")
        fontStyle = opts.get("font_style", 0)

        // 颜色：opts 未传则保持默认值
        if opts.get("track_color") is Color => t { trkColor = t }
        if opts.get("fill_color") is Color => t { fillColor = t }
        if opts.get("thumb_color") is Color => t { thumbColor = t }
        if opts.get("text_color") is Color => t { txtColor = t }

        cursor = opts.get("cursor", SystemCursor.POINTER)
        enabled = opts.get("enabled", true)
        visible = opts.get("visible", true)
        // hover/_wasHover/_dragging 默认见字段声明
        _tip = opts.get("tip", "")
        value = maths.max(minV, maths.min(value, maxV))
        ensure_font()
        _loaded = true
    }

    // ==================== 设置方法 ====================
    func set_value(float v)    { float nv = quantize(v); if nv != value { value = nv; if onChange != null { onChange(value) } } }
    func set_tip(string t)      { _tip = t }
    func get_value(): float     { return value }
    func set_range(float lo, float hi) { minV = lo; maxV = hi; value = maths.max(minV, maths.min(value, maxV)) }
    func set_enabled(bool e)     { enabled = e }
    func set_visible(bool v)      { visible = v }
    func is_visible(): bool       { return visible }
    func set_font_size(float s)  { _fontSize = s; if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null }
    func get_x(): float          { return x }
    func get_y(): float          { return y }
    func get_w(): float          { return w }
    func get_h(): float          { return h }
    func set_pos(float px, float py) { x = px; y = py }
    func set_size(float sw, float sh) { w = sw; h = sh }

    func on_change(func(float):void cb) { onChange = cb }

    // 当前值在轴上的归一化比例 [0,1]
    pri func ratio(): float {
        float span = maxV - minV
        if span <= 0.0 { return 0.0 }
        return maths.max(0.0, maths.min((value - minV) / span, 1.0))
    }

    pri func thumb_radius(): float {
        if vertical { return maths.max(6.0, maths.min(w * 0.45, 40.0)) }
        return maths.max(6.0, maths.min(h * 0.45, 40.0))
    }

    func contains(float mx, float my): bool {
        float pad = thumb_radius() + 4.0
        if vertical { return mx >= x - pad and mx <= x + w + pad and my >= y and my <= y + h }
        return mx >= x and mx <= x + w and my >= y - pad and my <= y + h + pad
    }

    // 把鼠标坐标换算为值（用于拖拽与点击）
    pri func value_from_pos(float p): float {
        float rad = thumb_radius()
        float span
        if vertical { span = h - 2.0 * rad } else { span = w - 2.0 * rad }
        float t
        if vertical { t = (y + h - rad - p) / span } else { t = (p - (x + rad)) / span }
        if t < 0.0 { t = 0.0 }
        if t > 1.0 { t = 1.0 }
        return quantize(minV + t * (maxV - minV))
    }

    // ==================== 交互 ====================
    func process(Event ev) {
        if not _loaded { return }
        if not visible { return }
        if not enabled { hover = false; _dragging = false; return }
        // 弹层捕获：事件落在“他人的弹层（如打开的菜单/下拉）范围内时忽略，避免穿透到下层控件
        var[float, float](mx, my) = ev.mousePos()
        if ev.isMouseWheel() { mx = ev.wheelMouseX(); my = ev.wheelMouseY() }
        if core.inPopupCapture(mx, my) { return }


        if ev.isMouseMotion() {
            wasHover = hover
            hover = contains(mx, my)
            // 拖拽中：即使移出控件也要继续更新
            // 注意：motion 事件不触发整窗重绘，控件必须主动 markFrameRedraw()
            if _dragging {
                if vertical { value = value_from_pos(my) } else { value = value_from_pos(mx) }
                if onChange != null { onChange(value) }
                core.markFrameRedraw()
            } else if wasHover != hover {
                core.markFrameRedraw()   // hover 状态变化也需重绘（thumb 高亮）
            }
            if cursor >= 0 {
                if hover or _dragging {
                    core.requestCursor(cursor)
                }
            }
            // 悬停提示：hover 时上报；离开由 tipEndMotion 统一清除
            if hover and _tip != "" { var[float, float](_tx, _ty) = ev.mousePos(); tip.tipReport(_tip, _tx, _ty) }
        }

        if ev.isMouseButtonUp() { _dragging = false }

        if ev.isMouseButtonDown() and not _dragging {
            var[float, float](_cx, _cy) = ev.mousePos()
            if contains(_cx, _cy) {
                _dragging = true
                if vertical { value = value_from_pos(_cy) } else { value = value_from_pos(_cx) }
                if onChange != null { onChange(value) }
            }
        }
    }

    // ==================== 渲染 ====================
    func render(Renderer r) {
        if not _loaded { return }
        if not visible { return }
        ensure_font()
        float rad = thumb_radius()
        float baseWH
        if vertical { baseWH = w } else { baseWH = h }
        float tk = maths.max(3.0, maths.min(baseWH * 0.4, 30.0))   // 轨道厚度
        float span
        if vertical { span = h - 2.0 * rad } else { span = w - 2.0 * rad }

        // 轨道背景
        Color tC = trkColor
        if not enabled { tC = theme.darken(trkColor, 60) }
        r.setColor(tC)
        if vertical {
            float tx = x + (w - tk) / 2.0
            r.fillRoundedRect(tx, y + rad, tk, span, tk / 2.0)
        } else {
            float ty = y + (h - tk) / 2.0
            r.fillRoundedRect(x + rad, ty, span, tk, tk / 2.0)
        }

        // 已选填充
        float ratio = ratio()
        Color fC = fillColor
        if not enabled { fC = theme.darken(fillColor, 60) }
        r.setColor(fC)
        if vertical {
            float tx = x + (w - tk) / 2.0
            float fillH = tk / 2.0 + ratio * span   // 从底向上填充
            r.fillRoundedRect(tx, y + h - rad - fillH, tk, fillH, tk / 2.0)
        } else {
            float ty = y + (h - tk) / 2.0
            float fillW = tk / 2.0 + ratio * span
            r.fillRoundedRect(x + rad, ty, fillW, tk, tk / 2.0)
        }

        // thumb
        float cx, cy
        if vertical { cx = x + w / 2.0; cy = y + h - rad - ratio * span }
        else         { cx = x + rad + ratio * span; cy = y + h / 2.0 }
        Color kC = thumbColor
        if hover or _dragging { kC = theme.brighten(thumbColor, 15) }
        if not enabled { kC = theme.darken(thumbColor, 60) }
        r.setColor(kC)
        r.fillCircle(cx, cy, rad)

        // 数值文字
        if _font != null and _font.ok {
            string label = value as string
            float th = fontH
            float ty; float tx
            if vertical { ty = y + h + 6.0; var[float, float](_lw, _lh) = _font.measureString(label); tx = x + w / 2.0 - _lw / 2.0 }
            else { ty = y + h / 2.0 - th / 2.0; tx = x + w + 8.0 }
            Color tcC = txtColor
            if not enabled { tcC = theme.darken(txtColor, 60) }
            r.drawText(_font, label, tx, ty, tcC)
        }
    }

    func dispose() {
        if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null
    }

    func applyTheme(Theme t) {
        trkColor = t.bgAlt
        fillColor = t.accent
        thumbColor = t.txt
        txtColor = t.txt
    }
}

// 工厂
export func createSlider(Dict opts): Slider {
    Slider s = new Slider(); s.set(opts); return s
}


