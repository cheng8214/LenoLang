// sdl_window.leno — SDL3 窗口封装
//
// 提供两种使用模式：
// 1. run() 回调模式（推荐）：
//    win.run(onEvent, onRender)
//       onEvent: func(Event): bool  — 返回 false 退出
//       onRender: func(Renderer)    — 每帧绘制
//
// 2. 手动轮询模式：
//    var ev = SDL3.createEvent()
//    while running { while ev.poll() { ... } ren.clear(); ...; ren.present() }
import ffi
import files          // 2026-11-18：LENO_FRAME_TRACE 的帧诊断写文件用（应用多关控制台 ⇒ print 看不见）
import maths          // 控件透明度夹取 / 定时等待夹取（2026-11-01：maths.saturate / clampi）
import "sdl_core.leno" as core
import "sdl_clickthrough.leno" as ct      // 整窗鼠标穿透（2026-10-21；只依赖 core，无循环引用 ✓）
use core.SDL_KeyboardEvent     // ★ 2026-10-13：testKeyDown 注入按键要用（Leno 要求"出现它的每一处都在 use 列表里" ✓）
use core.(sdl3, SDL_Point, Size, SDL_Event, SDL_WindowEvent, SDL_MouseButtonEvent, SDL_MouseMotionEvent)   // 后两个供自测注入点击/移动 ✓
use core.SDL_MouseWheelEvent    // ★ 2026-11-01：testWheelAt 注入滚轮要用 ✓

sdl3 _lib = core.lib()

// 全局窗口引用计数，最后一个窗口销毁时才 quit
var _windowCount = 0

// ★ 2026-11-18：run 循环里"事件合并"用的两块 128B 缓冲，**只分配一次**（原来每次迭代 malloc/free）。
//   实测每次迭代的固定开销约 0.36ms，播放动画时每秒醒 1500+ 次 ⇒ 光这块就白烧半个核 ✗
//   ⚠ 只在 run 的那个线程里用（同一进程只有一个 run 循环），单线程独占 ✓
Ptr[u8] _evBufA = null
Ptr[u8] _evBufB = null

