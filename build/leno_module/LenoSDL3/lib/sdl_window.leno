// ★ 注册扩展窗口句柄下发回调：布局容器（HBox/VBox/AnchorBox）遇到 Splitter/Panel/TabControl/
// SpinBox/GroupBox/ScrollView/ComboBox 等后续扩展类型时，通过此回调下发窗口句柄，无需在 sdl_layout 中
// import 这些类型（避免循环依赖）。此前示例需手动调用 _content._bind_window()，现在自动完成。
lay.setExtraPassWindow(func(Widget c, Ptr[u8] hwnd, int ww, int hh) {
    // ★ 2026-10-10：合并 `case is A, B, ...` 可以用 ✓（样板见 sdl_layout._passWindowHandle 的说明 ✓）
    // ★ 2026-10-13：签名补了**窗口逻辑宽高**；`ww < 0` = 尺寸未知（容器路径 ✓）⇒ 只下发句柄 ✓
    //   ⚠ 这里是**全工程唯一**的"控件 ← 窗口句柄/尺寸"类型表（原来窗口里另有两份、还漂移了 ✗）
    bool hasSize = ww >= 0
    switch c {
        case is Edit { c.set_window(hwnd); return }
        // 容器：只吃句柄，自己递归往下传 ✓
        case is Panel, ScrollView, TabControl, SpinBox, GroupBox, GridLayout, ComboBox { c._bind_window(hwnd); return }
        case is Card { c._bind_window(hwnd); c.set_window_handle(hwnd); return }   // 卡片：子控件 IME + 右键菜单句柄 ✓
        case is TitleBar { c.set_window_handle(hwnd); return }
        // "句柄 + 尺寸"三件套：内嵌右键菜单要按窗口夹紧 ✓
        //   ★ 2026-10-08：ListBox 也把窗口尺寸收下 —— 它的右击上下文菜单要按窗口隔离绘制 ✓
        case is TreeView { c.set_window_handle(hwnd); if hasSize { c.set_window(ww, hh) }; return }
        case is Table, ListBox { c.set_window_handle(hwnd); if hasSize { c.set_window_size(ww, hh) }; return }
        // Splitter：有尺寸就带着尺寸往下传播（内层 Table/TreeView 才拿得到 ✓）；没有就只给句柄 ✓
        case is Splitter {
            if hasSize { c._bind_window_size(hwnd, ww, hh) } else { c._bind_window(hwnd) }
            return
        }
    }
})

// ★ 2026-10-13：注册**窗口尺寸变化**下发回调 —— 同一张类型表原来在本文件写了 3 遍 ✗
//   （主循环 / 模态窗 / 悬停弹层窗）⇒ 现在收敛到 `sdl_layout._passWindowResize` 一处，本文件只留这一处注册 ✓
//   ⚠ 以后新增"想收 resize 的控件"：**加成上面那个 switch 的一个分支**（或在 sdl_layout 里加 ✓），
//     不用再翻窗口的三个循环 ✓
lay.setExtraPassResize(func(Widget c, Ptr[u8] hwnd, int ww, int hh) {
    switch c {
        case is Splitter { c._bind_window_size(hwnd, ww, hh); return }
        // ★ Scrim 必须跟着铺满（2026-10-13 修 ✓）：否则拉大窗口后右下露一条**没遮住且点得动** ✗
        case is Scrim { c.on_window_resize(ww, hh); return }
    }
})

export alias EventHandler  = func(Event):bool
export alias RenderCallback = func(Renderer)

// ==================== 快捷键系统 ====================
// 上层通过 win.addShortcut("Ctrl+C", func() { ... }) 注册快捷键，
// 框架自动在事件循环中匹配并执行，无需手动判断 scancode/modifier。
// setShortcutGuard 设置守卫回调：返回 true 时阻止快捷键（如 Edit/Table 编辑中）。

export struct Shortcut {
    string display = ""   // 显示文本: "Ctrl+C", "F5", "Backspace"（显式初值，消 [字段未初始化] 警告）
    int scancode = 0      // 解析后的 scancode
    int modFlags = 0      // bit 0=Ctrl, 1=Shift, 2=Alt, 3=GUI
    func():void callback
    bool enabled = true
}

// 键名 → scancode 映射表（懒加载）
Dict? _keyNameMap = null

func _ensureKeyNameMap() {
    if _keyNameMap != null { return }
    _keyNameMap = {
        "F1": 58, "F2": 59, "F3": 60, "F4": 61, "F5": 62, "F6": 63,
        "F7": 64, "F8": 65, "F9": 66, "F10": 67, "F11": 68, "F12": 69,
        "BACKSPACE": 42, "DELETE": 76, "DEL": 76, "INSERT": 73,
        "ESCAPE": 41, "ESC": 41, "RETURN": 40, "ENTER": 40, "SPACE": 44, "TAB": 43,
        "HOME": 74, "END": 77, "PAGEUP": 75, "PAGEDOWN": 78,
        "LEFT": 80, "RIGHT": 79, "UP": 82, "DOWN": 81,
        "A": 4, "B": 5, "C": 6, "D": 7, "E": 8, "F": 9, "G": 10,
        "H": 11, "I": 12, "J": 13, "K": 14, "L": 15, "M": 16,
        "N": 17, "O": 18, "P": 19, "Q": 20, "R": 21, "S": 22,
        "T": 23, "U": 24, "V": 25, "W": 26, "X": 27, "Y": 28, "Z": 29,
        "0": 39, "1": 30, "2": 31, "3": 32, "4": 33, "5": 34,
        "6": 35, "7": 36, "8": 37, "9": 38
    }
}

// 解析快捷键字符串: "Ctrl+C" → {scancode, modFlags}
func _parseShortcut(string key): Dict {
    _ensureKeyNameMap()
    int mods = 0  // bit 0=Ctrl, 1=Shift, 2=Alt, 3=GUI
    string k = key
    while true {
        if k.starts_with("Ctrl+") {
            mods = mods | 1; k = k.slice(5, k.len())
        } eif k.starts_with("Shift+") {
            mods = mods | 2; k = k.slice(6, k.len())
        } eif k.starts_with("Alt+") {
            mods = mods | 4; k = k.slice(4, k.len())
        } eif k.starts_with("GUI+") {
            mods = mods | 8; k = k.slice(4, k.len())
        } else {
            break
        }
    }
    int sc = _int(_keyNameMap.get(k.to_upper(), 0))
    return {scancode: sc, mods: mods}
}

// 多窗口回调缓存
Array[int]             _runWids   = []
Array[Ptr[u8]]            _runHnds   = []
Array[Renderer]        _runRens   = []
Array[EventHandler]    _runEvts   = []
Array[RenderCallback]  _runRends  = []
Array[Array[Widget]]   _runWidgets = []
Array[Array[float]]   _runWidgetZ = []     // 各窗口控件的 z 值数组（与 _runWidgets 并行）
Array[Array[MenuBar]]   _runMenus   = []
Array[MenuBar]          _runCtxBar  = []   // 各窗口级右击上下文菜单（由 setContextMenu 注册，run 自动接管弹出）
Array[int]             _runCtxIdx  = []   // 对应的上下文菜单索引
Array[Widget?]          _runRoots  = []     // 各窗口的根布局控件（setRoot 设置，可空）
Array[float]           _runRootX = []     // 各窗口根布局 X 偏移（如 MenuBar 高度）
// ★ 2026-11-27：Tickable 用 —— 每窗口"上一帧时刻"（按 window id 存 ⇒ 窗口增删不会错位）
Array[int]             _tickWids = []
Array[int]             _tickNss  = []
Array[float]           _runRootY = []
Array[int]             _runW     = []     // 各窗口逻辑宽（背景填充 + Tooltip 夹紧用）
Array[int]             _runH     = []     // 各窗口逻辑高
Array[bool]            _runDialogHidden = []  // 对话框窗口是否创建时隐藏（首次渲染后 show）
Array[bool]            _runTransparent = []    // 各窗口是否透明（跳过背景填充）
Array[RenderCallback]  _runOverlays = []    // 各窗口叠加层回调（在所有控件/弹层/Tooltip 之上、present 之前调用）
Array[Array[Shortcut]]  _runShortcuts = []    // 各窗口快捷键列表
Array[func():bool]       _runShortcutGuards = [] // 各窗口快捷键守卫回调
// ★ 2026-11-21：**虚拟子窗口**（不向 OS 申请窗口的"对话框"）
//   为什么需要：Android 上一个 Activity 只有一个顶层窗口（SurfaceView），
//   `SDL_CreateWindow` 拿不到第二个可显示的窗口 ⇒ 弹窗静默不出现（见 sdl_dialog 的 ok 检查）。
//   做法：子窗口有自己的控件树 / 事件 / 模态状态，但**渲染目标**是自己的离屏纹理，
//   由父窗口在它客户区里合成（等比缩放 + 遮罩）。控件树坐标仍是自己的 0,0 ⇒ 弹窗布局零改动。
//   ★ 状态用**并行数组**（不用 Dict）：裸 Dict 的元素类型被"第一次写入"定死，
//     而这里要同时装 bool/int/float/Ptr ⇒ 用 `Dict[..., any]` 又处处要窄化，反而更容易错。
//   ⚠ 必须与 `_runWids` **下标对齐**：所有增删都跟其它 `_run*` 一起做（见 registerOnly / 关闭路径）。
Array[bool]             _runVOn     = []   // 是不是虚拟子窗口
Array[int]              _runVParent = []   // 父窗口 ID（0 = 无）
Array[Dict]             _runVTexD   = []   // 离屏纹理（每项 {} 或 {tex: Ptr[u8]}；逻辑尺寸 dw×dh）
Array[float]            _runVX      = []   // 合成左上角（父窗口客户区坐标）
Array[float]            _runVY      = []
Array[float]            _runVS      = []   // 合成缩放（1.0 = 原尺寸）
Array[int]              _runVDrawn  = []   // 已合成帧数（诊断用 ✓）
Array[float]            _runDens    = []   // ★ 每窗口的**密度**（物理像素/逻辑像素；桌面恒 1.0）
var _runLoopActive = false    // 主循环是否已在运行

// ---- 虚拟子窗口的取用助手（下标必须有界：并行数组在关闭路径上是逐条 remove 的）----
func _virtOn(int i): bool {
    if i < 0 or i >= _runVOn.len() { return false }
    return _runVOn[i]
}
func _virtParentOf(int i): int {
    if i < 0 or i >= _runVParent.len() { return 0 }
    return _runVParent[i]
}
func _virtTexOf(int i): Ptr[u8] {
    if i < 0 or i >= _runVTexD.len() { return null }
    var t = _runVTexD[i].get("tex", null)
    if t is Ptr[u8] { return t }
    return null
}
func _virtSetTex(int i, Ptr[u8] t) {
    if i < 0 or i >= _runVTexD.len() { return }
    if t == null { _runVTexD[i] = {} } else { _runVTexD[i]["tex"] = t }
}
func _virtXOf(int i): float {
    if i < 0 or i >= _runVX.len() { return 0.0 }
    return _runVX[i]
}
func _virtYOf(int i): float {
    if i < 0 or i >= _runVY.len() { return 0.0 }
    return _runVY[i]
}
func _virtSOf(int i): float {
    if i < 0 or i >= _runVS.len() { return 1.0 }
    return _runVS[i]
}
// 窗口 ID → 在 `_runWids` 里的下标（-1 = 不是运行中的窗口）
func _virtIndex(int wid): int {
    for _runWids.len() to i {
        if _runWids[i] == wid { return i }
    }
    return -1
}

// ★ 2026-11-21：某个窗口的**最上层虚拟子窗口**（后注册的在上层，与绘制顺序一致 ✓）
//   返回 0 = 没有。Android 返回键的分层返回第一步就靠它（见 run() 里的兜底）
func _virtTopOf(int parentWid): int {
    int i = _runWids.len() - 1
    while i >= 0 {
        if _virtOn(i) and _virtParentOf(i) == parentWid { return _runWids[i] }
        i = i - 1
    }
    return 0
}

// ★ 2026-11-21：向某窗口投递一条"请求关闭"（**异步**：下一轮 poll 才处理 ⇒ 不打断当前派发 ✓）
//   与 `Window.requestClose()` 走同一条路：会先登记"这是程序自己发的"⇒ `isUserClose()` 返回 false，
//   于是"关闭到托盘/关闭前询问"那类逻辑不会被误当成用户点 X ✓
//   ⚠ 虚拟子窗口也能用：它的合成 ID 同样会被 SDL_PushEvent 带出去（框架按 wid 找索引 ✓）
func _postClose(int wid) {
    if wid <= 0 { return }
    event.markSelfClose(wid)
    var e = SDL_Event.malloc()
    e.window.type = core.EventType.WINDOW_CLOSE_REQUESTED
    e.window.windowID = wid
    _lib.SDL_PushEvent(e)
    e.free()
}

// ★ 2026-11-21：**应用是否在后台**（Android 切出去后为真）。
//   后台时停止出帧：surface 已经销毁，`SDL_RenderPresent` 既无意义又白烧电
//   （实测模拟器上后台仍按 2fps 空转 ⇒ 手机上是实打实的掉电 ✗）。
//   桌面永不进入这个状态（收不到 DID_ENTER_BACKGROUND）⇒ 行为零变化 ✓
var _backgrounded = false
export func isBackgrounded(): bool { return _backgrounded }

// ★ 2026-11-21：**GPU 上下文丢失后的离屏资源重建**（Android 切后台回来 / 驱动重启）。
//   为什么不能"就地 Destroy"：设备重置后所有纹理句柄都已失效，拿悬空句柄去
//   SDL_DestroyTexture 是未定义行为（实测会崩）⇒ 一律**直接丢弃指针**再重新创建 ✓
func _resetOffscreen() {
    // ① 先清虚拟子窗口的纹理指针（它们建在**父窗口**的渲染器上，下面统一重建）
    for _runWids.len() to i {
        if _virtOn(i) { _virtSetTex(i, null) }
    }
    // ② 真窗口：SSAA 离屏纹理重建（无 SSAA 的直接 false，无需动作 ✓）
    for _runWids.len() to i {
        if _virtOn(i) { continue }
        _runRens[i].rebuildSSAA()
    }
    // ③ 虚拟子窗口：按"逻辑尺寸 × 父窗口密度"重新分配（与 `_virtEnsureTex` 同一算式 ⇒
    //    私有字段 `_virtTexW/H` 不必同步，也不会被误判成"尺寸变了要重建" ✓）
    for _runWids.len() to i {
        if not _virtOn(i) { continue }
        int pi = _virtIndex(_virtParentOf(i))
        if pi < 0 { continue }
        float td = _densOfWid(_virtParentOf(i))
        if td < 1.0 { td = 1.0 }
        int tw = maths.roundi(_float(_runW[i]) * td)
        int th = maths.roundi(_float(_runH[i]) * td)
        if tw < 1 { tw = 1 }
        if th < 1 { th = 1 }
        Ptr[u8] t = _runRens[pi].createTexture(core.PIXELFORMAT_RGBA8888, 2, tw, th)
        if t == null {
            print("[LenoSDL3] 设备重置后虚拟子窗口纹理重建失败：" + core.getError() + "\n")
        } else {
            _lib.SDL_SetTextureScaleMode(t, core.ScaleMode.LINEAR)
        }
        _virtSetTex(i, t)
    }
}
// 虚拟子窗口的合成 ID 发号器：与 SDL 的 windowID 不重叠（SDL 用小的自增数）
var _virtIdNext = 0x40000000
// 该窗口 ID 是否是虚拟子窗口
export func isVirtual(int wid): bool {
    int i = _virtIndex(wid)
    return i >= 0 and _virtOn(i)
}

// ★ 2026-11-21：**密度层** —— 逻辑像素 ↔ 物理像素的唯一换算点。
//   为什么必须有：Android 上 SDL 给的窗口尺寸和事件坐标**都是物理像素**
//   （`SDL_GetWindowDisplayScale` ≈ 2.75），而框架所有布局/字体/命中判断都按逻辑像素写。
//   不换算的话：13px 字在 2.75x 屏上只有 4.7dp（小到看不清）、40px 按钮 = 14.5dp（远低于
//   Material 的 48dp 最小触控尺寸）—— 界面"能用但手指点不中"。
//   ⚠ **只在 Android 上除**：桌面 Windows/macOS 的 `SDL_GetWindowSize` 已经返回逻辑点
//     （HiDPI 下 getSize < getSizeInPixels），再除一次界面会缩成 1/1.5 ✗（已验证：桌面 contentScale=1.5 时
//     getSize 仍是逻辑值）。
var _densForce = 0.0     // 0 = 按平台自动判断；>0 = 强制（测试用：桌面也能跑 Android 的代码路径 ✓）
// 强制密度（0 恢复自动）。仅在测试/调试里用 —— 正常应用不要调。
export func setDensityOverride(float v) { _densForce = if v > 0.0 then v else 0.0 }
export func getDensityOverride(): float { return _densForce }

// 按平台/显示器算出密度（1.0 = 不需要换算）
//   ⚠ 只用 `SDL_DisplayMode.pixel_density`：`SDL_GetWindowDisplayScale` 在 **Android 上恒为 1.0**
//     （后端没实现）。实测 AVD 720x1280 / 420dpi 上它返回 1.0，照它算密度 = 什么都没做 ✗
//     （这个是模拟器实测抓到的，桌面永远看不到 —— 桌面那个 API 是对的）
func _resolveDensity(): float {
    if _densForce > 0.0 { return _densForce }
    // ★ 桌面**一律不换算**：SDL 在 Windows/macOS 上的 getSize 已经是逻辑点，
    //   即使显示器是 150% 也不该再除（否则界面缩成 2/3 ✗）
    if _os() != "android" { return 1.0 }
    float v = core.getPlatformDensity()
    if v < 1.0 { return 1.0 }
    if v > 6.0 { return 6.0 }      // 兜底：荒唐值别把界面缩没了
    return v
}

// 某窗口 ID 的密度（1.0 = 不做换算；窗口未注册/虚拟子窗口 ⇒ 1.0，子窗口活在父窗口的逻辑空间里 ✓）
func _densOfWid(int wid): float {
    int i = _virtIndex(wid)
    if i < 0 or i >= _runDens.len() { return 1.0 }
    return _runDens[i]
}

// ★ 2026-11-21：这个 SDL 事件该投给哪个虚拟子窗口（返回子窗口的合成 ID；0 = 不投）
//   为什么要改投：虚拟子窗口没有 OS 窗口 ⇒ 事件里的 windowID 永远是**父窗口**的，
//   不换 ID 的话 `_runWids[j] == wid` 永远匹配不到子窗口那一项（控件全都收不到事件 ✗）。
func _virtHitTarget(int wid, Event ev): int {
    // 模态：栈顶是虚拟子窗口 ⇒ **所有**事件都归它
    //   （点在弹窗外也一样：落进"没命中任何控件"⇒ 表现就是模态挡住了下层 ✓）
    if _isModal() {
        int mt = _modalTop()
        if _virtIndex(mt) >= 0 { return mt }
        return 0
    }
    // 非模态（如音乐下载窗）：只有落在它矩形内的指针事件才归它 ⇒ 主窗口其余部分照常可点 ✓
    if not (ev.isMouseMotion() or ev.isMouseButtonDown() or ev.isMouseButtonUp() or ev.isMouseWheel()) {
        return 0
    }
    var[float, float](mx, my) = ev.mousePos()
    if ev.isMouseWheel() { mx = ev.wheelMouseX(); my = ev.wheelMouseY() }
    // 倒序：后注册的在上层（与绘制顺序一致 ✓）
    int i = _runWids.len() - 1
    while i >= 0 {
        if _virtOn(i) and _virtParentOf(i) == wid {
            float x = _virtXOf(i)
            float y = _virtYOf(i)
            float s = _virtSOf(i)
            float ex = x + _float(_runW[i]) * s
            float ey = y + _float(_runH[i]) * s
            if mx >= x and mx <= ex and my >= y and my <= ey { return _runWids[i] }
        }
        i = i - 1
    }
    return 0
}

// [诊断] 控件树绘制（含 Canvas/图片/文字）累计微秒 + 累计帧数 —— 只在基准模式打印
int _profDrawUs = 0
int _profDrawFrames = 0
int _profPresentUs = 0
int _profCbUs = 0
// 其余分段（2026-11-17 第二轮：打开展帧里的"黑箱"）
int _profEvUs = 0        // 事件轮询/派发
int _profBeginUs = 0     // beginFrame + 清屏
int _profTimerUs = 0     // tickAllTimers
int _profCursorUs = 0    // applyFrameCursor
int _profLoopFrames = 0
// [诊断] `LENO_SKIP_RENDER=1` ⇒ 只跑事件/定时器，**完全不绘制**。
//   用来把"交互开销"拆成「事件分发」与「绘制」两半（2026-11-17 实测用 ✓）
bool _skipRender = _env("LENO_SKIP_RENDER") != null
// ★ 2026-11-17 晚：**局部重绘（脏矩形）整段删除** —— 连同 `LENO_PARTIAL_REDRAW` 开关、
//   `_dirtyClip` / `_drawnWids` / `_pPart` / `_pFull` 与 core 里的 markRectDirty 全家。
//   为什么删而不是留着当开关（详见 sdl_core.leno 同一段注释）：
//     · 窗口后台缓冲不保证跨帧保留 ⇒ 只刷脏区会让其它区域闪上一帧（实测"鼠标一动整窗闪烁"）；
//     · tooltip / toast / 焦点环 / 弹层都画在脏区之外 ⇒ 补 1x 离屏纹理也救不了；
//     · 脏区是全局一份，多窗口下先渲染的窗口会把别人的清掉。
//   要真做是一整轮独立工作（离屏缓冲 + overlay 纳入 + 按窗口脏区 + 控件树剔除），
//   不是"加个开关"——现在的收益由**分窗重绘**（F4）承担，整窗重绘本身不再拖别的窗口 ✓
int _profWaitUs = 0      // ev.waitTimeout（**睡眠**，不是 CPU —— 会大幅抬高 us_per_frame）
int _profIters = 0       // 循环迭代次数（与 frames 不同：有的迭代不渲染）
int _profBodyUs = 0      // 整个循环体耗时（从帧标志计算到帧末）

func _profAdd(int t0): int {
    return _int(_float(core.getPerfCounter() - t0) * 1000000.0 / _float(core.getPerfFrequency()))
}

// ==================== 控件级「模态浮层」/「点外部」状态（**按窗口 ID 归属**）====================
// ★ 2026-11-13（Aria 实测反哺，重要）：
//   这两组状态原来是 **Window 的实例字段**（`pri Widget? _modalW` / `pri bool _outArmed` …），
//   可是**事件派发的循环只有一个**（`run()` 是方法，`_runLoopActive` 保证同一进程只有一个循环在跑）
//   ⇒ 循环体里读到的 `_modalW` / `_outX`… 永远是「**开循环的那个窗口**」的字段，
//     而不是「**事件所属窗口**」的字段 ✗
//   ⇒ 症状：主窗口设过 `set_click_outside(播放列表矩形)` 之后，用户去点**对话框窗口**（另一个
//     OS 窗口）的按钮 —— 那个按钮的**客户区局部坐标**被拿去和**主窗口**的矩形比 ⇒ 判成"点了外面"
//     ⇒ ① 回调把播放列表收了 ② 这一下还被 `swallowed` 吞掉 ⇒ 对话框的按钮**根本没收到点击**
//     （Aria 实测：弹出播放列表后再弹 msgBox，点「清空」第一下只关掉了播放列表，第二下才关对话框 ✗）
//   修法：状态改成**模块级 + 记下所属窗口 ID**，派发时只对 `wid` 相同的窗口生效 ✓
//   （单窗口应用行为完全不变 ✓）
var _moWid = -1                  // 归属窗口 ID（-1 = 无）
Widget? _moWidget = null         // 模态浮层持有者（见派发处的 modalHit ✓）
var _moX = 0.0
var _moY = 0.0
var _moW = 0.0
var _moH = 0.0
var _outWid = -1                 // 归属窗口 ID（-1 = 无）
func():void _outCb = null       // 点外部回调（见 set_click_outside）
var _outArmed = false
var _outX = 0.0
var _outY = 0.0
var _outW = 0.0
var _outH = 0.0

// 窗口销毁时把它的浮层状态一并摘掉（否则宽高/回调残留到下次同 ID 窗口 ✓）
func _dropOverlayState(int wid) {
    if _moWid == wid { _moWid = -1; _moWidget = null; _moW = 0.0; _moH = 0.0 }
    if _outWid == wid { _outWid = -1; _outCb = null; _outArmed = false; _outW = 0.0; _outH = 0.0 }
}

// ★ 2026-11-21：销毁"第 i 个运行期窗口"的全部资源（主循环里 4 条收尾路径共用）
//   为什么必须收敛到一处：虚拟子窗口的 `handle` / `Renderer` 都是**父窗口的**
//   ⇒ 照原样 `SDL_DestroyWindow(_runHnds[i])` 会把主窗口炸掉 ✗（4 处各改一遍极容易漏 ✓）
func _destroyEntry(int i) {
    var ws = _runWidgets[i]
    if ws != null { for ws to w { w.dispose() } }
    var rt = _runRoots[i]
    rt?.dispose()
    if _virtOn(i) {
        Ptr[u8] t = _virtTexOf(i)
        if t != null { _lib.SDL_DestroyTexture(t); _virtSetTex(i, null) }
        return                       // 不碰 SDL 窗口 / 不碰 Renderer / 不递减 _windowCount ✓
    }
    _runRens[i].destroy()
    _lib.SDL_DestroyWindow(_runHnds[i])
    _windowCount -= 1
}

// ★ 2026-11-08 诊断：累计渲染帧数。配合 timer.debugDump() 可以判断
//   空闲时的高 CPU 是「定时器驱动的频繁重绘」还是别的原因。
var _frameTotal = 0
export func frameTotal(): int { return _frameTotal }

// 主循环是否**已经**在跑（即某个窗口的 run 正占着它）
//
// ★ 2026-11-05（Aria 头像裁剪实测反哺）：
//   `run` 开头有 `if _runLoopActive { return }` —— 主循环已在跑时，**它只把窗口注册进去、
//   立刻返回**。所以 `runModal(...)` 这个名字看着像"阻塞到窗口关闭"，实际不是：
//   在已运行的应用里它一定立刻返回，窗口是**异步**显示的。
//   ⇒ 调用方必须自己判断：真阻塞时才能在 runModal 之后读结果；否则结果得由
//     按钮回调 / 关闭回调交出（Aria 那次就是在"窗口刚建好"时用空值回调了，
//     界面直接显示"已取消头像选择" ✗）。
//
//   用法：
//     bool blocked = not SDL3.isRunLoopActive()
//     SDL3.runModal(dlg, onEvent, onRender)
//     if blocked { /* 这里才拿得到用户的选择 */ } else { /* 异步：等回调 */ }
export func isRunLoopActive(): bool { return _runLoopActive }
Array[int] _modalStack = []   // 模态窗口栈（支持嵌套）
var _exitRequested = false    // 程序化退出请求（requestExit ⇒ 主循环下一轮收尾返回）
var _closeCanceled = false    // 本次关闭请求被拦截（Window.cancelClose ⇒ 不销毁窗口）

// ★ 安全网：每帧向根控件下发窗口句柄，确保所有子控件（含动态添加的）都能拿到 _hwnd。
//   与 Window._passWindowHandle 逻辑一致，但作为模块级函数供事件循环调用（可处理多窗口）。
func _refreshWindowHandle(Widget w, Ptr[u8] hwnd, int ww, int hh) {
    // ★ 2026-10-13：类型表**收敛到 `sdl_layout.passWindowHandleSized`** ✓ ——
    //   原来本文件与 `Window._passWindowHandle` **各写了一份、还漂移了** ✗
    //   （这份有 ListBox/GridLayout；那份有 Card 却**漏了 ListBox**，靠"每帧安全网"掩盖着 ✓）
    lay.passWindowHandleSized(w, hwnd, ww, hh)
}

// 模块级快捷键尝试匹配（事件循环中调用，必须在 _runShortcuts/_runShortcutGuards 定义之后）
func _tryShortcut(int winIdx, Event ev): bool {
    if winIdx >= _runShortcuts.len() { return false }
    var shortcuts = _runShortcuts[winIdx]
    if shortcuts.len() == 0 { return false }
    var guard = _runShortcutGuards[winIdx]
    if guard != null {
        if guard() { return false }
    }
    int sc = ev.scancode()
    int mod = ev.keyMod()
    bool ctrl = (mod & 64) != 0 or (mod & 128) != 0
    bool shift = (mod & 1) != 0 or (mod & 2) != 0
    bool alt = (mod & 4) != 0 or (mod & 8) != 0
    bool gui = (mod & 16) != 0 or (mod & 32) != 0
    for shortcuts.len() to si {
        Shortcut s = shortcuts[si]
        if not s.enabled { continue }
        if s.scancode != sc { continue }
        int mf = s.modFlags
        if (mf & 1) != 0 and not ctrl { continue }
        if (mf & 2) != 0 and not shift { continue }
        if (mf & 4) != 0 and not alt { continue }
        if (mf & 8) != 0 and not gui { continue }
        if s.callback != null { s.callback() }
        return true
    }
    return false
}

// 查找控件列表中 TitleBar 的高度（用于 MenuBar 偏移）
func _findTitleBarHeight(Array[Widget] widgets): float {
    if widgets == null { return 0.0 }
    for widgets.len() to i {
        var w = widgets[i]
        if w is TitleBar { TitleBar tb = w; return tb.get_h() }
    }
    return 0.0
}

// 推入模态窗口（runModal 内部调用）
export func pushModal(int w) { _modalStack.add(w) }
// 弹出栈顶：仅当栈顶匹配时才弹出（防止重复弹/弹错）
export func popModalIfTop(int w) {
    if _modalStack.len() > 0 and _modalStack[_modalStack.len() - 1] == w { _modalStack.pop() }
}
// 当前是否为模态状态（栈非空即模态）
func _isModal(): bool { return _modalStack.len() > 0 }
func _modalTop(): int {
    if _modalStack.len() > 0 { return _modalStack[_modalStack.len() - 1] }
    return -1
}

// 获取模态栈中指定窗口下方的窗口 ID（即打开该模态窗口的父窗口）
func _modalParent(int wid): int {
    for _modalStack.len() to i {
        if _modalStack[i] == wid {
            if i > 0 { return _modalStack[i - 1] }
            return -1
        }
    }
    return -1
}

// ★ 自测/自动化用：向指定窗口**注入一次鼠标点击**（坐标为**客户区**坐标，不含标题栏 ✓）
//   与 `Window.requestClose()` 同一路数（那个的注释写着"自测/脚本触发关闭流程 —— 人手点 X
//   没法自动化 ✓"）—— 点击同理：**人手点也没法进无人值守的断言** ⇒ 留一个门 ✓
//   为什么必须"注入**事件**"而不是直接调用控件回调：注入走的是**真实派发链路** ——
//   窗口路由 → 模态栈裁决（非栈顶只 raise、不派发 ✓）→ 控件命中测试（Button.contains ✓）
//   ⇒ 能断言"这一点到底有没有落到那个按钮上" ✓
//   —— 这正是 2026-09-30「点确认没反应」那类 bug 的判别点：当时用 **窗口矩形** 坐标去点，
//      整体偏了一个标题栏高 ⇒ 点在了按钮外面（结果点到别处 ✗，教训记在这里 ✓）
//   ⚠ 坐标是**客户区**坐标；`SDL3.getModalWid()` 可拿到当前模态窗 id ⇒ 断言里这样用：
//      `SDL3.testClickAt(SDL3.getModalWid(), x, y)` ✓
//   返回：按下 / 抬起两条事件是否都投递成功
export func testClickAt(int wid, float x, float y): bool {
    bool okDown = _pushMouseEvent(true, wid, x, y)
    bool okUp = _pushMouseEvent(false, wid, x, y)
    return okDown and okUp
}

// 注入一次**右键**点击（自测用 ✓ 2026-10-08 补）
//   为什么补：先前只有左键注入 ✗ ⇒ "上下文菜单弹没弹出来"这类**只能在真机手点** ✗
//   按钮号与 `Event.mouseButton()` 的约定一致：1 = 左、2 = 中、3 = 右 ✓（同 Table 的判据 ✓）
export func testRightClickAt(int wid, float x, float y): bool {
    bool okDown = _pushMouseEvent(true, wid, x, y, 3)
    bool okUp = _pushMouseEvent(false, wid, x, y, 3)
    return okDown and okUp
}

// 只投递"按下"或"抬起"中的一条（自测用：要复现"抬起丢了"这类场景 ✓）
//   ⚠ 形参不能叫 `down`（它是语言关键字 ✗，编译期报"期望表达式"）
export func testMouseAt(int wid, float x, float y, bool pressed): bool {
    return _pushMouseEvent(pressed, wid, x, y)
}

// 投递一条鼠标移动（自测用：悬停 / 拖拽阈值 ✓）
export func testMoveAt(int wid, float x, float y): bool {
    // ★ 2026-11-12：`SDL_Event` 改成 union 后，直接按成员写法构造（等价 C 的
    //   `ev.motion.type = …`），且 `malloc()` 已零初始化 ⇒ 不再手工 malloc + 清零循环。
    var e = SDL_Event.malloc()
    e.motion.type = core.EventType.MOUSE_MOTION
    e.motion.windowID = wid
    e.motion.which = 0
    e.motion.state = 0
    e.motion.x = x
    e.motion.y = y
    bool r = _lib.SDL_PushEvent(e)      // union 实例自动转指针
    e.free()
    return r
}

// ★ 2026-11-01 反哺：投递一条**鼠标滚轮**（自测用）
//   为什么补：表格/列表的"滚到底自动加载"只有真滚轮才触发，无头探针以前没法验 ✗
//   `dy` 与 SDL 同号：**负 = 向下滚**（内容往上走，scrollY 变大）
//   x/y 是**客户区**坐标（与 testMoveAt 一致）：滚轮事件自带鼠标位置，控件用它做命中判断 ✓
export func testWheelAt(int wid, float x, float y, float dy): bool {
    var e = SDL_Event.malloc()
    e.wheel.type = core.EventType.MOUSE_WHEEL
    e.wheel.windowID = wid
    e.wheel.which = 0
    e.wheel.y = dy
    e.wheel.mouse_x = x
    e.wheel.mouse_y = y
    bool r = _lib.SDL_PushEvent(e)
    e.free()
    return r
}

// 注入一次**窗口失去焦点**（自测用 ✓ 2026-10-13 补）
//   为什么补：像 ComboBox 那种"失焦应收起下拉"的行为，**只有真机 Alt+Tab 才触发** ✗ ⇒ 以前无法自动回归；
//   有了它就能在探针里"展开下拉 → 注入失焦 → 断言已收起" ✓（与 testClickAt 同一思路 ✓）
//   ⚠ 只投递失焦本身；是否真的换了焦点由各控件自己按语义处理 ✓
export func testFocusLost(int wid): bool {
    var e = SDL_Event.malloc()
    e.window.type = core.EventType.WINDOW_FOCUS_LOST
    e.window.windowID = wid
    bool r = _lib.SDL_PushEvent(e)
    e.free()
    return r
}

// 注入一次**窗口获得焦点**（与 testFocusLost 配对；同样只用来自测 ✓）
export func testFocusGained(int wid): bool {
    var e = SDL_Event.malloc()
    e.window.type = core.EventType.WINDOW_FOCUS_GAINED
    e.window.windowID = wid
    bool r = _lib.SDL_PushEvent(e)
    e.free()
    return r
}

// 注入一次**按键**（自测用 ✓ 2026-10-13 补）
//   为什么补：焦点链（Tab / Shift+Tab / Enter / Space）**只有真键盘才会触发** ✗ ⇒ 以前无法自动回归 ✓
//   scancode 用 `core.Scancode.TAB` / `.RETURN` / `.SPACE` 这类常量 ✓；mod 用 SDL 修饰位掩码（Shift = 0x0003 ✓）
//   ⚠ 与 testClickAt 同款：**只投递事件**，是否消费由窗口/控件按语义自己决定 ✓
export func testKeyDown(int wid, int scancode, int mod = 0): bool {
    var e = SDL_Event.malloc()
    e.key.type = core.EventType.KEY_DOWN
    e.key.windowID = wid
    e.key.scancode = scancode
    e.key.mod = mod
    bool r = _lib.SDL_PushEvent(e)
    e.free()
    return r
}

// 注入一条**全局事件**（无 windowID；自测用 ✓ 2026-11-21 补）
//   为什么要：生命周期（切后台/回前台）与渲染设备重置在桌面上**永远不会自然发生**，
//   但它们决定了手机会不会白烧电、离屏纹理会不悬空 ⇒ 必须能自动化回归 ✓
//   evType 传 `core.EventType.DID_ENTER_BACKGROUND` 这类常量
export func testGlobalEvent(int evType): bool {
    var e = SDL_Event.malloc()
    e.type = evType
    bool r = _lib.SDL_PushEvent(e)
    e.free()
    return r
}

// 投递一条鼠标按键事件（内部用；SDL_Event 缓冲取 128 字节 ✓）
//   ⚠ 模块级"私有"只用 `_` 前缀即可 —— 写成 `pri func` 会被解析器判成语法错误 ✗（实测 ✓）
func _pushMouseEvent(bool pressed, int wid, float x, float y, int button = 1, int which = 0): bool {
    var e = SDL_Event.malloc()
    if pressed {
        e.button.type = core.EventType.MOUSE_BUTTON_DOWN
        e.button.down = 1
    } else {
        e.button.type = core.EventType.MOUSE_BUTTON_UP
        e.button.down = 0
    }
    e.button.windowID = wid
    e.button.which = which                          // 0 = 真鼠标 / 0xFFFFFFFF = 触摸合成（见 isTouchLike ✓）
    e.button.button = button                        // 1 = 左键 / 2 = 中键 / 3 = 右键（默认左键 ✓）
    e.button.clicks = 1
    e.button.x = x
    e.button.y = y
    bool r = _lib.SDL_PushEvent(e)
    e.free()
    return r
}

// ★ 2026-11-21：注入**手指**触点（自测用）。为什么必须专门造一套：
//   `Event.isTouchLike()` 靠 SDL 的 `which` 标记区分手指和鼠标，而 `testMouseAt` 注入的
//   which=0 会被当成鼠标 ⇒ "拖动内容滚动"/惯性这条代码路径**根本走不到** ✗（等于没测）。
//   用 SDL_TOUCH_MOUSEID = 0xFFFFFFFF 注入 ⇒ 与 Android 上真实手指完全同一条路 ✓
//   ⚠ 用法：**一帧一个事件**（down → move × N → up），别一口气全推 ——
//     主循环会把同帧的多条 motion 合并成最后一条 ⇒ 每帧位移失真、速度/惯性也就测不准 ✗
export func testTouchDown(int wid, float x, float y): bool {
    return _pushMouseEvent(true, wid, x, y, 1, 0xFFFFFFFF)
}
export func testTouchUp(int wid, float x, float y): bool {
    return _pushMouseEvent(false, wid, x, y, 1, 0xFFFFFFFF)
}
export func testTouchMove(int wid, float x, float y): bool {
    var e = SDL_Event.malloc()
    e.motion.type = core.EventType.MOUSE_MOTION
    e.motion.windowID = wid
    e.motion.which = 0xFFFFFFFF      // 触摸合成标记
    e.motion.state = 1               // 左键按下中
    e.motion.x = x
    e.motion.y = y
    bool r = _lib.SDL_PushEvent(e)
    e.free()
    return r
}

// 按 wid 提升窗口到前台（SDL_RaiseWindow）
export func raiseWindow(int wid) {
    for _runWids.len() to i {
        if _runWids[i] == wid { _lib.SDL_RaiseWindow(_runHnds[i]); return }
    }
}

// ★ 请求主循环退出（销毁所有已注册窗口并返回，与 SDL_QUIT 事件同一套清理流程）。
//   给"非 onEvent 上下文"开的门：托盘菜单回调 / 定时器 / 渲染回调里想结束程序时调用 ✓
//   onEvent 返回 false 仍是首选；但在托盘回调里没法 return false（回调签名是 func():void）
//   ⇒ 先调用本函数，主循环下一轮统一收尾 ✓（不是立即返回：不打断当前事件/渲染处理）
export func requestExit() { _exitRequested = true }

// 兼容旧 API（已废弃，仅 test_modal_dialog.leno 等旧示例使用）
export func setModalWid(int w) {
    if w < 0 { _modalStack = [] }
    else { _modalStack.add(w) }
}
export func getModalWid(): int { return _modalTop() }

// 仅为注册（不启动循环），给 Dialog 等外部 struct 用
// ⚠ 形参原来是 `any onEvent, any onRender` —— 与下面的 `_runEvts: Array[EventHandler]` /
//   `_runRends: Array[RenderCallback]` 冲突（v3.2.7 起"静态 any 不允许流进具体类型形参"）。
//   同文件的 `registerOnly(EventHandler, RenderCallback)` 本来就是**正确写法** ⇒ 对齐即可。
export func registerRun(Ptr[u8] hdl, int wid, Renderer ren, EventHandler onEvent, RenderCallback onRender) {
    _runWids.add(wid)
    _runHnds.add(hdl)
    _runRens.add(ren)
    _runEvts.add(onEvent)
    _runRends.add(onRender)
    _runOverlays.add(null)   // 占位（Dialog 无叠加层）
}


export struct Window {
    Ptr[u8] handle    // SDL_Window 指针
    bool ok = false       // 窗口是否创建成功（显式初值，消 [字段未初始化] 警告）
    // ★ 2026-11-21：虚拟子窗口（见 `_runVirt` 那段说明）
    bool virt = false         // 本窗口不拥有 OS 窗口：渲染到自己的离屏纹理，由父窗口合成
    pri int _virtID = 0       // 合成窗口 ID（不与 SDL 的 windowID 冲突：从 0x40000000 起发 ✓）
    pri int virtLW = 0        // 逻辑宽（= opts 的 w；与父窗口尺寸无关 ✓）
    pri int virtLH = 0        // 逻辑高
    pri int _virtTexW = 0     // 纹理实际尺寸（创建时 = 逻辑尺寸）
    pri int _virtTexH = 0
    // ★ 2026-11-21：本窗口的**密度**（物理像素 / 逻辑像素）。桌面恒 1.0，Android ≈ 2.75
    //   作用：`getSize()` 除、`setSize()` 乘、Renderer 的 setScale 乘 ⇒ 应用永远只见逻辑像素 ✓
    pri float _dens = 1.0
    int _w = 0; int _h = 0; pri float aaScale = 0.0
    // 最大渲染帧率（0 = 不限制）。2026-09-25 由 **30 调到 60**：
    //   实测（dummy 驱动、每帧主动请求重绘 ⇒ 完全由上限决定）：
    //     · 上限 30 时只跑到 ~20.5 fps ✗ —— 节流"多等"了约 15ms/帧（waitTimeout 毫秒精度 + 5ms 兜底 ✓）
    //     · 空窗口裸帧成本 ~17.7ms ⇒ 60 的节流间隔(16ms)与它同量级 ⇒ 轻界面能吃到全部收益 ✓
    //     · 重界面裸成本 ~28ms/帧（示例页 5）⇒ 天花板 ~35fps，改 60 只多拿几点 ⚠
    //   ⚠ 代价是 CPU：重界面上几乎恒定占满 ⇒ 省电/弱机场景仍可 `setMaxFPS(30)` 兜底 ✓
    pri int maxFPS = 60
    pri Array[Widget] widgets = []
    pri Array[float]  widgetZ = []   // 各控件的 z 值（与 _widgets 并行），渲染时按 z 升序排列
    // ★ 2026-10-13：控件级不透明度（与 `widgets` **按下标对齐**，但是**稀疏**的 ✓）
    //   为什么稀疏：`widgets.add` 的调用点有 40+ 处（每个 `addXxx` 各一处 ✗）—— 不想为了一个
    //   新特性去改 40 处注册代码 ✗ ⇒ 只有被 `set_widget_opacity` 显式设过的下标才有值，
    //   查表越界一律当 1.0 ✓（后续新加的控件天然是 1.0 ✓）
    pri Array[float]  widgetOpac = []
    pri Array[MenuBar]  menus  = []   // 菜单栏集合，第二遍画下拉层（盖在最上层）
    pri MenuBar? ctxBar              // 窗口级右击上下文菜单（setContextMenu 注册，run 自动接管弹出）
    pri int    ctxIdx = -1             // 对应的上下文菜单索引（-1 表示未注册）
    pri Widget? root                     // 根布局控件（setRoot/setRootAt 设置），缩放时自动跟随
    pri float rootX = 0.0, rootY = 0.0  // 根布局偏移（如 MenuBar 高度偏移）
    bool _dialogHidden = false        // 对话框窗口：创建时隐藏，首帧渲染完后 show（消除闪现）
    pri bool transparent = false          // 透明窗口（跳过背景填充）
    RenderCallback? _overlay = null      // 叠加层渲染回调（setOverlay 设置，在所有控件/弹层之上绘制）
    Array[Shortcut] _shortcuts = []    // 本窗口注册的快捷键
    pri func():bool shortcutGuard = null  // 快捷键守卫：返回 true 时阻止快捷键

    // 设置叠加层渲染回调（在所有控件和弹层渲染之后、present 之前调用）
    // 用途：拖拽浮动框、自定义全局浮层等需要绘制在所有控件之上的场景
    // ★ 2026-10-31 反哺：**单槽语义** —— 整个窗口只有一个 overlay 槽。
    //   实测踩过：应用自己挂了一个 toast 浮层，自检的截图钩子又挂一个
    //   ⇒ 后挂的把前者顶掉（截图模式下 toast 直接不显示，且完全静默 ✗）
    //   ⇒ 重复调用时打一行日志；真要多个浮层请**合成一个**回调内部再分发 ✓
    func setOverlay(RenderCallback cb) {
        if _overlay != null and cb != null {
            print("[warn] Window.setOverlay 被重复调用：前一个渲染回调已丢弃（窗口只有一个 overlay 槽）\n")
        }
        _overlay = cb
    }

    // ★ 「关闭到托盘」：拦截本次窗口关闭请求 ⇒ 主循环**不**销毁窗口（不再自动退出）。
    //   只对**本次** WINDOW_CLOSE_REQUESTED 有效，且必须在 onEvent 里收到 ev.isWindowClose()
    //   时调用（标记在每次调用处理器前清零 ⇒ 不会跨事件残留 ✓）。典型用法：
    //     win.run(func(Event ev): bool {
    //         if ev.isWindowClose() { win.hide(); win.cancelClose(); return true }   // 收进托盘继续跑
    //         if ev.isQuit() { return false }                                        // 真退出
    //         ...
    //     }, ...)
    //   ⚠ 与 SDL 的 SDL_HINT_QUIT_ON_LAST_WINDOW_CLOSE 无关：本函数只影响 run() 主循环的
    //     窗口销毁判断；窗口随后仍可用 win.show() 恢复 ✓
    func cancelClose() { _closeCanceled = true }

    // ★ 程序化"请求关闭"该窗口：向事件队列投递一条 WINDOW_CLOSE_REQUESTED
    //   （与用户点 X 走**同一条**路径 ⇒ onEvent 里"关闭到托盘/关闭前询问"的逻辑照样生效 ✓）
    //   用途：① 自测/脚本触发关闭流程（人手点 X 没法自动化 ✓）
    //        ② 应用自己的"关闭"按钮走同一套收尾，而不是各写一套
    //   返回：投递是否成功（事件被禁用的环境下 SDL_PushEvent 返回 false ⇒ 调用方要能知道 ✓）
    func requestClose(): bool {
        // ★ 2026-11-08 框架缺陷修复：**标记这是程序自己发起的关闭**
        //   原来 requestClose 投递的事件与用户点 X 完全一样（同一个 WINDOW_CLOSE_REQUESTED），
        //   onEvent 里分不清是谁关的 —— 于是"登录成功后关闭对话框"被当成"用户关窗"，
        //   在 force 模式下直接 requestExit() 把整个程序退了（实测 ✗）。
        //   现在用 `Event.isUserClose()` 区分；标记在事件被消费时清掉。
        // ★ 2026-11-21：投递动作抽到模块级 `_postClose`（返回键的分层返回也要用它 ✓）
        int wid = getID()
        event.markSelfClose(wid)        // 登记"这是程序自己发的关闭"，供 Event.isUserClose() 判断 ✓
        var e = SDL_Event.malloc()                      // 128 字节、零初始化
        e.window.type = core.EventType.WINDOW_CLOSE_REQUESTED
        e.window.windowID = wid
        bool r = _lib.SDL_PushEvent(e)
        e.free()
        return r
    }

    // ==================== 快捷键注册 ====================
    // 注册快捷键，key 格式: "F5", "Backspace", "Ctrl+C", "Ctrl+Shift+S"
    // 返回 Shortcut 对象，可通过 .enabled = false 临时禁用
    func addShortcut(string key, func():void cb): Shortcut {
        var parsed = _parseShortcut(key)
        Shortcut s = new Shortcut()
        s.display = key
        s.scancode = parsed.get("scancode", 0)
        s.modFlags = parsed.get("mods", 0)
        s.callback = cb
        _shortcuts.add(s)
        return s
    }

    // 移除已注册的快捷键
    func removeShortcut(Shortcut s) {
        for _shortcuts.len() to i {
            if _shortcuts[i] == s { _shortcuts.remove(i); return }
        }
    }

    // 设置守卫回调：返回 true 时阻止所有快捷键（如 Edit/Table 编辑中）
    func setShortcutGuard(func():bool guard) { shortcutGuard = guard }

    // opts 支持字段：title(string), w(int), h(int), flags(int)
    //   ★ 2026-10-13：补**选项对账** ✓ —— 本文件原来没有 `dochk.check` ✗
    //     ⚠ 白名单**只列创建窗口自己读的键** ✓ —— 各 `addXxx` 的 opts 由**控件自己**对账 ✓
    //       （`z` 是窗口侧通用键、`addXxx` 读它做层级 ✓ ⇒ 已在 `sdl_opts` 里**豁免** ✓
    //        不然控件会把它当"不认识"报出来 ✗）
    func init(Dict opts): bool {
        //   ⚠ `icon` 是**门面**（`SDL3.createWindow`）收的键 ✓ —— 门面用它在
        //     Linux/macOS 上补一次 `SDL_SetWindowIcon` ✓，然后**原样**把 opts 透传到这里 ✗
        //     ⇒ 键表里必须含它，否则会**误报** ✓（实测：海报墙的 `icon:` 就是这么被报出来的 ✓）
        //   ★ 2026-10-31：这里的运行时对账**已删** —— 改由门面 `SDL3.createWindow` 的
        //     `@optkeys` 在编译期做（同一份键表：title/w/h/flags/resizable/aa/icon ✓）
        if not core.initVideo() {
            print($"[LenoSDL3] init failed: {core.getError()}")
            return false
        }
        string title = opts.get("title", "LenoSDL3")
        int w        = opts.get("w", 800)
        int h        = opts.get("h", 600)
        int flags    = opts.get("flags", 0)
        // ★ `resizable:true` ⇒ 补上 SDL_WINDOW_RESIZABLE（0x20）—— 窗口可拖边缘缩放/最大化 ✓
        //   为什么以前不行：`flags` 默认 0，而 **init 从来没读过 `resizable` 选项** ✗ ⇒
        //   示例里写的 `resizable:false` / `resizable:true` 一直是**被忽略的选项** ✗（实测踩到 ✓）
        //   默认仍是"不可缩放"= 历史行为不变 ✓；要缩放就显式 `resizable:true` ✓
        if opts.get("resizable", false) { flags = flags | 0x20 }
        _w = w; _h = h
        // 检测透明窗口标志
        transparent = (flags & 0x0000000040000000) != 0
        // 超采样抗锯齿：默认关闭；aa:true / aa:2 / aa:1.5 开启
        aaScale = 0.0
        var aaOpt = opts.get("aa", 0.0)
        if aaOpt is bool { if aaOpt { aaScale = 2.0 } }
        else { float a = aaOpt; if a > 0.0 { aaScale = a } }
        // ★ 2026-11-21：虚拟子窗口 —— **不建 OS 窗口**（Android 上一个 Activity 只有一个顶层窗口，
        //   第二个 `SDL_CreateWindow` 拿不到可显示的窗口）。`ok` 在这里表示"参数合法"，
        //   真正能否合成由父窗口决定（见 `_registerVirtual`：找不到父窗口才置 false）。
        if virt or opts.get("virtual", false) {
            virt = true
            _virtIdNext = _virtIdNext + 1
            _virtID = _virtIdNext
            virtLW = w; virtLH = h
            _w = w; _h = h
            handle = null
            ok = true
            return true
        }
        handle = _lib.SDL_CreateWindow(title, w, h, flags)
        ok = handle != null
        // ★ 2026-11-21：窗口句柄有了才能问显示器密度（Android ≈2.75，桌面 100% ⇒ 1.0）
        //   放在这里而不是 registerOnly：`getSize()` 在 registerOnly 之前就会被调用（如下面的
        //   `SDL_SyncWindow` 之后取实际尺寸），那时 `_dens` 必须已经是对的 ✓
        if ok { _dens = _resolveDensity(); _windowCount = _windowCount + 1 }
        return ok
    }
    // 获取窗口 ID
    // ★ 2026-11-21：虚拟子窗口没有 OS 窗口（handle 为 null）⇒ 返回自己发的合成 ID，
    //   否则 `SDL_GetWindowID(null)` 恒为 0 ⇒ 与"全局事件"撞号、模态栈全乱。
    func getID(): int {
        if virt { return _virtID }
        return _lib.SDL_GetWindowID(handle)
    }

    // ★ 2026-11-17（F4）：只让**这个**窗口重绘（其余窗口这一帧整个跳过）。
    //   用途：浮窗 / 桌宠 / 桌面歌词这类独立小窗自己的定时器里调它，
    //   而不是全局 `markFrameRedraw()` —— 后者会把主窗口一起拖着重绘。
    func redraw() {
        core.requestRedrawWindow(getID())
    }

    func getHandle(): Ptr[u8] { return handle }

    // 设置窗口标题
    func setTitle(string title): bool {
        if virt { return true }        // 无 OS 窗口 ⇒ 标题由自绘标题栏显示
        return _lib.SDL_SetWindowTitle(handle, title)
    }

    // 设置窗口大小
    // ★ 虚拟子窗口：改的是**逻辑尺寸**（纹理 + 根布局），不是父窗口 ✓
    func setSize(int w, int h): bool {
        if virt {
            virtLW = w; virtLH = h
            _w = w; _h = h
            _virtResizeTex()
            var rt = root
            if rt != null { rt.set_size(_float(w) - rootX, _float(h) - rootY) }
            return true
        }
        // ★ 2026-11-21：应用传的是逻辑像素 ⇒ Android 上乘回物理像素（桌面 _dens=1.0 原样 ✓）
        int pw = w; int ph = h
        if _dens > 1.0 { pw = maths.roundi(_float(w) * _dens); ph = maths.roundi(_float(h) * _dens) }
        return _lib.SDL_SetWindowSize(handle, pw, ph)
    }

    // 获取窗口真实像素尺寸（HiDPI 时大于逻辑尺寸）
    func getSizeInPixels(): Size {
        if virt { Size dv = {w: virtLW, h: virtLH}; return dv }
        SDL_Point pt = SDL_Point.malloc()
        _lib.SDL_GetWindowSizeInPixels(handle, &pt.x, &pt.y)
        Size d = {w: pt.x, h: pt.y}
        pt.free(); return d
    }

    // 获取窗口逻辑尺寸（绘图坐标系使用的尺寸，不受 HiDPI 放大影响）
    // ★ 虚拟子窗口：返回**自己的**逻辑尺寸（不是父窗口的 ✓ 否则布局会被撑成父窗口大小）
    // ★ 2026-11-21：Android 上 SDL_GetWindowSize 给的是**物理像素**（2.75x 屏 ⇒ 720x1280 的窗口
    //   会报 720x1280，而逻辑只有 262x465）⇒ 这里除以 _dens。桌面 _dens=1.0 ⇒ 原样返回（零回归 ✓）
    func getSize(): Size {
        if virt { Size dv2 = {w: virtLW, h: virtLH}; return dv2 }
        SDL_Point pt = SDL_Point.malloc()
        _lib.SDL_GetWindowSize(handle, &pt.x, &pt.y)
        Size d = {w: pt.x, h: pt.y}
        if _dens > 1.0 {
            d.w = maths.roundi(_float(pt.x) / _dens)
            d.h = maths.roundi(_float(pt.y) / _dens)
            if d.w < 1 { d.w = 1 }
            if d.h < 1 { d.h = 1 }
        }
        pt.free(); return d
    }

    // ★ 2026-11-21：窗口所在显示器的**内容缩放**（逻辑像素 = 物理像素 / 该值）
    //   Android 恒 > 0（约 2.75~3.5）；桌面按系统缩放给（100% ⇒ 1.0）。
    //   虚拟子窗口借父窗口句柄 ⇒ 返回父窗口所在显示器的缩放（合成时也按它换算 ✓）
    func getContentScale(): float {
        return core.getWindowDisplayScale(handle)
    }

    // 设置窗口位置
    func setPosition(int x, int y): bool {
        return _lib.SDL_SetWindowPosition(handle, x, y)
    }

    // 设置窗口是否可调整大小
    func setResizable(bool v) {
        if ok { _lib.SDL_SetWindowResizable(handle, v) }
    }

    // 设置窗口是否有系统标题栏边框（false = 无边框，自绘标题栏用）
    func setBordered(bool v) {
        if ok { _lib.SDL_SetWindowBordered(handle, v) }
    }

    // ==================== 运行时主题切换 ====================
    // 遍历所有控件（含根布局和 MenuBar），对实现 Themeable 的调用 applyTheme
    // 无需关闭/重建窗口，立即生效
    func applyThemeAll(Theme t) {
        // 0. ★ 2026-10-13：注册**主题递归出口** —— 深容器（ScrollView / Card / TabControl）在自己的
        //    `applyTheme` 里把内容控件交回来，由本函数继续下钻 ✓（类型表只在本文件一处 ✓，
        //    与 `lay.setExtraPassResize` 同款；`Card._content` 是 `pri` ✗ ⇒ 只能这么交 ✓）
        lay.setExtraApplyThemeChild((Widget c, Theme ct) => applyThemeWidget(c, ct))
        // 1. 更新全局主题单例
        theme.setTheme(t)
        // 2. 遍历 _widgets（覆盖层：MenuBar/TitleBar 等）
        for widgets.len() to i {
            applyThemeWidget(widgets[i], t)
        }
        // 3. 遍历根布局控件（背景层：VBox/HBox 内的 Panel/Table/TreeView 等）
        if root != null { applyThemeWidget(root, t) }
        // 4. 请求重绘
        core.requestRedraw()
    }

    // 对单个控件及其子控件应用主题（递归容器）
    pri func applyThemeWidget(Widget w, Theme t) {
        switch w {
            // ★ 2026-10-10：合并 case 恢复（编译器侧已治本 ✓ 见 sdl_layout._passWindowHandle 与 docs §九 ✓）
            // ★ 2026-10-13：**名称补全** —— 全库有 44 处 `impl Widget`，而这里原来只点了 8 个 ✗
            //   ⇒ 下面这批控件的 `applyTheme` **早就写好了却从没被调用过**（切主题后仍是旧色 ✓）：
            //     Canvas / ListBox / Slider / SpinBox / 三种图表 / Card / ScrollView / TabControl
            //   ⚠ 以后新增控件实现了 Themeable，**必须**加进这张表（本表是全库唯一的"主题点名处" ✓）
            //   ★ 2026-10-13（第二批）：把"表单/展示"这一族也补齐 —— 它们原来**连 `applyTheme` 都没有** ✗
            //     （CheckBox/RadioButton/Toggle/ProgressBar/Spinner/Separator/RingProgress/ImageView/LinkButton ✓）
            //   ⚠ 不需要进表的：`PopMenu`/`Tooltip`/`Dialog`（每帧现读 `getTheme()` ⇒ 本来就跟随 ✓）、
            //     `Scrim`（纯黑 alpha 遮罩 ⇒ 无颜色可切 ✓）；`Calendar`/`Steps` 设计上不依赖主题（配色全靠 opts ✓）
            case is Button, Label, Edit, Table, TreeView, ComboBox, MenuBar, TitleBar, Canvas, ListBox, Slider, SpinBox, BarChart, LineChart, PieChart, Card, ScrollView, TabControl, CheckBox, RadioButton, Toggle, ProgressBar, Spinner, Separator, RingProgress, ImageView, LinkButton { w.applyTheme(t) }
            case is Splitter {
                w.applyTheme(t)
                // 递归两侧子控件（_first / _second 为 Widget?）
                var f = w._first
                if f is Widget { applyThemeWidget(f, t) }
                var s = w._second
                if s is Widget { applyThemeWidget(s, t) }
            }
            case is Panel {
                w.applyTheme(t)
                // ★ 递归 _layoutChild（setLayoutPadded 设置的布局子控件，如 VBox）
                var lc = w._layoutChild
                if lc is Widget { applyThemeWidget(lc, t) }
                // 递归 children（通过 add() 添加的子控件）
                for w.children.len() to ci { applyThemeWidget(w.children[ci], t) }
            }
            case is GroupBox {
                w.applyTheme(t)
                // ★ 递归 _layoutChild（setLayoutPadded 设置的布局子控件，如 VBox）
                var glc = w._layoutChild
                if glc is Widget { applyThemeWidget(glc, t) }
                // 递归 children（通过 add() 添加的子控件）
                for w.children.len() to ci { applyThemeWidget(w.children[ci], t) }
            }
            case is HBox {
                for w._c.len() to ci { applyThemeWidget(w._c[ci], t) }
            }
            case is VBox {
                for w._c.len() to ci { applyThemeWidget(w._c[ci], t) }
            }
            case is GridLayout {
                for w._c.len() to ci { applyThemeWidget(w._c[ci], t) }
            }
            // ★ 2026-10-13：AnchorBox 与 HBox/VBox 同族（同样持 `_c` ✓），原表漏了它 ✗
            case is AnchorBox {
                for w._c.len() to ci { applyThemeWidget(w._c[ci], t) }
            }
        }
    }

    // 设置最大渲染帧率（默认 30 FPS；0 = 不限制）
    func setMaxFPS(int fps) { maxFPS = fps }

    // 设置窗口置顶
    func setAlwaysOnTop(bool v): bool {
        return _lib.SDL_SetWindowAlwaysOnTop(handle, v)
    }

    // 设置窗口透明度（0.0 全透明 ~ 1.0 不透明）
    func setOpacity(float v): bool {
        return _lib.SDL_SetWindowOpacity(handle, v)
    }

    // ★ 2026-11-16：窗口当前位置 x, y（**虚拟桌面**坐标 ⇒ 多屏时副屏可能是负值 ✓）
    //   为什么要补：悬浮窗（桌面歌词）要按"主窗口在哪块屏"决定自己的落点，
    //   之前框架只包了 setPosition、没包读回位置 ⇒ 应用只能猜（写死坐标 ⇒ 换屏就跑到屏幕外 ✗）
    //   ⚠ 保留"先解构再 return"：直接 `return core.getWindowPos(handle)` 在老版 leno.exe 上
    //     会报假的「期望 [int,int]，实际 [int,int]」（2026-11-16 已在语言侧修好）✓
    func getPosition(): [int, int] {
        var[int, int](px, py) = core.getWindowPos(handle)
        return px, py
    }

    // ★ 2026-10-21：整窗**鼠标穿透**（桌面宠物 / 悬浮挂件用）
    //   true ⇒ 点击、悬停、滚轮全部穿到下层窗口，窗口本身照常渲染
    //   返回 false = 本平台还没实现（当前只有 Windows）/ 拿不到原生句柄（如 dummy 视频驱动）
    //   ⚠ 与 `setOpacity(0)` 不是一回事：那是**看不见**，这是**看得见但不挡鼠标**
    func setClickThrough(bool v): bool { return ct.setClickThrough(handle, v) }
    func isClickThrough(): bool { return ct.isClickThrough(handle) }

    // 鼠标锁定 & 相对模式（FPS 游戏用）
    func setMouseGrab(bool v): bool              { return _lib.SDL_SetWindowMouseGrab(handle, v) }
    func getMouseGrab(): bool                    { return _lib.SDL_GetWindowMouseGrab(handle) }
    func setRelativeMouse(bool v): bool          { return _lib.SDL_SetWindowRelativeMouseMode(handle, v) }
    func getRelativeMouse(): bool                { return _lib.SDL_GetWindowRelativeMouseMode(handle) }

    // 限制窗口最小尺寸
    func setMinSize(int w, int h): bool          { return _lib.SDL_SetWindowMinimumSize(handle, w, h) }

    // 窗口闪烁（FLASH_BRIEFLY=短暂, FLASH_UNTIL_FOCUSED=直到获得焦点, FLASH_CANCEL=取消）
    func flash(int op): bool                     { return _lib.SDL_FlashWindow(handle, op) }

    // 设置窗口图标（surface 来自 SDL3.loadImage 等）
    func setIcon(Ptr[u8] icon): bool { return _lib.SDL_SetWindowIcon(handle, icon) }

    // 全屏切换
    func setFullscreen(bool v): bool { return _lib.SDL_SetWindowFullscreen(handle, v) }

    // 前置窗口并获取焦点
    func raise(): bool       { if virt { return true } return _lib.SDL_RaiseWindow(handle) }

    // 窗口状态控制
    // ★ 虚拟子窗口：这些操作**不能透到父窗口**（否则 `dlg.hide()` 会把主窗口藏掉 ✗）
    func show(): bool        { if virt { return true } return _lib.SDL_ShowWindow(handle) }
    func hide(): bool        { if virt { return true } return _lib.SDL_HideWindow(handle) }
    func maximize(): bool    { if virt { return true } return _lib.SDL_MaximizeWindow(handle) }
    func minimize(): bool    { if virt { return true } return _lib.SDL_MinimizeWindow(handle) }
    func restore(): bool     { if virt { return true } return _lib.SDL_RestoreWindow(handle) }

    // 销毁窗口（同时释放所有控件资源：字体等，避免窗口关闭后字体泄漏）
    func destroy() {
        // ★ 2026-11-21：虚拟子窗口没有 OS 窗口，只销毁自己那块离屏纹理
        if virt {
            if ok {
                timer.unregisterByWindow(getID())
                core.requestRedraw()
                for widgets to w { w.dispose() }
                root?.dispose()
                _virtDropTex()
                ok = false
            }
            return
        }
        if ok {
            // ★ 2026-11-08：先注销本窗口的定时器（必须在 DestroyWindow 之前取 ID）
            timer.unregisterByWindow(getID())
            // ★ 2026-11-17：窗口消失是"全局事件" —— 别的窗口可能画着蒙版 / 弹层 / 引用它的东西
            //   ⇒ 必须请求**全脏**（重绘归属按窗口之后，这里不显式置全局就会留下残影 ✗）
            core.requestRedraw()
            // 根销毁：先释放所有控件资源，沿父子树递归清理
            for widgets to w { w.dispose() }
            root?.dispose()
            _lib.SDL_DestroyWindow(handle); handle = null; ok = false; _windowCount = _windowCount - 1
        }
    }

    // 手动创建渲染器（供轮询模式使用）
    func createRenderer(): Renderer {
        return renderer.createRenderer(handle)
    }

    // 添加定时器（毫秒），用法: Timer t = win.addTimer(200, func() { ... })
    func addTimer(int ms, func():void cb): Timer {
        Timer t = new Timer(); t.set(ms, cb)
        t.ownerWid = getID()                 // ★ 归属本窗口，窗口销毁时自动注销 ✓
        timer.registerTimer(t); return t
    }

    // 添加一次性定时器
    func addTimerOnce(int ms, func():void cb): Timer {
        Timer t = new Timer(); t.setOnce(ms, cb)
        t.ownerWid = getID()
        timer.registerTimer(t); return t
    }

    // 添加按钮，opts: {text, x, y, w, h, r, g, b}
    // 返回 Button，可 .on_click(func() { ... })
    func addButton(Dict opts): Button {
        Button b = btn.createButton(opts)
        widgets.add(b as Widget)
        widgetZ.add(opts.get("z", 0.0))
        return b
    }

    // 添加标签，opts: {text, x, y, font_size, rgb, align}
    func addLabel(Dict opts): Label {
        Label l = lbl.createLabel(opts)
        widgets.add(l as Widget)
        widgetZ.add(opts.get("z", 0.0))
        return l
    }

    // 添加文本编辑框，opts: {text, x, y, w, h, placeholder, password, readonly}
    func addEdit(Dict opts): Edit {
        Edit ed = edt.createEdit(opts)
        ed.set_window(handle)
        ed.set_window_size(_w, _h)
        if ed.is_context_menu_enabled() { menu.registerContextMenu(ed.get_context_menu()) }   // 上下文菜单登记，由窗口第二遍按窗口隔离绘制
        widgets.add(ed as Widget)
        widgetZ.add(opts.get("z", 0.0))
        return ed
    }

    // 通用控件注册：任何 impl Widget 的控件（含第三方自定义控件）都能被 run() 自动管理
    // z 值默认 0.0；如需自定义层级用 addZ(w, z) 或 setWidgetZ(w, z)
    // ⚠ 控件级「模态浮层」/「点外部回调」的状态**不放在 Window 上**（放这里会让多窗口互相串：
    //   主窗口的矩形被拿去量对话框窗口的坐标 ⇒ 点按钮变成"点了外面"✗）
    //   ⇒ 现为模块级 + 按窗口 ID 归属，见文件顶部 `_moWid` / `_outWid` 那段的 2026-11-13 注释 ✓

    func add(Widget w): Widget {
        widgets.add(w)
        widgetZ.add(0.0)
        // 绑定窗口句柄：容器向下传递，Edit/Table/TreeView/TitleBar 直接设置
        // ★ 2026-10-10：合并 case 恢复（编译器侧已治本 ✓ 见 sdl_layout._passWindowHandle 与 docs §九 ✓）
        switch w {
            case is Panel, ScrollView, HBox, VBox, AnchorBox, TabControl, SpinBox, GroupBox, Splitter { w._bind_window(handle); return w }
            case is Edit {
                w.set_window(handle); return w
            }
            case is TreeView {
                w.set_window_handle(handle)
                w.set_window(_w, _h); return w
            }
            case is Table {
                w.set_window_handle(handle)
                w.set_window_size(_w, _h); return w
            }
            case is TitleBar, Canvas {
                w.set_window_handle(handle); return w
            }
        }
        return w
    }

    // 带层级的控件注册：z 值大的控件画在 z 值小的控件之上
    // 模态浮层：设了它以后，落在该矩形内的鼠标事件**只**派发给它（弹层防穿透 ✓）
    //   矩形要显式给：接口类型（Widget）上不能调 get_x/get_y（框架只支持 `?.process` 这种动态派发 ✓）
    func set_modal(Widget w, float x, float y, float ww, float hh) {
        // 记下**自己**的 wid：矩形是本窗口客户区坐标，派发时必须按窗口配对 ✓
        _moWid = getID()
        _moWidget = w; _moX = x; _moY = y; _moW = ww; _moH = hh
    }
    // 只清自己的（另一个窗口的浮层状态不能被误清 ✓）
    func clear_modal() {
        if _moWid == getID() { _moWid = -1; _moWidget = null; _moW = 0.0; _moH = 0.0 }
    }

    // 点外部回调（2026-10-29 反哺）：设了它以后，**左键按下且落在矩形外** ⇒ 调一次 cb，
    //   并且**这一下不再派发给任何控件**（否则"点列表按钮收起浮层"会变成收起后按钮又把它打开 ✗）。
    //   典型用途：浮层/下拉面板"点外面自动收起"。
    //   矩形与 set_modal 同理，必须显式传（接口上调不了 get_x/get_y ✓）。
    //   ⚠ 只在**左键按下**那一刻判一次；`cb` 里只该做"收起/关闭"，别做 toggle（会把自己关回去）
    func set_click_outside(float x, float y, float ww, float hh, func():void cb) {
        _outWid = getID()
        _outX = x; _outY = y; _outW = ww; _outH = hh
        _outCb = cb
        _outArmed = true
    }
    func clear_click_outside() {
        if _outWid == getID() { _outWid = -1; _outCb = null; _outArmed = false; _outW = 0.0; _outH = 0.0 }
    }

    func addZ(Widget w, float z): Widget {
        widgets.add(w)
        widgetZ.add(z)
        // ★ 2026-10-10：合并 case 恢复（编译器侧已治本 ✓ 见 sdl_layout._passWindowHandle 与 docs §九 ✓）
        switch w {
            case is Panel, ScrollView, HBox, VBox, AnchorBox, TabControl, SpinBox, GroupBox, Splitter { w._bind_window(handle); return w }
            case is Edit {
                w.set_window(handle); return w
            }
            case is TreeView {
                w.set_window_handle(handle)
                w.set_window(_w, _h); return w
            }
            case is Table {
                w.set_window_handle(handle)
                w.set_window_size(_w, _h); return w
            }
            case is TitleBar, Canvas {
                w.set_window_handle(handle); return w
            }
        }
        return w
    }

    // 设置已有控件的 z 值（用于运行时动态调整层级）
    func setWidgetZ(Widget w, float z) {
        for widgets.len() to i {
            if widgets[i] == w { widgetZ[i] = z; return }
        }
    }

    // 找个控件在 `widgets` 里的下标（不是本窗口注册的 ⇒ -1 ✓）
    pri func _indexOfWidget(Widget w): int {
        for widgets.len() to i {
            if widgets[i] == w { return i }
        }
        return -1
    }

    // ==================== 控件级不透明度（`opacity`）====================
    //   用法：`Button b = win.addButton({...}); win.set_widget_opacity(b, 0.5)` ✓
    //   ★ 实现只有**一处**：渲染该控件前后 `setAlphaScale(op)` / `setAlphaScale(1.0)`（见下面渲染循环 ✓）
    //     ⇒ 控件侧**零改动** ✓；容器被设透明度时**整个子树一起淡出** ✓（子控件都在它的 render 里画 ✓）
    //   ⚠ 只作用于 `win.add*` / `win.addZ` 注册到窗口的控件 ✓（排进布局的孙控件靠"淡出父容器"整体处理 ✓）
    //   ⚠ v1 不覆盖渲染器里那几条**直绘纹理**路径（圆角图/直贴图）—— 见 sdl_renderer 的已知边界 ✓
    func set_widget_opacity(Widget w, float a) {
        int idx = _indexOfWidget(w)
        if idx < 0 { return }                        // 不是本窗口的控件：静默忽略（不崩 ✓）
        a = maths.saturate(a)                                    // 夹到 0..1（2026-11-01）
        while widgetOpac.len() <= idx { widgetOpac.add(1.0) }   // 稀疏补齐 ✓
        widgetOpac[idx] = a
        core.requestRedraw()
    }

    // 读取某下标控件的不透明度（越界 = 1.0 ⇒ 绝大多数控件走的就是这条"零开销"路径 ✓）
    pri func _opacAt(int i): float {
        if i >= 0 and i < widgetOpac.len() { return widgetOpac[i] }
        return 1.0
    }

    // ==================== 焦点链（键盘导航）====================
    //   ★ 2026-10-13 加：全库原来只有 `Edit` / `Canvas` 自己管焦点 ⇒ **Tab 键不会换焦点** ✗
    //   本版口径（都是可改的默认 ✓，别当死规矩 ✓）：
    //     · 焦点链顺序 = **注册顺序**（`widgets` 的加入先后）⇒ 稳定可预期 ✓；暂不做 `tabIndex` ✓
    //     · 窗口只接管 **Tab / Shift+Tab 换焦点** + **Enter / Space 激活** ✓
    //       方向键**留给控件自己**（ListBox/Table/TreeView/ComboBox 的内部导航不归窗口管 ✓）
    //     · "谁能聚焦"用一张**类型表**（全库唯一一处 ✓，与主题点名表同款口径 ✓）
    //     · ring 由控件**自绘**（`draw_focus_ring` ✓），窗口只在渲染后统一叫一下 ✓
    pri int focusIdx = -1                      // 当前焦点在"可聚焦列表"里的序号（-1 = 无焦点 ✓）

    // 懒收集当前所有可聚焦控件（按注册顺序 ✓）—— 不维护注册表 ⇒ 不会与 widgets 失同步 ✓
    //   ★ 2026-10-13（第八批）：**递归进容器** —— 原来**只扫 `widgets`** ✗
    //     ⇒ 装在 `HBox/VBox/AnchorBox/GridLayout/Panel/GroupBox/Splitter/ScrollView/Card/页签页`
    //       里的控件 **Tab 永远到不了** ✗
    //       （实测复现：面板里放一个按钮 ⇒ 链尾本该是它，结果 Tab **直接回卷到 A** ✓）
    //     ⇒ 顺带把**根布局 `root`** 也纳入（原来连它都不扫 ✗ —— 走 `setRoot` 的应用里
    //       所有控件都不在链条里 ✓）
    //   ⚠ 去重：同一个控件可能既在 `widgets`、又在某容器子树里 ⇒ 不去重会"两次 Tab 停靠"✗
    pri func _focusables(): Array[Widget] {
        Array[Widget] r = []
        for widgets.len() to i { _collectFocus(widgets[i], r) }
        if root != null { _collectFocus(root, r) }
        return r
    }

    // 收一棵子树里的可聚焦控件：自己可聚焦就收，然后**继续下钻容器的子控件** ✓
    pri func _collectFocus(Widget w, Array[Widget] out) {
        if _inList(out, w) { return }        // 已收过 ⇒ 跳过（防重复停靠 ✓）
        switch w {
            // ★ 2026-10-13 第二批：开关类也进链条（各自 `activate()` = 切一下 ✓）
            // ★ 2026-11-04：**Edit 进链** —— 之前漏了它 ⇒ 表单里按 Tab 只在按钮间跳、
            //   输入框纹丝不动（"输完用户名按 Tab 不跳密码框"就是这条 ✗）。
            //   ⚠ **必须单独写一条 case**：多类型 case 的窄化只按第一个类型（本文件
            //     991-1003 那条规矩）⇒ 写成 `case is Button, …, Edit` 时，对 Edit 实例
            //     调 `w.is_focusable()` 会按 **Button 的字段下标**去读 ⇒ 读到的不是 Edit 的
            //     focusable（实测：加了 Edit 到合并 case 后链里依旧是 0 个输入框 ✗）
            case is Edit { if w.is_focusable() { out.add(w) } }
            case is Button, CheckBox, RadioButton, Toggle, Slider, ListBox, ComboBox, TabControl, Table, TreeView { if w.is_focusable() { out.add(w) } }
        }
        _collectChildren(w, out)
    }

    pri func _inList(Array[Widget] out, Widget w): bool {
        for out.len() to i { if out[i] == w { return true } }
        return false
    }

    // 容器的**直接子控件**是谁 —— 口径与 `applyThemeWidget` 同一张表 ✓
    //   （`Card._content` 是 `pri` ✗ ⇒ 走它公开的 `content_widget()` ✓；
    //     `ScrollView._content` / `TabControl._pageLayouts` / `Splitter._first·_second` 本来就是公开字段 ✓）
    //   ⚠ 以后新增容器类型：**这两处都要加**（本表 + `applyThemeWidget` ✓）
    //
    // ★★ 2026-10-16 修（LenoMusic 崩溃）：**多类型 case 里不要访问字段** ★★
    //   `case is HBox, VBox, AnchorBox, GridLayout { … w._c … }` 看着很整齐，但多类型 case 的
    //   窄化**只按第一个类型**（Leno 里就是这样，实测最小复现 20 行见下）⇒ `w._c` 用的是
    //   **第一个类型（HBox）的字段下标**，而 `_c` 在各容器里的下标**根本不同**：
    //       HBox/VBox: 12   ·   AnchorBox: 6   ·   GridLayout: 11
    //   ⇒ 遇到 AnchorBox 直接「**字段索引越界**」崩溃；遇到 GridLayout **不越界但读的是
    //     HBox 下标 11 的那个字段**（静默取错 ⇒ 比崩溃更难查 ✗）。Panel/GroupBox 同款：
    //       `children` 4 vs 12 · `_layoutChild` 5 vs 13
    //   复现（`build/_switch_multi.leno`，已删）：A 的 `f` 在 index 2、B 的 `f` 在 index 0
    //     ⇒ `case is A, B { x.f }` 对 B 取值时越界 ⇒ 这条规则**不是猜的** ✓
    //   ⇒ 规矩：**要访问字段就一个类型写一条** ✓
    //     （合并写法仍然是安全的、也是推荐的 —— 但只**调方法**时：方法走 face 动态派发，
    //      与字段下标无关 ⇒ 本文件其它 `case is A, B, …` 都是这种 ✓）
    pri func _collectChildren(Widget w, Array[Widget] out) {
        switch w {
            // ①②③④ 四个布局容器：孩子都在 `_c`，但**下标各不相同** ⇒ 必须分开写 ✓
            case is HBox {
                for w._c.len() to i { _collectFocus(w._c[i], out) }
            }
            case is VBox {
                for w._c.len() to i { _collectFocus(w._c[i], out) }
            }
            case is AnchorBox {
                for w._c.len() to i { _collectFocus(w._c[i], out) }
            }
            case is GridLayout {
                for w._c.len() to i { _collectFocus(w._c[i], out) }
            }
            // ⑤⑥ `children` 4 vs 12、`_layoutChild` 5 vs 13 ⇒ 同理分开写 ✓
            case is Panel {
                var lc = w._layoutChild
                if lc is Widget { _collectFocus(lc, out) }
                for w.children.len() to i { _collectFocus(w.children[i], out) }
            }
            case is GroupBox {
                var lc = w._layoutChild
                if lc is Widget { _collectFocus(lc, out) }
                for w.children.len() to i { _collectFocus(w.children[i], out) }
            }
            case is Splitter {
                var f = w._first
                if f is Widget { _collectFocus(f, out) }
                var s2 = w._second
                if s2 is Widget { _collectFocus(s2, out) }
            }
            case is ScrollView {
                var c = w._content
                if c is Widget { _collectFocus(c, out) }
            }
            case is Card {
                var cw = w.content_widget()
                if cw is Widget { _collectFocus(cw, out) }
            }
            case is TabControl {
                for w._pageLayouts.len() to i { _collectFocus(w._pageLayouts[i], out) }
            }
        }
    }

    // 把焦点状态**一次性**刷到列表上（只让 `focusIdx` 那个亮 ⇒ 不会"两个都以为有焦点" ✗）
    pri func _applyFocus(Array[Widget] fs) {
        for fs.len() to i {
            var w = fs[i]
            switch w {
                case is Edit { if i == focusIdx { w.focus() } else { w.blur() } }
                case is Button, CheckBox, RadioButton, Toggle, Slider, ListBox, ComboBox, TabControl, Table, TreeView { if i == focusIdx { w.focus() } else { w.blur() } }
            }
        }
    }

    func focus_next() { _moveFocus(1) }
    func focus_prev() { _moveFocus(-1) }
    func clear_focus() {
        Array[Widget] fs = _focusables()
        focusIdx = -1
        _applyFocus(fs)
        core.requestRedraw()
    }
    // 指定焦点（`w` 不在焦点链里 ⇒ 静默忽略 ✓）
    func focus_widget(Widget w) {
        Array[Widget] fs = _focusables()
        for fs.len() to i {
            if fs[i] == w { focusIdx = i; _applyFocus(fs); core.requestRedraw(); return }
        }
    }
    // 激活当前焦点控件（Enter / Space ⇒ 与鼠标点击同一条回调 ✓）
    pri func _activateFocused() {
        Array[Widget] fs = _focusables()
        if focusIdx < 0 or focusIdx >= fs.len() { return }
        var w = fs[focusIdx]
        switch w {
            // ⚠ `Table` **刻意不在激活表里** ✓ —— 它自己那套键盘导航（已有）管 Enter ✓
            //   放进来就会"窗口 + 控件"各处理一次 ⇒ 与 ListBox/ComboBox 踩过的双触发同源 ✗
            // ★ 2026-11-04：Edit 也在这里 —— 输入框上的 Enter 走 `activate()`（= onEnter 回调），
            //   否则窗口层把 RETURN 消费掉后什么都不做 ⇒ "密码输完按回车不登录" ✗
            //   （同样单独一条 case，理由同上一条注释 ✓）
            case is Edit { w.activate() }
            case is Button, CheckBox, RadioButton, Toggle, Slider, ListBox, ComboBox, TabControl, TreeView { w.activate() }
        }
    }
    pri func _moveFocus(int dir) {
        Array[Widget] fs = _focusables()
        if fs.len() == 0 { return }
        int n = focusIdx
        if dir > 0 {
            n = n + 1
            if n >= fs.len() { n = 0 }                    // 末尾回卷到首个 ✓
        } else {
            if n < 0 { n = fs.len() - 1 }
            else {
                n = n - 1
                if n < 0 { n = fs.len() - 1 }
            }
        }
        focusIdx = n
        _applyFocus(fs)
        core.requestRedraw()
    }
    // 键盘：Tab / Shift+Tab 换焦点、Enter / Space 激活（返回 true = 已消费 ✓）
    pri func _focusKey(Event ev): bool {
        if not ev.isKeyDown() { return false }
        int sc = ev.scancode()
        if sc == core.Scancode.TAB {
            // ★ 2026-11-04：**焦点不是链给的就不消费**。应用里最常见的路径是"鼠标点进输入框
            //   直接打字、再按 Tab 换下一个框"—— 此时 focusIdx 还是 -1（点选不同步聚焦序号），
            //   原先窗口层照样把 TAB 吃掉 ⇒ 输入框换不动、应用也收不到（登录窗实测 ✗）。
            //   放行后事件继续派发 ⇒ 应用可在自己的 onEvent 里按输入框顺序换焦点 ✓
            if focusIdx < 0 { return false }
            if (ev.keyMod() & 3) != 0 { _moveFocus(-1) } else { _moveFocus(1) }   // 0x0003 = Shift ✓
            return true
        }
        // ★ 2026-11-10：KP_ENTER（小键盘回车）与 RETURN 同义，否则焦点链激活会漏掉它 ✗
        if sc == core.Scancode.RETURN or sc == core.Scancode.SPACE or sc == core.Scancode.KP_ENTER {
            // ★ 2026-11-04：**焦点没落在链里时不消费** —— 应用里很常见的路径是"鼠标点进输入框，
            //   直接敲回车提交"，此时 focusIdx 还是 -1（点选没有同步聚焦序号）⇒ 原先
            //   窗口层把 RETURN 吃掉、又没人可激活 ⇒ 回车**毫无反应**（登录窗实测 ✗）。
            //   放行后事件继续派发到控件，Edit 自己的 onEnter 就生效了 ✓
            Array[Widget] fs = _focusables()
            if focusIdx < 0 or focusIdx >= fs.len() { return false }
            _activateFocused()
            return true
        }
        return false
    }

    // 设置根布局控件：窗口缩放时自动把根控件尺寸设为窗口大小并驱动内部布局重排
    // ★ 同时下发窗口句柄（等价于 win.add 的 _bind_window），确保根控件内部的 Edit/TreeView/ComboBox 等能正常工作
    func setRoot(Widget root) {
        // ⚠ 形参与字段同名 ⇒ 裸 `root = root` 只会写形参（字段永远为 null ⇒ 根布局不被渲染 ✗）
        self.root = root
        rootX = 0.0; rootY = 0.0
        root.set_pos(0, 0)
        root.set_size(_w, _h)
        _passWindowHandle(root)
        _syncRunRoot()
    }

    // 设置根布局控件（带偏移）：窗口缩放时自动把根控件位置/尺寸设为 (x,y,winW-x,winH-y)
    // 典型场景：顶部 MenuBar 占 h=30，根布局从 (0,30) 开始填满剩余空间
    // ★ 2026-10-13：**run() 之后再调用它也能生效**（整页切换 = 换根 ✓ 见 _syncRunRoot ✓）
    func setRootAt(Widget root, float ox, float oy) {
        self.root = root      // 同上：必须显式 self.（形参遮蔽字段 ✓）
        rootX = ox; rootY = oy
        root.set_pos(ox, oy)
        root.set_size(_float(_w) - ox, _float(_h) - oy)
        _passWindowHandle(root)
        _syncRunRoot()
    }

    // ★ 2026-10-13：把"当前根"同步进主循环的快照 `_runRoots[i]`。
    //   为什么必须同步：`registerOnly()`（run 里调）会把本窗口的根**拷进** `_runRoots[i]`，
    //   而主循环的**绘制与事件派发**都只看那份快照（见 run 里的 render/process 段）⇒
    //   以前在 run 之后换根是**静默 no-op** ✗：`self.root` 换了、界面照旧、
    //   日志里却显示"换页成功"（实测：详情页开了但屏幕还是列表页 ✓ 就是这条）。
    //   用途：整页切换（列表 ⇄ 详情）= 换根 —— 比"隐藏/显示"干净（隐藏的页照样占位 ✗）。
    //   未注册（run 之前）时找不到对应 wid ⇒ 什么都不做（此时快照本就取自 self.root ✓）。
    pri func _syncRunRoot() {
        int wid = getID()
        for _runWids.len() to i {
            if _runWids[i] == wid {
                _runRoots[i] = root
                _runRootX[i] = rootX
                _runRootY[i] = rootY
                return
            }
        }
    }

    // 向控件下发窗口句柄（**带窗口逻辑宽高** ✓ —— 有一批控件还要尺寸）
    //   ★ 2026-10-13：类型判断收敛到 `sdl_layout.passWindowHandleSized` ✓
    //     （原来这里自己一份 switch、还和 `_refreshWindowHandle` 漂移了 ✗ —— 前者有 Card、后者有 ListBox ✓）
    func _passWindowHandle(Widget w) {
        lay.passWindowHandleSized(w, handle, _w, _h)
    }

    // 添加复选框，opts: {text, x, y, box, checked, on_change}
    // 返回 CheckBox，可 .on_change(func(bool){...}) / .set_checked(bool) / .is_checked()
    func addCheckBox(Dict opts): CheckBox {
        CheckBox c = chk.createCheckBox(opts)
        widgets.add(c as Widget)
        widgetZ.add(opts.get("z", 0.0))
        return c
    }

    // 添加单选按钮，opts: {text, x, y, group, checked, on_change}
    // 同一 group 内互斥（由控件内部注册表实现）
    func addRadioButton(Dict opts): RadioButton {
        RadioButton r = rb.createRadioButton(opts)
        r.setWindowHandle(handle)   // 让同组互斥按窗口隔离（避免跨窗口同组互相取消）
        widgets.add(r as Widget)
        widgetZ.add(opts.get("z", 0.0))
        return r
    }

    // 添加开关，opts: {text, x, y, w, h, on, on_change}
    func addToggle(Dict opts): Toggle {
        Toggle t = tgl.createToggle(opts)
        widgets.add(t as Widget)
        widgetZ.add(opts.get("z", 0.0))
        return t
    }

    // 添加滑块，opts: {x, y, w, h, min, max, value, step, vertical, on_change}
    // 返回 Slider，可 .set_value(float) / .get_value() / .on_change(func(float){...})
    func addSlider(Dict opts): Slider {
        Slider s = sld.createSlider(opts)
        widgets.add(s as Widget)
        widgetZ.add(opts.get("z", 0.0))
        return s
    }

    // 添加进度条，opts: {x, y, w, h, min, max, value, clickable, show_text, on_change}
    func addProgressBar(Dict opts): ProgressBar {
        ProgressBar p = prg.createProgressBar(opts)
        widgets.add(p as Widget)
        widgetZ.add(opts.get("z", 0.0))
        return p
    }

    // 添加列表框，opts: {x, y, w, h, items, item_h, mode, selected, on_change}
    // mode: 0=单选, 1=多选；on_change 回调收到选中的索引数组 Array[int]
    func addListBox(Dict opts): ListBox {
        ListBox lb2 = lb.createListBox(opts)
        widgets.add(lb2 as Widget)
        widgetZ.add(opts.get("z", 0.0))
        return lb2
    }

    // 添加下拉框，opts: {x, y, w, h, items, item_h, popup_h, placeholder, selected, on_change}
    // on_change 回调收到选中索引 int
    func addComboBox(Dict opts): ComboBox {
        ComboBox cb = cbb.createComboBox(opts)
        cb.setWindowHandle(handle)   // 让下拉层按窗口隔离绘制（工厂已登记到 registerComboBox）
        widgets.add(cb as Widget)
        widgetZ.add(opts.get("z", 0.0))
        return cb
    }

    // 添加菜单栏，opts: {x, y, w, h, menus:[{title, items:[...]}], item_h, font_size, ...}
    // 下拉层自动盖在最上层（renderPopup 第二遍绘制 + 弹层捕获区）
    func addMenuBar(Dict opts): MenuBar {
        MenuBar m = menu.createMenuBar(opts)
        m.setWindowHandle(handle)   // 让活动菜单按窗口隔离（避免跨窗口互相抢互斥）
        widgets.add(m as Widget)
        widgetZ.add(opts.get("z", 0.0))
        menus.add(m)
        m.setWindowSize(_w, _h)   // 供上下文菜单弹出时按窗口边界夹紧
        return m
    }

    // 注册窗口级右击上下文菜单（只需调用一次）。之后 run 会在每帧事件处理中统一接管右击：
    // 若命中控件自行弹出了自身菜单（占用弹层），则不弹窗口菜单；否则才弹本菜单。
    // 这样「控件菜单优先、窗口菜单兜底」由底层统一保证，示例无需在 onEvent 里处理右键。
    func setContextMenu(MenuBar bar, int ctxIdx) { bar.setWindowHandle(handle); ctxBar = bar; self.ctxIdx = ctxIdx }

    // 添加面板容器，opts: {x, y, w, h, bg, border, radius, border_alpha, clip}
    // 用 panel.add(win.addButton({...})) 把子控件挂到面板（子控件用窗口绝对坐标）
    func addPanel(Dict opts): Panel {
        Panel p = pnl.createPanel(opts)
        widgets.add(p as Widget)
        widgetZ.add(opts.get("z", 0.0))
        p._bind_window(handle)
        return p
    }

    // 添加选项卡容器，opts: {x, y, w, h, tabs:[...], active, tab_h, font_size, ...}
    // 用法：tab.addToPage(0, SDL3.createButton({...})) 把子控件挂到指定页（子控件用窗口绝对坐标，落在内容区）
    func addTabControl(Dict opts): TabControl {
        TabControl t = tab.createTabControl(opts)
        widgets.add(t as Widget)
        widgetZ.add(opts.get("z", 0.0))
        t._bind_window(handle)
        return t
    }

    // 添加数值微调框，opts: {x, y, w, h, min, max, value, step, int, decimals, ...}
    // 返回 SpinBox，可 .on_change(func(float){...}) / .set_value(float) / .get_value() / .set_range(lo,hi)
    func addSpinBox(Dict opts): SpinBox {
        SpinBox s = spb.createSpinBox(opts)
        widgets.add(s as Widget)
        widgetZ.add(opts.get("z", 0.0))
        s._bind_window(handle)
        return s
    }

    // 添加表格，opts: {x, y, w, h, headers, col_widths, aligns, rows, row_h, header_h, sortable, zebra, ...}
    // 返回 Table，可 .on_select(func(int){...}) / .on_cell(func(int,int){...}) / .set_rows(...) / .add_row(...)
    func addTable(Dict opts): Table {
        Table t = tbl.createTable(opts)
        t.set_window_size(_w, _h)
        t.set_window_handle(handle)
        widgets.add(t as Widget)
        widgetZ.add(opts.get("z", 0.0))
        if t.is_context_menu_enabled() { menu.registerContextMenu(t.get_context_menu()) }   // 上下文菜单登记，由窗口第二遍按窗口隔离绘制
        return t
    }

    // 添加画布，opts: {x, y, w, h, bg_color, border, border_color, pad, cursor, ...}
    // 返回 Canvas，可 .on_draw(func(Renderer, float, float){...}) / .on_click(func(float, float, int){...}) 等
    func addCanvas(Dict opts): Canvas {
        Canvas c = cnv.createCanvas(opts)
        widgets.add(c as Widget)
        widgetZ.add(opts.get("z", 0.0))
        c.set_window_handle(handle)
        return c
    }

    // 添加水平布局容器，opts: {x, y, w, h, spacing, padX, padY}
    // hb.add(win.addButton({...}), {expand:true}) 占满剩余宽度；{align:1} 交叉轴居中
    func addHBox(Dict opts): HBox {
        HBox b = lay.createHBox(opts)
        widgets.add(b as Widget)
        widgetZ.add(opts.get("z", 0.0))
        b._bind_window(handle)
        return b
    }

    // 添加垂直布局容器，opts: {x, y, w, h, spacing, padX, padY}
    func addVBox(Dict opts): VBox {
        VBox b = lay.createVBox(opts)
        widgets.add(b as Widget)
        widgetZ.add(opts.get("z", 0.0))
        b._bind_window(handle)
        return b
    }

    // 添加锚点布局容器，opts: {x, y, w, h, padX, padY}
    // ab.add(win.addButton({...}), {left:10, top:10}) 钉在左上；{centerX:true,centerY:true} 居中
    func addAnchorBox(Dict opts): AnchorBox {
        AnchorBox b = lay.createAnchorBox(opts)
        widgets.add(b as Widget)
        widgetZ.add(opts.get("z", 0.0))
        b._bind_window(handle)
        return b
    }

    // 添加网格布局容器，opts: {x, y, w, h, cols, spacing, padX, padY, col_weights}
    // grid.add(win.addButton({...}), {align: 1})  align: 0=左上 1=居中 2=右下 3=撑满
    func addGridLayout(Dict opts): GridLayout {
        GridLayout b = grdlib.createGridLayout(opts)
        widgets.add(b as Widget)
        widgetZ.add(opts.get("z", 0.0))
        b._bind_window(handle)
        return b
    }

    // 添加通用滚动容器，opts: {x, y, w, h, content_w, content_h, bg, border, radius}
    // 用法：var box = SDL3.createVBox({...}); sv.set_content(box)；内容控件用 createXxx 创建（不要 win.add）
    // content_w/h 不传则自动取内容自然尺寸；悬停滚轮滚动，可拖右侧/底部滚动条
    func addScrollView(Dict opts): ScrollView {
        ScrollView s = scv.createScrollView(opts)
        widgets.add(s as Widget)
        widgetZ.add(opts.get("z", 0.0))
        s._bind_window(handle)
        return s
