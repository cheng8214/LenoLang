    // 添加图片视图，opts: {x, y, w, h, image_path, image_mode, radius, border, alpha, tint, cursor, on_click, ...}
    // image_mode: 0=aspectFit(默认) 1=stretch 2=aspectFill
    // 返回 ImageView，可 .set_image(path) / .set_mode(mode) / .on_click(func(){...}) 等
    func addImageView(Dict opts): ImageView {
        ImageView iv = ivw.createImageView(opts)
        widgets.add(iv as Widget)
        widgetZ.add(opts.get("z", 0.0))
        return iv
    }

    // 添加分隔线，opts: {x, y, w, h, dir, thickness, rgb, alpha, margin}
    // dir: 0=水平(默认) 1=垂直；布局容器中常用作视觉分隔
    func addSeparator(Dict opts): Separator {
        Separator s = seplib.createSeparator(opts)
        widgets.add(s as Widget)
        widgetZ.add(opts.get("z", 0.0))
        return s
    }

    // 添加胶囊徽标（**不可点**的状态标签；要可点请用 Button ✓）
    // opts: {x, y, text, w?, h?, font_size?, pad_x?, pad_y?, radius?, align?,
    //        bg_color?, border_color?, text_color?}  不给 w ⇒ 按文字 + 2×pad_x 自适应 ✓
    func addBadge(Dict opts): Badge {
        Badge b = bdglib.createBadge(opts)
        widgets.add(b as Widget)
        widgetZ.add(opts.get("z", 0.0))
        return b
    }

    // 添加提示条：kind 0=info 1=warn(默认) 2=danger 3=safe；高度按文字行数自适应 ✓
    // opts: {x, y, w, text, kind?, h?, font_size?, wrap?, wrap_w?, accent?, bg_color?, ...}
    func addAlert(Dict opts): Alert {
        Alert a = altlib.createAlert(opts)
        widgets.add(a as Widget)
        widgetZ.add(opts.get("z", 0.0))
        return a
    }

    // 添加步骤条；步骤用返回值的 `add_step(标题, 说明)` 追加、`set_active(i)` 一键推进 ✓
    // opts: {x, y, w, dir?(0 竖 1 横), item_h?, circle?, gap?, font_size?, desc_size?, done_color?, ...}
    func addSteps(Dict opts): Steps {
        Steps s = stplib.createSteps(opts)
        widgets.add(s as Widget)
        widgetZ.add(opts.get("z", 0.0))
        return s
    }

    // 添加模态遮罩（Scrim），默认 z=900（画在普通控件之上、弹层之下）
    // 用法：scrim = win.addScrim({}); scrim.show() / scrim.hide()
    func addScrim(Dict opts): Scrim {
        float zv = opts.get("z", 900.0)
        Scrim s = scrlib.createScrim(opts)
        s.set_pos(0, 0)
        s.set_size(_float(_w), _float(_h))
        widgets.add(s as Widget)
        widgetZ.add(zv)
        return s
    }

    // 添加超链接按钮，opts: {text, x, y, url, font_size, rgb, hover_rgb, underline, visited, on_click, ...}
    // 返回 LinkButton，可 .on_click(func(){...}) / .set_visited(bool) / .set_text(t) 等
    func addLinkButton(Dict opts): LinkButton {
        // ⚠ 局部量不能叫 `lb` ✗ —— 本文件 `import "sdl_listbox.leno" as lb`（见第 43 行 ✓）
        //   同名会让 **模块别名在该作用域不可达**（新警告 [模块别名被遮蔽] ✓ 见 M4）
        //   ⇒ 局部量改名 `link` ✓（别名在 addListBox 里还在用 ✓ 见第 841 行）
        LinkButton link = lnklib.createLinkButton(opts)
        widgets.add(link as Widget)
        widgetZ.add(opts.get("z", 0.0))
        return link
    }

    // 添加加载旋转动画，opts: {x, y, size, thickness, rgb, speed, running, full_track, ...}
    // 返回 Spinner，可 .start() / .stop() / .is_running() / .set_color(r,g,b) 等
    func addSpinner(Dict opts): Spinner {
        Spinner s = spnlib.createSpinner(opts)
        widgets.add(s as Widget)
        widgetZ.add(opts.get("z", 0.0))
        return s
    }

    // 添加带标题的分组容器，opts: {x, y, w, h, title, bg_rgb, border_rgb, title_rgb, radius, ...}
    // 用 gb.add(win.addButton({x, y, ...})) 把子控件挂到分组（子控件用窗口绝对坐标）
    func addGroupBox(Dict opts): GroupBox {
        GroupBox gb = gbxlib.createGroupBox(opts)
        widgets.add(gb as Widget)
        widgetZ.add(opts.get("z", 0.0))
        gb._bind_window(handle)
        return gb
    }

    // 添加树视图，opts: {x, y, w, h, items, row_h, indent, mode, show_check, context_menu, on_change, ...}
    // 返回 TreeView，可 .on_change(func(Array[int]){...}) / .on_context(...) / .on_toggle(...) /
    //   .expand/.collapse_all/.get_selected_id/.get_node/.add_child/.remove_node 等
    func addTreeView(Dict opts): TreeView {
        TreeView t = tvlib.createTreeView(opts)
        t.set_window(_w, _h)
        t.set_window_handle(handle)
        if t.is_context_menu_enabled() { menu.registerContextMenu(t.get_context_menu()) }   // 右键上下文菜单登记，由窗口第二遍按窗口隔离绘制
        widgets.add(t as Widget)
        widgetZ.add(opts.get("z", 0.0))
        return t
    }

    // 添加柱状图，opts: {x, y, w, h, title, font_size, show_values, show_grid}
    // 返回 BarChart，可 .set_data(Array[string] cats, Array[float] vals)
    func addBarChart(Dict opts): BarChart {
        BarChart c = cht.createBarChart(opts)
        widgets.add(c as Widget)
        widgetZ.add(opts.get("z", 0.0))
        return c
    }

    // 添加折线图，opts: {x, y, w, h, title, font_size, show_grid, show_points}
    // 返回 LineChart，可 .set_data(Array[string] xlabels, Array[Array[float]] series, Array[string] names)
    func addLineChart(Dict opts): LineChart {
        LineChart c = cht.createLineChart(opts)
        widgets.add(c as Widget)
        widgetZ.add(opts.get("z", 0.0))
        return c
    }

    // 添加饼图，opts: {x, y, w, h, title, font_size}
    // 返回 PieChart，可 .set_data(Array[string] labels, Array[float] values)
    func addPieChart(Dict opts): PieChart {
        PieChart c = cht.createPieChart(opts)
        widgets.add(c as Widget)
        widgetZ.add(opts.get("z", 0.0))
        return c
    }

    // 仅注册窗口（不启动主循环），用于多窗口场景：先逐个 registerOnly，最后 run() 启动循环
    func registerOnly(EventHandler onEvent, RenderCallback onRender) {
        // ★ 2026-11-21：虚拟子窗口走独立注册（不建 Renderer、不 SyncWindow、不取父窗口尺寸）
        if virt { _registerVirtual(onEvent, onRender); return }
        // ★ Android：SDL_StartTextInput 会**立刻弹出软键盘**，而且键盘把 Surface 挤小
        //   ⇒ 窗口高度从 1217 变成 ~600、所有控件位置全错（实测截图：键盘占了下半屏）。
        //   桌面必须有它（Edit 控件靠 SDL_EVENT_TEXT_INPUT 收字），所以只在非 Android 上无条件开；
        //   Android 要打字时由应用显式调用 SDL3.startTextInput(win.getHandle())。
        if _os() != "android" { core.startTextInput(handle) }
        // ★ 阻塞等待 OS 完成异步窗口状态变更（如创建时带 MAXIMIZED 标志的窗口）。
        //   SDL3 官方 API：SDL_SyncWindow 阻塞直到所有 pending 的窗口状态变更被 OS 应用。
        //   不调用此函数时，Windows 上最大化是异步的——getSize() 可能返回请求尺寸（1000x680）
        //   而非最大化后的实际尺寸（如 1920x1080），导致 SSAA 纹理创建为小尺寸→迷你版闪现。
        _lib.SDL_SyncWindow(handle)
        // ★ 获取窗口实际尺寸（系统可能已最大化/恢复到不同尺寸），
        //   用实际值初始化 SSAA 纹理和根布局，避免首帧渲染到旧尺寸纹理再贴到大窗口左上角
        Size actualSz = getSize()
        _w = actualSz.w; _h = actualSz.h
        Renderer ren = renderer.createRenderer(handle)
        // ★ 2026-11-21：密度交给渲染器 —— 它把 setScale 乘进 dens（SSAA 时是 ssaaScale*dens）
        //   ⇒ 之后所有绘制调用继续用**逻辑坐标**，落到物理像素上自动放大 ✓（桌面 1.0 = 不变 ✓）
        ren.setDensity(_dens)
        // ★ 密度 > 1 ⇒ 这是移动平台，指针就是手指 ⇒ 让控件放开"拖动内容滚动"这类手势
        //   （桌面密度 1.0 ⇒ 保持 false ⇒ 鼠标左键拖动语义不变 ✓）
        if _dens > 1.0 { event.setPointerIsTouch(true) }
        if aaScale > 0.0 { ren.enableSSAA(actualSz.w, actualSz.h, aaScale) }
        // ★ 同步根布局到实际窗口尺寸（setRootAt 在 run() 前调用，此时窗口可能已被系统改变尺寸）
        if root != null {
            root.set_pos(rootX, rootY)
            root.set_size(_float(actualSz.w) - rootX, _float(actualSz.h) - rootY)
        }
        // ★ 同步 MenuBar 到实际窗口尺寸（系统可能已最大化）
        float _tbH0 = _findTitleBarHeight(widgets)
        for menus.len() to mi {
            MenuBar mb = menus[mi]
            mb.set_pos(0, _tbH0)
            mb.set_size(_float(actualSz.w), mb.get_h())
            mb.setWindowSize(actualSz.w, actualSz.h)
        }
        // ★ 同步 Table/TreeView 内嵌上下文菜单的窗口尺寸（供右键菜单边界夹紧）
        for widgets.len() to wi {
            var widget = widgets[wi]
            if widget is Table {
                Table t = widget; t.set_window_size(actualSz.w, actualSz.h)
            } else if widget is TreeView {
                TreeView tv = widget; tv.set_window(actualSz.w, actualSz.h)
            }
        }
        _runWids.add(getID())
        _runHnds.add(handle)
        _runRens.add(ren)
        _runDens.add(_dens)          // ★ 密度（事件坐标换算要用；桌面 1.0）
        _runEvts.add(onEvent)
        _runRends.add(onRender)
        _runWidgets.add(widgets)    // 统一关联控件列表
        _runWidgetZ.add(widgetZ)    // 统一关联 z 值列表
        _runMenus.add(menus)        // 菜单栏集合（用于第二遍 overlay 绘制）
        MenuBar? cb = ctxBar
        if cb is MenuBar { _runCtxBar.add(cb); _runCtxIdx.add(ctxIdx) }
        else { _runCtxBar.add(menu.createMenuBar({})); _runCtxIdx.add(-1) }   // 占位（idx=-1 表示未注册，run 中不弹）
        _runRoots.add(root)         // 根布局控件
        _runRootX.add(rootX)         // 根布局偏移
        _runRootY.add(rootY)
        _runW.add(actualSz.w); _runH.add(actualSz.h)
        _runDialogHidden.add(_dialogHidden)   // 对话框窗口：首帧渲染后自动 show
        _runTransparent.add(transparent)    // 透明窗口标志
        _runOverlays.add(_overlay)           // 叠加层回调（可空）
        _runShortcuts.add(_shortcuts)          // 快捷键列表
        _runShortcutGuards.add(shortcutGuard) // 快捷键守卫
        _runVOn.add(false); _runVParent.add(0); _runVTexD.add({})
        _runVX.add(0.0); _runVY.add(0.0); _runVS.add(1.0); _runVDrawn.add(0)
    }

    // ★ 2026-11-21：注册虚拟子窗口（见 `_runVirt` 上方那段说明）
    //   与 registerOnly 的唯一差别：**不碰 SDL 窗口/Renderer**，渲染目标是一块自己的离屏纹理。
    pri func _registerVirtual(EventHandler onEvent, RenderCallback onRender) {
        // 父窗口 = 第一个**非虚拟**的已注册窗口（= 主窗口）。
        // 设计上不要求调用方传 parent：弹窗总是"主窗口已经跑起来之后"才创建 ✓
        int pj = -1
        for _runWids.len() to j {
            if not _virtOn(j) { pj = j; break }
        }
        if pj < 0 {
            print("[LenoSDL3] 虚拟子窗口注册失败：没有可用的父窗口（主窗口必须先 registerOnly/run）\n")
            ok = false
            return
        }
        int pwid = _runWids[pj]
        handle = _runHnds[pj]              // 借用父窗口句柄（控件 `_bind_window` 要非空 ✓）
        Renderer pren = _runRens[pj]
        _runWids.add(getID()); _runHnds.add(handle); _runRens.add(pren)
        _runEvts.add(onEvent); _runRends.add(onRender)
        _runWidgets.add(widgets); _runWidgetZ.add(widgetZ)
        _runMenus.add(menus)
        MenuBar? cb = ctxBar
        if cb is MenuBar { _runCtxBar.add(cb); _runCtxIdx.add(ctxIdx) }
        else { _runCtxBar.add(menu.createMenuBar({})); _runCtxIdx.add(-1) }
        _runRoots.add(root); _runRootX.add(rootX); _runRootY.add(rootY)
        _runW.add(virtLW); _runH.add(virtLH)
        _runDialogHidden.add(false)        // 无 OS 窗口 ⇒ 不涉及"首帧后 show"
        _runTransparent.add(false)
        _runOverlays.add(_overlay)
        _runShortcuts.add(_shortcuts); _runShortcutGuards.add(shortcutGuard)
        _runVOn.add(true); _runVParent.add(pwid); _runVTexD.add({})
        _runVX.add(0.0); _runVY.add(0.0); _runVS.add(1.0); _runVDrawn.add(0)
        // ★ 密度：虚拟子窗口活在**父窗口的逻辑空间**里 ⇒ 自己不再做换算（1.0）；
        //   物理分辨率只在建离屏纹理时用父窗口的密度（见 `_virtTexDens`）✓
        _runDens.add(1.0)
        _virtEnsureTex(pren)
        // 根布局：**按自己的逻辑尺寸**铺（父窗口大小与它无关 ⇒ 桌面布局原样可用 ✓）
        if root != null {
            root.set_pos(rootX, rootY)
            root.set_size(_float(virtLW) - rootX, _float(virtLH) - rootY)
        }
    }

    // 虚拟子窗口：确保离屏纹理存在、尺寸与逻辑尺寸一致
    // ★ 2026-11-21：虚拟子窗口离屏纹理的**物理**倍率 = 父窗口密度
    //   （纹理按逻辑尺寸建会在大屏上被放大 ⇒ 文字糊；按物理像素建 + 按 density 缩放绘制 ⇒ 清晰 ✓）
    pri func _virtTexDens(): float {
        int i = _virtIndex(getID())
        if i < 0 { return 1.0 }
        float d = _densOfWid(_virtParentOf(i))
        if d < 1.0 { return 1.0 }
        return d
    }

    pri func _virtEnsureTex(Renderer ren) {
        int i = _virtIndex(getID())
        if i < 0 or ren == null { return }
        float td = _virtTexDens()
        int tw = maths.roundi(_float(virtLW) * td)
        int th = maths.roundi(_float(virtLH) * td)
        if tw < 1 { tw = 1 }
        if th < 1 { th = 1 }
        Ptr[u8] old = _virtTexOf(i)
        if old != null and _virtTexW == tw and _virtTexH == th { return }
        if old != null { _lib.SDL_DestroyTexture(old) }
        _virtTexW = tw; _virtTexH = th
        // ACCESS_TARGET = 2（同 SSAA 的用法）；线性缩放 ⇒ 缩到手机宽度时文字不发块 ✓
        Ptr[u8] t = ren.createTexture(core.PIXELFORMAT_RGBA8888, 2, tw, th)
        if t == null {
            print("[LenoSDL3] 虚拟子窗口离屏纹理创建失败：" + core.getError() + "\n")
        } else {
            _lib.SDL_SetTextureScaleMode(t, core.ScaleMode.LINEAR)
        }
        _virtSetTex(i, t)
    }

    pri func _virtResizeTex() {
        int i = _virtIndex(getID())
        if i < 0 { return }
        _virtEnsureTex(_runRens[i])
    }

    pri func _virtDropTex() {
        int i = _virtIndex(getID())
        if i < 0 { return }
        Ptr[u8] t = _virtTexOf(i)
        if t != null { _lib.SDL_DestroyTexture(t); _virtSetTex(i, null) }
    }

    // ★ 2026-11-27：每窗口的 dt（Tickable 统一推进用）。首帧返回 0（没有"上一帧"可算）。
//   钳到 33ms，与滚动/补间内核同口径（掉帧或空闲唤醒时不会一帧跳几百像素）。
pri func _tickDt(int wid): float {
    int now = core.getTicksNS()
    int idx = -1
    for _tickWids.len() to k { if _tickWids[k] == wid { idx = k; break } }
    if idx < 0 {
        _tickWids.add(wid); _tickNss.add(now)
        return 0.0
    }
    int dn = now - _tickNss[idx]
    _tickNss[idx] = now
    if dn <= 0 { return 0.0 }
    float dt = _float(dn) / 1000000000.0
    if dt > 0.033 { dt = 0.033 }
    return dt
}

// ==================== 控件树绘制（2026-11-21 从 run() 抽出）====================
    // 为什么抽出来：虚拟子窗口要复用**同一套**绘制顺序（根 → 控件按 z → 弹层 → toast/tip → 叠加层）。
    // 复制一份必然漂移（弹层/焦点环/toast 以后还会加东西），所以只能抽 ☑
    //   opac：控件级不透明度数组（主循环传 self.widgetOpac，行为与抽取前逐字一致 ✓）
    //   ⚠ 虚拟子窗口传空数组 ⇒ 弹窗里 `set_widget_opacity` 暂不生效（该特性极少用，先如实标注 ✓）
    pri func _drawTree(int i, Renderer ren, Array[float] opac) {
        // 弹层捕获区：每帧渲染前清空，由展开的下拉框在 renderPopup 里重新登记
        //   ★ 按窗口隔离：设上下文 ⇒ 只清/只登记**本窗口**那一块（别的窗口不受影响 ✓ 见 sdl_core ✓）
        core.setDispatchWindow(_runWids[i])
        core.clearPopupCapture()
        var rootWid = _runRoots[i]

        // ★ 2026-11-27：**统一每帧推进**（Tickable）—— 必须在绘制**之前**
        //   控件只实现 `tick(dt): bool`（返回"还在动"），这里汇总后请求下一帧。
        //   ⚠ 控件侧**仍然自己 requestRedraw**（双保险）：万一这里的续帧被节流/漏掉，
        //     还有控件那条兜底 —— 上一版删掉控件侧续帧、全靠这里，结果 Aria 滚不动 ✗
        float tdt = _tickDt(_runWids[i])
        if tdt > 0.0 {
            bool moving = false
            var tws = _runWidgets[i]
            for tws to twi {
                if rootWid != null and twi == rootWid { continue }   // 根控件单独 tick，别推两次 ✗
                if twi is wgt.Tickable => tk { if tk.tick(tdt) { moving = true } }
            }
            if rootWid is wgt.Tickable => rk { if rk.tick(tdt) { moving = true } }
            if moving { core.requestRedraw() }
        }

        // 先渲染根布局控件（背景层），再渲染 _widgets（按 z 值排序后层叠）
        rootWid?.render(ren)
        // 自动渲染该窗口的所有控件（z 值小的先画，大的后画；同 z 值保持添加顺序）
        // ★ 跳过已作为 root 渲染的控件，避免双重渲染导致闪烁
        //   （如 TabControl 既被 setRoot 又在 _widgets 中，双重渲染时
        //     第二次的内容区背景覆盖第一次 Table 内容 → 闪一下背景再画 Table）
        var ws = _runWidgets[i]
        var wz = _runWidgetZ[i]
        int wn = ws.len()
        if wn > 0 {
            // 构建排序索引（稳定排序：同 z 值保持原始顺序）
            Array[int] order = []
            for wn to k { order.add(k) }
            // 选择排序（控件数量通常 < 50，不需要复杂排序算法）
            for wn to k {
                int minIdx = k
                int j = k + 1
                while j < wn {
                    if wz[order[j]] < wz[order[minIdx]] { minIdx = j }
                    j = j + 1
                }
                if minIdx != k {
                    int tmp = order[k]; order[k] = order[minIdx]; order[minIdx] = tmp
                }
            }
            for wn to k {
                var w = ws[order[k]]
                if rootWid != null and w == rootWid { continue }
                // ★ 2026-10-13：控件级不透明度 —— **只在此处包一层** ✓（控件侧零改动 ✓）
                //   `op >= 1.0` 是绝大多数控件的路径 ⇒ 不引入任何多余调用 ✓
                float op = 1.0
                int oi = order[k]
                if oi >= 0 and oi < opac.len() { op = opac[oi] }
                if op >= 1.0 {
                    w.render(ren)
                } else {
                    ren.setAlphaScale(op)
                    w.render(ren)
                    ren.setAlphaScale(1.0)      // 必须还原 ⇒ 否则后面所有绘制都跟着淡 ✗
                }
                // ★ 2026-10-13：聚焦 ring —— 由**控件自绘**、窗口只叫一下 ✓
                //   （控件自检 `focused` ⇒ 没聚焦时是空调用 ✓；ring 放在 opacity 之后 ⇒ 环始终清晰 ✓）
                switch w {
                    case is Button, CheckBox, RadioButton, Toggle, Slider, ListBox, ComboBox, TabControl, Table, TreeView { w.draw_focus_ring(ren) }
                }
            }
        }
        // 第二遍：所有展开的下拉框画在最上层（按窗口隔离；含经 panel/tab/布局添加的，由 registerComboBox 兜底）
        cbb.renderComboBoxes(ren, _runHnds[i])
        // 第二遍：所有展开的下拉菜单画在最上层
        var mns = _runMenus[i]
        for mns to mn { mn.renderPopup(ren) }
        // ★ 第二遍：TitleBar 的嵌入式 MenuBar 弹层（set_center_menu 嵌入的菜单下拉）
        var ws2 = _runWidgets[i]
        for ws2 to w2 {
            if w2 is TitleBar { TitleBar tb2 = w2; tb2.renderPopup(ren) }
        }
        // 第二遍：所有展开的控件内嵌右击上下文菜单（Edit 经 panel.add 添加时未进 _menus，
        // 在此兜底绘制到最上层，避免被同级控件遮挡）
        menu.renderContextMenus(ren, _runHnds[i], _runW[i], _runH[i])
        core.clearDispatchWindow()      // 本窗口的弹层都登记完了 ⇒ 撤上下文 ✓
        // Toast 浮层（2026-10-30）：在控件与弹层之后、Tooltip 之前。
        //   tick 是全局状态更新，每帧只需一次（在首个窗口时调用，同 tipTick ✓）
        if i == 0 { tst.toastTick(_runWids[i]) }
        tst.toastRender(ren, _runW[i], _runH[i], _runWids[i])
        // Tooltip 浮层：在所有控件与弹层之后绘制，浮在最上层；不拦截输入
        if i == 0 { tip.tipTick() }
        tip.tipRender(ren, _runW[i], _runH[i], _runWids[i])
        // ★ 2026-11-21：虚拟子窗口合成（**在叠加层之前**）
        //   为什么放在 overlay 下面：overlay 的契约是"盖住一切"（HUD / 截图钩子），
        //   把弹窗塞到它上面会让所有现有应用的截图钩子拍不到弹窗（Android 上只能靠截图取证 ✗）。
        //   代价：HUD 会压在弹窗上 —— 这是刻意的，HUD 是"临时信息"，弹窗是"交互层"，
        //   真要弹在 HUD 之上，可以在 overlay 回调里自己 `SDL3.isVirtual()` 判断后跳过绘制 ✓
        _renderVirtChildren(i, ren)
        // 叠加层：在所有控件/弹层/Tooltip 之上绘制（拖拽浮动框等），present 之前最后一遍
        var _ovl = _runOverlays[i]
        if _ovl != null { _ovl(ren) }
    }

    // ★ 2026-11-21：把本窗口的虚拟子窗口合成上来
    //   顺序（实测确认）：父控件 → 弹层 → toast/tip → **本函数** → 父窗口 overlay → present
    //   为什么在 overlay 之后：弹窗是"最上层"，而 overlay 的契约是"盖住一切"（HUD/截图钩子）——
    //   两者冲突时以**弹窗**为准（点不到的 HUD 等于不存在），截图钩子因此也能截到弹窗 ✓
    pri func _renderVirtChildren(int pi, Renderer ren) {
        int pw = _runW[pi]; int ph = _runH[pi]
        if pw <= 0 or ph <= 0 { return }
        bool _anyV = false
        for _runWids.len() to j {
            if not _virtOn(j) { continue }
            if _virtParentOf(j) != _runWids[pi] { continue }
            int dw = _runW[j]; int dh = _runH[j]
            if dw <= 0 or dh <= 0 { continue }
            // 等比缩到父窗口客户区（留 16px 边），**只缩不放**：桌面尺寸的弹窗在手机上整屏可见
            float m = 16.0
            float sx = (_float(pw) - 2.0 * m) / _float(dw)
            float sy = (_float(ph) - 2.0 * m) / _float(dh)
            float s = maths.min(1.0, maths.min(sx, sy))
            if s < 0.25 { s = 0.25 }        // 兜底：极小屏也别缩成一条缝
            float dx = (_float(pw) - _float(dw) * s) * 0.5
            float dy = (_float(ph) - _float(dh) * s) * 0.5
            _runVX[j] = dx; _runVY[j] = dy; _runVS[j] = s
            Ptr[u8] tex = _virtTexOf(j)
            if tex == null { continue }
            // ① 画进自己的离屏纹理：坐标是**子窗口自己的 0,0**（控件树零改动 ⇒ 桌面布局原样可用）
            //   ★ 密度：纹理按物理像素建（见 `_virtEnsureTex`）⇒ 这里必须按同一个倍率缩放，
            //     否则子窗口只会画到纹理左上角 1/d 的区域（实测：Android 上弹窗内容缩在一角）
            float _td = _densOfWid(_virtParentOf(j))
            if _td < 1.0 { _td = 1.0 }
            ren.setRenderTarget(tex)
            // 注：`setRenderTarget` 已把缩放缓存同步成 SDL 的实际值（1.0）⇒ 这一行会真正下发 ✓
            ren.setScale(_td, _td)
            Theme th = theme.getTheme()
            ren.setColor(th.bg)
            ren.fillRect(0, 0, _float(dw), _float(dh))
            try {
                _runRends[j](ren)
            } catch e {
                print("[错误] 虚拟子窗口渲染异常: " + e)
            }
            _drawTree(j, ren, [])
            // ② 回到父窗口的渲染目标
            //   ⚠ 必须先显式 `setRenderTarget(null)`：`beginFrame()` 只在开了 SSAA 时才设目标，
            //     否则它是空操作 —— 那就会把后面的遮罩/贴图**继续画进弹窗纹理**里（实测：整块不显示 ✗）
            ren.setRenderTarget(null)
            ren.setScale(1.0, 1.0)
            ren.beginFrame()        // 开了 SSAA ⇒ 切回它的离屏纹理 + 缩放（逻辑坐标不变 ✓）
            // ③ 模态遮罩 + 阴影 + 等比贴图
            if _isModal() and _modalTop() == _runWids[j] {
                ren.setColorFloat(0.0, 0.0, 0.0, 0.6)
                ren.fillRect(0, 0, _float(pw), _float(ph))
            }
            // 投影：弹窗底色常与主窗口同色（同一个 theme）⇒ 没有阴影就看不出"这是一块弹窗"（实测 ✓）
            ren.setColorFloat(0.0, 0.0, 0.0, 0.45)
            ren.fillRect(dx + 3.0, dy + 4.0, _float(dw) * s, _float(dh) * s)
            ren.drawTextureAt(tex, dx, dy, _float(dw) * s, _float(dh) * s)
            // 1px 描边：暗色主题下也能看出边界
            ren.setColorFloat(1.0, 1.0, 1.0, 0.12)
            ren.drawRect(dx - 0.5, dy - 0.5, _float(dw) * s + 1.0, _float(dh) * s + 1.0)
            _runVDrawn[j] = _runVDrawn[j] + 1
            core.dropWindowRedraw(_runWids[j])
            _anyV = true
        }
        if _anyV { core.setDispatchWindow(_runWids[pi]) }   // 合成时改过派发上下文 ⇒ 还原
    }

    // 运行主循环（回调模式，支持多窗口）
    // 单窗口：直接调用 run() 注册并启动循环
    // 多窗口：各窗口先 registerOnly()，最后一个 run() 启动循环
    //
    // ★ 两个回调**都要给** ✓ —— 漏一个只会报「只能调用函数（不是对象类型）」，
    //   看不出缺的是哪个参数 ✗（本人踩过 ✓）：
    //     onEvent  (Event) -> bool —— 返回 false 结束主循环，true 继续
    //     onRender (Renderer)      —— 每帧绘制（清屏 / 背景 / 网格），**在最底层** ✓
    //   例：
    //     win.run(
    //         func(Event ev): bool { if ev.isQuit() or ev.isWindowClose() { return false } return true },
    //         func(Renderer r) { r.clearColor(#F0F1F4FF) }
    //     )
    //
    // ★ 三个绘制层的先后（**实测确认** ✓，不是推测）：
    //     ① onRender（run 的第二个回调）—— 最底层，**在控件之下**
    //     ② 控件树（_root 根布局 + addXxx 注册的控件）
    //     ③ setOverlay 回调 —— 最上层，盖住一切（HUD / 调试标记 / 截图钩子都放这里 ✓）
    //   ⇒ 想让自绘"盖在控件之上"就必须放 setOverlay；
    //     放在 onRender 里会被控件盖掉 ✗（本人曾以为 onRender 在上层 ✗，实测打脸 ✓）
    //
    // ★ 不需要 addTimer 空转来"保持窗口不退出"：主循环本来就一直跑，
    //   退出只由 onEvent 返回 false（或调用 _exit）决定 ✓
    // 返回 bool：**true = 真的进了阻塞循环**（本调用期间循环跑完才返回）；
    //            **false = 主循环已在跑**，本窗口只是被注册进去、由现有循环驱动，
    //                    调用方拿不到"窗口关闭了"这个返回时机 ✗
    //   ★ 2026-11-08 框架缺陷修复：原来无返回值、静默 return —— 调用方（比如从 200ms 定时器里弹窗）
    //     会以为"返回了就是关掉了"，于是每一拍又调一次 run/runModal ⇒ 窗口和线程疯狂堆积
    //     （实测 30 秒 814 → 4085 线程、内存 287MB → 977MB）。有了返回值，调用方能自己判断。
    func run(EventHandler onEvent, RenderCallback onRender): bool {
        registerOnly(onEvent, onRender)
        if _runLoopActive { return false }
        _runLoopActive = true

        // ★ 首帧前检测：SDL_SyncWindow 已在 registerOnly 中阻塞等待 OS 完成最大化，
        //   正常情况下此处尺寸应与 registerOnly 时一致。此检测作为安全网，防止极端时序下
        //   registerOnly 到 run() 之间窗口尺寸再次变化（如用户快速操作）。
        for _runWids.len() to i {
            if _virtOn(i) { continue }     // 虚拟子窗口：句柄是父窗口的 ⇒ 取它的尺寸会把弹窗布局撑成主窗口 ✗
            SDL_Point pt = SDL_Point.malloc()
            _lib.SDL_GetWindowSize(_runHnds[i], &pt.x, &pt.y)
            // ★ 密度：Android 上这里给的是物理像素 ⇒ 立刻换成逻辑像素（下游全部按逻辑使用 ✓）
            float _ds1 = if i < _runDens.len() then _runDens[i] else 1.0
            if _ds1 > 1.0 {
                pt.x = maths.roundi(_float(pt.x) / _ds1)
                pt.y = maths.roundi(_float(pt.y) / _ds1)
                if pt.x < 1 { pt.x = 1 }
                if pt.y < 1 { pt.y = 1 }
            }
            if pt.x != _runW[i] or pt.y != _runH[i] {
                _runRens[i].resizeSSAA(pt.x, pt.y)
                _runW[i] = pt.x; _runH[i] = pt.y
                var rootWid = _runRoots[i]
                rootWid?.set_pos(_runRootX[i], _runRootY[i])
                rootWid?.set_size(_float(pt.x) - _runRootX[i], _float(pt.y) - _runRootY[i])
                // ★ 同步 MenuBar 尺寸到满宽（首帧尺寸可能与 registerOnly 时不同）
                float _tbH1 = _findTitleBarHeight(_runWidgets[i])
                var menus0 = _runMenus[i]
                for menus0.len() to mi0 {
                    MenuBar bar = menus0[mi0]
                    bar.set_pos(0, _tbH1)
                    bar.set_size(_float(pt.x), bar.get_h())
                    bar.setWindowSize(pt.x, pt.y)
                }
                // ★ 同步 Table/TreeView 窗口尺寸 + Splitter 向下传播（供内部右键菜单边界夹紧）
                var widgets0 = _runWidgets[i]
                for widgets0.len() to wi0 {
                    // ★ 2026-10-13：类型表**收敛到 sdl_layout.passWindowResize 一处** ✓
                    //   （原来是硬编码 3 遍：主循环 / 模态窗 / 悬停弹层窗 ⇒ 新增控件要改 3 处 ✗）
                    lay.passWindowResize(widgets0[wi0], _runHnds[i], pt.x, pt.y)
                }
                // 根控件也要收 resize（**根可能是 Splitter** —— 它不在 `_widgets` 顶层 ✓）
                //   ★ 类型判断同样收敛到 `sdl_layout.passWindowResize` ⇒ 本文件不再认识任何具体控件类型 ✓
                var rw0 = rootWid
                if rw0 != null { lay.passWindowResize(rw0, _runHnds[i], pt.x, pt.y) }
            }
            pt.free()
        }

        Event ev = event.createEvent()
        bool _needRedraw = true       // 初始绘制一次
        // ★★ 2026-11-17（复审修正）：**跨轮次**的"欠一次全脏帧"标记。
        //   原来它声明在 `while true` **里面** ⇒ 每轮开头重置成 false，而末尾
        //   `if core.consumeRedrawRequest() { … _pendingFull = true }` 写的是同一个局部量 ⇒
        //   "跨轮次保留"根本没生效 ✗。真实后果（静默丢一次重绘）：
        //     渲染中应用回调调了 requestRedraw()（全局）⇒ 帧末被 consume 掉 ⇒ 下一轮若恰好
        //     还有**别的窗口**的 requestRedrawWindow 挂着，`hasWindowRedraw()` 非空使得
        //     "兜底全脏"不触发 ⇒ 只画了那个窗口，**这次全局重绘永久丢失**（不报错、不闪，
        //     就是那一帧该更新没更新）。提到循环外即可 ✓
        bool _pendingFull = false     // 有"欠一次全脏帧"的请求尚未兑现（跨轮次）
        // ★ 2026-11-18：**每窗口最小帧间隔**的两张表（按 _runWids 下标走）。
        //   `_winGap[i]` 是"这个窗口两帧至少隔多少毫秒"（0 = 不限）；`_lastDrawAt[i]` 是上次真画的时间。
        //   谁来设 `_winGap`：控件在 render 里调 `core.setFrameGap(40)`（如 `ImageView` 的封面自转），
        //   run 在渲染完那个窗口时把它读进 `_winGap[i]` —— 用来把"小动画"压在 ~25fps，
        //   而不是让整页 60fps 重绘（老机器 CPU 30~40% 的元凶，见 sdl_imageview 的说明 ✓）
        Array[int] _winGap = []
        Array[int] _lastDrawAt = []
        int  _lastRenderTicks = core.getTicks()   // 上次渲染时刻，用于帧率节流
        int  _throttleMs = if maxFPS > 0 then 1000 / maxFPS else 1
        int _sizeSyncRemaining = 10   // 安全网：前 N 帧持续检查窗口尺寸（SDL_SyncWindow 已解决主问题）

        // ---- 确定性 GUI 基准模式（2026-09-15）----
        // `LENO_SDL_FRAMES=<n>`：跑满 n 帧后自动清理退出，并打印一行确定性摘要。
        //
        // 为什么需要它：GUI 负载的 A/B **必须固定帧数**。按"跑满 N 秒"测时，同一壁钟时长内
        // 实际跑了多少帧会随系统噪声变化 —— 实测同一应用交替同轮测 CPU 时间能差 4 倍、
        // 且两轮方向还会翻转（`FuncExecuted` 甚至差 60 倍），根本下不了结论。
        // 配合 `SDL_VIDEODRIVER=dummy|offscreen`（**不开任何窗口**）⇒ 可重复、可自动化、
        // 不需要人工交互，也不需要我在测试时弹窗。
        //
        // 默认不设这个环境变量 ⇒ 帧计数为 0、不强制重绘、不打印，行为与改动前逐字一致。
        int _benchFrames = 0
        {
            var _bfEnv = _env("LENO_SDL_FRAMES")
            if _bfEnv != null { _benchFrames = _int(_bfEnv) }
            if _benchFrames < 0 { _benchFrames = 0 }
        }
        int _benchDone = 0
        int _benchT0 = core.getPerfCounter()
        if _benchFrames > 0 { _throttleMs = 0 }   // 基准模式去掉帧率节流（每轮都真渲染）

        // ---- 运行时帧诊断（2026-11-18，Aria 老机器「开桌面歌词 CPU 10% → 40%」反哺）----
        // `LENO_FRAME_TRACE=<文件路径>` ⇒ 每秒写一行到**文件**并 print 一次：
        //     [FRAME] 12s iters=62 frames=62 full=0 | w1 n=0 | w2 n=30 420us/f | timer=1ms ev=2ms
        // 判读方法：
        //   · 某个窗口 n 明显大于它的定时器频率 ⇒ 有东西在（直接或间接）反复请求它重绘；
        //   · full > 0 且每秒都有 ⇒ 有调用方走了**全局** requestRedraw（会把所有窗口一起画）；
        //   · 某窗口 us/f 很大 ⇒ 是那一页自己的绘制太重（控件树），不是窗口数量的问题；
        //   · iters 远大于 frames ⇒ 循环被高频唤醒但没出帧（节流/定时器参数问题）。
        // 为什么写文件：应用普遍 `_console(false)` 关掉控制台，print 是看不见的 ✗
        // 不设这个环境变量 ⇒ 下面所有分支都不进，行为与之前逐字一致 ✓
        string _trPath = ""
        {
            var _trEnv = _env("LENO_FRAME_TRACE")
            if _trEnv != null { _trPath = _str(_trEnv) }
        }
        bool _trOn = _trPath != ""
        int _trNext = core.getTicks() + 1000
        int _trIters = 0
        int _trFrames = 0
        int _trFull = 0
        int _trTimerUs = 0
        int _trEvUs = 0
        int _trEvs = 0        // 每秒处理的事件个数（=0 却 iters 很高 ⇒ 空转自旋；>1000 ⇒ 事件风暴）
        int _trSpin = 0       // "等着出帧但 waitTimeout 几乎没睡"的次数（≈iters ⇒ 在空转烧 CPU）
        int _trSkip = 0       // 欠帧但被**帧率节流**挡下的次数（说明节流窗口里在反复空转）
        int _trGapSkip = 0    // 被"窗口级最小间隔"挡下的次数（2026-11-18）
        int _trG0 = core._dbgGlobalReqs      // 上一秒的"全脏请求"计数（差值 = 每秒速率）
        int _trW0c = core._dbgWinReqs        // 上一秒的"按窗口请求"计数
        int _trGC0 = core._dbgGapCalls       // 上一秒的 setFrameGap(>0) 计数
        string _trLog = ""
        Array[int] _trN = []
        Array[int] _trUs = []

        while true {
            core.resetFrameCursor()   // 每帧开始：清空本帧光标请求
            core.advanceFrame()       // 帧计数器递增（供控件做帧内去重）
            // 基准模式：每轮都请求重绘 ⇒ "帧数"与"渲染次数"一一对应（负载可重复）
            if _benchFrames > 0 { _needRedraw = true }
            // ★ 2026-11-17：**欠一次全脏帧**的标记在循环外声明（`_pendingFull`）——
            //   放在这里面就成了每轮重置的局部量，跨轮次保留不成立（见循环前那段注释）。
            bool _hadEvent = false
            // ★ 2026-11-17：这个事件**属于哪个窗口** —— 事件触发的重绘只脏它（见下面的 `_fullFrame`）
            //   `<= 0`（SDL 的全局事件，如显示器变化/剪贴板）= 不归属任何窗口 ⇒ 退回全脏 ✓
            int _hadEventWid = 0
            // ★ 本帧是否有"输入类"非 motion 事件（滚轮 / 点击 / 键盘 / resize）。
            //   这类事件**不受帧率节流**：否则滚动/点击的响应最多被拖 1/30 秒，且连续滚动时
            //   多个滚轮增量会被攒进同一帧 ⇒ 画面一顿一顿、像"跳一下" ✗（"滚动不利索"的根因 ✓）
            bool _inputEvent = false
            // 动态计算等待时长：有重绘请求时节流至目标 FPS，空闲时按定时器触发时刻
            int timeoutMs = 500
            if _needRedraw {
                int elapsed = core.getTicks() - _lastRenderTicks
                int remain = _throttleMs - elapsed
                if remain < 1 { remain = 1 }
                if remain > timeoutMs { remain = timeoutMs }
                timeoutMs = remain
            } else {
                int nextTM = timer.nextTimerMs()
                if nextTM >= 0 {
                    int wait = nextTM - core.getTicks()
                    wait = maths.clampi(wait, 1, 100)      // 2026-11-01：int 夹取走 clampi
                    timeoutMs = wait
                }
                // ★ Tooltip 等待：将 poll 超时设为 tooltip 剩余等待时间，
                //   到期后唤醒一次渲染以显示 tooltip，而非每帧 60fps 空转重绘。
                //   旧方案 tipWaiting() 恒为 true → _needRedraw 恒 true → 60fps 全量重绘，
                //   在弱 CPU 上仅 hover 表格就能占 30%+ CPU。
                int tipRemain = tip.tipRemainingMs()
                if tipRemain >= 0 and tipRemain < timeoutMs { timeoutMs = tipRemain }
                // ★ Toast 同理（2026-10-30）：淡入淡出期 ~16ms 醒一次，停留期一觉睡到淡出开始，
                //   到期自动淡出 ⇒ 不用像应用侧那样挂 33ms 定时器常驻 30fps 空转 ✗
                int toRemain = tst.toastNextEventMs()
                if toRemain >= 0 and toRemain < timeoutMs { timeoutMs = toRemain }
                if timeoutMs < 1 { timeoutMs = 1 }
            }
            int _t0 = core.getTicks()
            int _profW0 = core.getPerfCounter()
            ev.waitTimeout(timeoutMs)
            if _benchFrames > 0 {
                _profWaitUs = _profWaitUs + _profAdd(_profW0)
                _profIters = _profIters + 1
            }
            // 兜底：若 waitTimeout 提前返回（实际等待 < 5ms 且无事件），
            // 强制 Sleep 补足，防止事件循环高频空转→CPU 占用异常
            int _wakeTick = core.getTicks()
            int _wakeWait = _wakeTick - _t0
            // ★★ 2026-11-17（实测出的大头）：**有活要干时绝不补睡**。
            //   原来不管有没有欠帧都补足 5ms，代价是：
            //     · 基准模式每次迭代白睡 ~5ms ⇒ us_per_frame 被抬高近一倍
            //       （实测 9962µs/帧 → 补睡去掉后 ~4700µs，其中"循环体外"那 5.3ms 全是这个 Sleep ✗）
            //     · 正常模式里动画/定时器欠帧时也被推迟最多 5ms：30fps 的 33ms 预算白扔 15%，
            //       表现为"动画偶发跳一下"（一直查不出的那类抖动 ✓）
            //   只在**真的没事干**（不欠帧、也不在跑基准）时才补，保留原来"防事件循环空转"的意图 ✓
            // ★★ 2026-11-18（Aria 播放时 CPU 反哺）：**欠帧但还在节流窗口里**必须把这段预算睡掉。
            //   原逻辑只在"没事干"时补睡 5ms，欠帧时则不管 —— 实测（LENO_FRAME_TRACE）：
            //     播放中 iters≈2400/秒、spin≈iters、skip≈iters、evs=0
            //   也就是每秒空转两千多次（每次还要 malloc×2/free/轮询），一帧都没多画，
            //   白烧 ~10% 单核（老机器更糟）。原因是 `ev.waitTimeout(n)` 在 Windows/D3D 下
            //   经常**立刻返回**（没有事件也秒回），靠它做节流等于没有节流 ✗
            //   为什么补睡安全：这里 `ev.has=false`（没有事件），SDL 的等待本来就会被新事件唤醒；
            //   补睡只是把"下一帧"推到节流窗口末端 —— 那本来就是它该出帧的时刻 ✓
            if not ev.has and _benchFrames <= 0 {
                if _backgrounded {
                    // ★ 2026-11-21：后台不按帧率醒来（否则手机上是 60 次/秒的空转 ⇒ 实打实掉电）。
                    //   100ms 一拍只为兜住"前台事件丢了"这种异常；正常情况事件一到立刻醒 ✓
                    core.delay(100)
                } else if _needRedraw and not _inputEvent {
                    int _remMs = _throttleMs - (core.getTicks() - _lastRenderTicks)
                    if _remMs > 1 { core.delay(_remMs - 1) }
                } else if not _needRedraw and _wakeWait < 5 {
                    core.delay(5 - _wakeWait)
                }
            }
            if _trOn and _needRedraw and not ev.has and _wakeWait < 2 { _trSpin = _trSpin + 1 }
            // ★ Motion 事件合并：鼠标快速移动时 SDL 队列中会堆积大量连续 motion 事件，
            //   每个都触发全控件 process()。弱 CPU 上导致 CPU 占用飙升。
            //   合并策略：只保留同窗口的最后一个 motion 事件，丢弃中间的。
            //   _motionBuf 保存最新 motion，_deferredBuf 保存合并期间遇到的非 motion 事件。
            // ★ 2026-11-18：这两块 128B 缓冲改成**只分配一次**（模块级，见 `_evBufA/_evBufB`）。
            //   原来每次循环迭代 malloc×2 + free×2 —— 实测循环体固定开销约 0.36ms/次，
            //   而播放动画时每秒会醒 1500+ 次（见下面的节流/窗口级限速），白烧半个核 ✗
            // ★ 2026-11-26：128 换成 SDL_Event.size()（与 sdl_event 的 init/saveRaw 同一事实来源）
            if _evBufA == null { _evBufA = ffi.malloc(SDL_Event.size()) }
            if _evBufB == null { _evBufB = ffi.malloc(SDL_Event.size()) }
            Ptr[u8] _motionBuf = _evBufA
            Ptr[u8] _deferredBuf = _evBufB
            bool _hasDeferred = false
            int _profBody0 = core.getPerfCounter()
            int _profEv0 = core.getPerfCounter()
            while ev.has {
                if _trOn { _trEvs = _trEvs + 1 }
                // ★ 2026-11-21：每个事件开头清"取消/返回键已消费"标记（见 sdl_event 的说明）——
                //   只在**同一个事件**内有效，绝不跨事件残留 ✓
                event.clearDismissHandled()
                // 鼠标移动(motion)不强制整窗重绘：光标为 OS 级、hover 变化已由控件
                // markFrameRedraw() 请求重绘；否则每次移动都触发全窗清屏+全控件重绘，
                // 偶发呈现异常会让控件（如表）整块露出背景而“闪一下”。
                // 滚轮/点击/resize/键盘等非 motion 事件仍强制重绘。
                if not ev.isMouseMotion() { _inputEvent = true }   // wid 还没取（下面 1798 才取）⇒ 那里再记归属

                // ★★ 2026-11-21：**Android 生命周期 / GPU 上下文重置**（桌面永不出现 ⇒ 零影响）
                //   ① 切后台 ⇒ 停止出帧（surface 已销毁，present 无意义且白烧电）
                //   ② 回前台 ⇒ 强画一帧（后台期间画面/动画都停在旧状态，不重画就是"回来一片残影"✗）
                //   ③ 渲染设备重置 ⇒ 离屏纹理句柄全部失效，必须**重建**而不是只重画
                //   ⚠ 一律 `ev.poll(); continue`：这些事件没有 windowID，掉进下面的普通派发
                //     只会被当成"未知事件"白跑一遍控件树（还会把 wid 记成 0 ⇒ 全脏帧 ✓）
                if ev.isEnteredBackground() {
                    _backgrounded = true
                    ev.poll(); continue
                }
                if ev.isEnteredForeground() {
                    _backgrounded = false
                    _needRedraw = true
                    _pendingFull = true        // 强制一次全窗口整画（后台期间可能错过了 resize ✓）
                    core.markFrameRedraw()
                    ev.poll(); continue
                }
                if ev.isRenderDeviceReset() {
                    _resetOffscreen()
                    _needRedraw = true
                    _pendingFull = true
                    ev.poll(); continue
                }
                // 渲染目标内容被清空：纹理**还在**，只需重画（不必重建 ⇒ 别调 _resetOffscreen 白重建一轮）
                if ev.isRenderTargetsReset() {
                    _needRedraw = true
                    _pendingFull = true
                    ev.poll(); continue
                }

                if ev.isQuit() {
                    for _runWids.len() to i {
                        // 根销毁：退出前先释放所有控件资源（字体等），沿父子树递归清理
                        _destroyEntry(i)
                    }
                    ev.uninit()
                    if _windowCount <= 0 { core.quit() }
                    _runLoopActive = false
                    return true          // 本调用真的跑完了整个循环 ✓
                }
                int wid = ev.windowID()
                // ★ 2026-11-21：**虚拟子窗口的事件改投**（它没有 OS 窗口 ⇒ SDL 事件带的是父窗口 ID）
                //   ① 命中哪个子窗口 → 把 wid 换成它的合成 ID（模态时 = 栈顶那个，语义自动正确 ✓）
                //   ② 坐标换成**子窗口自己的局部坐标**（-= 记录左上角，/= 缩放）⇒ 控件命中判断零改动 ✓
                //   ★ 密度：SDL 给的事件坐标是**物理像素** ⇒ 先除密度变成父窗口的逻辑坐标
                //     （桌面 _dens=1.0 ⇒ `(v-0)/1` 恒等，行为零变化 ✓）
                float _pd = _densOfWid(wid)
                event.setGeometryOffset(0.0, 0.0, _pd)
                int _vwHit = _virtHitTarget(wid, ev)
                if _vwHit > 0 {
                    int _vj = _virtIndex(_vwHit)
                    if _vj >= 0 {
                        // 合成偏移/缩放都是**逻辑坐标** ⇒ 反解要带上密度：
                        //   子局部 = (物理px/密度 - x) / s = (px - x*密度) / (s*密度) ✓
                        event.setGeometryOffset(
                            _virtXOf(_vj) * _pd, _virtYOf(_vj) * _pd, _virtSOf(_vj) * _pd)
                        wid = _vwHit
                    }
                }
                // ★ 2026-11-17：非 motion 事件 ⇒ 记"需要重绘"，并把**归属窗口**记下来
                //   （原来只置 `_hadEvent`，渲染时一律 `_fullFrame = true` ⇒ 一个窗口的点击
                //    会把所有窗口整窗重画，浮窗/对话框跟着白烧 CPU ✗）
                if not ev.isMouseMotion() { _hadEvent = true; _hadEventWid = wid }
                // 模态：仅栈顶窗口接收事件，其余全部跳过（含主窗口 + 下层模态）
                // 注意：必须继续 poll 前进事件队列，否则 ev.has 恒为 true 导致 while 死循环（窗口假死）
                if _isModal() and wid != _modalTop() {
                    // 用户点击了非模态窗口（如父窗口标题栏），OS 已把父窗口提到前面；
                    // 立刻把模态窗口 raise 回来，防止对话框被遮挡
                    if ev.isWindowFocusGained() or ev.isMouseButtonDown() {
                        raiseWindow(_modalTop())
                    }
                    ev.poll(); continue
                }
                // ★ Motion 事件合并：当前事件是鼠标移动时，连续 poll 直到找到最后一个
                //   同窗口 motion 事件，中间的全部丢弃。若遇到非 motion 事件则暂存，
                //   处理完 motion 后再处理。这样无论队列堆积多少 motion，每帧只处理 1 个。
                if ev.isMouseMotion() and not _hasDeferred {
                    ev.saveRaw(_motionBuf)
                    bool _coalescing = true
                    while _coalescing {
                        ev.poll()
                        if not ev.has {
                            ev.restoreRaw(_motionBuf)
                            ev.has = true
                            _coalescing = false
                        } else if ev.isMouseMotion() and ev.windowID() == wid {
                            ev.saveRaw(_motionBuf)   // 更新为更新的 motion
                        } else {
                            // 遇到非 motion 事件（或其它窗口的 motion）：暂存，先处理 motion
                            ev.saveRaw(_deferredBuf)
                            ev.restoreRaw(_motionBuf)
                            ev.has = true
                            _hasDeferred = true
                            _coalescing = false
                        }
                    }
                }
                for _runWids.len() to i {
                    if _runWids[i] == wid {
                        // ★ 快捷键优先处理：键按下事件先尝试匹配已注册快捷键，
                        //   匹配成功则跳过用户事件处理器（避免重复处理）；
                        //   守卫回调返回 true 时阻止快捷键（如 Edit/Table 编辑中）
                        bool _shortcutHandled = false
                        if ev.isKeyDown() { _shortcutHandled = _tryShortcut(i, ev) }
                        // ★ 2026-10-13：快捷键没接住的键，先给**焦点链**（Tab / Shift+Tab / Enter / Space ✓）
                        //   放在"广播给所有控件"**之前** ⇒ 换焦点这类键不会漏给每个控件各处理一遍 ✓
                        if not _shortcutHandled { _shortcutHandled = _focusKey(ev) }
                        // ★ 关闭拦截：处理器可在 ev.isWindowClose() 里调用 win.cancelClose() ⇒ 不销毁窗口
                        //   （"关闭到托盘"✓）。标记每次处理前清零 ⇒ 只对本次事件有效、无跨事件残留 ✓
                        _closeCanceled = false
                        bool _keepOpen = false
                        if not _shortcutHandled { _keepOpen = _runEvts[i](ev) }
                        if not _shortcutHandled and (not _keepOpen or (ev.isWindowClose() and not _closeCanceled)) {
                            // 模态窗口关闭：弹出栈并恢复焦点到父窗口
                            int _restoreWid = -1
                            if _isModal() and _runWids[i] == _modalTop() {
                                _restoreWid = _modalParent(_runWids[i])
                                _modalStack.pop()
                                // ★ 模态对话框关闭时清除 tooltip 状态：
                                //   对话框打开期间主窗口不接收 motion 事件，tipEndMotion 无法触发清除，
                                //   导致对话框前的 tip 状态残留（_tipText 非空、_tipVisible 可能已为 true）。
                                //   关闭后残留的 tip 会自动弹出并跟随鼠标，必须在此主动清除。
                                tip.tipClear()
                            }
                            // 根销毁：关闭窗口前先释放所有控件资源（字体等），沿父子树递归清理
                            _destroyEntry(i)
                            core.dropPopupCaptures(_runWids[i])   // 窗口没了 ⇒ 它那块弹层捕获区也清掉 ✓
                            _dropOverlayState(_runWids[i])        // 浮层/点外部状态同样是按窗口的 ✓
                            // ★ 2026-11-08：窗口自己的定时器一并注销（必须在 remove 之前取 wid）
                            //   不注销会一直跑 ⇒ 每拍 requestRedraw ⇒ 空闲 CPU 白烧
                            timer.unregisterByWindow(_runWids[i])
                            _runWids.remove(i);  _runHnds.remove(i)
                            _runRens.remove(i); _runEvts.remove(i)
                            _runRends.remove(i); _runWidgets.remove(i); _runWidgetZ.remove(i); _runMenus.remove(i); _runRoots.remove(i); _runRootX.remove(i); _runRootY.remove(i); _runW.remove(i); _runH.remove(i)
                            _runCtxBar.remove(i); _runCtxIdx.remove(i)
                            _runDialogHidden.remove(i); _runTransparent.remove(i)
                            _runOverlays.remove(i)
                            // ★ 虚拟子窗口状态（必须与 _runWids 对齐 ✓）
                            _runVOn.remove(i); _runVParent.remove(i); _runVTexD.remove(i)
                            _runVX.remove(i); _runVY.remove(i); _runVS.remove(i); _runVDrawn.remove(i)
                            _runDens.remove(i)          // ★ 密度表必须同步移除（否则下标整体错位 ✗）
                            _runShortcuts.remove(i); _runShortcutGuards.remove(i)
                            // ★ 2026-11-18：窗口级动画限速的两张表也要跟着删（下标必须对齐）
                            if i < _winGap.len() { _winGap.remove(i) }
                            if i < _lastDrawAt.len() { _lastDrawAt.remove(i) }
                            // 恢复焦点到父窗口（非模态关闭时 _restoreWid 为 -1，跳过）
                            if _restoreWid >= 0 { raiseWindow(_restoreWid) }
                            break
                        }
                    }
                }
                // 自动处理该窗口的所有控件事件
                // 鼠标运动事件：处理前重置 tip 上报标记，处理后若无人上报则清除
                // （解决多控件处理顺序导致的 tipClear 覆盖 tipReport 问题）
                bool _isMotion = ev.isMouseMotion()
                if _isMotion {
                    // ★ 2026-10-13（光标帧语义）：**窗口**统一登记"本帧有鼠标移动" ⇒ 帧末 `applyFrameCursor` 才重算 ✓
                    //   以前只靠控件各自调 `markFrameMotion/Redraw`，而 `markFrameRedraw` 把
                    //   "要重绘"和"鼠标动过"混为一谈 ✗ ⇒ **按下 / 松开 / 键盘激活**这些帧
                    //   会被当成"要重算光标"、可那一刻没有任何控件请求 ⇒ 落到 DEFAULT 兜底
                    //   ⇒ **光标被打回箭头**（"移到按钮上是手型、一按下去变普通形状" ✓）。
                    //   现在判据唯一：**只有真的收到 motion 事件**才算"鼠标位置变了" ✓
                    core.markFrameMotion()
                    tip.tipSetWindow(wid); tip.tipBeginMotion()
                }
                // ★ 派发上下文 = 本窗口 ⇒ 弹层捕获区按窗口判定（见 sdl_core 的说明 ✓）
                core.setDispatchWindow(wid)
                for _runWids.len() to j {
                    if _runWids[j] == wid {
                        // 先处理根布局控件（背景层），再处理 _widgets（覆盖层如 MenuBar）
                        var rootWid = _runRoots[j]
                        // ★ 安全网：每帧向根控件下发窗口句柄，确保所有子控件（含动态添加的、
                        //   或因创建顺序/容器类型遗漏而未收到句柄的）都能拿到 _hwnd。
                        //   _bind_window 是幂等操作（重复设置同一句柄无副作用），开销可忽略。
                        if rootWid is Widget { _refreshWindowHandle(rootWid, _runHnds[j], _runW[j], _runH[j]) }
                        // ★ 模态浮层（2026-10-29）：设了 `set_modal(w)` 且鼠标落在它矩形内 ⇒
                        //   **只**把事件给它，跳过根布局与其它覆盖层 ✓
                        //   为什么需要：窗口原本把同一事件广播给所有控件，浮层展开时点它上面的按钮，
                        //   底下的 Table/Button 也会同时收到（穿透 ✗）；`inPopupCapture` 那套是
                        //   "控件各自忽略"，会把**浮层自己内部**的控件也一起挡掉 ✗ ⇒ 只能在派发处拦。
                        bool modalHit = false
                        // ⚠ 必须同时满足 `_moWid == wid`：矩形是**设它的那个窗口**的客户区坐标，
                        //   拿它去量别的窗口的事件就是"点哪儿都在外面"（2026-11-13 修 ✓ 见顶部注释）
                        if _moWidget != null and _moWid == wid
                            and (ev.isMouseMotion() or ev.isMouseButtonDown()
                                 or ev.isMouseButtonUp() or ev.isMouseWheel()) {
                            var[float, float](mmx, mmy) = ev.mousePos()
                            if ev.isMouseWheel() { mmx = ev.wheelMouseX(); mmy = ev.wheelMouseY() }
                            // 矩形用 float 判（接口上调不了 get_x）；派发走 `?.process` 动态派发 ✓
                            if mmx >= _moX and mmx <= _moX + _moW
                                and mmy >= _moY and mmy <= _moY + _moH {
                                modalHit = true
                                _moWidget?.process(ev)
                            }
                        }
                        // ★ 点外部（2026-10-29）：左键按下且落在矩形外 ⇒ 回调一次，并**吞掉这一下**
                        //   为什么吞：否则"点列表按钮收起浮层"会变成「先收起、按钮再 toggle 打开」
                        //   ⇒ 看起来点了没反应（关了又开 ✗）
                        //   ⚠ 同样必须 `_outWid == wid`（2026-11-13 修）：否则在**另一个窗口**
                        //     （如 msgBox 对话框）上点按钮，会被主窗口的矩形判成"点了外面" ⇒
                        //     先关掉浮层、这一下还被吞掉，按钮收不到点击（Aria 实测 ✗）
                        bool swallowed = false
                        if _outArmed and _outWid == wid
                            and ev.isMouseButtonDown() and ev.mouseButton() == 1 {
                            var[float, float](ox, oy) = ev.mousePos()
                            if ox < _outX or ox > _outX + _outW
                                or oy < _outY or oy > _outY + _outH {
                                swallowed = true
                                _outArmed = false          // 先撤标记，避免回调里重入
                                var ocb = _outCb
                                if ocb != null { ocb() }
                            }
                        }
                        if not modalHit and not swallowed {
                            rootWid?.process(ev)
                            var ws = _runWidgets[j]
                            for ws to w { w.process(ev) }
                        }
                        // ★ 2026-10-13：**失焦即收起"浮层"**（右键上下文菜单 + 顶部菜单下拉）——
                        //   这些浮层不是由宿主控件画的，而是按 `isOpen()` **第二遍统一画** ✗（不看宿主在不在 ✓）
                        //   ⇒ 不收拾的话，Alt+Tab 切走后菜单会**留在屏幕上**，而且点不动也关不掉 ✗✗
                        //   （同源问题在 `TabControl` 切页时已修过一次 ✓ 见其 closePopups ✓）
                        //   ⚠ 控件自己的弹层不在这里：ComboBox/Edit 各自在 process 里处理 ✓；PopMenu 是独立窗口 ✓
                        if ev.isWindowFocusLost() {
                            menu.closeContextMenus(_runHnds[j])
                            var bars = _runMenus[j]
                            for bars to b { b.close() }     // `for arr to x` 里 x **就是元素** ✓（仓库惯例 ✓）
                        }
                        break
                    }
                }
                if _isMotion { tip.tipEndMotion() }
                // 窗口级右击上下文菜单（统一在底层接管，而非示例 onEvent）：
                // 先让命中控件自行处理右键（Edit/ComboBox 等会弹出自身菜单并占住弹层捕获区），
                // 若没有任何控件占用弹层，才弹出窗口级菜单，避免「窗口菜单盖住控件菜单」。
                if ev.isMouseButtonDown() and ev.mouseButton() == 3 {
                    for _runWids.len() to j {
                        if _runWids[j] == wid {
                            var[float, float](_cmx, _cmy) = ev.mousePos()
                            if _runCtxIdx[j] >= 0 and not core.inPopupCapture(_cmx, _cmy) {
                                _runCtxBar[j].openContext(_runCtxIdx[j], _cmx, _cmy)
                            }
                            break
                        }
                    }
                }
                core.clearDispatchWindow()      // 派发上下文用完即撤（回到"无窗口"态 ✓）

                // ★★ 2026-11-21：Android 返回键的**分层返回**兜底。
                //   上面那一整段派发里，凡是真关掉了东西的控件都会调 `ev.consumeDismiss()`
                //   （下拉框 / 菜单 / 弹出菜单 / 表格编辑 / 模态对话框）⇒ 到这里标记为真，
                //   说明这个键已经被**最上层**用掉了，直接结束，不许再往上关 ✗
                //   没人用掉才往上升一层，顺序按 Android 惯例：
                //     ① 还有虚拟子窗口（非模态弹窗，如设置/关于）⇒ 关最上层那个
                //     ② 否则 ⇒ 请求关闭本窗口（与 requestClose 同一条路 ⇒ "关闭到托盘"照样生效 ✓）
                //   ⚠ 只在 isBackKey() 时执行：桌面 ESC 不走这里（ESC 在桌面的语义是"取消当前控件"，
                //     按一下 ESC 就把窗口关掉是灾难 ✗）
                if ev.isBackKey() and not event.dismissHandled() {
                    int _bkTop = _virtTopOf(wid)
                    if _bkTop > 0 {
                        _postClose(_bkTop)          // 关弹窗：下一轮 poll 走正常关闭流程（含栈弹出/焦点恢复 ✓）
                    } else {
                        _postClose(wid)
                    }
                }

                // 窗口缩放：重建 SSAA 离屏纹理 + 更新逻辑尺寸 + 驱动根布局跟随
                // ★ 不在此处理 WINDOW_MAXIMIZED/WINDOW_RESTORED 事件：这些事件触发时窗口可能尚在
                //   动画过程中，SDL_GetWindowSize 返回的是最终尺寸而非当前实际尺寸，此时重建 SSAA
                //   会导致纹理尺寸与窗口实际尺寸不匹配→缩小版。首次最大化的同步由 _sizeSyncRemaining
                //   在渲染阶段（窗口尺寸已稳定）可靠完成。
                if ev.isWindowResized() {
                    for _runWids.len() to k {
                        if _runWids[k] == wid {
                            SDL_Point pt = SDL_Point.malloc()
                            _lib.SDL_GetWindowSize(_runHnds[k], &pt.x, &pt.y)
                            // ★ 密度：物理像素 → 逻辑像素（下游 resizeSSAA/布局/夹紧全按逻辑 ✓）
                            float _ds2 = if k < _runDens.len() then _runDens[k] else 1.0
                            if _ds2 > 1.0 {
                                pt.x = maths.roundi(_float(pt.x) / _ds2)
                                pt.y = maths.roundi(_float(pt.y) / _ds2)
                                if pt.x < 1 { pt.x = 1 }
                                if pt.y < 1 { pt.y = 1 }
                            }
                            _runRens[k].resizeSSAA(pt.x, pt.y)
                            // ★ 更新逻辑尺寸（背景填充 + Tooltip 夹紧依赖此值）
                            _runW[k] = pt.x; _runH[k] = pt.y
                            // 驱动根布局控件跟随窗口大小（带偏移）
                            var rootWid = _runRoots[k]
                            rootWid?.set_pos(_runRootX[k], _runRootY[k])
                            rootWid?.set_size(_float(pt.x) - _runRootX[k], _float(pt.y) - _runRootY[k])
                            // ★ 自动同步 MenuBar 尺寸到满宽（此前示例需手动 _updateMenuBar）
                            float _tbH2 = _findTitleBarHeight(_runWidgets[k])
                            var menus = _runMenus[k]
                            for menus.len() to m {
                                MenuBar bar = menus[m]
                                bar.set_pos(0, _tbH2)
                                bar.set_size(_float(pt.x), bar.get_h())
                                bar.setWindowSize(pt.x, pt.y)
                            }
                            // ★ 自动同步窗口尺寸到 Table/TreeView/Splitter（供内部右键菜单边界夹紧）
                            var widgets = _runWidgets[k]
                            for widgets.len() to w {
                                lay.passWindowResize(widgets[w], _runHnds[k], pt.x, pt.y)   // 类型表见 sdl_layout ✓
                            }
                            // 根控件也要收 resize（根可能是 Splitter ⇒ 不在 `_widgets` 顶层 ✓；类型判断见 sdl_layout ✓）
                            var rootWid2 = _runRoots[k]
                            if rootWid2 != null { lay.passWindowResize(rootWid2, _runHnds[k], pt.x, pt.y) }
                            pt.free()
                            break
                        }
                    }
                }
                // 获取队列中下一个事件（或恢复合并期间暂存的非 motion 事件）
                if _hasDeferred {
                    ev.restoreRaw(_deferredBuf)
                    ev.has = true
                    _hasDeferred = false
                } else {
                    ev.poll()
                }
            }
            // 缓冲常驻（见上面的 `_evBufA/_evBufB`），这里不再 free ✓
            int _profCur0 = core.getPerfCounter()
            if _trOn { _trEvUs = _trEvUs + _profAdd(_profEv0) }   // [诊断] 本帧事件轮询+派发耗时
            core.applyFrameCursor()    // 帧末：按本帧各控件的请求统一设置一次光标（避免互相覆盖）
            int _profCursorTmp = _profAdd(_profCur0)
            if _runWids.len() == 0 {
                ev.uninit()
                if _windowCount <= 0 { core.quit() }
                _runLoopActive = false
                return true          // 窗口全关，循环结束 ✓
            }
            // 驱动所有定时器（在事件轮询外，确保 idle 期间也能触发定时器与自动重绘）
            int _profTmr0 = core.getPerfCounter()
            timer.tickAllTimers()
            int _profTimerTmp = _profAdd(_profTmr0)
            if _trOn { _trTimerUs = _trTimerUs + _profTimerTmp }   // [诊断] 定时器回调（含频谱 FFT）每秒总耗时
            // ★ 程序化退出请求（requestExit()：托盘菜单/定时器等非 onEvent 上下文发起）：
            //   与 SDL_QUIT 事件同款收尾（控件 dispose → 渲染器/窗口销毁 → 事件反初始化）
            if _exitRequested {
                _exitRequested = false
                for _runWids.len() to _qi {
                    _destroyEntry(_qi)
                }
                // 清空注册表：窗口都已销毁 ⇒ 不能留下失效句柄（run() 返回后应用可能再次 run() ✓）
                _runWids = []; _runHnds = []; _runRens = []; _runEvts = []; _runRends = []
                _runWidgets = []; _runWidgetZ = []; _runMenus = []; _runCtxBar = []; _runCtxIdx = []
                _runRoots = []; _runRootX = []; _runRootY = []; _runW = []; _runH = []
                _runDialogHidden = []; _runTransparent = []; _runOverlays = []
                _runVOn = []; _runVParent = []; _runVTexD = []          // ★ 虚拟子窗口状态
                _runVX = []; _runVY = []; _runVS = []; _runVDrawn = []   //（与 _runWids 同生共死 ✓）
                _runDens = []                                              // ★ 密度表（同上 ✓）
                _runShortcuts = []; _runShortcutGuards = []
                _winGap = []; _lastDrawAt = []     // ★ 窗口级动画限速表（2026-11-18）
                // 浮层/点外部状态也归零（否则下次 run() 会带着上一次窗口的矩形 ✓）
                _moWid = -1; _moWidget = null; _moW = 0.0; _moH = 0.0
                _outWid = -1; _outCb = null; _outArmed = false; _outW = 0.0; _outH = 0.0
                ev.uninit()
                if _windowCount <= 0 { core.quit() }
                _runLoopActive = false
                return true          // 退出清理完成，循环结束 ✓
            }
            // 事件驱动重绘：非 motion 事件/动画请求/tooltip就绪时才渲染，空闲时跳过以降低 CPU 占用。
            // 注意：纯鼠标移动(motion)不再触发整窗重绘——其光标为 OS 级、hover 变化由控件
            // markFrameRedraw() 单独请求；否则每次移动都整窗清屏+重绘会偶发“闪一下”。
            // ★ Tooltip 优化：旧方案 tipWaiting() 在等待延迟期间恒返回 true，导致每帧 60fps
            //   全量重绘（即使画面无任何变化）。新方案仅在延迟到期时（tipRemainingMs()==0）
            //   触发一次重绘以显示 tooltip，等待期间通过 poll 超时挂起，CPU 降至接近 0。
            // [诊断] 本帧"事件轮询 + 派发"耗时
            _profLoopFrames = _profLoopFrames + 1
            if _benchFrames > 0 {
                _profEvUs = _profEvUs + _profAdd(_profEv0)
                _profCursorUs = _profCursorUs + _profCursorTmp
                _profTimerUs = _profTimerUs + _profTimerTmp
            }
            if _hadEvent { _needRedraw = true }
            // ★ 2026-11-17（F4）：`_fullFrame` 决定这一帧是"所有窗口都画"还是"只画被点名的窗口"。
            //   初值取 `_needRedraw`（之前就欠一帧的原因：首帧、渲染中 requestRedraw）⇒ 全脏；
            //   只有 `requestRedrawWindow(wid)` 这一条**不**置全脏 —— 这正是浮窗不拖累主窗口的关键。
            // ⚠ 初值**不能**取 `_needRedraw`：`_needRedraw` 只表示"欠一帧"，可能只是**某个窗口**
            //   的请求（per-window）或因节流攒下来的 carry ⇒ 一律当"全脏"就把分窗收益漏回去了 ✗
            //   真正的兜底在下面：欠一帧但**没有任何窗口被点名**时才全画（首帧 / 渲染中又被请求）✓
            bool _fullFrame = false
            // ★ 2026-11-17：事件触发的重绘**按事件所属窗口**归属（不再一律全脏）。
            //   · 有归属（`_hadEventWid > 0`）⇒ 只脏那个窗口；
            //   · 无归属（SDL 全局事件 / `windowID()==0`）或 `LENO_GLOBAL_MARK=1` ⇒ 全脏（保守 / 逃生阀）。
            if _hadEvent {
                if _hadEventWid > 0 and not core.globalMarkForced() {
                    core.requestRedrawWindow(_hadEventWid)
                } else {
                    _fullFrame = true
                }
            }
            // ⚠ 这里**只查看、不消费**：消费放到"确认真要出帧"之后（见下面的渲染分支）——
            //   提前 consume 会被帧率节流吞掉（标志清了、帧没画 ⇒ 那次重绘永久丢失 ✗ 实测踩到）
            if _pendingFull or core.hasGlobalRedraw() { _needRedraw = true; _fullFrame = true }
            if core.hasWindowRedraw() { _needRedraw = true }
            if tip.tipRemainingMs() == 0 { _needRedraw = true; _fullFrame = true }
            // ★ Toast 动画期（淡入/淡出）必须连续出帧，否则会"卡两下再出现" ✗
            //   停留期不在这里——交给上面的 poll 超时按时刻唤醒 ✓
            if tst.toastAnimating() { _needRedraw = true; _fullFrame = true }
            if _sizeSyncRemaining > 0 { _fullFrame = true }
            // 兜底：欠一帧，但**没有任何窗口被点名**（首帧 / 渲染过程中又请求 / 节流攒下的 carry）
            //   ⇒ 全画一次。否则"只画被点名的窗口"会把首帧和这类请求整个漏掉 ✗
            if _needRedraw and not _fullFrame and not core.hasWindowRedraw() {
                _fullFrame = true
            }
            // ★ 2026-11-21：后台时**不出帧**（Android surface 已销毁）。
            //   `_needRedraw` 保留不清 ⇒ 回前台那一拍自然会画（不必额外再置一次 ✓）
            if _needRedraw and not _backgrounded {
                int now = core.getTicks()
                // ★ 输入类事件（滚轮/点击/键盘/resize）**不等节流**，立刻出一帧：
                //   节流本来是为了压制动画/motion 的 CPU 占用，但把它套在用户输入上，
                //   就会让滚动/点击"攒着一起动"✗ ⇒ 输入路径放行，其余照旧 ✓
                if _trOn and not _inputEvent and now - _lastRenderTicks < _throttleMs { _trSkip = _trSkip + 1 }
                if _inputEvent or now - _lastRenderTicks >= _throttleMs {   // 节流：距上次渲染不足节流间隔则跳过
                    _lastRenderTicks = now
                    _needRedraw = false   // 清除标记；动画控件在 render 时可调用 requestRedraw() 请求下一帧
                    // ★ 2026-11-17：**确认真要出这一帧了**才消费"全脏"标志 ——
                    //   全脏帧把两个窗口都画了，窗口级标记也随之作废（见 clearWindowRedraws 的注释 ✓）
                    if _fullFrame {
                        _pendingFull = false
                        core.consumeRedrawRequest()
                        core.clearWindowRedraws()
                    }
                    // ★ 安全网尺寸同步：SDL_SyncWindow 已在 registerOnly 中阻塞等待 OS 完成最大化，
                    //   正常情况下首帧 getSize() 已返回正确尺寸。此多帧检查仅作为极端时序下的
                    //   兜底（如某些 Windows 版本 SyncWindow 返回后仍有微小延迟），检测到变化
                    //   立即重建 SSAA 纹理并同步根布局。未变化时仅多一次 SDL_GetWindowSize 调用。
                    if _sizeSyncRemaining > 0 {
                        _sizeSyncRemaining = _sizeSyncRemaining - 1
                        for _runWids.len() to fi {
                            if _virtOn(fi) { continue }   // 同上：虚拟子窗口尺寸与父窗口无关 ✓
                            SDL_Point fpt = SDL_Point.malloc()
                            _lib.SDL_GetWindowSize(_runHnds[fi], &fpt.x, &fpt.y)
                            // ★ 密度：物理像素 → 逻辑像素（与上面两处同规则 ✓）
                            float _ds3 = if fi < _runDens.len() then _runDens[fi] else 1.0
                            if _ds3 > 1.0 {
                                fpt.x = maths.roundi(_float(fpt.x) / _ds3)
                                fpt.y = maths.roundi(_float(fpt.y) / _ds3)
                                if fpt.x < 1 { fpt.x = 1 }
                                if fpt.y < 1 { fpt.y = 1 }
                            }
                            if fpt.x != _runW[fi] or fpt.y != _runH[fi] {
                                _runRens[fi].resizeSSAA(fpt.x, fpt.y)
                                _runW[fi] = fpt.x; _runH[fi] = fpt.y
                                var fRoot = _runRoots[fi]
                                fRoot?.set_pos(_runRootX[fi], _runRootY[fi])
                                fRoot?.set_size(_float(fpt.x) - _runRootX[fi], _float(fpt.y) - _runRootY[fi])
                                var fMenus = _runMenus[fi]
                                float _tbH3 = _findTitleBarHeight(_runWidgets[fi])
                                for fMenus.len() to fmi {
                                    MenuBar fbar = fMenus[fmi]
                                    fbar.set_pos(0, _tbH3)
                                    fbar.set_size(_float(fpt.x), fbar.get_h())
                                    fbar.setWindowSize(fpt.x, fpt.y)
                                }
                                var fWidgets = _runWidgets[fi]
                                for fWidgets.len() to fwi {
                                    lay.passWindowResize(fWidgets[fwi], _runHnds[fi], fpt.x, fpt.y)   // 类型表见 sdl_layout ✓
                                }
                                var frw = fRoot
                                if frw != null { lay.passWindowResize(frw, _runHnds[fi], fpt.x, fpt.y) }   // 类型判断见 sdl_layout ✓
                            }
                            fpt.free()
                        }
                    }
                    int _gapWaitMs = 0
                    for _runWids.len() to i {
                    // ★ 2026-11-21：虚拟子窗口**不自己出帧** —— 它没有窗口可 present，
                    //   由父窗口那一帧在 `_renderVirtChildren` 里合成（顺序也要靠这个保证 ✓）
                    if _virtOn(i) { continue }
                    // ★ 2026-11-17（F4）：这一帧只有"某个窗口欠一帧"时，其余窗口**整个跳过**
                    //   （不清屏、不 relayout、不 present）—— 浮窗的 20fps 不再拖着主窗口重绘。
                    //   `_fullFrame` 为真时照旧全画：事件、全局 requestRedraw、toast/tooltip、
                    //   尺寸同步这些路径都可能是"任何窗口都受影响"的 ✓
                    if not _fullFrame {
                        // ★ 2026-11-21：**虚拟子窗口欠帧 ⇒ 父窗口这一帧也要画**
                        //   （子窗口没有自己的 present；它只在父窗口的帧里合成 ⇒ 不把欠帧传上来
                        //     就会出现"弹窗内部该刷新但画面不动"✗）
                        bool _virtDirty = false
                        for _runWids.len() to cj {
                            if _virtOn(cj) and _virtParentOf(cj) == _runWids[i]
                                and core.hasWindowRedrawFor(_runWids[cj]) { _virtDirty = true }
                        }
                        // ★ 2026-11-18：先**看**请求、再判窗口级最小间隔、真画了才消费 ✓
                        //   （原来直接 takeWindowRedraw ⇒ 被节流挡下时请求已经没了，整页 60fps）
                        if not core.hasWindowRedrawFor(_runWids[i]) and not _virtDirty { continue }
                        while _winGap.len() <= i { _winGap.add(0) }
                        while _lastDrawAt.len() <= i { _lastDrawAt.add(0) }
                        int _gapMs = _winGap[i]
                        // 用户输入（点击/滚轮/键盘）**不受窗口级限速约束**：拖动/滚动要跟手 ✓
                        // 基准模式也绕过：`LENO_SDL_FRAMES` 要做**确定性**的每帧渲染，被限速会失真 ✓
                        if _inputEvent or _benchFrames > 0 { _gapMs = 0 }
                        if _gapMs > 0 {
                            int _waitMs = _gapMs - (core.getTicks() - _lastDrawAt[i])
                            if _waitMs > 0 {
                                if _trOn { _trGapSkip = _trGapSkip + 1 }
                                // 还没到点：请求保留、下一轮再看；把"还要等多久"记下来统一补睡
                                if _waitMs > _gapWaitMs { _gapWaitMs = _waitMs }
                                continue
                            }
                        }
                        core.dropWindowRedraw(_runWids[i])
                    }
                    if _skipRender { continue }
                    // 每帧清屏：用 fillRect 打满整个窗口代替 SDL_RenderClear
                    // SDL_RenderClear 在 Win/D3D 后端可能不走 back buffer 缓冲，导致短暂黑闪
                    // 透明窗口跳过背景填充，保留 alpha=0 区域透明
                    // 使用主题背景色而非硬编码黑色，消除首帧黑闪
                    var ren = _runRens[i]
                    // [诊断] LENO_FRAME_TRACE：本窗口这一帧的起点（关闭时取 0，不算）
                    int _tW0 = if _trOn then core.getPerfCounter() else 0
                    // ★ SSAA：每帧渲染前重新设置渲染目标到离屏高分辨率纹理 + 缩放
                    // present() 每帧执行后会重置渲染目标为窗口、缩放为 1.0，
                    // 必须在此切回 SSAA 纹理，否则后续 fillRect/控件绘制全部直接画到窗口、SSAA 失效
                    int _profB0 = core.getPerfCounter()
                    ren.beginFrame()
                    core.setFrameGap(0)      // ★ 每次渲染前重置：本帧没人调 setFrameGap ⇒ 该窗口恢复不限速
                    if not _runTransparent[i] {
                        Theme th = theme.getTheme()
                        ren.setColor(th.bg)
                        ren.fillRect(0, 0, _float(_runW[i]), _float(_runH[i]))
                    }
                    if _benchFrames > 0 { _profBeginUs = _profBeginUs + _profAdd(_profB0) }
                    int _profC0 = core.getPerfCounter()
                    try {
                        _runRends[i](_runRens[i])
                    } catch e {
                        print("[错误] 渲染异常: " + e)
                        // 异常导致事件循环中断，手动执行清理（与 isQuit 路径一致）
                        for _runWids.len() to j {
                            _destroyEntry(j)
                        }
                        ev.uninit()
                        if _windowCount <= 0 { core.quit() }
                        _runLoopActive = false
                        return true          // 全部窗口销毁，循环结束 ✓
                    }
                    // [诊断] 应用自己的 render 回调（背景/自绘叠加层）耗时
                    if _benchFrames > 0 {
                        _profCbUs = _profCbUs + _int(_float(core.getPerfCounter() - _profC0) * 1000000.0
                                                     / _float(core.getPerfFrequency()))
                    }
                    // [诊断] 本窗口"控件树绘制"耗时（present 之前那段）；基准模式下打印均值
                    int _profT0 = core.getPerfCounter()
                    // 控件树 + 弹层 + toast/tip/叠加层（★ 2026-11-21 抽成方法：虚拟子窗口复用同一套）
                    _drawTree(i, ren, widgetOpac)
                    // ★ 2026-11-18：收集本帧控件声明的"最小出帧间隔"（见 sdl_core.setFrameGap）
                    //   放在这里（控件都画完）⇒ 下一帧就用它给这个窗口限速 ✓
                    while _winGap.len() <= i { _winGap.add(0) }
                    _winGap[i] = core.frameGap()
                    // [诊断] present 之前的"控件树绘制"耗时（含 toast/tooltip/叠加层）
                    //   只在基准模式累计 ⇒ 正常跑图零开销（两个整数加法都不做 ✓）
                    if _benchFrames > 0 {
                        _profDrawUs = _profDrawUs + _int(_float(core.getPerfCounter() - _profT0) * 1000000.0
                                                         / _float(core.getPerfFrequency()))
                        _profDrawFrames = _profDrawFrames + 1
                    }
                    int _profP0 = core.getPerfCounter()
                    _runRens[i].present()
                    if _benchFrames > 0 {
                        _profPresentUs = _profPresentUs + _int(_float(core.getPerfCounter() - _profP0) * 1000000.0
                                                               / _float(core.getPerfFrequency()))
                    }
                    _frameTotal = _frameTotal + 1      // ★ 诊断：累计渲染帧数（供 frameTotal() 查）
                    while _lastDrawAt.len() <= i { _lastDrawAt.add(0) }
                    _lastDrawAt[i] = core.getTicks()   // ★ 窗口级最小出帧间隔的起点（2026-11-18）
                    // [诊断] LENO_FRAME_TRACE：按窗口累计帧数与单帧耗时（微秒）
                    if _trOn {
                        while _trN.len() <= i { _trN.add(0); _trUs.add(0) }
                        _trN[i] = _trN[i] + 1
                        _trUs[i] = _trUs[i] + _profAdd(_tW0)
                        _trFrames = _trFrames + 1
                    }
                    // 对话框窗口：首帧渲染完后显示（避免创建时闪现默认背景）
                    // show 后立即 raise，确保对话框在主窗口前面
                    if _runDialogHidden[i] {
                        _lib.SDL_ShowWindow(_runHnds[i])
                        _lib.SDL_RaiseWindow(_runHnds[i])
                        _runDialogHidden[i] = false
                    }
                }
                    // ★★ 2026-11-18 修（这条把动画彻底掐死了）：**帧末绝对不能再 clearWindowRedraws()**。
                    //   全脏帧的窗口级标记已经在帧首清过了（见上面的 consumeRedrawRequest +
                    //   clearWindowRedraws）；帧末再清一次，会把**渲染过程中**新产生的请求一起抹掉 ——
                    //   而"动画续帧"（封面自转 / 波形）恰恰就是在 render 里请求下一帧的 ✗
                    //   实测症状：`gapCalls=5`（每秒只渲染 5 次，动画每帧都请求、每次都被清零）⇒
                    //   唱片停转、主窗只剩 200ms 一拍；一改成帧首清，25fps 立刻恢复 ✓
                    if _fullFrame { if _trOn { _trFull = _trFull + 1 } }
                    // ★ 2026-11-18：有窗口被"最小出帧间隔"挡住 ⇒ 在这里补睡到它到点。
                    //   为什么不 continue 空转：欠帧标记还在，下一轮会立刻又进来 ⇒ 上千次/秒 ✗
                    //   封顶 16ms（≈60fps 一帧）：再长的话输入延迟会超过一帧（宁可多醒两次）
                    if _gapWaitMs > 0 {
                        core.delay(if _gapWaitMs > 16 then 16 else _gapWaitMs)
                    }
                }              // 闭合节流 if
            }
            // 动画控件可能在 render 中调用了 requestRedraw() → 下一轮**必须全脏**出帧
            //   ⚠ 2026-11-17：不能只置 `_needRedraw` —— 那只表示"欠一帧"，下一轮会被
            //     per-window 请求或帧率节流"顶掉"，全脏的意图就丢了 ⇒ 记到 `_pendingFull`，
            //     等**真的画出全脏帧**再清（消费点见渲染分支 ✓）
            if core.consumeRedrawRequest() { _needRedraw = true; _pendingFull = true }

            // ---- [诊断] LENO_FRAME_TRACE：每秒一行（见循环前那段判读说明）----
            if _trOn {
                _trIters = _trIters + 1
                int _trNow = core.getTicks()
                if _trNow >= _trNext {
                    string _trS = "[FRAME] " + _str(_trNow / 1000) + "s iters=" + _str(_trIters)
                        + " frames=" + _str(_trFrames) + " full=" + _str(_trFull)
                    for _runWids.len() to _ti {
                        int _tn = 0
                        int _tu = 0
                        if _ti < _trN.len() { _tn = _trN[_ti]; _tu = _trUs[_ti] }
                        // 带上窗口尺寸 ⇒ 不用猜是哪个窗（主窗 1000x680 / 桌面歌词 920x96 / 对话框各异 ✓）
                        _trS = _trS + " | w" + _str(_runWids[_ti])
                            + "(" + _str(_runW[_ti]) + "x" + _str(_runH[_ti]) + ")"
                            + " n=" + _str(_tn)
                        if _tn > 0 { _trS = _trS + " " + _str(_tu / _tn) + "us/f" }
                        if _ti < _winGap.len() { _trS = _trS + " gap=" + _str(_winGap[_ti]) }
                    }
                    _trS = _trS + " | timer=" + _str(_trTimerUs / 1000) + "ms ev=" + _str(_trEvUs / 1000) + "ms"
                        + " evs=" + _str(_trEvs) + " spin=" + _str(_trSpin) + " skip=" + _str(_trSkip)
                        + " thr=" + _str(_throttleMs) + " maxfps=" + _str(maxFPS)
                        + " globReq=" + _str(core._dbgGlobalReqs - _trG0) + " winReq=" + _str(core._dbgWinReqs - _trW0c)
                        + " gapSkip=" + _str(_trGapSkip) + " gapCalls=" + _str(core._dbgGapCalls - _trGC0) + "\n"
                    _trLog = _trLog + _trS
                    try { files.write(_trPath, _trLog) } catch e { print("[FRAME] 写 trace 失败：" + _str(e) + "\n") }
                    print(_trS)
                    _trN = []; _trUs = []
                    _trIters = 0; _trFrames = 0; _trFull = 0; _trTimerUs = 0; _trEvUs = 0
                    _trEvs = 0; _trSpin = 0; _trSkip = 0; _trGapSkip = 0
                    _trG0 = core._dbgGlobalReqs; _trW0c = core._dbgWinReqs; _trGC0 = core._dbgGapCalls
                    _trNext = _trNow + 1000
                }
            }

            // ---- 确定性 GUI 基准：跑满 _benchFrames 帧后收尾 ----
            // 摘要里的 `sum`（批处理计数之和）是**负载一致性判据**：两次运行的 sum 相同
            // 才说明渲染工作量相同，此时比 us_per_frame 才有意义。
            if _benchFrames > 0 {
                // [诊断] 整个循环体的耗时（与 us_per_frame 对照，判断"未计入"的部分在体内还是体外）
                _profBodyUs = _profBodyUs + _profAdd(_profBody0)
                _benchDone = _benchDone + 1
                if _benchDone >= _benchFrames {
                    int _bus = _int(_float(core.getPerfCounter() - _benchT0) * 1000000.0
                                    / _float(core.getPerfFrequency()))
                    int _bfill = renderer.getBatchFillBatched()
                    int _bline = renderer.getBatchLineBatched()
                    int _bout  = renderer.getBatchOutBatched()
                    int _bsum  = _bfill + _bline + _bout
                    print("[SDL-BENCH] frames=" + _benchDone
                          + " total_us=" + _bus
                          + " us_per_frame=" + _int(_float(_bus) / _float(_benchDone))
                          + " fill=" + _bfill + " line=" + _bline + " out=" + _bout
                          + " sum=" + _bsum
                          // [诊断] 每帧里"控件树绘制"占多少微秒（其余 = 清屏/提交/事件/present）
                          + " draw_us_avg=" + _int(_float(_profDrawUs) / _float(_profDrawFrames))
                          + " present_us_avg=" + _int(_float(_profPresentUs) / _float(_profDrawFrames))
                          + " cb_us_avg=" + _int(_float(_profCbUs) / _float(_profDrawFrames))
                          // 每帧（非每窗口）的分段：事件轮询 / 清屏 / 定时器 / 光标
                          + " ev_us=" + _int(_float(_profEvUs) / _float(_profLoopFrames))
                          + " begin_us=" + _int(_float(_profBeginUs) / _float(_profDrawFrames))
                          + " timer_us=" + _int(_float(_profTimerUs) / _float(_profLoopFrames))
                          + " cursor_us=" + _int(_float(_profCursorUs) / _float(_profLoopFrames))
                          + " wait_us=" + _int(_float(_profWaitUs) / _float(_profIters))
                          + " iters=" + _profIters
                          + " body_us=" + _int(_float(_profBodyUs) / _float(_benchDone))
                          + "\n")
                    // 收尾：与 isQuit 路径一致（控件 dispose → 渲染器/窗口销毁 → 事件反初始化）
                    for _runWids.len() to i {
                        _destroyEntry(i)
                    }
                    ev.uninit()
                    if _windowCount <= 0 { core.quit() }
                    _runLoopActive = false
                    return true          // 程序化退出（requestExit / 托盘菜单等），循环结束 ✓
                }
            }
        }
    }

    // 布局调试：打印本窗口的布局树（根布局 + 注册的控件），见文件末尾 _dWalk 的说明 ✓
    func dumpLayout() {
        print("[layout] ===== dump =====  窗口 " + _str(_w) + "x" + _str(_h)
              + "  控件数=" + _str(widgets.len()) + "\n")
        if root != null { _dWalk(root, 0, "", -1.0, -1.0) }
        for widgets.len() to i { _dWalk(widgets[i], 0, "", -1.0, -1.0) }
        print("[layout] ================\n")
    }
}

// ==================== 布局调试：dumpLayout ====================
// 为什么需要它 ✓：布局"没铺开 / 位置不对"时，此前只能**截图扫像素反推** ✗（排障主力，慢且绕 ✗）。
//   dump 直接给出每个容器的计算尺寸 + 每个子项的 flex 参数 + 剩余空间 ✓ ⇒ 一眼看出根因 ✓：
//     · `free > 0` 但子项 `grow = 0` ⇒ 它不会跟着变大 ✗（最常见的一种"没铺开" ✓）
//     · `basis` 被显式写死 ⇒ 窗口变宽它也不动 ✗（`mk_card_h` 曾经就是这样 ✗）
//     · 容器尺寸与父容器给的不匹配 ⇒ 是上层没给够空间 ✓
//   ⚠ 纯只读：不改任何布局行为 ✓；也不给 face Widget 加方法（它只有 get_w/get_h/set_pos/set_size ✓）
//      ⇒ 位置信息用「容器自身 @(x,y) + 子项 w×h + flex 参数」表达，子项坐标可由此推出 ✓
//   用法：`win.dumpLayout()`（窗口树）或 `SDL3.dumpLayout(某个容器)`（任意子树 ✓）
func _dInd(int depth): string {
    string s = ""
    for 0 : depth - 1 to i { s = s + "  " }
    return s
}
func _dNum(float v): string { return _str(_int(v)) }

// 控件类型名（本模块 import 了全部控件类型，因此能给出准确名字 ✓）
func _dName(Widget c): string {
    switch c {
        case is HBox { return "HBox" }
        case is VBox { return "VBox" }
        case is AnchorBox { return "AnchorBox" }
        case is ScrollView { return "ScrollView" }
        case is Panel { return "Panel" }
        case is TabControl { return "TabControl" }
        case is GroupBox { return "GroupBox" }
        case is Splitter { return "Splitter" }
        case is SpinBox { return "SpinBox" }
        case is Button { return "Button" }
        case is Label { return "Label" }
        case is Edit { return "Edit" }
        case is Table { return "Table" }
        case is TreeView { return "TreeView" }
    }
    return "Widget"
}

// 只打印「会显著影响布局」的选项，避免刷屏 ✓
func _dOpts(Dict o): string {
    string s = ""
    float g = o.get("grow", 0.0)
    if o.get("expand", false) and g <= 0.0 { g = 1.0 }
    if g != 0.0 { s = s + " grow=" + _dNum(g) }
    float b = o.get("basis", -1.0)
    if b >= 0.0 { s = s + " basis=" + _dNum(b) }
    float sh = o.get("shrink", 1.0)
    if sh != 1.0 { s = s + " shrink=" + _dNum(sh) }
    int al = o.get("align", 0)
    if al != 0 { s = s + " align=" + _str(al) }
    float l = o.get("left", -1.0); if l >= 0.0 { s = s + " left=" + _dNum(l) }
    float t = o.get("top", -1.0); if t >= 0.0 { s = s + " top=" + _dNum(t) }
    float r = o.get("right", -1.0); if r >= 0.0 { s = s + " right=" + _dNum(r) }
    float bt = o.get("bottom", -1.0); if bt >= 0.0 { s = s + " bottom=" + _dNum(bt) }
    return s
}

// 打印一行子项（HBox/VBox 的主轴可以是横或竖 ✓），并给出该容器的剩余空间诊断 ✓
func _dRow(Array[Widget] cs, Array[Dict] opts, Array[float] natW, Array[float] natH,
           float inner, float spacing, bool horiz, int depth) {
    int n = cs.len()
    if n == 0 { print(_dInd(depth + 1) + "(空容器)\n"); return }
    float totalBasis = 0.0
    float sumGrow = 0.0
    for n to i {
        Dict o = opts[i]
        float g = o.get("grow", 0.0)
        if o.get("expand", false) and g <= 0.0 { g = 1.0 }
        float basis = natH[i]
        if horiz { basis = natW[i] }
        float b = o.get("basis", -1.0)
        if b >= 0.0 { basis = b }
        totalBasis = totalBasis + basis
        sumGrow = sumGrow + g
    }
    float free = inner - totalBasis - spacing * (n - 1)
    string hint = ""
    if free > 0.5 and sumGrow == 0.0 {
        hint = "   <== 有剩余空间但无人 grow ⇒ 全靠起始边堆着 ✗（写 grow 或 justify ✓）"
    }
    print(_dInd(depth + 1) + "inner=" + _dNum(inner) + "  basis合计=" + _dNum(totalBasis)
          + "  free=" + _dNum(free) + "  sumGrow=" + _str(_int(sumGrow)) + hint + "\n")
    for n to i {
        Dict o = opts[i]
        float g = o.get("grow", 0.0)
        if o.get("expand", false) and g <= 0.0 { g = 1.0 }
        string warn = ""
        if free > 0.5 and g <= 0.0 { warn = "   <== free 未被吸收（grow=0 ⇒ 不随空间变化 ✗）" }
        _dWalk(cs[i], depth + 2, _dOpts(o) + warn, natW[i], natH[i])
    }
}

// 递归打印一个控件；`optStr` 为父容器记录给它的 flex 选项（根为空 ✓）
// 参数改成 `Widget?`：调用方常从**字段**里取子控件（`root`、`c._content`），
// 而字段的判断**不会**收窄类型 ⇒ 声明成非可空只会让 12 处 null 静默流进来 ✗。
// 这里统一在入口判空返回，调用方的判空保留着也无害 ✓。
func _dWalk(Widget? c, int depth, string optStr, float natW, float natH) {
    if c == null { return }
    string natS = ""
    if natW >= 0.0 { natS = "  nat=" + _dNum(natW) + "x" + _dNum(natH) }
    print(_dInd(depth) + _dName(c) + "  " + _dNum(c.get_w()) + "x" + _dNum(c.get_h()) + natS + optStr + "\n")
    switch c {
        case is HBox {
            print(_dInd(depth + 1) + "@(" + _dNum(c.x) + "," + _dNum(c.y) + ")  pad="
                  + _dNum(c.padX) + "," + _dNum(c.padY) + "  spacing=" + _dNum(c.spacing) + "\n")
            _dRow(c._c, c._opt, c._natW, c._natH, c.w - 2.0 * c.padX, c.spacing, true, depth)
        }
        case is VBox {
            print(_dInd(depth + 1) + "@(" + _dNum(c.x) + "," + _dNum(c.y) + ")  pad="
                  + _dNum(c.padX) + "," + _dNum(c.padY) + "  spacing=" + _dNum(c.spacing) + "\n")
            _dRow(c._c, c._opt, c._natW, c._natH, c.h - 2.0 * c.padY, c.spacing, false, depth)
        }
        case is AnchorBox {
            print(_dInd(depth + 1) + "@(" + _dNum(c.x) + "," + _dNum(c.y) + ")  anchor\n")
            for c._c.len() to i {
                _dWalk(c._c[i], depth + 2, _dOpts(c._opt[i]), c._natW[i], c._natH[i])
            }
        }
        case is ScrollView {
            print(_dInd(depth + 1) + "@(" + _dNum(c.x) + "," + _dNum(c.y) + ")  内容="
                  + _dNum(c._contentW) + "x" + _dNum(c._contentH) + "\n")
            if c._content != null { _dWalk(c._content, depth + 1, "", -1.0, -1.0) }
        }
        case is TabControl {
            print(_dInd(depth + 1) + "@(" + _dNum(c.x) + "," + _dNum(c.y) + ")  页="
                  + _str(c._active) + "/" + _str(c._tabs.len()) + "\n")
            if c._active >= 0 and c._active < c._pageLayouts.len() {
                if c._hasLayout[c._active] {
                    _dWalk(c._pageLayouts[c._active] as Widget, depth + 1, "", -1.0, -1.0)
                }
            }
        }
    }
}

export func dumpLayout(Widget c) {
    print("[layout] ===== dump =====\n")
    _dWalk(c, 0, "", -1.0, -1.0)
    print("[layout] ================\n")
}

// 创建窗口实例，opts: {title, w, h, flags}
export func createWindow(Dict opts): Window {
    Window win = new Window(); win.init(opts); return win
}

// ★ 2026-11-21：创建**虚拟子窗口**（不向 OS 申请窗口；画进离屏纹理，由父窗口合成）
//   opts 与 createWindow 相同（title/w/h 只作记录），额外要求**主窗口已经注册**（registerOnly/run 之后）。
export func createVirtualWindow(Dict opts): Window {
    Window win = new Window()
    win.virt = true
    win.init(opts)
    return win
}



