// sdl_steps.leno — 步骤条（Steps / 流程指示器）
// 通过 win.addSteps({...}) 或 SDL3.createSteps({...}) 创建
//
// 两种方向：
//   dir:0（默认，竖向）—— 圆圈 + 序号 + 标题 + 说明，右侧竖排（"切换守护"那种 5 步流程 ✓）
//   dir:1（横向）——  圆圈 + 序号 + 横线 + 下方标题/状态（"部署流程"那种概览 ✓）
//
// 状态：`set_active(idx)` 一把设定"idx 之前=已完成 / idx=当前 / 之后=未开始"，
//   也可用 `set_state(i, STATE_*)` 单独设某一步 ✓
//
// ★ 为什么自绘而不塞一堆 Label：步骤行里是"圆形 + 序号 + 两行文字"，用子控件反而要处理
//   动态子控件数量 + 位置同步；这里只有"量文字 + 摆文字"，自绘更直接 ✓（两点注意：
//   ① 序号/标题都按**实测宽高**摆 ⇒ 只居中一次 ✓；② 字宽随字号变 ⇒ 字号 setter 要重排 ✓）
import "sdl_renderer.leno" as ren; use ren.Renderer
import "sdl_event.leno" as evt; use evt.Event
import "sdl_widget.leno" as wgt; use wgt.Widget
import "sdl_theme.leno" as theme; use theme.Color
import "sdl_font.leno" as fnt; use fnt.Font
import "sdl_core.leno" as core

export struct Steps impl Widget {
    const DIR_V = 0
    const DIR_H = 1
    const STATE_PENDING = 0
    const STATE_DONE    = 1
    const STATE_ACTIVE  = 2

    float x = 0.0, y = 0.0
    float _w = 320.0, _h = 0.0
    int _dir = DIR_V
    float _itemH = 44.0      // 竖向：每步占高（圆圈 26 + 间隙 18 ✓）
    float _circle = 26.0
    float _gap = 14.0        // 圆圈到文字的横向间距 ✓
    float _titleSize = 14.0
    float _descSize = 11.0
    int _active = -1         // < active 已完成、== active 当前步、> active 未开始（-1 = 全部未开始 ✓）
    // 配色（默认面向浅色界面 ✓）
    Color _doneBg    = #2B6BE4FF
    Color _pendBg    = #F1F5F9FF
    Color _pendBd    = #E2E8F0FF
    Color _pendTx    = #94A3B8FF
    Color _lineDone  = #2B6BE4FF
    Color _linePend  = #E2E8F0FF
    Color _titleC    = #111827FF
    Color _descC     = #6B7280FF
    Array[string] _titles = []
    Array[string] _descs  = []
    Array[int]    _states = []
    Font? _fT = null         // 标题/序号字体 ✓
    Font? _fD = null         // 说明字体 ✓
    bool _loaded = false, visible = true

    func set(Dict opts) {
        x = opts.get("x", 0.0)
        y = opts.get("y", 0.0)
        _w = opts.get("w", 320.0)
        _dir = opts.get("dir", Steps.DIR_V)
        _itemH = opts.get("item_h", 44.0)
        _circle = opts.get("circle", 26.0)
        _gap = opts.get("gap", 14.0)
        _titleSize = opts.get("font_size", 14.0)
        _descSize = opts.get("desc_size", 11.0)
        if opts.get("done_color") is Color => t { _doneBg = t; _lineDone = t }
        if opts.get("pending_bg") is Color => t { _pendBg = t }
        if opts.get("pending_border") is Color => t { _pendBd = t }
        if opts.get("pending_text") is Color => t { _pendTx = t }
        if opts.get("line_color") is Color => t { _linePend = t }
        if opts.get("title_color") is Color => t { _titleC = t }
        if opts.get("desc_color") is Color => t { _descC = t }
        _fT = fnt.acquireFontAuto(_titleSize)
        _fD = fnt.acquireFontAuto(_descSize)
        visible = opts.get("visible", true)
        _loaded = true
        _measure()
    }

    // ==================== 设置方法 ====================
    func add_step(string title, string desc) {
        _titles.add(title)
        _descs.add(desc)
        _states.add(Steps.STATE_PENDING)
        _measure()
    }
    // 一把设定：idx 之前 = 已完成，idx = 当前步，之后 = 未开始 ✓
    func set_active(int idx) {
        _active = idx
        for _states.len() to i {
            if i < idx { _states[i] = Steps.STATE_DONE }
            else if i == idx { _states[i] = Steps.STATE_ACTIVE }
            else { _states[i] = Steps.STATE_PENDING }
        }
        core.markFrameRedraw()
    }
    func set_state(int idx, int st) {
        if idx < 0 or idx >= _states.len() { return }
        _states[idx] = st
        core.markFrameRedraw()
    }
    func _state(int i): int {
        if i < 0 or i >= _states.len() { return Steps.STATE_PENDING }
        return _states[i]
    }
    // 某个状态是否"已点亮"（圆圈填充 + 文字反白 ✓）
    func _lit(int st): bool { return st != Steps.STATE_PENDING }

    // 自然高度：竖向 = (n-1)×步高 + 圆圈；横向 = 圆圈 + 标题 + 说明 ✓
    func _measure() {
        int n = _titles.len()
        if n == 0 { _h = 0.0; return }
        if _dir == Steps.DIR_V {
            _h = _itemH * _float(n - 1) + _circle
            return
        }
        float th = _titleSize
        float dh = _descSize
        if _fT != null and _fT.ok { var[float, float](twx, thx) = _fT.measureString("Ag"); th = thx }
        if _fD != null and _fD.ok { var[float, float](dwx, dhx) = _fD.measureString("Ag"); dh = dhx }
        _h = _circle + 8.0 + th + 2.0 + dh + 2.0
    }
    func set_title_size(float s) {
        _titleSize = s
        if _fT != null and _fT.ok { fnt.releaseFont(_fT) }
        _fT = fnt.acquireFontAuto(s)
        _measure()
    }
    func set_desc_size(float s) {
        _descSize = s
        if _fD != null and _fD.ok { fnt.releaseFont(_fD) }
        _fD = fnt.acquireFontAuto(s)
        _measure()
    }
    func set_visible(bool v) { visible = v }
    func is_visible(): bool { return visible }
    func set_enabled(bool e) {}

    // ==================== 查询方法 ====================
    func get_x(): float { return x }
    func get_y(): float { return y }
    func get_w(): float { return _w }
    func get_h(): float { return _h }
    func count(): int { return _titles.len() }
    func set_pos(float px, float py) { x = px; y = py }
    func set_size(float sw, float sh) {
        _w = sw
        if sh > 0.0 { _h = sh }
    }

    // 不可点 ⇒ 不处理事件
    func process(Event ev) {}

    // ==================== 渲染 ====================
    func render(Renderer r) {
        if not _loaded or not visible { return }
        int n = _titles.len()
        if n == 0 { return }
        if _fT == null or not _fT.ok { return }
        if _fD == null or not _fD.ok { return }
        float rad = _circle / 2.0

        if _dir == Steps.DIR_V {
            for n to i {
                float cy = y + _itemH * _float(i) + rad
                int st = _state(i)
                // 连线先画（圆圈盖在上面 ✓）：从当前圆底连到下一个圆顶
                if i < n - 1 {
                    if st == Steps.STATE_DONE { r.setColor(_lineDone) } else { r.setColor(_linePend) }
                    r.fillRect(x + rad - 1.0, cy + rad, 2.0, _itemH - _circle)
                }
                if _lit(st) {
                    r.setColor(_doneBg)
                    r.fillRoundedRect(x, cy - rad, _circle, _circle, rad)
                } else {
                    r.setColor(_pendBg)
                    r.fillRoundedRect(x, cy - rad, _circle, _circle, rad)
                    r.setColor(_pendBd)
                    r.drawRoundedRect(x, cy - rad, _circle, _circle, rad)
                }
                // 序号：量出宽高再摆 ⇒ 真正居中（只居中一次 ✓）
                string num = _str(i + 1)
                var[float, float](nw, nh) = _fT.measureString(num)
                Color nc = #FFFFFFFF
                if not _lit(st) { nc = _pendTx }
                r.drawText(_fT, num, x + rad - nw / 2.0, cy - nh / 2.0, nc)
                // 标题 / 说明：与圆圈**顶边对齐**（和示例里手工摆的位置一致 ✓）
                string tt = _titles[i]
                string dd = _descs[i]
                var[float, float](tw, th) = _fT.measureString(tt)
                r.drawText(_fT, tt, x + _circle + _gap, cy - rad + 1.0, _titleC)
                if dd != "" {
                    Color dc = _descC
                    if not _lit(st) { dc = _pendTx }   // 未开始：说明也用浅灰 ✓
                    r.drawText(_fD, dd, x + _circle + _gap, cy - rad + 1.0 + th - 3.0, dc)
                }
            }
            return
        }

        // 横向：圆圈等分排开 + 连线 + 下方居中标题/状态 ✓
        float span = _w - _circle
        if n > 1 { span = (_w - _circle) / _float(n - 1) }
        float ccy = y + rad
        for n to i {
            float cx = x + rad + span * _float(i)
            int st = _state(i)
            if i < n - 1 {
                if st == Steps.STATE_DONE { r.setColor(_lineDone) } else { r.setColor(_linePend) }
                r.fillRect(cx + rad, ccy - 1.0, span - _circle, 2.0)
            }
        }
        var[float, float](_aw, th) = _fT.measureString("Ag")
        var[float, float](_bw, dh) = _fD.measureString("Ag")
        for n to i {
            float cx = x + rad + span * _float(i)
            int st = _state(i)
            if _lit(st) {
                r.setColor(_doneBg)
                r.fillRoundedRect(cx - rad, ccy - rad, _circle, _circle, rad)
            } else {
                r.setColor(_pendBg)
                r.fillRoundedRect(cx - rad, ccy - rad, _circle, _circle, rad)
                r.setColor(_pendBd)
                r.drawRoundedRect(cx - rad, ccy - rad, _circle, _circle, rad)
            }
            string num = _str(i + 1)
            var[float, float](nw, nh) = _fT.measureString(num)
            Color nc = #FFFFFFFF
            if not _lit(st) { nc = _pendTx }
            r.drawText(_fT, num, cx - nw / 2.0, ccy - nh / 2.0, nc)
            // 标题（居中于圆心 ✓）
            string tt = _titles[i]
            var[float, float](tw, _th2) = _fT.measureString(tt)
            float ty = ccy + rad + 8.0
            r.drawText(_fT, tt, cx - tw / 2.0, ty, _titleC)
            string dd = _descs[i]
            if dd != "" {
                var[float, float](dw, _dh2) = _fD.measureString(dd)
                r.drawText(_fD, dd, cx - dw / 2.0, ty + th + 2.0, _descC)
            }
        }
    }

    func dispose() {
        if _fT != null and _fT.ok { fnt.releaseFont(_fT) }
        if _fD != null and _fD.ok { fnt.releaseFont(_fD) }
        _fT = null
        _fD = null
    }
}

// 工厂
export func createSteps(Dict opts): Steps {
    Steps s = new Steps(); s.set(opts); return s
}
