// sdl_steps.leno — 步骤条（Steps / 流程指示器）
// 通过 win.addSteps({...}) 或 SDL3.createSteps({...}) 创建
//
// 两种方向：
//   dir:0（默认，竖向）—— 圆圈 + 序号 + 标题 + 说明，右侧竖排（"切换守护"那种 5 步流程 ✓）
//   dir:1（横向）——  圆圈 + 序号 + 横线 + 下方标题/状态（"部署流程"那种概览 ✓）
//                     可选 `text_side:true` ⇒ 文字改放圆圈**右侧**（同心圆 + 右标题版式 ✓）
//                     可选 `line_w`（连线粗细，默认 2 ✓）/ `line_color` ✓
//
// 状态：`set_active(idx)` 一把设定"idx 之前=已完成 / idx=当前 / 之后=未开始"，
//   也可用 `set_state(i, STATE_*)` 单独设某一步 ✓
//
// ★ 为什么自绘而不塞一堆 Label：步骤行里是"圆形 + 序号 + 两行文字"，用子控件反而要处理
//   动态子控件数量 + 位置同步；这里只有"量文字 + 摆文字"，自绘更直接 ✓（两点注意：
//   ① 序号/标题都按**实测宽高**摆 ⇒ 只居中一次 ✓；② 字宽随字号变 ⇒ 字号 setter 要重排 ✓）
import "sdl_renderer.leno" as ren; use ren.Renderer
import "sdl_opts.leno" as dochk    // 选项对账：不认识的键会报一行警告（见 sdl_opts.leno ✓）
import "sdl_event.leno" as evt; use evt.Event
import "sdl_widget.leno" as wgt; use wgt.Widget
import "sdl_theme.leno" as theme; use theme.Color
import "sdl_font.leno" as fnt; use fnt.Font
import "sdl_core.leno" as core


// 本控件认的键 —— 由本文件全部 `.get("…")` **自动抽取**（是超集 ⇒ 可少报、不误报 ✓）
//   ⚠ 以后增删选项请重跑抽取（或人工核对），否则可能对合法用法误报 ✓
func _opts_keys(): Array[string] {
    return [
"circle", "desc_color", "desc_size", "dir", "done_color", "font_size", "gap", "item_h", "line_color", "line_w", "pending_bg", "pending_border", "pending_text", "text_side", "title_color", "visible", "w", "x", "y"
]
}
export struct Steps impl Widget {
    const DIR_V = 0
    const DIR_H = 1
    const STATE_PENDING = 0
    const STATE_DONE    = 1
    const STATE_ACTIVE  = 2

    float x = 0.0, y = 0.0
    float _w = 320.0, _h = 0.0
    pri int dir = DIR_V
    pri float itemH = 44.0      // 竖向：每步占高（圆圈 26 + 间隙 18 ✓）
    pri float circle = 26.0
    pri float gap = 14.0        // 圆圈到文字的横向间距 ✓
    pri float titleSize = 14.0
    pri float descSize = 11.0
    pri float lineW = 2.0        // 横向连线粗细（默认 2 ✓；`line_w:1` 可与手写 1px 细线一致 ✓）
    // 横向时文字放哪边：
    //   false（默认）= **居中在圆圈正下方**（标准 stepper 版式 ✓）
    //   true         = **放在圆圈右侧**（同心圆+右标题的版式，与示例里手写的 `step_h` 一致 ✓）
    pri bool textSide = false
    // `text_side` 模式下"最宽的一段文字"宽度（标题/说明取大者 ✓）
    //   ⚠ 必须用它给**最后一步右侧的文字**留位置，否则圆圈等分到边缘时标题会被卡片切掉 ✗
    pri float textW = 0.0
    int _active = -1         // < active 已完成、== active 当前步、> active 未开始（-1 = 全部未开始 ✓）
    // 配色（默认面向浅色界面 ✓）
    pri Color doneBg    = #2B6BE4FF
    pri Color pendBg    = #F1F5F9FF
    pri Color pendBd    = #E2E8F0FF
    pri Color pendTx    = #94A3B8FF
    pri Color lineDone  = #2B6BE4FF
    pri Color linePend  = #E2E8F0FF
    pri Color titleC    = #111827FF
    pri Color descC     = #6B7280FF
    Array[string] _titles = []
    pri Array[string] descs  = []
    pri Array[int]    states = []
    pri Font? fT = null         // 标题/序号字体 ✓
    pri Font? fD = null         // 说明字体 ✓
    bool _loaded = false, visible = true


    func set(Dict opts) {
        dochk.check("sdl_steps", opts, _opts_keys())   // ★ 选项对账（2026-09-29 铺开 ✓）
        x = opts.get("x", 0.0)
        y = opts.get("y", 0.0)
        _w = opts.get("w", 320.0)
        dir = opts.get("dir", Steps.DIR_V)
        itemH = opts.get("item_h", 44.0)
        circle = opts.get("circle", 26.0)
        gap = opts.get("gap", 14.0)
        titleSize = opts.get("font_size", 14.0)
        descSize = opts.get("desc_size", 11.0)
        lineW = opts.get("line_w", 2.0)
        textSide = opts.get("text_side", false)
        if opts.get("done_color") is Color => t { doneBg = t; lineDone = t }
        if opts.get("pending_bg") is Color => t { pendBg = t }
        if opts.get("pending_border") is Color => t { pendBd = t }
        if opts.get("pending_text") is Color => t { pendTx = t }
        if opts.get("line_color") is Color => t { linePend = t }
        if opts.get("title_color") is Color => t { titleC = t }
        if opts.get("desc_color") is Color => t { descC = t }
        fT = fnt.acquireFontAuto(titleSize)
        fD = fnt.acquireFontAuto(descSize)
        visible = opts.get("visible", true)
        _loaded = true
        measure()
    }

    // ==================== 设置方法 ====================
    func add_step(string title, string desc) {
        _titles.add(title)
        descs.add(desc)
        states.add(Steps.STATE_PENDING)
        measure()
    }
    // 一把设定：idx 之前 = 已完成，idx = 当前步，之后 = 未开始 ✓
    func set_active(int idx) {
        _active = idx
        for states.len() to i {
            if i < idx { states[i] = Steps.STATE_DONE }
            else if i == idx { states[i] = Steps.STATE_ACTIVE }
            else { states[i] = Steps.STATE_PENDING }
        }
        core.markFrameRedraw()
    }
    func set_state(int idx, int st) {
        if idx < 0 or idx >= states.len() { return }
        states[idx] = st
        core.markFrameRedraw()
    }
    pri func state(int i): int {
        if i < 0 or i >= states.len() { return Steps.STATE_PENDING }
        return states[i]
    }
    // 某个状态是否"已点亮"（圆圈填充 + 文字反白 ✓）
    pri func lit(int st): bool { return st != Steps.STATE_PENDING }

    // 自然高度：竖向 = (n-1)×步高 + 圆圈；横向 = 圆圈 + 标题 + 说明 ✓
    pri func measure() {
        int n = _titles.len()
        if n == 0 { _h = 0.0; return }
        if dir == Steps.DIR_V {
            _h = itemH * _float(n - 1) + circle
            return
        }
        float th = titleSize
        float dh = descSize
        if fT != null and fT.ok { var[float, float](twx, thx) = fT.measureString("Ag"); th = thx }
        if fD != null and fD.ok { var[float, float](dwx, dhx) = fD.measureString("Ag"); dh = dhx }
        if textSide {
            // 文字在圆圈右侧 ⇒ 与圆圈并排 ⇒ 高度取"文字块"与圆圈的大者 ✓
            float th2 = th + 2.0 + dh
            _h = if circle > th2 then circle else th2
            // 量出最宽的一段文字 ⇒ 横向排布时给它留位置（否则最后一步的标题溢出卡片 ✗）
            textW = 0.0
            for _titles.len() to i {
                var[float, float](wt, _h1) = fT.measureString(_titles[i])
                var[float, float](wd, _h2) = fD.measureString(descs[i])
                if wt > textW { textW = wt }
                if wd > textW { textW = wd }
            }
            return
        }
        textW = 0.0
        _h = circle + 8.0 + th + 2.0 + dh + 2.0
    }
    func set_title_size(float s) {
        titleSize = s
        if fT != null and fT.ok { fnt.releaseFont(fT) }
        fT = fnt.acquireFontAuto(s)
        measure()
    }
    func set_desc_size(float s) {
        descSize = s
        if fD != null and fD.ok { fnt.releaseFont(fD) }
        fD = fnt.acquireFontAuto(s)
        measure()
    }
    func set_visible(bool v) { visible = v }
    func is_visible(): bool { return visible }
    func set_enabled(bool e) {}

    // ==================== 查询方法 ====================
    func get_x(): float { return x }
    func get_y(): float { return y }
    func get_w(): float { return _w }
    func get_h(): float { return _h }
    func count(): int { return _titles.len() }
    func set_pos(float px, float py) { x = px; y = py }
    func set_size(float sw, float sh) {
        _w = sw
        if sh > 0.0 { _h = sh }
    }

    // 不可点 ⇒ 不处理事件
    func process(Event ev) {}

    // ==================== 渲染 ====================
    func render(Renderer r) {
        if not _loaded or not visible { return }
        int n = _titles.len()
        if n == 0 { return }
        if fT == null or not fT.ok { return }
        if fD == null or not fD.ok { return }
        float rad = circle / 2.0

        if dir == Steps.DIR_V {
            for n to i {
                float cy = y + itemH * _float(i) + rad
                int st = state(i)
                // 连线先画（圆圈盖在上面 ✓）：从当前圆底连到下一个圆顶
                if i < n - 1 {
                    if st == Steps.STATE_DONE { r.setColor(lineDone) } else { r.setColor(linePend) }
                    r.fillRect(x + rad - 1.0, cy + rad, 2.0, itemH - circle)
                }
                if lit(st) {
                    r.setColor(doneBg)
                    r.fillRoundedRect(x, cy - rad, circle, circle, rad)
                } else {
                    r.setColor(pendBg)
                    r.fillRoundedRect(x, cy - rad, circle, circle, rad)
                    r.setColor(pendBd)
                    r.drawRoundedRect(x, cy - rad, circle, circle, rad)
                }
                // 序号：量出宽高再摆 ⇒ 真正居中（只居中一次 ✓）
                string num = _str(i + 1)
                var[float, float](nw, nh) = fT.measureString(num)
                Color nc = #FFFFFFFF
                if not lit(st) { nc = pendTx }
                r.drawText(fT, num, x + rad - nw / 2.0, cy - nh / 2.0, nc)
                // 标题 / 说明：与圆圈**顶边对齐**（和示例里手工摆的位置一致 ✓）
                string tt = _titles[i]
                string dd = descs[i]
                var[float, float](tw, th) = fT.measureString(tt)
                r.drawText(fT, tt, x + circle + gap, cy - rad + 1.0, titleC)
                if dd != "" {
                    Color dc = descC
                    if not lit(st) { dc = pendTx }   // 未开始：说明也用浅灰 ✓
                    r.drawText(fD, dd, x + circle + gap, cy - rad + 1.0 + th - 3.0, dc)
                }
            }
            return
        }

        // 横向：圆圈等分排开 + 连线；文字按 `_textSide` 决定在圆圈右侧 / 下方居中 ✓
        float span = _w - circle
        if n > 1 {
            if textSide {
                // ⚠ 文字在右侧 ⇒ 必须**先扣掉最宽文字的宽度**再等分，否则最后一步的标题会越过卡片
                //   右边缘被切掉 ✗（用户实测抓到："启用定时任务"超出卡片 ✓）
                //   推导：末步文字右端 = span×(n−1) + 圆圈直径 + gap + 文字宽 ≤ _w
                //     ⇒ span ≤ (_w − 圆圈 − gap − 文字宽) / (n−1) ✓
                span = (_w - circle - gap - textW) / _float(n - 1)
                if span < 0.0 { span = 0.0 }
            } else {
                span = (_w - circle) / _float(n - 1)
            }
        }
        float ccy = y + rad
        for n to i {
            float cx = x + rad + span * _float(i)
            int st = state(i)
            if i < n - 1 {
                if st == Steps.STATE_DONE { r.setColor(lineDone) } else { r.setColor(linePend) }
                // 连线**居中于圆心高度**、粗细可配（`line_w:1` ⇒ 与手写 1px 细线一致 ✓）
                r.fillRect(cx + rad, ccy - lineW / 2.0, span - circle, lineW)
            }
        }
        var[float, float](_aw, th) = fT.measureString("Ag")
        var[float, float](_bw, dh) = fD.measureString("Ag")
        for n to i {
            float cx = x + rad + span * _float(i)
            int st = state(i)
            if lit(st) {
                r.setColor(doneBg)
                r.fillRoundedRect(cx - rad, ccy - rad, circle, circle, rad)
            } else {
                r.setColor(pendBg)
                r.fillRoundedRect(cx - rad, ccy - rad, circle, circle, rad)
                r.setColor(pendBd)
                r.drawRoundedRect(cx - rad, ccy - rad, circle, circle, rad)
            }
            string num = _str(i + 1)
            var[float, float](nw, nh) = fT.measureString(num)
            Color nc = #FFFFFFFF
            if not lit(st) { nc = pendTx }
            r.drawText(fT, num, cx - nw / 2.0, ccy - nh / 2.0, nc)
            string tt = _titles[i]
            var[float, float](tw, _th2) = fT.measureString(tt)
            string dd = descs[i]
            if textSide {
                // 文字在圆圈**右侧**：标题与圆圈顶边对齐 +1，说明固定在标题下方 +21 处
                //   ⇒ 与手写 `step_h` 的 (left+36, top+1) / (left+36, top+21) 完全一致 ✓
                //   （`gap` 要按原样给 23 ⇒ 圆圈左边缘到文字 = 圆圈直径 26 + 23 - 13 = 36 ✓）
                float tx = cx + rad + gap
                r.drawText(fT, tt, tx, ccy - rad + 1.0, titleC)
                if dd != "" {
                    var[float, float](dw, _dh2) = fD.measureString(dd)
                    r.drawText(fD, dd, tx, ccy - rad + 21.0, descC)
                }
            } else {
                // 默认：标题/说明**居中在圆圈正下方** ✓
                float ty = ccy + rad + 8.0
                r.drawText(fT, tt, cx - tw / 2.0, ty, titleC)
                if dd != "" {
                    var[float, float](dw, _dh2) = fD.measureString(dd)
                    r.drawText(fD, dd, cx - dw / 2.0, ty + th + 2.0, descC)
                }
            }
        }
    }

    func dispose() {
        if fT != null and fT.ok { fnt.releaseFont(fT) }
        if fD != null and fD.ok { fnt.releaseFont(fD) }
        fT = null
        fD = null
    }
}

// 工厂
export func createSteps(Dict opts): Steps {
    Steps s = new Steps(); s.set(opts); return s
}


