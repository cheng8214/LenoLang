// sdl_radio.leno — 单选按钮（同组互斥）
// 通过 win.addRadioButton({...}) 创建，同一 group 内只能选中一个。
// 互斥依赖模块级注册表：Leno 的 struct 数组为引用语义，注册 self 即共享同一实例。
import "sdl_renderer.leno" as ren; use ren.Renderer
import "sdl_opts.leno" as dochk    // 选项对账：不认识的键会报一行警告（见 sdl_opts.leno ✓）
import "sdl_font.leno" as fnt; use fnt.Font
import "sdl_event.leno" as evt; use evt.Event
import "sdl_core.leno" as core; use core.SystemCursor
import "sdl_widget.leno" as wgt; use wgt.Widget
import "sdl_tooltip.leno" as tip
import "sdl_theme.leno" as theme; use theme.(Theme, Themeable)
use theme.Color

// 模块级注册表，用于同组互斥（引用语义：dispose 时摘除自身，跨窗口按窗口句柄隔离）
Array[RadioButton] _radioRegistry = []


// 本控件认的键 —— 由本文件全部 `.get("…")` **自动抽取**（是超集 ⇒ 可少报、不误报 ✓）
//   ⚠ 以后增删选项请重跑抽取（或人工核对），否则可能对合法用法误报 ✓
func _opts_keys(): Array[string] {
    return [
"border_color", "box", "checked", "checked_color", "cursor", "enabled", "font_path", "font_size", "font_style", "gap", "group", "text", "text_color", "tip", "unchecked_color", "visible", "x", "y"
]
}
export struct RadioButton impl Widget {
    string text = ""
    string group = "default"
    float x = 0.0, y = 0.0
    pri float box = 22.0
    pri float gap = 8.0
    float _fontSize = 15.0
    pri string fontPath = ""
    pri int fontStyle = 0
    Font? _font
    pri bool checked = false
    pri Color uncheckedColor = #3C3C48FF
    pri Color checkedColor = #3CAAF5FF
    pri Color txtColor = #EBEBF5FF
    pri Color brdColor = #828296FF
    pri int cursor = SystemCursor.DEFAULT
    pri bool hover = false, wasHover = false, pressed = false, enabled = true, visible = true, _loaded = false
    string _tip = ""        // 悬停提示文本（空 = 不提示）
    pri float fontH = 0.0          // 字体行高缓存（字体不变时为常量，避免每帧 measureString）
    pri func(bool):void onChange
    pri Ptr[u8]? winHnd            // 所属窗口句柄：同组互斥按窗口隔离（面板/Tab 嵌套未拿到句柄则为 null）

    pri func ensure_font() {
        if _font == null or not _font.ok {
            if _font != null and _font.ok { fnt.releaseFont(_font) }
            if fontPath != "" { _font = fnt.acquireFont(fontPath, _fontSize) }
            else { _font = fnt.acquireFontAuto(_fontSize) }
            if _font.ok and fontStyle != 0 { _font.setStyle(fontStyle) }
            if _font.ok { var[float, float](_agw, _agh) = _font.measureString("Ag"); fontH = _agh }
        }
    }


    func set(Dict opts) {
        dochk.check("sdl_radio", opts, _opts_keys())   // ★ 选项对账（2026-09-29 铺开 ✓）
        Theme th = theme.getTheme()
        uncheckedColor = th.bgAlt
        checkedColor = th.accent
        txtColor = th.txt
        brdColor = th.border
        text      = opts.get("text", "")
        group     = opts.get("group", "default")
        x         = opts.get("x", 0)
        y         = opts.get("y", 0)
        box      = opts.get("box", 22)
        gap      = opts.get("gap", 8)
        _fontSize = opts.get("font_size", 15)
        fontPath = opts.get("font_path", "")
        fontStyle = opts.get("font_style", 0)

        // 颜色：opts 未传则保持默认值
        if opts.get("unchecked_color") is Color => t { uncheckedColor = t }
        if opts.get("checked_color") is Color => t { checkedColor = t }
        if opts.get("text_color") is Color => t { txtColor = t }
        if opts.get("border_color") is Color => t { brdColor = t }

        cursor = opts.get("cursor", SystemCursor.DEFAULT)
        checked = opts.get("checked", false)
        enabled = opts.get("enabled", true)
        visible = opts.get("visible", true)
        // hover/_wasHover/_pressed 默认见字段声明
        _tip = opts.get("tip", "")

        ensure_font()
        _loaded = true
        _registerRadio(self)   // 引用语义：与窗口数组同一实例（去重登记）
    }

    func set_text(string t)     { text = t }
    func set_tip(string t)       { _tip = t }
    func set_checked(bool c)     { checked = c }
    func is_checked(): bool      { return checked }
    func set_enabled(bool e)      { enabled = e }
    func set_visible(bool v)       { visible = v }
    func is_visible(): bool        { return visible }
    func set_font_size(float s)   { _fontSize = s; if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null }
    func get_x(): float           { return x }
    func get_y(): float           { return y }
    func get_w(): float {
        ensure_font()
        float tw = 0.0
        if _font != null and _font.ok and text != "" { var[float, float](_tw, _th) = _font.measureString(text); tw = _tw }
        return box + gap + tw
    }
    func get_h(): float          { return box }
    func set_pos(float px, float py) { x = px; y = py }
    func set_size(float sw, float sh) {}

    func on_change(func(bool):void cb) { onChange = cb }
    // 记录所属窗口句柄，供同组互斥按窗口隔离（_select 只取消同窗口同组其它项）
    func setWindowHandle(Ptr[u8] hwnd) { winHnd = hwnd }
    func getWindowHandle(): Ptr[u8] { return winHnd }

    func contains(float mx, float my): bool {
        float tw = 0.0
        if _font != null and _font.ok and text != "" { var[float, float](_tw, _th) = _font.measureString(text); tw = _tw }
        float totalW = box + gap + tw
        return mx >= x and mx <= x + totalW and my >= y and my <= y + box
    }

    // 选中自己并取消同组其它（同窗口内；未拿句柄的嵌套控件只与同桶控件互斥）
    pri func select() {
        if checked { return }   // 已选中保持不动
        checked = true
        for _radioRegistry.len() to i {
            RadioButton rb = _radioRegistry[i]
            if rb.group == group and rb != self and rb.getWindowHandle() == winHnd {
                rb.checked = false
            }
        }
        if onChange != null { onChange(true) }
    }

    func process(Event ev) {
        if not _loaded { return }
        if not visible { return }
        if not enabled { hover = false; pressed = false; return }
        // 弹层捕获：事件落在“他人的弹层（如打开的菜单/下拉）范围内时忽略，避免穿透到下层控件
        var[float, float](mx, my) = ev.mousePos()
        if ev.isMouseWheel() { mx = ev.wheelMouseX(); my = ev.wheelMouseY() }
        if core.inPopupCapture(mx, my) { return }


        if ev.isMouseMotion() {
            wasHover = hover
            var[float, float](_hx, _hy) = ev.mousePos(); hover = contains(_hx, _hy)
            if cursor >= 0 {
                if hover { core.requestCursor(cursor) }
            }
            // 悬停提示：hover 时上报；离开由 tipEndMotion 统一清除
            if hover and _tip != "" { var[float, float](_tx, _ty) = ev.mousePos(); tip.tipReport(_tip, _tx, _ty) }
        }

        if ev.isMouseButtonUp() { pressed = false }

        if ev.isMouseButtonDown() and hover and not pressed {
            pressed = true
            select()
        }
    }

    func render(Renderer r) {
        if not _loaded { return }
        if not visible { return }
        ensure_font()
        float bx = x, by = y, bs = box

        // 外环
        Color ringC = uncheckedColor
        if hover { ringC = theme.brighten(ringC, 25) }
        if not enabled { ringC = theme.packColor(theme.colorR(uncheckedColor) / 2, theme.colorG(uncheckedColor) / 2, theme.colorB(uncheckedColor) / 2) }
        r.setColor(ringC)
        r.fillRoundedRect(bx, by, bs, bs, bs / 2.0)

        r.setColor(theme.withAlpha(brdColor, 220))
        r.drawRoundedRect(bx, by, bs, bs, bs / 2.0)

        // 选中内点
        if checked {
            Color dotC = checkedColor
            if not enabled { dotC = theme.packColor(theme.colorR(checkedColor) / 2, theme.colorG(checkedColor) / 2, theme.colorB(checkedColor) / 2) }
            r.setColor(dotC)
            float ins = bs * 0.30
            r.fillRoundedRect(bx + ins, by + ins, bs - ins * 2.0, bs - ins * 2.0, (bs - ins * 2.0) / 2.0)
        }

        // 文字
        if _font != null and _font.ok and text != "" {
            float cy = by + (bs - fontH) / 2.0
            Color tc = txtColor
            if not enabled { tc = theme.packColor(theme.colorR(txtColor) / 2, theme.colorG(txtColor) / 2, theme.colorB(txtColor) / 2) }
            r.drawText(_font, text, bx + bs + gap, cy, tc)
        }
    }

    func dispose() {
        if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null
        _unregisterRadio(self)   // 从注册表摘除自身，避免窗口销毁后悬空引用累积、跨窗口误互斥
    }
}

export func createRadioButton(Dict opts): RadioButton {
    RadioButton rb = new RadioButton(); rb.set(opts); return rb
}

// ==================== 单选按钮注册表（同组互斥） ====================
// 区别于旧「全局数组永不摘除」反模式：RadioButton.dispose() 时通过 _unregisterRadio 摘除自身，
// 窗口销毁（递归 dispose 所有控件）后不残留，无悬空引用累积、无跨窗口数组无限增长。
// 登记去重；互斥判定在同窗口（_winHnd）+ 同 group 内进行（见 _select）。
func _registerRadio(RadioButton r) {
    for _radioRegistry.len() to i { if _radioRegistry[i] == r { return } }  // 去重
    _radioRegistry.add(r)
}
func _unregisterRadio(RadioButton r) {
    for _radioRegistry.len() to i { if _radioRegistry[i] == r { _radioRegistry.remove(i); break } }
}


