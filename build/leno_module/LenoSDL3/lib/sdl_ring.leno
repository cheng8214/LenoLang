// sdl_ring.leno — 圆环进度控件（donut 环形进度条）
// 三种形态（mode）：
//   "idle"   静止圆环（可配 on_click 当大按钮用）
//   "sweep"  扫描模式：旋转亮弧 + 淡色余辉（自动 requestRedraw 驱动动画）
//   "value"  值模式：set_value(0..1) 平滑动画画出进度弧（从 12 点钟方向顺时针）
// 绘制 = fillPie 扇形（AA ✓）+ fillCircle 抠底成 donut；中心文字可选（text_fn 动态文案）
import maths
import "sdl_renderer.leno" as ren; use ren.Renderer
import "sdl_font.leno" as fnt; use fnt.Font
import "sdl_event.leno" as evt; use evt.Event
import "sdl_core.leno" as core; use core.SystemCursor
import "sdl_widget.leno" as wgt; use wgt.Widget
import "sdl_theme.leno" as theme
use theme.(Color, Theme)
import "sdl_tooltip.leno" as tip

export struct RingProgress impl Widget {
    float x = 0.0, y = 0.0
    float _size = 220.0            // 直径
    float _thickness = 16.0        // 环带厚度
    float value = 0.0              // 目标值 0..1
    float _dispVal = 0.0           // 显示值（动画逼近 value）
    float _animSpeed = 6.0; float _animLast = 0.0; bool _animating = false
    string _mode = "idle"          // idle | sweep | value
    float _angle = 0.0             // sweep 当前旋转角（度）
    float _speed = 150.0           // sweep 转速（度/秒）
    float _sweepLast = 0.0
    Color _track = #464A54FF       // 轨道色
    Color _fill = #3CC850FF        // 值弧/亮弧色
    Color _txt = #EBEBF5FF         // 中心文字色
    Color _bg = #FFFFFF00          // 抠底色（内圆）——须与父容器底色一致才无缝
    float _fontSize = 18.0; string _fontPath = ""; Font? _font; float _fontH = 0.0
    bool _showText = true
    int _cursor = SystemCursor.POINTER
    bool hover = false; bool enabled = true; bool visible = true; bool _loaded = false
    string _tip = ""
    func():string _textFn
    func():void _onClick

    func set(Dict opts) {
        Theme th = theme.getTheme()
        _track = th.bgAlt
        _fill = th.btnSuccess
        _txt = th.txt
        _bg = th.bg
        x = opts.get("x", 0)
        y = opts.get("y", 0)
        _size = opts.get("size", 220)
        _thickness = opts.get("thickness", 16.0)
        value = opts.get("value", 0.0)
        if value < 0.0 { value = 0.0 }
        if value > 1.0 { value = 1.0 }
        _dispVal = value; _animating = false; _animLast = 0.0
        _animSpeed = opts.get("anim_speed", 6.0)
        _speed = opts.get("sweep_speed", 150.0)
        _mode = opts.get("mode", "idle")
        _fontSize = opts.get("font_size", 18)
        _fontPath = opts.get("font_path", "")
        _showText = opts.get("show_text", true)
        _cursor = opts.get("cursor", SystemCursor.POINTER)
        enabled = opts.get("enabled", true)
        visible = opts.get("visible", true)
        _tip = opts.get("tip", "")
        if opts.get("track_color") is Color => t { _track = t }
        if opts.get("fill_color") is Color => t { _fill = t }
        if opts.get("text_color") is Color => t { _txt = t }
        if opts.get("bg_color") is Color => t { _bg = t }
        if opts.get("text_fn") is func():string => f { _textFn = f }
        if opts.get("on_click") is func():void => f { _onClick = f }
        _ensure_font()
        _loaded = true
    }

    func _ensure_font() {
        if _font == null or not _font.ok {
            if _font != null and _font.ok { fnt.releaseFont(_font) }
            if _fontPath != "" { _font = fnt.acquireFont(_fontPath, _fontSize) }
            else { _font = fnt.acquireFontAuto(_fontSize) }
            if _font.ok { var[float, float](_gw, _gh) = _font.measureString("Ag"); _fontH = _gh }
        }
    }

    // ==================== 设置方法 ====================
    func set_value(float v) {
        if v < 0.0 { v = 0.0 }
        if v > 1.0 { v = 1.0 }
        if v != value {
            value = v
            _animating = true
            _animLast = 0.0
        }
    }
    func get_value(): float { return value }
    func get_display_value(): float { return _dispVal }
    func set_mode(string m) {
        if m == _mode { return }
        _mode = m
        _angle = 0.0; _sweepLast = 0.0
        if m == "value" { _dispVal = 0.0; _animating = true; _animLast = 0.0 }
    }
    func get_mode(): string { return _mode }
    func set_text_fn(func():string f) { _textFn = f }
    func on_click(func():void cb) { _onClick = cb }
    func set_enabled(bool e) { enabled = e }
    func set_visible(bool v) { visible = v }
    func is_visible(): bool { return visible }
    func set_font_size(float s) { _fontSize = s; if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null }
    func get_x(): float { return x }
    func get_y(): float { return y }
    func get_w(): float { return _size }
    func get_h(): float { return _size }
    func set_pos(float px, float py) { x = px; y = py }
    func set_size(float sw, float sh) { _size = if sw < sh then sw else sh }

    func _hit(float mx, float my): bool {
        float dx = mx - (x + _size / 2.0)
        float dy = my - (y + _size / 2.0)
        return dx * dx + dy * dy <= (_size / 2.0) * (_size / 2.0)
    }

    // ==================== 交互 ====================
    func process(Event ev) {
        if not _loaded or not visible { return }
        if ev.isMouseMotion() {
            var[float, float](mx, my) = ev.mousePos()
            bool h = _hit(mx, my) and enabled and _onClick != null
            if h != hover { hover = h; core.markFrameRedraw() }
            if h and _tip != "" { tip.tipReport(_tip, mx, my) }
            if h and _cursor >= 0 { core.requestCursor(_cursor) }
            core.markFrameMotion()
        }
        if ev.isMouseButtonDown() and enabled and _onClick != null {
            var[float, float](mx, my) = ev.mousePos()
            if _hit(mx, my) { _onClick() }
        }
    }

    // ==================== 动画步进 ====================
    func _step_anim() {
        if not _animating { return }
        if _animSpeed <= 0.0 { _dispVal = value; _animating = false; return }
        float now = _float(core.getTicks())
        float dt = 0.0
        if _animLast > 0.0 { dt = (now - _animLast) / 1000.0 }
        _animLast = now
        float diff = value - _dispVal
        float ad = diff
        if ad < 0.0 { ad = -ad }
        if ad <= 0.001 {
            _dispVal = value
            _animating = false
        } else if dt > 0.0 {
            float f = _animSpeed * dt
            if f > 1.0 { f = 1.0 }
            _dispVal += diff * f
        }
    }

    func _step_sweep() {
        float now = _float(core.getTicks())
        if _sweepLast > 0.0 {
            float dt = (now - _sweepLast) / 1000.0
            _angle = _angle + _speed * dt
            if _angle >= 360.0 { _angle = _angle - 360.0 }
        }
        _sweepLast = now
    }

    // ==================== 渲染 ====================
    func render(Renderer r) {
        if not _loaded or not visible { return }
        _ensure_font()
        _step_anim()
        bool busy = false
        if _mode == "sweep" { _step_sweep(); busy = true }
        if _animating { busy = true }
        if busy { core.requestRedraw() }

        float cx = x + _size / 2.0
        float cy = y + _size / 2.0
        float rOuter = _size / 2.0 - 2.0          // 留 2px 给 AA 边
        float rInner = rOuter - _thickness
        if rInner < 1.0 { rInner = 1.0 }

        // hover 反馈（可点击时）：按主题亮度自适应 —— 深色主题提亮 / 浅色主题加深 ✓
        Color trackC = _track
        Color fillC = _fill
        Color txtC = _txt
        if hover and enabled and _onClick != null {
            Theme tnow = theme.getTheme()
            int lum = theme.colorR(tnow.bg) * 299 / 1000 + theme.colorG(tnow.bg) * 587 / 1000 + theme.colorB(tnow.bg) * 114 / 1000
            if lum < 128 {
                trackC = theme.brighten(_track, 25)
                fillC = theme.brighten(_fill, 25)
                txtC = theme.brighten(_txt, 40)
            } else {
                trackC = theme.darken(_track, 22)
                fillC = theme.darken(_fill, 18)
                txtC = theme.darken(_txt, 50)
            }
        }

        // 轨道（整圈 donut）
        r.setColor(trackC)
        r.fillPie(cx, cy, rOuter, 0.0, 360.0, theme.colorR(trackC), theme.colorG(trackC), theme.colorB(trackC), theme.colorA(trackC))
        r.setColor(_bg)
        r.fillCircle(cx, cy, rInner)

        if _mode == "sweep" {
            // 淡色余辉（亮弧后方 110°）
            Color tail = theme.withAlpha(fillC, 70)
            r.fillPie(cx, cy, rOuter, _angle - 110.0, _angle, theme.colorR(tail), theme.colorG(tail), theme.colorB(tail), theme.colorA(tail))
            // 亮弧（90°）
            r.fillPie(cx, cy, rOuter, _angle, _angle + 90.0, theme.colorR(fillC), theme.colorG(fillC), theme.colorB(fillC), theme.colorA(fillC))
            r.setColor(_bg)
            r.fillCircle(cx, cy, rInner)
        } else if _mode == "value" and _dispVal > 0.0005 {
            // 值弧：12 点方向顺时针
            float a1 = -90.0 + _dispVal * 360.0
            r.fillPie(cx, cy, rOuter, -90.0, a1, theme.colorR(fillC), theme.colorG(fillC), theme.colorB(fillC), theme.colorA(fillC))
            r.setColor(_bg)
            r.fillCircle(cx, cy, rInner)
        }

        // 中心文字
        if _showText and _font != null and _font.ok {
            string label = ""
            if _textFn != null { label = _str(_textFn()) } else {
                if _mode == "value" { int pct = _int(_dispVal * 100.0 + 0.5); label = $"{pct}%" }
            }
            if label != "" {
                if not enabled { txtC = theme.packColor(theme.colorR(_txt) / 2, theme.colorG(_txt) / 2, theme.colorB(_txt) / 2) }
                r.drawTextCentered(_font, label, x, _size, cy - _fontH / 2.0, txtC)
            }
        }
    }

    func dispose() {
        if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null
    }
}

// 工厂
export func createRingProgress(Dict opts): RingProgress {
    RingProgress p = new RingProgress(); p.set(opts); return p
}
