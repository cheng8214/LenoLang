// sdl_ring.leno — 圆环进度控件（donut 环形进度条）
// 三种形态（mode）：
//   "idle"   静止圆环（可配 on_click 当大按钮用）
//   "sweep"  扫描模式：旋转亮弧 + 淡色余辉（自动 requestRedraw 驱动动画）
//   "value"  值模式：set_value(0..1) 平滑动画画出进度弧（从 12 点钟方向顺时针）
// 绘制 = fillPie 扇形（AA ✓）+ fillCircle 抠底成 donut；中心文字可选（text_fn 动态文案）
import maths
import "sdl_opts.leno" as dochk    // 选项对账：不认识的键会报一行警告（见 sdl_opts.leno ✓）
import "sdl_renderer.leno" as ren; use ren.Renderer
import "sdl_font.leno" as fnt; use fnt.Font
import "sdl_event.leno" as evt; use evt.Event
import "sdl_core.leno" as core; use core.SystemCursor
import "sdl_widget.leno" as wgt; use wgt.Widget
import "sdl_theme.leno" as theme
use theme.(Color, Theme)
import "sdl_tooltip.leno" as tip


// 本控件认的键 —— 由本文件全部 `.get("…")` **自动抽取**（是超集 ⇒ 可少报、不误报 ✓）
//   ⚠ 以后增删选项请重跑抽取（或人工核对），否则可能对合法用法误报 ✓
func _opts_keys(): Array[string] {
    return [
"anim_speed", "bg_color", "cursor", "enabled", "fill_color", "font_path", "font_size", "mode", "on_click", "segment_colors", "segments", "show_text", "size", "sub_font_size", "sub_text_fn", "sweep_speed", "text_color", "text_fn", "thickness", "tip", "track_color", "value", "visible", "x", "y"
]
}
// 多段弧「余量补全」阈值（度）：各段合计不到 1 时，余量小于这个角度就按比例补成整圈
//   为什么需要：余量只剩一两度时，它在 12 点方向就是一条发丝缝（浅色主题下看着就是一道白缝），
//   且缝宽随数据抖动忽有忽无 ⇒ 像渲染 bug ✗（见 render() 里多段弧那段注释 ✓）
//   为什么是 4°：直径 220 的环上 4° ≈ 7.7px 弧长（环带厚 24px）—— 比这更小的余量读不出任何
//   信息，补掉毫无损失；而更大的余量（如 30°）依然保留轨道色，能表达"还有一类没算进来" ✓
const float SEG_SNAP_DEG = 4.0

export struct RingProgress impl Widget {
    float x = 0.0, y = 0.0
    pri float size = 220.0            // 直径
    pri float thickness = 16.0        // 环带厚度
    float value = 0.0              // 目标值 0..1
    pri float dispVal = 0.0           // 显示值（动画逼近 value）
    pri float animSpeed = 6.0; pri float animLast = 0.0; pri bool animating = false
    string _mode = "idle"          // idle | sweep | value
    pri float angle = 0.0             // sweep 当前旋转角（度）
    pri float speed = 150.0           // sweep 转速（度/秒）
    pri float sweepLast = 0.0
    pri Color track = #464A54FF       // 轨道色
    pri Color fill = #3CC850FF        // 值弧/亮弧色
    pri Color txt = #EBEBF5FF         // 中心文字色
    pri Color bg = #FFFFFF00          // 抠底色（内圆）——须与父容器底色一致才无缝
    // ==================== 多段弧（如"已清 vs 跳过"双色环） ====================
    // 为什么需要：`value` 模式只有**一段**弧，无法表达"总量里成功的多少、跳过的多少"。
    //   清理类应用（电脑清理大师）报告页要的正是这个 ⇒ 这里补 `set_segments` ✓
    pri Array[float] segVals = []     // 各段占比（0..1，顺序 = 自 12 点顺时针；总和 ≤ 1，余量留轨道色
                                      //   ⚠ 余量 < SEG_SNAP_DEG 度时自动补成整圈 ⇒ 12 点不出白缝 ✓）
    pri Array[Color] segCols = []     // 各段颜色（可短于 vals ⇒ 循环取色）
    pri float segShown = 1.0          // 揭示动画系数（0→1）：新段数据时长出，避免"瞬间出现"的生硬感
    pri float segLast = 0.0
    pri bool segAnim = false
    // ==================== 副行文字（环中心第二行，比主行小一号） ====================
    //   用途：主行放"已释放 42.0 MB"，副行放"占可清理 23%" ⇒ 一个环讲清两件事 ✓
    pri func():string subTextFn
    pri float subFontSize = 12.0
    pri Font? subFont
    pri float subFontH = 0.0
    float _fontSize = 18.0; pri string fontPath = ""; Font? _font; pri float fontH = 0.0
    pri bool showText = true
    pri int cursor = SystemCursor.POINTER
    bool hover = false; bool enabled = true; bool visible = true; bool _loaded = false
    string _tip = ""
    pri func():string textFn
    pri func():void onClick


    func set(Dict opts) {
        dochk.check("sdl_ring", opts, _opts_keys())   // ★ 选项对账（2026-09-29 铺开 ✓）
        Theme th = theme.getTheme()
        track = th.bgAlt
        fill = th.btnSuccess
        txt = th.txt
        bg = th.bg
        x = opts.get("x", 0)
        y = opts.get("y", 0)
        size = opts.get("size", 220)
        thickness = opts.get("thickness", 16.0)
        value = opts.get("value", 0.0)
        if value < 0.0 { value = 0.0 }
        if value > 1.0 { value = 1.0 }
        dispVal = value; animating = false; animLast = 0.0
        animSpeed = opts.get("anim_speed", 6.0)
        speed = opts.get("sweep_speed", 150.0)
        _mode = opts.get("mode", "idle")
        _fontSize = opts.get("font_size", 18)
        fontPath = opts.get("font_path", "")
        showText = opts.get("show_text", true)
        cursor = opts.get("cursor", SystemCursor.POINTER)
        enabled = opts.get("enabled", true)
        visible = opts.get("visible", true)
        _tip = opts.get("tip", "")
        if opts.get("track_color") is Color => t { track = t }
        if opts.get("fill_color") is Color => t { fill = t }
        if opts.get("text_color") is Color => t { txt = t }
        if opts.get("bg_color") is Color => t { bg = t }
        if opts.get("text_fn") is func():string => f { textFn = f }
        if opts.get("on_click") is func():void => f { onClick = f }
        if opts.get("sub_text_fn") is func():string => f { subTextFn = f }
        subFontSize = opts.get("sub_font_size", 12)
        // 多段弧（可选）：segments = 占比数组，segment_colors = 颜色数组（可短 ⇒ 循环取色 ✓）
        var segsAny = opts.get("segments", [])
        if segsAny is Array => sa {
            if sa.len() > 0 {
                Array[float] vs = []
                for sa to v { vs.add(_float(v)) }
                Array[Color] cs = []
                var segcAny = opts.get("segment_colors", [])
                if segcAny is Array => ca {
                    for ca to c {
                        if c is Color => cc { cs.add(cc) }
                    }
                }
                set_segments(vs, cs)
            }
        }
        ensure_font()
        ensure_sub_font()
        _loaded = true
    }

    pri func ensure_font() {
        if _font == null or not _font.ok {
            if _font != null and _font.ok { fnt.releaseFont(_font) }
            if fontPath != "" { _font = fnt.acquireFont(fontPath, _fontSize) }
            else { _font = fnt.acquireFontAuto(_fontSize) }
            if _font.ok { var[float, float](_gw, _gh) = _font.measureString("Ag"); fontH = _gh }
        }
    }

    // 副行字体（比主行小一号；单独 acquire ⇒ 与主行字号互不影响 ✓）
    pri func ensure_sub_font() {
        if subFont == null or not subFont.ok {
            if subFont != null and subFont.ok { fnt.releaseFont(subFont) }
            if fontPath != "" { subFont = fnt.acquireFont(fontPath, subFontSize) }
            else { subFont = fnt.acquireFontAuto(subFontSize) }
            if subFont.ok { var[float, float](_gw, _gh) = subFont.measureString("Ag"); subFontH = _gh }
        }
    }

    // ==================== 设置方法 ====================
    func set_value(float v) {
        if v < 0.0 { v = 0.0 }
        if v > 1.0 { v = 1.0 }
        if v != value {
            value = v
            animating = true
            animLast = 0.0
        }
    }
    func get_value(): float { return value }
    func get_display_value(): float { return dispVal }
    func set_mode(string m) {
        if m == _mode { return }
        _mode = m
        angle = 0.0; sweepLast = 0.0
        if m == "value" { dispVal = 0.0; animating = true; animLast = 0.0 }
    }
    func get_mode(): string { return _mode }
    func set_text_fn(func():string f) { textFn = f }
    // ==================== 多段弧（双色环）API ====================
    // vals：各段占比（0..1，顺序 = 自 12 点方向**顺时针**依次排布；总和不超 1，余量留轨道色）
    //       ⚠ 余量折算 < SEG_SNAP_DEG 度（≈4°）时会被补成整圈（按比例放大各段）——
    //         余量只剩一两度时那只是条发丝缝，补掉比留着好看（见 render 的说明 ✓）
    // cols：各段颜色（可短于 vals ⇒ 按 `i % len` 循环取色）；空 ⇒ 全用 `_fill`
    // 说明：设置后自动播放"长出"揭示动画（`_segShown` 0→1）—— 清理类应用报告页看着更自然 ✓
    // ⚠ 与 `mode="value"` 互不干扰：设了多段弧就优先画多段（`value` 弧不再画 ✓）
    func set_segments(Array[float] vals, Array[Color] cols) {
        segVals = []
        for vals to v {
            float f = v
            if f < 0.0 { f = 0.0 }
            segVals.add(f)
        }
        segCols = cols
        segShown = 0.0; segLast = 0.0; segAnim = true
        core.markFrameRedraw()
    }
    func clear_segments() {
        segVals = []; segCols = []
        segShown = 1.0; segLast = 0.0; segAnim = false
        core.markFrameRedraw()
    }
    func get_segment_count(): int { return segVals.len() }
    // 副行文字（环中心第二行；传 null 取消）
    func set_sub_text_fn(func():string f) { subTextFn = f }
    func set_sub_font_size(float s) {
        subFontSize = s
        if subFont != null and subFont.ok { fnt.releaseFont(subFont) }
        subFont = null
    }
    func on_click(func():void cb) { onClick = cb }
    func set_enabled(bool e) { enabled = e }
    func set_visible(bool v) { visible = v }
    func is_visible(): bool { return visible }
    func set_font_size(float s) { _fontSize = s; if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null }
    func get_x(): float { return x }
    func get_y(): float { return y }
    func get_w(): float { return size }
    func get_h(): float { return size }
    func set_pos(float px, float py) { x = px; y = py }
    func set_size(float sw, float sh) { size = if sw < sh then sw else sh }

    pri func hit(float mx, float my): bool {
        float dx = mx - (x + size / 2.0)
        float dy = my - (y + size / 2.0)
        return dx * dx + dy * dy <= (size / 2.0) * (size / 2.0)
    }

    // ==================== 交互 ====================
    func process(Event ev) {
        if not _loaded or not visible { return }
        if ev.isMouseMotion() {
            var[float, float](mx, my) = ev.mousePos()
            bool h = hit(mx, my) and enabled and onClick != null
            if h != hover { hover = h; core.markFrameRedraw() }
            if h and _tip != "" { tip.tipReport(_tip, mx, my) }
            if h and cursor >= 0 { core.requestCursor(cursor) }
            core.markFrameMotion()
        }
        if ev.isMouseButtonDown() and enabled and onClick != null {
            var[float, float](mx, my) = ev.mousePos()
            if hit(mx, my) { onClick() }
        }
    }

    // ==================== 动画步进 ====================
    pri func step_anim() {
        if not animating { return }
        if animSpeed <= 0.0 { dispVal = value; animating = false; return }
        float now = _float(core.getTicks())
        float dt = 0.0
        if animLast > 0.0 { dt = (now - animLast) / 1000.0 }
        animLast = now
        float diff = value - dispVal
        float ad = diff
        if ad < 0.0 { ad = -ad }
        if ad <= 0.001 {
            dispVal = value
            animating = false
        } else if dt > 0.0 {
            float f = animSpeed * dt
            if f > 1.0 { f = 1.0 }
            dispVal += diff * f
        }
    }

    pri func step_sweep() {
        float now = _float(core.getTicks())
        if sweepLast > 0.0 {
            float dt = (now - sweepLast) / 1000.0
            angle = angle + speed * dt
            if angle >= 360.0 { angle = angle - 360.0 }
        }
        sweepLast = now
    }

    // 多段弧的揭示动画（0→1）：与数值动画同款指数逼近，但慢一点 ⇒ 观感更稳 ✓
    pri func step_segments() {
        if not segAnim { return }
        float now = _float(core.getTicks())
        float dt = 0.0
        if segLast > 0.0 { dt = (now - segLast) / 1000.0 }
        segLast = now
        if animSpeed <= 0.0 { segShown = 1.0; segAnim = false; return }
        if dt > 0.0 {
            float f = animSpeed * dt * 0.6
            if f > 1.0 { f = 1.0 }
            segShown = segShown + (1.0 - segShown) * f
            if segShown > 0.995 { segShown = 1.0; segAnim = false }
        }
    }

    // ==================== 渲染 ====================
    func render(Renderer r) {
        if not _loaded or not visible { return }
        ensure_font()
        if subTextFn != null { ensure_sub_font() }
        step_anim()
        step_segments()
        bool busy = false
        if _mode == "sweep" { step_sweep(); busy = true }
        if animating { busy = true }
        if segAnim { busy = true }
        if busy { core.requestRedraw() }

        float cx = x + size / 2.0
        float cy = y + size / 2.0
        float rOuter = size / 2.0 - 2.0          // 留 2px 给 AA 边
        float rInner = rOuter - thickness
        if rInner < 1.0 { rInner = 1.0 }

        // hover 反馈（可点击时）：按主题亮度自适应 —— 深色主题提亮 / 浅色主题加深 ✓
        Color trackC = track
        Color fillC = fill
        Color txtC = txt
        if hover and enabled and onClick != null {
            Theme tnow = theme.getTheme()
            int lum = theme.colorR(tnow.bg) * 299 / 1000 + theme.colorG(tnow.bg) * 587 / 1000 + theme.colorB(tnow.bg) * 114 / 1000
            if lum < 128 {
                trackC = theme.brighten(track, 25)
                fillC = theme.brighten(fill, 25)
                txtC = theme.brighten(txt, 40)
            } else {
                trackC = theme.darken(track, 22)
                fillC = theme.darken(fill, 18)
                txtC = theme.darken(txt, 50)
            }
        }

        // 轨道（整圈 donut）
        r.setColor(trackC)
        r.fillPie(cx, cy, rOuter, 0.0, 360.0, theme.colorR(trackC), theme.colorG(trackC), theme.colorB(trackC), theme.colorA(trackC))
        r.setColor(bg)
        r.fillCircle(cx, cy, rInner)

        if segVals.len() > 0 {
            // 多段弧（双色环）：自 12 点方向顺时针依次排布，长度 = 占比 × 揭示度 ✓
            //   多片 fillPie 叠画后**只抠一次**内圆 ⇒ 与单段弧同一套 donut 做法 ✓
            // ★ 余量补全（2026-09-30）：各段合计不到 1 时，余量停在 12 点方向、露出**轨道色** ✓
            //   余量明显（看得出"还有一类没算进来"）时这正是想要的效果；但余量只剩一两度时，
            //   它就是一条**发丝缝** —— 浅色主题下 = 一道白缝，且缝宽随数据抖动忽有忽无 ⇒
            //   看着像渲染 bug ✗（实测踩到：清理大师前 3 大类占 99.3% ⇒ 12 点一道 2.5° 白缝）
            //   ⇒ 余量折算成角度 < SEG_SNAP_DEG 时按比例放大各段**补成整圈**（缝消失 ✓）
            //   ⚠ 只在本段"揭示动画"**结束**（segShown == 1）时补：动画中途补会把"长出"的
            //     过程弄没（第一帧就满圈）✗ —— 动画结束时代码会把 segShown 精确置 1.0 ✓
            float segTotal = 0.0
            for segVals to v { segTotal = segTotal + v }
            float segScale = 1.0
            if segShown >= 1.0 and segTotal > 0.0 and segTotal < 1.0 and (1.0 - segTotal) * 360.0 < SEG_SNAP_DEG {
                segScale = 1.0 / segTotal
            }
            float sa = -90.0
            for segVals.len() to si {
                Color sc = fill
                if segCols.len() > 0 { sc = segCols[si % segCols.len()] }
                float span = segVals[si] * segShown * 360.0 * segScale
                if span > 0.01 {
                    r.fillPie(cx, cy, rOuter, sa, sa + span,
                              theme.colorR(sc), theme.colorG(sc), theme.colorB(sc), theme.colorA(sc))
                }
                sa = sa + span
            }
            r.setColor(bg)
            r.fillCircle(cx, cy, rInner)
        } else if _mode == "sweep" {
            // 淡色余辉（亮弧后方 110°）
            Color tail = theme.withAlpha(fillC, 70)
            r.fillPie(cx, cy, rOuter, angle - 110.0, angle, theme.colorR(tail), theme.colorG(tail), theme.colorB(tail), theme.colorA(tail))
            // 亮弧（90°）
            r.fillPie(cx, cy, rOuter, angle, angle + 90.0, theme.colorR(fillC), theme.colorG(fillC), theme.colorB(fillC), theme.colorA(fillC))
            r.setColor(bg)
            r.fillCircle(cx, cy, rInner)
        } else if _mode == "value" and dispVal > 0.0005 {
            // 值弧：12 点方向顺时针
            float a1 = -90.0 + dispVal * 360.0
            r.fillPie(cx, cy, rOuter, -90.0, a1, theme.colorR(fillC), theme.colorG(fillC), theme.colorB(fillC), theme.colorA(fillC))
            r.setColor(bg)
            r.fillCircle(cx, cy, rInner)
        }

        // 中心文字（单行 / 主+副两行）
        if showText and _font != null and _font.ok {
            string label = ""
            if textFn != null { label = _str(textFn()) } else {
                if _mode == "value" { int pct = _int(dispVal * 100.0 + 0.5); label = $"{pct}%" }
            }
            string sub = ""
            if subTextFn != null { sub = _str(subTextFn()) }
            if sub != "" and subFont != null and subFont.ok {
                // 两行模式：主行上移、副行下移，两行共同以圆心为视觉中心 ✓
                //   （若副行仍画在 `cy - _fontH/2`，整体会明显偏高 ⇒ 这里各让一半 ✓）
                if not enabled { txtC = theme.packColor(theme.colorR(txt) / 2, theme.colorG(txt) / 2, theme.colorB(txt) / 2) }
                float yMain = cy - fontH * 0.92
                float ySub = cy + fontH * 0.12
                if label != "" { r.drawTextCentered(_font, label, x, size, yMain, txtC) }
                r.drawTextCentered(subFont, sub, x, size, ySub, theme.withAlpha(txtC, 210))
            } else if label != "" {
                // 单行路径 —— **与改动前逐像素一致** ✓（表达式原样保留，勿动）
                if not enabled { txtC = theme.packColor(theme.colorR(txt) / 2, theme.colorG(txt) / 2, theme.colorB(txt) / 2) }
                r.drawTextCentered(_font, label, x, size, cy - fontH / 2.0, txtC)
            }
        }
    }

    func dispose() {
        if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null
        if subFont != null and subFont.ok { fnt.releaseFont(subFont) }; subFont = null
    }
}

// 工厂
export func createRingProgress(Dict opts): RingProgress {
    RingProgress p = new RingProgress(); p.set(opts); return p
}


