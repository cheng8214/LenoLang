// sdl_scrollview.leno — 通用滚动容器（裁剪视口 + 内容偏移 + 滚轮/拖动滚动条）
//
// 解决的问题：Panel 只会裁剪不会滚动，只有 ListBox/ComboBox 内部自带滚动条。
// ScrollView 持有一个「内容控件」（通常为 VBox/Panel/HBox），内容坐标 (0,0) 映射到
// 可滚动区左上角；视口自动裁剪，悬停滚轮滚动，可拖动右侧/底部滚动条，点击槽翻页。
//
// 滚动是**物理**的（2026-11-27 起是唯一实现，没有开关）：
//   滚轮叠加速度 ⇒ 起步是加速、停下是滑行、撞到边界是弹簧回弹（越界量 ±180px）
//   可调：friction（滚轮每帧保留率，默认 0.88，越小停得越快）/ drag_friction（甩动，默认 0.94）
//   `smooth:true` 已废弃（no-op）：滚轮本来就平滑了，这个键只为兼容老调用方保留 ✓
//   `scroll_by` / `set_scroll` / `ensure_visible` 仍是**精确位移**（程序语义可预期 ✓）
//
// 用法：
//   var sv = win.addScrollView({x:20, y:20, w:300, h:200, content_w:300, content_h:800})
//   var box = SDL3.createVBox({pad_x:10, pad_y:10, spacing:8})   // 用 createXxx，不要 win.add
//   box.add(SDL3.createButton({text:"A"}), {})
//   sv.set_content(box)
//
// 注意：内容控件不要单独 win.add，否则会被窗口与 ScrollView 双重处理。
//       content_w/h 不传时，自动取内容控件的自然尺寸（即内容多大就滚多远）。
import "sdl_widget.leno" as wgt; use wgt.(Widget, Tickable)
import "sdl_opts.leno" as dochk    // 选项对账：不认识的键会报一行警告（见 sdl_opts.leno ✓）
import maths          // clamp / max / abs（2026-11-01 起不再手写，私有 fabs 已删 ✓）
import "sdl_event.leno" as evt; use evt.Event
import "sdl_renderer.leno" as ren; use ren.Renderer
import "sdl_core.leno" as core; use core.SDL_Rect
import "sdl_layout.leno" as lay; use lay.HBox; use lay.VBox; use lay.AnchorBox
import "sdl_gridlayout.leno" as grd; use grd.GridLayout
import "sdl_scrollphys.leno" as sph; use sph.ScrollPhys   // 物理滚动内核（与 ListBox/Table/… 共用 ✓）
import "sdl_animator.leno" as ani; use ani.Tween         // 滚动条折叠/展开渐变 ✓
import "sdl_edit.leno" as edt; use edt.Edit
import "sdl_panel.leno" as pnl; use pnl.Panel
import "sdl_theme.leno" as theme; use theme.Theme
use theme.Color


// ★ 2026-10-13：补 `Themeable` —— 本控件以前**只有 `impl Widget`** ✗，
//   于是 `Window.applyThemeAll` 那条类型表里没有它，**切主题时滚动区完全不响应** ✗
//   （底色/边框/滚动条全停在建时的旧主题色 ✓）；内容控件靠 `lay.applyThemeChild` 继续下钻 ✓
export struct ScrollView impl Widget, Themeable, Tickable {
    float x = 0.0, y = 0.0, w = 300.0, h = 200.0
    float _contentW = -1.0, _contentH = -1.0   // 可滚动内容虚拟尺寸
    Widget? _content                       // 内部内容控件（通常 VBox/Panel）
    pri float scrollX = 0.0, scrollY = 0.0        // 当前滚动偏移
    // 每格滚轮滚动像素（`step` 选项可调）。默认 48 ≈ Windows「3 行」惯例（~16px/行 ✓）；
    // 早先的 24px 明显偏小 ⇒ 用户体感"滚了轮子只走一点点、得使劲滚" ✗
    pri float step = 48.0
    // ★ 2026-11-27：`smooth` 选项**已废弃**（no-op）——滚轮现在一律走速度物理，本来就是平滑的 ✓
    //   键名保留只为不让下游（Aria 8 处 / leno_gui 4 处）因"不认识键"刷警告；新代码别传了 ✓
    pri float syncedX = 0.0, syncedY = 0.0  // 上次 `_sync` 应用过的位置（位置变了要重做 ⇒ 见 _sync 注释）

    // 外观
    pri Color bgColor = #262830FF
    pri Color bdrColor = #505A64FF
    pri Color sbColor = #787D8CFF           // 滚动条颜色
    // ---- 观感（与 VirtualGrid 同一套选项，名字一致）----
    //   bar_auto_hide：鼠标不在视口内时只留一根 3px 提示条，移进来才展开 ✓
    //   bar_hover_color：悬停/拖动时的深色（0 = 按 sbColor 自动加深 28）
    pri bool barAutoHide = true
    pri Color barHoverColor = #00000000
    pri float radius = 8.0
    pri int brdA = 200
    bool _drawBorder = true

    // 滚动条
    pri float barW = 12.0
    pri int dragV = 0, dragH = 0         // 0 无 / 1 拖动中
    pri float dragOffV = 0.0, dragOffH = 0.0
    pri float vThumbY = 0.0, vThumbH = 0.0      // 竖直滚动条拇指几何（每帧计算）
    pri float hThumbX = 0.0, hThumbW = 0.0      // 水平滚动条拇指几何

    // ★ 2026-11-21：**触摸拖动滚动 + 惯性**（Android 上唯一的滚动手势）
    //   为什么必须加：手机上既没有滚轮，也抓不住 12px 宽的滚动条 ⇒ 原来列表/表格**完全滚不动**。
    //   只对"手指"生效（`ev.isTouchLike()`）：桌面鼠标左键拖动有别的语义，不能抢 ✓
    //   panSt：0 空闲 / 1 按下了但还没超过阈值（保持子控件的点击不受影响）/ 2 拖动中
    pri int panSt = 0
    pri float panX0 = 0.0, panY0 = 0.0          // 按下点（判阈值用）
    pri float panLastX = 0.0, panLastY = 0.0    // 上一拍位置（算增量）
    pri float panThr = 6.0                      // 起拖阈值：小于它算点击（否则子按钮点不动 ✗）
    pri int panNs = 0                           // 上一次 move 的时刻（算拖动速度 px/s 用）

    // ★ 2026-11-27：**物理滚动** —— 唯一实现（老路径已删，见文件末尾的迁移记录）
    //   位置仍由本控件持有（`scrollX/scrollY`，夹在 [0, vmax]），
    //   速度 / 越界量 / 时钟全部交给共享内核 `ScrollPhys`（见 sdl_scrollphys.leno）：
    //     · 每帧按 **dt** 解析积分 ⇒ 60Hz 与 144Hz 走同样远
    //     · 滚轮/甩动只叠加速度，不直接改位置 ⇒ 连续滚轮累积成"一次飞" ✓
    //     · 撞界 ⇒ 多余位移折减成越界量、速度交给弹簧（欠阻尼 ⇒ 顶到边界有"呼吸" ✓）
    //   ⚠ 单位：内核里的速度是 **px/秒**（不是 px/帧）—— 老实现那个 px/帧 的 `panV` 已删
    pri ScrollPhys phys
    // ★ 2026-11-27：**纵向滚轮是否允许被横向条"劫持"**（拿去做横滚）
    //   默认 false：鼠标停在横滑条上时，普通滚轮**穿过**给外层的纵向滚动 —— 否则整页滚不动 ✗
    //   需要"横滑条也能用滚轮横滚"的地方（卡片墙单独一屏、没有纵向可滚）显式传 `wheel_cross: true`
    pri bool wheelCross = false
    // ★ 2026-11-27：滚动条**折叠/展开渐变**（0 = 3px 细条、1 = 完整轨道+手柄）
    //   以前是 3px ↔ barW 硬跳，鼠标扫过滚动条那一下"啪"地变粗 ✗
    pri Tween barA

    pri bool autoW = false, autoH = false      // 自动内容尺寸标志（content_w/h < 0 时启用）
    // ── 内容尺寸「跟随视图」（自适应布局用 ✓）──
    //   `fit_w`：内容宽 = 视图宽 − 滚动条宽（= 旧写法 `content_w: w - 12` ✓，但会**跟着窗口变**）
    //   `fit_h`：内容高 = max(实测高, 视图高) ⇒ 内容不满一屏时也撑满 ⇒ 内容里的 `grow` 子项
    //     才有"多余空间"可分配（没有它，VBox 的自然高=各子项之和 ⇒ grow 拿不到空间 ✗）
    //   与 `content_w/h < 0` 的自动测量互斥：`fit_w` 优先（此时 `_autoW` 不再启用 ✓）
    pri bool fitW = false, fitH = false
    bool _loaded = false, enabled = true, visible = true
    pri Ptr[u8]? hwnd
    pri int frameSynced = -1   // _sync() 帧内去重：记录已同步的帧号，-1 表示从未同步
    // 上一次"已同步过"的自身尺寸：窗口缩放时滚动位置没变，但**内容尺寸必须按新视图尺寸重算** ✗
    //   （只比滚动位置的去重会让内容停在旧宽度 ⇒ 画面"还原后没变"，用户实测 ✓）
    pri float syncedW = -1.0, syncedH = -1.0
    // ★ 2026-11-01 反哺：视口尺寸「布局版本号」—— 每次 `set_size` 把 w/h **真的**改了就 +1 ✓
    //   为什么需要：虚拟滚动 / 自适应列数这类"内容按视口大小决定铺多少"的用法，只能靠轮询拿
    //   视口尺寸；而"高度变了没有"没法安全地拿 `get_h()` 自己比（重建后新对象、首帧还是构造时的
    //   初始高 ⇒ 比出来"没变"，于是下面几行一直是空行槽 ✗）。有了版本号：
    //       `if sv.get_layout_epoch() != seen { seen = ...; 重排 }`
    //   一行判断即可，不必自己缓存/猜视口高（Aria 精选页"窗口放大后半屏空白"就是这么修的 ✓）
    pri int layoutEpoch = 0
    // 事件派发的「视口裁剪」状态（渲染有 `pushClipRect`，派发也必须有一份对应的闸门 ⇒ 见 process ✓）
    pri bool innerDown = false   // 视口内按下且还没松手 ⇒ 期间一律照转（拖出视口也不会卡住 pressed ✓）
    pri bool mouseIn = false     // 上一拍指针在不在视口内（刚离开时补一次 motion ⇒ 子控件清 hover ✓）
    // ★ 2026-11-01 修：指针在**滚动条槽**内也算「悬停本控件」✓
    //   bug（Aria「发现/精选」实测抓到）：滚动条是否展开原先只看 `mouseIn`，而 `mouseIn` 由
    //   `inView()` 决定，`inView()` 又**扣掉了右侧那条 barW 宽的槽**（槽是给滚动条用的）⇒
    //   鼠标一挪进槽里 `inside` 就变 false ⇒ 滚动条当场折叠回 3px 细线 ⇒ 想拖它得先精确摸到
    //   那根线（并且按下去才展开）✗ 体感"滚动条躲鼠标"。
    //   语义：`mouseIn` = 指针在**内容区**（决定内容 hover 下钻，保持不变 ✓）；
    //         `barHover` = 指针在内容区**或**滚动条槽（只决定滚动条展开/变深 ✓）。
    pri bool barHover = false
    // 视口裁剪矩形：**分配一次复用**（2026-10-25：原来每帧 malloc 且没 free ✗）
    pri SDL_Rect clipR
    pri bool clipInit = false


    func set(Dict opts) {
        Theme th = theme.getTheme()
        bgColor = th.bg
        bdrColor = th.border
        sbColor = th.sb
        x = opts.get("x", 0)
        y = opts.get("y", 0)
        w = opts.get("w", 300)
        h = opts.get("h", 200)
        radius = opts.get("radius", 8.0)
        if opts.get("bg_color") is Color => t { bgColor = t }
        if opts.get("border_color") is Color => t { bdrColor = t }
        // 滚动条颜色（默认取主题 `th.sb`）。浅色页面 + 深色默认主题时必须能显式指定，
        // 否则一条深灰滚动条压在浅底上很突兀 ✗（本示例就是这种情况 ✓）
        if opts.get("bar_color") is Color => t { sbColor = t }
        brdA = opts.get("border_alpha", 200)
        _drawBorder = opts.get("border", true)
        // ⚠ `content_h` 必须 **≥ 内容的自然高**，否则底部那一截**永远滚不到**：
        //   实测（test_scroll_physics）：30 行共 1272px、却写了 content_h:1200
        //   ⇒ vmax = 1200 − 300 = 900 ⇒ 最后一行只能"冒头"，怎么滚都看不全 ✗
        //   （不是控件 bug：滚动上限就是按你给的 content_h 算的）
        //   ⇒ 内容高不确定时**别传 content_h**，交给它第一帧自动量 ✓（content_w 同理）
        _contentW = opts.get("content_w", -1.0)
        _contentH = opts.get("content_h", -1.0)
        fitW = opts.get("fit_w", false)
        fitH = opts.get("fit_h", false)
        if fitW { _contentW = w - barW }       // 立即可用（不必等首帧 _sync ✓）
        step = opts.get("step", 48.0)          // 每格滚轮步长（默认 48 ≈ 平台惯例 ✓）
        wheelCross = opts.get("wheel_cross", false)   // 纵向滚轮是否允许横滚（默认否，见字段注释 ✓）
        // ★ 2026-11-27：`smooth` **不再读取**（物理滚动是唯一行为 ⇒ 本来就平滑，见字段注释）。
        //   键仍在白名单里 ⇒ 老调用方不会因为"不认识键"刷警告，但传了也不起作用 ✓
        // `friction`/`drag_friction` 是**每帧**（60fps 基准）速度保留率：
        //   越小停得越快（0.85 很"黏"、0.96 很"飘"）；τ 的换算与钳位在内核里 ✓
        phys.set_friction(opts.get("friction", 0.88), opts.get("drag_friction", 0.94))
        barAutoHide = opts.get("bar_auto_hide", true)
        // 滚动条宽度（默认 12）：浮层/小面板里 12 太粗，可调到 6~8 ✓
        barW = opts.get("bar_w", 12.0)
        if barW < 3.0 { barW = 3.0 }
        if opts.get("bar_hover_color") is Color => hc { barHoverColor = hc }
        scrollX = 0.0; scrollY = 0.0
        enabled = opts.get("enabled", true)
        visible = opts.get("visible", true)
        _loaded = true
    }

    // 绑定窗口句柄：记录自身，并下发给需要它的内容控件（如含 Edit 的布局）
    // 委托给 sdl_layout 的统一函数，确保所有容器类型都能正确传递
    func _bind_window(Ptr[u8] hwnd) {
        self.hwnd = hwnd      // 形参遮蔽字段 ⇒ 必须显式 self.
        Widget c = _content
        if c is Widget { lay.passWindowHandle(c, hwnd) }
    }

    // 设置内容控件（单一）。content_w/h 未指定时自动测算内容尺寸
    func set_content(Widget c): Widget {
        _content = c
        // ⚠ 这里**只标记**"自动测量"，**不要**当场量：内容子控件通常是 `set_content` **之后**才逐个
        //   `add` 进来的 ⇒ 此刻量到的自然尺寸是 0（VBox 空的时候 measure_h 就返回 0 ✗），
        //   于是"内容高度 = 0"被当成事实 ⇒ `set_scroll` 立刻被钳成 0 且之后测量出来也回不去 ✗。
        //   交给第一帧 `_syncContent` 去量（它每帧都会重量 ✓）—— 实测踩过这个坑 ✓
        if _contentW < 0.0 and c != null { autoW = true }
        if _contentH < 0.0 and c != null { autoH = true }
        scrollX = 0.0; scrollY = 0.0
        if c != null and hwnd != null { _bind_window(hwnd) }
        return c
    }
    func set_content_size(float cw, float ch) { autoW = false; autoH = false; _contentW = cw; _contentH = ch; clampScroll() }

    // 测量内容控件的自然尺寸（供自动内容尺寸用）
    // VBox/HBox/AnchorBox 有 measure_w/measure_h 方法，其他控件回退到 get_w/get_h
    pri func measure_w(Widget c): float {
        switch c {
            case is VBox { return c.measure_w() }
            case is HBox { return c.measure_w() }
            case is AnchorBox { return c.measure_w() }
            case is GridLayout { return c.measure_w() }
        }
        return c.get_w()
    }
    pri func measure_h(Widget c): float {
        switch c {
            case is VBox { return c.measure_h() }
            case is HBox { return c.measure_h() }
            case is AnchorBox { return c.measure_h() }
            case is GridLayout { return c.measure_h() }
        }
        return c.get_h()
    }
    func set_bg_color(Color color) { bgColor = color }

    // ---- 滚动范围与约束 ----
    // ★ 2026-11-01：`if x < 0 then 0` 这类写法统一换成 maths.max / maths.clamp，
    //   私有 fabs 也删了（maths.abs 就是它，单次只贵 0.6ns ✓）
    pri func vmax(): float { return maths.max(0.0, _contentH - h) }
    pri func hmax(): float { return maths.max(0.0, _contentW - w) }
    pri func showV(): bool { return vmax() > 0.0 }
    pri func showH(): bool { return hmax() > 0.0 }
    pri func clampScroll() {
        // ⚠ 内容尺寸**还没测量**时（`_autoH/_autoW` 要等第一帧 `_syncContent` 才量，此前
        //   `_contentH/_contentW == -1`）不要按它钳位：否则"构造完立刻 set_scroll"会被钳成 0，
        //   等测量出来也回不去了 ✗（实测踩过：首帧后上限其实有 167，但 y 已经变 0 ✓）
        if _contentH >= 0.0 {
            scrollY = maths.clamp(scrollY, 0.0, vmax())
        } else if scrollY < 0.0 {
            scrollY = 0.0
        }
        if _contentW >= 0.0 {
            scrollX = maths.clamp(scrollX, 0.0, hmax())
        } else if scrollX < 0.0 {
            scrollX = 0.0
        }
    }
    // ==================== 物理滚动（委托给共享内核 `ScrollPhys`）====================
    //   参数（速度上限 / 弹簧 400·28 / 收尾 20px/s / dt 钳位 / 越界上限）全部在
    //   `sdl_scrollphys.leno` 里，本控件只负责"位置"以及"什么时候推进、什么时候请求重绘" ✓
    pri func kill_motion() { phys.kill() }

    // 手指拖动：1:1 跟手 + 越界弹性（内核 drag 会返回夹好的新位置 ✓）
    pri func drag_by(float ddx, float ddy) {
        var[float, float](nx, ny) = phys.drag(ddx, ddy, scrollX, scrollY, hmax(), vmax())
        scrollX = nx; scrollY = ny
    }

    // 滚轮入口：只**叠加速度**（连续滚轮累积成"一次飞"），不直接改位置 ✓
    pri func wheel_scroll(float dx, float dy) {
        phys.kick(dx, dy)
        core.markFrameRedraw()
        core.requestRedraw()   // 本帧会画，但**下一帧**也得有人要（见 `sync` 顶部那段注释 ✓）
    }

    // 按 **给定 dt（秒）** 推进一次物理。生产路径由 `pump_physics()` 用真实 dt 调用；
    //   单独暴露成方法是为了能验证「帧率无关性」——同一段模拟分别用 1/60、1/144 推进，
    //   最终位置必须一致，靠真实时钟是测不出这一点的 ✓
    func step_physics(float dt) {
        if dt <= 0.0 { return }
        var[float, float](nx, ny) = phys.step(scrollX, scrollY, dt, hmax(), vmax())
        scrollX = nx; scrollY = ny
        core.requestRedraw()
    }

    // ★ 2026-11-27：**每帧推进交给窗口**（Tickable）—— 但**自己仍然请求下一帧**（双保险）：
    //   ⚠ 上一版把这条续帧删掉、全靠窗口，结果 Aria 滚不动 ✗
    //     （窗口那边的 `requestRedraw` 在某些主循环配置下不可靠，控件侧必须自己兜底）
    func tick(float dt): bool {
        if dt <= 0.0 { return false }
        // 先转发给内容控件（视口里放的列表/卡片也可能要推进）
        bool cm = false
        var cc = _content
        if cc is Tickable => tk { if tk.tick(dt) { cm = true } }
        // 跟手期间不积分：位置由 `process` 1:1 改，再叠惯性就"抢方向盘" ✗
        if panSt == 2 { return cm }
        var[float, float](nx, ny) = phys.step(scrollX, scrollY, dt, hmax(), vmax())
        scrollX = nx; scrollY = ny
        bool m = phys.is_moving()
        if m {
            core.markFrameRedraw()
            core.requestRedraw()      // ★ 兜底：不依赖窗口那次汇总请求
        }
        return m or cm
    }

    // 程序化滚动：立即到位。**必须掐掉速度与越界量**，否则"设到 0"之后残余速度
    //   还会把内容又推走（实测：老实现里 set_scroll(0,0) 后一帧变成 8.7 ✗；
    //   物理模式的速度是 px/s，残留一拍就是几十像素 ⇒ 统一走 kill_motion() ✓）
    func set_scroll(float sx, float sy) {
        kill_motion()
        panSt = 0
        scrollX = sx; scrollY = sy
        clampScroll()
    }
    func scroll_to(float sx, float sy) { set_scroll(sx, sy) }

    // 按"滚轮语义"滚动一段相对距离 ⇒ **精确位移**（程序调用的语义必须可预期）。
    //   "飞"只属于滚轮 / 甩动：它们叠加速度，由 `_sync` 的物理积分推进 ✓
    //   （2026-11-27 删掉了 `smooth` 的目标逼近分支：滚轮不再走这里，那套已无入口）
    func scroll_by(float dx, float dy) {
        kill_motion()
        scrollX = scrollX + dx
        scrollY = scrollY + dy
        clampScroll()
        core.markFrameRedraw()
    }

    // 程序化"甩一下"：给一段初速度（px/秒），交给物理积分 ⇒ 自然滑行 + 撞界回弹 ✓
    //   典型用法：点一下"回顶部"按钮给一个负速度，看着像被推回去的（而不是瞬间跳 ✗）
    func fling(float vx, float vy) {
        phys.fling(vx, vy)
        core.markFrameRedraw()
        core.requestRedraw()   // 同上：把"下一帧"预约上 ✓
    }

    // 滚动使内容坐标系中的指定矩形区域可见（常用于「滚动到某控件」）
    // tx/ty 为目标在内容坐标系中的左上角，tw/th 为目标尺寸
    // 若目标已完全在视口内则不动；否则最小幅度滚动使其可见
    func ensure_visible(float tx, float ty, float tw, float th) {
        // 立即到位：取消平滑动画（否则会被旧目标拽回去 ✗）；物理模式下连速度/越界一起掐掉 ✓
        kill_motion()
        float left = scrollX
        float right = scrollX + w
        float top = scrollY
        float bottom = scrollY + h
        if tx < left { scrollX = tx }
        else if tx + tw > right { scrollX = tx + tw - w }
        if ty < top { scrollY = ty }
        else if ty + th > bottom { scrollY = ty + th - h }
        clampScroll()
        core.markFrameRedraw()
    }

    func get_scroll_x(): float { return scrollX }
    func get_scroll_y(): float { return scrollY }
    func get_max_scroll_x(): float { return hmax() }
    func get_max_scroll_y(): float { return vmax() }
    // ★ 2026-11-27：物理状态原来外面完全看不到 ⇒ 自测断言不了、应用也做不了
    //   "滚动中淡出标题栏"这类效果（只能自己再记一份状态 ✗）。补齐：
    //     get_velocity_*  —— px/秒（静止恒 0）
    //     get_overscroll_* —— 弹性越界量（正 = 越过下/右界，负 = 越过上/左界）
    //     is_animating    —— 有没有未收敛的运动（速度 / 回弹任一）
    func get_velocity_x(): float { return phys.velX }
    func get_velocity_y(): float { return phys.velY }
    func get_overscroll_x(): float { return phys.overX }
    func get_overscroll_y(): float { return phys.overY }
    func is_animating(): bool { return phys.is_moving() }

    // 每帧把内容定位到（视口 - 偏移），设定内容尺寸，并刷新滚动条几何
    // 自动内容尺寸模式下，每帧重新测算（子控件可能动态增减）
    // 帧内去重：process 和 render 各调用一次 _sync()，但同一帧只需执行一次
    pri func sync() {
        int cur = core.frameId()
        bool firstThisFrame = (frameSynced != cur)
        // ★ 2026-11-27：**只要还在运动，就每帧再要一帧**（必须放在去重**之前**）
        //   ⚠ 少这一句就是一个真实 bug（用户实测："滚轮动了画面不动、动一下鼠标才动"）：
        //     滚轮加速发生在 `process → sync()` **之后** ——「那一帧」的 `pump_physics` 里速度
        //     还是 0（早退，没请求下一帧）；而同一帧的 render 阶段再调 `_sync` 时
        //     `firstThisFrame` 已是 false ⇒ 推进块被跳过 ⇒ **没有任何人再要下一帧** ✗
        //     ⇒ 事件循环空闲挂起（500ms 超时）⇒ 画面停住，直到鼠标事件把它叫醒 ✗
        //   ⇒ `step_physics` 末尾的 requestRedraw 只在"**已经推进过**"的帧里补请求，
        //     接不上"刚被加速的那一帧" —— 必须在这里（去重之前、每帧都过）兜底 ✓
        if phys.is_moving() { core.requestRedraw() }
        // ⚠ 内容高度**不能**在这里每帧测：虚拟滚动的控件（Aria 发现页）会自己
        //   `set_content_size(虚拟总高)`，每帧 autoH 会把它覆盖成"可见行高度" ⇒ 越测越不能滚 ✗
        //   （实测：改成每帧测之后，发现页 vmax 从 309 掉回 0）
        // ⚠ 去重**不能只看帧号**：同一帧内可能来多个滚轮事件（快速滚 ✗），位置变了就必须重做，
        //   否则渲染用的还是"第一个事件"留下的旧位置 ⇒ 视觉滞后/一顿一顿 ✗（"抽搐"的第二个成因）
        // ⚠ 去重**必须连自身尺寸一起比**：窗口缩放（最大化/还原）时滚动位置没变，但 `fit_w/fit_h`
        //   要按新尺寸重算 `_contentW/_contentH` 并下发 `_content.set_size(...)`；只按"滚动位置没变"
        //   就 return，会让**内容仍按旧宽度排版** ⇒ 画面停在旧样子（而外层的 `w` 已经变了 ⇒
        //   看起来就是"还原后布局没变、要动一下鼠标才恢复" ✗ —— 用户实测抓到 ✓）
        if not firstThisFrame and scrollX == syncedX and scrollY == syncedY and w == syncedW and h == syncedH { return }
        frameSynced = cur
        // ★ 2026-11-27：物理滚动 —— 每帧**按真实 dt** 推进一次（速度/弹簧都在内核里）✓
        //   ⚠ 必须 `firstThisFrame`：同一帧 process + render 各调一次 `_sync`，
        //     推两次就等于 2 倍速度 ✗
        // 推进在 `tick(dt)` 里（窗口每帧调一次）⇒ 这里不再 pump，避免"一帧推两次"✗
        syncedX = scrollX; syncedY = scrollY
        syncedW = w; syncedH = h
        if fitW { _contentW = w - barW }
        if autoW and _content != null { _contentW = measure_w(_content) }
        if autoH and _content != null { _contentH = measure_h(_content) }
        // `fit_h`：内容不满一屏也撑满视图高 ⇒ 内容里的 `grow` 子项才有空间可分 ✓
        //   ⚠ 必须放在**测量之后**：先拿真实自然高，再决定要不要顶到视图高 ✓
        if fitH and _contentH < h { _contentH = h }
        clampScroll()
        computeThumbs()
        // ⚠ 内容定位**取整**：分数偏移会让文字落在半像素上 ⇒ 边缘发虚/闪 ✗（与"裁剪闪烁"同源）
        //   `overX/overY` 是弹性越界量，越界时内容跟手移出视口，
        //   由 render 的裁剪矩形切掉 ⇒ 露出的就是 ScrollView 自己的底色 = 橡皮筋的视觉 ✓
        _content?.set_pos(x - _int(phys.renderX(scrollX)), y - _int(phys.renderY(scrollY)))
        _content?.set_size(_contentW, _contentH)
    }

    pri func computeThumbs() {
        vThumbY = y; vThumbH = h; hThumbX = x; hThumbW = w
        if showV() {
            float gh = if showH() then barW else 0.0
            float trackH = h - gh
            float ratio = if _contentH > 0.0 then h / _contentH else 1.0
            float th = trackH * ratio
            if th < 24.0 { th = 24.0 }
            vThumbH = th
            float maxY = vmax()
            vThumbY = if maxY > 0.0 then y + (scrollY / maxY) * (trackH - th) else y
        }
        if showH() {
            float gw = if showV() then barW else 0.0
            float trackW = w - gw
            float ratio = if _contentW > 0.0 then w / _contentW else 1.0
            float tw = trackW * ratio
            if tw < 24.0 { tw = 24.0 }
            hThumbW = tw
            float maxX = hmax()
            hThumbX = if maxX > 0.0 then x + (scrollX / maxX) * (trackW - tw) else x
        }
    }

    // ---- Widget 接口 ----
    func get_w(): float { return w }
    func get_h(): float { return h }
    // ★ 2026-10-29 反哺：ScrollView 原来只有 get_w/get_h
    //   ⇒ 上层想算"这个滚动区在屏幕上的矩形"（浮层防穿透、拖拽命中）时拿不到坐标 ✗ 补齐 ✓
    func get_x(): float { return x }
    func get_y(): float { return y }
    // ★ 2026-10-29 反哺：内部 `mouseIn` 本来就是"指针在不在视口内"（滚动条显隐靠它），
    //   但没暴露 ⇒ 上层想按"鼠标在滚动区上"做效果只能自己算 ✗ 补齐 ✓
    func is_hover(): bool { return mouseIn }
    // ★ 2026-10-29 反哺：滚动位置与内容高原来是 pri 字段，外面读不到
    //   ⇒ "快到底时自动加载更多"这类需求没法做（除非自己重新记一份状态 ✗）补齐 ✓
    func get_content_h(): float { return _contentH }
    // ★ 2026-11-05 反哺：`fit_w` 算出的**内容宽**（= 视图宽 − 滚动条宽）原来取不到，
    //   上层只能自己写 `content_w: w` ⇒ 内容比视口宽出正好一条滚动条 ⇒ 底部多出一条横向
    //   滚动条（实测：只超 12px，拇指几乎满宽、看着像"莫名其妙的横条"✗）。
    //   上层要让内容跟视口同宽，直接 `get_content_w()` 即可 ✓
    func get_content_w(): float { return _contentW }
    // 是否已接近底部（距底 < margin 就算）
    //   ⚠ 内容高未知（`content_h` 没给、自动测出来之前是 -1）时返回 false，别误触发加载 ✓
    func near_bottom(float margin): bool {
        if _contentH <= 0.0 or _contentH <= h { return false }
        return scrollY + h + margin >= _contentH
    }
    func set_pos(float px, float py) { x = px; y = py }
    func set_size(float sw, float sh) {
        // 布局每帧都会重复调用（值没变），只有**真变化**才推进版本号 ✓
        //   ⚠ 必须在这里判、不能延到 `_sync`：`_sync` 自己去重时会提前 return，且它拿不到
        //     "布局前"的旧尺寸 ⇒ 版本号会漏拍（虚拟列表就还是看不到"视口变高了"✗）
        if sw != w or sh != h {
            layoutEpoch = layoutEpoch + 1
            // 视口尺寸变了 ⇒ 可滚范围也变了，残留的弹性越界量没有意义（还会把内容顶出视口 ✗）
            //   ⚠ 只在**真的变了**时清：布局每帧都调 set_size（值相同），无条件清会把回弹打断 ✗
            phys.overX = 0.0; phys.overY = 0.0; phys.overVelX = 0.0; phys.overVelY = 0.0
        }
        w = sw; h = sh
        // 视图尺寸变了 ⇒ `fit_w` 的内容宽立刻跟着变（不必等下一帧 `_sync` ✓）
        if fitW { _contentW = w - barW }
        clampScroll()
    }
    // 视口布局版本号（见字段注释）：虚拟滚动/自适应布局在轮询里比对它即可知道"该重排了" ✓
    func get_layout_epoch(): int { return layoutEpoch }
    func set_enabled(bool e) { enabled = e }
    func set_visible(bool v) { visible = v }
    func is_visible(): bool { return visible }
    func contains(float mx, float my): bool {
        return mx >= x and mx <= x + w and my >= y and my <= y + h
    }

    // 点是否在**可见内容区**内（视口扣除滚动条槽 ⇒ 与 render 的裁剪矩形逐位一致 ✓）
    pri func inView(float mx, float my): bool {
        float gw = if showV() then barW else 0.0
        float gh = if showH() then barW else 0.0
        return mx >= x and mx <= x + w - gw and my >= y and my <= y + h - gh
    }

    // 点是否在滚动条槽内（竖直右槽 / 水平底槽）
    pri func onGutter(float mx, float my): bool {
        if showV() {
            float gw = barW
            if mx >= x + w - gw and mx <= x + w and my >= y and my <= y + h { return true }
        }
        if showH() {
            float gh = barW
            if my >= y + h - gh and my <= y + h and mx >= x and mx <= x + w { return true }
        }
        return false
    }

    pri func scrollbarDown(float mx, float my) {
        if showV() {
            float tx0 = x + w - barW
            if mx >= tx0 and mx <= x + w {
                if my >= vThumbY and my <= vThumbY + vThumbH {
                    dragV = 1; dragOffV = my - vThumbY
                } else {
                    float gh = if showH() then barW else 0.0
                    float page = (h - gh) * 0.9
                    kill_motion()          // 翻页是"立即到位"⇒ 先把惯性/平滑掐掉（否则翻完又被拽走 ✗）
                    if my < vThumbY { scrollY = scrollY - page } else { scrollY = scrollY + page }
                    clampScroll()
                }
                return
            }
        }
        if showH() {
            float ty0 = y + h - barW
            if my >= ty0 and my <= y + h {
                if mx >= hThumbX and mx <= hThumbX + hThumbW {
                    dragH = 1; dragOffH = mx - hThumbX
                } else {
                    float gw = if showV() then barW else 0.0
                    float page = (w - gw) * 0.9
                    kill_motion()          // 同上：翻页立即到位
                    if mx < hThumbX { scrollX = scrollX - page } else { scrollX = scrollX + page }
                    clampScroll()
                }
                return
            }
        }
    }

    pri func scrollbarDrag(float mx, float my) {
        kill_motion()             // 拖动滚动条必须 1:1 跟手 ⇒ 平滑动画与惯性速度一起取消 ✓
        if dragV == 1 {
            float gh = if showH() then barW else 0.0
            float trackH = h - gh
            float maxY = vmax()
            if trackH - vThumbH > 0.0 { scrollY = (my - dragOffV - y) / (trackH - vThumbH) * maxY }
            clampScroll()
        }
        if dragH == 1 {
            float gw = if showV() then barW else 0.0
            float trackW = w - gw
            float maxX = hmax()
            if trackW - hThumbW > 0.0 { scrollX = (mx - dragOffH - x) / (trackW - hThumbW) * maxX }
            clampScroll()
        }
    }

    func process(Event ev) {
        if not _loaded or not enabled or not visible { return }
        // 失焦兜底：拖拽中途 Alt+Tab / 切走窗口会**丢掉 up 事件** ⇒ 捕获状态必须归零，
        //   否则 `innerDown` 永远为真、闸门永久敞开（= 这篇修复白做 ✗）
        if ev.isWindowFocusLost() { innerDown = false; mouseIn = false; barHover = false
            panSt = 0; phys.velX = 0.0; phys.velY = 0.0 }   // ★ 丢 up 事件 ⇒ 拖动状态也要归零（否则"粘手" ✗）
        sync()
        // 滚动条交互优先于内容
        if ev.isMouseButtonDown() and ev.mouseButton() == 1 {
            var[float, float](_dx, _dy) = ev.mousePos()
            if onGutter(_dx, _dy) {
                barHover = true                 // 按在槽里 ⇒ 本次操作期间滚动条保持展开 ✓
                scrollbarDown(_dx, _dy)
                return
            }
        }
        if ev.isMouseButtonUp() and ev.mouseButton() == 1 {
            if dragV != 0 or dragH != 0 {
                dragV = 0; dragH = 0
                // 松手后指针通常还停在槽里（拖完就在原地）⇒ 悬停标记按实际位置重算，
                //   否则"松手就折叠、动一下才展开"（同一类体感问题 ✓）
                var[float, float](_ux, _uy) = ev.mousePos()
                barHover = onGutter(_ux, _uy)
                core.markFrameRedraw()
                return
            }
        }
        if ev.isMouseMotion() and (dragV != 0 or dragH != 0) {
            var[float, float](_dx2, _dy2) = ev.mousePos(); scrollbarDrag(_dx2, _dy2); core.markFrameRedraw(); return
        }
        // ★ 2026-11-21：**手指按住内容拖动 = 滚动**（手机上唯一的滚动手势）
        //   拖动阈值 panThr：手指轻微抖动不算拖（否则列表行/按钮就"点不中"了 ✗）
        if ev.isTouchLike() {
            if ev.isMouseButtonDown() and ev.mouseButton() == 1 {
                var[float, float](px0, py0) = ev.mousePos()
                if px0 >= x and px0 <= x + w and py0 >= y and py0 <= y + h {
                    panSt = 1; panX0 = px0; panY0 = py0
                    panLastX = px0; panLastY = py0
                    // 按下就接管方向盘 ⇒ 残余速度必须掐掉（越界量留着，手指从当前位置接手 ✓）
                    phys.velX = 0.0; phys.velY = 0.0; panNs = 0
                    return
                }
            } else if ev.isMouseMotion() and panSt != 0 {
                var[float, float](pmx, pmy) = ev.mousePos()
                if panSt == 1 {
                    float jx = maths.abs(pmx - panX0)
                    float jy = maths.abs(pmy - panY0)
                    if jx > panThr or jy > panThr { panSt = 2 }
                }
                if panSt == 2 {
                    float ddx = pmx - panLastX
                    float ddy = pmy - panLastY
                    panLastX = pmx; panLastY = pmy
                    // 手指上移（ddy<0）⇒ 内容跟着上移 ⇒ 偏移增大 ✓（与滚轮同号约定）
                    // 位移**1:1 跟手 + 越界弹性**（drag_by），速度按 move 事件的
                    //   **真实时间差**算成 px/s（不是 px/帧）⇒ 帧率无关 ✓
                    //   ⚠ 松手后由 `pump_physics` 按 dt 积分（不是每帧乘固定系数 ✗）
                    int nowNs = core.getTicksNS()
                    float dts = 0.0166667
                    if panNs != 0 {
                        int dn = nowNs - panNs
                        if dn > 0 {
                            dts = _float(dn) / 1000000000.0
                            if dts < 0.002 { dts = 0.002 }     // 同一毫秒多个 move：别除出天量速度 ✗
                            if dts > 0.1 { dts = 0.1 }
                        }
                    }
                    panNs = nowNs
                    phys.velY = maths.clamp(-ddy / dts, -4000.0, 4000.0)
                    phys.velX = maths.clamp(-ddx / dts, -4000.0, 4000.0)
                    phys.velDrag = true
                    drag_by(ddx, ddy)
                    core.markFrameRedraw()
                    return
                }
            } else if ev.isMouseButtonUp() and panSt != 0 {
                bool wasPan = (panSt == 2)
                panSt = 0
                if wasPan {
                    // 惯性交给 `sync()` 逐帧推进（这里只负责"松手"）
                    core.markFrameRedraw()
                    return
                }
            }
        }
        // 滚轮：悬停视口内才滚动
        if ev.isMouseWheel() {
            float wx = ev.wheelMouseX(), wy = ev.wheelMouseY()

            if wx >= x and wx <= x + w and wy >= y and wy <= y + h {
                if showH() and maths.abs(ev.wheelX()) > maths.abs(ev.wheelY()) {
                    wheel_scroll(-ev.wheelX() * step, 0.0)
                } else if showV() {
                    // 滚轮语义：wheelY > 0 = 向上/远离用户 ⇒ 内容往下看 ⇒ 偏移减小 ✓
                    // 走 `wheel_scroll` ⇒ 物理模式叠加速度（"飞"）、老模式精确位移 ✓
                    wheel_scroll(0.0, -ev.wheelY() * step)
                } else if showH() and ev.wheelX() != 0.0 {
                    // ★ 2026-11-27：**纵向滚轮不再被横向条劫持**
                    //   原来（2026-10-13）这里无条件把纵向滚轮拿去横滚 —— 于是鼠标只要停在
                    //   某个横滑条（首页"继续听"、歌单横滑）上，**整页滚轮就没反应** ✗
                    //   （Aria 用户实测：首页怎么滚都不动，拖滚动条却正常）
                    //   现在只有**真的横向滚轮**（触摸板横滑 / Shift+滚轮）才横滚 ✓
                    //   ⚠ 代价：只放了一个横滑条、周围没有纵向滚动时，普通滚轮不再横滚 ——
                    //     需要那种行为的地方显式传 `wheel_cross: true`（走下面的兜底分支）
                    wheel_scroll(-ev.wheelX() * step, 0.0)
                } else if showH() and wheelCross {
                    wheel_scroll(-ev.wheelY() * step, 0.0)
                }
            }
        }
        // 键盘导航：悬停视口时 PageUp/Down 翻页、Home/End 跳首尾
        if ev.isKeyDown() {
            var[float, float](kx, ky) = ev.mousePos()
            if kx >= x and kx <= x + w and ky >= y and ky <= y + h {
                int sc = ev.scancode()
                // 键盘翻页一律**立即到位** ⇒ 先掐掉一切运动（物理模式的速度不掐会接着飘 ✗）
                if sc == 78 {  // PageDown
                    kill_motion()
                    scrollY = scrollY + h * 0.9; clampScroll(); core.markFrameRedraw(); return
                }
                if sc == 75 {  // PageUp
                    kill_motion()
                    scrollY = scrollY - h * 0.9; clampScroll(); core.markFrameRedraw(); return
                }
                if sc == 74 {  // Home
                    kill_motion()
                    scrollY = 0.0; scrollX = 0.0; core.markFrameRedraw(); return
                }
                if sc == 77 {  // End
                    kill_motion()
                    scrollY = vmax(); scrollX = hmax(); core.markFrameRedraw(); return
                }
            }
        }
        // ★★ 内容事件**必须按视口裁剪**（2026-10-25 修）：渲染有 `pushClipRect`，派发却一直是无条件
        //   转发 ⇒ 滚动后内容被 `set_pos(y - _int(scrollY))` 整体上移，**移出视口的那些行只是画不出来、
        //   命中判定照旧按绝对坐标** ⇒ 鼠标在标题栏/顶栏上划，底下那张"幽灵卡片"照样 hover / 被点开 ✗
        //   （海报墙实测：下滚后点标题栏居然进了详情页 ✓）
        //   规则与桌面的"鼠标捕获"一致：
        //     ① 指针在视口内 ⇒ 照转；
        //     ② 视口内**按下后**一直在转（拖到视口外也不断）⇒ 子控件能收到 up，不会卡在 pressed ✗；
        //     ③ 刚离开视口那一下**补转一次 motion** ⇒ 视口内原有的 hover 能收到"指针不在了"自行清掉 ✓
        //        （否则 hover 高亮会一直粘在最后划过的那张卡上 ✗）
        //   ⚠ 键盘/文本事件**不闸**：Edit 在滚动区里输入时光标可能不在自己身上（如滚轮把视口挪走）✓
        var[float, float](_mx, _my) = ev.mousePos()
        if ev.isMouseWheel() { _mx = ev.wheelMouseX(); _my = ev.wheelMouseY() }
        bool isMouse = ev.isMouseMotion() or ev.isMouseButtonDown() or ev.isMouseButtonUp() or ev.isMouseWheel()
        if not isMouse {
            _content?.process(ev)
            return
        }
        bool inside = inView(_mx, _my)
        bool captured = innerDown
        if ev.isMouseButtonUp() { innerDown = false }
        if ev.isMouseButtonDown() and inside { innerDown = true }
        if not inside and not captured {
            bool wasIn = mouseIn
            if wasIn {
                mouseIn = false
                core.markFrameRedraw()          // 折叠滚动条：离开时也要刷一次 ✓
            }
            // ★ 指针虽然不在内容区（`inView` 把滚动条槽扣掉了），但可能正停在槽上 ⇒
            //   滚动条必须**保持展开**，否则"移进去展开、挪到滚动条上立刻缩成线"，拖之前先得摸线 ✗
            bool gIn = onGutter(_mx, _my)
            if gIn != barHover {
                barHover = gIn
                core.markFrameRedraw()
            }
            if ev.isMouseMotion() and wasIn { _content?.process(ev) }   // 离开视口：补一次 ⇒ 清 hover ✓
            return
        }
        // 拖动中即使指针移出视口也算"还在操作"⇒ 滚动条保持展开（否则拖到一半缩回去 ✗）
        bool nowIn = inside or innerDown
        if nowIn != mouseIn {
            mouseIn = nowIn
            core.markFrameRedraw()
        }
        // 指针在内容区内 ⇒ 构造上不可能同时落在槽上（`inView` 与 `onGutter` 互斥）⇒ 清槽悬停 ✓
        if barHover {
            barHover = false
            core.markFrameRedraw()
        }
        _content?.process(ev)
    }

    // 滚动条：悬停/拖动 ⇒ 展开成「轨道 + 手柄」并变深；否则（默认）折叠成一根 3px 提示条
    pri func drawScrollbars(Renderer r) {
        // `barHover`：指针停在滚动条槽上（见字段注释）⇒ 与"在内容区里"同样算悬停 ✓
        bool hot = mouseIn or barHover or dragV != 0 or dragH != 0
        // ★ 2026-11-27：折叠/展开**渐变**（ba：0 = 3px 细条、1 = 完整轨道 + 手柄）
        //   以前 `fold` 是布尔 ⇒ 鼠标一进就 3px→12px 硬跳，观感"咔"✗
        barA.set_target(if hot then 1.0 else 0.0)
        if barA.pump() { core.requestRedraw() }
        float ba = if barAutoHide then barA.value() else 1.0
        Color track = sbColor
        if hot {
            track = if theme.colorA(barHoverColor) > 0 then barHoverColor
                    else theme.darken(sbColor, 45)
        }
        int faintA = theme.colorA(track) / 2
        Color faint = (faintA << 24) | (track & 0x00FFFFFF)
        float gw = 3.0 + (barW - 3.0) * ba
        float gh = gw
        if showV() {
            float innerH = h - (if showH() then gh else 0.0)
            // ⚠ 三条（细条 / 轨道 / 手柄）必须**共用同一个左边界**，否则渐变期间会露出两条并排的竖条
            //   （错位 2px 时肉眼就是"手柄不居中"✗ —— 2026-11-27 用户实测抓到）
            //   口径：右边缘固定 = `x + w - 2`，宽度 = gw（3 → barW），手柄是轨道内缩 2px ✓
            float bx = x + w - gw - 2.0
            // 细条永远画（宽度跟着 ba 长）—— 让人知道"这里能滚"，又不抢视线 ✓
            r.setColor(faint)
            r.fillRoundedRect(bx, y + 2.0, gw, innerH - 4.0, gw / 2.0)
            // 展开的部分（轨道 + 手柄）：靠 alpha 淡入，ba≈0 时完全看不见 ✓
            if ba > 0.01 {
                int ta = _int(255.0 * ba)
                r.setColor(theme.withAlpha(track, ta))
                r.fillRoundedRect(bx, y, gw, innerH, gw / 2.0)
                if gw > 6.0 {
                    r.setColor(theme.withAlpha(theme.brighten(track, 40), ta))
                    r.fillRoundedRect(bx + 2.0, vThumbY, gw - 4.0, vThumbH, (gw - 4.0) / 2.0)
                }
            }
        }
        if showH() {
            float innerW = w - (if showV() then gw else 0.0)
            // 同理：底边缘固定 = `y + h - 2`，handle/轨道/细条都从这里算 ✓
            float by = y + h - gh - 2.0
            float bw = innerW - 4.0
            r.setColor(faint)
            r.fillRoundedRect(x + 2.0, by, bw, gh, gh / 2.0)
            if ba > 0.01 {
                int ta2 = _int(255.0 * ba)
                r.setColor(theme.withAlpha(track, ta2))
                r.fillRoundedRect(x + 2.0, by, bw, gh, gh / 2.0)
                if gh > 6.0 {
                    r.setColor(theme.withAlpha(theme.brighten(track, 40), ta2))
                    r.fillRoundedRect(hThumbX + 2.0, by + 2.0, hThumbW - 4.0, gh - 4.0, (gh - 4.0) / 2.0)
                }
            }
        }
    }

    // ==================== 运行时主题切换 ====================
    //   底色 / 边框 / 滚动条三色都从主题重取（本控件以前**不在** `applyThemeAll` 的名单里 ✗）
    //   内容控件交给递归出口继续下钻：`_content` 通常是 VBox/Panel，里层还有一堆控件 ✓
    func applyTheme(Theme t) {
        bgColor = t.bg
        bdrColor = t.border
        sbColor = t.sb
        var c = _content
        if c is Widget { lay.applyThemeChild(c, t) }
        core.markFrameRedraw()
    }

    func render(Renderer r) {
        if not _loaded or not enabled or not visible { return }
        sync()
        // 背景
        r.setColor(bgColor)
        r.fillRoundedRect(x, y, w, h, radius)
        // 裁剪到视口（扣除滚动条槽，避免内容画到槽下）
        //   ★ 2026-10-25：两条"裁剪成本"优化（视觉逐像素不变 ✓）
        //     ① 内容**不满一屏**（无滚动条）⇒ 构造上不可能溢出 ⇒ 不裁剪、不 flush
        //        （短内容页面每帧省 2 次 batch 提交 + 2 次 SetRenderClipRect）
        //     ② 裁剪矩形**分配一次复用**（原来每帧 SDL_Rect.malloc + 无对应 free ✗ 还漏了）
        if not showV() and not showH() {
            var c0 = _content
            c0?.render(r)
        } else {
            float gw = if showV() then barW else 0.0
            float gh = if showH() then barW else 0.0
            if not clipInit { clipR = SDL_Rect.malloc(); clipInit = true }
            clipR.x = _int(x); clipR.y = _int(y)
            clipR.w = _int(w - gw) + 1; clipR.h = _int(h - gh) + 1   // +1 覆盖浮点截断的亚像素
            r.pushClipRect(clipR.to_ptr())
            _content?.render(r)
            r.popClipRect()
        }
        // 滚动条（最上层）
        drawScrollbars(r)
        // 边框
        if _drawBorder {
            r.setColor(theme.withAlpha(bdrColor, brdA))
            r.drawRoundedRect(x, y, w, h, radius)
        }
    }

    func dispose() {
        _content?.dispose()
        if clipInit { clipR.free(); clipInit = false }
    }
}

// 工厂
export func createScrollView(Dict opts): ScrollView {
    ScrollView s = new ScrollView(); s.set(opts); return s
}

// ==================== 迁移记录 ====================
// 2026-11-27：删除"老滚动行为"，物理滚动成为唯一实现。删掉的东西（别再从历史版本搬回来）：
//   · `panV/panH`（px/帧）+ `sync()` 里每帧 ×0.86、`|v| < 0.4` 硬停的触摸惯性块
//   · `smooth` 的"目标位置 + 每帧 ×0.4 指数逼近"（连带 `targetX/targetY`、`clampTarget()`）
//   · 给指数逼近打补丁的三处特判：方向反转就立即到位、落后 2.5 格就立即到位、撞边把速度归零
//   · `physics` / `usePhysics` 开关本身（不再有两套行为可切）
// 为什么可以删：新模型里"反向"只是速度相消、"撞边"由弹簧接管，那些特判在结构上就不存在了 ✓
// 兼容面：
//   · `smooth` 键保留为 **no-op**（下游 Aria 8 处 / leno_gui 4 处不用改，也不会刷"不认识键"）
//   · 变的是三处**观感**：滚轮一格从 48px 变成约 66px、惯性与尾巴更长、撞界会回弹
//   · 不变的是**程序语义**：`scroll_by` / `set_scroll` / `ensure_visible` 仍是精确位移 ✓


