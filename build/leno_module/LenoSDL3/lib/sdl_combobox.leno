// sdl_combobox.leno — 下拉框控件（点击展开列表选择，回调 on_change(int)）
import maths
import "sdl_opts.leno" as dochk    // 选项对账：不认识的键会报一行警告（见 sdl_opts.leno ✓）
import "sdl_renderer.leno" as ren; use ren.Renderer
import "sdl_font.leno" as fnt; use fnt.Font
import "sdl_event.leno" as evt; use evt.Event
import "sdl_core.leno" as core; use core.(SystemCursor, SDL_Rect, sdl3)
import "sdl_widget.leno" as wgt; use wgt.Widget
import "sdl_tooltip.leno" as tip
import "sdl_theme.leno" as theme; use theme.(Theme, Themeable)
use theme.Color
import "sdl_image.leno" as img
import "sdl_edit.leno" as edt; use edt.Edit


// 本控件认的键 —— 由本文件全部 `.get("…")` **自动抽取**（是超集 ⇒ 可少报、不误报 ✓）
//   ⚠ 以后增删选项请重跑抽取（或人工核对），否则可能对合法用法误报 ✓
func _opts_keys(): Array[string] {
    return [
"bg_color", "border", "border_color", "cursor", "editable", "enabled", "font_path", "font_size", "font_style", "h", "hover_color", "icon", "icon_gap", "icon_size", "image_gap", "image_size", "item_h", "item_images", "items", "placeholder", "pad_x", "popup_h", "show_arrow", "radius", "scroll_color", "bar_auto_hide", "bar_hover_color", "sel_color", "selected", "text_color", "tip", "visible", "w", "x", "y"
]
}
export struct ComboBox impl Widget, Themeable {
    float x = 0.0, y = 0.0, w = 200.0, h = 30.0
    Array[string] items = []
    pri int sel = -1              // 选中索引（-1 无）
    pri bool open = false
    pri float itemH = 24.0
    pri float scroll = 0.0
    pri int hover = -1
    pri float popupMax = 200.0    // 弹出列表最大高度
    float _fontSize = 15.0; pri string fontPath = ""; pri int fontStyle = 0; Font? _font
    pri string placeholder = "请选择"
    pri Color bgColor = #262830FF
    pri Color bdrColor = #5A5F6EFF
    pri Color selColor = #343A46FF
    pri Color hovColor = #464E5CFF
    pri Color txtColor = #EBEBF5FF
    pri Color sbColor = #787D8CFF
    pri int cursor = SystemCursor.POINTER
    bool enabled = true, visible = true, _loaded = false
    string _tip = ""
    pri bool draggingScroll = false
    // 滚动条观感（与其它控件同名同义）；弹层小列表默认不折叠，可显式开 ✓
    pri bool barAutoHide = false
    pri bool barHover = false
    pri Color barHoverColor = #00000000
    pri float sbDragOffset = 0.0
    pri func(int):void onChange
    pri func(string):void onEnter     // 可编辑模式：回车回调
    pri Ptr[u8]? winHnd            // 所属窗口句柄：下拉层按窗口隔离绘制；面板/Tab 嵌套未拿到句柄则为 null
    // ===== 可编辑模式 =====
    pri bool editable = false       // 是否可编辑（内嵌 Edit 控件）
    // ★ 2026-10-27：外框圆角与内边距可配（原来写死 6 / 4）——
    //   当"搜索框"用它时，要和旁边 18px 圆角的 Edit 长得一样，否则一个胶囊一个方角 ✗
    pri float boxRadius = 6.0
    pri float padX = 4.0
    // 当作"搜索框/自动补全"用时不需要下拉箭头和外框（视觉上应该是一个普通输入框 ✓）
    pri bool showArrow = true
    pri bool showBorder = true
    // 前置图标（搜索框那种「🔍 + 输入框」的形态）：icon 为图片路径，"" = 不显示 ✓
    pri string iconPath = ""
    pri float iconSize = 16.0
    pri float iconGap = 6.0
    // 哪些颜色是调用方**显式指定**的（切主题时不能把它们冲掉 ✓）
    pri bool bgSet = false
    pri bool bdrSet = false
    pri bool selSet = false
    pri bool hovSet = false
    pri bool txtSet = false
    pri Edit? edit                 // 内嵌编辑框（懒创建）

    // ==================== 每项图标支持（对齐 Table._rowImages / TreeView image） ====================
    pri Array[string] itemImages = []    // 每项图标路径（与 items 平行，空串=无图标）
    pri float imgSize = 16.0             // 图标边长
    pri float imgGap  = 6.0              // 图标与文字间距
    // 纹理缓存（避免每帧重载 & 纹理泄漏）：Dict O(1) 查找替代旧双数组线性扫描
    Dict[string, Ptr[u8]] _imgCache = {}
    pri float fontH = 0.0             // 字体行高缓存（避免每帧 measureString("Ag")）

    pri func ensure_font() {
        if _font == null or not _font.ok {
            if _font != null and _font.ok { fnt.releaseFont(_font) }
            if fontPath != "" { _font = fnt.acquireFont(fontPath, _fontSize) }
            else { _font = fnt.acquireFontAuto(_fontSize) }
            if _font.ok and fontStyle != 0 { _font.setStyle(fontStyle) }
            if _font.ok { var[float, float](_agw, _agh) = _font.measureString("Ag"); fontH = _agh }
        }
    }

    func _ph(): float {
        float ph = items.len() * itemH
        return if ph > popupMax then popupMax else ph
    }
    pri func max_scroll(): float {
        float m = items.len() * itemH - _ph()
        return if m < 0.0 then 0.0 else m
    }
    pri func clamp_scroll() {
        float m = max_scroll()
        if scroll < 0.0 { scroll = 0.0 }
        if scroll > m { scroll = m }
    }

    // ==================== 布局接口 ====================
    func get_w(): float          { return w }
    // ★ 2026-10-29 反哺：⚠ 语义 = 「**有选项被悬停**」（hover 索引 >= 0），不是鼠标在矩形内 ✓
    func is_hover(): bool        { return hover >= 0 }
    func get_h(): float          { return h }
    func set_pos(float px, float py) { x = px; y = py }
    func set_size(float sw, float sh) { w = sw; h = sh }


    func set(Dict opts) {
        dochk.check("sdl_combobox", opts, _opts_keys())   // ★ 选项对账（2026-09-29 铺开 ✓）
        Theme th = theme.getTheme()
        bgColor = th.bg
        bdrColor = th.border
        selColor = th.bgSel
        hovColor = th.bgHover
        txtColor = th.txt
        sbColor = th.sb
        x         = opts.get("x", 0)
        y         = opts.get("y", 0)
        w         = opts.get("w", 200)
        h         = opts.get("h", 30)
        itemH    = opts.get("item_h", 24)
        popupMax = opts.get("popup_h", 200)
        _fontSize = opts.get("font_size", 15)
        fontPath = opts.get("font_path", "")
        fontStyle = opts.get("font_style", 0)
        placeholder = opts.get("placeholder", "请选择")

        var its = opts.get("items", [])
        if its is Array[string] { items = its } else { items = [] }
        sel = opts.get("selected", -1)
        if sel >= items.len() { sel = -1 }

        // 颜色：opts 未传则保持默认值；传了就记下来 —— 切主题时**不覆盖显式值** ✓
        if opts.get("bg_color") is Color => t { bgColor = t; bgSet = true }
        if opts.get("border_color") is Color => t { bdrColor = t; bdrSet = true }
        if opts.get("sel_color") is Color => t { selColor = t; selSet = true }
        if opts.get("hover_color") is Color => t { hovColor = t; hovSet = true }
        if opts.get("text_color") is Color => t { txtColor = t; txtSet = true }
        if opts.get("scroll_color") is Color => t { sbColor = t }
        barAutoHide = opts.get("bar_auto_hide", false)
        if opts.get("bar_hover_color") is Color => hc { barHoverColor = hc }

        // 每项图标
        var iis = opts.get("item_images")
        if iis is Array[string] { itemImages = iis } else { itemImages = [] }
        imgSize = opts.get("image_size", 16)
        imgGap  = opts.get("image_gap", 6)

        cursor = opts.get("cursor", SystemCursor.POINTER)
        enabled = opts.get("enabled", true)
        visible = opts.get("visible", true)
        _tip = opts.get("tip", "")
        open = false; scroll = 0.0; hover = -1   // 重置：收起弹层、滚动归零、悬停行清除
        editable = opts.get("editable", false)
        boxRadius = opts.get("radius", 6.0)
        padX = opts.get("pad_x", 4.0)
        showArrow = opts.get("show_arrow", true)
        showBorder = opts.get("border", true)
        iconPath = opts.get("icon", "")
        iconSize = opts.get("icon_size", 16.0)
        iconGap = opts.get("icon_gap", 6.0)
        if editable and edit == null {
            edit = edt.createEdit({x:x+padX, y:y+1, w:w-padX-20.0, h:h-2, font_size:_fontSize, border:false, draw_bg:false, radius:0, pad_x:padX, placeholder:placeholder, text_color:txtColor})
            edit.on_enter(func() { if onEnter != null { onEnter(edit.get_text()) } })
            // ★ 同步初始选中项文本到 Edit（selected 在 set 前面已解析）
            if sel >= 0 and sel < items.len() { edit.set_text(items[sel]) }
        }
        ensure_font()
        _loaded = true
    }

    // ==================== 设置方法 ====================
    func set_items(Array[string] its) { items = its; if sel >= items.len() { sel = -1 }; open = false; scroll = 0.0; itemImages = [] }
    func set_items_with_images(Array[string] its, Array[string] imgs) {
        items = its; itemImages = imgs
        if sel >= items.len() { sel = -1 }; open = false; scroll = 0.0
    }
    func set_item_image(int idx, string path) {
        while itemImages.len() <= idx { itemImages.add("") }
        itemImages[idx] = path
    }
    func get_item_image(int idx): string {
        if idx < 0 or idx >= itemImages.len() { return "" }
        return itemImages[idx]
    }
    func set_image_size(float s) { imgSize = s }
    func set_image_gap(float g)  { imgGap = g }
    func add_item(string s)           { items.add(s) }
    func clear()                      { items = []; itemImages = []; sel = -1; open = false; scroll = 0.0; hover = -1 }
    func set_enabled(bool e)          { enabled = e }
    func set_visible(bool v)           { visible = v }
    func is_visible(): bool           { return visible }
    func set_font_size(float s)       { _fontSize = s; if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null }
    func get_x(): float               { return x }
    func get_y(): float               { return y }

    func get_selected(): int          { return sel }
    func get_selected_text(): string  { return if sel >= 0 and sel < items.len() then items[sel] else "" }
    func set_selected(int idx) {
        if idx < 0 or idx >= items.len() { return }
        sel = idx
        if editable and edit != null and not edit.is_focused() { edit.set_text(items[sel]) }
        if onChange != null { onChange(sel) }
    }
    func close() { open = false }
    func isOpen(): bool { return open }
    // 记录所属窗口句柄，供下拉层按窗口隔离绘制（渲染循环据 hwnd 只画本窗口下拉框）
    func setWindowHandle(Ptr[u8] hwnd) { winHnd = hwnd }
    func getWindowHandle(): Ptr[u8] { return winHnd }
    // ★ 容器下发窗口句柄：同时传递给内嵌 Edit，使其 IME 候选框能正确定位
    func _bind_window(Ptr[u8] hwnd) {
        winHnd = hwnd
        edit?.set_window(hwnd)
    }

    // 纹理缓存：按 path 取/载纹理（O(1) Dict 查找，替代旧双数组线性扫描）
    pri func get_tex(Renderer r, string path): Ptr[u8] {
        Ptr[u8] cached = _imgCache.get(path, null)
        if cached != null { return cached }
        Ptr[u8] t = img.loadTexture(r.handle, path)
        _imgCache[path] = t
        return t
    }
    pri func free_img_cache() {
        sdl3 _lib = core.lib()
        // 遍历 Dict 释放所有纹理
        Array[string] keys = _imgCache.keys()
        for keys.len() to i {
            Ptr[u8] tex = _imgCache[keys[i]]
            if tex != null { _lib.SDL_DestroyTexture(tex) }
        }
        _imgCache = {}
    }

    func on_change(func(int):void cb) { onChange = cb }

    // ==================== 焦点与键盘（供窗口的"焦点链"调用 ✓ 2026-10-13 第五批）====================
    //   语义：↓/↑ 移动选中（走 `set_selected` ⇒ 回调 + 滚入视野 + **内嵌 Edit 文本同步**一起 ✓）、
    //     Home/End 首末、Enter/Space **开关下拉**（开着时按 = 选定并收起 ✓）、Esc 收起 ✓
    bool focusable = true
    bool focused = false
    func set_focusable(bool b) { focusable = b; if not b { focused = false } }
    func is_focusable(): bool { return focusable }
    func focus() { if focusable and not focused { focused = true; core.markFrameRedraw() } }
    func blur() { if focused { focused = false; core.markFrameRedraw() } }
    func is_focused(): bool { return focused }

    // ==================== 可输入模式（autocomplete 用）====================
    // ★ 2026-10-27：`editable: true` 时输入的文字原来**取不出来** ⇒ 没法做"边输边给建议" ✗
    //   · get_text：取输入框里的原文（非可编辑 ⇒ 回落选中项文本 ✓）
    //   · set_text：程序化填入（不会触发 on_change，避免自我循环 ✓）
    //   · on_text_change：输入变化回调（转发内嵌 Edit 的 on_change ✓）
    func get_text(): string {
        if editable and edit != null { return edit.get_text() }
        return get_selected_text()
    }
    func set_text(string t) {
        if editable and edit != null { edit.set_text(t) }
    }
    func on_text_change(func():void cb) {
        if editable and edit != null { edit.on_change(cb) }
    }
    // 换建议后重新展开：`set_items` 会 `open = false`（避免旧列表残留），
    //   建议列表需要"更新完再弹开" ⇒ 调它 ✓
    func set_suggestions(Array[string] its) {
        set_items(its)
        if its.len() > 0 { open_list() } else { close() }
        core.markFrameRedraw()
    }
    // ★ 打开下拉抽成**一个入口** ⇒ 键盘与鼠标点击共用 ✓
    //   （原来这段逻辑**内联在点击路径里** ✗ —— 那份"滚到选中项"的代码要是抄第二遍，迟早漂 ✓）
    func open_list() {
        open = true
        scroll = 0.0
        if sel >= 0 {
            float iy = sel * itemH
            if iy + itemH > _ph() { scroll = iy + itemH - _ph() }
            clamp_scroll()
        }
    }
    // 内嵌 Edit 的左边距 / 宽度（有前置图标时右移并变窄）——
    //   绘制与命中测试**共用这两个函数**，避免两处各算一份而漂移 ✓
    pri func edit_left(): float {
        return x + padX + (if iconPath != "" then iconSize + iconGap else 0.0)
    }
    pri func edit_width(): float {
        float iconExtra = if iconPath != "" then iconSize + iconGap else 0.0
        float rightPad = if showArrow then 20.0 else padX
        float ew = w - padX - iconExtra - rightPad
        if ew < 40.0 { ew = 40.0 }
        return ew
    }

    func toggle_list() { if open { close() } else { open_list() } }

    // 选中第 idx 项（鼠标点击与程序化调用共用）——
    //   ⚠ 必须把文本同步进内嵌 Edit：原来只改 `sel` 字段，输入框里还是旧词，
    //     调用方拿 `get_text()` 去搜会搜到旧关键词 ✗
    func pick_item(int idx) {
        if idx < 0 or idx >= items.len() { return }
        sel = idx
        open = false
        if editable and edit != null { edit.set_text(items[sel]) }
        if onChange != null { onChange(sel) }
        core.markFrameRedraw()
    }
    func activate() { toggle_list(); core.markFrameRedraw() }   // Enter/Space ≡ "点一下下拉框" ✓
    pri func nudge_sel(int sc) {
        if items.len() == 0 { return }
        int n = get_selected()
        if sc == core.Scancode.DOWN {
            if n < 0 { n = 0 } else { if n + 1 >= items.len() { n = items.len() - 1 } else { n = n + 1 } }
        }
        eif sc == core.Scancode.UP { n = if n <= 0 then 0 else n - 1 }
        eif sc == core.Scancode.HOME { n = 0 }
        eif sc == core.Scancode.END { n = items.len() - 1 }
        else { return }
        if n >= 0 { set_selected(n) }
    }
    func draw_focus_ring(Renderer r) {
        if not focused { return }
        Theme th = theme.getTheme()
        r.setColor(th.accentFocus)
        r.drawRect(x - 2.0, y - 2.0, w + 4.0, h + 4.0)
    }
    func on_enter(func(string):void cb) { onEnter = cb }
    func set_editable(bool e) { editable = e }
    func is_editing(): bool { return editable and edit != null and edit.is_focused() }
    func get_text(): string { if editable and edit != null { return edit.get_text() }; return get_selected_text() }
    func set_text(string t) { if editable and edit != null { edit.set_text(t) } }

    func contains(float mx, float my): bool {
        return mx >= x and mx <= x + w and my >= y and my <= y + h
    }
    pri func popup_rect(): Array[float] {
        float ph = _ph()
        return [x, y + h, w, ph]
    }
    pri func in_popup(float mx, float my): bool {
        var pr = popup_rect()
        return mx >= pr[0] and mx <= pr[0] + pr[2] and my >= pr[1] and my <= pr[1] + pr[3]
    }
    pri func index_at(float mx, float my): int {
        if not in_popup(mx, my) { return -1 }
        var pr = popup_rect()
        int idx = _int((my - pr[1] + scroll) / itemH)
        if idx < 0 or idx >= items.len() { return -1 }
        return idx
    }

    // 弹层竖向滚动条几何：返回 [sx, sw, ty0, ty1, thH, thy, maxs, px, py, ph]
    pri func sb_geom_popup(): Array[float] {
        var pr = popup_rect()
        float px = pr[0], py = pr[1], pw = pr[2], ph = pr[3]
        float maxs = max_scroll()
        float sw = 8.0
        float sx = px + pw - sw - 2.0
        float ty0 = py + 2.0
        float ty1 = py + ph - 2.0
        float trk = ty1 - ty0
        float thH = maths.max(20.0, maths.min(ph * ph / (items.len() * itemH), ph - 4.0))
        float thy = ty0 + (scroll / maxs) * (trk - thH)
        return [sx, sw, ty0, ty1, thH, thy, maxs, px, py, ph]
    }
    pri func in_vscroll_popup(float mx, float my): bool {
        if not open or max_scroll() <= 0.0 { return false }
        var g = sb_geom_popup()
        return mx >= g[0] - 2.0 and mx <= g[0] + g[1] + 2.0 and my >= g[2] and my <= g[3]
    }
    pri func in_thumb_popup(float mx, float my): bool {
        if not open or max_scroll() <= 0.0 { return false }
        var g = sb_geom_popup()
        return mx >= g[0] - 2.0 and mx <= g[0] + g[1] + 2.0 and my >= g[5] and my <= g[5] + g[4]
    }

    // ==================== 交互 ====================
    func process(Event ev) {
        if not _loaded { return }
        if not enabled { open = false; hover = -1; draggingScroll = false; return }

        // ★ 2026-10-13 修：**失焦即收起下拉** —— Alt+Tab / 切到别的应用时下拉层会一直挂在屏幕上 ✗
        //   （`PopMenu` 早就是这个写法：`if ev.isWindowFocusLost() { hide(); return }` ✓，ComboBox 漏了这一步 ✓）
        //   实测：注入 WINDOW_FOCUS_LOST 后 `isOpen()` 仍是 true ✗ ⇒ 现在应收起 ✓
        //   自测钩子：`SDL3.testFocusLost(win.getID())`（2026-10-13 补 ✓）⇒ 探针 leno_gui/自测/test_combobox_focus.leno ✓
        if ev.isWindowFocusLost() {
            if open { close() }
            hover = -1
            draggingScroll = false
            core.markFrameRedraw()
            return
        }

        // ★ 2026-10-13：键盘（第五批）—— 只在**自己聚焦**时响应 ✓（键事件是广播的 ⇒ 自己过滤 ✓）
        //   ⚠ 位置刻意放在**所有"弹层捕获"守卫之前** ✓：下拉开着时鼠标事件会被捕获区拦掉，
        //     但**键盘必须照常工作**（否则"开着下拉就没法用键盘选"✗ 实测同类问题在 ListBox 上踩过 ✓）
        //   ⚠⚠ 这里**只处理 Esc 与方向键** ✓：Enter/Space 归**窗口**（窗口会调 `activate()` ⇒ `toggle_list()` ✓）
        //     两边都处理会互相抵消：实测 Enter 被处理两次 ⇒ 下拉"开了又关"、`isOpen()` 仍是 false ✗
        if focused and ev.isKeyDown() {
            int _sc = ev.scancode()
            if _sc == core.Scancode.ESCAPE { if open { close(); core.markFrameRedraw() } }
            eif _sc == core.Scancode.DOWN or _sc == core.Scancode.UP or _sc == core.Scancode.HOME or _sc == core.Scancode.END { nudge_sel(_sc) }
        }

        var[float, float](mx, my) = ev.mousePos()
        if ev.isMouseWheel() { mx = ev.wheelMouseX(); my = ev.wheelMouseY() }

        // 滚动条自动隐藏：鼠标进出控件时只请求一次重绘（不是每帧 ✓）
        bool inNow = mx >= x and mx <= x + w and my >= y and my <= y + h
        if inNow != barHover {
            barHover = inNow
            core.markFrameRedraw()
        }

        // ★ 可编辑模式：Edit 聚焦时，键盘/文本事件路由给 Edit
        if editable and edit != null and edit.is_focused() {
            edit.set_pos(edit_left(), y + 1); edit.set_size(edit_width(), h - 2)
            edit.process(ev)
            // ★ 2026-10-27：这条分支原来直接 `return` ⇒ **输入框聚焦时下拉的 hover 永远不更新** ✗
            //   （打字时输入框一直聚焦，鼠标划过列表没反应，必须先点一下让输入框失焦才行）
            //   ⇒ 在这里补上 hover 计算，与下面的普通分支同一套逻辑 ✓
            if open and ev.isMouseMotion() {
                int prevHov = hover
                hover = index_at(mx, my)
                if hover != prevHov { core.markFrameRedraw() } else { core.markFrameMotion() }
            }
            // 点在下拉项上 ⇒ 直接选中（不然这条分支会把它当"点到外面"而 blur 掉 ✗）
            if open and ev.isMouseButtonDown() {
                int hitIdx = index_at(mx, my)
                if hitIdx >= 0 {
                    pick_item(hitIdx)
                    return
                }
            }
            // 点击箭头区域：展开/收起下拉（没箭头时整块都是输入区 ✓）
            if showArrow and ev.isMouseButtonDown() and contains(mx, my) and mx >= x + w - 20.0 {
                // ★ 2026-10-13：改走 `open_list()` / `close()` —— 与键盘**同一个入口** ✓（不抄第二份 ⇒ 不会漂 ✓）
                if not open { open_list() } else { close() }
                edit.blur()
            } eif ev.isMouseButtonDown() and not edit.contains(mx, my) {
                // 点在列表项上就交给列表处理（不能在这里 blur 掉，否则点击选中会失效）
                if not (open and index_at(mx, my) >= 0) { edit.blur() }
            }
            return
        }

        // 弹层捕获：光标落在"他人的下拉弹层"范围内、且本框未展开时，忽略该事件
        if core.inPopupCapture(mx, my) and not open { return }

        // 拖拽结束
        if ev.isMouseButtonUp() and draggingScroll { draggingScroll = false; return }

        // 弹层滚动条优先（仅展开时）
        if open and ev.isMouseButtonDown() and in_vscroll_popup(mx, my) {
            var g = sb_geom_popup()
            float maxs = g[6], trk = g[3] - g[2], thH = g[4]
            if in_thumb_popup(mx, my) {
                draggingScroll = true
                sbDragOffset = my - g[5]                  // 记录起点相对滑块顶偏移，避免跳动
            } else {
                draggingScroll = true
                sbDragOffset = thH / 2.0
                float rel = my - g[2] - thH / 2.0
                if trk - thH > 0.0 { scroll = rel * maxs / (trk - thH) }
                clamp_scroll()
            }
            return
        }

        // 拖拽中：跟随鼠标移动滑块（即使移出弹层也继续）
        if draggingScroll {
            if ev.isMouseMotion() {
                var g = sb_geom_popup()
                float maxs = g[6], trk = g[3] - g[2], thH = g[4]
                float rel = my - g[2] - sbDragOffset
                if trk - thH > 0.0 { scroll = rel * maxs / (trk - thH) }
                clamp_scroll()
                core.markFrameRedraw()
            }
            return
        }

        if ev.isMouseWheel() and open {
            // 滚轮只作用于光标所在的弹层，避免同一事件被其它控件共享
            if not in_popup(ev.wheelMouseX(), ev.wheelMouseY()) { return }
            float d = ev.wheelY() * itemH
            scroll = scroll - d
            clamp_scroll()
        }

        if ev.isMouseMotion() {
            int prevHover = hover
            if open { hover = index_at(mx, my) } else { hover = -1 }
            bool hv = open and hover >= 0
            if not hv { hv = contains(mx, my) }
            if hover != prevHover { core.markFrameRedraw() } else { core.markFrameMotion() }
            if hv and cursor >= 0 { core.requestCursor(cursor) }
            if hv and _tip != "" { tip.tipReport(_tip, mx, my) }
            // 未命中不再强制设 DEFAULT，由 Window 帧末统一决定（避免覆盖上方弹层的手型）
        }

        if ev.isMouseButtonDown() {
            if not open {
                if contains(mx, my) {
                    // ★ 可编辑模式：点击文本区域聚焦 Edit（不展开弹层）
                    if editable and edit != null and mx < x + w - 20.0 {
                        edit.set_pos(x + padX, y + 1); edit.set_size(w - padX - 20.0, h - 2)
                        edit.focus(); return
                    }
                    open = true
                    scroll = 0.0
                    if sel >= 0 {
                        float iy = sel * itemH
                        if iy + itemH > _ph() { scroll = iy + itemH - _ph() }
                        clamp_scroll()
                    }
                }
            } else {
                int idx = index_at(mx, my)
                if idx >= 0 {
                    pick_item(idx)
                } else if not contains(mx, my) {
                    open = false   // 点击弹出区域外关闭
                } else {
                    open = false   // 点击标题栏收起
                }
            }
        }
    }

    // ==================== 渲染 ====================
    func render(Renderer r) {
        if not _loaded { return }
        if not visible { return }
        ensure_font()

        Color bgC = bgColor
        if not enabled { bgC = theme.darken(bgColor, 60) }
        r.setColor(bgC)
        r.fillRoundedRect(x, y, w, h, boxRadius)

        // 当前文字 + 图标
        float textX = x + 8.0
        // ★ 可编辑模式：渲染 Edit 代替静态文字
        if editable and edit != null {
            edit.set_pos(edit_left(), y + 1); edit.set_size(edit_width(), h - 2)
            // 前置图标（搜索框那种「🔍 + 输入框」）—— 落整像素，细线不被采样掉 ✓
            if iconPath != "" {
                Ptr[u8] itex = get_tex(r, iconPath)
                if itex != null {
                    r.setTextureAlpha(itex, 255); r.setTextureColor(itex, #FFFFFFFF)
                    float iy = y + (h - iconSize) / 2.0
                    r.drawTextureAt(itex, _float(_int(x + padX + 0.5)), _float(_int(iy + 0.5)),
                                    iconSize, iconSize)
                }
            }
            edit.render(r)
            if showArrow {
                // 下拉箭头
                //   ★ 颜色取**文字色**（2026-10-09 修）：原来用 `brighten(bdrColor, 60)`，浅色主题下
                //     border=#C8CDD4 提亮 60 会**饱和成纯白** ⇒ 与浅底几乎同色、根本看不见 ✗
                //     文字色按定义就"与底有对比"（深色主题下自动变成浅箭头 ✓）⇒ 必可见 ✓
                //     （与 SpinBox 的 `btnColor = txtHeader` 同一口径 ✓）
                float aw = 10.0, ax = x + w - aw - 8.0, ay = y + h / 2.0
                Color arrowC = txtColor
                if not enabled { arrowC = theme.darken(txtColor, 60) }   // 禁用与文字同步变暗 ✓
                arrowC = theme.withAlpha(arrowC, 200)                    // 比文字略柔，不抢眼 ✓
                r.setColor(arrowC)
                r.drawTriangleC(ax + aw / 2.0, ay, aw / 2.0, 180.0, arrowC)
            }
            if showBorder {
                r.setColor(bdrColor)
                r.drawRoundedRect(x, y, w, h, boxRadius)
            }
            return
        }
        if _font.ok {
            // 选中项图标
            if sel >= 0 and sel < itemImages.len() and itemImages[sel] != "" {
                Ptr[u8] tex = get_tex(r, itemImages[sel])
                if tex != null {
                    float isz = imgSize
                    if isz > h - 8.0 { isz = h - 8.0 }
                    float iy = y + (h - isz) / 2.0
                    r.setTextureAlpha(tex, 255); r.setTextureColor(tex, #FFFFFFFF)
                    var[float, float](nw, nh) = r.getTextureSize(tex)
                    if nw > 0.0 and nh > 0.0 {
                        float s = isz / nw; if isz / nh < s { s = isz / nh }
                        float dw = nw * s, dh = nh * s
                        r.drawTextureAt(tex, textX + (isz - dw) / 2.0, iy + (isz - dh) / 2.0, dw, dh)
                    }
                    textX = textX + isz + imgGap
                }
            }
            string t = ""
            if sel >= 0 and sel < items.len() { t = items[sel] } else { t = placeholder }
            float th = fontH
            Color tcC = txtColor
            if not enabled { tcC = theme.darken(txtColor, 60) }
            float ty = r.snapY(y + (h - th) / 2.0)
            r.drawText(_font, t, r.snapX(textX), ty, tcC)
        }

        // 下拉箭头（向下填充三角）—— 取色同上面那处：**跟文字色**，别跟边框色 ✓（见上方注释）
        float aw = 10.0, ax = x + w - aw - 8.0, ay = y + h / 2.0
        Color arrowC = txtColor
        if not enabled { arrowC = theme.darken(txtColor, 60) }
        arrowC = theme.withAlpha(arrowC, 200)
        r.setColor(arrowC)
        r.drawTriangleC(ax + aw / 2.0, ay, aw / 2.0, 180.0, arrowC)

        // 边框
        r.setColor(bdrColor)
        r.drawRoundedRect(x, y, w, h, 6.0)
    }

    // 弹出列表（独立 overlay 通道：由 Window 在所有控件渲染完后第二遍调用，
    // 保证下拉层永远盖在其它控件之上，不会被列表中靠后的 ComboBox 挡住）
    func renderPopup(Renderer r) {
        if not _loaded or not visible or not open or items.len() == 0 { return }
        Color bgC = bgColor
        if not enabled { bgC = theme.darken(bgColor, 60) }
        var pr = popup_rect()
        float px = pr[0], py = pr[1], pw = pr[2], ph = pr[3]

        // 把弹出矩形登记为事件捕获区，使下层控件忽略落在弹层范围内的鼠标/滚轮事件
        core.setPopupCapture(px, py, pw, ph)

        r.setColor(bgC)
        r.fillRoundedRect(px, py, pw, ph, 6.0)

        SDL_Rect clip = SDL_Rect.malloc()
        clip.x = _int(px); clip.y = _int(py)
        // ★ 2026-10-13：裁剪矩形要**正好等于面板**，别给 +1 —— 旧代码 `_int(ph) + 1` 本意是
        //   "覆盖浮点截断的亚像素"，但它比面板真身还多 1px ⇒ 末行（常只露一半）的**文字下沿**
        //   会漏到面板/边框**外面** 1px ✗（实测症状："字体下沿有一丢丢出框" ✓）
        //   ⇒ 用 ceil 算出面板的真实覆盖（永不超出 ✓，也永不缺一角 ✓）
        clip.w = _int(maths.ceil(px + pw)) - _int(px)
        clip.h = _int(maths.ceil(py + ph)) - _int(py)
        r.pushClipRect(clip.to_ptr())

        float radius = 6.0
        // 行高为常量，复用 _fontH 缓存避免每行重复测量
        float textH = fontH
        for items.len() to i {
            float iy = r.snapY(py - scroll + i * itemH)
            if iy + itemH < py or iy > py + ph { continue }
            Color rowC = bgC
            if i == sel { rowC = selColor }
            else if i == hover { rowC = hovColor }
            r.setColor(rowC)
            // 行底色统一走渲染器的共用件：圆角**锚在面板的边**上（首行/末行/只露半行都对 ✓）
            //   ⚠ 旧写法是"按行自己的矩形补圆角 + 补缺口"：末行只露 18px（200/26=7.69 行）时
            //     圆角落到了面板底边**下方 8px** ⇒ 面板两个底角仍是方角、被这行铺满 ✗
            //     （2026-10-13 实测：面板底行整行铺满到边框线上，左下/右下各一块方角底色 ✓）
            r.fillRowInPanel(px, py, pw, ph, radius, px, iy, pw, itemH)

            if textH > 0.0 {
                Color tcC = txtColor
                float ty = r.snapY(iy + (itemH - textH) / 2.0)
                float tx = r.snapX(px + 8.0)
                // 每项图标
                if i < itemImages.len() and itemImages[i] != "" {
                    Ptr[u8] tex = get_tex(r, itemImages[i])
                    if tex != null {
                        float isz = imgSize
                        if isz > itemH - 4.0 { isz = itemH - 4.0 }
                        float iy2 = iy + (itemH - isz) / 2.0
                        r.setTextureAlpha(tex, 255); r.setTextureColor(tex, #FFFFFFFF)
                        var[float, float](nw, nh) = r.getTextureSize(tex)
                        if nw > 0.0 and nh > 0.0 {
                            float s = isz / nw; if isz / nh < s { s = isz / nh }
                            float dw = nw * s, dh = nh * s
                            r.drawTextureAt(tex, tx + (isz - dw) / 2.0, iy2 + (isz - dh) / 2.0, dw, dh)
                        }
                        tx = tx + isz + imgGap
                    }
                }
                r.drawText(_font, items[i], tx, ty, tcC)
            }
        }
        r.popClipRect()
        clip.free()

        r.setColor(bdrColor)
        r.drawRoundedRect(px, py, pw, ph, 6.0)

        // 弹出滚动条：悬停/拖动 ⇒ 展开并变深；否则（bar_auto_hide）折叠成 3px 提示条
        float maxs = max_scroll()
        if maxs > 0.0 {
            bool hot = barHover or draggingScroll
            bool fold = barAutoHide and not hot
            Color track = sbColor
            if hot {
                track = if theme.colorA(barHoverColor) > 0 then barHoverColor
                        else theme.darken(sbColor, 45)
            }
            float sw = if fold then 3.0 else 8.0
            float sx = px + pw - sw - 2.0
            if fold {
                r.setColor(theme.withAlpha(track, 90))
                r.fillRoundedRect(sx, py + 2.0, sw, ph - 4.0, sw / 2.0)
            } else {
                r.setColor(theme.withAlpha(track, 230))
                r.fillRoundedRect(sx, py + 2.0, sw, ph - 4.0, sw / 2.0)
                float ratio = scroll / maxs
                float thH = maths.max(20.0, maths.min(ph * ph / (items.len() * itemH), ph - 4.0))
                float thy = py + 2.0 + ratio * (ph - 4.0 - thH)
                r.setColor(theme.brighten(track, 60))
                r.fillRoundedRect(sx, thy, sw, thH, sw / 2.0)
            }
        }
    }

    func dispose() {
        if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null
        edit?.dispose()
        free_img_cache()         // 释放图标纹理缓存
        _unregisterComboBox(self)   // 从下拉框登记表摘除自身，避免窗口销毁后悬空引用累积
    }

// ==================== 运行时主题切换 ====================
func applyTheme(Theme t) {
    // 显式指定过的颜色**保持不动** —— 否则切主题时应用精心配的胶囊/下拉色会被冲成主题色 ✗
    if not bgSet { bgColor = t.bg }
    if not bdrSet { bdrColor = t.border }
    if not selSet { selColor = t.bgSel }
    if not hovSet { hovColor = t.bgHover }
    if not txtSet { txtColor = t.txt }
    sbColor = t.sb
    // 同步内嵌 Edit 的颜色
    edit?.applyTheme(t)
}
}

// ==================== 下拉框登记（兜底第二遍绘制） ====================
// 经 panel.add / 布局容器 / Tab 页添加的 ComboBox 不会进入窗口首遍绘制顺序，
// 其展开的下拉层无法兜底到最上层（会被同级控件遮挡）。这里统一登记（createComboBox 工厂登记），
// 由窗口第二遍按窗口隔离绘制；面板/Tab 嵌套等拿不到句柄的控件 _winHnd 为 null，兜底画到任意窗口。
// 区别于旧「全局数组永不摘除」反模式：本数组在 ComboBox.dispose() 时摘除自身，
// 窗口销毁（递归 dispose 所有控件）后不残留，无悬空引用累积、无跨窗口数组无限增长。
Array[ComboBox] _comboPopupRegistry = []
export func registerComboBox(ComboBox c) {
    for _comboPopupRegistry.len() to k { if _comboPopupRegistry[k] == c { return } }  // 去重
    _comboPopupRegistry.add(c)
}
// 第二遍：仅绘制归属本窗口（hwnd）的下拉层；未登记句柄（嵌套控件）兜底画到任意窗口
export func renderComboBoxes(Renderer r, Ptr[u8] hwnd) {
    for _comboPopupRegistry.len() to i {
        var cb = _comboPopupRegistry[i]
        if cb.isOpen() {
            if cb.getWindowHandle() == null or cb.getWindowHandle() == hwnd {
                cb.renderPopup(r)
            }
        }
    }
}
// 摘除某个下拉框（在 ComboBox.dispose 时调用；置于文件末尾以便引用 _comboPopupRegistry）
func _unregisterComboBox(ComboBox c) {
    for _comboPopupRegistry.len() to k { if _comboPopupRegistry[k] == c { _comboPopupRegistry.remove(k); break } }
}

// 工厂
export func createComboBox(Dict opts): ComboBox {
    ComboBox cb = new ComboBox()
    // ★ 2026-10-27：**先套主题再 set(opts)** —— 原来只 set，主题一次都没应用过，
    //   控件一直停在字段默认色（深色底/深灰边），浅色界面上很突兀 ✗
    //   顺序保证"主题打底、显式参数覆盖" ✓
    cb.applyTheme(theme.getTheme())
    cb.set(opts)
    registerComboBox(cb)   // 登记到全局注册表，确保经 panel/tab/布局添加时下拉层也能画到最上层
    return cb
}


