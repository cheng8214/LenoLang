// sdl_calendar.leno — 通用月历控件（Calendar）
// win.addCalendar({...}) 或 SDL3.createCalendar({...})
//
// ★ **通用**优先：控件本身不含任何领域语义（不认识"签到"✗、不认识语言 ✗）。
//   星期名、月份文案、图例文字、状态色、一周从哪天开始……全部由调用方给 ✓
//   默认值刻意**中性**：没有图例、未标记的日子没有底色、不写死语言 ✓
//   （原先把"已签/漏签/未签"这些签到词和图例焊在里面 ✗ —— 那是页面的事 ✓）
//
// ★ 零依赖：不算星期几就调不动（`times` 只给"现在"，给不了任意日期 ✓）⇒
//   内部用**蔡勒公式**自己算星期 ✓（纯整数运算，实测 2026-09-01 = 周二、2026-09-26 = 周六 ✓）。
//   也不依赖主题模块：配色全部可传（与 Badge 同一策略 ✓）
//
// ★ 布局：固定 7 列 × `rows` 行（默认 6 ⇒ 用不满的行自动留空 ✓）。
//   切月只改**已有格子**的文字与颜色（Label.set_text）⇒ 不重建控件树 ✓
//
// ★ 状态：`marks` 是 {日: 状态}，状态就是**颜色表的索引**（0/1/2 或你自定义的编号 ✓）
//   常量只为常用三态提供名字：ST_PLAIN / ST_FILLED / ST_ALERT
//   默认色：0 无底色、1 主色底白字、2 浅红底红字 —— 都可用 *_bg / *_fg 覆盖 ✓
//
// 用法（最小）：
//   var cal = SDL3.createCalendar({x:20, y:20, w:600, h:420, year:2026, month:9, today:26})
//   cal.set_week_labels(["日","一","二","三","四","五","六"])     // 不给则用内置短名 ✓
//   cal.set_week_start(1)                                        // 1 = 周一开始 ✓（默认 0 = 周日）
//   cal.set_month_fmt("%d 年 %d 月")                              // 默认 "%d-%02d" ✓
//   cal.set_legend([1, LEG_TODAY, 2, 0], ["已签","今日","漏签","未签"])   // 不给就没有图例 ✓
//   cal.on_pick(func(int day) { print(day) })
//
// 用法（签到式外观，见数据看板页 2 / Trae 应用）：
//   var cal = SDL3.createCalendar({year:y, month:m, today:d,
//                                  plain_bg:#F1F5F9FF, filled_bg:#2B6BE4FF, filled_fg:#FFFFFFFF,
//                                  alert_bg:#FEE4E2FF, alert_fg:#D92D20FF,
//                                  today_bg:#FFFFFFFF, today_fg:#2B6BE4FF, today_border:#2B6BE4FF})
//   cal.set_legend([1, Calendar.LEG_TODAY, 2, 0], ["已签","今日","漏签","未签"])
import "sdl_renderer.leno" as ren; use ren.Renderer
import "sdl_event.leno" as evt; use evt.Event
import "sdl_widget.leno" as wgt; use wgt.Widget
import "sdl_label.leno" as lbl; use lbl.Label
import "sdl_theme.leno" as theme; use theme.Color   // Color 类型在 sdl_theme 里 ✓（不引它字段类型无法解析 ✓）
import "sdl_core.leno" as core

export struct Calendar impl Widget {
    // 常用三态的名字（值就是 colors 表的索引 ✓，可自定义更多态 ✓）
    const ST_PLAIN  = 0
    const ST_FILLED = 1
    const ST_ALERT  = 2

    // 图例里代表"今天"那一项的伪状态（不是真实的每日状态 ✓）
    const LEG_TODAY = -1

    const COLS = 7

    // ---- 位置与尺寸（布局容器通过 set_pos/set_size 驱动 ✓）----
    float x = 0.0, y = 0.0
    float _w = 620.0, _h = 400.0
    bool _natW = false, _natH = false      // 调用方没显式给尺寸 ⇒ 用自然尺寸 ✓

    // ---- 数据 ----
    int _year = 2026
    int _month = 1
    int _today = 0                         // 0 = 不标"今天"
    Dict _marks = {}                       // {日: 状态}
    int _rows = 6
    int _weekStart = 0                     // 0 = 周日开头（默认）✓ / 1 = 周一开头 ✓

    // ---- 文案（全部可配 ✓ 控件不认识语言 ✗）----
    // 默认给一套短名；调用方可用 set_week_labels 换成任意语言（或空数组 ⇒ 不画星期头 ✓）
    Array[string] _weekLabels = ["日", "一", "二", "三", "四", "五", "六"]
    string _monthFmt = "%d-%02d"           // 月份文案格式串（format 的 C 风格 ✓）
    string _arrowLeft = "‹"                // 切月箭头字符（字体缺字形时可换成文字 ✓）
    string _arrowRight = "›"

    // ---- 外观 ----
    float _pad = 16.0
    float _headH = 26.0                    // 顶部：月份文案 + 左右箭头
    float _weekH = 22.0                    // 星期头
    float _legendH = 22.0                  // 图例
    float _gap = 10.0                      // 格子间距
    float _cellMax = 40.0                  // 格子边长上限
    float _cellMin = 22.0
    float _radiusRatio = 0.24              // 格子圆角 = 边长 × 比例（给 cell_radius 则直接用它 ✓）
    float _radiusFixed = -1.0
    float _fsWeek = 12.0
    float _fsDay = 13.0
    float _fsHead = 12.0
    float _fsLegend = 11.0
    float _legendSwatch = 10.0
    float _legendGap = 18.0
    bool _showHead = true

    // ---- 状态色表（按状态索引 ✓；默认：未标记无底色 ⇒ 中性 ✓）----
    Color _cPlainBg  = #00000000           // 0：透明 ⇒ 不画底色 ✓
    Color _cPlainFg  = #6B7280FF
    Color _cFilledBg = #2B6BE4FF           // 1：主色底
    Color _cFilledFg = #FFFFFFFF
    Color _cAlertBg  = #FEE4E2FF           // 2：浅红底
    Color _cAlertFg  = #D92D20FF
    Color _cTodayBg  = #FFFFFFFF
    Color _cTodayFg  = #2B6BE4FF
    Color _cTodayBd  = #2B6BE4FF
    Color _cHeadTxt  = #111827FF           // 月份文案
    Color _cWeekTxt  = #9CA3AFFF           // 星期头 / 图例文字
    Color _cArrow    = #6B7280FF

    // ---- 图例（默认**空** ⇒ 不画 ✓；由 set_legend 决定 ✓）----
    Array[int]    _legendStates = []
    Array[string] _legendLabels = []

    // ---- 子控件（构造时一次性建好 ✓ 切月只改字 ✓）----
    Array[Label] _weekLbl = []
    Array[Label] _dayLbl = []
    Array[int]   _dayNum = []              // 该格是几号；0 = 本月没有这一天（留空 ✓）
    Label? _monthLbl = null
    Label? _arrowL = null
    Label? _arrowR = null
    Array[Label] _lgTxt = []               // 图例文字（个数由 set_legend 决定 ✓）
    bool _loaded = false
    bool visible = true

    // ---- 回调（不注册就纯显示 ✓）----
    func(int):void _onPick = null
    func(int, int):void _onMonthChange = null

    // ==================== 构造 ====================
    func set(Dict opts) {
        x = opts.get("x", 0.0)
        y = opts.get("y", 0.0)
        float wOpt = opts.get("w", 0.0)
        float hOpt = opts.get("h", 0.0)
        _natW = wOpt <= 0.0
        _natH = hOpt <= 0.0
        _w = wOpt
        _h = hOpt
        _year = opts.get("year", 2026)
        _month = opts.get("month", 1)
        _today = opts.get("today", 0)
        _rows = opts.get("rows", 6)
        _weekStart = opts.get("week_start", 0)
        _monthFmt = opts.get("month_fmt", "%d-%02d")
        _arrowLeft = opts.get("arrow_left", "‹")
        _arrowRight = opts.get("arrow_right", "›")
        _pad = opts.get("pad", 16.0)
        _headH = opts.get("head_h", 26.0)
        _weekH = opts.get("week_h", 22.0)
        _legendH = opts.get("legend_h", 22.0)
        _gap = opts.get("gap", 10.0)
        _cellMax = opts.get("cell_max", 40.0)
        _cellMin = opts.get("cell_min", 22.0)
        _radiusRatio = opts.get("cell_radius_ratio", 0.24)
        _radiusFixed = opts.get("cell_radius", -1.0)
        _fsWeek = opts.get("font_size_week", 12.0)
        _fsDay = opts.get("font_size_day", 13.0)
        _fsHead = opts.get("font_size_head", 12.0)
        _fsLegend = opts.get("font_size_legend", 11.0)
        _legendSwatch = opts.get("legend_swatch", 10.0)
        _legendGap = opts.get("legend_gap", 18.0)
        _showHead = opts.get("show_head", true)
        visible = opts.get("visible", true)
        // 状态色（名字按常用三态 ✓；要更多态请直接改字段或用 set_state_color ✓）
        if opts.get("plain_bg") is Color => t { _cPlainBg = t }
        if opts.get("plain_fg") is Color => t { _cPlainFg = t }
        if opts.get("filled_bg") is Color => t { _cFilledBg = t }
        if opts.get("filled_fg") is Color => t { _cFilledFg = t }
        if opts.get("alert_bg") is Color => t { _cAlertBg = t }
        if opts.get("alert_fg") is Color => t { _cAlertFg = t }
        if opts.get("today_bg") is Color => t { _cTodayBg = t }
        if opts.get("today_fg") is Color => t { _cTodayFg = t }
        if opts.get("today_border") is Color => t { _cTodayBd = t }
        if opts.get("head_text_color") is Color => t { _cHeadTxt = t }
        if opts.get("week_text_color") is Color => t { _cWeekTxt = t }
        if opts.get("arrow_color") is Color => t { _cArrow = t }
        if opts.get("marks") is Dict => m { _marks = m }

        // 星期头：7 个标签，文字按 week_start 轮转 ✓（默认短名；set_week_labels 可换 ✓）
        for 0 : COLS - 1 to i {
            _weekLbl.add(lbl.createLabel({x:0, y:0, text:_weekLabel(i), font_size:_fsWeek, text_color:_cWeekTxt}))
        }
        // 日期格：7 × rows，一次性建满 ⇒ 切月只改文字 ✓
        int total = COLS * _rows
        for 0 : total - 1 to i {
            _dayLbl.add(lbl.createLabel({x:0, y:0, text:"", font_size:_fsDay, text_color:_cPlainFg}))
            _dayNum.add(0)
        }
        if _showHead {
            _monthLbl = lbl.createLabel({x:0, y:0, text:"", font_size:_fsHead, text_color:_cHeadTxt})
            _arrowL = lbl.createLabel({x:0, y:0, text:_arrowLeft, font_size:_fsHead + 2.0, text_color:_cArrow})
            _arrowR = lbl.createLabel({x:0, y:0, text:_arrowRight, font_size:_fsHead + 2.0, text_color:_cArrow})
        }
        _relabel()
        _loaded = true
    }

    // ==================== 数据 ====================
    // 蔡勒公式的实现放在**模块级** `dow()`（见文件末尾 ✓）—— 页面也要用同一个算法 ✓
    //   这里只做委托，避免两份实现漂移 ✗
    func _dow(int y, int m, int d): int { return dow(y, m, d) }

    // 第 i 列（0 = 最左）的星期名：按 week_start 轮转 ✓
    func _weekLabel(int i): string {
        if _weekLabels.len() == 0 { return "" }
        return _weekLabels[(_weekStart + i) % 7]
    }

    func _daysInMonth(): int {
        if _month == 2 {
            // 闰年：4 整除且不是 100 的倍数，或 400 的倍数 ✓
            if (_year % 4 == 0 and _year % 100 != 0) or _year % 400 == 0 { return 29 }
            return 28
        }
        if _month == 4 or _month == 6 or _month == 9 or _month == 11 { return 30 }
        return 31
    }

    // 把当前年月填进已有格子（只改文字/颜色 ⇒ 不重建控件 ✓）
    func _relabel() {
        if _dayLbl.len() == 0 { return }
        int firstDow = _dow(_year, _month, 1)                 // 1 号是周几（0 = 周日）
        int off = (firstDow - _weekStart + 7) % 7             // ⇒ 它在网格里的列号 ✓
        int dim = _daysInMonth()
        for 0 : _dayNum.len() - 1 to i {
            int d = i - off + 1
            if d < 1 or d > dim {
                _dayNum[i] = 0
                _dayLbl[i].set_text("")
            } else {
                _dayNum[i] = d
                _dayLbl[i].set_text(d as string)
            }
        }
        if _monthLbl != null { _monthLbl.set_text(format(_monthFmt, _year, _month)) }
        core.markFrameRedraw()
    }

    // 切月（delta = -1 上一月 / +1 下一月 ✓）；会触发 on_month_change（若已注册）
    func _shift_month(int delta) {
        int m = _month + delta
        int y = _year
        if m < 1 { m = 12; y = y - 1 }
        if m > 12 { m = 1; y = y + 1 }
        _month = m; _year = y
        // 切月后"今天"通常不再属于本月 ⇒ 由调用方按需 set_today(0) ✓
        _relabel()
        if _onMonthChange != null { _onMonthChange(_year, _month) }
    }

    // ==================== 设置方法 ====================
    func set_month(int y, int m) { _year = y; _month = m; _relabel() }
    func get_year(): int  { return _year }
    func get_month(): int { return _month }
    func set_today(int d) { _today = d; core.markFrameRedraw() }
    func get_today(): int { return _today }
    func set_mark(int day, int state) { _marks[day] = state; core.markFrameRedraw() }
    func set_marks(Dict m) { _marks = m; core.markFrameRedraw() }
    func clear_marks() { _marks = {}; core.markFrameRedraw() }
    func get_mark(int day): int {
        // Dict 取值是 any ⇒ 必须显式转 ✓（否则返回类型不匹配 ✗）
        if _marks.has(day) { return _marks[day] as int }
        return ST_PLAIN
    }

    // 星期名（任意语言 ✓；空数组 ⇒ 不画星期头 ✓）—— 会顺带更新表头文字 ✓
    func set_week_labels(Array[string] names) {
        _weekLabels = names
        for 0 : _weekLbl.len() - 1 to i { _weekLbl[i].set_text(_weekLabel(i)) }
        core.markFrameRedraw()
    }
    // 一周从哪天开始：0 = 周日、1 = 周一 … ✓（会重排表头与日期格 ✓）
    func set_week_start(int ws) { _weekStart = ws; _update_week_labels(); _relabel() }
    func get_week_start(): int { return _weekStart }
    func _update_week_labels() {
        for 0 : _weekLbl.len() - 1 to i { _weekLbl[i].set_text(_weekLabel(i)) }
    }
    // 月份文案格式串（C 风格 format ✓），如 "%d 年 %d 月" / "%B %Y" / "%d-%02d" ✓
    func set_month_fmt(string fmt) { _monthFmt = fmt; _relabel() }
    // 切月箭头字符（字体缺字形时换成 "<<" / ">>" 也行 ✓）
    func set_arrows(string left, string right) {
        _arrowLeft = left; _arrowRight = right
        if _arrowL != null { _arrowL.set_text(left) }
        if _arrowR != null { _arrowR.set_text(right) }
        core.markFrameRedraw()
    }
    // 图例：states 里可含 LEG_TODAY（今天那种"白底 + 描边"的样式 ✓）；
    //   两个数组都空 ⇒ 不画图例 ✓（默认就是空 ✓）
    func set_legend(Array[int] states, Array[string] labels) {
        _legendStates = states
        _legendLabels = labels
        for _lgTxt to l { l.dispose() }
        _lgTxt = []
        for 0 : states.len() - 1 to i {
            string t = ""
            if i < labels.len() { t = labels[i] }
            _lgTxt.add(lbl.createLabel({x:0, y:0, text:t, font_size:_fsLegend, text_color:_cWeekTxt}))
        }
        core.markFrameRedraw()
    }
    // 状态色（状态编号任意 ✓，便于自定义多于三态的场景 ✓）
    func set_state_color(int state, Color bg, Color fg) {
        if state == ST_PLAIN { _cPlainBg = bg; _cPlainFg = fg }
        else if state == ST_FILLED { _cFilledBg = bg; _cFilledFg = fg }
        else if state == ST_ALERT { _cAlertBg = bg; _cAlertFg = fg }
        core.markFrameRedraw()
    }
    func _stateBg(int st): Color {
        if st == ST_FILLED { return _cFilledBg }
        if st == ST_ALERT { return _cAlertBg }
        return _cPlainBg
    }
    func _stateFg(int st): Color {
        if st == ST_FILLED { return _cFilledFg }
        if st == ST_ALERT { return _cAlertFg }
        return _cPlainFg
    }

    func on_pick(func(int):void cb) { _onPick = cb }
    func on_month_change(func(int, int):void cb) { _onMonthChange = cb }
    func set_visible(bool v) { visible = v; core.markFrameRedraw() }
    func is_visible(): bool { return visible }
    func set_enabled(bool e) {}

    // ==================== 几何 ====================
    func _legendRows(): float {
        if _legendStates.len() == 0 { return 0.0 }
        return _legendH
    }
    // 格子边长：按可用宽度与高度取较小者，再夹到 [cellMin, cellMax] ✓
    func _cell(): float {
        float availW = _w - 2.0 * _pad - _gap * _float(COLS - 1)
        float cw = availW / _float(COLS)
        float headH = 0.0
        if _showHead { headH = _headH }
        float availH = _h - 2.0 * _pad - headH - _weekH - _legendRows() - _gap * _float(_rows - 1)
        float chh = availH / _float(_rows)
        float c = cw
        if chh < c { c = chh }
        if c > _cellMax { c = _cellMax }
        if c < _cellMin { c = _cellMin }
        return c
    }
    func _cellRadius(float c): float {
        if _radiusFixed >= 0.0 { return _radiusFixed }
        return c * _radiusRatio
    }
    // 第 row 行、第 col 列的格子左上角（含整块网格在可用区里居中 ✓）
    func _cellX(float c, float gridW, int col): float {
        float ox = x + _pad
        if _w - 2.0 * _pad > gridW { ox = x + (_w - gridW) / 2.0 }
        return ox + _float(col) * (c + _gap)
    }
    func _cellY(float c, float gridH): float {
        float headH = 0.0
        if _showHead { headH = _headH }
        float oy = y + _pad + headH + _weekH
        float avail = _h - 2.0 * _pad - headH - _weekH - _legendRows()
        if avail > gridH { oy = y + _pad + headH + _weekH + (avail - gridH) / 2.0 }
        return oy
    }

    // ==================== 查询（布局用 ✓）====================
    func get_x(): float { return x }
    func get_y(): float { return y }
    func get_w(): float {
        if _natW { return _cellMax * _float(COLS) + _gap * _float(COLS - 1) + 2.0 * _pad }
        return _w
    }
    func get_h(): float {
        if _natH {
            float headH = 0.0
            if _showHead { headH = _headH }
            return 2.0 * _pad + headH + _weekH + _float(_rows) * _cellMax + _gap * _float(_rows - 1) + _legendRows()
        }
        return _h
    }
    func set_pos(float px, float py) { x = px; y = py }
    func set_size(float sw, float sh) {
        if sw > 0.0 { _w = sw; _natW = false }
        if sh > 0.0 { _h = sh; _natH = false }
    }

    // ==================== 事件 ====================
    func process(Event ev) {
        if not _loaded or not visible { return }
        var[float, float](mx, my) = ev.mousePos()
        if core.inPopupCapture(mx, my) { return }        // 弹层展开时不穿透 ✓（与 Canvas 同一守卫 ✓）
        if mx < x or mx > x + _w or my < y or my > y + _h { return }
        if ev.isMouseMotion() { core.markFrameMotion(); return }
        if not ev.isMouseButtonDown() { return }
        if ev.mouseButton() != 1 { return }              // 只认左键 ✓

        float c = _cell()
        float gridW = c * _float(COLS) + _gap * _float(COLS - 1)
        float gridH = c * _float(_rows) + _gap * _float(_rows - 1)
        float oy = _cellY(c, gridH)

        // 顶部：左右箭头（各占右侧一格 ✓ —— 宽度按实测文字宽算 ✓）
        if _showHead and my < y + _pad + _headH and _arrowL != null and _arrowR != null {
            float aw = _arrowL.get_w() + _arrowR.get_w() + 12.0
            float ax = x + _w - _pad - aw
            if mx >= ax and mx < ax + aw * 0.5 { _shift_month(-1); return }
            if mx >= ax + aw * 0.5 and mx <= ax + aw { _shift_month(1); return }
            return
        }
        // 日期格：反算行列 ✓
        if my < oy or my > oy + gridH { return }
        int col = -1
        int row = -1
        for 0 : COLS - 1 to ci {
            float cx = _cellX(c, gridW, ci)
            if mx >= cx and mx <= cx + c { col = ci }
        }
        for 0 : _rows - 1 to ri {
            float cy = oy + _float(ri) * (c + _gap)
            if my >= cy and my <= cy + c { row = ri }
        }
        if col < 0 or row < 0 { return }
        int idx = row * COLS + col
        if idx < 0 or idx >= _dayNum.len() { return }
        int day = _dayNum[idx]
        if day <= 0 { return }                            // 空格不响应 ✓
        if _onPick != null { _onPick(day) }
        core.markFrameRedraw()
    }

    // ==================== 渲染 ====================
    func render(Renderer r) {
        if not _loaded or not visible { return }
        float c = _cell()
        float gridW = c * _float(COLS) + _gap * _float(COLS - 1)
        float gridH = c * _float(_rows) + _gap * _float(_rows - 1)
        float oy = _cellY(c, gridH)
        float rad = _cellRadius(c)

        // ---- 顶部：右对齐的月份文案 + 左右箭头 ----
        if _showHead and _monthLbl != null and _arrowL != null and _arrowR != null {
            float myY = y + _pad + (_headH - _monthLbl.get_h()) / 2.0
            _arrowR.set_pos(x + _w - _pad - _arrowR.get_w(), myY)
            _arrowL.set_pos(x + _w - _pad - _arrowR.get_w() - 12.0 - _arrowL.get_w(), myY)
            float mLeft = x + _w - _pad - _arrowR.get_w() - 12.0 - _arrowL.get_w() - 8.0 - _monthLbl.get_w()
            _monthLbl.set_pos(mLeft, myY)
            _monthLbl.render(r)
            _arrowL.render(r)
            _arrowR.render(r)
        }

        // ---- 星期头（每列在该列上方居中 ✓；标签为空则整行跳过 ✓）----
        if _weekLabels.len() > 0 {
            float wy = y + _pad + _headH
            for 0 : COLS - 1 to i {
                float cx = _cellX(c, gridW, i) + (c - _weekLbl[i].get_w()) / 2.0
                _weekLbl[i].set_pos(cx, wy + (_weekH - _weekLbl[i].get_h()) / 2.0)
                _weekLbl[i].render(r)
            }
        }

        // ---- 日期格 ----
        for 0 : _dayNum.len() - 1 to i {
            int day = _dayNum[i]
            if day <= 0 { continue }                      // 本月没有这一天 ⇒ 留空 ✓
            int row = i / COLS
            int col = i % COLS
            float cx = _cellX(c, gridW, col)
            float cy = oy + _float(row) * (c + _gap)
            bool isToday = _today > 0 and day == _today
            int st = get_mark(day)
            Color bg = _stateBg(st)
            Color tc = _stateFg(st)
            if isToday { bg = _cTodayBg; tc = _cTodayFg }

            // 透明底色直接跳过（默认的"未标记"就是这种 ✓ —— 中性默认 ✓）
            if bg != 0 {
                r.setColor(bg)
                r.fillRoundedRect(cx, cy, c, c, rad)
            }
            if isToday {
                // 今天画 2px 描边：外圈 + 内缩 1px 一圈 ⇒ 视觉上是粗描边 ✓
                r.setColor(_cTodayBd)
                r.drawRoundedRect(cx, cy, c, c, rad)
                r.drawRoundedRect(cx + 1.0, cy + 1.0, c - 2.0, c - 2.0, rad - 1.0)
            }
            Label lb = _dayLbl[i]
            lb.set_text_color(tc)
            lb.set_pos(cx + (c - lb.get_w()) / 2.0, cy + (c - lb.get_h()) / 2.0)
            lb.render(r)
        }

        // ---- 图例（states 为空 ⇒ 不画 ✓）----
        if _legendStates.len() > 0 and _lgTxt.len() == _legendStates.len() {
            float ly = oy + gridH + 6.0                  // 贴着网格下沿（贴卡片底会空一截 ✗）
            float lx = x + _pad
            for 0 : _legendStates.len() - 1 to i {
                int st = _legendStates[i]
                float sw = _legendSwatch
                float sy = ly + 2.0
                if st == LEG_TODAY {
                    // 今天的图例：白底 + 主色描边 ✓
                    r.setColor(_cTodayBg)
                    r.fillRoundedRect(lx, sy, sw, sw, 3.0)
                    r.setColor(_cTodayBd)
                    r.drawRoundedRect(lx, sy, sw, sw, 3.0)
                } else {
                    Color bg = _stateBg(st)
                    if bg != 0 {
                        r.setColor(bg)
                        r.fillRoundedRect(lx, sy, sw, sw, 3.0)
                    } else {
                        // 无色状态（如"未标记"）：画一圈浅描边，否则图例上看不见 ✗
                        r.setColor(_cWeekTxt)
                        r.drawRoundedRect(lx, sy, sw, sw, 3.0)
                    }
                }
                _lgTxt[i].set_pos(lx + sw + 6.0, sy - 1.0)
                _lgTxt[i].render(r)
                lx = lx + sw + 6.0 + _lgTxt[i].get_w() + _legendGap
            }
        }
    }

    func dispose() {
        for _weekLbl to l { l.dispose() }
        for _dayLbl to l { l.dispose() }
        for _lgTxt to l { l.dispose() }
        if _monthLbl != null { _monthLbl.dispose(); _monthLbl = null }
        if _arrowL != null { _arrowL.dispose(); _arrowL = null }
        if _arrowR != null { _arrowR.dispose(); _arrowR = null }
        _weekLbl = []; _dayLbl = []; _lgTxt = []; _dayNum = []
    }
}

// ==================== 模块级工具（页面也能直接用 ✓）====================

// 蔡勒公式（Zeller）：返回 0 = 周日 … 6 = 周六
//   1、2 月按上一年的 13、14 月算 ✓；蔡勒原式给的是 h=0 为周六 ⇒ +6 再取模转成"周日为 0" ✓
//   实测：2026-09-01 → 2（周二 ✓）、2026-09-26 → 6（周六 ✓）
func dow(int y, int m, int d): int {
    int yy = y
    int mm = m
    if mm < 3 { mm = mm + 12; yy = yy - 1 }
    int c = yy / 100
    int yb = yy % 100
    int h = (d + (13 * (mm + 1)) / 5 + yb + yb / 4 + c / 4 - 2 * c) % 7
    if h < 0 { h = h + 7 }
    return (h + 6) % 7
}

// 星期名：输入**名字表**（任意语言 ✓ 控件不预设语言 ✗）
//   names 按 0 = 周日 … 6 = 周六 排列 ✓
//   ⚠ 别用 `times.format(now, "%w")`：实测它返回**字面量 "%w"** ⇒ `as int` 静默变 0 ✗
//     （曾把"星期六"显示成"星期日" ✗ —— 这类静默转换只能靠对照截图发现 ✓）
export func weekdayName(int y, int m, int d, Array[string] names): string {
    if names.len() == 0 { return "" }
    return names[dow(y, m, d) % names.len()]
}

// 工厂
export func createCalendar(Dict opts): Calendar {
    Calendar c = new Calendar(); c.set(opts); return c
}
