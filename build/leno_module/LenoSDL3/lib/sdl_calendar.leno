// sdl_calendar.leno — 通用月历控件（Calendar）
// win.addCalendar({...}) 或 SDL3.createCalendar({...})
//
// ★ **通用**优先：控件本身不含任何领域语义（不认识"签到"✗、不认识语言 ✗）。
//   星期名、月份文案、图例文字、状态色、一周从哪天开始……全部由调用方给 ✓
//   默认值刻意**中性**：没有图例、未标记的日子没有底色、不写死语言 ✓
//   （原先把"已签/漏签/未签"这些签到词和图例焊在里面 ✗ —— 那是页面的事 ✓）
//
// ★ 零依赖：不算星期几就调不动（`times` 只给"现在"，给不了任意日期 ✓）⇒
//   内部用**蔡勒公式**自己算星期 ✓（纯整数运算，实测 2026-09-01 = 周二、2026-09-26 = 周六 ✓）。
//   也不依赖主题模块：配色全部可传（与 Badge 同一策略 ✓）
//
// ★ 布局：固定 7 列 × `rows` 行（默认 6 ⇒ 用不满的行自动留空 ✓）。
//   切月只改**已有格子**的文字与颜色（Label.set_text）⇒ 不重建控件树 ✓
//
// ★ 状态：`marks` 是 {日: 状态}，状态就是**颜色表的索引**（0/1/2 或你自定义的编号 ✓）
//   常量只为常用三态提供名字：ST_PLAIN / ST_FILLED / ST_ALERT
//   默认色：0 无底色、1 主色底白字、2 浅红底红字 —— 都可用 *_bg / *_fg 覆盖 ✓
//
// 用法（最小）：
//   var cal = SDL3.createCalendar({x:20, y:20, w:600, h:420, year:2026, month:9, today:26})
//   cal.set_week_labels(["日","一","二","三","四","五","六"])     // 不给则用内置短名 ✓
//   cal.set_week_start(1)                                        // 1 = 周一开始 ✓（默认 0 = 周日）
//   cal.set_month_fmt("%d 年 %d 月")                              // 默认 "%d-%02d" ✓
//   cal.set_legend([1, LEG_TODAY, 2, 0], ["已签","今日","漏签","未签"])   // 不给就没有图例 ✓
//   cal.on_pick(func(int day) { print(day) })
//
// 用法（签到式外观，见数据看板页 2 / Trae 应用）：
//   var cal = SDL3.createCalendar({year:y, month:m, today:d,
//                                  plain_bg:#F1F5F9FF, filled_bg:#2B6BE4FF, filled_fg:#FFFFFFFF,
//                                  alert_bg:#FEE4E2FF, alert_fg:#D92D20FF,
//                                  today_bg:#FFFFFFFF, today_fg:#2B6BE4FF, today_border:#2B6BE4FF})
//   cal.set_legend([1, Calendar.LEG_TODAY, 2, 0], ["已签","今日","漏签","未签"])
import "sdl_renderer.leno" as ren; use ren.Renderer
import "sdl_opts.leno" as dochk    // 选项对账：不认识的键会报一行警告（见 sdl_opts.leno ✓）
import "sdl_event.leno" as evt; use evt.Event
import "sdl_widget.leno" as wgt; use wgt.Widget
import "sdl_label.leno" as lbl; use lbl.Label
import "sdl_theme.leno" as theme; use theme.Color   // Color 类型在 sdl_theme 里 ✓（不引它字段类型无法解析 ✓）
import "sdl_core.leno" as core


// 本控件认的键 —— 由本文件全部 `.get("…")` **自动抽取**（是超集 ⇒ 可少报、不误报 ✓）
//   ⚠ 以后增删选项请重跑抽取（或人工核对），否则可能对合法用法误报 ✓
func _opts_keys(): Array[string] {
    return [
"alert_bg", "alert_fg", "arrow_color", "arrow_left", "arrow_right", "cell_max", "cell_min", "cell_radius", "cell_radius_ratio", "filled_bg", "filled_fg", "font_size_day", "font_size_head", "font_size_legend", "font_size_week", "gap", "h", "head_h", "head_text_color", "legend_gap", "legend_h", "legend_swatch", "marks", "month", "month_fmt", "pad", "plain_bg", "plain_fg", "rows", "show_head", "today", "today_bg", "today_border", "today_fg", "visible", "w", "week_h", "week_start", "week_text_color", "x", "y", "year"
]
}
export struct Calendar impl Widget {
    // 常用三态的名字（值就是 colors 表的索引 ✓，可自定义更多态 ✓）
    const ST_PLAIN  = 0
    const ST_FILLED = 1
    const ST_ALERT  = 2

    // 图例里代表"今天"那一项的伪状态（不是真实的每日状态 ✓）
    const LEG_TODAY = -1

    const COLS = 7

    // ---- 位置与尺寸（布局容器通过 set_pos/set_size 驱动 ✓）----
    float x = 0.0, y = 0.0
    float _w = 620.0, _h = 400.0
    bool _natW = false, _natH = false      // 调用方没显式给尺寸 ⇒ 用自然尺寸 ✓

    // ---- 数据 ----
    pri int year = 2026
    pri int month = 1
    int _today = 0                         // 0 = 不标"今天"
    pri Dict marks = {}                       // {日: 状态}
    pri int rows = 6
    pri int weekStart = 0                     // 0 = 周日开头（默认）✓ / 1 = 周一开头 ✓

    // ---- 文案（全部可配 ✓ 控件不认识语言 ✗）----
    // 默认给一套短名；调用方可用 set_week_labels 换成任意语言（或空数组 ⇒ 不画星期头 ✓）
    pri Array[string] weekLabels = ["日", "一", "二", "三", "四", "五", "六"]
    pri string monthFmt = "%d-%02d"           // 月份文案格式串（format 的 C 风格 ✓）
    pri string arrowLeft = "‹"                // 切月箭头字符（字体缺字形时可换成文字 ✓）
    pri string arrowRight = "›"

    // ---- 外观 ----
    float _pad = 16.0
    pri float headH = 26.0                    // 顶部：月份文案 + 左右箭头
    pri float weekH = 22.0                    // 星期头
    pri float legendH = 22.0                  // 图例
    pri float gap = 10.0                      // 格子间距
    pri float cellMax = 40.0                  // 格子边长上限
    pri float cellMin = 22.0
    pri float radiusRatio = 0.24              // 格子圆角 = 边长 × 比例（给 cell_radius 则直接用它 ✓）
    pri float radiusFixed = -1.0
    pri float fsWeek = 12.0
    pri float fsDay = 13.0
    pri float fsHead = 12.0
    pri float fsLegend = 11.0
    pri float legendSwatch = 10.0
    pri float legendGap = 18.0
    pri bool showHead = true

    // ---- 状态色表（按状态索引 ✓；默认：未标记无底色 ⇒ 中性 ✓）----
    pri Color cPlainBg  = #00000000           // 0：透明 ⇒ 不画底色 ✓
    pri Color cPlainFg  = #6B7280FF
    pri Color cFilledBg = #2B6BE4FF           // 1：主色底
    pri Color cFilledFg = #FFFFFFFF
    pri Color cAlertBg  = #FEE4E2FF           // 2：浅红底
    pri Color cAlertFg  = #D92D20FF
    pri Color cTodayBg  = #FFFFFFFF
    pri Color cTodayFg  = #2B6BE4FF
    pri Color cTodayBd  = #2B6BE4FF
    pri Color cHeadTxt  = #111827FF           // 月份文案
    pri Color cWeekTxt  = #9CA3AFFF           // 星期头 / 图例文字
    pri Color cArrow    = #6B7280FF

    // ---- 图例（默认**空** ⇒ 不画 ✓；由 set_legend 决定 ✓）----
    pri Array[int]    legendStates = []
    pri Array[string] legendLabels = []

    // ---- 子控件（构造时一次性建好 ✓ 切月只改字 ✓）----
    pri Array[Label] weekLbl = []
    pri Array[Label] dayLbl = []
    pri Array[int]   dayNum = []              // 该格是几号；0 = 本月没有这一天（留空 ✓）
    pri Label? monthLbl = null
    pri Label? arrowL = null
    pri Label? arrowR = null
    pri Array[Label] lgTxt = []               // 图例文字（个数由 set_legend 决定 ✓）
    bool _loaded = false
    bool visible = true

    // ---- 回调（不注册就纯显示 ✓）----
    pri func(int):void onPick = null
    pri func(int, int):void onMonthChange = null

    // ==================== 构造 ====================

    func set(Dict opts) {
        dochk.check("sdl_calendar", opts, _opts_keys())   // ★ 选项对账（2026-09-29 铺开 ✓）
        x = opts.get("x", 0.0)
        y = opts.get("y", 0.0)
        float wOpt = opts.get("w", 0.0)
        float hOpt = opts.get("h", 0.0)
        _natW = wOpt <= 0.0
        _natH = hOpt <= 0.0
        _w = wOpt
        _h = hOpt
        year = opts.get("year", 2026)
        month = opts.get("month", 1)
        _today = opts.get("today", 0)
        rows = opts.get("rows", 6)
        weekStart = opts.get("week_start", 0)
        monthFmt = opts.get("month_fmt", "%d-%02d")
        arrowLeft = opts.get("arrow_left", "‹")
        arrowRight = opts.get("arrow_right", "›")
        _pad = opts.get("pad", 16.0)
        headH = opts.get("head_h", 26.0)
        weekH = opts.get("week_h", 22.0)
        legendH = opts.get("legend_h", 22.0)
        gap = opts.get("gap", 10.0)
        cellMax = opts.get("cell_max", 40.0)
        cellMin = opts.get("cell_min", 22.0)
        radiusRatio = opts.get("cell_radius_ratio", 0.24)
        radiusFixed = opts.get("cell_radius", -1.0)
        fsWeek = opts.get("font_size_week", 12.0)
        fsDay = opts.get("font_size_day", 13.0)
        fsHead = opts.get("font_size_head", 12.0)
        fsLegend = opts.get("font_size_legend", 11.0)
        legendSwatch = opts.get("legend_swatch", 10.0)
        legendGap = opts.get("legend_gap", 18.0)
        showHead = opts.get("show_head", true)
        visible = opts.get("visible", true)
        // 状态色（名字按常用三态 ✓；要更多态请直接改字段或用 set_state_color ✓）
        if opts.get("plain_bg") is Color => t { cPlainBg = t }
        if opts.get("plain_fg") is Color => t { cPlainFg = t }
        if opts.get("filled_bg") is Color => t { cFilledBg = t }
        if opts.get("filled_fg") is Color => t { cFilledFg = t }
        if opts.get("alert_bg") is Color => t { cAlertBg = t }
        if opts.get("alert_fg") is Color => t { cAlertFg = t }
        if opts.get("today_bg") is Color => t { cTodayBg = t }
        if opts.get("today_fg") is Color => t { cTodayFg = t }
        if opts.get("today_border") is Color => t { cTodayBd = t }
        if opts.get("head_text_color") is Color => t { cHeadTxt = t }
        if opts.get("week_text_color") is Color => t { cWeekTxt = t }
        if opts.get("arrow_color") is Color => t { cArrow = t }
        if opts.get("marks") is Dict => m { marks = m }

        // 星期头：7 个标签，文字按 week_start 轮转 ✓（默认短名；set_week_labels 可换 ✓）
        for 0 : COLS - 1 to i {
            weekLbl.add(lbl.createLabel({x:0, y:0, text:weekLabel(i), font_size:fsWeek, text_color:cWeekTxt}))
        }
        // 日期格：7 × rows，一次性建满 ⇒ 切月只改文字 ✓
        int total = COLS * rows
        for 0 : total - 1 to i {
            dayLbl.add(lbl.createLabel({x:0, y:0, text:"", font_size:fsDay, text_color:cPlainFg}))
            dayNum.add(0)
        }
        if showHead {
            monthLbl = lbl.createLabel({x:0, y:0, text:"", font_size:fsHead, text_color:cHeadTxt})
            arrowL = lbl.createLabel({x:0, y:0, text:arrowLeft, font_size:fsHead + 2.0, text_color:cArrow})
            arrowR = lbl.createLabel({x:0, y:0, text:arrowRight, font_size:fsHead + 2.0, text_color:cArrow})
        }
        relabel()
        _loaded = true
    }

    // ==================== 数据 ====================
    // 蔡勒公式的实现放在**模块级** `dow()`（见文件末尾 ✓）—— 页面也要用同一个算法 ✓
    //   ★ 2026-09-30：这里原来还有一层"同名委托"方法 `func dow(...) { return dow(...) }`
    //   （重构前叫 `_dow` —— 那时不撞名 ✓）。去下划线改名成 `dow` 后它就与**模块级** `dow`
    //   撞名了，而方法体内的裸 `dow(...)` 会被优先解析成"调用本 struct 的同名方法"
    //   ⇒ 自己调自己 ⇒ **无限递归**（实测：数据看板/dashboard 直接「调用栈溢出 ✗」，
    //     而编译期一声不吭 —— 又一处"编译通过、运行才炸"✗）。
    //   ⇒ 直接删掉这一层委托：方法体内改调模块级 `dow()`（同一个实现，零漂移 ✓）。
    //   ⚠ 以后要留转发方法，必须换一个**不与模块级函数撞名**的名字 ✓

    // 第 i 列（0 = 最左）的星期名：按 week_start 轮转 ✓
    pri func weekLabel(int i): string {
        if weekLabels.len() == 0 { return "" }
        return weekLabels[(weekStart + i) % 7]
    }

    pri func daysInMonth(): int {
        if month == 2 {
            // 闰年：4 整除且不是 100 的倍数，或 400 的倍数 ✓
            if (year % 4 == 0 and year % 100 != 0) or year % 400 == 0 { return 29 }
            return 28
        }
        if month == 4 or month == 6 or month == 9 or month == 11 { return 30 }
        return 31
    }

    // 把当前年月填进已有格子（只改文字/颜色 ⇒ 不重建控件 ✓）
    pri func relabel() {
        if dayLbl.len() == 0 { return }
        int firstDow = dow(year, month, 1)                 // 1 号是周几（0 = 周日）
        int off = (firstDow - weekStart + 7) % 7             // ⇒ 它在网格里的列号 ✓
        int dim = daysInMonth()
        for 0 : dayNum.len() - 1 to i {
            int d = i - off + 1
            if d < 1 or d > dim {
                dayNum[i] = 0
                dayLbl[i].set_text("")
            } else {
                dayNum[i] = d
                dayLbl[i].set_text(d as string)
            }
        }
        if monthLbl != null { monthLbl.set_text(format(monthFmt, year, month)) }
        core.markFrameRedraw()
    }

    // 切月（delta = -1 上一月 / +1 下一月 ✓）；会触发 on_month_change（若已注册）
    pri func shift_month(int delta) {
        int m = month + delta
        int y = year
        if m < 1 { m = 12; y = y - 1 }
        if m > 12 { m = 1; y = y + 1 }
        month = m; year = y
        // 切月后"今天"通常不再属于本月 ⇒ 由调用方按需 set_today(0) ✓
        relabel()
        if onMonthChange != null { onMonthChange(year, month) }
    }

    // ==================== 设置方法 ====================
    func set_month(int y, int m) { year = y; month = m; relabel() }
    func get_year(): int  { return year }
    func get_month(): int { return month }
    func set_today(int d) { _today = d; core.markFrameRedraw() }
    func get_today(): int { return _today }
    func set_mark(int day, int state) { marks[day] = state; core.markFrameRedraw() }
    func set_marks(Dict m) { marks = m; core.markFrameRedraw() }
    func clear_marks() { marks = {}; core.markFrameRedraw() }
    func get_mark(int day): int {
        // Dict 取值是 any ⇒ 必须显式转 ✓（否则返回类型不匹配 ✗）
        if marks.has(day) { return marks[day] as int }
        return ST_PLAIN
    }

    // 星期名（任意语言 ✓；空数组 ⇒ 不画星期头 ✓）—— 会顺带更新表头文字 ✓
    func set_week_labels(Array[string] names) {
        weekLabels = names
        for 0 : weekLbl.len() - 1 to i { weekLbl[i].set_text(weekLabel(i)) }
        core.markFrameRedraw()
    }
    // 一周从哪天开始：0 = 周日、1 = 周一 … ✓（会重排表头与日期格 ✓）
    func set_week_start(int ws) { weekStart = ws; update_week_labels(); relabel() }
    func get_week_start(): int { return weekStart }
    pri func update_week_labels() {
        for 0 : weekLbl.len() - 1 to i { weekLbl[i].set_text(weekLabel(i)) }
    }
    // 月份文案格式串（C 风格 format ✓），如 "%d 年 %d 月" / "%B %Y" / "%d-%02d" ✓
    func set_month_fmt(string fmt) { monthFmt = fmt; relabel() }
    // 切月箭头字符（字体缺字形时换成 "<<" / ">>" 也行 ✓）
    func set_arrows(string left, string right) {
        arrowLeft = left; arrowRight = right
        if arrowL != null { arrowL.set_text(left) }
        if arrowR != null { arrowR.set_text(right) }
        core.markFrameRedraw()
    }
    // 图例：states 里可含 LEG_TODAY（今天那种"白底 + 描边"的样式 ✓）；
    //   两个数组都空 ⇒ 不画图例 ✓（默认就是空 ✓）
    func set_legend(Array[int] states, Array[string] labels) {
        legendStates = states
        legendLabels = labels
        for lgTxt to l { l.dispose() }
        lgTxt = []
        for 0 : states.len() - 1 to i {
            string t = ""
            if i < labels.len() { t = labels[i] }
            lgTxt.add(lbl.createLabel({x:0, y:0, text:t, font_size:fsLegend, text_color:cWeekTxt}))
        }
        core.markFrameRedraw()
    }
    // 状态色（状态编号任意 ✓，便于自定义多于三态的场景 ✓）
    func set_state_color(int state, Color bg, Color fg) {
        if state == ST_PLAIN { cPlainBg = bg; cPlainFg = fg }
        else if state == ST_FILLED { cFilledBg = bg; cFilledFg = fg }
        else if state == ST_ALERT { cAlertBg = bg; cAlertFg = fg }
        core.markFrameRedraw()
    }
    pri func stateBg(int st): Color {
        if st == ST_FILLED { return cFilledBg }
        if st == ST_ALERT { return cAlertBg }
        return cPlainBg
    }
    pri func stateFg(int st): Color {
        if st == ST_FILLED { return cFilledFg }
        if st == ST_ALERT { return cAlertFg }
        return cPlainFg
    }

    func on_pick(func(int):void cb) { onPick = cb }
    func on_month_change(func(int, int):void cb) { onMonthChange = cb }
    func set_visible(bool v) { visible = v; core.markFrameRedraw() }
    func is_visible(): bool { return visible }
    func set_enabled(bool e) {}

    // ==================== 几何 ====================
    pri func legendRows(): float {
        if legendStates.len() == 0 { return 0.0 }
        return legendH
    }
    // 格子边长：按可用宽度与高度取较小者，再夹到 [cellMin, cellMax] ✓
    pri func cell(): float {
        float availW = _w - 2.0 * _pad - gap * _float(COLS - 1)
        float cw = availW / _float(COLS)
        float headH = 0.0
        if showHead { headH = self.headH }      // 局部 headH 遮蔽字段 ⇒ 必须显式 self.
        float availH = _h - 2.0 * _pad - headH - weekH - legendRows() - gap * _float(rows - 1)
        float chh = availH / _float(rows)
        float c = cw
        if chh < c { c = chh }
        if c > cellMax { c = cellMax }
        if c < cellMin { c = cellMin }
        return c
    }
    pri func cellRadius(float c): float {
        if radiusFixed >= 0.0 { return radiusFixed }
        return c * radiusRatio
    }
    // 第 row 行、第 col 列的格子左上角（含整块网格在可用区里居中 ✓）
    pri func cellX(float c, float gridW, int col): float {
        float ox = x + _pad
        if _w - 2.0 * _pad > gridW { ox = x + (_w - gridW) / 2.0 }
        return ox + _float(col) * (c + gap)
    }
    pri func cellY(float c, float gridH): float {
        float headH = 0.0
        if showHead { headH = self.headH }      // 局部 headH 遮蔽字段 ⇒ 必须显式 self.
        float oy = y + _pad + headH + weekH
        float avail = _h - 2.0 * _pad - headH - weekH - legendRows()
        if avail > gridH { oy = y + _pad + headH + weekH + (avail - gridH) / 2.0 }
        return oy
    }

    // ==================== 查询（布局用 ✓）====================
    func get_x(): float { return x }
    func get_y(): float { return y }
    func get_w(): float {
        if _natW { return cellMax * _float(COLS) + gap * _float(COLS - 1) + 2.0 * _pad }
        return _w
    }
    func get_h(): float {
        if _natH {
            float headH = 0.0
            if showHead { headH = self.headH }      // 局部 headH 遮蔽字段 ⇒ 必须显式 self.
            return 2.0 * _pad + headH + weekH + _float(rows) * cellMax + gap * _float(rows - 1) + legendRows()
        }
        return _h
    }
    func set_pos(float px, float py) { x = px; y = py }
    func set_size(float sw, float sh) {
        if sw > 0.0 { _w = sw; _natW = false }
        if sh > 0.0 { _h = sh; _natH = false }
    }

    // ==================== 事件 ====================
    func process(Event ev) {
        if not _loaded or not visible { return }
        var[float, float](mx, my) = ev.mousePos()
        if core.inPopupCapture(mx, my) { return }        // 弹层展开时不穿透 ✓（与 Canvas 同一守卫 ✓）
        if mx < x or mx > x + _w or my < y or my > y + _h { return }
        if ev.isMouseMotion() { core.markFrameMotion(); return }
        if not ev.isMouseButtonDown() { return }
        if ev.mouseButton() != 1 { return }              // 只认左键 ✓

        float c = cell()
        float gridW = c * _float(COLS) + gap * _float(COLS - 1)
        float gridH = c * _float(rows) + gap * _float(rows - 1)
        float oy = cellY(c, gridH)

        // 顶部：左右箭头（各占右侧一格 ✓ —— 宽度按实测文字宽算 ✓）
        if showHead and my < y + _pad + headH and arrowL != null and arrowR != null {
            float aw = arrowL.get_w() + arrowR.get_w() + 12.0
            float ax = x + _w - _pad - aw
            if mx >= ax and mx < ax + aw * 0.5 { shift_month(-1); return }
            if mx >= ax + aw * 0.5 and mx <= ax + aw { shift_month(1); return }
            return
        }
        // 日期格：反算行列 ✓
        if my < oy or my > oy + gridH { return }
        int col = -1
        int row = -1
        for 0 : COLS - 1 to ci {
            float cx = cellX(c, gridW, ci)
            if mx >= cx and mx <= cx + c { col = ci }
        }
        for 0 : rows - 1 to ri {
            float cy = oy + _float(ri) * (c + gap)
            if my >= cy and my <= cy + c { row = ri }
        }
        if col < 0 or row < 0 { return }
        int idx = row * COLS + col
        if idx < 0 or idx >= dayNum.len() { return }
        int day = dayNum[idx]
        if day <= 0 { return }                            // 空格不响应 ✓
        if onPick != null { onPick(day) }
        core.markFrameRedraw()
    }

    // ==================== 渲染 ====================
    func render(Renderer r) {
        if not _loaded or not visible { return }
        float c = cell()
        float gridW = c * _float(COLS) + gap * _float(COLS - 1)
        float gridH = c * _float(rows) + gap * _float(rows - 1)
        float oy = cellY(c, gridH)
        float rad = cellRadius(c)

        // ---- 顶部：右对齐的月份文案 + 左右箭头 ----
        if showHead and monthLbl != null and arrowL != null and arrowR != null {
            float myY = y + _pad + (headH - monthLbl.get_h()) / 2.0
            arrowR.set_pos(x + _w - _pad - arrowR.get_w(), myY)
            arrowL.set_pos(x + _w - _pad - arrowR.get_w() - 12.0 - arrowL.get_w(), myY)
            float mLeft = x + _w - _pad - arrowR.get_w() - 12.0 - arrowL.get_w() - 8.0 - monthLbl.get_w()
            monthLbl.set_pos(mLeft, myY)
            monthLbl.render(r)
            arrowL.render(r)
            arrowR.render(r)
        }

        // ---- 星期头（每列在该列上方居中 ✓；标签为空则整行跳过 ✓）----
        if weekLabels.len() > 0 {
            float wy = y + _pad + headH
            for 0 : COLS - 1 to i {
                float cx = cellX(c, gridW, i) + (c - weekLbl[i].get_w()) / 2.0
                weekLbl[i].set_pos(cx, wy + (weekH - weekLbl[i].get_h()) / 2.0)
                weekLbl[i].render(r)
            }
        }

        // ---- 日期格 ----
        for 0 : dayNum.len() - 1 to i {
            int day = dayNum[i]
            if day <= 0 { continue }                      // 本月没有这一天 ⇒ 留空 ✓
            int row = i / COLS
            int col = i % COLS
            float cx = cellX(c, gridW, col)
            float cy = oy + _float(row) * (c + gap)
            bool isToday = _today > 0 and day == _today
            int st = get_mark(day)
            Color bg = stateBg(st)
            Color tc = stateFg(st)
            if isToday { bg = cTodayBg; tc = cTodayFg }

            // 透明底色直接跳过（默认的"未标记"就是这种 ✓ —— 中性默认 ✓）
            if bg != 0 {
                r.setColor(bg)
                r.fillRoundedRect(cx, cy, c, c, rad)
            }
            if isToday {
                // 今天画 2px 描边：外圈 + 内缩 1px 一圈 ⇒ 视觉上是粗描边 ✓
                r.setColor(cTodayBd)
                r.drawRoundedRect(cx, cy, c, c, rad)
                r.drawRoundedRect(cx + 1.0, cy + 1.0, c - 2.0, c - 2.0, rad - 1.0)
            }
            Label lb = dayLbl[i]
            lb.set_text_color(tc)
            lb.set_pos(cx + (c - lb.get_w()) / 2.0, cy + (c - lb.get_h()) / 2.0)
            lb.render(r)
        }

        // ---- 图例（states 为空 ⇒ 不画 ✓）----
        if legendStates.len() > 0 and lgTxt.len() == legendStates.len() {
            float ly = oy + gridH + 6.0                  // 贴着网格下沿（贴卡片底会空一截 ✗）
            float lx = x + _pad
            for 0 : legendStates.len() - 1 to i {
                int st = legendStates[i]
                float sw = legendSwatch
                float sy = ly + 2.0
                if st == LEG_TODAY {
                    // 今天的图例：白底 + 主色描边 ✓
                    r.setColor(cTodayBg)
                    r.fillRoundedRect(lx, sy, sw, sw, 3.0)
                    r.setColor(cTodayBd)
                    r.drawRoundedRect(lx, sy, sw, sw, 3.0)
                } else {
                    Color bg = stateBg(st)
                    if bg != 0 {
                        r.setColor(bg)
                        r.fillRoundedRect(lx, sy, sw, sw, 3.0)
                    } else {
                        // 无色状态（如"未标记"）：画一圈浅描边，否则图例上看不见 ✗
                        r.setColor(cWeekTxt)
                        r.drawRoundedRect(lx, sy, sw, sw, 3.0)
                    }
                }
                lgTxt[i].set_pos(lx + sw + 6.0, sy - 1.0)
                lgTxt[i].render(r)
                lx = lx + sw + 6.0 + lgTxt[i].get_w() + legendGap
            }
        }
    }

    func dispose() {
        for weekLbl to l { l.dispose() }
        for dayLbl to l { l.dispose() }
        for lgTxt to l { l.dispose() }
        if monthLbl != null { monthLbl.dispose(); monthLbl = null }
        if arrowL != null { arrowL.dispose(); arrowL = null }
        if arrowR != null { arrowR.dispose(); arrowR = null }
        weekLbl = []; dayLbl = []; lgTxt = []; dayNum = []
    }
}

// ==================== 模块级工具（页面也能直接用 ✓）====================

// 蔡勒公式（Zeller）：返回 0 = 周日 … 6 = 周六
//   1、2 月按上一年的 13、14 月算 ✓；蔡勒原式给的是 h=0 为周六 ⇒ +6 再取模转成"周日为 0" ✓
//   实测：2026-09-01 → 2（周二 ✓）、2026-09-26 → 6（周六 ✓）
func dow(int y, int m, int d): int {
    int yy = y
    int mm = m
    if mm < 3 { mm = mm + 12; yy = yy - 1 }
    int c = yy / 100
    int yb = yy % 100
    int h = (d + (13 * (mm + 1)) / 5 + yb + yb / 4 + c / 4 - 2 * c) % 7
    if h < 0 { h = h + 7 }
    return (h + 6) % 7
}

// 星期名：输入**名字表**（任意语言 ✓ 控件不预设语言 ✗）
//   names 按 0 = 周日 … 6 = 周六 排列 ✓
//   ⚠ 别用 `times.format(now, "%w")`：实测它返回**字面量 "%w"** ⇒ `as int` 静默变 0 ✗
//     （曾把"星期六"显示成"星期日" ✗ —— 这类静默转换只能靠对照截图发现 ✓）
export func weekdayName(int y, int m, int d, Array[string] names): string {
    if names.len() == 0 { return "" }
    return names[dow(y, m, d) % names.len()]
}

// 工厂
export func createCalendar(Dict opts): Calendar {
    Calendar c = new Calendar(); c.set(opts); return c
}


