
// sdl_button.leno — 按钮控件
// 通过 win.addButton({...}) 创建，run() 自动处理交互和渲染
import "sdl_renderer.leno" as ren; use ren.Renderer
import "sdl_opts.leno" as dochk    // 选项对账：不认识的键会报一行警告（见 sdl_opts.leno ✓）
import "sdl_font.leno" as fnt; use fnt.Font
import "sdl_event.leno" as evt; use evt.Event
import "sdl_core.leno" as core; use core.(SystemCursor, sdl3)
import "sdl_widget.leno" as wgt; use wgt.Widget
import "sdl_tooltip.leno" as tip
import "sdl_image.leno" as img
import "sdl_theme.leno" as theme; use theme.(Theme, Themeable)
use theme.Color


// 本控件认的键 —— 由本文件全部 `.get("…")` **自动抽取**（是超集 ⇒ 可少报、不误报 ✓）
//   ⚠ 以后增删选项请重跑抽取（或人工核对），否则可能对合法用法误报 ✓
func _opts_keys(): Array[string] {
    return [
"align", "background", "bg_color", "bg_image", "border", "border_color", "cursor", "enabled", "font_path", "font_size", "font_style", "h", "hover_color", "image_alpha", "image_gap", "image_mode", "image_path", "image_path_disabled", "image_path_hover", "image_path_pressed", "image_pos", "image_size", "image_tint", "padding", "pressed_color", "radius", "shadow", "text", "text_color", "tip", "type", "visible", "w", "x", "y"
]
}
export struct Button impl Widget, Themeable {
    // ==================== 关联常量 ====================
    const IMG_LEFT   = 0   // 图标在文字左侧
    const IMG_RIGHT  = 1   // 图标在文字右侧
    const IMG_TOP    = 2   // 图标在文字上方
    const IMG_BOTTOM = 3   // 图标在文字下方

    const IMG_ASPECT_FIT   = 0   // 内容模式：保持比例，完整显示
    const IMG_STRETCH      = 1   // 内容模式：拉伸填满
    const IMG_ASPECT_FILL  = 2   // 内容模式：覆盖填满（裁剪）

    // 文字水平对齐（常量与 sdl_label.leno 同名同值 ✓）
    // 为什么加：导航项/列表行这类「图标 + 左对齐文字」的按钮此前文字**只能居中** ✗
    //（见 leno_gui/控件/数据看板/dashboard_sidebar.leno 的侧栏）
    const ALIGN_LEFT   = 0
    const ALIGN_CENTER = 1
    const ALIGN_RIGHT  = 2

    string text = "Button"
    float x = 0.0, y = 0.0, w = 100.0, h = 40.0
    pri float radius = 6.0      // 圆角半径
    pri float fontSize = 15.0   // 字体大小
    pri string fontPath = ""    // 字体路径（空则自动选择）
    pri int fontStyle = 0       // 字体样式（STYLE_BOLD|STYLE_ITALIC 等）
    pri Font? font              // 字体缓存
    // ★ 文字测量缓存：text 不变时避免每帧 measureString
    pri float cachedTextW = 0.0
    pri float cachedTextH = 0.0
    pri string cachedTextKey = "\x01"
    pri Color bgColor = #3C8CDCFF   // 背景色（默认 primary）
    pri Color txtColor = #FFFFFFFF  // 文字色
    pri int textAlign = ALIGN_CENTER    // 文字水平对齐（**默认居中 = 历史行为**，零破坏 ✓）
                                    // ⚠ 不给外面看 ⇒ 对外用 opts 的 `align` ✓ 或 set_align() ✓
    pri Color bdrColor = 0          // 边框色（0 = 自动：按背景提亮 ✓，见 dashboard 的浅灰/浅蓝描边）
    pri float padding = 0.0         // 文字左右内边距（**默认 0 = 历史行为**，零破坏 ✓；见 align:"left"）
    pri Color hovColor = 0          // 悬停背景色（为 0 时自动计算）
    pri Color prColor = 0           // 按下背景色（为 0 时自动变暗）
    pri int cursor = SystemCursor.POINTER   // 悬停鼠标样式（默认手型）
    pri func():void onClick    // 点击回调
    bool hover = false
    pri bool wasHover = false  // 上一帧悬停状态
    bool enabled = true
    bool visible = true
    pri bool showShadow = true // 是否显示阴影
    pri bool showBorder = true // 是否显示边框
    pri string btnType = ""   // 预设类型（primary/danger/success/warning/dark/normal）
    pri bool showBackground = true // 是否显示背景（false = 仅显示图标，无框无背景）
    pri bool autoImgEffect = true  // 未提供 hover/press 图时，自动给普通图标加色调效果
    pri bool loaded = false
    pri string tipText = ""    // 悬停提示文本（空 = 不提示）（pri：仅自己可用 ✓）
                               // ⚠ 不能叫 `tip` ✗ —— 本文件 `import "sdl_tooltip.leno" as tip`
                               //   已占这个裸名（实测：改成 tip 后 `tip.tipReport(…)` 里的 tip
                               //   变成了字符串字段 ✗ ⇒ 编译器报「类型 'string' 没有方法 'tipReport'」）

    // ==================== 图片（图标） ====================
    // 设计参考：Qt setIcon/setIconSize、Material iconGravity、WinForms TextImageRelation
    pri string imagePath = ""   // 图片路径（空 = 无图）
    pri int    imgPos = IMG_LEFT   // 图标相对文字位置（IMG_LEFT/RIGHT/TOP/BOTTOM）
    pri float  imgSize = 0.0    // 图标边长（0 = 自动：取 min(h-8, 自然高)）
    pri float  imgGap = 6.0     // 图标与文字间距
    pri int    imgAlpha = 255   // 图标透明度 0~255
    pri Color    imgTint = -1   // 图标着色（-1 = 不着色，其余为 #RRGGBBAA 着色）
    pri Ptr[u8]? imgTex   // 图片纹理（懒加载，dispose 释放）
    pri string imgLoadPath = "" // 已尝试加载的路径（避免加载失败每帧重试）

    // ==================== 状态图片（对齐 iOS UIButton.setImage(_:forState:)） ====================
    pri string imgPathHover = "";    pri Ptr[u8]? imgTexHover;    pri string imgLoadHover = ""
    pri string imgPathPressed = "";  pri Ptr[u8]? imgTexPressed;  pri string imgLoadPressed = ""
    pri string imgPathDisabled = ""; pri Ptr[u8]? imgTexDisabled; pri string imgLoadDisabled = ""
    pri bool   pressed = false       // 鼠标按下且悬停中（用于 pressed 态图片 / 按下高亮）

    // ==================== 内容模式（对齐 iOS contentMode / Android scaleType） ====================
    // 内容模式（IMG_ASPECT_FIT/STRETCH/ASPECT_FILL）
    pri int imgMode = IMG_ASPECT_FIT

    // ==================== 背景图（对齐 iOS setBackgroundImage） ====================
    pri string bgImagePath = ""; pri Ptr[u8]? bgTex; pri string bgLoadPath = ""

    // ==================== 预设类型 ====================
    pri func apply_type(string t) {
        Theme th = theme.getTheme()
        switch t {
            case "primary"  { bgColor = th.btnPrimary }
            case "danger"   { bgColor = th.btnDanger }
            case "success"  { bgColor = th.btnSuccess }
            case "warning"  { bgColor = th.btnWarning }
            case "dark"     { bgColor = th.btnDark }
            default {}
        }
    }

    pri func ensure_font() {
        if font == null or not font.ok {
            if font != null and font.ok { fnt.releaseFont(font) }
            if fontPath != "" {
                font = fnt.acquireFont(fontPath, fontSize)
            } else {
                font = fnt.acquireFontAuto(fontSize)
            }
            if font.ok and fontStyle != 0 { font.setStyle(fontStyle) }
            cachedTextKey = "\x01"   // 字体变化，缓存失效
        }
    }

    // 懒加载图片纹理（需要有效渲染器，render 时调用）
    pri func ensure_image(Renderer r) {
        Ptr[u8] h = r.handle
        if imagePath != "" and imgTex == null and imgLoadPath != imagePath {
            imgTex = img.loadTexture(h, imagePath); imgLoadPath = imagePath
        }
        if imgPathHover != "" and imgTexHover == null and imgLoadHover != imgPathHover {
            imgTexHover = img.loadTexture(h, imgPathHover); imgLoadHover = imgPathHover
        }
        if imgPathPressed != "" and imgTexPressed == null and imgLoadPressed != imgPathPressed {
            imgTexPressed = img.loadTexture(h, imgPathPressed); imgLoadPressed = imgPathPressed
        }
        if imgPathDisabled != "" and imgTexDisabled == null and imgLoadDisabled != imgPathDisabled {
            imgTexDisabled = img.loadTexture(h, imgPathDisabled); imgLoadDisabled = imgPathDisabled
        }
        if bgImagePath != "" and bgTex == null and bgLoadPath != bgImagePath {
            bgTex = img.loadTexture(h, bgImagePath); bgLoadPath = bgImagePath
        }
    }

    // ==================== set 初始化 ====================

    func set(Dict opts) {
        dochk.check("sdl_button", opts, _opts_keys())   // ★ 选项对账（2026-09-29 铺开 ✓）
        // 主题默认配色（opts 覆盖优先级更高）
        Theme th = theme.getTheme()
        bgColor = th.btnPrimary
        txtColor = th.txtOnAccent
        text = opts.get("text", "Button")
        x    = opts.get("x", 0)
        y    = opts.get("y", 0)
        w    = opts.get("w", 100)
        h    = opts.get("h", 40)

        // 圆角
        radius   = opts.get("radius", 6)
        // 字体大小
        fontSize = opts.get("font_size", 15)
        // 字体路径（空则自动匹配系统字体）
        fontPath = opts.get("font_path", "")
        // 字体样式（粗体/斜体/下划线等）
        fontStyle = opts.get("font_style", 0)

        // 预设类型（优先级低于显式 color）
        if opts.get("type") is string => tp { btnType = tp; apply_type(tp) }

        // 颜色：opts 未传则保持主题色（bgColor 等已在上面从 Theme 赋值）
        if opts.get("bg_color") is Color => t { bgColor = t }
        if opts.get("text_color") is Color => t { txtColor = t }
        if opts.get("border_color") is Color => t { bdrColor = t }
        // 文字水平对齐（默认**居中** = 历史行为 ✓；支持 "left"/"center"/"right" 或 int 常量）
        var av = opts.get("align", ALIGN_CENTER)
        if av is string {
            string avs = av
            if avs == "left" { textAlign = ALIGN_LEFT }
            else if avs == "right" { textAlign = ALIGN_RIGHT }
            else { textAlign = ALIGN_CENTER }
        } else {
            textAlign = _int(av)
        }
        // 文字左右内边距（opt-in；默认 0 ⇒ 与历史绘制完全一致 ✓）—— 配合 align:"left" 用，
        // 否则左对齐文字会贴到按钮左边缘（导航项/列表行那种"图标 + 文字"必须留白 ✓）
        padding = _float(opts.get("padding", 0.0))
        if opts.get("hover_color") is Color => t { hovColor = t }
        if opts.get("pressed_color") is Color => t { prColor = t }

        // 外观开关
        showShadow = opts.get("shadow", true)
        showBorder = opts.get("border", true)
        // ⚠ `background` 是**开关**（true/false = 画不画底/框/阴影 ✓），**不是颜色** ✗
        //   实测最容易踩的：`background: #RRGGBBFF` 或 `background: {bg: …}` —— 旧代码直接
        //   `opts.get("background", true)` ⇒ 非 false 一律当"开"⇒ **静默变真** ✗
        //   （用户以为在设颜色，屏幕上却毫无变化，且**一句提示都没有** ✗）
        //   ⇒ 显式报一句：颜色请走 bg_color / hover_color / pressed_color ✓
        //   ★ 缺省值给 true（bool）⇒ **没传这个键时绝不会误报** ✓
        if opts.get("background", true) is bool => bgOn {
            showBackground = bgOn
        } else {
            dochk.warn_once("Button", "background",
                "Button：'background' 是开关（true/false），它不负责颜色 —— 颜色请用 'bg_color' / 'hover_color' / 'pressed_color'；本次按 true 处理")
            showBackground = true
        }

        // 鼠标样式（默认手型，-1 不改变）
        cursor = opts.get("cursor", SystemCursor.POINTER)

        // 状态（hover/wasHover 默认见字段声明；enabled/visible 有 opts 默认）
        enabled = opts.get("enabled", true)
        visible = opts.get("visible", true)
        tipText = opts.get("tip", "")

        // 图片（图标）
        imagePath = opts.get("image_path", "")
        var ip = opts.get("image_pos", "left")
        if ip is string {
            switch ip {
                case "left"   { imgPos = IMG_LEFT }
                case "right"  { imgPos = IMG_RIGHT }
                case "top"    { imgPos = IMG_TOP }
                case "bottom" { imgPos = IMG_BOTTOM }
                default       { imgPos = IMG_LEFT }
            }
        }
        imgSize  = opts.get("image_size", 0.0)
        imgGap   = opts.get("image_gap", 6.0)
        imgAlpha = opts.get("image_alpha", 255)
        var tint = opts.get("image_tint")
        if tint is int { imgTint = tint }

        // 内容模式 / 状态图片 / 背景图
        imgMode        = opts.get("image_mode", IMG_ASPECT_FIT)
        imgPathHover   = opts.get("image_path_hover", "")
        imgPathPressed = opts.get("image_path_pressed", "")
        imgPathDisabled = opts.get("image_path_disabled", "")
        bgImagePath    = opts.get("bg_image", "")

        // 更换任意图片路径时释放旧纹理，下一帧 render 重新加载
        release_all_images()
        imgLoadPath = ""; imgLoadHover = ""; imgLoadPressed = ""
        imgLoadDisabled = ""; bgLoadPath = ""

        ensure_font()
        loaded = true
    }

    // ==================== 设置方法 ====================
    func set_text(string t)     { text = t; cachedTextKey = "\x01" }
    func set_tip(string t)       { tipText = t }
    func set_pos(float px, float py)      { x = px; y = py }
    func set_size(float sw, float sh)     { w = sw; h = sh }
    func set_bounds(float bx, float by, float bw, float bh) {
        x = bx; y = by; w = bw; h = bh
    }
    func set_bg_color(Color color)         { bgColor = color }
    func set_text_color(Color color)       { txtColor = color }
    func set_hover_color(Color color)      { hovColor = color }
    func set_pressed_color(Color color)     { prColor = color }
    func set_font_size(float s) {
        fontSize = s
        if font != null and font.ok { fnt.releaseFont(font) }; font = null
    }
    func set_font_path(string path) {
        fontPath = path
        if font != null and font.ok { fnt.releaseFont(font) }; font = null
    }
    func set_font_style(int style) {
        fontStyle = style
        ensure_font()
        if font.ok { font.setStyle(style) }
    }
    func set_radius(float r)   { radius = r }
    func set_align(int a)      { textAlign = a }
    func set_border_color(Color c) { bdrColor = c }
    func set_padding(float p)  { padding = p }

    // ★ 文本尺寸缓存的**唯一测量点**（text 不变 ⇒ 零测量）。
    //   为什么要有它：以前 render 主路径已缓存，但 `draw_text_aligned` 的**右对齐分支**仍每帧
    //   `measureString(text)` ✗（框架自查清单 J 项的遗漏点）。两处收敛到这里后：
    //     ① 同一帧内无论画几次、什么对齐方式，都只可能测 0 次（缓存命中）✓
    //     ② 值与原实现**完全一致**（同字体同文本）⇒ 像素不变 ✓
    //   缓存失效：`set_text` 与 `ensure_font`（字体/字号变化）把 `cachedTextKey` 置为哨兵 ✓
    pri func ensure_text_size() {
        if font == null or not font.ok { return }
        if text == cachedTextKey { return }
        var[float, float](_tw, _th) = font.measureString(text)
        cachedTextW = _tw; cachedTextH = _th; cachedTextKey = text
    }

    // 在 [tx, tx+tw] 内按 align 绘制文字（默认居中 ⇒ 与历史绘制逐像素一致 ✓）
    pri func draw_text_aligned(Renderer r, float tx, float tw, float ty, Color col) {
        if textAlign == ALIGN_LEFT {
            r.drawText(font, text, tx, ty, col)
        } else if textAlign == ALIGN_RIGHT {
            // 复用缓存（原先这里每帧 measureString ✗）；缓存未命中时 `ensure_text_size()` 会补测 ✓
            ensure_text_size()
            r.drawText(font, text, tx + tw - cachedTextW, ty, col)
        } else {
            r.drawTextCentered(font, text, tx, tw, ty, col)
        }
    }
    func set_enabled(bool e)   { enabled = e }
    func set_visible(bool v)    { visible = v }
    func is_visible(): bool     { return visible }
    func set_shadow(bool s)     { showShadow = s }
    func set_border(bool b)     { showBorder = b }
    func set_background(bool b) { showBackground = b }
    func set_cursor(int cur)   { cursor = cur }

    // ==================== 图片设置方法 ====================
    func set_image(string path) {
        if imgTex != null { release_image() }
        imagePath = path; imgTex = null; imgLoadPath = ""
    }
    func set_image_pos(string pos) {
        switch pos {
            case "left"   { imgPos = IMG_LEFT }
            case "right"  { imgPos = IMG_RIGHT }
            case "top"    { imgPos = IMG_TOP }
            case "bottom" { imgPos = IMG_BOTTOM }
            default       { imgPos = IMG_LEFT }
        }
    }
    func set_image_size(float s) { imgSize = s }
    func set_image_gap(float g)  { imgGap = g }
    func set_image_alpha(int a)  { imgAlpha = a }
    func set_image_tint(Color color) { imgTint = color }
    func set_image_hover(string path) { imgPathHover = path; imgTexHover = null; imgLoadHover = "" }
    func set_image_pressed(string path) { imgPathPressed = path; imgTexPressed = null; imgLoadPressed = "" }
    func set_image_disabled(string path) { imgPathDisabled = path; imgTexDisabled = null; imgLoadDisabled = "" }
    func set_auto_img_effect(bool e) { autoImgEffect = e }
    // 内容模式：IMG_ASPECT_FIT / IMG_STRETCH / IMG_ASPECT_FILL
    func set_image_mode(int mode) { imgMode = mode }
    // 状态图片（对齐 iOS setImage(_:forState:)）：state ∈ "hover" | "pressed" | "disabled" | "normal"(默认)
    func set_image_for_state(string path, string state) {
        switch state {
            case "hover" {
                if imgTexHover != null { core.lib().SDL_DestroyTexture(imgTexHover); imgTexHover = null }
                imgPathHover = path; imgLoadHover = ""
            }
            case "pressed" {
                if imgTexPressed != null { core.lib().SDL_DestroyTexture(imgTexPressed); imgTexPressed = null }
                imgPathPressed = path; imgLoadPressed = ""
            }
            case "disabled" {
                if imgTexDisabled != null { core.lib().SDL_DestroyTexture(imgTexDisabled); imgTexDisabled = null }
                imgPathDisabled = path; imgLoadDisabled = ""
            }
            default {
                if imgTex != null { core.lib().SDL_DestroyTexture(imgTex); imgTex = null }
                imagePath = path; imgLoadPath = ""
            }
        }
    }
    // 背景图（对齐 iOS setBackgroundImage / Android background）
    func set_background_image(string path) {
        if bgTex != null { core.lib().SDL_DestroyTexture(bgTex); bgTex = null }
        bgImagePath = path; bgLoadPath = ""
    }
    pri func release_image() {
        if imgTex != null { core.lib().SDL_DestroyTexture(imgTex); imgTex = null }
    }
    pri func release_all_images() {
        if imgTex != null { core.lib().SDL_DestroyTexture(imgTex); imgTex = null }
        if imgTexHover != null { core.lib().SDL_DestroyTexture(imgTexHover); imgTexHover = null }
        if imgTexPressed != null { core.lib().SDL_DestroyTexture(imgTexPressed); imgTexPressed = null }
        if imgTexDisabled != null { core.lib().SDL_DestroyTexture(imgTexDisabled); imgTexDisabled = null }
        if bgTex != null { core.lib().SDL_DestroyTexture(bgTex); bgTex = null }
    }

    // 应用预设类型
    func set_type(string t) { apply_type(t) }

    // ==================== 查询方法 ====================
    // ★ 为什么必须有它（2026-09-30 ✓）：`loaded` 是 pri 私有（资源/字体已就绪 ✓），
    //   但应用要问"这个按钮能不能用了" ✓ ⇒ 给一个**公开只读**入口 ✓
    //   实测踩过：应用写 `btn._loaded` ✗ 在**运行期**才炸（struct 不存在字段 '_loaded' ✗），
    //   编译期没拦住 ⇒ 所以这类"跨文件要用的内部状态"必须配 getter ✓
    func is_loaded(): bool   { return loaded }
    func is_hover(): bool    { return hover }
    func is_pressed(): bool  { return pressed }
    func is_enabled(): bool  { return enabled }
    func get_text(): string  { return text }
    func get_x(): float      { return x }
    func get_y(): float      { return y }
    func get_w(): float      { return w }
    func get_h(): float      { return h }

    // ==================== 交互 ====================
    func on_click(func():void callback) { onClick = callback }

    func contains(float mx, float my): bool {
        return mx >= x and mx <= x + w and my >= y and my <= y + h
    }

    // 处理事件（run 内部调用）
    func process(Event ev) {
        if not loaded { return }
        if not visible { return }
        if not enabled { return }
        // 弹层捕获：事件落在“他人的弹层（如打开的菜单/下拉）范围内时忽略，避免穿透到下层控件
        var[float, float](mx, my) = ev.mousePos()
        if ev.isMouseWheel() { mx = ev.wheelMouseX(); my = ev.wheelMouseY() }
        if core.inPopupCapture(mx, my) { return }
        if ev.isMouseMotion() {
            wasHover = hover
            hover = contains(mx, my)
            // hover 状态变化需请求重绘：run 循环已优化为 motion 不整窗重绘，
            // 由控件在视觉状态变化时自行 markFrameRedraw()（对齐 table/edit 等控件）
            if hover != wasHover { core.markFrameRedraw() } else { core.markFrameMotion() }
            // 鼠标样式切换（集中式：仅请求，帧末 applyFrameCursor 统一应用）
            if cursor >= 0 {
                if hover { core.requestCursor(cursor) }
            }
            // 悬停提示：hover 时上报；离开由 tipEndMotion 统一清除
            if hover and tipText != "" { tip.tipReport(tipText, mx, my) }
        }
        if ev.isMouseButtonDown() {
            if contains(mx, my) {
                hover = true
                pressed = true
                core.markFrameRedraw()   // 按下状态变化需重绘
                if onClick != null { onClick() }
            }
        }
        if ev.isMouseButtonUp() {
            if pressed { core.markFrameRedraw() }   // 释放状态变化需重绘
            pressed = false
        }
    }

    // ==================== 渲染 ====================
    func render(Renderer r) {
        if not loaded { return }
        if not visible { return }
        ensure_font()
        ensure_image(r)

        Color bgC = bgColor
        Color txtC = txtColor

        if hover {
            if hovColor != 0 {
                bgC = hovColor
            } else {
                bgC = theme.brighten(bgColor, 40)
            }
        }
        // 按下态：优先级高于 hover，背景变暗（模拟按压凹陷感）
        if pressed and enabled {
            if prColor != 0 {
                bgC = prColor
            } else {
                bgC = theme.darken(bgColor, 30)
            }
        }
        if not enabled {
            int er = theme.colorR(bgColor) / 2
            int eg = theme.colorG(bgColor) / 2
            int eb = theme.colorB(bgColor) / 2
            bgC = theme.packColor(er, eg, eb)
        }

        // 背景/阴影/边框（showBackground=false 时全部跳过，只显示图标）
        if showBackground {
            // 阴影（按下时消除阴影，模拟按压贴合感）
            if showShadow and not (pressed and enabled) {
                r.setColor(#00000028)
                r.fillRoundedRect(x + 2, y + 2, w, h, radius)
            }

            // 背景
            r.setColor(bgC)
            r.fillRoundedRect(x, y, w, h, radius)

            // 背景图（对齐 iOS setBackgroundImage / Android background）：覆盖在纯色背景之上、填满按钮矩形
            if bgTex != null {
                r.setTextureAlpha(bgTex, 255)
                r.setTextureColor(bgTex, #FFFFFFFF)
                r.drawTextureAt(bgTex, x, y, w, h)
            }

            // 边框（按下态使用深色内凹边框，区别于 hover 的亮色高亮边框）
            if showBorder {
                if pressed and enabled { r.setColor(#00000096) }
                else if hover { r.setColor(#FFFFFFC8) }
                else if bdrColor != 0 { r.setColor(bdrColor) }   // ★ 显式边框色（opt-in，默认仍是自动 ✓）
                else {
                    r.setColor(theme.withAlpha(theme.brighten(bgC, 30), 180))
                }
                r.drawRoundedRect(x, y, w, h, radius)
            }
        }

        // ============ 图标 + 文字布局 ============
        // 内容裁剪到按钮矩形内，防止图标/文字溢出按钮（对齐 sdl_edit / sdl_panel 做法）
        var _btnClip = core.SDL_Rect.malloc()
        _btnClip.x = _int(x); _btnClip.y = _int(y)
        _btnClip.w = _int(w) + 1; _btnClip.h = _int(h) + 1   // +1 覆盖浮点截断的亚像素
        r.pushClipRect(_btnClip.to_ptr())

        float pad = 6.0 + padding   // 图标布局的留白；`padding` 默认 0 ⇒ 仍是 6.0 ✓
        // 提前测量文字，供图标尺寸自适应（防止图标挤占文字 / 内容溢出按钮）
        // ★ 缓存：text 不变时直接复用；唯一测量点收敛到 `ensure_text_size()` ✓（右对齐分支共用）
        float textW = 0.0; float textH = 0.0
        if font.ok {
            ensure_text_size()
            textW = cachedTextW; textH = cachedTextH
        }

        // 选择当前状态的图标纹理（disabled > pressed > hover > normal）
        Ptr[u8] itex = imgTex
        bool imgAutoDim = false
        if not enabled and imgTexDisabled != null { itex = imgTexDisabled }
        else if not enabled { itex = imgTex; imgAutoDim = true }
        else if pressed and imgTexPressed != null { itex = imgTexPressed }
        else if hover and imgTexHover != null { itex = imgTexHover }

        // 图标尺寸（对齐 Qt setIconSize / Material iconSize）
        // 自动尺寸须按布局约束，确保图标与文字都能容纳在按钮内：
        //  - 无文字（纯图标按钮）：图标撑满按钮主体
        //  - 左右布局：图标纵向占满（留 padding）
        //  - 上下布局：图标须给文字预留 (h - 2pad - gap - textH) 高度
        bool iconOnly = (text == "")
        float isize = imgSize
        if isize <= 0.0 and itex != null {
            var[float, float](_tsw, _tsh) = r.getTextureSize(itex)
            isize = _tsh
        }
        if isize <= 0.0 { isize = h - 2.0 * pad }
        if isize > w - 2.0 * pad { isize = w - 2.0 * pad }
        if iconOnly {
            // 纯图标：允许占满整个按钮（只留 2px 边距）
            float maxS = w - 4.0
            if maxS > h - 4.0 { maxS = h - 4.0 }
            if isize > maxS { isize = maxS }
        } else if imgPos == IMG_LEFT or imgPos == IMG_RIGHT {
            if isize > h - 2.0 * pad { isize = h - 2.0 * pad }
        } else {
            float maxI = h - 2.0 * pad - imgGap - textH
            if maxI < 0.0 { maxI = 0.0 }
            if isize > maxI { isize = maxI }
        }
        if isize < 0.0 { isize = 0.0 }

        // 纯图标按钮：悬浮/按下时在图标区域画半透明高亮矩形（比图标稍大）
        if iconOnly and (hover or pressed) {
            float hx = x + (w - isize) / 2.0 - 3.0
            float hy = y + (h - isize) / 2.0 - 3.0
            float hw = isize + 6.0
            float hh = isize + 6.0
            if pressed {
                r.setColor(#0000003C)   // 按下：暗色半透明
            } else {
                r.setColor(#FFFFFF23)  // 悬浮：亮色半透明
            }
            r.fillRoundedRect(hx, hy, hw, hh, 4.0)
        }

        // 实际绘制尺寸（按内容模式保持/拉伸比例，避免非正方形图变形）+ alpha/tint 调制
        float dw = isize; float dh = isize
        if itex != null {
            int effA = imgAlpha
            if imgAutoDim { effA = _int(imgAlpha * 0.5) }
            r.setTextureAlpha(itex, effA)
            if imgTint >= 0 {
                r.setTextureColor(itex, imgTint)
            }
            else if imgAutoDim { r.setTextureColor(itex, #808080FF) }   // 禁用态自动变灰
            else { r.setTextureColor(itex, #FFFFFFFF) }
            if imgMode != IMG_STRETCH {   // IMG_ASPECT_FIT / IMG_ASPECT_FILL：保持原始比例
                var[float, float](nw, nh) = r.getTextureSize(itex)
                if nw > 0.0 and nh > 0.0 {
                    if imgMode == IMG_ASPECT_FILL {   // 覆盖填满（可能裁剪，居中绘制）
                        float s = isize / nw; if isize / nh > s { s = isize / nh }
                        dw = nw * s; dh = nh * s
                    } else {             // IMG_ASPECT_FIT：完整显示（可能留边，居中绘制）
                        float s = isize / nw; if isize / nh < s { s = isize / nh }
                        dw = nw * s; dh = nh * s
                    }
                }
            }
        }

        // 复用前面已测量的 textH（避免对同一 text 重复调用 measureString）
        if font.ok {
            if itex != null and text == "" {
                // 纯图标（无文字）：整按钮居中绘制
                float ix = x + (w - isize) / 2.0
                float iy = y + (h - isize) / 2.0
                r.drawTextureAt(itex, ix + (isize - dw) / 2.0, iy + (isize - dh) / 2.0, dw, dh)
            } else if itex == null {
                // 纯文字：按 align 绘制（默认居中 = 历史行为 ✓；内边距 opt-in ✓）
                float cy = y + (h - textH) / 2.0
                draw_text_aligned(r, x + padding, w - 2.0 * padding, cy, txtC)
            } else if imgPos == IMG_LEFT {
                // 图标在左（对齐 Material iconGravity=start / WinForms ImageBeforeText）
                // ★ 整块居中（2026-10-09）：`align:"center"`（默认）此前只把**文字**在"图标右侧的
                //   剩余区"里居中 ⇒ [图标 + 间距 + 文字] 整块偏左，**按钮越宽偏得越多** ✗
                //   （实测 68px：左 6 / 右 15；92px 时更明显 ⇒ LenoMusic 侧栏"变长"直接卡在这）
                //   现在把整块当**一个单元**居中（图标与文字的间距恒为 imgGap ✓）；
                //   只有装得下（band ≤ w - 2*pad）才走这条 ⇒ 装不下仍按原布局，绝不溢出 ✓
                float band = isize + imgGap + textW
                bool midBand = textAlign == ALIGN_CENTER and text != "" and band <= w - 2.0 * pad
                float ix = x + pad
                if midBand { ix = x + (w - band) / 2.0 }
                float iy = y + (h - isize) / 2.0
                r.drawTextureAt(itex, ix + (isize - dw) / 2.0, iy + (isize - dh) / 2.0, dw, dh)
                float tx = ix + isize + imgGap
                float tw = (x + w) - tx - pad
                float ty = y + (h - textH) / 2.0
                // 整块已居中 ⇒ 文字紧跟图标（左对齐）；否则仍按 align 在剩余区里排 ✓
                if midBand { r.drawText(font, text, tx, ty, txtC) }
                else { draw_text_aligned(r, tx, tw, ty, txtC) }
            } else if imgPos == IMG_RIGHT {
                // 图标在右（Material iconGravity=end / WinForms TextBeforeImage）
                // ★ 同上：整块居中（原先镜像地偏右 ✗）
                float band = isize + imgGap + textW
                bool midBand = textAlign == ALIGN_CENTER and text != "" and band <= w - 2.0 * pad
                float tx = x + pad
                float ix = x + w - pad - isize
                if midBand {
                    tx = x + (w - band) / 2.0
                    ix = tx + textW + imgGap
                }
                float iy = y + (h - isize) / 2.0
                r.drawTextureAt(itex, ix + (isize - dw) / 2.0, iy + (isize - dh) / 2.0, dw, dh)
                float ty = y + (h - textH) / 2.0
                if midBand { r.drawText(font, text, tx, ty, txtC) }
                else {
                    float tw = ix - imgGap - tx
                    draw_text_aligned(r, tx, tw, ty, txtC)
                }
            } else if imgPos == IMG_TOP {
                // 图标在上（Material iconGravity=top / WinForms ImageAboveText）
                float ix = x + (w - isize) / 2.0
                float iy = y + pad
                r.drawTextureAt(itex, ix + (isize - dw) / 2.0, iy + (isize - dh) / 2.0, dw, dh)
                float ty = iy + isize + imgGap
                float th = (y + h) - ty - pad
                float cy = ty + (th - textH) / 2.0
                draw_text_aligned(r, x + padding, w - 2.0 * padding, cy, txtC)
            } else {
                // 图标在下（WinForms TextAboveImage）
                float ix = x + (w - isize) / 2.0
                float iy = y + h - pad - isize
                r.drawTextureAt(itex, ix + (isize - dw) / 2.0, iy + (isize - dh) / 2.0, dw, dh)
                float ty = y + pad
                float th = iy - imgGap - ty
                float cy = ty + (th - textH) / 2.0
                draw_text_aligned(r, x + padding, w - 2.0 * padding, cy, txtC)
            }
        } else if itex != null {
            // 仅图标、无文字：居中绘制
            float ix = x + (w - isize) / 2.0
            float iy = y + (h - isize) / 2.0
            if imgPos == IMG_LEFT { ix = x + pad; iy = y + (h - isize) / 2.0 }
            else if imgPos == IMG_RIGHT { ix = x + w - pad - isize; iy = y + (h - isize) / 2.0 }
            else if imgPos == IMG_TOP { ix = x + (w - isize) / 2.0; iy = y + pad }
            else { ix = x + (w - isize) / 2.0; iy = y + h - pad - isize }
            r.drawTextureAt(itex, ix + (isize - dw) / 2.0, iy + (isize - dh) / 2.0, dw, dh)
        }

        // 恢复裁剪区
        r.popClipRect(); _btnClip.free()
    }

// 释放字体与图片资源
func dispose() {
if font != null and font.ok { fnt.releaseFont(font) }; font = null
release_all_images()
}

// ==================== 运行时主题切换 ====================
func applyTheme(Theme t) {
bgColor = t.btnPrimary
txtColor = t.txtOnAccent
// 重新应用预设类型颜色
if btnType != "" { apply_type(btnType) }
}
}

// 工厂
export func createButton(Dict opts): Button {
    Button btn = new Button(); btn.set(opts); return btn
}


