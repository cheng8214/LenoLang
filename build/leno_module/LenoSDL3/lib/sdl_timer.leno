// sdl_timer.leno — 基于 getTicks() 的定时器，Array 存回调
// 注意：Timer 统一由 tickAllTimers() 在主循环中驱动（不要在各处手动 tick），
// 定时器回调触发后自动 requestRedraw，无需在 onRender 中持续 requestRedraw。

import "sdl_core" as core
use core.sdl3
sdl3 _lib = core.lib()

export alias TimerCallback = func():void

// 全局定时器注册表（供窗口主循环统一 tick + 自动 requestRedraw）
Array[Timer] _timers = []

export func registerTimer(Timer t) {
    _timers.add(t)
}

export func unregisterTimer(Timer t) {
    for _timers.len() to i {
        if _timers[i] == t { _timers.remove(i); break }
    }
}

// 窗口主循环每帧调用：驱动所有注册的定时器，任意一个触发回调则自动 requestRedraw
export func tickAllTimers() {
    bool anyFired = false
    for _timers.len() to i {
        if _timers[i].tick() { anyFired = true }
    }
    if anyFired { core.requestRedraw() }
}

// 返回所有运行中定时器的最近触发时刻（getTicks 毫秒），用于主循环动态计算 waitTimeout；
// 无运行定时器时返回 -1
export func nextTimerMs(): int {
    int best = -1
    for _timers.len() to i {
        var t = _timers[i]
        if t is Timer and t.running {
            int n = _int(t.next)
            if best < 0 or n < best { best = n }
        }
    }
    return best
}

export struct Timer {
    pri float   ms = 0.0     // 定时间隔（毫秒）
    float   next = 0.0    // 下次触发时间（getTicks 毫秒）
    bool    running = false   // 是否运行中（显式初值，消 [字段未初始化] 警告）
    bool    once = false      // true=一次性
    Array   _cb           // 回调存 [0]

    // 设置并启动（循环），ms=毫秒，=0 只存回调不启动
    func set(int ms, TimerCallback cb) {
        _cb.clear(); _cb.add(cb); self.ms = ms   // 形参遮蔽字段 ⇒ 必须显式 self.
        if ms > 0 { next = _float(_lib.SDL_GetTicks()) + ms; running = true }
        else { running = false }
        once = false
    }

    // 设置一次性定时器
    func setOnce(int ms, TimerCallback cb) {
        _cb.clear(); _cb.add(cb); self.ms = ms   // 形参遮蔽字段 ⇒ 必须显式 self.
        next = _float(_lib.SDL_GetTicks()) + ms
        running = true; once = true
    }

    // 暂停
    func stop() { running = false }

    // 恢复（需先有间隔）
    func start() {
        if ms <= 0.0 { return }
        next = _float(_lib.SDL_GetTicks()) + ms; running = true
    }

    // 修改间隔 + 立即重启计时
    func reset(int ms) {
        self.ms = ms      // 形参遮蔽字段 ⇒ 必须显式 self.
        next = _float(_lib.SDL_GetTicks()) + ms; running = true
    }

    // 每帧调用，自动触发回调。返回是否触发了回调（供 tickAllTimers 判断是否需 requestRedraw）
    func tick(): bool {
        if not running or _cb.len() == 0 or ms <= 0.0 { return false }
        float now = _float(_lib.SDL_GetTicks())
        bool fired = false
        var cb = _cb[0]
        while now >= next {
            cb()
            fired = true
            if once { running = false; return fired }
            next += ms
        }
        return fired
    }
}
