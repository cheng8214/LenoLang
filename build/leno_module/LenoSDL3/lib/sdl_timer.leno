// sdl_timer.leno — 基于 getTicks() 的定时器，Array 存回调
// 注意：Timer 统一由 tickAllTimers() 在主循环中驱动（不要在各处手动 tick），
// 定时器回调触发后自动 requestRedraw，无需在 onRender 中持续 requestRedraw。

import "sdl_core" as core
use core.sdl3
sdl3 _lib = core.lib()

export alias TimerCallback = func():void

// 全局定时器注册表（供窗口主循环统一 tick + 自动 requestRedraw）
Array[Timer] _timers = []

export func registerTimer(Timer t) {
    _timers.add(t)
}

export func unregisterTimer(Timer t) {
    for _timers.len() to i {
        if _timers[i] == t { _timers.remove(i); break }
    }
}

// 窗口主循环每帧调用：驱动所有注册的定时器，任意一个触发回调则自动 requestRedraw
//   ⚠⚠ 2026-10-27 修（用户实测：Aria 运行中报
//     "sdl_timer.leno:28 数组索引越界: 索引 2, 长度 2" ✗）：
//     回调里完全可能 **unregisterTimer**（例如跑马灯 Label 被 dispose、一次性定时器用完就注销）
//     或 **registerTimer**（回调里新建控件）⇒ 边遍历边改 `_timers`，
//     刚开始 len=3、中途变成 2，走到 i=2 就**越界崩掉** ✗
//   正解：先**拷贝一份快照**再遍历；每项 tick 前确认它还在注册表里（快照里的已被移除就跳过）
export func tickAllTimers() {
    bool anyFired = false
    Array[Timer] snap = []                     // 快照：遍历期间 _timers 怎么增删都不影响下标 ✓
    for _timers.len() to i { snap.add(_timers[i]) }
    for snap.len() to i {
        Timer t = snap[i]
        // 回调里被移除的定时器（以及后来才注册的）都不该在本拍执行
        bool alive = false
        for _timers.len() to j {
            if _timers[j] == t { alive = true; break }
        }
        if alive and t.tick() { anyFired = true }
    }
    if anyFired { core.requestRedraw() }
}

// 返回所有运行中定时器的最近触发时刻（getTicks 毫秒），用于主循环动态计算 waitTimeout；
// 无运行定时器时返回 -1
export func nextTimerMs(): int {
    int best = -1
    for _timers.len() to i {
        var t = _timers[i]
        if t is Timer and t.running {
            int n = _int(t.next)
            if best < 0 or n < best { best = n }
        }
    }
    return best
}

export struct Timer {
    pri float   ms = 0.0     // 定时间隔（毫秒）
    float   next = 0.0    // 下次触发时间（getTicks 毫秒）
    bool    running = false   // 是否运行中（显式初值，消 [字段未初始化] 警告）
    bool    once = false      // true=一次性
    Array   _cb           // 回调存 [0]

    // 设置并启动（循环），ms=毫秒，=0 只存回调不启动
    func set(int ms, TimerCallback cb) {
        _cb.clear(); _cb.add(cb); self.ms = ms   // 形参遮蔽字段 ⇒ 必须显式 self.
        if ms > 0 { next = _float(_lib.SDL_GetTicks()) + ms; running = true }
        else { running = false }
        once = false
    }

    // 设置一次性定时器
    func setOnce(int ms, TimerCallback cb) {
        _cb.clear(); _cb.add(cb); self.ms = ms   // 形参遮蔽字段 ⇒ 必须显式 self.
        next = _float(_lib.SDL_GetTicks()) + ms
        running = true; once = true
    }

    // 暂停
    func stop() { running = false }

    // 恢复（需先有间隔）
    func start() {
        if ms <= 0.0 { return }
        next = _float(_lib.SDL_GetTicks()) + ms; running = true
    }

    // 修改间隔 + 立即重启计时
    func reset(int ms) {
        self.ms = ms      // 形参遮蔽字段 ⇒ 必须显式 self.
        next = _float(_lib.SDL_GetTicks()) + ms; running = true
    }

    // 每帧调用，自动触发回调。返回是否触发了回调（供 tickAllTimers 判断是否需 requestRedraw）
    //   ⚠⚠ 2026-10-08 修（用户实测："电脑睡眠唤醒后，Trae签到 就崩溃或退出" ✗）：
    //     先前是 `while now >= next { cb(); next += ms }` ✗ —— 把**所有错过的周期都补跑一遍**。
    //     平时看不出来（每帧都在跑 ✓），但**睡眠唤醒 / 长卡顿**后 `now` 会一次跳几小时 ✗
    //     ⇒ 33ms 的动画定时器要补跑 **327272 次**、120ms 的要 90000 次（3 小时，探针实测 ✓）
    //     ⇒ 界面**假死**几十秒（用户看到的就是"崩溃/退出" ✓）。两个应用都挂 33/120ms 定时器 ⇒ 全中 ✗
    //   正解：**最多跑一次**，并把 `next` 对齐到"未来"（丢掉积压的周期 ⇒ 醒来只补一拍 ✓）。
    //     对自动签到那种"该补的事"没影响：`autoTick()` 是拿**真实时钟**判"过没过点" ✓
    //     ⇒ 醒来这一拍照样会补签 ✓（对标参考件"启动时过了点就补一次" ✓）
    func tick(): bool {
        if not running or _cb.len() == 0 or ms <= 0.0 { return false }
        float now = _float(_lib.SDL_GetTicks())
        if now < next { return false }
        var cb = _cb[0]
        if once {
            running = false          // ⚠ 先置位再回调：回调里若重新 set/setOnce 才不会被这句冲掉 ✓
            cb()
            return true
        }
        // 周期对齐：落后不到一个周期 ⇒ 正常推进（保持不漂移 ✓）；
        //   落后 ≥ 一个周期（睡眠 / 长卡顿）⇒ 从"现在"重新起算，**不补**那些来不及的拍 ✓
        if now - next >= ms { next = now + ms } else { next = next + ms }
        cb()
        return true
    }
}
