// sdl_image.leno — SDL3_image 图像加载/保存（PNG/JPG/BMP/WEBP 等）
// SDL3_image 无需显式 Init/Quit，加载 DLL 后直接使用
// 注意：isFormat 函数需 SDL_IOStream 暂未封装
import ffi
import dirs
import files
import "sdl_core.leno" as core
use core.(sdl3, ScaleMode, BlendMode)

// ★ 2026-10-21：帧动画（GIF / APNG / WebP 动画）
//   C 侧布局（SDL3_image 头文件，64 位）：
//     typedef struct IMG_Animation { int w, h, count; int *delays; SDL_Surface **frames; }
//   偏移：w@0  h@4  count@8  (**4 字节 padding**)  frames@16  delays@24，结构共 32 字节。
//   ⚠ **顺序是 frames 在前、delays 在后**（实测 2026-10-21：@16 的 [0] 是 SDL_Surface*，
//     @24 的 [0] 是延迟 0）—— 按"delays 在前"读会拿到两个错位的指针，
//     症状是 count/w/h 全对但取帧全 null（以为是解码失败，其实偏移错了 ✗）
//   ⚠ 这里**故意不用 cstruct 读字段**：Leno 的 cstruct 是紧凑排列，
//     不会在 `count`(4B) 与 `delays`(8B 指针) 之间自动补 padding
//     ⇒ 用 cstruct 会把 delays 读成 @12、frames 读成 @20，拿到垃圾指针 ✗
//     （实测症状：count 读对了（@8 两边一致），但取帧全是 null ⇒ 动画永远 ok=false）
//   ⇒ 统一用 `ffi.read_int/read_ptr` + 显式偏移，偏移写死在这里，只此一处 ✓
const IMG_ANIM_OFF_W      = 0
const IMG_ANIM_OFF_H      = 4
const IMG_ANIM_OFF_COUNT  = 8
const IMG_ANIM_OFF_FRAMES = 16
const IMG_ANIM_OFF_DELAYS = 24

clib sdl3_image {
    // 加载
    Ptr[u8]  IMG_Load(str8 file)
    Ptr[u8]  IMG_LoadTexture(Ptr[u8] renderer, str8 file)

    // 动画（静态图也能加载：count == 1）
    Ptr[u8]  IMG_LoadAnimation(str8 file)
    void     IMG_FreeAnimation(Ptr[u8] anim)

    // 保存（直接接受文件路径）
    bool IMG_SavePNG(Ptr[u8] surface, str8 file)
    bool IMG_SaveJPG(Ptr[u8] surface, str8 file, i32 quality)
    bool IMG_SaveBMP(Ptr[u8] surface, str8 file)
    bool IMG_SaveWEBP(Ptr[u8] surface, str8 file, f32 quality)

    i32  IMG_Version()
}

sdl3_image _img = null

func imgLib(): sdl3_image {
    if _img == null {
        string ext = if _os() == "windows" then ".dll" else ".so"
        string path = dirs.script_dir() + "/../SDL3_image" + ext
        if not files.exists(path) { path = dirs.script_dir() + "/SDL3_image" + ext }
        if not files.exists(path) { path = "SDL3_image" + ext }
        _img = ffi.load(path)
    }
    return _img
}

// ==================== 加载 ====================

// 从文件加载为 SDL_Surface（用完需 SDL_DestroySurface）
export func load(string path): Ptr[u8] {
    return imgLib().IMG_Load(path) 
}

// 从文件直接加载为 GPU 纹理（需要有效渲染器）
// 加载后自动设为 LINEAR 缩放模式，避免圆形/平滑边缘显示成锯齿多边形
export func loadTexture(Ptr[u8] renderer, string path): Ptr[u8] {
    sdl3 _lib = core.lib()
    Ptr[u8] tex = imgLib().IMG_LoadTexture(renderer, path)
    if tex != null {
        // 1 = SDL_SCALEMODE_LINEAR
        _lib.SDL_SetTextureScaleMode(tex, ScaleMode.LINEAR)
        // 关键：启用 alpha 混合，否则透明区域显示为背景矩形（默认 NONE = 不透明矩形绘制）
        _lib.SDL_SetTextureBlendMode(tex, BlendMode.BLEND)
    }
    return tex
}

// 改变**已加载纹理**的缩放模式（2026-10-12 补 ✓）
//   · 为什么需要它：上面的 `loadTexture` 一律设成 LINEAR（平滑边缘对圆形/文字更好 ✓），
//     但**像素画**必须 NEAREST —— 精灵图四周那些"A=0 但带颜色"的像素会被双线性插值掺进来，
//     放大后就是一圈白/脏边的"描边"（《超级玛丽》精灵白边就是这个原因 ✓）
//   · 用法：`Ptr[u8] t = SDL3.loadImageTexture(ren, path);  SDL3.setTextureScaleMode(t, ScaleMode.NEAREST)`
//   · 经 SDL3 门面转发（见 SDL3.leno ✓）；scaleMode 见 core.ScaleMode（NEAREST/LINEAR/BEST ✓）
//   · 形参用 `int`（与本框架既有 FFI 风格一致，如 core 的 `setSystemCursor(int kind)` ✓）；
//     枚举值可直接传：`setTextureScaleMode(tex, ScaleMode.NEAREST)` ✓
//     （2026-10-12 记：当初只能写 int，是因为「枚举类型 ↔ C 布局整型」不互通、变量喂 clib 的 i32
//      形参会报「期望 'i32'，实际 'unknown'」✗；该编译器问题已修 ✓ ⇒ 现在写 `ScaleMode mode` 也行 ✓）
export func setTextureScaleMode(Ptr[u8] tex, int mode) {
    if tex == null { return }
    sdl3 _lib = core.lib()
    _lib.SDL_SetTextureScaleMode(tex, mode)
}

// ==================== 保存 ====================

// 保存为 PNG（无损压缩）
export func savePNG(Ptr[u8] surface, string path): bool {
    return imgLib().IMG_SavePNG(surface, path)
}

// 保存为 JPG，quality: 0~100（越高画质越好，默认 90）
export func saveJPG(Ptr[u8] surface, string path, int quality = 90): bool {
    return imgLib().IMG_SaveJPG(surface, path, quality)
}

// 保存为 BMP
export func saveBMP(Ptr[u8] surface, string path): bool {
    return imgLib().IMG_SaveBMP(surface, path)
}

// 保存为 WEBP，quality: 0.0~100.0（浮点，默认 80）
export func saveWEBP(Ptr[u8] surface, string path, float quality = 80.0): bool {
    return imgLib().IMG_SaveWEBP(surface, path, quality)
}

// ==================== 版本 ====================

export func version(): int {
    return imgLib().IMG_Version()
}

// ==================== 动画：加载 / 拆帧（2026-10-21）====================
//   GIF / APNG / WebP 动画都能读；**静态图也能读**（count == 1），所以调用方不用先判格式 ✓
//   ⚠ 拿到的是 `IMG_Animation*`，帧 surface 归它所有 ⇒ 只能 `freeAnimation()` 释放，
//     不要对帧表面调 `SDL_DestroySurface`（那会 double free）✗

// 加载动画；失败 ⇒ null
export func loadAnimation(string path): Ptr[u8] {
    return imgLib().IMG_LoadAnimation(path)
}

// 释放动画（连同所有帧 surface）
export func freeAnimation(Ptr[u8] anim) {
    if anim != null { imgLib().IMG_FreeAnimation(anim) }
}

export func animCount(Ptr[u8] anim): int {
    if anim == null { return 0 }
    return ffi.read_int(anim, IMG_ANIM_OFF_COUNT)
}

export func animWidth(Ptr[u8] anim): int {
    if anim == null { return 0 }
    return ffi.read_int(anim, IMG_ANIM_OFF_W)
}

export func animHeight(Ptr[u8] anim): int {
    if anim == null { return 0 }
    return ffi.read_int(anim, IMG_ANIM_OFF_H)
}

// 第 i 帧的显示时长（毫秒）；越界或写成 0 ⇒ 100（SDL_image 对静态图给 0，
//   播放器必须兜底，否则"一帧 0ms"会变成死循环/瞬间播完）
export func animDelay(Ptr[u8] anim, int i): int {
    if anim == null { return 100 }
    int n = ffi.read_int(anim, IMG_ANIM_OFF_COUNT)
    if i < 0 or i >= n { return 100 }
    Ptr delays = ffi.read_ptr(anim, IMG_ANIM_OFF_DELAYS)
    if delays == null { return 100 }
    int d = ffi.read_int(delays, i * 4)
    if d <= 0 { d = 100 }
    return d
}

// 第 i 帧的 surface（null = 越界/未加载）；**不要销毁它**
export func animFrame(Ptr[u8] anim, int i): Ptr[u8] {
    if anim == null { return null }
    int n = ffi.read_int(anim, IMG_ANIM_OFF_COUNT)
    if i < 0 or i >= n { return null }
    Ptr frames = ffi.read_ptr(anim, IMG_ANIM_OFF_FRAMES)
    if frames == null { return null }
    return ffi.read_ptr(frames, i * 8)      // 指针数组步长 = sizeof(void*) = 8（64 位）
}
