// sdl_titlebar.leno — 自绘标题栏组件（impl Widget）
//
// 用法：
//   TitleBar tb = SDL3.createTitleBar({title:"我的应用", height:32})
//   win.add(tb)              // 自动去掉系统标题栏，组件接管绘制和事件
//   tb.on_close(func() { ... })       // 可选：自定义关闭回调
//   tb.on_minimize(func() { ... })    // 可选：自定义最小化回调
//   tb.on_maximize(func() { ... })    // 可选：自定义最大化回调
//
// 默认行为（未设回调时）：
//   close     → wantQuit（由 isCloseRequested() 查询，示例在事件循环中检查）
//   minimize  → win.minimize()
//   maximize  → win.maximize() / win.restore()（双击标题栏也可切换）
//
// 配置项（createTitleBar opts）：
//   title           标题文字（默认空）
//   height          标题栏高度（默认 32）
//   font_size       标题字号（默认 15）
//   font_path       字体路径（空则自动匹配系统字体）
//   show_minimize   是否显示最小化按钮（默认 true）
//   show_maximize   是否显示最大化按钮（默认 true）
//   show_close      是否显示关闭按钮（默认 true）
//   btn_width       按钮宽度（默认 40）
//   btn_spacing     按钮间距（默认 0，紧贴排列）
//   btn_align       按钮组位置: "right"（默认，右侧）或 "left"（左侧，macOS 风格）
//   bg_color        背景色 #RRGGBBAA（默认从主题读取）
//   text_color      标题文字色 #RRGGBBAA
//   hover_color     按钮悬停背景色 #RRGGBBAA
//   close_hover_color 关闭按钮悬停色 #RRGGBBAA
//   icon_color      图标线条色 #RRGGBBAA
//   separator_color 底部分隔线色 #RRGGBBAA
//   show_separator  是否显示底部分隔线（默认 true）
//   icon_minimize   最小化图标图片路径（可选，不传则矢量绘制）
//   icon_maximize   最大化图标图片路径
//   icon_restore    还原图标图片路径
//   icon_close      关闭图标图片路径
//   icon_size       图标图片显示尺寸（默认 16）
//   title_align     标题对齐: "left"（默认）或 "center"
//   title_pad       标题水平内边距（默认 12）
//   resizable       是否允许拖边缘缩放（默认 true = 历史行为 ✓）
//                   ⚠ **弹窗必须传 false** —— 见 sdl_dialog.dialogTitleBar（用户实测：msg 弹窗能改大小 ✗）
//
// 中间控件（VS Code 风格标题栏）：
//   通过 set_center_widget(Widget) 在标题栏中间插入自定义控件（如路径栏、搜索框等）。
//   控件会自动定位在标题/按钮之间的剩余空间内，并随窗口缩放自适应宽度。
//   用法：
//     var pathEdit = SDL3.createEdit({font_size:13, placeholder:"搜索或输入路径"})
//     titleBar.set_center_widget(pathEdit)
import "sdl_renderer.leno" as ren; use ren.Renderer
import "sdl_opts.leno" as dochk    // 选项对账：不认识的键会报一行警告（见 sdl_opts.leno ✓）
import "sdl_font.leno" as fnt; use fnt.Font
import "sdl_event.leno" as evt; use evt.Event
import "sdl_core.leno" as core; use core.(sdl3, SystemCursor)
import "sdl_widget.leno" as wgt; use wgt.Widget
import "sdl_theme.leno" as theme; use theme.(Theme, Themeable)
use theme.Color
import "sdl_image.leno" as img
import "sdl_menu.leno" as mnu; use mnu.MenuBar
import "sdl_tooltip.leno" as tip    // 悬停提示复用框架那一套（与 Button/CheckBox 同一手感 ✓）


// 本控件认的键 —— 由本文件全部 `.get("…")` **自动抽取**（是超集 ⇒ 可少报、不误报 ✓）
//   ⚠ 以后增删选项请重跑抽取（或人工核对），否则可能对合法用法误报 ✓
func _opts_keys(): Array[string] {
    return [
"actions", "bg_color", "btn_align", "btn_spacing", "btn_width", "close", "close_hover_color", "font_path", "font_size", "height", "hover_color", "icon_close", "icon_color", "icon_maximize", "icon_minimize", "icon_restore", "icon_size", "maximize", "minimize", "resizable", "separator_color", "show_close", "show_maximize", "show_minimize", "show_separator", "text_color", "title", "title_align", "title_icon", "title_icon_gap", "title_icon_size", "title_pad"
]
}

// ==================== 动作按钮（自定义，2026-10-07）====================
// 原标题栏只有"最小化/最大化/关闭"三个固定位；`actions` 让调用方**往按钮组里加自己的图标按钮** ✓
//   位置：系统按钮的**内侧**（btn_align="right" ⇒ 从最小化往左排；"left" ⇒ 从关闭往右排）✓
//   图标两种给法（都不需要额外资源文件时用 ① ✓）：
//     ① **内置矢量名**：gear(齿轮) / menu / search / star / info / refresh / sun / home / dot
//     ② 图片路径："images/set.png" ⇒ 按 id 缓存纹理（与 icon_minimize 那套同源 ✓）
//
// 用法（声明式）：
//   TitleBar tb = SDL3.createTitleBar({title: "…", actions: [
//       {id: "settings", icon: "gear", tip: "设置"},
//       {id: "theme",    icon: "sun",  tip: "换主题"}
//   ]})
//   tb.on_action(func(string id) { if id == "settings" { openSettings() } })
// 用法（运行时）：tb.add_action({id:"pin", icon:"images/pin.png", tip:"置顶"}) / set_action_icon / remove_action ✓
//
// ⚠ 键名用 `icon`（与本控件的 icon_minimize/icon_close 一族一致 ✓）；也收 `image`（菜单那套键名）✓
export struct TitleBarAction {
    string id = ""
    string icon = ""
    string tip = ""
    bool enabled = true
}

func _makeAction(Dict d): TitleBarAction {
    TitleBarAction a = new TitleBarAction()
    a.id     = d.get("id", "")
    a.icon   = d.get("icon", d.get("image", ""))
    a.tip    = d.get("tip", "")
    a.enabled = d.get("enabled", true)
    return a
}

// 把调用方给的 Array[Dict] 解析成 Array[TitleBarAction]（**没有 id 的直接丢**：删/改都靠 id ✓）
export func parseTitleBarActions(Array[Dict] src): Array[TitleBarAction] {
    Array[TitleBarAction] out = []
    for src.len() to i {
        TitleBarAction a = _makeAction(src[i])
        if a.id != "" { out.add(a) }
    }
    return out
}

// 是不是"内置矢量图标名"（不是 ⇒ 当图片路径处理 ✓）。导出 ⇒ 调用方/测试都能用同一份判定 ✓
export func is_builtin_icon(string n): bool {
    if n == "gear" or n == "settings" { return true }
    if n == "menu" or n == "search" or n == "star" { return true }
    if n == "info" or n == "help" or n == "refresh" { return true }
    if n == "sun" or n == "home" or n == "dot" { return true }
    // ★ "download"（2026-10-09 加 ✓）：矢量图标**跟着 `icon_color` 走** ⇒ 浅色/深色标题栏都看得见 ✓
    //   （图片图标是按原色画的、不吃 icon_color ⇒ 白 PNG 放到浅色标题栏上就"消失"了 ✗）
    if n == "download" { return true }
    return false
}
export struct TitleBar impl Widget, Themeable {
    // ==================== 关联常量 ====================
    const ALIGN_LEFT   = 0   // 标题左对齐
    const ALIGN_CENTER = 1   // 标题居中对齐

    const BTN_ALIGN_RIGHT = 0   // 按钮组在右侧（Windows/Linux 默认）
    const BTN_ALIGN_LEFT  = 1   // 按钮组在左侧（macOS 风格）

    const BTN_NONE  = 0   // 无悬停按钮
    const BTN_MIN   = 1   // 最小化按钮
    const BTN_MAX   = 2   // 最大化按钮
    const BTN_CLOSE = 3   // 关闭按钮

    const EDGE_NONE         = 0   // 无边缘命中
    const EDGE_LEFT         = 1   // 左边缘
    const EDGE_RIGHT        = 2   // 右边缘
    const EDGE_TOP          = 3   // 上边缘
    const EDGE_BOTTOM       = 4   // 下边缘
    const EDGE_TOP_LEFT     = 5   // 左上角
    const EDGE_TOP_RIGHT    = 6   // 右上角
    const EDGE_BOTTOM_LEFT  = 7   // 左下角
    const EDGE_BOTTOM_RIGHT = 8   // 右下角

    // ==================== 布局 ====================
    float x = 0.0, y = 0.0, w = 1000.0, h = 32.0

    // ==================== 配置 ====================
    pri string title = ""
    float  _fontSize = 15.0
    pri string fontPath = ""
    Font?  _font
    pri float  btnWidth = 40.0
    pri float  btnSpacing = 0.0      // 按钮之间的间距
    pri float  titlePad = 12.0       // 标题水平内边距
    pri int    titleAlign = ALIGN_LEFT   // 标题对齐（ALIGN_LEFT/ALIGN_CENTER）
    pri int    btnAlign = BTN_ALIGN_RIGHT // 按钮组位置（BTN_ALIGN_RIGHT/BTN_ALIGN_LEFT）

    // 中间控件（VS Code 风格：在标题和按钮之间插入自定义控件）
    pri Widget? centerWidget = null

    // 嵌入式 MenuBar 专用引用（用于 renderPopup 转发）
    pri MenuBar? embeddedMenu = null
    pri bool centerIsMenu = false

    // 按钮可见性
    pri bool showMinimize = true
    pri bool showMaximize = true
    pri bool showClose = true

    // ==================== 颜色 ====================
    pri Color bgColor = #262830FF
    pri Color txColor = #C8D1E5FF
    pri Color hovColor = #37404CFF
    pri Color closeHovColor = #E81123FF
    pri Color iconColor = #C8D1E5FF
    pri Color sepColor = #373A44FF
    pri bool showSeparator = true

    // ==================== 图标图片（可选） ====================
    pri string imgMin = "";  pri Ptr[u8]? texMin;  pri string loadMin = ""
    pri string imgMax = "";  pri Ptr[u8]? texMax;  pri string loadMax = ""
    pri string imgRestore = ""; pri Ptr[u8]? texRestore; pri string loadRestore = ""
    pri string imgClose = ""; pri Ptr[u8]? texClose; pri string loadClose = ""
    pri float iconImgSize = 16.0

    // ==================== 标题前的**应用图标**（2026-10-07 新增 ✓）====================
    // 只有文字时标题前面空一块，观感差 ⇒ `title_icon` 给一张图（PNG 也认 ✓），
    //   与文字**作为一个整体**居中/左对齐 ⇒ 不再"前面空空的" ✓
    // ⚠ 路径同样要**绝对**（`dirs.res_dir()` 拼 ✓）——控件把它原样交给 SDL_image ✓
    pri string imgTitle = ""; pri Ptr[u8]? texTitle; pri string loadTitle = ""
    pri float titleIconSize = 0.0     // ≤0 ⇒ 用 icon_size（与窗口按钮图标同一档 ✓）
    pri float titleIconGap = 6.0      // 图标与文字之间的间隙

    // ==================== 动作按钮（自定义；用法见文件头）====================
    pri Array[TitleBarAction] actions = []   // 图标按钮（顺序 = 从系统按钮往内侧排 ✓）
    pri string actionHover = ""               // 当前悬停的动作 id（空 = 无）
    pri Dict actionTex = {}                   // id -> 纹理（只给图片图标用；矢量名不进这里 ✓）
    pri Dict actionLoad = {}                  // id -> 已加载路径（避免重复加载 ✓）

    // ==================== 状态 ====================
    pri int    btnHover = BTN_NONE   // 悬停按钮（BTN_NONE/MIN/MAX/CLOSE）
    pri bool   maximized = false
    bool   _dragging = false
    // ★ 2026-09-30：拖拽"阈值"标记 —— 只有指针移动超过阈值才真的搬窗口
    //   手点标题栏总带一两像素抖动；以前"按下即进拖拽"⇒ 一次"点击"被当成"拖窗口"
    //   （实测症状：点过标题栏后，点别的按钮第一次没反应、点 ✕ 要点两次 ✓）
    pri bool   _dragMoved = false
    pri int    motionSkipCount = 0  // 窗口状态切换后跳过合成 Motion 的 hover 更新（防止关闭按钮误红）
    pri int    dragStartGX = 0, dragStartGY = 0
    pri int    dragStartWinX = 0, dragStartWinY = 0
    pri Ptr[u8] winHandle = null
    // ★ 窗口尺寸缓存：避免每帧调用 SDL_GetWindowSize（仅在拖拽/缩放后置脏）
    pri int cachedWinW = 0
    pri int cachedWinH = 0
    pri bool winSizeDirty = true
    bool   _loaded = false
    pri bool   borderlessApplied = false
    // ★ 是否允许缩放（2026-10-09 加 ✓，默认 true = 历史行为不变）
    //   ⚠ 为什么需要这个开关：挂载时会 `SDL_SetWindowResizable(true)`（主窗口去掉原生边框后
    //   靠它恢复缩放能力 ✓），可那一下会把**本来不可缩放的窗口**也"解放"掉 ⇒ 弹窗（msgBox）
    //   一并继承 ⇒ 用户实测"msg 弹窗居然能拖边改大小" ✗ ⇒ 弹窗走 `resizable:false` ✓
    //   （同样的开关也管住下面那套**手动边缘缩放**：不可缩放的窗口连光标都不该变 ✓）
    pri bool   allowResize = true
    pri bool   closeRequested = false  // 关闭按钮被按下（示例查询后重置）

    // ==================== 手动边缘缩放（无边框窗口用） ====================
    pri int    resizeEdge = EDGE_NONE
    pri int    resizeStartGX = 0, resizeStartGY = 0
    pri int    resizeStartWinX = 0, resizeStartWinY = 0
    pri int    resizeStartW = 0, resizeStartH = 0
    pri float  resizeEdgeThreshold = 6.0   // 边缘检测阈值（像素）

    // ==================== 回调 ====================
    pri func():void onClose = null
    pri func():void onMinimize = null
    pri func():void onMaximize = null
    pri func(string):void onAction = null   // 动作按钮被点击（参数 = 动作 id ✓）

    // ==================== set 初始化 ====================

    func set(Dict opts) {
        dochk.check("sdl_titlebar", opts, _opts_keys())   // ★ 选项对账（2026-09-29 铺开 ✓）
        h = opts.get("height", 32.0)
        title = opts.get("title", "")
        _fontSize = opts.get("font_size", 15.0)
        fontPath = opts.get("font_path", "")
        btnWidth = opts.get("btn_width", 40.0)
        btnSpacing = opts.get("btn_spacing", 0.0)
        titlePad = opts.get("title_pad", 12.0)
        var align = opts.get("title_align", "left")
        if align is string {
            if align == "center" { titleAlign = ALIGN_CENTER } else { titleAlign = ALIGN_LEFT }
        }
        var balign = opts.get("btn_align", "right")
        if balign is string {
            if balign == "left" { btnAlign = BTN_ALIGN_LEFT } else { btnAlign = BTN_ALIGN_RIGHT }
        }
        showMinimize = opts.get("show_minimize", true)
        showMaximize = opts.get("show_maximize", true)
        showClose = opts.get("show_close", true)
        showSeparator = opts.get("show_separator", true)
        allowResize = opts.get("resizable", true)   // 弹窗传 false ✓（默认 true = 历史行为 ✓）

        // 颜色：opts 未传则保持默认值
        if opts.get("bg_color") is Color => t { bgColor = t }
        if opts.get("text_color") is Color => t { txColor = t }
        if opts.get("hover_color") is Color => t { hovColor = t }
        if opts.get("close_hover_color") is Color => t { closeHovColor = t }
        if opts.get("icon_color") is Color => t { iconColor = t }
        if opts.get("separator_color") is Color => t { sepColor = t }

        imgMin = opts.get("icon_minimize", "")
        imgMax = opts.get("icon_maximize", "")
        imgRestore = opts.get("icon_restore", "")
        imgClose = opts.get("icon_close", "")
        // 标题前的应用图标（也收 `title_image`：与 actions 那套"icon/image 都认"同宽 ✓）
        imgTitle = opts.get("title_icon", opts.get("title_image", ""))
        // ★ 记住"应用图标"（2026-10-08 ✓）：**第一个**设了 title_icon 的标题栏（= 主窗口 ✓）
        //   ⇒ 之后建的**弹窗**标题栏若没自己指定，就沿用它 ✓（见 sdl_dialog.dialogTitleBar ✓）
        //   为什么要记：用户实测"主窗口设了图标，各对话框没设 ⇒ 弹窗光秃秃的" ✗
        if imgTitle != "" and _appIcon == "" { _appIcon = imgTitle }
        titleIconSize = opts.get("title_icon_size", 0.0)
        titleIconGap = opts.get("title_icon_gap", 6.0)
        iconImgSize = opts.get("icon_size", 16.0)

        // 动作按钮：给了 Array[Dict] 就解析（没有 id 的会被丢掉，见 parseTitleBarActions ✓）；
        //   没给 ⇒ 保持空数组（老代码行为完全不变 ✓）
        var acts = opts.get("actions", [])
        if acts is Array[Dict] { actions = parseTitleBarActions(acts) }

        ensure_font()
        _loaded = true
    }

    pri func ensure_font() {
        if _font == null or not _font.ok {
            if _font != null and _font.ok { fnt.releaseFont(_font) }
            if fontPath != "" {
                _font = fnt.acquireFont(fontPath, _fontSize)
            } else {
                _font = fnt.acquireFontAuto(_fontSize)
            }
        }
    }

    // ==================== 窗口绑定 ====================

    // 绑定窗口句柄（win.add 时由 Window._passWindowHandle 调用，或手动调用）
    // 自动去掉系统标题栏边框，恢复缩放能力，并修正最大化状态
    func set_window_handle(Ptr[u8] handle) {
        winHandle = handle
        if not borderlessApplied and handle != null {
            // 1. 去掉系统标题栏边框
            core.lib().SDL_SetWindowBordered(handle, false)
            // 2. 恢复缩放能力（SDL_SetWindowBordered 在 Windows 上会去掉 WS_THICKFRAME，
            //    导致窗口无法缩放；此处显式恢复）
            //    ⚠ 只在 `allowResize` 时做（2026-10-09）：这一句会把**本来不可缩放**的窗口
            //    也改成可缩放 ⇒ 弹窗照单全收 ⇒ "msg 弹窗能改大小" ✗（见字段处注释 ✓）
            if allowResize { core.lib().SDL_SetWindowResizable(handle, true) }
            // 3. 修正最大化状态：窗口若以 MAXIMIZED 标志创建，去掉边框后 Windows 不会
            //    重算最大化客户区，顶部会残留系统标题栏高度的间隙。
            //    解决：restore → re-maximize 强制 Windows 重算
            if core.isWindowMaximized(handle) {
                core.lib().SDL_RestoreWindow(handle)
                core.lib().SDL_MaximizeWindow(handle)
                maximized = true
            }
            borderlessApplied = true
        }
    }

    // 手动设置窗口句柄（兼容旧式调用）
    func bind_window(Ptr[u8] handle) { set_window_handle(handle) }

    // ==================== Widget 接口 ====================

    func get_w(): float { return w }
    func get_h(): float { return h }
    func set_pos(float px, float py) { x = px; y = py }
    func set_size(float sw, float sh) { w = sw; if sh > 0 { h = sh } }

    func contains(float mx, float my): bool {
        return mx >= x and mx <= x + w and my >= y and my <= y + h
    }

    // ==================== 按钮位置计算 ====================
    // 系统按钮（最小化/最大化/关闭）+ 自定义**动作按钮**排在**同一条带子**上：
    //   动作按钮一律在系统按钮的**内侧**（右对齐 ⇒ 从最小化再往左；左对齐 ⇒ 从关闭再往右）✓
    //   声明顺序 = 从系统按钮往内侧排（第一个声明的离系统按钮最近 ✓）
    // 返回各按钮的起始 X 坐标（-1 表示该按钮不显示）
    pri func btnPositions(): Dict {
        Dict pos = {}
        if btnAlign == BTN_ALIGN_LEFT {
            // macOS 风格：按钮在左侧，从左到右排列
            float curX = x
            if showMinimize {
                pos["minimize"] = curX
                curX = curX + btnWidth + btnSpacing
            } else { pos["minimize"] = -1.0 }
            if showMaximize {
                pos["maximize"] = curX
                curX = curX + btnWidth + btnSpacing
            } else { pos["maximize"] = -1.0 }
            if showClose {
                pos["close"] = curX
            } else { pos["close"] = -1.0 }
            // 动作按钮：接在系统按钮右边
            float acur = x + btnTotalWidth()
            for actions.len() to i {
                acur = acur + btnSpacing
                pos[actions[i].id] = acur
                acur = acur + btnWidth
            }
        } else {
            // Windows/Linux 风格：按钮在右侧，从右到左排列
            float curX = w - btnWidth
            if showClose {
                pos["close"] = curX
                curX = curX - btnWidth - btnSpacing
            } else { pos["close"] = -1.0 }
            if showMaximize {
                pos["maximize"] = curX
                curX = curX - btnWidth - btnSpacing
            } else { pos["maximize"] = -1.0 }
            if showMinimize {
                pos["minimize"] = curX
            } else { pos["minimize"] = -1.0 }
            // 动作按钮：接在系统按钮左边（第一个声明的紧贴最内侧的系统按钮 ✓）
            float acur = w - btnTotalWidth()
            for actions.len() to i {
                acur = acur - btnSpacing - btnWidth
                pos[actions[i].id] = acur
            }
        }
        return pos
    }

    // 系统按钮组占据的总宽度
    pri func btnTotalWidth(): float {
        int count = 0
        if showMinimize { count = count + 1 }
        if showMaximize { count = count + 1 }
        if showClose { count = count + 1 }
        if count == 0 { return 0.0 }
        return _float(count) * btnWidth + _float(count - 1) * btnSpacing
    }

    // 动作按钮组占据的总宽度（含每个动作前的一次 btnSpacing ✓）
    pri func actionTotalWidth(): float {
        int n = actions.len()
        if n == 0 { return 0.0 }
        return _float(n) * (btnWidth + btnSpacing)
    }

    // 整条按钮带的总宽度（系统 + 动作）—— 标题/中间控件留白按它算 ✓
    pri func barTotalWidth(): float {
        return btnTotalWidth() + actionTotalWidth()
    }

    // 返回按钮区域的左边界 X 坐标
    pri func btnAreaLeft(): float {
        if btnAlign == BTN_ALIGN_LEFT { return x }
        return w - barTotalWidth()
    }

    // 返回按钮区域的右边界 X 坐标（不含 padding）
    pri func btnAreaRight(): float {
        if btnAlign == BTN_ALIGN_LEFT { return x + barTotalWidth() }
        return w
    }

    // 判断鼠标在哪个按钮上：0=无, 1=min, 2=max, 3=close
    pri func hitTestBtn(float mx): int {
        var pos = btnPositions()
        float minP = pos.get("minimize", -1.0)
        float maxP = pos.get("maximize", -1.0)
        float closeP = pos.get("close", -1.0)
        // 检查是否在任何按钮的 X 范围内
        bool inBtnArea = false
        if showClose and closeP >= 0.0 and mx >= closeP and mx < closeP + btnWidth { inBtnArea = true }
        if not inBtnArea and showMaximize and maxP >= 0.0 and mx >= maxP and mx < maxP + btnWidth { inBtnArea = true }
        if not inBtnArea and showMinimize and minP >= 0.0 and mx >= minP and mx < minP + btnWidth { inBtnArea = true }
        if not inBtnArea { return 0 }
        // 精确判断是哪个按钮（从外到内，后绘制的在上层优先）
        if showClose and mx >= closeP and mx < closeP + btnWidth { return 3 }
        if showMaximize and mx >= maxP and mx < maxP + btnWidth { return 2 }
        if showMinimize and mx >= minP and mx < minP + btnWidth { return 1 }
        return 0
    }

    // 鼠标落在哪个**动作按钮**上（返回动作 id；空 = 没有）—— 与系统按钮各管各的区域 ✓
    pri func hitTestAction(float mx): string {
        int n = actions.len()
        if n == 0 { return "" }
        var pos = btnPositions()
        for n to i {
            TitleBarAction a = actions[i]
            float px = pos.get(a.id, -1.0)
            if px >= 0.0 and mx >= px and mx < px + btnWidth { return a.id }
        }
        return ""
    }

    // 动作索引（-1 = 没有这个 id）
    pri func action_index(string id): int {
        for actions.len() to i {
            if actions[i].id == id { return i }
        }
        return -1
    }

    // 动作是否可用（不存在的 id ⇒ 不可用 ✓）
    pri func action_enabled(string id): bool {
        int i = action_index(id)
        if i < 0 { return false }
        return actions[i].enabled
    }

    // ==================== 事件处理 ====================

    func process(Event ev) {
        if not _loaded { return }
        if winHandle == null { return }

        // ★★ 自愈（2026-09-30）：拖拽 / 边缘缩放会**吞掉后续所有事件**（下面那两处 `return` ✓），
        //   可"抬起"事件并不保证一定送到：拖拽中指针移出窗口、切到别的程序、OS 吞事件…都会丢 ✗
        //   一旦丢了，`_dragging`（或 `resizeEdge`）就**永远卡住** ⇒ 之后点 ✕、点标题栏、点内容
        //   全都"第一次没反应"（实测症状：点过标题栏后点 ✕ 要点两次 ✓；点按钮第一次没反应 ✓）。
        //   ⇒ 每个事件先核对**真实按键状态**：左键早就松开了就立刻清状态，绝不留到下一次 ✗
        if (core.getMouseState() & 1) == 0 {
            if _dragging { _dragging = false; _dragMoved = false; winSizeDirty = true; core.markFrameRedraw() }
            if resizeEdge != EDGE_NONE {
                resizeEdge = EDGE_NONE
                winSizeDirty = true
                core.forceFrameCursor(SystemCursor.DEFAULT)
                core.markFrameRedraw()
            }
        }

        // ★ 窗口尺寸变化事件 ⇒ 置脏（框架自查清单 L 项收尾）✓
        //   为什么必须有这一句：下面改成"只在脏时查 SDL_GetWindowSize"后，**任何来源**的尺寸变化
        //   都必须能置脏，否则 `w` 会长期停在旧值 ✗（自绘边缘拖拽/最大化切换那几处已各自置脏，
        //   但 OS 侧的缩放事件此前无人处理 —— `isWindowResized()` 在框架内一直没被用到）。
        //   ⚠ 必须放在读取缓存**之前**：本事件就刷新，不必等下一帧 ✓
        if ev.isWindowResized() { winSizeDirty = true; core.markFrameRedraw() }

        // 同步窗口宽度：★ 走 `_winSizeDirty` 缓存（与 render 的 614-618、边缘检测的 361-363 同一套 ✓）
        //   原先这里**每个事件**都调一次 `SDL_GetWindowSize`（native 调用）✗ —— 而尺寸只在
        //   缩放结束(351) / 拖拽结束(389) / 窗口状态切换(458,462) / 尺寸变化(579) / resize 事件
        //   （上一行）时变 ⇒ 只在脏时查一次即可 ✓
        if winSizeDirty {
            var[int, int](_ww, _wh) = core.getWindowSize(winHandle)
            cachedWinW = _ww; cachedWinH = _wh; winSizeDirty = false
        }
        w = _float(cachedWinW)

        // 跟踪最大化/还原状态（切换时清除按钮悬停，防止状态残留导致关闭按钮变红）
        // ★ 同时设置 _motionSkipCount：窗口尺寸变化后 OS 会生成合成 MouseMotion 事件，
        //   此时鼠标的窗口相对坐标可能恰好落在关闭按钮区域，导致 _btnHover 被误设为 3（关闭），
        //   关闭按钮变红。跳过紧随状态切换后的合成 Motion 事件即可避免此问题。
if ev.isWindowMaximized() { maximized = true; btnHover = BTN_NONE; motionSkipCount = 2; core.markFrameRedraw() }
if ev.isWindowRestored() { maximized = false; btnHover = BTN_NONE; motionSkipCount = 2; core.markFrameRedraw() }

        var[float, float](mx, my) = ev.mousePos()

        // === 手动边缘缩放（非最大化时） ===
        if resizeEdge != EDGE_NONE {
            // 缩放进行中：处理鼠标移动和释放
            if ev.isMouseMotion() {
                doResize()
            }
            if ev.isMouseButtonUp() and ev.mouseButton() == 1 {
                resizeEdge = EDGE_NONE
                winSizeDirty = true   // 缩放结束后刷新窗口尺寸缓存
                core.forceFrameCursor(SystemCursor.DEFAULT)
                core.markFrameRedraw()
            }
            return  // 缩放期间不处理其他事件
        }

        // 边缘检测（仅在非最大化、且**允许缩放**时 —— 不可缩放的窗口连光标都不该变 ✓）
        if allowResize and not maximized and not _dragging {
            // ★ 复用缓存，避免每帧 getWindowSize
            if winSizeDirty and winHandle != null {
                var[int, int](_ww, _wh) = core.getWindowSize(winHandle)
                cachedWinW = _ww; cachedWinH = _wh; winSizeDirty = false
            }
            int winH = cachedWinH
            int edge = detectEdge(mx, my, cachedWinW, winH)
            if edge != 0 {
                // 请求对应的缩放光标
                requestResizeCursor(edge)
                // 鼠标按下时开始缩放
                if ev.isMouseButtonDown() and ev.mouseButton() == 1 {
                    startResize(edge)
                    return
                }
            }
        }

        // 拖拽中：处理移动和释放
        if _dragging {
            if ev.isMouseMotion() {
                var[int, int](curGX, curGY) = core.getGlobalMouse()
                // ★ 阈值（3px）：没超过就只是"手抖"，**不搬窗口** ⇒ 一次点击不会被当成拖拽 ✓
                //   （以前"按下即拖" ⇒ 点标题栏会让窗口跟着鼠标漂一两像素，紧接着的那次点击就落空 ✗）
                if not _dragMoved {
                    int ddx = curGX - dragStartGX
                    int ddy = curGY - dragStartGY
                    if ddx < 0 { ddx = -ddx }
                    if ddy < 0 { ddy = -ddy }
                    if ddx >= 3 or ddy >= 3 { _dragMoved = true }
                }
                if _dragMoved {
                    int newX = dragStartWinX + (curGX - dragStartGX)
                    int newY = dragStartWinY + (curGY - dragStartGY)
                    core.lib().SDL_SetWindowPosition(winHandle, newX, newY)
                    core.markFrameRedraw()
                }
            }
            if ev.isMouseButtonUp() and ev.mouseButton() == 1 {
                _dragging = false
                _dragMoved = false
                winSizeDirty = true   // 拖拽结束后刷新窗口尺寸缓存
                core.markFrameRedraw()
            }
            return  // 拖拽期间不处理其他事件
        }

        // 非拖拽：处理事件
        // ★ 当嵌入的 MenuBar 展开时（isOpen），即使鼠标在标题栏外（下拉区域），
        //   也要继续转发事件给 MenuBar，否则下拉菜单无法响应 hover/click
        bool menuOpen = (centerIsMenu and embeddedMenu != null and embeddedMenu.isOpen())
        if not (my >= y and my < y + h and mx >= x) {
            if btnHover != BTN_NONE { btnHover = BTN_NONE; core.markFrameRedraw() }
            if actionHover != "" { actionHover = ""; core.markFrameRedraw() }
            if menuOpen and centerWidget != null { centerWidget.process(ev) }
            return
        }

        // ★ 中间控件事件转发（让嵌入的 Edit/Button/MenuBar 等控件能接收输入）
        if centerWidget != null { centerWidget.process(ev) }

        // 鼠标移动：更新按钮悬停状态（动作按钮与系统按钮**互斥** ✓）
        // ★ 窗口状态切换后的合成 Motion 事件跳过 hover 更新（_motionSkipCount > 0 时递减并跳过），
        //   避免窗口尺寸变化导致鼠标相对坐标落在关闭按钮上而误触红色悬停
        if ev.isMouseMotion() {
            if motionSkipCount > 0 {
                motionSkipCount = motionSkipCount - 1
            } else {
                int oldHover = btnHover
                string oldAHover = actionHover
                actionHover = hitTestAction(mx)
                if actionHover != "" {
                    btnHover = BTN_NONE              // 停在动作区时不该再亮系统按钮 ✓
                    core.requestCursor(SystemCursor.POINTER)
                    // 悬停提示复用框架那一套（与 Button/CheckBox 同一手感 ✓）
                    int ai = action_index(actionHover)
                    if ai >= 0 and actions[ai].tip != "" { tip.tipReport(actions[ai].tip, mx, my) }
                } else {
                    btnHover = hitTestBtn(mx)
                    if btnHover != BTN_NONE {
                        core.requestCursor(SystemCursor.POINTER)
                    }
                }
                if oldHover != btnHover or oldAHover != actionHover { core.markFrameRedraw() }
            }
        }

        // 鼠标按下：动作按钮 / 系统按钮 / 拖拽（三者互斥 ✓）
        if ev.isMouseButtonDown() and ev.mouseButton() == 1 {
            string act = hitTestAction(mx)
            int btn = hitTestBtn(mx)
            if act != "" {
                // 动作按钮：只回调 —— **不拖窗、也不双击最大化** ✓
                if action_enabled(act) {
                    if onAction != null { onAction(act) }
                    core.markFrameRedraw()
                }
            } else if btn == 3 and showClose {
                // 关闭
                if onClose != null { onClose() }
                else { closeRequested = true }
                core.markFrameRedraw()
            } else if btn == 2 and showMaximize {
                doToggleMaximize()
            } else if btn == 1 and showMinimize {
                doMinimize()
            } else {
                // 标题栏非按钮区域：双击切换最大化，单击开始拖拽
                if ev.mouseClicks() >= 2 {
                    if showMaximize { doToggleMaximize() }
                } else {
                    _dragging = true
                    _dragMoved = false   // ★ 阈值标记复位：动够了才真搬窗口（见拖拽分支的注释 ✓）
                    var[int, int](_dgx, _dgy) = core.getGlobalMouse(); dragStartGX = _dgx; dragStartGY = _dgy
                    var[int, int](_wpx, _wpy) = core.getWindowPos(winHandle)
                    dragStartWinX = _wpx
                    dragStartWinY = _wpy
                }
            }
        }

        // 右键菜单（可选，未来可扩展）
    }

    // ==================== 内部操作 ====================

    pri func doToggleMaximize() {
        if maximized {
            core.lib().SDL_RestoreWindow(winHandle)
            winSizeDirty = true   // 状态切换后刷新窗口尺寸缓存
            maximized = false
        } else {
            core.lib().SDL_MaximizeWindow(winHandle)
            winSizeDirty = true   // 状态切换后刷新窗口尺寸缓存
            maximized = true
        }
        btnHover = BTN_NONE            // ★ 立即清除悬停状态
        motionSkipCount = 2     // ★ 跳过紧随的合成 Motion 事件
        core.markFrameRedraw()
        if onMaximize != null { onMaximize() }
    }

    pri func doMinimize() {
        core.lib().SDL_MinimizeWindow(winHandle)
        core.markFrameRedraw()
        if onMinimize != null { onMinimize() }
    }

    // ==================== 手动边缘缩放 ====================

    // 检测鼠标是否在窗口边缘
    // 返回: 0=none, 1=left, 2=right, 3=top, 4=bottom,
    //       5=top-left, 6=top-right, 7=bottom-left, 8=bottom-right
    pri func detectEdge(float mx, float my, int winW, int winH): int {
        float th = resizeEdgeThreshold
        float fw = _float(winW)
        float fh = _float(winH)
        bool atLeft   = mx <= th
        bool atRight  = mx >= fw - th
        bool atTop    = my <= th
        bool atBottom = my >= fh - th

        // 优先检测角（角 = 两个边缘同时命中）
        if atTop and atLeft     { return EDGE_TOP_LEFT }
        if atTop and atRight    { return EDGE_TOP_RIGHT }
        if atBottom and atLeft  { return EDGE_BOTTOM_LEFT }
        if atBottom and atRight { return EDGE_BOTTOM_RIGHT }
        // 单边缘
        if atLeft   { return EDGE_LEFT }
        if atRight  { return EDGE_RIGHT }
        if atTop    { return EDGE_TOP }
        if atBottom { return EDGE_BOTTOM }
        return EDGE_NONE
    }

    // 根据 edge 值请求对应的系统缩放光标
    pri func requestResizeCursor(int edge) {
        // 1=left, 2=right → EW_RESIZE(7)
        // 3=top, 4=bottom → NS_RESIZE(8)
        // 5=top-left, 8=bottom-right → NWSE_RESIZE(5)
        // 6=top-right, 7=bottom-left → NESW_RESIZE(6)
        if edge == EDGE_LEFT or edge == EDGE_RIGHT {
            core.requestCursor(SystemCursor.EW_RESIZE)
        } else if edge == EDGE_TOP or edge == EDGE_BOTTOM {
            core.requestCursor(SystemCursor.NS_RESIZE)
        } else if edge == EDGE_TOP_LEFT or edge == EDGE_BOTTOM_RIGHT {
            core.requestCursor(SystemCursor.NWSE_RESIZE)
        } else if edge == EDGE_TOP_RIGHT or edge == EDGE_BOTTOM_LEFT {
            core.requestCursor(SystemCursor.NESW_RESIZE)
        }
    }

    // 开始缩放：记录起始状态
    pri func startResize(int edge) {
        resizeEdge = edge
        var[int, int](_rsgx, _rsgy) = core.getGlobalMouse(); resizeStartGX = _rsgx; resizeStartGY = _rsgy
        var[int, int](_rwx, _rwy) = core.getWindowPos(winHandle)
        resizeStartWinX = _rwx
        resizeStartWinY = _rwy
        var[int, int](_rww, _rwh) = core.getWindowSize(winHandle)
        resizeStartW = _rww
        resizeStartH = _rwh
        // 强制光标：拖拽中保持缩放光标，防止被其他控件覆盖
        if edge == EDGE_LEFT or edge == EDGE_RIGHT {
            core.forceFrameCursor(SystemCursor.EW_RESIZE)
        } else if edge == EDGE_TOP or edge == EDGE_BOTTOM {
            core.forceFrameCursor(SystemCursor.NS_RESIZE)
        } else if edge == EDGE_TOP_LEFT or edge == EDGE_BOTTOM_RIGHT {
            core.forceFrameCursor(SystemCursor.NWSE_RESIZE)
        } else if edge == EDGE_TOP_RIGHT or edge == EDGE_BOTTOM_LEFT {
            core.forceFrameCursor(SystemCursor.NESW_RESIZE)
        }
    }

    // 执行缩放：根据 edge 和当前全局鼠标位置调整窗口尺寸/位置
    pri func doResize() {
        var[int, int](curGX, curGY) = core.getGlobalMouse()
        int dx = curGX - resizeStartGX
        int dy = curGY - resizeStartGY
        int newW = resizeStartW
        int newH = resizeStartH
        int newX = resizeStartWinX
        int newY = resizeStartWinY
        int edge = resizeEdge

        // 水平方向
        if edge == EDGE_LEFT or edge == EDGE_TOP_LEFT or edge == EDGE_BOTTOM_LEFT {
            // 左边缘：宽度减小，位置左移
            newW = resizeStartW - dx
            newX = resizeStartWinX + dx
        } else if edge == EDGE_RIGHT or edge == EDGE_TOP_RIGHT or edge == EDGE_BOTTOM_RIGHT {
            // 右边缘：宽度增大
            newW = resizeStartW + dx
        }

        // 垂直方向
        if edge == EDGE_TOP or edge == EDGE_TOP_LEFT or edge == EDGE_TOP_RIGHT {
            // 上边缘：高度减小，位置上移
            newH = resizeStartH - dy
            newY = resizeStartWinY + dy
        } else if edge == EDGE_BOTTOM or edge == EDGE_BOTTOM_LEFT or edge == EDGE_BOTTOM_RIGHT {
            // 下边缘：高度增大
            newH = resizeStartH + dy
        }

        // 防止窗口尺寸过小
        if newW < 100 { newW = 100; newX = resizeStartWinX + (resizeStartW - 100) }
        if newH < 100 { newH = 100; newY = resizeStartWinY + (resizeStartH - 100) }

        core.lib().SDL_SetWindowSize(winHandle, newW, newH)
            winSizeDirty = true   // 尺寸变化后刷新缓存
        // 仅当位置变化时才设置（左/上边缘缩放会改变窗口位置）
        if newX != resizeStartWinX or newY != resizeStartWinY {
            core.lib().SDL_SetWindowPosition(winHandle, newX, newY)
        }
        core.markFrameRedraw()
    }

    // ==================== 懒加载图标纹理 ====================
    pri func ensure_images(Renderer r) {
        Ptr[u8] h = r.handle
        if imgMin != "" and texMin == null and loadMin != imgMin {
            texMin = img.loadTexture(h, imgMin); loadMin = imgMin
        }
        if imgMax != "" and texMax == null and loadMax != imgMax {
            texMax = img.loadTexture(h, imgMax); loadMax = imgMax
        }
        if imgRestore != "" and texRestore == null and loadRestore != imgRestore {
            texRestore = img.loadTexture(h, imgRestore); loadRestore = imgRestore
        }
        if imgClose != "" and texClose == null and loadClose != imgClose {
            texClose = img.loadTexture(h, imgClose); loadClose = imgClose
        }
        // 标题前的应用图标（与 icon_minimize 那套同款：路径变了就重载 ✓）
        if imgTitle != "" and texTitle == null and loadTitle != imgTitle {
            texTitle = img.loadTexture(h, imgTitle); loadTitle = imgTitle
        }
        // 动作按钮的**图片**图标：按 id 缓存（矢量名不进这里 ⇒ 不会去文件系统找 ✓）
        for actions.len() to i {
            TitleBarAction a = actions[i]
            if a.icon == "" or is_builtin_icon(a.icon) { continue }
            string loaded = actionLoad.get(a.id, "")
            if loaded != a.icon {
                var old = actionTex.get(a.id, null)
                if old != null {
                    var op = old as Ptr[u8]
                    releaseTex(op)
                }
                actionTex[a.id] = img.loadTexture(h, a.icon)
                actionLoad[a.id] = a.icon
            }
        }
    }

    // ==================== 渲染 ====================

    func render(Renderer r) {
        if not _loaded { return }
        ensure_font()
        ensure_images(r)

        // 同步窗口宽度
        // 缓存：仅在脏时查询 SDL，避免每帧 native call
        if winHandle != null {
            if winSizeDirty {
                var[int, int](_ww, _wh) = core.getWindowSize(winHandle)
                cachedWinW = _ww; cachedWinH = _wh; winSizeDirty = false
            }
            w = _float(cachedWinW)
        }

        // 背景填充
        r.setColor(bgColor)
        r.fillRect(x, y, w, h)

        // 按钮区域边界（供标题和中间控件布局参考）
        float btnLeft = btnAreaLeft()
        float btnRight = btnAreaRight()

        // 计算中间控件的布局位置（先计算，用于确定标题区域）
        float centerW = 0.0
        float cLeft = x + titlePad
        float cActualW = 0.0
        if centerWidget != null {
            centerW = centerWidget.get_w()
            cActualW = centerW
            if cActualW <= 0.0 { cActualW = 200.0 }
            cLeft = x + titlePad  // 默认靠左
            float cRight = cLeft + cActualW
            // 如果和右侧按钮重叠，则调整
            if btnAlign == BTN_ALIGN_RIGHT and cRight > btnRight - 4.0 {
                cLeft = btnRight - cActualW - 4.0
                if cLeft < x + titlePad { cLeft = x + titlePad; cActualW = btnRight - cLeft - 4.0 }
            }
        }

        // 标题文字区域：在中间控件和按钮组之间的空白处居中
        float titleLeft = x + titlePad
        float titleRight = w - titlePad
        float centerRightEdge = cLeft + cActualW
        if cActualW > 0.0 {
            if btnAlign == BTN_ALIGN_RIGHT {
                // 按钮在右：标题在菜单右侧、按钮左侧之间居中
                titleLeft = centerRightEdge + 8.0
                titleRight = btnRight - 8.0
            } else {
                // 按钮在左：标题在按钮右侧、菜单左侧之间居中
                titleLeft = btnLeft + 8.0
                titleRight = cLeft - 8.0
            }
        } else {
            if btnAlign == BTN_ALIGN_RIGHT { titleRight = btnRight - titlePad }
            else { titleLeft = btnLeft + titlePad }
        }
        if titleLeft > titleRight { titleLeft = x + titlePad; titleRight = w - titlePad }

        // 中间控件渲染（VS Code 风格：路径栏/搜索框/菜单栏等）
        if centerWidget != null {
            float cw = cActualW
            // 设置中间控件位置并渲染（使用上面计算的 cLeft）
            centerWidget.set_pos(cLeft, y + (h - centerWidget.get_h()) * 0.5)
            centerWidget.set_size(cw, centerWidget.get_h())
            centerWidget.render(r)
        }

        // 标题文字（在中间控件之后绘制，确保层级正确）
        if _font != null and _font.ok and title != "" {
            var[float, float](tw, th) = _font.measureString(title)
            float textY = y + (h - _float(_font.height)) * 0.5
            // ★ 标题前的**应用图标**（`title_icon`，2026-10-07 新增 ✓）：与文字作为**一个整体**排版
            //   · 尺寸缺省跟 `icon_size` 同档；纹理没加载出来 ⇒ 当"没有图标"，**不留空位** ✓
            //   · 没有图标时 blockW == tw、bx 与旧算法完全一致 ⇒ 老应用逐像素不变 ✓
            float iconS = titleIconSize
            if iconS <= 0.0 { iconS = iconImgSize }
            bool hasIcon = texTitle != null and iconS > 0.0
            float blockW = tw
            if hasIcon { blockW = blockW + iconS + titleIconGap }
            float bx = titleLeft
            if titleAlign == ALIGN_CENTER or centerWidget != null {
                // 居中：图标 + 文字**一起**在 titleLeft ~ titleRight 范围内居中
                bx = titleLeft + (titleRight - titleLeft - blockW) * 0.5
                if bx < titleLeft { bx = titleLeft }
                if bx + blockW > titleRight { bx = titleRight - blockW }
            }
            if texTitle != null and iconS > 0.0 {
                drawTitleIcon(r, texTitle, bx, y + (h - iconS) * 0.5, iconS)
                bx = bx + iconS + titleIconGap
            }
            r.drawText(_font, title, r.snapX(bx), r.snapY(textY), txColor)
        }

        // 按钮区域
        var pos = btnPositions()
        float minP = pos.get("minimize", -1.0)
        float maxP = pos.get("maximize", -1.0)
        float closeP = pos.get("close", -1.0)

        // 最小化按钮
        if showMinimize and minP >= 0.0 {
            drawBtnBg(r, minP, btnHover == BTN_MIN)
            if texMin != null {
                drawIcon(r, texMin, minP)
            } else {
                // 矢量：横线
                r.setColor(iconColor)
                r.fillRect(minP + btnWidth * 0.35, y + h * 0.5, btnWidth * 0.3, 2.0)
            }
        }

        // 最大化/还原按钮
        if showMaximize and maxP >= 0.0 {
            drawBtnBg(r, maxP, btnHover == BTN_MAX)
            if maximized and texRestore != null {
                drawIcon(r, texRestore, maxP)
            } else if not maximized and texMax != null {
                drawIcon(r, texMax, maxP)
            } else if texMax != null and texRestore == null {
                drawIcon(r, texMax, maxP)
            } else {
                // 矢量绘制
                r.setColor(iconColor)
                drawMaxIcon(r, maxP)
            }
        }

        // 关闭按钮
        if showClose and closeP >= 0.0 {
            drawCloseBtnBg(r, closeP, btnHover == BTN_CLOSE)
            if texClose != null {
                drawIcon(r, texClose, closeP)
            } else {
                // 矢量：X 叉
                r.setColor(iconColor)
                float cx = closeP + btnWidth * 0.5
                float cy = y + h * 0.5
                float sz = h * 0.25
                r.drawLine(cx - sz, cy - sz, cx + sz, cy + sz)
                r.drawLine(cx + sz, cy - sz, cx - sz, cy + sz)
            }
        }

        // 动作按钮（系统按钮内侧；位置顺序与 btnPositions 一致 ✓）
        int acount = actions.len()
        if acount > 0 {
            var apos = btnPositions()
            for acount to i {
                TitleBarAction a = actions[i]
                float ax = apos.get(a.id, -1.0)
                if ax < 0.0 { continue }
                if actionHover == a.id and a.enabled {
                    r.setColor(hovColor)
                    r.fillRect(ax, y, btnWidth, h)
                }
                if a.enabled {
                    r.setColor(iconColor)
                } else {
                    r.setColor(sepColor)      // 禁用 ⇒ 用分隔线色弱化（一眼看出不可点 ✓）
                }
                drawActionIcon(r, a.icon, a.id, ax)
            }
        }

        // 底部分隔线
        if showSeparator {
            r.setColor(sepColor)
            r.fillRect(x, y + h - 1.0, w, 1.0)
        }
    }

    // ==================== 动作按钮的图标绘制 ====================
    // 内置矢量名（见 is_builtin_icon）⇒ 矢量画，**不依赖任何图片资源** ✓；
    // 其他字符串当图片路径（纹理由 ensure_images 按 id 缓存 ✓）
    pri func drawActionIcon(Renderer r, string icon, string id, float bx) {
        float cx = bx + btnWidth * 0.5
        float cy = y + h * 0.5
        float sz = h * 0.26
        if sz < 6.0 { sz = 6.0 }
        if not is_builtin_icon(icon) {
            var texv = actionTex.get(id, null)
            if texv != null {
                var t = texv as Ptr[u8]
                drawIcon(r, t, bx)
            } else {
                r.fillCircle(cx, cy, sz * 0.35)   // 还没加载出来：先点一个点，别留空白 ✗
            }
            return
        }
        if icon == "gear" or icon == "settings" {
            // 齿轮：外圈 + 内孔 + 8 颗齿（四正 + 四斜 ⇒ 不用三角函数 ✓）
            float rr = sz * 0.62
            r.drawCircle(cx, cy, rr)
            r.drawCircle(cx, cy, rr * 0.42)
            float th = 3.0
            float td = rr * 1.45
            r.fillRect(cx - th * 0.5, cy - td - th * 0.5, th, th)
            r.fillRect(cx - th * 0.5, cy + td - th * 0.5, th, th)
            r.fillRect(cx - td - th * 0.5, cy - th * 0.5, th, th)
            r.fillRect(cx + td - th * 0.5, cy - th * 0.5, th, th)
            float dd = rr * 1.02
            r.fillRect(cx - dd - th * 0.5, cy - dd - th * 0.5, th, th)
            r.fillRect(cx + dd - th * 0.5, cy - dd - th * 0.5, th, th)
            r.fillRect(cx - dd - th * 0.5, cy + dd - th * 0.5, th, th)
            r.fillRect(cx + dd - th * 0.5, cy + dd - th * 0.5, th, th)
        } else if icon == "menu" {
            float bw = sz * 1.9
            r.fillRect(cx - bw * 0.5, cy - sz * 0.8, bw, 1.8)
            r.fillRect(cx - bw * 0.5, cy - 0.9, bw, 1.8)
            r.fillRect(cx - bw * 0.5, cy + sz * 0.8 - 1.8, bw, 1.8)
        } else if icon == "search" {
            r.drawCircle(cx - sz * 0.22, cy - sz * 0.22, sz * 0.72)
            r.drawLine(cx + sz * 0.3, cy + sz * 0.3, cx + sz * 1.1, cy + sz * 1.1)
        } else if icon == "star" {
            r.drawLine(cx - sz, cy, cx + sz, cy)
            r.drawLine(cx - sz * 0.5, cy - sz * 0.87, cx + sz * 0.5, cy + sz * 0.87)
            r.drawLine(cx - sz * 0.5, cy + sz * 0.87, cx + sz * 0.5, cy - sz * 0.87)
        } else if icon == "info" or icon == "help" {
            r.drawCircle(cx, cy, sz)
            r.fillRect(cx - 1.0, cy - sz * 0.5, 2.0, 2.0)
            r.fillRect(cx - 1.0, cy - sz * 0.05, 2.0, sz * 0.65)
        } else if icon == "refresh" {
            r.drawCircle(cx, cy, sz * 0.82)
            r.fillRect(cx + sz * 0.42, cy - sz * 1.02, 3.0, 3.0)
        } else if icon == "sun" {
            r.drawCircle(cx, cy, sz * 0.45)
            drawIconRays(r, cx, cy, sz * 0.95, 3.0)
        } else if icon == "home" {
            r.drawLine(cx - sz, cy, cx, cy - sz * 0.95)
            r.drawLine(cx, cy - sz * 0.95, cx + sz, cy)
            r.drawRect(cx - sz * 0.6, cy, sz * 1.2, sz * 0.85)
        } else if icon == "download" {
            // 下载：下箭头（竖杆 + 箭头）+ 底下一条托盘线（三笔都用现成图元，不引三角函数 ✓）
            r.drawLine(cx, cy - sz * 1.05, cx, cy + sz * 0.25)
            r.drawLine(cx - sz * 0.62, cy - sz * 0.28, cx, cy + sz * 0.42)
            r.drawLine(cx, cy + sz * 0.42, cx + sz * 0.62, cy - sz * 0.28)
            r.drawLine(cx - sz * 0.95, cy + sz * 1.0, cx + sz * 0.95, cy + sz * 1.0)
        } else {
            r.fillCircle(cx, cy, sz * 0.35)      // dot：兜底，至少不是空白 ✓
        }
    }

    // 八向短横（sun 的射线；与齿轮同款写法，不引三角函数 ✓）
    pri func drawIconRays(Renderer r, float cx, float cy, float d, float th) {
        r.fillRect(cx - th * 0.5, cy - d - th * 0.5, th, th)
        r.fillRect(cx - th * 0.5, cy + d - th * 0.5, th, th)
        r.fillRect(cx - d - th * 0.5, cy - th * 0.5, th, th)
        r.fillRect(cx + d - th * 0.5, cy - th * 0.5, th, th)
        float dd = d * 0.72
        r.fillRect(cx - dd - th * 0.5, cy - dd - th * 0.5, th, th)
        r.fillRect(cx + dd - th * 0.5, cy - dd - th * 0.5, th, th)
        r.fillRect(cx - dd - th * 0.5, cy + dd - th * 0.5, th, th)
        r.fillRect(cx + dd - th * 0.5, cy + dd - th * 0.5, th, th)
    }

    // ==================== 弹层渲染（第二遍，画在最上层） ====================
    // ★ 当 center_widget 是 MenuBar 时，需要转发 renderPopup 以绘制下拉弹出层
    func renderPopup(Renderer r) {
        if not _loaded { return }
        if centerWidget != null {
            // 尝试调用 center_widget 的 renderPopup（MenuBar 有此方法）
            // 用类型检查确保安全
            var w = centerWidget
            // MenuBar 的 renderPopup 在展开时绘制下拉层
            // 由于 Leno 的动态分发限制，这里通过检查 isOpen 状态来决定是否需要弹层渲染
            // 实际上 MenuBar 的 renderPopup 是独立方法，我们需要直接调用
            // 这里用内联方式处理：检查是否是 MenuBar 并调用其 renderPopup
            renderCenterPopup(r)
        }
    }

    // 内部方法：尝试渲染 center_widget 的弹层（MenuBar 下拉菜单）
    pri func renderCenterPopup(Renderer r) {
        // 由于 Leno 不支持动态类型转换到具体类型调用方法，
        // 我们在 TitleBar 层面记录 center_widget 是否是 MenuBar 类型
        // 通过 _centerIsMenu 标志位判断
        if centerIsMenu and centerWidget != null {
            // 手动调用 MenuBar 的 renderPopup 逻辑
            // MenuBar 的 renderPopup 检查 _open >= 0 后绘制下拉面板
            drawMenuBarPopup(r)
        }
    }

    // 绘制嵌入的 MenuBar 的下拉弹出层
    pri func drawMenuBarPopup(Renderer r) {
        // 通过访问 MenuBar 内部状态来判断是否需要绘制弹层
        // 这里我们依赖 MenuBar 自身的 render 方法已经处理了本体，
        // 而 renderPopup 需要额外绘制下拉面板
        // 由于跨模块访问限制，我们在 set_center_widget 时记录类型信息
        // 实际绘制委托给一个回调或直接调用已知接口
        // 当前方案：让嵌入的 MenuBar 也注册到窗口的 _menus 列表
        // 但这需要在 Window 层面支持。作为替代方案：
        // 我们在 TitleBar 内部模拟 MenuBar 的 renderPopup 行为
        // 这需要访问 MenuBar 的内部字段，不太理想。
        // 
        // ★ 最佳方案：让 set_center_widget(MenuBar) 时自动将 MenuBar 注册到一个
        //   全局/窗口级别的 "嵌入式菜单" 列表，由 win.run 的 renderPopup 阶段遍历。
        //   但这需要修改 sdl_window.leno。
        //
        // ★ 当前可行方案：TitleBar 自己维护一个 _embeddedMenu 引用，
        //   在 renderPopup 中直接调用它的 renderPopup 方法。
        //   问题：Leno 的 Widget 基类没有 renderPopup 方法。
        //
        // ★ 最终方案：在 TitleBar 中存储 MenuBar 类型的引用（非 Widget?），
        //   提供 set_center_menu(MenuBar) 专用方法。
        if embeddedMenu != null {
            embeddedMenu.renderPopup(r)
        }
    }

    // ★ 专用方法：设置嵌入的 MenuBar（相比通用 set_center_widget，
    //   这个方法会额外处理 renderPopup 转发，确保下拉菜单能正常弹出）
    func set_center_menu(MenuBar bar) {
        centerWidget = bar as Widget
        embeddedMenu = bar
        centerIsMenu = true
        core.markFrameRedraw()
    }

    func get_center_menu(): MenuBar? { return embeddedMenu }

    // 普通按钮悬停背景
    pri func drawBtnBg(Renderer r, float bx, bool hover) {
        if hover {
            r.setColor(hovColor)
            r.fillRect(bx, y, btnWidth, h)
        }
    }

    // 关闭按钮悬停背景（红色）
    pri func drawCloseBtnBg(Renderer r, float bx, bool hover) {
        if hover {
            r.setColor(closeHovColor)
            r.fillRect(bx, y, btnWidth, h)
        }
    }

    // 居中绘制图标图片
    pri func drawIcon(Renderer r, Ptr[u8] tex, float bx) {
        float sz = iconImgSize
        if sz <= 0.0 { sz = h * 0.5 }
        float ix = bx + (btnWidth - sz) * 0.5
        float iy = y + (h - sz) * 0.5
        r.setTextureAlpha(tex, 255)
        r.setTextureColor(tex, #FFFFFFFF)
        var[float, float](nw, nh) = r.getTextureSize(tex)
        float dw = sz; float dh = sz
        if nw > 0.0 and nh > 0.0 {
            float s = sz / nw; if sz / nh < s { s = sz / nh }
            dw = nw * s; dh = nh * s
        }
        r.drawTextureAt(tex, ix + (sz - dw) * 0.5, iy + (sz - dh) * 0.5, dw, dh)
    }

    // 标题前的应用图标：按指定边长**等比**缩放后画在 (bx, by)（与 drawIcon 同一套等比算法 ✓）
    pri func drawTitleIcon(Renderer r, Ptr[u8] tex, float bx, float by, float sz) {
        r.setTextureAlpha(tex, 255)
        r.setTextureColor(tex, #FFFFFFFF)
        var[float, float](nw, nh) = r.getTextureSize(tex)
        float dw = sz; float dh = sz
        if nw > 0.0 and nh > 0.0 {
            float s = sz / nw; if sz / nh < s { s = sz / nh }
            dw = nw * s; dh = nh * s
        }
        r.drawTextureAt(tex, bx + (sz - dw) * 0.5, by + (sz - dh) * 0.5, dw, dh)
    }

    // 矢量最大化/还原图标
    pri func drawMaxIcon(Renderer r, float bx) {
        float cx = bx + btnWidth * 0.5
        float cy = y + h * 0.5
        float sz = h * 0.22
        if maximized {
            // 还原图标：两个偏移方框
            r.drawRect(cx - sz + 2, cy - sz + 2, sz * 1.3, sz * 1.3)
            r.drawLine(cx - sz + 2 + sz * 0.4, cy - sz + 2, cx - sz + 2 + sz * 0.4, cy - sz + 2 - sz * 0.4)
            r.drawLine(cx - sz + 2 + sz * 0.4, cy - sz + 2 - sz * 0.4, cx - sz + 2 + sz * 1.3, cy - sz + 2 - sz * 0.4)
            r.drawLine(cx - sz + 2 + sz * 1.3, cy - sz + 2 - sz * 0.4, cx - sz + 2 + sz * 1.3, cy - sz + 2 + sz * 0.4)
            r.drawLine(cx - sz + 2 + sz * 1.3, cy - sz + 2 + sz * 0.4, cx - sz + 2 + sz * 1.3 - sz * 0.4, cy - sz + 2 + sz * 0.4)
        } else {
            // 最大化图标：单个方框
            r.drawRect(cx - sz, cy - sz, sz * 2.0, sz * 2.0)
        }
    }

    // ==================== 公共 API ====================

    func set_title(string t) { title = t; core.markFrameRedraw() }
    func get_title(): string { return title }
    func set_maximized(bool v) { maximized = v; core.markFrameRedraw() }
    func is_maximized(): bool { return maximized }
    func is_close_requested(): bool { return closeRequested }
    func clear_close_request() { closeRequested = false }
    func is_dragging(): bool { return _dragging }
    func set_show_minimize(bool v) { showMinimize = v; core.markFrameRedraw() }
    func set_show_maximize(bool v) { showMaximize = v; core.markFrameRedraw() }
    func set_show_close(bool v) { showClose = v; core.markFrameRedraw() }
    func set_height(float hh) { h = hh; core.markFrameRedraw() }

    // 设置按钮组位置："right"（默认，Windows/Linux）或 "left"（macOS 风格）
    func set_btn_align(string align) {
        if align == "left" { btnAlign = BTN_ALIGN_LEFT } else { btnAlign = BTN_ALIGN_RIGHT }
        core.markFrameRedraw()
    }

    // ★ 设置中间控件（VS Code 风格：在标题和按钮之间插入自定义控件）
    //   传入 null 可移除中间控件
    func set_center_widget(Widget? widget) { centerWidget = widget; core.markFrameRedraw() }
    func get_center_widget(): Widget? { return centerWidget }

    // 设置背景色
    func set_bg_color(Color color) { bgColor = color; core.markFrameRedraw() }
    // 设置标题文字色
    func set_text_color(Color color) { txColor = color; core.markFrameRedraw() }
    // 设置按钮悬停色
    func set_hover_color(Color color) { hovColor = color; core.markFrameRedraw() }
    // 设置关闭按钮悬停色
    func set_close_hover_color(Color color) { closeHovColor = color; core.markFrameRedraw() }
    // 设置图标线条色
    func set_icon_color(Color color) { iconColor = color; core.markFrameRedraw() }
    // 设置分隔线色
    func set_separator_color(Color color) { sepColor = color; core.markFrameRedraw() }

    // 设置图标图片
    func set_icon_minimize(string path) { releaseTex(texMin); texMin = null; imgMin = path; loadMin = "" }
    func set_icon_maximize(string path) { releaseTex(texMax); texMax = null; imgMax = path; loadMax = "" }
    func set_icon_restore(string path)  { releaseTex(texRestore); texRestore = null; imgRestore = path; loadRestore = "" }
    func set_icon_close(string path)    { releaseTex(texClose); texClose = null; imgClose = path; loadClose = "" }
    // 运行时换标题前的应用图标（传 "" ⇒ 去掉图标 ✓）
    func set_title_icon(string path)    { releaseTex(texTitle); texTitle = null; imgTitle = path; loadTitle = "" }

    pri func releaseTex(Ptr[u8]? tex) {
        if tex != null { core.lib().SDL_DestroyTexture(tex) }
    }

    // ==================== 回调注册 ====================
    func on_close(func():void cb) { onClose = cb }
    func on_minimize(func():void cb) { onMinimize = cb }
    func on_maximize(func():void cb) { onMaximize = cb }
    func on_action(func(string):void cb) { onAction = cb }   // 动作按钮被点击（见文件头 ✓）

    // ==================== 动作按钮：运行时增删改 ====================
    //   （声明式那一套见 opts.actions；这里给"边跑边改"用：加/删/换图标/禁用 ✓）

    // 追加一个动作按钮：{id, icon, tip, enabled}（id 为空 ⇒ 忽略；id 已存在 ⇒ 就地替换 ✓）
    func add_action(Dict a) {
        TitleBarAction na = _makeAction(a)
        if na.id == "" { return }
        int i = action_index(na.id)
        if i >= 0 { actions[i] = na } else { actions.add(na) }
        core.markFrameRedraw()
    }

    // 移除一个动作按钮（连带释放它的图片纹理 ✓）
    func remove_action(string id) {
        int i = action_index(id)
        if i < 0 { return }
        var old = actionTex.get(id, null)
        if old != null {
            var op = old as Ptr[u8]
            releaseTex(op)
        }
        actions.remove(i)
        if actionHover == id { actionHover = "" }
        actionTex = {}      // 缓存整体作废（下次 ensure_images 会按剩下的动作重建 ✓）
        actionLoad = {}
        core.markFrameRedraw()
    }

    func clear_actions() {
        for actions.len() to i {
            var old = actionTex.get(actions[i].id, null)
            if old != null {
                var op = old as Ptr[u8]
                releaseTex(op)
            }
        }
        actions = []
        actionTex = {}
        actionLoad = {}
        actionHover = ""
        core.markFrameRedraw()
    }

    // 换图标：内置矢量名或图片路径都行（换路径 ⇒ 自动重新加载 ✓）
    func set_action_icon(string id, string icon) {
        int i = action_index(id)
        if i < 0 { return }
        actions[i].icon = icon
        core.markFrameRedraw()
    }

    func set_action_tip(string id, string t) {
        int i = action_index(id)
        if i < 0 { return }
        actions[i].tip = t
    }

    func set_action_enabled(string id, bool v) {
        int i = action_index(id)
        if i < 0 { return }
        actions[i].enabled = v
        core.markFrameRedraw()
    }

    // 只读快照 / 计数（调用方与测试都靠它看当前有哪些动作 ✓）
    func get_actions(): Array[TitleBarAction] { return actions }
    func action_count(): int { return actions.len() }

    // ==================== 释放资源 ====================
    func dispose() {
        if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null
        releaseTex(texMin); releaseTex(texMax)
        releaseTex(texRestore); releaseTex(texClose)
        releaseTex(texTitle)
        texMin = null; texMax = null; texRestore = null; texClose = null; texTitle = null
        // 动作按钮的图片纹理（矢量图标没有纹理 ⇒ 空缓存时什么都不做 ✓）
        for actions.len() to i {
            var old = actionTex.get(actions[i].id, null)
            if old != null {
                var op = old as Ptr[u8]
                releaseTex(op)
            }
        }
        actionTex = {}
        actionLoad = {}
    }

// ==================== 运行时主题切换 ====================
func applyTheme(Theme t) {
bgColor = t.bg
txColor = t.txt
hovColor = t.bgHover
sepColor = t.sep
iconColor = theme.darken(t.txt, 64)
}
}

// 工厂
// 应用图标（2026-10-08 ✓）：**第一个**设了 `title_icon` 的标题栏 = 主窗口那个 ✓
//   弹窗标题栏没自己指定时沿用它（见 `sdl_dialog.dialogTitleBar` ✓）
//   为什么记在这儿：标题栏是"谁设了图标"的唯一入口 ✓，而弹窗那边拿不到主窗口的控件 ✓
string _appIcon = ""

export func appTitleIcon(): string { return _appIcon }

export func createTitleBar(Dict opts): TitleBar {
    TitleBar tb = new TitleBar(); tb.set(opts); return tb
}


