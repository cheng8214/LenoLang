// sdl_groupbox.leno — 带标题的分组容器
// 通过 win.addGroupBox({...}) 创建，在 Panel 基础上增加标题文字
// 标题绘制在边框顶部，子控件用绝对坐标添加
import "sdl_renderer.leno" as ren; use ren.Renderer
import "sdl_opts.leno" as dochk    // 选项对账：不认识的键会报一行警告（见 sdl_opts.leno ✓）
import "sdl_font.leno" as fnt; use fnt.Font
import "sdl_event.leno" as evt; use evt.Event
import "sdl_core.leno" as core; use core.SDL_Rect
import "sdl_widget.leno" as wgt; use wgt.Widget
import "sdl_edit.leno" as edt; use edt.Edit
import "sdl_layout.leno" as lay; use lay.HBox; use lay.VBox; use lay.AnchorBox
import "sdl_table.leno" as tbl; use tbl.Table
import "sdl_treeview.leno" as tvlib; use tvlib.TreeView
import "sdl_theme.leno" as theme; use theme.(Theme, Themeable)
use theme.Color


// 本控件认的键 —— 由本文件全部 `.get("…")` **自动抽取**（是超集 ⇒ 可少报、不误报 ✓）
//   ⚠ 以后增删选项请重跑抽取（或人工核对），否则可能对合法用法误报 ✓
func _opts_keys(): Array[string] {
    return [
"bg_color", "border_alpha", "border_color", "clip", "enabled", "font_path", "font_size", "font_style", "h", "radius", "title", "title_color", "title_pad", "visible", "w", "x", "y"
]
}
export struct GroupBox impl Widget, Themeable {
    float x = 0.0, y = 0.0, w = 300.0, h = 200.0
    pri string title = "Group"
    float _fontSize = 14.0
    pri string fontPath = ""
    pri int fontStyle = 0
    Font? _font
    // ★ 标题宽度缓存：标题不变时避免每帧 measureString
    pri float cachedTitleW = 0.0
    pri float cachedTitleH = 0.0
    pri string cachedTitleKey = "\x01"
    Array[Widget] children = []
    Widget? _layoutChild          // 自动布局子控件：每帧自动同步到 GroupBox 内部区域（减去 padding）
    pri float layPad = 0.0          // _layoutChild 的内边距
    pri Color bgColor = #2C2E36FF        // 背景色
    pri Color bdrColor = #5A5F6EFF    // 边框色
    pri Color titleColor = #C8CDD7FF  // 标题文字色
    pri int brdA = 200                            // 边框透明度
    pri float radius = 8.0
    pri float titlePad = 8.0                      // 标题左右间距
    bool _clip = true
    bool _loaded = false, enabled = true, visible = true
    pri Ptr[u8] hwnd

    pri func ensure_font() {
        if _font == null or not _font.ok {
            if _font != null and _font.ok { fnt.releaseFont(_font) }
            if fontPath != "" { _font = fnt.acquireFont(fontPath, _fontSize) }
            else { _font = fnt.acquireFontAuto(_fontSize) }
            if _font.ok and fontStyle != 0 { _font.setStyle(fontStyle) }
            cachedTitleKey = "\x01"   // 字体变化，缓存失效
        }
    }


    func set(Dict opts) {
        dochk.check("sdl_groupbox", opts, _opts_keys())   // ★ 选项对账（2026-09-29 铺开 ✓）
        Theme th = theme.getTheme()
        bgColor = th.bgAlt
        bdrColor = th.border
        titleColor = th.txtHeader
        x      = opts.get("x", 0)
        y      = opts.get("y", 0)
        w      = opts.get("w", 300)
        h      = opts.get("h", 200)
        title = opts.get("title", "Group")
        _fontSize = opts.get("font_size", 14)
        fontPath = opts.get("font_path", "")
        fontStyle = opts.get("font_style", 0)
        radius = opts.get("radius", 8.0)
        titlePad = opts.get("title_pad", 8.0)
        brdA = opts.get("border_alpha", 200)
        _clip = opts.get("clip", true)
        enabled = opts.get("enabled", true)
        visible = opts.get("visible", true)
        if opts.get("bg_color") is Color => t { bgColor = t }
        if opts.get("border_color") is Color => t { bdrColor = t }
        if opts.get("title_color") is Color => t { titleColor = t }
        ensure_font()
        children = []
        _loaded = true
    }

    // ==================== 设置方法 ====================
    func set_title(string t) { title = t; cachedTitleKey = "\x01" }
    func add(Widget c): Widget {
        children.add(c)
        if hwnd != null { pass_hwnd(c, hwnd) }
        return c
    }
    func _bind_window(Ptr[u8] hwnd) {
        self.hwnd = hwnd      // 形参遮蔽字段 ⇒ 必须显式 self.
        var lc = _layoutChild
        if lc is Widget { pass_hwnd(lc, hwnd) }
        for children to c { pass_hwnd(c, hwnd) }
    }
    pri func pass_hwnd(Widget c, Ptr[u8] hwnd) {
        lay.passWindowHandle(c, hwnd)
    }
    func remove(Widget c) {
        for children.len() to i { if children[i] == c { children.remove(i); return } }
    }
    func clear_children() { children = [] }

    // 设置自动布局子控件：该控件会每帧自动同步位置/尺寸到 GroupBox 内部区域（减去 padding）。
    // 用法：gb.setLayout(SDL3.createVBox({...}))，GroupBox 移动/缩放时 VBox 自动跟随。
    // 这解决了 GroupBox 子控件用绝对坐标不跟随滚动的问题（与 Panel.setLayoutPadded 一致）。
    func setLayout(Widget c) { _layoutChild = c; layPad = 0.0 }
    func setLayoutPadded(Widget c, float pad) { _layoutChild = c; layPad = pad }

    // 同步 _layoutChild 到 GroupBox 内部区域
    pri func syncLayoutChild() {
        var lc = _layoutChild
        if lc is Widget {
            lc.set_pos(x + layPad, y + layPad)
            lc.set_size(w - 2.0 * layPad, h - 2.0 * layPad)
        }
    }

    func set_bg_color(Color color) { bgColor = color }
    func set_enabled(bool e) { enabled = e }
    func set_visible(bool v) { visible = v }
    func is_visible(): bool { return visible }
    func get_x(): float { return x }
    func get_y(): float { return y }
    func get_w(): float { return w }
    func get_h(): float { return h }
    func set_pos(float px, float py) { x = px; y = py }
    func set_size(float sw, float sh) { w = sw; h = sh }

    func process(Event ev) {
        if not _loaded or not enabled or not visible { return }
        syncLayoutChild()
        var lc = _layoutChild
        lc?.process(ev)
        for children to c { c.process(ev) }
    }

    // ==================== 渲染 ====================
    func render(Renderer r) {
        if not _loaded or not visible { return }
        ensure_font()

        // 背景
        r.setColor(bgColor)
        r.fillRoundedRect(x, y, w, h, radius)

        // 裁剪子控件（只在真要裁剪时分配 rect ✓ 同 Panel：每帧 render ⇒ 不该无条件 malloc ✗）
        SDL_Rect? cr = null
        if _clip {
            var c2 = SDL_Rect.malloc()
            c2.x = _int(x); c2.y = _int(y)
            c2.w = _int(w) + 1; c2.h = _int(h) + 1
            r.pushClipRect(c2.to_ptr())
            cr = c2
        }
        syncLayoutChild()
        var lc = _layoutChild
        lc?.render(r)
        for children to c { c.render(r) }
        if _clip {
            r.popClipRect()
            cr?.free()
        }

        // 边框
        r.setColor(theme.withAlpha(bdrColor, brdA))
        r.drawRoundedRect(x, y, w, h, radius)

        // 标题：在边框顶部画一段背景色遮断边框，再绘制文字
        if _font != null and _font.ok and title != "" {
            // ★ 缓存：标题不变时直接复用
            float msw, msh
            if title == cachedTitleKey {
                msw = cachedTitleW; msh = cachedTitleH
            } else {
                var[float, float](_msw, _msh) = _font.measureString(title)
                msw = _msw; msh = _msh
                cachedTitleW = msw; cachedTitleH = msh; cachedTitleKey = title
            }
            float tx = x + titlePad
            float ty = y - msh / 2.0
            // 用背景色画一个矩形遮断边框（标题位置）
            r.setColor(bgColor)
            r.fillRect(tx - 3.0, ty, msw + 6.0, _float(msh))
            // 标题文字
            r.drawText(_font, title, tx, ty, titleColor)
        }
    }

    func dispose() {
        if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null
        var lc = _layoutChild
        lc?.dispose()
        for children to c { c.dispose() }
    }

    // ==================== 运行时主题切换 ====================
    func applyTheme(Theme t) {
        bgColor = t.bgAlt
        bdrColor = t.border
        titleColor = t.txtHeader
    }
}

// 工厂
export func createGroupBox(Dict opts): GroupBox {
    GroupBox gb = new GroupBox(); gb.set(opts); return gb
}


