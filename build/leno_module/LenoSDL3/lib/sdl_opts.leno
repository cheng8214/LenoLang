// sdl_opts.leno — 控件选项"对账"小工具（2026-09-29 加）
//
// 背景：框架早期为了快，`opts.get(k, def)` 对**不认识的键**一律**静默丢弃** ✗ ——
//   拼错的名字（`icon` vs `image` ✗）、父容器根本不采纳的键（Label 收 `w` ✗）
//   全都没有任何提示 ✗ ⇒ 应用侧为此踩了很多坑（实测：图标不出现、文字不显示、
//   折行压住按钮，都要靠读框架源码才查得出来 ✗）。
//   ⇒ 本文件提供**一次对账**：在**入口**处把 opts 的键与白名单比一遍，
//     不认识的 ⇒ 打印一行警告（带"你是不是想要 xxx？"的近名提示 ✓）。
//
// 用法（**只加一行，不动原有逻辑** ✓）：
//   import "sdl_opts" as dochk
//   dochk.check("Alert", opts, ALERT_KEYS)          // 创建函数 / set() 入口处
//   dochk.warn_once("菜单项", "icon", "菜单项：图标键是 'image' 不是 'icon' ⇒ 请改成 image: …")
//
// 设计取舍（都是**为了不破坏现有代码** ✓）：
//   · 默认只**警告**、绝不报错 ⇒ 框架已有很多使用者，不能因为多传一个键就炸 ✗
//   · 同一个 `(控件名, 键名)` **只报一次** ⇒ 循环里建控件也不会刷屏 ✓
//   · 设 `LENO_UI_STRICT=1` 时前缀变成 `[ui][STRICT]`（便于 CI/自测把它当失败看 ✓）
//   · 只在**入口**调用（createXxx / add / 解析器）⇒ 不侵入各控件内部 ✓
import strings

// 已经报过的 `控件名:键名`（同一个错只提醒一次 ✓）
Array[string] _warned = []

// 收集到的警告原文（供**自测断言** ✓ —— 见 assert/test_ui_opts_guard.leno ✓）
//   为什么要它：这套东西的价值全在"该报的一定报、不该报的一句不报" ✗
//   ⇒ 光靠肉眼看屏是回归不住的，必须能被断言钉住 ✓
Array[string] _log = []

// 取出并清空已收集的警告（自测用 ✓；正常运行不需要它 ✓）
export func take_log(): Array[string] {
    Array[string] r = _log
    _log = []
    return r
}

export func _strict(): bool {
    return _env_or("LENO_UI_STRICT", "") != ""
}

func _in(Array[string] xs, string x): bool {
    for xs to it { if it == x { return true } }
    return false
}

// 编辑距离（键名都很短 ⇒ 经典 DP 足够快 ✓）
func _dist(string a, string b): int {
    int la = a.len()
    int lb = b.len()
    if la == 0 { return lb }
    if lb == 0 { return la }
    Array[int] prev = []
    for 0 : lb to j { prev.add(j) }
    for 1 : la to i {
        Array[int] cur = [i]
        for 1 : lb to j {
            int cost = 1
            if strings.slice(a, i - 1, i - 1) == strings.slice(b, j - 1, j - 1) { cost = 0 }
            int v = prev[j] + 1
            if cur[j - 1] + 1 < v { v = cur[j - 1] + 1 }
            if prev[j - 1] + cost < v { v = prev[j - 1] + cost }
            cur.add(v)
        }
        prev = cur
    }
    return prev[lb]
}

// 找"最像"的已知键（编辑距离 ≤ 2）⇒ 给"你是不是想要 xxx？"的提示 ✓
//   实测价值最大的就是这条：`icon` ⇒ `image` ✓（我为此读了一整天源码才定位到 ✗）
export func near(string k, Array[string] known): string {
    string best = ""
    int bestD = 99
    for known to c {
        int d = _dist(k, c)
        if d < bestD { bestD = d; best = c }
    }
    if bestD <= 2 { return best }
    return ""
}

// 给一行警告**加前缀** —— 抽成纯函数是有原因的 ✓：
//   ★ 2026-10-13：原来"STRICT 时前缀变成 `[ui][STRICT]`"这句**只写在注释里** ✗、
//     自测也断言不到 ✗（`take_log()` 存的是**原文**、前缀只打在 stdout ✓）
//   ⇒ 抽出来 ⇒ 自测可以**直接断言这个函数**（两种模式都对得上 ✓ 见 test_ui_opts_guard ⑦ ✓）
export func format_line(string msg): string {
    if _strict() { return "[ui][STRICT] " + msg }
    return "[ui] " + msg
}

// 只报一次（同一 (who,key) ✓）；STRICT 时加醒目前缀 ✓
export func warn_once(string who, string key, string msg) {
    string tag = who + ":" + key
    if _in(_warned, tag) { return }
    _warned.add(tag)
    _log.add(msg)      // ★ 收集的是**原文**（不带前缀 ✓）⇒ 自测做子串断言最方便 ✓
    print(format_line(msg))
}

// **窗口侧通用键**：由 `Window.addXxx` 读走做层级 ✓，控件自己不认它 ⇒ 不该算"未知键" ✗
//   ★ 2026-10-13 补：实测全库**没有一个控件白名单含 `z`** ✗、应用里也没人传过 ✓
//   ⇒ 这是"以后一传 `z:` 就被误报"的隐患 ✓（对账最怕误报 ⇒ 一旦刷屏就退化成噪音 ✗）
//   ⇒ 在**这一处**豁免最省：不用去改 33 份白名单 ✓
Array[string] _window_keys = ["z"]

// ============================================================================
// ★ 2026-10-13：**改名表**（旧名 → 新名）—— "统一选项命名"的**安全网** ✓
// ----------------------------------------------------------------------------
// 为什么要有它（这是改名能不能做成的关键）：
//   改名的最大风险是"用户的代码**悄悄**失效" ✗。有了这张表：
//     ① 旧名**仍然可用**（各控件照旧读它 ⇒ 白名单 `_opts_keys()` 里也还留着它 ✓）
//        ⇒ **现有代码零破坏** ✓（这一步比"直接改名"重要得多）
//     ② 但**每次用到都会警告**：本表在 `known` 判断**之前**查 ⇒
//        旧名虽然还在白名单里，照样每次都报 ✓ ⇒ **警告清零 = 迁移完成**，**可验证** ✓
//     ③ 加一处改名只改**这一处** ✓
//   ⚠ 口径与"不认识的选项"**分开**：改名是**有对应新名的** ⇒ 直接给出新名，
//     不走"你是不是想要 xxx"的近名猜测（那对改名场景是误导 ✗）
//   ⚠ 旧名**别急着**删：白名单与 `.get("…")` 里的旧读法要一直留到"警告清零"之后再删 ✓
//
// 两列**平行**（不用字符串解析：更直白、也少一处可能出错的地方 ✓）
Array[string] _renamed_old = [
    "fontSize",        // popmenu：其余 22 个控件都用 font_size ✓
    "padX", "padY",    // gridlayout：alert / badge / drag / card… 早就用 pad_x / pad_y ✓
    "imageMode",       // treeview：button / card 用 image_mode ✓
    "imageExpanded",   // treeview
]
Array[string] _renamed_new = [
    "font_size",
    "pad_x", "pad_y",
    "image_mode",
    "image_expanded",
]

// 查旧名 ⇒ 新名（不是旧名时返回 ""✓）
export func renamed_to(string key): string {
    for 0 : _renamed_old.len() - 1 to i {
        if _renamed_old[i] == key { return _renamed_new[i] }
    }
    return ""
}

// 对账：opts 里出现不在 known 里的键 ⇒ 警告 ✓（默认每个只报一次 ✓）
export func check(string who, Dict opts, Array[string] known) {
    if opts == null { return }
    var ks = opts.keys()
    for ks to k {
        // ⚠ `keys()` 返回**无类型 Array** ⇒ 元素是 `any` ✗ ⇒ 显式转 string ✓
        //   （否则报 "期望 string, 实际 any" ✓ —— 与 RegValueInfo 那个坑同源 ✓）
        string key = _str(k)
        if key == "" { continue }
        // ★ 改名过的旧名：**照旧能用**，但每次都提醒一次 ✓
        //   ⚠ 必须在 `known` 判断**之前** —— 旧名还在白名单里（控件还在读它）⇒ 放后面就永远不报 ✗
        string nn = renamed_to(key)
        if nn != "" {
            warn_once(who, key, $"{who}：选项 '{key}' 已改名为 '{nn}'（旧名仍可用，但建议改过来 ✓）")
            continue
        }
        if _in(known, key) or _in(_window_keys, key) { continue }
        string hint = near(key, known)
        string msg = $"{who}：不认识的选项 '{key}'"
        if hint != "" { msg = msg + $" —— 你是不是想要 '{hint}'？" }
        warn_once(who, key, msg)
    }
}
