// sdl_toggle.leno — 开关（滑块式）
// 通过 win.addToggle({...}) 创建，点击切换 on/off，回调 on_change(bool)
import "sdl_renderer.leno" as ren; use ren.Renderer
import "sdl_opts.leno" as dochk    // 选项对账：不认识的键会报一行警告（见 sdl_opts.leno ✓）
import "sdl_font.leno" as fnt; use fnt.Font
import "sdl_event.leno" as evt; use evt.Event
import "sdl_core.leno" as core; use core.SystemCursor
import "sdl_widget.leno" as wgt; use wgt.Widget
import "sdl_tooltip.leno" as tip
import "sdl_theme.leno" as theme; use theme.(Theme, Themeable)
use theme.Color


// 本控件认的键 —— 由本文件全部 `.get("…")` **自动抽取**（是超集 ⇒ 可少报、不误报 ✓）
//   ⚠ 以后增删选项请重跑抽取（或人工核对），否则可能对合法用法误报 ✓
func _opts_keys(): Array[string] {
    return [
"anim", "anim_speed", "cursor", "enabled", "font_path", "font_size", "font_style", "h", "off_color", "on", "on_color", "text", "text_color", "tip", "visible", "w", "x", "y"
]
}
export struct Toggle impl Widget {
    string text = ""
    float x = 0.0, y = 0.0
    float w = 52.0, h = 28.0
    float _fontSize = 15.0
    pri string fontPath = ""
    pri int fontStyle = 0
    Font? _font
    pri bool on = false
    pri Color onColor = #3CAAF5FF
    pri Color offColor = #464652FF
    pri Color txtColor = #EBEBF5FF
    pri Color knobColor = #FFFFFFFF       // 滑块填充色
    pri Color knobBrdColor = #C8C8D2FF // 滑块边框色（浅色主题下确保可见）
    pri int cursor = SystemCursor.DEFAULT
    pri bool hover = false, wasHover = false, pressed = false, enabled = true, visible = true, _loaded = false
    string _tip = ""           // 悬停提示文本（空 = 不提示）
    pri bool animate = false
    pri float animSpeed = 12.0, animPos = 0.0, animTarget = 0.0, animLast = 0.0
    pri bool animating = false
    pri float fontH = 0.0          // 字体行高缓存（字体不变时为常量，避免每帧 measureString）
    pri func(bool):void onChange

    pri func ensure_font() {
        if _font == null or not _font.ok {
            if _font != null and _font.ok { fnt.releaseFont(_font) }
            if fontPath != "" { _font = fnt.acquireFont(fontPath, _fontSize) }
            else { _font = fnt.acquireFontAuto(_fontSize) }
            if _font.ok and fontStyle != 0 { _font.setStyle(fontStyle) }
            if _font.ok { var[float, float](_agw, _agh) = _font.measureString("Ag"); fontH = _agh }
        }
    }


    func set(Dict opts) {
        dochk.check("sdl_toggle", opts, _opts_keys())   // ★ 选项对账（2026-09-29 铺开 ✓）
        Theme th = theme.getTheme()
        onColor = th.accent
        offColor = th.bgAlt
        txtColor = th.txt
        knobColor = th.txtOnAccent
        knobBrdColor = th.border
        text      = opts.get("text", "")
        x         = opts.get("x", 0)
        y         = opts.get("y", 0)
        w         = opts.get("w", 52)
        h         = opts.get("h", 28)
        _fontSize = opts.get("font_size", 15)
        fontPath = opts.get("font_path", "")
        fontStyle = opts.get("font_style", 0)

        // 默认颜色见字段声明，以下仅 opts 覆盖

        // 颜色：opts 未传则保持默认值
        if opts.get("on_color") is Color => t { onColor = t }
        if opts.get("off_color") is Color => t { offColor = t }
        if opts.get("text_color") is Color => t { txtColor = t }

        cursor = opts.get("cursor", SystemCursor.DEFAULT)
        on = opts.get("on", false)
        enabled = opts.get("enabled", true)
        visible = opts.get("visible", true)
        // hover/_wasHover/_pressed 默认见字段声明
        _tip = opts.get("tip", "")

        // 动画选项：anim=true 开启平滑滑动动画，anim_speed 控制速度
        animate = opts.get("anim", false)
        animSpeed = opts.get("anim_speed", 12.0)
        animPos = if on then 1.0 else 0.0
        animTarget = animPos
        animLast = 0.0
        animating = false

        ensure_font()
        _loaded = true
    }

    func set_text(string t)    { text = t }
    func set_tip(string t)      { _tip = t }
    func set_on(bool o) {
        if on != o {
            on = o
            if animate {
                animTarget = if on then 1.0 else 0.0
                animating = true
                animLast = 0.0
            } else {
                animPos = if on then 1.0 else 0.0
            }
        }
    }
    func is_on(): bool          { return on }
    func get_anim_pos(): float  { return animPos }   // 滑块当前显示位置（用于观察过渡）
    func set_enabled(bool e)     { enabled = e }
    func set_visible(bool v)      { visible = v }
    func is_visible(): bool       { return visible }
    func set_font_size(float s)  { _fontSize = s; if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null }
    func get_x(): float          { return x }
    func get_y(): float          { return y }
    func get_w(): float {
        ensure_font()
        float tw = 0.0
        if _font != null and _font.ok and text != "" { var[float, float](_tw, _th) = _font.measureString(text); tw = _tw }
        return w + 10.0 + tw
    }
    func get_h(): float          { return h }
    func set_pos(float px, float py) { x = px; y = py }
    func set_size(float sw, float sh) {}

    func on_change(func(bool):void cb) { onChange = cb }

    func contains(float mx, float my): bool {
        float tw = 0.0
        if _font != null and _font.ok and text != "" { var[float, float](_tw, _th) = _font.measureString(text); tw = _tw }
        float totalW = w + 10.0 + tw
        return mx >= x and mx <= x + totalW and my >= y and my <= y + h
    }

    func process(Event ev) {
        if not _loaded { return }
        if not visible { return }
        if not enabled { hover = false; pressed = false; return }
        // 弹层捕获：事件落在“他人的弹层（如打开的菜单/下拉）范围内时忽略，避免穿透到下层控件
        var[float, float](mx, my) = ev.mousePos()
        if ev.isMouseWheel() { mx = ev.wheelMouseX(); my = ev.wheelMouseY() }
        if core.inPopupCapture(mx, my) { return }


        if ev.isMouseMotion() {
            wasHover = hover
            var[float, float](_hx, _hy) = ev.mousePos()
            hover = contains(_hx, _hy)
            if cursor >= 0 {
                if hover { core.requestCursor(cursor) }
            }
            // 悬停提示：hover 时上报；离开由 tipEndMotion 统一清除
            if hover and _tip != "" { var[float, float](_tx, _ty) = ev.mousePos(); tip.tipReport(_tip, _tx, _ty) }
        }

        if ev.isMouseButtonUp() { pressed = false }

        if ev.isMouseButtonDown() and hover and not pressed {
            pressed = true
            on = not on
            if animate {
                animTarget = if on then 1.0 else 0.0
                animating = true
                animLast = 0.0
            } else {
                animPos = if on then 1.0 else 0.0
            }
            if onChange != null { onChange(on) }
        }
    }

    // ==================== 动画步进（每帧由 render 调用） ====================
    pri func step_anim() {
        if not animating { return }
        if animSpeed <= 0.0 { animPos = animTarget; animating = false; return }  // 关闭动画：立即到位
        float now = _float(core.getTicks())
        float dt = 0.0
        if animLast > 0.0 { dt = (now - animLast) / 1000.0 }
        animLast = now
        float diff = animTarget - animPos
        float ad = diff
        if ad < 0.0 { ad = -ad }
        if ad <= 0.001 {
            animPos = animTarget
            animating = false
        } else if dt > 0.0 {
            float f = animSpeed * dt
            if f > 1.0 { f = 1.0 }
            animPos += diff * f
        }
    }

    func render(Renderer r) {
        if not _loaded { return }
        if not visible { return }
        ensure_font()
        step_anim()
        if animating { core.requestRedraw() }

        // 轨道（颜色按动画位置在 关闭色↔开启色 之间平滑过渡）
        int offR = theme.colorR(offColor); int offG = theme.colorG(offColor); int offB = theme.colorB(offColor)
        int onR  = theme.colorR(onColor);  int onG  = theme.colorG(onColor);  int onB  = theme.colorB(onColor)
        int trkR = _int(offR + animPos * (onR - offR))
        int trkG = _int(offG + animPos * (onG - offG))
        int trkB = _int(offB + animPos * (onB - offB))
        int trkA = _int(theme.colorA(offColor) + animPos * (theme.colorA(onColor) - theme.colorA(offColor)))
        if hover { trkR = trkR + 20; trkG = trkG + 20; trkB = trkB + 20
                   if trkR > 255 { trkR = 255 }; if trkG > 255 { trkG = 255 }; if trkB > 255 { trkB = 255 } }
        if not enabled { trkR = offR / 2; trkG = offG / 2; trkB = offB / 2 }
        r.setColor(theme.packColor(trkR, trkG, trkB, trkA))
        r.fillRoundedRect(x, y, w, h, h / 2.0)

        // 滑块（按动画位置在 左↔右 之间平滑滑动）
        float knob = h - 6.0
        float kxOff = x + 3.0
        float kxOn  = x + w - 3.0 - knob
        float kx = kxOff + animPos * (kxOn - kxOff)
        r.setColor(knobColor)
        r.fillRoundedRect(kx, y + 3.0, knob, knob, knob / 2.0)
        // 浅色主题下滑块可能与轨道重合，添加边框确保可见
        r.setColor(theme.withAlpha(knobBrdColor, 130))
        r.drawRoundedRect(kx, y + 3.0, knob, knob, knob / 2.0)

        // 文字
        if _font != null and _font.ok and text != "" {
            float cy = y + (h - fontH) / 2.0
            Color tc = txtColor
            if not enabled { tc = theme.packColor(theme.colorR(txtColor) / 2, theme.colorG(txtColor) / 2, theme.colorB(txtColor) / 2) }
            r.drawText(_font, text, x + w + 10.0, cy, tc)
        }
    }

    func dispose() {
        if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null
    }
}

export func createToggle(Dict opts): Toggle {
    Toggle t = new Toggle(); t.set(opts); return t
}


