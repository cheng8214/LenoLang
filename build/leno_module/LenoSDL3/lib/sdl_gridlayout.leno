// sdl_gridlayout.leno — 网格布局容器（行列排列）
//
// 对标成熟 UI 框架：
//   - Qt:     QGridLayout (简化版，不支持 row/col span)
//   - GTK:    GtkGrid
//   - WPF:    UniformGrid
//   - CSS:    display: grid; grid-template-columns: repeat(N, 1fr)
//
// 设计要点：
//   1. 固定列数（cols），子控件按添加顺序从左到右、从上到下排列
//   2. 每列等宽（可用 col_weights 不等分），每行高度取该行最高子控件
//   3. 子控件可在格子内对齐（align: 0=左上 1=居中 2=右下 3=撑满）
//   4. 支持 padding、spacing、独立的行列间距
//   5. 实现 measure_w/measure_h 供 ScrollView 自动测算内容尺寸
//
// 用法：
//   var grid = SDL3.createGridLayout({w: 600, h: 400, cols: 3, spacing: 8})
//   grid.add(SDL3.createButton({text: "A", w: 100, h: 32}))
//   grid.add(SDL3.createButton({text: "B", w: 100, h: 32}), {align: 1})
//   grid.add(SDL3.createButton({text: "C", w: 100, h: 32}), {align: 3})
//   grid.add(SDL3.createButton({text: "D", w: 100, h: 32}))
//   // A B C
//   // D _ _
import "sdl_renderer.leno" as ren; use ren.Renderer
import "sdl_opts.leno" as dochk    // 选项对账：不认识的键会报一行警告（见 sdl_opts.leno ✓）
import "sdl_event.leno" as evt; use evt.Event
import "sdl_widget.leno" as wgt; use wgt.Widget
import "sdl_edit.leno" as edt; use edt.Edit
import "sdl_layout.leno" as lay; use lay.(HBox, VBox, AnchorBox)
import "sdl_table.leno" as tbl; use tbl.Table
import "sdl_treeview.leno" as tvlib; use tvlib.TreeView
import "sdl_panel.leno" as pnl; use pnl.Panel
import "sdl_theme.leno" as theme; use theme.Theme


export struct GridLayout impl Widget {
    float x = 0.0, y = 0.0, w = 400.0, h = 300.0
    pri int cols = 2               // 列数
    // ★ 2026-10-25：`min_col_width > 0` ⇒ 列数**按宽度自适应**（见 relayout）；
    //   0 = 老行为（固定 cols，应用自己 set_cols ✓）
    pri float minColW = 0.0
    float padX = 8.0, padY = 8.0
    float spacing = 8.0         // 通用间距
    pri float colSpacing = -1.0    // 列间距（-1 = 用 spacing）
    pri float rowSpacing = -1.0    // 行间距（-1 = 用 spacing）
    pri Array[float] colWeights   // 列权重（不等分时用），为空则等分

    Array[Widget] _c = []
    Array[Dict]   _opt = []     // 每个子项的布局选项（align 等）
    Array[float]  _natW = []    // 子项添加时的自然宽度
    Array[float]  _natH = []    // 子项添加时的自然高度
    bool _loaded = false, visible = true, enabled = true
    pri bool hover = false         // ★ 2026-10-29 反哺：见 process 里的 hover 追踪
    pri Ptr[u8] hwnd


    func set(Dict opts) {
        x      = opts.get("x", 0)
        y      = opts.get("y", 0)
        w      = opts.get("w", 400)
        h      = opts.get("h", 300)
        cols  = opts.get("cols", 2)
        minColW = opts.get("min_col_width", 0.0)   // >0 ⇒ 列数随宽度自适应 ✓
        if cols < 1 { cols = 1 }
        // ★ 2026-10-13（选项命名统一）：`padX` / `padY` → **`pad_x` / `pad_y`** ✓
        //   本仓其它控件（alert / badge / drag / card…）早就用 `pad_x` / `pad_y` ⇒ 这里曾是唯一例外 ✗
        //   ⚠ **旧名已放弃**（不留别名 ✓）；注意字段名仍叫 `padX`/`padY`（那是**内部/公开字段**、
        //     不是"暴露给用户的字典名" ⇒ 不在本次统一范围内 ✓）
        padX   = opts.get("pad_x", 8)
        padY   = opts.get("pad_y", 8)
        spacing = opts.get("spacing", 8)
        colSpacing = opts.get("col_spacing", -1.0)
        rowSpacing = opts.get("row_spacing", -1.0)
        var cw = opts.get("col_weights")
        if cw is Array[float] { colWeights = cw }
        enabled = opts.get("enabled", true)
        visible = opts.get("visible", true)
        _loaded = true
    }

    // ==================== 子项管理 ====================
    func add(Widget c, Dict opts): Widget {
        if opts == null { opts = {} }
        _c.add(c); _opt.add(opts)
        _natW.add(c.get_w()); _natH.add(c.get_h())
        if hwnd != null { pass_hwnd(c, hwnd) }
        return c
    }
    func remove(Widget c) {
        for _c.len() to i { if _c[i] == c { _c.remove(i); _opt.remove(i); _natW.remove(i); _natH.remove(i); return } }
    }
    func clear() { _c = []; _opt = []; _natW = []; _natH = [] }
    func count(): int { return _c.len() }

    func _bind_window(Ptr[u8] hwnd) {
        self.hwnd = hwnd      // 形参遮蔽字段 ⇒ 必须显式 self.
        for _c to c { pass_hwnd(c, hwnd) }
    }
    pri func pass_hwnd(Widget c, Ptr[u8] hwnd) {
        lay.passWindowHandle(c, hwnd)
    }

    // ==================== 尺寸接口 ====================
    func get_w(): float { return w }
    func get_h(): float { return h }
    // ★ 2026-10-29 反哺：原只有 get_w/get_h ⇒ 上层算"网格在屏幕上的矩形"拿不到坐标，补齐 ✓
    func get_x(): float { return x }
    func get_y(): float { return y }
    func is_hover(): bool { return hover }
    func set_pos(float px, float py) { x = px; y = py }
    func set_size(float sw, float sh) { w = sw; h = sh }
    // ★ 运行时改列数（2026-10-13 补 ✓）：响应式海报墙/商品列表要按窗口宽度重排列，
    //   而 `cols` 是 pri 字段、外面设不了 ⇒ 此前只能整个 GridLayout 重建（旧卡片得重新 add ✗）。
    //   下一帧 `relayout()` 即生效（列宽、行高、measure_h 都是每帧按 `cols` 重算的 ✓）
    func set_cols(int c) { if c >= 1 { cols = c } }
    // 当前实际列数（`min_col_width` 自适应后想知道结果就调它 ✓）
    func get_cols(): int { return cols }
    func get_cols(): int { return cols }
    func set_enabled(bool e) { enabled = e }
    func set_visible(bool v) { visible = v }
    func is_visible(): bool { return visible }

    func contains(float mx, float my): bool {
        return mx >= x and mx <= x + w and my >= y and my <= y + h
    }

    // ==================== 尺寸测量 ====================
    // 按 `min_col_width` 更新列数（relayout 与 measure_* 都要先走这一步，
    //   否则"先量高度、后摆位置"两条路径会拿到不同的 cols ✗）
    pri func sync_auto_cols() {
        if minColW <= 0.0 { return }
        float cs0 = if colSpacing >= 0.0 then colSpacing else spacing
        float availW = w - 2.0 * padX
        int want = _int((availW + cs0) / (minColW + cs0))
        if want < 1 { want = 1 }
        if want != cols { cols = want }
    }

    // measure_h：行数 * 每行最大高度 + padding + 行间距
    func measure_h(): float {
        sync_auto_cols()
        if not _loaded or _c.len() == 0 { return 2.0 * padY }
        int nrows = (_c.len() + cols - 1) / cols
        float rs = if rowSpacing >= 0.0 then rowSpacing else spacing
        float total = 2.0 * padY + rs * (nrows - 1)
        for nrows to r {
            float maxH = 0.0
            int start = r * cols
            for cols to ci {
                int idx = start + ci
                if idx < _c.len() {
                    float ch = _natH[idx]
                    if ch > maxH { maxH = ch }
                }
            }
            total = total + maxH
        }
        return total
    }
    // measure_w：cols * 每列最大宽度 + padding + 列间距
    func measure_w(): float {
        if not _loaded or _c.len() == 0 { return 2.0 * padX }
        float cs = if colSpacing >= 0.0 then colSpacing else spacing
        float total = 2.0 * padX + cs * (cols - 1)
        for cols to ci {
            float maxW = 0.0
            int idx = ci
            while idx < _c.len() {
                float cw = _natW[idx]
                if cw > maxW { maxW = cw }
                idx = idx + cols
            }
            total = total + maxW
        }
        return total
    }

    // ==================== 布局计算 ====================
    pri func relayout() {
        if not _loaded { return }
        int n = _c.len()
        if n == 0 { return }
        // ★ 2026-10-25：**自适应列数**（`min_col_width`）——
        //   以前列数只能由应用自己算好再 `set_cols()`（海报墙的 sync_cols、Aria 的手工分行
        //   都是这么写的 ⇒ 每个界面各算一遍、窗口缩放还得各自监听 resize ✗）。
        //   现在：给了 `min_col_width` 就按**自身当前宽度**算列数，父布局 resize 会下发
        //   `set_size`，下一次 relayout 自动重排 ✓（应用侧只需 add + 可选 align）
        sync_auto_cols()
        int nrows = (n + cols - 1) / cols
        float cs = if colSpacing >= 0.0 then colSpacing else spacing
        float rs = if rowSpacing >= 0.0 then rowSpacing else spacing
        float innerW = w - 2.0 * padX - cs * (cols - 1)
        float innerH = h - 2.0 * padY - rs * (nrows - 1)
        if innerW < 0.0 { innerW = 0.0 }
        if innerH < 0.0 { innerH = 0.0 }

        // 计算每列宽度
        Array[float] colW = []
        float sumWeight = 0.0
        for cols to ci {
            float wt = 1.0
            if ci < colWeights.len() { wt = colWeights[ci] }
            colW.add(wt)
            sumWeight = sumWeight + wt
        }
        for cols to ci {
            colW[ci] = innerW * colW[ci] / sumWeight
        }

        // 计算每行高度（取该行最高子项）
        Array[float] rowH = []
        for nrows to r {
            float maxH = 0.0
            int start = r * cols
            for cols to ci {
                int idx = start + ci
                if idx < n {
                    float ch = _natH[idx]
                    if ch > maxH { maxH = ch }
                }
            }
            rowH.add(maxH)
        }

        // 摆放子项
        float startY = y + padY
        for nrows to r {
            float startX = x + padX
            for cols to ci {
                int idx = r * cols + ci
                if idx < n {
                    Widget c = _c[idx]
                    Dict o = _opt[idx]
                    float cw = colW[ci]
                    float ch = rowH[r]
                    int align = o.get("align", 0)
                    float ix, iy, iw, ih
                    if align == 3 {
                        // 撑满
                        ix = startX; iy = startY; iw = cw; ih = ch
                    } else {
                        // 子项自然尺寸
                        iw = _natW[idx]; ih = _natH[idx]
                        // 约束不超过格子
                        if iw > cw { iw = cw }
                        if ih > ch { ih = ch }
                        if align == 1 {
                            // 居中
                            ix = startX + (cw - iw) / 2.0
                            iy = startY + (ch - ih) / 2.0
                        } else if align == 2 {
                            // 右下
                            ix = startX + cw - iw
                            iy = startY + ch - ih
                        } else {
                            // 左上
                            ix = startX; iy = startY
                        }
                    }
                    c.set_pos(ix, iy)
                    c.set_size(iw, ih)
                }
                startX = startX + colW[ci] + cs
            }
            startY = startY + rowH[r] + rs
        }
    }

    // ==================== Widget 接口 ====================
    func process(Event ev) {
        if not _loaded or not enabled or not visible { return }
        // ★ 2026-10-29 反哺：容器类补 hover 状态（同 Panel/AnchorBox）✓
        if ev.isMouseMotion() or ev.isMouseButtonDown() or ev.isMouseButtonUp() {
            var[float, float](hmx, hmy) = ev.mousePos()
            hover = hmx >= x and hmx <= x + w and hmy >= y and hmy <= y + h
        }
        relayout()
        for _c to c { c.process(ev) }
    }
    func render(Renderer r) {
        if not _loaded or not visible { return }
        relayout()
        for _c to c { c.render(r) }
    }
    func dispose() { for _c to c { c.dispose() } }
}

// 工厂
export func createGridLayout(Dict opts): GridLayout {
    GridLayout g = new GridLayout(); g.set(opts); return g
}


