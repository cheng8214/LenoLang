// sdl_spinbox.leno — 数值微调框（SpinBox）
// 通过 win.addSpinBox({...}) 创建：左侧 Edit 编辑数值，右侧上下箭头按钮 ±step，滚轮也可调整。
// 复用 Edit 实现文本输入 / 光标 / IME / 剪贴板，SpinBox 仅负责箭头与数值约束。
import "sdl_renderer.leno" as ren; use ren.Renderer
import "sdl_opts.leno" as dochk    // 选项对账：不认识的键会报一行警告（见 sdl_opts.leno ✓）
import "sdl_event.leno" as evt; use evt.Event
import "sdl_core.leno" as core; use core.SystemCursor
import "sdl_widget.leno" as wgt; use wgt.Widget
import "sdl_tooltip.leno" as tip
import maths
import strings   // 2026-10-02：数值解析改用 `to_codepoints`（一趟取码点，替代逐字符 slice ✓）
import "sdl_edit.leno" as edt; use edt.Edit
import "sdl_theme.leno" as theme; use theme.(Theme, Themeable)
use theme.Color


// 本控件认的键 —— 由本文件全部 `.get("…")` **自动抽取**（是超集 ⇒ 可少报、不误报 ✓）
//   ⚠ 以后增删选项请重跑抽取（或人工核对），否则可能对合法用法误报 ✓
func _opts_keys(): Array[string] {
    return [
"arrow_color", "arrow_w", "bg_color", "border_color", "cursor", "decimals", "enabled", "focus_color", "font_size", "h", "int_mode", "max", "min", "placeholder", "step", "tip", "value", "visible", "w", "x", "y"
]
}
export struct SpinBox impl Widget, Themeable {
    float x = 0.0, y = 0.0, w = 140.0, h = 34.0
    pri float arrowW = 20.0            // 右侧箭头区宽度
    float minV = 0.0, maxV = 100.0, value = 0.0, step = 1.0
    pri bool intMode = false           // 整数模式（true 时显示为整数）
    pri int decimals = 2               // 浮点显示小数位
    pri Edit? edit   // 内嵌编辑框（文本输入/IME）
    pri Ptr[u8]? hwnd

    pri Color bgColor = #262830FF       // 整体背景
    pri Color bdrColor = #5A5F6EFF      // 边框色
    pri Color focusColor = #64B4FFFF     // 聚焦边框色
    pri Color arrowColor = #2C2E36FF    // 箭头区背景
    pri Color btnColor = #DCE1EBFF     // 箭头符号色

    pri bool hoverUp = false, hoverDown = false, wasUp = false, wasDown = false
    pri bool wasFocused = false
    pri int cursor = SystemCursor.POINTER
    bool enabled = true, visible = true, _loaded = false
    string _tip = ""
    pri func(float):void onChange

    // ==================== 工具 ====================

    pri func quantize(float v): float {
        if step > 0.0 { v = maths.round(v / step) * step }
        return maths.max(minV, maths.min(v, maxV))
    }
    // (2026-10-02) 这里原有 `digit(string c)`（单字符 → 0-9 的 switch）。收编 `try_apply_text`
    //   到码点解析后它**零引用** ⇒ 已删 ✓（数字 = 码点 - 48，见 try_apply_text）
    func _fmt(): string {
        if intMode { return (_int(value)) as string }
        if decimals > 0 {
            float p = 1.0
            for decimals to _ { p = p * 10.0 }
            float r = maths.round(value * p) / p
            return (r) as string
        }
        return (value) as string
    }
    pri func sync_text() {
        edit?.set_text(_fmt())
    }
    // 解析内嵌 Edit 的文本为数值（手动解析，避免依赖不确定转换）
    pri func try_apply_text() {
        if edit == null { return }
        string s = edit.get_text()
        int n = s.len()
        if n == 0 { return }
        int i = 0
        bool neg = false
        // ★ 2026-10-02 收编：原先循环里每次 `s.slice(k, k+1)` 都要从头扫到第 k 个字符
        //   ⇒ 整个解析是 **O(n²)**。改用 native `to_codepoints` 一趟取全部码点（O(n)），
        //   循环里只做 O(1) 索引，且**不再造单字符临时串** ✓
        //   等价：`codepoint_at(s,k) == to_codepoints(s)[k]`（对拍 0 分歧 ✓）；判据同为
        //   `-`=45 / `.`=46 / `0`..`9`=48..57 —— 非 ASCII 码点与原先的字符串比较同判（都落进 else ⇒ return ✓）
        Array[int] cps = strings.to_codepoints(s)
        if cps[0] == 45 { neg = true; i = 1 }
        if neg and n == 1 { return }
        bool anyDigit = false
        float intPart = 0.0; float frac = 0.0; bool hasFrac = false; float fdiv = 1.0
        for i : n - 1 to k {
            int cp = cps[k]
            if cp == 46 {
                if hasFrac { return }
                hasFrac = true
                continue
            }
            if cp >= 48 and cp <= 57 {
                anyDigit = true
                int d = cp - 48
                if hasFrac { fdiv = fdiv * 10.0; frac = frac + d / fdiv }
                else { intPart = intPart * 10.0 + d }
            } else { return }
        }
        if not anyDigit { return }
        float v = intPart + frac
        if neg { v = -v }
        if step > 0.0 { v = quantize(v) }
        value = maths.max(minV, maths.min(v, maxV))
        if onChange != null { onChange(value) }
    }
    pri func step_delta(): float { return if step > 0.0 then step else 1.0 }

    // ==================== set 初始化 ====================

    func set(Dict opts) {
        dochk.check("sdl_spinbox", opts, _opts_keys())   // ★ 选项对账（2026-09-29 铺开 ✓）
        Theme th = theme.getTheme()
        bgColor = th.bg
        bdrColor = th.border
        focusColor = th.accentFocus
        arrowColor = th.bgAlt
        btnColor = th.txtHeader
        x = opts.get("x", 0)
        y = opts.get("y", 0)
        w = opts.get("w", 140)
        h = opts.get("h", 34)
        minV = opts.get("min", 0.0)
        maxV = opts.get("max", 100.0)
        value = opts.get("value", 0.0)
        step = opts.get("step", 1.0)
        intMode = opts.get("int_mode", false)
        decimals = opts.get("decimals", 2)
        arrowW = opts.get("arrow_w", 20.0)
        if arrowW < 12.0 { arrowW = 12.0 }

        float ew = w - arrowW
        if ew < 10.0 { ew = 10.0 }
        edit = edt.createEdit({x: x, y: y, w: ew, h: h, border: false, draw_bg: false, radius: 0,
                                font_size: opts.get("font_size", 15),
                                placeholder: opts.get("placeholder", "")})
        edit.on_change(func() { try_apply_text() })

        // 颜色：opts 未传则保持默认值
        if opts.get("bg_color") is Color => t { bgColor = t }
        edit.set_bg_color(bgColor)
        edit.set_text_color(th.txtInput)
        if opts.get("border_color") is Color => t { bdrColor = t }
        if opts.get("focus_color") is Color => t { focusColor = t }

        if opts.get("arrow_color") is Color => t { arrowColor = t }
        // 默认箭头符号色见字段声明（_btnColor）

        cursor = opts.get("cursor", SystemCursor.POINTER)
        enabled = opts.get("enabled", true)
        visible = opts.get("visible", true)
        _tip = opts.get("tip", "")

        value = maths.max(minV, maths.min(value, maxV))
        sync_text()
        _loaded = true
    }

    // ==================== 布局接口 ====================
    func get_w(): float { return w }
    func get_h(): float { return h }
    func get_x(): float { return x }
    func get_y(): float { return y }
    func set_pos(float px, float py) {
        x = px; y = py
        edit?.set_pos(x, y); edit?.set_size(w - arrowW, h)
    }
    func set_size(float sw, float sh) {
        w = sw; h = sh
        edit?.set_pos(x, y); edit?.set_size(w - arrowW, h)
    }

    // ==================== 设置方法 ====================
    func set_value(float v) {
        float nv = quantize(v)
        if nv != value {
            value = nv
            sync_text()
            if onChange != null { onChange(value) }
        }
    }
    func get_value(): float { return value }
    func set_range(float lo, float hi) { minV = lo; maxV = hi; value = maths.max(minV, maths.min(value, maxV)); sync_text() }
    func set_step(float s) { step = s }
    func set_int_mode(bool m) { intMode = m; if m { decimals = 0 }; sync_text() }
    func set_decimals(int d) { decimals = d; if intMode { decimals = 0 }; sync_text() }
    func set_tip(string t) { _tip = t }
    func set_enabled(bool e) { enabled = e; edit?.set_enabled(e) }
    func set_visible(bool v) { visible = v }
    func is_visible(): bool { return visible }
    func is_enabled(): bool { return enabled }
    func get_text(): string { return edit?.get_text() ?? "" }
    func on_change(func(float):void cb) { onChange = cb }
    func _bind_window(Ptr[u8] hwnd) { self.hwnd = hwnd; edit?.set_window(hwnd) }   // 形参遮蔽字段 ⇒ 必须显式 self.

    func contains(float mx, float my): bool {
        return mx >= x and mx <= x + w and my >= y and my <= y + h
    }

    // ==================== 交互 ====================
    func process(Event ev) {
        if not _loaded or not visible or not enabled {
            hoverUp = false; hoverDown = false
            return
        }
        var[float, float](mx, my) = ev.mousePos()
        if ev.isMouseWheel() { mx = ev.wheelMouseX(); my = ev.wheelMouseY() }
        // 弹层捕获：事件落在他人弹层范围内时，跳过自身交互（滚轮/箭头），
        // 但仍转发给内嵌 Edit——Edit 可能拥有该弹层（如右键菜单），需要接收事件。
        bool inPopup = core.inPopupCapture(mx, my)

        // 其余事件转发给内嵌 Edit（箭头区在 Edit 之外，Edit 自动忽略）
        // Edit 内部自行通过 inPopupCapture 守卫，无需在此阻断
        edit?.process(ev)

        if inPopup { return }

        // 滚轮：整框内 → ±step
        if ev.isMouseWheel() {
            if not contains(ev.wheelMouseX(), ev.wheelMouseY()) { return }
            float d = ev.wheelY()
            if d == 0.0 { return }
            float delta = step_delta()
            if d > 0.0 { set_value(value + delta) } else { set_value(value - delta) }
            return
        }

        float ax = x + (w - arrowW)
        float midY = y + h / 2.0
        bool upHit = mx >= ax and mx <= x + w and my >= y and my <= midY
        bool downHit = mx >= ax and mx <= x + w and my > midY and my <= y + h

        if ev.isMouseMotion() {
            wasUp = hoverUp; wasDown = hoverDown
            hoverUp = upHit; hoverDown = downHit
            if hoverUp != wasUp or hoverDown != wasDown { core.markFrameRedraw() } else { core.markFrameMotion() }
            if (upHit or downHit) and cursor >= 0 { core.requestCursor(cursor) }
            if _tip != "" {
                if upHit or downHit { tip.tipReport(_tip, mx, my) }
            }
        }

        if ev.isMouseButtonDown() {
            float delta = step_delta()
            if upHit { set_value(value + delta) }
            else if downHit { set_value(value - delta) }
        }

        // 失焦时把文本同步为规范值
        bool f = edit?.is_focused() ?? false
        if wasFocused and not f { sync_text() }
        wasFocused = f
    }

    // ==================== 渲染 ====================
    func render(Renderer r) {
        if not _loaded or not visible { return }
        edit?.render(r)

        float ax = x + (w - arrowW)
        Color aC = arrowColor
        if hoverUp or hoverDown { aC = theme.brighten(arrowColor, 10) }
        r.setColor(aC)
        r.fillRect(ax, y, arrowW, h)

        r.setColor(bdrColor)
        r.drawLine(ax, y, ax, y + h)

        float s = 4.0
        float cxA = ax + arrowW / 2.0
        // 上箭头
        Color bC = btnColor
        if hoverUp { bC = theme.brighten(btnColor, 40) }
        r.setColor(bC)
        float uy = y + h / 4.0
        r.drawLine(cxA - s, uy + s * 0.5, cxA, uy - s * 0.5)
        r.drawLine(cxA, uy - s * 0.5, cxA + s, uy + s * 0.5)
        // 下箭头
        Color dC = btnColor
        if hoverDown { dC = theme.brighten(btnColor, 40) }
        r.setColor(dC)
        float dy = y + h * 0.75
        r.drawLine(cxA - s, dy - s * 0.5, cxA, dy + s * 0.5)
        r.drawLine(cxA, dy + s * 0.5, cxA + s, dy - s * 0.5)

        // 外边框（聚焦高亮）
        if edit != null and edit.is_focused() { r.setColor(focusColor) }
        else { r.setColor(bdrColor) }
        r.drawRect(x, y, w, h)
    }

    func dispose() {
        edit?.dispose(); edit = null
    }

    func applyTheme(Theme t) {
        bgColor = t.bg
        bdrColor = t.border
        focusColor = t.accentFocus
        arrowColor = t.bgAlt
        btnColor = t.txtHeader
        edit?.applyTheme(t)
    }
}

// 工厂
export func createSpinBox(Dict opts): SpinBox {
    SpinBox s = new SpinBox(); s.set(opts); return s
}


