// sdl_alert.leno — 提示条（Info / Warning / Danger / Success）
// win.addAlert({...}) 或 SDL3.createAlert({...})
//
// 结构：自绘的圆角底 + 描边 + 左侧色条 + **可选前置图标**，文字交给内部的 Label ✓
//   ⇒ **多行/自动折行直接可用**（Label 已支持 `\n` 与 `wrap`），不必在这里再写一套排版 ✗
//   ⇒ 高度默认按文字实际行数自适应（给了 h 则固定 ✓）
//
// `icon`：前置图标字符（如 "▲"、"●"、"◎" ✓ —— 只实测出 ■ ● ◆ ▲ ○ ◎ ※ √ × ∑ ☆ ★ → ← § 有字形，
//   其它符号会渲染成豆腐块 □ ✗）。图标会占用文字左侧的位置，折行宽度自动扣掉它 ✓
//   ⚠ 不传 icon ⇒ 与老版本逐像素一致（零影响 ✓）
//
// `kind` 预设四套浅色配色（默认 WARN）：
//   info 蓝 / warn 黄 / danger 红 / success 绿；任一项都能用 bg_color/border_color/text_color 覆盖 ✓
// ⚠ 默认配色面向**浅色界面**（深色主题请显式传色 ✓）
import "sdl_renderer.leno" as ren; use ren.Renderer
import "sdl_event.leno" as evt; use evt.Event
import "sdl_widget.leno" as wgt; use wgt.Widget
import "sdl_theme.leno" as theme; use theme.Color
import "sdl_font.leno" as fnt; use fnt.Font
import "sdl_label.leno" as lbl; use lbl.Label
import "sdl_core.leno" as core

export struct Alert impl Widget {
    const KIND_INFO    = 0
    const KIND_WARN    = 1
    const KIND_DANGER  = 2
    const KIND_SUCCESS = 3

    float x = 0.0, y = 0.0
    float _w = 320.0, _h = 0.0
    float _padX = 14.0
    float _padY = 9.0
    float _radius = 8.0
    int _kind = KIND_WARN
    bool _accent = true        // 左侧色条 ✓
    bool _autoH = true         // 高度按行数自适应（opts 给了 h ⇒ false ✓）
    float _accentW = 4.0
    float _lx = 0.0            // 文字相对本控件左上角的 x 偏移（含色条 + 图标 + 间距 ✓）
    string _icon = ""          // 前置图标字符（默认无 ⇒ 老行为 ✓）
    Font? _fI = null           // 图标字体（与正文同字号 ✓）
    Color _bg = #FFF8E1FF
    Color _bd = #F5C77EFF
    Color _ac = #B54708FF
    // ⚠ struct 字段不能用 `= new Label()` 当默认值（编译报"默认值不是常量表达式"✗）
    //   ⇒ 可空字段 + 使用前判空（同 Label 的 `Font? _font` / ComboBox 的 `_edit` ✓）
    Label? _lbl = null
    bool _loaded = false, visible = true

    // 四套预设（浅色界面）
    func _applyKind(int k) {
        _kind = k
        if k == Alert.KIND_INFO {
            _bg = #EFF6FFFF; _bd = #BFDBFEFF; _ac = #1D4ED8FF
        } else if k == Alert.KIND_WARN {
            _bg = #FFF8E1FF; _bd = #F5C77EFF; _ac = #B54708FF
        } else if k == Alert.KIND_DANGER {
            _bg = #FEF2F2FF; _bd = #FECACAFF; _ac = #B42318FF
        } else {
            _bg = #ECFDF3FF; _bd = #A6F4C5FF; _ac = #027A48FF
        }
    }
    // 左侧色条占用的横向宽度（含与文字的间距 ✓）
    func _accent_off(): float {
        if _accent { return _accentW + 6.0 }
        return 0.0
    }
    // 图标占用的横向宽度（图标实测宽 + 间距；无图标 ⇒ 0 ✓）
    //   ⚠ 用**实测宽**而不是固定值：▲ / ● / → 这类符号宽度并不相同 ✓
    func _icon_off(): float {
        if _icon == "" { return 0.0 }
        if _fI == null or not _fI.ok { return 0.0 }
        var[float, float](iw, ih) = _fI.measureString(_icon)
        return iw + 6.0
    }
    // 文字左偏移 = 内边距 +（有色条时）色条宽 +（有图标时）图标宽 + 间距 ✓
    func _calc_lx() { _lx = _padX + _accent_off() + _icon_off() }
    func _wrap_w(): float { return _w - 2.0 * _padX - _accent_off() - _icon_off() }

    func set(Dict opts) {
        _applyKind(opts.get("kind", Alert.KIND_WARN))
        x = opts.get("x", 0.0)
        y = opts.get("y", 0.0)
        _w = opts.get("w", 320.0)
        _padX = opts.get("pad_x", 14.0)
        _padY = opts.get("pad_y", 9.0)
        _radius = opts.get("radius", 8.0)
        _accent = opts.get("accent", true)
        _accentW = opts.get("accent_w", 4.0)
        if opts.get("bg_color") is Color => t { _bg = t }
        if opts.get("border_color") is Color => t { _bd = t }
        if opts.get("accent_color") is Color => t { _ac = t }
        float hOpt = opts.get("h", 0.0)
        _autoH = hOpt <= 0.0
        _h = hOpt
        Color tc = _ac
        if opts.get("text_color") is Color => t { tc = t }
        float fs = opts.get("font_size", 12.0)
        // 前置图标（可选）：**先取字体再算左偏移** —— `_icon_off()` 依赖字体实测宽 ✓
        _icon = opts.get("icon", "")
        if _icon != "" { _fI = fnt.acquireFontAuto(fs) }
        _calc_lx()
        // 折行宽度：显式 `wrap_w` > 0 用它，否则按"内容区宽 - 两侧内边距 - 色条"✓
        float bw = opts.get("wrap_w", 0.0)
        if bw <= 0.0 { bw = _wrap_w() }
        // 提示条默认**自动折行**（长文案本来就不该横着溢出去 ✓）；短文案折行不生效、零影响 ✓
        bool wrap = opts.get("wrap", true)
        _lbl = lbl.createLabel({x:x + _lx, y:y + _padY, text:opts.get("text", ""), font_size:fs,
                                text_color:tc, wrap:wrap, wrap_w:bw})
        _measure()
        visible = opts.get("visible", true)
        _loaded = true
    }

    // 高度自适应：按 Label 排完版后的实际高度 ✓（Label 多行排版会把 `_h` 写成 行数×行高 ✓）
    func _measure() {
        if _lbl == null { return }
        if _autoH { _h = _lbl.get_h() + 2.0 * _padY }
    }

    // ==================== 设置方法 ====================
    func set_text(string t) {
        if _lbl == null { return }
        _lbl.set_text(t)
        _measure()
        core.markFrameRedraw()
    }
    func set_kind(int k) {
        _applyKind(k)
        if _lbl != null { _lbl.set_text_color(_ac) }
        core.markFrameRedraw()
    }
    func set_visible(bool v) { visible = v }
    func is_visible(): bool { return visible }
    func set_enabled(bool e) {}

    // ==================== 查询方法 ====================
    func get_x(): float { return x }
    func get_y(): float { return y }
    func get_w(): float { return _w }
    func get_h(): float { return _h }
    func set_pos(float px, float py) {
        float dx = px - x
        float dy = py - y
        x = px; y = py
        if _lbl != null { _lbl.set_pos(_lbl.get_x() + dx, _lbl.get_y() + dy) }
    }
    func set_size(float sw, float sh) {
        _w = sw
        if _lbl != null {
            // 宽度变了（如被布局拉伸）⇒ 折行宽度跟着变，否则文字还按老宽度排 ✓
            _calc_lx()
            _lbl.set_wrap_w(_wrap_w())
        }
        // ⚠ 自适应模式必须**重排之后再定高**：宽度一变行数就可能变 ✗
        //   （若直接把 `_h` 钉成调用方传来的旧自然高，换行后就会文字溢出或下半留白 ✓）
        if _autoH { _measure() }
        else if sh > 0.0 { _h = sh }
    }

    // 不可点 ⇒ 不处理事件
    func process(Event ev) {}

    // ==================== 渲染 ====================
    func render(Renderer r) {
        if not _loaded or not visible { return }
        if _lbl == null { return }
        _measure()   // 文字被改过 ⇒ 每帧兜一次高度 ✓（幂等 ✓）
        r.setColor(_bg)
        r.fillRoundedRect(x, y, _w, _h, _radius)
        if _bd != 0 {
            r.setColor(_bd)
            r.drawRoundedRect(x, y, _w, _h, _radius)
        }
        // 左侧色条：与底同圆角、宽 accent_w ⇒ 视觉上是"贴边的一条"✓
        if _accent {
            r.setColor(_ac)
            r.fillRoundedRect(x, y, _accentW, _h, _radius)
        }
        // 前置图标：排在色条右侧、与首行文字顶边对齐 ✓（`_lx` 已把它的宽度算进去 ✓）
        if _icon != "" and _fI != null and _fI.ok {
            r.drawText(_fI, _icon, x + _padX + _accent_off(), y + _padY, _ac)
        }
        _lbl.set_pos(x + _lx, y + _padY)
        _lbl.render(r)
    }

    func dispose() {
        if _fI != null and _fI.ok { fnt.releaseFont(_fI) }
        _fI = null
        if _lbl == null { return }
        _lbl.dispose()
        _lbl = null
    }
}

// 工厂
export func createAlert(Dict opts): Alert {
    Alert a = new Alert(); a.set(opts); return a
}
