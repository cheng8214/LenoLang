// sdl_alert.leno — 提示条（Info / Warning / Danger / Success）
// win.addAlert({...}) 或 SDL3.createAlert({...})
//
// 结构：自绘的圆角底 + 描边 + 左侧色条 + **可选前置图标**，文字交给内部的 Label ✓
//   ⇒ **多行/自动折行直接可用**（Label 已支持 `\n` 与 `wrap`），不必在这里再写一套排版 ✗
//   ⇒ 高度默认按文字实际行数自适应（给了 h 则固定 ✓）
//
// `icon`：前置图标字符（如 "▲"、"●"、"◎" ✓ —— 只实测出 ■ ● ◆ ▲ ○ ◎ ※ √ × ∑ ☆ ★ → ← § 有字形，
//   其它符号会渲染成豆腐块 □ ✗）。图标会占用文字左侧的位置，折行宽度自动扣掉它 ✓
//   ⚠ 不传 icon ⇒ 与老版本逐像素一致（零影响 ✓）
//
// `kind` 预设四套浅色配色（默认 WARN）：
//   info 蓝 / warn 黄 / danger 红 / success 绿；任一项都能用 bg_color/border_color/text_color 覆盖 ✓
// ⚠ 默认配色面向**浅色界面**（深色主题请显式传色 ✓）
import "sdl_renderer.leno" as ren; use ren.Renderer
import "sdl_event.leno" as evt; use evt.Event
import "sdl_widget.leno" as wgt; use wgt.Widget
import "sdl_theme.leno" as theme; use theme.Color
import "sdl_font.leno" as fnt; use fnt.Font
import "sdl_label.leno" as lbl; use lbl.Label
import "sdl_opts.leno" as dochk    // 选项对账（见 sdl_opts.leno 头部的来龙去脉 ✓）
import "sdl_core.leno" as core

export struct Alert impl Widget {
    const KIND_INFO    = 0
    const KIND_WARN    = 1
    const KIND_DANGER  = 2
    const KIND_SUCCESS = 3

    float x = 0.0, y = 0.0
    float _w = 320.0, _h = 0.0
    pri float padX = 14.0
    pri float padY = 9.0
    pri float radius = 8.0
    pri int kind = KIND_WARN
    pri bool accent = true        // 左侧色条 ✓
    pri bool autoH = true         // 高度按行数自适应（opts 给了 h ⇒ false ✓）
    pri float accentW = 4.0
    pri float lx = 0.0            // 文字相对本控件左上角的 x 偏移（含色条 + 图标 + 间距 ✓）
    pri string icon = ""          // 前置图标字符（默认无 ⇒ 老行为 ✓）
    pri Font? fI = null           // 图标字体（与正文同字号 ✓）
    pri Color bg = #FFF8E1FF
    pri Color bd = #F5C77EFF
    pri Color ac = #B54708FF
    // ⚠ struct 字段不能用 `= new Label()` 当默认值（编译报"默认值不是常量表达式"✗）
    //   ⇒ 可空字段 + 使用前判空（同 Label 的 `Font? _font` / ComboBox 的 `_edit` ✓）
    Label? _lbl = null
    bool _loaded = false, visible = true

    // 四套预设（浅色界面）
    pri func applyKind(int k) {
        kind = k
        if k == Alert.KIND_INFO {
            bg = #EFF6FFFF; bd = #BFDBFEFF; ac = #1D4ED8FF
        } else if k == Alert.KIND_WARN {
            bg = #FFF8E1FF; bd = #F5C77EFF; ac = #B54708FF
        } else if k == Alert.KIND_DANGER {
            bg = #FEF2F2FF; bd = #FECACAFF; ac = #B42318FF
        } else {
            bg = #ECFDF3FF; bd = #A6F4C5FF; ac = #027A48FF
        }
    }
    // 左侧色条占用的横向宽度（含与文字的间距 ✓）
    pri func accent_off(): float {
        if accent { return accentW + 6.0 }
        return 0.0
    }
    // 图标占用的横向宽度（图标实测宽 + 间距；无图标 ⇒ 0 ✓）
    //   ⚠ 用**实测宽**而不是固定值：▲ / ● / → 这类符号宽度并不相同 ✓
    pri func icon_off(): float {
        if icon == "" { return 0.0 }
        if fI == null or not fI.ok { return 0.0 }
        var[float, float](iw, ih) = fI.measureString(icon)
        return iw + 6.0
    }
    // 文字左偏移 = 内边距 +（有色条时）色条宽 +（有图标时）图标宽 + 间距 ✓
    pri func calc_lx() { lx = padX + accent_off() + icon_off() }
    pri func wrap_w(): float { return _w - 2.0 * padX - accent_off() - icon_off() }

    // Alert 认的键（与本文件 set() 里的 opts.get 一一对应 ✓）
    pri func alert_keys(): Array[string] {
        return ["kind", "x", "y", "w", "h", "pad_x", "pad_y", "radius",
                "accent", "accent_w", "bg_color", "border_color", "accent_color",
                "text_color", "font_size", "icon", "wrap_w", "wrap", "text", "visible"]
    }

    func set(Dict opts) {
        // ★ 选项对账（2026-09-29）：不认识的键此前**静默丢弃** ✗ ⇒ 现在报一行警告 ✓
        dochk.check("Alert", opts, alert_keys())
        applyKind(opts.get("kind", Alert.KIND_WARN))
        x = opts.get("x", 0.0)
        y = opts.get("y", 0.0)
        _w = opts.get("w", 320.0)
        padX = opts.get("pad_x", 14.0)
        padY = opts.get("pad_y", 9.0)
        radius = opts.get("radius", 8.0)
        accent = opts.get("accent", true)
        accentW = opts.get("accent_w", 4.0)
        if opts.get("bg_color") is Color => t { bg = t }
        if opts.get("border_color") is Color => t { bd = t }
        if opts.get("accent_color") is Color => t { ac = t }
        float hOpt = opts.get("h", 0.0)
        autoH = hOpt <= 0.0
        _h = hOpt
        Color tc = ac
        if opts.get("text_color") is Color => t { tc = t }
        float fs = opts.get("font_size", 12.0)
        // 前置图标（可选）：**先取字体再算左偏移** —— `_icon_off()` 依赖字体实测宽 ✓
        icon = opts.get("icon", "")
        if icon != "" { fI = fnt.acquireFontAuto(fs) }
        calc_lx()
        // 折行宽度：显式 `wrap_w` > 0 用它，否则按"内容区宽 - 两侧内边距 - 色条"✓
        float bw = opts.get("wrap_w", 0.0)
        if bw <= 0.0 { bw = wrap_w() }
        // 提示条默认**自动折行**（长文案本来就不该横着溢出去 ✓）；短文案折行不生效、零影响 ✓
        bool wrap = opts.get("wrap", true)
        _lbl = lbl.createLabel({x:x + lx, y:y + padY, text:opts.get("text", ""), font_size:fs,
                                text_color:tc, wrap:wrap, wrap_w:bw})
        measure()
        visible = opts.get("visible", true)
        _loaded = true
    }

    // 高度自适应：按 Label 排完版后的实际高度 ✓（Label 多行排版会把 `_h` 写成 行数×行高 ✓）
    pri func measure() {
        if _lbl == null { return }
        if autoH { _h = _lbl.get_h() + 2.0 * padY }
    }

    // ==================== 设置方法 ====================
    func set_text(string t) {
        if _lbl == null { return }
        _lbl.set_text(t)
        measure()
        core.markFrameRedraw()
    }
    func set_kind(int k) {
        applyKind(k)
        if _lbl != null { _lbl.set_text_color(ac) }
        core.markFrameRedraw()
    }
    func set_visible(bool v) { visible = v }
    func is_visible(): bool { return visible }
    func set_enabled(bool e) {}

    // ==================== 查询方法 ====================
    func get_x(): float { return x }
    func get_y(): float { return y }
    func get_w(): float { return _w }
    func get_h(): float { return _h }
    func set_pos(float px, float py) {
        float dx = px - x
        float dy = py - y
        x = px; y = py
        if _lbl != null { _lbl.set_pos(_lbl.get_x() + dx, _lbl.get_y() + dy) }
    }
    func set_size(float sw, float sh) {
        _w = sw
        if _lbl != null {
            // 宽度变了（如被布局拉伸）⇒ 折行宽度跟着变，否则文字还按老宽度排 ✓
            calc_lx()
            _lbl.set_wrap_w(wrap_w())
        }
        // ⚠ 自适应模式必须**重排之后再定高**：宽度一变行数就可能变 ✗
        //   （若直接把 `_h` 钉成调用方传来的旧自然高，换行后就会文字溢出或下半留白 ✓）
        if autoH { measure() }
        else if sh > 0.0 { _h = sh }
    }

    // 不可点 ⇒ 不处理事件
    func process(Event ev) {}

    // ==================== 渲染 ====================
    func render(Renderer r) {
        if not _loaded or not visible { return }
        if _lbl == null { return }
        measure()   // 文字被改过 ⇒ 每帧兜一次高度 ✓（幂等 ✓）
        r.setColor(bg)
        r.fillRoundedRect(x, y, _w, _h, radius)
        if bd != 0 {
            r.setColor(bd)
            r.drawRoundedRect(x, y, _w, _h, radius)
        }
        // 左侧色条：与底同圆角、宽 accent_w ⇒ 视觉上是"贴边的一条"✓
        if accent {
            r.setColor(ac)
            r.fillRoundedRect(x, y, accentW, _h, radius)
        }
        // 前置图标：排在色条右侧、与首行文字顶边对齐 ✓（`_lx` 已把它的宽度算进去 ✓）
        if icon != "" and fI != null and fI.ok {
            r.drawText(fI, icon, x + padX + accent_off(), y + padY, ac)
        }
        _lbl.set_pos(x + lx, y + padY)
        _lbl.render(r)
    }

    func dispose() {
        if fI != null and fI.ok { fnt.releaseFont(fI) }
        fI = null
        if _lbl == null { return }
        _lbl.dispose()
        _lbl = null
    }
}

// 工厂
export func createAlert(Dict opts): Alert {
    Alert a = new Alert(); a.set(opts); return a
}
