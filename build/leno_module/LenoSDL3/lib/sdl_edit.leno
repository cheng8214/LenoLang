// sdl_edit.leno — 文本编辑控件（单行/多行 + 滚动条）
// 通过 win.addEdit({...}) 创建，run() 自动处理交互和渲染
import "sdl_renderer.leno" as ren; use ren.Renderer
import "sdl_opts.leno" as dochk    // 选项对账：不认识的键会报一行警告（见 sdl_opts.leno ✓）
import "sdl_font.leno" as fnt; use fnt.Font
import "sdl_event.leno" as evt; use evt.Event
import "sdl_core.leno" as core; use core.Scancode
use core.sdl3
import "sdl_widget.leno" as wgt; use wgt.Widget
import "sdl_tooltip.leno" as tip
import "sdl_theme.leno" as theme; use theme.(Theme, Themeable)
use theme.Color
import "sdl_menu.leno" as menu; use menu.MenuBar
import "sdl_timer.leno" as tmr; use tmr.Timer
import strings   // 2026-10-02：选词改用 `codepoint_at`（直取码点，替代逐字符 slice ✓）


// 双击选词的"词分隔标点"集合：由**同一份字面量**一次性算出码点（12 个 ASCII + 10 个全角 = 22 个）
//   ⚠ 必须是**模块级**声明：`var` 不能当 struct 字段（放进 struct 体会报「struct 字段不能使用 var ✗」实测）
var WORD_PUNCT_CP = ".,!?:;()[]\"'：。，！？（）【】；".to_codepoints()


// 本控件认的键 —— 由本文件全部 `.get("…")` **自动抽取**（是超集 ⇒ 可少报、不误报 ✓）
//   ⚠ 以后增删选项请重跑抽取（或人工核对），否则可能对合法用法误报 ✓
func _opts_keys(): Array[string] {
    return [
"bg_color", "border", "border_color", "draw_bg", "enabled", "focus_color", "font_path", "font_size", "font_style", "h", "multiline", "password", "placeholder", "radius", "readonly", "text", "text_color", "tip", "visible", "w", "wordWrap", "x", "y"
]
}
export struct Edit impl Widget, Themeable {
    // 显式初值：空串（不是 null）—— 消 [字段未初始化] 警告，且与「未输入的编辑框」
    // 语义一致（读取 text 得到 "" 而不是 null）
    string text = ""
    float x = 0.0, y = 0.0, w = 200.0, h = 30.0
    pri float radius = 4.0             // 圆角半径
bool _drawBorder = true          // 是否绘制边框（嵌入 ComboBox 时设为 false）
    pri bool drawBg = true              // 是否绘制背景（默认 true；Table 内嵌需背景遮住单元格文字）
    float _fontSize = 15.0          // 字体大小
    pri string fontPath = ""
    pri int fontStyle = 0
    Font? _font                    // 字体缓存
    pri Ptr[u8]? hwnd                   // 窗口句柄（IME 定位）
    pri Color bgColor = #232332FF             // 背景色（默认深色主题）
    pri Color txtColor = #DCDCF0FF           // 文字色（默认浅色）
    pri Color focusColor = #64B4FFFF          // 聚焦边框色
    pri Color bdrColor = 0                    // 边框色（**0 = 自动**：按背景提亮 ✓ ⇒ 默认行为不变）
    pri Color sbColor = #787D8CFF             // 滚动条颜色

    // 单行模式
    pri int cursorPos = 0               // 光标字符位置（单行）
    pri float scrollX = 0.0             // 水平滚动偏移

    // 多行模式
    pri bool multiline = false
    pri Array[string] lines = []         // 行缓存
    pri int cursorLine = 0, cursorCol = 0   // 多行光标
    pri float scrollY = 0.0              // 垂直滚动偏移
    pri float lineHeight = 20.0          // 行高缓存

    pri string placeholder = ""          // 占位文字
    pri bool focused = false
    // IME 候选框位置缓存：仅在坐标/光标变化时调用 SDL，避免每帧无谓刷新
    pri int imeX = -1, imeY = -1, imeW = -1, imeH = -1, imeCursor = -1
    pri bool mouseDown = false, draggingVScroll = false, draggingHScroll = false, hoverVScroll = false
    pri float hDragOffset = 0.0            // 横向拖动：抓取点在滑块内的偏移（避免拖动跳变）
    pri bool hDragThumb = false, hoverHScroll = false, hoverText = false
    pri int blinkTime = 0               // 光标闪烁 tick
    pri Timer? blinkTimer              // 光标闪烁定时器（500ms 间隔驱动空闲闪烁）
    pri bool showCursor = true
    pri bool password = false               // 密码模式
    pri bool readOnly = false               // 只读
    bool _loaded = false
    bool enabled = true
    bool visible = true
    string _tip = ""             // 悬停提示文本（空 = 不提示）
    pri bool dirty = true                  // 行缓存需重建
    pri bool textDirty = false              // text 需要从 _lines 重建
    pri int  cachedLen = -1              // 缓存总字符数（不含换行符）
    pri float cachedMaxW = 0.0            // 缓存最大行宽（脏时重算）

    // 撤销/重做
    pri Array[Array[string]] undoStack = []
    pri Array[Array[string]] redoStack = []
    pri Array[int] undoCursorStack = []       // 撤销光标栈：每项存 line*10000+col
    pri Array[int] redoCursorStack = []
    pri bool mergeUndo = false              // 连续输入可合并为一次撤销
    pri int  mergePos = 0               // 合并基准：上次输入结束处的光标字符位置
    int  _lastClickTime = -100000    // 上次点击 tick（双击检测）；初值足够小，避免首点误判双击
    pri float lastClickX = 0.0, lastClickY = 0.0

    // 自动换行
    pri bool wordWrap = false
    // 显示行表（自动换行时一行逻辑行拆成多显示行）：每行 [逻辑行, 段起始列, 段结束列]
    pri Array[int] drLi = []
    pri Array[int] drC0 = []
    pri Array[int] drC1 = []
    pri int drCount = 0
    pri bool drDirty = true               // 显示行表需重建
    pri float drVisW = 0.0               // 上次构建显示行表用的可视宽度
    pri bool drWrap = false                // 上次构建时的换行模式
    pri Array[int] drLStart = []        // 每逻辑行在显示行表中的起始索引
    pri Array[int] drLCnt = []          // 每逻辑行的显示行段数
    pri int dirtyLine = -1              // 仅单行内容变化时需增量重算的逻辑行（-1 表示无）
    pri Array[float] lineW = []         // 每行像素宽度缓存（增量更新）
    pri float maxLineW = 0.0             // 当前最大行宽
    pri bool lwDirty = true               // 行宽缓存需全量重算

    // 滚动条尺寸缓存（避免同一帧内重复调用 _compute_sb）
    pri Array[float] sbCache = [0.0, 0.0]   // [sbW, sbH]
    pri bool sbDirty = true                  // 滚动条尺寸需重算

    // 文本选取
    pri int  selStart = -1               // 选区起始（-1 表示无选区）
    pri int  selEnd = 0                 // 选区结束
    pri bool selActive = false              // 有活跃选区

    pri func():void onChange
    pri func():void onEnter

    // 内嵌右击上下文菜单（复制/剪切/粘贴/全选/撤销/重做），复用 MenuBar 弹层渲染与捕获
    pri MenuBar? ctxMenu
    pri int ctxMenuH = -1
    pri bool ctxMenuEnabled = true       // 是否启用右击上下文菜单
    pri int winW = 0, winH = 0       // 所属窗口逻辑宽高（上下文菜单边界夹紧用）
    pri func(string):void onCtxSelect     // 上下文菜单自定义回调（内置动作之后触发，可选）

    // ==================== 字体 ====================
    pri func ensure_font() {
        if _font == null or not _font.ok {
            if _font != null and _font.ok { fnt.releaseFont(_font) }
            if fontPath != "" {
                _font = fnt.acquireFont(fontPath, _fontSize)
            } else {
                _font = fnt.acquireFontAuto(_fontSize)
            }
            if _font.ok and fontStyle != 0 { _font.setStyle(fontStyle) }
            cachedMaxW = -1.0       // 字体变了，行宽缓存失效
            invalidate_sb()           // 字体变化，行高/行宽变化，滚动条尺寸需重算
            // 缓存行高
            if _font.ok {
                var[float, float](_agw, _agh) = _font.measureString("Ag")
                lineHeight = _agh + 2.0
            }
        }
    }

    // 单行：测量到 pos 的宽度
    pri func text_width_to(int pos): float {
        if _font == null or not _font.ok { return 0.0 }
        if pos <= 0 { return 0.0 }
        if pos > text.len() { pos = text.len() }
        var sub = text.slice(0, pos - 1)
        if password { sub = "*".rep(pos) }
        var[float, float](_msw, _msh) = _font.measureString(sub)
        return _msw
    }

    // 多行：测量某行到某列的宽度
    pri func line_width_to(int line, int col): float {
        if _font == null or not _font.ok { return 0.0 }
        rebuild_lines()
        if line < 0 { return 0.0 }
        if line >= lines.len() { return 0.0 }
        var ln = lines[line]
        if col <= 0 { return 0.0 }
        if col > ln.len() { col = ln.len() }
        var sub = ln.slice(0, col - 1)
        if password { sub = "*".rep(col) }
        var[float, float](_msw, _msh) = _font.measureString(sub)
        return _msw
    }

    // ==================== 行管理 ====================
    pri func rebuild_lines() {
        if not dirty { return }
        dirty = false
        cachedMaxW = -1.0
        drDirty = true
        lwDirty = true
        invalidate_sb()   // 文本结构变化，滚动条尺寸需重算

        // 从 text 拆分行（用 split 处理所有 \n，包括末尾换行产生的空行）
        // ★ 空文本时保持 _lines = [""] 而非 []，确保 _process_ml 等处访问 _lines[0] 不越界
        if text == "" { lines = [""]; return }
        lines = text.lines()
    }

    // 总内容高度
    pri func content_height(): float {
        rebuild_lines()
        if lines.len() == 0 { return lineHeight }
        if wordWrap {
            if drDirty or drWrap != wordWrap { ensure_layout(w - 16.0) }
            if drCount == 0 { return lineHeight }
            return lineHeight * drCount
        }
        return lineHeight * lines.len()
    }

    // ==================== 滚动 ====================
    pri func adjust_scroll() {
        if multiline {
            adjust_scroll_ml()
        } else {
            adjust_scroll_sl()
        }
    }

    pri func adjust_scroll_sl() {
        float pad = 8.0
        float visW = w - pad * 2.0
        if visW <= 0 { return }
        float curX = text_width_to(cursorPos)
        // ★ 全文宽度 ≤ 可视宽度时强制归零（避免 Edit 被 set_size 加宽后 scroll 残留导致开头被裁）
        float fullW = text_width_to(text.len())
        if fullW <= visW { scrollX = 0.0; return }
        if curX - scrollX > visW { scrollX = curX - visW + 4.0 }
        if curX - scrollX < 0 { scrollX = curX - 4.0 }
        if scrollX < 0 { scrollX = 0 }
    }

    pri func adjust_scroll_ml() {
        float pad = 8.0
        // 先用不含滚动条的宽度构建显示行表，再算滚动条，避免每帧重排
        float provVisW = w - pad * 2.0
        if provVisW <= 0 { provVisW = 1.0 }
        ensure_layout(provVisW)
        float sbW = sb_width(), sbH = sb_height(), visW = w - pad * 2.0 - sbW, visH = h - pad * 2.0 - sbH
        if visH <= 0 { return }

        // 构建显示行表并定位光标所在显示行
        if not wordWrap { ensure_layout(visW) }
        var di = disp_row_of(cursorLine, cursorCol)

        // 垂直滚动
        float curY = di * lineHeight
        if curY - scrollY > visH - lineHeight {
            scrollY = curY - visH + lineHeight
        }
        if curY - scrollY < 0 {
            scrollY = curY
        }
        if scrollY < 0 { scrollY = 0 }

        // 水平滚动（自动换行模式不横向滚动）
        if not wordWrap {
            float curX = line_width_to(cursorLine, cursorCol)
            if curX - scrollX > visW { scrollX = curX - visW + 4.0 }
            if curX - scrollX < 0 { scrollX = curX - 4.0 }
            if scrollX < 0 { scrollX = 0 }
        } else {
            scrollX = 0.0
        }

        // 限制最大滚动
        float maxSY = content_height() - visH
        if scrollY > maxSY { scrollY = maxSY }
        if maxSY < 0 { scrollY = 0 }
    }

    // ==================== set 初始化 ====================

    func set(Dict opts) {
        dochk.check("sdl_edit", opts, _opts_keys())   // ★ 选项对账（2026-09-29 铺开 ✓）
        // 主题默认配色（opts 覆盖优先级更高）
        Theme th = theme.getTheme()
        bgColor = th.bgInput
        txtColor = th.txtInput
        focusColor = th.accentFocus
        sbColor = th.sb
        text        = opts.get("text", "")
        x           = opts.get("x", 0)
        y           = opts.get("y", 0)
        w           = opts.get("w", 180)
        h           = opts.get("h", 36)
        radius     = opts.get("radius", 5)
_drawBorder = opts.get("border", true)
        drawBg = opts.get("draw_bg", true)
        _fontSize   = opts.get("font_size", 15)
        fontPath   = opts.get("font_path", "")
        fontStyle  = opts.get("font_style", 0)

        // 颜色：opts 未传则保持默认值
        if opts.get("bg_color") is Color => t { bgColor = t }
        if opts.get("text_color") is Color => t { txtColor = t }
        if opts.get("focus_color") is Color => t { focusColor = t }
        if opts.get("border_color") is Color => t { bdrColor = t }

        placeholder = opts.get("placeholder", "")
        _tip = opts.get("tip", "")

        // 模式
        multiline  = opts.get("multiline", false)
        password   = opts.get("password", false)
        readOnly   = opts.get("readonly", false)
        wordWrap   = opts.get("wordWrap", false)

        // 状态
        focused    = false
        hoverText  = false
        showCursor = true
        blinkTime  = core.getTicks()
        blinkTimer = new Timer()
        blinkTimer.set(500, func() {
            showCursor = not showCursor
            core.requestRedraw()
        })
        tmr.registerTimer(blinkTimer)
        blinkTimer.stop()    // 默认不运行，聚焦时由 focus() 启动
        cursorPos  = text.len()
        cursorLine = 0; cursorCol = 0
        scrollX    = 0.0; scrollY  = 0.0
        lines      = []
        drLi = []; drC0 = []; drC1 = []; drCount = 0
        drDirty = true; drVisW = 0.0; drWrap = wordWrap
        drLStart = []; drLCnt = []; dirtyLine = -1
        lineW = []; maxLineW = 0.0; lwDirty = true
        dirty      = true
        cachedLen  = -1
        _lastClickTime = -100000; lastClickX = 0; lastClickY = 0
        undoStack  = []; redoStack = []; undoCursorStack = []; redoCursorStack = []
        mergeUndo = false; mergePos = 0
        selStart   = -1; selEnd = 0; selActive = false

        ensure_font()
        enabled = opts.get("enabled", true)
        visible = opts.get("visible", true)
        _loaded = true

        // —— 内嵌右击上下文菜单（撤销/重做/剪切/复制/粘贴/全选）——
        ctxMenu = menu.createMenuBar({})
        ctxMenu.setWindowSize(winW, winH)
        ctxMenuH = ctxMenu.addContextMenu("edit_ctx")
        ctxMenu.addContextItem(ctxMenuH, { label: "撤销", id: "undo", shortcut: "Ctrl+Z" })
        ctxMenu.addContextItem(ctxMenuH, { label: "重做", id: "redo", shortcut: "Ctrl+Y" })
        ctxMenu.addContextSeparator(ctxMenuH)
        ctxMenu.addContextItem(ctxMenuH, { label: "剪切", id: "cut", shortcut: "Ctrl+X" })
        ctxMenu.addContextItem(ctxMenuH, { label: "复制", id: "copy", shortcut: "Ctrl+C" })
        ctxMenu.addContextItem(ctxMenuH, { label: "粘贴", id: "paste", shortcut: "Ctrl+V" })
        ctxMenu.addContextSeparator(ctxMenuH)
        ctxMenu.addContextItem(ctxMenuH, { label: "全选", id: "select_all", shortcut: "Ctrl+A" })
        ctxMenu.on_select(func(string m, string id) { ctx_action(id) })
        // 登记到全局注册表，由窗口第二遍绘制兜底画在最上层（panel 添加的 Edit 也能被覆盖）
        menu.registerContextMenu(ctxMenu)

    }

    // ==================== 设置方法 ====================
    func set_text(string t) {
        text = t; cursorPos = text.len(); cursorLine = 0; cursorCol = 0
        scrollX = 0.0   // ★ 强制归零：避免短文本替换长文本时 scroll 残留导致显示不完整
        dirty = true; invalidate_sb(); adjust_scroll()
    }
    func set_pos(float px, float py)    { x = px; y = py }
    func set_size(float sw, float sh)   { w = sw; h = sh; invalidate_sb(); adjust_scroll() }
    func get_w(): float                 { return w }
    func get_h(): float                 { return h }
    func set_bg_color(Color color)         { bgColor = color }
    func set_text_color(Color color)       { txtColor = color }
    func set_border_color(Color color)     { bdrColor = color }
    func set_font_size(float s) {
        _fontSize = s
        if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null
    }
    func set_readonly(bool ro)  { readOnly = ro }
    func set_password(bool pw)  { password = pw }
    func set_multiline(bool ml) {
        if not ml { text = get_text() }   // 切单行前 flush lines → text
        multiline = ml; dirty = true; invalidate_sb()
    }
    func set_placeholder(string p) { placeholder = p }
    func set_tip(string t) { _tip = t }
    func set_enabled(bool e) { enabled = e }
    func set_visible(bool v) { visible = v }
    func is_visible(): bool { return visible }
    func set_window(Ptr[u8] hwnd) {
        self.hwnd = hwnd                 // 形参遮蔽字段 ⇒ 必须显式 self.
        ctxMenu?.setWindowHandle(hwnd)   // 让右击菜单按窗口隔离绘制
    }
    // 设置所属窗口逻辑宽高，供上下文菜单弹出时做边界夹紧
    func set_window_size(int ww, int hh) {
        winW = ww; winH = hh
        ctxMenu?.setWindowSize(ww, hh)
    }
    // 返回内嵌上下文菜单（MenuBar），应用可经 addContextItem 等扩展菜单项
    func get_context_menu(): MenuBar { return ctxMenu }
    // 返回内嵌上下文菜单句柄（addContextMenu 返回的索引），用于扩展菜单项
    func get_context_menu_handle(): int { return ctxMenuH }
    // 启用/禁用右击上下文菜单
    func set_context_menu_enabled(bool en) { ctxMenuEnabled = en }
    func is_context_menu_enabled(): bool { return ctxMenuEnabled }
    // 检查内嵌右击上下文菜单是否处于展开状态（供 Table 等容器判断是否拦截事件）
    func isContextMenuOpen(): bool { return ctxMenu != null and ctxMenu.isOpen() }
    // 注册上下文菜单自定义回调（内置动作执行之后触发，参数为项 id）
    func on_context_select(func(string):void cb) { onCtxSelect = cb }
    func set_word_wrap(bool w)  { wordWrap = w; scrollX = 0.0; drDirty = true; invalidate_sb() }
    func focus()    { focused = true; blinkTimer?.start() }
    func blur()     { focused = false; blinkTimer?.stop() }

    // 保存当前状态到撤销栈
    pri func save_undo() {
        // 单行模式：text 是源，_lines 仅惰性同步，撤销依赖 _lines，故先同步；
        // 光标统一折成“行0 + 字符位置”，与 _undo/_redo 的 _col_to_pos 还原一致
        if not multiline {
            rebuild_lines()
            cursorLine = 0
            cursorCol = cursorPos
        }
        undoStack.add(lines.copy())
        undoCursorStack.add(cursorLine * 10000 + cursorCol)
        if undoStack.len() > 200 { undoStack.remove(0); undoCursorStack.remove(0) }
        redoStack.clear(); redoCursorStack.clear()
    }

    // Ctrl+Z
    pri func undo() {
        if undoStack.len() == 0 { return }
        // 单行模式：先把当前 text 同步进 _lines（数据源是 text，缓存可能陈旧），
        // 保证 redo 栈存的是真实当前状态；并折出正确光标。
        if not multiline {
            rebuild_lines()
            cursorLine = 0
            cursorCol = cursorPos
        }
        // 保存当前状态到 redo 栈
        redoStack.add(lines.copy())
        redoCursorStack.add(cursorLine * 10000 + cursorCol)
        // 恢复行内容
        lines = undoStack[undoStack.len() - 1]
        undoStack.remove(undoStack.len() - 1)
        // 恢复光标位置
        var cursorInfo = undoCursorStack[undoCursorStack.len() - 1]
        undoCursorStack.remove(undoCursorStack.len() - 1)
        cursorLine = cursorInfo / 10000
        cursorCol = cursorInfo % 10000
        textDirty = true; cachedLen = -1; cachedMaxW = -1; mergeUndo = false
        clear_sel()
        if lines.len() > 0 {
            if cursorLine >= lines.len() { cursorLine = lines.len() - 1 }
            if cursorLine < 0 { cursorLine = 0 }
            if cursorCol > lines[cursorLine].len() { cursorCol = lines[cursorLine].len() }
        } else { cursorLine = 0; cursorCol = 0 }
        cursorPos = col_to_pos(cursorLine, cursorCol)
        if not multiline {
            // 单行：直接由还原后的 _lines 重建 text，并禁止 get_text 再用旧 text 反写 _lines
            dirty = false
            textDirty = false
            text = lines.join("\n")
        } else {
            text = get_text()
        }
        drDirty = true; lwDirty = true; invalidate_sb()
        adjust_scroll()
    }

    // Ctrl+Y
    pri func redo() {
        if redoStack.len() == 0 { return }
        // 单行模式：先把当前 text 同步进 _lines，保证 undo 栈存的是真实当前状态
        if not multiline {
            rebuild_lines()
            cursorLine = 0
            cursorCol = cursorPos
        }
        // 保存当前状态到 undo 栈
        undoStack.add(lines.copy())
        undoCursorStack.add(cursorLine * 10000 + cursorCol)
        // 恢复行内容
        lines = redoStack[redoStack.len() - 1]
        redoStack.remove(redoStack.len() - 1)
        // 恢复光标位置
        var cursorInfo = redoCursorStack[redoCursorStack.len() - 1]
        redoCursorStack.remove(redoCursorStack.len() - 1)
        cursorLine = cursorInfo / 10000
        cursorCol = cursorInfo % 10000
        textDirty = true; cachedLen = -1; cachedMaxW = -1; mergeUndo = false
        clear_sel()
        if lines.len() > 0 {
            if cursorLine >= lines.len() { cursorLine = lines.len() - 1 }
            if cursorLine < 0 { cursorLine = 0 }
            if cursorCol > lines[cursorLine].len() { cursorCol = lines[cursorLine].len() }
        } else { cursorLine = 0; cursorCol = 0 }
        cursorPos = col_to_pos(cursorLine, cursorCol)
        if not multiline {
            // 单行：直接由还原后的 _lines 重建 text，并禁止 get_text 再用旧 text 反写 _lines
            dirty = false
            textDirty = false
            text = lines.join("\n")
        } else {
            text = get_text()
        }
        drDirty = true; lwDirty = true; invalidate_sb()
        adjust_scroll()
    }

    // ==================== 查询 ====================
    func is_focused(): bool { return focused }
    func is_loaded(): bool { return _loaded }

    // ==================== 右击上下文菜单 ====================
    // 在 (x,y) 弹出，并按当前状态刷新各项可用性
    pri func open_ctx_menu(float x, float y) {
        if ctxMenu == null { return }
        focus()
        ctxMenu.setContextItemEnabled(ctxMenuH, "undo", undoStack.len() > 0)
        ctxMenu.setContextItemEnabled(ctxMenuH, "redo", redoStack.len() > 0)
        bool hasSel = selActive and selStart >= 0 and selStart != selEnd
        ctxMenu.setContextItemEnabled(ctxMenuH, "cut", not readOnly and hasSel)
        ctxMenu.setContextItemEnabled(ctxMenuH, "copy", hasSel)
        var cbp = core.getClipboardText()
        ctxMenu.setContextItemEnabled(ctxMenuH, "paste", not readOnly and cbp != "")
        ctxMenu.openContext(ctxMenuH, x, y)
    }

    // 上下文菜单项动作分发
    pri func ctx_action(string id) {
        switch id {
            case "undo"       { undo() }
            case "redo"       { redo() }
            case "cut"        { ctx_cut() }
            case "copy"       { ctx_copy() }
            case "paste"      { ctx_paste() }
            case "select_all" { ctx_select_all() }
        }
        if onCtxSelect != null { onCtxSelect(id) }
    }

    pri func ctx_copy() {
        rebuild_lines()
        var sel = sel_text()
        if sel == "" { sel = if multiline then get_text() else text }
        if sel != "" { core.setClipboardText(sel) }
    }

    pri func ctx_cut() {
        if readOnly { return }
        rebuild_lines()
        var sel = sel_text()
        if sel == "" { return }
        core.setClipboardText(sel)
        if multiline {
            save_undo(); mergeUndo = false; del_sel_lines()
            cachedLen = -1; cachedMaxW = -1; lwDirty = true; drDirty = true
            cursorPos = col_to_pos(cursorLine, cursorCol)
            textDirty = true; invalidate_sb(); on_text_changed()
        } else {
            cursorPos = del_sel(); dirty = true; on_text_changed()
        }
    }

    pri func ctx_paste() {
        if readOnly { return }
        var paste = core.getClipboardText()
        if paste == "" { return }
        if multiline {
            rebuild_lines()
            save_undo(); mergeUndo = false; del_sel_lines()
            if lines.len() == 0 { lines.add("") }
            var left = lines[cursorLine].slice(0, cursorCol - 1)
            var right = lines[cursorLine].slice(cursorCol, (lines[cursorLine].len()) - 1)
            var full = left + paste
            var plines = full.lines()
            lines.remove(cursorLine)
            for plines.len() to pi {
                lines.insert(cursorLine + pi, plines[pi] as string)
            }
            var li = cursorLine + plines.len() - 1
            lines[li] = lines[li] + right
            cursorLine = li
            cursorCol = (plines[plines.len() - 1] as string).len()
            cachedLen = -1; cachedMaxW = -1; lwDirty = true; drDirty = true
            cursorPos = col_to_pos(cursorLine, cursorCol)
            textDirty = true; invalidate_sb(); on_text_changed()
        } else {
            paste = paste.replace("\r", "").replace("\n", " ")
            cursorPos = del_sel()
            text = text.slice(0, cursorPos - 1) + paste + text.slice(cursorPos, text.len())
            cursorPos += paste.len()
            dirty = true; on_text_changed()
        }
    }

    pri func ctx_select_all() {
        rebuild_lines()
        if multiline { selStart = 0; selEnd = get_text().len() }
        else          { selStart = 0; selEnd = text.len() }
        selActive = true
        showCursor = true; blinkTime = core.getTicks()
    }
    func get_text_length(): int {
        if cachedLen < 0 {
            rebuild_lines()
            var len = 0
            for lines.len() to li { len = len + lines[li].len() }
            if lines.len() > 1 { len = len + lines.len() - 1 }
            cachedLen = len
        }
        return cachedLen
    }
    func get_text(): string {
        if textDirty {
            rebuild_lines()
            text = lines.join("\n")
            textDirty = false
        }
        return text
    }

    // ==================== 回调 ====================
    func on_change(func():void cb) { onChange = cb }
    func on_enter(func():void cb)  { onEnter = cb }

    // ==================== 交互 ====================
    func contains(float mx, float my): bool {
        return mx >= x and mx <= x + w and my >= y and my <= y + h
    }

    // 判断鼠标是否悬停在可编辑区域（多行模式排除滚动条）
    pri func edit_hit(float mx, float my): bool {
        if not contains(mx, my) { return false }
        if multiline {
            float pad = 8.0
            float sbW = sb_width(); float sbH = sb_height()
            float visW = w - pad * 2.0 - sbW
            float visH = h - pad * 2.0 - sbH
            if sbW > 0.0 {
                float vsbX = x + w - sbW - 4.0
                if mx >= vsbX and mx <= vsbX + sbW
                   and my >= y + pad and my <= y + pad + visH { return false }
            }
            if sbH > 0.0 {
                float hsbY = y + h - sbH - 4.0
                if my >= hsbY and my <= hsbY + sbH
                   and mx >= x + pad and mx <= x + pad + visW { return false }
            }
        }
        return true
    }

    pri func update_ime() {
        // 仅在聚焦且窗口有效时更新；未聚焦时不应干涉 IME
        if not focused or hwnd == null {
            imeX = -1; imeY = -1; imeW = -1; imeH = -1; imeCursor = -1
            return
        }
        float pad = 8.0
        float cx
        int rx = 0, ry = 0, rw = 0, rh = 0
        if multiline {
            rebuild_lines()
            cx = x + pad + line_width_to(cursorLine, cursorCol) - scrollX
            rx = _int(x)
            ry = _int(y + pad + cursorLine * lineHeight - scrollY)
            rw = _int(w)
            rh = _int(lineHeight)
        } else {
            cx = x + pad + text_width_to(cursorPos) - scrollX
            rx = _int(x)
            // 单行文字垂直居中绘制，IME 矩形应只覆盖文字所在那一行
            // （与多行的「单行文字矩形」保持一致），否则候选框会落在整框下方、偏低
            float textH = lineHeight - 2.0
            ry = _int(y + (h - textH) / 2.0)
            rw = _int(w)
            rh = _int(textH)
        }
        int icur = _int(cx - x)
        // 仅在位置或光标相对上次发送有变化时才调用 SDL：
        // 1) 避免每帧无谓刷新；2) 保证滚动/布局/resize 导致坐标变化后候选框跟随。
        if rx == imeX and ry == imeY and rw == imeW and rh == imeH and icur == imeCursor { return }
        imeX = rx; imeY = ry; imeW = rw; imeH = rh; imeCursor = icur
        var rect = core.SDL_Rect.malloc()
        rect.x = rx; rect.y = ry; rect.w = rw; rect.h = rh
        core.setTextInputArea(hwnd, rect.to_ptr(), icur)
        rect.free()
    }

    // 单行：从 x 算光标位置
    pri func pos_from_x(float mx): int {
        if _font == null or not _font.ok { return 0 }
        if text.len() == 0 { return 0 }
        float relX = mx - x - 8.0 + scrollX
        if relX <= 0 { return 0 }
        var lo = 0
        var hi = text.len()
        while lo < hi {
            var mid = (lo + hi + 1) / 2
            if text_width_to(mid) <= relX { lo = mid } else { hi = mid - 1 }
        }
        return lo
    }

    // 多行：从 mx,my 算 (line, col)
    pri func pos_from_xy(float mx, float my) {
        float pad = 8.0; float sbW = sb_width()
        float visW = w - pad * 2.0 - sbW
        if wordWrap { visW = w - pad * 2.0 }   // 换行模式布局宽度与渲染一致（不含滚动条）
        float relX = mx - x - pad + scrollX
        float relY = my - y - pad + scrollY
        if relY < 0 { relY = 0 }
        rebuild_lines()
        ensure_layout(visW)
        if drCount == 0 { cursorLine = 0; cursorCol = 0; cursorPos = 0; return }

        var di = _int(relY / lineHeight)
        if di < 0 { di = 0 }
        if di >= drCount { di = drCount - 1 }

        var li = drLi[di]; var c0 = drC0[di]; var c1 = drC1[di]
        cursorLine = li

        if lines.len() == 0 { cursorCol = c0; cursorPos = col_to_pos(li, c0); return }
        if relX <= 0 { cursorCol = c0; cursorPos = col_to_pos(li, c0); return }

        // 在段 [c0, c1] 内二分查找列
        var lo = c0
        var hi = c1
        while lo < hi {
            var mid = (lo + hi + 1) / 2
            var segW = line_width_to(li, mid) - line_width_to(li, c0)
            if segW <= relX { lo = mid } else { hi = mid - 1 }
        }
        cursorCol = lo
        cursorPos = col_to_pos(li, lo)
    }

    // ==================== 滚动条尺寸 ====================
    // 一次性计算横/竖滚动条尺寸（双向耦合，用两段式避免相互递归）：
    // 竖条存在会挤占横向轨道宽度，横条存在会挤占竖向轨道高度，
    // 两者“是否出现”需互相参考对方的存在性，否则任一存在时另一个会判断错。
    // 滚动条尺寸计算结果缓存：避免同一帧内 process/render 多次调用 _compute_sb
    // （_compute_sb 内部涉及 _content_height → _ensure_layout 等重操作）。
    // 在文本/尺寸/字体/换行模式变化时通过 _invalidate_sb() 置脏，下次查询时才重算。
    pri func invalidate_sb() { sbDirty = true }

    pri func compute_sb(): Array[float] {
        if not sbDirty { return sbCache }
        sbDirty = false
        if not multiline { sbCache = [0.0, 0.0]; return sbCache }
        float contentH = content_height()
        float visH0 = h - 16.0
        float visW0 = w - 16.0
        float sbW = 0.0
        float sbH = 0.0
        if wordWrap {
            // 自动换行模式不出现横向滚动条（sbH 恒为 0），竖向轨道高度不受影响
            if contentH > visH0 { sbW = 10.0 }
        } else {
            // 第一段：先忽略对方，各自判断是否超出
            if contentH > visH0          { sbW = 10.0 }
            if max_line_width() > visW0 { sbH = 10.0 }
            // 第二段：竖条存在 → 横向轨道变窄 → 可能需横条；
            //         横条存在 → 竖向轨道变矮 → 可能需竖条
            if sbW > 0.0 and max_line_width() > visW0 - sbW { sbH = 10.0 }
            if sbH > 0.0 and contentH > visH0 - sbH           { sbW = 10.0 }
        }
        sbCache = [sbW, sbH]
        return sbCache
    }

    pri func sb_width(): float  { return compute_sb()[0] }
    pri func sb_height(): float { return compute_sb()[1] }

    pri func max_line_width(): float {
        rebuild_lines()
        if cachedMaxW >= 0.0 { return cachedMaxW }
        ensure_line_widths()
        return cachedMaxW
    }

    // 全量重算每行宽度并得出最大行宽（仅在行结构/字体变化时触发）
    pri func ensure_line_widths() {
        if not lwDirty and cachedMaxW >= 0.0 { return }
        if _font == null or not _font.ok { return }
        rebuild_lines()
        lineW = []
        maxLineW = 0.0
        for lines.len() to li {
            var[float, float](w0, _h0) = _font.measureString(lines[li])
            lineW.add(w0)
            if w0 > maxLineW { maxLineW = w0 }
        }
        lwDirty = false
        cachedMaxW = maxLineW
    }

    // 单行内容变化时的增量更新（避免每次按键全量重测所有行）
    pri func update_line_width(int li) {
        if li < 0 or li >= lines.len() { return }
        if _font == null or not _font.ok { return }
        if lineW.len() != lines.len() { lwDirty = true }
        ensure_line_widths()
        var[float, float](w0, _h0) = _font.measureString(lines[li])
        var old = lineW[li]
        lineW[li] = w0
        if w0 > maxLineW {
            maxLineW = w0; cachedMaxW = w0
        } else if old >= maxLineW - 0.5 {
            // 该行可能曾是最大值，安全起见重扫一次
            maxLineW = 0.0
            for lineW.len() to i { if lineW[i] > maxLineW { maxLineW = lineW[i] } }
            cachedMaxW = maxLineW
        }
    }

    // ==================== 事件处理 ====================
    func process(Event ev) {
        if not _loaded { return }
        if not visible { return }
        if not enabled { return }

        // 内嵌右击上下文菜单已展开：所有事件先交菜单处理（选择/关闭由菜单自身负责）
        if ctxMenuEnabled and ctxMenu != null and ctxMenu.isOpen() {
            // 菜单已展开时再次右键：编辑框内 → 移动到新位置重开；编辑框外 → 关闭。
            // 否则右键会被 MenuBar.process 静默忽略，导致“旧菜单卡在原地、必须单击关闭再右键”的别扭流程。
            if ev.isMouseButtonDown() and ev.mouseButton() == 3 {
                var[float, float](_rmx, _rmy) = ev.mousePos()
                if contains(_rmx, _rmy) {
                    open_ctx_menu(_rmx, _rmy)
                } else {
                    ctxMenu.close()
                }
                return
            }
            ctxMenu.process(ev)
            return
        }

        // 弹层捕获：光标落在“他人的下拉弹层”范围内时，本控件忽略该事件（避免穿透到下层）
        var[float, float](emx, emy) = ev.mousePos()
        if ev.isMouseWheel() { emx = ev.wheelMouseX(); emy = ev.wheelMouseY() }
        if core.inPopupCapture(emx, emy) { return }

        // 右键：在编辑框内弹出上下文菜单（复制/剪切/粘贴/全选/撤销/重做）
        if ctxMenuEnabled and ctxMenu != null and ev.isMouseButtonDown() and ev.mouseButton() == 3 {
            if contains(emx, emy) {
                open_ctx_menu(emx, emy)
                return
            }
        }

        // ---- 悬停光标：鼠标移入编辑框 → 文本(I型)光标；移出 → 默认光标 ----
        // 走集中式光标决策（requestCursor），由 Window 帧末统一 apply，避免多控件互相覆盖
        if ev.isMouseMotion() {
            bool hit = edit_hit(emx, emy)
            if hit != hoverText { core.markFrameRedraw() } else { core.markFrameMotion() }
            hoverText = hit
            if hit { core.requestCursor(core.SystemCursor.TEXT) }
            // 悬停提示：命中编辑区上报；离开由 tipEndMotion 统一清除
            if hit and _tip != "" { tip.tipReport(_tip, emx, emy) }
        }

        // ---- 鼠标滚轮（所有模式，仅当光标在本控件内才响应）----
        if ev.isMouseWheel() {
            if not contains(ev.wheelMouseX(), ev.wheelMouseY()) { return }
            if multiline {
                float sy = scrollY - ev.wheelY() * lineHeight * 3.0
                if sy < 0 { sy = 0 }
                // 可见高度需减去横向滚动条高度（sbH），否则横条存在时滚不到底
                float maxSY = content_height() - (h - 16.0 - sb_height())
                if maxSY < 0 { maxSY = 0 }
                if sy > maxSY { sy = maxSY }
                scrollY = sy
            } else {
                float sx = scrollX - ev.wheelX() * 20.0
                if sx < 0 { sx = 0 }
                scrollX = sx
            }
            return
        }

        // ---- 滚动条交互（多行模式）----
        if multiline {
            float pad = 8.0, sbW = sb_width(), sbH = sb_height(), visW = w - pad * 2.0 - sbW, visH = h - pad * 2.0 - sbH
            float contentH = content_height()

            // hover 检测
            hoverVScroll = false; hoverHScroll = false
            if sbW > 0.0 {
                float vsbX = x + w - sbW - 4.0
                if emx >= vsbX and emx <= vsbX + sbW
                   and emy >= y + pad and emy <= y + pad + visH {
                    hoverVScroll = true
                }
            }
            if sbH > 0.0 {
                float hsbY = y + h - sbH - 4.0
                if emy >= hsbY and emy <= hsbY + sbH
                   and emx >= x + pad and emx <= x + pad + visW {
                    hoverHScroll = true
                }
            }

            // 竖向拖动
            if sbW > 0.0 and ev.isMouseButtonDown() and hoverVScroll and not draggingHScroll {
                draggingVScroll = true; mouseDown = false
            }
            if draggingVScroll {
                if ev.isMouseButtonUp() { draggingVScroll = false }
                else if ev.isMouseMotion() {
                    float maxSY = contentH - visH
                    if maxSY < 0 { maxSY = 0 }
                    float thumbH = visH * visH / contentH
                    if thumbH < 20 { thumbH = 20 }
                    float relY = emy - y - pad
                    scrollY = relY * maxSY / (visH - thumbH)
                    if scrollY < 0 { scrollY = 0 }
                    if scrollY > maxSY { scrollY = maxSY }
                    core.markFrameRedraw()
                }
            }

            // 横向拖动：在横向滚动条区域内按下即开始（直接命中测试，不依赖每事件 hover 布尔，
            // 避免点击稍偏时“有时拖不动”）；抓在滑块上记录偏移，做到抓哪拖哪不跳变。
            if sbH > 0.0 {
                var maxLineW = max_line_width() + 8.0
                float maxSX = maxLineW - visW
                if maxSX < 0 { maxSX = 0 }
                float thumbW = visW * visW / maxLineW
                if thumbW < 20 { thumbW = 20 }
                float hsbY = y + h - sbH - 4.0
                float trackX0 = x + pad
                float trackX1 = x + pad + visW
                float thumbX = trackX0
                if maxSX > 0 { thumbX = trackX0 + scrollX * visW / maxLineW }
                if thumbX + thumbW > trackX1 { thumbX = trackX1 - thumbW }

                if ev.isMouseButtonDown() and not draggingVScroll {
                    bool onBar = emy >= hsbY and emy <= hsbY + sbH
                                and emx >= trackX0 and emx <= trackX1
                    if onBar {
                        draggingHScroll = true; mouseDown = false
                        if emx >= thumbX and emx <= thumbX + thumbW {
                            hDragThumb = true
                            hDragOffset = emx - thumbX
                        } else {
                            hDragThumb = false
                        }
                    }
                }
            }
            if draggingHScroll {
                if ev.isMouseButtonUp() { draggingHScroll = false }
                else if ev.isMouseMotion() {
                    var maxLineW = max_line_width() + 8.0
                    float maxSX = maxLineW - visW
                    if maxSX < 0 { maxSX = 0 }
                    float thumbW = visW * visW / maxLineW
                    if thumbW < 20 { thumbW = 20 }
                    float trackX0 = x + pad
                    float trackX1 = x + pad + visW
                    float tx
                    if hDragThumb { tx = emx - hDragOffset }
                    else { tx = emx - thumbW * 0.5 }
                    if tx < trackX0 { tx = trackX0 }
                    if tx > trackX1 - thumbW { tx = trackX1 - thumbW }
                    if maxSX <= 0 { scrollX = 0 }
                    else { scrollX = (tx - trackX0) * maxSX / (trackX1 - thumbW - trackX0) }
                    if scrollX < 0 { scrollX = 0 }
                    if scrollX > maxSX { scrollX = maxSX }
                    core.markFrameRedraw()
                }
            }
        }

        // ---- 选区 + 聚焦 ----
        if ev.isMouseButtonDown() {
            var inside = contains(emx, emy)
            if inside { focus() } else { blur() }
            if inside and not draggingVScroll and not draggingHScroll {
                // 双击检测（400ms 内，位置接近）
                var now = core.getTicks()
                var isDbl = now - _lastClickTime < 400
                        and emx >= lastClickX - 10 and emx <= lastClickX + 10
                        and emy >= lastClickY - 10 and emy <= lastClickY + 10
                _lastClickTime = now
                lastClickX = emx; lastClickY = emy
                if isDbl {
                    if multiline { pos_from_xy(emx, emy) }
                    else { cursorPos = pos_from_x(emx) }
                    select_word()
                    return
                } else {
                    mouseDown = true
                }
                if not isDbl and focused {
                    if multiline {
                        pos_from_xy(emx, emy)
                    } else {
                        cursorPos = pos_from_x(emx)
                    }
                    selStart = cursorPos; selEnd = cursorPos; selActive = false
                    adjust_scroll()
                    showCursor = true; blinkTime = core.getTicks()
                    update_ime()
                    core.markFrameRedraw()
                } else {
                    selActive = false; selStart = -1
                }
            }
        }

        // 按住拖动扩展选区
        if mouseDown and ev.isMouseMotion() and focused and not draggingVScroll and not draggingHScroll {
            // ★ 鼠标拖出编辑框时，钳制到边界继续扩展选区（避免选中一半）
            float mx = emx
            float pad = 8.0
            if mx < x + pad { mx = x + pad }
            if mx > x + w - pad { mx = x + w - pad }
            if multiline {
                float my = emy
                if my < y + pad { my = y + pad }
                if my > y + h - pad { my = y + h - pad }
                pos_from_xy(mx, my)
            } else {
                cursorPos = pos_from_x(mx)
            }
            if cursorPos != selEnd {
                selEnd = cursorPos
                selActive = true
                adjust_scroll()
                core.markFrameRedraw()
            }
        }

        if ev.isMouseButtonUp() {
            mouseDown = false
            if selStart == selEnd { selActive = false; selStart = -1 }
        }

        if not focused { return }
        if readOnly { return }

        if multiline {
            process_ml(ev)
        } else {
            process_sl(ev)
        }
    }

    // 清除选区
    pri func clear_sel() {
        selActive = false
        selStart = -1
    }

    // 双击选词
    pri func select_word() {
        if not multiline {
            // 单行模式：直接基于 text 和 _cursorPos
            if text.len() == 0 { return }
            var s = cursorPos; var e = cursorPos
            // ★ 2026-10-02 收编（4 处）：原先（旧口径，slice 不含 end）`slice(s-1, s)` / `slice(e, e+1)` 各要**从头扫**到该下标
            //   并造一个单字符临时串 ⇒ 双击选词是 O(n²)。改用 native `codepoint_at`（直接给第 k 个
            //   字符的**码点**，不分配）✓ 等价：`codepoint_at(s,k) == to_codepoints(s)[k]`（对拍 0 分歧 ✓）
            while s > 0 and is_word_char(strings.codepoint_at(text, s - 1)) { s -= 1 }
            while e < text.len() and is_word_char(strings.codepoint_at(text, e)) { e += 1 }
            if s >= e { return }
            selStart = s; selEnd = e; selActive = true
            return
        }
        rebuild_lines()
        if lines.len() == 0 or cursorLine >= lines.len() { return }
        var ln = lines[cursorLine]
        if ln.len() == 0 { return }
        var s = cursorCol; var e = cursorCol
        while s > 0 and is_word_char(strings.codepoint_at(ln, s - 1)) { s -= 1 }
        while e < ln.len() and is_word_char(strings.codepoint_at(ln, e)) { e += 1 }
        if s >= e { return }
        selStart = line_pos(cursorLine) + s
        selEnd = line_pos(cursorLine) + e
        selActive = true
    }

    // ★ 2026-10-02 收编：改收**码点**（int）而不是单字符串 —— 调用方改用 native `codepoint_at` 直取，
    //   省掉 `slice(k, k)` 的 O(n) 从头扫描与单字符临时串 ✓
    //   等价：原判据 = "空/空格/\n/\r/\t ⇒ 非词" + "在标点集合里 ⇒ 非词"；这里逐码点对齐：
    //     · 越界（`codepoint_at` 给 null）⇔ 原先的空串 ✔（`cp < 0`）
    //     · 空白与标点取自**同一份字面量**的码点（模块级 `WORD_PUNCT_CP`，22 个，实测打印核对过 ✓）
    pri func is_word_char(int cp): bool {
        if cp < 0 { return false }
        if cp == 32 or cp == 10 or cp == 13 or cp == 9 { return false }
        if WORD_PUNCT_CP.has(cp) { return false }
        return true
    }

    // 获取选中的文本
    pri func sel_text(): string {
        if not selActive or selStart < 0 { return "" }
        var s = selStart; var e = selEnd
        if s > e { var t = s; s = e; e = t }
        if s < 0 { s = 0 }
        var t = get_text()
        if e > t.len() { e = t.len() }
        if s >= e { return "" }
        return t.slice(s, e - 1)
    }

    // 删除选区并返回删除的起始位置
    pri func del_sel(): int {
        if not selActive or selStart < 0 { return cursorPos }
        var s = selStart; var e = selEnd
        if s > e { var t = s; s = e; e = t }
        if s < 0 { s = 0 }
        if e > text.len() { e = text.len() }
        if s < e { text = text.slice(0, s - 1) + text.slice(e, text.len()) }
        clear_sel()
        return s
    }

    // ---- 单行事件处理 ----
    pri func process_sl(Event ev) {
        if ev.isKeyDown() {
            int sc = ev.scancode()
            bool changed = false

            // Ctrl 组合键
            int mod = ev.keyMod()
            bool ctrl = (mod & 64) != 0 or (mod & 128) != 0
            if ctrl {
                if sc == Scancode.A {
                    selStart = 0; selEnd = text.len(); selActive = true
                    return
                }
                if sc == Scancode.C {
                    var sel = sel_text()
                    if sel != "" { core.setClipboardText(sel) }
                    else { core.setClipboardText(text) }
                    return
                }
                if sc == Scancode.X {
                    var sel = sel_text()
                    if sel != "" { core.setClipboardText(sel) }
                    else { core.setClipboardText(text) }
                    save_undo(); mergeUndo = false; cursorPos = del_sel()
                    changed = true
                }
                if sc == Scancode.V {
                    var paste = core.getClipboardText()
                    if paste != "" {
                        paste = paste.replace("\r", "").replace("\n", " ")
                        save_undo(); mergeUndo = false
                        cursorPos = del_sel()
                        text = text.slice(0, cursorPos - 1) + paste + text.slice(cursorPos, text.len())
                        cursorPos += paste.len()
                        changed = true
                    }
                }
                if sc == Scancode.Z { undo(); return }
                if sc == Scancode.Y { redo(); return }
            }

            if sc == Scancode.BACKSPACE {
                if selActive and selStart != selEnd {
                    save_undo(); mergeUndo = false
                    cursorPos = del_sel(); changed = true
                } else if cursorPos > 0 {
                    save_undo(); mergeUndo = false
                    text = text.slice(0, cursorPos - 2) + text.slice(cursorPos, text.len())
                    cursorPos -= 1; changed = true
                }
            }
            if sc == Scancode.DELETE {
                if selActive and selStart != selEnd {
                    save_undo(); mergeUndo = false
                    cursorPos = del_sel(); changed = true
                } else if cursorPos < text.len() {
                    save_undo(); mergeUndo = false
                    text = text.slice(0, cursorPos - 1) + text.slice(cursorPos + 1, text.len())
                    changed = true
                }
            }
            if sc == Scancode.LEFT  { if cursorPos > 0 { cursorPos -= 1; clear_sel() }; mergeUndo = false }
            if sc == Scancode.RIGHT { if cursorPos < text.len() { cursorPos += 1; clear_sel() }; mergeUndo = false }
            if sc == Scancode.HOME  { cursorPos = 0; clear_sel(); mergeUndo = false }
            if sc == Scancode.END   { cursorPos = text.len(); clear_sel(); mergeUndo = false }
            adjust_scroll()
            if sc == Scancode.RETURN {
                if onEnter != null { onEnter() }
            }

            if changed { dirty = true; on_text_changed() }
        }

        if ev.isTextInput() {
            var ch = ev.text()
            if ch != "" {
                cursorPos = del_sel()
                // 连续输入合并为一次撤销（与多行一致）；选区删除/光标移动则断开
                bool canMerge = mergeUndo and not selActive and cursorPos == mergePos
                if not canMerge { save_undo() }
                text = text.slice(0, cursorPos - 1) + ch + text.slice(cursorPos, text.len())
                cursorPos += ch.len()
                on_text_changed()
                dirty = true
                mergeUndo = true; mergePos = cursorPos
            }
        }
    }

    // ---- 多行事件处理（直接改 _lines，O(行长度) 非 O(全文)）----
    pri func process_ml(Event ev) {
        if ev.isKeyDown() {
            int sc = ev.scancode()
            bool moved = false; bool changed = false

            rebuild_lines()

            // Ctrl 组合键
            int mod = ev.keyMod()
            bool ctrl = (mod & 64) != 0 or (mod & 128) != 0
            if ctrl {
                if sc == Scancode.A { selStart = 0; selEnd = get_text().len(); selActive = true; return }
                if sc == Scancode.Z { undo(); return }
                if sc == Scancode.Y { redo(); return }
                if sc == Scancode.C {
                    var t = get_text()
                    var sel = sel_text()
                    if sel != "" { core.setClipboardText(sel) }
                    else { core.setClipboardText(t) }
                    return
                }
                if sc == Scancode.X {
                    var t = get_text()
                    var sel = sel_text()
                    if sel != "" { core.setClipboardText(sel) }
                    else { core.setClipboardText(t) }
                    save_undo(); mergeUndo = false; del_sel_lines(); cachedLen = -1; lwDirty = true; changed = true
                }
                if sc == Scancode.V {
                    var paste = core.getClipboardText()
                    if paste != "" {
                        save_undo(); mergeUndo = false
                        del_sel_lines()
                        if lines.len() == 0 { lines.add("") }
                        var left = lines[cursorLine].slice(0, cursorCol - 1)
                        var right = lines[cursorLine].slice(cursorCol, (lines[cursorLine].len()) - 1)
                        var full = left + paste
                        var plines = full.lines()
                        lines.remove(cursorLine)
                        for plines.len() to pi {
                            lines.insert(cursorLine + pi, plines[pi])
                        }
                        // 末行拼右侧
                        var li = cursorLine + plines.len() - 1
                        lines[li] = lines[li] + right
                        cursorLine = li
                        cursorCol = (plines[plines.len() - 1] as string).len()
                        cachedLen = -1; cachedMaxW = -1; lwDirty = true; changed = true
                    }
                }
            }

            // 退格
            if sc == Scancode.BACKSPACE {
                if selActive and selStart != selEnd {
                    save_undo(); mergeUndo = false; del_sel_lines(); cachedLen = -1; lwDirty = true; changed = true
                } else if cursorCol > 0 {
                    save_undo(); mergeUndo = false; var ln = lines[cursorLine]
                    lines[cursorLine] = ln.slice(0, cursorCol - 2) + ln.slice(cursorCol, ln.len())
                    cursorCol -= 1; cachedLen -= 1; update_line_width(cursorLine); dirtyLine = cursorLine; changed = true
                } else if cursorLine > 0 {
                    save_undo(); mergeUndo = false; cursorCol = lines[cursorLine - 1].len()
                    lines[cursorLine - 1] = lines[cursorLine - 1] + lines[cursorLine]
                    lines.remove(cursorLine)
                    cursorLine -= 1; cachedLen -= 1; cachedMaxW = -1; lwDirty = true; changed = true
                }
            }

            // Delete
            if sc == Scancode.DELETE {
                if selActive and selStart != selEnd {
                    save_undo(); mergeUndo = false; del_sel_lines(); cachedLen = -1; cachedMaxW = -1; lwDirty = true; changed = true
                } else if cursorCol < lines[cursorLine].len() {
                    save_undo(); mergeUndo = false; var ln = lines[cursorLine]
                    lines[cursorLine] = ln.slice(0, cursorCol - 1) + ln.slice(cursorCol + 1, ln.len())
                    cachedLen -= 1; update_line_width(cursorLine); dirtyLine = cursorLine; changed = true
                } else if cursorLine < lines.len() - 1 {
                    save_undo(); mergeUndo = false; lines[cursorLine] = lines[cursorLine] + lines[cursorLine + 1]
                    lines.remove(cursorLine + 1)
                    cachedLen -= 1; cachedMaxW = -1; lwDirty = true; changed = true
                }
            }

            // 方向键
            if sc == Scancode.LEFT {
                if cursorCol > 0 { cursorCol -= 1; moved = true; clear_sel() }
                else if cursorLine > 0 { cursorLine -= 1; cursorCol = lines[cursorLine].len(); moved = true; clear_sel() }
                mergeUndo = false
            }
            if sc == Scancode.RIGHT {
                if cursorCol < lines[cursorLine].len() { cursorCol += 1; moved = true; clear_sel() }
                else if cursorLine < lines.len() - 1 { cursorLine += 1; cursorCol = 0; moved = true; clear_sel() }
                mergeUndo = false
            }
            if sc == Scancode.UP     { move_up(); moved = true; clear_sel(); mergeUndo = false }
            if sc == Scancode.DOWN   { move_down(); moved = true; clear_sel(); mergeUndo = false }
            if sc == Scancode.HOME   { cursorCol = 0; moved = true; clear_sel(); mergeUndo = false }
            if sc == Scancode.END    { cursorCol = lines[cursorLine].len(); moved = true; clear_sel(); mergeUndo = false }

            // 回车
            if sc == Scancode.RETURN {
                save_undo(); mergeUndo = false; var ln = lines[cursorLine]
                var rest = ln.slice(cursorCol, ln.len())
                lines[cursorLine] = ln.slice(0, cursorCol - 1)
                lines.insert(cursorLine + 1, rest)
                cursorLine += 1; cursorCol = 0; cachedLen += 1; cachedMaxW = -1; lwDirty = true; changed = true
            }

            if cursorLine >= lines.len() { cursorLine = lines.len() - 1 }
            if cursorLine < 0 { cursorLine = 0 }

            if changed {
                if dirtyLine < 0 { drDirty = true }
                cursorPos = col_to_pos(cursorLine, cursorCol)
                textDirty = true
                invalidate_sb()   // 文本变化 → 内容高度/宽度可能变 → 滚动条尺寸需重算
                adjust_scroll()
                showCursor = true; blinkTime = core.getTicks()
                update_ime()
                if onChange != null { onChange() }
            } else if moved {
                cursorPos = col_to_pos(cursorLine, cursorCol)
                adjust_scroll()
                showCursor = true; blinkTime = core.getTicks()
                update_ime()
            }
        }

        // 文本输入
        if ev.isTextInput() {
            var ch = ev.text()
            if ch != "" {
                rebuild_lines()
                // 连续输入合并撤销：仅当上次也是文本输入、无选区删除、且光标紧接上次结束位置
                bool canMerge = mergeUndo and not selActive and cursorPos == mergePos
                if not canMerge { save_undo() }
                del_sel_lines()
                if lines.len() == 0 { lines.add("") }
                var ln = lines[cursorLine]
                lines[cursorLine] = ln.slice(0, cursorCol - 1) + ch + ln.slice(cursorCol, ln.len())
                cursorCol += ch.len()
                cachedLen = -1; update_line_width(cursorLine)
                dirtyLine = cursorLine
                cursorPos = col_to_pos(cursorLine, cursorCol)
                textDirty = true
                invalidate_sb()   // 文本变化 → 内容高度/宽度可能变 → 滚动条尺寸需重算
                adjust_scroll()
                showCursor = true; blinkTime = core.getTicks()
                update_ime()
                if onChange != null { onChange() }
                mergeUndo = true; mergePos = cursorPos
            }
        }
    }

    // 计算某行在全文中的起始字节位置
    pri func line_pos(int line): int {
        return col_to_pos(line, 0)
    }

    // 总字符数（用于 Ctrl+A）
    pri func line_count_pos(): int {
        rebuild_lines()
        var pos = 0
        for lines.len() to li { pos = pos + lines[li].len() + 1 }
        if pos > 0 { pos -= 1 }    // 去掉最后一个 \n
        return pos
    }

    // 删除选区(行级别)
    pri func del_sel_lines() {
        if not selActive or selStart < 0 { return }
        var s = selStart; var e = selEnd
        if s > e { var t = s; s = e; e = t }
        if s < 0 { s = 0 }
        if s >= e { clear_sel(); return }
        // 转换为行列
        var cs = pos_to_col(s)
        var ce = pos_to_col(e)
        var ls = pos_to_line(s)
        var le = pos_to_line(e)
        if ls < 0 or le < 0 or ls >= lines.len() or le >= lines.len() { clear_sel(); return }
        // 删除选区
        if ls == le {
            var ln = lines[ls]
            lines[ls] = ln.slice(0, cs - 1) + ln.slice(ce, ln.len())
        } else {
            lines[ls] = lines[ls].slice(0, cs - 1) + lines[le].slice(ce, (lines[le].len()) - 1)
            var cnt = le - ls
            for cnt to _ { lines.remove(ls + 1) }
        }
        cursorLine = ls; cursorCol = cs
        clear_sel()
    }

    pri func pos_to_line(int pos): int {
        var p = 0
        for lines.len() to li {
            var len = lines[li].len() + 1
            if pos < p + len { return li }
            p += len
        }
        return lines.len() - 1
    }

    pri func pos_to_col(int pos): int {
        var p = 0
        for lines.len() to li {
            var len = lines[li].len() + 1
            if pos < p + len {
                var col = pos - p
                if col > lines[li].len() { col = lines[li].len() }
                return col
            }
            p += len
        }
        return lines[lines.len() - 1].len()
    }

    // ---- 多行方向键辅助（基于 _cursorPos）----
    pri func move_up() {
        sync_line_col()
        rebuild_lines()
        float visW = w - 16.0 - sb_width()
        if wordWrap { visW = w - 16.0 }
        ensure_layout(visW)
        var di = disp_row_of(cursorLine, cursorCol)
        if di > 0 {
            // 在同一逻辑行内的上一显示行，或上一逻辑行的末显示行
            var pli = drLi[di - 1]; var pc0 = drC0[di - 1]; var pc1 = drC1[di - 1]
            var off = cursorCol - drC0[di]
            if off < 0 { off = 0 }
            var ncol = pc0 + off
            if ncol > pc1 { ncol = pc1 }
            cursorLine = pli; cursorCol = ncol
            cursorPos = col_to_pos(cursorLine, cursorCol)
        } else if cursorLine > 0 {
            cursorLine -= 1
            if cursorCol > lines[cursorLine].len() { cursorCol = lines[cursorLine].len() }
            cursorPos = col_to_pos(cursorLine, cursorCol)
            adjust_scroll()
        }
    }

    pri func move_down() {
        sync_line_col()
        rebuild_lines()
        float visW = w - 16.0 - sb_width()
        if wordWrap { visW = w - 16.0 }
        ensure_layout(visW)
        var di = disp_row_of(cursorLine, cursorCol)
        if di < drCount - 1 {
            var nli = drLi[di + 1]; var nc0 = drC0[di + 1]; var nc1 = drC1[di + 1]
            var off = cursorCol - drC0[di]
            if off < 0 { off = 0 }
            var ncol = nc0 + off
            if ncol > nc1 { ncol = nc1 }
            cursorLine = nli; cursorCol = ncol
            cursorPos = col_to_pos(cursorLine, cursorCol)
        } else if cursorLine < lines.len() - 1 {
            cursorLine += 1
            if cursorCol > lines[cursorLine].len() { cursorCol = lines[cursorLine].len() }
            cursorPos = col_to_pos(cursorLine, cursorCol)
            adjust_scroll()
        }
    }

    pri func move_home() {
        sync_line_col()
        cursorCol = 0
        cursorPos = col_to_pos(cursorLine, 0)
    }

    pri func move_end() {
        sync_line_col()
        rebuild_lines()
        cursorCol = lines[cursorLine].len()
        cursorPos = col_to_pos(cursorLine, cursorCol)
    }

    // 从 _cursorPos 同步 _cursorLine / _cursorCol
    pri func sync_line_col() {
        rebuild_lines()
        var pos = 0
        cursorLine = 0; cursorCol = 0
        for lines.len() to li {
            var len = lines[li].len() + 1   // +1 for \n
            if cursorPos < pos + len {
                cursorLine = li
                cursorCol = cursorPos - pos
                if cursorCol > lines[li].len() { cursorCol = lines[li].len() }
                return
            }
            pos = pos + len
        }
        // 光标在末尾
        if lines.len() > 0 {
            cursorLine = lines.len() - 1
            cursorCol = lines[cursorLine].len()
        }
    }

    // 根据 line/col 计算 _cursorPos
    pri func col_to_pos(int line, int col): int {
        if lines.len() == 0 { return 0 }
        var pos = 0
        var end = line
        if end > lines.len() { end = lines.len() }
        if end > 0 {
            for 0 : end - 1 to i {
                pos = pos + lines[i].len() + 1
            }
        }
        if line < lines.len() {
            var c = col
            if c > lines[line].len() { c = lines[line].len() }
            pos = pos + c
        }
        return pos
    }

    // 数组中指定位置插入元素
    pri func on_text_changed() {
        adjust_scroll()
        showCursor = true
        blinkTime = core.getTicks()
        update_ime()
        if onChange != null { onChange() }
    }

    // ==================== 渲染 ====================
    func render(Renderer r) {
        if not _loaded { return }
        if not visible { return }
        // 聚焦时每帧用当前绝对坐标刷新 IME 候选框位置。
        // 容器(ScrollView/VBox/Panel 等)会动态设置 edit 的绝对坐标，
        // render 阶段的坐标是最终权威值，可修正“容器内 IME 位置不对”的问题。
        if focused { update_ime() }
        ensure_font()
        if not _font.ok { return }

        // 背景（由 draw_bg 选项控制：ComboBox/SpinBox 嵌入时可关闭，Table 内嵌时开启以遮住单元格文字）
        if drawBg {
            r.setColor(bgColor)
            r.fillRoundedRect(x, y, w, h, radius)
        }

        // 边框（由 border 选项控制是否绘制）
        // `border_color` 显式给定则用它（默认 0 = 走老行为：按背景提亮 X）—— 老行为在**浅色底**上
        // 会算成"更白" ⇒ 白底输入框的边框等于看不见 ✗（浅色界面必须有可指定的描边 ✓）
        if _drawBorder {
            if focused and bdrColor == 0 { r.setColor(focusColor) }
            else if bdrColor != 0 { r.setColor(bdrColor) }
            else { r.setColor(theme.brighten(bgColor, 40)) }
            r.drawRoundedRect(x, y, w, h, radius)
        }

        if multiline {
            render_ml(r)
        } else {
            render_sl(r)
        }
    }

    // ---- 单行渲染 ----
    pri func render_sl(Renderer r) {
        _font.setSSAA(r.getSSAA())   // 让 measureString 与 SSAA 绘制宽度一致，光标/选区对齐且不变形
        float pad = 8.0
        // 裁剪
        var clip = core.SDL_Rect.malloc()
        clip.x = _int(x + pad); clip.y = _int(y)
        clip.w = _int(w - pad * 2.0) + 1; clip.h = _int(h) + 1   // +1 覆盖浮点截断的亚像素
        r.pushClipRect(clip.to_ptr())

        // 文字几何（先算，供选区/光标对齐）
        // ★ 复用 _ensure_font 中缓存的 _lineHeight（= _agh + 2.0），避免每帧 measureString
        float textH = lineHeight - 2.0
        float ty = y + (h - textH) / 2.0
        var display = text
        if password and text != "" { display = "*".rep(text.len()) }
        if text != "" {
            var[float, float](_dw, _dh) = _font.measureString(display)
            textH = _dh
            ty = y + (h - textH) / 2.0
        }

        // 选区高亮（画在文字【后面】，文字再叠上去仍可见）
        if selActive and selStart >= 0 and selStart != selEnd and text != "" {
            var ss = selStart; var se = selEnd
            if ss > se { var t = ss; ss = se; se = t }
            if ss < 0 { ss = 0 }
            if se > text.len() { se = text.len() }
            float sx = r.snapX(x + pad + text_width_to(ss) - scrollX)
            float ex = r.snapX(x + pad + text_width_to(se) - scrollX)
            float rx = sx; float rw = ex - sx
            if rw < 0 { rx = ex; rw = -rw }
            r.setColor(#3C64B4B4)
            r.fillRect(rx, r.snapY(ty), rw, textH)
        }

        // 文字（叠在选区之上）
        if text == "" and not focused and placeholder != "" {
            var[float, float](_pw, _ph) = _font.measureString(placeholder)
            float py = y + (h - _ph) / 2.0
            r.drawText(_font, placeholder, r.snapX(x + pad), r.snapY(py),
                       theme.darken(txtColor, 80))
        } else if text != "" {
            r.drawText(_font, display, r.snapX(x + pad - scrollX), r.snapY(ty), txtColor)
        }

        // 光标（与文字同高、垂直对齐；画在裁剪区域内，与 _render_ml 行为一致，
        // 避免在容器嵌套（Panel/VBox/HBox 内嵌 Table 含 Edit）时光标溢出到右下角）
        if focused and showCursor {
            float cx = r.snapX(x + pad + text_width_to(cursorPos) - scrollX)
            if cx < x + pad { cx = x + pad }
            if cx > x + w - pad { cx = x + w - pad }
            r.setColor(theme.withAlpha(txtColor, 200))
            r.drawLine(cx, r.snapY(ty), cx, r.snapY(ty + textH))
        }

        r.popClipRect(); clip.free()
    }

    // ---- 多行渲染 ----
    pri func render_ml(Renderer r) {
        _font.setSSAA(r.getSSAA())   // 让 measureString 与 SSAA 绘制宽度一致，光标/选区对齐且不变形
        rebuild_lines()
        sync_line_col()                // 进入渲染时统一同步行列
        float pad = 8.0
        // 先用不含滚动条的宽度构建显示行表（仅脏时重建），再算滚动条
        float provVisW = w - pad * 2.0
        if provVisW <= 0 { provVisW = 1.0 }
        ensure_layout(provVisW)
        float sbW = sb_width(), sbH = sb_height(), visW = w - pad * 2.0 - sbW, visH = h - pad * 2.0 - sbH
        if visW <= 0 { visW = 1.0 }
        if visH <= 0 { visH = 1.0 }
        if not wordWrap { ensure_layout(visW) }


        // 裁剪区域
        var clip = core.SDL_Rect.malloc()
        clip.x = _int(x + pad); clip.y = _int(y + pad)
        clip.w = _int(visW) + 1; clip.h = _int(visH) + 1   // +1 覆盖浮点截断的亚像素
        r.pushClipRect(clip.to_ptr())

        // 计算可见行范围（选区和文本渲染共用）
        var firstLine = _int(scrollY / lineHeight)
        var lastLineV = firstLine + _int(visH / lineHeight) + 2
        if lastLineV > drCount { lastLineV = drCount }
        if firstLine < 0 { firstLine = 0 }

        // ---- 选区高亮（画在文字后面）----
        if selActive and selStart >= 0 and selStart != selEnd and lines.len() > 0 {
            var ss = selStart; var se = selEnd
            if ss > se { var t = ss; ss = se; se = t }
            for firstLine : lastLineV - 1 to di {
                if di >= drCount { break }
                var li = drLi[di]; var c0 = drC0[di]; var c1 = drC1[di]
                var segStart = line_pos(li) + c0
                var segEnd = line_pos(li) + c1
                var selS = ss; var selE = se
                if selS > segEnd { continue }
                if selE < segStart { continue }
                if selS < segStart { selS = segStart }
                if selE > segEnd { selE = segEnd }
                if selS >= selE { continue }
                var colS = selS - segStart
                var colE = selE - segStart
                var full = lines[li]
                var[float, float](ms1w, ms1h) = _font.measureString(full.slice(c0, (c0 + colS) - 1))
                var[float, float](ms2w, ms2h) = _font.measureString(full.slice(c0, (c0 + colE) - 1))
                float sx = r.snapX(x + pad + ms1w - scrollX), ew = ms2w - ms1w, sy = r.snapY(y + pad + di * lineHeight - scrollY)
                if ew < 0 { ew = 0 }
                r.setColor(#3C64B4B4)
                r.fillRect(sx, sy, ew, lineHeight)
            }
        }

        // 占位文字 / 内容
        if lines.len() == 0 and not focused and placeholder != "" {
            var phLines = placeholder.split("\n")
            var dy = 0
            for phLines.len() to pl {
                var seg = phLines[pl]
                var wraps = wrap_line(seg, visW)
                for wraps.len() to wi {
                    float ly = y + pad + dy * lineHeight - scrollY
                    r.drawText(_font, wraps[wi], r.snapX(x + pad), r.snapY(ly), theme.darken(txtColor, 80))
                    dy += 1
                }
            }
        } else if lines.len() > 0 {
            for firstLine : lastLineV - 1 to di {
                if di >= drCount { break }
                var li = drLi[di]; var c0 = drC0[di]; var c1 = drC1[di]
                var seg = lines[li].slice(c0, c1 - 1)
                if password { seg = "*".rep(seg.len()) }
                float ly = y + pad + di * lineHeight - scrollY
                r.drawText(_font, seg, r.snapX(x + pad - scrollX), r.snapY(ly), txtColor)
            }
        }

        // 光标（在裁剪区域内）
        cursorPos = col_to_pos(cursorLine, cursorCol)
        if focused and showCursor {
            if lines.len() > 0 and drCount > 0 {
                var cdi = disp_row_of(cursorLine, cursorCol)
                float cy = r.snapY(y + pad + cdi * lineHeight - scrollY)
                if cy + lineHeight > y + pad and cy < y + pad + visH {
                    // ★ 复用 _lineHeight（= _agh + 2.0），避免每帧 measureString
                    float ch = lineHeight - 2.0
                    float cx = x + pad
                    if wordWrap {
                        // 直接测量段内子串（ln.slice(c0, col)）作为段内偏移，
                        // 不能用 整行slice - 整行slice(c0) 相减：跨段边界的字偶距
                        // 不计入，会随换行段数累积误差导致光标错位。
                        var cm0 = 0
                        if cdi >= 0 and cdi < drC0.len() { cm0 = drC0[cdi] }
                        if cursorCol < cm0 { cm0 = cursorCol }
                        var ln = lines[cursorLine]
                        var seg = ln.slice(cm0, cursorCol - 1)
                        var[float, float](_segw, _segh) = _font.measureString(seg); cx = cx + _segw - scrollX
                    } else {
                        cx = cx + line_width_to(cursorLine, cursorCol) - scrollX
                    }
                    cx = r.snapX(cx)
                    r.setColor(theme.withAlpha(txtColor, 200))
                    r.drawLine(cx, cy, cx, cy + ch)
                }
            } else {
                // 空内容：光标固定在左上角
                float cy = r.snapY(y + pad)
                // ★ 复用 _lineHeight（= _agh + 2.0），避免每帧 measureString
                float ch = lineHeight - 2.0
                float cx = r.snapX(x + pad)
                r.setColor(theme.withAlpha(txtColor, 200))
                r.drawLine(cx, cy, cx, cy + ch)
            }
        }

        r.popClipRect(); clip.free()

        // ---- 竖向滚动条 ----
        if sbW > 0.0 {
            float sbX = x + w - sbW - 4.0
            float contentH = content_height()

            r.setColor(theme.withAlpha(sbColor, 180))
            r.fillRoundedRect(sbX, y + pad, sbW, visH, sbW / 2.0)

            float thumbH = visH * visH / contentH
            if thumbH < 20 { thumbH = 20 }
            float maxSY = contentH - visH
            float thumbY = y + pad
            if maxSY > 0 { thumbY = y + pad + scrollY * visH / contentH }
            if thumbY + thumbH > y + pad + visH { thumbY = y + pad + visH - thumbH }

            if hoverVScroll or draggingVScroll {
                r.setColor(theme.brighten(sbColor, 40))
            } else {
                r.setColor(theme.withAlpha(sbColor, 220))
            }
            r.fillRoundedRect(sbX, thumbY, sbW, thumbH, sbW / 2.0)
        }

        // ---- 横向滚动条 ----
        if sbH > 0.0 {
            float sbY = y + h - sbH - 4.0
            float maxLineW = max_line_width() + 8.0

            r.setColor(theme.withAlpha(sbColor, 180))
            r.fillRoundedRect(x + pad, sbY, visW, sbH, sbH / 2.0)

            float thumbW = visW * visW / maxLineW
            if thumbW < 20 { thumbW = 20 }
            float maxSX = maxLineW - visW
            if maxSX < 0 { maxSX = 0 }
            float thumbX = x + pad
            if maxSX > 0 { thumbX = x + pad + scrollX * visW / maxLineW }
            if thumbX + thumbW > x + pad + visW { thumbX = x + pad + visW - thumbW }

            if hoverHScroll or draggingHScroll {
                r.setColor(theme.brighten(sbColor, 40))
            } else {
                r.setColor(theme.withAlpha(sbColor, 220))
            }
            r.fillRoundedRect(thumbX, sbY, thumbW, sbH, sbH / 2.0)
        }

        // ---- 滚动条交叉角落 ----
        if sbW > 0.0 and sbH > 0.0 {
            float cornerX = x + w - sbW - 4.0
            float cornerY = y + h - sbH - 4.0
            r.setColor(theme.withAlpha(sbColor, 200))
            r.fillRoundedRect(cornerX, cornerY, sbW, sbH, sbW / 2.0)
        }
    }

    // 按像素宽度拆分一行（逐字符累加宽度，O(n) 而非 O(n^2)）
    pri func wrap_line(string ln, float maxW): Array[string] {
        var result = []
        if ln == "" { result.add(""); return result }
        var n = ln.len()
        var segStart = 0
        var curW = 0.0
        // ★ 2026-10-02 收编：原先是逐字符（旧口径，slice 不含 end）`ln.slice(i, i+1)` —— 每轮都要**从头扫**到第 i 个字符
        //   （整段 O(n²)）且每字符造一个临时串。这里改成一趟 `to_codepoints`（O(n)）取全部码点，
        //   循环里用 `from_codepoint` 还原出单字符字符串喂 measureString ⇒ 全线 O(n) ✓
        //   等价：`from_codepoint(to_codepoints(s)[k]) == s.slice(k, k)`（对拍 0 分歧 ✓）
        Array[int] cps = strings.to_codepoints(ln)
        for :n to i {
            var ch = strings.from_codepoint(cps[i])
            var[float, float](cw, _ch) = _font.measureString(ch)
            if curW + cw > maxW and i > segStart {
                result.add(ln.slice(segStart, i - 1))
                segStart = i
                curW = cw
            } else {
                curW = curW + cw
            }
        }
        if segStart < n { result.add(ln.slice(segStart, n - 1)) }
        return result
    }

    // 仅在行表脏（内容/字体/换行模式/可视宽度变化）时全量重建，避免每帧重排全文；
    // 否则若仅单行内容变化则增量重算该行（O(该行) 而非 O(全文)）
    pri func ensure_layout(float visW): int {
        if drDirty or drWrap != wordWrap or (wordWrap and drVisW != visW) {
            build_display_rows(visW)
            drVisW = visW
            drWrap = wordWrap
            drDirty = false
            dirtyLine = -1
        } else if dirtyLine >= 0 {
            rebuild_line_segment(dirtyLine, visW)
            dirtyLine = -1
        }
        return drCount
    }

    // 仅重算单个逻辑行的显示行段（增量），代价 O(该行长度) 而非 O(全文)
    pri func rebuild_line_segment(int li, float visW) {
        if drLStart.len() != lines.len() or li < 0 or li >= lines.len() or visW != drVisW {
            build_display_rows(visW); drVisW = visW; drWrap = wordWrap
            drDirty = false; dirtyLine = -1; return
        }
        int pos = drLStart[li]
        int oldCnt = drLCnt[li]
        Array[int] nc0 = []; Array[int] nc1 = []
        var ln = lines[li]
        if not wordWrap {
            nc0.add(0); nc1.add(ln.len())
        } else {
            var wl = wrap_line(ln, visW)
            var col0 = 0
            for wl.len() to wi {
                var segLen = (wl[wi]).len()
                nc0.add(col0); nc1.add(col0 + segLen); col0 = col0 + segLen
            }
            if wl.len() == 0 { nc0.add(0); nc1.add(0) }
        }
        int newCnt = nc0.len()
        // 删除旧段
        for oldCnt to k { drLi.remove(pos); drC0.remove(pos); drC1.remove(pos) }
        // 插入新段
        for newCnt to s {
            drLi.insert(pos + s, li)
            drC0.insert(pos + s, nc0[s])
            drC1.insert(pos + s, nc1[s])
        }
        int delta = newCnt - oldCnt
        if delta != 0 and li + 1 <= lines.len() - 1 {
            for li + 1 : lines.len() - 1 to k { drLStart[k] = drLStart[k] + delta }
        }
        drLCnt[li] = newCnt
        drCount = drLi.len()
    }

    // 构建显示行表：自动换行时一行逻辑行会被拆成多显示行。
    // 非换行模式下显示行与逻辑行 1:1。结果存入 _drLi/_drC0/_drC1，并维护 _drLStart/_drLCnt。
    pri func build_display_rows(float visW): int {
        drLi = []; drC0 = []; drC1 = []
        drLStart = []; drLCnt = []
        if visW <= 0 { visW = 1.0 }
        for lines.len() to li {
            var ln = lines[li]
            drLStart.add(drLi.len())
            if not wordWrap {
                drLi.add(li); drC0.add(0); drC1.add(ln.len())
                drLCnt.add(1)
            } else {
                var wl = wrap_line(ln, visW)
                var col0 = 0
                for wl.len() to wi {
                    var seg = wl[wi]
                    var segLen = seg.len()
                    drLi.add(li); drC0.add(col0); drC1.add(col0 + segLen)
                    col0 = col0 + segLen
                }
                if wl.len() == 0 { drLi.add(li); drC0.add(0); drC1.add(0) }
                drLCnt.add(wl.len())
            }
        }
        drCount = drLi.len()
        return drCount
    }

    // 给定逻辑行列，返回其所在的显示行索引
    pri func disp_row_of(int li, int col): int {
        var best = -1
        for drCount to di {
            if drLi[di] == li {
                if col >= drC0[di] and col <= drC1[di] { return di }
                best = di
            }
        }
        if best >= 0 { return best }
        return 0
    }

    func dispose() {
        if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null
        // 释放内嵌右击菜单（MenuBar）。它不在窗口 _widgets 中，需由持有者负责清理，
        // 对齐 SpinBox.dispose 释放子控件的做法，避免右键菜单字体泄漏
        ctxMenu?.dispose(); ctxMenu = null
        // 停止并注销光标闪烁定时器
        blinkTimer?.stop()
        if blinkTimer != null { tmr.unregisterTimer(blinkTimer) }
    }

// ==================== 运行时主题切换 ====================
func applyTheme(Theme t) {
    bgColor = t.bgInput
    txtColor = t.txtInput
    focusColor = t.accentFocus
    sbColor = t.sb
}
}

// 工厂
export func createEdit(Dict opts): Edit {
    Edit ed = new Edit(); ed.set(opts); return ed
}


