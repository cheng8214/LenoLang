// sdl_drag.leno — 拖拽提示框组件
// 拖拽文件/项目时在鼠标附近显示的浮动提示框（半透明圆角背景 + 文字）。
// 用法：
//   DragHint dh = SDL3.createDragHint({})
//   win.setOverlay(func(Renderer r) { dh.render(r) })
//   dh.show("file.txt (+2)", mouseX, mouseY)  // 显示/更新
//   dh.hide()                                   // 隐藏
//   dh.dispose()                                // 释放资源
import "sdl_renderer.leno" as ren; use ren.Renderer
import "sdl_opts.leno" as dochk    // 选项对账：不认识的键会报一行警告（见 sdl_opts.leno ✓）
import "sdl_font.leno" as fnt; use fnt.Font
import "sdl_core.leno" as core
import "sdl_theme.leno" as theme
use theme.Color


// 本控件认的键 —— 由本文件全部 `.get("…")` **自动抽取**（是超集 ⇒ 可少报、不误报 ✓）
//   ⚠ 以后增删选项请重跑抽取（或人工核对），否则可能对合法用法误报 ✓
func _opts_keys(): Array[string] {
    return [
"bg_a", "bg_color", "border_a", "border_color", "font_size", "offset_x", "offset_y", "pad_x", "pad_y", "radius", "text_color"
]
}
export struct DragHint {
    // ── 样式配置 ──
    Font? _font = null           // 字体缓存（懒加载）
    float _fontSize = 13.0       // 字体大小
    pri float padX = 10.0           // 内边距 X
    pri float padY = 5.0            // 内边距 Y
    pri float radius = 4.0          // 圆角半径
    pri float offsetX = 14.0        // 相对鼠标的 X 偏移
    pri float offsetY = 14.0        // 相对鼠标的 Y 偏移
    // 背景色（半透明）
    pri Color bgColor = #1E3C78DC
    // 边框色
    pri Color brColor = #508CDCFF
    // 文字色
    pri Color txColor = #FFFFFFFF

    // ── 运行时状态 ──
    pri string text = ""            // 显示文本
    pri float x = 0.0, y = 0.0    // 鼠标位置
    bool _visible = false        // 是否可见

    // 初始化（通过 Dict 配置样式）

    func set(Dict opts) {
        dochk.check("sdl_drag", opts, _opts_keys())   // ★ 选项对账（2026-09-29 铺开 ✓）
        _fontSize = opts.get("font_size", 13.0)
        padX = opts.get("pad_x", 10.0)
        padY = opts.get("pad_y", 5.0)
        radius = opts.get("radius", 4.0)
        offsetX = opts.get("offset_x", 14.0)
        offsetY = opts.get("offset_y", 14.0)
        if opts.get("bg_color") is Color => t { bgColor = t }
        if opts.get("border_color") is Color => t { brColor = t }
        var bga = opts.get("bg_a")
        if bga is int { bgColor = theme.withAlpha(bgColor, bga) }
        var bra = opts.get("border_a")
        if bra is int { brColor = theme.withAlpha(brColor, bra) }
        if opts.get("text_color") is Color => t { txColor = t }
    }

    // 确保字体已加载
    func _ensureFont() {
        if _font != null and _font.ok { return }
        _font = fnt.acquireFontAuto(_fontSize)
    }

    // 显示拖拽提示（设置文本 + 位置 + 可见）
    func show(string text, float x, float y) {
        // 形参遮蔽同名字段（text/x/y）⇒ 裸写法会写到形参上，字段纹丝不动 ✗
        self.text = text; self.x = x; self.y = y
        _visible = true
        core.markFrameRedraw()
    }

    // 仅更新位置（不改变文本）
    func updatePos(float x, float y) {
        self.x = x; self.y = y      // 同上：形参遮蔽字段
        if _visible { core.markFrameRedraw() }
    }

    // 隐藏
    func hide() {
        _visible = false
        text = ""
    }

    // 渲染（作为 overlay 回调使用）
    func render(Renderer r) {
        if not _visible or text == "" { return }
        _ensureFont()
        if _font == null or not _font.ok { return }
        var[float, float](szw, szh) = _font.measureString(text)
        float boxW = szw + padX * 2.0
        float boxH = szh + padY * 2.0
        float bx = x + offsetX
        float by = y + offsetY
        // 半透明圆角背景
        r.setColor(bgColor)
        r.fillRoundedRect(bx, by, boxW, boxH, radius)
        // 圆角边框
        r.setColor(brColor)
        r.drawRoundedRect(bx, by, boxW, boxH, radius)
        // 文字
        r.drawText(_font, text, bx + padX, by + padY, txColor)
    }

    // 释放字体资源
    func dispose() {
        if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null
    }
}

// 工厂
export func createDragHint(Dict opts): DragHint {
    DragHint dh = new DragHint()
    dh.set(opts)
    return dh
}


