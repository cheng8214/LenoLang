// sdl_spinner.leno — 加载旋转动画指示器
// 通过 win.addSpinner({...}) 创建，用于异步操作时的加载反馈
// 旋转弧线动画，支持自定义大小/颜色/速度
import "sdl_renderer.leno" as ren; use ren.Renderer
import "sdl_opts.leno" as dochk    // 选项对账：不认识的键会报一行警告（见 sdl_opts.leno ✓）
import "sdl_event.leno" as evt; use evt.Event
import "sdl_core.leno" as core
import "sdl_widget.leno" as wgt; use wgt.Widget
import "sdl_theme.leno" as theme; use theme.(Theme, Themeable)
use theme.Color
import maths


// 本控件认的键 —— 由本文件全部 `.get("…")` **自动抽取**（是超集 ⇒ 可少报、不误报 ✓）
//   ⚠ 以后增删选项请重跑抽取（或人工核对），否则可能对合法用法误报 ✓
func _opts_keys(): Array[string] {
    return [
"color", "full_track", "running", "size", "speed", "thickness", "tip", "track_alpha", "track_color", "visible", "x", "y"
]
}
export struct Spinner impl Widget {
    float x = 0.0, y = 0.0
    pri float size = 32.0           // 直径
    pri float thickness = 3.0       // 线条粗细
    Color _color = #64B4FFFF  // 旋转弧颜色
    pri Color trackColor = #464A54FF  // 背景轨道色
    pri int trackA = 80             // 背景轨道透明度
    pri float speed = 270.0         // 旋转速度（度/秒）
    pri float angle = 0.0           // 当前旋转角度
    pri float lastTick = 0.0        // 上一帧时间戳
    bool _running = true         // 是否正在旋转
    pri bool full = false           // 是否画整圆轨道（true=整圈背景+旋转缺口）
    bool visible = true, _loaded = false
    string _tip = ""


    func set(Dict opts) {
        dochk.check("sdl_spinner", opts, _opts_keys())   // ★ 选项对账（2026-09-29 铺开 ✓）
        Theme th = theme.getTheme()
        _color = theme.brighten(th.accent, 30)
        trackColor = th.sep
        x      = opts.get("x", 0)
        y      = opts.get("y", 0)
        size  = opts.get("size", 32)
        thickness = opts.get("thickness", 3.0)
        speed = opts.get("speed", 270.0)
        _running = opts.get("running", true)
        full = opts.get("full_track", false)
        visible = opts.get("visible", true)
        _tip = opts.get("tip", "")
        if opts.get("color") is Color => t { _color = t }
        if opts.get("track_color") is Color => t { trackColor = t }
        trackA = opts.get("track_alpha", 80)
        _loaded = true
    }

    // ==================== 设置方法 ====================
    func set_diameter(float s) { size = s }
    func set_thickness(float t) { thickness = t }
    func set_color(Color color) { _color = color }
    func set_speed(float s) { speed = s }
    func start() { _running = true; lastTick = 0.0 }
    func stop()  { _running = false; angle = 0.0; lastTick = 0.0 }
    func is_running(): bool { return _running }
    func set_visible(bool v) { visible = v }
    func is_visible(): bool { return visible }
    func set_enabled(bool e) {}
    func set_tip(string t) { _tip = t }

    // ==================== 查询方法 ====================
    func get_x(): float { return x }
    func get_y(): float { return y }
    func get_w(): float { return size }
    func get_h(): float { return size }
    func set_pos(float px, float py) { x = px; y = py }
    func set_size(float sw, float sh) { size = if sw < sh then sw else sh }

    func process(Event ev) {}

    // ==================== 动画步进 ====================
    pri func step() {
        if not _running { return }
        float now = _float(core.getTicks())
        if lastTick > 0.0 {
            float dt = (now - lastTick) / 1000.0
            angle = angle + speed * dt
            if angle >= 360.0 { angle = angle - 360.0 }
        }
        lastTick = now
    }

    // ==================== 渲染 ====================
    func render(Renderer r) {
        if not _loaded or not visible { return }
        step()
        if _running { core.requestRedraw() }

        float cx = x + size / 2.0
        float cy = y + size / 2.0
        float radius = size / 2.0 - thickness

        // 背景轨道（整圆）
        if full or trackA > 0 {
            r.setColor(theme.withAlpha(trackColor, trackA))
            draw_arc(r, cx, cy, radius, 0.0, 360.0, thickness)
        }

        // 旋转弧（约 120 度的弧段）
        if _running or full {
            float a0 = angle
            float a1 = angle + 120.0
            r.setColor(_color)
            draw_arc(r, cx, cy, radius, a0, a1, thickness)
        }
    }

    // 用线段逼近圆弧（SDL3 无原生圆弧绘制）
    pri func draw_arc(Renderer r, float cx, float cy, float radius, float a0, float a1, float thick) {
        if radius <= 0.0 { return }
        float span = a1 - a0
        if span <= 0.0 { return }
        int segs = _int(radius * span / 360.0 * 0.4)
        if segs < 4 { segs = 4 }
        if segs > 120 { segs = 120 }
        float step = span / _float(segs)
        float d2r = 3.14159265 / 180.0
        for 0 : segs to i {
            float aa = a0 + step * _float(i)
            float ab = a0 + step * _float(i + 1)
            float x1 = cx + radius * maths.cos(aa * d2r)
            float y1 = cy + radius * maths.sin(aa * d2r)
            float x2 = cx + radius * maths.cos(ab * d2r)
            float y2 = cy + radius * maths.sin(ab * d2r)
            r.drawLine(x1, y1, x2, y2)
        }
    }

    func dispose() {}
}

// 工厂
export func createSpinner(Dict opts): Spinner {
    Spinner s = new Spinner(); s.set(opts); return s
}


