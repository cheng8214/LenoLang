// ★ 2026-10-31：`@optkeys` 加在**门面这一层**（应用调的 `SDL3.createXxx` 就是这里）——
//   键表逐字取自各实现文件的 `_opts_keys()`（运行时 dochk 对账用的是同一份 ✓）。
//   ⚠ **只给已有 `_opts_keys()` 的控件加**：没有那份白名单的（如 Label）加了就等于瞎猜，
//     一旦猜少一个键，正常代码就编不过 ✗ —— 这类控件留空（= 不检查）更安全 ✓
@optkeys(["border_color", "box", "checked", "checked_color", "cursor", "enabled", "font_path",
          "font_size", "font_style", "gap", "text", "text_color", "tip", "unchecked_color",
          "visible", "x", "y"])
export func createCheckBox(Dict opts): CheckBox     { return chk.createCheckBox(opts) }
@optkeys(["align", "background", "bg_color", "bg_image", "border", "border_color", "cursor",
          "enabled", "font_path", "font_size", "font_style", "h", "hover_color", "image_alpha",
          "image_gap", "image_mode", "image_path", "image_path_disabled", "image_path_hover",
          "image_path_pressed", "image_pos", "image_size", "image_tint", "padding",
          "pressed_color", "radius", "shadow", "text", "text_color", "tip", "type", "visible",
          "w", "x", "y"])
export func createButton(Dict opts): Button          { return btn.createButton(opts) }
export func createLabel(Dict opts): Label            { return lbl.createLabel(opts) }
@optkeys(["bg_color", "border", "border_color", "draw_bg", "enabled", "focus_color", "font_path",
          "font_size", "font_style", "h", "multiline", "pad_x", "password", "placeholder",
          "placeholder_color", "radius", "readonly", "text", "text_color", "tip", "visible",
          "w", "wordWrap", "x", "y"])
export func createEdit(Dict opts): Edit              { return edt.createEdit(opts) }
@optkeys(["border_color", "box", "checked", "checked_color", "cursor", "enabled", "font_path",
          "font_size", "font_style", "gap", "group", "text", "text_color", "tip",
          "unchecked_color", "visible", "x", "y"])
export func createRadioButton(Dict opts): RadioButton { return rb.createRadioButton(opts) }
@optkeys(["anim", "anim_speed", "cursor", "enabled", "font_path", "font_size", "font_style", "h",
          "off_color", "on", "on_color", "text", "text_color", "tip", "visible", "w", "x", "y"])
export func createToggle(Dict opts): Toggle          { return tgl.createToggle(opts) }
@optkeys(["cursor", "enabled", "fill_color", "font_path", "font_size", "font_style", "h", "max",
          "min", "show_value", "step", "text_color", "thumb_color", "tip", "track_color", "value",
          "vertical", "visible", "w", "x", "y"])
export func createSlider(Dict opts): Slider          { return sld.createSlider(opts) }
@optkeys(["anim_speed", "clickable", "cursor", "enabled", "fill_color", "font_path", "font_size",
          "font_style", "h", "hit_pad_y", "max", "min", "show_text", "text_color", "tip",
          "track_color", "value", "visible", "w", "x", "y"])
export func createProgressBar(Dict opts): ProgressBar { return prg.createProgressBar(opts) }
@optkeys(["bg_color", "border_color", "cursor", "enabled", "font_path", "font_size", "font_style",
          "h", "hover_color", "image_gap", "image_pad", "image_path", "image_size", "item_h",
          "items", "mode", "scroll_color", "bar_auto_hide", "bar_hover_color", "sel_color",
          "selected", "text_color", "tip", "visible", "w", "x", "y"])
export func createListBox(Dict opts): ListBox     { return lb.createListBox(opts) }
@optkeys(["bg_color", "border", "border_color", "cursor", "editable", "enabled", "font_path",
          "font_size", "font_style", "h", "hover_color", "icon", "icon_gap", "icon_size",
          "image_gap", "image_size", "item_h", "item_images", "items", "placeholder",
          "placeholder_color", "pad_x", "popup_h", "show_arrow", "radius", "scroll_color",
          "bar_auto_hide", "bar_hover_color", "sel_color", "selected", "text_color", "tip",
          "visible", "w", "x", "y"])
export func createComboBox(Dict opts): ComboBox  { return cbb.createComboBox(opts) }
@optkeys(["bg_color", "border", "border_alpha", "border_color", "clip", "enabled", "h", "radius",
          "visible", "w", "x", "y"])
export func createPanel(Dict opts): Panel        { return pnl.createPanel(opts) }
@optkeys(["accent_color", "active", "active_color", "active_text_color", "bar_color", "bg_color",
          "border", "border_color", "clip", "cursor", "enabled", "font_path", "font_size",
          "font_style", "h", "show_header", "tab_color", "tab_h", "tab_icon_size", "tab_icons",
          "tab_radius", "tabs", "text_color", "underline", "visible", "w", "x", "y"])
export func createTabControl(Dict opts): TabControl { return tab.createTabControl(opts) }
@optkeys(["arrow_color", "arrow_w", "bg_color", "border_color", "cursor", "decimals", "enabled",
          "focus_color", "font_size", "h", "int_mode", "max", "min", "placeholder", "step", "tip",
          "value", "visible", "w", "x", "y"])
export func createSpinBox(Dict opts): SpinBox { return spb.createSpinBox(opts) }
@optkeys(["aligns", "bar_auto_hide", "bar_hover_color", "bg_color", "border", "border_color",
          "cell_select", "cell_types", "check_col", "check_color", "col_ratios", "col_reorder",
          "col_widths", "ctx_font_size", "ctx_image_size", "ctx_item_h", "cursor", "editable",
          "editable_cols", "empty_color", "empty_text", "enabled", "font_path", "font_size",
          "font_style", "frozen_cols", "h", "header_aligns", "header_color", "header_h",
          "headers", "hover_color", "image_cache_max", "image_col", "image_gap", "image_mode",
          "image_pad", "image_path", "image_size", "item_h", "max_col_width", "min_col_width",
          "multi_select", "numeric_cols", "radius", "resizable", "row_images", "row_num_color",
          "row_num_w", "row_numbers", "row_pad_x", "row_radius", "row_reorder", "rows", "sel_color",
          "sep_color", "solid_sel", "sort_disabled_cols", "sortable", "text_color", "tip",
          "visible", "w", "x", "y", "zebra"])
export func createTable(Dict opts): Table      { return tbl.createTable(opts) }
//    不导出 createMenuBar！MenuBar 有下拉弹层（renderPopup），必须通过 win.addMenuBar() 创建，
//    才能同时注册到 _widgets（render/process）和 _menus（renderPopup 绘制下拉层）。
//    若用 createMenuBar + win.add()，只注册到 _widgets，导致：标题栏正常显示、点击事件能响应，
//    但下拉菜单永远不会弹出（因为 renderPopup 只遍历 _menus 列表）。
//    此工厂函数保留供内部控件（TreeView/Table/Edit）创建私有右键菜单使用，不暴露给用户。
// 收起控件内嵌的右击菜单（表格/树/输入框都有）。
//   为什么需要暴露：这些弹层由 `renderContextMenus` **统一第二遍画**，判据只有 `isOpen()`，
//   **不看宿主还在不在** ⇒ 宿主被换页/隐藏后菜单会继续留在屏幕上、还点不动 ✗
//   传 null = 关掉所有窗口的（应用换页时最省事 ✓）
export func closeContextMenus(Ptr[u8] hwnd) { menu.closeContextMenus(hwnd) }
@optkeys(["bar_color", "bg_color", "border", "border_alpha", "border_color", "content_h",
          "content_w", "enabled", "fit_h", "fit_w", "h", "radius", "smooth", "step", "visible",
          "w", "x", "y", "bar_auto_hide", "bar_hover_color", "bar_w"])
export func createScrollView(Dict opts): ScrollView { return scv.createScrollView(opts) }
// 虚拟网格：只构建可见项（长列表 / 卡片墙用它，成千上万条也不卡 ✓）
export func createVirtualGrid(Dict opts): VirtualGrid { return vgd.createVirtualGrid(opts) }
@optkeys(["arrow_color", "bg_color", "border_color", "check_color", "checkable", "checked",
          "children", "context_menu", "cursor", "data", "enabled", "expanded", "font_path",
          "font_size", "font_style", "h", "has_children", "hover_color", "image",
          "image_expanded", "image_mode", "image_gap", "image_size", "indent", "items",
          "line_color", "mode", "pad_x", "placeholder", "item_h", "scroll_color", "sel_color",
          "show_check", "show_lines", "text", "text_color", "tip", "visible", "w", "x", "y"])
export func createTreeView(Dict opts): TreeView { return tv.createTreeView(opts) }
export func createBarChart(Dict opts): BarChart { return cht.createBarChart(opts) }
export func createLineChart(Dict opts): LineChart { return cht.createLineChart(opts) }
export func createPieChart(Dict opts): PieChart { return cht.createPieChart(opts) }
export func createTray(Dict opts): Tray        { return tray.createTray(opts) }
@optkeys(["alpha", "bg_color", "border", "border_alpha", "border_color", "cursor", "enabled", "h",
          "image_mode", "image_path", "image_tint", "overlay_hover_only", "overlay_path",
          "overlay_scale", "overlay_size", "radius", "rotation", "spin", "tip", "visible", "w",
          "x", "y"])
export func createImageView(Dict opts): ImageView  { return iv.createImageView(opts) }
// 图片纹理共享缓存（2026-10-27 补）：同一路径的 ImageView 共用一个纹理，
//   整页重建后不必重新解码 ⇒ 不再"重建即闪" ✓
export func imageCacheCount(): int          { return tcx.count() }
export func setImageCacheMax(int n)          { tcx.setCap(n) }
export func imageCacheRefOf(Ptr[u8] t): int  { return tcx.refOf(t) }
@optkeys(["alpha", "color", "dir", "h", "margin", "thickness", "visible", "w", "x", "y"])
export func createSeparator(Dict opts): Separator  { return sep.createSeparator(opts) }
@optkeys(["align", "bg_color", "border", "border_color", "font_size", "h", "pad_x", "pad_y",
          "radius", "text", "text_color", "visible", "w", "x", "y"])
export func createBadge(Dict opts): Badge         { return bdg.createBadge(opts) }
export func createAlert(Dict opts): Alert         { return alt.createAlert(opts) }
@optkeys(["circle", "desc_color", "desc_size", "dir", "done_color", "font_size", "gap", "item_h",
          "line_color", "line_w", "pending_color", "pending_border_color", "pending_text_color",
          "text_side", "title_color", "visible", "w", "x", "y"])
export func createSteps(Dict opts): Steps         { return stp.createSteps(opts) }
@optkeys(["alpha", "color", "visible"])
export func createScrim(Dict opts): Scrim           { return scr.createScrim(opts) }
@optkeys(["color", "enabled", "font_path", "font_size", "font_style", "hover_color", "text",
          "tip", "underline", "underline_hover", "url", "visible", "visited", "x", "y"])
export func createLinkButton(Dict opts): LinkButton { return lnk.createLinkButton(opts) }
@optkeys(["color", "full_track", "running", "size", "speed", "thickness", "tip", "track_alpha",
          "track_color", "visible", "x", "y"])
export func createSpinner(Dict opts): Spinner       { return spn.createSpinner(opts) }
@optkeys(["anim_speed", "bg_color", "cursor", "enabled", "fill_color", "font_path", "font_size",
          "mode", "on_click", "segment_colors", "segments", "show_text", "size", "sub_font_size",
          "sub_text_fn", "sweep_speed", "text_color", "text_fn", "thickness", "tip", "track_color",
          "value", "visible", "x", "y"])
export func createRingProgress(Dict opts): RingProgress { return ring.createRingProgress(opts) }
@optkeys(["bg_color", "border_alpha", "border_color", "clip", "enabled", "font_path", "font_size",
          "font_style", "h", "radius", "title", "title_color", "title_pad", "visible", "w", "x", "y"])
export func createGroupBox(Dict opts): GroupBox    { return gbx.createGroupBox(opts) }
@optkeys(["align", "col_spacing", "col_weights", "cols", "enabled", "h", "pad_x", "pad_y",
          "row_spacing", "spacing", "visible", "w", "x", "y"])
export func createGridLayout(Dict opts): GridLayout { return grd.createGridLayout(opts) }
@optkeys(["auto_h", "badge", "bare", "badge_bg", "badge_color", "badge_icon", "badge_pos",
          "badge_size", "badges", "bg_color", "border", "border_color", "border_selected_color",
          "content_bg", "content_click_through", "content_clip", "content_h", "content_pad",
          "cursor", "enabled", "gap", "h", "hover_color", "hover_lift", "image_aspect", "image_bg",
          "image_h", "image_mode", "image_path", "image_radius", "image_tint", "pad",
          "pressed_color", "radius", "selected", "sel_color", "subtitle", "subtitle_color",
          "subtitle_size", "text_align", "text_color", "tip", "title", "title_bold", "title_size",
          "visible", "w", "x", "y"])
export func createCard(Dict opts): Card             { return crd.createCard(opts) }
@optkeys(["sep_color", "sep_width", "first", "h", "hit_pad", "hover_color", "min_first",
          "min_second", "orientation", "ratio", "second", "w", "x", "y"])
export func createSplitter(Dict opts): Splitter    { return spl.createSplitter(opts) }
export func createDragHint(Dict opts): DragHint     { return drag.createDragHint(opts) }
export func createTitleBar(Dict opts): TitleBar       { return tbar.createTitleBar(opts) }
// 标题栏「动作按钮」的两个纯函数也透出去（调用方/示例/测试都靠同一份判定 ✓，2026-10-07 ✓）
export func parseTitleBarActions(Array[Dict] src): Array[TitleBarAction] { return tbar.parseTitleBarActions(src) }
export func is_builtin_icon(string n): bool { return tbar.is_builtin_icon(n) }
@optkeys(["bg_color", "border", "border_color", "border_w", "clip", "cursor", "enabled",
          "focus_border", "focus_color", "focusable", "h", "pad", "visible", "w", "x", "y"])
export func createCanvas(Dict opts): Canvas            { return cnv.createCanvas(opts) }

export func isTrayEntryChecked(Ptr[u8] e): bool   { return tray.isEntryChecked(e) }
export func isTrayEntryEnabled(Ptr[u8] e): bool   { return tray.isEntryEnabled(e) }
export func setTrayEntryEnabled(Ptr[u8] e, bool v) { tray.setEntryEnabled(e, v) }
export func setTrayEntryLabel(Ptr[u8] e, string l)  { tray.setEntryLabel(e, l) }
export func setTrayEntryChecked(Ptr[u8] e, bool v) { tray.setEntryChecked(e, v) }
// 模拟点击托盘条目（同步执行其回调）—— 托盘应用的无头自测入口 ✓
export func clickTrayEntry(Ptr[u8] e)               { tray.clickEntry(e) }

// ==================== 托盘图标点击拦截（自绘菜单用 ✓）====================
// 先 createTray，再调本函数开拦截；**不要调 tray.getMenu()**（不建菜单 ⇒ SDL 永不开它的
// 模态菜单 ⇒ 画面不冻结 ✓）。之后在主循环里 pollTrayClick() 取"图标被点 + 光标位置" ✓
export func interceptTrayClick(): bool        { return tray.interceptTrayClick() }
export func releaseTrayClick()               { tray.releaseTrayClick() }
export func pollTrayClick(): Array           { return tray.pollTrayClick() }   // [x, y, 键(1左/2右)] ✓
export func clickTrayIcon(int kind = 2): bool { return tray.clickTrayIcon(kind) }   // 自测用：模拟点图标 ✓
export func setTipDelay(int ms)                     { tip.setTipDelay(ms) }
// 手动指定提示气泡（2026-10-27 补）：给"进度条悬停显示时间"这类**内容随光标变化**的提示用
//   on_hover 拿到光标处的值 ⇒ 格式化后调 tipReport(text, x, y)；鼠标离开时 tipClear() ✓
export func tipReport(string text, float ax, float ay) { tip.tipReport(text, ax, ay) }
export func tipClear()                              { tip.tipClear() }
// 带**归属者**的版本（推荐）：气泡归 owner，别处清不掉，只受 `tipClearEx(owner)` 管 ✓
//   on_hover 这类"手动弹气泡"的回调必须用它 —— 用无条件 tipClear 会把别人的提示一起清掉 ✗
export func tipReportEx(string owner, string text, float ax, float ay) { tip.tipReportEx(owner, text, ax, ay) }
export func tipClearEx(string owner)                { tip.tipClearEx(owner) }
export func tipOwner(): string                       { return tip.tipOwner() }
// 诊断：提示气泡当前是否已显示 / 当前文本（排障"没弹出来"用 ✓）
export func tipVisible(): bool                      { return tip.tipVisible() }
export func tipText(): string                       { return tip.tipCurrent() }

// ==================== 轻提示 Toast（应用内，2026-10-30）====================
//   定位：一次操作的**回声** —— 不占布局、不吃事件、自动淡出。
//   要"占位/停留到用户处理"的提示条请用 addAlert（两者分工见 sdl_toast.leno 头部 ✓）
//   SDL3.toast("已复制")  SDL3.toastKind("保存失败", SDL3.TOAST_ERROR)
//   SDL3.toastFull("正在解析…", SDL3.TOAST_INFO, 1200, SDL3.TOAST_TOP)
export const TOAST_INFO    = tst.TOAST_INFO
export const TOAST_SUCCESS = tst.TOAST_SUCCESS
export const TOAST_WARN    = tst.TOAST_WARN
export const TOAST_ERROR   = tst.TOAST_ERROR
export const TOAST_BOTTOM       = tst.TOAST_BOTTOM
export const TOAST_TOP          = tst.TOAST_TOP
export const TOAST_BOTTOM_RIGHT = tst.TOAST_BOTTOM_RIGHT
