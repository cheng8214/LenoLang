// LenoSDL3 — SDL3 绑定入口（用户只需导入此模块）
import "sdl_core.leno" as core
import "sdl_window.leno" as wnd
import "sdl_renderer.leno" as r
import "sdl_font.leno" as fnt
import "sdl_event.leno" as evt
import "sdl_timer.leno" as tm
import "sdl_image.leno" as img
import "sdl_anim.leno" as anim; use anim.Anim     // 帧动画播放器（2026-10-21）
import "sdl_capture.leno" as cap
import "sdl_button.leno" as btn
import "sdl_label.leno" as lbl
import "sdl_edit.leno" as edt
import "sdl_checkbox.leno" as chk
import "sdl_radio.leno" as rb
import "sdl_toggle.leno" as tgl
import "sdl_slider.leno" as sld
import "sdl_progress.leno" as prg
import "sdl_listbox.leno" as lb
import "sdl_combobox.leno" as cbb
import "sdl_panel.leno" as pnl
import "sdl_tab.leno" as tab
import "sdl_spinbox.leno" as spb
import "sdl_table.leno" as tbl
import "sdl_layout.leno" as lay
import "sdl_menu.leno" as menu
import "sdl_tooltip.leno" as tip
import "sdl_toast.leno" as tst       // 轻提示（应用内 toast，2026-10-30）✓
import "sdl_scrollview.leno" as scv
import "sdl_virtualgrid.leno" as vgd
import "sdl_treeview.leno" as tv
import "sdl_widget.leno" as wgt
import "sdl_chart.leno" as cht
import "sdl_tray.leno" as tray
import "sdl_theme.leno" as thm
import "sdl_imageview.leno" as iv
import "sdl_texcache.leno" as tcx   // 图片纹理共享缓存（诊断/上限配置用 ✓）
import "sdl_separator.leno" as sep
import "sdl_badge.leno" as bdg; use bdg.Badge     // 胶囊徽标（不可点状态标签 ✓）
import "sdl_calendar.leno" as cal; use cal.Calendar   // 签到日历（月历网格 + 每天状态色 + 可选点选/切月）
@optkeys(["alert_color", "alert_text_color", "arrow_color", "arrow_left", "arrow_right",
          "cell_max", "cell_min", "cell_radius", "cell_radius_ratio", "filled_color",
          "filled_text_color", "font_size_day", "font_size_head", "font_size_legend",
          "font_size_week", "gap", "h", "header_h", "header_text_color", "legend_gap", "legend_h",
          "legend_swatch", "marks", "month", "month_fmt", "pad", "plain_color", "plain_text_color",
          "rows", "show_header", "today", "today_color", "today_border_color", "today_text_color",
          "visible", "w", "week_h", "week_start", "week_text_color", "x", "y", "year"])
export func createCalendar(Dict opts): Calendar   { return cal.createCalendar(opts) }
export func weekdayName(int y, int m, int d, Array[string] names): string { return cal.weekdayName(y, m, d, names) }   // 星期名（名字表由调用方给 ⇒ 控件不预设语言 ✓）
import "sdl_alert.leno" as alt; use alt.Alert     // 提示条 info/warn/danger/success ✓
import "sdl_steps.leno" as stp; use stp.Steps     // 步骤条（竖向流程 / 横向概览 ✓）
import "sdl_scrim.leno" as scr; use scr.Scrim
import "sdl_linkbutton.leno" as lnk
import "sdl_spinner.leno" as spn
import "sdl_ring.leno" as ring; use ring.RingProgress   // 圆环进度（donut：idle/sweep/value 三态 ✓）
import "sdl_groupbox.leno" as gbx
import "sdl_gridlayout.leno" as grd
import "sdl_card.leno" as crd; use crd.Card     // 卡片（图片 + 标题 + 副标题 + 角标；海报墙/商品列表的单元 ✓）
import "sdl_splitter.leno" as spl
use spl.Splitter
import "sdl_drag.leno" as drag
use drag.DragHint
import "sdl_titlebar.leno" as tbar
use tbar.(TitleBar, TitleBarAction)   // 标题栏 + 它的**动作按钮**类型（2026-10-07 新增 ✓）
import "sdl_canvas.leno" as cnv
use cnv.Canvas
import "sdl_popmenu.leno" as pmenu; use pmenu.PopMenu    // 自绘弹出菜单（图标传图片路径，同 MenuBar ✓）
export func createPopMenu(Dict opts): PopMenu { return pmenu.createPopMenu(opts) }


// ==================== 重新导出类型 ====================
// 用户可通过 use SDL3.xxx 导入
// 注：必须导出至少一个返回该类型的函数，模块符号表才能识别

use core.(SDL_FRect, SDL_Rect, SDL_FPoint, SDL_Point, SDL_Color, SDL_FColor, SDL_GlyphMetrics, SDL_Vertex)
use core.(SDL_KeyboardEvent, SDL_MouseButtonEvent, SDL_MouseMotionEvent, SDL_MouseWheelEvent, SDL_TextInputEvent, SDL_WindowEvent, SDL_DropEvent)
