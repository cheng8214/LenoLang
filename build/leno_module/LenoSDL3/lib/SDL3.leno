    return anim.loadFrames(renderer, paths, delayMs)
}

// ==================== Image ====================

export func loadImage(string path): Ptr[u8]                  { return img.load(path)}
export func loadImageTexture(Ptr[u8] ren, string path): Ptr[u8]  { return img.loadTexture(ren, path) }
// 改**已加载纹理**的缩放模式（2026-10-12 补 ✓）：loadImageTexture 一律设 LINEAR（圆/文字更顺 ✓），
// 但**像素画**必须 NEAREST —— 否则精灵图四周"A=0 但带颜色"的像素会被双线性插值掺进来，
// 放大后就是一圈白/脏边"描边"（《超级玛丽》的白边 ✓）。用法与理由见 sdl_image.leno ✓
// 形参是 `int`（同框架既有 FFI 风格 ✓）；传 `ScaleMode.NEAREST` 照旧 ✓（枚举↔C 整型的静态检查问题已修 ✓）
export func setTextureScaleMode(Ptr[u8] tex, int mode)   { img.setTextureScaleMode(tex, mode) }
export func saveImagePNG(Ptr[u8] surface, string path): bool           { return img.savePNG(surface, path) }
export func saveImageJPG(Ptr[u8] surface, string path, int q = 90): bool    { return img.saveJPG(surface, path, q) }
export func saveImageBMP(Ptr[u8] surface, string path): bool           { return img.saveBMP(surface, path) }
export func saveImageWEBP(Ptr[u8] surface, string path, float q = 80.0): bool { return img.saveWEBP(surface, path, q) }
export func imageVersion(): int { return img.version() }

// 从原始像素创建 surface（配合截屏使用）
sdl3 _sdlLib = core.lib()

export func createSurfaceFromRaw(int w, int h, int fmt, Ptr[u8] pixels, int pitch): Ptr[u8] {
    return _sdlLib.SDL_CreateSurfaceFrom(w, h, fmt, pixels, pitch)
}
export func destroySurface(Ptr[u8] surface) { _sdlLib.SDL_DestroySurface(surface) }
// 由 surface 创建纹理（配合逐像素直写渲染：自己写 pixels 缓冲 -> CreateSurfaceFrom -> 这里上传）
export func createTextureFromSurface(Ptr[u8] renderer, Ptr[u8] surface): Ptr[u8] {
    return _sdlLib.SDL_CreateTextureFromSurface(renderer, surface)
}
// 销毁纹理（配合逐像素直写渲染：createTextureFromSurface 用完即销毁）
export func destroyTexture(Ptr[u8] texture) { _sdlLib.SDL_DestroyTexture(texture) }

// ==================== 桌面截屏（★ 2026-10-01 新增，跨平台）====================
// ★ Windows 请用 `LenoWin32` 的 `Win32.captureScreen()`（GDI，已实测 ✓）；
//   本函数负责**非 Windows**：借 grim / gnome-screenshot / spectacle / scrot / import
//   产出 PNG，再用 SDL_image 解码成像素 ✓
//   应用侧按本仓既有惯例分支即可：
//     var shot = if Sys.isWindows() then Win32.captureScreen() else SDL3.captureScreen()
// 返回 `{w,h,fmt,pitch,pixels}`（与 Win32.captureScreen **同形** ✓，pixels 需调用方 ffi.free ✓）
export func captureScreen(): Dict { return cap.captureScreen() }
// PNG 文件 → 像素（导出以便单测；也方便"先存盘再解码"的用法 ✓）
export func pngFileToPixels(string path): Dict { return cap.pngFileToPixels(path) }

