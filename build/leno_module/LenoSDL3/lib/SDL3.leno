// ==================== 帧动画（GIF / APNG / WebP，2026-10-21）====================
//   返回 Anim：`a.tick(dt)` / `a.drawTo(ren, x, y, w, h)` / `a.destroySelf()`
//   静态图也能加载（1 帧）；无显示器/解码失败 ⇒ `a.ok == false`（不抛）
export func loadAnim(Ptr[u8] renderer, string path, bool loop = true): Anim {
    return anim.load(renderer, path, loop)
}

