// sdl_table.leno — 表格控件（多列多行，可选表头/排序/选择/双向滚动）
// 通过 win.addTable({...}) 创建；数据用 set_rows / add_row 设置。
//
// ★ 2026-10-07：单元格内容**不再只有文本** —— 两种新能力（都在原有的可见行循环里做 ✓）：
//   · `cell_types: ["", "", "", "progress"]` 或 `set_col_cell_type(c, "progress")`
//     ⇒ 该列画**进度条**（值取自该列文本，规则见 sdl_progress.parseProgress ✓）
//     原先只能把进度写成 "37%" 文字 ✗ ⇒ 表格里再嵌一个 ProgressBar 控件是不成的（那要虚拟化+生命周期 ✗）
//   · `on_cell_draw(cb)` ⇒ 每格常规内容画完后给一次**自绘**机会（矩形已含滚动偏移/冻结列 ✓）
//     逃生舱：色块、徽标、迷你折线、给某格加角标…… 应用自己画，表格不猜 ✓
//   ⚠ 观感约定（别再犯）：progress 的轨道/填充/文字色**一律从 sdl_progress 取** ——
//     本文件已经两次踩过"单元格自己调色 ⇒ 与真控件两套观感"（见 set() 里复选框那段注释 ✓）
//   ⚠ 本文件**不接管**单元格内的点击：命中仍是行/单元格级（`on_cell(row, col)` ✓）
//     —— 真控件那种"格内小按钮/可拖进度"要处理可见行实例化与生命周期，本轮不做 ✓
import maths
import "sdl_opts.leno" as dochk    // 选项对账：不认识的键会报一行警告（见 sdl_opts.leno ✓）
import "sdl_renderer.leno" as ren; use ren.Renderer
import "sdl_font.leno" as fnt; use fnt.Font
import "sdl_event.leno" as evt; use evt.Event
import "sdl_core.leno" as core; use core.SystemCursor; use core.SDL_Rect
import "sdl_widget.leno" as wgt; use wgt.Widget
import "sdl_edit.leno" as edt; use edt.Edit
import "sdl_tooltip.leno" as tip
import "sdl_progress.leno" as prgb    // ★ 2026-10-07：进度单元格复用它的观感 + 取值规则（同源 ✓）
import "sdl_menu.leno" as menu; use menu.MenuBar
import "sdl_image.leno" as img
import "sdl_theme.leno" as theme; use theme.(Theme, Themeable)
use theme.Color


// 本控件认的键 —— 由本文件全部 `.get("…")` **自动抽取**（是超集 ⇒ 可少报、不误报 ✓）
//   ⚠ 以后增删选项请重跑抽取（或人工核对），否则可能对合法用法误报 ✓
func _opts_keys(): Array[string] {
    return [
"aligns", "bg_color", "cell_select", "cell_types", "check_col", "check_color", "col_reorder", "col_widths", "cursor", "editable", "editable_cols", "empty_color", "empty_text", "enabled", "font_path", "font_size", "font_style", "frozen_cols", "h", "header_aligns", "header_color", "header_h", "headers", "image_col", "image_gap", "image_mode", "image_pad", "image_size", "max_col_width", "min_col_width", "multi", "multi_select", "numeric_cols", "resizable", "row_h", "row_images", "row_reorder", "rows", "sel_color", "sep_color", "sort_disabled_cols", "sortable", "tip", "visible", "w", "x", "y", "zebra"
]
}
export struct Table impl Widget, Themeable {
    float x = 0.0, y = 0.0, w = 360.0, h = 240.0
    Array[string] _headers = []
    Array[float] _colW = []
    Array[int] _aligns = []           // 每列对齐：0 左, 1 中, 2 右
    pri Array[int] headerAligns = []     // 表头文字对齐（可独立于数据列），0 左, 1 中, 2 右
    Array[Array[string]] _rows = []
    pri int ncols = 1
    pri bool autoCols = true            // 列宽是否按宽度等分（用户未指定 col_widths）
    pri float headerH = 28.0, rowH = 24.0
    pri float scrollX = 0.0, scrollY = 0.0
    pri int selRow = -1, selCol = -1, hoverRow = -1, hoverCol = -1; bool _multi = false; pri Array[int] selRows = []
    pri Array[bool] selSet = []           // 选中行标志数组（与 _rows 平行），让 _is_sel O(1) 避免 render 中线性扫描 _selRows
    bool _sortable = false; pri int sortCol = -1; pri bool sortDesc = false, _zebra = true
    pri Array[int] numericCols = []    // 数值排序列索引集合（点击表头时按数值而非字符串比较）
    pri Array[int] sortDisabledCols = []  // 禁用排序的列索引集合（黑名单；空数组=全部列可排序，受 _sortable 控制）
    pri bool colReorder = true         // 是否允许拖拽表头重排列顺序
    pri int dragReorderCol = -1        // 正在拖拽重排的源列索引（-1=无）
    pri float reorderStartX = 0.0     // 拖拽起点 X（用于判断是点击还是拖拽）
    pri bool reorderDragging = false  // 已越过拖拽阈值，进入列重排拖拽状态
    pri float reorderDragX = 0.0      // 当前拖拽鼠标 X（绘制指示线用）
    pri int frozenCols = 0           // 冻结列数量（左侧前 N 列不随水平滚动，0=无冻结）
    pri bool rowReorder = false       // 是否允许拖拽行重排
    pri int dragReorderRow = -1       // 正在拖拽重排的源行索引（-1=无）
    pri float rowReorderStartY = 0.0  // 行拖拽起点 Y
    pri bool rowReorderDragging = false // 已越过拖拽阈值
    pri float rowReorderDragY = 0.0   // 当前拖拽鼠标 Y（绘制指示线用）
    pri func(int, int):void onRowReorder  // 行拖拽重排回调（from, to）

    float _fontSize = 15.0; pri string fontPath = ""; pri int fontStyle = 0; Font? _font
    pri float textH = 16.0         // 缓存字体行高，避免每个单元格重复 measureString
    pri Color bgColor = #262830FF
    pri Color hdrColor = #2E3038FF, hdrTxtColor = #DCE1EBFF
    pri Color selColor = #343A46FF
    pri Color hovColor = #464E5CFF
    pri Color zebColor = #2C2E36FF
    pri Color txtColor = #EBEBF5FF, sepColor = #464A54FF, sbColor = #787D8CFF
    int _cursor = SystemCursor.POINTER
    bool enabled = true, visible = true, _loaded = false
    string _tip = ""
    pri Ptr[u8]? clipBase            // 表格整体裁剪区指针（供单元格内裁剪后恢复）
    pri Array[float] colWPrefix = []    // 列宽前缀和缓存：_colWPrefix[i] = sum(_colW[0..i-1])，让 _col_x O(1)
    pri bool colWPrefixValid = false
    pri float cachedTotalW = -1.0       // _total_w() 缓存，避免 process/render 中多次遍历 _colW
    pri bool totalWValid = false
    // ★ _compute_sb() 结果缓存：process 单帧最多调用 6 次，缓存后只计算 1 次
    pri float cachedSbVw = -1.0, cachedSbHh = -1.0
    pri bool sbValid = false
    pri int hoverColForTip = -1         // 缓存：上次做 tooltip 截断检查的列索引
    pri string hoverTipText = ""        // 缓存：当前悬停单元格的 tooltip 文本（空串=无需 tooltip）
    pri bool draggingV = false, draggingH = false; pri float vDragOffset = 0.0, hDragOffset = 0.0
    pri int dragCol = -1; pri float _dragStartX = 0.0, dragStartW = 0.0; bool _resizable = true
    pri func(int):void onSelect
    pri func(int, int):void onCell
    // 内嵌右击上下文菜单（复用 MenuBar 弹层渲染与捕获；默认不预置项，由应用层自定义）
    pri MenuBar? ctxMenu
    pri int ctxMenuH = -1
    Ptr[u8]? _hwnd           // 所属窗口句柄（供内嵌右击菜单按窗口隔离绘制）
    pri bool ctxMenuEnabled = true
    // 行图标支持：指定某列显示 [图标+文字]，图标路径由 _rowImages 独立存储（对齐 Treeview 模式）
    pri int          imageCol = -1           // 图标列索引（0-based，-1=无图标列）
    pri Array[string] rowImages = []         // 每行图标路径（与 _rows 平行，空串=无图标）
    pri Array[string] rowTips = []           // 每行自定义悬浮 tip（与 _rows 平行，空串=无自定义 tip）
    float        _imgSize = 0.0           // 图标边长（0 = 自动：取 _rowH - 8）
    pri int          imgMode = 0             // 内容模式：0=aspectFit 1=stretch 2=aspectFill
    pri float        imgPad = 4.0            // 图标在单元格内的左侧内边距
    pri float        imgGap = 4.0            // 图标与文字间距
    pri Array[string] imgCachePaths = []     // 纹理缓存路径
    pri Array[Ptr[u8]] imgCacheTex = []      // 纹理缓存指针
    pri string imgLastPath = ""               // MRU 快路径：上次命中的图标路径
    pri Ptr[u8] imgLastTex = null             // MRU 快路径：上次命中的纹理指针
    // === 拟合文本缓存 ===
    // 预计算可见单元格的截断文本和宽度，避免 render 路径每帧调用 _fit_cell_text + measureString。
    // ★ 优化：只缓存当前视口可见行（_fittedStartRow ~ _fittedEndRow），滚动时惰性重建对应区间，
    //   避免对万行数据全量预计算（O(n×cols) → O(visibleRows×cols)）。
    pri Array[string] fittedText = []        // flat: (row-_fittedStartRow) * _ncols + col，截断后的文本
    pri Array[float] fittedW = []            // flat: (row-_fittedStartRow) * _ncols + col，截断后文本的测量宽度
    pri int fittedStartRow = 0               // 缓存对应的起始行索引
    pri int fittedEndRow = 0                 // 缓存对应的结束行索引（exclusive）
    pri bool fittedValid = false
    // 行背景色缓存：避免 render 中对每个可见行逐个 _is_sel / 判 zebraness / 判 hover
    // （_is_sel 已用 _selSet 消除，此处仅保留注释说明设计思路）
    pri int checkedCount = -1               // _rowChecked 已勾选计数缓存（-1=未计算/失效）
    pri int ctxRow = -1, ctxCol = -1   // 右击命中行/列
    pri int winW = 0, winH = 0          // 所属窗口逻辑宽高（上下文菜单边界夹紧用）
    pri func(int, string):void onCtxSelect   // 上下文菜单自定义回调（参数为命中行与项 id）
    pri func(int):void onCtxWillOpen          // 右键菜单弹出前回调（参数为命中行）；用于按行类型动态重建菜单项
    pri func(int, int, string):void onEditCommit  // 行内编辑提交回调（行, 列, 新文本）；供应用层落盘（如重命名）
    pri func(int, Array[int]):void onCheck       // 复选框变化回调（复选列索引, 勾选行索引数组）

    // === 复选框列 ===
    pri int  checkCol = -1               // 复选框列索引（-1=无复选框列）
    pri Array[bool] rowChecked = []      // 每行勾选状态（与 _rows 平行）
    pri bool checkHeaderState = false    // 表头全选框状态（三态：半选用 false 但有部分勾选时渲染半选样式）
    pri Color  chkColor = #3C82DCFF   // 勾选框的"边框 + 勾线"色（默认取主题 accent，见 set ✓）
    pri Color  chkBoxColor = #5A5F6EFF  // 未勾选时边框色
    // ⚠ 勾线**不再单独设色**：勾选态是"描边 + 勾线"（不填满）⇒ 勾线必须与描边同色；
    //   原先这里另设 `markColor = txtOnAccent`（≈白）⇒ 浅色主题下**白勾画在白底上 = 看不见** ✗
    //   （CheckBox 控件踩过同款，见 sdl_checkbox.leno 那句"去掉蓝底后白勾会看不见" ✓）

    // ==================== 单元格内容类型（2026-10-07 新增）====================
    // 每列内容类型（下标=列）："" / "text" = 文本（默认），"progress" = 进度条
    //   ⚠ **值不另存**：progress 列的**单元格文本本身**就是数值（规则见 set_col_cell_type）
    //     ⇒ 不必新增"每行并行数组" ⇒ 排序 / 行重排 / 列重排**零同步代码** ✓（值随 _rows 一起搬 ✓）
    //     （这正是 rowImages / rowChecked / rowColors 必须在 swap_rows / move_row / swap_cols
    //       各写一遍的原因 ✗ —— 少写一处就"进度跟着别人走" ✗）
    pri Array[string] cellTypes = []
    // progress 单元格配色：★ 从 sdl_progress 的取色函数取（与 ProgressBar 同源，见文件头约定 ✓）
    pri Color progTrack = #3C3C48FF, progFill = #3CC850FF, progTxt = #EBEBF5FF
    // 百分比文字宽度缓存（下标=百分数 0..100，-1=未测）：每个值一生只测一次 ✓
    //   （表格刻意避开"每格每帧 measureString" —— 见 Pass 2 拟合文本缓存那段注释 ✓）
    pri Array[float] pctW = []
    // 单元格自绘回调（r, 行, 列, x, y, w, h）：常规内容**之后**调用 ✓（矩形已含滚动偏移与冻结列）
    pri func(Renderer, int, int, float, float, float, float):void onCellDraw

    // === 行级颜色 ===
    pri Array[Color] rowColors = []        // 每行文字色 RGB 打包：0xRRGGBB，0=用默认色
    Dict[string, Color] _cellFgColors = {}  // 单元格前景色：键"row,col"，值 0xRRGGBB，0=无
    Dict[string, Color] _cellBgColors = {}  // 单元格背景色：键"row,col"，值 0xRRGGBB，0=无
    pri Array[float] colMinW = []   // 每列最小宽度（空数组=全部用默认 _minColW）
    pri Array[float] colMaxW = []   // 每列最大宽度（空数组=无上限）
    pri float minColW = 24.0        // 默认列最小宽度
    pri float maxColW = 9999.0     // 默认列最大宽度

    // === 空状态 ===
    pri string emptyText = "暂无数据"     // 空状态提示文字
    pri Color emptyColor = #78808CFF  // 空状态文字颜色

    // === 双击编辑（默认关闭，由应用按需开启） ===
    Edit? _edit
    pri bool editing = false
    bool _editable = false          // 是否允许双击进入单元格编辑（默认 false）
    pri Array[int] editableCols = []   // 可编辑列索引集合（空数组=全部可编辑）
    pri bool cellSelect = false        // 单元格选中模式：hover/选中高亮单个单元格而非整行
    pri int editRow = -1, editCol = -1
    int _lastClickTime = -100000
    pri float lastClickX = 0.0, lastClickY = 0.0
    pri func(int, int):void onDblClick  // 双击单元格回调（无论是否可编辑都会触发，便于应用层自定义如“打开”）

    pri func ensure_font() {
        if _font == null or not _font.ok {
            if _font != null and _font.ok { fnt.releaseFont(_font) }
            if fontPath != "" { _font = fnt.acquireFont(fontPath, _fontSize) }
            else { _font = fnt.acquireFontAuto(_fontSize) }
            if _font.ok {
                if fontStyle != 0 { _font.setStyle(fontStyle) }
                var[float, float](_agw, _agh) = _font.measureString("Ag")
                textH = _agh   // 字体加载时缓存行高，避免每帧渲染中调用 measureString
            }
        }
    }
    pri func total_w(): float {
        if totalWValid { return cachedTotalW }
        float s = 0.0
        for _colW.len() to i { s = s + _colW[i] }
        cachedTotalW = s; totalWValid = true
        return s
    }
    pri func invalidate_sb() { sbValid = false }
    pri func compute_sb(): Array[float] {
        if sbValid { return [cachedSbVw, cachedSbHh] }
        float fw = frozen_w()
        float vw = 0.0, hh = 0.0
        float bodyH0 = h - headerH - 8.0
        float bodyW0 = w - 8.0 - fw
        float ch = _rows.len() * rowH
        float tw = total_w() - fw
        if ch > bodyH0 { vw = 8.0 }
        if tw > bodyW0 { hh = 8.0 }
        if vw > 0.0 and tw > bodyW0 - vw { hh = 8.0 }
        if hh > 0.0 and ch > bodyH0 - hh { vw = 8.0 }
        cachedSbVw = vw; cachedSbHh = hh; sbValid = true
        return [vw, hh]
    }
    pri func max_scroll_y(): float {
        var sb = compute_sb()
        float bodyH = h - headerH - sb[1]
        if bodyH < 0 { bodyH = 0 }
        float ch = _rows.len() * rowH
        if ch <= 0 { ch = 1 }
        float m = ch - bodyH
        if m < 0 { m = 0 }
        return m
    }
    pri func max_scroll_x(): float {
        var sb = compute_sb()
        float bodyW = w - sb[0] - frozen_w()
        if bodyW < 0 { bodyW = 0 }
        float m = total_w() - frozen_w() - bodyW
        if m < 0 { m = 0 }
        return m
    }
    pri func clamp_scroll() {
        float my = max_scroll_y(); if scrollY < 0 { scrollY = 0 }; if scrollY > my { scrollY = my }
        float mx = max_scroll_x(); if scrollX < 0 { scrollX = 0 }; if scrollX > mx { scrollX = mx }
    }
    // 键盘导航：选中某行并滚动到可见
    pri func select_key(int row) {
        if row < 0 or row >= _rows.len() { return }
        selRow = row
        selRows = [row]; rebuild_sel_set()
        if row < selSet.len() { selSet[row] = true }
        ensure_row_visible(row)
        core.markFrameRedraw()
        if onSelect != null { onSelect(row) }
    }
    // 滚动使指定行可见
    pri func ensure_row_visible(int row) {
        if row < 0 { return }
        var sb = compute_sb()
        float visH = h - headerH - sb[1]
        if visH < 0 { visH = 0 }
        float rowTop = row * rowH
        float rowBot = rowTop + rowH
        if rowTop < scrollY { scrollY = rowTop }
        eif rowBot > scrollY + visH { scrollY = rowBot - visH }
        clamp_scroll()
    }
    // 确保列宽前缀和缓存有效（列宽变化时由 _recompute_cols / 列拖拽处失效）
    pri func ensure_col_prefix() {
        if colWPrefixValid { return }
        colWPrefix = [0.0]
        float s = 0.0
        for _colW.len() to i { s = s + _colW[i]; colWPrefix.add(s) }
        colWPrefixValid = true
    }
    pri func col_x(int ci): float {
        ensure_col_prefix()
        if ci < 0 { return x - scrollX }
        if ci >= colWPrefix.len() { ci = colWPrefix.len() - 1 }
        if ci < 0 { return x - scrollX }
        // 冻结列不受水平滚动影响
        if ci < frozenCols { return x + colWPrefix[ci] }
        return x - scrollX + colWPrefix[ci]
    }
    pri func row_at(float my): int {
        if my < y + headerH { return -1 }
        if my > y + h { return -1 }   // ★ 下边界：鼠标在 Table 下方时不应返回有效行
        int idx = _int((my - y - headerH + scrollY) / rowH)
        if idx < 0 or idx >= _rows.len() { return -1 }
        return idx
    }
    pri func col_at(float mx): int {
        ensure_col_prefix()
        if ncols <= 0 { return -1 }
        // 先检查冻结列（不受 _scrollX 影响）
        if frozenCols > 0 {
            for frozenCols to c {
                if mx >= x + colWPrefix[c] and mx < x + colWPrefix[c + 1] { return c }
            }
        }
        // 非冻结列：基于 _scrollX 做二分查找
        float offset = mx - (x - scrollX)
        if offset < 0 { return -1 }
        int lo = frozenCols, hi = ncols - 1
        if lo > hi { return -1 }
        while lo < hi {
            int mid = (lo + hi) / 2
            float edge = colWPrefix[mid + 1]
            if offset < edge { hi = mid } else { lo = mid + 1 }
        }
        if lo < _colW.len() and offset >= colWPrefix[lo] and offset < colWPrefix[lo + 1] { return lo }
        return -1
    }
    // 命中表头列分隔线（用于列宽拖拽），返回左侧列索引，未命中返回 -1
    pri func header_resize_col(float mx): int {
        if not _resizable { return -1 }
        if ncols <= 0 { return -1 }
        float tol = 5.0
        for 0 : ncols - 1 to c {
            float edge = col_x(c) + _colW[c]
            if mx >= edge - tol and mx <= edge + tol { return c }
        }
        return -1
    }
    pri func cell(int r, int c): string {
        if r < 0 or r >= _rows.len() { return "" }
        var row = _rows[r]
        if c < 0 or c >= row.len() { return "" }
        return row[c]
    }

    // ==================== set 初始化 ====================

    func set(Dict opts) {
        dochk.check("sdl_table", opts, _opts_keys())   // ★ 选项对账（2026-09-29 铺开 ✓）
        // 主题默认配色（opts 覆盖优先级更高）
        Theme th = theme.getTheme()
        bgColor = th.bg
        hdrColor = th.bgHeader
        selColor = th.bgSel
        hovColor = th.bgHover
        zebColor = th.bgZebra
        txtColor = th.txt
        hdrTxtColor = th.txtHeader
        // ★ 复选框列跟随主题（原来 chkColor 是**硬编码**的绿色，既不走主题、又与 CheckBox 观感不一致
        //   ⇒ 2026-10-07 统一到 accent ✓）；勾线跟描边同色 —— 理由见字段声明处那句 ⚠
        chkColor = th.accent
        sepColor = th.sep
        sbColor = th.sb
        emptyColor = th.txtDim
        chkBoxColor = th.border
        // ★ progress 单元格配色：走 sdl_progress 的取色函数（与 ProgressBar **同源**，见文件头约定 ✓）
        progTrack = prgb.barTrackColor(th)
        progFill = prgb.barFillColor(th)
        progTxt = prgb.barTextColor(th)
        x = opts.get("x", 0)
        y = opts.get("y", 0)
        w = opts.get("w", 360)
        h = opts.get("h", 240)
        headerH = opts.get("header_h", 28)
        rowH = opts.get("row_h", 24)
        _fontSize = opts.get("font_size", 15)
        fontPath = opts.get("font_path", "")
        fontStyle = opts.get("font_style", 0)
        _sortable = opts.get("sortable", false)
        _resizable = opts.get("resizable", true)
        _zebra = opts.get("zebra", true)
        colReorder = opts.get("col_reorder", true)
        frozenCols = opts.get("frozen_cols", 0)
        rowReorder = opts.get("row_reorder", false)
        minColW = opts.get("min_col_width", 24.0)
        maxColW = opts.get("max_col_width", 9999.0)
        var ncs = opts.get("numeric_cols", [])
        if ncs is Array[int] { numericCols = ncs } else { numericCols = [] }
        // 禁用排序的列集合（黑名单，空数组=全部可排序）；列重排时索引自动同步
        var sdc = opts.get("sort_disabled_cols", [])
        if sdc is Array[int] { sortDisabledCols = sdc } else { sortDisabledCols = [] }
        // 若当前排序列被禁用，清除排序状态
        if is_col_sort_disabled(sortCol) { sortCol = -1; sortDesc = false }

        var hs = opts.get("headers", [])
        if hs is Array[string] { _headers = hs } else { _headers = [] }
        var cws = opts.get("col_widths", [])
        if cws is Array[float] { _colW = cws ; autoCols = (_colW.len() == 0) }
        else { _colW = []; autoCols = true }
        var als = opts.get("aligns", [])
        if als is Array[int] { _aligns = als } else { _aligns = [] }
        var has = opts.get("header_aligns", [])
        if has is Array[int] { headerAligns = has } else { headerAligns = [] }

        var rs = opts.get("rows", [])
        if rs is Array[Array[string]] { _rows = rs } else { _rows = [] }

        ncols = _headers.len()
        if ncols == 0 {
            int m = 0
            for _rows.len() to i { if _rows[i].len() > m { m = _rows[i].len() } }
            ncols = m
        }
        if ncols == 0 { ncols = 1 }
        recompute_cols()

        // 颜色：opts 未传则保持默认值
        if opts.get("bg_color") is Color => t { bgColor = t }
        if opts.get("header_color") is Color => t { hdrColor = t }
        if opts.get("sel_color") is Color => t { selColor = t }
        if opts.get("sep_color") is Color => t { sepColor = t }

        // 行图标配置：image_col 指定哪列显示 [图标+文字]，图标路径由 row_images 独立存储
        imageCol = opts.get("image_col", -1)
        var ri = opts.get("row_images", [])
        if ri is Array[string] { rowImages = ri } else { rowImages = [] }
        _imgSize = opts.get("image_size", 0.0)
        imgMode = opts.get("image_mode", 0)
        imgPad = opts.get("image_pad", 4.0)
        imgGap = opts.get("image_gap", 4.0)

        // 复选框列配置
        checkCol = opts.get("check_col", -1)
        // 单元格内容类型（2026-10-07）：按列给（Array[string]，下标=列），"progress" = 进度条
        //   与 check_col / image_col 一个路子走 opts ✓（运行时还能 set_col_cell_type 改 ✓）
        var cts = opts.get("cell_types", [])
        cellTypes = []
        if cts is Array[string] {
            for cts.len() to k { set_col_cell_type(k, cts[k]) }
        }
        if opts.get("check_color") is Color => t { chkColor = t }
        emptyText = opts.get("empty_text", "暂无数据")
        if opts.get("empty_color") is Color => t { emptyColor = t }
        // 初始化行勾选/颜色数组长度
        while rowChecked.len() < _rows.len() { rowChecked.add(false) }
        while rowColors.len() < _rows.len() { rowColors.add(0) }

        _cursor = opts.get("cursor", SystemCursor.POINTER)
        enabled = opts.get("enabled", true)
        visible = opts.get("visible", true)
        _tip = opts.get("tip", "")
        selRow = -1; selCol = -1; hoverRow = -1; selRows = []; rebuild_sel_set()
        _multi = opts.get("multi_select", opts.get("multi", false))
        scrollX = 0.0; scrollY = 0.0
        sortCol = -1; sortDesc = false
        draggingV = false; draggingH = false
        dragCol = -1
        _editable = opts.get("editable", false)
        cellSelect = opts.get("cell_select", false)
        // 指定哪些列可编辑（空数组=全部可编辑）
        var ec = opts.get("editable_cols", [])
        if ec is Array[int] { editableCols = ec } else { editableCols = [] }
        ensure_font()
        clamp_scroll()
        // 编辑框（朴素写法：在 sdl_table 内部经模块别名 edt 创建，触发传递加载别名 bug）
        _edit = edt.createEdit({x:0, y:0, w:w, h:rowH, font_size:_fontSize, border:false, draw_bg:true, radius:2})
        editing = false
        editRow = -1; editCol = -1
        // 内嵌右击上下文菜单（首次 set 时创建，避免重复注册到全局菜单注册表）
        if ctxMenu == null {
            ctxMenu = menu.createMenuBar({})
            ctxMenu.setWindowSize(winW, winH)
            ctxMenuH = ctxMenu.addContextMenu("table_ctx")
            ctxMenu.on_select(func(string m, string id) { ctx_select(id) })
            menu.registerContextMenu(ctxMenu)
        }
        _loaded = true
    }

    pri func recompute_cols() {
        colWPrefixValid = false
        totalWValid = false
        invalidate_sb()
        invalidate_fitted()
        int n = ncols
        if n <= 0 { n = 1 }
        if autoCols or _colW.len() != n {
            _colW = []
            float cw = w / n
            if cw < 30.0 { cw = 30.0 }
            for n to _ { _colW.add(cw) }
        }
        if _aligns.len() != n {
            _aligns = []
            for n to _ { _aligns.add(0) }
        }
        if headerAligns.len() != n {
            headerAligns = []
            for n to i { int a = 0; if i < _aligns.len() { a = _aligns[i] }; headerAligns.add(a) }
        }
    }

    // ==================== 布局接口 ====================
    func get_w(): float { return w }
    func get_h(): float { return h }
    func get_x(): float { return x }
    func get_y(): float { return y }
    func set_pos(float px, float py) { x = px; y = py; invalidate_sb(); clamp_scroll() }
    func set_size(float sw, float sh) {
        w = sw; h = sh
        if autoCols { recompute_cols() } else { invalidate_sb() }
        clamp_scroll()
    }

    // ==================== 数据操作 ====================
    func set_rows(Array[Array[string]] rs) {
        _rows = rs
        invalidate_fitted(); invalidate_sb()
        int m = 0
        for _rows.len() to i { if _rows[i].len() > m { m = _rows[i].len() } }
        if _headers.len() > 0 { ncols = _headers.len() }
        eif m > 0 { ncols = m } eif ncols == 0 { ncols = 1 }
        recompute_cols()
        clamp_scroll()
        selRow = -1; selRows = []; rebuild_sel_set()
        // ★ 同步 _rowImages / _rowTips / _rowChecked / _rowColors 长度（批量截断避免逐个 remove）
        int nRows = _rows.len()
        if nRows > 0 and rowImages.len() > nRows { rowImages = rowImages[0 : nRows - 1] }
        eif nRows == 0 { rowImages = [] }
        while rowImages.len() < nRows { rowImages.add("") }
        if nRows > 0 and rowTips.len() > nRows { rowTips = rowTips[0 : nRows - 1] }
        eif nRows == 0 { rowTips = [] }
        while rowTips.len() < nRows { rowTips.add("") }
        if nRows > 0 and rowChecked.len() > nRows { rowChecked = rowChecked[0 : nRows - 1] }
        eif nRows == 0 { rowChecked = [] }
        while rowChecked.len() < nRows { rowChecked.add(false) }
        if nRows > 0 and rowColors.len() > nRows { rowColors = rowColors[0 : nRows - 1] }
        eif nRows == 0 { rowColors = [] }
        while rowColors.len() < nRows { rowColors.add(0) }
        checkedCount = -1
        update_check_header()
    }
    func add_row(Array[string] row, string imgPath) {
        _rows.add(row)
        invalidate_fitted(); invalidate_sb()
        rowImages.add(imgPath)
        rowTips.add("")
        rowChecked.add(false)
        rowColors.add(0)
        selSet.add(false)
        if row.len() > ncols and _headers.len() == 0 { ncols = row.len(); recompute_cols() }
        clamp_scroll()
        update_check_header()
    }
    func remove_row(int idx) {
        invalidate_fitted(); invalidate_sb()
        if idx >= 0 and idx < _rows.len() { _rows.remove(idx) }
        if idx >= 0 and idx < rowImages.len() { rowImages.remove(idx) }
        if idx >= 0 and idx < rowTips.len() { rowTips.remove(idx) }
        if idx >= 0 and idx < rowChecked.len() {
            if rowChecked[idx] { checkedCount = -1 }
            rowChecked.remove(idx)
        }
        if idx >= 0 and idx < rowColors.len() { rowColors.remove(idx) }
        if selRow == idx { selRow = -1 }
        eif selRow > idx { selRow = selRow - 1 }
        Array[int] ns = []
        for selRows.len() to i {
            int r = selRows[i]
            if r == idx { continue }
            if r > idx { r = r - 1 }
            ns.add(r)
        }
        selRows = ns
        rebuild_sel_set()
        clamp_scroll()
        update_check_header()
    }
    func clear() { _rows = []; rowImages = []; rowTips = []; rowChecked = []; rowColors = []; selRow = -1; selCol = -1; selRows = []; selSet = []; scrollX = 0; scrollY = 0; checkHeaderState = false; checkedCount = -1; invalidate_fitted(); invalidate_sb() }
    func row_count(): int { return _rows.len() }
    func col_count(): int { return ncols }
    func get_row(int idx): Array[string] {
        if idx >= 0 and idx < _rows.len() { return _rows[idx] }
        return []
    }
    func set_cell(int r, int c, string v) {
        if r >= 0 and r < _rows.len() {
            while _rows[r].len() <= c { _rows[r].add("") }
            _rows[r][c] = v
            invalidate_fitted()
        }
    }
    // 获取单元格文本（供 tooltip 截断检测用）
    pri func cell_text(int r, int c): string {
        if r < 0 or r >= _rows.len() { return "" }
        if c < 0 or c >= _rows[r].len() { return "" }
        return _rows[r][c]
    }
    func get_cell(int r, int c): string {
        return cell_text(r, c)
    }
    func set_headers(Array[string] hs) {
        _headers = hs; ncols = hs.len(); if ncols == 0 { ncols = 1 }
        recompute_cols(); clamp_scroll(); invalidate_fitted()
    }
    pri func is_sel(int r): bool {
        if r < 0 or r >= selSet.len() { return false }
        return selSet[r]
    }
    pri func toggle_sel(int r) {
        while selSet.len() <= r { selSet.add(false) }
        if selSet[r] {
            selSet[r] = false
            int idx = -1
            for selRows.len() to i { if selRows[i] == r { idx = i } }
            if idx >= 0 { selRows.remove(idx) }
        } else {
            selSet[r] = true; selRows.add(r)
        }
    }
    pri func rebuild_sel_set() {
        selSet = []
        while selSet.len() < _rows.len() { selSet.add(false) }
        for selRows.len() to i { if selRows[i] >= 0 and selRows[i] < selSet.len() { selSet[selRows[i]] = true } }
    }
    func set_selected(int idx) { selRows = []; rebuild_sel_set(); if idx >= 0 and idx < _rows.len() { selRow = idx; selRows.add(idx); if idx < selSet.len() { selSet[idx] = true } } }
    func get_selected_row(): int { return selRow }
    func get_selected_rows(): Array[int] { return selRows }
    func set_aligns(Array[int] als) { _aligns = als; if _aligns.len() != ncols { recompute_cols() } }
    func set_header_aligns(Array[int] als) { headerAligns = als; if headerAligns.len() != ncols { recompute_cols() } }
    func set_multi_select(bool m) { _multi = m }
    func select_all() { selRows = []; rebuild_sel_set(); for _rows.len() to i { selRows.add(i); selSet[i] = true }; if selRow < 0 and _rows.len() > 0 { selRow = 0 } }
    func clear_selection() { selRows = []; selRow = -1; rebuild_sel_set() }
    func set_selected_rows(Array[int] rows) {
        selRows = []; rebuild_sel_set()
        for rows.len() to i {
            if rows[i] >= 0 and rows[i] < _rows.len() { selRows.add(rows[i]); if rows[i] < selSet.len() { selSet[rows[i]] = true } }
        }
        if selRows.len() > 0 { selRow = selRows[0] } else { selRow = -1 }
    }

    // ==================== 排序 ====================
    // ★ 交换两行数据及所有并行数组（图标/tip/勾选/颜色），保持对齐
    pri func swap_rows(int i, int j) {
        var tmp = _rows[i]; _rows[i] = _rows[j]; _rows[j] = tmp
        if i < rowImages.len() and j < rowImages.len() {
            string ti = rowImages[i]; rowImages[i] = rowImages[j]; rowImages[j] = ti
        }
        if i < rowTips.len() and j < rowTips.len() {
            string tt = rowTips[i]; rowTips[i] = rowTips[j]; rowTips[j] = tt
        }
        if i < rowChecked.len() and j < rowChecked.len() {
            bool tb = rowChecked[i]; rowChecked[i] = rowChecked[j]; rowChecked[j] = tb
        }
        if i < rowColors.len() and j < rowColors.len() {
            Color tc = rowColors[i]; rowColors[i] = rowColors[j]; rowColors[j] = tc
        }
        // 同步交换单元格级颜色（fg/bg），键格式 "row,col"
        if _cellFgColors.len() > 0 or _cellBgColors.len() > 0 {
            for 0 : ncols - 1 to c {
                string ki = $"{i},{c}"; string kj = $"{j},{c}"
                Color fgi = _cellFgColors.get(ki, 0); Color fgj = _cellFgColors.get(kj, 0)
                if fgi != 0 { _cellFgColors[kj] = fgi } else { _cellFgColors.remove(kj) }
                if fgj != 0 { _cellFgColors[ki] = fgj } else { _cellFgColors.remove(ki) }
                Color bgi = _cellBgColors.get(ki, 0); Color bgj = _cellBgColors.get(kj, 0)
                if bgi != 0 { _cellBgColors[kj] = bgi } else { _cellBgColors.remove(kj) }
                if bgj != 0 { _cellBgColors[ki] = bgj } else { _cellBgColors.remove(ki) }
            }
        }
    }
    // 判断列是否为数值排序列
    pri func is_numeric_col(int col): bool {
        for numericCols.len() to i { if numericCols[i] == col { return true } }
        return false
    }
    // 判断列是否被禁用排序（在 _sortDisabledCols 黑名单中）
    pri func is_col_sort_disabled(int col): bool {
        if col < 0 { return false }
        for sortDisabledCols.len() to i { if sortDisabledCols[i] == col { return true } }
        return false
    }
    // 字符串转 float（失败返回 0.0，不抛异常）
    pri func to_float(string s): float {
        try {
            return _float(s)
        } catch {
            return 0.0
        }
    }
    // 判断字符串是否为可解析的数字（自动数值排序检测用）
    pri func is_number_str(string s): bool {
        if s == "" { return false }
        try {
            _float(s)
            return true
        } catch {
            return false
        }
    }
    // 判断某列排序是否应按数值比较：
    // 1) 显式在 numeric_cols 中指定 → 数值
    // 2) 否则自动检测：该列所有非空值均可解析为数字 → 数值
    //    （避免 "9" > "89" 这类字符串比较 bug：99/90/89 会排成 90,9,89）
    pri func should_numeric_sort(int col): bool {
        if is_numeric_col(col) { return true }
        for _rows.len() to i {
            string v = cell(i, col)
            if v == "" { continue }
            if not is_number_str(v) { return false }
        }
        return true
    }
    // ★ 选择排序替代冒泡：比较次数减半，交换次数从 O(n²) 降为 O(n)
    // 支持 numeric 模式：数值列按 float 比较，避免字符串排序 "10" < "2" 的问题
    // ★ 自动检测：显式 numeric_cols 或全列可解析为数字时按数值比较
    func sort_by(int col, bool desc) {
        sortCol = col; sortDesc = desc
        invalidate_fitted(); invalidate_sb()
        bool numeric = should_numeric_sort(col)
        int n = _rows.len()
        for 0 : n - 1 to i {
            int best = i
            string bestVal = cell(i, col)
            float bestNum = 0.0
            if numeric { bestNum = to_float(bestVal) }
            for i + 1 : n - 1 to j {
                string cur = cell(j, col)
                bool shouldSwap = false
                if numeric {
                    float curNum = to_float(cur)
                    if desc { shouldSwap = (curNum > bestNum) } else { shouldSwap = (curNum < bestNum) }
                } else {
                    if desc { shouldSwap = (cur > bestVal) } else { shouldSwap = (cur < bestVal) }
                }
                if shouldSwap { best = j; bestVal = cur; if numeric { bestNum = to_float(cur) } }
            }
            if best != i { swap_rows(i, best) }
        }
    }

    // ==================== 设置方法 ====================
    func set_font_size(float s) { _fontSize = s; if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null; invalidate_fitted() }
    func set_col_reorder(bool r) { colReorder = r }
    // 动态启用/禁用某列的排序（en=false 时从黑名单追加，en=true 时从黑名单移除）
    func set_col_sortable(int col, bool en) {
        if col < 0 { return }
        if not en {
            if not is_col_sort_disabled(col) { sortDisabledCols.add(col) }
            if sortCol == col { sortCol = -1; sortDesc = false }
        } else {
            for sortDisabledCols.len() to i { if sortDisabledCols[i] == col { sortDisabledCols.remove(i); break } }
        }
    }
    // 整体设置禁用排序的列集合（黑名单，空数组=全部列可排序）
    func set_sort_disabled_cols(Array[int] cols) {
        sortDisabledCols = cols
        if is_col_sort_disabled(sortCol) { sortCol = -1; sortDesc = false }
    }
    // 查询某列是否可排序（全局开关 + 列级黑名单）
    func is_col_sortable(int col): bool {
        return _sortable and not is_col_sort_disabled(col)
    }
    func set_frozen_cols(int n) { frozenCols = n; invalidate_sb(); clamp_scroll() }
    func set_row_reorder(bool r) { rowReorder = r }
    func on_row_reorder(func(int, int):void cb) { onRowReorder = cb }
    // 将行从 srcIdx 移动到 dstIdx 位置（插入到 dstIdx 之前，其他行后移）
    pri func move_row(int srcIdx, int dstIdx) {
        if srcIdx < 0 or dstIdx < 0 or srcIdx >= _rows.len() or dstIdx >= _rows.len() or srcIdx == dstIdx { return }
        invalidate_fitted(); invalidate_sb()
        // 提取源行数据
        var row = _rows[srcIdx]
        string imgP = ""; string tipP = ""; bool chkP = false; int colP = 0
        if srcIdx < rowImages.len() { imgP = rowImages[srcIdx] }
        if srcIdx < rowTips.len() { tipP = rowTips[srcIdx] }
        if srcIdx < rowChecked.len() { chkP = rowChecked[srcIdx] }
        if srcIdx < rowColors.len() { colP = rowColors[srcIdx] }
        // 移除源行
        _rows.remove(srcIdx)
        if srcIdx < rowImages.len() { rowImages.remove(srcIdx) }
        if srcIdx < rowTips.len() { rowTips.remove(srcIdx) }
        if srcIdx < rowChecked.len() { rowChecked.remove(srcIdx) }
        if srcIdx < rowColors.len() { rowColors.remove(srcIdx) }
        // 插入到目标位置
        int insertAt = dstIdx
        if dstIdx > srcIdx { insertAt = dstIdx - 1 }  // 移除后索引偏移
        _rows.insert(insertAt, row)
        rowImages.insert(insertAt, imgP)
        rowTips.insert(insertAt, tipP)
        rowChecked.insert(insertAt, chkP)
        rowColors.insert(insertAt, colP)
        // 同步选中状态
        selRow = insertAt
        selRows = [insertAt]; rebuild_sel_set()
        if insertAt < selSet.len() { selSet[insertAt] = true }
        checkedCount = -1
        clamp_scroll()
        if onRowReorder != null { onRowReorder(srcIdx, dstIdx) }
    }
    // 冻结列总宽度
    pri func frozen_w(): float {
        ensure_col_prefix()
        if frozenCols <= 0 { return 0.0 }
        if frozenCols >= colWPrefix.len() { return colWPrefix[colWPrefix.len() - 1] }
        return colWPrefix[frozenCols]
    }
    // 交换两列顺序：同步交换 headers/colW/aligns/headerAligns 及所有行的列数据
    pri func swap_cols(int a, int b) {
        if a < 0 or b < 0 or a >= ncols or b >= ncols or a == b { return }
        // 交换表头
        if a < _headers.len() and b < _headers.len() { string th = _headers[a]; _headers[a] = _headers[b]; _headers[b] = th }
        // 交换列宽
        if a < _colW.len() and b < _colW.len() { float tw = _colW[a]; _colW[a] = _colW[b]; _colW[b] = tw }
        // 交换对齐
        if a < _aligns.len() and b < _aligns.len() { int ta = _aligns[a]; _aligns[a] = _aligns[b]; _aligns[b] = ta }
        if a < headerAligns.len() and b < headerAligns.len() { int ta = headerAligns[a]; headerAligns[a] = headerAligns[b]; headerAligns[b] = ta }
        // 交换每行的列数据
        for _rows.len() to i {
            if a < _rows[i].len() and b < _rows[i].len() { string tc = _rows[i][a]; _rows[i][a] = _rows[i][b]; _rows[i][b] = tc }
        }
        // 交换 numericCols / sortDisabledCols 中的索引
        for numericCols.len() to i { if numericCols[i] == a { numericCols[i] = b } eif numericCols[i] == b { numericCols[i] = a } }
        for sortDisabledCols.len() to i { if sortDisabledCols[i] == a { sortDisabledCols[i] = b } eif sortDisabledCols[i] == b { sortDisabledCols[i] = a } }
        // ★ 交换单元格内容类型（2026-10-07）：**值**随行数据一起搬（见上面那个 for ✓），但"类型"
        //   是按列的 ⇒ 不跟着换就把"进度条列"留在原地了 ✗（原来的数值列变回文本、原文本列画空条）
        if a < cellTypes.len() and b < cellTypes.len() { string tt = cellTypes[a]; cellTypes[a] = cellTypes[b]; cellTypes[b] = tt }
        // 交换 imageCol / checkCol / sortCol 引用（排序箭头跟随列移动）
        if imageCol == a { imageCol = b } eif imageCol == b { imageCol = a }
        if checkCol == a { checkCol = b } eif checkCol == b { checkCol = a }
        if sortCol == a { sortCol = b } eif sortCol == b { sortCol = a }
        colWPrefixValid = false; totalWValid = false; invalidate_sb(); invalidate_fitted()
    }
    func set_enabled(bool e) { enabled = e }
    func set_visible(bool v) { visible = v }
    func set_resizable(bool r) { _resizable = r }
    func is_visible(): bool { return visible }
    func set_tip(string t) { _tip = t }
    func on_select(func(int):void cb) { onSelect = cb }
    func on_cell(func(int, int):void cb) { onCell = cb }
    // ★ 单元格自绘（2026-10-07）：每格常规内容画完**之后**调一次（矩形已含滚动偏移/冻结列 ✓）
    //   应用可任意叠加（色块 / 徽标 / 迷你折线…）；表格**不接管**格内点击（命中仍是 on_cell ✓）
    func on_cell_draw(func(Renderer, int, int, float, float, float, float):void cb) { onCellDraw = cb }

    // ==================== 行图标设置方法 ====================
    func set_image_col(int c) { imageCol = c; invalidate_fitted() }

    // ==================== 单元格内容类型（2026-10-07 新增）====================
    // 设定某列的内容类型："" / "text"（默认，文本）或 "progress"（进度条）
    //   ⚠ progress 列的**文本被当作数值**（不显示原文！）：`0.37` / `37` / `37%` 都行，
    //     规则见 sdl_progress.parseProgress ✓ ⇒ 那列的 set_cell 要写数值，别写"等待中"
    //     （应用要改显示，改的就该是"值"：set_cell(i, col, _str(pct)) ✓）
    //   ⚠ 别和 image_col 混用同一列：图标 + 进度条会挤在同一格里（本轮不做"图标+条"的组合）
    func set_col_cell_type(int c, string t) {
        if c < 0 { return }
        string v = t
        if v == null { v = "" }
        if v == "text" { v = "" }
        if v != "" and v != "progress" {
            print("[Table] 不认识的 cell_type：\"" + v + "\"（只支持 \"text\" 与 \"progress\"）\n")
            v = ""
        }
        while cellTypes.len() <= c { cellTypes.add("") }
        cellTypes[c] = v
        invalidate_fitted()      // 该列不再画文本 ⇒ 拟合缓存的意义变了（保守失效 ✓）
        core.requestRedraw()
    }
    func get_col_cell_type(int c): string {
        if c < 0 or c >= cellTypes.len() { return "" }
        return cellTypes[c]
    }
    func set_row_image(int row, string path) {
        if row >= 0 and row < rowImages.len() { rowImages[row] = path; invalidate_fitted() }
        eif row >= 0 {
            while rowImages.len() <= row { rowImages.add("") }
            rowImages[row] = path
        }
    }
    func get_row_image(int row): string {
        if row >= 0 and row < rowImages.len() { return rowImages[row] }
        return ""
    }
    func set_row_tip(int row, string tip) {
        if row >= 0 and row < rowTips.len() { rowTips[row] = tip }
        eif row >= 0 {
            while rowTips.len() <= row { rowTips.add("") }
            rowTips[row] = tip
        }
    }
    func set_image_size(float s) { _imgSize = s; invalidate_fitted() }
    func set_image_mode(int m) { imgMode = m }
    func set_image_pad(float p) { imgPad = p; invalidate_fitted() }
    func set_image_gap(float g) { imgGap = g; invalidate_fitted() }

    // ==================== 复选框列 ====================
    func set_check_col(int c) { checkCol = c }
    func is_row_checked(int row): bool {
        if row >= 0 and row < rowChecked.len() { return rowChecked[row] }
        return false
    }
    func set_row_checked(int row, bool on) {
        if row >= 0 and row < rowChecked.len() {
            if rowChecked[row] != on { checkedCount = -1 }
            rowChecked[row] = on
            update_check_header()
            if onCheck != null { onCheck(checkCol, _get_checked_rows()) }
        }
    }
    func get_checked_rows(): Array[int] { return _get_checked_rows() }
    func check_all() {
        for rowChecked.len() to i { rowChecked[i] = true }
        checkHeaderState = true; checkedCount = rowChecked.len()
        if onCheck != null { onCheck(checkCol, _get_checked_rows()) }
    }
    func uncheck_all() {
        for rowChecked.len() to i { rowChecked[i] = false }
        checkHeaderState = false; checkedCount = 0
        if onCheck != null { onCheck(checkCol, []) }
    }
    func _get_checked_rows(): Array[int] {
        Array[int] out = []
        for rowChecked.len() to i { if rowChecked[i] { out.add(i) } }
        return out
    }
    // ★ 缓存已勾选行计数，避免 render 表头中每帧遍历 _rowChecked
    pri func get_checked_count(): int {
        if checkedCount >= 0 { return checkedCount }
        checkedCount = 0
        for rowChecked.len() to i { if rowChecked[i] { checkedCount = checkedCount + 1 } }
        return checkedCount
    }
    // 根据行勾选状态更新表头全选框状态
    pri func update_check_header() {
        if checkCol < 0 { return }
        int cnt = get_checked_count()
        checkHeaderState = (cnt > 0 and cnt == rowChecked.len())
    }
    func on_check(func(int, Array[int]):void cb) { onCheck = cb }

    // ==================== 行级颜色 ====================
    // color 为 0xRRGGBB 整数（如 0xFF4040 表红色），0 表示恢复默认色
    func set_row_color(int row, Color color) {
        if row >= 0 {
            while rowColors.len() <= row { rowColors.add(0) }
            rowColors[row] = color
        }
    }
    func get_row_color(int row): Color {
        if row >= 0 and row < rowColors.len() { return rowColors[row] }
        return 0
    }
    func clear_row_colors() {
        for rowColors.len() to i { rowColors[i] = 0 }
    }

    // ==================== 单元格级颜色 ====================
    // color 为 0xRRGGBB 整数，0 表示清除该单元格的自定义颜色
    func set_cell_fg(int row, int col, Color color) {
        if row < 0 or col < 0 { return }
        _cellFgColors[$"{row},{col}"] = color
    }
    func set_cell_bg(int row, int col, Color color) {
        if row < 0 or col < 0 { return }
        _cellBgColors[$"{row},{col}"] = color
    }
    func get_cell_fg(int row, int col): Color {
        return _cellFgColors.get($"{row},{col}", 0)
    }
    func get_cell_bg(int row, int col): Color {
        return _cellBgColors.get($"{row},{col}", 0)
    }
    func clear_cell_colors() {
        _cellFgColors.clear(); _cellBgColors.clear()
    }

    // ==================== 列宽约束 ====================
    // 设置某列的最小/最大宽度
    func set_col_min_width(int col, float w) {
        if col < 0 { return }
        while colMinW.len() <= col { colMinW.add(minColW) }
        colMinW[col] = w
    }
    func set_col_max_width(int col, float w) {
        if col < 0 { return }
        while colMaxW.len() <= col { colMaxW.add(maxColW) }
        colMaxW[col] = w
    }
    // 获取某列的有效最小宽度
    pri func col_min_w(int col): float {
        if col >= 0 and col < colMinW.len() { return colMinW[col] }
        return minColW
    }
    // 获取某列的有效最大宽度
    pri func col_max_w(int col): float {
        if col >= 0 and col < colMaxW.len() { return colMaxW[col] }
        return maxColW
    }

    // ==================== 空状态 ====================
    func set_empty_text(string t) { emptyText = t }

    // ==================== 右击上下文菜单（默认不预置任何项，由应用层自定义） ====================
    // 设置所属窗口逻辑宽高，供上下文菜单弹出时做边界夹紧
    func set_window_size(int ww, int hh) {
        winW = ww; winH = hh
        ctxMenu?.setWindowSize(ww, hh)
    }
    // ★ Widget 接口：窗口 resize 时自动同步尺寸到内部菜单
    func on_window_resize(int ww, int hh) {
        set_window_size(ww, hh)
    }
    // 记录所属窗口句柄，供内嵌右击菜单按窗口隔离绘制
    // ★ 同时传递给内嵌 Edit，使其 IME 候选框能正确定位（否则 _hwnd 为 null，IME 位置默认 0,0）
    func set_window_handle(Ptr[u8] hwnd) {
        _hwnd = hwnd
        ctxMenu?.setWindowHandle(hwnd)
        _edit?.set_window(hwnd)
    }
    // 启用/禁用右击上下文菜单
    func set_context_menu_enabled(bool en) { ctxMenuEnabled = en }
    func is_context_menu_enabled(): bool { return ctxMenuEnabled }
    // 向上下文菜单追加一项，返回项在菜单内索引（可用于挂子菜单）
    func addContextItem(Dict opts): int {
        if ctxMenu == null or ctxMenuH < 0 { return -1 }
        return ctxMenu.addContextItem(ctxMenuH, opts)
    }
    // 向上下文菜单追加分隔线
    func addContextSeparator() {
        if ctxMenu == null or ctxMenuH < 0 { return }
        ctxMenu.addContextSeparator(ctxMenuH)
    }
    // 按 id 动态启用/禁用某个上下文菜单项（供调用方按当前状态刷新）
    func setContextItemEnabled(string id, bool en) {
        if ctxMenu != null and ctxMenuH >= 0 { ctxMenu.setContextItemEnabled(ctxMenuH, id, en) }
    }
    // 返回内嵌上下文菜单（MenuBar），应用可经 addContextItem 等进一步扩展或挂子菜单
    func get_context_menu(): MenuBar { return ctxMenu }
    func get_context_menu_handle(): int { return ctxMenuH }
    // 右击时记录的行/列（在 on_context_select 回调内可读，定位操作目标）
    func get_context_menu_row(): int { return ctxRow }
    func get_context_menu_col(): int { return ctxCol }
    // 注册上下文菜单自定义回调（参数为命中行与项 id）；也可直接在 addContextItem 的 opts 里写 action
    func on_context_select(func(int, string):void cb) { onCtxSelect = cb }
    // 注册“右键菜单弹出前”回调（参数为命中行，row<0 表示空白处）；用于按行类型动态重建菜单项
    func on_context_will_open(func(int):void cb) { onCtxWillOpen = cb }
    // 清空内嵌上下文菜单的全部项（配合 on_context_will_open 在弹出前重建）
    func clearContextItems() {
        if ctxMenu != null and ctxMenuH >= 0 { ctxMenu.clearContextItems(ctxMenuH) }
    }
    // 注册行内编辑提交回调（行,列,新文本）；如用于右键“重命名”后落盘
    func on_edit_commit(func(int, int, string):void cb) { onEditCommit = cb }
    // 程序触发进入某行某列的行内编辑（如右键"重命名"、F2 快捷键）
    // ★ 程序化调用绕过 _editable 全局开关：应用层已明确知道要编辑哪个单元格，
    //   不应被默认关闭的双击编辑开关拦截。仍受 _editableCols 列级限制约束（若指定）。
    func begin_edit(int row, int col) {
        if row < 0 or row >= _rows.len() { return }
        if col < 0 or col >= ncols { return }
        // 列级限制：若指定了可编辑列集合，则仅允许这些列
        if editableCols.len() > 0 {
            bool ok = false
            for editableCols.len() to i { if editableCols[i] == col { ok = true } }
            if not ok { return }
        }
        editRow = row; editCol = col
        float cx = col_x(col)
        float ry = y + headerH - scrollY + row * rowH
        _edit.set_pos(cx, ry)
        _edit.set_size(_colW[col], rowH)
        _edit.set_font_size(_fontSize)
        _edit.set_text(cell(row, col))
        _edit.focus()
        editing = true
    }

    // 在 (x,y) 弹出上下文菜单，并记录右击命中的行/列
    pri func open_ctx_menu(float x, float y, int keyMod) {
        if ctxMenu == null or ctxMenuH < 0 { return }
        ctxRow = row_at(y); ctxCol = col_at(x)
        // 右击命中数据行时，更新选中状态
        if ctxRow >= 0 {
            // ★ 多选模式右击选中逻辑（对齐 Windows 资源管理器行为）：
            //   - 右击行已选中 → 保持当前多选状态不变（仅更新 _selRow 为当前行）
            //   - 右击行未选中 + 无 Ctrl → 替换为唯一选中项（清除旧多选）
            //   - 右击行未选中 + Ctrl → 追加到多选集
            if not is_sel(ctxRow) {
                selRow = ctxRow
                if _multi {
                    int MOD_CTRL = 64
                    if (keyMod & MOD_CTRL) != 0 {
                        selRows.add(ctxRow)       // Ctrl+右击：追加到多选
                        while selSet.len() <= ctxRow { selSet.add(false) }
                        selSet[ctxRow] = true
                    } else {
                        selRows = [ctxRow]; rebuild_sel_set()
                        if ctxRow < selSet.len() { selSet[ctxRow] = true }
                    }
                } else {
                    selRows = [ctxRow]; rebuild_sel_set()
                    if ctxRow < selSet.len() { selSet[ctxRow] = true }
                }
                if onSelect != null { onSelect(ctxRow) }
            } eif _multi {
                // 多选模式下右击已选中行：仅更新 selRow 为当前行，保持 _selRows 不变
                selRow = ctxRow
                if onSelect != null { onSelect(ctxRow) }
            } else {
                // 单选模式：正常选中
                selRow = ctxRow; selRows = [ctxRow]; rebuild_sel_set()
                if ctxRow < selSet.len() { selSet[ctxRow] = true }
                if onSelect != null { onSelect(ctxRow) }
            }
        }
        // 弹出前把命中行交给应用层，由它按行类型重建菜单项（文件/文件夹/空白处不同）
        if onCtxWillOpen != null { onCtxWillOpen(ctxRow) }
        // 重建后仍无任何有效项则不弹菜单（避免出现空白横线）
        if ctxMenu.contextItemCount(ctxMenuH) == 0 { return }
        ctxMenu.openContext(ctxMenuH, x, y)
    }
    // 上下文菜单项动作分发
    pri func ctx_select(string id) {
        if onCtxSelect != null { onCtxSelect(ctxRow, id) }
    }

    // ==================== 双击编辑 ====================
    func _begin_edit(int row, int col) {
        if row < 0 or row >= _rows.len() { return }
        if col < 0 or col >= ncols { return }
        if not is_col_editable(col) { return }
        editRow = row; editCol = col
        float cx = col_x(col)
        float ry = y + headerH - scrollY + row * rowH
        _edit.set_pos(cx, ry)
        _edit.set_size(_colW[col], rowH)
        _edit.set_font_size(_fontSize)
        _edit.set_text(cell(row, col))
        _edit.focus()
        editing = true
    }
    pri func commit_edit() {
        if editRow >= 0 and editCol >= 0 and editRow < _rows.len() {
            string newText = _edit.get_text()
            set_cell(editRow, editCol, newText)
            if onEditCommit != null { onEditCommit(editRow, editCol, newText) }
        }
        editing = false
        editRow = -1; editCol = -1
        _lastClickTime = -100000
        _edit.blur()    // 停止闪烁定时器，避免每 500ms 空跑 requestRedraw 导致 Table 闪烁
    }
    func is_editing(): bool { return editing }
    // 启用/禁用双击进入单元格编辑（默认关闭）
    func set_editable(bool en) { _editable = en }
    func set_cell_select(bool en) { cellSelect = en }
    func is_editable(): bool { return _editable }
    func set_col_editable(int col, bool en) {
        if en {
            bool found = false
            for editableCols.len() to i { if editableCols[i] == col { found = true } }
            if not found { editableCols.add(col) }
        } else {
            int idx = -1
            for editableCols.len() to i { if editableCols[i] == col { idx = i } }
            if idx >= 0 { editableCols.remove(idx) }
        }
    }
    // 判断某列是否可编辑
    pri func is_col_editable(int col): bool {
        if not _editable { return false }
        if col < 0 { return false }
        // 空数组=全部可编辑
        if editableCols.len() == 0 { return true }
        for editableCols.len() to i { if editableCols[i] == col { return true } }
        return false
    }
    // 双击单元格回调：无论是否可编辑都会触发，便于应用层自定义（如文件管理器双击打开）
    func on_dbl_click(func(int, int):void cb) { onDblClick = cb }
    func edit_debug(): string {
        if _edit == null { return "edit=null" }
        if _edit.is_loaded() { return "edit.loaded=true" }
        return "edit.loaded=false"
    }

    func contains(float mx, float my): bool {
        return mx >= x and mx <= x + w and my >= y and my <= y + h
    }

    // ==================== 交互 ====================
    func process(Event ev) {
        if not _loaded or not visible or not enabled {
            hoverRow = -1; draggingV = false; draggingH = false; dragCol = -1
            return
        }
        var[float, float](mx, my) = ev.mousePos()
        if ev.isMouseWheel() { mx = ev.wheelMouseX(); my = ev.wheelMouseY() }

        // 内嵌右击上下文菜单已展开：所有事件先交菜单处理（选择/关闭由菜单自身负责）
        if ctxMenuEnabled and ctxMenu != null and ctxMenu.isOpen() {
            if ev.isMouseButtonDown() and ev.mouseButton() == 3 {
                ctxMenu.close()
                if contains(mx, my) { open_ctx_menu(mx, my, ev.keyMod()) }
                return
            }
            ctxMenu.process(ev)
            return
        }

        // ★ 修复：编辑中且 Edit 的右击菜单展开时，事件必须经 Edit 转发给菜单处理。
        //   若先走 inPopupCapture 拦截，Edit 的菜单将收不到点击事件，导致菜单项无法选中。
        //   菜单因点击菜单项而关闭后，Edit 应保持编辑状态（不提交），下一次真正点击 Edit
        //   外部时才由下方的 _editing 分支提交。
        if editing and _edit.isContextMenuOpen() {
            _edit.process(ev)
            return
        }

        if core.inPopupCapture(mx, my) { return }

        // 编辑中：事件转发给编辑框
        if editing {
            _edit.process(ev)
            if ev.isKeyDown() and ev.scancode() == core.Scancode.RETURN { commit_edit() }
            eif ev.isKeyDown() and ev.scancode() == core.Scancode.ESCAPE {
                // Esc 取消编辑（不提交）
                editing = false
                editRow = -1; editCol = -1
                _lastClickTime = -100000
                _edit.blur()
            }
            eif ev.isKeyDown() and ev.scancode() == core.Scancode.TAB {
                // Tab 跳到下一个可编辑单元格
                commit_edit()
                int nr = editRow, nc = editCol + 1
                while nr < _rows.len() {
                    while nc < ncols {
                        if is_col_editable(nc) { _begin_edit(nr, nc); return }
                        nc++
                    }
                    nc = 0
                    nr++
                }
            }
            eif ev.isMouseButtonDown() {
                var[float, float](_ex, _ey) = ev.mousePos()
                if not _edit.contains(_ex, _ey) { commit_edit() }
            }
            return
        }

        // 键盘导航：表格聚焦时处理方向键/Enter/PageUp/PageDown/Home/End/Ctrl+A
        if ev.isKeyDown() {
            int sc = ev.scancode()
            int mod = ev.keyMod()
            switch sc {
                case core.Scancode.UP {
                    if _rows.len() == 0 { return }
                    int r = selRow - 1
                    if selRow < 0 { r = 0 }
                    if r < 0 { r = 0 }
                    select_key(r)
                    return
                }
                case core.Scancode.DOWN {
                    if _rows.len() == 0 { return }
                    int r = selRow + 1
                    if selRow < 0 { r = 0 }
                    if r >= _rows.len() { r = _rows.len() - 1 }
                    select_key(r)
                    return
                }
                case core.Scancode.HOME {
                    if _rows.len() == 0 { return }
                    select_key(0)
                    return
                }
                case core.Scancode.END {
                    if _rows.len() == 0 { return }
                    select_key(_rows.len() - 1)
                    return
                }
                case core.Scancode.PAGEUP {
                    if _rows.len() == 0 { return }
                    var sbP = compute_sb()
                    float bodyH = h - headerH - sbP[1]
                    if bodyH < 0 { bodyH = 0 }
                    int pageSteps = _int(bodyH / rowH)
                    if pageSteps < 1 { pageSteps = 1 }
                    int r = selRow - pageSteps
                    if r < 0 { r = 0 }
                    select_key(r)
                    return
                }
                case core.Scancode.PAGEDOWN {
                    if _rows.len() == 0 { return }
                    var sbP = compute_sb()
                    float bodyH = h - headerH - sbP[1]
                    if bodyH < 0 { bodyH = 0 }
                    int pageSteps = _int(bodyH / rowH)
                    if pageSteps < 1 { pageSteps = 1 }
                    int r = selRow + pageSteps
                    if r >= _rows.len() { r = _rows.len() - 1 }
                    select_key(r)
                    return
                }
                case core.Scancode.RETURN {
                    if selRow >= 0 and selRow < _rows.len() {
                        if onDblClick != null { onDblClick(selRow, selCol) }
                        if is_col_editable(selCol) { _begin_edit(selRow, selCol) }
                    }
                    return
                }
                case core.Scancode.A {
                    // Ctrl+A 全选（未按 Ctrl 时不拦截，让事件继续传递）
                    if (mod & 64) != 0 or (mod & 128) != 0 {
                        if _multi { select_all() }
                        return
                    }
                }
            }
        }

        // ★ 拖动状态清理必须在 contains 检查之前：
        //   鼠标拖动滚动条时移出表格区域，若 contains 拦截了 mouse up 事件，
        //   _draggingV/H 不会被清除 → 重新进入表格时无需按住即可拖动滚动条
        if ev.isMouseButtonUp() {
            // 列重排拖拽结束：确定目标列并执行交换
            if reorderDragging and dragReorderCol >= 0 {
                int targetCol = col_at(mx)
                if targetCol >= 0 and targetCol != dragReorderCol {
                    swap_cols(dragReorderCol, targetCol)
                }
            }
            // 行重排拖拽结束：确定目标行并执行交换
            if rowReorderDragging and dragReorderRow >= 0 {
                int targetRow = row_at(my)
                if targetRow >= 0 and targetRow != dragReorderRow {
                    move_row(dragReorderRow, targetRow)
                }
            }
            draggingV = false; draggingH = false; dragCol = -1
            dragReorderCol = -1; reorderDragging = false
            dragReorderRow = -1; rowReorderDragging = false
        }

        // ★ 拖动滚动条时鼠标移出表格区域仍需继续跟随，否则滚动条卡住不动
        if draggingV and ev.isMouseMotion() {
            var sbV = compute_sb()
            float hhV = sbV[1]
            float maxY = max_scroll_y(); if maxY <= 0 { maxY = 1 }
            float bodyH = h - headerH - hhV
            float track = bodyH - 4.0
            float contentH = _rows.len() * rowH; if contentH <= 0 { contentH = 1 }
            float thumbH = maths.max(18.0, maths.min(bodyH * bodyH / contentH, bodyH))
            scrollY = (my - (y + headerH + 2.0) - vDragOffset) * (maxY / (track - thumbH))
            clamp_scroll()
            core.markFrameRedraw()
            return
        }
        if draggingH and ev.isMouseMotion() {
            var sbH = compute_sb()
            float vwH = sbH[0]
            float maxX = max_scroll_x(); if maxX <= 0 { maxX = 1 }
            float bodyW = w - vwH
            float track = bodyW - 4.0
            float tw = total_w(); if tw <= 0 { tw = 1 }
            float thumbW = maths.max(18.0, maths.min(bodyW * bodyW / tw, bodyW))
            scrollX = (mx - (x + 2.0) - hDragOffset) * (maxX / (track - thumbW))
            clamp_scroll()
            core.markFrameRedraw()
            return
        }
        // ★ 列宽拖动中：鼠标移出表格仍继续跟随（与滚动条同理）
        if dragCol >= 0 and ev.isMouseMotion() {
            float nw = dragStartW + (mx - _dragStartX)
            float minW = col_min_w(dragCol)
            float maxW = col_max_w(dragCol)
            if nw < minW { nw = minW }
            if nw > maxW { nw = maxW }
            if dragCol >= 0 and dragCol < _colW.len() { _colW[dragCol] = nw; colWPrefixValid = false; totalWValid = false; invalidate_sb(); invalidate_fitted() }
            autoCols = false
            clamp_scroll()
            core.markFrameRedraw()
            core.requestCursor(SystemCursor.EW_RESIZE)
            return
        }

        // 列重排拖拽中：跟随鼠标移动绘制指示线
        if reorderDragging and ev.isMouseMotion() {
            reorderDragX = mx
            core.markFrameRedraw()
            return
        }

        // 行重排拖拽中：跟随鼠标移动绘制指示线
        if rowReorderDragging and ev.isMouseMotion() {
            rowReorderDragY = my
            // 自动滚动：拖到视口顶部/底部边缘时滚动
            float bodyTop = y + headerH
            float bodyBot = y + h
            if my < bodyTop + 30.0 { scrollY = scrollY - 3.0 * rowH; clamp_scroll() }
            eif my > bodyBot - 30.0 { scrollY = scrollY + 3.0 * rowH; clamp_scroll() }
            core.markFrameRedraw()
            return
        }

        // 仅处理命中表格区域内的事件（表格外点击/悬停不触发表头与行交互）
        if not contains(mx, my) {
            hoverRow = -1
            hoverColForTip = -1; hoverTipText = ""
            return
        }

        var sb = compute_sb()
        float vw = sb[0], hh = sb[1]

        // 竖向滚动条
        if vw > 0.0 {
            float sx = x + w - vw - 2.0
            bool inV = mx >= sx - 2.0 and mx <= sx + vw + 2.0 and my >= y + headerH and my <= y + h - hh
            if ev.isMouseButtonDown() and inV {
                float maxY = max_scroll_y(); if maxY <= 0 { maxY = 1 }
                float bodyH = h - headerH - hh
                float track = bodyH - 4.0
                float contentH = _rows.len() * rowH; if contentH <= 0 { contentH = 1 }
                float thumbH = maths.max(18.0, maths.min(bodyH * bodyH / contentH, bodyH))
                float thy = y + headerH + 2.0 + (scrollY / maxY) * (track - thumbH)
                if my >= thy and my <= thy + thumbH { draggingV = true; vDragOffset = my - thy }
                else {
                    draggingV = true; vDragOffset = thumbH / 2.0
                    scrollY = (my - (y + headerH + 2.0) - thumbH / 2.0) * (maxY / (track - thumbH))
                    clamp_scroll()
                }
                return
            }
        }

        // 横向滚动条
        if hh > 0.0 {
            float sy = y + h - hh - 2.0
            bool inH = my >= sy - 2.0 and my <= sy + hh + 2.0 and mx >= x and mx <= x + w - vw
            if ev.isMouseButtonDown() and inH {
                float maxX = max_scroll_x(); if maxX <= 0 { maxX = 1 }
                float bodyW = w - vw
                float track = bodyW - 4.0
                float tw = total_w(); if tw <= 0 { tw = 1 }
                float thumbW = maths.max(18.0, maths.min(bodyW * bodyW / tw, bodyW))
                float thx = x + 2.0 + (scrollX / maxX) * (track - thumbW)
                if mx >= thx and mx <= thx + thumbW { draggingH = true; hDragOffset = mx - thx }
                else {
                    draggingH = true; hDragOffset = thumbW / 2.0
                    scrollX = (mx - (x + 2.0) - thumbW / 2.0) * (maxX / (track - thumbW))
                    clamp_scroll()
                }
                return
            }
        }

        if ev.isMouseWheel() {
            if not contains(ev.wheelMouseX(), ev.wheelMouseY()) { return }
            int mod = ev.keyMod()
            if (mod & 1) != 0 { scrollX = scrollX - ev.wheelX() * 24.0 }
            else { scrollY = scrollY - ev.wheelY() * rowH }
            clamp_scroll()
            return
        }

        if ev.isMouseMotion() {
            // 列重排拖拽阈值检测：鼠标移动超过 5px 后进入拖拽状态
            if dragReorderCol >= 0 and not reorderDragging {
                float dx = mx - reorderStartX
                if dx > 5.0 or dx < -5.0 {
                    reorderDragging = true
                    reorderDragX = mx
                    core.markFrameRedraw()
                    return
                }
            }
            // 行重排拖拽阈值检测
            if dragReorderRow >= 0 and not rowReorderDragging {
                float dy = my - rowReorderStartY
                if dy > 5.0 or dy < -5.0 {
                    rowReorderDragging = true
                    rowReorderDragY = my
                    core.markFrameRedraw()
                    return
                }
            }
            int prevHover = hoverRow
            int prevHoverCol = hoverCol
            // ★ X 边界检查：_row_at 只验证 Y 坐标，不检查 X。
            if mx >= x and mx <= x + w {
                hoverRow = row_at(my)
                hoverCol = col_at(mx)
            } else {
                hoverRow = -1; hoverCol = -1
            }
            bool hv = hoverRow >= 0
            if hoverRow != prevHover or hoverCol != prevHoverCol { core.markFrameRedraw() } else { core.markFrameMotion() }
            if dragCol >= 0 {
                float nw = dragStartW + (mx - _dragStartX)
                if nw < 24.0 { nw = 24.0 }
                if dragCol >= 0 and dragCol < _colW.len() { _colW[dragCol] = nw; colWPrefixValid = false; totalWValid = false; invalidate_sb(); invalidate_fitted() }
                autoCols = false
                clamp_scroll()
                core.markFrameRedraw()
                core.requestCursor(SystemCursor.EW_RESIZE)
            } eif my < y + headerH {
                int rc = header_resize_col(mx)
                if rc >= 0 { core.requestCursor(SystemCursor.EW_RESIZE) }
                eif hv and _cursor >= 0 { core.requestCursor(_cursor) }
            } eif hv and _cursor >= 0 {
                core.requestCursor(_cursor)
            }
            string rt = if hoverRow >= 0 and hoverRow < rowTips.len() then rowTips[hoverRow] else ""
            // ★ Tooltip 节流：仅在悬停目标（行/单元格）变化时调用 tipReport（重置延迟计时器），
            //   同一目标内的鼠标移动调用 tipKeep（保持 tooltip 活跃但不重置计时器）。
            //   旧方案每次 motion 都调 tipReport → _tipStart 恒被重置 → tipWaiting() 恒 true
            //   → 窗口 60fps 空转重绘。新方案让计时器从首次进入目标起自然到期，到期后
            //   tipRemainingMs()==0 触发一次重绘显示 tooltip，之后不再额外重绘。
            bool prevHv = prevHover >= 0
            if _tip != "" {
                if hv {
                    // 表级 tip：仅进出表格时重置延迟，表格内移动不重置
                    if hv != prevHv { tip.tipReport(_tip, mx, my) }
                    else { tip.tipKeep(mx, my) }
                }
            } eif rt != "" and hv {
                // 行级自定义 tip：仅跨行时重置延迟，同行内移动不重置
                if hoverRow != prevHover { tip.tipReport(rt, mx, my) }
                else { tip.tipKeep(mx, my) }
            } eif hv {
                // 单元格 Tooltip：文字被截断时悬停显示完整内容
                // 优化：仅当悬停单元格(行+列)变化时才做 measureString 截断检查，
                //       同一单元格内的鼠标移动直接复用缓存的 tooltip 文本，
                //       避免每次 mouse motion 都调 measureString（线性扫描 256 槽缓存）
                int hc = col_at(mx)
                if hc >= 0 {
                    bool cellChanged = (hoverRow != prevHover or hc != hoverColForTip)
                    if cellChanged {
                        hoverColForTip = hc
                        hoverTipText = ""
                        string cellText = cell_text(hoverRow, hc)
                        if cellText != "" and cellText != null {
                            float iconOff = 0.0
                            if hc == imageCol and hoverRow < rowImages.len() {
                                string ip = rowImages[hoverRow]
                                if ip != "" and ip != null { iconOff = rowH * 0.7 }
                            }
                            float pad = 8.0
                            float availW = _colW[hc] - 2.0 * pad - iconOff
                            var[float, float](_fw, _fh) = _font.measureString(cellText); float fullW = _fw
                            if fullW > availW { hoverTipText = cellText }
                        }
                    }
                    // 复用缓存的 tooltip 文本保持 tooltip 可见
                    // ★ 优化：同一单元格内用 tipKeep 替代 tipReport，不重置延迟计时器
                    if hoverTipText != "" {
                        float cellX = col_x(hc)
                        float cellCY = y + headerH - scrollY + hoverRow * rowH + rowH / 2.0
                        if cellChanged { tip.tipReport(hoverTipText, cellX, cellCY) }
                        else { tip.tipKeep(cellX, cellCY) }
                    }
                }
            }
        }

        if ev.isMouseButtonDown() {
            // 右击：在表格内弹出上下文菜单（默认无预置项，由应用层自定义）
            if ctxMenuEnabled and ctxMenu != null and ev.mouseButton() == 3 {
                if contains(mx, my) { open_ctx_menu(mx, my, ev.keyMod()) }
                return
            }
            if my < y + headerH {
                // 表头复选框：点击全选/全不选
                if checkCol >= 0 and is_in_checkbox(mx, my, true, -1) {
                    if checkHeaderState { uncheck_all() } else { check_all() }
                    return
                }
                int rc = header_resize_col(mx)
                if rc >= 0 {
                    dragCol = rc; _dragStartX = mx; dragStartW = _colW[rc]
                    autoCols = false
                    return
                }
                int col = col_at(mx)
                // 列重排：记录拖拽起点（延迟到 mouseMotion 超过阈值时才进入拖拽状态）
                if col >= 0 and colReorder {
                    dragReorderCol = col; reorderStartX = mx; reorderDragging = false
                }
                if col >= 0 and _sortable and not is_col_sort_disabled(col) { sort_by(col, not (sortCol == col and sortDesc)) }
            } else {
                int row = row_at(my)
                int col = col_at(mx)
                if row >= 0 {
                    // 行复选框点击
                    if checkCol >= 0 and col == checkCol and is_in_checkbox(mx, my, false, row) {
                        set_row_checked(row, not is_row_checked(row))
                        return
                    }
                    int now = core.getTicks()
                    bool isDbl = now - _lastClickTime < 400
                            and mx >= lastClickX - 10 and mx <= lastClickX + 10
                            and my >= lastClickY - 10 and my <= lastClickY + 10
                    _lastClickTime = now
                    lastClickX = mx; lastClickY = my
                    if isDbl and col >= 0 {
                        if onDblClick != null { onDblClick(row, col) }
                        if is_col_editable(col) { _begin_edit(row, col) }
                        return
                    }
                    if _multi {
                        int MOD_SHIFT = 1, MOD_CTRL = 64
                        int mod = ev.keyMod()
            bool shift = (mod & MOD_SHIFT) != 0, ctrl = (mod & MOD_CTRL) != 0
                        if shift and selRow >= 0 {
                            int a = selRow, b = row
                            if a > b { int t = a; a = b; b = t }
                            selRows = []
                            for a : b to k { selRows.add(k) }
                            rebuild_sel_set()
                            for a : b to k { if k < selSet.len() { selSet[k] = true } }
                        } eif ctrl {
                            toggle_sel(row)
                        } else {
                            selRows = [row]; rebuild_sel_set()
                            if row < selSet.len() { selSet[row] = true }
                        }
                        selRow = row
                    } else {
                        selRows = [row]; rebuild_sel_set()
                        if row < selSet.len() { selSet[row] = true }
                        selRow = row
                    }
                    selCol = col
                    // 行拖拽重排：记录拖拽起点
                    if rowReorder {
                        dragReorderRow = row; rowReorderStartY = my; rowReorderDragging = false
                    }
                    if onSelect != null { onSelect(row) }
                    if onCell != null and col >= 0 { onCell(row, col) }
                }
            }
        }
    }

    // ==================== 复选框命中测试与绘制 ====================
    // 判断点击是否落在复选框区域。isHeader=true 时用表头坐标(row 忽略)；否则用数据行坐标
    pri func is_in_checkbox(float mx, float my, bool isHeader, int row): bool {
        if checkCol < 0 { return false }
        float cx = col_x(checkCol)
        float cw = _colW[checkCol]
        float boxSize = 14.0
        float bx = cx + (cw - boxSize) / 2.0
        float by
        if isHeader {
            by = y + (headerH - boxSize) / 2.0
        } else {
            if row < 0 { return false }
            float ry = y + headerH - scrollY + row * rowH
            by = ry + (rowH - boxSize) / 2.0
        }
        return mx >= bx and mx <= bx + boxSize and my >= by and my <= by + boxSize
    }

    // 在指定单元格中心绘制复选框。checked=是否勾选，partial=是否半选(仅表头)
    pri func draw_checkbox(Renderer r, float cx, float cw, float ry, float rh, bool checked, bool partial) {
        float boxSize = 14.0
        float bx = r.snapX(cx + (cw - boxSize) / 2.0)
        float by = r.snapY(ry + (rh - boxSize) / 2.0)
        // ★ 水平边界保护：表头在 bodyClip 之外绘制（无全表 clip），
        //   完全滚出 Table 水平范围的复选框跳过，防止画出 Table 左/右边界。
        if bx + boxSize < x or bx > x + w { return }
        if checked or partial {
            // ★ 2026-10-07 与 CheckBox 统一：勾选态**不填满**，改为"主题色描边 + 主题色勾线"
            //   （原来这里是 fillRect 实心块 + 近白勾线，和 CheckBox 控件两套观感 ✗）
            Color bc = chkColor
            // ★ 勾线**跟描边同色**：勾选态不填满 ⇒ 用 txtOnAccent（白）在白底上就是"看不见的勾" ✗
            Color mc = bc
            if partial {
                // 半选（表头三态的"部分选中"）：保持灰色调，只是同样不填满
                bc = theme.packColor(100, 110, 125)
                mc = bc
            }
            if not enabled {
                // 禁用 = 向背景褪色（darken 在浅色主题下会变深、反而更显眼 ✗）
                Color bg = theme.getTheme().bg
                bc = theme.mixbg(bc, bg, 55)
                mc = theme.mixbg(mc, bg, 55)
            }
            r.setColor(bc)
            r.drawRect(bx, by, boxSize, boxSize)
            // 勾号（checked）或横杠（partial 半选）
            r.setColor(mc)
            if checked {
                r.drawLine(bx + 3.0, by + 7.5, bx + 6.0, by + 10.5)
                r.drawLine(bx + 6.0, by + 10.5, bx + 11.0, by + 4.5)
            } eif partial {
                r.drawLine(bx + 3.0, by + 7.0, bx + 11.0, by + 7.0)
            }
        } else {
            Color bc = chkBoxColor
            if not enabled { bc = theme.mixbg(bc, theme.getTheme().bg, 55) }
            r.setColor(bc)
            r.drawRect(bx, by, boxSize, boxSize)
        }
    }

    // ==================== 单元格：进度条（2026-10-07 新增）====================
    // 列内容类型（"" = 文本，"progress" = 进度条）—— 越界/未设定一律当文本 ✓
    pri func cell_type_at(int c): string {
        if c < 0 or c >= cellTypes.len() { return "" }
        return cellTypes[c]
    }

    // 在单元格里画进度条。**观感与 ProgressBar 同源**：几何与配色都走 sdl_progress.drawBar ✓
    //   （别在这里自己调色 —— 那正是复选框当年踩过的"两套观感"坑，见 set() 那段注释 ✗）
    pri func draw_progress_cell(Renderer r, float cx, float cw, float ry, float rowH, float ratio, float iconOff) {
        float pad = 6.0
        float bx = cx + pad + iconOff
        float bw = cw - pad * 2.0 - iconOff
        if bw < 12.0 { return }                    // 列太窄：宁可不画，也不能算出负宽度 ✗
        float bh = rowH - 10.0
        if bh < 4.0 { bh = 4.0 }
        if bh > 12.0 { bh = 12.0 }
        float by = ry + (rowH - bh) / 2.0
        prgb.drawBar(r, bx, by, bw, bh, ratio, progTrack, progFill)
        // 百分比文字（与 ProgressBar 的 show_text 一致）；格太窄就不挤了，免得糊成一团 ✓
        if _font != null and _font.ok and bw >= 44.0 {
            int pct = _int(ratio * 100.0)
            if pct < 0 { pct = 0 }
            if pct > 100 { pct = 100 }
            float tw = pct_text_w(pct)
            if tw + 4.0 < bw {
                r.drawText(_font, _str(pct) + "%", r.snapX(bx + bw / 2.0 - tw / 2.0),
                           r.snapY(by + bh / 2.0 - textH / 2.0), progTxt)
            }
        }
    }

    // 百分比文字宽度：0..100 每个值**一生只测一次** ✓
    //   （表格刻意避开"每格每帧 measureString" —— 见拟合文本缓存那段注释 ✓）
    pri func pct_text_w(int pct): float {
        while pctW.len() <= pct { pctW.add(-1.0) }
        if pctW[pct] < 0.0 {
            if _font != null and _font.ok {
                var[float, float](sw, _sh) = _font.measureString(_str(pct) + "%")
                pctW[pct] = sw
            } else {
                pctW[pct] = 0.0
            }
        }
        return pctW[pct]
    }

    // ==================== 渲染 ====================
    // 按可用宽度测算，超宽时在末尾追加 "…" 截断（二分查找最大可容纳字符数）
    pri func fit_cell_text(string t, float availW): string {
        if _font == null or not _font.ok { return t }
        if availW <= 0.0 { return "" }
        var[float, float](_fw, _fh) = _font.measureString(t); float fullW = _fw
        if fullW <= availW { return t }
        var[float, float](_ew, _eh) = _font.measureString("\u2026"); float eW = _ew   // "…"
        float limit = availW - eW
        if limit < 0.0 { return "\u2026" }
        int n = t.len()
        int lo = 0, hi = n
        while lo < hi {
            int mid = (lo + hi + 1) / 2
            var[float, float](_mw, _mh) = _font.measureString(t.slice(0, mid)); float mw = _mw
            if mw <= limit { lo = mid } else { hi = mid - 1 }
        }
        return t.slice(0, lo) + "\u2026"
    }

    // ==================== 拟合文本缓存 ====================
    // 预计算所有单元格的截断文本 + 测量宽度，render 中直接查表，消除每帧 _fit_cell_text 二分搜索
    // 和 measureString 的 string key 构造 + 缓存扫描开销（~120-420 次/帧 → 0 次/帧）。
    // 在数据/列宽/字体/图标布局变化时调用 _invalidate_fitted() 失效。

    pri func invalidate_fitted() { fittedValid = false; fittedStartRow = 0; fittedEndRow = 0 }

    // 计算指定行指定列的图标占宽（不绘制，仅用于拟合文本的可用宽度计算）
    pri func compute_icon_off(int r, int c): float {
        if c != imageCol or not has_image_col() { return 0.0 }
        if r < 0 or r >= rowImages.len() { return 0.0 }
        if rowImages[r] == "" { return 0.0 }
        float imgSize = _imgSize
        if imgSize <= 0.0 { imgSize = rowH - 8.0 }
        if imgSize <= 0.0 { return 0.0 }
        return imgSize + imgGap
    }

    // 惰性重建拟合文本缓存：只遍历可见行×列，预计算截断文本和宽度
    // ★ 优化：仅计算 [startRow, endRow) 区间，滚动时惰性重建对应区间，
    //   避免对万行数据全量预计算（O(n×cols) → O(visibleRows×cols)）。
    //   render 调用时传入可见行范围，_ensure_fitted 仅在该范围变化时重建。
    pri func ensure_fitted_range(int startRow, int endRow) {
        if _font == null or not _font.ok { return }
        if fittedValid and startRow == fittedStartRow and endRow == fittedEndRow { return }
        fittedStartRow = startRow
        fittedEndRow = endRow
        int nrows = endRow - startRow
        if nrows <= 0 { fittedText = []; fittedW = []; fittedValid = true; return }
        fittedText = []
        fittedW = []
        float pad = 8.0
        int totalCells = nrows * ncols
        for totalCells to _ {
            fittedText.add(""); fittedW.add(0.0)
        }
        for startRow : endRow - 1 to r {
            int baseIdx = (r - startRow) * ncols
            for 0 : ncols - 1 to c {
                string text = cell(r, c)
                float iconOff = compute_icon_off(r, c)
                float availW = _colW[c] - 2.0 * pad - iconOff
                string fitted = fit_cell_text(text, availW)
                float fw = 0.0
                if fitted != "" { var[float, float](_fw2, _fh2) = _font.measureString(fitted); fw = _fw2 }
                fittedText[baseIdx + c] = fitted
                fittedW[baseIdx + c] = fw
            }
        }
        fittedValid = true
    }

    // 使用预计算的截断文本和宽度绘制单元格文字（跳过 _fit_cell_text 和 measureString）
    pri func draw_cached_text(Renderer r, string dt, float tw, float cx, float cw, float ry, float rh, int align, Color color, float iconOff) {
        if dt == "" { return }
        float th = textH
        float ty = ry + (rh - th) / 2.0
        float pad = 8.0
        float tx
        switch align {
            case 2 { tx = cx + cw - pad - tw }
            case 1 { tx = cx + iconOff + (cw - iconOff - tw) / 2.0 }
            default { tx = cx + pad + iconOff }
        }
        if tx < cx + 2.0 { tx = cx + 2.0 }
        float cl = cx; if cl < x { cl = x }
        float crx = cx + cw; if crx > x + w { crx = x + w }
        if tx >= crx { return }
        r.drawText(_font, dt, r.snapX(tx), r.snapY(ty), color)
    }

    // 判断是否启用了图标列
    pri func has_image_col(): bool { return imageCol >= 0 }

    // 获取行 ri 的图标路径（越界或无图标返回空串）
    pri func row_image(int ri): string {
        if ri < 0 or ri >= rowImages.len() { return "" }
        return rowImages[ri]
    }

    // 纹理缓存：按 path 取/载纹理，避免每帧重载与纹理泄漏
    // ★ MRU 快路径：文件管理器中连续多行常共用同一图标（如全部是文件夹），
    //   单槽快路径将 O(n) 线性扫描降为 O(1)，消除每行 string 比较开销
    pri func get_tex(Renderer r, string path): Ptr[u8] {
        if path == imgLastPath and imgLastTex != null { return imgLastTex }
        for imgCachePaths.len() to i {
            if imgCachePaths[i] == path {
                imgLastPath = path; imgLastTex = imgCacheTex[i]
                return imgCacheTex[i]
            }
        }
        Ptr[u8] t = img.loadTexture(r.handle, path)
        imgCachePaths.add(path); imgCacheTex.add(t)
        imgLastPath = path; imgLastTex = t
        return t
    }

    // 在图标列单元格内绘制 [图标+文字]（对齐 Treeview 的 icon+text 模式）
    // 返回图标占据的宽度（0 = 无图标），供调用方在文字绘制时偏移
    pri func draw_cell_icon(Renderer r, string ipath, float cx, float ry, float rh): float {
        if ipath == "" { return 0.0 }
        Ptr[u8] tex = get_tex(r, ipath)
        if tex == null { return 0.0 }
        float imgSize = _imgSize
        if imgSize <= 0.0 { imgSize = rh - 8.0 }
        if imgSize <= 0.0 { return 0.0 }
        float imgX = cx + imgPad
        float imgY = ry + (rh - imgSize) / 2.0
        r.setTextureAlpha(tex, 255)
        r.setTextureColor(tex, #FFFFFFFF)
        var[float, float](nw, nh) = r.getTextureSize(tex)
        switch imgMode {
            case 1 {
                // stretch：直接拉伸填满
                r.drawTextureFromTo(tex, 0.0, 0.0, nw, nh, imgX, imgY, imgSize, imgSize)
            }
            case 2 {
                // aspectFill（裁边填满）：覆盖缩放 + 居中裁剪源矩形
                float s = imgSize / nw; if imgSize / nh > s { s = imgSize / nh }
                float sw = imgSize / s, sh = imgSize / s
                float sx = (nw - sw) / 2.0, sy = (nh - sh) / 2.0
                r.drawTextureFromTo(tex, sx, sy, sw, sh, imgX, imgY, imgSize, imgSize)
            }
            default {
                // aspectFit（默认，留边）：保持比例完整显示
                float s = imgSize / nw; if imgSize / nh < s { s = imgSize / nh }
                float dw = nw * s, dh = nh * s
                r.drawTextureFromTo(tex, 0.0, 0.0, nw, nh,
                    imgX + (imgSize - dw) / 2.0, imgY + (imgSize - dh) / 2.0, dw, dh)
            }
        }
        return imgSize + imgGap   // 返回图标总占宽（含间距），文字需右移此量
    }

    pri func draw_cell_text(Renderer r, string t, float cx, float cw, float ry, float rh, int align, Color color, float iconOff) {
        if _font == null or not _font.ok { return }
        if t == "" { return }
        float th = textH
        float ty = ry + (rh - th) / 2.0
        float pad = 8.0
        float availW = cw - 2.0 * pad - iconOff
        string dt = fit_cell_text(t, availW)
        if dt == "" { return }
        var[float, float](_tw, _th) = _font.measureString(dt); float tw = _tw
        float tx
        switch align {
            case 2 { tx = cx + cw - pad - tw }
            case 1 { tx = cx + iconOff + (cw - iconOff - tw) / 2.0 }
            default { tx = cx + pad + iconOff }
        }
        if tx < cx + 2.0 { tx = cx + 2.0 }
        // 安全裁剪：tx 已 clamp，body clip 已覆盖数据区，无需 per-cell pushClipRect
        // （每格 push/pop 会产生 2 次 batch flush，12行×5列=120次/帧，导致闪烁）
        float cl = cx; if cl < x { cl = x }
        float crx = cx + cw; if crx > x + w { crx = x + w }
        // ★ 左边界保护：表头在 bodyClip 之外直接绘制（无全表 clip），
        //   防止列滚动到视口左侧时 header 文字画出 Table 左边界。
        if tx < cl { tx = cl }
        if tx >= crx { return }
        r.drawText(_font, dt, r.snapX(tx), r.snapY(ty), color)
    }

    func render(Renderer r) {
        if not _loaded or not visible { return }
        ensure_font()

        // 背景底色（在字体检查之前画，避免字体偶发未就绪时 Table 区域变透明露出容器底色 → 闪一下）
        Color bgC = bgColor
        if not enabled { bgC = theme.darken(bgColor, 64) }
        r.setColor(bgC)
        r.fillRect(x, y, w, h)

        if _font == null or not _font.ok { return }   // 字体无效时仍有背景，只跳过文字

        var sb = compute_sb()

        // 表头
        r.setColor(hdrColor)
        r.fillRect(x, y, w, headerH)
        for 0 : ncols - 1 to c {
            float cx = col_x(c)
            float cw = _colW[c]
            if cx + cw < x or cx > x + w { continue }
            // 复选框列表头：绘制全选/半选复选框
            if c == checkCol and checkCol >= 0 {
                int cnt = get_checked_count()
                bool partial = (cnt > 0 and cnt < rowChecked.len())
                draw_checkbox(r, cx, cw, y, headerH, checkHeaderState, partial)
            }
            if c < _headers.len() and c != checkCol {
                string t = _headers[c]
                Color htc = hdrTxtColor
                // 禁用排序列不显示排序箭头（即使它曾是排序列）
                if c == sortCol and not is_col_sort_disabled(c) {
                    if sortDesc { t = $"{t} ▼" } else { t = $"{t} ▲" }
                }
                draw_cell_text(r, t, cx, cw, y, headerH, headerAligns[c], htc, 0.0)
            }
            r.setColor(theme.withAlpha(sepColor, 130))
            r.drawLine(cx + cw, y, cx + cw, y + headerH)
        }
        r.setColor(theme.withAlpha(sepColor, 220))
        r.drawLine(x, y + headerH, x + w, y + headerH)

        // 数据区：bodyClip 单层裁剪。裁剪深度在 Tab 内容区内仍为 2 层（Tab + body），
        // 且 push/pop 次数与旧"仅全表单层裁剪"版本相同——不引入额外 flush，避免 D3D 闪烁。
        // ★ bodyClip 兜底：跨 header 上边界 / 底部边界的半行被安全裁剪，
        //   既不覆盖表头（滚动到底时行不会画到 header 上），也不整行跳过留空白
        //   （拖动滚动条时顶部半行自然显示，滚动平滑）。
        float bodyTop = y + headerH
        float bodyH = h - headerH - sb[1]
        float bodyW = w - sb[0]
        SDL_Rect bodyClip = SDL_Rect.malloc()
        bodyClip.x = _int(x); bodyClip.y = _int(bodyTop)
        bodyClip.w = _int(bodyW) + 1; bodyClip.h = _int(bodyH) + 1   // +1 防止浮点坐标截断丢失亚像素
        r.pushClipRect(bodyClip.to_ptr())
        clipBase = bodyClip.to_ptr()

        int startRow = _int(scrollY / rowH)
        if startRow < 0 { startRow = 0 }
        int endRow = startRow + _int(bodyH / rowH) + 2
        if endRow > _rows.len() { endRow = _rows.len() }
        // ★ 惰性重建拟合文本缓存（仅可见行区间）
        ensure_fitted_range(startRow, endRow)

        // ★ Pass 1：行背景填充——按背景色分组，减少 setColor 切换次数
        //   先画所有普通行，再画 zebran 行，再画 hover 行，最后画选中行
        //   （选中行在最上层，避免被后续覆盖）
        for startRow : endRow - 1 to ri {
            float ry = bodyTop - scrollY + ri * rowH
            if ry + rowH < bodyTop or ry > bodyTop + bodyH { continue }
            Color rc = bgC
            if cellSelect {
                // 单元格模式：行背景只画 zebra，hover/选中在 Pass 1.5 中按单元格画
                if _zebra and (ri % 2 == 1) { rc = zebColor }
            } else {
                if is_sel(ri) { rc = selColor }
                eif ri == hoverRow { rc = hovColor }
                eif _zebra and (ri % 2 == 1) { rc = zebColor }
            }
            r.setColor(rc)
            r.fillRect(x, ry, bodyW, rowH + 1.0)   // ★ 用 bodyW 防止渗透到竖向滚动条区域（替代原 bodyClip 裁剪）
        }

        // ★ Pass 1.5（仅 _cellSelect 模式）：单元格级 hover/选中高亮
        if cellSelect {
            for startRow : endRow - 1 to ri {
                float ry = bodyTop - scrollY + ri * rowH
                if ry + rowH < bodyTop or ry > bodyTop + bodyH { continue }
                bool isSel = (selRow == ri and selCol >= 0)
                bool isHov = (hoverRow == ri and hoverCol >= 0)
                if isSel or isHov {
                    // 选中单元格优先于 hover
                    Color hc2 = hovColor
                    if isSel { hc2 = selColor }
                    // 只画 hover/选中单元格高亮（不画整行背景）
                    int hcol = if isSel then selCol else hoverCol
                    if hcol >= 0 and hcol < ncols {
                        float cx = col_x(hcol), cw = _colW[hcol]
                        if cx + cw >= x and cx <= x + w {
                            r.setColor(hc2)
                            r.fillRect(cx, ry, cw, rowH + 1.0)
                        }
                    }
                }
            }
        }

        // ★ Pass 2：单元格内容（图标+文字）
        for startRow : endRow - 1 to ri {
            if ri >= _rows.len() { continue }
            float ry = bodyTop - scrollY + ri * rowH
            if ry + rowH < bodyTop or ry > bodyTop + bodyH { continue }
            var row = _rows[ri]
            string imgPath = row_image(ri)
            // 行级颜色：取本行文字色（0=用默认色）
            // ★ _rowColors 存储为 0xRRGGBB（无 alpha），需补 0xFF alpha 否则文字透明
            Color rowC = txtColor
            if ri < rowColors.len() and rowColors[ri] != 0 {
                rowC = theme.withAlpha(rowColors[ri], 255)
            }
            for 0 : ncols - 1 to c {
                float cx = col_x(c), cw = _colW[c]
                if cx + cw < x or cx > x + w { continue }
                // 复选框列：绘制行复选框
                if c == checkCol and checkCol >= 0 {
                    draw_checkbox(r, cx, cw, ry, rowH, is_row_checked(ri), false)
                    if onCellDraw != null { onCellDraw(r, ri, c, cx, ry, cw, rowH) }
                    continue
                }
                // ★ 跳过正在编辑的单元格：Edit 控件会自行绘制，避免文字叠加重叠
                //   （自绘回调也一并跳过 —— 那一刻这格归 Edit 管 ✓）
                if editing and ri == editRow and c == editCol { continue }
                float iconOff = 0.0
                if c == imageCol and has_image_col() {
                    iconOff = draw_cell_icon(r, imgPath, cx, ry, rowH)
                }
                if cell_type_at(c) == "progress" {
                    // ★ 进度条单元格（2026-10-07）：该列**文本当数值**（规则见 sdl_progress.parseProgress）
                    //   单元格背景色与文本格同待遇：先铺底，再画条 ✓
                    Color cbg = get_cell_bg(ri, c)
                    if cbg != 0 {
                        r.setColor(theme.withAlpha(cbg, 200))
                        r.fillRect(cx, ry, cw, rowH)
                    }
                    float ratio = 0.0
                    if c < row.len() { ratio = prgb.parseProgress(row[c]) }
                    draw_progress_cell(r, cx, cw, ry, rowH, ratio, iconOff)
                } eif c < row.len() {
                    // ★ 使用预计算的拟合文本和宽度，跳过 _fit_cell_text + measureString
                    int fidx = (ri - fittedStartRow) * ncols + c
                    string dt = ""
                    float dw = 0.0
                    if fidx >= 0 and fidx < fittedText.len() { dt = fittedText[fidx]; dw = fittedW[fidx] }
                    // 单元格级颜色优先于行级颜色
                    // ★ cell fg 存储为 0xRRGGBB（无 alpha），需补 0xFF alpha 否则文字透明
                    Color cellC = rowC
                    Color cfg = get_cell_fg(ri, c)
                    if cfg != 0 {
                        cellC = theme.withAlpha(cfg, 255)
                    }
                    // 单元格背景色
                    Color cbg = get_cell_bg(ri, c)
                    if cbg != 0 {
                        r.setColor(theme.withAlpha(cbg, 200))
                        r.fillRect(cx, ry, cw, rowH)
                    }
                    draw_cached_text(r, dt, dw, cx, cw, ry, rowH, _aligns[c], cellC, iconOff)
                }
                // ★ 自绘回调（2026-10-07）：常规内容**之后**调用 ⇒ 应用可叠加/覆盖
                //   （矩形已含滚动偏移与冻结列 ⇒ 应用不用自己算坐标 ✓）
                if onCellDraw != null { onCellDraw(r, ri, c, cx, ry, cw, rowH) }
            }
        }

        // ★ Pass 3：列分隔线——统一在所有行内容绘制后一次性绘制，减少 setColor 切换
        //   旧方案每格末尾 setColor(sep,70)+drawLine 会打断 fillRect/drawText 批处理，
        //   改为在 pass 3 统一设一次颜色，所有分隔线连续 drawLine（batch 内不中断）。
        r.setColor(theme.withAlpha(sepColor, 70))
        for 0 : ncols - 1 to c {
            float cx = col_x(c), cw = _colW[c]
            if cx + cw < x or cx > x + w { continue }
            for startRow : endRow - 1 to ri {
                float ry = bodyTop - scrollY + ri * rowH
                if ry + rowH < bodyTop or ry > bodyTop + bodyH { continue }
                r.drawLine(cx + cw, ry, cx + cw, ry + rowH)
            }
        }

        // 空状态提示：无数据时在数据区居中显示
        if _rows.len() == 0 and emptyText != "" {
            var[float, float](_tw2, _th2) = _font.measureString(emptyText); float tw = _tw2
            float tx = x + (w - tw) / 2.0
            float ty = bodyTop + (bodyH - textH) / 2.0
            r.setColor(emptyColor)
            r.drawText(_font, emptyText, r.snapX(tx), r.snapY(ty), emptyColor)
        }

        // 恢复裁剪（滚动条/边框/拖拽线需全区域绘制）
        r.popClipRect(); bodyClip.free()

        if dragCol >= 0 and dragCol < _colW.len() {
            float ex = col_x(dragCol) + _colW[dragCol]
            r.setColor(selColor)
            r.drawLine(ex, y, ex, y + h)
        }

        // 列重排拖拽指示线：在目标列边界处画竖线
        if reorderDragging and dragReorderCol >= 0 {
            int targetCol = col_at(reorderDragX)
            if targetCol >= 0 {
                float tx = col_x(targetCol)
                // 鼠标在目标列右半部分时指示线画在右侧
                float cx = col_x(targetCol) + _colW[targetCol]
                if reorderDragX - tx < _colW[targetCol] / 2.0 { cx = tx }
                r.setColor(theme.brighten(selColor, 40))
                r.drawLine(cx, y, cx, y + h)
            }
        }

        // 行重排拖拽指示线：在目标行边界处画横线
        if rowReorderDragging and dragReorderRow >= 0 {
            int targetRow = row_at(rowReorderDragY)
            if targetRow >= 0 {
                float bodyTop = y + headerH
                float ry = bodyTop - scrollY + targetRow * rowH
                // 鼠标在行下半部分时指示线画在下方
                float cy = ry + rowH
                if rowReorderDragY - ry < rowH / 2.0 { cy = ry }
                r.setColor(theme.brighten(selColor, 40))
                r.drawLine(x, cy, x + w, cy)
            }
        }

        r.setColor(theme.withAlpha(sepColor, 220))
        r.drawRect(x, y, w, h)

        if sb[0] > 0.0 { draw_vscroll(r, sb) }
        if sb[1] > 0.0 { draw_hscroll(r, sb) }

        if editing and _edit != null { _edit.render(r) }
    }

    pri func draw_vscroll(Renderer r, Array[float] sb) {
        float vw = 8.0
        float sx = x + w - vw - 2.0
        float bodyH = h - headerH - sb[1]
        float maxY = max_scroll_y(); if maxY <= 0 { maxY = 1 }
        float track = bodyH - 4.0
        float contentH = _rows.len() * rowH; if contentH <= 0 { contentH = 1 }
        float thumbH = maths.max(18.0, maths.min(bodyH * bodyH / contentH, bodyH))
        float thy = y + headerH + 2.0 + (scrollY / maxY) * (track - thumbH)
        r.setColor(theme.withAlpha(sbColor, 180))
        r.fillRoundedRect(sx, y + headerH + 2.0, vw, bodyH - 4.0, vw / 2.0)
        r.setColor(theme.brighten(sbColor, 60))
        r.fillRoundedRect(sx, thy, vw, thumbH, vw / 2.0)
    }
    pri func draw_hscroll(Renderer r, Array[float] sb) {
        float hh = 8.0
        float sy = y + h - hh - 2.0
        float maxX = max_scroll_x(); if maxX <= 0 { maxX = 1 }
        float bodyW = w - sb[0]
        float track = bodyW - 4.0
        float tw = total_w(); if tw <= 0 { tw = 1 }
        float thumbW = maths.max(18.0, maths.min(bodyW * bodyW / tw, bodyW))
        float thx = x + 2.0 + (scrollX / maxX) * (track - thumbW)
        r.setColor(theme.withAlpha(sbColor, 180))
        r.fillRoundedRect(x + 2.0, sy, bodyW - 4.0, hh, hh / 2.0)
        r.setColor(theme.brighten(sbColor, 60))
        r.fillRoundedRect(thx, sy, thumbW, hh, hh / 2.0)
    }

    func dispose() {
        if _font != null and _font.ok { fnt.releaseFont(_font) }; _font = null
        _edit?.dispose(); _edit = null
        ctxMenu?.dispose(); ctxMenu = null
        // 纹理缓存仅清空引用：其由所属渲染器在销毁时统一释放，
        // 此处再 SDL_DestroyTexture 会造成 double-free/崩溃（见 sdl_font.leno 注释）
        imgCacheTex = []; imgCachePaths = []
        imgLastPath = ""; imgLastTex = null
        fittedText = []; fittedW = []; fittedValid = false; fittedStartRow = 0; fittedEndRow = 0
        selSet = []; checkedCount = -1
    }

// ==================== 运行时主题切换 ====================
func applyTheme(Theme t) {
bgColor = t.bg
hdrColor = t.bgHeader
selColor = t.bgSel
hovColor = t.bgHover
zebColor = t.bgZebra
txtColor = t.txt
hdrTxtColor = t.txtHeader
sepColor = t.sep
sbColor = t.sb
emptyColor = t.txtDim
chkBoxColor = t.border
chkColor = t.accent        // ★ 补上：原来这里**漏了 chkColor** ⇒ 换主题后描边/勾线还是旧主题的色 ✗
invalidate_fitted()
// 同步内嵌控件的配色
_edit?.applyTheme(t)
ctxMenu?.applyTheme(t)
}
}

// 工厂
export func createTable(Dict opts): Table {
    Table t = new Table(); t.set(opts); return t
}


