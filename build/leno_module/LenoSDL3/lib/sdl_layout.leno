// sdl_layout.leno — 自动布局容器（HBox / VBox / AnchorBox）
//
// 解决的问题：此前所有控件都用窗口绝对坐标摆放，调整一个就得手动算其它所有坐标。
// 布局容器接管子控件的 x/y（必要时还有 w/h），按规则自动排布。
//
// 关键依赖：控件通过 Widget 接口的 get_w()/get_h()/set_pos()/set_size() 与布局协作，
// 因此任何 impl Widget 的控件（含未来新增的 TabControl/Menu/Table）都能直接放进布局，
// 无需布局本身做修改 —— 这是“不影响后面扩展”的基础。
//
// 用法：
//   HBox hb = win.addHBox({x, y, w, h, spacing, padX, padY, justify})
//   hb.add(SDL3.createButton({text:"A"}), {grow:1})            // 占满剩余宽度（可写 grow:2 拿两倍）
//   hb.add(SDL3.createButton({text:"B"}), {grow:1, shrink:0})  // 可增长、但不被压缩
//   hb.add(SDL3.createButton({text:"C"}), {align:1})           // 交叉轴居中
//   hb.add(SDL3.createButton({text:"D"}), {basis:80, minW:40}) // 显式主轴基准尺寸 + 最小宽度
// 子控件创建时仍需给定 w/h（作为自然尺寸/basis）；布局会按需用 set_size 改写它们。
//
// 每个子项 opts 支持（模拟 CSS Flexbox，沿主轴是 HBox 的水平 / VBox 的竖直）：
//   grow      : 数字权重，剩余空间按权重分配（默认 0）。expand:true 等价于 grow:1（向后兼容）。
//   shrink    : 数字权重，空间不足时按 shrink*basis 比例收缩（默认 1；写 0 即不收缩、允许溢出）。
//   basis     : 显式主轴基准尺寸，覆盖控件自然尺寸（默认 -1 表示用 get_w()/get_h()）。
//   align     : 交叉轴对齐 0=start 1=center 2=end 3=stretch（覆盖容器默认）。
//   minW/maxW/minH/maxH : 主/交叉轴尺寸约束下限/上限（默认 -1 不约束）。
// 容器 opts 支持：
//   justify   : 主轴分布（仅当无 grow 且有剩余空间时生效）
//               0=start 1=center 2=end 3=space-between 4=space-around 5=space-evenly。
// 注意：放进布局的控件用 SDL3.createXxx 创建（不注册进窗口，避免被窗口与布局双重绘制），
//       只把布局容器注册进窗口。容器会把窗口句柄自动下发给需要它的子控件（如 Edit 的 IME）。
// 注意：放进布局的控件用 SDL3.createXxx 创建（不注册进窗口，避免被窗口与布局双重绘制），
//       只把布局容器注册进窗口。容器会把窗口句柄自动下发给需要它的子控件（如 Edit 的 IME）。
import "sdl_widget.leno" as wgt; use wgt.Widget
import "sdl_opts.leno" as dochk    // 选项对账（见 sdl_opts.leno 头部的来龙去脉 ✓）
import "sdl_event.leno" as evt; use evt.Event
import "sdl_renderer.leno" as ren; use ren.Renderer
import "sdl_edit.leno" as edt; use edt.Edit
import "sdl_table.leno" as tbl; use tbl.Table
import "sdl_treeview.leno" as tvlib; use tvlib.TreeView
import "sdl_theme.leno" as thm; use thm.Theme   // ★ 2026-10-13：主题递归出口的钩子签名要用 Theme ✓
import "sdl_core.leno" as core; use core.SDL_Rect   // clip：容器裁剪子控件用（2026-10-26 ✓）
// ⚠ 本文件 switch 里"点名"的类型必须显式 import（单类型 case 是**静态**调用 ✓）
//   2026-10-13：`ListBox` 的 import 已删 —— 它跟着句柄路径一起挪进 `_extraPassWindow` 钩子了，
//   本文件不再点名它 ✓（`Table`/`TreeView` 仍要点名：`_passWindowResize` 那处 switch 认识它们 ✓）

// 扩展窗口句柄下发回调（由 sdl_window 模块注册，避免循环依赖）
// _layout_pass_window 只认识本模块导入的类型（Edit/HBox/VBox/AnchorBox），
// 对于 Table/TreeView/ListBox/Splitter/Panel/TabControl 等其它类型，通过此回调下发，无需在本模块 import。
//   ★ 2026-10-13：签名补上**窗口逻辑宽高** —— 有一批控件要的不只是句柄、还要尺寸
//     （Table/TreeView/ListBox 的内嵌右键菜单要按窗口夹紧 ✓、Splitter 要把尺寸往下传 ✓）。
//     `ww < 0` 表示"**尺寸未知**"（容器路径只知道句柄 ✓）⇒ 下游只下发句柄、不动尺寸 ✓
func(Widget, Ptr[u8], int, int):void _extraPassWindow
export func setExtraPassWindow(func(Widget, Ptr[u8], int, int):void cb) { _extraPassWindow = cb }

// 扩展**窗口尺寸变化**下发回调（同样由 sdl_window 注册 ⇒ 本模块不 import 扩展类型 ✓）
//   ★ 2026-10-13：窗口那条 resize 通知原来在 sdl_window 里**同一张硬编码类型表写了 3 遍** ✗
//     （主循环 / 模态窗 / 悬停弹层窗）⇒ 一起收敛到本模块一处，并留这个钩子（照 `_extraPassWindow` 的样板 ✓）
func(Widget, Ptr[u8], int, int):void _extraPassResize
export func setExtraPassResize(func(Widget, Ptr[u8], int, int):void cb) { _extraPassResize = cb }

// 扩展**主题递归**出口（同样由 sdl_window 注册 ⇒ 本模块不 import 控件类型 ✓）
//   ★ 2026-10-13 补：主题切换原来在窗口里只"点名"了 8 个类型、且**不下钻深容器** ✗
//     （`ScrollView` / `Card` / `TabControl` 里的控件永远收不到主题 ✓）
//   ⇒ 容器在自己的 `applyTheme` 末尾把**内容控件**交回来，由注册方继续递归 ✓；
//     为什么要这个钩子：`Card._content` 是 `pri` ✗（外部拿不到），而"类型判断只在一处"的约定
//     又不允许各容器自己点名类型 ⇒ 用回调出口两全 ✓（与 `setExtraPassResize` 同款 ✓）
func(Widget, Theme):void _extraApplyThemeChild
export func setExtraApplyThemeChild(func(Widget, Theme):void cb) { _extraApplyThemeChild = cb }
// 容器侧入口：把一个**内容控件**交给注册方下钻（未注册时安全 no-op ✓）
export func applyThemeChild(Widget c, Theme t) {
    if _extraApplyThemeChild != null { _extraApplyThemeChild(c, t) }
}

// 交叉轴对齐方式
export const LAYOUT_START   = 0   // 靠起始边（左/上）
export const LAYOUT_CENTER  = 1   // 居中
export const LAYOUT_END     = 2   // 靠结束边（右/下）
export const LAYOUT_STRETCH = 3   // 撑满交叉轴

// ============================================================
// HBox — 子控件沿水平方向依次排列
// ============================================================
export struct HBox impl Widget {
    // ==================== 关联常量 ====================
    const JUSTIFY_START        = 0   // 靠起始边
    const JUSTIFY_CENTER       = 1   // 居中
    const JUSTIFY_END          = 2   // 靠结束边
    const JUSTIFY_SPACE_BETWEEN = 3   // 两端对齐，间距等分
    const JUSTIFY_SPACE_AROUND  = 4   // 每项两侧等距
    const JUSTIFY_SPACE_EVENLY  = 5   // 含首尾等距

    float x = 0.0, y = 0.0, w = 300.0, h = 40.0
    float padX = 8.0, padY = 8.0, spacing = 6.0
    float padTop = -1.0, padBottom = -1.0, padLeft = -1.0, padRight = -1.0  // 分立内边距（<0 时回退 padX/padY）
    int justify = JUSTIFY_START  // 主轴分布（JUSTIFY_START/CENTER/END/SPACE_BETWEEN/SPACE_AROUND/SPACE_EVENLY）
    // ★ 2026-10-26：`clip: true` ⇒ 子控件超出容器矩形时被裁掉（不再压到邻居上 ✓）
    //   之前只有 Label 自己能裁（还要传 max_w），容器层没有开关 ⇒ 长内容一律溢出 ✗
    pri bool clipKids = false
    pri SDL_Rect? _clipR = null
    Array[Widget] _c = []
    Array[Dict]    _opt = []
    Array[float]  _natW = []   // 子项自然尺寸（add 时捕获，不被 set_size 改写，作为 flex basis 基准）
    Array[float]  _natH = []
    bool _loaded = false
    pri Ptr[u8] hwnd              // 绑定的窗口句柄，下发给需要的子控件

    // ★ 背景色（2026-10-09 新增 ✓）：此前**只有 Panel 有底色**，给布局容器传 `bg_color`
    //   会被**静默忽略**（`set()` 既不解析也不校验 ✗）⇒ 想给侧栏/内容区上色只能套一层 Panel。
    //   现在容器自己就能带底色 ✓（LenoMusic 的侧栏就是为这个才被迫绕路）
    //   ⚠ 默认**透明且不填** ⇒ 不传 `bg_color` 的老代码逐像素不变（零破坏 ✓）
    pri Color bgColor = #00000000
    pri float bgRadius = 0.0
    bool _hasBg = false

    func set(Dict opts) {
        dochk.check("HBox.set()", opts, _set_keys())
        x = opts.get("x", 0)
        y = opts.get("y", 0)
        w = opts.get("w", 300)
        h = opts.get("h", 40)
        padX = opts.get("pad_x", 8)
        padY = opts.get("pad_y", 8)
        spacing = opts.get("spacing", 6)
        justify = opts.get("justify", JUSTIFY_START)
        clipKids = opts.get("clip", false)   // 子控件超出容器就裁掉 ✓
        padTop = opts.get("padTop", -1.0)
        padBottom = opts.get("padBottom", -1.0)
        padLeft = opts.get("padLeft", -1.0)
        padRight = opts.get("padRight", -1.0)
        // 背景（照 Panel 的写法用 `is Color =>` 收窄 ⇒ 类型不对就忽略，不会炸 ✓）
        if opts.get("bg_color") is Color => t {
            bgColor = t
            _hasBg = true
        }
        bgRadius = opts.get("bg_radius", 0.0)
        _loaded = true
    }

    // 运行时改底色（与 Panel 同名方法，调用方写法统一 ✓）
    func set_bg_color(Color c) { bgColor = c; _hasBg = true }

    func add(Widget c, Dict opts): Widget {
        if opts == null { opts = {} }
        // ★ 选项对账（2026-09-29）：写错/不支持的键此前会被**静默丢弃** ✗ ⇒ 这里报一行警告 ✓
        //   实测收益最大的一条：把尺寸写进 createXxx 的 opts 里 ✗（那是 add(c, {basis:…}) 的活 ✓）
        dochk.check("add()", opts, _add_keys())
        _c.add(c); _opt.add(opts)
        _natW.add(c.get_w()); _natH.add(c.get_h())
        if hwnd != null { _layout_pass_window(c, hwnd) }
        return c
    }
    func remove(Widget c) {
        for _c.len() to i { if _c[i] == c { _c.remove(i); _opt.remove(i); _natW.remove(i); _natH.remove(i); return } }
    }
    // ⚠ `clear()` 只清**布局数组**，**不** dispose 子控件 —— 这是给"控件建一次、只换上场名单"
    //   的用法留的（例：影视海报墙的卡片，筛选时只是重新 add ✓）。
    //   如果子控件是**每次新建**的（内容区/列表整体重建），光 clear 会持续漏原生资源：
    //   纹理与字体引用都在各控件的 `dispose()` 里释放，GC **不会**替你调 ✗
    //   ⇒ 那种场合必须 `dispose()` 再 `clear()`（顺序不能反：先 dispose 才遍历得到子控件 ✓）
    //   实测（2026-10-26，Aria 交替切页）：只 clear 时 24 次 +95MB（≈4MB/次，线性）；
    //   加上 dispose 后 24 次 +8.9MB、44 次 +9.5MB（**不随次数增长** = 有界开销）
    // `clear()` **只清数组**，不释放子控件（纹理/字体/内嵌菜单都留着）⇒
    //   换页/换内容必须用 `reset()`：先 dispose 再 clear ✓
    //   否则子控件既不上屏也不销毁：内存只涨不降，内嵌的右击菜单还会**继续画在屏幕上** ✗
    func reset() {
        dispose()
        clear()
    }
    func clear() { _c = []; _opt = []; _natW = []; _natH = [] }
    // 绑定窗口句柄：记录自身，并把已添加的子控件一并下发
    func _bind_window(Ptr[u8] hwnd) {
        self.hwnd = hwnd      // 形参遮蔽字段 ⇒ 必须显式 self.（裸写法等于什么都没做 ✗）
        for _c to c { _layout_pass_window(c, hwnd) }
    }

    // 布局容器自身也实现尺寸接口，从而可被嵌套进其它布局
    func get_w(): float { return w }
    func get_h(): float { return h }
    func set_pos(float px, float py) { x = px; y = py }
    func set_size(float sw, float sh) { w = sw; h = sh }

    // ==================== 尺寸测量（供 ScrollView 自动内容尺寸用） ====================
    // HBox 主轴为水平：measure_w 返回所有子项宽度之和 + padding + spacing
    func measure_w(): float {
        if not _loaded or _c.len() == 0 { return 0.0 }
        float pl = if padLeft >= 0.0 then padLeft else padX
        float pr = if padRight >= 0.0 then padRight else padX
        float total = pl + pr + spacing * (_c.len() - 1)
        for _c.len() to i {
            float basis = _natW[i]
            float b = _opt[i].get("basis", -1.0)
            if b >= 0.0 { basis = b }
            total = total + basis
        }
        return total
    }
    // HBox 交叉轴为竖直：measure_h 返回最大子项高度 + padding
    func measure_h(): float {
        if not _loaded or _c.len() == 0 { return 0.0 }
        float pt = if padTop >= 0.0 then padTop else padY
        float pb = if padBottom >= 0.0 then padBottom else padY
        float maxH = 0.0
        for _c.len() to i {
            float ch = _natH[i]
            if ch > maxH { maxH = ch }
        }
        return pt + pb + maxH
    }

    pri func relayout() {
        if not _loaded { return }
        int n = _c.len()
        if n == 0 { return }
        float pl = if padLeft >= 0.0 then padLeft else padX
        float pr = if padRight >= 0.0 then padRight else padX
        float pt = if padTop >= 0.0 then padTop else padY
        float pb = if padBottom >= 0.0 then padBottom else padY
        float innerW = w - pl - pr
        float innerH = h - pt - pb
        if innerW < 0 { innerW = 0 }
        if innerH < 0 { innerH = 0 }
        float totalSpacing = spacing * (n - 1)
        float totalBasis = 0.0
        float sumGrow = 0.0
        float sumShrinkBasis = 0.0
        for n to i {
            Dict o = _opt[i]
            float g = o.get("grow", 0.0)
            if o.get("expand", false) and g <= 0.0 { g = 1.0 }
            float s = o.get("shrink", 1.0)
            float basis = _natW[i]
            float b = o.get("basis", -1.0)
            if b >= 0.0 { basis = b }
            totalBasis = totalBasis + basis
            sumGrow = sumGrow + g
            sumShrinkBasis = sumShrinkBasis + s * basis
        }
        float free = innerW - totalBasis - totalSpacing
        func childMain(int i): float {
            Dict o = _opt[i]
            float g = o.get("grow", 0.0)
            if o.get("expand", false) and g <= 0.0 { g = 1.0 }
            float s = o.get("shrink", 1.0)
            float basis = _natW[i]
            float b = o.get("basis", -1.0)
            if b >= 0.0 { basis = b }
            if free >= 0.0 {
                if sumGrow > 0.0 { return basis + free * g / sumGrow }
                return basis
            }
            if sumShrinkBasis > 0.0 {
                float cut = (s * basis) / sumShrinkBasis * (-free)
                float sz = basis - cut
                if sz < 0.0 { return 0.0 }
                return sz
            }
            return basis
        }
        float lead = 0.0
        float extraGap = 0.0
        if sumGrow == 0.0 and free > 0.0 {
            if justify == JUSTIFY_CENTER { lead = free / 2.0 }
            else if justify == JUSTIFY_END { lead = free }
            else if justify == JUSTIFY_SPACE_BETWEEN { if n > 1 { extraGap = free / (n - 1) } }
            else if justify == JUSTIFY_SPACE_AROUND { extraGap = free / n; lead = extraGap / 2.0 }
            else if justify == JUSTIFY_SPACE_EVENLY { extraGap = free / (n + 1); lead = extraGap }
        }
        float cx = x + pl + lead
        for n to i {
            Widget c = _c[i]
            Dict o = _opt[i]
            float cw = childMain(i)
            float ch = _natH[i]
            float g = o.get("grow", 0.0)
            if o.get("expand", false) and g <= 0.0 { g = 1.0 }
            int align = o.get("align", 0)
            float cy
            if align == 3 { ch = innerH; cy = y + pt }
            else if g > 0.0 { ch = innerH; cy = y + pt }
            else if align == 1 { cy = y + pt + (innerH - ch) / 2.0 }
            else if align == 2 { cy = y + pt + innerH - ch }
            else { cy = y + pt }
            float mn = o.get("minW", -1.0); if mn >= 0.0 and cw < mn { cw = mn }
            float mx = o.get("maxW", -1.0); if mx >= 0.0 and cw > mx { cw = mx }
            float mnh = o.get("minH", -1.0); if mnh >= 0.0 and ch < mnh { ch = mnh }
            float mxh = o.get("maxH", -1.0); if mxh >= 0.0 and ch > mxh { ch = mxh }
            c.set_pos(cx, cy)
            c.set_size(cw, ch)
            cx = cx + cw + spacing + extraGap
        }
    }

    func process(Event ev) {
        if not _loaded { return }
        relayout()
        for _c to c { c.process(ev) }
    }
    func render(Renderer r) {
        if not _loaded { return }
        // 背景先画，子控件再盖上来（顺序与 Panel 一致 ✓）
        if _hasBg {
            r.setColor(bgColor)
            r.fillRoundedRect(x, y, w, h, bgRadius)
        }
        relayout()
        if clipKids {
            if _clipR == null { _clipR = SDL_Rect.malloc() }
            _clipR.x = _int(x); _clipR.y = _int(y)
            _clipR.w = _int(w) + 1; _clipR.h = _int(h) + 1
            r.pushClipRect(_clipR.to_ptr())
            for _c to c { c.render(r) }
            r.popClipRect()
        } else {
            for _c to c { c.render(r) }
        }
    }
    func dispose() { for _c to c { c.dispose() } }
}

// ============================================================
// VBox — 子控件沿垂直方向依次排列（主轴为竖直）
// ============================================================
export struct VBox impl Widget {
    // ==================== 关联常量 ====================
    const JUSTIFY_START        = 0   // 靠起始边
    const JUSTIFY_CENTER       = 1   // 居中
    const JUSTIFY_END          = 2   // 靠结束边
    const JUSTIFY_SPACE_BETWEEN = 3   // 两端对齐，间距等分
    const JUSTIFY_SPACE_AROUND  = 4   // 每项两侧等距
    const JUSTIFY_SPACE_EVENLY  = 5   // 含首尾等距

    float x = 0.0; float y = 0.0; float w = 200.0; float h = 300.0
    float padX = 8.0; float padY = 8.0; float spacing = 6.0
    float padTop = -1.0, padBottom = -1.0, padLeft = -1.0, padRight = -1.0  // 分立内边距（<0 时回退 padX/padY）
    int justify = JUSTIFY_START  // 主轴分布（JUSTIFY_START/CENTER/END/SPACE_BETWEEN/SPACE_AROUND/SPACE_EVENLY）
    // ★ 2026-10-26：`clip: true` ⇒ 子控件超出容器矩形时被裁掉（不再压到邻居上 ✓）
    //   之前只有 Label 自己能裁（还要传 max_w），容器层没有开关 ⇒ 长内容一律溢出 ✗
    pri bool clipKids = false
    pri SDL_Rect? _clipR = null
    Array[Widget] _c = []
    Array[Dict]    _opt = []
    Array[float]  _natW = []   // 子项自然尺寸（add 时捕获，不被 set_size 改写，作为 flex basis 基准）
    Array[float]  _natH = []
    bool _loaded = false
    pri Ptr[u8] hwnd       // 绑定的窗口句柄，下发给需要的子控件

    // ★ 背景色（2026-10-09 新增 ✓）：与 HBox 同款 —— 此前只有 Panel 有底色，
    //   给布局容器传 `bg_color` 会被**静默忽略** ⇒ 侧栏这类"整条有色带"只能套 Panel，
    //   而 Panel 的子控件走**绝对坐标**（与自动布局混用会错位 ✗）⇒ 容器自己能上色才是正道 ✓
    //   ⚠ 默认透明且不填 ⇒ 老代码逐像素不变（零破坏 ✓）
    pri Color bgColor = #00000000
    pri float bgRadius = 0.0
    bool _hasBg = false

    func set(Dict opts) {
        dochk.check("VBox.set()", opts, _set_keys())
        x = opts.get("x", 0)
        y = opts.get("y", 0)
        w = opts.get("w", 200)
        h = opts.get("h", 300)
        padX = opts.get("pad_x", 8)
        padY = opts.get("pad_y", 8)
        spacing = opts.get("spacing", 6)
        justify = opts.get("justify", JUSTIFY_START)
        clipKids = opts.get("clip", false)   // 子控件超出容器就裁掉 ✓
        padTop = opts.get("padTop", -1.0)
        padBottom = opts.get("padBottom", -1.0)
        padLeft = opts.get("padLeft", -1.0)
        padRight = opts.get("padRight", -1.0)
        if opts.get("bg_color") is Color => t {
            bgColor = t
            _hasBg = true
        }
        bgRadius = opts.get("bg_radius", 0.0)
        _loaded = true
    }

    // 运行时改底色（与 Panel 同名 ✓）
    func set_bg_color(Color c) { bgColor = c; _hasBg = true }

    func add(Widget c, Dict opts): Widget {
        if opts == null { opts = {} }
        // ★ 选项对账（2026-09-29）：写错/不支持的键此前会被**静默丢弃** ✗ ⇒ 这里报一行警告 ✓
        //   实测收益最大的一条：把尺寸写进 createXxx 的 opts 里 ✗（那是 add(c, {basis:…}) 的活 ✓）
        dochk.check("add()", opts, _add_keys())
        _c.add(c); _opt.add(opts)
        _natW.add(c.get_w()); _natH.add(c.get_h())
        if hwnd != null { _layout_pass_window(c, hwnd) }
        return c
    }
    func remove(Widget c) {
        for _c.len() to i { if _c[i] == c { _c.remove(i); _opt.remove(i); _natW.remove(i); _natH.remove(i); return } }
    }
    // ⚠ `clear()` 只清**布局数组**，**不** dispose 子控件 —— 这是给"控件建一次、只换上场名单"
    //   的用法留的（例：影视海报墙的卡片，筛选时只是重新 add ✓）。
    //   如果子控件是**每次新建**的（内容区/列表整体重建），光 clear 会持续漏原生资源：
    //   纹理与字体引用都在各控件的 `dispose()` 里释放，GC **不会**替你调 ✗
    //   ⇒ 那种场合必须 `dispose()` 再 `clear()`（顺序不能反：先 dispose 才遍历得到子控件 ✓）
    //   实测（2026-10-26，Aria 交替切页）：只 clear 时 24 次 +95MB（≈4MB/次，线性）；
    //   加上 dispose 后 24 次 +8.9MB、44 次 +9.5MB（**不随次数增长** = 有界开销）
    // `clear()` **只清数组**，不释放子控件（纹理/字体/内嵌菜单都留着）⇒
    //   换页/换内容必须用 `reset()`：先 dispose 再 clear ✓
    //   否则子控件既不上屏也不销毁：内存只涨不降，内嵌的右击菜单还会**继续画在屏幕上** ✗
    func reset() {
        dispose()
        clear()
    }
    func clear() { _c = []; _opt = []; _natW = []; _natH = [] }
    // 绑定窗口句柄：记录自身，并把已添加的子控件一并下发
    func _bind_window(Ptr[u8] hwnd) {
        self.hwnd = hwnd      // 形参遮蔽字段 ⇒ 必须显式 self.（裸写法等于什么都没做 ✗）
        for _c to c { _layout_pass_window(c, hwnd) }
    }

    // 布局容器自身也实现尺寸接口，从而可被嵌套进其它布局
    func get_w(): float { return w }
    func get_h(): float { return h }
    func set_pos(float px, float py) { x = px; y = py }
    func set_size(float sw, float sh) { w = sw; h = sh }

    // ==================== 尺寸测量（供 ScrollView 自动内容尺寸用） ====================
    // VBox 主轴为竖直：measure_h 返回所有子项高度之和 + padding + spacing
    func measure_h(): float {
        if not _loaded or _c.len() == 0 { return 0.0 }
        float pt = if padTop >= 0.0 then padTop else padY
        float pb = if padBottom >= 0.0 then padBottom else padY
        float total = pt + pb + spacing * (_c.len() - 1)
        for _c.len() to i {
            float basis = _natH[i]
            float b = _opt[i].get("basis", -1.0)
            if b >= 0.0 { basis = b }
            total = total + basis
        }
        return total
    }
    // VBox 交叉轴为水平：measure_w 返回最大子项宽度 + padding
    func measure_w(): float {
        if not _loaded or _c.len() == 0 { return 0.0 }
        float pl = if padLeft >= 0.0 then padLeft else padX
        float pr = if padRight >= 0.0 then padRight else padX
        float maxW = 0.0
        for _c.len() to i {
            float cw = _natW[i]
            if cw > maxW { maxW = cw }
        }
        return pl + pr + maxW
    }

    pri func relayout() {
        if not _loaded { return }
        int n = _c.len()
        if n == 0 { return }
        // 有效内边距：分立值 >=0 时优先，否则回退 padX/padY
        float pl = if padLeft >= 0.0 then padLeft else padX
        float pr = if padRight >= 0.0 then padRight else padX
        float pt = if padTop >= 0.0 then padTop else padY
        float pb = if padBottom >= 0.0 then padBottom else padY
        float innerW = w - pl - pr
        float innerH = h - pt - pb
        if innerW < 0 { innerW = 0 }
        if innerH < 0 { innerH = 0 }

        // 先扫描，统计各 flex 总和（用于 free / justify 计算）
        float totalSpacing = spacing * (n - 1)
        float totalBasis = 0.0
        float sumGrow = 0.0
        float sumShrinkBasis = 0.0
        for n to i {
            Dict o = _opt[i]
            float g = o.get("grow", 0.0)
            if o.get("expand", false) and g <= 0.0 { g = 1.0 }
            float s = o.get("shrink", 1.0)
            float basis = _natH[i]
            float b = o.get("basis", -1.0)
            if b >= 0.0 { basis = b }
            totalBasis = totalBasis + basis
            sumGrow = sumGrow + g
            sumShrinkBasis = sumShrinkBasis + s * basis
        }
        float free = innerH - totalBasis - totalSpacing

        // 嵌套闭包：计算第 i 个子项的主轴尺寸（捕获 free/sumGrow/sumShrinkBasis 等外层变量）
        func childMain(int i): float {
            Dict o = _opt[i]
            float g = o.get("grow", 0.0)
            if o.get("expand", false) and g <= 0.0 { g = 1.0 }
            float s = o.get("shrink", 1.0)
            float basis = _natH[i]
            float b = o.get("basis", -1.0)
            if b >= 0.0 { basis = b }
            if free >= 0.0 {
                if sumGrow > 0.0 { return basis + free * g / sumGrow }
                return basis
            }
            if sumShrinkBasis > 0.0 {
                float cut = (s * basis) / sumShrinkBasis * (-free)
                float sz = basis - cut
                if sz < 0.0 { return 0.0 }
                return sz
            }
            return basis
        }

        // 主轴起始偏移与间隙（justify-content，仅在无 grow 且有剩余空间时生效）
        float lead = 0.0
        float extraGap = 0.0
        if sumGrow == 0.0 and free > 0.0 {
            if justify == JUSTIFY_CENTER { lead = free / 2.0 }
            else if justify == JUSTIFY_END { lead = free }
            else if justify == JUSTIFY_SPACE_BETWEEN { if n > 1 { extraGap = free / (n - 1) } }
            else if justify == JUSTIFY_SPACE_AROUND { extraGap = free / n; lead = extraGap / 2.0 }
            else if justify == JUSTIFY_SPACE_EVENLY { extraGap = free / (n + 1); lead = extraGap }
        }

        float cy = y + pt + lead
        for n to i {
            Widget c = _c[i]
            Dict o = _opt[i]
            float ch = childMain(i)
            float cw = _natW[i]
            float g = o.get("grow", 0.0)
            if o.get("expand", false) and g <= 0.0 { g = 1.0 }
            int align = o.get("align", 0)
            float cx
            if align == 3 { cw = innerW; cx = x + pl }
            else if g > 0.0 { cw = innerW; cx = x + pl }   // grow 同时撑满交叉轴
            else if align == 1 { cx = x + pl + (innerW - cw) / 2.0 }
            else if align == 2 { cx = x + pl + innerW - cw }
            else { cx = x + padX }
            // 最小/最大约束
            float mn = o.get("minW", -1.0); if mn >= 0.0 and cw < mn { cw = mn }
            float mx = o.get("maxW", -1.0); if mx >= 0.0 and cw > mx { cw = mx }
            float mnh = o.get("minH", -1.0); if mnh >= 0.0 and ch < mnh { ch = mnh }
            float mxh = o.get("maxH", -1.0); if mxh >= 0.0 and ch > mxh { ch = mxh }
            c.set_pos(cx, cy)
            c.set_size(cw, ch)
            cy = cy + ch + spacing + extraGap
        }
    }

    func process(Event ev) {
        if not _loaded { return }
        relayout()
        for _c to c { c.process(ev) }
    }
    func render(Renderer r) {
        if not _loaded { return }
        // 背景先画，子控件再盖上来（与 Panel/HBox 一致 ✓）
        if _hasBg {
            r.setColor(bgColor)
            r.fillRoundedRect(x, y, w, h, bgRadius)
        }
        relayout()
        if clipKids {
            if _clipR == null { _clipR = SDL_Rect.malloc() }
            _clipR.x = _int(x); _clipR.y = _int(y)
            _clipR.w = _int(w) + 1; _clipR.h = _int(h) + 1
            r.pushClipRect(_clipR.to_ptr())
            for _c to c { c.render(r) }
            r.popClipRect()
        } else {
            for _c to c { c.render(r) }
        }
    }
    func dispose() { for _c to c { c.dispose() } }
}

    // ============================================================
    // AnchorBox — 子控件按锚点（left/top/right/bottom 或 center）定位
    // opts 支持：left, top, right, bottom（像素偏移，-1 表示不约束）、
//            centerX, centerY（bool）、w, h（显式尺寸，覆盖自然尺寸）
// ============================================================
export struct AnchorBox impl Widget {
    float x = 0.0; float y = 0.0; float w = 300.0; float h = 200.0
    float padX = 0.0; float padY = 0.0
    Array[Widget] _c = []
    Array[Dict]    _opt = []
    Array[float]  _natW = []   // 子项自然尺寸（add 时捕获，不被 set_size 改写）
    Array[float]  _natH = []
    bool _loaded = false
    // ★ 2026-10-29 反哺：AnchorBox 原来**没有** visible/enabled/hover 这组通用状态，
    //   于是应用里想"叠层显隐"只能拿 Panel/Card 去包（AnchorBox.set_visible 直接编译不过 ✗）。
    //   叠层显隐是刚需（封面上的播放标记、角标、遮罩）⇒ 补成和其它控件一致 ✓
    bool visible = true
    bool enabled = true
    pri bool hover = false
    pri Ptr[u8] hwnd              // 绑定的窗口句柄，下发给需要的子控件

    func set(Dict opts) {
        dochk.check("AnchorBox.set()", opts, _set_keys())
        x = opts.get("x", 0)
        y = opts.get("y", 0)
        w = opts.get("w", 300)
        h = opts.get("h", 200)
        padX = opts.get("pad_x", 0)
        padY = opts.get("pad_y", 0)
        visible = opts.get("visible", true)
        enabled = opts.get("enabled", true)
        _loaded = true
    }

    func add(Widget c, Dict opts): Widget {
        if opts == null { opts = {} }
        // ★ 选项对账（2026-09-29）：写错/不支持的键此前会被**静默丢弃** ✗ ⇒ 这里报一行警告 ✓
        //   实测收益最大的一条：把尺寸写进 createXxx 的 opts 里 ✗（那是 add(c, {basis:…}) 的活 ✓）
        dochk.check("add()", opts, _add_keys())
        _c.add(c); _opt.add(opts)
        _natW.add(c.get_w()); _natH.add(c.get_h())
        if hwnd != null { _layout_pass_window(c, hwnd) }
        return c
    }
    func remove(Widget c) {
        for _c.len() to i { if _c[i] == c { _c.remove(i); _opt.remove(i); _natW.remove(i); _natH.remove(i); return } }
    }
    // ⚠ `clear()` 只清**布局数组**，**不** dispose 子控件 —— 这是给"控件建一次、只换上场名单"
    //   的用法留的（例：影视海报墙的卡片，筛选时只是重新 add ✓）。
    //   如果子控件是**每次新建**的（内容区/列表整体重建），光 clear 会持续漏原生资源：
    //   纹理与字体引用都在各控件的 `dispose()` 里释放，GC **不会**替你调 ✗
    //   ⇒ 那种场合必须 `dispose()` 再 `clear()`（顺序不能反：先 dispose 才遍历得到子控件 ✓）
    //   实测（2026-10-26，Aria 交替切页）：只 clear 时 24 次 +95MB（≈4MB/次，线性）；
    //   加上 dispose 后 24 次 +8.9MB、44 次 +9.5MB（**不随次数增长** = 有界开销）
    // `clear()` **只清数组**，不释放子控件（纹理/字体/内嵌菜单都留着）⇒
    //   换页/换内容必须用 `reset()`：先 dispose 再 clear ✓
    //   否则子控件既不上屏也不销毁：内存只涨不降，内嵌的右击菜单还会**继续画在屏幕上** ✗
    func reset() {
        dispose()
        clear()
    }
    func clear() { _c = []; _opt = []; _natW = []; _natH = [] }
    // 绑定窗口句柄：记录自身，并把已添加的子控件一并下发
    func _bind_window(Ptr[u8] hwnd) {
        self.hwnd = hwnd      // 形参遮蔽字段 ⇒ 必须显式 self.（裸写法等于什么都没做 ✗）
        for _c to c { _layout_pass_window(c, hwnd) }
    }

    // 布局容器自身也实现尺寸接口，从而可被嵌套进其它布局
    func get_w(): float { return w }
    func get_h(): float { return h }
    func set_pos(float px, float py) { x = px; y = py }
    func set_size(float sw, float sh) { w = sw; h = sh }

    // ==================== 尺寸测量（供 ScrollView 自动内容尺寸用） ====================
    // AnchorBox：按子项锚点计算所需最小尺寸
    func measure_w(): float {
        if not _loaded or _c.len() == 0 { return 2.0 * padX }
        float maxR = 0.0
        for _c.len() to i {
            float cw = _natW[i]
            float ow = _opt[i].get("w", -1.0); if ow >= 0.0 { cw = ow }
            float l = _opt[i].get("left", -1.0)
            float r = _opt[i].get("right", -1.0)
            float edge
            if l >= 0.0 and r >= 0.0 { edge = l + r }
            else if l >= 0.0 { edge = l + cw }
            else if r >= 0.0 { edge = r + cw }
            else { edge = cw }
            if edge > maxR { maxR = edge }
        }
        return 2.0 * padX + maxR
    }
    func measure_h(): float {
        if not _loaded or _c.len() == 0 { return 2.0 * padY }
        float maxB = 0.0
        for _c.len() to i {
            float ch = _natH[i]
            float oh = _opt[i].get("h", -1.0); if oh >= 0.0 { ch = oh }
            float t = _opt[i].get("top", -1.0)
            float b = _opt[i].get("bottom", -1.0)
            float edge
            if t >= 0.0 and b >= 0.0 { edge = t + b }
            else if t >= 0.0 { edge = t + ch }
            else if b >= 0.0 { edge = b + ch }
            else { edge = ch }
            if edge > maxB { maxB = edge }
        }
        return 2.0 * padY + maxB
    }

    pri func relayout() {
        if not _loaded { return }
        float bx = x + padX
        float by = y + padY
        float bw = w - 2.0 * padX
        float bh = h - 2.0 * padY
        if bw < 0 { bw = 0 }
        if bh < 0 { bh = 0 }

        for _c.len() to i {
            Widget c = _c[i]
            Dict o = _opt[i]
            float cw = _natW[i]; float ch = _natH[i]
            float ow = o.get("w", -1.0); if ow >= 0.0 { cw = ow }
            float oh = o.get("h", -1.0); if oh >= 0.0 { ch = oh }
            float l = o.get("left", -1.0)
            float t = o.get("top", -1.0)
            float r = o.get("right", -1.0)
            float b = o.get("bottom", -1.0)
            bool cX = o.get("centerX", false)
            bool cY = o.get("centerY", false)
            float px = bx; float py = by

            // 水平
            if l >= 0.0 and r >= 0.0 { cw = bw - l - r; px = bx + l }
            else if l >= 0.0 and cX { px = bx + (bw - cw) / 2.0 }
            else if l >= 0.0 { px = bx + l }
            else if r >= 0.0 { px = bx + bw - r - cw }
            else if cX { px = bx + (bw - cw) / 2.0 }
            else { px = bx }
            // 垂直
            if t >= 0.0 and b >= 0.0 { ch = bh - t - b; py = by + t }
            else if t >= 0.0 and cY { py = by + (bh - ch) / 2.0 }
            else if t >= 0.0 { py = by + t }
            else if b >= 0.0 { py = by + bh - b - ch }
            else if cY { py = by + (bh - ch) / 2.0 }
            else { py = by }

            c.set_pos(px, py)
            c.set_size(cw, ch)
        }
    }

    // 通用控件状态（2026-10-29 反哺：与 Button/Card/Panel 保持同一套叫法 ✓）
    func set_visible(bool v) { visible = v }
    func set_enabled(bool v) { enabled = v }
    func get_x(): float { return x }
    func get_y(): float { return y }
    func is_hover(): bool { return hover }

    func process(Event ev) {
        if not _loaded or not visible or not enabled { return }
        // hover 状态：叠层（封面播放标记之类）常靠它决定显隐 ⇒ 自己也算一份 ✓
        if ev.isMouseMotion() or ev.isMouseButtonDown() {
            var[float, float](mx, my) = ev.mousePos()
            hover = mx >= x and mx <= x + w and my >= y and my <= y + h
        }
        relayout()
        for _c to c { c.process(ev) }
    }
    func render(Renderer r) {
        if not _loaded or not visible { return }
        relayout()
        for _c to c { c.render(r) }
    }
    func dispose() { for _c to c { c.dispose() } }
}

// ★ 核心窗口句柄下发逻辑（必须定义在使用它的函数之前，避免前向引用问题）
// ==================== 一条容易踩的布局常识（2026-10-29 记）====================
// **行内「文字 + 紧跟徽标」时，文字必须 `grow: 0, shrink: 1`，不能用 `grow: 1`。**
//
//   起因：表格行里「歌名 + 音质标签」，歌名写 `grow: 1` 后标签被推到列最右，
//   看着像浮在列中间 —— 排查时一度怀疑是 `align` 没生效、`w` 被写死，
//   实际两条都不是（`align: 3` 在 L276/L523 里正确地 `cw = innerW` 覆盖了子项的 w）。
//
//   这是 flex 的标准语义，不是缺陷：
//     · `grow: n`（n>0） = 吃掉主轴上的**剩余空间** ⇒ 后面的兄弟会被顶到行尾
//     · `align: 3`        = 撑满**交叉轴**（横向对齐方向），与主轴分配无关
//     · `shrink: 1`       = 空间不够时压缩自己 ⇒ 文字超长会缩，`lblFit` 的省略号照样生效
//
//   ⇒ 「文字靠左、徽标紧随其后、文字超长时省略」= `{grow: 0, shrink: 1}` ✓
//   ⇒ 若本意就是「文字单独占满一行」才用 `grow: 1` ✓
//
// `add(c, opts)` 认的键 —— 与本文件各处 `.get("…")` 保持一致 ✓
//   ⚠ 故意比"子项真正用到的"更宽（含 x/y/w/h/left/top/… 锚点类 ✓）⇒ **宁可少报也不误报** ✓
func _add_keys(): Array[string] {
    return ["x", "y", "w", "h", "grow", "shrink", "basis", "align", "justify",
            "minW", "minH", "maxW", "maxH", "expand",
            "left", "top", "right", "bottom", "centerX", "centerY",
            "pad_x", "pad_y", "padTop", "padBottom", "padLeft", "padRight", "spacing"]
}

// `set(opts)` 认的键 —— 与本文件**三处 `set()`** 里的 `.get("…")` 对齐 ✓
//   ★ 2026-10-13 补：`set()` 这条路原来**完全没对账** ✗（`add()` 那条早就有了 ✓）
//     ⇒ 建容器（`createHBox/VBox/AnchorBox`）时传错键一律**静默** ✓ —— 正是对账最该拦的那种 ✗
//   ⚠ 与 `_add_keys()` 是**两条路**：`set()` 是"建容器"、`add()` 是"往容器里加子项" ✓
//   ⚠ 白名单是三者**并集**（HBox/VBox 那套 + AnchorBox 那套 ✓）⇒ 可选宽不选窄（宁少报、不误报 ✓）
func _set_keys(): Array[string] {
    return ["x", "y", "w", "h", "pad_x", "pad_y", "padTop", "padBottom", "padLeft", "padRight",
            "spacing", "justify", "bg_color", "bg_radius", "clip",
            "visible", "enabled"]     // ★ 2026-10-29：AnchorBox 现在认这两个（见 struct 里的字段注释）
}

// ★ 2026-10-10：名字已**改回 `_passWindowHandle`** ✓ —— 它曾为绕开"顶层函数名与某类型方法同名"
//   而改叫 `_lay_dispatch_handle` ✗，但那条病因后来**被证伪** ✓（最小复现：自由函数 + 同名方法、
//   参数个数不同，`.leno` 直跑与单文件 `.lenb` 两条路都正确 ✓；若真命中那条路径，编译器会
//   **当场报"参数过多"**而不是静默 ✗）。
//   现在编译器对"**个数不同**的同名撞车"会正确落到**自由函数** ✓（见
//   `docs/LenoSDL3_打包后窗口句柄下发静默失效排查记录.md` §九）⇒ 本函数与
//   `sdl_window.leno` 里的 `Window._passWindowHandle(Widget)` 同名**完全没问题** ✓
//   （个数不同 ✓、本函数是模块级、调用点也都在模块级函数体内 ✓）
func _passWindowHandle(Widget c, Ptr[u8] hwnd, int ww, int hh) {
    // ★ 2026-10-10：**合并写法回来了** ✓ —— 这里就是给它留的样板（门面代码要写最自然的写法 ✓）
    //   历史：合并 `case is A, B, C { c._bind_window(...) }` 曾因编译器 bug（DCE 把按名动态派发的
    //   方法剪成 `<dce-cut>` 空桩 ⇒ 调用方静默 no-op ✗）被迫拆成"每支一个类型" ✗ —— 那条已在
    //   编译器侧治本（codegen_stmt.c 的 gen_switch 记类型引用 + 合并 case 体内方法名按通配登记 ✓
    //   + dce.c 的名字通配默认安全档 ✓），详见
    //   `docs/LenoSDL3_打包后窗口句柄下发静默失效排查记录.md` §九 ✓
    //   ⇒ 现在合并写法与单类型写法**都正确** ✓，按可读性挑就行 ✓
    switch c {
        case is Edit { c.set_window(hwnd); return }
        case is HBox, VBox, AnchorBox { c._bind_window(hwnd); return }
    }
    // 其余类型（Table/TreeView/ListBox/Splitter/Panel/TabControl/Card/TitleBar…）一律交给注册方的回调 ✓
    //   ★ 2026-10-13：**Table/TreeView/ListBox 也挪走了** —— 它们要的不只是句柄、还要**窗口尺寸**
    //     （内嵌右键菜单要按窗口夹紧 ✓），而本函数手上只有句柄 ⇒ 交给"知道窗口尺寸"的注册方 ✓
    if _extraPassWindow != null { _extraPassWindow(c, hwnd, ww, hh) }
}

// 把窗口句柄下发给需要它的子控件：
// - Edit 需要窗口句柄做 IME 候选框定位（SDL_SetTextInputArea）；
// - 嵌套的布局容器（HBox/VBox/AnchorBox）继续向下传递，保证深层子控件也能拿到句柄。
// 其它控件忽略即可（无 set_window 需求）。
func _layout_pass_window(Widget c, Ptr[u8] hwnd) {
    _passWindowHandle(c, hwnd, -1, -1)     // 容器路径只有句柄 ⇒ 尺寸按"未知"传 ✓
}

// ★ 导出统一的窗口句柄下发函数，供 Panel/GroupBox/Splitter/TabControl/ScrollView
//   等容器的 _pass_hwnd 调用，确保所有容器类型（含未来新增的）都能正确传递句柄给 Edit。
//   此前各容器的 _pass_hwnd 只处理了部分类型（如 Panel 不认识 ScrollView），导致嵌套
//   容器内的 Edit 收不到窗口句柄，IME 候选框位置始终在 (0,0)。
// 容器侧入口（只知道句柄 ✓）：尺寸按"未知"传 ⇒ 下游只拿到句柄 ✓（与老行为一致 ✓）
export func passWindowHandle(Widget c, Ptr[u8] hwnd) {
    _passWindowHandle(c, hwnd, -1, -1)
}
// ★ 2026-10-13 新增：**窗口侧入口**（窗口知道自己的逻辑宽高 ✓）——
//   Table/TreeView/ListBox 能拿到"句柄 + 尺寸" ✓、Splitter 能带着尺寸往下传播 ✓。
//   窗口里原来**自己写了两份类型表**（还漂移了：一份有 ListBox/GridLayout、另一份有 Card 却漏 ListBox ✗，
//   靠"每帧安全网"掩盖着 ✓）⇒ 两处都改成调这里，**类型判断只在本文件一处** ✓
export func passWindowHandleSized(Widget c, Ptr[u8] hwnd, int ww, int hh) {
    _passWindowHandle(c, hwnd, ww, hh)
}

// 把「窗口逻辑宽高变了」下发给需要它的控件（**全工程唯一的类型表** ✓）
//   - Table / TreeView：`on_window_resize` ⇒ 同步给内嵌右键菜单做弹层边界夹紧 ✓
//   - Splitter / Scrim 等后续类型：走 `_extraPassResize` 钩子（由 sdl_window 注册 ✓）
//   ⚠ 与 `_passWindowHandle` 同一个套路：**以后新控件想让窗口告诉它 resize，只加这里/加钩子** ✓
//     —— 别再去改窗口里那三个循环 ✗（那正是这次收掉的债 ✓）
func _passWindowResize(Widget c, Ptr[u8] hwnd, int ww, int hh) {
    switch c {
        case is Table { c.on_window_resize(ww, hh); return }
        case is TreeView { c.on_window_resize(ww, hh); return }
    }
    // 未匹配的扩展类型（Splitter / Scrim / 后续新增 ✓）交给回调处理
    if _extraPassResize != null { _extraPassResize(c, hwnd, ww, hh) }
}
// 导出：供 sdl_window 的三个循环（主循环 / 模态窗 / 悬停弹层窗）统一调用 ✓
export func passWindowResize(Widget c, Ptr[u8] hwnd, int ww, int hh) {
    _passWindowResize(c, hwnd, ww, hh)
}

// ==================== 工厂 ====================
export func createHBox(Dict opts): HBox {
    HBox b = new HBox(); b.set(opts); return b
}
export func createVBox(Dict opts): VBox {
    VBox b = new VBox(); b.set(opts); return b
}
export func createAnchorBox(Dict opts): AnchorBox {
    AnchorBox b = new AnchorBox(); b.set(opts); return b
}
