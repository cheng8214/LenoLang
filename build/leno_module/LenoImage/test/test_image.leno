// LenoImage 自测：构造/读写、缩放、几何、PNG 编解码往返
//
// 跑法（仓库根目录）：
//   build\leno.exe build\leno_module\LenoImage\test\test_image.leno
//   或 build\leno.exe build\leno_module\run_all_tests.leno --only LenoImage
import "Image" as img
import files
use img.Image

func fail(string msg) {
    print("[FAIL] " + msg + "\n")
    _exit(1)
}

func eqInt(int got, int want, string tag) {
    if got != want { fail(tag + "：得到 " + _str(got) + " 期望 " + _str(want)) }
}

func eqBool(bool got, bool want, string tag) {
    if got != want { fail(tag + "：得到 " + _str(got) + " 期望 " + _str(want)) }
}

// 比较两个 Image 的尺寸与全部像素（逐字节）
func eqImage(Image a, Image b, string tag) {
    if a.w != b.w or a.h != b.h {
        fail(tag + "：尺寸 " + _str(a.w) + "x" + _str(a.h) + " != " + _str(b.w) + "x" + _str(b.h))
    }
    for 0 : a.h - 1 to y {
        for 0 : a.w - 1 to x {
            var ca = a.get(x, y)
            var cb = b.get(x, y)
            for 0 : 3 to k {
                if ca[k] != cb[k] {
                    fail(tag + "：(" + _str(x) + "," + _str(y) + ") 通道 " + _str(k)
                          + " 得到 " + _str(ca[k]) + " 期望 " + _str(cb[k]))
                }
            }
        }
    }
}

main() {
    // ==================== ① 构造 + 单点读写（RGBA 逻辑序）====================
    Image t = img.newImage(2, 2)
    eqInt(t.w, 2, "newImage 宽")
    eqInt(t.h, 2, "newImage 高")
    eqInt(t.px.len(), 16, "px 长度 = w*h*4")
    // 默认全透明黑（BGRA 全 0）
    eqInt(t.getA(0, 0), 0, "默认 alpha = 0")

    t.set(0, 0, 255, 0, 0, 255)     // 红，不透明
    var c = t.get(0, 0)
    eqInt(c[0], 255, "get.r")
    eqInt(c[1], 0, "get.g")
    eqInt(c[2], 0, "get.b")
    eqInt(c[3], 255, "get.a")
    // 内部 BGRA：B=0, G=0, R=255, A=255
    eqInt(t.px[0], 0, "内部 B")
    eqInt(t.px[1], 0, "内部 G")
    eqInt(t.px[2], 255, "内部 R")
    eqInt(t.px[3], 255, "内部 A")

    t.set(1, 0, 0, 255, 0, 255)     // 绿
    t.set(0, 1, 0, 0, 255, 255)     // 蓝
    t.set(1, 1, 255, 255, 255, 255) // 白

    // 越界抛错
    bool threw = false
    try { t.get(5, 0) } catch e { threw = true }
    eqBool(threw, true, "越界 get 抛错")

    // ==================== ② fill / fillRect ====================
    Image f = img.newImage(4, 4)
    f.fill(10, 20, 30, 255)
    var fc = f.get(3, 3)
    eqInt(fc[0], 10, "fill r")
    eqInt(fc[1], 20, "fill g")
    eqInt(fc[2], 30, "fill b")
    eqInt(fc[3], 255, "fill a")

    f.fillRect(1, 1, 2, 2, 200, 0, 0, 255)
    eqInt(f.get(0, 0)[0], 10, "fillRect 外保持原色")
    eqInt(f.get(1, 1)[0], 200, "fillRect 内被覆盖")

    // ==================== ③ 缩放：最近邻 2x2 → 4x4 ====================
    Image nn = img.resize(t, 4, 4, img.MODE_NEAREST)
    eqInt(nn.w, 4, "nearest 宽")
    eqInt(nn.h, 4, "nearest 高")
    // 每个源像素 2x2 块：源 (0,0) 红 → 目标 (0,0)(1,0)(0,1)(1,1) 都红
    eqInt(nn.get(1, 1)[0], 255, "nearest (1,1) 仍是红")
    eqInt(nn.get(1, 1)[1], 0, "nearest (1,1) g=0")
    eqInt(nn.get(3, 3)[0], 255, "nearest (3,3) 是白 r")
    eqInt(nn.get(3, 3)[1], 255, "nearest (3,3) 是白 g")

    // ==================== ④ 缩放：box 缩小（纯色不变色）====================
    Image solid = img.newImage(4, 4)
    solid.fill(7, 8, 9, 255)
    Image small = img.resize(solid, 2, 2, img.MODE_BOX)
    eqInt(small.get(0, 0)[0], 7, "box 缩小 r 不变")
    eqInt(small.get(1, 1)[2], 9, "box 缩小 b 不变")

    // resizeAuto：缩小自动走 box
    Image auto = img.resizeAuto(solid, 1, 1, false)
    eqInt(auto.w, 1, "resizeAuto 宽")
    eqInt(auto.get(0, 0)[0], 7, "resizeAuto 缩小颜色保持")

    // 非法采样方式抛错
    bool threwMode = false
    try { img.resize(solid, 2, 2, 99) } catch e { threwMode = true }
    eqBool(threwMode, true, "未知采样方式抛错")

    // ==================== ⑤ 几何：crop / flip / rotate ====================
    // t 是 2x2：红 绿 / 蓝 白
    Image cropImg = img.crop(t, 1, 0, 1, 1)
    eqInt(cropImg.w, 1, "crop 宽")
    eqInt(cropImg.h, 1, "crop 高")
    eqInt(cropImg.get(0, 0)[1], 255, "crop 取到绿")

    Image fh = img.flipH(t)
    eqInt(fh.get(0, 0)[1], 255, "flipH：左上变绿")

    Image fv = img.flipV(t)
    eqInt(fv.get(0, 0)[2], 255, "flipV：左上变蓝")

    Image r90 = img.rotate90(t)
    eqInt(r90.w, 2, "rotate90 宽不变（2x2）")
    // 顺时针 90：红(0,0) → 右上(1,0)；蓝(0,1) → 左上(0,0)
    eqInt(r90.get(0, 0)[2], 255, "rotate90 左上变蓝")

    // 非正方形：2x3 → rotate90 成 3x2
    Image rect = img.newImage(2, 3)
    rect.fill(0, 0, 0, 255)
    rect.set(1, 2, 100, 0, 0, 255)
    Image rr = img.rotate90(rect)
    eqInt(rr.w, 3, "rotate90 非正方：宽 = 原高")
    eqInt(rr.h, 2, "rotate90 非正方：高 = 原宽")
    // 源右下角 (1,2) 顺时针转到目标左下角 (0,1)
    eqInt(rr.get(0, 1)[0], 100, "rotate90 角点搬对")

    // ==================== ⑥ PNG 往返（encode → decode 逐像素一致）====================
    Image pat = img.newImage(3, 2)
    pat.fill(12, 34, 56, 255)
    pat.set(0, 0, 255, 0, 0, 255)       // 红
    pat.set(1, 0, 0, 255, 0, 128)       // 半透明绿
    pat.set(2, 0, 0, 0, 255, 255)       // 蓝
    pat.set(0, 1, 255, 255, 255, 0)     // 全透明白
    pat.set(1, 1, 1, 2, 3, 255)         // 近黑
    pat.set(2, 1, 200, 150, 100, 254)   // 杂色

    var enc = img.encodePNG(pat)
    eqBool(enc.isOk(), true, "encodePNG 成功")
    // PNG 签名
    eqInt(enc.val.byte(0), 0x89, "PNG 签名 0")
    eqInt(enc.val.byte(1), 0x50, "PNG 签名 1")

    var dec = img.decodePNG(enc.val)
    if dec.isErr() { fail("decodePNG 失败：" + dec.errText()) }
    eqImage(dec.val, pat, "PNG 往返逐像素一致")

    // 坏输入
    eqBool(img.decodePNG("not a png").isErr(), true, "坏输入返回失败")
    eqBool(img.decodePNG("").isErr(), true, "空输入返回失败")

    // ==================== ⑦ 绘制 / 合成 ====================
    // blit：整块覆盖，越界部分裁掉
    Image canvas = img.newImage(4, 4)
    Image dot = img.newImage(2, 2)
    dot.fill(10, 20, 30, 255)
    img.blit(canvas, dot, 3, 3)                 // 只落 1 个像素在 (3,3)
    var c33 = canvas.get(3, 3)
    eqInt(c33[0], 10, "blit 右下落点 R")
    eqInt(c33[2], 30, "blit 右下落点 B")
    eqInt(canvas.getA(0, 0), 0, "blit 未覆盖处仍是透明")
    img.blit(canvas, dot, -1, -1)               // 左上越界：只落 (0,0)
    eqInt(canvas.get(0, 0)[1], 20, "blit 左上越界落点 G")

    // blitAlpha：半透明叠加（50% 白 over 黑 ⇒ 约 128）
    Image base = img.newImage(1, 1)
    base.fill(0, 0, 0, 255)
    Image half = img.newImage(1, 1)
    half.fill(255, 255, 255, 128)
    img.blitAlpha(base, half, 0, 0)
    int mixR = base.get(0, 0)[0]
    eqBool(mixR >= 126 and mixR <= 130, true, "blitAlpha 半透明混色 ≈128（实际 " + _str(mixR) + "）")
    eqInt(base.getA(0, 0), 255, "blitAlpha 结果 alpha = 255")
    // sa=0 不改变目标
    Image clear = img.newImage(1, 1)            // 全透明
    img.blitAlpha(base, clear, 0, 0)
    eqInt(base.get(0, 0)[0], mixR, "blitAlpha sa=0 不改目标")

    // fillCircle：圆心在 (3,3) r=2 ⇒ (3,3) 实心、(0,0) 不受影响
    Image circ = img.newImage(7, 7)
    img.fillCircle(circ, 3, 3, 2, 200, 100, 50, 255)
    eqInt(circ.get(3, 3)[0], 200, "fillCircle 圆心")
    eqInt(circ.getA(0, 0), 0, "fillCircle 不碰远处")
    eqInt(circ.get(3, 1)[0], 200, "fillCircle 上边缘在圆内")
    eqInt(circ.getA(3, 0), 0, "fillCircle 圆外左侧(3,0)不在圆内")

    // drawRect：只描边，内部不变
    Image rct = img.newImage(5, 5)
    img.drawRect(rct, 1, 1, 3, 3, 9, 9, 9, 255)
    eqInt(rct.getA(1, 1), 255, "drawRect 左上角")
    eqInt(rct.getA(3, 3), 255, "drawRect 右下角")
    eqInt(rct.getA(2, 2), 0, "drawRect 内部不填")

    // line：水平线 + 对角线
    Image ln = img.newImage(5, 5)
    img.line(ln, 0, 0, 4, 0, 1, 2, 3, 255)
    eqInt(ln.getA(4, 0), 255, "line 水平到端点")
    eqInt(ln.getA(0, 1), 0, "line 不溢出到下一行")
    Image dg = img.newImage(5, 5)
    img.line(dg, 0, 0, 4, 4, 7, 7, 7, 255)
    eqInt(dg.getA(2, 2), 255, "line 对角线经过中点")

    // toGray / invert
    Image col = img.newImage(1, 1)
    col.set(0, 0, 255, 0, 0, 200)               // 纯红，alpha=200
    Image gray = img.toGray(col)
    int gv = gray.get(0, 0)[0]
    eqBool(gv >= 75 and gv <= 77, true, "toGray 亮度 ≈76（0.299*255，实际 " + _str(gv) + "）")
    eqInt(gray.get(0, 0)[1], gv, "toGray 三通道相等")
    eqInt(gray.getA(0, 0), 200, "toGray 保留 alpha")
    Image inv = img.invert(col)
    eqInt(inv.get(0, 0)[0], 0, "invert R")
    eqInt(inv.get(0, 0)[1], 255, "invert G")
    eqInt(inv.getA(0, 0), 200, "invert 保留 alpha")
    eqInt(col.get(0, 0)[0], 255, "toGray/invert 不改入参")

    // clone：改副本不影响原图
    Image cp = img.clone(col)
    cp.set(0, 0, 0, 0, 0, 0)
    eqInt(col.get(0, 0)[0], 255, "clone 后改副本不影响原图")

    // scaleToFit：200x100 装进 50x50 ⇒ 50x25；小图不放大
    Image big = img.newImage(200, 100)
    Image fit = img.scaleToFit(big, 50, 50, false)
    eqInt(fit.w, 50, "scaleToFit 宽")
    eqInt(fit.h, 25, "scaleToFit 高")
    Image tiny = img.newImage(10, 10)
    Image same = img.scaleToFit(tiny, 64, 64, false)
    eqInt(same.w, 10, "scaleToFit 不放大（宽）")
    eqInt(same.h, 10, "scaleToFit 不放大（高）")

    // ==================== ⑧ PNG 滤波：五种都能自解回来 + 自适应当真更小 ====================
    Image pf = img.newImage(64, 48)
    for 0 : 47 to y {
        for 0 : 63 to x { pf.set(x, y, x * 4, y * 5, (x + y) * 2, 255) }
    }
    // 每种固定滤波编出来的流都必须能被自己解开（解码侧要认全部 5 种）
    for 0 : 4 to ft {
        var r = img.encodePNGWithFilter(pf, ft)
        if r.isErr() { fail("filter=" + _str(ft) + " 编码失败：" + r.errText()) }
        var back = img.decodePNG(r.val)
        if back.isErr() { fail("filter=" + _str(ft) + " 往返解码失败：" + back.errText()) }
        eqImage(back.val, pf, "filter=" + _str(ft) + " 往返逐像素一致")
    }
    // 自适应 vs None：渐变图应当明显更小（同一份像素，只是滤波选择不同）
    var rAd = img.encodePNG(pf)
    var rNo = img.encodePNGNoFilter(pf)
    eqBool(rAd.val.len() < rNo.val.len(), true,
           "自适应当比 None 小（自适应 " + _str(rAd.val.len()) + " / None " + _str(rNo.val.len()) + "）")
    // 非法滤波值要报错，不静默
    eqBool(img.encodePNGWithFilter(pf, 9).isErr(), true, "filter 越界报错")

    // ==================== ⑨ 写文件：缺父目录要**返回 Result 错误**，不能抛 ====================
    //   背景（2026-11-25 实测）：调用方在子目录里用"仓库根相对路径"写盘 ⇒ 父目录不存在
    //   ⇒ 旧写法由 files.write 直接抛「无法创建文件 '…'」+ 调用栈，看不出是目录问题。
    var badPath = img.encodePNGFile(pf, "__no_such_dir_xyz__/x.png")
    eqBool(badPath.isErr(), true, "缺父目录 ⇒ 返回错误（不抛异常）")
    eqBool(badPath.errText().find("目录不存在") >= 0, true, "错误信息指明是目录不存在")

    // 正常路径仍能写（写完删掉，别在仓库里留垃圾）
    var okPath = img.encodePNGFile(pf, "test_image_tmp.png")
    eqBool(okPath.isOk(), true, "正常路径写文件成功")
    files.delete("test_image_tmp.png")

    print("test_image passed（9 组 / 构造·读写·缩放·几何·PNG 往返/滤波·绘制·写文件）")
}
