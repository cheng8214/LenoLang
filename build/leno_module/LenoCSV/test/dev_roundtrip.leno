// dev_roundtrip.leno -- 供 test/dev_crosscheck_python.py 调用（**开发期工具，不是用例**）
//
// 用法：dev_roundtrip.leno <输入.csv> <输出.csv>
// 语义：读进来 → 按 LF 重新写出（不回写表头判断，纯行×列搬运）
// ★ 2026-11-09：CSV 的 load/save 已改成 Result（见 lib/csv_io.leno 顶部说明）
import "CSV" as csv
import "Result" as res
use res.Result
use csv.CsvTable

main() {
    Array[string] args = _args()
    if args.len() < 2 {
        print("用法: dev_roundtrip.leno <输入.csv> <输出.csv>")
        return
    }
    Result[CsvTable] d = csv.load(args[0], ",", false)
    if d.isErr() {
        print("ERR " + d.errText())
        return
    }
    Result[int] w = csv.save(args[1], d.val.rows, ",", false)
    if w.isErr() {
        print("ERR " + w.errText())
        return
    }
    print("OK " + _str(d.val.rows.len()))
}
