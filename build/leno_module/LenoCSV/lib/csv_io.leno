// csv_io.leno -- 文件读写 + 表头/记录整理（纯 Leno）
//
// 返回口径统一为 Dict（与 LenoQR / LenoSDL3 的 capture 一致）：
//   {ok: bool, header: Array[string], rows: Array[Array[string]], err: string}
//   ok=false 时 err 是可直接展示的原因；ok=true 时 err 为空串。
import files
import "csv_parse.leno" as p
import "csv_encode.leno" as e

// 文本 → {header, rows}；hasHeader=false 时 header 为空、rows 是全部行
export func parse_table(string text, string delim, bool hasHeader): Dict {
    Array[Array[string]] all = p.parse(text, delim)
    Array[string] header = []
    Array[Array[string]] rows = all
    if hasHeader and all.len() > 0 {
        header = all[0]
        rows = []
        for 1:all.len()-1 to i { rows.add(all[i]) }
    }
    return {ok: true, header: header, rows: rows, err: ""}
}

// 文件 → {header, rows}
//   ⚠ files.read 本身会剥 UTF-8 BOM；parse 里也有一层 BOM 处理 ⇒ 两条路都安全 ✓
export func load(string path, string delim, bool hasHeader): Dict {
    if not files.exists(path) {
        return {ok: false, header: [], rows: [], err: "文件不存在：" + path}
    }
    string text = ""
    try {
        text = files.read(path)
    } catch ex {
        return {ok: false, header: [], rows: [], err: "读文件失败：" + path}
    }
    return parse_table(text, delim, hasHeader)
}

// 行×列 → 文件。返回是否确实落盘（不依赖 files.write 的返回值口径）
export func save(string path, Array[Array[string]] rows, string delim, bool crlf): bool {
    files.write(path, e.encode(rows, delim, crlf))
    return files.exists(path)
}

// 表头 + 行 → Array[Dict]（每行一个记录；缺的列补空串，多的列忽略）
export func to_dicts(Array[string] header, Array[Array[string]] rows): Array[Dict] {
    Array[Dict] recs = []
    for rows to r {
        Dict d = {}
        for 0:header.len()-1 to c {
            d.set(header[c], if c < r.len() then r[c] else "")
        }
        recs.add(d)
    }
    return recs
}
