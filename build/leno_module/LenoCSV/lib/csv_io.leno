// csv_io.leno -- 文件读写 + 表头/记录整理（纯 Leno）
//
// ★ 2026-11-09（P2 契约收敛）：原来的口径是 `Dict{ok, header, rows, err}`，
//   调用方要 `_str(d["err"])` 判空、还要 `as Array[...]` 强转。
//   现在按"能不能失败"分开，**只给会失败的那两个套 Result**：
//     · parse_table(text, ...)            ⇒ `CsvTable`       —— 解析是容错的，不会失败
//     · load(path, ...)                   ⇒ `Result[CsvTable]` —— 文件可能不存在/读不了
//     · save(path, ...)                   ⇒ `Result[int]`     —— 返回**写出的字节数**（原来是 bool）
//   这样既统一了契约，也没有"凭空造一个永远 ok 的 Result"（那种 Result 反而让人以为要判错）。
import files
import strings
import "Result" as res
use res.Result
import "csv_parse.leno" as p
import "csv_encode.leno" as e

// 表头 + 记录（原来塞在 Dict 的 header / rows 两个键里）
export struct CsvTable {
    Array[string] header = []
    Array[Array[string]] rows = []
}

// 文本 → 表；hasHeader=false 时 header 为空、rows 是全部行
export func parse_table(string text, string delim, bool hasHeader): CsvTable {
    Array[Array[string]] all = p.parse(text, delim)
    CsvTable t = new CsvTable()
    if hasHeader and all.len() > 0 {
        t.header = all[0]
        for 1:all.len()-1 to i { t.rows.add(all[i]) }
    } else {
        t.rows = all
    }
    return t
}

// 文件 → 表
//   ⚠ files.read 本身会剥 UTF-8 BOM；parse 里也有一层 BOM 处理 ⇒ 两条路都安全 ✓
export func load(string path, string delim, bool hasHeader): Result[CsvTable] {
    if not files.exists(path) {
        return res.err[CsvTable](res.ErrCode.NOT_FOUND, "文件不存在：" + path)
    }
    string text = ""
    try {
        text = files.read(path)
    } catch ex {
        return res.err[CsvTable](res.ErrCode.IO, "读文件失败：" + path + "（" + _str(ex) + "）")
    }
    return res.ok(parse_table(text, delim, hasHeader))
}

// 行×列 → 文件。成功时给出**写出的字节数**（UTF-8），失败区分"写不动"和"写完不见了"
export func save(string path, Array[Array[string]] rows, string delim, bool crlf): Result[int] {
    string text = e.encode(rows, delim, crlf)
    try {
        files.write(path, text)
    } catch ex {
        return res.err[int](res.ErrCode.IO, "写文件失败：" + path + "（" + _str(ex) + "）")
    }
    if not files.exists(path) {
        return res.err[int](res.ErrCode.IO, "写入后文件仍不存在：" + path)
    }
    return res.ok(strings.byte_len(text))
}

// 表头 + 行 → Array[Dict]（每行一个记录；缺的列补空串，多的列忽略）
export func to_dicts(Array[string] header, Array[Array[string]] rows): Array[Dict] {
    Array[Dict] recs = []
    for rows to r {
        Dict d = {}
        for 0:header.len()-1 to c {
            d.set(header[c], if c < r.len() then r[c] else "")
        }
        recs.add(d)
    }
    return recs
}
