// LenoCompress 0.1.0 自测：CRC32 向量 + gzip/zlib/裸 DEFLATE 解压
//
// 跑法（仓库根目录）：
//   build\leno.exe build\leno_module\LenoCompress\test\test_inflate_crc.leno
//
// 固定输入（全部由 python zlib / gzip 生成，权威期望值）：
//   plain = "LenoCompress 测试：你好"（UTF-8 24 字节）
//   gzip   = gzip.compress(plain, 9)                    —— 49 字节
//   zlib   = zlib.compress(plain, 9)                    —— 37 字节
//   raw    = zlib.compressobj(9, DEFLATED, -15)         —— 31 字节（裸 DEFLATE）
//
// ★ 2026-11-09（P2）：返回值 `GzipResult{ok,data,error}` ⇒ `Result[Inflated]`，
//   断言改成 `isErr()` / `msg` / `val.data`，并**顺带验证失败码统一是 PARSE**。
import strings
import "Compress" as z
import "Result" as res
use res.Result
use z.Inflated

func fail(string msg) {
    print("[FAIL] " + msg)
    _exit(1)
}

func eq(string got, string want, string tag) {
    if got != want { fail(tag + "：得到「" + got + "」期望「" + want + "」") }
}

func eqInt(int got, int want, string tag) {
    if got != want { fail(tag + "：得到 " + _str(got) + " 期望 " + _str(want)) }
}

main() {
    string plain = "LenoCompress 测试：你好"

    // ---------- ① CRC32 向量 ----------
    if z.crc32("123456789") != 3421780262 { fail("① crc32(123456789) 应为 3421780262") }
    if z.crc32("") != 0 { fail("① crc32(\"\") 应为 0") }
    if z.crc32("abc") != 891568578 { fail("① crc32(abc) 应为 891568578") }
    if z.crcTableEntry(1) != 0x77073096 { fail("① CRC 表第 1 项应为 0x77073096") }
    print("① CRC32 向量 ok")

    // ---------- ② gzip ----------
    string gz = strings.from_bytes([
        31, 139, 8, 0, 176, 119, 211, 106, 2, 255, 243, 73, 205, 203, 119, 206, 207, 45,
        40, 74, 45, 46, 86, 120, 182, 181, 251, 197, 250, 169, 239, 247, 204, 122, 178,
        119, 193, 211, 165, 123, 1, 87, 221, 232, 251, 28, 0, 0, 0
    ])
    if not z.isGzip(gz) { fail("② 魔数判断失败") }
    Result[Inflated] r1 = z.gunzip(gz)
    if r1.isErr() { fail("② gunzip 失败：" + r1.errText()) }
    eq(r1.val.data, plain, "② gunzip 内容")
    eqInt(r1.val.outBytes, plain.byte_len(), "② outBytes")
    eqInt(r1.val.inBytes, gz.byte_len(), "② inBytes = 整段 gzip 长度")
    print("② gzip ok（" + _str(r1.val.inBytes) + " → " + _str(r1.val.outBytes) + " 字节）")

    // ---------- ③ zlib ----------
    string zl = strings.from_bytes([
        120, 218, 243, 73, 205, 203, 119, 206, 207, 45, 40, 74, 45, 46, 86, 120, 182, 181,
        251, 197, 250, 169, 239, 247, 204, 122, 178, 119, 193, 211, 165, 123, 1, 199, 103,
        16, 26
    ])
    Result[Inflated] r2 = z.inflateZlib(zl)
    if r2.isErr() { fail("③ inflateZlib 失败：" + r2.errText()) }
    eq(r2.val.data, plain, "③ zlib 内容")
    print("③ zlib ok")

    // ---------- ④ 裸 DEFLATE（zip 条目用的就是它）----------
    string raw = strings.from_bytes([
        243, 73, 205, 203, 119, 206, 207, 45, 40, 74, 45, 46, 86, 120, 182, 181, 251,
        197, 250, 169, 239, 247, 204, 122, 178, 119, 193, 211, 165, 123, 1
    ])
    Result[Inflated] r3 = z.inflateRaw(raw)
    if r3.isErr() { fail("④ inflateRaw 失败：" + r3.errText()) }
    eq(r3.val.data, plain, "④ 裸 DEFLATE 内容")
    print("④ 裸 DEFLATE ok")

    // ---------- ⑤ 损坏数据必须报错（不能静默给半截）----------
    Result[Inflated] bad = z.gunzip(strings.from_bytes([31, 139, 8, 0, 0, 0, 0, 0, 0, 255, 255, 255, 255, 255, 255, 255, 255, 255]))
    if bad.isOk() { fail("⑤ 损坏的 gzip 不该成功") }
    if bad.msg == "" { fail("⑤ 损坏的 gzip 应给出原因") }
    eqInt(bad.code, res.ErrCode.PARSE, "⑤ 解压失败统一 PARSE")
    print("⑤ 损坏数据报错 ok：" + bad.errText())

    // ---------- ⑥ 空输入的边界 ----------
    if z.gunzip("").isOk() { fail("⑥ 空串不该被当成 gzip") }
    Result[Inflated] er = z.inflateRaw("")
    if er.isOk() and er.val.outBytes != 0 { fail("⑥ 空 DEFLATE 若成功也只能是 0 字节") }
    print("⑥ 空输入边界 ok")

    // ---------- ⑦ 垃圾输入：必须**返回错误**，不能崩 ----------
    //   2026-11-09 补：原来只测合法数据的往返。解压是"解析**外部**数据"，
    //   坏输入是最常见也最危险的场景 —— 崩溃就等于整个服务端挂掉。
    Result[Inflated] b1 = z.gunzip("")
    if b1.isOk() { fail("⑦ 空输入不该成功") }
    if b1.msg == "" { fail("⑦ 空输入应给出原因") }

    Result[Inflated] b2 = z.gunzip("not a gzip at all")
    if b2.isOk() { fail("⑦ 纯文本被当成 gzip 不该成功") }
    if b2.msg == "" { fail("⑦ 纯文本应给出原因") }

    Result[Inflated] b4 = z.inflateRaw("random bytes here")
    if b4.isOk() { fail("⑦ inflateRaw 垃圾不该成功") }
    if b4.msg == "" { fail("⑦ inflateRaw 垃圾应给出原因") }

    Result[Inflated] b5 = z.inflateZlib("random bytes here")
    if b5.isOk() { fail("⑦ inflateZlib 垃圾不该成功") }
    if b5.msg == "" { fail("⑦ inflateZlib 垃圾应给出原因") }

    // isGzip 判据
    if not z.isGzip(z.gzip("x")) { fail("⑦ isGzip 对 gzip 输出应为真") }
    if z.isGzip("hello") { fail("⑦ isGzip 对普通串应为假") }

    print("test_inflate_crc passed")
}
