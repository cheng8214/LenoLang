// dev_decompress.leno -- 解压文件（**开发期工具，不是用例**）
//
// 用法：dev_decompress.leno <raw|gzip|zlib> <in> <out>
// ★ 2026-11-09：解压三件已改成 Result[Inflated]（见 lib/Compress.leno 顶部说明）
import files
import "Compress" as z
import "Result" as res
use res.Result
use z.Inflated

main() {
    Array[string] args = _args()
    if args.len() < 3 {
        print("用法: dev_decompress.leno <raw|gzip|zlib> <in> <out>")
        return
    }
    string mode = args[0]
    string data = files.read(args[1])
    Result[Inflated] r = z.gunzip(data)
    if mode == "raw" { r = z.inflateRaw(data) }
    else if mode == "zlib" { r = z.inflateZlib(data) }
    if r.isErr() {
        print("ERR " + r.errText())
        return
    }
    files.write(args[2], r.val.data)
    print("OK " + _str(r.val.outBytes))
}
