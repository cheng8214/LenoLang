// zip_write.leno -- 写 ZIP（PKZIP 2.0 格式，纯 Leno）
//
// 现状：条目**按 compress 参数**选 method —— true ⇒ 8（deflate），false ⇒ 0（stored）。
//   deflate 走 `LenoCompress.deflateRaw`（fixed Huffman + LZ77）。
//   stored 的好处是"任何解压器都能读"，代价是体积。
//
// ⚠ 2026-11-09 更正：这里原先写"条目一律用 stored（不压缩），deflate 压缩端还没实现"，
//   是压缩端完成前的状态 —— 下面 `if compress { method = 8 }` 早就实现了。
//
// 结构（3 段，全部小端）：
//   [local header + data] × N  →  [central directory]  →  [EOCD]
// 关键点：
//   · CRC32 / csize / usize **必须写对**（很多解压器只信 CD 里的值）
//   · flag 置 0x0800（UTF-8 文件名），否则中文名在 Windows 资源管理器里会乱码
//   · DOS 时间/日期用当前时间（1980 为基准；秒只有 2 秒精度）
import maths
import strings
import times
import bytes
import "Compress" as z

// ★ 2026-11-28：原来这里有两个手抄的"整数 → 小端字节"helper（u16 / u32 各一份，
//   逐字节 out.add），已删除并**全量替换**成内置 `bytes.write_u16` / `bytes.write_u32`
//   （一次 native 调用写完整数，也不再套一层函数调用）。


// [DOS time, DOS date]
func _dos_stamp(): Array[int] {
    var ts = times.now()
    var year = _int(times.format(ts, "%Y"))
    var mon = _int(times.format(ts, "%m"))
    var day = _int(times.format(ts, "%d"))
    var hh = _int(times.format(ts, "%H"))
    var mm = _int(times.format(ts, "%M"))
    var ss = _int(times.format(ts, "%S"))
    year = maths.clampi(year, 1980, 2107)   // DOS 纪元边界（2026-11-01）
    Array[int] r = []
    r.add((hh << 11) | (mm << 5) | (ss / 2))
    r.add(((year - 1980) << 9) | (mon << 5) | day)
    return r
}

// entries: [{name: string, data: string}] → zip 字节（字符串载体）
//   compress=true ⇒ method 8（deflate）；false ⇒ method 0（stored）
//   ⚠ 头里的 CRC / usize 永远按**原文**算；csize 才是压缩后的长度
export func encode(Array[Dict] entries, bool compress): string {
    Array[int] out = []
    Array[int] cds = []
    Array[int] stamp = _dos_stamp()
    int dt = stamp[0]
    int dd = stamp[1]

    for entries to e {
        string name = e["name"] as string
        var data = ""
        if e.has("data") { data = e["data"] as string }
        Array[int] nb = name.to_bytes()
        Array[int] db = data.to_bytes()
        int crc = z.crc32Bytes(db)

        var payload = data
        var method = 0
        if compress { payload = z.deflateRaw(data) }
        if compress { method = 8 }
        Array[int] pb = payload.to_bytes()
        int off = out.len()

        // ---- local file header ----
        bytes.write_u32(out, 0x04034b50)
        bytes.write_u16(out, 20)              // version needed 2.0
        bytes.write_u16(out, 0x0800)          // flag: UTF-8 文件名
        bytes.write_u16(out, method)
        bytes.write_u16(out, dt)
        bytes.write_u16(out, dd)
        bytes.write_u32(out, crc)
        bytes.write_u32(out, pb.len())        // compressed size
        bytes.write_u32(out, db.len())        // uncompressed size
        bytes.write_u16(out, nb.len())
        bytes.write_u16(out, 0)               // extra len
        for nb to b { out.add(b) }
        for pb to b { out.add(b) }

        // ---- central directory record ----
        bytes.write_u32(cds, 0x02014b50)
        bytes.write_u16(cds, 20)              // version made by（低字节 2.0，高字节 0 = MS-DOS）
        bytes.write_u16(cds, 20)              // version needed
        bytes.write_u16(cds, 0x0800)
        bytes.write_u16(cds, method)
        bytes.write_u16(cds, dt)
        bytes.write_u16(cds, dd)
        bytes.write_u32(cds, crc)
        bytes.write_u32(cds, pb.len())
        bytes.write_u32(cds, db.len())
        bytes.write_u16(cds, nb.len())
        bytes.write_u16(cds, 0)               // extra
        bytes.write_u16(cds, 0)               // comment
        bytes.write_u16(cds, 0)               // disk start
        bytes.write_u16(cds, 0)               // internal attrs
        bytes.write_u32(cds, 0)               // external attrs
        bytes.write_u32(cds, off)             // local header offset
        for nb to b { cds.add(b) }
    }

    int cdOff = out.len()
    for cds to b { out.add(b) }

    // ---- EOCD ----
    bytes.write_u32(out, 0x06054b50)
    bytes.write_u16(out, 0)                   // disk number
    bytes.write_u16(out, 0)                   // disk with CD
    bytes.write_u16(out, entries.len())
    bytes.write_u16(out, entries.len())
    bytes.write_u32(out, cds.len())
    bytes.write_u32(out, cdOff)
    bytes.write_u16(out, 0)                   // comment len

    return strings.from_bytes(out)
}
