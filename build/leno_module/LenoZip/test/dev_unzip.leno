// dev_unzip.leno -- 把 zip 解到目录（**开发期工具，不是用例**）
//
// 用法：dev_unzip.leno <in.zip> <outdir>
// 输出：OK <条目数> / ERR <原因>
// 说明：目录条目（名字以 / 结尾）跳过；嵌套路径会先建父目录
import dirs
import files
import "Zip" as zip

// 取父目录（name 里最后一个 '/' 之前的部分；没有则空串）
func parent_of(string name): string {
    Array[int] bs = name.to_bytes()
    var i = bs.len() - 1
    while i >= 0 {
        if bs[i] == 47 {
            if i == 0 { return "" }
            return name.byte_slice(0, i - 1)
        }
        i = i - 1
    }
    return ""
}

main() {
    Array[string] args = _args()
    if args.len() < 2 {
        print("用法: dev_unzip.leno <in.zip> <outdir>")
        return
    }
    string inPath = args[0]
    string outDir = args[1]
    dirs.mkdir_p(outDir)

    var z = zip.load(inPath)
    if not (z["ok"] as bool) {
        print("ERR " + (z["err"] as string))
        return
    }
    Array[Dict] entries = z["entries"] as Array[Dict]
    var written = 0
    for entries to e {
        if e["isDir"] as bool { continue }
        if (e["err"] as string) != "" {
            print("ERR " + (e["name"] as string) + "：" + (e["err"] as string))
            return
        }
        string name = e["name"] as string
        string full = dirs.join(outDir, name)
        string parent = parent_of(name)
        if parent != "" { dirs.mkdir_p(dirs.join(outDir, parent)) }
        files.write(full, e["data"] as string)
        written = written + 1
    }
    print("OK " + _str(written))
}
