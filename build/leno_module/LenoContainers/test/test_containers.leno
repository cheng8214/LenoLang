// LenoContainers 自测：Stack / Queue / LRU（2026-11-24）
//
// 重点不是"能用"，而是**边界契约**：空容器抛错、Queue 惰性压缩后顺序不乱、
// LRU 按最近访问淘汰（不是按插入）。
import "Containers" as ct

func fail(string msg) {
    print("[FAIL] " + msg + "\n")
    _exit(1)
}

func eqI(int got, int want, string tag) {
    if got != want { fail(tag + "：得到 " + _str(got) + " 期望 " + _str(want)) }
}

main() {
    // ==================== Stack ====================
    var s = new ct.Stack[int]()
    if not s.is_empty() { fail("① 新栈应为空") }
    s.push(1)
    s.push(2)
    s.push(3)
    eqI(s.len(), 3, "① 栈长度")
    eqI(s.peek(), 3, "① peek 取栈顶")
    eqI(s.pop(), 3, "① 后进先出 1")
    eqI(s.pop(), 2, "① 后进先出 2")
    eqI(s.len(), 1, "① 出栈后长度")

    var threw1 = false
    s.pop()          // 弹掉最后一个（值 1）⇒ 此刻已空
    try {
        s.pop()      // 再弹 ⇒ 必须抛错
    } catch e {
        threw1 = true
    }
    if not threw1 { fail("① 空栈 pop 必须抛错（不返回 null/0）") }

    s.push(9)
    s.clear()
    if not s.is_empty() { fail("① clear 后应为空") }

    // 泛型实参不同互不影响
    var st = new ct.Stack[string]()
    st.push("x")
    if st.pop() != "x" { fail("① 字符串栈") }

    // 命名参数构造直接灌初值（原来 README 没写，实测可用）
    var s2 = new ct.Stack[int](items = [1, 2, 3])
    eqI(s2.len(), 3, "① 命名参数灌初值")
    eqI(s2.pop(), 3, "① 灌初值后仍是后进先出")

    // push_all + to_array（非破坏性快照，栈底 → 栈顶）
    var s3 = new ct.Stack[int]()
    s3.push_all([1, 2, 3])
    eqI(s3.len(), 3, "① push_all")
    Array[int] snap = s3.to_array()
    eqI(snap.len(), 3, "① to_array 长度")
    eqI(snap[0], 1, "① to_array[0] 是栈底")
    eqI(snap[2], 3, "① to_array[2] 是栈顶")
    eqI(s3.len(), 3, "① to_array 不消耗栈")
    snap.add(99)
    eqI(s3.len(), 3, "① to_array 返回副本（改它不影响栈）")

    // ==================== Queue ====================
    var q = new ct.Queue[int]()
    q.push(10)
    q.push(20)
    eqI(q.len(), 2, "② 队列长度")
    eqI(q.peek(), 10, "② peek 取队首")
    eqI(q.pop(), 10, "② 先进先出 1")
    eqI(q.pop(), 20, "② 先进先出 2")

    var threw2 = false
    try {
        q.pop()
    } catch e {
        threw2 = true
    }
    if not threw2 { fail("② 空队列 pop 必须抛错") }

    // 惰性压缩：塞 100 个、出队 90 个（中途会压缩），剩下的顺序必须还是 90..99
    for 0 : 99 to i {
        q.push(i)
    }
    for 0 : 89 to i {
        var v = q.pop()
        if v != i { fail("② 第 " + _str(i) + " 次出队应为 " + _str(i) + "，实际 " + _str(v)) }
    }
    eqI(q.len(), 10, "② 压缩后逻辑长度")
    eqI(q.pop(), 90, "② 压缩后队首仍是 90")

    // len 必须扣掉 head 空洞
    var q2 = new ct.Queue[int]()
    for 0 : 4 to i {
        q2.push(i)
    }
    q2.pop()
    q2.pop()
    eqI(q2.len(), 3, "② len 扣掉已出队元素")
    q2.clear()
    eqI(q2.len(), 0, "② clear 后长度 0")
    if not q2.is_empty() { fail("② clear 后 is_empty") }

    // push_all + to_array（逻辑顺序，扣 head）
    var q3 = new ct.Queue[int]()
    q3.push_all([1, 2, 3, 4])
    eqI(q3.len(), 4, "② push_all")
    q3.pop()
    Array[int] qs = q3.to_array()
    eqI(qs.len(), 3, "② to_array 扣掉已出队")
    eqI(qs[0], 2, "② to_array 第一个是队首")

    // pop_n：一次出队 n 个，按出队顺序返回
    var q4 = new ct.Queue[int]()
    q4.push_all([10, 20, 30, 40, 50])
    Array[int] three = q4.pop_n(3)
    eqI(three.len(), 3, "② pop_n 个数")
    eqI(three[0], 10, "② pop_n 顺序 1")
    eqI(three[2], 30, "② pop_n 顺序 3")
    eqI(q4.len(), 2, "② pop_n 后剩余长度")
    eqI(q4.pop(), 40, "② pop_n 之后队首正确")

    // pop_n 边界：n < 1 抛错；n 超过剩余抛错（不静默少给）
    var threwN1 = false
    try {
        q4.pop_n(0)
    } catch e {
        threwN1 = true
    }
    if not threwN1 { fail("② pop_n(0) 必须抛错") }

    var threwN2 = false
    try {
        q4.pop_n(5)          // 只剩 1 个
    } catch e {
        threwN2 = true
    }
    if not threwN2 { fail("② pop_n 超过剩余必须抛错") }
    eqI(q4.len(), 1, "② 抛错后队列不变")

    // pop_n 用满全部（边界 n == len）
    eqI(q4.pop_n(1).len(), 1, "② pop_n(n == len)")

    // ==================== LRU ====================
    var l = new ct.LRU[int](cap = 2)
    eqI(l.capacity(), 2, "③ 容量")
    l.put("a", 1)
    l.put("b", 2)
    eqI(l.len(), 2, "③ 装满")

    // 命中 a 会把它提升为"最近使用"⇒ 再插 c 时要淘汰的是 b
    eqI(l.get("a", -1), 1, "③ 命中 a")
    l.put("c", 3)
    if l.has("b") { fail("③ b 应被淘汰（按最近访问，不是按插入）") }
    if not l.has("a") { fail("③ a 应保留") }
    eqI(l.get("b", -1), -1, "③ 缺失返回调用点给的默认值")
    eqI(l.len(), 2, "③ 淘汰后仍是 2")

    l.remove("a")
    eqI(l.len(), 1, "③ remove 后长度")
    if l.has("a") { fail("③ remove 后查不到") }

    // 调小容量 ⇒ 立刻淘汰到新上限
    l.put("d", 4)
    l.put("e", 5)
    l.set_capacity(1)
    eqI(l.len(), 1, "③ set_capacity 调小后立刻裁剪")

    var threw3 = false
    try {
        l.set_capacity(0)
    } catch e {
        threw3 = true
    }
    if not threw3 { fail("③ 容量 0 必须报错") }

    l.clear()
    eqI(l.len(), 0, "③ clear")

    // peek 只读、不提升 ⇒ 不能改变淘汰顺序
    var lp = new ct.LRU[int](cap = 2)
    lp.put("a", 1)
    lp.put("b", 2)
    eqI(lp.peek("a", -1), 1, "③ peek 命中")
    eqI(lp.peek("zz", -9), -9, "③ peek 缺失返回默认值")
    lp.put("c", 3)              // a 只 peek 过（没提升）⇒ 淘汰的仍是 a
    if lp.has("a") { fail("③ peek 不该提升访问序（a 应被淘汰）") }
    if not lp.has("b") { fail("③ peek 后 b 必须保留") }

    // put 必须把被淘汰的 key 交出来（缓存里装 Ptr/文件句柄时要当场释放）
    var le = new ct.LRU[int](cap = 2)
    le.put("x", 1)
    le.put("y", 2)
    string? gone = le.put("z", 3)
    if gone is string => gk {
        if gk != "x" { fail("③ put 返回的被淘汰 key 应为 x，实际 " + gk) }
    } else {
        fail("③ put 满了必须返回被淘汰的 key（否则资源泄漏）")
    }
    string? none = le.put("z", 9)      // 覆盖已存在的 key ⇒ 不淘汰
    if none != null { fail("③ 覆盖已存在 key 不该报告淘汰") }

    // keys()：最久 → 最近
    Array[string] lk = le.keys()
    eqI(lk.len(), 2, "③ keys 长度")
    if lk[1] != "z" { fail("③ keys 末尾应是最新访问的 z，实际 " + lk[1]) }

    // set_capacity 缩容 ⇒ 返回被淘汰的全部 key
    Array[string] dropped = le.set_capacity(1)
    eqI(dropped.len(), 1, "③ 缩容返回被淘汰的 key 个数")
    eqI(le.len(), 1, "③ 缩容后长度")

    // ==================== ClockLRU（O(1) 近似 LRU）====================
    var c = new ct.ClockLRU[int](cap = 4)
    eqI(c.capacity(), 4, "④ 容量")
    eqI(c.len(), 0, "④ 新容器为空")
    for 0 : 3 to i { c.put("k" + _str(i), i) }
    eqI(c.len(), 4, "④ 装满 4")
    eqI(c.get("k1", -1), 1, "④ 命中")
    eqI(c.peek("k2", -1), 2, "④ peek 命中")
    eqI(c.get("nope", -1), -1, "④ 缺失返回默认值")
    eqI(c.peek("nope", -7), -7, "④ peek 缺失返回默认值")

    // 满了再写 ⇒ 淘汰一格，长度必须恒定；被淘汰的 key 必须交出来（缓存装 Ptr 时要释放）
    string? ev = c.put("k4", 4)
    eqI(c.len(), 4, "④ 淘汰后长度恒定")
    if not c.has("k4") { fail("④ 新写的 key 必须在") }
    if not c.has("k1") { fail("④ k1 刚被 get 提升过，必须留下") }
    if ev is string => ek {
        if c.has(ek) { fail("④ 报告被淘汰的 key " + ek + " 仍在容器里") }
    } else {
        fail("④ 满了再 put 必须返回被淘汰的 key（否则资源泄漏）")
    }

    // keys()：环上还活着的 key 都要在
    Array[string] ck = c.keys()
    eqI(ck.len(), 4, "④ keys 长度 = len")
    string? again = c.put("k4", 44)
    if again != null { fail("④ 覆盖写不该报告淘汰") }

    // 覆盖写：不新增长度、值要换掉
    c.put("k1", 111)
    eqI(c.get("k1", -1), 111, "④ 覆盖写")
    eqI(c.len(), 4, "④ 覆盖写不增长度")

    // remove 留死槽，后续 put 要复用 ⇒ 长度不虚增
    c.remove("k1")
    eqI(c.len(), 3, "④ remove 后长度")
    if c.has("k1") { fail("④ remove 后查不到") }
    c.put("k9", 9)
    eqI(c.len(), 4, "④ 死槽被复用，长度不虚增")

    // 容量只能调大
    c.set_capacity(8)
    eqI(c.capacity(), 8, "④ 调大容量")
    c.put("k10", 10)
    eqI(c.len(), 5, "④ 调大后能装更多")

    var threw4 = false
    try {
        c.set_capacity(2)
    } catch e {
        threw4 = true
    }
    if not threw4 { fail("④ ClockLRU 缩容必须报错（定长环只支持调大）") }
    eqI(c.capacity(), 8, "④ 缩容失败后容量不变")

    var threw5 = false
    try {
        c.set_capacity(0)
    } catch e {
        threw5 = true
    }
    if not threw5 { fail("④ 容量 0 必须报错") }

    // clear 后能重新用
    c.clear()
    eqI(c.len(), 0, "④ clear")
    c.put("x", 1)
    eqI(c.get("x", -1), 1, "④ clear 后重新写入")

    // ==================== PriorityQueue（二叉堆）====================
    var pq = new ct.PriorityQueue[int](cmp = func(int a, int b): int {
        if a > b { return -1 }      // 大顶堆：大的先出
        if a < b { return 1 }
        return 0
    })
    if not pq.is_empty() { fail("⑤ 新堆应为空") }
    pq.push(5)
    pq.push(1)
    pq.push(9)
    pq.push(3)
    pq.push(7)
    eqI(pq.len(), 5, "⑤ 入堆 5 个")
    eqI(pq.top(), 9, "⑤ top 是最大值")
    eqI(pq.len(), 5, "⑤ top 不出队")

    Array[int] want5 = [9, 7, 5, 3, 1]
    for 0 : 4 to i {
        int gotv = pq.pop()
        if gotv != want5[i] {
            fail("⑤ 大顶堆出队顺序第 " + _str(i) + " 个应为 " + _str(want5[i]) + "，实际 " + _str(gotv))
        }
    }
    if not pq.is_empty() { fail("⑤ 全部出队后应为空") }

    // 空堆取值必须抛错
    var threwP1 = false
    try {
        pq.pop()
    } catch e {
        threwP1 = true
    }
    if not threwP1 { fail("⑤ 空堆 pop 必须抛错") }

    var threwP2 = false
    try {
        pq.top()
    } catch e {
        threwP2 = true
    }
    if not threwP2 { fail("⑤ 空堆 top 必须抛错") }

    // 同优先级 FIFO（堆本身不稳定，容器内部用入队序号打破）
    struct PQItem {
        string name = ""
        int w = 0
    }
    var ps = new ct.PriorityQueue[PQItem](cmp = func(PQItem a, PQItem b): int {
        if a.w > b.w { return -1 }
        if a.w < b.w { return 1 }
        return 0
    })
    ps.push(new PQItem(name = "a", w = 1))
    ps.push(new PQItem(name = "x", w = 5))
    ps.push(new PQItem(name = "b", w = 1))
    ps.push(new PQItem(name = "y", w = 5))
    ps.push(new PQItem(name = "c", w = 1))
    Array[string] wantNames = ["x", "y", "a", "b", "c"]
    Array[PQItem] drained = ps.drain_sorted()
    eqI(drained.len(), 5, "⑤ drain_sorted 长度")
    for 0 : 4 to i {
        if drained[i].name != wantNames[i] {
            fail("⑤ 同优先级应 FIFO：第 " + _str(i) + " 个应为 " + wantNames[i] + "，实际 " + drained[i].name)
        }
    }
    if not ps.is_empty() { fail("⑤ drain_sorted 后应为空") }

    // 不给比较器 ⇒ 全部相等 ⇒ 退化成先进先出
    var pf = new ct.PriorityQueue[int]()
    pf.push(3)
    pf.push(1)
    pf.push(2)
    Array[int] fifo = pf.drain_sorted()
    if fifo[0] != 3 or fifo[1] != 1 or fifo[2] != 2 {
        fail("⑤ 无比较器时退化为 FIFO（实际 " + _str(fifo[0]) + "," + _str(fifo[1]) + "," + _str(fifo[2]) + "）")
    }

    // to_array 是堆序（只保证父优于子），长度必须对；clear 后能复用
    var pc = new ct.PriorityQueue[int](cmp = func(int a, int b): int { return a - b })   // 小顶堆
    for [4, 2, 8] to v { pc.push(v) }
    eqI(pc.to_array().len(), 3, "⑤ to_array 长度")
    eqI(pc.top(), 2, "⑤ 小顶堆 top 是最小值")
    pc.clear()
    eqI(pc.len(), 0, "⑤ clear")
    pc.push(1)
    eqI(pc.top(), 1, "⑤ clear 后复用")

    // ==================== on_evict：自动淘汰时交还资源 ====================
    // 为什么必须有：缓存里装的是纹理 Ptr / 文件句柄时，淘汰那一刻得释放，否则就是泄漏。
    Array[string] fired = []
    var lo = new ct.LRU[int](cap = 2, on_evict = func(string k, int v): void {
        fired.add(k + "=" + _str(v))
    })
    lo.put("a", 1)
    lo.put("b", 2)
    eqI(fired.len(), 0, "⑥ 未超容量时不该触发")
    lo.put("c", 3)
    eqI(fired.len(), 1, "⑥ 超容量淘汰触发一次")
    if fired[0] != "a=1" { fail("⑥ 回调参数应为被淘汰的 key/value，实际 " + fired[0]) }
    lo.remove("b")
    eqI(fired.len(), 1, "⑥ 显式 remove 不触发回调（调用方自己收尾）")
    lo.clear()
    eqI(fired.len(), 2, "⑥ clear 触发剩余条目（c=3）")
    if fired[1] != "c=3" { fail("⑥ clear 回调参数错，实际 " + fired[1]) }

    // ClockLRU 同一语义
    Array[string] cfired = []
    var co = new ct.ClockLRU[int](cap = 2, on_evict = func(string k, int v): void {
        cfired.add(k + "=" + _str(v))
    })
    co.put("a", 1)
    co.put("b", 2)
    eqI(cfired.len(), 0, "⑥ ClockLRU 未超容量不触发")
    co.put("c", 3)
    eqI(cfired.len(), 1, "⑥ ClockLRU 淘汰触发")
    co.remove("b")
    eqI(cfired.len(), 1, "⑥ ClockLRU remove 不触发")
    co.clear()
    eqI(cfired.len(), 2, "⑥ ClockLRU clear 触发剩余")

    // ==================== Deque：双端队列 ====================
    var dq = new ct.Deque[int]()
    if not dq.is_empty() { fail("⑦ 新 deque 应为空") }
    eqI(dq.len(), 0, "⑦ 新 deque 长度 0")

    var dqThrew = 0
    try { dq.pop_front() } catch e { dqThrew = dqThrew + 1 }
    try { dq.pop_back() } catch e { dqThrew = dqThrew + 1 }
    try { dq.peek_front() } catch e { dqThrew = dqThrew + 1 }
    try { dq.peek_back() } catch e { dqThrew = dqThrew + 1 }
    eqI(dqThrew, 4, "⑦ 空 deque 两端取值都必须抛错")

    dq.push_back(1)
    dq.push_back(2)
    dq.push_back(3)
    dq.push_front(0)
    dq.push_front(-1)
    eqI(dq.len(), 5, "⑦ 两端入队后长度")
    eqI(dq.peek_front(), -1, "⑦ peek_front")
    eqI(dq.peek_back(), 3, "⑦ peek_back")
    eqI(dq.at(0), -1, "⑦ at(0) = 队首")
    eqI(dq.at(2), 1, "⑦ at(2) 跨前后段")
    eqI(dq.at(4), 3, "⑦ at(4) = 队尾")

    var dqArr = dq.to_array()
    eqI(dqArr.len(), 5, "⑦ to_array 长度")
    if dqArr[0] != -1 or dqArr[4] != 3 { fail("⑦ to_array 顺序不对") }

    dq.set(2, 99)
    eqI(dq.at(2), 99, "⑦ set 写入跨段槽位")

    eqI(dq.pop_front(), -1, "⑦ pop_front 1")
    eqI(dq.pop_back(), 3, "⑦ pop_back 1")
    eqI(dq.pop_front(), 0, "⑦ pop_front 2")
    eqI(dq.len(), 2, "⑦ 两端出队后长度")

    var dqOut = 0
    try { dq.at(5) } catch e { dqOut = 1 }
    eqI(dqOut, 1, "⑦ at 越界必须抛错")

    // 从中间摘一个（CDP 事件那种用法）
    var dq2 = new ct.Deque[string]()
    dq2.push_back("a"); dq2.push_back("bb"); dq2.push_back("ccc")
    if dq2.remove_at(1) != "bb" { fail("⑦ remove_at 返回值") }
    eqI(dq2.len(), 2, "⑦ remove_at 后长度")
    if dq2.at(0) != "a" or dq2.at(1) != "ccc" { fail("⑦ remove_at 后顺序") }

    // 空后重用
    dq.clear()
    eqI(dq.len(), 0, "⑦ clear 后长度 0")
    dq.push_back(7)
    eqI(dq.pop_back(), 7, "⑦ clear 后可重用")

    // 压力：交替两端进出，顺序必须与参考数组一致
    var dq3 = new ct.Deque[int]()
    Array[int] ref = []
    for 0 : 199 to i {
        dq3.push_front(i)
        ref.insert(0, i)
        if i % 3 == 0 { dq3.push_back(i * 10); ref.add(i * 10) }
        if i % 5 == 0 {
            if dq3.pop_back() != ref.pop() { fail("⑦ 压力 pop_back 顺序错（i=" + _str(i) + "）") }
        }
    }
    eqI(dq3.len(), ref.len(), "⑦ 压力后长度与参考一致")
    for 0 : ref.len() - 1 to i {
        if dq3.at(i) != ref[i] { fail("⑦ 压力第 " + _str(i) + " 项不一致") }
    }
    while not dq3.is_empty() { dq3.pop_front() }
    eqI(dq3.len(), 0, "⑦ 全部出队后为空")

    // ==================== LRUO1：严格最近访问淘汰 + 全 O(1) ====================
    var o = new ct.LRUO1[int](cap = 2)
    eqI(o.capacity(), 2, "⑧ 容量")
    o.put("a", 1)
    o.put("b", 2)
    eqI(o.get("a", -1), 1, "⑧ 命中 a（提升为最近使用）")
    o.put("c", 3)                       // 此时 b 是最久未使用 ⇒ 淘汰 b（严格，不是近似）
    if o.has("b") { fail("⑧ 应淘汰 b") }
    if not o.has("a") or not o.has("c") { fail("⑧ a/c 应保留") }
    eqI(o.len(), 2, "⑧ 淘汰后长度")
    eqI(o.get("zz", -9), -9, "⑧ 缺失返回默认值")
    eqI(o.peek("a", -1), 1, "⑧ peek 命中")

    // keys() 顺序：最久未使用 → 最近使用
    var ks = o.keys()
    eqI(ks.len(), 2, "⑧ keys 长度")
    if ks[0] != "a" or ks[1] != "c" { fail("⑧ keys 顺序应为 a（最旧）→ c（最新），实际 " + ks[0] + "," + ks[1]) }

    // put 已有 key：值更新 + 提升到尾部，不增长度、不淘汰
    o.put("a", 111)
    eqI(o.len(), 2, "⑧ 覆盖写不增长度")
    eqI(o.get("a", -1), 111, "⑧ 覆盖写生效")
    var ks2 = o.keys()
    if ks2[1] != "a" { fail("⑧ 覆盖写应把 a 提到最近使用") }

    // remove：摘掉后可复用槽位
    o.remove("a")
    eqI(o.len(), 1, "⑧ remove 后长度")
    if o.has("a") { fail("⑧ remove 后查不到") }
    o.put("d", 4)
    o.put("e", 5)                       // 又一次淘汰（此时 c 最旧）
    eqI(o.len(), 2, "⑧ 复用槽位后长度仍为 2")

    // set_capacity 调小立即淘汰
    var o2 = new ct.LRUO1[int](cap = 4)
    for 0 : 3 to i { o2.put("k" + _str(i), i) }
    var oGone = o2.set_capacity(2)
    eqI(oGone.len(), 2, "⑧ set_capacity 返回被淘汰的 key")
    eqI(o2.len(), 2, "⑧ 调小后长度")
    if oGone[0] != "k0" or oGone[1] != "k1" {
        fail("⑧ 调小容量应按最久未使用顺序淘汰，实际 " + oGone[0] + "," + oGone[1])
    }

    // on_evict：严格淘汰时逐条通知
    Array[string] ofired = []
    var o3 = new ct.LRUO1[int](cap = 2, on_evict = func(string kk, int vv): void {
        ofired.add(kk + "=" + _str(vv))
    })
    o3.put("a", 1)
    o3.put("b", 2)
    o3.put("c", 3)                      // 淘汰 a=1
    eqI(ofired.len(), 1, "⑧ on_evict 触发一次")
    if ofired[0] != "a=1" { fail("⑧ on_evict 参数应为淘汰的 key/value，实际 " + ofired[0]) }
    o3.clear()
    eqI(ofired.len(), 3, "⑧ clear 逐条通知剩余两个")
    eqI(o3.len(), 0, "⑧ clear 后为空")

    // 与 LRU 的**随机对拍**：同样的操作序列，每一步 keys() 必须完全一致
    //   （LRU 是"教科书版"实现 ⇒ 用它对拍 LRUO1 的链表实现，能抓出摘链/接尾的错）
    var refLru = new ct.LRU[int](cap = 16)
    var candO1 = new ct.LRUO1[int](cap = 16)
    int seed = 12345
    for 0 : 1999 to step {
        seed = (seed * 1103515245 + 12345) % 2147483648
        int op = seed % 10
        int keyNo = (seed / 7) % 24
        string key = "k" + _str(keyNo)
        if op < 5 {
            refLru.put(key, keyNo)
            candO1.put(key, keyNo)
        } else if op < 8 {
            int a1 = refLru.get(key, -1)
            int a2 = candO1.get(key, -1)
            if a1 != a2 { fail("⑧ 对拍不一致（get）step=" + _str(step)) }
        } else if op < 9 {
            refLru.remove(key)
            candO1.remove(key)
        } else {
            int b1 = refLru.peek(key, -1)
            int b2 = candO1.peek(key, -1)
            if b1 != b2 { fail("⑧ 对拍不一致（peek）step=" + _str(step)) }
        }
        if refLru.len() != candO1.len() { fail("⑧ 对拍长度不一致 step=" + _str(step)) }
        var rk = refLru.keys()
        var ck = candO1.keys()
        if rk.len() != ck.len() { fail("⑧ 对拍 keys 长度不一致 step=" + _str(step)) }
        for 0 : rk.len() - 1 to ki {
            if rk[ki] != ck[ki] {
                fail("⑧ 对拍 keys 第 " + _str(ki) + " 项不一致（step=" + _str(step) + "）：LRU=" + rk[ki] + " LRUO1=" + ck[ki])
            }
        }
    }

    // ==================== 小接口：at / remove_at / 批量 ====================
    ct.Stack[int] sa = new ct.Stack[int]()
    sa.push(1); sa.push(2); sa.push(3)
    eqI(sa.at(0), 1, "⑨ Stack.at(0) 是栈底")
    eqI(sa.at(2), 3, "⑨ Stack.at(2) 是栈顶")
    var saOut = 0
    try { sa.at(3) } catch e { saOut = 1 }
    eqI(saOut, 1, "⑨ Stack.at 越界抛错")

    ct.Queue[string] qa = new ct.Queue[string]()
    qa.push("a"); qa.push("b"); qa.push("c")
    eqI(qa.at(0).len(), 1, "⑨ Queue.at(0) 是队首")
    if qa.at(2) != "c" { fail("⑨ Queue.at(2) 应为 c") }
    if qa.remove_at(1) != "b" { fail("⑨ Queue.remove_at 返回值") }
    eqI(qa.len(), 2, "⑨ remove_at 后逻辑长度")
    if qa.at(0) != "a" or qa.at(1) != "c" { fail("⑨ remove_at 后顺序") }
    if qa.pop() != "a" { fail("⑨ remove_at 后仍能正常出队") }

    ct.Deque[int] db = new ct.Deque[int]()
    db.push_back_all([1, 2])
    db.push_front_all([9, 8])            // 依次压入 ⇒ 逻辑顺序 8,9,1,2
    eqI(db.len(), 4, "⑨ 批量入队后长度")
    if db.at(0) != 8 or db.at(1) != 9 or db.at(3) != 2 { fail("⑨ push_front_all 顺序") }
    var two = db.pop_front_n(2)
    eqI(two.len(), 2, "⑨ pop_front_n 个数")
    if two[0] != 8 or two[1] != 9 { fail("⑨ pop_front_n 顺序") }
    eqI(db.len(), 2, "⑨ pop_front_n 后长度")
    var dbOut = 0
    try { db.pop_front_n(5) } catch e { dbOut = 1 }
    eqI(dbOut, 1, "⑨ pop_front_n 超过剩余必须抛错")

    print("test_containers passed")
}
