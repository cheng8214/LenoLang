// Containers.leno — LenoContainers 入口（2026-11-24）
// 纯 Leno，无原生依赖。
//
// 为什么需要它：内置只有 Array / Dict，而"队列 / 栈 / LRU"这三个容器几乎每个项目都要重写一遍。
// 重写时**最容易错的不是主体，是边界**——空取返回什么、容量淘汰按插入还是按访问、
// 队列头指针漂移后 len 怎么算。这里把边界行为固定成契约：
//
//   · **空容器取值一律抛错**，不返回 null/0/默认值。空栈 pop 是写错了，
//     给它一个 0 只会让错误漂到很远的地方（Leno 一贯的取向）。
//   · `len()` 始终是**逻辑元素个数**（Queue 的 head 偏移已经扣掉）。
//   · LRU 的淘汰按**最近访问**（get 会提升），不是按插入。

// ==================== Stack：后进先出 ====================
export struct Stack[T] {
    Array[T] items = []

    func push(T v) {
        items.add(v)
    }

    // 空栈 ⇒ 抛错（不返回 null）
    func pop(): T {
        if items.len() == 0 { throw "Stack.pop: 空栈" }
        return items.pop()
    }

    func peek(): T {
        if items.len() == 0 { throw "Stack.peek: 空栈" }
        return items[items.len() - 1]
    }

    func len(): int { return items.len() }
    func is_empty(): bool { return items.len() == 0 }
    func clear() { items.clear() }
}

// ==================== Queue：先进先出 ====================
// 为什么不用 `Array.remove(0)` 实现：那是 O(n) 整体搬移，出队一多就是平方复杂度。
// 这里用 **head 指针 + 惰性压缩**：正常出队只挪指针；积压超过一半且超过 64 个时才真正搬一次，
// 平摊下来是 O(1)。
export struct Queue[T] {
    Array[T] items = []
    int head = 0

    func push(T v) {
        items.add(v)
    }

    func pop(): T {
        // len 只取一次：items.len() 在这里是方法调用，原来空判断和压缩判断各调一次。
        // A/B 实测（bench，N=2M 三轮交替）100 → 94 ns/op，约 -6%
        int n = items.len()
        if head >= n { throw "Queue.pop: 空队列" }
        T v = items[head]
        head = head + 1
        // 惰性压缩：死元素超过一半且总量超过 64 时才搬
        if head > 64 and head * 2 > n {
            Array[T] keep = []
            for head : items.len() - 1 to i {
                keep.add(items[i])
            }
            items = keep
            head = 0
        }
        return v
    }

    func peek(): T {
        if head >= items.len() { throw "Queue.peek: 空队列" }
        return items[head]
    }

    // 逻辑长度（扣掉已经出队、但还没压缩掉的空洞）
    func len(): int { return items.len() - head }
    func is_empty(): bool { return head >= items.len() }
    func clear() {
        items.clear()
        head = 0
    }
}

// ==================== LRU：最近最少使用淘汰 ====================
// 容量淘汰的容器，适合"缓存最近 N 条"（日志尾部、最近打开的文件、热数据）。
//
// ⚠ 复杂度：`get` / `put` 是 **O(n)**（数组里找 key 再搬位置）。cap 在几千以内没问题；
//   真要 O(1) 得做双向链表 + 节点表，Leno 里手写那套的复杂度远超收益（见 README）。
export struct LRU[V] {
    Dict[string, V] map = {}
    Array[string] order = []          // 顺序 = 最近使用（末尾最新）
    int cap = 128

    // 超出容量时淘汰**最久未使用**的那个。
    // 常规 put 只超 1 个 ⇒ 走原地 remove(0)（不分配新数组）；
    // set_capacity 一次缩很多个时走批量裁剪，否则是 O(over×n) 的搬移
    // （4096 → 128：批量裁剪实测 426 us，逐次 remove(0) 是几十毫秒）。
    func _trim() {
        int over = order.len() - cap
        if over <= 0 { return }
        if over == 1 {
            map.remove(order[0])
            order.remove(0)
            return
        }
        for 0 : over - 1 to i { map.remove(order[i]) }
        order = order[over : order.len() - 1]
    }

    func put(string k, V v) {
        if not map.has(k) {
            order.add(k)
        } else {
            // 已存在 ⇒ 提升到末尾（最近使用）
            int i = order.index_of(k)
            if i >= 0 and i < order.len() - 1 {
                order.remove(i)
                order.add(k)
            }
        }
        map[k] = v
        _trim()
    }

    // 缺失 ⇒ 返回调用点显式给的默认值（与 Result.orElse 同风格：默认值必须写明）
    func get(string k, V def): V {
        if not map.has(k) { return def }
        // 命中 ⇒ 提升为最近使用
        int i = order.index_of(k)
        if i >= 0 and i < order.len() - 1 {
            order.remove(i)
            order.add(k)
        }
        return map[k]
    }

    // 只读、**不提升**访问序：批量读（渲染、命中即用）走这个，
    // 不付 index_of + remove + add 的搬移代价（cap=1024 实测 get 2.2us → peek 0.36us，6 倍）
    func peek(string k, V def): V {
        if not map.has(k) { return def }
        return map[k]
    }

    func has(string k): bool { return map.has(k) }

    func remove(string k) {
        if not map.has(k) { return }
        int i = order.index_of(k)
        if i >= 0 { order.remove(i) }
        map.remove(k)
    }

    func len(): int { return order.len() }
    func capacity(): int { return cap }

    // 调小容量会立刻淘汰到新上限（调大不会补数据）
    func set_capacity(int n) {
        if n < 1 { throw "LRU.set_capacity: 容量必须 >= 1（收到 " + _str(n) + "）" }
        cap = n
        _trim()
    }

    func clear() {
        map.clear()
        order.clear()
    }
}

// ==================== ClockLRU：O(1) 近似 LRU（CLOCK 二次机会）====================
// 为什么还要一个：上面的 LRU 淘汰"严格按最近访问"，代价是每次命中都要在 order 里
// index_of 再 remove + add —— 实测 cap=1024 时 get 2.2 us、cap=4096 已到 7.5 us，
// 热数据上千条就受不了。这里换算法而不是换数据结构：
//
//   · **定长环 + 每格一个"最近用过"位（ref）**。get / put / peek 全是 O(1)：
//     命中只写一个 ref 位，不搬数组、不找 key（key→下标在 slot 字典里）。
//   · 淘汰不再"严格最久未使用"，而是**近似**：CLOCK 指针走环，
//     ref=1 ⇒ 清零放过（给第二次机会），ref=0 ⇒ 淘汰，ref=-1 ⇒ 死槽直接复用。
//     每次淘汰最多扫一圈，均摊到每次 put 仍是常数。
//
// 取舍：要"淘汰的确实是最久未使用"就用 LRU（cap 小的时候它够快）；
// 要 cap 上千还能 O(1)，用这个，代价是淘汰顺序只是近似。
export struct ClockLRU[V] {
    Dict[string, V] map = {}          // 值
    Dict[string, int] slot = {}       // key → 环上下标（命中不用遍历）
    Array[string] keys = []           // 环：装满后长度恒为 cap
    Array[int] ref = []               // 1 = 最近用过，0 = 这一圈没用过，-1 = 死槽（remove 留下的）
    int cap = 128
    int hand = 0                      // CLOCK 指针

    func _next(int i): int {
        int n = i + 1
        if n >= cap { return 0 }
        return n
    }

    // 取一个可写的环槽：环没满就追加（只发生在预热阶段），满了就按 CLOCK 走指针
    func _slot(): int {
        if keys.len() < cap {
            keys.add("")
            ref.add(0)
            return keys.len() - 1
        }
        while true {
            int r = ref[hand]
            if r <= 0 {
                if r == 0 {
                    // 二次机会用尽 ⇒ 淘汰这一格（死槽 r=-1 时 map 里早就没了）
                    string old = keys[hand]
                    map.remove(old)
                    slot.remove(old)
                }
                int idx = hand
                hand = _next(hand)
                return idx
            }
            ref[hand] = 0                 // 刚用过 ⇒ 清零、放过，看下一格
            hand = _next(hand)
        }
    }

    func put(string k, V v) {
        if map.has(k) {
            map[k] = v
            ref[slot[k]] = 1
            return
        }
        int i = _slot()
        keys[i] = k
        ref[i] = 1
        slot[k] = i
        map[k] = v
    }

    // 命中 ⇒ 打 ref 位（O(1)），缺失 ⇒ 返回调用点显式给的默认值
    func get(string k, V def): V {
        if not map.has(k) { return def }
        ref[slot[k]] = 1
        return map[k]
    }

    // 只读、不提升（同 LRU.peek）：连 ref 位都不动，用于"命中就读"的批量场景
    func peek(string k, V def): V {
        if not map.has(k) { return def }
        return map[k]
    }

    func has(string k): bool { return map.has(k) }
    func len(): int { return map.len() }
    func capacity(): int { return cap }

    func remove(string k) {
        if not map.has(k) { return }
        int i = slot[k]
        keys[i] = ""                      // 键本身在 slot/map 里删掉，环上留死槽
        ref[i] = -1
        slot.remove(k)
        map.remove(k)
    }

    // ⚠ 只支持**调大**。环是定长数组，缩容要把还活着的项重排进更小的环
    //   —— 那和"定长环换 O(1)"是两套结构，收益远小于复杂度。
    //   真要缩小就 clear() 重来，或者用 LRU。
    func set_capacity(int n) {
        if n < 1 { throw "ClockLRU.set_capacity: 容量必须 >= 1（收到 " + _str(n) + "）" }
        if n < cap {
            throw "ClockLRU.set_capacity: 不支持缩容（当前 " + _str(cap) + " → " + _str(n) + "）；定长环只能调大，需要缩小请 clear() 后重建"
        }
        cap = n
    }

    func clear() {
        map.clear()
        slot.clear()
        keys.clear()
        ref.clear()
        hand = 0
    }
}
