// Containers.leno — LenoContainers 入口（2026-11-24，0.3.0）
// 纯 Leno，无原生依赖。
//
// 为什么需要它：内置只有 Array / Dict，而"栈 / 队列 / 优先队列 / 缓存淘汰"这几样几乎
// 每个项目都要重写一遍。重写时**最容易错的不是主体，是边界**——空取返回什么、容量淘汰
// 按插入还是按访问、队列头指针漂移后 len 怎么算。这里把边界行为固定成契约：
//
//   · **空容器取值一律抛错**，不返回 null/0/默认值。空栈 pop 是写错了，
//     给它一个 0 只会让错误漂到很远的地方（Leno 一贯的取向）。
//     错误串统一前缀 `Containers.<类型>.<方法>:`，调用方要按字符串分支也有得抓。
//   · `len()` 始终是**逻辑元素个数**（Queue 的 head 偏移已经扣掉）。
//   · LRU 的淘汰按**最近访问**（get 会提升，peek 不会）；ClockLRU 是**近似**。
//   · **不带锁**：Leno 的并发模型是 Channel 传值 + thread_local，不做加锁容器。
//     要跨线程就整份传（或把容器放在一个线程里，用 Channel 收发）。
//
// 五个类型：Stack / Queue / PriorityQueue / LRU / ClockLRU。

// ==================== Stack：后进先出 ====================
export struct Stack[T] {
    Array[T] items = []

    func push(T v) {
        items.add(v)
    }

    // 一次灌多个（`new Stack[int](items = arr)` 也能直接给初值，见 README）
    func push_all(Array[T] vs) {
        for vs to v { items.add(v) }
    }

    // 空栈 ⇒ 抛错（不返回 null）
    func pop(): T {
        if items.len() == 0 { throw "Containers.Stack.pop: 空栈" }
        return items.pop()
    }

    func peek(): T {
        if items.len() == 0 { throw "Containers.Stack.peek: 空栈" }
        return items[items.len() - 1]
    }

    func len(): int { return items.len() }
    func is_empty(): bool { return items.len() == 0 }
    func clear() { items.clear() }

    // 快照（栈底 → 栈顶），**非破坏性**：返回值是副本，改它不影响栈
    func to_array(): Array[T] { return items.copy() }
}

// ==================== Queue：先进先出 ====================
// 为什么不用 `Array.remove(0)` 实现：那是 O(n) 整体搬移，出队一多就是平方复杂度。
// 这里用 **head 指针 + 惰性压缩**：正常出队只挪指针；积压超过一半且超过 64 个时才真正搬一次，
// 平摊下来是 O(1)。
export struct Queue[T] {
    Array[T] items = []
    int head = 0

    func push(T v) {
        items.add(v)
    }

    func push_all(Array[T] vs) {
        for vs to v { items.add(v) }
    }

    func pop(): T {
        // len 只取一次：items.len() 在这里是方法调用，原来空判断和压缩判断各调一次。
        // A/B 实测（bench，N=2M 三轮交替）100 → 94 ns/op，约 -6%
        int n = items.len()
        if head >= n { throw "Containers.Queue.pop: 空队列" }
        T v = items[head]
        head = head + 1
        // 惰性压缩：死元素超过一半且总量超过 64 时才搬
        if head > 64 and head * 2 > n {
            Array[T] keep = []
            for head : items.len() - 1 to i {
                keep.add(items[i])
            }
            items = keep
            head = 0
        }
        return v
    }

    // 一次出队 n 个（按出队顺序返回）。n 超过实际数量 ⇒ 抛错（不静默少给）
    func pop_n(int n): Array[T] {
        if n < 1 { throw "Containers.Queue.pop_n: 数量必须 >= 1（收到 " + _str(n) + "）" }
        int total = items.len()
        int avail = total - head
        if n > avail {
            throw "Containers.Queue.pop_n: 只剩 " + _str(avail) + " 个，取不到 " + _str(n) + " 个"
        }
        Array[T] out = items[head : head + n - 1]
        head = head + n
        if head > 64 and head * 2 > total {
            Array[T] keep = []
            for head : total - 1 to i { keep.add(items[i]) }
            items = keep
            head = 0
        }
        return out
    }

    func peek(): T {
        if head >= items.len() { throw "Containers.Queue.peek: 空队列" }
        return items[head]
    }

    // 逻辑长度（扣掉已经出队、但还没压缩掉的空洞）
    func len(): int { return items.len() - head }
    func is_empty(): bool { return head >= items.len() }
    func clear() {
        items.clear()
        head = 0
    }

    // 快照（队首 → 队尾），**非破坏性**：返回副本，出队游标不动
    func to_array(): Array[T] {
        int n = items.len()
        if head == 0 { return items.copy() }
        if head >= n { return [] }
        return items[head : n - 1]
    }
}

// ==================== PriorityQueue：二叉堆（优先队列）====================
// 为什么需要：内置没有堆，而"任务调度 / 定时器 / A* / top-K / 带权 BFS"都要用；
// 实测 LenoWeb 的爬虫就自己内联抄了一份（web_crawler.leno 的 _siftUp/_siftDown）。
// 手写堆最容易错的两处这里都固定住：
//   · **同优先级 FIFO**：比较器返回 0 时按**入队序号**先入先出（堆本身不稳定，
//     LenoWeb 当年为此另加了一个 seq 字段自己比）；
//   · **空堆取值抛错**（不是返回 null，那样错误会漂走）。
export struct PriorityQueue[T] {
    Array[T] heap = []
    Array[int] seqs = []              // 与 heap 平行的入队序号（做"同优先级 FIFO"的稳定打破）
    int next_seq = 0
    // < 0 ⇒ a 先出；> 0 ⇒ b 先出；0 ⇒ 相等（容器内部按入队序打破）
    // null ⇒ 全部视为相等（等价于先进先出队列，用于"只想按插入序处理"的兜底）
    func(T, T):int cmp = null

    // ⚠ 比较与交换**必须内联**在这个两个循环里，不能抽成 `_better(i,j)` / `_swap(i,j)`：
    //   每层堆操作各调一次 ⇒ 每次 push/pop 白花 (log n) 次方法调用。
    //   实测（N=500k 随机优先级）：抽成方法时 pop 7 421 ns/op，内联后见 bench 的当前读数
    //   （每次比较里已含一次 `cmp` 函数调用 ~55 ns，那是必须付的）。

    func push(T v) {
        heap.add(v)
        seqs.add(next_seq)
        next_seq = next_seq + 1
        int i = heap.len() - 1
        while i > 0 {
            int p = (i - 1) / 2
            int c = 0
            if cmp != null { c = cmp(heap[i], heap[p]) }
            if c > 0 { break }                        // i 不比父优先
            if c == 0 and not (seqs[i] < seqs[p]) { break }   // 同优先级：先入先出
            T t = heap[i]
            heap[i] = heap[p]
            heap[p] = t
            int s = seqs[i]
            seqs[i] = seqs[p]
            seqs[p] = s
            i = p
        }
    }

    func pop(): T {
        int n = heap.len()
        if n == 0 { throw "Containers.PriorityQueue.pop: 空堆" }
        T top = heap[0]
        T last = heap[n - 1]
        int last_seq = seqs[n - 1]
        heap.remove(n - 1)
        seqs.remove(n - 1)
        n = n - 1
        if n > 0 {
            heap[0] = last
            seqs[0] = last_seq
            int i = 0
            while true {
                int l = i * 2 + 1
                if l >= n { break }
                int best = i
                int c1 = 0
                if cmp != null { c1 = cmp(heap[l], heap[best]) }
                if c1 < 0 or (c1 == 0 and seqs[l] < seqs[best]) { best = l }
                int r = l + 1
                if r < n {
                    int c2 = 0
                    if cmp != null { c2 = cmp(heap[r], heap[best]) }
                    if c2 < 0 or (c2 == 0 and seqs[r] < seqs[best]) { best = r }
                }
                if best == i { break }
                T t = heap[i]
                heap[i] = heap[best]
                heap[best] = t
                int s = seqs[i]
                seqs[i] = seqs[best]
                seqs[best] = s
                i = best
            }
        }
        return top
    }

    // 看一眼队首（最小/最高优先级），不出队；空堆抛错
    func top(): T {
        if heap.len() == 0 { throw "Containers.PriorityQueue.top: 空堆" }
        return heap[0]
    }

    func len(): int { return heap.len() }
    func is_empty(): bool { return heap.len() == 0 }
    func clear() {
        heap.clear()
        seqs.clear()
        next_seq = 0
    }

    // ⚠ 这是**堆序**（只保证父优于子），不是出队顺序。
    //   要真实出队顺序用 drain_sorted()（会清空），或自己循环 pop。
    func to_array(): Array[T] { return heap.copy() }

    // 依次弹出全部元素 ⇒ 真实的出队顺序（用完堆为空）。
    // 给"要按优先级持久化 / 打印整队"的场景（LenoWeb 存断点就是先把堆倒空再压回去）。
    func drain_sorted(): Array[T] {
        Array[T] out = []
        while heap.len() > 0 { out.add(pop()) }
        return out
    }
}

// ==================== Deque：双端队列 ====================
// 为什么需要它（2026-11-24）：`Queue` 只能"尾进头出"，`Stack` 只能"一头进出"，
// 而下面这些真实需求两头都要动：
//   · 撤销/重做（`sdl_edit`）：新快照压到**尾**、旧快照从**头**丢；
//   · 日志窗（`sdl_listbox`）：追加到尾部、超过上限丢最旧的头；
//   · CDP 事件队列（`web_cdp`）：按到达序入队、按 method 从**中间**取走。
// 用 `Array.remove(0)` 硬凑都是 O(n) 搬移。
//
// 实现：**两段式**（不做环形、也不用占位符）——
//   · `f` 反向存前半段（`f` 的末尾就是逻辑第一个）；
//   · `b` 正向存后半段（`b[bh]` 是前半段之后的下一个，`bh` 是惰性头偏移）。
//   两端 push 都是 O(1)；`pop_back` 遇到 `b` 空了就把 `f` 整体倒进 `b`
//   （每个元素一辈子最多搬一次 ⇒ **平摊 O(1)**）。
//   为什么不用"单数组 + 头预留空隙"：Leno 的泛型没法造 `T` 的占位值来预留空隙。
export struct Deque[T] {
    Array[T] f = []                  // 前半段（反向）：f[f.len()-1] = 逻辑第 0 个
    Array[T] b = []                  // 后半段（正向）
    int bh = 0                       // b 的头偏移（出队只挪它，超过一半且 >64 才真正搬）
    // 逻辑长度单独维护：`len()` 走字段读（~5 ns），而不是两次方法调用（~50 ns）。
    // 每次进出队都要同步改它 —— 这是唯一容易出错的地方，单测里覆盖了压力场景。
    int n = 0

    func len(): int { return n }
    func is_empty(): bool { return n == 0 }

    func push_back(T v) { b.add(v); n = n + 1 }
    func push_front(T v) { f.add(v); n = n + 1 }

    func pop_front(): T {
        int fn = f.len()
        if fn > 0 { n = n - 1; return f.pop() }
        int bn = b.len()
        if bh >= bn { throw "Containers.Deque.pop_front: 空队列" }
        T v = b[bh]
        bh = bh + 1
        n = n - 1
        // 惰性压缩（同 Queue）：死元素超过一半且总量超过 64 时才搬一次
        if bh > 64 and bh * 2 > bn {
            Array[T] keep = []
            for bh : bn - 1 to i { keep.add(b[i]) }
            b = keep
            bh = 0
        }
        return v
    }

    func pop_back(): T {
        int bn = b.len()
        if bn > bh {
            T v = b.pop()
            if bh >= bn - 1 { b.clear(); bh = 0 }
            n = n - 1
            return v
        }
        if n == 0 { throw "Containers.Deque.pop_back: 空队列" }
        // b 空了但 f 还有：整体倒进 b（f 的末尾 = 逻辑第一个 ⇒ 逐个 pop 出来 add 到 b
        // 正好恢复正序）。每元素最多搬这一次 ⇒ 平摊 O(1)。
        b.clear()
        bh = 0
        while f.len() > 0 { b.add(f.pop()) }
        T v = b.pop()
        if b.len() == 0 { b.clear(); bh = 0 }
        n = n - 1
        return v
    }

    func peek_front(): T {
        int fn = f.len()
        if fn > 0 { return f[fn - 1] }
        if bh >= b.len() { throw "Containers.Deque.peek_front: 空队列" }
        return b[bh]
    }

    func peek_back(): T {
        int bn = b.len()
        if bn > bh { return b[bn - 1] }
        if n == 0 { throw "Containers.Deque.peek_back: 空队列" }
        return f[0]
    }

    // 按**逻辑下标**取（0 = 队首）；越界抛错（不返回 null）
    func at(int i): T {
        int fn = f.len()
        if i < 0 or i >= n {
            throw "Containers.Deque.at: 下标越界（" + _str(i) + " / " + _str(n) + "）"
        }
        if i < fn { return f[fn - 1 - i] }
        return b[bh + i - fn]
    }

    func set(int i, T v) {
        int fn = f.len()
        if i < 0 or i >= n {
            throw "Containers.Deque.set: 下标越界（" + _str(i) + " / " + _str(n) + "）"
        }
        if i < fn { f[fn - 1 - i] = v; return }
        b[bh + i - fn] = v
    }

    // ⚠ O(n)：要搬后面所有元素。给"按条件摘一个"的队列用（如 CDP 事件），别放进热循环。
    func remove_at(int i): T {
        if i < 0 or i >= n {
            throw "Containers.Deque.remove_at: 下标越界（" + _str(i) + " / " + _str(n) + "）"
        }
        Array[T] all = to_array()
        T v = all[i]
        f.clear()
        b.clear()
        bh = 0
        n = 0
        for 0 : all.len() - 1 to j {
            if j != i { b.add(all[j]); n = n + 1 }
        }
        return v
    }

    func to_array(): Array[T] {
        Array[T] out = []
        int fn = f.len()
        for 0 : fn - 1 to i { out.add(f[fn - 1 - i]) }
        for bh : b.len() - 1 to i { out.add(b[i]) }
        return out
    }

    func clear() {
        f.clear()
        b.clear()
        bh = 0
        n = 0
    }
}

// ==================== LRU：最近最少使用淘汰 ====================
// 容量淘汰的容器，适合"缓存最近 N 条"（日志尾部、最近打开的文件、热数据）。
//
// ⚠ 复杂度：`get` / `put` 是 **O(n)**（数组里找 key 再搬位置）。cap 在几千以内没问题；
//   要 O(1) 用 ClockLRU（近似淘汰）。`peek` 不搬位置，是 O(1)。
export struct LRU[V] {
    Dict[string, V] map = {}
    Array[string] order = []          // 顺序 = 最近使用（末尾最新）
    int cap = 128
    // 淘汰回调（可选）：`on_evict(key, value)` —— **自动淘汰**（超容量 / set_capacity 缩容 /
    // clear）时逐条触发，用于释放 V 里装的资源（纹理 Ptr、打开的文件、socket）。
    // ⚠ 显式 `remove(k)` **不触发**：那是调用方主动拿走的，由它自己负责收尾。
    func(string, V):void on_evict = null

    func _fire(string k) {
        if on_evict != null { on_evict(k, map[k]) }
    }

    // 超出容量时淘汰**最久未使用**的那个，返回被淘汰的 key（null = 没淘汰）。
    // 为什么要把淘汰的 key 交出去：除了 on_evict 回调，调用方有时还要记账（日志/统计）。
    //
    // 常规 put 只超 1 个 ⇒ 走原地 remove(0)（不分配新数组）；
    // set_capacity 一次缩很多个时走批量裁剪，否则是 O(over×n) 的搬移
    // （4096 → 128：批量裁剪实测 251 us，逐次 remove(0) 是几十毫秒）。
    func _trim(): Array[string] {
        Array[string] out = []
        int over = order.len() - cap
        if over <= 0 { return out }
        if over == 1 {
            string k0 = order[0]
            _fire(k0)
            out.add(k0)
            map.remove(k0)
            order.remove(0)
            return out
        }
        for 0 : over - 1 to i {
            _fire(order[i])
            out.add(order[i])
            map.remove(order[i])
        }
        order = order[over : order.len() - 1]
        return out
    }

    func put(string k, V v): string? {
        if not map.has(k) {
            order.add(k)
        } else {
            // 已存在 ⇒ 提升到末尾（最近使用）
            int i = order.index_of(k)
            if i >= 0 and i < order.len() - 1 {
                order.remove(i)
                order.add(k)
            }
        }
        map[k] = v
        Array[string] gone = _trim()
        if gone.len() > 0 { return gone[0] }
        return null
    }

    // 缺失 ⇒ 返回调用点显式给的默认值（与 Result.orElse 同风格：默认值必须写明）
    func get(string k, V def): V {
        if not map.has(k) { return def }
        // 命中 ⇒ 提升为最近使用
        int i = order.index_of(k)
        if i >= 0 and i < order.len() - 1 {
            order.remove(i)
            order.add(k)
        }
        return map[k]
    }

    // 只读、**不提升**访问序：批量读（渲染、命中即用）走这个，
    // 不付 index_of + remove + add 的搬移代价（cap=1024 实测 get 2.2us → peek 0.36us，6 倍）
    func peek(string k, V def): V {
        if not map.has(k) { return def }
        return map[k]
    }

    func has(string k): bool { return map.has(k) }

    func remove(string k) {
        if not map.has(k) { return }
        int i = order.index_of(k)
        if i >= 0 { order.remove(i) }
        map.remove(k)
    }

    func len(): int { return order.len() }
    func capacity(): int { return cap }

    // 现存 key，顺序 = 最久未使用 → 最近使用（order 的原始顺序，**非破坏性**）
    func keys(): Array[string] { return order.copy() }

    // 调小容量会立刻淘汰到新上限（调大不会补数据），返回被淘汰的 key（最久 → 较新）
    func set_capacity(int n): Array[string] {
        if n < 1 { throw "Containers.LRU.set_capacity: 容量必须 >= 1（收到 " + _str(n) + "）" }
        cap = n
        return _trim()
    }

    // 清空；挂了 on_evict 就逐条通知（整表释放资源用）
    func clear() {
        if on_evict != null {
            Array[string] ks = order.copy()
            for ks to k { on_evict(k, map[k]) }
        }
        map.clear()
        order.clear()
    }
}

// ==================== ClockLRU：O(1) 近似 LRU（CLOCK 二次机会）====================
// 为什么还要一个：上面的 LRU 淘汰"严格按最近访问"，代价是每次命中都要在 order 里
// index_of 再 remove + add —— 实测 cap=1024 时 get 2.2 us、cap=4096 已到 7.5 us，
// 热数据上千条就受不了。这里换算法而不是换数据结构：
//
//   · **定长环 + 每格一个"最近用过"位（ref）**。get / put / peek 全是 O(1)：
//     命中只写一个 ref 位，不搬数组、不找 key（key→下标在 slot 字典里）。
//   · 淘汰不再"严格最久未使用"，而是**近似**：CLOCK 指针走环，
//     ref=1 ⇒ 清零放过（给第二次机会），ref=0 ⇒ 淘汰，ref=-1 ⇒ 死槽直接复用。
//     每次淘汰最多扫一圈，均摊到每次 put 仍是常数。
//
// 取舍：要"淘汰的确实是最久未使用"就用 LRU（cap 小的时候它够快）；
// 要 cap 上千还能 O(1)，用这个，代价是淘汰顺序只是近似。
export struct ClockLRU[V] {
    Dict[string, V] map = {}          // 值
    Dict[string, int] slot = {}       // key → 环上下标（命中不用遍历）
    Array[string] ring = []           // 环：装满后长度恒为 cap
    Array[int] ref = []               // 1 = 最近用过，0 = 这一圈没用过，-1 = 死槽（remove 留下的）
    int cap = 128
    int hand = 0                      // CLOCK 指针
    string? _evicted = null           // put 内部淘汰的 key（返回给调用方记账用）
    // 淘汰回调（可选）：语义与 LRU.on_evict **完全一致**（自动淘汰 + clear 触发，remove 不触发）
    func(string, V):void on_evict = null

    func _next(int i): int {
        int n = i + 1
        if n >= cap { return 0 }
        return n
    }

    // 取一个可写的环槽：环没满就追加（只发生在预热阶段），满了就按 CLOCK 走指针
    func _slot(): int {
        if ring.len() < cap {
            ring.add("")
            ref.add(0)
            return ring.len() - 1
        }
        while true {
            int r = ref[hand]
            if r <= 0 {
                if r == 0 {
                    // 二次机会用尽 ⇒ 淘汰这一格（死槽 r=-1 时 map 里早就没了）
                    string old = ring[hand]
                    if on_evict != null { on_evict(old, map[old]) }
                    map.remove(old)
                    slot.remove(old)
                    _evicted = old
                }
                int idx = hand
                hand = _next(hand)
                return idx
            }
            ref[hand] = 0                 // 刚用过 ⇒ 清零、放过，看下一格
            hand = _next(hand)
        }
    }

    // 返回被淘汰的 key（null = 没淘汰）：缓存里装 Ptr/文件句柄时靠它当场释放
    func put(string k, V v): string? {
        if map.has(k) {
            map[k] = v
            ref[slot[k]] = 1
            return null
        }
        _evicted = null
        int i = _slot()
        ring[i] = k
        ref[i] = 1
        slot[k] = i
        map[k] = v
        return _evicted
    }

    // 命中 ⇒ 打 ref 位（O(1)），缺失 ⇒ 返回调用点显式给的默认值
    func get(string k, V def): V {
        if not map.has(k) { return def }
        ref[slot[k]] = 1
        return map[k]
    }

    // 只读、不提升（同 LRU.peek）：连 ref 位都不动，用于"命中就读"的批量场景
    func peek(string k, V def): V {
        if not map.has(k) { return def }
        return map[k]
    }

    func has(string k): bool { return map.has(k) }
    func len(): int { return map.len() }
    func capacity(): int { return cap }

    func remove(string k) {
        if not map.has(k) { return }
        int i = slot[k]
        ring[i] = ""                      // 键本身在 slot/map 里删掉，环上留死槽
        ref[i] = -1
        slot.remove(k)
        map.remove(k)
    }

    // ⚠ 只支持**调大**。环是定长数组，缩容要把还活着的项重排进更小的环
    //   —— 那和"定长环换 O(1)"是两套结构，收益远小于复杂度。
    //   真要缩小就 clear() 重来，或者用 LRU。返回空数组（保持与 LRU.set_capacity 同形）。
    func set_capacity(int n): Array[string] {
        if n < 1 { throw "Containers.ClockLRU.set_capacity: 容量必须 >= 1（收到 " + _str(n) + "）" }
        if n < cap {
            throw "Containers.ClockLRU.set_capacity: 不支持缩容（当前 " + _str(cap) + " → " + _str(n) + "）；定长环只能调大，需要缩小请 clear() 后重建"
        }
        cap = n
        return []
    }

    // 现存 key（**环序**，不是访问序；要知道"谁最该被淘汰"只有 LRU 能给）
    func keys(): Array[string] {
        Array[string] out = []
        for 0 : ring.len() - 1 to i {
            if ref[i] >= 0 { out.add(ring[i]) }
        }
        return out
    }

    // 清空；挂了 on_evict 就逐条通知（整表释放资源用）
    func clear() {
        if on_evict != null {
            for 0 : ring.len() - 1 to i {
                if ref[i] >= 0 { on_evict(ring[i], map[ring[i]]) }
            }
        }
        map.clear()
        slot.clear()
        ring.clear()
        ref.clear()
        hand = 0
        _evicted = null
    }
}
