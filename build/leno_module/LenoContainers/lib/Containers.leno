// Containers.leno — LenoContainers 入口（2026-11-24，0.3.0）
// 纯 Leno，无原生依赖。
//
// 为什么需要它：内置只有 Array / Dict，而"栈 / 队列 / 优先队列 / 缓存淘汰"这几样几乎
// 每个项目都要重写一遍。重写时**最容易错的不是主体，是边界**——空取返回什么、容量淘汰
// 按插入还是按访问、队列头指针漂移后 len 怎么算。这里把边界行为固定成契约：
//
//   · **空容器取值一律抛错**，不返回 null/0/默认值。空栈 pop 是写错了，
//     给它一个 0 只会让错误漂到很远的地方（Leno 一贯的取向）。
//     错误串统一前缀 `Containers.<类型>.<方法>:`，调用方要按字符串分支也有得抓。
//   · `len()` 始终是**逻辑元素个数**（Queue 的 head 偏移已经扣掉）。
//   · LRU 的淘汰按**最近访问**（get 会提升，peek 不会）；ClockLRU 是**近似**。
//   · **不带锁**：Leno 的并发模型是 Channel 传值 + thread_local，不做加锁容器。
//     要跨线程就整份传（或把容器放在一个线程里，用 Channel 收发）。
//
// 七个类型：Stack / Queue / Deque / PriorityQueue / LRU / ClockLRU / LRUO1。

// ==================== 遍历协议：face Iterable（2026-11-25）====================
// `for c to v` 的**声明式**入口。编译器只做结构判定、**不认识任何名字**：
//
//     struct 恰好实现 1 个 face、该 face 恰好 1 个方法、且该方法返回 Array
//        ⇒ for 遍历 `c.<那个方法>()` 的结果（元素）
//     否则（0 个 face / 多个 face / 方法不返回 Array）
//        ⇒ 仍是**字段遍历**（本语言 for struct 的原有语义）
//
// 所以：想让自己的类型能被 `for` 遍历元素，就 `impl Iterable` 并实现 `each()`：
//     export struct Stack[T] impl Iterable { func each(): Array[T] { return items } … }
// 编译器里没有 "Iterable"、没有 "each" —— 这两个名字只存在于这份声明里。
//
// ── `each()` 的契约（三条，都别踩）────────────────────────────────────────────
// ① **顺序**：按迭代顺序返回元素。`for c to v, i` 里的 `i` 就是这个数组的下标。
// ② **视图 or 快照，由实现者决定**：
//      元素连续（Stack / PriorityQueue / LRU 的 order）⇒ 直接返回内部数组（零分配、实时视图）；
//      元素不连续（Queue 有 head 空洞、Deque 分 f/b 两段）⇒ 返回 `to_array()`（快照）。
//    两种都合法，但**调用方不能假设是哪一种**。
// ③ **不得在遍历中修改容器**：视图情况下新增会让循环"边加边遍历"（实测 5 项能跑到 20 次，
//    理论上停不下来），删除会跳过元素。
//    本模块的结构性方法都标了 **`mut`**（`mut func push(T v) { … }`）⇒ 编译期会给
//    `for st to v { st.push(x) }` 报 `WARN_ITER_MUTATE`，**跨模块也生效**
//    （标志随 .lenosymc 导出，不是靠编译器认模块 API）。
//    真要边遍历边改：先把要处理的元素收集到临时数组，循环后再统一改；
//    或者用游标 `iter()` 显式表达"我在实时遍历"。
// （旧版曾在 C 里内置同名 face 并 `strdup("each")`，那是把写死换了个地方放，已弃用。）
export face Iterable {
    func each(): Array
}

// ==================== 零分配遍历：游标（Iter / DequeIter）====================
// 背景：`for st to v` 是**语义期改写成 `st.to_array()`** ⇒ 每轮遍历先复制一份快照
//   （README 里只能写"热路径请自己按下标走"）。这里给出**不复制**的写法：
//
//     var it = st.iter()
//     while it.has_next() { string v = it.next() }   // 只多一个游标结构，零数组分配
//
// 语义差别（要知道）：
//   · `for st to v` 走**快照** ⇒ 循环体里改容器不影响本轮遍历（安全，但每轮一次分配）；
//   · `iter()` 走**实时**视图 ⇒ 循环体里 pop/add 会影响本轮（与"按下标走"一致）。
//   想两者兼得：热路径用 iter()，循环体别改容器。
//
// 用法上的注意：`next()` 返回 `T?`（空容器/已走完给 null），所以取值要收窄：
//     while it.has_next() { if it.next() is string => s { ... } }
export struct Iter[T] {
    Array[T] items = []          // 底层数组（引用语义：不复制元素）
    int pos = 0
    int stop = 0                 // 上界（Queue 用它扣掉 head 之前的空洞）

    func has_next(): bool { return pos < stop }
    func remaining(): int { return stop - pos }

    func next(): T? {
        if pos >= stop { return null }
        T v = items[pos]
        pos = pos + 1
        return v
    }
}

// Deque 的元素分两段（f 反向 + b 正向）⇒ 游标要多带几个字段，但同样**不复制**
export struct DequeIter[T] {
    Array[T] f = []
    Array[T] b = []
    int bh = 0
    int n = 0
    int pos = 0

    func has_next(): bool { return pos < n }
    func remaining(): int { return n - pos }

    func next(): T? {
        if pos >= n { return null }
        int fn = f.len()
        T v = if pos < fn then f[fn - 1 - pos] else b[bh + pos - fn]
        pos = pos + 1
        return v
    }
}

// ==================== Stack：后进先出 ====================
export struct Stack[T] impl Iterable {
    Array[T] items = []

    mut func push(T v) {
        items.add(v)
    }

    // 一次灌多个（`new Stack[int](items = arr)` 也能直接给初值，见 README）
    func push_all(Array[T] vs) {
        for vs to v { items.add(v) }
    }

    // 空栈 ⇒ 抛错（不返回 null）
    mut func pop(): T {
        if items.len() == 0 { throw "Containers.Stack.pop: 空栈" }
        return items.pop()
    }

    func peek(): T {
        if items.len() == 0 { throw "Containers.Stack.peek: 空栈" }
        return items[items.len() - 1]
    }

    func len(): int { return items.len() }
    func is_empty(): bool { return items.len() == 0 }

    // 零分配遍历（栈底 → 栈顶）：`var it = st.iter(); while it.has_next() { it.next() }`
    func iter(): Iter[T] { return new Iter[T](items = items, pos = 0, stop = items.len()) }

    // ★ 2026-11-25（P1.1）：**返回内部数组本身**（不复制）。语义期看到 `raw` 就把
    //   `for st to v` 改写成 `for st.raw() to v` ⇒ 零分配 + 数组迭代的满速路径。
    //   代价：这是**实时视图**（循环体里 push/pop 会被看到；边遍历边改容器本来就不该做）。
    func raw(): Array[T] { return items }

    // face Iterable 的契约方法：`for st to v` 走这条（栈底 → 栈顶，零复制）
    func each(): Array[T] { return items }
    mut func clear() { items.clear() }

    // 快照（栈底 → 栈顶），**非破坏性**：返回值是副本，改它不影响栈
    func to_array(): Array[T] { return items.copy() }

    // 按**逻辑下标**看元素（0 = 栈底）；越界抛错（与 Deque.at 同口径）
    func at(int i): T {
        if i < 0 or i >= items.len() {
            throw "Containers.Stack.at: 下标越界（" + _str(i) + " / " + _str(items.len()) + "）"
        }
        return items[i]
    }
}

// ==================== Queue：先进先出 ====================
// 为什么不用 `Array.remove(0)` 实现：那是 O(n) 整体搬移，出队一多就是平方复杂度。
// 这里用 **head 指针 + 惰性压缩**：正常出队只挪指针；积压超过一半且超过 64 个时才真正搬一次，
// 平摊下来是 O(1)。
export struct Queue[T] impl Iterable {
    Array[T] items = []
    int head = 0

    mut func push(T v) {
        items.add(v)
    }

    func push_all(Array[T] vs) {
        for vs to v { items.add(v) }
    }

    mut func pop(): T {
        // len 只取一次：items.len() 在这里是方法调用，原来空判断和压缩判断各调一次。
        // A/B 实测（bench，N=2M 三轮交替）100 → 94 ns/op，约 -6%
        int n = items.len()
        if head >= n { throw "Containers.Queue.pop: 空队列" }
        T v = items[head]
        head = head + 1
        // 惰性压缩：死元素超过一半且总量超过 64 时才搬
        if head > 64 and head * 2 > n {
            Array[T] keep = []
            for head : items.len() - 1 to i {
                keep.add(items[i])
            }
            items = keep
            head = 0
        }
        return v
    }

    // 一次出队 n 个（按出队顺序返回）。n 超过实际数量 ⇒ 抛错（不静默少给）
    func pop_n(int n): Array[T] {
        if n < 1 { throw "Containers.Queue.pop_n: 数量必须 >= 1（收到 " + _str(n) + "）" }
        int total = items.len()
        int avail = total - head
        if n > avail {
            throw "Containers.Queue.pop_n: 只剩 " + _str(avail) + " 个，取不到 " + _str(n) + " 个"
        }
        Array[T] out = items[head : head + n - 1]
        head = head + n
        if head > 64 and head * 2 > total {
            Array[T] keep = []
            for head : total - 1 to i { keep.add(items[i]) }
            items = keep
            head = 0
        }
        return out
    }

    func peek(): T {
        if head >= items.len() { throw "Containers.Queue.peek: 空队列" }
        return items[head]
    }

    // 逻辑长度（扣掉已经出队、但还没压缩掉的空洞）
    func len(): int { return items.len() - head }
    func is_empty(): bool { return head >= items.len() }

    // 零分配遍历（队首 → 队尾）：pos 从 head 起，天然跳过已出队的空洞
    func iter(): Iter[T] { return new Iter[T](items = items, pos = head, stop = items.len()) }

    // face Iterable：队首 → 队尾（快照：内部有 head 空洞，不能直接给数组）
    func each(): Array[T] { return to_array() }

    // 按**逻辑下标**看元素（0 = 队首）；越界抛错（与 Deque.at 同口径）
    func at(int i): T {
        int n = items.len() - head
        if i < 0 or i >= n {
            throw "Containers.Queue.at: 下标越界（" + _str(i) + " / " + _str(n) + "）"
        }
        return items[head + i]
    }

    // 摘掉第 i 个（0 = 队首）。⚠ O(n)：要搬后面的元素 —— 给"按条件取走一条"的队列用，
    //   别放进热循环（纯 FIFO 出队请继续用 pop()）。
    mut func remove_at(int i): T {
        int n = items.len() - head
        if i < 0 or i >= n {
            throw "Containers.Queue.remove_at: 下标越界（" + _str(i) + " / " + _str(n) + "）"
        }
        return items.remove(head + i)
    }
    mut func clear() {
        items.clear()
        head = 0
    }

    // 快照（队首 → 队尾），**非破坏性**：返回副本，出队游标不动
    func to_array(): Array[T] {
        int n = items.len()
        if head == 0 { return items.copy() }
        if head >= n { return [] }
        return items[head : n - 1]
    }
}

// ==================== PriorityQueue：二叉堆（优先队列）====================
// 为什么需要：内置没有堆，而"任务调度 / 定时器 / A* / top-K / 带权 BFS"都要用；
// 实测 LenoWeb 的爬虫就自己内联抄了一份（web_crawler.leno 的 _siftUp/_siftDown）。
// 手写堆最容易错的两处这里都固定住：
//   · **同优先级 FIFO**：比较器返回 0 时按**入队序号**先入先出（堆本身不稳定，
//     LenoWeb 当年为此另加了一个 seq 字段自己比）；
//   · **空堆取值抛错**（不是返回 null，那样错误会漂走）。
export struct PriorityQueue[T] impl Iterable {
    Array[T] heap = []
    Array[int] seqs = []              // 与 heap 平行的入队序号（做"同优先级 FIFO"的稳定打破）
    int next_seq = 0
    // < 0 ⇒ a 先出；> 0 ⇒ b 先出；0 ⇒ 相等（容器内部按入队序打破）
    // null ⇒ 全部视为相等（等价于先进先出队列，用于"只想按插入序处理"的兜底）
    func(T, T):int cmp = null

    // ⚠ 比较与交换**必须内联**在这个两个循环里，不能抽成 `_better(i,j)` / `_swap(i,j)`：
    //   每层堆操作各调一次 ⇒ 每次 push/pop 白花 (log n) 次方法调用。
    //   实测（N=500k 随机优先级）：抽成方法时 pop 7 421 ns/op，内联后见 bench 的当前读数
    //   （每次比较里已含一次 `cmp` 函数调用 ~55 ns，那是必须付的）。

    mut func push(T v) {
        heap.add(v)
        seqs.add(next_seq)
        next_seq = next_seq + 1
        int i = heap.len() - 1
        while i > 0 {
            int p = (i - 1) / 2
            int c = 0
            if cmp != null { c = cmp(heap[i], heap[p]) }
            if c > 0 { break }                        // i 不比父优先
            if c == 0 and not (seqs[i] < seqs[p]) { break }   // 同优先级：先入先出
            T t = heap[i]
            heap[i] = heap[p]
            heap[p] = t
            int s = seqs[i]
            seqs[i] = seqs[p]
            seqs[p] = s
            i = p
        }
    }

    mut func pop(): T {
        int n = heap.len()
        if n == 0 { throw "Containers.PriorityQueue.pop: 空堆" }
        T top = heap[0]
        T last = heap[n - 1]
        int last_seq = seqs[n - 1]
        heap.remove(n - 1)
        seqs.remove(n - 1)
        n = n - 1
        if n > 0 {
            heap[0] = last
            seqs[0] = last_seq
            int i = 0
            while true {
                int l = i * 2 + 1
                if l >= n { break }
                int best = i
                int c1 = 0
                if cmp != null { c1 = cmp(heap[l], heap[best]) }
                if c1 < 0 or (c1 == 0 and seqs[l] < seqs[best]) { best = l }
                int r = l + 1
                if r < n {
                    int c2 = 0
                    if cmp != null { c2 = cmp(heap[r], heap[best]) }
                    if c2 < 0 or (c2 == 0 and seqs[r] < seqs[best]) { best = r }
                }
                if best == i { break }
                T t = heap[i]
                heap[i] = heap[best]
                heap[best] = t
                int s = seqs[i]
                seqs[i] = seqs[best]
                seqs[best] = s
                i = best
            }
        }
        return top
    }

    // 看一眼队首（最小/最高优先级），不出队；空堆抛错
    func top(): T {
        if heap.len() == 0 { throw "Containers.PriorityQueue.top: 空堆" }
        return heap[0]
    }

    func len(): int { return heap.len() }
    func is_empty(): bool { return heap.len() == 0 }

    // 零分配遍历：**堆序**（只保证父优于子，不是出队顺序；要优先级顺序用 drain_sorted）
    func iter(): Iter[T] { return new Iter[T](items = heap, pos = 0, stop = heap.len()) }

    // 内部堆数组本身（P1.1：让 `for pq to v` 零分配）
    func raw(): Array[T] { return heap }

    // face Iterable 的契约方法：堆序（只保证父优于子；要出队序用 drain_sorted）
    func each(): Array[T] { return heap }
    mut func clear() {
        heap.clear()
        seqs.clear()
        next_seq = 0
    }

    // ⚠ 这是**堆序**（只保证父优于子），不是出队顺序。
    //   要真实出队顺序用 drain_sorted()（会清空），或自己循环 pop。
    func to_array(): Array[T] { return heap.copy() }

    // 依次弹出全部元素 ⇒ 真实的出队顺序（用完堆为空）。
    // 给"要按优先级持久化 / 打印整队"的场景（LenoWeb 存断点就是先把堆倒空再压回去）。
    mut func drain_sorted(): Array[T] {
        Array[T] out = []
        while heap.len() > 0 { out.add(pop()) }
        return out
    }
}

// ==================== Deque：双端队列 ====================
// 为什么需要它（2026-11-24）：`Queue` 只能"尾进头出"，`Stack` 只能"一头进出"，
// 而下面这些真实需求两头都要动：
//   · 撤销/重做（`sdl_edit`）：新快照压到**尾**、旧快照从**头**丢；
//   · 日志窗（`sdl_listbox`）：追加到尾部、超过上限丢最旧的头；
//   · CDP 事件队列（`web_cdp`）：按到达序入队、按 method 从**中间**取走。
// 用 `Array.remove(0)` 硬凑都是 O(n) 搬移。
//
// 实现：**两段式**（不做环形、也不用占位符）——
//   · `f` 反向存前半段（`f` 的末尾就是逻辑第一个）；
//   · `b` 正向存后半段（`b[bh]` 是前半段之后的下一个，`bh` 是惰性头偏移）。
//   两端 push 都是 O(1)；`pop_back` 遇到 `b` 空了就把 `f` 整体倒进 `b`
//   （每个元素一辈子最多搬一次 ⇒ **平摊 O(1)**）。
//   为什么不用"单数组 + 头预留空隙"：Leno 的泛型没法造 `T` 的占位值来预留空隙。
export struct Deque[T] impl Iterable {
    Array[T] f = []                  // 前半段（反向）：f[f.len()-1] = 逻辑第 0 个
    Array[T] b = []                  // 后半段（正向）
    int bh = 0                       // b 的头偏移（出队只挪它，超过一半且 >64 才真正搬）
    // 逻辑长度单独维护：`len()` 走字段读（~5 ns），而不是两次方法调用（~50 ns）。
    // 每次进出队都要同步改它 —— 这是唯一容易出错的地方，单测里覆盖了压力场景。
    int n = 0

    func len(): int { return n }
    func is_empty(): bool { return n == 0 }

    // 零分配遍历（队首 → 队尾）：跨 f/b 两段的实时视图
    func iter(): DequeIter[T] { return new DequeIter[T](f = f, b = b, bh = bh, n = n, pos = 0) }

    // face Iterable：队首 → 队尾（快照：元素分 f/b 两段）
    func each(): Array[T] { return to_array() }

    mut func push_back(T v) { b.add(v); n = n + 1 }
    mut func push_front(T v) { f.add(v); n = n + 1 }

    // 一次灌多个（顺序 = 数组顺序）：push_back_all 把 [a,b] 追加到尾部；
    // push_front_all 把 [a,b] 依次从头部压入 ⇒ 逻辑顺序变成 b,a,…
    func push_back_all(Array[T] vs) { for vs to v { b.add(v); n = n + 1 } }
    func push_front_all(Array[T] vs) { for vs to v { f.add(v); n = n + 1 } }

    // 一次性从队首取走 k 个（按出队顺序）；k 超过剩余 ⇒ 抛错（不静默少给）
    func pop_front_n(int k): Array[T] {
        if k < 1 { throw "Containers.Deque.pop_front_n: 个数必须 >= 1（收到 " + _str(k) + "）" }
        if k > n { throw "Containers.Deque.pop_front_n: 只剩 " + _str(n) + " 个，要取 " + _str(k) }
        Array[T] out = []
        for 0 : k - 1 to _ { out.add(pop_front()) }
        return out
    }

    mut func pop_front(): T {
        int fn = f.len()
        if fn > 0 { n = n - 1; return f.pop() }
        int bn = b.len()
        if bh >= bn { throw "Containers.Deque.pop_front: 空队列" }
        T v = b[bh]
        bh = bh + 1
        n = n - 1
        // 惰性压缩（同 Queue）：死元素超过一半且总量超过 64 时才搬一次
        if bh > 64 and bh * 2 > bn {
            Array[T] keep = []
            for bh : bn - 1 to i { keep.add(b[i]) }
            b = keep
            bh = 0
        }
        return v
    }

    mut func pop_back(): T {
        int bn = b.len()
        if bn > bh {
            T v = b.pop()
            if bh >= bn - 1 { b.clear(); bh = 0 }
            n = n - 1
            return v
        }
        if n == 0 { throw "Containers.Deque.pop_back: 空队列" }
        // b 空了但 f 还有：整体倒进 b（f 的末尾 = 逻辑第一个 ⇒ 逐个 pop 出来 add 到 b
        // 正好恢复正序）。每元素最多搬这一次 ⇒ 平摊 O(1)。
        b.clear()
        bh = 0
        while f.len() > 0 { b.add(f.pop()) }
        T v = b.pop()
        if b.len() == 0 { b.clear(); bh = 0 }
        n = n - 1
        return v
    }

    func peek_front(): T {
        int fn = f.len()
        if fn > 0 { return f[fn - 1] }
        if bh >= b.len() { throw "Containers.Deque.peek_front: 空队列" }
        return b[bh]
    }

    func peek_back(): T {
        int bn = b.len()
        if bn > bh { return b[bn - 1] }
        if n == 0 { throw "Containers.Deque.peek_back: 空队列" }
        return f[0]
    }

    // 按**逻辑下标**取（0 = 队首）；越界抛错（不返回 null）
    func at(int i): T {
        int fn = f.len()
        if i < 0 or i >= n {
            throw "Containers.Deque.at: 下标越界（" + _str(i) + " / " + _str(n) + "）"
        }
        if i < fn { return f[fn - 1 - i] }
        return b[bh + i - fn]
    }

    func set(int i, T v) {
        int fn = f.len()
        if i < 0 or i >= n {
            throw "Containers.Deque.set: 下标越界（" + _str(i) + " / " + _str(n) + "）"
        }
        if i < fn { f[fn - 1 - i] = v; return }
        b[bh + i - fn] = v
    }

    // ⚠ O(n)：要搬后面所有元素。给"按条件摘一个"的队列用（如 CDP 事件），别放进热循环。
    mut func remove_at(int i): T {
        if i < 0 or i >= n {
            throw "Containers.Deque.remove_at: 下标越界（" + _str(i) + " / " + _str(n) + "）"
        }
        Array[T] all = to_array()
        T v = all[i]
        f.clear()
        b.clear()
        bh = 0
        n = 0
        for 0 : all.len() - 1 to j {
            if j != i { b.add(all[j]); n = n + 1 }
        }
        return v
    }

    func to_array(): Array[T] {
        Array[T] out = []
        int fn = f.len()
        for 0 : fn - 1 to i { out.add(f[fn - 1 - i]) }
        for bh : b.len() - 1 to i { out.add(b[i]) }
        return out
    }

    mut func clear() {
        f.clear()
        b.clear()
        bh = 0
        n = 0
    }
}

// ==================== LRU：最近最少使用淘汰 ====================
// 容量淘汰的容器，适合"缓存最近 N 条"（日志尾部、最近打开的文件、热数据）。
//
// ⚠ 复杂度：`get` / `put` 是 **O(n)**（数组里找 key 再搬位置）。cap 在几千以内没问题；
//   要 O(1) 用 ClockLRU（近似淘汰）。`peek` 不搬位置，是 O(1)。
export struct LRU[V] impl Iterable {
    Dict[string, V] map = {}
    Array[string] order = []          // 顺序 = 最近使用（末尾最新）
    int cap = 128
    // 淘汰回调（可选）：`on_evict(key, value)` —— **自动淘汰**（超容量 / set_capacity 缩容 /
    // clear）时逐条触发，用于释放 V 里装的资源（纹理 Ptr、打开的文件、socket）。
    // ⚠ 显式 `remove(k)` **不触发**：那是调用方主动拿走的，由它自己负责收尾。
    func(string, V):void on_evict = null

    func _fire(string k) {
        if on_evict != null { on_evict(k, map[k]) }
    }

    // 超出容量时淘汰**最久未使用**的那个，返回被淘汰的 key（null = 没淘汰）。
    // 为什么要把淘汰的 key 交出去：除了 on_evict 回调，调用方有时还要记账（日志/统计）。
    //
    // 常规 put 只超 1 个 ⇒ 走原地 remove(0)（不分配新数组）；
    // set_capacity 一次缩很多个时走批量裁剪，否则是 O(over×n) 的搬移
    // （4096 → 128：批量裁剪实测 251 us，逐次 remove(0) 是几十毫秒）。
    func _trim(): Array[string] {
        Array[string] out = []
        int over = order.len() - cap
        if over <= 0 { return out }
        if over == 1 {
            string k0 = order[0]
            _fire(k0)
            out.add(k0)
            map.remove(k0)
            order.remove(0)
            return out
        }
        for 0 : over - 1 to i {
            _fire(order[i])
            out.add(order[i])
            map.remove(order[i])
        }
        order = order[over : order.len() - 1]
        return out
    }

    mut func put(string k, V v): string? {
        if not map.has(k) {
            order.add(k)
        } else {
            // 已存在 ⇒ 提升到末尾（最近使用）
            int i = order.index_of(k)
            if i >= 0 and i < order.len() - 1 {
                order.remove(i)
                order.add(k)
            }
        }
        map[k] = v
        Array[string] gone = _trim()
        if gone.len() > 0 { return gone[0] }
        return null
    }

    // 缺失 ⇒ 返回调用点显式给的默认值（与 Result.orElse 同风格：默认值必须写明）
    func get(string k, V def): V {
        if not map.has(k) { return def }
        // 命中 ⇒ 提升为最近使用
        int i = order.index_of(k)
        if i >= 0 and i < order.len() - 1 {
            order.remove(i)
            order.add(k)
        }
        return map[k]
    }

    // 只读、**不提升**访问序：批量读（渲染、命中即用）走这个，
    // 不付 index_of + remove + add 的搬移代价（cap=1024 实测 get 2.2us → peek 0.36us，6 倍）
    func peek(string k, V def): V {
        if not map.has(k) { return def }
        return map[k]
    }

    func has(string k): bool { return map.has(k) }

    mut func remove(string k) {
        if not map.has(k) { return }
        int i = order.index_of(k)
        if i >= 0 { order.remove(i) }
        map.remove(k)
    }

    func len(): int { return order.len() }
    func capacity(): int { return cap }

    // 现存 key，顺序 = 最久未使用 → 最近使用（order 的原始顺序，**非破坏性**）
    func keys(): Array[string] { return order.copy() }

    // 零分配遍历 key（最久 → 最近）：省掉 keys() 的那次复制
    func keys_iter(): Iter[string] { return new Iter[string](items = order, pos = 0, stop = order.len()) }

    // 内部 order 数组本身（P1.1：让 `for lru to k` 零分配；顺序同 keys()）
    func raw(): Array[string] { return order }

    // face Iterable 的契约方法：遍历 **key**（最久 → 最近，零复制）
    func each(): Array[string] { return order }

    // 调小容量会立刻淘汰到新上限（调大不会补数据），返回被淘汰的 key（最久 → 较新）
    mut func set_capacity(int n): Array[string] {
        if n < 1 { throw "Containers.LRU.set_capacity: 容量必须 >= 1（收到 " + _str(n) + "）" }
        cap = n
        return _trim()
    }

    // 清空；挂了 on_evict 就逐条通知（整表释放资源用）
    mut func clear() {
        if on_evict != null {
            Array[string] ks = order.copy()
            for ks to k { on_evict(k, map[k]) }
        }
        map.clear()
        order.clear()
    }
}

// ==================== ClockLRU：O(1) 近似 LRU（CLOCK 二次机会）====================
// 为什么还要一个：上面的 LRU 淘汰"严格按最近访问"，代价是每次命中都要在 order 里
// index_of 再 remove + add —— 实测 cap=1024 时 get 2.2 us、cap=4096 已到 7.5 us，
// 热数据上千条就受不了。这里换算法而不是换数据结构：
//
//   · **定长环 + 每格一个"最近用过"位（ref）**。get / put / peek 全是 O(1)：
//     命中只写一个 ref 位，不搬数组、不找 key（key→下标在 slot 字典里）。
//   · 淘汰不再"严格最久未使用"，而是**近似**：CLOCK 指针走环，
//     ref=1 ⇒ 清零放过（给第二次机会），ref=0 ⇒ 淘汰，ref=-1 ⇒ 死槽直接复用。
//     每次淘汰最多扫一圈，均摊到每次 put 仍是常数。
//
// 取舍：要"淘汰的确实是最久未使用"就用 LRU（cap 小的时候它够快）；
// 要 cap 上千还能 O(1)，用这个，代价是淘汰顺序只是近似。
export struct ClockLRU[V] impl Iterable {
    Dict[string, V] map = {}          // 值
    Dict[string, int] slot = {}       // key → 环上下标（命中不用遍历）
    Array[string] ring = []           // 环：装满后长度恒为 cap
    Array[int] ref = []               // 1 = 最近用过，0 = 这一圈没用过，-1 = 死槽（remove 留下的）
    int cap = 128
    int hand = 0                      // CLOCK 指针
    string? _evicted = null           // put 内部淘汰的 key（返回给调用方记账用）
    // 淘汰回调（可选）：语义与 LRU.on_evict **完全一致**（自动淘汰 + clear 触发，remove 不触发）
    func(string, V):void on_evict = null

    func _next(int i): int {
        int n = i + 1
        if n >= cap { return 0 }
        return n
    }

    // 取一个可写的环槽：环没满就追加（只发生在预热阶段），满了就按 CLOCK 走指针
    func _slot(): int {
        if ring.len() < cap {
            ring.add("")
            ref.add(0)
            return ring.len() - 1
        }
        while true {
            int r = ref[hand]
            if r <= 0 {
                if r == 0 {
                    // 二次机会用尽 ⇒ 淘汰这一格（死槽 r=-1 时 map 里早就没了）
                    string old = ring[hand]
                    if on_evict != null { on_evict(old, map[old]) }
                    map.remove(old)
                    slot.remove(old)
                    _evicted = old
                }
                int idx = hand
                hand = _next(hand)
                return idx
            }
            ref[hand] = 0                 // 刚用过 ⇒ 清零、放过，看下一格
            hand = _next(hand)
        }
    }

    // 返回被淘汰的 key（null = 没淘汰）：缓存里装 Ptr/文件句柄时靠它当场释放
    mut func put(string k, V v): string? {
        if map.has(k) {
            map[k] = v
            ref[slot[k]] = 1
            return null
        }
        _evicted = null
        int i = _slot()
        ring[i] = k
        ref[i] = 1
        slot[k] = i
        map[k] = v
        return _evicted
    }

    // 命中 ⇒ 打 ref 位（O(1)），缺失 ⇒ 返回调用点显式给的默认值
    func get(string k, V def): V {
        if not map.has(k) { return def }
        ref[slot[k]] = 1
        return map[k]
    }

    // 只读、不提升（同 LRU.peek）：连 ref 位都不动，用于"命中就读"的批量场景
    func peek(string k, V def): V {
        if not map.has(k) { return def }
        return map[k]
    }

    func has(string k): bool { return map.has(k) }
    func len(): int { return map.len() }

    // face Iterable：遍历 key（环序；死槽已剔除 —— 与 keys() 同口径）
    func each(): Array[string] { return keys() }
    func capacity(): int { return cap }

    mut func remove(string k) {
        if not map.has(k) { return }
        int i = slot[k]
        ring[i] = ""                      // 键本身在 slot/map 里删掉，环上留死槽
        ref[i] = -1
        slot.remove(k)
        map.remove(k)
    }

    // ⚠ 只支持**调大**。环是定长数组，缩容要把还活着的项重排进更小的环
    //   —— 那和"定长环换 O(1)"是两套结构，收益远小于复杂度。
    //   真要缩小就 clear() 重来，或者用 LRU。返回空数组（保持与 LRU.set_capacity 同形）。
    mut func set_capacity(int n): Array[string] {
        if n < 1 { throw "Containers.ClockLRU.set_capacity: 容量必须 >= 1（收到 " + _str(n) + "）" }
        if n < cap {
            throw "Containers.ClockLRU.set_capacity: 不支持缩容（当前 " + _str(cap) + " → " + _str(n) + "）；定长环只能调大，需要缩小请 clear() 后重建"
        }
        cap = n
        return []
    }

    // 现存 key（**环序**，不是访问序；要知道"谁最该被淘汰"只有 LRU 能给）
    func keys(): Array[string] {
        Array[string] out = []
        for 0 : ring.len() - 1 to i {
            if ref[i] >= 0 { out.add(ring[i]) }
        }
        return out
    }

    // 清空；挂了 on_evict 就逐条通知（整表释放资源用）
    mut func clear() {
        if on_evict != null {
            for 0 : ring.len() - 1 to i {
                if ref[i] >= 0 { on_evict(ring[i], map[ring[i]]) }
            }
        }
        map.clear()
        slot.clear()
        ring.clear()
        ref.clear()
        hand = 0
        _evicted = null
    }
}

// ==================== LRUO1：**严格**最久未使用淘汰，且 get/put 全 O(1) ====================
// 为什么还要第三个 LRU（2026-11-25）：
//   · `LRU`      —— 严格按最近访问淘汰，但 `get` 是 O(n)（数组里找 key 再搬位置）：
//                   cap=1024 时 2 2 µs、cap=4096 已到 7.6 µs；
//   · `ClockLRU` —— O(1) 且曲线平，但淘汰只是**近似**最久未使用（CLOCK 二次机会）。
// 两者之间的空档：**既要严格淘汰顺序、又要 O(1)**。这里用手写双向链表补上 ——
// 不是 `Ptr` 链表，而是**整数下标链表**（`prev/next` 两个 Array[int] + `slot` 字典）：
//   · get 命中 ⇒ 从链上摘下、接到尾（最近使用），O(1)；
//   · put 新 key ⇒ 接到尾；超容量 ⇒ 摘头（head = 最久未使用）淘汰，O(1)；
//   · 节点被 remove/淘汰后下标进**空闲栈**复用，数组不会无限长。
// 代价：每个键多两条 int（8 字节）+ 三个字典/数组项，比 `ClockLRU` 略费内存。
// 选型：cap 小（≤128）三者都行，`LRU` 最省事；cap 上千且要 O(1) 又要严格 ⇒ 用这个；
//       只求"够用的近似" ⇒ `ClockLRU`（它连链都不用维护）。
export struct LRUO1[V] impl Iterable {
    Dict[string, V] map = {}
    Dict[string, int] slot = {}       // key → 节点下标
    Array[int] prev = []              // 双向链表（下标索引，-1 = 无）
    Array[int] next = []
    Array[string] keyAt = []          // 下标 → key（淘汰时要还 key、释放要拿 key 去查值）
    Array[int] freeIdx = []           // 空闲下标栈（remove/淘汰 留下的槽复用）
    int head = -1                     // 最久未使用
    int tail = -1                     // 最近使用
    int cap = 128
    func(string, V):void on_evict = null

    func _alloc(string k): int {
        int i = -1
        if freeIdx.len() > 0 {
            i = freeIdx.pop()
            keyAt[i] = k
        } else {
            i = prev.len()
            prev.add(-1)
            next.add(-1)
            keyAt.add(k)
        }
        return i
    }

    // 接到链表尾（最近使用）
    func _link_back(int i) {
        prev[i] = tail
        next[i] = -1
        if tail >= 0 { next[tail] = i }
        tail = i
        if head < 0 { head = i }
    }

    func _unlink(int i) {
        int p = prev[i]
        int n = next[i]
        if p >= 0 { next[p] = n } else { head = n }
        if n >= 0 { prev[n] = p } else { tail = p }
        prev[i] = -1
        next[i] = -1
    }

    // 摘掉 head（最久未使用）并回收：返回 key（null = 空）
    func _evict_head(): string? {
        if head < 0 { return null }
        int i = head
        string k = keyAt[i]
        _unlink(i)
        if on_evict != null { on_evict(k, map[k]) }
        map.remove(k)
        slot.remove(k)
        keyAt[i] = ""
        freeIdx.add(i)
        return k
    }

    func len(): int { return map.len() }

    // face Iterable：遍历 key（环序；死槽已剔除 —— 与 keys() 同口径）
    func each(): Array[string] { return keys() }
    func capacity(): int { return cap }
    func has(string k): bool { return map.has(k) }

    mut func put(string k, V v): string? {
        if map.has(k) {
            map[k] = v
            int i = slot[k]
            if i != tail {            // 已存在 ⇒ 提升到最近使用（本来就在尾部就不用动）
                _unlink(i)
                _link_back(i)
            }
            return null
        }
        string? evicted = null
        while map.len() >= cap { evicted = _evict_head() }
        int i = _alloc(k)
        map[k] = v
        slot[k] = i
        _link_back(i)
        return evicted
    }

    func get(string k, V def): V {
        if not map.has(k) { return def }
        int i = slot[k]
        if i != tail {
            _unlink(i)
            _link_back(i)
        }
        return map[k]
    }

    // 只读、不提升（同 LRU.peek）
    func peek(string k, V def): V {
        if not map.has(k) { return def }
        return map[k]
    }

    mut func remove(string k) {
        if not map.has(k) { return }
        int i = slot[k]
        _unlink(i)
        map.remove(k)
        slot.remove(k)
        keyAt[i] = ""
        freeIdx.add(i)
    }

    // 现存 key：**最久未使用 → 最近使用**（与 LRU.keys() 同口径，可直接对比/调试）
    func keys(): Array[string] {
        Array[string] out = []
        int i = head
        while i >= 0 {
            out.add(keyAt[i])
            i = next[i]
        }
        return out
    }

    // 调小容量立即淘汰到新上限（返回被淘汰的 key，与 LRU 同口径）
    mut func set_capacity(int n): Array[string] {
        if n < 1 { throw "Containers.LRUO1.set_capacity: 容量必须 >= 1（收到 " + _str(n) + "）" }
        cap = n
        Array[string] out = []
        while map.len() > cap {
            string? k = _evict_head()
            if k is string => ks { out.add(ks) }
        }
        return out
    }

    mut func clear() {
        if on_evict != null {
            int i = head
            while i >= 0 {
                on_evict(keyAt[i], map[keyAt[i]])
                i = next[i]
            }
        }
        map.clear()
        slot.clear()
        prev.clear()
        next.clear()
        keyAt.clear()
        freeIdx.clear()
        head = -1
        tail = -1
    }
}
