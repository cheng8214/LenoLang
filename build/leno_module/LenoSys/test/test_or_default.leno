// Sys.orDefault / Sys.listOr 真实运行验证
import "../lib/Sys.leno" as Sys
import files
import dirs

main() {
    // ① 成功：不抛异常 ⇒ 返回 f() 的结果
    int a = Sys.orDefault(func() { return _int("42") }, -1)
    print("[1] a=" + _str(a) + "（期望 42）\n")

    // ② 失败：_int("abc") 抛异常 ⇒ 返回默认值
    int b = Sys.orDefault(func() { return _int("abc") }, -1)
    print("[2] b=" + _str(b) + "（期望 -1）\n")

    // ③ 数组默认值
    Array[string] c = Sys.orDefault(func() { return ["x", "y"] }, [])
    print("[3] c.len=" + _str(c.len()) + "（期望 2）\n")

    Array[string] c2 = Sys.orDefault(func() { return _int("bad") }, [])
    print("[3b] c2.len=" + _str(c2.len()) + "（期望 0，异常被吃掉）\n")

    // ④ 字符串
    string d = Sys.orDefault(func() { return files.read("Z:\\nope.txt") }, "dflt")
    print("[4] d=" + d + "（期望空串或 dflt）\n")

    // ⑤ 异常确实被吞掉：下面还能正常跑
    print("[5] 程序继续执行 ✓\n")

    // ⑥ listOr：`dirs.listdir` 失败给的是 **null 且不抛异常** ⇒ orDefault 漏、listOr 兜 ✓
    Array[string] e = Sys.listOr(func() { return dirs.listdir("Z:\\__nope_dir__") }, [])
    print("[6] e.len=" + _str(e.len()) + "（期望 0）\n")
    assert_eq(e.len(), 0)

    // ⑦ listOr：正常路径原样返回（别把好数据也换成兜底值）
    Array[string] f2 = Sys.listOr(func() { return dirs.listdir(".") }, [])
    print("[7] f2.len=" + _str(f2.len()) + "（期望 > 0）\n")
    assert_eq(f2.len() > 0, true)

    // ⑧ listOr：真·抛异常也兜（`_int("abc")` 是原生异常）
    Array[string] g = Sys.listOr(func() { return [_str(_int("abc"))] }, ["dflt"])
    print("[8] g=" + _str(g) + "（期望 [dflt]）\n")
    assert_eq(g.len(), 1)
    assert_eq(g[0], "dflt")

    // ⑨ 对照：同一件事走 orDefault 就兜不住（这正是 listOr 存在的理由）
    Array[string] h = Sys.orDefault(func() { return dirs.listdir("Z:\\__nope_dir__") }, [])
    print("[9] orDefault + listdir 失败 => type=" + type(h) + "（期望 null：它只兜异常 ✗）\n")
    assert_eq(type(h), "null")

    print("test_or_default passed\n")
}
