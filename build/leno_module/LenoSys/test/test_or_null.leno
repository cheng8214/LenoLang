// Sys.orNull 真实运行验证：异常和 null 都兜
import "../lib/Sys.leno" as Sys
import dirs
import files

main() {
    // ① 数组：dirs.listdir 失败返回 **null 且不抛异常** ⇒ orNull 兜住
    Array[string] a = Sys.orNull(func() { return dirs.listdir("Z:\\nope") }, [])
    print("[1] 数组失败 len=" + _str(a.len()) + "（期望 0）\n")

    // ② 数组：成功路径原样返回
    Array[string] b = Sys.orNull(func() { return dirs.listdir("C:\\") }, [])
    print("[2] 数组成功 len=" + _str(b.len()) + "（期望 > 0）\n")

    // ③ 标量 + 异常（T=int，验证 v == null 不报错）
    int n = Sys.orNull(func() { return _int("abc") }, -1)
    print("[3] 异常 " + _str(n) + "（期望 -1）\n")

    // ④ 标量 + 成功
    int m = Sys.orNull(func() { return _int("42") }, -1)
    print("[4] 成功 " + _str(m) + "（期望 42）\n")

    // ⑤ 字符串 + null 失败
    string s = Sys.orNull(func() { return files.read("Z:\\nope.txt") }, "dflt")
    print("[5] 字符串 " + s + "（期望 dflt）\n")

    // ⑥ 对照：orDefault 不兜 null（断言它仍是 null，把这个差异钉住）
    Array[string] c = Sys.orDefault(func() { return dirs.listdir("Z:\\nope") }, [])
    print("[6] orDefault 对照 isNull=" + _str(c == null) + "（期望 true：它只兜异常）\n")

    // ⑦ listOr 仍然工作（保留的数组特化）
    Array[string] d = Sys.listOr(func() { return dirs.listdir("Z:\\nope") }, [])
    print("[7] listOr len=" + _str(d.len()) + "（期望 0）\n")
}
