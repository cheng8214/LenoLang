// Sys.leno — **LenoSys 门面**：一套 API，Windows / Linux 同一份调用代码
//
// 用法：
//   import Sys
//   var ps  = Sys.listProcesses()                 // 进程
//   var sp  = Sys.diskSpace(Sys.systemRoot())     // 磁盘
//   var st  = Sys.listStartupItems()              // 开机启动项（Win=注册表 / Linux=autostart）
//   var sw  = Sys.listInstalledSoftware()         // 已装软件（Win=Uninstall 键 / Linux=dpkg）
//   var rec = Sys.recentFiles(20)                 // 最近文件
//   Sys.deleteToTrash(paths) / Sys.emptyTrash()   // 删除到回收站 / 清空回收站
//
// ★ 分层（见各文件头部）：
//   Sys.leno（本文件）      平台分派 + 统一结构体 + 跨平台小工具（env/路径/exec/selfTest）
//   sys_win.leno            Windows 后端（**复用** LenoWin32，未改动它 ✓）
//   sys_linux.leno          Linux 后端（/proc、df、Trash 规范、autostart、dpkg、xbel）
//   sys_parse.leno          纯解析层（只吃文本 ⇒ Windows 上就能全量回归 ✓）
//
// ★ 设计约定：
//   · 后端返回 **Dict**，本文件负责转成导出的结构体（`ProcInfo`/`StartupItem`/`SoftwareItem`）
//     —— 结构体字段类型编译期已知 ⇒ 调用方零收窄 ✓（裸 Array 的成员访问会退化成 any ✗）
//   · macOS 目前**没有后端**：会退到 Linux 分支（路径/df 多数能用；Trash/autostart 语义不同 ⇒
//     调用方请先看 `Sys.os()`；selfTest() 会把实际结果打出来 ✓）
import "./sys_win.leno" as w
import "./sys_linux.leno" as l
import dirs
import files
import strings
import jsons

// ==================== 对外结构体 ====================

export struct ProcInfo {
    int pid = 0
    string name = ""
    string path = ""      // 可执行文件路径（Linux 侧不填：/proc/<pid>/exe 需 readlink ⇒ 慢 ✗）
    int memKb = 0         // 常驻内存（KB；0 = 未查；按需用 processMemoryKb(pid) ✓）
}

export struct StartupItem {
    string scope = ""     // Win: HKCU/HKLM/HKLM32/StartupDir   Linux: user/system
    string id = ""        // 值名 / 子键名 / 文件名
    string name = ""      // 展示名
    string cmd = ""       // 启动命令行
    string source = ""    // registry / startup-folder / autostart
    bool enabled = true   // Linux 的 Hidden/NoDisplay ⇒ false
}

export struct SoftwareItem {
    string name = ""
    string version = ""
    string publisher = ""
    string installPath = ""
    string source = ""    // registry / dpkg
}

// ★ 2026-10-15 新增：回收站条目（`listTrash` 的返回元素 ✓）
export struct TrashItem {
    // ⚠ `name` 的含义**两端不同**（2026-10-15 记）：
    //   Linux   = 回收站里的名字（`files/` 下那个文件名，去重时可能被改成 `a.txt.2` ✓）
    //   Windows = **原文件名**（`$R0UFLFU` 那种名字对用户毫无意义 ⇒ 给用户认得出的那个 ✓）
    string name = ""
    string originalPath = ""  // **原始路径**（还原用；来自 `.trashinfo` 的 Path，已解码 ✓）
    string deletedAt = ""     // 删除时间（`.trashinfo` 的 DeletionDate；空 = 账本没写 ✓）
    string trashDir = ""      // 它属于哪个回收站根（家目录 / 某分区 ✓ —— 跨分区时靠它区分 ✓）
}

// ★ 2026-10-15 新增：系统信息（`sysInfo()` 的返回 ✓）
//   ⚠ 每个字段都可能为空 / 0（读不到、权限不足、平台未实现）
//     ⇒ 调用方必须按"未知"处理，**不要**把 0 当成真的 0 ✗
export struct SysInfo {
    string osName = ""        // 发行版全名（Linux `PRETTY_NAME`）/ Windows 版本
    string kernel = ""        // 内核版本（Linux `osrelease`）/ Windows 内部版本
    string host = ""          // 主机名
    string user = ""          // 当前**登录用户**名（不是显示名 ✓）
    string cpuModel = ""      // CPU 型号（ARM 上可能取不到 ⇒ ""）
    int cpuCount = 0          // 逻辑核数
    int memTotalKb = 0        // 物理内存总量（KB）
    int memAvailKb = 0        // 当前**可用**内存（KB）
    int uptimeSec = 0         // 已运行秒数
    bool elevated = false     // 当前是否 root / 管理员（= `isElevated()` ✓ 单一实现 ✓）
}

// ==================== 平台 ====================

export func os(): string { return _os() }
export func isWindows(): bool { return _os() == "windows" }
export func isLinux(): bool { return _os() == "linux" }
export func isMacos(): bool {
    string o = _os()
    return o == "macos" or o == "darwin" or o == "osx"
}

// 后端分派：只有 win / 非 win 两支（macOS 暂用 Linux 分支 ✓ 见文件头）
func _isW(): bool { return _os() == "windows" }

// ==================== 环境变量 / 路径 ====================

export func env(string name, string def = ""): string { return _env_or(name, def) }

// 展开 `%NAME%`（Windows 风格）与 `$NAME` / `${NAME}`（Unix 风格）——两种都认 ✓
//   取不到的环境变量：**原样保留**（不替换成空串 ✗ —— 静默吞掉会让路径变得看似可用）
export func expandEnv(string s): string {
    string out = ""
    int i = 0
    while (i < s.len()) {
        string c = strings.slice(s, i, i)

        if c == "%" {
            string tail = strings.slice(s, i + 1, s.len())
            int j = strings.find(tail, "%")
            if j > 0 {
                string nm = strings.slice(tail, 0, j - 1)
                string v = _env_or(nm, "")
                if v != "" {
                    out = out + v
                    i = i + j + 2
                    continue
                }
            }
        } else if c == "$" {
            string tail = strings.slice(s, i + 1, s.len())
            string nm = ""
            int used = 0
            if strings.starts_with(tail, "{") {
                int close = strings.find(tail, "}")
                if close > 0 {
                    nm = strings.slice(tail, 1, close - 1)
                    used = close + 1
                }
            } else {
                int k = 0
                while (k < tail.len()) {
                    string ch = strings.slice(tail, k, k)
                    if strings.find("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_", ch) < 0 { break }
                    nm = nm + ch
                    k = k + 1
                }
                used = k
            }
            if nm != "" {
                string v = _env_or(nm, "")
                if v != "" {
                    out = out + v
                    i = i + 1 + used
                    continue
                }
            }
        }

        out = out + c
        i = i + 1
    }
    return out
}

export func homeDir(): string { if _isW() { return w.homeDir() } return l.homeDir() }
export func tempDir(): string { if _isW() { return w.tempDir() } return l.tempDir() }
export func configDir(): string { if _isW() { return w.configDir() } return l.configDir() }
export func dataDir(): string { if _isW() { return w.dataDir() } return l.dataDir() }
export func cacheDir(): string { if _isW() { return w.cacheDir() } return l.cacheDir() }
export func systemRoot(): string { if _isW() { return w.systemRoot() } return l.systemRoot() }
export func pathSep(): string { if _isW() { return w.pathSep() } return l.pathSep() }

// 用本平台的路径分隔符拼接（空段跳过 ✓）
export func joinPath(Array[string] parts): string {
    string sep = pathSep()
    string out = ""
    for parts to p {
        string t = strings.trim(p)
        if t == "" { continue }
        if out == "" { out = t }
        else if strings.ends_with(out, sep) { out = out + t }
        else { out = out + sep + t }
    }
    return out
}

// ==================== 执行命令 ====================

// 在**平台 shell** 里执行（Win: `cmd /c`；Linux: `sh` ✓）
//   返回 {ok, code, out}；起不来 ⇒ ok=false, code=-1 ✓
//   ★ 2026-10-15 更正（本轮实测踩到才查清的）：Linux 侧**不是 popen，是 `system()`** —— 效果同样是
//     "有 sh"（所以 `&`、重定向、管道都能用 ✓），但 **`_exec` 会在命令前面套一层 `timeout`**，
//     而 `timeout` 用 `execvp` 跑命令词 ⇒ **shell 内建（`command`/`type`/`test`）当命令词会直接失败**
//     （`timeout: 无法运行命令 "command"` rc=127 ✗）⇒ 需要内建就走 `sh -c '…'`，或改用真二进制
//     （如探测命令用 `which` ✓）。另外固定带的 30s 超时还有个陷阱：见 sys_linux 的 openWith 注释 ✓
//   ★ 2026-10-16 新增**可选超时参数** `timeoutMs`（缺省 30000）—— 此前写死 30s、调用方**没法**表达
//     "这条命令可能要跑几分钟"，也没法表达"别超时" ✗（`_exec` 本身支持，是这层门面把能力藏住了 ✓）：
//     · `exec(cmd)`            ⇒ 老行为不变（30s ✓）—— **既有调用点零改动** ✓
//     · `exec(cmd, 600000)`    ⇒ 允许跑 10 分钟（编译 / 打包 / 大文件校验要用 ✓）
//     · `exec(cmd, 0)`         ⇒ **不套超时**（与内置 `_exec` 的口径一致；实测确认过 ✓）
//   ⚠ `0` 的代价必须说清：命令一旦卡住 ⇒ 本调用**永远不返回**（这是**同步阻塞**调用 ✗）
//     "发起后不管它"的正确做法是 `&` 后台（见 sys_linux 的 openWith ✓），**不是**传 0 ✗
//   ⚠ 负数**不能原样透传**：实测内置 `_exec` 把**任何非正数**都当"不套超时"（`-1` 也一样 ✓）
//     ⇒ 若直接透传，一个手滑的 `-5` 就把 30s 守卫**悄悄摘掉**了 ✗ ⇒ 这里负值**退回缺省 30s** ✓
//     （选保守方向：给错值只是"按老行为走"，而不是"失去保护" ✓）
//   ⚠ 超时的退出码是 **124**（GNU `timeout` 惯例 ✓）⇒ 调用方可据此区别"超时"与"命令自己失败"
export func exec(string cmd, int timeoutMs = 30000): Dict {
    // Windows 必须显式 `cmd /c`（`_exec` 在 Windows 走后 CreateProcessW，**不套 shell** ✓）；
    // Linux **不用再包一层**：`_exec` 最终走 `system()` ⇒ 本来就带 `/bin/sh -c` ✓
    string full = cmd
    if _isW() { full = "cmd /c " + cmd }
    int ms = timeoutMs
    if ms < 0 { ms = 30000 }          // 负值 ⇒ 退回缺省（**不能**退化成"不超时" ✗，见上）
    ExecResult? r = _exec(full, ms)
    if r == null { return {ok: false, code: -1, out: ""} }
    return {ok: r.code == 0, code: r.code, out: r.output}
}

// ==================== 进程 ====================

func _procDict(): Dict {
    if _isW() { return w.listProcesses() }
    return l.listProcesses()
}

export func listProcesses(): Array[ProcInfo] {
    Array[ProcInfo] out = []
    var r = _procDict()
    if not jsons.get_bool(r, "ok", false) { return out }
    var arr = r.processes
    for arr to p {
        int pid = jsons.get_int(p, "pid", 0)
        if pid <= 0 { continue }
        out.add(new ProcInfo(pid = pid,
                             name = jsons.get_str(p, "name", ""),
                             path = jsons.get_str(p, "path", ""),
                             memKb = 0))
    }
    return out
}

// 按名字查（**不区分大小写**，子串匹配 ✓）；名字空 ⇒ 返回空
export func findProcess(string name): Array[ProcInfo] {
    Array[ProcInfo] out = []
    if strings.trim(name) == "" { return out }
    string needle = strings.to_lower(name)
    var all = listProcesses()
    for all to p {
        if strings.find(strings.to_lower(p.name), needle) >= 0 { out.add(p) }
    }
    return out
}

export func processExists(int pid): bool {
    if pid <= 0 { return false }
    if _isW() { return w.processExists(pid) }
    return l.processExists(pid)
}

export func killProcess(int pid, bool force = false): bool {
    if pid <= 0 { return false }
    if _isW() { return w.killProcess(pid, force) }
    return l.killProcess(pid, force)
}

export func processMemoryKb(int pid): int {
    if pid <= 0 { return -1 }
    if _isW() { return w.processMemoryKb(pid) }
    return l.processMemoryKb(pid)
}

export func currentPid(): int { if _isW() { return w.currentPid() } return l.currentPid() }
export func exePath(): string { if _isW() { return w.exePath() } return l.exePath() }

// 指定进程的可执行文件**全路径**（取不到 ⇒ `""`：进程已退出 / 无权限 / 二进制已被删 ✓）
//   ★ 为什么单独一个函数：`listProcesses` 的 `path` 字段**恒空**是**有意**的
//     （逐 pid readlink / 开句柄 = 批量时很慢，见 ProcInfo 注释 ✓）⇒ 这里是**按需**版本：
//     只查你要的那一个 pid，就不必付批量成本 ✓
//   ⚠ Linux：走 `readlink -f /proc/<pid>/exe`（需权限；别人的进程多半读不到 ⇒ 空 ✓）
//   ⚠ Windows：`OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION)` + `QueryFullProcessImageNameW`
//     （★ 2026-10-15 起已实现 ✓ —— 声明在 LenoWin32\w32_sys.leno，见 sys_win.leno ✓）
//   ⚠ 两端都一样：空串的含义是"**读不到**"（进程已退出 / 无权限 / 受保护进程），
//     不是"这个进程没有 exe" ✗
export func processPath(int pid): string {
    if pid <= 0 { return "" }
    if _isW() { return w.processPath(pid) }
    return l.processPath(pid)
}

// ==================== 磁盘 ====================

export func diskSpace(string path): Dict {
    if _isW() { return w.diskSpace(path) }
    return l.diskSpace(path)
}

// 磁盘空间 + 便捷百分比（0..100；取不到 ⇒ -1 ✓）
export func diskUsagePercent(string path): int {
    var d = diskSpace(path)
    if not jsons.get_bool(d, "ok", false) { return -1 }
    int total = jsons.get_int(d, "total", 0)
    int free = jsons.get_int(d, "free", 0)
    if total <= 0 { return -1 }
    return _int(100 * (total - free) / total)
}

export func listDrives(): Array[string] {
    if _isW() { return w.listDrives() }
    return l.listDrives()
}

// ==================== 桌面集成 ====================

// 用**系统默认程序**打开一个文件 / 目录 / URI（`https://…` 也认 ✓）
//   Linux ：`xdg-open`（**后台发起** —— 它前台跑会一直等到目标程序退出 ⇒ 必被超时掐掉 ✗）
//   Windows：`ShellExecuteW("open", …)`（★ 2026-10-15 起已实现 ✓；URI 与本地路径同一个 API ✓）
//   ⚠ 返回 `true` = "**已发起**打开请求"，**不等于**目标程序真的开起来了 ✓
//     （要"确实开起来了"只能等目标进程出现，那是另一件事 ✗）
//   ⚠ 非 URI 的入参要求**路径存在**；工具不在（如无 xdg-open）⇒ `false` ✓
//     ⇒ 应用可以拿 false 把按钮**置灰**，而不是点了没反应 ✓
export func openWith(string path): bool {
    if _isW() { return w.openWith(path) }
    return l.openWith(path)
}

// 在文件管理器里**打开它所在的目录**（Linux 端**不保证选中该文件** ✗）
//   Linux ：打开父目录（精确选中要 D-Bus FileManager1，不是每个文件管理器都实现 ⇒ 选朴素做法 ✓）
//   Windows：`explorer /select,"…"` —— **能选中**（★ 2026-10-15 起已实现 ✓）
//   ⚠ 两端返回的 true 都是"**已发起**"（explorer 把请求转交给桌面进程后即退出 ✓）
//   ⚠ 传目录自身 ⇒ 打开的就是它本身（dirname 的结果）✓
export func revealInFolder(string path): bool {
    if _isW() { return w.revealInFolder(path) }
    return l.revealInFolder(path)
}

// 发一条**桌面通知**（标题必填；正文可空 ✓）
//   Linux ：`notify-send`（**同步**，退出码即"守护进程收没收" ⇒ 如实返回 ✓）
//   Windows：托盘气泡（`Shell_NotifyIconW` + 隐藏窗口；★ 2026-10-15 起已实现并**肉眼验过** ✓）
//     ⚠ 两个坑（都实测踩过，写法照 .NET WinForms 的 `NotifyIcon.ShowBalloonTip` ✓）：
//       ① 托盘项**必须有真图标**（我们用系统自带的 IDI_INFORMATION）—— `hIcon = NULL` 时
//          `Shell_NotifyIconW` 照样返回真，但气泡**根本不会画** ✗
//       ② 要**两步**：先 `NIM_ADD`（登记图标）再 `NIM_MODIFY`（加 `NIF_INFO` 弹气泡）✗ 一步不行
//     ⚠ 代价：会往托盘里挂一个图标（进程退出后由系统清理）—— "发完就无痕"做不到，
//       长驻应用想要自己的托盘图标请用 LenoSDL3 的 `Tray`（本函数是"随手发一条"的定位 ✓）
//   ⚠ 两端语义**不完全相同**，用之前请知悉：
//     · Linux 能如实回答"投递出去没有"（有应答 ✓）
//     · Windows 只能回答"**已登记到通知区域**"—— 用户会不会看到（通知开关、专注助手、
//       系统把气泡转成 Toast…）我们**无从得知** ✗ ⇒ 别把 true 当成"用户一定看见了" ✓
//   ⚠ 没有通知服务（纯服务器 / 未装 notify-send）⇒ `false` ⇒ 调用方应降级为打日志 ✓
export func notify(string title, string body = ""): bool {
    if _isW() { return w.notify(title, body) }
    return l.notify(title, body)
}

// ==================== 系统信息 ====================

// 系统信息汇总（发行版 / 内核 / 主机名 / 用户 / CPU / 内存 / 运行时长 / 是否提权 ✓）
//   Linux  ：只读 `/etc/os-release` 与 `/proc`（**不跑外部命令**的例外只有 `id -un` ✓）
//   Windows：注册表 `HKLM\...\Windows NT\CurrentVersion` + `HARDWARE\DESCRIPTION\...\CentralProcessor\0`
//            + 几个直连 API（GetComputerNameW / GetUserNameW / GetActiveProcessorCount /
//            GlobalMemoryStatusEx / GetTickCount64 —— ★ 2026-10-15 起已实现 ✓）
//   取不到的字段 ⇒ 空 / 0（**不要**当成真的 0 ✗ —— 见 SysInfo 的注释 ✓）
//   ⚠ `elevated` 由这里统一填（内部就调 `isElevated()` ⇒ 只有一处实现 ✓）
export func sysInfo(): SysInfo {
    // ⚠ 用**三元形态**（`if … then … else …`）取后端结果：它可作右值 ✓
    //   （写成"先 `var d = {}` 再在 if/else 里赋值"要多一个空字典字面量，本语言里没必要 ✓）
    var d = if _isW() then w.sysInfo() else l.sysInfo()
    return new SysInfo(osName = jsons.get_str(d, "osName", ""),
                       kernel = jsons.get_str(d, "kernel", ""),
                       host = jsons.get_str(d, "host", ""),
                       user = jsons.get_str(d, "user", ""),
                       cpuModel = jsons.get_str(d, "cpuModel", ""),
                       cpuCount = jsons.get_int(d, "cpuCount", 0),
                       memTotalKb = jsons.get_int(d, "memTotalKb", 0),
                       memAvailKb = jsons.get_int(d, "memAvailKb", 0),
                       uptimeSec = jsons.get_int(d, "uptimeSec", 0),
                       elevated = isElevated())
}

// 当前是否 **已提权**（Linux = root；Windows = 管理员令牌 ✓ 两端都已实现 ★ Windows 2026-10-15 补）
//   ★ 用途：清理/安装类应用**区分"没权限"与"被占用"** —— 没提权时该如实说"需要管理员" ✓
//   ⚠ Linux 判据是 `uid == 0`；`uid` 取不到 ⇒ **保守 false**（见 sys_linux 注释 ✓）
//   ⚠ Windows 判据是令牌的 `TokenElevation` —— **不是**"用户名是不是 Administrator"
//     （账户名与"进程有没有提权"是两件事：UAC 下管理员账户跑的程序默认也未提权 ⇒ 拿账户名
//      判会**恒真**，恰是最危险的假阳性 ✗）；令牌打不开 ⇒ 同样**保守 false** ✓
export func isElevated(): bool {
    if _isW() { return w.isElevated() }
    return l.isElevated()
}

// ==================== 卷 / 分区 ====================
// `path` 所在的**卷/分区根**：Linux 是挂载点（`/home/u/x` ⇒ `/`；`/media/u/U盘/x` ⇒ `/media/u/U盘`）；
//   Windows 是盘符根（`C:\Users\x` ⇒ `C:\`）✓
//   判不出 ⇒ **`""`**（调用方须按"未知"处理 —— 本模块从不猜路径 ✗）
//   ★ 用途：判断"目标在哪个分区"（跨分区回收站、清理范围、给用户显示分区 ✓）
//   ⚠ POSIX 侧 `dirs.abspath` 走 realpath ⇒ **符号链接会解析到真实位置**，
//     得到的是文件**实际所在**的分区（这对清理/回收站恰恰是想要的 ✓）
export func volumeOf(string path): string {
    if _isW() { return w.volumeOf(path) }
    return l.volumeOf(path)
}

// ==================== 回收站 ====================

// paths 里的路径**必须存在**；返回 {ok, count, aborted, errors}
//   ⚠ `count` 两端口径一致 = **提交的路径数**（不是成功数 ✓）；成功与否看 `ok` ✓
//   ⚠ `errors` 只有 Linux 侧有明细（逐条做 `mv`，失败原因能拿到 ✓）；
//     Windows 侧走一次 `SHFileOperation`，**它不给明细** ⇒ 恒为空数组（不是"没有错误" ✗）
export func deleteToTrash(Array[string] paths): Dict {
    if _isW() { return w.deleteToTrash(paths) }
    return l.deleteToTrash(paths)
}

export func emptyTrash(): bool {
    if _isW() { return w.emptyTrash() }
    return l.emptyTrash()
}

// 列出回收站里的条目（两端都已实现 ✓ ★ Windows 侧 2026-10-15 补）
//   Linux  ：家目录 + **各分区**（与 `emptyTrash` 覆盖同一套目录 ✓）
//   Windows：**自己 SID** 的、各个盘上的 `<盘符>:\$Recycle.Bin\<SID>`（别人的不列也不动 ✓）
//   ⚠ 只有"账本 + 内容都在"的条目才会被列出：
//     · Linux  = `info/*.trashinfo` 在、且 `files/<名字>` 也在
//     · Windows = `$I…`（账本，二进制）在、且配对的 `$R…` 也在
//     ⇒ 没账本的 / 内容已没了的一律不列（宁缺勿猜；列出来点"还原"必然失败 ✗）
//   ⚠ 本版**不给大小**（逐条 walk 会让大回收站明显卡 ✗）；要大小就自己 `dirs.stat` ✓
//   ⚠ `item.name` 的含义**两端不同**（见 TrashItem 注释）：Linux 是回收站里的文件名，
//     Windows 是**原文件名**（`$R0UFLFU` 那种名字对用户没有意义 ✓）
export func listTrash(): Array[TrashItem] {
    Array[TrashItem] out = []
    Array raw = []
    if _isW() { raw = w.listTrash() } else { raw = l.listTrash() }
    for raw to it {
        string nm = jsons.get_str(it, "name", "")
        if nm == "" { continue }
        out.add(new TrashItem(name = nm,
                              originalPath = jsons.get_str(it, "originalPath", ""),
                              deletedAt = jsons.get_str(it, "deletedAt", ""),
                              trashDir = jsons.get_str(it, "trashDir", "")))
    }
    return out
}

// ==================== 开机启动项 ====================

export func listStartupItems(): Array[StartupItem] {
    Array[StartupItem] out = []
    Array raw = []
    if _isW() { raw = w.startupItems() } else { raw = l.startupItems() }
    for raw to it {
        out.add(new StartupItem(scope = jsons.get_str(it, "scope", ""),
                                id = jsons.get_str(it, "id", ""),
                                name = jsons.get_str(it, "name", ""),
                                cmd = jsons.get_str(it, "cmd", ""),
                                source = jsons.get_str(it, "source", ""),
                                enabled = jsons.get_bool(it, "enabled", true)))
    }
    return out
}

// ==================== 开机自启动（跨平台三件套）====================
//
//   Windows：`HKCU\Software\Microsoft\Windows\CurrentVersion\Run`（值名 = id ✓）
//   Linux  ：`~/.config/autostart/<id>.desktop`（freedesktop 规范 ✓ —— 与本模块
//            `listStartupItems()` 读的是**同一套** ⇒ 写完立刻能在启动项列表里看到 ✓）
//   macOS  ：**未实现**（返回 false/""，绝不写假文件 ✗ —— LaunchAgents 是另一套格式）
//
//   语义约定（三平台一致 ✓）：
//     · `id` 唯一标识一项自启（GUID/包名风格，别用中文/空格 ✓ 它会变成值名或文件名）
//     · `get` 返回**当前命令行**；不存在 ⇒ `""`（调用方据此显示"未启用" ✓）
//     · `remove` 对"本来就不存在"返回 **true**（目标 = 不再自启，已达成 ✓ 幂等 ✓）
export func getAutostart(string id): string {
    if isMacos() { return "" }
    if _isW() { return w.getAutostart(id) }
    return l.getAutostart(id)
}

export func setAutostart(string id, string name, string cmd): bool {
    if isMacos() { return false }
    if id == "" or cmd == "" { return false }
    if _isW() { return w.setAutostart(id, name, cmd) }
    return l.setAutostart(id, name, cmd)
}

export func removeAutostart(string id): bool {
    if isMacos() { return false }
    if _isW() { return w.removeAutostart(id) }
    return l.removeAutostart(id)
}

// ==================== 已装软件 ====================

export func listInstalledSoftware(): Array[SoftwareItem] {
    Array[SoftwareItem] out = []
    Array raw = []
    if _isW() { raw = w.installedSoftware() } else { raw = l.installedSoftware() }
    for raw to it {
        string nm = jsons.get_str(it, "name", "")
        if nm == "" { continue }
        out.add(new SoftwareItem(name = nm,
                                 version = jsons.get_str(it, "version", ""),
                                 publisher = jsons.get_str(it, "publisher", ""),
                                 installPath = jsons.get_str(it, "installPath", ""),
                                 source = jsons.get_str(it, "source", "")))
    }
    return out
}

// ==================== 最近文件 ====================

export func recentFiles(int max = 100): Array[string] {
    if _isW() { return w.recentFiles(max) }
    return l.recentFiles(max)
}

// ==================== 自检 ====================

// 在本机把每个能力跑一遍，返回 {os, ok, lines:[...]}
//   ★ 用途：**换到一台新平台（尤其 Linux）时先跑这个** ⇒ 一眼看出哪些能力真的可用 ✓
//     （Linux 侧只有解析层在 Windows 上回归过；读文件/跑命令这一段只能真机验 ✓）
export func selfTest(): Dict {
    Array[string] lines = []
    int bad = 0

    lines.add("os = " + _os())
    lines.add("homeDir = " + homeDir())
    lines.add("tempDir = " + tempDir())
    lines.add("configDir = " + configDir())
    lines.add("dataDir = " + dataDir())
    lines.add("systemRoot = " + systemRoot())

    int pid = currentPid()
    lines.add("currentPid = " + _str(pid) + (if pid > 0 then " ✓" else " ✗"))
    if pid <= 0 { bad = bad + 1 }

    string exe = exePath()
    lines.add("exePath = " + exe + (if exe != "" then " ✓" else " ✗"))
    if exe == "" { bad = bad + 1 }

    var ps = listProcesses()
    lines.add("listProcesses = " + _str(ps.len()) + " 个" + (if ps.len() > 0 then " ✓" else " ✗"))
    if ps.len() == 0 { bad = bad + 1 }

    if pid > 0 {
        int mem = processMemoryKb(pid)
        lines.add("processMemoryKb(self) = " + _str(mem) + " KB" + (if mem >= 0 then " ✓" else " ✗"))
        if mem < 0 { bad = bad + 1 }
    }

    var d = diskSpace(systemRoot())
    bool dok = jsons.get_bool(d, "ok", false)
    string dtxt = if dok then _str(jsons.get_int(d, "total", 0)) + " 字节 / 剩 " + _str(jsons.get_int(d, "free", 0)) else "失败"
    lines.add("diskSpace(" + systemRoot() + ") = " + dtxt + (if dok then " ✓" else " ✗"))
    if not dok { bad = bad + 1 }

    // ★ 2026-10-15 新增三件套（volumeOf / processPath / listTrash）
    string vol = volumeOf(systemRoot())
    lines.add("volumeOf(" + systemRoot() + ") = " + vol + (if vol != "" then " ✓" else " ✗"))
    if vol == "" { bad = bad + 1 }

    if pid > 0 {
        // ★ 2026-10-15：Windows 侧已实现 ⇒ 两端都按"必须读到自己的 exe"计失败 ✓
        string pp = processPath(pid)
        lines.add("processPath(self) = " + pp + (if pp != "" then " ✓" else " ✗"))
        if pp == "" { bad = bad + 1 }
    }

    var tl = listTrash()
    //   ⚠ 0 条**也可能是真没有**（回收站本来就是空的）⇒ 只报数、不计失败 ✓
    //     两端都已实现（Linux 家目录+各分区；Windows 自己 SID 的各盘 ✓）
    lines.add("listTrash = " + _str(tl.len()) + " 条（0 也可能是真没有 ✓）")

    // ★ 2026-10-15 桌面集成：**只报"可调用"，不真去开窗口/发通知** ✗
    //   （自检不该打扰用户 —— 真开一个文件管理器窗口、弹一条通知都是打扰 ✓）
    //   ⇒ 用**空入参**探一下：按契约它必须返回 false 且不产生任何副作用 ✓
    lines.add("openWith('') = " + (if openWith("") then "true" else "false") + "（空入参应恒 false ✓）")
    lines.add("revealInFolder('') = " + (if revealInFolder("") then "true" else "false") + "（同上 ✓）")
    lines.add("notify('') = " + (if notify("") then "true" else "false") + "（标题必填 ⇒ false ✓）")
    if not _isW() {
        //   Linux 侧顺带报"工具在不在"（这才是决定这三个能不能用的东西 ✓；只读探测、无副作用 ✓）
        //   ⚠ 这里用 `which`（**真二进制**）而**不是** `command -v`：`exec` 固定带 30s 超时 ⇒
        //     命令会被包进 `timeout`，而 `timeout` 用 execvp 跑命令词 ⇒ shell 内建当命令词会失败 ✗
        //     （同 sys_linux 的 `_hasCmd` 注释，实测复现过 ✓）
        var lo = exec("which xdg-open")
        var lnc = exec("which notify-send")
        string xo = "无"
        string ns = "无"
        if jsons.get_bool(lo, "ok", false) { xo = strings.trim(jsons.get_str(lo, "out", "")) }
        if jsons.get_bool(lnc, "ok", false) { ns = strings.trim(jsons.get_str(lnc, "out", "")) }
        lines.add("xdg-open = " + xo + " · notify-send = " + ns)
    }

    // ★ 2026-10-15 系统信息（两端都已实现 ⇒ 两端都计失败 ✓；Windows 侧来源见 sys_win.sysInfo 注释）
    var si = sysInfo()
    lines.add("sysInfo.osName = '" + si.osName + "' · kernel '" + si.kernel + "' · host '" + si.host + "'")
    lines.add("sysInfo.user = '" + si.user + "' · cpu '" + si.cpuModel + "' × " + _str(si.cpuCount))
    lines.add("sysInfo.mem = " + _str(si.memAvailKb) + " / " + _str(si.memTotalKb) + " KB · uptime "
              + _str(si.uptimeSec) + " s")
    lines.add("isElevated = " + (if si.elevated then "true" else "false"))
    //   ⚠ `osName`/`cpuModel` 不写成硬失败：极端精简的系统上（注册表被裁剪）可能真读不到 ✗
    //     但 host/user/cpuCount/内存/uptime 两端都有**确定的来源** ⇒ 读不到就是真出问题了 ✓
    if si.host == "" { lines.add("  ✗ sysInfo.host 读不到"); bad = bad + 1 }
    if si.user == "" { lines.add("  ✗ sysInfo.user 读不到"); bad = bad + 1 }
    if si.cpuCount <= 0 { lines.add("  ✗ sysInfo.cpuCount 读不到"); bad = bad + 1 }
    if si.memTotalKb <= 0 { lines.add("  ✗ sysInfo.memTotalKb 读不到"); bad = bad + 1 }
    if si.uptimeSec <= 0 { lines.add("  ✗ sysInfo.uptimeSec 读不到"); bad = bad + 1 }

    var su = listStartupItems()
    lines.add("listStartupItems = " + _str(su.len()) + " 项（0 也可能是真没有 ✓）")

    var sw = listInstalledSoftware()
    lines.add("listInstalledSoftware = " + _str(sw.len()) + " 个（0 也可能是真没有 ✓）")

    var rec = recentFiles(5)
    lines.add("recentFiles(5) = " + _str(rec.len()) + " 条")

    lines.add("tempDir 可写 = " + (if jsons.get_bool(_writeProbe(), "ok", false) then " ✓" else " ✗"))

    return {os: _os(), ok: bad == 0, lines: lines}
}

// ★ 三元在本语言里写作 **`if 条件 then 值1 else 值2`** ✓（不是 C 的 `? :`）——
//   上面那些 `(if … then " ✓" else " ✗")` 就是它 ✓（可嵌套、可作实参 ✓，实测过 ✓）

func _writeProbe(): Dict {
    string f = joinPath([tempDir(), "lenosys_selftest.txt"])
    try {
        files.write(f, "ok")
        bool exists = files.exists(f)
        try { files.delete(f) } catch e { return {ok: false} }
        return {ok: exists}
    } catch e { return {ok: false} }
}
