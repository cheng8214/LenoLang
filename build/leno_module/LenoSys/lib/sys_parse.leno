// sys_parse.leno — LenoSys 的**纯解析层**：只吃文本、不碰系统 ⇒ 全平台可单测 ✓
//
// ★ 为什么单独一层（这是本模块可维护性的关键）：
//   Linux 后端要读的东西**全是文本格式**：`/proc/*/stat`、`/proc/*/status`、`df`、
//   `*.desktop`、dpkg 的 status 文件、`recently-used.xbel`。
//   如果把"读文件"和"解析文本"揉在一起 ⇒ 没有 Linux 机器就**一行都验不了** ✗。
//   把解析抽到这里（纯函数：string → 结构）⇒ 在 Windows 上拿**造好的样例文本**就能
//   完整回归（assert\test_sys_parse.leno ✓），Linux 侧只剩"读文件 + 调这里"的薄壳 ✓
//
// ⚠ 本文件**不许 import ffi / Win32 / SDL3**，也不许调 _exec —— 保持"纯函数"才可测 ✓
import strings
import regexs

// ==================== 通用文本小工具 ====================

// 按空白切词（含制表符；丢弃空串）——df / proc stat / dpkg 都是空白分隔 ✓
export func tokens(string s): Array[string] {
    Array[string] out = []
    string flat = strings.replace(strings.replace(s, "\t", " "), "\r", "")
    var parts = strings.split(flat, " ")
    for parts to p {
        string t = strings.trim(p)
        if t != "" { out.add(t) }
    }
    return out
}

// 切成行（统一去掉 \r：Windows 侧文本常见 \r\n ✓；**不丢空行** ⇒ 调用方自行判定 ✓）
export func split_lines(string s): Array[string] {
    // 2026-10-02：收口到 native `strings.lines`（同一个实现 —— 见 src/module/strings/strings.c
    //   里 str_lines 的注释）。本函数**保留**只为不打断既有调用方，不再自己拼 replace+split ✓
    return strings.lines(s)
}

// 最后一个 ch 的下标（找不到 ⇒ -1）
//   用法：`/proc/<pid>/stat` 的 `comm` 字段**可能含空格甚至括号**（如 `(a (b))`）⇒
//         必须按**最后一个** ')' 切开，按第一个切会错位 ✗
//   ★ 实现依据（实测 ✓）：`strings.find` 支持**起始位置** ⇒ `find(hay, pat, start)` ✓
//     （`find("abcabc", "a", 1) == 3` ✓）。我第一版误以为它没有起始位置参数、
//      手写了逐字符扫描 ✗ —— 那是本语言里不必要的手工活 ✓
export func last_index_of(string s, string ch): int {
    int found = -1
    int at = 0
    while (at <= s.len()) {
        int i = strings.find(s, ch, at)
        if i < 0 { return found }
        found = i
        at = i + 1
    }
    return found
}

// 取第 i 个片段（越界 ⇒ ""，不抛 ✓ 解析时安全）
export func at(Array[string] arr, int i): string {
    if i < 0 { return "" }
    if i >= arr.len() { return "" }
    return arr[i]
}

// 该行是否以十进制数字开头（df 的**表头行**排除用 ✓）
export func is_digit_line(string s): bool {
    string t = strings.trim(s)
    if t == "" { return false }
    return strings.find("0123456789", strings.slice(t, 0, 0)) >= 0
}

// 是否**纯十进制数字**（`"60%"` ⇒ false ✓ —— 靠这个把 df 的 Use% 列排除掉 ✓）
export func is_number(string s): bool {
    string t = strings.trim(s)
    if t == "" { return false }
    int i = 0
    while (i < t.len()) {
        if strings.find("0123456789", strings.slice(t, i, i)) < 0 { return false }
        i = i + 1
    }
    return true
}

// 从形如 "... 123 kB" 的文本里取**第一个整数**（找不到 ⇒ def）
//   用途：/proc/<pid>/status 的 `VmRSS:    1234 kB`；`df` 的兜底解析 ✓
export func first_int_in(string s, int def): int {
    string digits = ""
    bool started = false
    int i = 0
    while (i < s.len()) {
        string c = strings.slice(s, i, i)
        bool isDigit = strings.find("0123456789", c) >= 0
        if isDigit {
            digits = digits + c
            started = true
        } else if started {
            break
        }
        i = i + 1
    }
    if digits == "" { return def }
    return _int(digits)
}

// ==================== df（Linux 磁盘空间）====================

// 支持两种输出形态（后端会先试 --output=size,avail，失败再退回普通 df ✓）：
//   A) `df -B1 --output=size,avail <path>` ⇒ 表头 + 一行两列：`<总> <可用>`
//   B) `df -B1 <path>`                     ⇒ 表头 + 一行多列：`/dev/sda1 <总> <已用> <可用> <Use%> <挂载点>`
// ★ 规则不按"列号"硬取，而按**纯数字列**取（实测过这个坑）：
//     · B 形态第 0 列是**设备名**（`/dev/sda1`）⇒ 按列号取会拿到 0 ✗
//     · B 形态的 `Use%`（`60%`）带百分号 ⇒ `is_number` 判 false ⇒ 自动排除 ✓
//   ⇒ 数字列 ≥3 个 ⇒ (nums[0], nums[2])；正好 2 个 ⇒ (nums[0], nums[1]) ✓
export func parse_df(string out): Dict {
    var ls = split_lines(out)
    for ls to l {
        var t = tokens(l)
        Array[string] nums = []
        for t to cell {
            if is_number(cell) { nums.add(cell) }
        }
        if nums.len() >= 3 {
            return {ok: true, total: _int(nums[0]), free: _int(nums[2])}
        }
        if nums.len() == 2 {
            return {ok: true, total: _int(nums[0]), free: _int(nums[1])}
        }
    }
    return {ok: false, total: 0, free: 0}
}

// ==================== /proc/mounts（挂载点列表，回收站跨分区用）====================
// 为什么需要：freedesktop Trash 规范要求**其它分区**的回收站放在
//   `<挂载点>/.Trash-<uid>`（或 `<挂载点>/.Trash/<uid>`）⇒ 清空回收站得先知道有哪些挂载点 ✓
// ★ 为什么用 `/proc/mounts` 而**不是 `df -P`**（本轮实测踩到的）：
//   `df -P` 的挂载点列是"最后一列"，而挂载点**允许含空格** —— 本机就有一个
//   `/media/cheng8214/Ubuntu 22.04.5 LTS amd64` ⇒ 按列取只会拿到 `amd64`（不以 `/` 开头 ⇒
//   整个挂载点被**漏掉** ✗）。外挂盘恰恰最常带空格（卷标）⇒ 正好漏在最需要覆盖的地方 ✗
//   `/proc/mounts` 则把空格写成 `\040` ⇒ **字段边界无歧义** ✓（读 /proc 也与本模块主线一致 ✓）
// 形态：`<设备> <挂载点> <文件系统> <选项> <dump> <pass>`（空白分隔，每行一个挂载 ✓）
//   ⇒ 第 **1** 列就是挂载点（设备名的空格同样被转义 ⇒ 列号不会错位 ✓）
// ⚠ 只认以 `/` 开头的挂载点（排除 swap 之类不以路径挂载的条目 ✓）；输出去重（bind mount 会重复 ✓）
export func parse_proc_mounts(string text): Array[string] {
    Array[string] res = []
    var ls = split_lines(text)
    for ls to l {
        var t = tokens(l)
        if t.len() < 2 { continue }
        string mp = unescape_mount(at(t, 1))
        if not strings.starts_with(mp, "/") { continue }
        bool dup = false
        for res to r {
            if r == mp { dup = true }
        }
        if not dup { res.add(mp) }
    }
    return res
}

// `/proc/mounts` 字段里的八进制转义还原：`\040`→空格、`\011`→Tab、`\012`→换行、`\134`→`\`
//   ⚠ 按**字节**处理（不是码点）：转义本身就是字节级规则，而挂载点里的中文是多字节 UTF-8
//     ⇒ 逐码点处理会把"从字节流里拣出来的某个字节"变成非法码点 ✗（`from_bytes` 才严格互逆 ✓）
//   ⚠ 非法转义（`\` 后不是 3 个八进制数字）⇒ **原样保留**（不静默丢字符 —— 宁可路径怪一点，
//     也不要"看起来对、其实少了个字符"的路径 ✗）
export func unescape_mount(string s): string {
    Array[int] out = []
    var by = strings.to_bytes(s)
    int i = 0
    while i < by.len() {
        if by[i] == 92 and i + 3 < by.len() {        // 92 = '\\'
            int d1 = _oct_digit(by[i + 1])
            int d2 = _oct_digit(by[i + 2])
            int d3 = _oct_digit(by[i + 3])
            if d1 >= 0 and d2 >= 0 and d3 >= 0 {
                out.add(d1 * 64 + d2 * 8 + d3)
                i = i + 4
                continue
            }
        }
        out.add(by[i])
        i = i + 1
    }
    return strings.from_bytes(out)
}

// 字节值 → 八进制数字（`'0'..'7'` ⇒ 0..7；其它 ⇒ -1）
func _oct_digit(int b): int {
    if b >= 48 and b <= 55 { return b - 48 }
    return -1
}

// ==================== 路径 → 归属哪个挂载点（回收站跨分区用）====================
// 用途：`deleteToTrash` 要先知道目标文件在**哪个分区**上 —— 同分区走家目录回收站，
//   异分区才去用/建 `<挂载点>/.Trash-<uid>` ✓（freedesktop Trash 规范正是按分区定的 ✓）
// ★ 判据 = **最长的**前缀匹配：挂载点会**嵌套**（`/`、`/media/x`、`/run/user/1000`…），
//   取到较短的那个会把文件判到外层分区 ⇒ 回收站建错地方 ✗
//   ⚠ 空表 ⇒ 返回 ""（调用方按"判不出分区"处理，**不猜** ✓）
export func mount_of(Array[string] mounts, string path): string {
    string best = ""
    for mounts to m {
        if not path_under(path, m) { continue }
        if m.len() > best.len() { best = m }
    }
    return best
}

// `path` 是否位于挂载点 `mnt` **之下**（**边界敏感** —— 这是本函数存在的唯一理由）
//   ⚠ 纯 `starts_with` 不够：`/run/user/1000` 会被 `/run/user/10` 命中 ✗
//     ⇒ 那样"1000"与"10"会被当成父子关系，跨分区回收站就建错了 ✗
//   ⚠ 根挂载点 `/` 特殊处理：`"/" + "/"` 拼出 `//`（语义怪）⇒ 直接按"是绝对路径"判 ✓
export func path_under(string path, string mnt): bool {
    if mnt == "" or path == "" { return false }
    if mnt == "/" { return strings.starts_with(path, "/") }
    if path == mnt { return true }
    return strings.starts_with(path, mnt + "/")
}

// ==================== /proc/<pid>/stat ====================

// 形如：`1234 (my proc) S 1 1234 ...`（第 2 段 comm 可能含空格/括号 ⇒ 按最后一个 ')' 切 ✓）
// 切完剩下的片段从**第 3 个字段**（state）开始 ⇒ state=t[0], ppid=t[1], rss=t[21]（第 24 字段 ✓）
export func parse_proc_stat(string line): Dict {
    string s = strings.trim(line)
    int lp = strings.find(s, "(")
    if lp < 0 { return {ok: false, pid: 0, name: "", ppid: 0, state: ""} }
    int rp = last_index_of(s, ")")
    if rp <= lp { return {ok: false, pid: 0, name: "", ppid: 0, state: ""} }

    int pid = _int(strings.trim(strings.slice(s, 0, lp - 1)))
    string name = strings.slice(s, lp + 1, rp - 1)
    string rest = strings.trim(strings.slice(s, rp + 1, s.len()))
    var t = tokens(rest)

    return {ok: pid > 0,
            pid: pid,
            name: name,
            state: at(t, 0),
            ppid: _int(at(t, 1)),
            rssPages: _int(at(t, 21))}
}

// /proc/<pid>/status 里的常驻内存（VmRSS，单位 KB；找不到 ⇒ -1 ✓ 与 0 区分开）
//   ⚠ 只认 `VmRSS:` 行：`VmSize`（虚拟）不是"占用"✗，两者差一个数量级
export func parse_proc_status_mem(string text): int {
    var ls = split_lines(text)
    for ls to l {
        string t = strings.trim(l)
        if strings.starts_with(t, "VmRSS:") {
            return first_int_in(strings.slice(t, 6, t.len()), -1)
        }
    }
    return -1
}

// ==================== .desktop（Linux 开机启动项）====================

// 解析 `~/.config/autostart/*.desktop` / `/etc/xdg/autostart/*.desktop` ✓
//   认：`Name=`（本地化 `Name[zh_CN]=` 跳过 ✗）、`Exec=`、`Hidden=true`、`NoDisplay=true`
//   只认 `[Desktop Entry]` 段；`#` 起首是注释 ✓
export func parse_desktop_entry(string text): Dict {
    string name = ""
    string execLine = ""
    bool hidden = false
    bool noDisplay = false
    bool inMain = false

    var ls = split_lines(text)
    for ls to l {
        string t = strings.trim(l)
        if t == "" { continue }
        if strings.starts_with(t, "#") { continue }
        if strings.starts_with(t, "[") {
            inMain = (t == "[Desktop Entry]")
            continue
        }
        if not inMain { continue }

        int eq = strings.find(t, "=")
        if eq <= 0 { continue }
        string k = strings.trim(strings.slice(t, 0, eq - 1))
        string v = strings.trim(strings.slice(t, eq + 1, t.len()))

        // 本地化键（`Name[zh_CN]`）跳过 ⇒ 取不带 locale 的基准值 ✓
        if strings.find(k, "[") >= 0 { continue }

        if k == "Name" { name = v }
        else if k == "Exec" { execLine = v }
        // 2026-10-02 收编：`to_lower(v) == "true"` 会造临时串 ⇒ 改 native `eq_ignore_case` ✓
        else if k == "Hidden" { hidden = strings.eq_ignore_case(v, "true") }
        else if k == "NoDisplay" { noDisplay = strings.eq_ignore_case(v, "true") }
    }

    return {ok: (name != "" or execLine != ""),
            name: name,
            execLine: execLine,
            hidden: hidden,
            noDisplay: noDisplay}
}

// ==================== dpkg status（Debian/Ubuntu 已装软件）====================

// `/var/lib/dpkg/status` 是**空行分隔的键值块**；只取 `Status: install ok installed` 的包 ✓
//   ⇒ 每块含 Package / Version / Maintainer / Architecture（缺项给 "" ✓）
export func parse_dpkg_status(string text): Array {
    Array out = []
    string curName = ""
    string curVer = ""
    string curMaint = ""
    string curArch = ""
    bool installed = false
    bool hasBlock = false

    var ls = split_lines(text)
    for ls to l {
        string t = strings.trim(l)

        if t == "" {
            // 块结束 ⇒ 已安装的收下（其余丢弃：deinstall/半装都不算 ✓）
            if hasBlock and installed and curName != "" {
                out.add({name: curName, version: curVer, maintainer: curMaint, arch: curArch})
            }
            curName = "" curVer = "" curMaint = "" curArch = ""
            installed = false hasBlock = false
            continue
        }

        int c = strings.find(t, ":")
        if c <= 0 { continue }
        string k = strings.slice(t, 0, c - 1)
        string v = strings.trim(strings.slice(t, c + 1, t.len()))
        hasBlock = true

        if k == "Package" { curName = v }
        else if k == "Version" { curVer = v }
        else if k == "Maintainer" { curMaint = v }
        else if k == "Architecture" { curArch = v }
        else if k == "Status" {
            installed = (strings.find(v, "install ok installed") >= 0)
        }
    }

    // 末块没有空行收尾 ⇒ 补收一次 ✓
    if hasBlock and installed and curName != "" {
        out.add({name: curName, version: curVer, maintainer: curMaint, arch: curArch})
    }
    return out
}

// ==================== recently-used.xbel（Linux 最近文件）====================

// `<bookmark href="file:///home/u/a.txt" added=... modified=...>` ⇒ 取 href 里的本地路径 ✓
//   只认 file:// 方案（http/https 等跳过 ✗）；去重（同一路径多次出现只留一次 ✓）
export func parse_xbel_recents(string text, int max): Array[string] {
    Array[string] out = []
    // ⚠ `regexs.find_all` 返回的是 `Array[RegexMatch]`（结构体，非字符串 ✗）
    //   `RegexMatch { int start, int end, string text }` ⇒ 取 `.text` ✓（字段类型编译期已知 ✓）
    var hits = regexs.find_all(text, "href=\"file:[^\"]+\"")
    for hits to hit {
        string h = hit.text
        // h 形如 `href="file:///home/u/a.txt"` ⇒ 掐头去尾取 URL ✓
        int q1 = strings.find(h, "\"")
        if q1 >= 0 {
            string rest = strings.slice(h, q1 + 1, h.len())
            int q2 = strings.find(rest, "\"")
            if q2 >= 0 {
                string p = file_uri_to_path(strings.slice(rest, 0, q2 - 1))
                if p != "" {
                    if not out.has(p) { out.add(p) }
                    if max > 0 and out.len() >= max { break }
                }
            }
        }
    }
    return out
}

// ==================== /etc/os-release（发行版信息）====================
// 形态：`KEY=值` 或 `KEY="值"`（**值多半带引号** ✓），`#` 起首是注释 ✓
//   要的键：PRETTY_NAME（给人看的全名）/ ID / VERSION_ID ✓
// ⚠ 值两端**成对**的引号必须剥掉 —— 带引号原样返回会显示成 `"Ubuntu 22.04.5 LTS"` ✗
//   只剥成对的（`"` 与 `'` 都认）；不成对（畸形行）⇒ **原样** ✓ 不猜
// ⚠ 只有 `ID`、没有 `PRETTY_NAME` ⇒ 拿 `ID` 顶上（是**真值**，不是编的 ✓）
export func parse_os_release(string text): Dict {
    string pretty = ""
    string id = ""
    string ver = ""
    var ls = split_lines(text)
    for ls to l {
        string t = strings.trim(l)
        if t == "" or strings.starts_with(t, "#") { continue }
        int eq = strings.find(t, "=")
        if eq <= 0 { continue }
        string k = strings.trim(strings.slice(t, 0, eq - 1))
        string v = unquote(strings.trim(strings.slice(t, eq + 1, t.len())))
        if k == "PRETTY_NAME" { pretty = v }
        eif k == "ID" { id = v }
        eif k == "VERSION_ID" { ver = v }
    }
    if pretty == "" { pretty = id }
    return {ok: pretty != "", pretty: pretty, id: id, version: ver}
}

// 剥掉两端**成对**的引号（`"x"` / `'x'` ⇒ `x`；不成对 / 太短 ⇒ 原样 ✓）
export func unquote(string s): string {
    if s.len() >= 2 {
        string a = strings.slice(s, 0, 0)
        string b = strings.slice(s, s.len() - 1, s.len() - 1)
        if (a == "\"" and b == "\"") or (a == "'" and b == "'") {
            return strings.slice(s, 1, s.len() - 2)
        }
    }
    return s
}

// ==================== /proc/cpuinfo（CPU 型号 / 逻辑核数）====================
// ★ 一个解析出两个字段，只因"读一次文件就够"（省一次读 ✓）
//   核数 = `processor` 行数；型号 = 第一个非空 `model name` ✓
// ⚠ 字段名**分架构不同**：x86 是 `model name`，ARM 常写作 `Processor` / `Hardware`
//   ⇒ ARM 上可能取不到型号（返回 ""）；但**核数照样数得对**（`processor` 行两边都有 ✓）
// ⚠ 多路 / 多核机器会**重复**同一串型号 ⇒ 取第一个即可（不必去重 ✓）
export func parse_cpuinfo(string text): Dict {
    string model = ""
    int count = 0
    var ls = split_lines(text)
    for ls to l {
        int colon = strings.find(l, ":")
        if colon <= 0 { continue }
        string k = strings.trim(strings.slice(l, 0, colon - 1))
        string v = strings.trim(strings.slice(l, colon + 1, l.len()))
        if k == "processor" { count = count + 1 }
        if model == "" {
            if k == "model name" { model = v }
            eif k == "Processor" { model = v }        // ARM 侧的等价位 ✓
        }
    }
    return {ok: count > 0, model: model, count: count}
}

// ==================== /proc/meminfo（物理内存）====================
// 形态：`MemTotal:       4041932 kB`（**单位 kB** ✓）；整行里第一个整数就是我们要的值 ✓
//   MemTotal     = 物理内存总量
//   MemAvailable = 内核估算的"还能拿来用"（Linux 3.14+ 才有 ✓）
// ⚠ 老内核 / 部分容器**没有** `MemAvailable` ⇒ 退回 `MemFree`（降级**但不缺席** ✓，
//   并用 `fallback` 如实标出来 —— 这两个数**口径不同**，调用方要能知道 ✗）
export func parse_meminfo(string text): Dict {
    int total = 0
    int avail = 0
    int freeKb = 0
    var ls = split_lines(text)
    for ls to l {
        int colon = strings.find(l, ":")
        if colon <= 0 { continue }
        string k = strings.trim(strings.slice(l, 0, colon - 1))
        if k == "MemTotal" { total = first_int_in(l, 0) }
        eif k == "MemAvailable" { avail = first_int_in(l, 0) }
        eif k == "MemFree" { freeKb = first_int_in(l, 0) }
    }
    bool fallback = false
    if avail <= 0 and freeKb > 0 {
        avail = freeKb
        fallback = true
    }
    return {ok: total > 0, totalKb: total, availKb: avail, fallback: fallback}
}

// ==================== .trashinfo（回收站条目，listTrash 用）====================
// 规范（freedesktop Trash）里每个条目在 `<回收站>/info/<名字>.trashinfo` 留一份账本：
//   [Trash Info]
//   Path=/home/u/My%20File.txt          ← **原始绝对路径**（百分号编码 ✓）
//   DeletionDate=2026-10-01T12:34:56    ← 本地时间 ✓
// ★ 这里就把 `Path` **解码**（`percent_decode` 就在本文件 ✓）⇒ 调用方直接拿到可用路径 ✓
//   ⚠ 不解码的话路径里会原样留着 `%20`/`%E4%B8%AD` ⇒ 拿去"还原/打开"全都打不开 ✗
// ⚠ 只认 `[Trash Info]` 段（`[Desktop Entry]` 那类段一律跳过 ✓，与 parse_desktop_entry 同风格）
// ⚠ 缺 `Path` ⇒ `ok=false`（**没账本就不猜路径** ✗ —— 调用方据此跳过该条目 ✓）
export func parse_trashinfo(string text): Dict {
    string path = ""
    string when = ""
    bool inMain = false
    var ls = split_lines(text)
    for ls to l {
        string t = strings.trim(l)
        if t == "" { continue }
        if strings.starts_with(t, "[") {
            inMain = (t == "[Trash Info]")
            continue
        }
        if not inMain { continue }
        int eq = strings.find(t, "=")
        if eq <= 0 { continue }
        string k = strings.trim(strings.slice(t, 0, eq - 1))
        string v = strings.trim(strings.slice(t, eq + 1, t.len()))
        if k == "Path" { path = percent_decode(v) }
        eif k == "DeletionDate" { when = v }
    }
    return {ok: path != "", path: path, deletedAt: when}
}

// ==================== URL / 百分号编解码 ====================

func _hex_val(string c): int {
    string lower = strings.to_lower(c)
    int d = strings.find("0123456789abcdef", lower)
    return d
}

func _hex_digit(int v): string {
    string table = "0123456789ABCDEF"
    if v < 0 or v > 15 { return "0" }
    return strings.slice(table, v, v)
}

// `%E4%B8%AD` ⇒ `中`
//   ★ 实现依据（**实测**过的语言语义，别改坏）：`strings.char(N)` 是**字节语义** ——
//     `byte_len(char(228)) == 1`、`byte(char(228)) == 228`，且
//     `char(228)+char(184)+char(173)` 拼出来就是合法 UTF-8 的 `中` ✓
//     ⇒ 直接按**字节**累加即可，不需要"字节数组 → 字符串"的转换 API ✓
export func percent_decode(string s): string {
    string out = ""
    int i = 0
    while (i < s.len()) {
        string c = strings.slice(s, i, i)
        if c == "%" and i + 2 < s.len() {
            int hi = _hex_val(strings.slice(s, i + 1, (i + 2) - 1))
            int lo = _hex_val(strings.slice(s, i + 2, (i + 3) - 1))
            if hi >= 0 and lo >= 0 {
                out = out + strings.char(hi * 16 + lo)
                i = i + 3
                continue
            }
        }
        out = out + c
        i = i + 1
    }
    return out
}

// `中 文/a b` ⇒ `%E4%B8%AD%20%E6%96%87%2Fa%20b`（只对**非 unreserved** 编码 ✓）
//   按**字节**遍历（`byte_len`/`byte` ✓）—— 多字节字符会被拆成 3 个 %XX ✓ 正是 URL 规范要求
export func percent_encode(string s): string {
    string out = ""
    string keep = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_.~/"
    int i = 0
    while (i < strings.byte_len(s)) {
        int b = strings.byte(s, i)
        string c = strings.char(b)
        if strings.find(keep, c) >= 0 {
            out = out + c
        } else {
            out = out + "%" + _hex_digit(b / 16) + _hex_digit(b % 16)
        }
        i = i + 1
    }
    return out
}

// `file:///home/u/a%20b.txt` ⇒ `/home/u/a b.txt`；`file:///C:/x` ⇒ `C:/x` ✓
export func file_uri_to_path(string uri): string {
    string s = strings.trim(uri)
    if not strings.starts_with(s, "file://") { return "" }
    string p = strings.slice(s, 7, s.len())
    // `file:///C:/…` 会留下一个前导 '/' ⇒ Windows 盘符形态要去掉 ✓
    if strings.starts_with(p, "/") and p.len() > 2 {
        string second = strings.slice(p, 2, 2)
        if second == ":" { p = strings.slice(p, 1, p.len()) }
    }
    return percent_decode(p)
}

// ==================== shell 引号（Linux 侧组命令）====================

// 单引号包裹（`'` → `'\''`）⇒ 任意路径都能安全拼进 `sh -c` ✓
//   ⚠ 这是"防注入 + 防空格路径"的唯一正解；直接拼双引号会被 `$`/反引号穿透 ✗
export func sh_quote(string s): string {
    return "'" + strings.replace(s, "'", "'\\''") + "'"
}

// `kill -TERM 123` / `kill -KILL 123`（force=true ⇒ -9 ✓）
export func build_kill_cmd(int pid, bool force): string {
    if force { return "kill -9 " + _str(pid) }
    return "kill -TERM " + _str(pid)
}

// ==================== Windows：whoami /user（当前用户 SID）====================
// 输出形态（Vista+ 自带，实测 ✓）：
//     USER INFORMATION
//     ----------------
//     User Name                     SID
//     ============================= =============================================
//     desktop-xxxx\administrator    S-1-5-21-3292028396-4221411052-2427840571-500
// ★ 判据 = "**以 `S-` 起首的那个空白分隔词**"（不去数列：表头/分隔线/域前缀都会变 ✓）
//   ⚠ SID 从不是最后一行也不是固定列 ⇒ 按**前缀**找最稳 ✓；找不到 ⇒ `""`（不猜 ✓）
export func parse_whoami_sid(string out): string {
    var ls = split_lines(out)
    for ls to l {
        var t = tokens(l)
        for t to w {
            if strings.starts_with(w, "S-") { return w }
        }
    }
    return ""
}

// ==================== Windows：回收站 `$I` 账本（二进制）====================
// 结构（**本机实测**核出来的，不是抄文档 —— 文档里"偏移 24 是字节数"那种说法对不上 ✗）：
//     偏移 0   u32   版本（1 = 老版；2 = Win10+）
//     偏移 4   u32   补零（观察值恒 0）
//     偏移 8   u64   原文件大小（字节）
//     偏移 16  u64   删除时间（FILETIME：100ns 自 1601-01-01 UTC）
//     偏移 24  u32   **路径长度（UTF-16 单元数，含结尾 NUL）** —— 仅版本 2 有
//     偏移 28  **UTF-16LE** 的原路径（版本 1 的路径从偏移 **24** 起）
//   ★ 实测样本（`$I0UFLFU`，82 字节）：
//     `02 00 00 00 | 00 00 00 00 | 21 89 9F 03 00 00 00 00 | … | 1B 00 00 00 | "C:\Program Files (x86)\Doc" NUL`
//     24 + 27*2 = 82 ✓ ⇒ 那个 `1B`(=27) 就是"27 个 UTF-16 单元（26 个字符 + 结尾 NUL）" ✓
//   ⚠ 长度字段**只当校验/参考**：真正的路径一律"**读到 NUL 或到头**"为止
//     （老版没有长度字段；且被测机器的记录里长度含不含 NUL 有历史差异 ⇒ 不靠它切 ✓）
// 返回 {ok, version, sizeBytes, deletedAtSec, path}（ok=false = 结构不认识 ⇒ 调用方跳过 ✓）
export func parse_recycle_item(string raw): Dict {
    var by = strings.to_bytes(raw)
    if by.len() < 24 {
        return {ok: false, version: 0, sizeBytes: 0, deletedAtSec: 0, path: ""}
    }
    int ver = _le32(by, 0)
    int size = _le64(by, 8)
    int ft = _le64(by, 16)
    int off = 28
    if ver < 2 { off = 24 }        // 老版：没有长度字段，路径紧跟在时间之后（定长 260 单元 ✓）
    string p = decode_utf16le(by, off, 0)
    return {ok: p != "",
            version: ver,
            sizeBytes: size,
            deletedAtSec: filetime_to_epoch(ft),
            path: p}
}

// FILETIME（100ns 自 1601-01-01）→ Unix 秒（1970-01-01）
//   ⚠ 这个常数必须写全（11644473600 秒 × 10^7）：少写几个 0 会静默得到**看似合理**的时间 ✗
//   ⚠ 早于 1970 的时间（不可能出现在删除记录里）⇒ 返回 0（不返回负数 ✓）
export func filetime_to_epoch(int ft): int {
    if ft <= 0 { return 0 }
    int sec = (ft - 116444736000000000) / 10000000
    if sec < 0 { return 0 }
    return sec
}

// 小端 u32 / u64（越界字节当 0 ⇒ 短记录不会崩 ✓）
func _le32(Array[int] by, int off): int {
    int v = 0
    int i = 3
    while (i >= 0) {
        v = v * 256 + _byte_at(by, off + i)
        i = i - 1
    }
    return v
}

func _le64(Array[int] by, int off): int {
    int v = 0
    int i = 7
    while (i >= 0) {
        v = v * 256 + _byte_at(by, off + i)
        i = i - 1
    }
    return v
}

func _byte_at(Array[int] by, int i): int {
    if i < 0 or i >= by.len() { return 0 }
    return by[i]
}

// UTF-16**LE** 字节段 → UTF-8 字符串
//   · 读到 **NUL 单元** 或字节用尽即停（`$I` 的路径就是 NUL 结尾 ✓）
//   · `maxUnits > 0` 时最多读这么多个单元（要定长读法时用 ✓）
//   · **代理对**（`D800-DBFF` + `DC00-DFFF`）合成 4 字节 UTF-8 —— 文件名里可能有 emoji ✓
//     孤立代理 ⇒ **跳过**（它本身不是合法字符；硬编成 3 字节会产出非法 UTF-8 ✗）
//   ⚠ 全程按**字节**处理（`to_bytes` → 逐字节拼 `from_bytes` ✓）：UTF-16 是字节级格式，
//     拿 `strings.slice`（字符语义）切会把相邻两字节当成一个码点 ✗
export func decode_utf16le(Array[int] by, int from, int maxUnits): string {
    Array[int] out = []
    int i = from
    int n = 0
    while (i + 1 < by.len()) {
        if maxUnits > 0 and n >= maxUnits { break }
        int u = by[i] + by[i + 1] * 256
        if u == 0 { break }
        i = i + 2
        n = n + 1

        int cp = u
        if u >= 55296 and u <= 56319 {              // 0xD800..0xDBFF：高代理
            if (i + 1 >= by.len()) { continue }
            int lo = by[i] + by[i + 1] * 256
            if lo < 56320 or lo > 57343 { continue }  // 后面不是低代理（0xDC00..0xDFFF）⇒ 丢弃
            cp = 65536 + (u - 55296) * 1024 + (lo - 56320)
            i = i + 2
            n = n + 1
        } else if u >= 56320 and u <= 57343 {        // 孤立的低代理 ⇒ 丢弃
            continue
        }
        _push_utf8(out, cp)
    }
    return strings.from_bytes(out)
}

// 一个码点 → UTF-8 字节（标准 1/2/3/4 字节编码 ✓）
func _push_utf8(Array[int] out, int cp) {
    if cp < 128 {
        out.add(cp)
    } eif cp < 2048 {
        out.add(192 + cp / 64)
        out.add(128 + cp % 64)
    } eif cp < 65536 {
        out.add(224 + cp / 4096)
        out.add(128 + (cp / 64) % 64)
        out.add(128 + cp % 64)
    } else {
        out.add(240 + cp / 262144)
        out.add(128 + (cp / 4096) % 64)
        out.add(128 + (cp / 64) % 64)
        out.add(128 + cp % 64)
    }
}
