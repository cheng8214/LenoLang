// sys_linux.leno — LenoSys 的 **Linux 后端**
//
// ★ 设计（为什么这样能"没 Linux 也能验"）：
//   本文件只做三件事：**读文件 / 跑命令 / 调纯解析器**（`sys_parse.leno`）。
//   所有"文本 → 结构"的逻辑都在解析器里，而解析器**已在 Windows 上被
//   assert\test_sys_parse.leno 钉死** ✓ ⇒ 这里剩下的只是薄壳（读/跑/拼）✓
//
// ★ 不 import 门面 Sys.leno（否则成环）；返回一律 **Dict**，由门面转结构体 ✓
// ★ 不 import ffi ⇒ 没有一个手写 ABI 结构（statvfs 之类）⇒ 没有"结构体布局错了静默崩"的风险 ✓
//   （磁盘空间走 `df`、进程走 /proc、回收站走 freedesktop Trash 规范 ✓）
import dirs
import files
import strings
import jsons
import times as ti
import "./sys_parse.leno" as sp

// 外部命令统一给超时，避免卡死（mount 挂起时 df 会一直等 ✗）
const int CMD_TIMEOUT_MS = 15000

// ==================== 平台信息 / 常用目录（XDG 规范 ✓）====================

export func homeDir(): string { return _env_or("HOME", "") }

export func tempDir(): string {
    string t = _env_or("TMPDIR", "")
    if t != "" { return t }
    return "/tmp"
}

export func configDir(): string {
    string x = _env_or("XDG_CONFIG_HOME", "")
    if x != "" { return x }
    return homeDir() + "/.config"
}

export func dataDir(): string {
    string x = _env_or("XDG_DATA_HOME", "")
    if x != "" { return x }
    return homeDir() + "/.local/share"
}

export func cacheDir(): string {
    string x = _env_or("XDG_CACHE_HOME", "")
    if x != "" { return x }
    return homeDir() + "/.cache"
}

export func systemRoot(): string { return "/" }
export func pathSep(): string { return "/" }

// ==================== 系统信息（sysInfo）====================
// 全部来自**只读的 /proc 与 /etc**（不跑外部命令、不引 ffi ⇒ 没有手写 ABI 风险 ✓）
//   · 读不到某个文件（受限容器 / 非 Linux）⇒ 该字段留 `""`/`0`，**绝不编** ✗
//   · 解析全在 sys_parse（纯函数 ⇒ 已在 Windows 上被 assert\test_sys_parse 钉死 ✓）
// 返回 Dict{osName, kernel, host, user, cpuModel, cpuCount, memTotalKb, memAvailKb, uptimeSec}
//   （`elevated` 不在这里 —— 它由门面单独取 `isElevated()`，避免两处实现 ✓）
export func sysInfo(): Dict {
    // ① 发行版全名：`/etc/os-release`
    var osr = sp.parse_os_release(_read_text("/etc/os-release"))
    // ② 内核版本 / 主机名：各是一行一个值的 /proc 文件 ✓
    string kernel = _read_text("/proc/sys/kernel/osrelease")
    string host = _read_text("/proc/sys/kernel/hostname")
    // ③ CPU：读一次 cpuinfo 拿型号 + 核数 ✓（ARM 上型号可能取不到，核数照样准 ✓）
    var ci = sp.parse_cpuinfo(_read_text("/proc/cpuinfo"))
    // ④ 内存：总量 + 可用（老内核缺 MemAvailable 时解析层会降级到 MemFree ✓）
    var mi = sp.parse_meminfo(_read_text("/proc/meminfo"))
    // ⑤ 运行时长：`/proc/uptime` 第一个数是秒（带小数 ⇒ 取整 ✓）
    int uptimeSec = sp.first_int_in(_read_text("/proc/uptime"), 0)
    // ⑥ 用户名：走 `id -un`（**比 $USER 权威** —— 环境变量谁都能改 ✗）
    string user = ""
    ExecResult? r = _exec("id -un", CMD_TIMEOUT_MS)
    if r != null and r.code == 0 { user = strings.trim(r.output) }

    return {osName: jsons.get_str(osr, "pretty", ""),
            kernel: kernel,
            host: host,
            user: user,
            cpuModel: jsons.get_str(ci, "model", ""),
            cpuCount: jsons.get_int(ci, "count", 0),
            memTotalKb: jsons.get_int(mi, "totalKb", 0),
            memAvailKb: jsons.get_int(mi, "availKb", 0),
            uptimeSec: uptimeSec}
}

// 读一个"一行一值"的 /proc 文件（读不到 ⇒ `""`；顺带去掉行尾换行 ✓）
func _read_text(string path): string {
    string txt = ""
    try { txt = files.read(path) } catch e { return "" }
    return strings.trim(txt)
}

// 当前是否 **root**（门面 `isElevated()` 的 Linux 实现 ✓）
//   ⚠ 判据就是 `uid == 0`（Linux 没有 Windows 那套"提权令牌"概念）✓
//   ⚠ `_uid()` 拿不到（-1）⇒ **保守返回 false**（"不确定是不是 root" 会误导调用方去删
//     系统文件 ⇒ 宁可说"不是" ✓）
export func isElevated(): bool {
    return _uid() == 0
}

// ==================== 进程（/proc）====================

// 返回 {ok, errorCode, processes:[{pid,name,path}]}
//   ⚠ 只读 `/proc/<pid>/stat`（不读 cmdline：它可能因为权限返回空 ✗）
export func listProcesses(): Dict {
    if not dirs.exists("/proc") { return {ok: false, errorCode: -1, processes: []} }

    Array out = []
    var names = dirs.listdir("/proc")
    for names to n {
        // 只认纯数字目录（`self`/`thread-self`/`sys` 等一律跳过 ✓）
        if not sp.is_number(n) { continue }

        string line = ""
        try { line = files.read("/proc/" + n + "/stat") } catch e { line = "" }
        if line == "" { continue }     // 进程已退出/权限不足 ⇒ 跳过（不静默吞，只是"不存在" ✓）

        var d = sp.parse_proc_stat(line)
        if jsons.get_bool(d, "ok", false) {
            out.add({pid: _int(n), name: jsons.get_str(d, "name", ""), path: ""})
        }
    }
    return {ok: true, errorCode: 0, processes: out}
}

// 常驻内存（VmRSS，KB）；读不到 ⇒ -1 ✓
export func processMemoryKb(int pid): int {
    string txt = ""
    try { txt = files.read("/proc/" + _str(pid) + "/status") } catch e { return -1 }
    return sp.parse_proc_status_mem(txt)
}

export func processExists(int pid): bool {
    if pid <= 0 { return false }
    return dirs.exists("/proc/" + _str(pid))
}

export func killProcess(int pid, bool force): bool {
    if pid <= 0 { return false }
    ExecResult? r = _exec(sp.build_kill_cmd(pid, force), CMD_TIMEOUT_MS)
    if r == null { return false }
    return r.code == 0
}

// ★ 自己读 `/proc/self/stat` 的第 1 字段 —— `/proc/self` 就是"当前进程" ✓
//   （不用 `echo $PPID` 那种 shell 技巧：多一层子进程就不可靠 ✗）
export func currentPid(): int {
    string line = ""
    try { line = files.read("/proc/self/stat") } catch e { return -1 }
    var d = sp.parse_proc_stat(line)
    if not jsons.get_bool(d, "ok", false) { return -1 }
    return jsons.get_int(d, "pid", -1)
}

// `/proc/<pid>/exe` 是**符号链接** ⇒ 只能 readlink（直接用 files.read 会读到二进制本身 ✗✗）
export func exePath(): string {
    int pid = currentPid()
    if pid <= 0 { return "" }
    ExecResult? r = _exec("readlink -f /proc/" + _str(pid) + "/exe", CMD_TIMEOUT_MS)
    if r == null { return "" }
    return strings.trim(r.output)
}

// 指定进程的可执行文件**全路径**（取不到 ⇒ `""`）
//   与门面的 `exePath()`（只看自己）互补：这是**按需**查一个 pid ✓
//   ⚠ 为什么不做进 `listProcesses` 的 `path` 字段：那要给每个 pid 付一次进程开销（见该函数注释 ✓）
export func processPath(int pid): string {
    if pid <= 0 { return "" }
    ExecResult? r = _exec("readlink -f /proc/" + _str(pid) + "/exe", CMD_TIMEOUT_MS)
    if r == null or r.code != 0 { return "" }
    return strings.trim(r.output)
}

// ==================== 磁盘 ====================

export func listDrives(): Array[string] {
    Array[string] out = []
    try {
        var d = dirs.list_drives()
        for d to x { out.add(x) }
    } catch e { return out }
    if out.len() == 0 { out.add("/") }
    return out
}

// 该路径所在的**卷/分区根**（判不出 ⇒ `""`，绝不猜 ✓）
//   Linux = 挂载点（`/` 或 `/media/u/U盘` …）；Windows 侧的门面对等物是盘符根（`C:\` ✓）
//   ⚠ `dirs.abspath` 走 `realpath`（POSIX 语义）⇒ **符号链接会被解析到真实位置**，
//     得到的是文件**实际所在**的分区 ✓（这对"跨分区回收站/清理"恰恰是想要的 ✓）
//   ⚠ 路径不存在时 `dirs.abspath` 会退回词法拼接（仍可用）⇒ 但判分区只看前缀是否命中挂载点 ✓
export func volumeOf(string path): string {
    if strings.trim(path) == "" { return "" }        // 空 ⇒ 判不出（与 Windows 侧同口径 ✓）
    string abs = path
    try {
        string a = dirs.abspath(path)
        if a != "" { abs = a }
    } catch e {
        abs = path                                   // 解析失败 ⇒ 用原值（不猜、不抛 ✓）
    }
    return _mountOf(abs)
}

// `df -B1`（GNU coreutils / busybox 都有 ✓）；单位字节 ✓
export func diskSpace(string path): Dict {
    string q = sp.sh_quote(path)
    ExecResult? r = _exec("df -B1 --output=size,avail " + q, CMD_TIMEOUT_MS)
    if r != null {
        var d = sp.parse_df(r.output)
        if jsons.get_bool(d, "ok", false) {
            return {ok: true, total: jsons.get_int(d, "total", 0), free: jsons.get_int(d, "free", 0)}
        }
    }
    // 退回普通 df（老 coreutils 不认 --output ✓ 解析器两种形态都吃 ✓）
    ExecResult? r2 = _exec("df -B1 " + q, CMD_TIMEOUT_MS)
    if r2 == null { return {ok: false, total: 0, free: 0} }
    var d2 = sp.parse_df(r2.output)
    if jsons.get_bool(d2, "ok", false) {
        return {ok: true, total: jsons.get_int(d2, "total", 0), free: jsons.get_int(d2, "free", 0)}
    }
    return {ok: false, total: 0, free: 0}
}

// ==================== 回收站（freedesktop.org Trash 规范）====================
//
//   ~/.local/share/Trash/files/<名字>          ← 实际文件
//   ~/.local/share/Trash/info/<名字>.trashinfo ← 还原信息（原始绝对路径 + 删除时间）
//   ⚠ 规范里"其它分区"放 `<挂载点>/.Trash-<uid>`（或 `<挂载点>/.Trash/<uid>`）✓
//   ★ 2026-10-15 起**两半都做了**：
//     · **清空** `emptyTrash()` ⇒ 家目录 + 各挂载点 + `expunged/` ✓
//     · **移入** `deleteToTrash()` ⇒ **按目标文件所在的分区**挑回收站 ✓
//       （同分区用家目录那个；异分区用该分区的 `<挂载点>/.Trash-<uid>`）✓
//   这么做还顺带解决了一个隐患：跨分区 `mv` 会**退化成"复制 + 删除"**（不是原子改名 ✗，
//   大文件既慢又可能中途失败）⇒ 现在目标目录与源**同分区**，`mv` 一定是原子的 rename ✓

func _trashDir(): string { return dataDir() + "/Trash" }

// ==================== 各分区的回收站目录 ====================
// 规范（freedesktop Trash）对"非家目录分区"给两种布局，优先前者：
//   ① `<挂载点>/.Trash/<uid>` —— **仅当** `<挂载点>/.Trash` 存在、是 sticky 目录且归 root
//      （多用户共享的机器上，管理员会这么建；此时每个用户占其中一个 `<uid>` 子目录 ✓）
//   ② `<挂载点>/.Trash-<uid>` —— 否则用/建这个"用户专属"的（权限 0700 ✓）
// ⚠ 两种都放"只有自己能进"的目录 ⇒ 不碰别人的回收站 ✓

// 该路径所在分区应当使用的回收站目录（判不出 ⇒ ""，调用方**如实报错**而不是猜 ✓）
func _trashDirForAbs(string abs): string {
    string homeTrash = _trashDir()
    string mnt = _mountOf(abs)
    if mnt == "" { return "" }
    // 与家目录回收站**同分区** ⇒ 直接用家目录那个 ✓（规范推荐；此时 mv 是原子改名 ✓）
    if mnt == _mountOf(_trashDir()) { return homeTrash }
    return _trashOnMount(mnt)
}

// 某挂载点上的回收站目录（不存在则创建；创建不出来 ⇒ ""）
func _trashOnMount(string mnt): string {
    int uid = _uid()
    if uid < 0 { return "" }
    string us = _str(uid)
    string top = mnt
    if top == "/" { top = "" }              // 免得拼出 `//…` ✓
    // ① 共享布局：`<挂载点>/.Trash/<uid>`（先看顶层 `.Trash` 够不够格 ✓）
    string shared = top + "/.Trash"
    if _isStickyRootDir(shared) {
        string d = shared + "/" + us
        if _mkdirTrash(d) { return d }
    }
    // ② 用户专属布局：`<挂载点>/.Trash-<uid>`（需要时创建，权限 0700 ✓）
    string own = top + "/.Trash-" + us
    if _mkdirTrash(own) { return own }
    return ""
}

// 建一个回收站目录（要 files/ + info/ 两个子目录一起 ✓）；失败（如只读挂载 / 无权限）⇒ false
func _mkdirTrash(string d): bool {
    dirs.mkdir_p(d + "/files")
    dirs.mkdir_p(d + "/info")
    // ⚠ `mkdir_p` **不报"已存在"与"没权限"的区别** ⇒ 建完再 stat 一次确认（不假装成功 ✓）
    if not dirs.is_dir(d + "/files") { return false }
    // 规范要求 `.Trash-<uid>` 是 0700（只有自己进得去 ✓）；`mkdir_p` 用的是 umask ⇒ 显式收一下
    //   ⚠ 失败不改判（有些文件系统不支持 chmod，如 FAT 挂载 ⇒ 不该因此判"不能回收" ✗）
    //   ⚠ 返回值**有意丢掉** ⇒ 直接裸调（别 `var r = ...`：那样会报"未使用变量"警告 ✗）
    _exec("chmod 700 " + sp.sh_quote(d) + " " + sp.sh_quote(d + "/files")
          + " " + sp.sh_quote(d + "/info"), CMD_TIMEOUT_MS)
    return true
}

// `<dir>` 是不是"sticky 且属 root"的目录（回收站共享布局的前置条件 ✓）
//   用 `stat -c '%a %u'`（GNU/busybox 都有 ✓）—— 本模块**不 import ffi**（见文件头 ✓）
//   判据：mode 带 sticky 位（八进制 ≥ 1000，如 /tmp 的 1777 ✓）且属主 uid == 0 ✓
func _isStickyRootDir(string d): bool {
    if not dirs.exists(d) { return false }
    ExecResult? r = _exec("stat -c '%a %u' " + sp.sh_quote(d), CMD_TIMEOUT_MS)
    if r == null or r.code != 0 { return false }
    var t = sp.tokens(r.output)
    if t.len() < 2 { return false }
    int mode = sp.first_int_in(sp.at(t, 0), -1)
    int owner = sp.first_int_in(sp.at(t, 1), -1)
    //   ⚠ `%a` 的 `1777` 这种**带粘滞位**写法 ⇒ 数值必然 ≥ 1000；`755` ⇒ 755 ✗
    return mode >= 1000 and owner == 0
}

// 目标名去重：`a.txt` 已存在 ⇒ `a.txt.2`、`a.txt.3` … ✓
func _uniqueName(string dirPath, string base): string {
    if not dirs.exists(dirs.join(dirPath, base)) { return base }
    int i = 2
    while (i < 10000) {
        string cand = base + "." + _str(i)
        if not dirs.exists(dirs.join(dirPath, cand)) { return cand }
        i = i + 1
    }
    return base + "." + _str(ti.ms())
}

func _two(int n): string {
    if n < 10 { return "0" + _str(n) }
    return _str(n)
}

// `2026-10-01T12:34:56`（Trash 规范要求的本地时间格式 ✓）
func _nowIso(): string {
    var dt = ti.datetime()
    if dt.len() < 6 { return "1970-01-01T00:00:00" }
    return _str(dt[0]) + "-" + _two(_int(dt[1])) + "-" + _two(_int(dt[2]))
         + "T" + _two(_int(dt[3])) + ":" + _two(_int(dt[4])) + ":" + _two(_int(dt[5]))
}

export func deleteToTrash(Array[string] paths): Dict {
    int okCount = 0
    Array[string] errs = []
    for paths to p {
        string abs = dirs.abspath(p)
        if not dirs.exists(abs) {
            errs.add(abs + "：不存在")
            continue
        }
        // ★ 2026-10-15：**每个路径各自**挑回收站 —— 它可能不在家目录那个分区上 ✓
        //   （同一批里混着家目录文件与 U 盘文件是完全正常的 ✓）
        string root = _trashDirForAbs(abs)
        if root == "" {
            errs.add(abs + "：判不出所在分区/建不出该分区的回收站")
            continue
        }
        string filesDir = root + "/files"
        string infoDir = root + "/info"

        string target = _uniqueName(filesDir, dirs.basename(abs))
        ExecResult? mv = _exec("mv -f " + sp.sh_quote(abs) + " " + sp.sh_quote(filesDir + "/" + target), CMD_TIMEOUT_MS)
        string why = ""
        if mv != null { why = "（" + strings.trim(mv.output) + "）" }
        if mv == null or mv.code != 0 {
            errs.add(abs + "：移动失败" + why)
            continue
        }

        // 还原信息（Path 要**百分号编码**；否则含空格/中文的路径还原不回来 ✗）
        files.write(infoDir + "/" + target + ".trashinfo",
            "[Trash Info]\nPath=" + sp.percent_encode(abs) + "\nDeletionDate=" + _nowIso() + "\n")
        okCount = okCount + 1
    }

    // ⚠ `count` 的口径与 Windows 侧**必须一致**：都是"**提交的路径数**"（不是成功数 ✓）
    //   —— Win32 的 SHFileOperation 就是这么报的（实测：路径不存在时 ok=false、count 仍 =1 ✓），
    //   成功数看 `ok`、失败明细看 `errors`（Windows 侧不给明细 ⇒ 注释里写明，见门面文档 ✓）
    return {ok: errs.len() == 0, count: paths.len(), aborted: false, errors: errs, moved: okCount}
}

// 清空回收站：**家目录 + 各挂载点**（与 Windows 侧 SHEmptyRecycleBin"清所有驱动器"同口径 ✓）
//   ★ 2026-10-15 补跨分区（原来只清家目录 ⇒ 外挂盘 / 其他分区的回收站清不掉 ✗）
//   覆盖范围交给 `_trashDirs()`（与 `listTrash` **共用同一套** —— 否则"列得出来却清不掉"
//   或反过来"清得掉却列不出来"，两边必然漂 ✗）
export func emptyTrash(): bool {
    for _trashDirs() to t {
        _clearTrashAt(t)
    }
    return true
}

// 本机**所有**回收站根（家目录 + 各挂载点）—— `emptyTrash` / `listTrash` 共用 ✓
//   规范规定的两种跨分区布局都收（存在才收 ⇒ 不会平白建目录 ✗）：
//     · `<挂载点>/.Trash-<uid>`                      ← 现代布局（较常用）
//     · `<挂载点>/.Trash/<uid>`（分区根的 `.Trash` 为 sticky 且属 root 时才有）
//   ⚠ 家目录那个**不删 .Trash/<uid>** 那一份（同一分区时它就是家目录回收站的镜像布局）
func _trashDirs(): Array[string] {
    Array[string] out = [_trashDir()]
    int uid = _uid()
    if uid >= 0 {
        for _mountPoints() to m {
            string base = m
            if base == "/" { base = "" }        // 免得拼出 `//.Trash-1000` ✓
            for [base + "/.Trash-" + _str(uid), base + "/.Trash/" + _str(uid)] to cand {
                if cand == "" or not dirs.exists(cand) { continue }
                bool dup = false
                for out to o {
                    if o == cand { dup = true }
                }
                if not dup { out.add(cand) }
            }
        }
    }
    return out
}

// 列回收站内容（家目录 + 各分区 ✓）
//   返回 `Array` of Dict{name, originalPath, deletedAt, trashDir}（门面转 `TrashItem` ✓）
//   ⚠ 只认 `info/*.trashinfo`（规范账本）⇒ 能拿到**原始路径与删除时间**；
//     `files/` 里没有对应账本的条目**不列**（没账可查，宁缺勿猜 ✗）
//   ⚠ 账本在、但 `files/<名字>` 已不在 ⇒ **也不列**（列出来点"还原"必然失败 ✗）
//   ⚠ 本版**不给大小**：每条目都 walk 一次，回收站大时会明显卡 ✗
//     （调用方要大小就自己 `dirs.stat`/`walk`：拿 `trashDir + "/files/" + name` 即可 ✓）
//   ⚠ 修不动/读不了某个 `<info>` 目录 ⇒ 跳过该根（不抛；读不到 ≠ 回收站是空的 ✓）
export func listTrash(): Array {
    Array out = []
    for _trashDirs() to t {
        string infoDir = t + "/info"
        Array[string] names = []
        try { names = dirs.listdir(infoDir) } catch e { continue }
        for names to n {
            if not strings.ends_with(n, ".trashinfo") { continue }
            string nm = strings.slice(n, 0, n.len() - 11)      // 去掉 ".trashinfo"（10 字符 ✓）
            if nm == "" { continue }
            if not dirs.exists(t + "/files/" + nm) { continue }  // 文件已不在 ⇒ 不列 ✓
            string txt = ""
            try { txt = files.read(dirs.join(infoDir, n)) } catch e { continue }
            var d = sp.parse_trashinfo(txt)
            if not jsons.get_bool(d, "ok", false) { continue }
            out.add({name: nm,
                     originalPath: jsons.get_str(d, "path", ""),
                     deletedAt: jsons.get_str(d, "deletedAt", ""),
                     trashDir: t})
        }
    }
    return out
}

// 清一个回收站目录：`files/` + `info/` + `expunged/`（目录不存在 ⇒ 各自 no-op ✓）
func _clearTrashAt(string t) {
    _clearDir(t + "/files")
    _clearDir(t + "/info")
    _clearDir(t + "/expunged")
}

// 当前 uid（拿不到 ⇒ -1）：走 `id -u`（coreutils / busybox 都有 ✓）
//   ⚠ 本模块**刻意不 import ffi**（见文件头）⇒ 不碰 `getuid()` 那种手写 ABI ✓
func _uid(): int {
    ExecResult? r = _exec("id -u", CMD_TIMEOUT_MS)
    if r == null { return -1 }
    return sp.first_int_in(r.output, -1)
}

// 挂载点列表（回收站按挂载点找 `.Trash-<uid>` ✓）
//   ★ 读 `/proc/mounts`（**不是 `df -P`**）：挂载点允许含空格，而 df 按列取会把
//     `/media/<用户>/Ubuntu 22.04.5 LTS amd64` 这种**外挂盘**整个漏掉 ✗（本轮实测踩到 ✓）
//     `/proc/mounts` 用 `\040` 转义空格 ⇒ 列号无歧义 ✓
//   ⚠ 解析全在 `sp.parse_proc_mounts`（纯函数 ⇒ 已在 assert\test_sys_parse.leno 钉死 ✓）
//   ⚠ 读不到 /proc/mounts（非 Linux / 受限容器）⇒ 返回空表 ⇒ 只清家目录，**不猜路径** ✓
func _mountPoints(): Array[string] {
    Array[string] none = []
    string txt = ""
    try { txt = files.read("/proc/mounts") } catch e { return none }
    if txt == "" { return none }
    return sp.parse_proc_mounts(txt)
}

// 该路径归属的挂载点（`""` = 判不出 ⇒ 调用方**如实报错**，不猜 ✓）
//   ★ 选择逻辑（最长前缀 + 边界敏感）全在 `sp.mount_of` 里 —— 纯函数 ⇒ 已被
//     assert\test_sys_parse.leno 钉死（含"`/run/user/10` 不该命中 `/run/user/1000`" ✓）
func _mountOf(string abs): string {
    return sp.mount_of(_mountPoints(), abs)
}

func _clearDir(string d) {
    if not dirs.exists(d) { return }
    try {
        var names = dirs.listdir(d)
        for names to n { _rm_rf(dirs.join(d, n)) }
    } catch e { return }
}

// 递归删除（纯 Leno：listdir + stat + delete ✓ 不走 `rm -rf` ⇒ 不怕路径拼错 ✓）
//   ⚠ **符号链接必须当文件删**：否则会跟着链接进目标目录、把真文件删掉 ✗✗
func _rm_rf(string p) {
    bool isLink = false
    try { isLink = dirs.is_symlink(p) } catch e { isLink = false }
    if isLink {
        try { files.delete(p) } catch e { return }
        return
    }
    bool isDir = false
    try { isDir = dirs.is_dir(p) } catch e { isDir = false }
    if isDir {
        try {
            var names = dirs.listdir(p)
            for names to n { _rm_rf(dirs.join(p, n)) }
        } catch e { return }
        try { dirs.rmdir(p) } catch e { return }
    } else {
        try { files.delete(p) } catch e { return }
    }
}

// ==================== 桌面集成（打开 / 定位 / 通知）====================
// 三个都靠 freedesktop 约定的小工具（`xdg-open` / `notify-send`），**先探测再调用** ✓
//   ⚠ 工具不在 ⇒ 直接 `false`：**绝不假装成功** ✗
//     （"返回 true、屏幕上却什么都没发生"是最坏的一种 —— 调用方据此没法置灰按钮 ✗）
//   ⚠ `xdg-open` 的 generic 分支是**前台 exec**（会一直等到目标程序退出）⇒ 前台跑必然
//     被 `CMD_TIMEOUT_MS` 掐掉、还会误报失败 ✗ ⇒ 打开类一律**后台发起**（见下 ✓）
//   ⚠ `notify-send` 是**同步**的（等通知守护进程应答，毫秒级）⇒ 它前台跑，能用退出码
//     如实回答"投递出去没有" ✓ —— 两者语义不同，不要统一样子 ✗

// 某命令是否可用
//   ⚠ 判据用 `which`（**真二进制**），**不能**用 `command -v` ✗ —— 这条踩过实测：
//     `_exec` 把命令包成 `( timeout N <cmd> )` 再交给 sh，而 `timeout` 是用 `execvp` 跑命令词的
//     ⇒ **命令词必须是真二进制**；shell 内建（`command` / `type` / `test`）当命令词会直接失败 ✗
//     （实测复现：`timeout 5 command -v xdg-open` ⇒ `timeout: 无法运行命令 "command"` rc=127 ✓
//       而 `timeout 5 whoami` 正常 ✓）
//   ⚠ 反过来，用 sh 能解释的语法（`&` / 重定向）是**可以**的 —— 因为最终走 `system()` ✓
//   ⚠ `which` 本身缺席（极小容器）⇒ 返回 false = 当成"不可用"（保守方向 ✓ 见文件头）
func _hasCmd(string name): bool {
    ExecResult? r = _exec("which " + sp.sh_quote(name), CMD_TIMEOUT_MS)
    if r == null or r.code != 0 { return false }
    return strings.trim(r.output) != ""
}

// 粗略判 URI：含 `://`（http/https/file…）或以 `mailto:` 起首 ✓
func _isUri(string s): bool {
    if strings.find(s, "://") >= 0 { return true }
    return strings.starts_with(s, "mailto:")
}

// 用系统默认程序打开一个**文件 / 目录 / URI**（`https://…` 也认 ✓）
//   ⚠ 非 URI 的话要求它**存在**：xdg-open 对不存在的路径会静默失败，而我们后台发起后
//     根本拿不到它的退出码 ⇒ 先自己挡一道 ✓
//   ⚠ 返回 `true` 的含义是"**已发起**打开请求"，不等于目标程序真的起来了 ✓（注释与门面同步）
//   ★ 2026-10-15 更正：这一句里有**两个各自独立**的手法，别把它们混成一条（我第一版就写错了 ✗）：
//     · `&` ⇒ **sh 立刻返回**（不等程序退出）—— 这才是"不卡住"的原因 ✓
//       （xdg-open 的 generic 分支是前台 exec，会一直等到程序退出 ⇒ 前台跑必被超时掐掉 ✗）
//     · `>/dev/null 2>&1` ⇒ **不让应用的输出混进本次捕获的 out/err** ✓
//       （`_exec` 会把整组的 stdout/stderr 收进临时文件当返回值返回；不隔离的话，被打开的
//        程序会往我们这两个文件里写东西 ⇒ 本次 `_exec` 的 out/err 被污染 ✗）
//       ⚠ 第一版我把这条理由写成"子进程攥着 popen 管道写端不放 ⇒ pclose 一直等" —— **那是错的** ✗：
//         这条路径根本没有 popen（`_exec` 走的是 `system()` + 临时文件，见 src/module/sys/sys.c ✓）
//   ⚠⚠ 这一整句**故意不传超时参数**（`_exec` 第 2 参缺省 ⇒ `timeout_ms=0` ⇒ 不套 `timeout`）：
//     · 若套上 `timeout`，超时那一刻它会**连同刚启动起来的程序一起** TERM 掉 ✗✗
//       （GNU timeout 默认把子进程放进新**进程组**、超时按**组**发信号 ⇒ 用 `&` 起的子进程会被连坐 ✓）
//       实测两条（build/_openwith_probe.leno 里钉着）：带超时的后台命令会被收掉（pgrep 退出码 1）、
//       不带超时的活着（退出码 0）✓
//     · 也**不能**改成"用 `exec` 包一层" —— 门面的 `exec` 固定 30s 超时、没有退出通道 ✗
export func openWith(string path): bool {
    string p = strings.trim(path)
    if p == "" { return false }
    if not _isUri(p) and not dirs.exists(p) { return false }
    if not _hasCmd("xdg-open") { return false }
    _exec("xdg-open " + sp.sh_quote(p) + " >/dev/null 2>&1 &")
    return true
}

// 在文件管理器里**打开它所在的目录**（**不保证"选中该文件"** ✗）
//   ⚠ 精确选中要 D-Bus `org.freedesktop.FileManager1.ShowItems`，而它**并非所有文件管理器
//     都实现**（且要 dbus-send/gdbus 多一个依赖 ✗）⇒ 这里选**朴素但处处可用**的做法：
//     打开父目录 ✓ —— 宁可少一点功能，也要真能用 ✓
export func revealInFolder(string path): bool {
    string p = strings.trim(path)
    if p == "" or not dirs.exists(p) { return false }
    string parent = dirs.dirname(p)
    if parent == "" { parent = "/" }
    return openWith(parent)
}

// 发一条桌面通知（标题必填；正文可空 ✓）
//   ⚠ 退出码就是"守护进程收没收" ⇒ 如实返回 ✓（不是"已发起"那种弱语义 ✓）
//   ⚠ 没装 notify-send / 没有通知守护进程（纯服务器）⇒ false ✓ 调用方据此降级为打日志 ✓
export func notify(string title, string body): bool {
    string t = strings.trim(title)
    if t == "" { return false }
    if not _hasCmd("notify-send") { return false }
    ExecResult? r = _exec("notify-send " + sp.sh_quote(t) + " " + sp.sh_quote(strings.trim(body)),
                          CMD_TIMEOUT_MS)
    if r == null { return false }
    return r.code == 0
}

// ==================== 开机启动项（freedesktop autostart 规范）====================
//
//   用户级：`~/.config/autostart/*.desktop`     系统级：`/etc/xdg/autostart/*.desktop`
//   `Hidden=true` / `NoDisplay=true` ⇒ enabled=false（仍然列出来 ✓ 让用户看得见）
//   ⚠ 只做 .desktop；systemd user units（`~/.config/systemd/user/*.service`）留待后续 ✓
export func startupItems(): Array {
    Array out = []
    _scanAutostart(out, configDir() + "/autostart", "user")
    _scanAutostart(out, "/etc/xdg/autostart", "system")
    return out
}

func _scanAutostart(Array out, string dir, string scope) {
    if not dirs.exists(dir) { return }
    try {
        var names = dirs.listdir(dir)
        for names to n {
            string full = dirs.join(dir, n)
            string txt = ""
            try { txt = files.read(full) } catch e { txt = "" }
            if txt == "" { continue }

            var e = sp.parse_desktop_entry(txt)
            if not jsons.get_bool(e, "ok", false) { continue }

            bool hidden = jsons.get_bool(e, "hidden", false)
            bool nodisp = jsons.get_bool(e, "noDisplay", false)
            string label = jsons.get_str(e, "name", "")
            if label == "" { label = n }

            out.add({scope: scope, id: n, name: label,
                     cmd: jsons.get_str(e, "execLine", ""),
                     source: "autostart", enabled: not (hidden or nodisp)})
        }
    } catch e { return }
}

// ==================== 开机自启动（Linux：freedesktop autostart）====================
//
//   `~/.config/autostart/<id>.desktop` —— 正是 `startupItems()` 读的那套 ✓
//   ⇒ 写进去之后，`listStartupItems()` 立刻能看到它（读写同源 ✓）
//   ⚠ `Exec=` 是**逐字照抄**调用方给的命令行 ⇒ 路径含空格时请自行加引号 ✓（这里不猜 ✗）
func _autostart_path(string id): string {
    if id == "" { return "" }
    return dirs.join(dirs.join(configDir(), "autostart"), id + ".desktop")
}

export func getAutostart(string id): string {
    string p = _autostart_path(id)
    if p == "" or not dirs.exists(p) { return "" }
    string txt = ""
    try { txt = files.read(p) } catch e { return "" }
    var e = sp.parse_desktop_entry(txt)
    if not jsons.get_bool(e, "ok", false) { return "" }
    if jsons.get_bool(e, "hidden", false) { return "" }     // `Hidden=true` ⇒ 已禁用 ✓
    return jsons.get_str(e, "execLine", "")
}

export func setAutostart(string id, string name, string cmd): bool {
    string p = _autostart_path(id)
    if p == "" or cmd == "" { return false }
    dirs.mkdir_p(dirs.dirname(p))
    string label = name
    if label == "" { label = id }
    string body = "[Desktop Entry]\n"
                + "Type=Application\n"
                + "Name=" + label + "\n"
                + "Comment=Leno 应用开机自启动（由 LenoSys 写入）\n"
                + "Exec=" + cmd + "\n"
                + "Terminal=false\n"
                + "Hidden=false\n"
                + "X-GNOME-Autostart-enabled=true\n"
    try {
        files.write(p, body)
        return dirs.exists(p)
    } catch e { return false }
}

export func removeAutostart(string id): bool {
    string p = _autostart_path(id)
    if p == "" { return false }
    if not dirs.exists(p) { return true }        // 本来就没有 ⇒ 目标已达成 ✓
    try {
        files.delete(p)
        return not dirs.exists(p)
    } catch e { return false }
}

// ==================== 已装软件（dpkg）====================
//
//   ⚠ 只做 Debian/Ubuntu 的 `/var/lib/dpkg/status`（纯文本 ✓）。
//     rpm（`/var/lib/rpm` 是 Berkeley DB ✗）/ pacman / flatpak 留待后续；
//     读不到 ⇒ 返回空数组（门面会带上"本平台未实现"的说明 ✓）
export func installedSoftware(): Array {
    Array out = []
    string f = "/var/lib/dpkg/status"
    if not files.exists(f) { return out }

    string txt = ""
    try { txt = files.read(f) } catch e { return out }

    var pkgs = sp.parse_dpkg_status(txt)
    for pkgs to p {
        string name = jsons.get_str(p, "name", "")
        if name == "" { continue }
        out.add({name: name,
                 version: jsons.get_str(p, "version", ""),
                 publisher: jsons.get_str(p, "maintainer", ""),
                 installPath: "",
                 source: "dpkg"})
    }
    return out
}

// ==================== 最近使用的文件 ====================

// `~/.local/share/recently-used.xbel`（GTK 维护的 XBEL 清单 ✓）
//   ⚠ xbel 里**没有可靠的"最后访问时间排序"**（要看 modified 属性解析 ✗）
//     ⇒ 本版按文件里出现的顺序返回（通常是"最新的在前" ✓）；如需严格排序用
//        `dirs.stat(path).mtime` 二级排序（后续 ✓）
export func recentFiles(int max): Array[string] {
    string f = dataDir() + "/recently-used.xbel"
    string txt = ""
    try { txt = files.read(f) } catch e { return [] }
    return sp.parse_xbel_recents(txt, max)
}
