// LenoCrypto 校验：断言值**全部由 node:crypto 生成**（权威）⇒ 绝对期望值 ✓
// 跑：build\leno.exe leno_module\LenoCrypto\test\test_crypto_vectors.leno
import strings  // base64 / 文本⇄字节 已归核心标准库（2026-10-07），不再由本库提供
import "Crypto" as crypto

main() {
    // ==================== 哈希 ====================
    assert_eq(crypto.sha256("abc"),
        "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    assert_eq(crypto.sha512("abc"),
        "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f")
    assert_eq(crypto.sha512_bytes(strings.to_bytes("abc")).len(), 64)   // 原始 64 字节 ✓

    // ==================== MD5（RFC 1321 向量 + 跨块 + UTF-8 字节口径）====================
    assert_eq(crypto.md5(""), "d41d8cd98f00b204e9800998ecf8427e")
    assert_eq(crypto.md5("a"), "0cc175b9c0f1b6a831c399e269772661")
    assert_eq(crypto.md5("abc"), "900150983cd24fb0d6963f7d28e17f72")
    assert_eq(crypto.md5("message digest"), "f96b697d7cb7938d525a2f31aaf161d0")
    assert_eq(crypto.md5("abcdefghijklmnopqrstuvwxyz"), "c3fcd3d76192e4007dfb496cca67e13b")
    assert_eq(crypto.md5("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"),
        "d174ab98d277d9f5a5611c2c9f419d9f")
    var rep = ""
    for 8 to i { rep += "1234567890" }                                   // RFC 1321 的 80 字符用例
    assert_eq(crypto.md5(rep), "57edf4a22be3c955ac49da2e2107b67a")
    assert_eq(crypto.md5("The quick brown fox jumps over the lazy dog"), "9e107d9d372bb6826bd81d3542a419d6")
    assert_eq(crypto.md5("中文"), "a7bac2239fcdcb3a067903d8077c4a07")     // UTF-8 每字 3 字节 ⇒ 走字节口径 ✓
    assert_eq(crypto.md5("中文abc"), "28251344f0303f110929e0bae4d2bd03")
    var a200 = ""
    for 200 to i { a200 = a200 + "A" }                                   // 跨多个 64 字节块
    assert_eq(crypto.md5(a200), "16bf06b3717d1f238252870e699c2a2e")
    assert_eq(crypto.md5_bytes(strings.to_bytes("abc")).len(), 16)        // 原始 16 字节 ✓

    // ==================== HMAC-SHA256 ====================
    assert_eq(crypto.hmac_sha256("key", "msg"),
        "2d93cbc1be167bcb1637a4a23cbff01a7878f0c50ee833954ea5221bb1b8c628")

    // ==================== Base64（含二进制安全性）====================
    // 实现已归核心标准库 `strings`（LenoCrypto 的 crypto_base64 已删）⇒ 这里守的是**标准库**那条路径
    assert_eq(strings.to_base64(strings.from_bytes([0, 1, 2, 253, 254, 255])), "AAEC/f7/")
    var back = strings.to_bytes(strings.from_base64("AAEC/f7/"))
    assert_eq(back.len(), 6)
    assert_eq(back[3], 253)                       // 253 是二进制字节 ⇒ 文本版会失真，字节版必须原样 ✓
    assert_eq(back[5], 255)
    assert_eq(strings.to_base64("foobar"), "Zm9vYmFy")
    assert_eq(strings.from_base64("Zm9vYmFy"), "foobar")
    // 标准库比旧 crypto 版**更宽容**（旧版遇 '=' 或非法字符是"静默截断"✗）——锁住这三点：
    assert_eq(strings.from_base64("Zm9vYmFy\n"), "foobar")                // 空白字符忽略
    assert_eq(strings.from_base64("Zg"), "f")                             // 缺 '=' padding 也收
    assert_eq(strings.from_base64("-_8="), strings.from_base64("+/8="))   // 两种字母表等价

    // ==================== AES-128-CBC（node 权威密文）====================
    var key = strings.to_bytes("0123456789abcdef")
    var iv = strings.to_bytes("abcdef0123456789")
    var ct_hex = "fd0ebb658338068b87dfb8b53954244e6b3a747633cc201a0ef5ead3f6fb4a09"
    var plain = "hello leno crypto"
    // 加密方向（PKCS7 自动补填充）
    assert_eq(crypto.bytes_to_hex(crypto.aes128_cbc_encrypt_bytes(key, iv, strings.to_bytes(plain))), ct_hex)
    // 解密方向（PKCS7 自动去填充）
    assert_eq(crypto.aes128_cbc_decrypt_str(key, iv, crypto.hex_to_bytes(ct_hex)), plain)

    // ==================== AES ECB 单块往返（自洽）====================
    var blk = strings.to_bytes("1234567890abcdef")
    assert_eq(crypto.bytes_to_hex(crypto.aes_decrypt_block(crypto.aes_encrypt_block(blk, key), key)),
        crypto.bytes_to_hex(blk))

    print("test_crypto_vectors passed")
}
