// LenoCrypto —— 通用加密库统一入口
// 与 LenoWeb / LenoSDL3 同一组织方式：import 子模块 → 重新导出 → export func 转发
//
// 设计取舍：
//   · 加解密一律走 **byte 数组（Array[int]）** ✓（字符串只是"顺手的糖"，因为 Leno 的
//     string 是字节串、二进制经 string 往返容易失真 ✗）；
//   · 子模块之间**互不依赖**（门面负责组合），改名/替换实现不影响别人 ✓；
//   · 全部来自 examples/crypto/*.leno 的**机械搬运**（截断各自 main()、逻辑逐字保留 ✓），
//     所以库里没有"新写但没验证"的算法 —— 校验见 test/test_crypto_vectors.leno
//     （向量由 node:crypto 生成，作为绝对期望值 ✓）。

import strings  // base64 / 文本⇄字节 一律直连标准库（2026-10-07 见下方说明）
import "crypto_sha256.leno" as s256
import "crypto_sha512.leno" as s512
import "crypto_hmac_sha256.leno" as hmac
import "crypto_aes.leno" as aes

// ==================== Base64 / 文本⇄字节（2026-10-07 迁至核心标准库）====================
// 原先这里转发 6 个函数（`base64_encode` / `base64_decode` / `b64_to_bytes` / `bytes_to_b64` /
// `str_to_bytes` / `bytes_to_str`），实现放在子模块 `crypto_base64.leno`。现在全部**删除**，
// 调用方一律直连 `strings.*`：
//   · 文本 ⇒ base64   ：`strings.to_base64(s)`（URL-safe 传第二个参数 true）
//   · base64 ⇒ 文本   ：`strings.from_base64(s)`
//   · 字节 ⇒ base64   ：`strings.to_base64(strings.from_bytes(bs))`
//   · base64 ⇒ 字节   ：`strings.to_bytes(strings.from_base64(s))`
//   · 文本 ⇄ 字节     ：`strings.to_bytes(s)` / `strings.from_bytes(bs)`
// 为什么删：base64 是**标量编解码**、不是密码学原语（无密钥、无安全性质），归核心标准库
//   （与 to_hex/from_hex 同族）⇒ 做分帧的 `web_ws` 这类模块不必为编解码去依赖一个加密库；
//   且加解密本身走 `Array[int]`，`strings.to_bytes/from_bytes` 语义完全一致 ✓
// 顺带换来一处**行为增强**：`strings.from_base64` 两种字母表都认（`+/` 与 `-_`）、缺 `=`
//   padding 也收、空白字符忽略，非法字符则**报错并指出第几位**（旧的 `b64_to_bytes` 是
//   "遇 '=' 或非法字符即静默截断" ⇒ 结果少一截却看不出原因 ✗）。

// ==================== 哈希 ====================
// sha256 / sha512 返回**十六进制小写字符串**；*_bytes 返回原始 32/64 字节
export func sha256(string input):string { return s256.sha256(input) }
// 注：sha256 的 bytes 版在 hmac 子模块里（那里也实现了一份 SHA-256），这里转发以免重复实现
export func sha256_bytes(Array[int] msg):Array[int] { return hmac.sha256_bytes(msg) }
export func sha512(string input):string { return s512.sha512(input) }
export func sha512_bytes(Array[int] msg):Array[int] { return s512.sha512_bytes(msg) }

// ==================== HMAC ====================
export func hmac_sha256(string key, string message):string { return hmac.hmac_sha256(key, message) }
export func hmac_sha256_bytes(Array[int] key_bytes, string message):string { return hmac.hmac_sha256_bytes(key_bytes, message) }

// ==================== AES（ECB 单块 + CBC 常用模式）====================
export func aes_encrypt_block(Array[int] plaintext, Array[int] key):Array[int] { return aes.aes_encrypt_block(plaintext, key) }
export func aes_decrypt_block(Array[int] ciphertext, Array[int] key):Array[int] { return aes.aes_decrypt_block(ciphertext, key) }
export func pkcs7_pad_bytes(Array[int] data, int block_size):Array[int] { return aes.pkcs7_pad_bytes(data, block_size) }
export func pkcs7_unpad_bytes(Array[int] data):Array[int] { return aes.pkcs7_unpad_bytes(data) }
// CBC：**内置 PKCS7**（加密自动补、解密自动去）⇒ 调用方不用管填充 ✓
export func aes128_cbc_encrypt_bytes(Array[int] key16, Array[int] iv16, Array[int] pt):Array[int] { return aes.aes128_cbc_encrypt_bytes(key16, iv16, pt) }
export func aes128_cbc_decrypt_bytes(Array[int] key16, Array[int] iv16, Array[int] ct):Array[int] { return aes.aes128_cbc_decrypt_bytes(key16, iv16, ct) }
// 字符串糖（内部按 UTF-8 字节处理）
export func aes128_cbc_encrypt_str(Array[int] key16, Array[int] iv16, string plaintext):Array[int] {
    return aes.aes128_cbc_encrypt_bytes(key16, iv16, strings.to_bytes(plaintext))
}
export func aes128_cbc_decrypt_str(Array[int] key16, Array[int] iv16, Array[int] ct):string {
    return strings.from_bytes(aes.aes128_cbc_decrypt_bytes(key16, iv16, ct))
}

// ==================== hex ====================
export func hex_to_bytes(string hex):Array[int] { return aes.hex_to_bytes(hex) }
export func bytes_to_hex(Array[int] bytes):string { return aes.bytes_to_hex(bytes) }
