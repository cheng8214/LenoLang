// bytes_capability.leno — 验证 Leno 的「字节级处理」能力
//
// 要确认的是：Leno 能不能写**字节级变换/解析**这一类程序 —— 二进制格式解析、协议编解码、
// 文件格式转换、按位运算的算法等等（通用能力，不针对任何具体格式）。四个验证点：
//   ① 位运算与位域拼装（大端/小端整数、掩码、循环移位、手写 hex）
//   ② 真实二进制结构解析：魔术字节嗅探 → ID3v2 头（syncsafe 长度域）/ PE 头（e_lfanew 定位）
//   ③ 分块可逆变换的**往返一致性**：变换后能逐字节还原 ⇒ 字节操作没有错位/丢字节
//   ④ 吞吐：处理 N MB 要多久，判断"大文件是否写得动"
//
// 样本自动挑选（原文件**只读**，变换结果写临时副本，结束即删）。
import "Web" as web
import strings
import files
import dirs
import times
import maths

// ---- ① 位运算：整数拆装（大端/小端）+ 手写 hex ----
func be32(string s, int off): int {
    return (s.byte(off) << 24) | (s.byte(off + 1) << 16) | (s.byte(off + 2) << 8) | s.byte(off + 3)
}

func le32(string s, int off): int {
    return s.byte(off) | (s.byte(off + 1) << 8) | (s.byte(off + 2) << 16) | (s.byte(off + 3) << 24)
}

func rol8(int b, int n): int {
    return ((b << n) | (b >> (8 - n))) & 255
}

// 手写 hex（顺便再演示一次位运算：取高低半字节 → 查表 → 转字符）
func hex2(int b): string {
    string digits = "0123456789abcdef"
    return strings.char(digits.byte((b >> 4) & 15)) + strings.char(digits.byte(b & 15))
}

func hexOf(int v): string {
    return "0x" + hex2((v >> 24) & 255) + hex2((v >> 16) & 255) + hex2((v >> 8) & 255) + hex2(v & 255)
}

// ---- ③ 可逆字节变换：XOR + 循环移位（正反必须严格互逆）----
func transformChunk(string data, int key): string {
    Array[int] out = []
    for strings.to_bytes(data) to b {
        int x = b ^ (key & 255)
        out.add(rol8(x, 3))
    }
    return strings.from_bytes(out)
}

func untransformChunk(string data, int key): string {
    Array[int] out = []
    for strings.to_bytes(data) to b {
        out.add(rol8(b, 5) ^ (key & 255))    // 左旋 3 的逆 = 左旋 5
    }
    return strings.from_bytes(out)
}

main() {
    string dir = dirs.script_dir() + _sep()
    string up = ".." + _sep()

    print("=== Leno 字节级处理能力验证 ===")
    print("")

    // ---- ① 位运算 ----
    print("① 位运算与位域拼装")
    int v = (0xC3 << 24) | (0x7F << 16) | (0x01 << 8) | 0x5A
    print("   拼装 0xC3 0x7F 0x01 0x5A => " +
          _str((v >> 24) & 255) + "." + _str((v >> 16) & 255) + "." +
          _str((v >> 8) & 255) + "." + _str(v & 255))
    string fake = strings.from_bytes([0xC3, 0x7F, 0x01, 0x5A])
    print("   大端 be32 = " + _str(be32(fake, 0)) + "（" + hexOf(be32(fake, 0)) + "）")
    print("   小端 le32 = " + _str(le32(fake, 0)) + "（" + hexOf(le32(fake, 0)) + "）")
    print("   rol8(0x81, 3) = " + _str(rol8(0x81, 3)) +
          "，再 rol8(..., 5) 回到 " + _str(rol8(rol8(0x81, 3), 5)) + " ⇒ 循环移位可逆")

    // ---- 挑样本 ----
    Array[string] cands = []
    cands.add(dir + up + up + up + up + "leno.exe")
    cands.add(dir + up + up + up + up + "leno_vm.exe")
    cands.add(dir + "audius_gWd2p.mp3")
    string src = ""
    for cands to c {
        if src == "" and files.exists(c) { src = c }
    }
    if src == "" { print(""); print("  跳过②③④：找不到样本文件"); return }
    string data = files.read(src)
    int n = data.byte_len()
    print("")
    print("   样本：" + src)
    print("   大小：" + strings.fmt_size(n) + "（" + _str(n) + " 字节）")

    // ---- ② 真实结构解析：魔术字节嗅探 ----
    print("")
    print("② 二进制结构解析（魔术字节嗅探 → 按格式解析）")
    if n >= 10 and strings.byte_slice(data, 0, 2) == "ID3" {
        int verMajor = data.byte(3)
        int flags = data.byte(5)
        // syncsafe：每字节只用低 7 位（ID3v2 规范里最容易写错的地方）
        int tagSize = ((data.byte(6) & 0x7F) << 21) | ((data.byte(7) & 0x7F) << 14) |
                      ((data.byte(8) & 0x7F) << 7) | (data.byte(9) & 0x7F)
        print("   识别为 ID3v2 音频：版本 2." + _str(verMajor) +
              "｜flags = " + hex2(flags) + "｜标签大小 = " + _str(tagSize) + " 字节")
    } else if n >= 64 and strings.byte_slice(data, 0, 1) == "MZ" {
        // DOS 头偏移 0x3C 处 4 字节小端 = PE 头偏移
        int peOff = le32(data, 0x3C)
        string sig = strings.byte_slice(data, peOff, (peOff + 4) - 1)
        int machine = data.byte(peOff + 4) | (data.byte(peOff + 5) << 8)
        int sections = data.byte(peOff + 6) | (data.byte(peOff + 7) << 8)
        string arch = "未知"
        if machine == 0x8664 { arch = "x86-64" }
        else if machine == 0x014C { arch = "x86" }
        else if machine == 0xAA64 { arch = "ARM64" }
        print("   识别为 PE 可执行文件：e_lfanew = " + _str(peOff) + "（" + hexOf(peOff) + "）")
        print("   PE 签名 = [" + sig + "]（应为 PE\\0\\0）｜Machine = " + hex2(machine >> 8) + hex2(machine & 255) +
              "（" + arch + "）｜节数 = " + _str(sections))
    } else {
        print("   未识别（前 4 字节 = " + hex2(data.byte(0)) + hex2(data.byte(1)) +
              hex2(data.byte(2)) + hex2(data.byte(3)) + "）")
    }

    // ---- ③ 分块可逆变换：往返一致 ----
    print("")
    print("③ 分块可逆变换（XOR + 循环移位）往返一致性")
    string encPath = dir + "_tmp_enc.bin"
    string decPath = dir + "_tmp_dec.bin"
    files.delete(encPath)
    files.delete(decPath)
    int CHUNK = 65536
    int total = 0
    int limit = 2 * 1024 * 1024      // 取前 2MB（够说明问题又不用等太久）
    int key = 0x5A

    int t0 = _int(times.ms())
    var fin = files.open(src, "rb")
    var fout = files.open(encPath, "ab")
    while total < limit {
        string chunk = fin.read(CHUNK)
        if chunk == null or chunk.byte_len() == 0 { break }
        fout.write(transformChunk(chunk, key))
        total = total + chunk.byte_len()
    }
    fin.close()
    fout.close()
    int msFwd = _int(times.ms()) - t0

    t0 = _int(times.ms())
    var f1 = files.open(encPath, "rb")
    var f2 = files.open(decPath, "ab")
    while true {
        string chunk = f1.read(CHUNK)
        if chunk == null or chunk.byte_len() == 0 { break }
        f2.write(untransformChunk(chunk, key))
    }
    f1.close()
    f2.close()
    int msBack = _int(times.ms()) - t0

    // 逐字节比对（前 total 字节）
    string back = files.read(decPath)
    bool same = strings.byte_slice(data, 0, total - 1) == strings.byte_slice(back, 0, total - 1)
    print("   处理 " + strings.fmt_size(total) + "：正向 " + _str(msFwd) + "ms，逆向 " + _str(msBack) + "ms")
    float secs = _float(msFwd + msBack) / 1000.0
    if secs > 0.0 {
        print("   吞吐 ≈ " + _str(maths.round((_float(total) / 1048576.0 / secs) * 100.0) / 100.0) + " MB/s（正向+逆向合计）")
    }
    print("   往返逐字节一致 = " + same + "（还原 " + _str(back.byte_len()) + " 字节）")

    files.delete(encPath)
    files.delete(decPath)
    print("")
    print("=== 结论：位运算 / 结构解析 / 分块变换 / 往返还原 均通过 ===")
}
