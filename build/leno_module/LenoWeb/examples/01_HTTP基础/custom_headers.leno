// custom_headers.leno — LenoWeb 自定义 header 示例
import "web_net" as net
use net.(HttpClient, Response)

main() {
    net.globalInit()

    HttpClient client = net.createClient()
    client.setTimeout(15000)

    // 设置多个自定义 header
    // ⚠ 请求头 API 分成两个"名字即语义"的方法（2026-10-07 更名，原名单一 setHeaders 太含糊）：
    //     · replaceHeaders([...]) —— **整表替换**（内部 = CURLOPT_HTTPHEADER，把已有头全换掉）
    //     · addHeaders([...])     —— **追加**（保留已设的头）
    //   历史坑：老名字 setHeaders 实际是替换语义，却听起来像"补充" ⇒ 有人分两次调用去补 Referer，
    //   Authorization / Content-Type / x-device-id 三个头被**静默覆盖** ⇒ 服务端回业务码 1001
    //   「not able to authenticate you」，**看起来完全像"token 过期"** ✗✗，差点误判（2026-09-18 实测）。
    //   ⇒ 要一次性给全就用 replaceHeaders（下面这样）；只想补一个头就用 addHeaders（见本文件下方）✓
    client.replaceHeaders([
        "Accept: application/json",
        "Accept-Language: zh-CN,zh;q=0.9,en;q=0.8",
        "Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9",
        "X-Request-ID: " + net.version(),
        "X-Custom: LenoNet-Test",
        "Referer: http://httpbin.org"
    ])

    // 设置 Cookie
    client.setCookie("session=abc123; user=admin")

    // 设置 User-Agent
    client.setUserAgent("Mozilla/5.0 (Windows NT 10.0; Win64; x64) LenoNet/1.0")

    // 追加一个头 —— 用 addHeaders。若这里改用 replaceHeaders，上面那 6 个会被整表冲掉 ✗
    client.addHeaders(["X-Trace: added-by-addHeaders"])
    print("当前请求头 " + client.headers().len() + " 条（replaceHeaders 6 条 + addHeaders 1 条）")

    print("=== 自定义 header 请求 ===")
    Response resp = client.get("http://httpbin.org/headers")
    if resp.ok() {
        print("状态码: " + resp.statusCode)
        print("服务器收到的 header:")
        print(resp.body)
    } else {
        print("失败: " + resp.error)
    }

    // 测试 HTTP 基本认证
    print("\n=== HTTP 基本认证 ===")
    client.reset()
    client.setCredentials("user", "passwd")
    Response resp2 = client.get("http://httpbin.org/basic-auth/user/passwd")
    if resp2.ok() {
        print("状态码: " + resp2.statusCode)
        print("认证成功!")
        print("响应: " + resp2.body[:200])
    } else {
        print("认证失败: " + resp2.error)
    }

    client.close()
}
