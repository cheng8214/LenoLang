// 泛型函数 re-export 回归断言测试
// 防止 map[T,U]/filter[T]/reduce[T,U]/forEach[T] 通过 export func 转发后回归
//   ★ 2026-11-15：`Ok[T]/Err[T]` 已从 web_generic / Web.leno 移除，改成独立模块 Result
//     （构造 `res.ok(v)` / `res.err(code, msg)`，判据 isOk/isErr，取值 orElse/errText）

import "web_generic" as gen
import "Web" as web
import "Result" as res
import "Containers" as ct     // ★ 2026-11-24：Stack 已从 web_generic 移到 LenoContainers

main()
{
    print("=== generic re-export regression ===")

    // ---------- 1. Result 构造 / 判据 / 取值 ----------
    var ok1 = res.ok[int](42)
    assert_eq(ok1.isOk(), true)
    assert_eq(ok1.orElse(0), 42)

    var err1 = res.err[int](500, "error msg")
    assert_eq(err1.isErr(), true)
    assert_eq(err1.orElse(-1), -1)
    assert_eq(err1.errText().has("error msg"), true)

    // ---------- 2. Result 经泛型函数转发（mapResult）----------
    var doubled = res.mapResult(res.ok[int](100), func(int x): int {
        return x * 2
    })
    assert_eq(doubled.orElse(0), 200)

    // ---------- 3. 不同 T ----------
    var okStr = res.ok[string]("hello")
    assert_eq(okStr.orElse(""), "hello")

    // ---------- 4. map 通过 Web.leno 转发 ----------
    var nums = [1, 2, 3, 4, 5]
    var squared = web.map[int, int](nums, func(int x): int {
        return x * x
    })
    assert_eq(squared[0], 1)
    assert_eq(squared[1], 4)
    assert_eq(squared[2], 9)
    assert_eq(squared[3], 16)
    assert_eq(squared[4], 25)

    // ---------- 5. filter 通过 Web.leno 转发 ----------
    var evens = web.filter[int](nums, func(int x): bool {
        return x % 2 == 0
    })
    assert_eq(evens.len(), 2)
    assert_eq(evens[0], 2)
    assert_eq(evens[1], 4)

    // ---------- 6. reduce 通过 Web.leno 转发 ----------
    var sum = web.reduce[int, int](nums, 0, func(int acc, int x): int {
        return acc + x
    })
    assert_eq(sum, 15)

    // ---------- 7. forEach 通过 Web.leno 转发 ----------
    var count = 0
    web.forEach[int](nums, func(int x) {
        count = count + 1
    })
    assert_eq(count, 5)

    // ---------- 8. map 字符串转换 ----------
    var words = ["hello", "world"]
    var upper = web.map[string, string](words, func(string s): string {
        return s.to_upper()
    })
    assert_eq(upper[0], "HELLO")
    assert_eq(upper[1], "WORLD")

    // ---------- 9. reduce 拼接字符串 ----------
    var parts = ["a", "b", "c"]
    var joined = web.reduce[string, string](parts, "", func(string acc, string x): string {
        return acc + x
    })
    assert_eq(joined, "abc")

    // ---------- 10. Stack 泛型（2026-11-24 起来自 LenoContainers） ----------
    var stack = new ct.Stack[int]()
    stack.push(10)
    stack.push(20)
    stack.push(30)
    assert_eq(stack.len(), 3)
    assert_eq(stack.peek(), 30)
    assert_eq(stack.pop(), 30)
    assert_eq(stack.pop(), 20)
    assert_eq(stack.is_empty(), false)
    assert_eq(stack.pop(), 10)
    assert_eq(stack.is_empty(), true)

    // ---------- 11. LinkedList 泛型 ----------
    var list = new gen.LinkedList[int]()
    list.init()
    list.append(10)
    list.append(20)
    list.append(30)
    list.prepend(5)
    assert_eq(list.length, 4)
    assert_eq(list.first(), 5)
    assert_eq(list.get(2), 20)
    assert_eq(list.contains(20), true)
    assert_eq(list.contains(99), false)
    assert_eq(list.shift(), 5)
    assert_eq(list.length, 3)

    print("")
    print("ALL ASSERTIONS PASSED")
}
