// _testkit.leno — LenoWeb 测试公共工具（断言 + **不依赖外网**的本机 HTTP 服务端）
//
// 为什么自建服务端：真实站点会变、会挂、会被墙，测试就没法当门禁用。
// 这里用 `sockets` 在**子线程**里跑一个阻塞式 HTTP/1.1 服务端（主线程当客户端连 127.0.0.1），
// 顺序确定、可离线、可重复。范式来自 `assert/test_sockets_io.leno`。
//
// 服务端路由（刻意覆盖爬虫最容易踩的编码场景）：
//   /gbk       声明 charset=gbk 的 GBK 正文
//   /gbk-nod   **不声明** charset 的 GBK 正文（只能靠"非合法 UTF-8 ⇒ 系统 ANSI 兜底"识别）
//   /utf8      声明 charset=utf-8 的 UTF-8 正文
//   /bin       image/png + 非法 UTF-8 字节（必须**原样保留**，一个字都不能被转码）
//   /echo/K    正文 = "BODY:K"（并发用例靠它自证"响应没串台"）
//   /post      回显完整请求（含 Content-Length 头），multipart 用例读它做断言
//   /quit      让服务端退出（正常收尾，便于 join）
//
// sitemap 路由（索引递归 / .gz / 跨站 / 去重 用例）：
//   /sitemap.xml         单层 urlset（2 条，第 1 条带 lastmod/changefreq/priority）
//   /sitemap-index.xml   索引：2 个站内子 sitemap + 1 个**重复**项 + 1 个**跨站**项
//   /sitemap-a.xml       urlset：a1、a2
//   /sitemap-b.xml       urlset：a2（与 a 重复）、b2
//   /sitemap-nested.xml  索引 → 另一个索引 → /sitemap-b.xml（测多层下钻）
//   /sitemap.gz          gzip 魔数正文（测"解压不了"的降级路径）
//
// 代理：请求行是**绝对 URI**（`GET http://host/path HTTP/1.1`）时回 `PROXIED:<uri>`
//   ⇒ 目标主机可以是不存在的域名，能收到响应就证明请求确实过了代理
import sockets
import threads
import strings

export int passed = 0
export int failed = 0

// 服务端自己的端口（sitemap 路由里要拼成绝对 URL）
int _srvPort = 0

// ==================== 断言 ====================

export func check(string name, any got, any want) {
    if _str(got) == _str(want) {
        passed = passed + 1
    } else {
        failed = failed + 1
        print("  [FAIL] " + name)
        print("         got  = [" + _str(got) + "]")
        print("         want = [" + _str(want) + "]")
    }
}

export func checkTrue(string name, bool cond) {
    if cond {
        passed = passed + 1
    } else {
        failed = failed + 1
        print("  [FAIL] " + name + "（期望 true）")
    }
}

export func checkHas(string name, string haystack, string needle) {
    if strings.has(haystack, needle) {
        passed = passed + 1
    } else {
        failed = failed + 1
        print("  [FAIL] " + name)
        print("         未包含 [" + needle + "]")
        print("         实际   [" + _cut(haystack, 400) + "]")
    }
}

export func checkNotHas(string name, string haystack, string needle) {
    if strings.has(haystack, needle) {
        failed = failed + 1
        print("  [FAIL] " + name + "（不应包含 [" + needle + "]）")
    } else {
        passed = passed + 1
    }
}

export func summary(string suite): int {
    print("[" + suite + "] 通过 " + passed + " / 失败 " + failed)
    if failed > 0 { return 1 }
    return 0
}

func _cut(string s, int maxBytes): string {
    if s.byte_len() <= maxBytes { return s }
    return s.byte_slice(0, maxBytes) + "..."
}

// ==================== 本机 HTTP 服务端 ====================

// 服务端主循环（在子线程里跑）。maxRequests 只是防跑飞的上限，正常靠 /quit 收尾。
export func serve(int port, int maxRequests) {
    _srvPort = port
    var srv = sockets.listen("127.0.0.1", port)
    if srv == null { return }
    int n = 0
    while n < maxRequests {
        var cli = srv.accept()
        if cli == null { break }
        cli.set_timeout(3000)
        string req = _readRequest(cli)
        string path = _requestPath(req)
        cli.send(_route(path, req))
        cli.close()
        n = n + 1
        if path == "/quit" { break }
    }
    srv.close()
}

// 服务端就绪检测：反复 connect（成功即说明 listener 已起），连上立刻关掉。
// 这种"空探针"会被服务端当成一次 404 请求（读不到数据就快速返回），不影响后续用例。
export func waitUp(int port): bool {
    // 60 → 120（6s）：机器繁忙（杀毒扫描 / 满负载跑整套用例）时子线程 listen 可能要等更久，
    // 实测曾在整套快速连跑时偶发一次"服务端未起来"（单独跑与重跑均通过）。
    int tries = 0
    while tries < 120 {
        var probe = sockets.connect("127.0.0.1", port)
        if probe != null {
            probe.close()
            return true
        }
        threads.sleep(50)
        tries = tries + 1
    }
    return false
}

// 通知服务端退出
export func shutdown(int port) {
    var c = sockets.connect("127.0.0.1", port)
    if c != null {
        c.send("GET /quit HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n")
        c.recv(1024)
        c.close()
    }
}

// ---------- 请求解析 ----------

func _b(string s, int i): int {
    var v = s.byte(i)
    if v is int { return v }
    return -1
}

func _readRequest(Socket cli): string {
    string req = ""
    int guard = 0
    // ① 先读到请求头结束
    while guard < 500 {
        if strings.has(req, "\r\n\r\n") { break }
        string chunk = cli.recv(65536)
        if chunk == null or chunk == "" { break }
        req = req + chunk
        guard = guard + 1
    }
    // ② 若声明了 Content-Length，继续读到 body 完整（multipart 必须收全）
    int clen = _contentLength(req)
    if clen > 0 {
        int headEnd = strings.byte_find(req, "\r\n\r\n")
        if headEnd >= 0 {
            int have = req.byte_len() - (headEnd + 4)
            guard = 0
            while have < clen and guard < 2000 {
                string chunk = cli.recv(65536)
                if chunk == null or chunk == "" { break }
                req = req + chunk
                have = req.byte_len() - (headEnd + 4)
                guard = guard + 1
            }
        }
    }
    return req
}

func _contentLength(string req): int {
    int headEnd = strings.byte_find(req, "\r\n\r\n")
    if headEnd < 0 { return 0 }
    int p = strings.byte_find(req, "Content-Length:")
    if p < 0 or p > headEnd { p = strings.byte_find(req, "content-length:") }
    if p < 0 or p > headEnd { return 0 }
    int i = p + 15
    while i < headEnd {
        int b = _b(req, i)
        if b != 32 and b != 9 { break }
        i = i + 1
    }
    Array[int] digits = []
    while i < headEnd {
        int b = _b(req, i)
        if b < 48 or b > 57 { break }
        digits.add(b)
        i = i + 1
    }
    if digits.len() == 0 { return 0 }
    return _int(strings.from_bytes(digits))
}

// 请求行形如 "POST /path HTTP/1.1" ⇒ 取中间那段
func _requestPath(string req): string {
    int sp1 = strings.byte_find(req, " ")
    if sp1 < 0 { return "/" }
    int sp2 = strings.byte_find(req, " ", sp1 + 1)
    if sp2 < 0 { return "/" }
    return req.byte_slice(sp1 + 1, sp2)
}

// ---------- 路由 ----------

export func gbkBody(): string {
    // "中文测试" 的 GBK 字节
    return strings.from_bytes([0xD6, 0xD0, 0xCE, 0xC4, 0xB2, 0xE2, 0xCA, 0xD4])
}

export func gbkBodyShort(): string {
    // "中文" 的 GBK 字节
    return strings.from_bytes([0xD6, 0xD0, 0xCE, 0xC4])
}

// ---------- 大文件 / Range（续传用例）----------

// 确定性的 n 字节正文：第 i 个字节 = '0' + (i % 10)
// ⇒ 客户端可以逐字节校验"续传拼起来的文件"是否正确（不是只看长度）
export func fileBody(int n): string {
    Array[int] b = []
    for n to i { b.add(48 + (i % 10)) }
    return strings.from_bytes(b)
}

// 校验一段内容是否是 fileBody 的第 [fromIdx, toIdx) 段
export func fileBodyOk(string got, int fromIdx, int toIdx): bool {
    if got.byte_len() != toIdx - fromIdx { return false }
    for got.byte_len() to k {
        var b = got.byte(k)
        if b is int {
            if b != 48 + ((fromIdx + k) % 10) { return false }
        }
    }
    return true
}

// 从路径尾段取数字（"/file/1234" ⇒ 1234）；取不到返回 -1
func _pathSize(string path): int {
    int n = path.byte_len()
    int last = -1
    int i = 0
    while i < n {
        if _b(path, i) == 47 { last = i }
        i = i + 1
    }
    if last < 0 { return -1 }
    int v = 0
    bool seenDigit = false
    i = last + 1
    while i < n {
        int b = _b(path, i)
        if b < 48 or b > 57 { break }
        v = v * 10 + (b - 48)
        seenDigit = true
        i = i + 1
    }
    if not seenDigit { return -1 }
    return v
}

// 解析 `Range: bytes=N-` 的起始偏移；没有 Range 头返回 -1
func _rangeStart(string req): int {
    int p = strings.byte_find(req, "Range: bytes=")
    if p < 0 { p = strings.byte_find(req, "range: bytes=") }
    if p < 0 { return -1 }
    int i = p + 13
    int headEnd = strings.byte_find(req, "\r\n\r\n")
    int v = 0
    bool seenDigit = false
    while i < headEnd {
        int b = _b(req, i)
        if b < 48 or b > 57 { break }
        v = v * 10 + (b - 48)
        seenDigit = true
        i = i + 1
    }
    if not seenDigit { return -1 }
    return v
}

// 大文件路由：supportRange=false 时**故意忽略** Range（用来验证客户端的回退路径）
func _routeFile(string path, string req, bool supportRange): string {
    int n = _pathSize(path)
    if n < 0 { n = 1000 }
    string full = fileBody(n)
    if supportRange {
        int start = _rangeStart(req)
        if start > 0 {
            if start >= full.byte_len() {
                return _respExt(416, "text/plain", "", "Content-Range: bytes */" + n + "\r\n")
            }
            string part = full.byte_slice(start, full.byte_len())
            return _respExt(206, "application/octet-stream", part,
                            "Content-Range: bytes " + start + "-" + (n - 1) + "/" + n + "\r\n")
        }
    }
    return _resp(200, "application/octet-stream", full)
}

// ---------- sitemap 路由 ----------

func _base(): string {
    return "http://127.0.0.1:" + _srvPort
}

func _sitemapXml(): string {
    return "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n" +
           "<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n" +
           "  <url><loc>http://site.test/a</loc><lastmod>2026-10-01</lastmod>" +
           "<changefreq>daily</changefreq><priority>0.8</priority></url>\n" +
           "  <url><loc>http://site.test/b</loc></url>\n" +
           "</urlset>"
}

func _sitemapA(): string {
    return "<urlset><url><loc>http://site.test/a1</loc></url>" +
           "<url><loc>http://site.test/a2</loc></url></urlset>"
}

func _sitemapB(): string {
    return "<urlset><url><loc>http://site.test/a2</loc></url>" +
           "<url><loc>http://site.test/b2</loc></url></urlset>"
}

// 2 个站内 + 1 个重复 + 1 个跨站（跨站必须被忽略）
func _sitemapIndex(): string {
    return "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n" +
           "<sitemapindex xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n" +
           "  <sitemap><loc>" + _base() + "/sitemap-a.xml</loc><lastmod>2026-10-01</lastmod></sitemap>\n" +
           "  <sitemap><loc>" + _base() + "/sitemap-b.xml</loc></sitemap>\n" +
           "  <sitemap><loc>" + _base() + "/sitemap-a.xml</loc></sitemap>\n" +
           "  <sitemap><loc>http://evil.test/sitemap.xml</loc></sitemap>\n" +
           "</sitemapindex>"
}

func _sitemapNested(): string {
    return "<sitemapindex><sitemap><loc>" + _base() + "/sitemap-index2.xml</loc></sitemap></sitemapindex>"
}

func _sitemapIndex2(): string {
    return "<sitemapindex><sitemap><loc>" + _base() + "/sitemap-b.xml</loc></sitemap></sitemapindex>"
}

func _route(string path, string req): string {
    // 代理模式：请求行是绝对 URI ⇒ 回显它（目标主机可以不存在，收到响应即证明走了代理）
    if strings.has(path, "http://") or strings.has(path, "https://") {
        return _resp(200, "text/plain; charset=utf-8", "PROXIED:" + path)
    }
    if path == "/sitemap.xml" {
        return _resp(200, "application/xml", _sitemapXml())
    }
    if path == "/sitemap-index.xml" {
        return _resp(200, "application/xml", _sitemapIndex())
    }
    if path == "/sitemap-nested.xml" {
        return _resp(200, "application/xml", _sitemapNested())
    }
    if path == "/sitemap-index2.xml" {
        return _resp(200, "application/xml", _sitemapIndex2())
    }
    if path == "/sitemap-a.xml" {
        return _resp(200, "application/xml", _sitemapA())
    }
    if path == "/sitemap-b.xml" {
        return _resp(200, "application/xml", _sitemapB())
    }
    if path == "/sitemap.gz" {
        // gzip 魔数 + 垃圾字节：客户端必须识别出"这是压缩体"并降级，而不是当 XML 解析
        return _resp(200, "application/x-gzip", strings.from_bytes([0x1F, 0x8B, 0x08, 0x00, 0x00, 0x00, 0x00, 0x00]))
    }
    if path == "/gbk" {
        return _resp(200, "text/html; charset=gbk", gbkBody())
    }
    if strings.has(path, "/file-norange/") {
        return _routeFile(path, req, false)
    }
    if strings.has(path, "/file/") {
        return _routeFile(path, req, true)
    }
    if path == "/gbk-nod" {
        return _resp(200, "text/html", gbkBodyShort())
    }
    if path == "/utf8" {
        return _resp(200, "text/html; charset=utf-8", "中文内容")
    }
    if path == "/bin" {
        // PNG magic + 非法 UTF-8 字节：任何字符集转码都不得动它
        return _resp(200, "image/png", strings.from_bytes([0x89, 0x50, 0x4E, 0x47, 0xD6, 0xD0, 0xFF, 0x0D]))
    }
    if strings.has(path, "/slow/") {
        // 延迟响应：用来把"并发"做成**可测的** ——
        //   N 个独立服务端（每个单线程只服务一条连接）+ 每台延迟 ms ⇒
        //   并发批抓总耗时 ≈ ms，串行 ≈ N×ms。单服务端做不到这点（它一次只处理一条连接）。
        int ms = _pathSize(path)
        if ms > 0 { sleep(ms) }
        return _resp(200, "text/plain; charset=utf-8", "SLOW:" + ms)
    }
    if strings.has(path, "/echo/") {
        string token = path.byte_slice(6, path.byte_len())
        return _resp(200, "text/plain; charset=utf-8", "BODY:" + token)
    }
    if path == "/post" {
        return _resp(200, "text/plain; charset=utf-8", "REQ:" + req)
    }
    if path == "/quit" {
        return _resp(200, "text/plain", "bye")
    }
    return _resp(404, "text/plain", "not found")
}

func _reason(int code): string {
    if code == 200 { return "OK" }
    if code == 206 { return "Partial Content" }
    if code == 404 { return "Not Found" }
    if code == 416 { return "Range Not Satisfiable" }
    return "OK"
}

func _resp(int code, string ctype, string body): string {
    return _respExt(code, ctype, body, "")
}

// 可插额外响应头（Content-Range 等）
func _respExt(int code, string ctype, string body, string extra): string {
    return "HTTP/1.1 " + code + " " + _reason(code) + "\r\n" +
           "Content-Type: " + ctype + "\r\n" +
           extra +
           "Content-Length: " + body.byte_len() + "\r\n" +
           "Connection: close\r\n\r\n" + body
}
