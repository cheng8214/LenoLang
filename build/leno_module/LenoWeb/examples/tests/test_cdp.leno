// test_cdp.leno — 动态渲染：CDP 驱动真实浏览器（Chrome/Edge），端到端
//
// ⚠ 这个用例**需要本机装有 Chrome/Edge**。找不到浏览器时**跳过**（退出码仍是 0），
//   这样在没装浏览器的机器/CI 上不会把整条门禁搞红 —— 但跳过会明确打印原因。
//
// 覆盖：
//   ① WS 基础件（SHA-1 RFC 向量 / Base64 / ws:// 解析）—— 纯离线，任何机器都跑
//   ② 浏览器发现（LENO_BROWSER → Edge → Chrome → 常见路径）
//   ③ 静态抓取 vs 动态渲染的对照（同一页面，脚本生成的内容只有渲染后才有）
//   ④ 启动（headless + 独立 user-data-dir + 自选端口 + 取版本/进程号）
//   ⑤ CDP 往返（Browser.getVersion）+ 未知方法的错误上报
//   ⑥ 渲染 → 结果直接喂现有 HTML 解析器
//   ⑦ 同一浏览器复用渲染第二个页面
//   ⑧ 关闭：走协议 Browser.close，端口释放
import "Web" as web
import "web_cdp" as cdp
import "web_ws" as ws
import "_testkit" as tk
import threads
import strings
import sockets
import files
import times
import dirs

use cdp.(Browser, BrowserConfig, CdpClient, RenderResult, RenderOptions)
use ws.(WsUrl, WsClient)

int PORT = 39621
int MAXREQ = 64

// ⚠ threads.start 的入口必须是**本文件**的函数
func serverEntry(int port, int maxReqs) { tk.serve(port, maxReqs) }

// 从 /detect 页面里抠出 #out 的文本（诊断打印用；失败返回 ""）
func _detectLine(string html): string {
    string open = "<div id=\"out\">"     // 长度 14
    int i = strings.byte_find(html, open, 0)
    if i < 0 { return "" }
    int s = i + 14
    int e = strings.byte_find(html, "</div>", s)
    if e < 0 { return "" }
    return strings.byte_slice(html, s, e)
}

main() {
    print("--- ① WS 基础件（纯离线）---")
    tk.check("sha1('')", ws.sha1Hex(""), "da39a3ee5e6b4b0d3255bfef95601890afd80709")
    tk.check("sha1('abc')", ws.sha1Hex("abc"), "a9993e364706816aba3e25717850c26c9cd0d89d")
    tk.check("sha1(56 字符)", ws.sha1Hex("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"),
             "84983e441c3bd26ebaae4aa1f95129e5e54670f1")
    tk.check("base64('abc')", ws.base64(strings.to_bytes("abc")), "YWJj")
    tk.check("base64('ab') 带补位", ws.base64(strings.to_bytes("ab")), "YWI=")
    tk.check("base64('a') 带补位", ws.base64(strings.to_bytes("a")), "YQ==")

    WsUrl u = ws.parseWsUrl("ws://127.0.0.1:9222/devtools/page/ABC")
    tk.check("parseWsUrl: ok", u.ok, true)
    tk.check("parseWsUrl: host", u.host, "127.0.0.1")
    tk.check("parseWsUrl: port（不能丢）", u.port, 9222)
    tk.check("parseWsUrl: path", u.path, "/devtools/page/ABC")
    WsUrl u2 = ws.parseWsUrl("wss://example.com/x")
    tk.check("wss 明确报错（不静默）", u2.ok, false)
    tk.checkTrue("wss 错误信息非空", u2.error != "")

    WsClient bad = ws.connect("ws://127.0.0.1:1/nope", 1000)
    tk.check("连不上时 ok=false", bad.ok, false)
    tk.checkTrue("连不上时给出原因", bad.error != "")

    print("--- ② 浏览器发现 ---")
    string shotPath = _env("TEMP") + _sep() + "leno_cdp_shot.png"
    string exe = cdp.findBrowser()
    if exe == "" {
        print("本机未找到 Chrome/Edge ⇒ 跳过动态渲染部分（不算失败；可用 LENO_BROWSER 指定路径）")
        if tk.summary("cdp") != 0 { _exit(1) }
        return
    }
    print("浏览器 = " + exe)

    print("--- ③ 起本机服务端 + 静态抓取对照 ---")
    var srv = threads.start(serverEntry, PORT, MAXREQ)
    if not tk.waitUp(PORT) {
        print("本机服务端未起来，终止")
        _exit(1)
    }
    string url = "http://127.0.0.1:" + PORT + "/js"
    var st = web.get(url)
    tk.checkTrue("静态抓取拿到了 HTML", st.ok())
    // 页面里的内容由脚本在 60ms 后写入（脚本源码里是把字符串拆开拼的）
    tk.check("静态抓取**不含**脚本生成的内容", strings.has(st.body, "SPA-CONTENT"), false)

    print("--- ④ 启动 headless 浏览器 ---")
    BrowserConfig cfg = new BrowserConfig()
    cfg.startUrl = "about:blank"
    Browser b = cdp.launch(cfg)
    tk.checkTrue("启动成功", b.ok)
    if not b.ok {
        print("启动失败：" + b.error)
        tk.shutdown(PORT)
        _exit(1)
    }
    tk.check("端口是自选的", b.port > 0, true)
    tk.checkTrue("拿到版本号", strings.has(b.version, "/"))
    tk.checkTrue("拿到浏览器级 WS 地址", strings.has(b.wsUrl, "ws://"))
    tk.checkTrue("user-data-dir 是独立临时目录", strings.has(b.userDataDir, "leno-cdp-"))
    tk.checkTrue("拿得到页面级 WS 地址", strings.has(cdp.pageWsUrl(b), "/devtools/page/"))
    tk.checkTrue("取到了浏览器进程号", b.pid > 0)

    print("--- ⑤ CDP 往返 ---")
    CdpClient cc = cdp.cdpConnect(b.wsUrl, 8000)
    tk.checkTrue("浏览器级连接成功", cc.ok)
    if cc.ok {
        string ver = cdp.cdpCall(cc, "Browser.getVersion", "")
        tk.checkTrue("getVersion 返回 JSON（含 product）", strings.has(ver, "product"))
        string bogus = cdp.cdpCall(cc, "LenoNoSuch.method", "")
        tk.check("未知方法返回空", bogus, "")
        tk.checkTrue("未知方法有可读错误", cc.error != "")
        cdp.cdpClose(cc)
    }

    print("--- ⑥ 渲染（页面脚本 60ms 后才写内容）---")
    RenderResult r = cdp.renderWith(b, url, 8000, 500)
    tk.checkTrue("渲染成功", r.ok)
    tk.check("标题（来自 <title>）", r.title, "JS Page")
    tk.checkTrue("渲染后的 HTML 含脚本生成的内容", strings.has(r.html, "SPA-CONTENT"))
    tk.checkTrue("耗时在合理范围（<10s）", r.ms < 10000)

    print("--- ⑦ 渲染结果直接喂现有解析器 ---")
    var node = web.parse(r.html)
    var sel = web.select(node, "#app")
    tk.check("#app 命中个数", sel.len(), 1)
    if sel.len() > 0 {
        tk.check("#app 文本", web.allText(sel[0]).trim(), "SPA-CONTENT")
    }

    print("--- ⑧ 同一浏览器复用（第二个页面）---")
    RenderResult r2 = cdp.renderWith(b, "http://127.0.0.1:" + PORT + "/utf8", 8000, 300)
    tk.checkTrue("复用后再渲染一次也成功", r2.ok)

    print("--- ⑨ 等待策略：只等 load 会取早，networkidle 才拿得到 AJAX 结果 ---")
    string ajaxUrl = "http://127.0.0.1:" + PORT + "/ajax"
    RenderOptions optLoad = new RenderOptions()
    optLoad.waitUntil = "load"
    optLoad.settleMs = 0
    optLoad.timeoutMs = 8000
    RenderResult rLoad = cdp.renderAdvanced(b, ajaxUrl, optLoad)
    tk.checkTrue("load 模式渲染成功", rLoad.ok)
    // 页面脚本 400ms 后才写内容 ⇒ 只等 load 必然取早
    tk.check("load 模式拿不到 AJAX 写入", strings.has(rLoad.html, "AJAX-DONE"), false)

    RenderOptions optIdle = new RenderOptions()
    optIdle.waitUntil = "networkidle"
    optIdle.networkIdleMs = 500
    optIdle.settleMs = 200
    optIdle.timeoutMs = 15000
    RenderResult rIdle = cdp.renderAdvanced(b, ajaxUrl, optIdle)
    tk.checkTrue("networkidle 渲染成功", rIdle.ok)
    tk.checkTrue("networkidle 等到了 AJAX 写入的内容", strings.has(rIdle.html, "AJAX-DONE"))

    print("--- ⑩ 等选择器 / 点击 / 滚动 / 截图 ---")
    CdpClient c2 = cdp.cdpConnect(cdp.pageWsUrl(b), 8000)
    tk.checkTrue("页面级连接成功", c2.ok)
    if c2.ok {
        tk.checkTrue("waitForSelector(#app) 命中", cdp.waitForSelector(c2, "#app", 5000))
        tk.checkTrue("waitForSelector(不存在) 超时返回 false", not cdp.waitForSelector(c2, "#no-such-thing", 800))
        cdp.cdpClose(c2)
    }

    RenderOptions optClick = new RenderOptions()
    optClick.waitUntil = "load"
    optClick.settleMs = 100
    optClick.clickSelector = "#btn"
    optClick.screenshotPath = shotPath
    optClick.timeoutMs = 8000
    RenderResult rClick = cdp.renderAdvanced(b, "http://127.0.0.1:" + PORT + "/click", optClick)
    tk.checkTrue("点击模式渲染成功", rClick.ok)
    tk.checkTrue("点击真的生效（内容出现）", strings.has(rClick.html, "CLICK-DONE"))
    tk.checkTrue("截图文件已生成", files.exists(shotPath))
    if files.exists(shotPath) {
        string png = files.read(shotPath)
        tk.checkTrue("截图有内容（>100 字节）", png.byte_len() > 100)
        tk.check("PNG 魔数首字节", png.byte(0), 137)
        files.delete(shotPath)
    }

    RenderOptions optLazy = new RenderOptions()
    optLazy.waitUntil = "load"
    optLazy.settleMs = 100
    optLazy.scrollTimes = 2
    optLazy.timeoutMs = 8000
    RenderResult rLazy = cdp.renderAdvanced(b, "http://127.0.0.1:" + PORT + "/lazy", optLazy)
    tk.checkTrue("滚动模式渲染成功", rLazy.ok)
    tk.checkTrue("滚动触发了懒加载", strings.has(rLazy.html, "LAZY-DONE"))

    print("--- ⑫ 关闭：走协议 + 端口释放 ---")
    bool closed = cdp.close(b)
    tk.checkTrue("Browser.close 成功", closed)
    var probe = sockets.connect("127.0.0.1", b.port)
    tk.checkTrue("端口已释放", probe == null)
    if probe != null { probe.close() }
    // 临时 profile 目录必须一起删掉（不删的话长跑会堆出上百个目录，每个几十 MB）
    threads.sleep(500)
    tk.checkTrue("临时 profile 目录已清理", not dirs.exists(b.userDataDir))

    // ⚠ ⑬（Web 统一入口转发）原先**单独起一个浏览器**来测。为省资源，已并入 ⑭ 的
    //   stealth 实例（bs）复用同一个浏览器 —— 见下面 ⑭ 段内的 ⑬ 小节。
    //   一个浏览器实例是多进程、几百 MB，能省一次就省一次。
    print("--- ⑭ 反检测：默认带着无头特征，开 stealth 后抹掉 ---")
    // 对照组：默认配置（不注入、不改 UA）
    BrowserConfig cfgPlain = new BrowserConfig()
    cfgPlain.startUrl = "about:blank"
    Browser bp = cdp.launch(cfgPlain)
    tk.checkTrue("对照组浏览器启动", bp.ok)
    string plainDetect = ""      // 对照组结果（后面要拿它判断"哪些检查项本身有判别力"）
    if bp.ok {
        RenderOptions od = new RenderOptions()
        od.waitUntil = "load"
        od.settleMs = 100
        od.timeoutMs = 8000
        RenderResult dOff = cdp.renderAdvanced(bp, "http://127.0.0.1:" + PORT + "/detect", od)
        tk.checkTrue("对照组渲染成功", dOff.ok)
        plainDetect = _detectLine(dOff.html)
        print("  对照组探测结果: " + plainDetect)
        tk.checkTrue("默认 UA 暴露 HeadlessChrome", strings.has(dOff.html, "ua=HEADLESS"))
        cdp.close(bp)
    }

    // stealth 组：--disable-blink-features=AutomationControlled + UA/语言覆盖 + 注入脚本
    BrowserConfig cfgSt = new BrowserConfig()
    cfgSt.startUrl = "about:blank"
    cfgSt.stealth = true
    Browser bs = cdp.launch(cfgSt)
    tk.checkTrue("stealth 浏览器启动", bs.ok)
    if bs.ok {
        RenderOptions os = new RenderOptions()
        os.waitUntil = "load"
        os.settleMs = 200
        os.timeoutMs = 8000
        RenderResult dOn = cdp.renderAdvanced(bs, "http://127.0.0.1:" + PORT + "/detect", os)
        tk.checkTrue("stealth 渲染成功", dOn.ok)
        print("  stealth 探测结果: " + _detectLine(dOn.html))
        tk.checkTrue("UA 已抹掉 Headless 字样", strings.has(dOn.html, "ua=clean"))
        // ⚠ 现代 headless 的 navigator.webdriver 默认就是 **false**（不是 true），
        //   站点判据是 `if (navigator.webdriver)` ⇒ 断"不是 true"才有意义
        tk.check("webdriver 不为 true", strings.has(dOn.html, "wd=true"), false)
        tk.checkTrue("语言已按配置覆盖", strings.has(dOn.html, "lang=zh-CN"))
        // WebGL 渲染器：只有对照组**真拿到了渲染器串**（不是 err/nodbg）时才校验
        // （拿不到就无法证明有判别力，硬断言只会变成"看环境脸色"的假失败）
        if not strings.has(plainDetect, "gl=err") and not strings.has(plainDetect, "gl=nodbg") and plainDetect != "" {
            tk.checkTrue("无头软件渲染器已被换掉", strings.has(dOn.html, "gl=intel"))
        }

        // ⑬ Web 统一入口的转发：**复用这个 stealth 实例**（不再单独起一个浏览器）
        print("--- ⑬ Web 统一入口的转发（整条闭环走公开 API）---")
        tk.check("web.findBrowser 转发", web.findBrowser(), exe)
        RenderResult r3 = web.renderWith(bs, url, 8000, 500)
        tk.checkTrue("web.renderWith 转发可用", r3.ok)
        tk.checkTrue("web.renderWith 拿到渲染后内容", strings.has(r3.html, "SPA-CONTENT"))

        print("--- ⑮ 真事件：JS 点击 vs isTrusted 点击 / 真输入 ---")
        RenderOptions oJs = new RenderOptions()
        oJs.waitUntil = "load"
        oJs.settleMs = 100
        oJs.clickSelector = "#btn"
        oJs.timeoutMs = 8000
        RenderResult jsClick = cdp.renderAdvanced(bs, "http://127.0.0.1:" + PORT + "/trust", oJs)
        tk.checkTrue("JS 点击渲染成功", jsClick.ok)
        tk.check("JS 点击被识破（isTrusted=false）", strings.has(jsClick.html, "UNTRUSTED-CLICK"), true)

        RenderOptions oReal = new RenderOptions()
        oReal.waitUntil = "load"
        oReal.settleMs = 100
        oReal.realClickSelector = "#btn"
        oReal.timeoutMs = 8000
        RenderResult realClick = cdp.renderAdvanced(bs, "http://127.0.0.1:" + PORT + "/trust", oReal)
        tk.checkTrue("真事件点击渲染成功", realClick.ok)
        tk.checkTrue("真事件点击通过 isTrusted 检查", strings.has(realClick.html, "TRUSTED-CLICK"))

        RenderOptions oType = new RenderOptions()
        oType.waitUntil = "load"
        oType.settleMs = 100
        oType.typeSelector = "#q"
        oType.typeValue = "hello"
        oType.timeoutMs = 8000
        RenderResult typed = cdp.renderAdvanced(bs, "http://127.0.0.1:" + PORT + "/type", oType)
        tk.checkTrue("输入渲染成功", typed.ok)
        tk.checkTrue("真事件输入触发了 input 事件", strings.has(typed.html, "TYPED-hello"))

        // 回归护栏：反检测脚本是**手工拼的 JS**，括号写错只会静默失效
        //   （`addScriptToEvaluateOnNewDocument` 连报错都不报）⇒ 必须自检语法
        CdpClient cdbg = cdp.cdpConnect(cdp.pageWsUrl(bs), 8000)
        if cdbg.ok {
            tk.check("反检测脚本语法自检", cdp.stealthSelfTest(cdbg), "ok")
            // 注入是否**真的落到当前文档**上（原型被改过）
            string patched = cdp.evaluate(cdbg, "String(WebGLRenderingContext.prototype.getParameter).indexOf('Intel')>=0?'y':'n'")
            tk.check("注入已落到当前文档（WebGL 原型被改）", patched, "y")
            cdp.cdpClose(cdbg)
        }

        // 顺带把 web.closeBrowser 的转发也测了（关掉这个 stealth 实例）
        tk.checkTrue("web.closeBrowser 转发可用", web.closeBrowser(bs))
    }

    print("--- ⑯ 浏览器走代理（--proxy-server）---")
    // 本机服务端充当代理：收到**绝对 URI** 请求行就回 "PROXIED:<uri>"
    // 目标主机名故意用不存在的域名 ⇒ 能拿到内容就证明请求确实过了代理
    BrowserConfig cfgPx = new BrowserConfig()
    cfgPx.startUrl = "about:blank"
    cfgPx.proxy = "http://127.0.0.1:" + PORT
    Browser bpx = cdp.launch(cfgPx)
    tk.checkTrue("带代理启动浏览器", bpx.ok)
    if bpx.ok {
        RenderOptions opx = new RenderOptions()
        opx.waitUntil = "load"
        opx.settleMs = 100
        opx.timeoutMs = 8000
        RenderResult proxied = cdp.renderAdvanced(bpx, "http://no-such-host.invalid/x", opx)
        tk.checkTrue("通过代理拿到了响应", strings.has(proxied.html, "PROXIED:"))
        tk.checkTrue("代理浏览器已关闭", cdp.close(bpx))
    }

    print("--- ⑰ 批量渲染（多 tab 轮转；单线程）---")
    // ⚠ 这里**不测多线程**：`threads.start` 的入口函数只能来自主脚本文件，
    //   库函数里起线程会让进程**直接崩溃**（实测）。并发模式见 README / 实战示例
    //   （调用方在自己文件里起线程 + `renderOn` 到各自的 tab）。
    BrowserConfig cfgMc = new BrowserConfig()
    cfgMc.startUrl = "about:blank"
    Browser bmc = cdp.launch(cfgMc)
    tk.checkTrue("批量用浏览器启动", bmc.ok)
    if bmc.ok {
        Array[string] urls = [
            "http://127.0.0.1:" + PORT + "/js",
            "http://127.0.0.1:" + PORT + "/click",
            "http://127.0.0.1:" + PORT + "/trust",
            "http://127.0.0.1:" + PORT + "/type"
        ]
        RenderOptions om = new RenderOptions()
        om.waitUntil = "load"
        om.settleMs = 500
        om.timeoutMs = 15000
        int tmc = _int(times.ms())
        Array[RenderResult] many = cdp.renderMany(bmc, urls, om, 3)
        int wall = _int(times.ms()) - tmc
        int okCount = 0
        for many.len() to i {
            if many[i].ok { okCount = okCount + 1 }
        }
        print("  4 个 URL / 3 个 tab 用时 = " + wall + "ms（成功 " + okCount + "）")
        tk.check("结果个数与输入一致", many.len(), 4)
        tk.check("顺序与输入一致", many[0].url, urls[0])
        tk.checkTrue("第 1 个（/js）拿到脚本生成的内容", many[0].ok and strings.has(many[0].html, "SPA-CONTENT"))
        tk.checkTrue("第 3 个（/trust）是初始态（没有 CLICK-DONE）", many[2].ok and not strings.has(many[2].html, "CLICK-DONE"))
        tk.check("全部成功", okCount, 4)

        // ⑱ 兜底清理：**复用刚才这个浏览器**（不再单独起一个）
        // 为什么单测这条：`Browser.close` 走不了时必须靠兜底 —— 而兜底一旦失效就会**漏进程**
        // （2026-10-07 之前兜底是"按端口 / 按命令行猜进程"，实测漏到过 45~55 个 msedge，
        //  漏了还不报错，只是机器越来越慢）。现在兜底 = `_kill(handle)`：
        // 与端口无关、与命令行无关，只认自己 spawn 的那棵树。
        print("--- ⑱ 兜底清理：协议不可用时按句柄收整棵树 ---")
        bmc.ok = false            // 模拟"协议关闭不可用"（close 会跳过 Browser.close）
        tk.checkTrue("close 仍能收干净（按句柄）", cdp.close(bmc))
        tk.check("句柄已归还", bmc.handle, 0)
        threads.sleep(500)
        var pk = sockets.connect("127.0.0.1", bmc.port)
        tk.checkTrue("端口已释放", pk == null)
        if pk != null { pk.close() }
    }

    tk.shutdown(PORT)
    if tk.summary("cdp") != 0 { _exit(1) }
}
