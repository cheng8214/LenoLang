// web_cdp.leno — 驱动真实浏览器（Chrome/Edge）的 CDP 客户端 + 进程管理
//
// 为什么是这条路（而不是 WebView2）：见 README「动态渲染」。一句话——
//   Windows 上 Edge 系统自带（等于 100% 有）、且同样覆盖 macOS/Linux；
//   Playwright/Puppeteer/Selenium 走的也是"外部浏览器 + CDP"这条同路。
//
// 本文件负责：
//   1. 找浏览器（LENO_BROWSER 环境变量 → Edge → Chrome → 常见路径）
//   2. 拉起（headless + 独立 `--user-data-dir` + 自选空闲端口）并等它就绪
//   3. 走 `/json/*` HTTP 端点拿目标页/版本信息（自己用 sockets 拼 HTTP，不依赖 libcurl）
//   4. 走 WebSocket（`web_ws`）发 CDP 命令、等事件
//   5. 收尾：`Browser.close` + 兜底按 profile 目录杀进程
//
// ⚠ 两个必须知道的现实约束（2026-10-06 实测 / 官方变更）：
//   · **Chrome/Edge 136+**：`--remote-debugging-port` 对**默认用户目录不再生效**，
//     必须配 `--user-data-dir=<独立目录>`。本模块本来就建临时目录（不碰用户的浏览器）。
//   · `--user-data-dir` 的路径会出现在进程命令行里 ⇒ 它同时被当作"这是我们的浏览器"的标记，
//     收尾时据此兜底清理（绝不能 `taskkill /IM msedge.exe`，那会杀掉用户自己的浏览器）。

import strings
import files
import dirs
import jsons
import times
import sockets
import "web_ws.leno" as ws

use ws.(WsClient)

// ==================== 类型 ====================

export struct BrowserConfig {
    string exe = ""            // 浏览器可执行文件；"" ⇒ 自动发现（或 LENO_BROWSER）
    bool headless = true
    string startUrl = ""       // 启动时的首页（给 "" 用 about:blank）
    string userDataDir = ""    // "" ⇒ 自动建临时目录；给了就持久化（可复用登录态）
    int port = 0               // 0 ⇒ 自动挑空闲端口
    int windowWidth = 1280
    int windowHeight = 800
    int readyTimeoutMs = 20000 // 等 DevTools 端口就绪的上限
    string extraArgs = ""      // 追加参数（空格分隔）
    string proxy = ""          // 例 "http://127.0.0.1:8080" ⇒ --proxy-server
    // ---- 反检测（对强反爬站点建议开：默认关，因为注入脚本毕竟改了页面环境）----
    bool stealth = false
    string userAgent = ""      // "" ⇒ stealth 时按浏览器版本自动生成（抹掉 HeadlessChrome 字样）
    string languages = "zh-CN,zh;q=0.9,en;q=0.8"
}

export struct Browser {
    bool ok = false
    string error = ""
    string exe = ""
    int port = 0
    string userDataDir = ""
    string version = ""        // 例："Edg/154.0.4258.53" / "Chrome/141.0.xxxx"
    string wsUrl = ""          // 浏览器级 webSocketDebuggerUrl
    bool headless = true
    int pid = 0                // 尽量取（`SystemInfo.getProcessInfo`），取不到为 0
    string pageTargetId = ""   // **我们自己创建的**页面 target（渲染操作都落在它上面）
    // 反检测配置（launch 时从 config 拷过来，渲染每个页面时按它准备环境）
    bool stealth = false
    string userAgent = ""
    string languages = ""
}

export struct CdpClient {
    WsClient ws
    int nextId = 1
    Array[string] events = []  // 等响应期间收到的事件，按到达顺序留着（waitEvent 会来领）
    bool ok = false
    string error = ""
}

export struct RenderResult {
    bool ok = false
    string html = ""
    string title = ""
    string url = ""
    string error = ""
    int ms = 0
    int status = 0             // 主文档 HTTP 状态码（拿不到为 0）
}

// ==================== 浏览器发现 ====================

func _envOr(string name, string def): string {
    string v = _env(name)
    if v == null or v == "" { return def }
    return v
}

// 返回浏览器可执行文件路径；找不到返回 ""
export func findBrowser(): string {
    string envPath = _envOr("LENO_BROWSER", "")
    if envPath != "" and files.exists(envPath) { return envPath }
    string local = _envOr("LOCALAPPDATA", "")

    Array[string] cands = []
    // Windows：Edge 优先（系统自带，装机面最大），再 Chrome
    string pf = _envOr("ProgramFiles", "C:\\Program Files")
    string pf86 = _envOr("ProgramFiles(x86)", "C:\\Program Files (x86)")
    cands.add(pf86 + "\\Microsoft\\Edge\\Application\\msedge.exe")
    cands.add(pf + "\\Microsoft\\Edge\\Application\\msedge.exe")
    cands.add(pf + "\\Google\\Chrome\\Application\\chrome.exe")
    cands.add(pf86 + "\\Google\\Chrome\\Application\\chrome.exe")
    if local != "" {
        cands.add(local + "\\Google\\Chrome\\Application\\chrome.exe")
    }
    // macOS
    cands.add("/Applications/Google Chrome.app/Contents/MacOS/Google Chrome")
    cands.add("/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge")
    cands.add("/Applications/Chromium.app/Contents/MacOS/Chromium")
    // Linux
    cands.add("/usr/bin/google-chrome")
    cands.add("/usr/bin/google-chrome-stable")
    cands.add("/usr/bin/chromium")
    cands.add("/usr/bin/chromium-browser")
    cands.add("/usr/bin/microsoft-edge")
    cands.add("/snap/bin/chromium")

    for cands.len() to i {
        if files.exists(cands[i]) { return cands[i] }
    }
    return ""
}

// ==================== 内部：进程 / 端口 / HTTP ====================

// 唯一的临时目录标记：既是 profile 目录名，也是"我们的浏览器进程"的识别标记
func _token(): string {
    return "leno-cdp-" + times.ns()
}

// 从 lo 起找一个空闲端口（连得上说明被占用）
// ⚠ 形参不能叫 `from` / `to`：`to` 是 `for a:b to i` 的关键字
func _pickFreePort(int lo, int hi): int {
    int p = lo
    while p <= hi {
        Socket s = sockets.connect("127.0.0.1", p)
        if s == null { return p }
        s.close()
        p = p + 1
    }
    return 0
}

// 极简 HTTP/1.1 GET（只给本机 DevTools 端点用；不依赖 libcurl）
//
// 两个实测过的要点：
//   ① Host 头**必须带端口**：Chromium 的 `/json/*` 会按 Host 头拼 `webSocketDebuggerUrl`，
//      写成 `Host: 127.0.0.1` 会拿回 `ws://127.0.0.1/devtools/...`（端口丢了 ⇒ 后面去连 80）
//   ② **必须按 Content-Length 收尾**：Chromium 无视我们的 `Connection: close`（HTTP/1.1
//      默认长连接）⇒ 只靠"读到断开/超时"会**白等一个超时**（实测每次 3s，把抓一页拖到 3.5s）
func _httpGet(int port, string path, int timeoutMs): string {
    Socket s = sockets.connect("127.0.0.1", port)
    if s == null { return "" }
    int slice = timeoutMs
    if slice > 1000 { slice = 1000 }        // 单次 recv 的超时；总预算另用 deadline 控
    s.set_timeout(slice)
    s.send("GET " + path + " HTTP/1.1\r\nHost: 127.0.0.1:" + port + "\r\nConnection: close\r\n\r\n")

    string buf = ""
    int deadline = _int(times.ms()) + timeoutMs
    int headEnd = -1
    while headEnd < 0 {
        if _int(times.ms()) > deadline { break }
        string got = s.recv(65536)
        // ⚠ recv 超时/关闭返回 **null**（不是空串）⇒ 必须显式判 null
        if got == null or got.byte_len() == 0 { break }
        buf = buf + got
        headEnd = strings.byte_find(buf, "\r\n\r\n", 0)
    }
    if headEnd < 0 {
        s.close()
        return ""
    }
    int bodyStart = headEnd + 4
    int want = _contentLength(buf, headEnd)
    if want >= 0 {
        while buf.byte_len() - bodyStart < want {
            if _int(times.ms()) > deadline { break }
            string more = s.recv(65536)
            if more == null or more.byte_len() == 0 { break }
            buf = buf + more
        }
        s.close()
        int avail = buf.byte_len() - bodyStart
        if avail < want { want = avail }
        return strings.byte_slice(buf, bodyStart, bodyStart + want)
    }
    // 没有 Content-Length（很少见）：退回"读到断开/超时"
    while true {
        if _int(times.ms()) > deadline { break }
        string got2 = s.recv(65536)
        if got2 == null or got2.byte_len() == 0 { break }
        buf = buf + got2
    }
    s.close()
    return strings.byte_slice(buf, bodyStart, buf.byte_len())
}

// 从响应头里取 Content-Length（找不到返回 -1）
func _contentLength(string head, int headEnd): int {
    string h = strings.byte_slice(head, 0, headEnd)
    string lower = strings.to_lower(h)
    int idx = strings.byte_find(lower, "content-length:", 0)
    if idx < 0 { return -1 }
    int p = idx + 15
    string digits = ""
    while p < h.byte_len() {
        int c = h.byte(p)
        if c < 48 or c > 57 { break }
        digits = digits + strings.char(c)
        p = p + 1
    }
    if digits == "" { return -1 }
    return _int(digits)
}

// 等 DevTools 端点就绪（返回 /json/version 的 JSON；超时返回 ""）
func _waitReady(int port, int timeoutMs): string {
    int t0 = _int(times.ms())
    while _int(times.ms()) - t0 < timeoutMs {
        string ver = _httpGet(port, "/json/version", 800)
        if ver != "" and strings.has(ver, "webSocketDebuggerUrl") { return ver }
        _sleepMs(50)
    }
    return ""
}

// 让当前线程睡一会儿（没有 sleep 内建 ⇒ 用 times 空转；50ms 级别的等待够用）
func _sleepMs(int ms) {
    int t0 = _int(times.ms())
    while _int(times.ms()) - t0 < ms {
        // 空转（每次循环都会调 native times.ms，代价很小）
    }
}

// 拼命令行（headless 新式写法；Chrome/Edge 通用）
func _buildArgs(BrowserConfig cfg, int port, string udd): string {
    string a = ""
    if cfg.headless { a = a + "--headless=new " }
    a = a + "--remote-debugging-port=" + port + " "
    a = a + "--user-data-dir=\"" + udd + "\" "
    a = a + "--no-first-run --no-default-browser-check --disable-extensions --disable-gpu "
    // 关掉这些"自带噪音"：Edge 首启会弹 edge://sync-confirmation-dialog/ 之类的内部页，
    // 干扰"哪个 page target 才是我们的页面"的判断（有 targetId 精确匹配兜底，但仍少扰为妙）
    a = a + "--disable-sync --disable-background-networking --no-service-autorun --disable-default-apps "
    a = a + "--window-size=" + cfg.windowWidth + "," + cfg.windowHeight + " "
    if cfg.proxy != "" {
        a = a + "--proxy-server=" + cfg.proxy + " "
    }
    if cfg.stealth {
        // 这一条是"抹掉 navigator.webdriver"的**源头**做法（比在 JS 里覆盖它更干净）
        a = a + "--disable-blink-features=AutomationControlled "
        string lang = cfg.languages
        int semi = strings.byte_find(lang, ";", 0)
        int comma = strings.byte_find(lang, ",", 0)
        int cut = -1
        if comma >= 0 { cut = comma }
        if semi >= 0 and (cut < 0 or semi < cut) { cut = semi }
        if cut > 0 { lang = strings.byte_slice(lang, 0, cut) }
        if lang != "" { a = a + "--lang=" + lang + " " }
    }
    if cfg.extraArgs != "" { a = a + cfg.extraArgs + " " }
    if cfg.startUrl != "" { a = a + "\"" + cfg.startUrl + "\" " }
    return strings.trim(a)
}

// 异步拉起（Windows 走 `cmd /c start ""`，POSIX 走 `sh -c '… &'`）
// 注意：**绝不能等它退出**（浏览器是常驻进程）⇒ 必须异步 + 独立 user-data-dir
func _spawn(string exe, string args): bool {
    if _isWindows() {
        // `start ""` 的第一个空参数是"标题"，缺了它 cmd 会把带引号的可执行文件路径当标题
        string cmd = "cmd /c start \"\" \"" + exe + "\" " + args
        var r = _exec(cmd, 10000)
        return r.code == 0
    }
    string cmd = "sh -c '\"" + exe + "\" " + args + " > /dev/null 2>&1 &'"
    var r2 = _exec(cmd, 10000)
    return r2.code == 0
}

func _isWindows(): bool {
    // dirs.sep() 在 Windows 返回 "\"，POSIX 返回 "/"（见 dirs 模块）
    return dirs.sep() == "\\"
}

// ==================== 反检测（stealth）====================

func _platform(): string {
    if _isWindows() { return "Win32" }
    return "Linux x86_64"
}

// 按浏览器版本号拼一个**正常**的 UA。
// 为什么要这一步：headless 默认 UA 里带 "HeadlessChrome/154.0.0.0" —— 白送一个特征。
func _defaultUa(string version): string {
    string v = version
    bool isEdge = false
    if strings.has(v, "Edg/") {
        isEdge = true
        v = strings.byte_slice(v, 4, v.byte_len())
    } else if strings.has(v, "Chrome/") {
        v = strings.byte_slice(v, 7, v.byte_len())
    }
    string base = ""
    if _isWindows() {
        base = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/" + v + " Safari/537.36"
    } else {
        base = "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/" + v + " Safari/537.36"
    }
    if isEdge { base = base + " Edg/" + v }
    return base
}

// 注入到**每个新文档**里的反检测脚本（在页面自身脚本之前执行）。
// ⚠ 这是**手工拼的 JS 字符串**：括号计数极易错，而错了以后 `Runtime.evaluate` /
//   注入都只会静默失效（`addScriptToEvaluateOnNewDocument` 甚至不报错）。
//   所以测试里有一条 `stealthSelfTest` 断言（把脚本丢进 try/eval 里跑一遍）——
//   实测就是靠它抓到"三个 defineProperty 各少一个 `}`"这个错。
//
// 只做"抹掉无头特征"这一类，不做指纹伪造的军备竞赛：
//   navigator.webdriver / languages / plugins / mimeTypes / hardwareConcurrency /
//   window.chrome / WebGL 的 UNMASKED_VENDOR|RENDERER / permissions.query('notifications')
func _stealthJs(): string {
    string js = "(function(){"
    js = js + "try{Object.defineProperty(navigator,'webdriver',{get:function(){return undefined;}});}catch(e){}"
    js = js + "try{Object.defineProperty(navigator,'languages',{get:function(){return ['zh-CN','zh','en'];}});}catch(e){}"
    js = js + "try{Object.defineProperty(navigator,'plugins',{get:function(){return [{name:'Chrome PDF Plugin'},{name:'Chrome PDF Viewer'},{name:'Native Client'}];}});}catch(e){}"
    js = js + "try{Object.defineProperty(navigator,'mimeTypes',{get:function(){return [{type:'application/pdf'}];}});}catch(e){}"
    js = js + "try{Object.defineProperty(navigator,'hardwareConcurrency',{get:function(){return 8;}});}catch(e){}"
    js = js + "try{Object.defineProperty(navigator,'deviceMemory',{get:function(){return 8;}});}catch(e){}"
    js = js + "try{if(!window.chrome){window.chrome={runtime:{},app:{isInstalled:false},csi:function(){},loadTimes:function(){}};}}catch(e){}"
    js = js + "try{var g=WebGLRenderingContext.prototype.getParameter;"
    js = js + "WebGLRenderingContext.prototype.getParameter=function(p){"
    js = js + "if(p===37445)return 'Intel Inc.';if(p===37446)return 'Intel Iris OpenGL Engine';return g.apply(this,arguments);};}catch(e){}"
    js = js + "try{var g2=WebGL2RenderingContext.prototype.getParameter;"
    js = js + "WebGL2RenderingContext.prototype.getParameter=function(p){"
    js = js + "if(p===37445)return 'Intel Inc.';if(p===37446)return 'Intel Iris OpenGL Engine';return g2.apply(this,arguments);};}catch(e){}"
    js = js + "try{var q=navigator.permissions.query.bind(navigator.permissions);"
    js = js + "navigator.permissions.query=function(a){"
    js = js + "if(a&&a.name==='notifications'){return Promise.resolve({state:'default',onchange:null});}return q(a);};}catch(e){}"
    js = js + "})();"
    return js
}

// 反检测脚本源码（导出给测试/诊断用：可以手动 evaluate 一次看它到底有没有效果）
export func stealthSource(): string {
    return _stealthJs()
}

// 自检：把脚本放进 try/eval 里跑一遍。返回 "ok" 或 "ERR:<原因>"。
// 为什么需要它：`Runtime.evaluate` 遇到**语法错误**只是返回异常详情 —— 我们的 evaluate
// 只看 value ⇒ 会静默返回空串，于是"注入没生效"完全没有线索（实测就这么卡了一轮）。
export func stealthSelfTest(CdpClient c): string {
    string js = "(function(){try{eval(" + jsons.encode(_stealthJs()) + ");return 'ok';}catch(e){return 'ERR:'+e.message;}})()"
    string r = evaluate(c, js)
    if r == "" { return "ERR:（evaluate 未返回，可能是语法错误）" }
    return r
}

// 每个页面在**导航之前**的环境准备（UA / 语言 / stealth 注入）
// ⚠ 注入必须早于导航：`Page.addScriptToEvaluateOnNewDocument` 要求"之后创建的新文档"才生效
// 返回 "" 表示都成功；否则是失败原因（**不要静默失败** —— 静默失败会让 stealth 看起来开着、
// 实际什么都没注入，实测就踩过：WebGL 渲染器与对照组一模一样，才发现注入压根没生效）
func _preparePage(CdpClient c, Browser b): string {
    if not b.stealth { return "" }
    string ua = b.userAgent
    if ua == "" { ua = _defaultUa(b.version) }
    string lang = b.languages
    if lang == "" { lang = "zh-CN,zh;q=0.9,en;q=0.8" }
    string params = "{\"userAgent\":" + jsons.encode(ua) +
                    ",\"acceptLanguage\":" + jsons.encode(lang) +
                    ",\"platform\":" + jsons.encode(_platform()) + "}"
    string r1 = cdpCall(c, "Emulation.setUserAgentOverride", params)
    if r1 == "" { return "设置 UA 失败：" + c.error }
    string r2 = cdpCall(c, "Page.addScriptToEvaluateOnNewDocument", "{\"source\":" + jsons.encode(_stealthJs()) + "}")
    if r2 == "" { return "注入反检测脚本失败：" + c.error }
    return ""
}

// 兜底清理：按 profile 目录标记杀进程（**主路径是 CDP 的 Browser.close**）
// 只杀命令行里带我们那个唯一目录的进程 —— 不可能碰到用户自己的浏览器
export func killByProfile(string udd): bool {
    if udd == "" { return false }
    string token = strings.byte_slice(udd, strings.byte_find(udd, "leno-cdp-", 0), udd.byte_len())
    if _isWindows() {
        // wmic 在新系统上可能已移除 ⇒ 失败就用 powershell 兜一层
        var r = _exec("wmic process where \"commandline like '%" + token + "%'\" call terminate", 15000)
        if r.code == 0 { return true }
        var r2 = _exec("powershell -NoProfile -Command \"Get-CimInstance Win32_Process -Filter \\\"CommandLine like '%" +
                       token + "%'\\\" | ForEach-Object { Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue }\"", 20000)
        return r2.code == 0
    }
    var r3 = _exec("pkill -f " + token, 10000)
    return r3.code == 0
}

// ==================== CDP over WebSocket ====================

// 连上浏览器级 WS（或某个 target 的 WS）
export func cdpConnect(string wsUrl, int timeoutMs): CdpClient {
    CdpClient c = new CdpClient()
    c.events = []
    c.nextId = 1
    c.ok = false
    c.error = ""
    c.ws = ws.connect(wsUrl, timeoutMs)
    if not c.ws.ok {
        c.error = "WebSocket 连接失败：" + c.ws.error
        return c
    }
    c.ok = true
    return c
}

// 收一条消息；失败返回 ""
func _recvJson(CdpClient c): string {
    string raw = ws.recvText(c.ws)
    if raw == "" {
        c.ok = false
        c.error = "读取 CDP 消息失败：" + ws.lastError()
        return ""
    }
    return raw
}

// 发一条命令并等它的响应；返回 `result` 的 JSON 文本（失败返回 ""）
export func cdpCall(CdpClient c, string method, string paramsJson): string {
    if not c.ok { return "" }
    int id = c.nextId
    c.nextId = c.nextId + 1
    string msg = ""
    if paramsJson == "" or paramsJson == "{}" {
        msg = "{\"id\":" + id + ",\"method\":\"" + method + "\"}"
    } else {
        msg = "{\"id\":" + id + ",\"method\":\"" + method + "\",\"params\":" + paramsJson + "}"
    }
    if not ws.sendText(c.ws, msg) {
        c.ok = false
        c.error = "发送 CDP 命令失败：" + method
        return ""
    }
    while true {
        string raw = _recvJson(c)
        if raw == "" { return "" }
        var obj = jsons.decode(raw)
        // 正向守卫即可：`if obj is Dict { … }` 会把 obj **收窄**成 Dict ⇒ 后面直接用它，
        // 不需要 `as Dict[string, any]`（负向守卫 `not is` 反而**不会**收窄，必须补 cast）
        if obj is Dict[string, any] {
            int rid = jsons.get_int(obj, "id", -1)
            if rid == id {
                var errObj = jsons.get_obj(obj, "error")
                if errObj is Dict[string, any] {
                    c.error = "CDP 错误（" + method + "）：" + jsons.get_str(errObj, "message", "未知错误")
                    return ""
                }
                var resObj = jsons.get_obj(obj, "result")
                if resObj is Dict[string, any] {
                    return jsons.encode(resObj)
                }
                return "{}"
            }
            // 别人的响应/事件 ⇒ 留着给 waitEvent 来领
            if jsons.get_str(obj, "method", "") != "" {
                c.events.add(raw)
            }
        }
    }
}

// 等一个事件（先翻已收到的事件队列，再继续收）；超时返回 ""
export func waitEvent(CdpClient c, string method, int timeoutMs): string {
    for c.events.len() to i {
        var obj = jsons.decode(c.events[i])
        if obj is Dict[string, any] and jsons.get_str(obj, "method", "") == method {
            // 领取（从队列里摘掉）
            string raw = c.events[i]
            Array[string] keep = []
            for c.events.len() to j {
                if j != i { keep.add(c.events[j]) }
            }
            c.events = keep
            return _eventParams(obj)
        }
    }
    int t0 = _int(times.ms())
    while _int(times.ms()) - t0 < timeoutMs and c.ok {
        string raw = _recvJson(c)
        if raw == "" { return "" }
        var obj = jsons.decode(raw)
        if obj is Dict[string, any] {
            if jsons.get_str(obj, "method", "") == method {
                return _eventParams(obj)
            }
            if jsons.get_str(obj, "method", "") != "" {
                c.events.add(raw)
            }
        }
    }
    return ""
}

// 事件消息的 params（没有就返回 "{}"）
func _eventParams(Dict[string, any] d): string {
    var p = jsons.get_obj(d, "params")
    if p is Dict[string, any] {
        return jsons.encode(p)
    }
    return "{}"
}

// 在页面里求值（returnByValue + awaitPromise），返回字符串结果
export func evaluate(CdpClient c, string js): string {
    var expr = jsons.encode(js)
    string params = "{\"expression\":" + expr + ",\"returnByValue\":true,\"awaitPromise\":true}"
    string res = cdpCall(c, "Runtime.evaluate", params)
    if res == "" { return "" }
    var obj = jsons.decode(res)
    if obj is Dict[string, any] {
        // ⚠ 取值要**两层**：cdpCall 返回的已经是命令的 `result`，
        //   `Runtime.evaluate` 的结果形如 {"result":{"type":"string","value":"…"}}
        //   ⇒ 先取 "result" 再取 "value"。只取一层会永远拿到空串（实测踩过：
        //   渲染阶段报"取值失败"但底层错误为空，因为 value 根本没被读到）。
        var inner = jsons.get_obj(obj, "result")
        if inner is Dict[string, any] {
            return jsons.get_str(inner, "value", "")
        }
        // 有些命令（或异常情形）直接把 value 放在顶层 ⇒ 兜一层
        return jsons.get_str(obj, "value", "")
    }
    return ""
}

export func cdpClose(CdpClient c) {
    ws.close(c.ws)
    c.ok = false
}

// ==================== 启动 / 收尾 ====================

export func launch(BrowserConfig cfg): Browser {
    Browser b = new Browser()
    b.ok = false
    b.error = ""
    b.headless = cfg.headless

    string exe = cfg.exe
    if exe == "" { exe = findBrowser() }
    if exe == "" {
        b.error = "没找到 Chrome / Edge（可用环境变量 LENO_BROWSER 指定可执行文件路径）"
        return b
    }
    b.exe = exe
    // 反检测配置跟着浏览器走（渲染每个页面时按它准备环境）
    b.stealth = cfg.stealth
    b.userAgent = cfg.userAgent
    b.languages = cfg.languages

    string udd = cfg.userDataDir
    if udd == "" {
        string base = _envOr("TEMP", _envOr("TMPDIR", "/tmp"))
        udd = dirs.join(base, _token())
    }
    if not dirs.exists(udd) {
        dirs.mkdir_p(udd)
    }
    b.userDataDir = udd

    int port = cfg.port
    if port <= 0 { port = _pickFreePort(9222, 9400) }
    if port <= 0 {
        b.error = "找不到空闲端口（9222-9400 都被占用）"
        return b
    }

    string args = _buildArgs(cfg, port, udd)
    if not _spawn(exe, args) {
        b.error = "拉起浏览器失败：" + exe
        return b
    }

    string verJson = _waitReady(port, cfg.readyTimeoutMs)
    if verJson == "" {
        b.error = "浏览器已拉起但 DevTools 端口未就绪（" + port + "，等了 " + cfg.readyTimeoutMs + "ms）"
        killByProfile(udd)
        return b
    }
    var ver = jsons.decode(verJson)
    if ver is Dict[string, any] {
        b.port = port
        b.version = jsons.get_str(ver, "Browser", "")
        b.wsUrl = jsons.get_str(ver, "webSocketDebuggerUrl", "")
        b.ok = true
    } else {
        b.error = "无法解析 /json/version 响应"
        killByProfile(udd)
        return b
    }

    // 顺便取一下浏览器进程号（收尾用得上；取不到不影响使用）+ **自己创建一个页面 target**
    //   ⚠ 为什么显式创建：`/json/list` 里可能有浏览器自带的内部页
    //   （实测 Edge 首启会冒出 `edge://sync-confirmation-dialog/`），
    //   "取第一个 page" 会连到别人的页面上 ⇒ 用 targetId 精确锁定我们自己的那个
    CdpClient probe = cdpConnect(b.wsUrl, 5000)
    if probe.ok {
        string created = cdpCall(probe, "Target.createTarget", "{\"url\":\"about:blank\"}")
        if created != "" {
            var cobj = jsons.decode(created)
            if cobj is Dict[string, any] {
                b.pageTargetId = jsons.get_str(cobj, "targetId", "")
            }
        }
        string sysInfo = cdpCall(probe, "SystemInfo.getProcessInfo", "")
        if sysInfo != "" {
            var arr = jsons.decode(sysInfo)
            // SystemInfo.getProcessInfo 的 result 形如 {"processInfo":[{"id":1234,"type":"browser"},…]}
            var list = jsons.get_obj(arr, "processInfo")
            if list is Array and list.len() > 0 {
                var first = list[0]
                if first is Dict[string, any] {
                    b.pid = jsons.get_int(first, "id", 0)
                }
            }
        }
        cdpClose(probe)
    }
    return b
}

// 取页面级 target 的 WS 地址。
// 优先级：① 我们**自己创建的** target（按 targetId 精确匹配）
//        ② url 以 http 开头的 page ③ about:blank ④ 其它 page（排除浏览器内部页）
// ⚠ 不能"取第一个 page"：实测 Edge 首启会自带 `edge://sync-confirmation-dialog/` 这类内部页，
//   取第一个会连到它上面（然后 `#app` 之类当然找不到）
export func pageWsUrl(Browser b): string {
    string list = _httpGet(b.port, "/json/list", 3000)
    if list == "" { return "" }
    var arr = jsons.decode(list)
    // ⚠ 必须用**正向**守卫包住循环：负向守卫（`not is` + 提前 return）**不会**收窄类型
    //   ⇒ 里面 `arr.len()` / `arr[i]` 会被判"不能在 any 上访问"。同一做法见 web_crawler 的
    //   `if seen is Array { … }`。
    if arr is Array {
        // ① targetId 精确匹配
        if b.pageTargetId != "" {
            for arr.len() to i {
                var it = arr[i]
                if it is Dict[string, any] {
                    if jsons.get_str(it, "id", "") == b.pageTargetId {
                        string u = jsons.get_str(it, "webSocketDebuggerUrl", "")
                        if u != "" { return u }
                    }
                }
            }
        }
        // ② http 页面
        for arr.len() to i {
            var it = arr[i]
            if it is Dict[string, any] {
                if jsons.get_str(it, "type", "") == "page" {
                    string url = jsons.get_str(it, "url", "")
                    if strings.has(url, "http") {
                        string u = jsons.get_str(it, "webSocketDebuggerUrl", "")
                        if u != "" { return u }
                    }
                }
            }
        }
        // ③/④ about:blank 与其它非内部 scheme
        for arr.len() to i {
            var it = arr[i]
            if it is Dict[string, any] {
                if jsons.get_str(it, "type", "") == "page" {
                    string url = jsons.get_str(it, "url", "")
                    if not strings.has(url, "edge://") and not strings.has(url, "chrome://") and not strings.has(url, "devtools://") {
                        string u = jsons.get_str(it, "webSocketDebuggerUrl", "")
                        if u != "" { return u }
                    }
                }
            }
        }
    }
    return ""
}

// 关闭浏览器：先走协议（干净），再按 profile 兜底（务实）
export func close(Browser b): bool {
    bool done = false
    if b.ok and b.wsUrl != "" {
        CdpClient c = cdpConnect(b.wsUrl, 3000)
        if c.ok {
            cdpCall(c, "Browser.close", "")
            cdpClose(c)
            // 等它自己退（最多 3s）
            int t0 = _int(times.ms())
            while _int(times.ms()) - t0 < 3000 {
                Socket s = sockets.connect("127.0.0.1", b.port)
                if s == null { done = true; break }
                s.close()
                _sleepMs(100)
            }
        }
    }
    if not done {
        killByProfile(b.userDataDir)
    }
    b.ok = false
    return done
}

// ==================== 等待策略 / 交互 / 截图 ====================

// 渲染选项：把"怎么等、要不要交互"显式化
// （取代"load 事件 + 固定 sleep"那种不可靠做法 —— 对慢接口会取早）
export struct RenderOptions {
    int timeoutMs = 20000        // 总预算
    string waitUntil = "load"    // "load" | "networkidle" | "selector"
    string waitSelector = ""     // waitUntil == "selector" 时等它出现
    int networkIdleMs = 500      // 连续这么久没有在飞请求 ⇒ 算网络空闲
    int settleMs = 500           // 等待结束后再静置一会儿（给前端渲染留时间）
    string clickSelector = ""    // 打开后先点它（JS 点击，最快）
    string realClickSelector = "" // **真事件**点击（isTrusted=true，过反脚本点击的站点）
    string typeSelector = ""     // 先往这里输入文字（真事件 insertText）
    string typeValue = ""
    int scrollTimes = 0          // 打开后向下滚几次（每次滚到底 + 短静置）
    string screenshotPath = ""   // 非空则把截图（PNG）写到这里
}

// 尽量多收几条消息（**不等满**整个 WS 超时）：事件攒进 c.events 交上层按需处理。
// 实现上把 WS 超时临时压到 ≤200ms ⇒ 这是"轮询式等待"的基础。
func _drain(CdpClient c, int budgetMs): int {
    int t0 = _int(times.ms())
    int count = 0
    while true {
        int remain = budgetMs - (_int(times.ms()) - t0)
        if remain <= 0 { break }
        if remain > 200 { remain = 200 }
        ws.setTimeout(c.ws, remain)
        string raw = ws.recvText(c.ws)
        if raw == "" { break }
        count = count + 1
        var obj = jsons.decode(raw)
        if obj is Dict[string, any] {
            if jsons.get_str(obj, "method", "") != "" {
                c.events.add(raw)
            }
        }
    }
    return count
}

// 等"网络空闲"（≈ Playwright 的 wait_until="networkidle"）：
// 用 Network.* 事件维护在飞请求数，连续 idleMs 没有在飞请求即算空闲。
// 超时返回 false —— 调用方照常取值（宁可拿到半成品，也不要卡死）
export func waitNetworkIdle(CdpClient c, int idleMs, int timeoutMs): bool {
    if not c.ok { return false }
    cdpCall(c, "Network.enable", "")
    int t0 = _int(times.ms())
    int inflight = 0
    int lastActivity = t0
    bool seenRequest = false
    while _int(times.ms()) - t0 < timeoutMs {
        _drain(c, 150)
        Array[string] keep = []
        for c.events.len() to i {
            var obj = jsons.decode(c.events[i])
            if obj is Dict[string, any] {
                string m = jsons.get_str(obj, "method", "")
                if m == "Network.requestWillBeSent" {
                    inflight = inflight + 1
                    seenRequest = true
                    lastActivity = _int(times.ms())
                } else if m == "Network.loadingFinished" or m == "Network.loadingFailed" {
                    inflight = inflight - 1
                    if inflight < 0 { inflight = 0 }
                    lastActivity = _int(times.ms())
                } else {
                    keep.add(c.events[i])
                }
            } else {
                keep.add(c.events[i])
            }
        }
        c.events = keep
        int now = _int(times.ms())
        // 除了"见过请求"之外再给 400ms 宽限：否则页面还没发出第一个请求就被判成空闲
        if seenRequest or (now - t0) > 400 {
            if inflight == 0 and (now - lastActivity) >= idleMs {
                return true
            }
        }
    }
    return false
}

// 等选择器出现（轮询实现：简单，且对动态插入的节点立刻可见）
export func waitForSelector(CdpClient c, string css, int timeoutMs): bool {
    string js = "(document.querySelector(" + jsons.encode(css) + ") ? '1' : '')"
    int t0 = _int(times.ms())
    while _int(times.ms()) - t0 < timeoutMs {
        if evaluate(c, js) == "1" { return true }
        _sleepMs(100)
    }
    return false
}

// 用 JS 点击（省掉 Input.* 的坐标换算）。
// ⚠ 派发的是**不可信事件**（isTrusted=false）：个别站点会据此拒绝。需要真事件时再走
//   Input.dispatchMouseEvent（后续）
export func clickSelector(CdpClient c, string css): bool {
    string js = "(function(){var e=document.querySelector(" + jsons.encode(css) +
                ");if(!e)return '';e.click();return '1';})()"
    return evaluate(c, js) == "1"
}

// **真事件**点击：走 `Input.dispatchMouseEvent`，页面拿到的 `event.isTrusted === true`。
// 有些站点用 isTrusted 挡脚本点击（只用 element.click() 会被识破）⇒ 这种场景用这个。
export func clickReal(CdpClient c, string css): bool {
    string js = "(function(){var e=document.querySelector(" + jsons.encode(css) +
                ");if(!e)return '';var r=e.getBoundingClientRect();" +
                "return Math.round(r.left+r.width/2)+','+Math.round(r.top+r.height/2);})()"
    string pos = evaluate(c, js)
    if pos == "" { return false }
    int comma = strings.byte_find(pos, ",", 0)
    if comma < 0 { return false }
    int x = _int(strings.byte_slice(pos, 0, comma))
    int y = _int(strings.byte_slice(pos, comma + 1, pos.byte_len()))
    // 坐标是**视口坐标**（getBoundingClientRect 与 CDP 的 x/y 同一坐标系）
    string common = "\"x\":" + x + ",\"y\":" + y + ",\"button\":\"left\",\"clickCount\":1"
    cdpCall(c, "Input.dispatchMouseEvent", "{\"type\":\"mouseMoved\"," + common + "}")
    cdpCall(c, "Input.dispatchMouseEvent", "{\"type\":\"mousePressed\"," + common + "}")
    cdpCall(c, "Input.dispatchMouseEvent", "{\"type\":\"mouseReleased\"," + common + "}")
    return true
}

// **真事件**输入：先聚焦元素，再用 `Input.insertText` 送文字（会触发 input 事件）
export func typeText(CdpClient c, string css, string text): bool {
    string js = "(function(){var e=document.querySelector(" + jsons.encode(css) +
                ");if(!e)return '';e.focus();return '1';})()"
    if evaluate(c, js) != "1" { return false }
    cdpCall(c, "Input.insertText", "{\"text\":" + jsons.encode(text) + "}")
    return true
}

// 滚到页面底部（无限滚动 / 懒加载用），返回滚动前的文档高度
export func scrollToBottom(CdpClient c): int {
    string h = evaluate(c, "String(Math.max(document.body.scrollHeight, document.documentElement.scrollHeight))")
    evaluate(c, "window.scrollTo(0, document.body.scrollHeight)")
    return _int(h)
}

// 截图（PNG）写文件；成功返回 true
export func captureScreenshot(CdpClient c, string savePath): bool {
    string res = cdpCall(c, "Page.captureScreenshot", "{\"format\":\"png\"}")
    if res == "" { return false }
    var obj = jsons.decode(res)
    if obj is Dict[string, any] {
        string b64 = jsons.get_str(obj, "data", "")
        if b64 == "" { return false }
        Array[int] bs = ws.base64Decode(b64)
        if bs.len() == 0 { return false }
        files.write(savePath, strings.from_bytes(bs))
        return true
    }
    return false
}

// ==================== 高层：渲染一个页面 ====================

// 完整版渲染：等待策略 + 交互 + 截图，都是"取值之前"生效（拿到的 HTML 反映交互后状态）
export func renderAdvanced(Browser b, string url, RenderOptions opt): RenderResult {
    RenderResult r = new RenderResult()
    r.url = url
    int t0 = _int(times.ms())
    if not b.ok {
        r.error = "浏览器未就绪：" + b.error
        return r
    }
    string wsUrl = pageWsUrl(b)
    if wsUrl == "" {
        r.error = "/json/list 里没有 page 类型的 target"
        return r
    }
    CdpClient c = cdpConnect(wsUrl, opt.timeoutMs)
    if not c.ok {
        r.error = c.error
        return r
    }
    cdpCall(c, "Page.enable", "")
    cdpCall(c, "Runtime.enable", "")
    // ⚠ stealth 的 UA/注入必须在**导航之前**做：注入脚本只对"之后创建的文档"生效
    string prepErr = _preparePage(c, b)
    if prepErr != "" {
        r.error = "stealth 准备失败：" + prepErr
        cdpClose(c)
        return r
    }
    if opt.waitUntil == "networkidle" {
        // ⚠ 必须先开 Network 域**再**导航，否则会漏掉最早那批请求（就等不准了）
        cdpCall(c, "Network.enable", "")
    }
    cdpCall(c, "Page.navigate", "{\"url\":" + jsons.encode(url) + "}")

    if opt.waitUntil == "networkidle" {
        waitNetworkIdle(c, opt.networkIdleMs, opt.timeoutMs)
    } else if opt.waitUntil == "selector" and opt.waitSelector != "" {
        waitForSelector(c, opt.waitSelector, opt.timeoutMs)
    } else {
        waitEvent(c, "Page.loadEventFired", opt.timeoutMs)
    }
    if opt.settleMs > 0 { _sleepMs(opt.settleMs) }

    // 交互顺序：填表 → 点击 → 滚动（都发生在取值之前，拿到的 HTML 反映交互后的状态）
    if opt.typeSelector != "" and opt.typeValue != "" {
        typeText(c, opt.typeSelector, opt.typeValue)
        _sleepMs(200)
    }
    if opt.clickSelector != "" {
        clickSelector(c, opt.clickSelector)
        _sleepMs(300)
    }
    if opt.realClickSelector != "" {
        clickReal(c, opt.realClickSelector)
        _sleepMs(300)
    }
    for 0:opt.scrollTimes-1 to i {
        scrollToBottom(c)
        _sleepMs(300)
    }
    if opt.screenshotPath != "" {
        captureScreenshot(c, opt.screenshotPath)
    }

    r.title = evaluate(c, "document.title")
    string html = evaluate(c, "document.documentElement.outerHTML")
    if html == "" {
        // 有些页面（或还没渲染）拿不到 outerHTML ⇒ 退回 documentElement.innerHTML
        html = evaluate(c, "document.documentElement ? document.documentElement.innerHTML : ''")
    }
    if html == "" {
        r.error = "取值失败（页面可能未完成渲染）：" + c.error
    } else {
        r.ok = true
        r.html = html
    }
    cdpClose(c)
    r.ms = _int(times.ms()) - t0
    return r
}

// 简版：等 load 事件 + 固定静置（签名保持不变，内部走 renderAdvanced）
export func renderWith(Browser b, string url, int waitLoadMs, int settleMs): RenderResult {
    RenderOptions opt = new RenderOptions()
    opt.timeoutMs = waitLoadMs
    opt.waitUntil = "load"
    opt.settleMs = settleMs
    return renderAdvanced(b, url, opt)
}

// 一次性：起浏览器 → 渲染 → 关掉。批量抓取请用 launch + renderWith 复用同一个浏览器
export func render(string url, int timeoutMs): RenderResult {
    BrowserConfig cfg = new BrowserConfig()
    cfg.startUrl = "about:blank"
    cfg.readyTimeoutMs = timeoutMs
    Browser b = launch(cfg)
    if not b.ok {
        RenderResult r = new RenderResult()
        r.url = url
        r.error = b.error
        return r
    }
    RenderResult r = renderWith(b, url, timeoutMs, 800)
    close(b)
    return r
}
