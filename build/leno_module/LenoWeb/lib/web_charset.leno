// web_charset.leno — 字符集探测与转码（GBK / GB2312 / BIG5 / Shift_JIS / … → UTF-8）
//
// 【为什么需要】
// libcurl 只负责搬字节，不认识 `Content-Type: charset=`，响应体里 GBK/GB2312 页面
// 会被原样塞进 `resp.body` ⇒ 中文整页乱码。这是"能不能爬中文站"的第一道门槛。
// 本模块补上"探测 + 转码"这一环，行为对齐 Python 的 requests：
//
//   探测顺序：BOM → Content-Type → <meta charset> → UTF-8 校验 → 系统 ANSI 兜底
//   转码后端：Windows = kernel32 MultiByteToWideChar/WideCharToMultiByte（系统自带，零依赖）
//             POSIX   = libc iconv
//             两者都不可用 ⇒ **原样返回**（宁可不转，也不要把内容搞坏）
//
// 【字节口径】（重要，2026-10-06 实测）
//   · `s.len()`        = UTF-8 **字符数**（对 GBK 字节是错的）
//   · `s.byte_len()`   = **字节数**   ⇒ 本模块全程用它
//   · `s.byte(i)`      = 按**字节**取下标
//   · `s.byte_slice()` = 按**字节**切片
//   · `strings.find()` = 返回**字符**下标（与 byte 口径不通用！）⇒ 本模块自带字节级查找
//
// 【无模块级可变状态】
//   刻意不缓存 DLL 句柄：`LenoWeb` 的模块级全局在多线程下是**共享**的
//   （见 docs/多线程struct与模块全局变量问题记录.md），缓存的库句柄会成为竞态源。
//   转码一次/响应，`ffi.load` 命中的是已加载模块（OS 计数 +1，微秒级），代价可忽略。

import ffi
import strings

// ==================== 平台 FFI ====================

// kernel32：CodePage 转换（Windows 自带，无需额外 DLL）
clib k32_charset {
    u32 GetACP()
    i32 MultiByteToWideChar(u32 CodePage, u32 dwFlags, str8 lpMultiByteStr, i32 cbMultiByte, Ptr lpWideCharStr, i32 cchWideChar)
    i32 WideCharToMultiByte(u32 CodePage, u32 dwFlags, Ptr lpWideCharStr, i32 cchWideChar, Ptr lpMultiByteStr, i32 cbMultiByte, Ptr lpDefaultChar, Ptr lpUsedDefaultChar)
}

// iconv（POSIX；glibc 自带）
clib iconv_charset {
    Ptr iconv_open(str8 tocode, str8 fromcode)
    i64 iconv(Ptr cd, Ptr inbuf, Ptr inbytesleft, Ptr outbuf, Ptr outbytesleft)
    i32 iconv_close(Ptr cd)
}

const CP_UTF8 = 65001
const MB_ERR_INVALID_CHARS = 0x8      // 仅 CP_UTF8 支持：非法字节 ⇒ 返回 0（用来做 UTF-8 校验）
const ICONV_FAILED = -1

// ==================== 库加载 ====================

func _k32Lib(): k32_charset {
    try {
        return ffi.load("kernel32.dll")
    } catch e {
        return null
    }
}

func _iconvLib(): iconv_charset {
    try {
        return ffi.load("libc.so.6")
    } catch e {
        // macOS / musl 等
        try {
            return ffi.load("libiconv.so")
        } catch e2 {
            return null
        }
    }
}

// 当前可用的转码后端："windows" / "iconv" / "none"
export func backend(): string {
    if _os() == "windows" {
        if _k32Lib() == null { return "none" }
        return "windows"
    }
    if _iconvLib() == null { return "none" }
    return "iconv"
}

// ==================== 字节级原语 ====================

func _byteAt(string s, int i): int {
    var v = s.byte(i)
    if v is int { return v }
    return -1
}

func _lowerByte(int b): int {
    if b >= 65 and b <= 90 { return b + 32 }
    return b
}

func _isSpaceByte(int b): bool {
    return b == 32 or b == 9 or b == 10 or b == 13 or b == 12
}

// 字符集名允许出现的字节：字母 / 数字 / - _ . : + *
func _isTokenByte(int b): bool {
    if b >= 48 and b <= 57 { return true }
    if b >= 65 and b <= 90 { return true }
    if b >= 97 and b <= 122 { return true }
    if b == 45 or b == 95 or b == 46 or b == 58 or b == 43 or b == 42 { return true }
    return false
}

// 在 s 的 [from, until) **字节**区间内做大小写不敏感查找，返回字节下标（-1 = 未找到）
// ⚠ 不能直接用 `strings.find`：它返回**字符**下标且默认走模式匹配（见模块头注释）
// 快路径 = `strings.byte_find`（C 侧 memcmp，二进制安全）；HTML/响应头里 "charset"/"<meta"
// 几乎都是小写 ⇒ 绝大多数请求在这条路径上零 VM 循环。
// 慢路径 = 窗口内逐字节比较（只处理大小写不一致的少数情况；窗口 ≤ 8KB ⇒ 亚毫秒）
func _findCI(string s, int from, int until, string needle): int {
    int n = needle.byte_len()
    if n <= 0 { return -1 }
    int total = s.byte_len()
    if until > total { until = total }
    if from < 0 { from = 0 }
    if from + n > until { return -1 }
    int fast = strings.byte_find(s, needle.to_lower(), from)
    if fast >= 0 and fast + n <= until { return fast }
    int i = from
    while i + n <= until {
        bool hit = true
        for n to k {
            if _lowerByte(_byteAt(s, i + k)) != _lowerByte(_byteAt(needle, k)) {
                hit = false
                break
            }
        }
        if hit { return i }
        i = i + 1
    }
    return -1
}

// pos 指向 "charset" 起点 ⇒ 取出其后的字符集名（跳过 =、空白、引号）
func _tokenAfter(string s, int pos): string {
    int total = s.byte_len()
    int i = pos + 7
    while i < total and _isSpaceByte(_byteAt(s, i)) { i = i + 1 }
    if i >= total or _byteAt(s, i) != 61 { return "" }      // 61 = '='
    i = i + 1
    while i < total and _isSpaceByte(_byteAt(s, i)) { i = i + 1 }
    if i < total {
        int q = _byteAt(s, i)
        if q == 34 or q == 39 { i = i + 1 }                  // 34 = '"', 39 = '\''
    }
    Array[int] out = []
    while i < total {
        int b = _byteAt(s, i)
        if not _isTokenByte(b) { break }
        out.add(b)
        i = i + 1
    }
    if out.len() == 0 { return "" }
    return strings.from_bytes(out)
}

// ==================== 字符集名归一 ====================

// 小写、去引号/空白、`_`与空格统一成 `-`
export func normalize(string charset): string {
    string s = charset.trim().to_lower()
    // 去掉可能带的 "charset=" 前缀
    if s.starts_with("charset=") { s = s.byte_slice(8, s.byte_len()) }
    int n = s.byte_len()
    if n >= 2 {
        int b0 = _byteAt(s, 0)
        if (b0 == 34 or b0 == 39) and _byteAt(s, n - 1) == b0 {
            s = s.byte_slice(1, (n - 1) - 1)
            n = s.byte_len()
        }
    }
    Array[int] out = []
    for n to i {
        int b = _byteAt(s, i)
        if b == 95 or b == 32 { b = 45 }
        out.add(b)
    }
    if out.len() == 0 { return "" }
    return strings.from_bytes(out)
}

// 字符集名 → Windows 代码页（0 = 未知）
export func codepage(string charset): int {
    string n = normalize(charset)
    if n == "" { return 0 }
    if n == "utf-8" or n == "utf8" or n == "cp65001" or n == "ascii" or n == "us-ascii" or n == "ansi-x3.4-1968" { return CP_UTF8 }
    // 简体中文
    if n == "gbk" or n == "cp936" or n == "ms936" or n == "gb2312" or n == "gb-2312" or n == "csgb2312" or n == "x-gbk" or n == "gb_2312-80" { return 936 }
    if n == "gb18030" or n == "gb-18030" { return 54936 }
    if n == "hz-gb-2312" { return 52936 }
    // 繁体中文
    if n == "big5" or n == "big-5" or n == "cp950" or n == "csbig5" or n == "x-x-big5" { return 950 }
    // 日文
    if n == "shift-jis" or n == "shiftjis" or n == "sjis" or n == "cp932" or n == "ms-kanji" or n == "x-sjis" { return 932 }
    if n == "euc-jp" or n == "eucjp" or n == "cp51932" or n == "x-euc-jp" { return 51932 }
    if n == "iso-2022-jp" or n == "csiso2022jp" { return 50220 }
    // 韩文
    if n == "euc-kr" or n == "euckr" or n == "cp949" or n == "ks-c-5601-1987" or n == "ksc5601" or n == "ks-c-5601-1989" { return 949 }
    if n == "iso-2022-kr" { return 50225 }
    // 西欧 / 其他单字节
    if n == "iso-8859-1" or n == "iso8859-1" or n == "latin1" or n == "latin-1" or n == "cp819" or n == "iso-ir-100" { return 28591 }
    if n == "iso-8859-2" or n == "iso8859-2" or n == "latin2" or n == "latin-2" { return 28592 }
    if n == "iso-8859-3" or n == "latin3" { return 28593 }
    if n == "iso-8859-4" or n == "latin4" { return 28594 }
    if n == "iso-8859-5" { return 28595 }
    if n == "iso-8859-6" { return 28596 }
    if n == "iso-8859-7" { return 28597 }
    if n == "iso-8859-8" { return 28598 }
    if n == "iso-8859-9" or n == "latin5" { return 28599 }
    if n == "iso-8859-15" or n == "latin9" { return 28605 }
    if n == "windows-1250" or n == "cp1250" { return 1250 }
    if n == "windows-1251" or n == "cp1251" { return 1251 }
    if n == "windows-1252" or n == "cp1252" { return 1252 }
    if n == "windows-1253" or n == "cp1253" { return 1253 }
    if n == "windows-1254" or n == "cp1254" { return 1254 }
    if n == "windows-1255" or n == "cp1255" { return 1255 }
    if n == "windows-1256" or n == "cp1256" { return 1256 }
    if n == "windows-1257" or n == "cp1257" { return 1257 }
    if n == "windows-1258" or n == "cp1258" { return 1258 }
    if n == "koi8-r" or n == "koi8r" { return 20866 }
    if n == "koi8-u" { return 21866 }
    if n == "cp437" or n == "ibm437" { return 437 }
    if n == "cp850" or n == "ibm850" { return 850 }
    if n == "cp852" { return 852 }
    if n == "cp866" or n == "ibm866" { return 866 }
    // UTF-16 / UTF-32
    if n == "utf-16" or n == "utf16" or n == "utf-16le" or n == "ucs-2" { return 1200 }
    if n == "utf-16be" or n == "unicodefffe" { return 1201 }
    if n == "utf-32" or n == "utf-32le" { return 12000 }
    if n == "utf-32be" { return 12001 }
    return 0
}

// 该字符集名是否需要转码（utf-8/ascii/未知 ⇒ 不需要）
export func needsDecode(string charset): bool {
    string n = normalize(charset)
    if n == "" { return false }
    int cp = codepage(n)
    if cp == 0 { return false }
    return cp != CP_UTF8
}

// ==================== 探测 ====================

export func charsetFromBom(string body): string {
    int n = body.byte_len()
    if n >= 3 and _byteAt(body, 0) == 0xEF and _byteAt(body, 1) == 0xBB and _byteAt(body, 2) == 0xBF { return "utf-8" }
    if n >= 4 and _byteAt(body, 0) == 0xFF and _byteAt(body, 1) == 0xFE and _byteAt(body, 2) == 0 and _byteAt(body, 3) == 0 { return "utf-32le" }
    if n >= 4 and _byteAt(body, 0) == 0 and _byteAt(body, 1) == 0 and _byteAt(body, 2) == 0xFE and _byteAt(body, 3) == 0xFF { return "utf-32be" }
    if n >= 2 and _byteAt(body, 0) == 0xFF and _byteAt(body, 1) == 0xFE { return "utf-16le" }
    if n >= 2 and _byteAt(body, 0) == 0xFE and _byteAt(body, 1) == 0xFF { return "utf-16be" }
    return ""
}

// 从响应头 Content-Type 里取 charset
export func charsetFromContentType(string contentType): string {
    if contentType == "" { return "" }
    int p = _findCI(contentType, 0, contentType.byte_len(), "charset")
    if p < 0 { return "" }
    return normalize(_tokenAfter(contentType, p))
}

// 从正文前 8KB 的 <meta> 标签里取 charset
// ⚠ 只认「<meta ...> 标签内部」的 charset：GBK 的双字节尾字节可能落在 0x40~0x7E，
//   正文里随时会**碰巧**出现 "charset" 字样，全正文裸搜必误判（实测过）。
export func charsetFromMeta(string body): string {
    int total = body.byte_len()
    if total <= 0 { return "" }
    int window = 8192
    if total < window { window = total }
    int i = 0
    while i < window {
        int m = _findCI(body, i, window, "<meta")
        if m < 0 { break }
        int tagEnd = m
        while tagEnd < total and _byteAt(body, tagEnd) != 62 { tagEnd = tagEnd + 1 }   // 62 = '>'
        if tagEnd < total { tagEnd = tagEnd + 1 }
        int p = _findCI(body, m, tagEnd, "charset")
        if p >= 0 {
            string name = normalize(_tokenAfter(body, p))
            if name != "" { return name }
        }
        i = m + 5
    }
    return ""
}

// ---------- UTF-8 合法性 ----------
// ⚠ 不能用 Leno 逐字节循环：实测（2026-10-06）1MB 逐字节扫描 ≈ **38ms**，
//   每个响应都扫会拖垮爬虫。Windows 交给 C（MultiByteToWideChar + MB_ERR_INVALID_CHARS），
//   POSIX 交给 iconv，实在没有后端才退回"只扫前 8KB"。
export func isValidUtf8(string s): bool {
    int n = s.byte_len()
    if n == 0 { return true }
    if _os() == "windows" {
        k32_charset k = _k32Lib()
        if k != null {
            int r = k.MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, s, n, null, 0)
            return r > 0
        }
    } else {
        iconv_charset ic = _iconvLib()
        if ic != null {
            return _iconvIsValid(s, ic)
        }
    }
    int cap = 8192
    if n < cap { cap = n }
    return _validUtf8Scan(s, cap)
}

// 无后端时的兜底：只扫前 cap 个字节（ASCII 与多字节序列的基本校验）
func _validUtf8Scan(string s, int cap): bool {
    int i = 0
    while i < cap {
        int b = _byteAt(s, i)
        if b < 0x80 { i = i + 1 }
        else if b >= 0xC2 and b <= 0xDF {
            if i + 1 >= cap { return true }                  // 截断在窗口边界 ⇒ 不判错
            if not _cont(s, i + 1, 1) { return false }
            i = i + 2
        } else if b >= 0xE0 and b <= 0xEF {
            if i + 2 >= cap { return true }
            int b1 = _byteAt(s, i + 1)
            if b1 < 0x80 or b1 > 0xBF { return false }
            if b == 0xE0 and b1 < 0xA0 { return false }       // overlong
            if b == 0xED and b1 > 0x9F { return false }       // 代理区
            if not _cont(s, i + 2, 1) { return false }
            i = i + 3
        } else if b >= 0xF0 and b <= 0xF4 {
            if i + 3 >= cap { return true }
            int b1 = _byteAt(s, i + 1)
            if b1 < 0x80 or b1 > 0xBF { return false }
            if b == 0xF0 and b1 < 0x90 { return false }       // overlong
            if b == 0xF4 and b1 > 0x8F { return false }       // > U+10FFFF
            if not _cont(s, i + 2, 2) { return false }
            i = i + 4
        } else {
            return false
        }
    }
    return true
}

func _cont(string s, int start, int count): bool {
    for count to k {
        int b = _byteAt(s, start + k)
        if b < 0x80 or b > 0xBF { return false }
    }
    return true
}

// ---------- 文本类型判定 ----------
export func isTextual(string contentType): bool {
    if contentType == "" { return true }        // 没声明 ⇒ 当作可能含文本（HTML 页面常见）
    string c = contentType.to_lower()
    if c.starts_with("text/") { return true }
    if strings.has(c, "json") { return true }
    if strings.has(c, "xml") { return true }
    if strings.has(c, "javascript") { return true }
    if strings.has(c, "ecmascript") { return true }
    if strings.has(c, "x-www-form-urlencoded") { return true }
    if strings.has(c, "csv") { return true }
    return false
}

// 系统 ANSI 代码页对应的字符集名（"页面没声明编码"时的兜底，中文 Windows = gbk）
export func defaultCharset(): string {
    if _os() != "windows" { return "" }
    k32_charset k = _k32Lib()
    if k == null { return "" }
    int acp = k.GetACP()
    if acp == 936 { return "gbk" }
    if acp == 950 { return "big5" }
    if acp == 932 { return "shift-jis" }
    if acp == 949 { return "euc-kr" }
    if acp == 1250 { return "windows-1250" }
    if acp == 1251 { return "windows-1251" }
    if acp == 1252 { return "windows-1252" }
    if acp == 1254 { return "windows-1254" }
    if acp == 1256 { return "windows-1256" }
    if acp == 1257 { return "windows-1257" }
    if acp == 20866 { return "koi8-r" }
    if acp == 866 { return "cp866" }
    if acp == 437 { return "cp437" }
    if acp == 850 { return "cp850" }
    return ""
}

// 综合探测：BOM → Content-Type → <meta> → UTF-8 校验 → 系统 ANSI 兜底
// 返回小写字符集名；"" 表示"未声明且无法推断"（此时调用方应保持原始字节）
export func detect(string raw, string contentType): string {
    if raw.byte_len() <= 0 { return "" }
    string b = charsetFromBom(raw)
    if b != "" { return b }
    string c = charsetFromContentType(contentType)
    if c != "" { return c }
    string m = charsetFromMeta(raw)
    if m != "" { return m }
    if isValidUtf8(raw) { return "utf-8" }
    if isTextual(contentType) { return defaultCharset() }
    return ""
}

// ==================== 转码 ====================

// 去掉 UTF-16/32 的 BOM（转码后会原样带进结果，解析器不需要它）
func _stripWideBom(string s, int cp): string {
    int n = s.byte_len()
    if n < 2 { return s }
    int b0 = _byteAt(s, 0)
    int b1 = _byteAt(s, 1)
    if cp == 1200 and b0 == 0xFF and b1 == 0xFE {
        if n >= 4 and _byteAt(s, 2) == 0 and _byteAt(s, 3) == 0 { return s.byte_slice(4, n - 1) }
        return s.byte_slice(2, n - 1)
    }
    if cp == 1201 and b0 == 0xFE and b1 == 0xFF { return s.byte_slice(2, n - 1) }
    if cp == 12000 and n >= 4 and b0 == 0xFF and b1 == 0xFE { return s.byte_slice(4, n - 1) }
    if cp == 12001 and n >= 4 and b0 == 0 and b1 == 0 { return s.byte_slice(4, n - 1) }
    return s
}

// 把 raw（按 charset 编码的原始字节）转成 UTF-8
// 未知字符集 / 后端不可用 ⇒ 原样返回（不破坏内容）
export func decode(string raw, string charset): string {
    int n = raw.byte_len()
    if n <= 0 { return raw }
    string name = normalize(charset)
    if name == "" { return raw }
    int cp = codepage(name)
    if cp == 0 { return raw }
    if cp == CP_UTF8 {
        // UTF-8：只顺手去掉 BOM
        if n >= 3 and _byteAt(raw, 0) == 0xEF and _byteAt(raw, 1) == 0xBB and _byteAt(raw, 2) == 0xBF {
            return raw.byte_slice(3, n - 1)
        }
        return raw
    }
    string src = _stripWideBom(raw, cp)
    if _os() == "windows" {
        k32_charset k = _k32Lib()
        if k == null { return raw }
        return _winConvert(k, src, cp)
    }
    iconv_charset ic = _iconvLib()
    if ic == null { return raw }
    return _iconvConvert(ic, src, name)
}

// 一步到位：探测 + 转码（未声明且像 UTF-8 ⇒ 原样返回）
export func toUtf8(string raw, string contentType): string {
    string cs = detect(raw, contentType)
    if cs == "" { return raw }
    return decode(raw, cs)
}

// 反向：UTF-8 文本 → 目标字符集字节
// 用途：往 **GBK 站点提交表单/查询** 时，body 必须是 GBK 字节，
//       直接发 UTF-8 会被服务端按 GBK 解成乱码（搜索关键词、中文用户名尤其常见）。
export func encode(string text, string charset): string {
    int n = text.byte_len()
    if n <= 0 { return text }
    string name = normalize(charset)
    int cp = codepage(name)
    if cp == 0 or cp == CP_UTF8 { return text }
    if _os() == "windows" {
        k32_charset k = _k32Lib()
        if k == null { return text }
        return _winEncode(k, text, cp)
    }
    iconv_charset ic = _iconvLib()
    if ic == null { return text }
    return _iconvDo(ic, text, name, "UTF-8")
}

// 该字符集是否真的可用（后端存在且代码页已知）
export func canEncode(string charset): bool {
    int cp = codepage(charset)
    if cp == 0 or cp == CP_UTF8 { return true }
    return backend() != "none"
}


// ---------- Windows 后端 ----------
func _winConvert(k32_charset k, string src, int cp): string {
    int inLen = src.byte_len()
    if inLen <= 0 { return src }
    // ① 多字节 → UTF-16（先问长度）
    int wlen = k.MultiByteToWideChar(cp, 0, src, inLen, null, 0)
    if wlen <= 0 { return src }
    Ptr wbuf = ffi.malloc(wlen * 2 + 2)
    if wbuf == null { return src }
    int got = k.MultiByteToWideChar(cp, 0, src, inLen, wbuf, wlen)
    if got <= 0 {
        ffi.free(wbuf)
        return src
    }
    // ② UTF-16 → UTF-8
    string out = src
    int u8len = k.WideCharToMultiByte(CP_UTF8, 0, wbuf, got, null, 0, null, null)
    if u8len > 0 {
        Ptr ubuf = ffi.malloc(u8len + 1)
        if ubuf != null {
            int made = k.WideCharToMultiByte(CP_UTF8, 0, wbuf, got, ubuf, u8len, null, null)
            if made > 0 { out = ffi.read_string_n(ubuf, 0, made) }
            ffi.free(ubuf)
        }
    }
    ffi.free(wbuf)
    return out
}

// UTF-8 → 目标代码页（encode 的 Windows 实现；与 _winConvert 反向）
func _winEncode(k32_charset k, string src, int cp): string {
    int inLen = src.byte_len()
    if inLen <= 0 { return src }
    // ① UTF-8 → UTF-16（先问长度）
    int wlen = k.MultiByteToWideChar(CP_UTF8, 0, src, inLen, null, 0)
    if wlen <= 0 { return src }
    Ptr wbuf = ffi.malloc(wlen * 2 + 2)
    if wbuf == null { return src }
    int got = k.MultiByteToWideChar(CP_UTF8, 0, src, inLen, wbuf, wlen)
    if got <= 0 {
        ffi.free(wbuf)
        return src
    }
    // ② UTF-16 → 目标代码页
    string out = src
    int nlen = k.WideCharToMultiByte(cp, 0, wbuf, got, null, 0, null, null)
    if nlen > 0 {
        Ptr nbuf = ffi.malloc(nlen + 1)
        if nbuf != null {
            int made = k.WideCharToMultiByte(cp, 0, wbuf, got, nbuf, nlen, null, null)
            if made > 0 { out = ffi.read_string_n(nbuf, 0, made) }
            ffi.free(nbuf)
        }
    }
    ffi.free(wbuf)
    return out
}

// ---------- POSIX（iconv）后端 ----------
// ⚠ 本路径在 Windows 上无法执行 ⇒ 未经实测（维护者请在 Linux/macOS 上跑一遍
//   examples/tests/test_charset.leno 的"转码"段）。任何异常都退回原始字节。

// iconv 通用转换，返回 [结果, 是否成功]
// 成功 = iconv 未报错 **且** 输入被完整消费（inbytesleft == 0）⇒ 这个 `ok` 同时
// 被 isValidUtf8 复用来做 UTF-8 合法性校验（UTF-8 → UTF-8 的往返）。
// 失败时结果为原串（调用方据此退回原始字节，不破坏内容）。
func _iconvDoEx(iconv_charset ic, string src, string tocode, string fromcode): [string, bool] {
    int inLen = src.byte_len()
    if inLen <= 0 { return src, true }
    Ptr cd = ic.iconv_open(tocode, fromcode)
    if cd == null { return src, false }
    if ffi.ptr_to_int(cd) == ICONV_FAILED { return src, false }

    int outCap = inLen * 4 + 16
    Ptr inBuf = ffi.malloc(inLen + 1)
    Ptr outBuf = ffi.malloc(outCap)
    Ptr hIn = ffi.malloc(8)
    Ptr hInLeft = ffi.malloc(8)
    Ptr hOut = ffi.malloc(8)
    Ptr hOutLeft = ffi.malloc(8)
    string out = src
    bool ok = false
    if inBuf != null and outBuf != null and hIn != null and hInLeft != null and hOut != null and hOutLeft != null {
        ffi.write_string(inBuf, 0, src)
        ffi.write_ptr(hIn, 0, inBuf)
        ffi.write_int64(hInLeft, 0, inLen)
        ffi.write_ptr(hOut, 0, outBuf)
        ffi.write_int64(hOutLeft, 0, outCap)
        int rc = ic.iconv(cd, hIn, hInLeft, hOut, hOutLeft)
        if rc != ICONV_FAILED {
            int left = ffi.read_int64(hOutLeft, 0)
            int made = outCap - left
            ok = ffi.read_int64(hInLeft, 0) == 0
            if made > 0 { out = ffi.read_string_n(outBuf, 0, made) }
        }
    }
    if inBuf != null { ffi.free(inBuf) }
    if outBuf != null { ffi.free(outBuf) }
    if hIn != null { ffi.free(hIn) }
    if hInLeft != null { ffi.free(hInLeft) }
    if hOut != null { ffi.free(hOut) }
    if hOutLeft != null { ffi.free(hOutLeft) }
    ic.iconv_close(cd)
    return out, ok
}

func _iconvDo(iconv_charset ic, string src, string tocode, string fromcode): string {
    var[string, bool](out, ok) = _iconvDoEx(ic, src, tocode, fromcode)
    return out
}

// 目标字符集 → UTF-8（decode 的 POSIX 实现）
func _iconvConvert(iconv_charset ic, string src, string name): string {
    return _iconvDo(ic, src, "UTF-8", name)
}

// UTF-8 合法性（POSIX）
// ⚠ 只把 `ok == true` 当作"确定合法"；`ok == false` 时**再退回窗口内字节扫描**复核，
//   避免 iconv 本身不可用（iconv_open 失败）时把合法 UTF-8 误判成非法
//   —— 误判会触发"按系统 ANSI 解码"，反而把好内容搞坏。
func _iconvIsValid(string s, iconv_charset ic): bool {
    var[string, bool](out, ok) = _iconvDoEx(ic, s, "UTF-8", "UTF-8")
    if ok { return true }
    int n = s.byte_len()
    int cap = 8192
    if n < cap { cap = n }
    return _validUtf8Scan(s, cap)
}
