// web_html.leno — LenoWeb HTML 解析器（纯 Leno 实现）
// 使用模块级全局变量管理解析状态
// 使用泛型类型 Array[string]/Dict[string,string] 提高类型安全性
// 支持：HTML 实体解码、DOCTYPE、CDATA、容错解析

import strings

// ==================== HtmlNode 结构 ====================
// 强类型 DOM 节点，替代旧的 Dict 表示
// tag 取值：普通元素为标签名(小写)；文本节点为 "#text"；文档根为 "#document"

export struct HtmlNode {
    string tag = 0
    Dict[string, string] attrs
    Array[HtmlNode] children
    string text = 0
    HtmlNode? _parent   // 父节点（根节点为 null），建树时由 _makeNode 设置；用 parent() 访问

    // 获取属性值（不存在返回空串）
    func attr(string name): string {
        return attrs.get(name, "")
    }

    // 判断是否有指定属性
    func hasAttr(string name): bool {
        return attrs.has(name)
    }

    // 直接文本内容（不含子节点）
    func text(): string {
        return text
    }

    // 是否文本节点
    func isTextNode(): bool {
        return tag == "#text"
    }

    // 是否元素节点（非文本/非文档根）
    func isElement(): bool {
        return tag != "#text" and tag != "#document"
    }

    // 标签名
    func tagName(): string {
        return tag
    }

    // 获取 class 列表
    func classes(): Array[string] {
        string c = attrs.get("class", "")
        Array[string] result = []
        if c == "" { return result }
        Array segs = c.split(" ")
        for segs.len() to i {
            if segs[i] != "" { result.add(segs[i]) }
        }
        return result
    }

    // 是否包含某 class
    func hasClass(string name): bool {
        Array cl = classes()
        for cl.len() to i {
            if cl[i] == name { return true }
        }
        return false
    }

    // 子节点数
    func childCount(): int {
        return children.len()
    }

    // 按选择器查询子元素（后代）
    // ⚠ 走模块级 `_selectFrom`，不要再在这里复制一份循环体 ——
    //   原先这里与模块级 select() 各有一份**逐字重复**的遍历，加组合器时
    //   很容易只改一处（另一处静默不同行为）。
    func select(string selector): Array[HtmlNode] {
        return _selectFrom(self, selector)
    }

    // 查询第一个匹配
    func selectOne(string selector): HtmlNode? {
        Array[HtmlNode] r = select(selector)
        if r.len() > 0 { return r[0] }
        return null
    }

    // 深度优先文本拼接
    func allText(): string {
        return _collectText(self)
    }

    // 移除匹配选择器的子节点，返回移除数量
    func remove(string selector): int {
        return removeElement(self, selector)
    }

    // ===== 向上查询 =====

    // 父节点（根节点返回 null）
    func parent(): HtmlNode? {
        return _parent
    }

    // 向上查找第一个匹配选择器的祖先（含自身），找不到返回 null
    func closest(string selector): HtmlNode? {
        HtmlNode? cur = self
        while cur != null {
            if _nodeMatches(cur, selector) {
                return cur
            }
            cur = cur._parent
        }
        return null
    }

    // 所有兄弟节点（不含自身）
    func siblings(): Array[HtmlNode] {
        Array[HtmlNode] result = []
        if _parent == null {
            return result
        }
        Array[HtmlNode] bros = _parent.children
        for bros.len() to i {
            if bros[i] != self {
                result.add(bros[i])
            }
        }
        return result
    }

    // 下一个兄弟节点（不存在返回 null）
    func nextSibling(): HtmlNode? {
        if _parent == null {
            return null
        }
        Array[HtmlNode] bros = _parent.children
        for bros.len() to i {
            if bros[i] == self {
                if i + 1 < bros.len() {
                    return bros[i + 1]
                }
                break
            }
        }
        return null
    }

    // 上一个兄弟节点（不存在返回 null）
    func prevSibling(): HtmlNode? {
        if _parent == null {
            return null
        }
        Array[HtmlNode] bros = _parent.children
        for bros.len() to i {
            if bros[i] == self {
                if i - 1 >= 0 {
                    return bros[i - 1]
                }
                break
            }
        }
        return null
    }
}

// CSS 选择器的单个组成部分（tag / id / class / 属性 / 伪类）
export struct SelectorPart {
    string tag = 0
    string id = 0
    Array[string] classes
    string attrName = 0
    string attrValue = 0
    string attrOp = 0
    bool hasAttr = 0
    // 与**前一段**的关系（第一段无意义）：
    //   " " 后代   ">" 子元素   "+" 紧随其后的兄弟元素   "~" 之后的所有兄弟元素
    string comb = " "
    bool isChild = 0            // 兼容位：等价于 comb == ">"（_removeRec / closest 仍在读它）
    // 伪类：可叠加（`td:not(.x):first-child`）—— 按 CSS 语义**全部**满足才算匹配。
    // 原先只有单个 `pseudo`/`pseudoArg` 字段，写第二个伪类会把第一个**覆盖掉**（静默错）。
    Array[string] pseudos
    Array[string] pseudoArgs

    // 取第 i 个伪类的参数（无参 ⇒ ""）
    func pseudoArgAt(int i): string {
        if i < 0 or i >= pseudoArgs.len() { return "" }
        return pseudoArgs[i]
    }

    // 是否为纯通配/空选择器（匹配所有元素）
    func isWildcard(): bool {
        return tag == "" and id == "" and classes.len() == 0 and not hasAttr and pseudos.len() == 0
    }
}

// ==================== 解析上下文 ====================

// 解析器上下文：每次 parse 调用创建独立实例，保证多线程并发解析安全。
// 取代原先的模块级全局 _g_pos/_g_html（共享会导致多线程串台）。
struct _ParseCtx {
    string html = 0   // 当前解析的 HTML 文本
    int pos = 0       // 当前解析光标

    func byte(int off): int {
        if pos + off >= 0 and pos + off < html.byte_len() {
            return html.byte(pos + off)
        }
        return -1
    }
}

// ==================== 辅助函数 ====================

func _isAlpha(int b): bool {
    return (b >= 97 and b <= 122) or (b >= 65 and b <= 90)
}

func _isAlphaNum(int b): bool {
    return (b >= 97 and b <= 122) or (b >= 65 and b <= 90) or (b >= 48 and b <= 57)
}

func _isSpace(int b): bool {
    return b == 32 or b == 9 or b == 10 or b == 13
}

// ==================== 解析器 ====================

func _parseTagName(_ParseCtx ctx): string {
    // ★ 2026-10-03 收编：字节先收数组，末尾一趟 from_bytes ✓（tag 名很短，收益有限但口径统一）
    Array[int] tag_bytes = []
    while ctx.pos < ctx.html.byte_len(){
        int b = ctx.html.byte(ctx.pos)
        if _isAlphaNum(b) or b == 45 or b == 95 {
            tag_bytes.add(b)
            ctx.pos = ctx.pos + 1
        } else {
            break
        }
    }
    return strings.from_bytes(tag_bytes)
}

func _skipWs(_ParseCtx ctx) {
    while ctx.pos <  ctx.html.byte_len() {
        int b = ctx.html.byte(ctx.pos)
        if _isSpace(b) {
            ctx.pos = ctx.pos + 1
        } else {
            break
        }
    }
}

func _parseAttrs(_ParseCtx ctx): Dict[string, string] {
    Dict[string, string] attrs = {}
    int len = ctx.html.byte_len()
    while ctx.pos < len {
        while ctx.pos < len and _isSpace(ctx.html.byte(ctx.pos)) {
            ctx.pos = ctx.pos + 1
        }
        if ctx.pos >= len {
            break
        }
        int b = ctx.html.byte(ctx.pos)
        if b == 62 or b == 47 {
            break
        }
        // 跳过非法字符
        if b == 60 or b == 38 {
            ctx.pos = ctx.pos + 1
            continue
        }
        string name = ""
        // ★ 2026-10-03 收编：属性名先收字节，循环后物化 ✓（`name` 的声明保留在上方）
        Array[int] name_bytes = []
        while ctx.pos < len {
            int ch = ctx.html.byte(ctx.pos)
            if _isSpace(ch) or ch == 61 or ch == 62 or ch == 47 or ch == 60 or ch == 38 {
                break
            }
            name_bytes.add(ch)
            ctx.pos = ctx.pos + 1
        }
        name = strings.from_bytes(name_bytes)
        if name == "" {
            ctx.pos = ctx.pos + 1
            continue
        }
        // 属性名转小写
        name = name.to_lower()
        while ctx.pos < len and _isSpace(ctx.html.byte(ctx.pos)) {
            ctx.pos = ctx.pos + 1
        }
        string val = ""
        // ★ 2026-10-03 收编：属性值（本函数 2 处 `+= strings.char`，带引号/不带引号两条路）
        //   ⇒ 先收字节，两路走完在下面统一物化一次 ✓（属性值可能较长 ✓）
        Array[int] val_bytes = []
        if ctx.pos < len and ctx.html.byte(ctx.pos) == 61 {
            ctx.pos = ctx.pos + 1
            while ctx.pos < len and _isSpace(ctx.html.byte(ctx.pos)) {
                ctx.pos = ctx.pos + 1
            }
            int q = -1
            if ctx.pos < len {
                q = ctx.html.byte(ctx.pos)
            }
            if q == 34 or q == 39 {
                ctx.pos = ctx.pos + 1
                while ctx.pos < len {
                    int ch = ctx.html.byte(ctx.pos)
                    if ch == q {
                        ctx.pos = ctx.pos + 1
                        break
                    }
                    val_bytes.add(ch)
                    ctx.pos = ctx.pos + 1
                }
            } else {
                // 无引号属性值
                while ctx.pos < len {
                    int ch = ctx.html.byte(ctx.pos)
                    if _isSpace(ch) or ch == 62 or ch == 47 {
                        break
                    }
                    val_bytes.add(ch)
                    ctx.pos = ctx.pos + 1
                }
            }
            val = strings.from_bytes(val_bytes)
        } else {
            // 布尔属性：checked, disabled, selected 等
            // HTML 中布尔属性存在即表示 true，值设为属性名本身
            val = name
        }
        attrs[name] = val
    }
    return attrs
}

func _parseText(_ParseCtx ctx): string {
    // ★ 2026-10-03 收编：文本节点可达**较长**（正文）⇒ 字节先收数组，末尾一趟 from_bytes ✓
    Array[int] text_bytes = []
    int len = ctx.html.byte_len()
    while ctx.pos < len {
        int b = ctx.html.byte(ctx.pos)
        if b == 60 {
            break
        }
        text_bytes.add(b)
        ctx.pos = ctx.pos + 1
    }
    return strings.from_bytes(text_bytes)
}

// 判断是否为 void 标签（不需要闭合标签）
func _isVoidTag(string tagName): bool {
    // 用 in 简化多标签判断（void 元素：无内容、自闭合）
    return tagName in ["br", "hr", "img", "input", "meta", "link",
                       "area", "base", "col", "embed", "source", "track", "wbr"]
}

// ==================== HTML 实体解码 ====================

// 命名实体表：name → Unicode 码点（HTML5 的 2000+ 个实体里，实际会遇到的这 ~250 个）
//
// 为什么改成表：原先是一个 24 个 case 的 switch，`&hearts;` `&euro;` `&alpha;` 这类
// 常见实体全部落空 ⇒ **原样留在正文里**（<p>&hearts;</p> 取文本得到 "&hearts;"）。
//
// 覆盖范围：XML 基本 5 个 + ISO-8859-1 全集（96 个，含 `nbsp` 的正确语义 U+00A0）
//          + 排版标点/空格/方向符 + 货币 + 希腊字母 + 数学与箭头 + 常用符号。
// 不含：多码点实体（如 `&NotEqualTilde;` 是两个码点）与冷门符号 —— 命中不到时
//      仍按原样保留 `&name;`（与旧行为一致，不会吃掉内容）。
Dict[string, int] _NAMED_ENTITIES = {
    // --- XML/HTML 基本 ---
    "amp": 38, "lt": 60, "gt": 62, "quot": 34, "apos": 39,
    // --- ISO-8859-1（Latin-1）全集：160..255 ---
    "nbsp": 160, "iexcl": 161, "cent": 162, "pound": 163, "curren": 164, "yen": 165,
    "brvbar": 166, "sect": 167, "uml": 168, "copy": 169, "ordf": 170, "laquo": 171,
    "not": 172, "shy": 173, "reg": 174, "macr": 175, "deg": 176, "plusmn": 177,
    "sup2": 178, "sup3": 179, "acute": 180, "micro": 181, "para": 182, "middot": 183,
    "cedil": 184, "sup1": 185, "ordm": 186, "raquo": 187, "frac14": 188, "frac12": 189,
    "frac34": 190, "iquest": 191,
    "Agrave": 192, "Aacute": 193, "Acirc": 194, "Atilde": 195, "Auml": 196, "Aring": 197,
    "AElig": 198, "Ccedil": 199, "Egrave": 200, "Eacute": 201, "Ecirc": 202, "Euml": 203,
    "Igrave": 204, "Iacute": 205, "Icirc": 206, "Iuml": 207, "ETH": 208, "Ntilde": 209,
    "Ograve": 210, "Oacute": 211, "Ocirc": 212, "Otilde": 213, "Ouml": 214, "times": 215,
    "Oslash": 216, "Ugrave": 217, "Uacute": 218, "Ucirc": 219, "Uuml": 220, "Yacute": 221,
    "THORN": 222, "szlig": 223,
    "agrave": 224, "aacute": 225, "acirc": 226, "atilde": 227, "auml": 228, "aring": 229,
    "aelig": 230, "ccedil": 231, "egrave": 232, "eacute": 233, "ecirc": 234, "euml": 235,
    "igrave": 236, "iacute": 237, "icirc": 238, "iuml": 239, "eth": 240, "ntilde": 241,
    "ograve": 242, "oacute": 243, "ocirc": 244, "otilde": 245, "ouml": 246, "divide": 247,
    "oslash": 248, "ugrave": 249, "uacute": 250, "ucirc": 251, "uuml": 252, "yacute": 253,
    "thorn": 254, "yuml": 255,
    // --- 拉丁扩展 / 连字 ---
    "OElig": 338, "oelig": 339, "Scaron": 352, "scaron": 353, "Yuml": 376,
    "fnof": 402, "circ": 710, "tilde": 732,
    // --- 希腊字母 ---
    "Alpha": 913, "Beta": 914, "Gamma": 915, "Delta": 916, "Epsilon": 917, "Zeta": 918,
    "Eta": 919, "Theta": 920, "Iota": 921, "Kappa": 922, "Lambda": 923, "Mu": 924,
    "Nu": 925, "Xi": 926, "Omicron": 927, "Pi": 928, "Rho": 929, "Sigma": 931,
    "Tau": 932, "Upsilon": 933, "Phi": 934, "Chi": 935, "Psi": 936, "Omega": 937,
    "alpha": 945, "beta": 946, "gamma": 947, "delta": 948, "epsilon": 949, "zeta": 950,
    "eta": 951, "theta": 952, "iota": 953, "kappa": 954, "lambda": 955, "mu": 956,
    "nu": 957, "xi": 958, "omicron": 959, "pi": 960, "rho": 961, "sigmaf": 962,
    "sigma": 963, "tau": 964, "upsilon": 965, "phi": 966, "chi": 967, "psi": 968,
    "omega": 969, "thetasym": 977, "upsih": 978, "piv": 982,
    // --- 空格 / 方向 / 排版标点 ---
    "ensp": 8194, "emsp": 8195, "thinsp": 8201, "zwnj": 8204, "zwj": 8205,
    "lrm": 8206, "rlm": 8207, "ndash": 8211, "mdash": 8212, "lsquo": 8216,
    "rsquo": 8217, "sbquo": 8218, "ldquo": 8220, "rdquo": 8221, "bdquo": 8222,
    "dagger": 8224, "Dagger": 8225, "bull": 8226, "hellip": 8230, "permil": 8240,
    "prime": 8242, "Prime": 8243, "lsaquo": 8249, "rsaquo": 8250, "oline": 8254,
    "frasl": 8260, "euro": 8364,
    // --- 字母式符号 / 商标 ---
    "weierp": 8472, "image": 8465, "real": 8476, "trade": 8482, "alefsym": 8501,
    // --- 箭头 ---
    "larr": 8592, "uarr": 8593, "rarr": 8594, "darr": 8595, "harr": 8596,
    "crarr": 8629, "lArr": 8656, "uArr": 8657, "rArr": 8658, "dArr": 8659, "hArr": 8660,
    // --- 数学运算符 ---
    "forall": 8704, "part": 8706, "exist": 8707, "empty": 8709, "nabla": 8711,
    "isin": 8712, "notin": 8713, "ni": 8715, "prod": 8719, "sum": 8721,
    "minus": 8722, "lowast": 8727, "radic": 8730, "prop": 8733, "infin": 8734,
    "ang": 8736, "and": 8743, "or": 8744, "cap": 8745, "cup": 8746,
    "int": 8747, "there4": 8756, "sim": 8764, "cong": 8773, "asymp": 8776,
    "ne": 8800, "equiv": 8801, "le": 8804, "ge": 8805, "sub": 8834,
    "sup": 8835, "nsub": 8836, "sube": 8838, "supe": 8839, "oplus": 8853,
    "otimes": 8855, "perp": 8869, "sdot": 8901,
    // --- 括号 / 几何 / 扑克 ---
    "lceil": 8968, "rceil": 8969, "lfloor": 8970, "rfloor": 8971, "lang": 9001,
    "rang": 9002, "loz": 9674, "spades": 9824, "clubs": 9827, "hearts": 9829, "diams": 9830
}

func _namedEntity(string name): string {
    int cp = _NAMED_ENTITIES.get(name, 0)
    if cp <= 0 { return "" }
    return _codepointToUtf8(cp)
}

func _hexDigit(int ch): int {
    if ch >= 48 and ch <= 57 { return ch - 48 }
    if ch >= 65 and ch <= 70 { return ch - 55 }
    if ch >= 97 and ch <= 102 { return ch - 87 }
    return -1
}

func _codepointToUtf8(int cp): string {
    if cp <= 127 {
        return strings.char(cp)
    }
    if cp <= 2047 {
        int b1 = 192 + (cp / 64)
        int b2 = 128 + (cp % 64)
        return strings.char(b1) + strings.char(b2)
    }
    if cp <= 65535 {
        int b1 = 224 + (cp / 4096)
        int b2 = 128 + ((cp / 64) % 64)
        int b3 = 128 + (cp % 64)
        return strings.char(b1) + strings.char(b2) + strings.char(b3)
    }
    int b1 = 240 + (cp / 262144)
    int b2 = 128 + ((cp / 4096) % 64)
    int b3 = 128 + ((cp / 64) % 64)
    int b4 = 128 + (cp % 64)
    return strings.char(b1) + strings.char(b2) + strings.char(b3) + strings.char(b4)
}

func _decodeEntities(string text): string {
    // ★ 2026-10-03 收编：实体解码的产出可达**整篇文本** ⇒ 改成字节数组累积，末尾一趟 from_bytes ✓
    //   本函数同时有"追加字符串"的分支（解码出的实体 / `_codepointToUtf8`）⇒ 用 `to_bytes()`
    //   把那两处也并入同一字节数组 ✓（`from_bytes(a+b) == from_bytes(a) + from_bytes(b)`）
    Array[int] result_bytes = []
    int i = 0
    int len = text.byte_len()
    while i < len {
        int b = text.byte(i)
        if b == 38 {
            int savePos = i
            i = i + 1
            if i < len and text.byte(i) == 35 {
                i = i + 1
                int codepoint = 0
                if i < len and (text.byte(i) == 120 or text.byte(i) == 88) {
                    i = i + 1
                    while i < len {
                        int ch = text.byte(i)
                        if ch == 59 {
                            i = i + 1
                            break
                        }
                        int d = _hexDigit(ch)
                        if d < 0 { break }
                        codepoint = codepoint * 16 + d
                        i = i + 1
                    }
                } else {
                    while i < len {
                        int ch = text.byte(i)
                        if ch == 59 {
                            i = i + 1
                            break
                        }
                        if ch >= 48 and ch <= 57 {
                            codepoint = codepoint * 10 + (ch - 48)
                            i = i + 1
                        } else {
                            break
                        }
                    }
                }
                if codepoint > 0 and codepoint <= 1114111 {
                    for _codepointToUtf8(codepoint).to_bytes() to cb { result_bytes.add(cb) }
                } else {
                    i = savePos + 1
                    result_bytes.add(38)   // '&'（原 `strings.char(38)`）
                }
            } else {
                // ★ 2026-10-03 收编：实体名先收字节，循环后物化 ✓（实体名很短，口径统一）
                Array[int] name_bytes = []
                while i < len {
                    int ch = text.byte(i)
                    if ch == 59 {
                        i = i + 1
                        break
                    }
                    if ch == 38 or _isSpace(ch) or ch == 60 or ch == 62 {
                        break
                    }
                    name_bytes.add(ch)
                    i = i + 1
                }
                string name = strings.from_bytes(name_bytes)
                string decoded = _namedEntity(name)
                if decoded != "" {
                    for decoded.to_bytes() to db { result_bytes.add(db) }
                } else {
                    i = savePos + 1
                    result_bytes.add(38)   // '&'（原 `strings.char(38)`）
                }
            }
        } else {
            result_bytes.add(b)
            i = i + 1
        }
    }
    return strings.from_bytes(result_bytes)
}

// ==================== 元素解析 ====================

// 内部节点工厂：创建 HtmlNode，并给所有子节点设置 parent 指针
func _makeNode(string tag, Dict[string, string] attrs, Array[HtmlNode] children, string text): HtmlNode {
    HtmlNode n = new HtmlNode()
    n.tag = tag
    n.attrs = attrs
    n.children = children
    n.text = text
    // 为每个子节点回填 parent 指针（支持 parent()/closest() 向上查询）
    for children.len() to i {
        children[i]._parent = n
    }
    return n
}

func _parseElement(_ParseCtx ctx): HtmlNode? {
    int len = ctx.html.byte_len()
    if ctx.pos >= len {
        return null
    }
    if ctx.html.byte(ctx.pos) != 60 {
        return null
    }

    // 注释 <!-- ... -->
    if ctx.pos + 3 < len and ctx.html.byte(ctx.pos+1) == 33 and ctx.html.byte(ctx.pos+2) == 45 and ctx.html.byte(ctx.pos+3) == 45 {
        ctx.pos = ctx.pos + 4
        while ctx.pos < len {
            if ctx.html.byte(ctx.pos) == 45 and ctx.pos+2 < len and ctx.html.byte(ctx.pos+1) == 45 and ctx.html.byte(ctx.pos+2) == 62 {
                ctx.pos = ctx.pos + 3
                break
            }
            ctx.pos = ctx.pos + 1
        }
        return null
    }

    // CDATA <![CDATA[ ... ]]>
    if ctx.pos + 8 < len and ctx.html.byte(ctx.pos+1) == 33 and ctx.html.byte(ctx.pos+2) == 91 and ctx.html.byte(ctx.pos+3) == 67 and ctx.html.byte(ctx.pos+4) == 68 and ctx.html.byte(ctx.pos+5) == 65 and ctx.html.byte(ctx.pos+6) == 84 and ctx.html.byte(ctx.pos+7) == 65 and ctx.html.byte(ctx.pos+8) == 91 {
        ctx.pos = ctx.pos + 9
        // ★ 2026-10-03 收编：CDATA 内容先收字节，末尾一趟 `strings.from_bytes`（替代逐字符拼串的 O(n²)）✓
        //   等价性：0-255 全量 / 多字节文本 / 空数组对拍 0 分歧（accum_eq ✓）
        Array[int] cdata_bytes = []
        while ctx.pos < len {
            if ctx.pos + 2 < len and ctx.html.byte(ctx.pos) == 93 and ctx.html.byte(ctx.pos+1) == 93 and ctx.html.byte(ctx.pos+2) == 62 {
                ctx.pos = ctx.pos + 3
                break
            }
            cdata_bytes.add(ctx.html.byte(ctx.pos))
            ctx.pos = ctx.pos + 1
        }
        return _makeNode("#text", {}, [], strings.from_bytes(cdata_bytes))
    }

    // DOCTYPE / 其他声明 <!...>
    if ctx.pos + 1 < len and ctx.html.byte(ctx.pos+1) == 33 {
        ctx.pos = ctx.pos + 2
        while ctx.pos < len and ctx.html.byte(ctx.pos) != 62 {
            ctx.pos = ctx.pos + 1
        }
        if ctx.pos < len and ctx.html.byte(ctx.pos) == 62 {
            ctx.pos = ctx.pos + 1
        }
        return null
    }

    // 闭合标签 </...>
    if ctx.pos + 1 < len and ctx.html.byte(ctx.pos+1) == 47 {
        return null
    }

    ctx.pos = ctx.pos + 1

    string tagName = _parseTagName(ctx)
    if tagName == "" {
        return null
    }
    tagName = strings.to_lower(tagName)

    Dict[string, string] attrs = _parseAttrs(ctx)

    bool selfClosing = false
    if ctx.pos < len and ctx.html.byte(ctx.pos) == 47 {
        selfClosing = true
        ctx.pos = ctx.pos + 1
    }
    if ctx.pos < len and ctx.html.byte(ctx.pos) == 62 {
        ctx.pos = ctx.pos + 1
    }

    if selfClosing {
        return _makeNode(tagName, attrs, [], "")
    }

    if _isVoidTag(tagName) {
        return _makeNode(tagName, attrs, [], "")
    }

    // script/style 标签：原始内容直接读取
    if tagName == "script" or tagName == "style" {
        // ★ 2026-10-03 收编：script/style 的原始内容先收字节（本函数 2 处 `+= strings.char`），
        //   两个使用点（循环内提前 return / 循环后 return）各物化一次 ✓
        //   等价性：0-255 全量 / 多字节 / 空数组对拍 0 分歧（accum_eq ✓）
        Array[int] raw_bytes = []
        while ctx.pos < len {
            if ctx.html.byte(ctx.pos) == 60 and ctx.pos+1 < len and ctx.html.byte(ctx.pos+1) == 47 {
                int savePos = ctx.pos
                ctx.pos = ctx.pos + 2
                string closeTag = _parseTagName(ctx)
                closeTag = strings.to_lower(closeTag)
                if closeTag == tagName {
                    _parseAttrs(ctx)
                    if ctx.pos < len and ctx.html.byte(ctx.pos) == 62 {
                        ctx.pos = ctx.pos + 1
                    }
                    return _makeNode(tagName, attrs, [], strings.from_bytes(raw_bytes))
                } else {
                    ctx.pos = savePos
                    raw_bytes.add(ctx.html.byte(ctx.pos))
                    ctx.pos = ctx.pos + 1
                }
            } else {
                raw_bytes.add(ctx.html.byte(ctx.pos))
                ctx.pos = ctx.pos + 1
            }
        }
        return _makeNode(tagName, attrs, [], strings.from_bytes(raw_bytes))
    }

    // 普通标签
    Array[HtmlNode] children = []
    string textContent = ""

    while ctx.pos < len {
        if ctx.html.byte(ctx.pos) == 60 {
            if ctx.pos + 3 < len and ctx.html.byte(ctx.pos+1) == 33 and ctx.html.byte(ctx.pos+2) == 45 and ctx.html.byte(ctx.pos+3) == 45 {
                ctx.pos = ctx.pos + 4
                while ctx.pos < len {
                    if ctx.html.byte(ctx.pos) == 45 and ctx.pos+2 < len and ctx.html.byte(ctx.pos+1) == 45 and ctx.html.byte(ctx.pos+2) == 62 {
                        ctx.pos = ctx.pos + 3
                        break
                    }
                    ctx.pos = ctx.pos + 1
                }
                continue
            }
            // CDATA in body
            if ctx.pos + 8 < len and ctx.html.byte(ctx.pos+1) == 33 and ctx.html.byte(ctx.pos+2) == 91 and ctx.html.byte(ctx.pos+3) == 67 and ctx.html.byte(ctx.pos+4) == 68 and ctx.html.byte(ctx.pos+5) == 65 and ctx.html.byte(ctx.pos+6) == 84 and ctx.html.byte(ctx.pos+7) == 65 and ctx.html.byte(ctx.pos+8) == 91 {
                ctx.pos = ctx.pos + 9
                // ★ 2026-10-03 收编：CDATA 先收字节，循环后物化一次 ✓
                Array[int] cdata_bytes = []
                while ctx.pos < len {
                    if ctx.pos + 2 < len and ctx.html.byte(ctx.pos) == 93 and ctx.html.byte(ctx.pos+1) == 93 and ctx.html.byte(ctx.pos+2) == 62 {
                        ctx.pos = ctx.pos + 3
                        break
                    }
                    cdata_bytes.add(ctx.html.byte(ctx.pos))
                    ctx.pos = ctx.pos + 1
                }
                string cdata = strings.from_bytes(cdata_bytes)
                if cdata != "" {
                    textContent = textContent + cdata
                    children.add(_makeNode("#text", {}, [], cdata))
                }
                continue
            }
            if ctx.pos + 1 < len and ctx.html.byte(ctx.pos+1) == 47 {
                ctx.pos = ctx.pos + 2
                _parseTagName(ctx)
                while ctx.pos < len and ctx.html.byte(ctx.pos) != 62 {
                    ctx.pos = ctx.pos + 1
                }
                if ctx.pos < len and ctx.html.byte(ctx.pos) == 62 {
                    ctx.pos = ctx.pos + 1
                }
                break
            }
            if _parseElement(ctx) is HtmlNode => child {
                children.add(child)
            }
        } else {
            string text = _parseText(ctx)
            if text != "" {
                text = _decodeEntities(text)
                textContent = textContent + text
                children.add(_makeNode("#text", {}, [], text))
            }
        }
    }

    return _makeNode(tagName, attrs, children, textContent)
}

// ==================== 对外接口 ====================

export func parse(string html): HtmlNode {
    // 每次 parse 创建独立解析上下文，多线程并发解析互不干扰
    _ParseCtx ctx = new _ParseCtx()
    ctx.html = html
    ctx.pos = 0

    HtmlNode root = _makeNode("#document", {}, [], "")
    int len = ctx.html.byte_len()

    while ctx.pos < len {
        while ctx.pos < len and _isSpace(ctx.html.byte(ctx.pos)) {
            ctx.pos = ctx.pos + 1
        }
        if ctx.pos >= len {
            break
        }
        if ctx.html.byte(ctx.pos) == 60 {
            // 注释
            if ctx.pos + 3 < len and ctx.html.byte(ctx.pos+1) == 33 and ctx.html.byte(ctx.pos+2) == 45 and ctx.html.byte(ctx.pos+3) == 45 {
                ctx.pos = ctx.pos + 4
                while ctx.pos < len {
                    if ctx.html.byte(ctx.pos) == 45 and ctx.pos+2 < len and ctx.html.byte(ctx.pos+1) == 45 and ctx.html.byte(ctx.pos+2) == 62 {
                        ctx.pos = ctx.pos + 3
                        break
                    }
                    ctx.pos = ctx.pos + 1
                }
                continue
            }
            // DOCTYPE / CDATA / 其他声明
            if ctx.pos + 1 < len and ctx.html.byte(ctx.pos+1) == 33 {
                if ctx.pos + 8 < len and ctx.html.byte(ctx.pos+2) == 91 and ctx.html.byte(ctx.pos+3) == 67 and ctx.html.byte(ctx.pos+4) == 68 and ctx.html.byte(ctx.pos+5) == 65 and ctx.html.byte(ctx.pos+6) == 84 and ctx.html.byte(ctx.pos+7) == 65 and ctx.html.byte(ctx.pos+8) == 91 {
                    // CDATA
                    ctx.pos = ctx.pos + 9
                    // ★ 2026-10-03 收编：CDATA 先收字节，循环后物化一次 ✓
                    Array[int] cdata_bytes = []
                    while ctx.pos < len {
                        if ctx.pos + 2 < len and ctx.html.byte(ctx.pos) == 93 and ctx.html.byte(ctx.pos+1) == 93 and ctx.html.byte(ctx.pos+2) == 62 {
                            ctx.pos = ctx.pos + 3
                            break
                        }
                        cdata_bytes.add(ctx.html.byte(ctx.pos))
                        ctx.pos = ctx.pos + 1
                    }
                    string cdata = strings.from_bytes(cdata_bytes)
                    if cdata != "" {
                        root.children.add(_makeNode("#text", {}, [], cdata))
                    }
                    continue
                }
                // 其他 <!...> 跳过
                ctx.pos = ctx.pos + 2
                while ctx.pos < len and ctx.html.byte(ctx.pos) != 62 {
                    ctx.pos = ctx.pos + 1
                }
                if ctx.pos < len and ctx.html.byte(ctx.pos) == 62 {
                    ctx.pos = ctx.pos + 1
                }
                continue
            }
            // 闭合标签（忽略孤立的）
            if ctx.pos + 1 < len and ctx.html.byte(ctx.pos+1) == 47 {
                ctx.pos = ctx.pos + 2
                while ctx.pos < len and ctx.html.byte(ctx.pos) != 62 {
                    ctx.pos = ctx.pos + 1
                }
                if ctx.pos < len and ctx.html.byte(ctx.pos) == 62 {
                    ctx.pos = ctx.pos + 1
                }
                continue
            }
            if _parseElement(ctx) is HtmlNode => child {
                root.children.add(child)
            }
        } else {
            string text = _parseText(ctx)
            if text != "" {
                text = _decodeEntities(text)
                root.children.add(_makeNode("#text", {}, [], text))
            }
        }
    }

    return root
}

// ==================== 便捷函数 ====================

export func tag(HtmlNode node): string {
    return node.tag
}

export func text(HtmlNode node): string {
    return node.text
}

export func allText(HtmlNode node): string {
    return _collectText(node)
}

// 内部：深度优先收集文本（用数组收集 + join 缓冲，避免逐字节 O(n²) 拼接）
func _collectText(HtmlNode node): string {
    Array[string] parts = []
    _collectTextInto(node, parts)
    return strings.join(parts, "")
}

// 深度优先把文本片段加入 parts（收集完整字符串片段，join 时安全还原含中文）
func _collectTextInto(HtmlNode node, Array[string] parts) {
    if node.tag == "#text" {
        parts.add(node.text)
        return
    }
    for node.children.len() to i {
        _collectTextInto(node.children[i], parts)
    }
}

// 清洗文本：合并连续空白（含换行）为单个空格，去首尾空白
export func cleanText(string raw): string {
    if raw == "" {
        return ""
    }
    Array[string] out = []
    bool lastWasSpace = false
    int n = raw.byte_len()
    for 0:n-1 to i {
        int b = raw.byte(i)
        if _isSpace(b) {
            if not lastWasSpace {
                out.add(" ")
            }
            lastWasSpace = true
        } else {
            out.add(strings.char(b))
            lastWasSpace = false
        }
    }
    string result = strings.join(out, "")
    // 去首尾空白：**必须全程字节口径**。
    // 原实现是 `while result.len() > 0 and result.byte(result.len() - 1) == 32 { result = result.slice(...) }`：
    //   `result.len()` 是**字符数**、`result.byte(i)`/`byte_slice` 是**字节下标** ⇒ 中文文本上
    //   这个下标指到字符中间，判断失真；`slice` 又是字符口径 ⇒ 两个口径来回切，容易改错。
    int start = 0
    int end = result.byte_len()
    while start < end and result.byte(start) == 32 { start = start + 1 }
    while end > start and result.byte(end - 1) == 32 { end = end - 1 }
    return result.byte_slice(start, end)
}

// HTML 转可读纯文本（仿 html2text）：保留段落/标题/列表/换行结构
export func htmlToText(HtmlNode node): string {
    return _toText(node)
}

func _toText(HtmlNode node): string {
    Array[string] parts = []
    _toTextInto(node, parts)
    return strings.join(parts, "")
}

func _toTextInto(HtmlNode node, Array[string] parts) {
    string tag = node.tag
    // 文本节点
    if tag == "#text" {
        parts.add(node.text)
        return
    }
    // 块级标签：段落前后加换行
    if tag in ["p", "div", "section", "article", "header", "footer"] {
        parts.add("\n")
    }
    // 标题：前后空行，加 # 标记
    if tag == "h1" {
        parts.add("\n# ")
    } else if tag == "h2" {
        parts.add("\n## ")
    } else if tag == "h3" {
        parts.add("\n### ")
    } else if tag in ["h4", "h5", "h6"] {
        parts.add("\n#### ")
    }
    // 列表项：前缀 "- "
    if tag == "li" {
        parts.add("- ")
    }
    for node.children.len() to i {
        _toTextInto(node.children[i], parts)
    }
    // 块级结束换行
    if tag in ["p", "div", "li", "h1", "h2", "h3", "h4", "h5", "h6"] {
        parts.add("\n")
    }
}

// 去除 HTML 字符串中的所有标签，只保留文本（不解析 DOM，纯字符串处理）
// 例："<p>Hi <b>there</b></p>" -> "Hi there"
export func stripTags(string html): string {
    string out = ""
    int n = html.byte_len()
    bool inTag = false
    // ★ 2026-10-03 收编：非标签内容先收字节，末尾一趟 `strings.from_bytes`（替代逐字符拼串的 O(n²)）✓
    Array[int] out_bytes = []
    for 0:n-1 to i {
        int b = html.byte(i)
        if b == 60 {
            // <
            inTag = true
        } else if b == 62 {
            // >
            inTag = false
        } else {
            if not inTag {
                out_bytes.add(b)
            }
        }
    }
    out = strings.from_bytes(out_bytes)
    return cleanText(out)
}

// 提取节点内所有文本（去标签、合并空白），等价于 allText + cleanText
export func textContent(HtmlNode node): string {
    return cleanText(allText(node))
}

// 提取 HTML 中第一个表格为二维数组（每行=一行，每格=cleanText 后的文本）
// 每行中 th（表头单元格）排在前、td（数据单元格）排在后，与 pandas read_html 的"表头优先"语义一致
export func extractTable(HtmlNode root): Array[Array[string]] {
    Array[HtmlNode] tables = select(root, "table")
    Array[Array[string]] tableData = []
    if tables.len() > 0 {
        HtmlNode tbl = tables[0]
        Array[HtmlNode] rows = select(tbl, "tr")
        for rows.len() to i {
            HtmlNode tr = rows[i]
            Array[HtmlNode] thCells = select(tr, "th")
            Array[HtmlNode] cells = select(tr, "td")
            Array[string] rowData = []
            // 表头单元格在前
            for thCells.len() to j {
                rowData.add(cleanText(allText(thCells[j])))
            }
            // 数据单元格在后
            for cells.len() to j {
                rowData.add(cleanText(allText(cells[j])))
            }
            tableData.add(rowData)
        }
    }
    return tableData
}

export func attr(HtmlNode node, string name): string {
    string v = node.attrs.get(name, "")
    if v == "" { return "" }
    return _decodeEntities(v)
}

export func children(HtmlNode node): Array[HtmlNode] {
    return node.children
}

export func getLinks(string html): Array[string] {
    var root = parse(html)
    var links = []
    _collectLinks(root, links)
    return links
}

// 提取 HTML 的 <title> 文本（不存在返回空串）
export func getTitle(HtmlNode root): string {
    Array[HtmlNode] titles = select(root, "title")
    if titles.len() > 0 {
        return cleanText(allText(titles[0]))
    }
    return ""
}

// 提取 HTML 中 <meta> 标签的属性值（按 name 或 property 匹配，取 content 属性）
export func getMeta(HtmlNode root, string name): string {
    Array[HtmlNode] metas = select(root, "meta")
    for metas.len() to i {
        HtmlNode m = metas[i]
        string mname = attr(m, "name")
        if mname == "" {
            mname = attr(m, "property")
        }
        if mname == name {
            return attr(m, "content")
        }
    }
    return ""
}

// 提取 HTML 中所有 <meta> 标签为 Dict（name/property -> content）
export func getMetas(HtmlNode root): Dict {
    Dict result = {}
    Array[HtmlNode] metas = select(root, "meta")
    for metas.len() to i {
        HtmlNode m = metas[i]
        string mname = attr(m, "name")
        if mname == "" {
            mname = attr(m, "property")
        }
        if mname != "" {
            result[mname] = attr(m, "content")
        }
    }
    return result
}

// 从 DOM 中删除所有匹配 selector 的元素（修改传入的 root），返回删除个数
export func removeElement(HtmlNode root, string selector): int {
    Array[SelectorPart] sels = _splitSelector(selector)
    if sels.len() == 0 {
        return 0
    }
    return _removeRec(root, sels, 0, true)
}

// 从 node 的 children 中删除匹配选择器链 sels 的节点。
// matchIdx：当前要匹配的选择器段索引（从 0 开始，匹配到最后一段则删除）。
// allowDeep：当前段是否允许在未匹配节点的任意后代中继续查找（空格后代选择器为 true）。
// 支持多段层级选择器（"div span"、"div > span"、"div > section span"）。
func _removeRec(HtmlNode node, Array[SelectorPart] sels, int matchIdx, bool allowDeep): int {
    int removed = 0
    Array[HtmlNode] keep = []
    SelectorPart sel = sels[matchIdx]
    bool lastSeg = (matchIdx == sels.len() - 1)
    for node.children.len() to i {
        HtmlNode child = node.children[i]
        if _matchSimple(child, sel) {
            if lastSeg {
                // 匹配到选择器链末尾：删除该节点
                removed = removed + 1
            } else {
                // 匹配到中间段：进入 child 内部匹配下一段。
                // 下一段是否要求"直接子"决定后续递归能否深入非匹配节点的后代
                bool nextIsChild = sels[matchIdx + 1].isChild
                removed = removed + _removeRec(child, sels, matchIdx + 1, not nextIsChild)
                keep.add(child)
            }
        } else {
            keep.add(child)
            // 未匹配当前段：若当前段允许后代匹配（allowDeep），继续深入 child 后代找该段
            if allowDeep {
                removed = removed + _removeRec(child, sels, matchIdx, true)
            }
        }
    }
    node.children = keep
    return removed
}

// 提取 HTML 中表单字段为 Dict（name -> value），仿 BeautifulSoup 表单解析
// 支持 input/select/textarea，取 name 属性和 value/文本
export func extractForm(HtmlNode root): Dict {
    Dict result = {}
    Array[HtmlNode] inputs = select(root, "input")
    for inputs.len() to i {
        HtmlNode inp = inputs[i]
        string iname = attr(inp, "name")
        if iname != "" {
            string val = attr(inp, "value")
            if val == "" and attr(inp, "type") == "checkbox" {
                if attr(inp, "checked") != "" {
                    val = "on"
                }
            }
            result[iname] = val
        }
    }
    Array[HtmlNode] selects = select(root, "select")
    for selects.len() to i {
        HtmlNode sel = selects[i]
        string sname = attr(sel, "name")
        if sname != "" {
            Array[HtmlNode] options = select(sel, "option")
            string selVal = ""
            for options.len() to j {
                if attr(options[j], "selected") != "" {
                    selVal = cleanText(allText(options[j]))
                    break
                }
            }
            result[sname] = selVal
        }
    }
    Array[HtmlNode] textareas = select(root, "textarea")
    for textareas.len() to i {
        HtmlNode ta = textareas[i]
        string taname = attr(ta, "name")
        if taname != "" {
            result[taname] = cleanText(allText(ta))
        }
    }
    return result
}

// ==================== 便捷查询 API（仿 BeautifulSoup） ====================

// 按 id 查找节点，返回第一个匹配或 null
export func getElementById(HtmlNode root, string id): HtmlNode? {
    if id == "" {
        return null
    }
    Array[SelectorPart] parts = _splitSelector("#" + id)
    if parts.len() == 0 {
        return null
    }
    Array[HtmlNode] current = [root]
    for 0:parts.len()-1 to pi {
        SelectorPart p0 = parts[pi]
        Array[HtmlNode] next = []
        for current.len() to ci {
            _findDescendants(current[ci], p0, next)
        }
        current = next
    }
    if current.len() > 0 {
        return current[0]
    }
    return null
}

// 按标签名查找所有节点
export func getElementsByTag(HtmlNode root, string tagName): Array[HtmlNode] {
    return select(root, tagName)
}

// 按 class 名查找所有节点
export func getElementsByClass(HtmlNode root, string className): Array[HtmlNode] {
    if className == "" {
        return []
    }
    return select(root, "." + className)
}

// 通用查找：可按 tag/class/id 组合过滤（均为可选，传空串表示不过滤）
export func findAll(HtmlNode root, string tagName, string className, string idName): Array[HtmlNode] {
    Array[HtmlNode] all = []
    _findAllRec(root, tagName, className, idName, all)
    return all
}

func _findAllRec(HtmlNode node, string tagName, string className, string idName, Array[HtmlNode] results) {
    bool matched = true
    if tagName != "" {
        if node.tag != tagName {
            matched = false
        }
    }
    if matched and className != "" {
        if not _hasWord(attr(node, "class"), className) {
            matched = false
        }
    }
    if matched and idName != "" {
        if attr(node, "id") != idName {
            matched = false
        }
    }
    if matched {
        results.add(node)
    }
    for node.children.len() to ci {
        _findAllRec(node.children[ci], tagName, className, idName, results)
    }
}

func _collectLinks(HtmlNode node, Array[string] links) {
    if node.tag == "a" {
        string href = node.attrs.get("href", "")
        if href != "" {
            links.add(href)
        }
    }
    for node.children.len() to ci {
        _collectLinks(node.children[ci], links)
    }
}

// ==================== CSS 选择器 ====================

func _parseSimple(string selector): SelectorPart {
    SelectorPart r = new SelectorPart()
    r.tag = ""
    r.id = ""
    r.classes = []
    r.attrName = ""
    r.attrValue = ""
    r.attrOp = "="
    r.hasAttr = false
    r.comb = " "
    r.isChild = false
    r.pseudos = []
    r.pseudoArgs = []
    int i = 0
    int slen = selector.byte_len()

    while i < slen {
        int b = selector.byte(i)
        if _isAlphaNum(b) or b == 42 or b == 45 or b == 95 {
            r.tag = r.tag + strings.char(b)
            i = i + 1
        } else {
            break
        }
    }

    while i < slen {
        int b = selector.byte(i)
        if b == 46 {
            i = i + 1
            // ★ 2026-10-03 收编：类名先收字节，循环后物化 ✓（选择器 token 很短，收益有限但口径统一）
            Array[int] cls_bytes = []
            while i < slen {
                int ch = selector.byte(i)
                if ch == 46 or ch == 35 or ch == 91 or ch == 58 {
                    break
                }
                cls_bytes.add(ch)
                i = i + 1
            }
            r.classes.add(strings.from_bytes(cls_bytes))
        } else if b == 35 {
            i = i + 1
            // ★ 2026-10-03 收编：id 先收字节，循环后物化 ✓
            Array[int] id_bytes = []
            while i < slen {
                int ch = selector.byte(i)
                if ch == 46 or ch == 35 or ch == 91 or ch == 58 {
                    break
                }
                id_bytes.add(ch)
                i = i + 1
            }
            r.id = strings.from_bytes(id_bytes)
        } else if b == 91 {
            i = i + 1
            // ★ 2026-10-03 收编：属性名先收字节，循环后物化 ✓
            Array[int] attr_name_bytes = []
            while i < slen {
                int ch = selector.byte(i)
                // 61'=' 94'^' 36'$' 42'*' 126'~' 124'|' 93']' —— 都要在属性名处停下，
                // 否则 `[class~='x']` 会把 `~` 吃进属性名
                if ch == 61 or ch == 94 or ch == 36 or ch == 42 or ch == 93 or ch == 126 or ch == 124 {
                    break
                }
                attr_name_bytes.add(ch)
                i = i + 1
            }
            r.attrName = strings.from_bytes(attr_name_bytes)
            r.hasAttr = true
            r.attrOp = "="
            if i < slen {
                int op = selector.byte(i)
                if op == 61 {
                    // =
                    i = i + 1
                } else if op == 94 and i + 1 < slen and selector.byte(i + 1) == 61 {
                    // ^=
                    r.attrOp = "^="
                    i = i + 2
                } else if op == 36 and i + 1 < slen and selector.byte(i + 1) == 61 {
                    // $=
                    r.attrOp = "$="
                    i = i + 2
                } else if op == 42 and i + 1 < slen and selector.byte(i + 1) == 61 {
                    // *=
                    r.attrOp = "*="
                    i = i + 2
                } else if op == 126 and i + 1 < slen and selector.byte(i + 1) == 61 {
                    // ~= 空白分隔的词匹配（类名场景最常用）
                    r.attrOp = "~="
                    i = i + 2
                } else if op == 124 and i + 1 < slen and selector.byte(i + 1) == 61 {
                    // |= 值等于 x 或以 "x-" 开头（lang 场景）
                    r.attrOp = "|="
                    i = i + 2
                }
                if i <= slen and i - 1 < slen {
                    // 读取属性值：支持引号（'x' 或 "x"）和无引号，到 ] 为止
                    // ★ 2026-10-03 收编：属性值（引号 / 无引号两条路，本函数 2 处 `+= strings.char`）
                    //   ⇒ 先收字节，两路走完在 `r.attrValue = ...` 处统一物化一次 ✓
                    Array[int] attr_val_bytes = []
                    // 跳过 '=' 后的空白
                    while i < slen and _isSpace(selector.byte(i)) {
                        i = i + 1
                    }
                    if i < slen {
                        int q = selector.byte(i)
                        if q == 34 or q == 39 {
                            // 引号包裹的值：读引号内容（遇相同引号结束）
                            i = i + 1
                            while i < slen {
                                int ch = selector.byte(i)
                                if ch == q {
                                    i = i + 1
                                    break
                                }
                                if ch == 93 {
                                    break
                                }
                                attr_val_bytes.add(ch)
                                i = i + 1
                            }
                        } else {
                            // 无引号：读到 ] 或空白为止
                            while i < slen {
                                int ch = selector.byte(i)
                                if ch == 93 {
                                    break
                                }
                                attr_val_bytes.add(ch)
                                i = i + 1
                            }
                        }
                    }
                    r.attrValue = strings.from_bytes(attr_val_bytes)
                }
            }
            if i < slen and selector.byte(i) == 93 {
                i = i + 1
            }
        } else if b == 58 {
            // 伪类：可叠加（`:not(.a):first-child`）⇒ 追加到数组，而不是覆盖单个字段
            i = i + 1
            Array[int] pseudo_bytes = []
            while i < slen {
                int ch = selector.byte(i)
                if ch == 40 or ch == 46 or ch == 35 or ch == 91 or ch == 58 or ch == 62 or ch == 43 or ch == 126 {
                    break
                }
                pseudo_bytes.add(ch)
                i = i + 1
            }
            string pname = strings.from_bytes(pseudo_bytes)
            string parg = ""
            if i < slen and selector.byte(i) == 40 {
                i = i + 1
                // 参数里可能有**嵌套括号**（`:not(:nth-child(2))`、`:has(a:not(.b))`）
                // ⇒ 必须按括号配平收，只认第一个 ')' 会把参数截断成半截选择器。
                Array[int] arg_bytes = []
                int depth = 1
                while i < slen {
                    int ch = selector.byte(i)
                    if ch == 40 {
                        depth = depth + 1
                    } else if ch == 41 {
                        depth = depth - 1
                        if depth == 0 {
                            i = i + 1
                            break
                        }
                    }
                    arg_bytes.add(ch)
                    i = i + 1
                }
                parg = strings.from_bytes(arg_bytes)
            }
            if pname != "" {
                r.pseudos.add(pname)
                r.pseudoArgs.add(parg)
            }
        } else {
            break
        }
    }

    return r
}

// 拆分复合选择器为若干"段"，并给每段记下它与**前一段**的组合器。
//   " " 后代   ">" 子元素   "+" 紧随兄弟   "~" 后续兄弟
// ⚠ 两处"深度"都要跟：[ ] 属性选择器内部的空格不是分隔符；
//   ( ) 伪类参数内部的空格同样不是（`:not(.a .b)`、`:has(+ span)`）。
func _splitSelector(string selector): Array[SelectorPart] {
    Array[SelectorPart] parts = []
    int i = 0
    int slen = selector.byte_len()
    string pendingComb = " "     // 作用于**下一个** flush 出来的段
    int bracketDepth = 0
    int parenDepth = 0

    Array[int] current_bytes = []
    while i < slen {
        int b = selector.byte(i)
        if b == 91 {   // '[' 进入属性选择器
            bracketDepth = bracketDepth + 1
            current_bytes.add(b)
            i = i + 1
        } else if b == 93 {   // ']' 离开属性选择器
            if bracketDepth > 0 { bracketDepth = bracketDepth - 1 }
            current_bytes.add(b)
            i = i + 1
        } else if b == 40 and bracketDepth == 0 {   // '('
            parenDepth = parenDepth + 1
            current_bytes.add(b)
            i = i + 1
        } else if b == 41 and bracketDepth == 0 {   // ')'
            if parenDepth > 0 { parenDepth = parenDepth - 1 }
            current_bytes.add(b)
            i = i + 1
        } else if (b == 62 or b == 43 or b == 126) and bracketDepth == 0 and parenDepth == 0 {
            // '>' / '+' / '~'：组合器（其后可能还有空格，不能把 pendingComb 冲掉）
            string seg = strings.from_bytes(current_bytes)
            current_bytes = []
            if seg != "" {
                parts.add(_partWithComb(seg, pendingComb))
            }
            pendingComb = strings.char(b)
            i = i + 1
        } else if _isSpace(b) and bracketDepth == 0 and parenDepth == 0 {
            string seg = strings.from_bytes(current_bytes)
            current_bytes = []
            if seg != "" {
                parts.add(_partWithComb(seg, pendingComb))
                pendingComb = " "     // 空白分隔 = 后代（只在真的收了一段后才复位）
            }
            i = i + 1
        } else {
            current_bytes.add(b)
            i = i + 1
        }
    }

    string tail = strings.from_bytes(current_bytes)
    if tail != "" {
        parts.add(_partWithComb(tail, pendingComb))
    }

    return parts
}

// 解析一段并设置它相对前一段的组合器（isChild 是给旧调用点留的兼容位）
func _partWithComb(string seg, string comb): SelectorPart {
    SelectorPart p = _parseSimple(seg)
    p.comb = comb
    p.isChild = (comb == ">")
    return p
}

func _hasWord(string str, string word): bool {
    if str == "" or word == "" {
        return false
    }
    int i = 0
    int slen = str.byte_len()
    while i < slen {
        while i < slen and _isSpace(str.byte(i)) {
            i = i + 1
        }
        // ★ 2026-10-03 收编：词先收字节，循环后物化 ✓
        Array[int] w_bytes = []
        while i < slen {
            int b = str.byte(i)
            if _isSpace(b) {
                break
            }
            w_bytes.add(b)
            i = i + 1
        }
        if strings.from_bytes(w_bytes) == word {
            return true
        }
    }
    return false
}

// ==================== 伪类匹配 ====================
// 位置参数一律按 **CSS 语义只数元素子节点**（`#text` 不计）。
// 传 `-1` 表示"拿不到父节点、无法判定位置" ⇒ 位置类伪类视为通过（不拦），
// 这与旧行为一致：宁可多匹配，也不要因为缺上下文而静默全不匹配。
func _matchPseudo(HtmlNode node, SelectorPart sel, int elemIdx, int elemTotal, int typeIdx, int typeTotal): bool {
    if sel.pseudos.len() == 0 { return true }
    for sel.pseudos.len() to pi {
        if not _matchOnePseudo(node, sel.pseudos[pi], sel.pseudoArgAt(pi), elemIdx, elemTotal, typeIdx, typeTotal) {
            return false
        }
    }
    return true
}

func _matchOnePseudo(HtmlNode node, string name, string arg, int elemIdx, int elemTotal, int typeIdx, int typeTotal): bool {
    switch name {
        case "first-child" { return elemIdx >= 0 and elemIdx == 0 }
        case "last-child" { return elemIdx >= 0 and elemIdx == elemTotal - 1 }
        case "only-child" { return elemIdx >= 0 and elemTotal == 1 }
        case "nth-child" { return _nthMatch(elemIdx, arg) }
        case "nth-last-child" { return elemIdx >= 0 and _nthMatch(elemTotal - 1 - elemIdx, arg) }
        case "first-of-type" { return typeIdx >= 0 and typeIdx == 0 }
        case "last-of-type" { return typeIdx >= 0 and typeIdx == typeTotal - 1 }
        case "only-of-type" { return typeIdx >= 0 and typeTotal == 1 }
        case "nth-of-type" { return _nthMatch(typeIdx, arg) }
        case "nth-last-of-type" { return typeIdx >= 0 and _nthMatch(typeTotal - 1 - typeIdx, arg) }
        case "empty" { return _isEmptyNode(node) }
        case "root" {
            var p = node.parent()
            return p == null or p.tag == "#document"
        }
        case "not" { return not _matchesAnchored(node, strings.trim(arg)) }
        case "has" { return _hasRelative(node, strings.trim(arg)) }
        // 未知伪类：不拦（与旧行为一致）—— 写错的伪类不会让整条选择器静默返回空
        default { return true }
    }
}

// `:empty`：没有元素子节点、也没有非空白文本
func _isEmptyNode(HtmlNode node): bool {
    for node.children.len() to i {
        HtmlNode c = node.children[i]
        if c.isElement() { return false }
        if c.text.trim() != "" { return false }
    }
    return true
}

// `:not(S)`：S 以 node 自身为锚求值（`S` 可以是复合段，如 `.a.b` / `:nth-child(2)`）
func _matchesAnchored(HtmlNode node, string selector): bool {
    if selector == "" { return false }
    Array[SelectorPart] parts = _splitSelector(selector)
    if parts.len() == 0 { return false }
    SelectorPart first = parts[0]
    if not _matchSimple(node, first) { return false }
    if not _matchesPseudoOf(node, first) { return false }
    if parts.len() == 1 { return true }
    // 其余段以 node 为起点继续收窄（`:not(div > .a)` 这类也能正确求值）
    Array[HtmlNode] cur = [node]
    for 1:parts.len()-1 to pi {
        Array[HtmlNode] next = []
        for cur.len() to ci { _collectRelated(cur[ci], parts[pi], next) }
        if next.len() == 0 { return false }
        cur = next
    }
    return true
}

// 用 node 自己的父节点算出位置参数后判伪类（供 closest 这类"只有单节点"的场景）
func _matchesPseudoOf(HtmlNode node, SelectorPart sel): bool {
    if sel.pseudos.len() == 0 { return true }
    var par = node.parent()
    if par == null {
        return _matchPseudo(node, sel, -1, -1, -1, -1)
    }
    int ci = _childIndexOf(par, node)
    if ci < 0 { return _matchPseudo(node, sel, -1, -1, -1, -1) }
    Array[int] st = _childStats(par, ci, node)
    return _matchPseudo(node, sel, st[0], st[1], st[2], st[3])
}

// node 在 parent.children 里的下标；找不到返回 -1
func _childIndexOf(HtmlNode parent, HtmlNode node): int {
    for parent.children.len() to i {
        if parent.children[i] == node { return i }   // struct 实例是引用语义 ⇒ 这比较可靠
    }
    return -1
}

// 位置统计（只数元素）：返回 [elemIdx, elemTotal, typeIdx, typeTotal]
// childIdx 为 node 在 children 里的下标
func _childStats(HtmlNode parent, int childIdx, HtmlNode node): Array[int] {
    int elemIdx = 0
    int elemTotal = 0
    int typeIdx = 0
    int typeTotal = 0
    for parent.children.len() to i {
        HtmlNode c = parent.children[i]
        if not c.isElement() { continue }
        elemTotal = elemTotal + 1
        bool sameType = (c.tag == node.tag)
        if sameType { typeTotal = typeTotal + 1 }
        if i < childIdx {
            elemIdx = elemIdx + 1
            if sameType { typeIdx = typeIdx + 1 }
        }
    }
    return [elemIdx, elemTotal, typeIdx, typeTotal]
}

// 解析 `:nth-child(...)` 的参数并判断"1 起的位置 pos"是否命中。
// 支持： `n` 整数、`odd`、`even`、`an+b`（含 `2n+1` / `-n+3` / `+2n-1` / 空格写法）。
// 参数非法 ⇒ 不匹配（不再抛异常：原先 `_int("2n+1")` 会直接**报错中断整次抓取**）。
func _nthMatch(int pos0, string arg): bool {
    if pos0 < 0 { return false }
    Array[int] ab = _parseAnB(arg)
    int a = ab[0]
    int b = ab[1]
    int k = pos0 + 1
    if a == 0 { return k == b }
    int d = k - b
    if a > 0 {
        if d < 0 { return false }
        return d % a == 0
    }
    if d > 0 { return false }
    return d % a == 0
}

// `an+b` → [a, b]；解析不了返回 [0, 0]（0 匹配不到任何正位置 ⇒ 等价"永不匹配"）
func _parseAnB(string arg): Array[int] {
    string s = strings.to_lower(strings.trim(arg))
    if s == "" { return [0, 0] }
    if s == "odd" { return [2, 1] }
    if s == "even" { return [2, 0] }
    int ni = strings.find(s, "n")
    if ni < 0 {
        return [0, _intDef(s, 0)]
    }
    // ⚠ 变量名不能用 `as`（类型转换关键字）与 `any`（类型名）
    string aPart = strings.trim(s.slice(0, ni))
    string bPart = strings.trim(s.slice(ni + 1, s.len()))
    int a = 1
    if aPart == "-" { a = -1 }
    else if aPart != "" and aPart != "+" { a = _intDef(aPart, 0) }
    int b = 0
    if bPart != "" { b = _intDef(bPart, 0) }
    return [a, b]
}

// 宽松整数解析（容许前导 '+'/'-'、前后空白，尾随垃圾则退化为"不匹配"用的 0/def）
func _intDef(string s, int def): int {
    string t = strings.trim(s)
    if t == "" { return def }
    bool neg = false
    int start = 0
    int b0 = t.byte(0)
    if b0 == 43 { start = 1 }          // '+'
    else if b0 == 45 { neg = true; start = 1 }   // '-'
    int v = 0
    bool seenDigit = false
    int lastIdx = t.byte_len() - 1
    for start:lastIdx to i {
        int b = t.byte(i)
        if b < 48 or b > 57 { break }
        v = v * 10 + (b - 48)
        seenDigit = true
    }
    if not seenDigit { return def }
    if neg { return -v }
    return v
}

// `:has(...)`：参数可带前导组合器（`> S` 子、`+ S` 紧随兄弟、`~ S` 后续兄弟），
// 否则按"有后代匹配 S"处理（最常用的形态）。
func _hasRelative(HtmlNode node, string arg): bool {
    if arg == "" { return false }
    int first = arg.byte(0)
    if first == 62 or first == 43 or first == 126 {
        string rest = strings.trim(arg.slice(1, arg.len()))
        if rest == "" { return false }
        if first == 62 {
            for node.children.len() to i {
                HtmlNode c = node.children[i]
                if c.isElement() and _matchesAnchored(c, rest) { return true }
            }
            return false
        }
        if first == 43 {
            var nxt = _nextElementSibling(node)
            if nxt == null { return false }
            return _matchesAnchored(nxt, rest)
        }
        Array[HtmlNode] after = _siblingsAfter(node)
        for after.len() to i {
            if _matchesAnchored(after[i], rest) { return true }
        }
        return false
    }
    return _selectFrom(node, arg).len() > 0
}

// node 之后的第一个元素兄弟（跳过 #text）
func _nextElementSibling(HtmlNode node): HtmlNode? {
    Array[HtmlNode] after = _siblingsAfter(node)
    if after.len() == 0 { return null }
    return after[0]
}

// node 之后的所有元素兄弟（按文档顺序）
func _siblingsAfter(HtmlNode node): Array[HtmlNode] {
    Array[HtmlNode] out = []
    var par = node.parent()
    if par == null { return out }
    int ci = _childIndexOf(par, node)
    if ci < 0 { return out }
    int from = ci + 1
    int toIdx = par.children.len() - 1
    for from:toIdx to i {
        HtmlNode c = par.children[i]
        if c.isElement() { out.add(c) }
    }
    return out
}

func _matchSimple(HtmlNode node, SelectorPart sel): bool {
    // tag
    if sel.tag != "" and sel.tag != "*" {
        if node.tag != sel.tag {
            return false
        }
    }

    // id
    if sel.id != "" {
        if node.attrs.get("id", "") != sel.id {
            return false
        }
    }

    // class
    string nodeClass = node.attrs.get("class", "")
    if nodeClass == "" {
        if sel.classes.len() > 0 {
            return false
        }
    } else {
        for sel.classes.len() to ci {
            if not _hasWord(nodeClass, sel.classes[ci]) {
                return false
            }
        }
    }

    // 属性
    if sel.hasAttr and sel.attrName != "" {
        string actual = node.attrs.get(sel.attrName, "")
        if sel.attrValue == "" {
            // ★ 存在性判断：`a[href]` 原先在这里**直接跳过**（外层 if 只看 hasAttr，
            //   而内层只在 attrValue != "" 时才比对）⇒ 没有该属性的元素也全部命中（静默错）。
            if not node.attrs.has(sel.attrName) {
                return false
            }
        } else {
            if sel.attrOp == "=" {
                if actual != sel.attrValue {
                    return false
                }
            } else if sel.attrOp == "^=" {
                if not actual.starts_with(sel.attrValue) {
                    return false
                }
            } else if sel.attrOp == "$=" {
                if not actual.ends_with(sel.attrValue) {
                    return false
                }
            } else if sel.attrOp == "*=" {
                if not actual.has(sel.attrValue) {
                    return false
                }
            } else if sel.attrOp == "~=" {
                // 空白分隔的词匹配：`[class~='x']` 命中 `class="a x b"`，且不会命中 `xy`
                if not _hasWord(actual, sel.attrValue) {
                    return false
                }
            } else if sel.attrOp == "|=" {
                // 等于 v 或以 "v-" 开头（`[lang|='zh']` 命中 zh / zh-CN）
                if actual != sel.attrValue and not actual.starts_with(sel.attrValue + "-") {
                    return false
                }
            } else {
                if actual != sel.attrValue {
                    return false
                }
            }
        }
    }

    return true
}

// 判断单个节点自身是否匹配选择器（供 HtmlNode.closest 使用）
func _nodeMatches(HtmlNode node, string selector): bool {
    Array[SelectorPart] parts = _splitSelector(selector)
    if parts.len() == 0 {
        return false
    }
    // 多段选择器（空格/>级联）用于祖先关系，单节点自身匹配只看最后一段
    SelectorPart last = parts[parts.len() - 1]
    return _matchSimple(node, last) and _matchesPseudoOf(node, last)
}

// "本段与上一段的组合器"只有这一处分派 —— select / HtmlNode.select / :has / :not 全走它，
// 避免各写一份 if（加组合器时漏改某处会变成静默的另一种语义）。
func _collectRelated(HtmlNode node, SelectorPart sel, Array[HtmlNode] out) {
    if sel.comb == ">" {
        _findDirectChildren(node, sel, out)
    } else if sel.comb == "+" {
        _findNextSibling(node, sel, out)
    } else if sel.comb == "~" {
        _findFollowingSiblings(node, sel, out)
    } else {
        _findDescendants(node, sel, out)
    }
}

// 单点匹配：先看自身（tag/id/class/attr），有伪类时再算兄弟统计喂位置类伪类
func _matchChild(HtmlNode parent, int childIdx, HtmlNode child, SelectorPart sel): bool {
    if not _matchSimple(child, sel) { return false }
    if sel.pseudos.len() == 0 { return true }
    Array[int] st = _childStats(parent, childIdx, child)
    return _matchPseudo(child, sel, st[0], st[1], st[2], st[3])
}

func _findDescendants(HtmlNode node, SelectorPart sel, Array[HtmlNode] results) {
    for node.children.len() to i {
        HtmlNode child = node.children[i]
        // 只匹配**元素**节点（CSS 选择器从不匹配文本节点；原先 `*` 会把 #text 也收进来）
        if child.isElement() and _matchChild(node, i, child, sel) {
            results.add(child)
        }
        _findDescendants(child, sel, results)
    }
}

func _findDirectChildren(HtmlNode node, SelectorPart sel, Array[HtmlNode] results) {
    for node.children.len() to i {
        HtmlNode child = node.children[i]
        if child.isElement() and _matchChild(node, i, child, sel) {
            results.add(child)
        }
    }
}

// 紧随其后的兄弟元素（`+`）
func _findNextSibling(HtmlNode node, SelectorPart sel, Array[HtmlNode] results) {
    var par = node.parent()
    if par == null { return }
    var nxt = _nextElementSibling(node)
    if nxt == null { return }
    int ci = _childIndexOf(par, nxt)
    if ci >= 0 and _matchChild(par, ci, nxt, sel) { results.add(nxt) }
}

// 之后的所有兄弟元素（`~`）
func _findFollowingSiblings(HtmlNode node, SelectorPart sel, Array[HtmlNode] results) {
    var par = node.parent()
    if par == null { return }
    Array[HtmlNode] after = _siblingsAfter(node)
    for after.len() to k {
        HtmlNode c = after[k]
        int ci = _childIndexOf(par, c)
        if ci >= 0 and _matchChild(par, ci, c, sel) { results.add(c) }
    }
}

// select 的唯一实现（模块级 select() 与 HtmlNode.select() 共用这一份）
func _selectFrom(HtmlNode root, string selector): Array[HtmlNode] {
    Array[SelectorPart] parts = _splitSelector(selector)
    if parts.len() == 0 {
        return []
    }
    Array[HtmlNode] current = [root]
    int partsLen = parts.len()
    // 是否需要去重：只有"后代（空格）/ 后续兄弟（~）"能从**多个**来源收出**同一个**节点。
    //   `>` 子元素与 `+` 紧随兄弟是**单射**：一个节点只有一个父、一个"前一个元素兄弟"
    //   ⇒ 不可能重复。单段选择器（`div.item`）更是每个节点只被访问一次。
    // 这么判断的意义在**性能**：`_dedupeNodes` 是 O(m²) 双层比较，660KB 文档上
    // `select("div.item")` 收到 4000 个结果时，它独占 132ms 里的 69ms（一半以上）。
    bool needDedupe = false
    for 0:partsLen-1 to pi {
        SelectorPart p0 = parts[pi]
        if pi > 0 and (p0.comb == " " or p0.comb == "~") {
            needDedupe = true
        }
        Array[HtmlNode] next = []
        for current.len() to ci {
            _collectRelated(current[ci], p0, next)
        }
        current = next
    }
    if not needDedupe {
        return current
    }
    return _dedupeNodes(current)
}

// 结果去重（保序）：`p ~ span` 里同一个 span 会被前面**多个** p 各命中一次，
// 不去重就会出现 ["B","D","D"] 这种重复项（CSS 的匹配集是集合语义）。
// ⚠ 这是 O(m²)（m = 结果数）—— 调用点已按"是否可能重复"过滤，不要无条件调用。
//   若将来 m 很大且确实需要去重，应改成一次性标记（如给节点打 visit 序号），
//   但节点是共享引用，标记需要配合清理，暂不做。
func _dedupeNodes(Array[HtmlNode] src): Array[HtmlNode] {
    Array[HtmlNode] out = []
    for src.len() to i {
        bool dup = false
        for out.len() to j {
            if out[j] == src[i] {
                dup = true
                break
            }
        }
        if not dup { out.add(src[i]) }
    }
    return out
}

export func select(HtmlNode root, string selector): Array[HtmlNode] {
    return _selectFrom(root, selector)
}

export func selectOne(HtmlNode root, string selector): HtmlNode? {
    Array[HtmlNode] results = select(root, selector)
    if results.len() > 0 {
        return results[0]
    }
    return null
}
