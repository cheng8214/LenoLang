// web_gzip.leno -- gzip/DEFLATE 解压（**已收编到 LenoCompress**，2026-10-17）
//
// 历史：这份实现 2026-10-06 写在这里，2026-10-17 抽成独立包 LenoCompress
//   （因为 LenoZip 也要裸 DEFLATE，归档不能反过来依赖 HTTP 模块）。
// 现在本文件只是**转发层**：函数名/签名完全不变，LenoWeb 内部与外部既有调用点
//   （Web.gunzip / web_net / web_crawler / examples/tests）零改动。
//
// ⚠ 依赖关系变了：LenoWeb 现在依赖 LenoCompress 存在（同在 leno_module 下）。
//   打包 LenoWeb 应用时两个包都要在；这比"两份 inflate 各自漂移"安全得多。
//
// 以后新增能力（例如 DEFLATE 压缩）只改 LenoCompress，这里按需转发。
import "Compress" as z
use z.GzipResult

// 看起来像 gzip 吗（魔数 1f 8b）
export func isGzip(string raw): bool { return z.isGzip(raw) }

// 裸 DEFLATE 流（RFC1951，无头无尾）
export func inflateRaw(string raw): GzipResult { return z.inflateRaw(raw) }

// zlib 流（RFC1950）
export func inflateZlib(string raw): GzipResult { return z.inflateZlib(raw) }

// gzip（RFC1952）
export func gunzip(string raw): GzipResult { return z.gunzip(raw) }

// RFC1951 码表自检（空串 = 正常）
export func rfcTableCheck(): string { return z.rfcTableCheck() }
