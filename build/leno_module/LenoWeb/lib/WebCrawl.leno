// WebCrawl.leno -- 爬虫入口（URL 工具 / robots / sitemap / Crawler）
//
// ★ 2026-11-09：从 `Web.leno` 拆出来。爬虫本身要发请求 ⇒ 仍会拉进
//   crawler(1585) + net(1699) + core(557)，比 `WebNet` 重；
//   但**只需要 URL 解析**（parseUrl / resolveUrl / domain）时也走这个入口，
//   不必为了几个 URL 函数把 CDP(1266) 和 WebSocket(533) 一起拉进来。
//
// 用法：import "WebCrawl" as web

import "web_curl_core.leno" as core
import "web_net.leno" as net
import "web_crawler.leno" as crawler

use crawler.(Url, Crawler, CrawlItem, Page, SitemapEntry, SitemapReport)
use net.(ProxyPool)

// ==================== URL 工具 ====================
export func parseUrl(string url): Url { return crawler.parseUrl(url) }
export func buildUrl(Url u): string { return crawler.buildUrl(u) }
export func buildUrlDict(Dict parts): string { return crawler.buildUrlDict(parts) }
export func domain(string url): string { return crawler.domain(url) }
export func baseUrl(string url): string { return crawler.baseUrl(url) }
export func resolveUrl(string base, string ref): string { return crawler.resolveUrl(base, ref) }
export func normalizeUrl(string url): string { return crawler.normalizeUrl(url) }
export func getQueryParam(string url, string key): string { return crawler.getQueryParam(url, key) }
export func stripQuery(string url): string { return crawler.stripQuery(url) }
export func urlParse(string url): Url { return crawler.urlParse(url) }
export func parseRobots(string text): Dict { return crawler.parseRobots(text) }
export func parseCrawlDelay(string robotsText, string userAgent): int { return crawler.parseCrawlDelay(robotsText, userAgent) }
export func isRobotsAllowed(string robotsText, string userAgent, string url): bool { return crawler.isRobotsAllowed(robotsText, userAgent, url) }
export func toCsv(Array[Array[string]] rows): string { return crawler.toCsv(rows) }
export func csvField(string v): string { return crawler.csvField(v) }
export func writeCsv(string path, Array[Array[string]] rows, Array[string] header, bool withBom = true): int { return crawler.writeCsv(path, rows, header, withBom) }
export func writeCsvRows(string path, Array[Array[string]] rows, bool withBom = true): int { return crawler.writeCsvRows(path, rows, withBom) }
export func parseSitemap(string xml): Array[string] { return crawler.parseSitemap(xml) }
export func parseSitemapEntries(string xml): Array[SitemapEntry] { return crawler.parseSitemapEntries(xml) }
export func parseSitemapIndex(string xml): Array[string] { return crawler.parseSitemapIndex(xml) }
export func isSitemapIndex(string xml): bool { return crawler.isSitemapIndex(xml) }
export func sitemapUrl(string baseUrl): string { return crawler.sitemapUrl(baseUrl) }
export func robotsUrl(string baseUrl): string { return crawler.robotsUrl(baseUrl) }
export func fetchRobots(string siteUrl, string userAgent): string { return crawler.fetchRobots(siteUrl, userAgent) }
export func fetchSitemapUrls(string siteUrl, string userAgent): Array[string] { return crawler.fetchSitemapUrls(siteUrl, userAgent) }
export func fetchSitemapUrlsDeep(string baseUrl, string userAgent, int maxDepth = 2, int maxSitemaps = 50): Array[string] { return crawler.fetchSitemapUrlsDeep(baseUrl, userAgent, maxDepth, maxSitemaps) }
export func fetchSitemapReport(string baseUrl, string userAgent, int maxDepth = 2, int maxSitemaps = 50): SitemapReport { return crawler.fetchSitemapReport(baseUrl, userAgent, maxDepth, maxSitemaps) }

// ==================== 爬虫框架 ====================
export func createCrawler(Dict config): Crawler { return crawler.createCrawler(config) }
export func setRobots(Crawler c, string robotsText) { c.setRobots(robotsText) }
export func start(Crawler c) { c.start() }
export func nextUrl(Crawler c): CrawlItem? { return c.nextUrl() }
export func markVisited(Crawler c, string url) { c.markVisited(url) }
export func enqueue(Crawler c, string url, int depth, int priority = 0) { c.enqueue(url, depth, priority) }
export func shouldStop(Crawler c): bool { return c.shouldStop() }
export func stop(Crawler c) { c.stop() }
export func fetchPage(string url, string user_agent): Page? { return crawler.fetchPage(url, user_agent) }
export func fetchPageVia(string url, string user_agent, string proxy): Page? { return crawler.fetchPageVia(url, user_agent, proxy) }
// 给爬虫挂代理池：之后用 Crawler.fetchItem(item) 抓取会自动轮换 + 回报成败
export func setProxyPool(Crawler c, ProxyPool pool) { c.setProxyPool(pool) }
export func extractLinks(Page page): Array[string] { return crawler.extractLinks(page) }

// 断点续爬：进度落盘 / 载入 / 从 state_path 续爬
export func saveState(Crawler c, string path) { c.saveState(path) }
export func loadState(Crawler c, string path): int { return c.loadState(path) }
export func resume(Crawler c): bool { return c.resume() }
