// web_generic.leno — LenoWeb 泛型工具库
// 提供 map/filter/reduce 函数式工具、Stack[T]、LinkedList[T]
// 供 LenoWeb 内部和用户代码使用
//
// ★ 2026-11-09（P2）：本文件原来的 `Result[T]` + `Ok`/`Err` **已删除** ——
//   它和标准的 `import "Result"` 是两份同义 API（而且字段口径还不一样：
//   这里 `ok` 默认 **true**、值字段叫 `data`，标准那份默认 false、叫 `val`）。
//   仓库内**零引用**（只有 Web.leno 的转发壳用到），所以直接收编，不再保留第二份。
//   要 Result 请写：
//       import "Result" as res
//       use res.(Result, Option)

// ============================================================================
// 2. map / filter / reduce — 函数式工具
// ============================================================================

// map: 将数组每个元素通过函数转换
export func map[T, U](Array[T] arr, func(T):U fn): Array[U] {
    Array[U] result = []
    for arr to item {
        result.add(fn(item))
    }
    return result
}

// filter: 过滤数组元素
export func filter[T](Array[T] arr, func(T):bool fn): Array[T] {
    Array[T] result = []
    for arr to item {
        if fn(item) {
            result.add(item)
        }
    }
    return result
}

// reduce: 将数组归约为单个值
export func reduce[T, U](Array[T] arr, U init, func(U, T):U fn): U {
    U acc = init
    for arr to item {
        acc = fn(acc, item)
    }
    return acc
}

// forEach: 遍历数组执行副作用
export func forEach[T](Array[T] arr, func(T) fn) {
    for arr to item {
        fn(item)
    }
}

// ============================================================================
// 3. Stack[T] — 指向 LenoContainers.Stack 的**别名**（名字保留，实现只有一份）
// ============================================================================
// 用 alias 而不是删掉：手写那份和 Containers.Stack **同名**，编译器的类型表全局按名字索引
// ⇒ 同时 import Web 与 Containers（或 SDL3，它内部用 Containers）就运行期报
//   「跨模块同名struct 'Stack' … 运行期只能保留一份 … 请给其中一个改名」（2026-11-24 实测，
//   LenoWeb 自己的 test 挂了 8/13）。别名指向同一类型 ⇒ 不再有两份同名 struct，名字照旧可用。
// ⚠ 语义随容器：长度 `len()`（不再有字段 `size`）、判空 `is_empty()`、空取**抛错**、没有 `init()`。
//   ★ 2026-11-25：先修了三个编译器问题才写得出这条别名（值别名误判 / new 丢模块前缀 /
//     跨模块别名没导出泛型形参名）。回归用例：assert/test_alias_generic_cross.leno。
import "Containers" as ct
export alias Stack[T] = ct.Stack[T]

// ---- 以下是 2026-11-24 的旧说明，保留作历史 ----
// 为什么删（和上面 Result 那次 2026-11-09 一模一样，这次还多一条硬性理由）：
//   ① 两份同义 API，而且**契约相反**：这里空取返回 null，Containers 里抛错；
//   ② 更致命：**同名 struct 冲突**。编译器的四张类型表**全局按名字索引**，只要用户
//      同时 import 了 Web 和 Containers（或者 SDL3 —— 它内部已用 Containers），
//      运行期就直接报：
//        「跨模块同名struct 'Stack' … 四张类型表全局只按名字索引、运行期只能保留一份
//          （保留先注册的定义）… 请给其中一个改名」
//      2026-11-24 实测：LenoWeb 自己的 test/ 齐刷刷挂掉（8/13 FAIL）就是这条。
//   所以留一份实现，用容器的：
//       import "Containers" as ct
//       var s = new ct.Stack[int]()
//       s.push(1); s.len(); s.is_empty(); s.pop()   // 空栈抛错（不返回 null）
//   ⚠ 破坏性变更：`use web.Stack` / `gen.Stack` / 字段 `size` / `init()` 都不再存在。

// ============================================================================
// 4. LinkedList[T] — 链表队列（大规模 URL 队列，O(1) 追加）
// ============================================================================

export struct ListNode[T] {
    T data
    ListNode? next = null
}

export struct LinkedList[T] {
    ListNode? head = null
    ListNode? tail = null
    int length = 0

    func init() {
        self.head = null
        self.tail = null
        self.length = 0
    }

    // 在尾部追加（O(1)）
    func append(T val) {
        ListNode[T] node = new ListNode[T](data=val)
        if self.tail == null {
            self.head = node
            self.tail = node
        } else {
            self.tail.next = node
            self.tail = node
        }
        self.length = self.length + 1
    }

    // 在头部插入（O(1)）
    func prepend(T val) {
        ListNode[T] node = new ListNode[T](data=val)
        if self.head == null {
            self.head = node
            self.tail = node
        } else {
            node.next = self.head
            self.head = node
        }
        self.length = self.length + 1
    }

    // 取出头部元素并移除（O(1)）
    func shift(): T {
        if self.head == null { return null }
        ListNode[T]? node = self.head
        self.head = self.head.next
        if self.head == null {
            self.tail = null
        }
        self.length = self.length - 1
        return node.data
    }

    // 查看头部元素（不移除）
    func first(): T {
        if self.head == null { return null }
        return self.head.data
    }

    // 查找元素
    func contains(T val): bool {
        ListNode? curr = self.head
        while curr != null {
            if curr.data == val { return true }
            curr = curr.next
        }
        return false
    }

    // 获取指定位置的元素
    func get(int index): T {
        if index < 0 or index >= self.length { return null }
        ListNode? curr = self.head
        int i = 0
        while i < index {
            curr = curr.next
            i = i + 1
        }
        return curr.data
    }

    // 转为数组
    func toArray(): Array[T] {
        Array[T] result = []
        ListNode? curr = self.head
        while curr != null {
            result.add(curr.data)
            curr = curr.next
        }
        return result
    }

    func isEmpty(): bool {
        return self.length == 0
    }
}
