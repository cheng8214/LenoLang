// WebHtml.leno -- HTML 解析入口（解析 / CSS 选择器 / 字符集 / gzip）
//
// ★ 2026-11-09：从 `Web.leno` 拆出来，只依赖 html(2008) + charset(614) + gzip(28)，
//   不拉 crawler / cdp / ws。纯解析场景（把一段 HTML 喂进来取字段）用这个最轻。
//
// 用法：import "WebHtml" as web

import "web_html.leno" as htmls
import "web_charset.leno" as charsets
import "web_gzip.leno" as gzip

import "Result" as res
use res.Result
use htmls.(HtmlNode)
use gzip.(Inflated)

// ==================== 字符集探测与转码 ====================
// body 已由 net 层自动转码成 UTF-8；这几个函数供"手动处理原始字节"的场景使用
export func charsetBackend(): string { return charsets.backend() }
export func detectCharset(string raw, string contentType): string { return charsets.detect(raw, contentType) }
export func decodeCharset(string raw, string charset): string { return charsets.decode(raw, charset) }
export func encodeCharset(string text, string charset): string { return charsets.encode(text, charset) }
export func charsetCanEncode(string charset): bool { return charsets.canEncode(charset) }
export func toUtf8(string raw, string contentType): string { return charsets.toUtf8(raw, contentType) }
export func isValidUtf8(string s): bool { return charsets.isValidUtf8(s) }
export func isTextual(string contentType): bool { return charsets.isTextual(contentType) }
export func defaultCharset(): string { return charsets.defaultCharset() }
export func codepage(string charset): int { return charsets.codepage(charset) }
export func normalizeCharset(string charset): string { return charsets.normalize(charset) }
export func charsetNeedsDecode(string charset): bool { return charsets.needsDecode(charset) }

// ==================== HTML 解析 ====================
export func parse(string html): HtmlNode { return htmls.parse(html) }
export func tag(HtmlNode node): string { return htmls.tag(node) }
export func text(HtmlNode node): string { return htmls.text(node) }
export func allText(HtmlNode node): string { return htmls.allText(node) }
export func cleanText(string raw): string { return htmls.cleanText(raw) }
export func extractTable(HtmlNode root): Array[Array[string]] { return htmls.extractTable(root) }
export func getTitle(HtmlNode root): string { return htmls.getTitle(root) }
export func getMeta(HtmlNode root, string name): string { return htmls.getMeta(root, name) }
export func getMetas(HtmlNode root): Dict { return htmls.getMetas(root) }
export func extractForm(HtmlNode root): Dict { return htmls.extractForm(root) }
export func htmlToText(HtmlNode node): string { return htmls.htmlToText(node) }
export func stripTags(string html): string { return htmls.stripTags(html) }
export func textContent(HtmlNode node): string { return htmls.textContent(node) }
export func removeElement(HtmlNode root, string selector): int { return htmls.removeElement(root, selector) }
export func attr(HtmlNode node, string name): string { return htmls.attr(node, name) }
export func children(HtmlNode node): Array[HtmlNode] { return htmls.children(node) }
export func getLinks(string html): Array[string] { return htmls.getLinks(html) }
export func select(HtmlNode root, string selector): Array[HtmlNode] { return htmls.select(root, selector) }
// 选择器 + 取值一步到位（2026-10-20）：批量取文本 / 批量取属性
export func selectText(HtmlNode root, string selector): Array[string] { return htmls.selectText(root, selector) }
export func selectAttr(HtmlNode root, string selector, string name): Array[string] {
    return htmls.selectAttr(root, selector, name)
}
export func selectOne(HtmlNode root, string selector): HtmlNode? { return htmls.selectOne(root, selector) }
export func getElementById(HtmlNode root, string id): HtmlNode? { return htmls.getElementById(root, id) }
export func getElementsByTag(HtmlNode root, string tagName): Array[HtmlNode] { return htmls.getElementsByTag(root, tagName) }
export func getElementsByClass(HtmlNode root, string className): Array[HtmlNode] { return htmls.getElementsByClass(root, className) }
export func findAll(HtmlNode root, string tagName, string className, string idName): Array[HtmlNode] { return htmls.findAll(root, tagName, className, idName) }


// ==================== gzip / DEFLATE 解压 ====================
// 纯 Leno 实现（零依赖）：解 `.gz`、解"响应体是 gzip 字节"的内容
export func gunzip(string raw): Result[Inflated] { return gzip.gunzip(raw) }
export func inflateRaw(string raw): Result[Inflated] { return gzip.inflateRaw(raw) }
export func isGzip(string raw): bool { return gzip.isGzip(raw) }
export func inflateZlib(string raw): Result[Inflated] { return gzip.inflateZlib(raw) }

