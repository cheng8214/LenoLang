// web_crawler.leno — LenoWeb 爬虫框架（URL 工具 + 队列爬取）
// 依赖 web_net.leno（HTTP）和 web_html.leno（HTML 解析）

import strings
import files
import times
import jsons
import "web_gzip.leno" as gzip     // 纯 Leno 的 gzip/DEFLATE 解压（.gz sitemap）
import "web_html.leno" as htmls
import "web_net.leno" as web_net
use web_net.(HttpClient, Response, createClient, ProxyPool)
use gzip.(GzipResult)
use htmls.(HtmlNode)

// ==================== 辅助转换 ====================
// 通用 any -> 具体类型安全转换（处理仍使用 Dict 的旧路径）

func _s(any v): string {
    if v is string { return v }
    return ""
}

func _i(any v): int {
    if v is int { return v }
    return 0
}

// ==================== Url 结构 ====================
// 强类型 URL，替代旧的 Dict 表示，提供完整的解析/重组/规范化能力

export struct Url {
    string scheme = 0      // 协议（http/https 等）
    string host = 0        // 主机名
    int port = 0           // 端口（-1 表示未显式指定）
    string path = 0        // 路径（默认 "/"）
    string query = 0       // 查询字符串（不含 ?）
    string fragment = 0    // 锚点（不含 #）
    bool isAbsolute = 0    // 是否为绝对 URL

    // 重新拼接为完整 URL 字符串
    func str(): string {
        if not isAbsolute {
            string rp = path
            if rp == "" { rp = "/" }
            return rp
        }
        string result = scheme + "://" + host
        if port > 0 and not ((scheme == "http" and port == 80) or (scheme == "https" and port == 443)) {
            result = result + ":" + format("%d", port)
        }
        string p = path
        if p == "" { p = "/" }
        result = result + p
        if query != "" { result = result + "?" + query }
        if fragment != "" { result = result + "#" + fragment }
        return result
    }

    // 是否使用默认端口
    func hasDefaultPort(): bool {
        if port <= 0 { return true }
        if scheme == "http" and port == 80 { return true }
        if scheme == "https" and port == 443 { return true }
        return false
    }

    // 默认端口号（未显式指定时）
    func defaultPort(): int {
        if scheme == "https" { return 443 }
        return 80
    }

    // 实际生效的端口号
    func effectivePort(): int {
        if port > 0 { return port }
        return defaultPort()
    }

    // 主机 + 端口（用于域限制）
    func authority(): string {
        string result = host
        if not hasDefaultPort() {
            result = result + ":" + format("%d", port)
        }
        return result
    }

    // 规范化路径（合并 ./ .. 等）
    func normalizedPath(): string {
        Array segs = []
        // ★ 2026-10-03 收编：原先逐字符 `cur = cur + strings.char(b)`（每轮重建整串 ⇒ O(n²) ✗）
        //   ⇒ 字节先收进数组，到"消费点"（分隔符处 / 循环结束）再一趟 `strings.from_bytes` ✓
        //   不变式：`cur == strings.from_bytes(cur_bytes)` 在每个消费点都成立 ✓
        //   （依据 from_bytes(a+b) == from_bytes(a) + from_bytes(b)）
        //   等价已证：0-255 全量 / 多字节文本 / 空数组逐一对拍 0 分歧（accum_eq 对拍 ✓）
        Array[int] cur_bytes = []
        string cur = ""
        int i = 0
        int plen = path.byte_len()
        while i < plen {
            int b = path.byte(i)
            if b == 47 {
                cur = strings.from_bytes(cur_bytes)
                cur_bytes = []
                if cur == ".." {
                    if segs.len() > 0 { segs = segs[:segs.len() - 1] }
                } else if cur != "." and cur != "" {
                    segs.add(cur)
                }
                cur = ""
            } else {
                cur_bytes.add(b)
            }
            i = i + 1
        }
        cur = strings.from_bytes(cur_bytes)
        cur_bytes = []
        if cur == ".." {
            if segs.len() > 0 { segs = segs[:segs.len() - 1] }
        } else if cur != "." and cur != "" {
            segs.add(cur)
        }
        string result = ""
        if path.byte_len() > 0 and path.byte(0) == 47 { result = "/" }
        result = result + strings.join(segs, "/")
        if path.byte_len() > 0 and path.byte(path.byte_len() - 1) == 47 and result != "/" {
            result = result + "/"
        }
        return result
    }

    // 去掉 query 和 fragment，返回纯路径 URL
    func withoutQuery(): Url {
        Url u = new Url()
        u.scheme = scheme
        u.host = host
        u.port = port
        u.path = path
        u.query = ""
        u.fragment = ""
        u.isAbsolute = isAbsolute
        return u
    }

    // 提取 query 中指定参数的值
    func queryParam(string key): string {
        if query == "" { return "" }
        int start = 0
        int qlen = query.len()
        while start <= qlen {
            int amp = strings.find(query.slice(start, qlen), "&")
            int segEnd = qlen
            if amp >= 0 { segEnd = start + amp }
            string seg = query.slice(start, segEnd)
            int eq = strings.find(seg, "=")
            string k = seg
            string v = ""
            if eq >= 0 {
                k = seg.slice(0, eq)
                v = seg.slice(eq + 1, seg.len())
            }
            if k == key { return v }
            if amp < 0 { break }
            start = segEnd + 1
        }
        return ""
    }

    // 拼接相对引用（类似 RFC 3986 resolve）
    func resolve(string ref): Url {
        if ref.byte_len() > 4 and ref.slice(0, 4).has("://") {
            return parseUrl(ref)
        }
        // 协议相对 //host/path
        if ref.byte_len() > 2 and ref.byte(0) == 47 and ref.byte(1) == 47 {
            return parseUrl(scheme + ":" + ref)
        }
        Url u = new Url()
        u.scheme = scheme
        u.host = host
        u.port = port
        u.isAbsolute = isAbsolute
        u.query = ""
        u.fragment = ""
        // 绝对路径引用
        if ref.byte_len() > 0 and ref.byte(0) == 47 {
            u.path = _collapsePath(ref)
        } else {
            // 相对路径：基于当前目录
            string base = normalizedPath()
            int lastSlash = -1
            int bi = 0
            while bi < base.byte_len() {
                if base.byte(bi) == 47 { lastSlash = bi }
                bi = bi + 1
            }
            string dir = "/"
            if lastSlash >= 0 { dir = base.slice(0, lastSlash + 1) }
            u.path = _collapsePath(dir + ref)
        }
        // 拆分 ref 中的 query/fragment
        int qi = strings.find(ref, "?")
        int fi = strings.find(ref, "#")
        string refNoFrag = ref
        if fi >= 0 {
            u.fragment = ref.slice(fi + 1, ref.byte_len())
            refNoFrag = ref.slice(0, fi)
        }
        if qi >= 0 {
            u.query = refNoFrag.slice(qi + 1, refNoFrag.len())
        }
        return u
    }

    // 规范化：小写 host、去 fragment、清理路径
    func normalize(): Url {
        Url u = new Url()
        u.scheme = strings.to_lower(scheme)
        u.host = strings.to_lower(host)
        u.port = port
        u.path = normalizedPath()
        u.query = query
        u.fragment = ""
        u.isAbsolute = isAbsolute
        return u
    }

    // 转为可读字符串
    func str2(): string { return str() }
}

// 内部辅助：路径规范化（无状态，供 Url.resolve 使用）
func _collapsePath(string path): string {
    Array segs = []
    // ★ 2026-10-03 收编：同 `Url.normalizedPath` —— 字节先收数组，消费点一趟 from_bytes ✓
    //   （不变式与等价性证据见上；`from_bytes(a+b) == from_bytes(a) + from_bytes(b)`）
    Array[int] cur_bytes = []
    string cur = ""
    int i = 0
    int plen = path.byte_len()
    while i < plen {
        int b = path.byte(i)
        if b == 47 {
            cur = strings.from_bytes(cur_bytes)
            cur_bytes = []
            if cur == ".." {
                if segs.len() > 0 { segs = segs[:segs.len() - 1] }
            } else if cur != "." and cur != "" {
                segs.add(cur)
            }
            cur = ""
        } else {
            cur_bytes.add(b)
        }
        i = i + 1
    }
    cur = strings.from_bytes(cur_bytes)
    cur_bytes = []
    if cur == ".." {
        if segs.len() > 0 { segs = segs[:segs.len() - 1] }
    } else if cur != "." and cur != "" {
        segs.add(cur)
    }
    string result = ""
    if path.byte_len() > 0 and path.byte(0) == 47 { result = "/" }
    result = result + strings.join(segs, "/")
    if path.byte_len() > 0 and path.byte(path.byte_len() - 1) == 47 and result != "/" {
        result = result + "/"
    }
    return result
}

// ==================== URL 解析 ====================
// 完整解析 URL，返回强类型 Url

export func parseUrl(string url): Url {
    Url u = new Url()
    u.scheme = ""
    u.host = ""
    u.port = -1
    u.path = "/"
    u.query = ""
    u.fragment = ""
    u.isAbsolute = false

    int len = url.len()
    int qi = strings.find(url, "?")
    int fi = strings.find(url, "#")
    // 分离 fragment
    string noFrag = url
    if fi >= 0 {
        u.fragment = url.slice(fi + 1, len)
        noFrag = url.slice(0, fi)
    }
    // 分离 query
    string noQuery = noFrag
    if qi >= 0 {
        u.query = noFrag.slice(qi + 1, noFrag.len())
        noQuery = noFrag.slice(0, qi)
    }
    // 解析 scheme://host[:port]/path
    // ★ 2026-10-03 收编：scheme 先收字节，循环后一趟 `strings.from_bytes`（替代逐字符拼串的 O(n²)）✓
    int pos = 0
    Array[int] scheme_bytes = []
    while pos < noQuery.byte_len() and noQuery.byte(pos) != 58 {
        scheme_bytes.add(noQuery.byte(pos))
        pos = pos + 1
    }
    // ⚠ 保留局部 `scheme`：后面 `else if scheme != "" and pos >= noQuery.byte_len()` 还要用它 ✓
    string scheme = strings.from_bytes(scheme_bytes)
    u.scheme = scheme
    if pos + 2 < noQuery.byte_len() and noQuery.byte(pos) == 58 and noQuery.byte(pos + 1) == 47 and noQuery.byte(pos + 2) == 47 {
        u.isAbsolute = true
        pos = pos + 3
        // ★ 2026-10-03 收编：host 先收字节，循环后一趟 `strings.from_bytes` ✓
        Array[int] host_bytes = []
        while pos < noQuery.byte_len() {
            int b = noQuery.byte(pos)
            if b == 58 or b == 47 { break }
            host_bytes.add(b)
            pos = pos + 1
        }
        u.host = strings.from_bytes(host_bytes)
        if pos < noQuery.byte_len() and noQuery.byte(pos) == 58 {
            pos = pos + 1
            int port = 0
            while pos < noQuery.byte_len() {
                int b = noQuery.byte(pos)
                if b >= 48 and b <= 57 {
                    port = port * 10 + (b - 48)
                    pos = pos + 1
                } else { break }
            }
            u.port = port
        }
        string path = "/"
        if pos < noQuery.byte_len() {
            path = noQuery.slice(pos, noQuery.byte_len())
        }
        if path == "" { path = "/" }
        u.path = path
    } else if scheme != "" and pos >= noQuery.byte_len() {
        // 只有 scheme，没有 //，视为相对/非标准
        u.isAbsolute = false
    } else {
        // 相对路径（无 scheme://）
        u.isAbsolute = false
        string p = noQuery
        if p == "" { p = "/" }
        u.path = p
        u.scheme = ""
    }
    return u
}

// ==================== CrawlItem / Page / Crawler 结构 ====================

// 队列项：待抓取的 URL 及其深度
export struct CrawlItem {
    string url = 0
    int depth = 0
    int priority = 0        // 越大越先出队（默认 0 ⇒ 先后顺序 = 入队顺序）
    int seq = 0             // 入队序号：同优先级按它做 FIFO 稳定排序（堆本身不稳定）

    func toString(): string {
        return url
    }
}

// 抓取的页面结果：URL + 状态码 + 原始 HTML + 解析后的 DOM
export struct Page {
    string url = 0
    int status = 0
    string body = 0
    HtmlNode html

    // 页面中所有链接（绝对 URL）
    func links(): Array[string] {
        return extractLinks(self)
    }

    // 页面标题
    func title(): string {
        return htmls.getTitle(html)
    }

    // 页面 meta 信息
    func metas(): Dict {
        return htmls.getMetas(html)
    }

    // 页面纯文本
    func text(): string {
        return htmls.allText(html)
    }
}

// 爬虫对象：状态 + 配置
export struct Crawler {
    Array[string] start_urls
    Array[string] allowed_domains
    int max_pages = 0
    int max_depth = 0
    int delay_ms = 0
    string user_agent = 0
    bool respect_robots = 0
    string robots_rules = 0
    Dict[string, bool] visited
    Array[CrawlItem] queue                  // 二叉大顶堆（优先队列），见 _push/_pop
    int page_count = 0
    bool running = 0

    // ---- 内部状态（见各方法注释）----
    Dict[string, bool] _queued = {}        // 已入队集合：同一 URL 不重复入队
    int _seq = 0                           // 入队序号发号器（同优先级 FIFO）
    int crawl_delay_ms = 0                 // robots.txt 的 crawl-delay（毫秒）
    int _lastFetchMs = 0                   // 上次真正发起抓取的时刻
    ProxyPool? pool = null                 // 代理池（设了它 ⇒ fetchItem 自动轮换并回报成败）

    // 挂代理池：之后用 fetchItem() 抓取就会自动"取代理 → 抓 → 回报成败"
    func setProxyPool(ProxyPool p) {
        pool = p
    }

    // 抓一页（推荐入口）：有池子就自动轮换 + 回报成败。
    // 返回 null 有两类原因，调用方都能区分：
    //   · pool 里全在冷却 ⇒ 本次**不抓**（避免用已被封的 IP 硬打）；`pool.available() == 0` 可判定
    //   · 请求失败 ⇒ 已计入该代理的失败数（连续失败达阈值会自动冷却它）
    func fetchItem(CrawlItem item): Page? {
        if pool == null {
            return fetchPage(item.url, user_agent)
        }
        string p = pool.next()
        if p == "" { return null }
        Page? page = fetchPageVia(item.url, user_agent, p)
        if page == null {
            pool.reportFail(p)
        } else {
            pool.reportOk(p)
        }
        return page
    }

    // ---- 断点续爬 ----
    string state_path = ""                 // 非空 ⇒ 每 save_every 页自动把进度写到这里
    int save_every = 0                     // 0 = 不自动落盘

    // 设置 robots.txt 规则（顺带解析 crawl-delay）
    func setRobots(string robotsText) {
        robots_rules = robotsText
        crawl_delay_ms = parseCrawlDelay(robotsText, user_agent)
    }

    // 开始爬取：把 start_urls 入队
    func start() {
        running = true
        page_count = 0
        _seq = 0
        _lastFetchMs = 0
        for start_urls.len() to i {
            enqueue(start_urls[i], 0)
        }
    }

    // 实际生效的间隔：robots 的 crawl-delay 与用户 delay_ms 取较大者
    func effectiveDelay(): int {
        if crawl_delay_ms > delay_ms { return crawl_delay_ms }
        return delay_ms
    }

    // 限速：距上次抓取不足间隔就补睡（框架自动生效，不必用户在循环里手写 sleep）
    func throttle() {
        int d = effectiveDelay()
        if d <= 0 {
            _lastFetchMs = _nowMs()
            return
        }
        int elapsed = _nowMs() - _lastFetchMs
        if _lastFetchMs > 0 and elapsed < d {
            sleep(d - elapsed)
        }
        _lastFetchMs = _nowMs()
    }

    // 取出下一个待抓取的 URL（跳过已访问/超深/域名不符/robots 禁止）
    func nextUrl(): CrawlItem? {
        if not running { return null }
        while queue.len() > 0 {
            CrawlItem? popped = _pop()
            if popped == null { break }
            // 用**归一化后**的 URL 判重：同一页面的 #fragment / ./ 变体不应被当成两页
            string key = _normKey(popped.url)
            if visited.get(key, false) { continue }
            if popped.depth > max_depth { continue }
            if allowed_domains.len() > 0 {
                string d = domain(popped.url)
                if not allowed_domains.has(d) { continue }
            }
            if respect_robots and robots_rules != "" {
                if not isRobotsAllowed(robots_rules, user_agent, popped.url) {
                    continue
                }
            }
            throttle()
            return popped
        }
        return null
    }

    // ==================== 优先队列（二叉大顶堆）====================
    // 排序键：`priority` 大者先出；同优先级按 `seq`（入队先后）⇒ FIFO 稳定。
    // 为什么用堆：数组"排序插入"每次要搬移 O(n)，出队也要搬移；堆的入队/出队都是 O(log n)。
    // 队列规模上千时差别明显（爬虫的队列经常是上万条）。
    // 堆数组里没有"已出队的前缀"，所以 block saveState 直接把整个数组存下来即可。

    // i 是否应比 j 先出队
    func _higher(int i, int j): bool {
        if queue[i].priority != queue[j].priority {
            return queue[i].priority > queue[j].priority
        }
        return queue[i].seq < queue[j].seq
    }

    func _swap(int i, int j) {
        CrawlItem t = queue[i]
        queue[i] = queue[j]
        queue[j] = t
    }

    func _siftUp(int i) {
        while i > 0 {
            int p = (i - 1) / 2
            if not _higher(i, p) { break }
            _swap(i, p)
            i = p
        }
    }

    func _siftDown(int i) {
        int n = queue.len()
        while true {
            int l = i * 2 + 1
            int r = l + 1
            int best = i
            if l < n and _higher(l, best) { best = l }
            if r < n and _higher(r, best) { best = r }
            if best == i { break }
            _swap(i, best)
            i = best
        }
    }

    func _push(CrawlItem it) {
        queue.add(it)
        _siftUp(queue.len() - 1)
    }

    // 调用前请确保队列非空（空时返回 null）
    func _pop(): CrawlItem? {
        int n = queue.len()
        if n == 0 { return null }
        CrawlItem top = queue[0]
        CrawlItem last = queue[n - 1]
        queue.remove(n - 1)
        if queue.len() > 0 {
            queue[0] = last
            _siftDown(0)
        }
        return top
    }

    // 标记已访问（键为归一化 URL，与 nextUrl/enqueue 保持同一口径）
    func markVisited(string url) {
        visited[_normKey(url)] = true
        page_count = page_count + 1
        // 断点续爬：按间隔自动落盘（长跑任务中途挂掉也能接着爬）
        if state_path != "" and save_every > 0 {
            if page_count % save_every == 0 { saveState(state_path) }
        }
    }

    // ==================== 断点续爬 ====================

    // 保存进度到 JSON：已访问集合 + 待抓队列 + 已抓页数。
    // 队列存成 [url, depth, priority] 三元组 —— CrawlItem 是 struct 实例，
    // 直接塞进 JSON 不划算也没必要。（version 2 起是三元组；载入时兼容旧的二元组）
    //
    // ⚠ 导出顺序必须是**出队顺序**：堆数组的内部顺序是任意的（满足堆序即可），
    //   直接存数组、载入时按数组顺序重编号 seq ⇒ 同优先级的 FIFO 次序会被打乱
    //   （实测：存 [p2(pri9) p4(pri9) p1(pri0) p3(pri0)] 恢复成 p2,p4,p3,p1 ✗）。
    //   所以这里先把堆逐个弹出（得到真实抓取顺序），存完再原样压回去 ——
    //   saveState 不该破坏运行期状态。
    func saveState(string path) {
        Array[string] seen = visited.keys()
        Array[Array[any]] pending = []
        Array[CrawlItem] drained = []
        while queue.len() > 0 {
            CrawlItem? it = _pop()
            if it == null { break }
            drained.add(it)
            pending.add([it.url, it.depth, it.priority])
        }
        for drained.len() to i {
            _push(drained[i])
        }
        jsons.write_file(path, {
            version: 2,
            page_count: page_count,
            visited: seen,
            queue: pending
        })
    }

    // 载入进度：返回恢复的已抓页数；文件不存在 / 格式不对返回 -1。
    // 载入后即可直接 `while not c.shouldStop() { ... }` 继续（running 会被置 true）。
    func loadState(string path): int {
        if not files.exists(path) { return -1 }
        var data = null
        try {
            data = jsons.read_file(path)
        } catch e {
            return -1
        }
        if not (data is Dict) { return -1 }
        // 收窄到**带泛型参数的** Dict：裸 Dict 取出的元素仍是 any（见编译器提示）
        Dict[string, any] d = data as Dict[string, any]

        Dict[string, bool] newVisited = {}
        var seen = d["visited"]
        if seen is Array {
            for seen.len() to i {
                var u = seen[i]
                if u is string { newVisited[u] = true }
            }
        }

        Array[CrawlItem] restored = []
        Dict[string, bool] newQueued = {}
        int newSeq = 0
        var pending = d["queue"]
        if pending is Array {
            for pending.len() to i {
                var pair = pending[i]
                if pair is Array and pair.len() >= 2 {
                    var u = pair[0]
                    var dep = pair[1]
                    if u is string and dep is int {
                        CrawlItem it = newCrawlItem(u, dep)
                        // version 2 起存 [url, depth, priority]；旧存档是二元组 ⇒ priority 当 0
                        if pair.len() >= 3 {
                            var pr = pair[2]
                            if pr is int { it.priority = pr }
                        }
                        it.seq = newSeq
                        newSeq = newSeq + 1
                        restored.add(it)
                        newQueued[u] = true
                    }
                }
            }
        }

        visited = newVisited
        _queued = newQueued
        // 逐个 _push 重建堆（顺带恢复优先级次序；同优先级按存档顺序重新编号 FIFO）
        queue = []
        for restored.len() to i {
            _push(restored[i])
        }
        _seq = newSeq
        _lastFetchMs = 0
        var pc = d["page_count"]
        page_count = if pc is int then pc else 0
        running = true
        return page_count
    }

    // 从 state_path 续爬：有存档 ⇒ true（进度已恢复，直接继续循环即可）；
    // 无存档 ⇒ false（首次运行，请自行 start()）。
    func resume(): bool {
        if state_path == "" { return false }
        return loadState(state_path) >= 0
    }

    // 入队一个 URL（归一化 + 双重去重：已访问的不入、队列内已有的不入）
    // `priority` 越大越先被 nextUrl() 取出（默认 0 ⇒ 与入队顺序一致）。
    // 典型用法：详情页 priority=1、翻页 priority=-1 ⇒ 先把详情页吃完再翻页。
    func enqueue(string url, int depth, int priority = 0) {
        string u = _normKey(url)
        if visited.get(u, false) { return }
        if _queued.get(u, false) { return }
        if depth > max_depth { return }
        _queued[u] = true
        CrawlItem it = newCrawlItem(u, depth)
        it.priority = priority
        it.seq = _seq
        _seq = _seq + 1
        _push(it)
    }

    // 是否应停止
    func shouldStop(): bool {
        if not running { return true }
        if max_pages > 0 and page_count >= max_pages { return true }
        if queue.len() == 0 { return true }
        return false
    }

    // 停止爬取
    func stop() {
        running = false
    }
}

// 归一化 URL 并保证非空（normalizeUrl 异常时退回原串，避免整条链路被空串污染）
func _normKey(string url): string {
    string u = normalizeUrl(url)
    if u == "" { return url }
    return u
}

func _nowMs(): int {
    return _int(times.ms())
}

// 内部辅助：创建队列项
func newCrawlItem(string url, int depth): CrawlItem {
    CrawlItem item = new CrawlItem()
    item.url = url
    item.depth = depth
    return item
}

// 内部构造实现：从配置 Dict 初始化 Crawler
func _buildCrawler(Dict config): Crawler {
    Crawler c = new Crawler()
    c.start_urls = []
    c.allowed_domains = []
    c.max_pages = 100
    c.max_depth = 3
    c.delay_ms = 0
    c.user_agent = "LenoCrawler/1.0"
    c.respect_robots = false
    c.robots_rules = ""
    c.visited = {}
    c.queue = []
    c.page_count = 0
    c.running = false
    var v_start = config["start_urls"]
    if v_start is Array { c.start_urls = v_start }
    var v_allowed = config["allowed_domains"]
    if v_allowed is Array { c.allowed_domains = v_allowed }
    var v_pages = config["max_pages"]
    if v_pages is int { c.max_pages = v_pages }
    var v_depth = config["max_depth"]
    if v_depth is int { c.max_depth = v_depth }
    var v_delay = config["delay_ms"]
    if v_delay is int { c.delay_ms = v_delay }
    var v_ua = config["user_agent"]
    if v_ua is string { c.user_agent = v_ua }
    var v_robots = config["respect_robots"]
    if v_robots is bool { c.respect_robots = v_robots }
    // 断点续爬：给了 state_path 就打开自动落盘（save_every 缺省 50 页）
    var v_state = config["state_path"]
    if v_state is string { c.state_path = v_state }
    var v_every = config["save_every"]
    if v_every is int { c.save_every = v_every }
    if c.state_path != "" and c.save_every <= 0 { c.save_every = 50 }
    return c
}

// 完整解析 URL（等价于 parseUrl，返回强类型 Url）
export func urlParse(string url): Url {
    return parseUrl(url)
}

// 将 Url 对象重组为字符串
export func buildUrl(Url u): string {
    return u.str()
}

// 兼容层：buildUrlDict 接收旧的 Dict 表示（内部转 Url）
export func buildUrlDict(Dict parts): string {
    Url u = new Url()
    u.scheme = _s(parts["scheme"])
    u.host = _s(parts["host"])
    u.port = _i(parts["port"])
    u.path = _s(parts["path"])
    u.query = _s(parts["query"])
    u.fragment = _s(parts["fragment"])
    u.isAbsolute = true
    return u.str()
}

export func domain(string url): string {
    return parseUrl(url).host
}

export func baseUrl(string url): string {
    Url u = parseUrl(url)
    string path = u.path
    int lastSlash = -1
    int i = 0
    while i < path.byte_len() {
        if path.byte(i) == 47 { lastSlash = i }
        i = i + 1
    }
    string base = "/"
    if lastSlash > 0 { base = path[:lastSlash + 1] }
    Url b = new Url()
    b.scheme = u.scheme
    b.host = u.host
    b.port = u.port
    b.path = base
    b.query = ""
    b.fragment = ""
    b.isAbsolute = u.isAbsolute
    return b.str()
}

// 拼接相对引用（基于 Url struct 的 RFC3986 resolve）
export func resolveUrl(string base, string ref): string {
    return parseUrl(base).resolve(ref).str()
}

export func normalizeUrl(string url): string {
    return parseUrl(url).normalize().str()
}

// 提取 URL 中指定 query 参数的值，找不到返回空串
export func getQueryParam(string url, string key): string {
    int qi = strings.find(url, "?")
    if qi < 0 {
        return ""
    }
    // 截取 query 部分（去掉 fragment）
    int end = url.len()
    int fi = strings.find(url, "#")
    if fi >= 0 and fi > qi {
        end = fi
    }
    string qs = url.slice(qi + 1, end)
    // 按 & 分割各参数
    int start = 0
    int len = qs.len()
    while start <= len {
        int amp = strings.find(qs.slice(start, len), "&")
        int segEnd = len
        if amp >= 0 {
            segEnd = start + amp
        }
        string seg = qs.slice(start, segEnd)
        // 按 = 分割 key=value
        int eq = strings.find(seg, "=")
        string k = ""
        string v = ""
        if eq >= 0 {
            k = seg.slice(0, eq)
            v = seg.slice(eq + 1, seg.len())
        } else {
            k = seg
        }
        if k == key {
            return v
        }
        if amp < 0 {
            break
        }
        start = segEnd + 1
    }
    return ""
}

// 去掉 URL 的 query 和 fragment，返回纯净 URL
export func stripQuery(string url): string {
    int len = url.len()
    int end = len
    int qi = strings.find(url, "?")
    int fi = strings.find(url, "#")
    if qi >= 0 and (fi < 0 or qi < fi) {
        end = qi
    } else if fi >= 0 {
        end = fi
    }
    return url.slice(0, end)
}

// ==================== Robots.txt 解析 ====================

// 解析 robots.txt 文本，返回规则结构：
// {groups: [{user_agents: [...], allow: [...], disallow: [...]}]}
export func parseRobots(string text): Dict {
    var lines = strings.split(text, "\n")
    Array groups = []
    Dict[string, any] cur = {user_agents: [], allow: [], disallow: []}
    for lines to ln {
        string line = strings.trim(ln)
        if line == "" or line.starts_with("#") {
            continue
        }
        int ci = strings.find(line, ":")
        if ci < 0 {
            continue
        }
        string field = strings.to_lower(strings.trim(line.slice(0, ci)))
        string value = strings.trim(line.slice(ci + 1, line.len()))
        if field == "user-agent" {
            // 新一组
            var prevUas = cur["user_agents"]
            if prevUas is Array and prevUas.len() > 0 {
                groups.add(cur)
            }
            cur = {user_agents: [value], allow: [], disallow: []}
        } else if field == "allow" {
            if value != "" {
                var allows = cur["allow"]
                if allows is Array {
                    allows.add(value)
                }
            }
        } else if field == "disallow" {
            if value != "" {
                var disallows = cur["disallow"]
                if disallows is Array {
                    disallows.add(value)
                }
            }
        }
    }
    var lastUas = cur["user_agents"]
    if lastUas is Array and lastUas.len() > 0 {
        groups.add(cur)
    }
    return {groups: groups}
}

// 解析 robots.txt 的 crawl-delay（秒 → 毫秒）；没有则返回 0。
// 为什么单独一个函数：原实现只认 User-agent/Allow/Disallow，**忽略 crawl-delay**，
// 于是"尊重 robots"其实只尊重了黑名单、没尊重站长要求的抓取频率。
export func parseCrawlDelay(string robotsText, string userAgent): int {
    if robotsText == "" { return 0 }
    string ua = strings.to_lower(strings.trim(userAgent))
    var lines = strings.split(robotsText, "\n")
    int starDelay = 0
    int exactDelay = 0
    bool inStar = false
    bool inExact = false
    for lines to ln {
        string line = strings.trim(ln)
        if line == "" or line.starts_with("#") { continue }
        int ci = strings.find(line, ":")
        if ci < 0 { continue }
        string field = strings.to_lower(strings.trim(line.slice(0, ci)))
        string value = strings.trim(line.slice(ci + 1, line.len()))
        if field == "user-agent" {
            string v = strings.to_lower(value)
            inStar = (v == "*")
            inExact = (v == ua)
        } else if field == "crawl-delay" and value != "" {
            int ms = _secondsToMs(value)
            if ms > 0 {
                if inExact and exactDelay == 0 { exactDelay = ms }
                else if inStar and starDelay == 0 { starDelay = ms }
            }
        }
    }
    if exactDelay > 0 { return exactDelay }
    return starDelay
}

// "1" / "0.5" / "2.00" → 毫秒（非数字 ⇒ 0，不抛错：robots.txt 什么脏数据都有）
func _secondsToMs(string v): int {
    int dot = strings.find(v, ".")
    if dot < 0 {
        return _intOr0(v) * 1000
    }
    int ms = _intOr0(v.slice(0, dot)) * 1000
    string frac = v.slice(dot + 1, v.len())
    if frac.len() >= 1 { ms = ms + _intOr0(frac.slice(0, 1)) * 100 }
    if frac.len() >= 2 { ms = ms + _intOr0(frac.slice(1, 2)) * 10 }
    return ms
}

func _intOr0(string s): int {
    if not _allDigits(s) { return 0 }
    return _int(s)
}

func _allDigits(string s): bool {
    if s == "" { return false }
    for s.byte_len() to i {
        var b = s.byte(i)
        if b is int {
            if b < 48 or b > 57 { return false }
        }
    }
    return true
}

// 判断是否允许抓取 url。userAgent 不区分大小写，支持通配 *
func _robotsRuleMatch(string rule, string path): bool {
    // 支持 * 通配符的简单前缀匹配
    int star = strings.find(rule, "*")
    if star < 0 {
        return path.starts_with(rule)
    }
    string prefix = rule.slice(0, star)
    string suffix = rule.slice(star + 1, rule.len())
    if not path.starts_with(prefix) {
        return false
    }
    if suffix == "" {
        return true
    }
    return path.has(suffix)
}

// 从 URL 中提取用于 robots 匹配的路径
func _robotsPath(string url): string {
    string clean = stripQuery(url)
    int hi = strings.find(clean, "://")
    if hi < 0 {
        return clean
    }
    int slash = strings.find(clean.slice(hi + 3, clean.len()), "/")
    if slash < 0 {
        return "/"
    }
    string p = clean.slice(hi + 3 + slash, clean.len())
    if p == "" {
        p = "/"
    }
    return p
}

// 判断 robots.txt 是否允许抓取指定 URL
export func isRobotsAllowed(string robotsText, string userAgent, string url): bool {
    var parsed = parseRobots(robotsText)
    var groups = parsed["groups"]
    string ua = strings.to_lower(userAgent)
    string path = _robotsPath(url)

    // 查找最匹配的 UA 组（精确匹配优先，其次 *)
    Dict[string, any] selected = null
    bool selectedIsStar = false
    if groups is Array {
        for groups to g {
            if g is Dict[string, any] {
                var uas = g["user_agents"]
                if uas is Array {
                    for uas to gagent {
                        string gs = strings.to_lower(_str(gagent))
                        if gs == "*" {
                            if selected == null {
                                selected = g
                                selectedIsStar = true
                            }
                        } else if gs == ua {
                            selected = g
                            selectedIsStar = false
                        }
                    }
                }
            }
        }
    }
    if selected == null {
        return true
    }

    // 检查 Allow / Disallow 规则
    bool allowed = true
    var allows = selected["allow"]
    var disallows = selected["disallow"]

    // Disallow 命中即拒绝，除非 Allow 覆盖
    if disallows is Array {
        for disallows to rule {
            if _robotsRuleMatch(rule as string, path) {
                allowed = false
            }
        }
    }
    if allows is Array {
        for allows to rule {
            if _robotsRuleMatch(rule as string, path) {
                allowed = true
            }
        }
    }
    return allowed
}

// ==================== Sitemap.xml 解析 ====================
//
// 这里不引 XML 解析器（也没必要）：sitemap 的结构极简，按 `<url>` / `<sitemap>` 分块 + 取
// 子标签文本即可。全部用**字符口径**（`strings.find` / `slice`）—— 与 `xml.byte(i)` 那类
// 字节口径不可混用（这正是本模块 2026-10-06 修掉的那类 bug）。

// 一条 sitemap 记录（lastmod/changefreq/priority 是可选元数据，没有则为 ""）
export struct SitemapEntry {
    string url = 0
    string lastmod = 0
    string changefreq = 0
    string priority = 0
}

// 递归抓取 sitemap 的结果 + 诊断信息（不引入模块级状态 ⇒ 多线程安全）
export struct SitemapReport {
    Array[string] urls = []
    int sitemaps_fetched = 0       // 实际请求并解析的 sitemap 个数（含子 sitemap）
    int gzip_skipped = 0           // 解压失败而跳过的 .gz 个数（正常 .gz 由 web_gzip 解出，不计这里）
    Array[string] errors = []      // 每条形如 "URL：原因"
}

// 找 `<tag` 的位置：要求标签名后紧跟 '>' 或空白或 '/'，
// 否则 `<url>` 会误命中 `<urlset>`、`<sitemap>` 会误命中 `<sitemapindex>`。
// ⚠ 返回的是**字符**下标（与 find/slice 同一口径）。
func _findOpenTag(string xml, string tagName, int fromPos): int {
    string open = "<" + tagName
    int olen = open.len()
    int n = xml.len()
    int pos = fromPos
    while pos < n {
        int o = strings.find(xml.slice(pos, n), open)
        if o < 0 { return -1 }
        int absO = pos + o
        int after = absO + olen
        if after >= n { return -1 }
        string nxt = xml.slice(after, after + 1)
        if nxt == ">" or nxt == " " or nxt == "\t" or nxt == "\n" or nxt == "\r" or nxt == "/" {
            return absO
        }
        pos = absO + olen
    }
    return -1
}

// 切出所有 `<block ...> ... </block>` 的内容（不含标签本身）
func _xmlBlocks(string xml, string blockName): Array[string] {
    Array[string] blocks = []
    string close = "</" + blockName
    int n = xml.len()
    int pos = 0
    while pos < n {
        int absO = _findOpenTag(xml, blockName, pos)
        if absO < 0 { break }
        int gt = strings.find(xml.slice(absO, n), ">")
        if gt < 0 { break }
        int cs = absO + gt + 1
        int ce = strings.find(xml.slice(cs, n), close)
        if ce < 0 { break }
        blocks.add(xml.slice(cs, cs + ce))
        pos = cs + ce + close.len()
    }
    return blocks
}

// 取第一个 `<tag>内容</tag>` 的文本（去首尾空白；没有则 ""）。XML 标签区分大小写。
func _xmlText(string xml, string tagName): string {
    int absO = _findOpenTag(xml, tagName, 0)
    if absO < 0 { return "" }
    int n = xml.len()
    string close = "</" + tagName
    int gt = strings.find(xml.slice(absO, n), ">")
    if gt < 0 { return "" }
    int cs = absO + gt + 1
    int ce = strings.find(xml.slice(cs, n), close)
    if ce < 0 { return "" }
    return strings.trim(xml.slice(cs, cs + ce))
}

// 解析 sitemap 的所有 <url> 条目（含可选元数据）
export func parseSitemapEntries(string xml): Array[SitemapEntry] {
    Array[SitemapEntry] out = []
    Array[string] blocks = _xmlBlocks(xml, "url")
    for blocks.len() to i {
        string loc = _xmlText(blocks[i], "loc")
        if loc == "" { continue }
        SitemapEntry e = new SitemapEntry()
        e.url = loc
        e.lastmod = _xmlText(blocks[i], "lastmod")
        e.changefreq = _xmlText(blocks[i], "changefreq")
        e.priority = _xmlText(blocks[i], "priority")
        out.add(e)
    }
    return out
}

// 解析 sitemap.xml，提取所有 <loc> 中的 URL（只有地址，兼容旧接口）
export func parseSitemap(string xml): Array[string] {
    Array[string] urls = []
    Array[SitemapEntry] entries = parseSitemapEntries(xml)
    for entries.len() to i {
        urls.add(entries[i].url)
    }
    return urls
}

// 是否为 sitemapindex（子 sitemap 索引）
export func isSitemapIndex(string xml): bool {
    return _findOpenTag(xml, "sitemapindex", 0) >= 0
}

// 从 sitemapindex 取子 sitemap 的地址列表（<sitemap><loc>…）
export func parseSitemapIndex(string xml): Array[string] {
    Array[string] out = []
    Array[string] blocks = _xmlBlocks(xml, "sitemap")
    for blocks.len() to i {
        string loc = _xmlText(blocks[i], "loc")
        if loc != "" { out.add(loc) }
    }
    return out
}

// 看起来像 gzip 吗（魔数 1f 8b）
func _isGzipBody(string body): bool {
    if body.byte_len() < 2 { return false }
    return body.byte(0) == 31 and body.byte(1) == 139
}

// 站点的 sitemap 地址。baseUrl 本身就是 sitemap.xml/.gz 时原样返回。
export func sitemapUrl(string baseUrl): string {
    string clean = strings.trim(baseUrl)
    if clean.ends_with(".xml") or clean.ends_with(".xml.gz") or clean.ends_with(".gz") or clean.ends_with(".txt") {
        return clean
    }
    if clean.ends_with("/") {
        clean = clean.slice(0, clean.len() - 1)
    }
    return clean + "/sitemap.xml"
}

// 站点的 robots.txt 地址（原先是用 `sitemapUrl().replace("/sitemap.xml", "/robots.txt")` 拼的，
// sitemapUrl 一旦改成别的前缀就会失效 ⇒ 独立出来）
export func robotsUrl(string baseUrl): string {
    string clean = strings.trim(baseUrl)
    if clean.ends_with("/robots.txt") { return clean }
    if clean.ends_with("/") {
        clean = clean.slice(0, clean.len() - 1)
    }
    return clean + "/robots.txt"
}

// ==================== Crawler 核心 ====================

// ==================== Crawler 便捷组合函数 ====================

// 创建爬虫（构造函数，返回强类型 Crawler）
export func createCrawler(Dict config): Crawler {
    return _buildCrawler(config)
}

// 抓取页面，返回强类型 Page struct（失败返回 null）
export func fetchPage(string url, string user_agent): Page? {
    return fetchPageVia(url, user_agent, "")
}

// 抓取页面（走指定代理；proxy 传 "" ⇒ 直连）。
// 反爬场景用 Crawler.fetchItem 更省事：它会自动从池子取代理并回报成功/失败。
export func fetchPageVia(string url, string user_agent, string proxy): Page? {
    HttpClient c = createClient()
    c.setHeaders(["User-Agent: " + user_agent])
    if proxy != "" { c.setProxy(proxy) }
    Response resp = c.get(url)
    c.close()
    if not resp.ok() { return null }
    Page p = new Page()
    p.url = url
    p.status = resp.statusCode
    p.body = resp.body
    p.html = htmls.parse(resp.body)
    return p
}

// 提取页面中所有链接（绝对 URL）
export func extractLinks(Page page): Array[string] {
    Array[string] links = []
    Array[HtmlNode] allRaw = htmls.select(page.html, "a")
    for allRaw.len() to i {
        HtmlNode node = allRaw[i]
        string href = htmls.attr(node, "href")
        if href != "" { links.add(resolveUrl(page.url, href)) }
    }
    return links
}

// 从站点获取 robots.txt 文本（成功返回文本，失败返回空串）
export func fetchRobots(string siteUrl, string userAgent): string {
    HttpClient c = createClient()
    if userAgent != "" {
        c.setHeaders(["User-Agent: " + userAgent])
    }
    Response r = c.get(robotsUrl(siteUrl))
    c.close()
    if r.ok() {
        return r.body
    }
    return ""
}

// 递归抓取 sitemap 并汇总 URL，附带诊断信息。
//   baseUrl     ：站点根（也可直接给某个 sitemap.xml / sitemap_index.xml 地址）
//   maxDepth    ：索引下钻层数上限。0 = 只抓这一层（默认 2）
//   maxSitemaps ：最多请求几个 sitemap（默认 50，防止病态站点拖死）
//
// 行为说明：
//   · `sitemapindex` 会自动下钻到子 sitemap（去重 + 层数限制 + **同站点**限制，
//     按协议跨站子 sitemap 一律忽略 —— 否则一个第三方索引就能把爬虫引到任意站点）
//   · `.gz` 的 sitemap：响应的 `Content-Encoding: gzip` 由 libcurl 自动解掉；
//     拿到的字节**仍是 gzip 魔数**时（服务端按 `.gz` 静态文件返回、不带 Content-Encoding）
//     由 `web_gzip` 自己解（纯 Leno 实现，不需要 zlib）。真解不开才计入 `gzip_skipped`，
//     并且**不会**把压缩字节当 XML 解析出满屏乱码
//   · 单个 sitemap 抓失败不会中断整体：错误进 `errors`，继续抓其余
export func fetchSitemapReport(string baseUrl, string userAgent, int maxDepth, int maxSitemaps): SitemapReport {
    SitemapReport rep = new SitemapReport()
    HttpClient c = createClient()
    if userAgent != "" {
        c.setHeaders(["User-Agent: " + userAgent])
    }
    Array[string] pending = [sitemapUrl(baseUrl)]
    Dict[string, bool] seenSm = {}
    Dict[string, bool] seenUrl = {}
    string rootHost = domain(baseUrl)
    int level = 0
    while pending.len() > 0 and level <= maxDepth {
        Array[string] next = []
        for pending.len() to i {
            string sm = pending[i]
            if seenSm.get(sm, false) { continue }
            seenSm[sm] = true
            if rep.sitemaps_fetched >= maxSitemaps {
                rep.errors.add(sm + "：已达 maxSitemaps（" + maxSitemaps + "）上限，跳过")
                continue
            }
            Response r = c.get(sm)
            rep.sitemaps_fetched = rep.sitemaps_fetched + 1
            if not r.ok() {
                rep.errors.add(sm + "：HTTP " + r.statusCode)
                continue
            }
            // 响应体是 gzip 字节（服务端把 .gz 当静态文件发，没做 Content-Encoding）⇒ 自己解
            string body = r.body
            if _isGzipBody(body) {
                GzipResult un = gzip.gunzip(body)
                if not un.ok {
                    rep.gzip_skipped = rep.gzip_skipped + 1
                    rep.errors.add(sm + "：gzip 解压失败（" + un.error + "）")
                    continue
                }
                body = un.data
            }
            if isSitemapIndex(body) {
                Array[string] children = parseSitemapIndex(body)
                for children.len() to k {
                    string ch = children[k]
                    if rootHost != "" and domain(ch) != rootHost {
                        rep.errors.add(ch + "：跨站子 sitemap，已忽略")
                        continue
                    }
                    next.add(ch)
                }
            } else {
                Array[string] urls = parseSitemap(body)
                for urls.len() to k {
                    if seenUrl.get(urls[k], false) { continue }
                    seenUrl[urls[k]] = true
                    rep.urls.add(urls[k])
                }
            }
        }
        pending = next
        level = level + 1
    }
    c.close()
    return rep
}

// 递归抓 sitemap 只要地址列表（默认下钻 2 层索引）
export func fetchSitemapUrlsDeep(string baseUrl, string userAgent, int maxDepth = 2, int maxSitemaps = 50): Array[string] {
    return fetchSitemapReport(baseUrl, userAgent, maxDepth, maxSitemaps).urls
}

// 从站点 sitemap 提取所有 URL 列表（兼容旧接口：只抓这一层，不跟索引）
export func fetchSitemapUrls(string siteUrl, string userAgent): Array[string] {
    return fetchSitemapReport(siteUrl, userAgent, 0, 1).urls
}

// ==================== 数据落地：CSV ====================
// 爬虫最常见的出口是"一张表"，此前只能靠 files.write 自己拼 —— 引号/逗号/换行
// 一旦进到字段里就会把表格撑坏，所以这里提供规范转义。

// 转义单个字段：含 , " 换行 时用双引号包裹，内部双引号双写（RFC 4180）
export func csvField(string v): string {
    if not (strings.has(v, ",") or strings.has(v, "\"") or strings.has(v, "\n") or strings.has(v, "\r")) {
        return v
    }
    return "\"" + v.replace("\"", "\"\"") + "\""
}

// 行集合 → CSV 文本（CRLF 行尾，Excel 友好）
export func toCsv(Array[Array[string]] rows): string {
    Array[string] lines = []
    for rows to row {
        Array[string] cells = []
        for row to cell { cells.add(csvField(cell)) }
        lines.add(strings.join(cells, ","))
    }
    return strings.join(lines, "\r\n") + "\r\n"
}

// 写 CSV 文件，返回写入的数据行数（不含表头）。
// withBom 默认 true：Excel 只有见到 UTF-8 BOM 才会正确显示中文（双击打开场景）。
// ⚠ header 没有默认值：默认参数只接受字面量常量，`= []` 不是（编译期会报错）
//   ⇒ 不想写表头请用 writeCsvRows()
export func writeCsv(string path, Array[Array[string]] rows, Array[string] header, bool withBom = true): int {
    string out = ""
    if header.len() > 0 {
        out = toCsv([header])
    }
    out = out + toCsv(rows)
    if withBom {
        out = strings.from_bytes([0xEF, 0xBB, 0xBF]) + out
    }
    files.write(path, out)
    return rows.len()
}

// 不带表头的 writeCsv
export func writeCsvRows(string path, Array[Array[string]] rows, bool withBom = true): int {
    return writeCsv(path, rows, [], withBom)
}
