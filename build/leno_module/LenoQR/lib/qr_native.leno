// qr_native.leno -- quirc 原生库的 clib 声明 + 加载
//
// 唯一事实来源：src/leno_qr.c 的导出函数。改这里的签名必须同步改那边，
// 反之亦然（ABI 常量就是为了让"版本对不上"变成响亮报错而不是静默错值）。
import ffi

// ==================== clib ====================
// 约定（与 src/leno_qr.c 文件头逐字一致）：
//   leno_qr_scan_* 返回值：>=0 = 写进 out 的字节数（0 = 图里没有二维码）；
//                         -2 = 参数非法；-3 = quirc 初始化/内存失败
clib quirc {
    i32  leno_qr_abi()
    str8 leno_qr_version()
    i32  leno_qr_max_payload()
    i32  leno_qr_scan_gray(Ptr[u8] gray, i32 w, i32 h, i32 stride, Ptr[u8] out, i32 cap)
    i32  leno_qr_scan_argb(Ptr[u8] px, i32 w, i32 h, i32 pitch, i32 bpp, Ptr[u8] out, i32 cap)
    // ABI 2：多码枚举（begin → count/get/meta → end）
    Ptr  leno_qr_begin(Ptr[u8] gray, i32 w, i32 h, i32 stride)
    Ptr  leno_qr_begin_argb(Ptr[u8] px, i32 w, i32 h, i32 pitch, i32 bpp)
    i32  leno_qr_count(Ptr handle)
    i32  leno_qr_get(Ptr handle, i32 index, Ptr[u8] out, i32 cap)
    i32  leno_qr_meta(Ptr handle, i32 index, Ptr out4)
    void leno_qr_end(Ptr handle)
}

// ==================== ABI ====================
// 必须等于 src/leno_qr.c 里的 LENO_QR_ABI
export var ABI = 2

export var ERR_ARGS = -2
export var ERR_MEM = -3
export var ERR_NO_LIB = -100

// ==================== 库加载 ====================
// ★ 2026-11-19 起库文件**按平台分目录**存放（原来是 lib/ 下平铺，与 LenoSqlite 等对齐）：
//     lib/win/quirc.dll                · Windows（src/build_dll.bat 产物）
//     lib/linux/quirc.so               · Linux（src/build_so.sh 产物）
//     lib/android/<abi>/libquirc.so    · Android（本包暂无产物，留位）
//
// 传的是**平台相对路径**（"win/quirc.dll"），不是裸文件名：
//   ffi.load 的自动搜索会先试"模块目录 + 完整相对路径"（ffi.c 的 2a-2 / 2c 两步），
//   所以库放在模块 lib/ 的子目录里也能命中，不需要自己拼 dirs.script_dir()。
//   ⚠ 别自己拼 dirs.script_dir()：它给的是**入口脚本**所在目录，不是模块目录，
//     从 test/ 跑时拼出来的是 leno_module/lib/ 这个不存在的路径（第一版踩过 ✗）。
//
// 加载失败时的兜底顺序见 lib()：子目录路径 → 裸文件名（打包后库被复制到 exe 同目录）。
export func lib_name(): string {
    if _os() == "windows" { return "win/quirc.dll" }
    if _os() == "android" { return "android/" + abi_dir() + "/libquirc.so" }
    return "linux/quirc.so"
}

// 裸文件名：打包后库被复制到 **exe 同目录**（package_install.c 的 collector_add 只取
//   basename，子目录前缀会被剥掉）⇒ 那种场景下没有平台子目录可拼，只能按纯名字找。
export func bare_name(): string {
    if _os() == "windows" { return "quirc.dll" }
    if _os() == "android" { return "libquirc.so" }
    return "quirc.so"
}

// `_arch()` 给的是 arm64 / x64，而 Android 的 ABI 目录叫 arm64-v8a / x86_64 ⇒ 必须显式转换。
func abi_dir(): string {
    var a = _arch()
    if a == "arm64" { return "arm64-v8a" }
    if a == "x64"   { return "x86_64" }
    if a == "arm"   { return "armeabi-v7a" }
    return "x86"
}

string g_name = ""
var g_tried = false
var g_loaded = false
quirc g_lib = null

export func lib(): quirc {
    if not g_tried {
        g_tried = true
        g_name = lib_name()
        // 加载失败 = 抛异常：这里捕获后**保持 null**，让上层给出可执行的文案
        // （而不是把异常抛到用户面前，只看到一句英文系统错误）
        //
        // 两路兜底：
        //   1. 平台子目录路径（"win/quirc.dll"）—— 开发/随源码树运行时走这条
        //   2. 裸文件名（"quirc.dll"）        —— 打包后库被复制到 exe 同目录时走这条
        //      （collector_add 只保留 basename，子目录会丢）
        try { g_lib = ffi.load(g_name) }
        catch e {
            try { g_lib = ffi.load(bare_name()) }
            catch e2 { g_lib = null }
        }
        g_loaded = g_lib != null
    }
    return g_lib
}

// 库是否可用（= 能加载）。注意：会**真实加载一次**（结果缓存），不是只看文件在不在。
export func available(): bool {
    if not g_tried { lib() }
    return g_loaded
}

// 诊断用：传给 ffi.load 的库文件名
export func path(): string {
    if not g_tried { lib() }
    return g_name
}

// 原生库版本串（quirc 自己的版本，静态内存）
export func version(): string {
    var l = lib()
    if l == null { return "" }
    return l.leno_qr_version()
}

export func abi(): int {
    var l = lib()
    if l == null { return 0 }
    return l.leno_qr_abi()
}

export func max_payload(): int {
    var l = lib()
    if l == null { return 0 }
    return l.leno_qr_max_payload()
}

// ==================== 扫描入口（把 clib 调用关在本文件内）====================
// 为什么不让 qr_decode.leno 直接拿 clib 句柄调：
//   clib 类型**跨文件**当函数返回类型时，语义层会把它当成 "struct quirc"，
//   于是 `l.leno_qr_scan_gray(...)` 报「类型 'struct quirc' 没有方法 …」✗
//   （实测：加 use nat.quirc 也不解决）。本仓既有做法是**声明与调用同文件**
//   （见 LenoMusic：music_core 里声明 clib 并调用，music_player 只调 core 的包装）
//   ⇒ 这里补 3 个薄包装，qr_decode 只跟 int 打交道 ✓
//
// 约定：ERR_NO_LIB(-100) = 库不可用 —— 调用方要有专门的提示文案；
//       其余返回值语义与 C 侧一致（>=0 字节数，0 没找到，-2 参数，-3 内存）

export func scan_gray(Ptr[u8] gray, int w, int h, int stride, Ptr[u8] out, int cap): int {
    var l = lib()
    if l == null { return ERR_NO_LIB }
    return l.leno_qr_scan_gray(gray, w, h, stride, out, cap)
}

export func scan_argb(Ptr[u8] px, int w, int h, int pitch, Ptr[u8] out, int cap): int {
    var l = lib()
    if l == null { return ERR_NO_LIB }
    return l.leno_qr_scan_argb(px, w, h, pitch, 4, out, cap)
}

export func scan_rgb24(Ptr[u8] px, int w, int h, int pitch, Ptr[u8] out, int cap): int {
    var l = lib()
    if l == null { return ERR_NO_LIB }
    return l.leno_qr_scan_argb(px, w, h, pitch, 3, out, cap)
}

// ==================== 多码枚举（ABI 2）====================
// 生命周期：scan_begin_* → scan_count / scan_get / scan_meta → scan_end（必须调）
export func scan_begin_gray(Ptr[u8] gray, int w, int h, int stride): Ptr {
    var l = lib()
    if l == null { return null }
    return l.leno_qr_begin(gray, w, h, stride)
}

export func scan_begin_argb(Ptr[u8] px, int w, int h, int pitch, int bpp): Ptr {
    var l = lib()
    if l == null { return null }
    return l.leno_qr_begin_argb(px, w, h, pitch, bpp)
}

export func scan_count(Ptr handle): int {
    var l = lib()
    if l == null { return ERR_NO_LIB }
    return l.leno_qr_count(handle)
}

export func scan_get(Ptr handle, int index, Ptr[u8] out, int cap): int {
    var l = lib()
    if l == null { return ERR_NO_LIB }
    return l.leno_qr_get(handle, index, out, cap)
}

export func scan_meta(Ptr handle, int index, Ptr out4): int {
    var l = lib()
    if l == null { return ERR_NO_LIB }
    return l.leno_qr_meta(handle, index, out4)
}

export func scan_end(Ptr handle) {
    var l = lib()
    if l == null { return }
    l.leno_qr_end(handle)
}
