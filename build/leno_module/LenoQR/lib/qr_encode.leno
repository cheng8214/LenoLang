// qr_encode.leno -- 纯 Leno 的 QR 编码器（ISO/IEC 18004）
//
// 覆盖：版本 1–40 自动选择、纠错 L/M/Q/H、数字 / 字母数字 / 字节（UTF-8）三种模式、
//       8 个掩码 + 4 条罚分选最优、format/version 的 BCH。
// 不做：Kanji 模式、ECI 显式声明、Structured Append、Micro QR。
//
// ⚠ GF(256) 用的本原多项式是 **0x11D** —— 与 LenoCrypto 里 AES 的 0x11B **不同**，
//   两边的 exp/log 表不能混用（QR 的 Reed-Solomon 是 18004 规定的域）。
//
// ⚠ 本文件所有循环变量都在**函数顶部**声明（不用 `var` 在各分支里重复声明）：
//   Leno 的 `var` 是块作用域，在 while 体里 `var x` 出了循环就不可见（实测报
//   「未定义的变量: x」）—— 这不是风格问题，是硬约束。
import strings
import "qr_tables.leno" as T

// ==================== 常量 ====================
export var ECC_L = 0
export var ECC_M = 1
export var ECC_Q = 2
export var ECC_H = 3
export var ECC_NAMES = ["L", "M", "Q", "H"]

// format info 里的 2 位纠错指示：L=01 M=00 Q=11 H=10（**不是**下标顺序）
var ECC_FORMAT_BITS = [1, 0, 3, 2]

var MODE_NUM = 0
var MODE_ALNUM = 1
var MODE_BYTE = 2

const ALNUM = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ $%*+-./:"

// ==================== GF(256) / 0x11D ====================
Array[int] g_exp = []
Array[int] g_log = []
var g_gf_ready = false

func gf_init() {
    if g_gf_ready { return }
    g_gf_ready = true
    Array[int] ex = []
    Array[int] lg = []
    var i = 0
    while i < 512 { ex.add(0); i = i + 1 }
    i = 0
    while i < 256 { lg.add(0); i = i + 1 }
    var x = 1
    i = 0
    while i < 255 {
        ex[i] = x
        lg[x] = i
        x = x << 1
        if x >= 256 { x = x ^ 285 }      // 285 = 0x11D
        i = i + 1
    }
    // exp 扩到 512：乘法时 log[a]+log[b] 最大 508，免去取模
    i = 255
    while i < 512 { ex[i] = ex[i - 255]; i = i + 1 }
    g_exp = ex
    g_log = lg
}

export func gf_mul(int a, int b): int {
    gf_init()
    if a == 0 or b == 0 { return 0 }
    return g_exp[g_log[a] + g_log[b]]
}

// 生成多项式 g(x) = (x-α^0)(x-α^1)…(x-α^(n-1))，返回 n+1 个系数（g[0] 恒为 1）
func rs_generator(int n): Array[int] {
    gf_init()
    Array[int] g = [1]
    var i = 0
    var k = 0
    var factor = 0
    Array[int] ng = []
    while i < n {
        factor = g_exp[i]
        ng = []
        k = 0
        while k < g.len() + 1 { ng.add(0); k = k + 1 }
        k = 0
        while k < g.len() {
            ng[k] = ng[k] ^ g[k]
            ng[k + 1] = ng[k + 1] ^ gf_mul(g[k], factor)
            k = k + 1
        }
        g = ng
        i = i + 1
    }
    return g
}

// Reed-Solomon 余式（长度为 n 的纠错码字）
func rs_ecc(Array[int] data, int n): Array[int] {
    Array[int] gen = rs_generator(n)
    Array[int] rem = []
    var i = 0
    var j = 0
    var factor = 0
    while i < n { rem.add(0); i = i + 1 }
    i = 0
    while i < data.len() {
        factor = data[i] ^ rem[0]
        j = 0
        while j < n - 1 { rem[j] = rem[j + 1]; j = j + 1 }
        rem[n - 1] = 0
        if factor != 0 {
            j = 0
            while j < n {
                rem[j] = rem[j] ^ gf_mul(gen[j + 1], factor)
                j = j + 1
            }
        }
        i = i + 1
    }
    return rem
}

// ==================== 位缓冲 ====================
func bits_push(Array[int] bits, int value, int nbits) {
    var i = nbits - 1
    while i >= 0 {
        bits.add((value >> i) & 1)
        i = i - 1
    }
}

// ==================== 模式与容量 ====================
func alnum_index(int b): int {
    var i = 0
    while i < 45 {
        if ALNUM.byte(i) == b { return i }
        i = i + 1
    }
    return -1
}

func detect_mode(string text): int {
    if text == "" { return MODE_BYTE }
    var all_num = true
    var all_alnum = true
    for text.to_bytes() to b {
        if b < 48 or b > 57 { all_num = false }
        if alnum_index(b) < 0 { all_alnum = false }
    }
    if all_num { return MODE_NUM }
    if all_alnum { return MODE_ALNUM }
    return MODE_BYTE
}

// 模式指示符（ISO 18004 表 2）
func _mode_indicator(int mode): int {
    if mode == MODE_NUM { return 1 }
    if mode == MODE_ALNUM { return 2 }
    return 4
}

// 字符计数位宽：**三段**，不是两段（ISO 18004 表 3）
//   v1–9 / v10–26 / v27–40
//   numeric 10/12/14、alnum 9/11/13、byte 8/16/16
// ⚠ 第一版只写了「<10 / >=10」两段 ⇒ v27+ 的数字/字母数字模式计数位少 2 位，
//   整条码字流从第 1 个字节就歪（实测：5000 位数字在 v34 上对不上 python qrcode）。
func cc_bits(int mode, int version): int {
    var hi = version >= 10
    var top = version >= 27
    if mode == MODE_NUM { return if top then 14 else if hi then 12 else 10 }
    if mode == MODE_ALNUM { return if top then 13 else if hi then 11 else 9 }
    return if hi then 16 else 8
}

func payload_bits(Array[int] bytes, int mode): int {
    int n = bytes.len()
    var b = 0
    if mode == MODE_NUM {
        b = (n / 3) * 10
        int r = n % 3
        if r == 2 { b = b + 7 }
        if r == 1 { b = b + 4 }
        return b
    }
    if mode == MODE_ALNUM {
        return (n / 2) * 11 + (n % 2) * 6
    }
    return n * 8
}

// 数据码字总数（不含纠错）：组1 + 组2
export func data_codewords(int version, int ecc): int {
    int off = (version - 1) * 20 + ecc * 5
    return T.EC[off + 1] * T.EC[off + 2] + T.EC[off + 3] * T.EC[off + 4]
}

// 某个版本/纠错下，字节模式能装多少字节（给调用方做"内容太长"的提示）
export func capacity_bytes(int version, int ecc): int {
    int bits = data_codewords(version, ecc) * 8
    int head = 4 + cc_bits(MODE_BYTE, version)
    return (bits - head) / 8
}

// ==================== 编码主流程 ====================
export func encode(string text, string eccName = "M", int forceVersion = 0): Dict {
    gf_init()

    var i = 0
    var k = 0
    var b = 0
    var p = 0
    var y = 0
    var x = 0

    var ecc = -1
    i = 0
    while i < 4 {
        if ECC_NAMES[i] == eccName { ecc = i }
        i = i + 1
    }
    if ecc < 0 { return _err("纠错档位只能是 L/M/Q/H，收到「" + eccName + "」") }

    Array[int] bytes = text.to_bytes()
    int mode = detect_mode(text)
    int pbits = payload_bits(bytes, mode)

    var version = 0
    if forceVersion > 0 {
        version = forceVersion
    } else {
        i = 1
        while i <= 40 {
            int need = 4 + cc_bits(mode, i) + pbits
            if need <= data_codewords(i, ecc) * 8 { version = i; break }
            i = i + 1
        }
    }
    if version <= 0 or version > 40 { return _err("内容太长：40 版也装不下") }
    if 4 + cc_bits(mode, version) + pbits > data_codewords(version, ecc) * 8 {
        return _err("内容超出该版本容量：" + _str(text.byte_len()) + " 字节，v" + _str(version)
            + "/" + eccName + " 只能装 " + _str(capacity_bytes(version, ecc)) + " 字节")
    }

    // ---- 位流：模式指示 + 字符计数 + 载荷 ----
    // ⚠ 这里要写的是**模式指示符**（numeric=0001 / alnum=0010 / byte=0100），
    //   不是内部下标（0/1/2）—— 第一版直接把 mode 推了进去，整条码字流从第一个
    //   字节就错了（实测对拍：py 首字节 0x20、我们 0x10）。
    Array[int] bits = []
    bits_push(bits, _mode_indicator(mode), 4)
    if mode == MODE_NUM {
        bits_push(bits, bytes.len(), cc_bits(mode, version))
        p = 0
        while p < bytes.len() {
            int left = bytes.len() - p
            if left >= 3 {
                int v = (bytes[p] - 48) * 100 + (bytes[p + 1] - 48) * 10 + (bytes[p + 2] - 48)
                bits_push(bits, v, 10)
                p = p + 3
            } else if left == 2 {
                int v = (bytes[p] - 48) * 10 + (bytes[p + 1] - 48)
                bits_push(bits, v, 7)
                p = p + 2
            } else {
                bits_push(bits, bytes[p] - 48, 4)
                p = p + 1
            }
        }
    } else if mode == MODE_ALNUM {
        bits_push(bits, bytes.len(), cc_bits(mode, version))
        p = 0
        while p < bytes.len() {
            if p + 1 < bytes.len() {
                bits_push(bits, alnum_index(bytes[p]) * 45 + alnum_index(bytes[p + 1]), 11)
                p = p + 2
            } else {
                bits_push(bits, alnum_index(bytes[p]), 6)
                p = p + 1
            }
        }
    } else {
        bits_push(bits, bytes.len(), cc_bits(mode, version))
        for bytes to by { bits_push(bits, by, 8) }
    }

    int cap = data_codewords(version, ecc) * 8
    // 终止符（不足 4 位就给剩余位）
    var t = 4
    while t > 0 and bits.len() < cap { bits.add(0); t = t - 1 }
    // 补到字节边界
    while bits.len() % 8 != 0 { bits.add(0) }
    // 位 → 码字
    Array[int] cw = []
    i = 0
    while i < bits.len() {
        int v = 0
        k = 0
        while k < 8 { v = (v << 1) | bits[i + k]; k = k + 1 }
        cw.add(v)
        i = i + 8
    }
    // 填充码字：0xEC / 0x11 交替
    var pad = 0
    while cw.len() < data_codewords(version, ecc) {
        cw.add(if pad % 2 == 0 then 236 else 17)
        pad = pad + 1
    }

    // ---- 分块 + 纠错 + 交织 ----
    int off = (version - 1) * 20 + ecc * 5
    int ecpb = T.EC[off]
    int g1b = T.EC[off + 1]
    int g1d = T.EC[off + 2]
    int g2b = T.EC[off + 3]
    int g2d = T.EC[off + 4]
    int totalBlocks = g1b + g2b

    Array[int] blkOff = []
    Array[int] blkLen = []
    var pos = 0
    i = 0
    while i < g1b { blkOff.add(pos); blkLen.add(g1d); pos = pos + g1d; i = i + 1 }
    i = 0
    while i < g2b { blkOff.add(pos); blkLen.add(g2d); pos = pos + g2d; i = i + 1 }
    int maxD = if g2d > g1d then g2d else g1d

    Array[int] out = []
    k = 0
    while k < maxD {
        b = 0
        while b < totalBlocks {
            if k < blkLen[b] { out.add(cw[blkOff[b] + k]) }
            b = b + 1
        }
        k = k + 1
    }

    Array[int] eccs = []
    b = 0
    while b < totalBlocks {
        Array[int] blk = []
        k = 0
        while k < blkLen[b] { blk.add(cw[blkOff[b] + k]); k = k + 1 }
        Array[int] e = rs_ecc(blk, ecpb)
        k = 0
        while k < ecpb { eccs.add(e[k]); k = k + 1 }
        b = b + 1
    }
    k = 0
    while k < ecpb {
        b = 0
        while b < totalBlocks { out.add(eccs[b * ecpb + k]); b = b + 1 }
        k = k + 1
    }

    // ---- 矩阵 ----
    int size = version * 4 + 17
    Array[int] m = []
    Array[int] fn = []
    i = 0
    while i < size * size { m.add(-1); fn.add(0); i = i + 1 }

    _place_function_patterns(m, fn, size, version)
    _place_data(m, fn, size, out, version)
    int mask = _choose_mask(m, fn, size, version, ecc)
    Array[int] best = _masked_copy(m, fn, size, mask)
    _write_format(best, size, version, ecc, mask)
    if version >= 7 { _write_version(best, size, version) }

    Array[string] rows = []
    y = 0
    while y < size {
        Array[int] rb = []
        x = 0
        while x < size {
            rb.add(if best[y * size + x] == 1 then 49 else 48)   // '1' / '0'
            x = x + 1
        }
        rows.add(strings.from_bytes(rb))
        y = y + 1
    }

    return {
        ok: true,
        err: "",
        text: text,
        version: version,
        ecc: ecc,
        eccName: ECC_NAMES[ecc],
        mask: mask,
        size: size,
        mode: mode,
        rows: rows,
        cw: out           // 交织后的完整码字流（数据 + 纠错）—— 仅用于对拍/诊断
    }
}

func _err(string msg): Dict {
    return {ok: false, err: msg, text: "", version: 0, ecc: 0, eccName: "", mask: -1,
            size: 0, mode: -1, rows: []}
}

// ==================== 功能图案 ====================
func _set(Array[int] m, Array[int] fn, int size, int x, int y, int v) {
    if x < 0 or y < 0 or x >= size or y >= size { return }
    m[y * size + x] = v
    fn[y * size + x] = 1
}

// 7×7 定位图案（含 1 格白色分隔符）
func _finder(Array[int] m, Array[int] fn, int size, int cx, int cy) {
    var dy = -1
    var dx = -1
    var v = 0
    var edge = false
    var core = false
    while dy <= 7 {
        dx = -1
        while dx <= 7 {
            v = 0
            if dx >= 0 and dx <= 6 and dy >= 0 and dy <= 6 {
                edge = (dx == 0 or dx == 6 or dy == 0 or dy == 6)
                core = (dx >= 2 and dx <= 4 and dy >= 2 and dy <= 4)
                v = if edge or core then 1 else 0
            }
            _set(m, fn, size, cx + dx, cy + dy, v)
            dx = dx + 1
        }
        dy = dy + 1
    }
}

func _place_function_patterns(Array[int] m, Array[int] fn, int size, int version) {
    _finder(m, fn, size, 0, 0)
    _finder(m, fn, size, size - 7, 0)
    _finder(m, fn, size, 0, size - 7)

    // 定时图案（第 6 行 / 第 6 列）
    var i = 8
    var v = 0
    while i <= size - 9 {
        v = if i % 2 == 0 then 1 else 0
        _set(m, fn, size, i, 6, v)
        _set(m, fn, size, 6, i, v)
        i = i + 1
    }

    // 对齐图案（v1 没有）
    var base = 0
    var vv = 0
    var a = 0
    var b2 = 0
    var cx = 0
    var cy = 0
    var dy = 0
    var dx = 0
    var skip = false
    var dark = false
    if version >= 2 {
        base = 0
        vv = 0
        while vv < version - 1 { base = base + T.ALIGN_COUNT[vv]; vv = vv + 1 }
        int cnt = T.ALIGN_COUNT[version - 1]
        a = 0
        while a < cnt {
            b2 = 0
            while b2 < cnt {
                cx = T.ALIGN[base + a]
                cy = T.ALIGN[base + b2]
                skip = (cx == 6 and cy == 6) or (cx == 6 and cy == size - 7) or (cx == size - 7 and cy == 6)
                if not skip {
                    dy = -2
                    while dy <= 2 {
                        dx = -2
                        while dx <= 2 {
                            dark = (dx == 0 and dy == 0) or (abs(dx) == 2) or (abs(dy) == 2)
                            _set(m, fn, size, cx + dx, cy + dy, if dark then 1 else 0)
                            dx = dx + 1
                        }
                        dy = dy + 1
                    }
                }
                b2 = b2 + 1
            }
            a = a + 1
        }
    }

    // 预留 format 区（先标成功能模块，值稍后写入）
    // ⚠ 必须跳过 (8,6) / (6,8)：这两格属于**定时图案**（第 6 行 / 第 6 列），
    //   format 信息的 15 位本来就不占它们（见 _write_format 的 rowV 映射）。
    //   第一版整段 0..8 都覆盖成 2 ⇒ 定时图案被抹掉一格，矩阵从 (6,8) 起与参考实现不符 ✗
    i = 0
    while i < 9 {
        if i != 6 {
            _set(m, fn, size, 8, i, 2)
            _set(m, fn, size, i, 8, 2)
        }
        i = i + 1
    }
    i = 0
    while i < 8 {
        _set(m, fn, size, size - 1 - i, 8, 2)
        _set(m, fn, size, 8, size - 1 - i, 2)
        i = i + 1
    }
    // 暗模块
    _set(m, fn, size, 8, size - 8, 1)

    // 预留 version 区（v≥7）
    if version >= 7 {
        i = 0
        var j = 0
        while i < 6 {
            j = 0
            while j < 3 {
                _set(m, fn, size, i, size - 11 + j, 2)
                _set(m, fn, size, size - 11 + j, i, 2)
                j = j + 1
            }
            i = i + 1
        }
    }
}

func abs(int x): int { return if x < 0 then -x else x }

// ==================== 数据放置（zigzag）====================
func _place_data(Array[int] m, Array[int] fn, int size, Array[int] cw, int version) {
    int totalBits = cw.len() * 8
    var bitIdx = 0
    var inc = -1
    var row = size - 1
    var col = size - 1
    var done = false
    var c = 0
    var bit = 0
    while col > 0 {
        if col == 6 { col = col - 1 }
        // 本次两列内的行扫描
        done = false
        while not done {
            c = col
            while c >= col - 1 {
                if fn[row * size + c] == 0 {
                    bit = 0
                    if bitIdx < totalBits {
                        bit = (cw[bitIdx / 8] >> (7 - (bitIdx % 8))) & 1
                    }
                    m[row * size + c] = bit
                    bitIdx = bitIdx + 1
                }
                c = c - 1
            }
            row = row + inc
            if row < 0 or row >= size {
                row = row - inc
                inc = -inc
                done = true
            }
        }
        col = col - 2
    }
}

// ==================== 掩码 ====================
func _mask_bit(int mask, int y, int x): bool {
    if mask == 0 { return (y + x) % 2 == 0 }
    if mask == 1 { return y % 2 == 0 }
    if mask == 2 { return x % 3 == 0 }
    if mask == 3 { return (y + x) % 3 == 0 }
    if mask == 4 { return (y / 2 + x / 3) % 2 == 0 }
    if mask == 5 { return (y * x) % 2 + (y * x) % 3 == 0 }
    if mask == 6 { return ((y * x) % 2 + (y * x) % 3) % 2 == 0 }
    return ((y + x) % 2 + (y * x) % 3) % 2 == 0
}

// 复制一份并套上掩码（功能模块不动）
func _masked_copy(Array[int] m, Array[int] fn, int size, int mask): Array[int] {
    Array[int] c = []
    var i = 0
    var y = 0
    var x = 0
    while i < size * size { c.add(m[i]); i = i + 1 }
    y = 0
    while y < size {
        x = 0
        while x < size {
            if fn[y * size + x] == 0 and _mask_bit(mask, y, x) { c[y * size + x] = c[y * size + x] ^ 1 }
            x = x + 1
        }
        y = y + 1
    }
    return c
}

func _choose_mask(Array[int] m, Array[int] fn, int size, int version, int ecc): int {
    var bestMask = 0
    var bestScore = 0
    var mask = 0
    var score = 0
    while mask < 8 {
        Array[int] c = _masked_copy(m, fn, size, mask)
        _write_format(c, size, version, ecc, mask)
        if version >= 7 { _write_version(c, size, version) }
        score = _penalty(c, size)
        if mask == 0 or score < bestScore { bestScore = score; bestMask = mask }
        mask = mask + 1
    }
    return bestMask
}

// ==================== 罚分（ISO 18004 §8.8.2）====================
func _penalty(Array[int] c, int size): int {
    var score = 0
    var y = 0
    var x = 0
    var run = 1
    var x2 = 0
    var y2 = 1
    var run2 = 1
    var a = 0
    var s = 0
    var k = 0
    var dark = 0
    var i = 0

    // 行连色
    y = 0
    while y < size {
        run = 1
        x = 1
        while x < size {
            if c[y * size + x] == c[y * size + x - 1] { run = run + 1 }
            else {
                if run >= 5 { score = score + 3 + (run - 5) }
                run = 1
            }
            x = x + 1
        }
        if run >= 5 { score = score + 3 + (run - 5) }
        y = y + 1
    }
    // 列连色
    x2 = 0
    while x2 < size {
        run2 = 1
        y2 = 1
        while y2 < size {
            if c[y2 * size + x2] == c[(y2 - 1) * size + x2] { run2 = run2 + 1 }
            else {
                if run2 >= 5 { score = score + 3 + (run2 - 5) }
                run2 = 1
            }
            y2 = y2 + 1
        }
        if run2 >= 5 { score = score + 3 + (run2 - 5) }
        x2 = x2 + 1
    }
    // 2×2 同色块
    y = 0
    while y < size - 1 {
        x = 0
        while x < size - 1 {
            a = c[y * size + x]
            if a == c[y * size + x + 1] and a == c[(y + 1) * size + x] and a == c[(y + 1) * size + x + 1] {
                score = score + 3
            }
            x = x + 1
        }
        y = y + 1
    }
    // 类定位图案 10111010000 / 00001011101（行、列）
    y = 0
    while y < size {
        x = 0
        while x + 10 < size {
            s = 0
            k = 0
            while k < 11 { s = (s << 1) | c[y * size + x + k]; k = k + 1 }
            if s == 0x5D0 or s == 0x05D { score = score + 40 }
            x = x + 1
        }
        y = y + 1
    }
    x2 = 0
    while x2 < size {
        y = 0
        while y + 10 < size {
            s = 0
            k = 0
            while k < 11 { s = (s << 1) | c[(y + k) * size + x2]; k = k + 1 }
            if s == 0x5D0 or s == 0x05D { score = score + 40 }
            y = y + 1
        }
        x2 = x2 + 1
    }
    // 黑格比例
    dark = 0
    i = 0
    while i < size * size { dark = dark + c[i]; i = i + 1 }
    int total = size * size
    int pct = (dark * 100) / total
    int k2 = abs(pct - 50) / 5
    score = score + k2 * 10
    return score
}

// ==================== format / version ====================
func _bitlen(int x): int {
    var n = 0
    var v = x
    while v != 0 { v = v >> 1; n = n + 1 }
    return n
}

func _bch15(int data): int {
    int d = data << 10
    while _bitlen(d) >= 11 { d = d ^ (0x537 << (_bitlen(d) - 11)) }
    return ((data << 10) | d) ^ 0x5412
}

func _bch18(int data): int {
    int d = data << 12
    while _bitlen(d) >= 13 { d = d ^ (0x1F25 << (_bitlen(d) - 13)) }
    return (data << 12) | d
}

func _write_format(Array[int] c, int size, int version, int ecc, int mask) {
    int data = (ECC_FORMAT_BITS[ecc] << 3) | mask
    int bits = _bch15(data)
    var i = 0
    var bit = 0
    var rowV = 0
    var colH = 0
    while i < 15 {
        bit = (bits >> i) & 1
        // 左上：竖列（行 0..5 / 7..8 / size-7..size-1）
        if i < 6 { rowV = i }
        else if i < 8 { rowV = i + 1 }
        else { rowV = size - 15 + i }
        c[rowV * size + 8] = bit
        // 左上：横行（i=8 落在第 7 列 —— 不是第 8 列：第 8 列那格是**暗模块**，
        //   它在下面单独写；这里写错会与参考实现差一格，且只在部分掩码下显形）
        if i < 8 { colH = size - i - 1 }
        else if i < 9 { colH = 7 }
        else { colH = 15 - i - 1 }
        c[8 * size + colH] = bit
        i = i + 1
    }
    // 暗模块
    c[(size - 8) * size + 8] = 1
}

func _write_version(Array[int] c, int size, int version) {
    int bits = _bch18(version)
    var i = 0
    var bit = 0
    while i < 18 {
        bit = (bits >> i) & 1
        c[(i / 3) * size + (size - 11 + i % 3)] = bit
        c[(size - 11 + i % 3) * size + (i / 3)] = bit
        i = i + 1
    }
}

// ==================== 渲染 ====================
// 矩阵 → 灰度字节串（1 字节/像素，0=黑 255=白），scale 像素/模块，quiet 模块静区
export func toGray(Dict res, int scale = 4, int quiet = 4): string {
    if not (res["ok"] as bool) { return "" }
    int size = res["size"] as int
    Array[string] rows = res["rows"] as Array[string]
    int side = (size + quiet * 2) * scale
    Array[int] px = []
    var y = 0
    var x = 0
    var my = 0
    var mx = 0
    var dark = false
    while y < side {
        my = y / scale - quiet
        x = 0
        while x < side {
            mx = x / scale - quiet
            dark = false
            if my >= 0 and my < size and mx >= 0 and mx < size {
                dark = rows[my].byte(mx) == 49
            }
            px.add(if dark then 0 else 255)
            x = x + 1
        }
        y = y + 1
    }
    return strings.from_bytes(px)
}

// 矩阵 → ARGB8888 字节串（B,G,R,A）
export func toARGB(Dict res, int scale = 4, int quiet = 4): string {
    string g = toGray(res, scale, quiet)
    Array[int] px = []
    for g.to_bytes() to v {
        px.add(v); px.add(v); px.add(v); px.add(255)
    }
    return strings.from_bytes(px)
}
