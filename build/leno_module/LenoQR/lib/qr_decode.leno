// qr_decode.leno -- 识别（quirc 后端）
//
// 返回口径统一为 Dict（与 LenoSDL3 的 capture 系列同一习惯）：
//   {found: bool, text: string, len: int, err: string}
//   · found=true  ⇒ text 是二维码载荷（UTF-8/ASCII 字节，按原样转成 Leno string）
//   · found=false ⇒ err 为空字符串 = "图里没有二维码"（正常情形，不是错误）
//                 ⇒ err 非空     = 真错误（库没编 / ABI 不符 / 参数非法 …）
// 为什么不抛异常：扫一张截图没扫到码是**日常**，不是异常。
//
// ⚠ 本文件**不碰 clib 句柄**（跨文件把 clib 当返回类型会被当成 struct ⇒
//   方法查找失败 ✗）⇒ 一切原生调用都走 qr_native 的 int 包装。
import ffi
import "qr_native.leno" as nat

// 灰度缓冲（每像素 1 字节，0=黑 255=白）→ {found,text,len,err}
//   stride = 每行字节数（>= w）
export func decodeGray(Ptr[u8] gray, int w, int h, int stride): Dict {
    if gray == null { return _err("像素指针为 null") }
    if w <= 0 or h <= 0 or stride < w { return _err("参数非法：w/h/stride 不合法") }
    return _run(gray, w, h, stride, 0)
}

// ARGB8888（内存序 B,G,R,A —— SDL 的 PIXELFORMAT_ARGB8888 在小端机就是这个）
//   pitch = 每行字节数（SDL surf 的 pitch，通常 = w*4）
export func decodeARGB(Ptr[u8] px, int w, int h, int pitch): Dict {
    if px == null { return _err("像素指针为 null") }
    if w <= 0 or h <= 0 or pitch < w * 4 { return _err("参数非法：w/h/pitch 不合法") }
    return _run(px, w, h, pitch, 4)
}

// RGB24（内存序 B,G,R，如 PNG 解码后未转格式的 24 位缓冲）
export func decodeRGB24(Ptr[u8] px, int w, int h, int pitch): Dict {
    if px == null { return _err("像素指针为 null") }
    if w <= 0 or h <= 0 or pitch < w * 3 { return _err("参数非法：w/h/pitch 不合法") }
    return _run(px, w, h, pitch, 3)
}

// ==================== 内部 ====================

// kind: 0 = 灰度（此时 pitch 参数里装的是 stride），4 = ARGB8888，3 = RGB24
func _run(Ptr[u8] px, int w, int h, int pitch, int kind): Dict {
    string why = _env_error()
    if why != "" { return _err(why) }

    int cap = nat.max_payload()
    if cap <= 0 { return _err("原生库返回的 max_payload 非法：" + _str(cap)) }

    Ptr[u8] out = ffi.malloc(cap)
    if out == null { return _err("分配输出缓冲失败（" + _str(cap) + " 字节）") }

    int n = 0
    if kind == 0 {
        n = nat.scan_gray(px, w, h, pitch, out, cap)   // 灰度：pitch 就是 stride
    } else if kind == 4 {
        n = nat.scan_argb(px, w, h, pitch, out, cap)
    } else {
        n = nat.scan_rgb24(px, w, h, pitch, out, cap)
    }

    var r = _collect(out, n)
    ffi.free(out)
    return r
}

// 原生库可用性 + ABI 握手。返回空串 = 一切就绪；否则是可执行的错误文案。
func _env_error(): string {
    if not nat.available() {
        return "加载原生库 " + nat.lib_name() + " 失败：先跑 src/build_dll.bat（POSIX 跑 src/build_so.sh）；"
            + "该库必须与 lib\\qr_native.leno 同目录，或放在 exe 同目录（-p 打包时由 leno.toml 自动内嵌）"
    }
    int a = nat.abi()
    if a == 0 {
        return "加载原生库失败：" + nat.path() + "（DLL 与 exe 位数是否一致？）"
    }
    if a != nat.ABI {
        return "原生库 ABI 不匹配（库=" + _str(a) + "，模块=" + _str(nat.ABI) + "）⇒ 重跑 src/build_dll.bat"
    }
    return ""
}

func _collect(Ptr[u8] out, int n): Dict {
    if n > 0 {
        return {found: true, text: ffi.read_bytes(out, 0, n), len: n, err: ""}
    }
    if n == 0 { return {found: false, text: "", len: 0, err: ""} }
    if n == nat.ERR_NO_LIB { return _err(_env_error()) }
    if n == nat.ERR_ARGS { return _err("参数非法（原生库返回 -2：w/h/stride/pitch 不合法）") }
    if n == nat.ERR_MEM { return _err("quirc 初始化或内存分配失败（返回 -3）") }
    return _err("未知返回码 " + _str(n))
}

func _err(string msg): Dict {
    return {found: false, text: "", len: 0, err: msg}
}

// ==================== 多码识别 ====================
// 一张图里可能有多枚二维码（海报拼图、成对贴纸、界面截图…）。
// 返回 {found, count, texts: Array[string], metas: Array[int], err}
//   · count  = **检测到**的码数（含解不开的）
//   · texts  = 成功解开的载荷（顺序与检测顺序一致；解不开的那枚不进 texts）
//   · metas  = 每枚成功解开的码 4 个整数：[version, ecc_level, mask, data_type]
//              （ecc_level 是 quirc 口径：M=0 L=1 H=2 Q=3；data_type 1=数字 2=字母 4=字节 8=Kanji）
export func decodeAllGray(Ptr[u8] gray, int w, int h, int stride): Dict {
    if gray == null { return _errAll("像素指针为 null") }
    if w <= 0 or h <= 0 or stride < w { return _errAll("参数非法：w/h/stride 不合法") }
    return _run_all(gray, w, h, stride, 0)
}

export func decodeAllARGB(Ptr[u8] px, int w, int h, int pitch): Dict {
    if px == null { return _errAll("像素指针为 null") }
    if w <= 0 or h <= 0 or pitch < w * 4 { return _errAll("参数非法：w/h/pitch 不合法") }
    return _run_all(px, w, h, pitch, 4)
}

export func decodeAllRGB24(Ptr[u8] px, int w, int h, int pitch): Dict {
    if px == null { return _errAll("像素指针为 null") }
    if w <= 0 or h <= 0 or pitch < w * 3 { return _errAll("参数非法：w/h/pitch 不合法") }
    return _run_all(px, w, h, pitch, 3)
}

func _errAll(string msg): Dict {
    return {found: false, count: 0, texts: [], metas: [], err: msg}
}

func _run_all(Ptr[u8] px, int w, int h, int pitch, int kind): Dict {
    string why = _env_error()
    if why != "" { return _errAll(why) }

    Ptr ctx = null
    if kind == 0 { ctx = nat.scan_begin_gray(px, w, h, pitch) }
    else { ctx = nat.scan_begin_argb(px, w, h, pitch, kind) }
    if ctx == null { return _errAll("检测失败（参数或内存问题）") }

    int n = nat.scan_count(ctx)
    if n < 0 {
        nat.scan_end(ctx)
        return _errAll("检测结果读取失败（返回 " + _str(n) + "）")
    }

    int cap = nat.max_payload()
    Ptr out = ffi.malloc(cap)
    Ptr meta = ffi.malloc(16)
    if out == null or meta == null {
        if out != null { ffi.free(out) }
        if meta != null { ffi.free(meta) }
        nat.scan_end(ctx)
        return _errAll("分配输出缓冲失败")
    }

    Array[string] texts = []
    Array[int] metas = []
    for 0:n-1 to i {
        int len = nat.scan_get(ctx, i, out, cap)
        if len > 0 {
            texts.add(ffi.read_bytes(out, 0, len))
            if nat.scan_meta(ctx, i, meta) == 0 {
                metas.add(ffi.read_int(meta, 0))
                metas.add(ffi.read_int(meta, 4))
                metas.add(ffi.read_int(meta, 8))
                metas.add(ffi.read_int(meta, 12))
            }
        }
    }
    ffi.free(out)
    ffi.free(meta)
    nat.scan_end(ctx)

    return {found: texts.len() > 0, count: n, texts: texts, metas: metas, err: ""}
}
