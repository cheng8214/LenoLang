# 构建输出（build/ **允许入库**：随 exe 分发的 leno_module/ 与 leno_gui/ 就在里面；
# 二进制仍不入库 —— *.exe 由下面这行统一排除，勿删）
*.exe
*.o
*.obj

# POSIX 解释器产物没有扩展名，上面那行 *.exe 管不到 ⇒ 单独列（与 *.exe 同口径）：
#   build/leno    ← build.sh
#   build/leno_vm ← build_vm.sh
build/leno
build/leno_vm
# LSP 产物同理（leno_lsp.exe 已由 *.exe 覆盖）：
#   leno_lsp/build/leno_lsp ← leno_lsp/build_lsp.sh
leno_lsp/build/leno_lsp

# 打包输出（leno -p）：目录内是 exe + 依赖原生库（leno.toml [native-libs]）的副本，
# 纯产物不入库。不写前导斜杠 —— 打包输出落在 <源码目录>/dist，不在仓库根。
dist/

# IDE
.vscode/
.idea/
*.sln
*.vcxproj

# 临时文件
*.tmp
*.temp
*.log
test_serialize_tmp.*
assert/run_tests.lenb
assert/run_tests.exe

# 编译器产物（leno -c 生成的字节码）
*.lenb

# 模块编译缓存（跨运行缓存 import 的 .leno 模块编译产物）
.lenocache/
# LSP 自己的模块缓存（2026-10-14 起与编译器**分开**：缓存 header 烙的是"运行中 exe 的指纹"
#   ⇒ leno_lsp.exe 与 leno.exe 的缓存互判失效，共享同一目录 = 两边反复白扫 + 互相覆盖 ✗）
.lenocache_lsp/
1.txt 

# 临时探针 / 实验目录（放在 build 外、不入库；与历史上的 .probe_perf / .probe_s2b 同族）
.probe*/

# build/ 下的临时探针与命令输出（约定：以 `_` 开头 —— _th1_pa.leno / _suite_out.txt / _t1_err.txt …）
#   ⚠ build/ 是**允许入库**的目录（leno_module/ 等在里面）⇒ 不能用 build/ 整体忽略，
#     只能按"下划线前缀"这条命名约定排除（2026-10-12 加：一次 `git add -A` 把 _suite2.out 扫进去了）
build/_*  
# 语法测试临时目录（其他 AI 生成的探针，不进仓库）  
.tmp_syntax_probe/  
tmp_syntax_probe/  

# 应用运行期缓存（试听音频 / 封面，用户能直接在资源管理器里看到并清理）
leno_gui/*/*/cache
