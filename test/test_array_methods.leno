// 数组方法测试

main()
{
    // 测试数组创建和基本操作
    var arr = [1, 2, 3, 4, 5]
    assert_eq(arr.len(), 5)
    assert_eq(arr[0], 1)
    assert_eq(arr[4], 5)

    // 测试 add
    arr.add(6)
    assert_eq(arr.len(), 6)
    assert_eq(arr[5], 6)

    // 测试 insert
    arr.insert(0, 0)
    assert_eq(arr.len(), 7)
    assert_eq(arr[0], 0)
    assert_eq(arr[1], 1)

    // 测试 remove
    var removed = arr.remove(0)
    assert_eq(removed, 0)
    assert_eq(arr.len(), 6)
    assert_eq(arr[0], 1)

    // 测试 has
    assert_eq(arr.has(3), true)
    assert_eq(arr.has(100), false)

    // 测试 pop
    var popped = arr.pop()
    assert_eq(popped, 6)
    assert_eq(arr.len(), 5)

    // 测试 clear
    arr.clear()
    assert_eq(arr.len(), 0)

    // 测试 copy
    var arr2 = [1, 2, 3]
    var arr3 = arr2.copy()
    assert_eq(arr3.len(), 3)
    assert_eq(arr3[0], 1)
    arr3[0] = 100
    assert_eq(arr2[0], 1) // 原数组不应改变

    // 测试多维数组
    var arr2d = [[1, 2], [3, 4], [5, 6]]
    assert_eq(arr2d.len(), 3)
    assert_eq(arr2d[0].len(), 2)
    assert_eq(arr2d[1][1], 4)

    print("test_array_methods passed")
}
