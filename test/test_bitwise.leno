// 位运算测试

main()
{
    // 测试1: 按位与 &
    var a = 5  // 二进制 101
    var b = 3  // 二进制 011
    assert_eq(a & b, 1)  // 001 = 1

    // 测试2: 按位或 |
    assert_eq(a | b, 7)  // 111 = 7

    // 测试3: 按位异或 ^
    assert_eq(a ^ b, 6)  // 110 = 6

    // 测试4: 按位取反 ~
    assert_eq(~a, -6)    // ~101 = ...11111010 = -6

    // 测试5: 左移 <<
    var c = 8  // 二进制 1000
    assert_eq(c << 2, 32)  // 100000 = 32

    // 测试6: 右移 >>
    assert_eq(c >> 2, 2)   // 10 = 2

    // 测试7: 复合赋值 &=
    var x = 5
    x &= 3
    assert_eq(x, 1)

    // 测试8: 复合赋值 |=
    var y = 5
    y |= 2
    assert_eq(y, 7)

    // 测试9: 复合赋值 ^=
    var z = 5
    z ^= 3
    assert_eq(z, 6)

    // 测试10: 复合赋值 <<=
    var s = 8
    s <<= 2
    assert_eq(s, 32)

    // 测试11: 复合赋值 >>=
    var t = 8
    t >>= 2
    assert_eq(t, 2)

    print("test_bitwise passed")
}
