// bench/bigint_bench.leno —— bigint 速度：Leno 自身 vs Python `int`
//
// 计时口径：Leno 侧用 `times.ms()` 前后差；Python 侧**自己**用 `perf_counter()` 只量负载
//   （不含解释器启动 —— 老 py 驱动把启动 45ms 算进去过，据此得出过"反超"的假结论 ✗）。
//
// 乘法用**稠密**操作数（`(2^n-1)/3` 与 `/5`）：`(2^n-1)×(2^n+1)` 的第二个操作数只有 2 个
//   非零位，CPython 在稀疏输入上快 20 多倍（1M 比特 3ms vs 随机 67ms）⇒ 曾把"我们慢 12.8x"
//   测出来过，那是**基准的锅**。稀疏形态单列 `mul_sparse_1m` 继续可见。
//
// 用法：build\leno.exe bench\bigint_bench.leno [--timeout 600000] [--only mul_1m]

import dirs
import files
import strings
import times

var TAGS = ["mul_100k", "mul_1m", "sqr_1m", "fact_20000", "add_1m", "shift_pow2", "dec_300k", "mul_sparse_1m"]
var DESCS = ["10 万比特乘法 ×20（稠密）", "100 万比特乘法 ×4（稠密）", "100 万比特平方 ×4",
             "阶乘 20000", "100 万比特加法 ×20000", "2^1e9 移位（十亿比特）",
             "2^1e6 转十进制（30 万位）", "100 万比特乘法（稀疏）×4"]

var g_timeout_ms = 600000
var g_only = ""

// ---------------------------------------------------------------- Leno 侧负载

func w_mul_100k() {
    var v = (1 << 100000) - 1
    var a = v / 3
    var b = v / 5
    var c = 0
    for 0:19 to i { c = a * b }
    if c <= 0 { print("bad\n") }
}

func w_mul_1m() {
    var v = (1 << 1000000) - 1
    var a = v / 3
    var b = v / 5
    var c = 0
    for 0:3 to i { c = a * b }
    if c <= 0 { print("bad\n") }
}

func w_sqr_1m() {
    var a = (1 << 1000000) - 1
    var c = 0
    for 0:3 to i { c = a * a }
    if c <= 0 { print("bad\n") }
}

func w_fact_20000() {
    var f = 1
    for 1:20000 to i { f = f * i }
    if f <= 0 { print("bad\n") }
}

func w_add_1m() {
    var a = 1 << 1000000
    var s = a
    for 0:19999 to i { s = s + a }
    if s <= 0 { print("bad\n") }
}

func w_shift_billion() {
    var p = 1 << 1000000000
    if p <= 0 { print("bad\n") }
}

func w_dec_300k() {
    var s = _str(1 << 1000000)
    if s.len() != 301030 { print("bad len\n") }
}

func w_mul_sparse_1m() {
    var a = (1 << 1000000) - 1
    var b = (1 << 1000000) + 1
    var c = 0
    for 0:3 to i { c = a * b }
    if c <= 0 { print("bad\n") }
}

func time_leno(int i):float {
    var t0 = times.ms()
    if i == 0 { w_mul_100k() }
    else if i == 1 { w_mul_1m() }
    else if i == 2 { w_sqr_1m() }
    else if i == 3 { w_fact_20000() }
    else if i == 4 { w_add_1m() }
    else if i == 5 { w_shift_billion() }
    else if i == 6 { w_dec_300k() }
    else { w_mul_sparse_1m() }
    return times.ms() - t0
}

// ---------------------------------------------------------------- Python 侧负载
//   只给"负载本体"；头尾（计时 + 打印毫秒）由 py_script 拼 ⇒ 8 段共用一份口径

func py_body(int i):string {
    if i == 0 { return "v = (1 << 100000) - 1\na = v // 3\nb = v // 5\nc = 0\nfor _ in range(20):\n    c = a * b\n" }
    if i == 1 { return "v = (1 << 1000000) - 1\na = v // 3\nb = v // 5\nc = 0\nfor _ in range(4):\n    c = a * b\n" }
    if i == 2 { return "a = (1 << 1000000) - 1\nc = 0\nfor _ in range(4):\n    c = a * a\n" }
    if i == 3 { return "f = 1\nfor k in range(1, 20001):\n    f = f * k\n" }
    if i == 4 { return "a = 1 << 1000000\ns = a\nfor _ in range(20000):\n    s = s + a\n" }
    if i == 5 { return "p = 1 << 1000000000\n" }
    if i == 6 { return "x = 1 << 1000000\ns = str(x)\nassert len(s) == 301030, len(s)\n" }
    return "a = (1 << 1000000) - 1\nb = (1 << 1000000) + 1\nc = 0\nfor _ in range(4):\n    c = a * b\n"
}

func py_script(int i):string {
    // set_int_max_str_digits：Python 3.11+ 默认限制 int→str 到 4300 位（只有 dec 用例需要，放着无害）
    return "import sys, time\nsys.set_int_max_str_digits(0)\nt0 = time.perf_counter()\n"
           + py_body(i)
           + "print('%.3f' % ((time.perf_counter() - t0) * 1000))\n"
}

// 取输出里最后一个"看起来是数字"的行（毫秒）
func last_ms(string out):float {
    var lines = strings.split(out, "\n")
    var k = lines.len() - 1
    while k >= 0 {
        var ln = strings.trim(lines[k])
        if ln != "" and strings.find(ln, ".") >= 0 { return _float(ln) }
        k -= 1
    }
    return -1.0
}

func run_py(string workdir, int i, string tag):float {
    var f = dirs.join(workdir, $"{tag}.py")
    files.write(f, py_script(i))
    var r = _exec($"python \"{f}\"", g_timeout_ms)
    if r == null or r.code != 0 { return -1.0 }
    return last_ms(_str(r.output))
}

main() {
    var args = _args()
    var i = 0
    while i < args.len() {
        if args[i] == "--timeout" and i + 1 < args.len() { i += 1; g_timeout_ms = _int(args[i]) }
        else if args[i] == "--only" and i + 1 < args.len() { i += 1; g_only = args[i] }
        i += 1
    }

    var work = dirs.join(_tmpdir(), $"leno_bigbench_{_int(times.ms())}")
    dirs.mkdir_p(work)
    // `%s` 的宽度已改成**按字符**计（2026-11-23 修）⇒ 中文列不再需要手工 pad_end ✓
    print(strings.format("%-16s%-34s%-10s%-11s%s\n", "用例", "说明", "Leno(s)", "Python(s)", "倍数"))
    print(strings.rep("-", 88) + "\n")

    var k = 0
    while k < TAGS.len() {
        if g_only == "" or g_only == TAGS[k] {
            var lsec = time_leno(k) / 1000.0
            var psec = run_py(work, k, TAGS[k]) / 1000.0
            var pstr = "-"
            var ratio = "-"
            if psec > 0.0 {
                pstr = strings.format("%.3f", psec)
                ratio = strings.format("%.2f", lsec / psec) + "x"
            }
            print(strings.format("%-16s%-34s%-10s%-11s%s\n", TAGS[k], DESCS[k],
                                 strings.format("%.3f", lsec), pstr, ratio))
        }
        k += 1
    }

    dirs.delete(work)
    print(strings.rep("-", 88) + "\n倍数 = Leno / Python（>1 表示 Leno 更慢）\n")
}
