// bench/verify_doc_code.leno —— 文档里每个 ```leno 块真跑一遍，按结果分类（Leno 版）
//
// 分类：STALE（报语法/语义错 ⇒ 文档过期）/ FRAGMENT（只报未定义函数·变量 ⇒ 依赖上文）
//       CRASH（非 0 退出且无 error 行）/ TIMEOUT（exit 124）/ ok
//
// 用法：build\leno.exe bench\verify_doc_code.leno [--glob module_*.md] [--timeout 20000]
//                                                [--only stale] [--docs <目录>]
//
// 写这个脚本时定下的三个语言事实（都写进注释，免得下次再撞）：
//   · 正则**量词一律贪婪**（不支持 `*?`）⇒ 截区间改用 `regexs.find_between`（2026-11-23 为此新增）；
//   · 字符串字面量不认 `\s`/`\S`；
//   · 插值 `$"{expr}"` 里**可以**放方法调用，`+=` 也可用 ⇒ 别再手写 `"a" + _str(b)`。
import dirs
import files
import regexs
import strings
import times

var HR = strings.rep("-", 74)
var g_docs = ""
var g_glob = "module_*.md"
var g_timeout_ms = 20000
var g_only = ""

var n_ok = 0
var n_stale = 0
var n_frag = 0
var n_crash = 0
var n_timeout = 0
var n_skip = 0

// 只支持单个 `*`（`module_*.md` / `*.md` / 精确名）
func glob_match(string name, string pat):bool {
    var star = strings.find(pat, "*")
    if star < 0 { return name == pat }
    var pre = ""
    if star > 0 { pre = pat.slice(0, star - 1) }
    var suf = ""
    if star + 1 < pat.len() { suf = pat.slice(star + 1, pat.len() - 1) }
    return strings.starts_with(name, pre) and strings.ends_with(name, suf)
}

// `error: [标签]` 里的标签（按行找，避免正则转义）
func error_tags(string out):Array[string] {
    Array[string] tags = []
    var lines = strings.split(out, "\n")
    for lines to ln {
        var p = strings.find(ln, "error: [")
        if p < 0 { continue }
        var rest = ln.slice(p + 7, ln.len() - 1)
        if not strings.starts_with(rest, "[") { continue }
        var rb = strings.find(rest, "]")
        if rb > 1 { tags.add(rest.slice(1, rb - 1)) }
    }
    return tags
}

func classify(string out, int code):string {
    if code == 0 { return "ok" }
    if code == 124 { return "timeout" }
    var tags = error_tags(out)
    if tags.len() == 0 { return "crash" }
    for tags to t {
        if t != "未定义函数" and t != "未定义变量" { return "stale" }
    }
    return "fragment"
}

// 报告里带一行详情（编译器第一处 error / 运行期 [错误]）
func first_detail(string out):string {
    var lines = strings.split(out, "\n")
    for lines to ln {
        if strings.find(ln, "error:") >= 0 or strings.find(ln, "[错误]") >= 0 {
            return strings.trim(ln)
        }
    }
    return ""
}

func docs_root():string {
    // script_dir = <repo>\bench ⇒ 上两级找兄弟目录 LenoDocsSrc
    var up1 = dirs.abspath(dirs.join(dirs.script_dir(), ".."))
    return dirs.join(dirs.abspath(dirs.join(up1, "..")), "LenoDocsSrc")
}

main() {
    g_docs = docs_root()
    var args = _args()
    var i = 0
    while i < args.len() {
        if args[i] == "--glob" and i + 1 < args.len() { i += 1; g_glob = args[i] }
        else if args[i] == "--timeout" and i + 1 < args.len() { i += 1; g_timeout_ms = _int(args[i]) }
        else if args[i] == "--only" and i + 1 < args.len() { i += 1; g_only = args[i] }
        else if args[i] == "--docs" and i + 1 < args.len() { i += 1; g_docs = args[i] }
        i += 1
    }
    if not dirs.is_dir(g_docs) {
        print($"找不到文档目录：{g_docs}\n用 --docs <路径> 指定（默认取兄弟目录 LenoDocsSrc）\n")
        _exit(2)
    }

    var work = dirs.join(_tmpdir(), $"leno_doccode_{_int(times.ms())}")
    dirs.mkdir_p(work)
    print($"文档目录: {g_docs}\n匹配: {g_glob}，超时 {g_timeout_ms}ms\n{HR}\n")

    var names = dirs.listdir(g_docs)
    var bad_files = 0
    var md_count = 0
    for names to nm {
        if not strings.ends_with(nm, ".md") or not glob_match(nm, g_glob) { continue }
        md_count += 1
        var text = files.read(dirs.join(g_docs, nm))
        if text == null { continue }

        // 截所有 ``` ```leno … ``` ``` 的**内容**（find_between 就是为这件事加的）
        var blocks = regexs.find_between(_str(text), "```leno", "```")
        var ran = 0
        var fail = 0
        var skip = 0
        var bi = 0
        for blocks to raw {
            bi += 1
            var code = strings.trim(raw)
            if not strings.has(code, "main(") or strings.has(code, ".leno\"") {
                skip += 1
                n_skip += 1
                continue
            }
            var f = dirs.join(work, $"blk{bi}.leno")
            files.write(f, code)
            var r = _exec($"{_executable()} \"{f}\"", g_timeout_ms)
            var out = ""
            var rc = -1
            if r != null { out = _str(r.output); rc = r.code }
            var kind = classify(out, rc)
            ran += 1
            if kind == "ok" { n_ok += 1 }
            else if kind == "stale" { n_stale += 1; fail += 1 }
            else if kind == "fragment" { n_frag += 1; fail += 1 }
            else if kind == "timeout" { n_timeout += 1; fail += 1 }
            else { n_crash += 1; fail += 1 }

            if kind != "ok" and (g_only == "" or g_only == kind) {
                var head_lines = strings.split(code, "\n")
                var head = ""
                if head_lines.len() > 0 { head = strings.trim(head_lines[0]) }
                print($"  #{bi}  {strings.to_upper(kind)}  {head}\n")
                var d = first_detail(out)
                if d != "" { print($"        {d}\n") }
            }
        }

        if fail > 0 { bad_files += 1 }
        if g_only == "" or fail > 0 {
            var mark = "OK  "
            if fail > 0 { mark = "FAIL" }
            print($"{mark} {nm}  ran={ran} fail={fail} skip={skip}\n")
        }
    }

    dirs.delete(work)
    print($"{HR}\n")
    print($"文件 {md_count} 个；ok={n_ok} stale={n_stale} fragment={n_frag}")
    print($" crash={n_crash} timeout={n_timeout} skip={n_skip}\n")
    print($"有失败的文件：{bad_files} 个\n")
    if n_stale > 0 or n_crash > 0 { _exit(1) }
}
