// bench/verify_bigint_dec.leno —— bigint↔十进制**双向**校验（Leno 驱动）
//
//   打印方向（12 例）：Leno 算值 + `_str`，与 Python 真值逐字节比对；
//                      Python 只当"真值预言机"（独立实现才有意义：自己验自己抓不到系统性算错）。
//   解析方向（9 例）：`_int(文本)` 再 `_str` 回来 —— 输入/期望都是本文件里的字面量，纯 Leno 即可。
//
// 用法：build\leno.exe bench\verify_bigint_dec.leno

import dirs
import files
import strings
import times

var TAGS = ["2^1000-1", "2^1000+1", "2^2048-1", "2^2048+1", "2^4096-1", "2^4096+1",
            "10^100", "10^1000", "3^5000", "2^10000-1", "-(2^2048-1)", "-(2^10000+1)"]
// 与 TAGS 一一对应的 Python 表达式
var PY = ["(1 << 1000) - 1", "(1 << 1000) + 1", "(1 << 2048) - 1", "(1 << 2048) + 1",
          "(1 << 4096) - 1", "(1 << 4096) + 1", "10 ** 100", "10 ** 1000", "3 ** 5000",
          "(1 << 10000) - 1", "-((1 << 2048) - 1)", "-((1 << 10000) + 1)"]

// Leno 侧**真算**（不是查表）
func leno_val(int i):int {
    if i == 0 { return (1 << 1000) - 1 }
    if i == 1 { return (1 << 1000) + 1 }
    if i == 2 { return (1 << 2048) - 1 }
    if i == 3 { return (1 << 2048) + 1 }
    if i == 4 { return (1 << 4096) - 1 }
    if i == 5 { return (1 << 4096) + 1 }
    if i == 9 { return (1 << 10000) - 1 }
    if i == 10 { return 0 - ((1 << 2048) - 1) }
    if i == 11 { return 0 - ((1 << 10000) + 1) }
    var p = 1
    if i == 6 { for 0:99 to k { p = p * 10 } }
    else if i == 7 { for 0:999 to k { p = p * 10 } }
    else { for 0:4999 to k { p = p * 3 } }
    return p
}

func py_script():string {
    // Python 3.11+ 默认限制 int→str 到 4300 位（DoS 防护）⇒ 大数必须显式放开
    var s = "import sys\nsys.set_int_max_str_digits(0)\n"
    for PY to e { s += $"print({e})\n" }
    return s
}

func head(string s):string {
    if s.len() <= 40 { return s }
    return s.slice(0, 39) + "..."
}

func check_parse(string tag, string text, string expect):int {
    var got = _str(_int(text))
    if got == expect {
        print(strings.format("OK   %-14s%d 位\n", tag, got.len()))
        return 0
    }
    print(strings.format("FAIL %-14sleno=%s / 期望=%s\n", tag, head(got), head(expect)))
    return 1
}

main() {
    var work = dirs.join(_tmpdir(), $"leno_decverify_{_int(times.ms())}")
    dirs.mkdir_p(work)
    var pyf = dirs.join(work, "truth.py")
    files.write(pyf, py_script())

    var r = _exec($"python \"{pyf}\"", 600000)
    if r == null or r.code != 0 {
        print($"真值预言机跑失败（exit={r.code}）\n")
        dirs.delete(work)
        _exit(2)
    }
    var expect = strings.split(_str(r.output), "\n")

    // ── 打印方向 ──
    var bad = 0
    var i = 0
    while i < TAGS.len() {
        var got = _str(leno_val(i))
        var want = ""
        if i < expect.len() { want = strings.trim(expect[i]) }
        if got == want {
            print(strings.format("OK   %-14s%d 位\n", TAGS[i], got.len()))
        } else {
            bad += 1
            print($"FAIL {strings.pad_end(TAGS[i], 14)}leno={got.len()} 位 / 真值={want.len()} 位\n")
            print($"     leno: {head(got)}\n     真值: {head(want)}\n")
        }
        i += 1
    }

    // ── 解析方向（400 位阈值两侧 + 前导零 + 负数）──
    var p_tags = ["9 位", "10 位", "18 位", "399 位", "400 位(阈值)", "401 位",
                  "1 后跟 500 零", "前导零", "负数 1000 位"]
    var texts = ["999999999", "1234567890", "123456789012345678",
                 strings.rep("9", 399), strings.rep("9", 400), strings.rep("9", 401),
                 "1" + strings.rep("0", 500), strings.rep("0", 50) + "123456789",
                 "-" + strings.rep("7", 1000)]
    var expects = ["999999999", "1234567890", "123456789012345678",
                   strings.rep("9", 399), strings.rep("9", 400), strings.rep("9", 401),
                   "1" + strings.rep("0", 500), "123456789", "-" + strings.rep("7", 1000)]
    print(strings.rep("-", 60) + "\n")
    var pbad = 0
    var k = 0
    while k < p_tags.len() {
        pbad += check_parse(p_tags[k], texts[k], expects[k])
        k += 1
    }

    dirs.delete(work)
    print(strings.rep("-", 60) + "\n")
    print($"打印方向 {TAGS.len()} 例，失败 {bad}\n")
    print($"解析方向 {p_tags.len()} 例，失败 {pbad}\n")
    if bad > 0 or pbad > 0 { _exit(1) }
}
