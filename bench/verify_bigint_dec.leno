// bench/verify_bigint_dec.leno —— bigint → 十进制：与 Python 真值**逐字节**比对（Leno 驱动）
//
// 分工：
//   · Leno：造值、算 `_str(...)`、逐行比对、报结论；
//   · Python：只当"真值预言机"（把同一批表达式的十进制结果打出来）。
//   这样驱动/判据都在 Leno 里（少一层依赖、也是压测），预言机保留是因为**独立实现**才有意义
//   （用 Leno 自己验 Leno 只能抓"两次调用不一致"，抓不到系统性算错）。
//
// 覆盖：2^n±1（1000/2048/4096/10000）、10^100、10^1000、3^5000、负数。
// 用法：build\leno.exe bench\verify_bigint_dec.leno

import dirs
import files
import strings
import times

const N = 12

func tag_of(int i):string {
    if i == 0 { return "2^1000-1" }
    if i == 1 { return "2^1000+1" }
    if i == 2 { return "2^2048-1" }
    if i == 3 { return "2^2048+1" }
    if i == 4 { return "2^4096-1" }
    if i == 5 { return "2^4096+1" }
    if i == 6 { return "10^100" }
    if i == 7 { return "10^1000" }
    if i == 8 { return "3^5000" }
    if i == 9 { return "2^10000-1" }
    if i == 10 { return "-(2^2048-1)" }
    return "-(2^10000+1)"
}

// 预言机侧：同一批表达式的 Python 文本
func py_expr(int i):string {
    if i == 0 { return "(1 << 1000) - 1" }
    if i == 1 { return "(1 << 1000) + 1" }
    if i == 2 { return "(1 << 2048) - 1" }
    if i == 3 { return "(1 << 2048) + 1" }
    if i == 4 { return "(1 << 4096) - 1" }
    if i == 5 { return "(1 << 4096) + 1" }
    if i == 6 { return "10 ** 100" }
    if i == 7 { return "10 ** 1000" }
    if i == 8 { return "3 ** 5000" }
    if i == 9 { return "(1 << 10000) - 1" }
    if i == 10 { return "-((1 << 2048) - 1)" }
    return "-((1 << 10000) + 1)"
}

// Leno 侧：真算一遍（不是查表）
func leno_val(int i):int {
    if i == 0 { return (1 << 1000) - 1 }
    if i == 1 { return (1 << 1000) + 1 }
    if i == 2 { return (1 << 2048) - 1 }
    if i == 3 { return (1 << 2048) + 1 }
    if i == 4 { return (1 << 4096) - 1 }
    if i == 5 { return (1 << 4096) + 1 }
    if i == 9 { return (1 << 10000) - 1 }
    if i == 10 { return 0 - ((1 << 2048) - 1) }
    if i == 11 { return 0 - ((1 << 10000) + 1) }
    if i == 6 {
        var p6 = 1
        for 0:99 to k { p6 = p6 * 10 }
        return p6
    }
    if i == 7 {
        var p7 = 1
        for 0:999 to k { p7 = p7 * 10 }
        return p7
    }
    var p3 = 1
    for 0:4999 to k { p3 = p3 * 3 }
    return p3
}

func py_script():string {
    // ⚠ Python 3.11+ 默认限制 int→str 到 4300 位（DoS 防护）⇒ 大数必须显式放开
    var s = "import sys\nsys.set_int_max_str_digits(0)\n"
    var i = 0
    while i < N {
        s = s + "print(" + py_expr(i) + ")\n"
        i = i + 1
    }
    return s
}

main() {
    var work = dirs.join(_tmpdir(), "leno_decverify_" + _str(_int(times.ms())))
    dirs.mkdir_p(work)
    var pyf = dirs.join(work, "truth.py")
    files.write(pyf, py_script())

    var r = _exec("python \"" + pyf + "\"", 600000)
    if r == null or r.code != 0 {
        print("真值预言机跑失败（exit=" + _str(r.code) + "）\n")
        dirs.delete(work)
        _exit(2)
    }
    var expect = strings.split(_str(r.output), "\n")

    var bad = 0
    var i = 0
    while i < N {
        var got = _str(leno_val(i))
        var want = ""
        if i < expect.len() { want = strings.trim(expect[i]) }
        if got == want {
            print("OK   " + pad(tag_of(i), 14) + _str(got.len()) + " 位\n")
        } else {
            bad = bad + 1
            print("FAIL " + pad(tag_of(i), 14) + "leno=" + _str(got.len())
                  + " 位 / 真值=" + _str(want.len()) + " 位\n")
            print("     leno: " + head(got) + "\n")
            print("     真值: " + head(want) + "\n")
        }
        i = i + 1
    }

    // ── 反向：十进制文本 → bigint（`_int`），覆盖 400 位阈值两侧与边界形态 ──
    //   为什么不需要预言机：输入与期望都是**我们自己写的字面量**（前导零这些形态
    //   Python 也只会给出同一个规范串），所以纯 Leno 就能判 ✓
    print(strings.rep("-", 60) + "\n")
    var pbad = 0
    pbad = pbad + check_parse("9 位", "999999999", "999999999")
    pbad = pbad + check_parse("10 位", "1234567890", "1234567890")
    pbad = pbad + check_parse("18 位", "123456789012345678", "123456789012345678")
    pbad = pbad + check_parse("399 位", strings.rep("9", 399), strings.rep("9", 399))
    pbad = pbad + check_parse("400 位(阈值)", strings.rep("9", 400), strings.rep("9", 400))
    pbad = pbad + check_parse("401 位", strings.rep("9", 401), strings.rep("9", 401))
    pbad = pbad + check_parse("1 后跟 500 零", "1" + strings.rep("0", 500), "1" + strings.rep("0", 500))
    pbad = pbad + check_parse("前导零", strings.rep("0", 50) + "123456789", "123456789")
    pbad = pbad + check_parse("负数 1000 位", "-" + strings.rep("7", 1000), "-" + strings.rep("7", 1000))

    dirs.delete(work)
    print(strings.rep("-", 60) + "\n")
    // ⚠ 拆成两行打印：合成一整串时**汇总行会丢**（实测，原因待查 ——
    //   可能与中文分号 `；` 或过长的拼接有关）；分开写就正常，先绕开
    print("打印方向 " + _str(N) + " 例，失败 " + _str(bad) + "\n")
    print("解析方向 9 例，失败 " + _str(pbad) + "\n")
    if bad > 0 or pbad > 0 { _exit(1) }
}

// 解析一对：`_int(text)` 再 `_str` 回来，应与 expect 一致
func check_parse(string tag, string text, string expect):int {
    var got = _str(_int(text))
    if got == expect {
        print("OK   " + pad(tag, 14) + _str(got.len()) + " 位\n")
        return 0
    }
    print("FAIL " + pad(tag, 14) + "leno=" + head(got) + " / 期望=" + head(expect) + "\n")
    return 1
}

func pad(string s, int w):string {
    var out = s
    while out.len() < w { out = out + " " }
    return out
}

func head(string s):string {
    if s.len() <= 40 { return s }
    return s.slice(0, 39) + "..."
}
