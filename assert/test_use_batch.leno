// use 批量导入语法测试
// 语法: use module.(A, B, C)
import "use_mod_a.leno" as a
import "use_mod_b.leno" as b

// 批量导入：同一模块的多个类型
use a.(Point)
use b.(Color)

main() {
    Point p = new a.Point(x = 3, y = 4)
    assert_eq(p.x, 3)
    assert_eq(p.y, 4)

    Color c = new b.Color(r = 255, g = 128, b = 0)
    assert_eq(c.r, 255)
    assert_eq(c.g, 128)
    assert_eq(c.b, 0)

    print("test_use_batch passed")
}
