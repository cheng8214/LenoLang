// test_check_flag.leno —— `--check` 到底检查什么（2026-10-20 修范围）
//
// 旧实现（B12）在"语义之后"就早退，而 import 的模块是在 **codegen 遇到 import 时**才编译的
//   ⇒ 模块体一条都没查：模块里写 `int x = "oops"`，`--check` 照样打印"检查通过" ✗
//   （用户原话：--check 没啥暖用 —— 判断成立 ✓）
// 现在早退点挪到 codegen 之后，代价是多跑一遍 codegen（实测 site.leno 39 → 38~45ms，
//   仍比 `-c` 的 63ms 快），换来"通过"真的可信。
//
// 判据：
//   ① 好文件 ⇒ 退出 0、输出"编译检查通过"、**不产出 .lenb**
//   ② 被 import 的模块里有类型错误 ⇒ 退出非 0，且报错点名那个模块文件
//   ③ 入口自身有错 ⇒ 退出非 0
import dirs
import files
import strings

main() {
    var work = dirs.join(_tmpdir(), "leno_check_flag")
    dirs.delete(work)
    dirs.mkdir_p(work)

    // ---------- ① 好文件 ----------
    var okFile = dirs.join(work, "ok.leno")
    files.write(okFile, @"main() {
    print(""hi"")
}
")
    var r1 = _exec(_executable() + " --check \"" + okFile + "\"", 30000)
    assert_eq(r1.code as int, 0, "①好文件 --check 退出 0")
    assert_true((r1.output as string).has("编译检查通过"), "①输出说通过了")
    assert_true(not files.exists(dirs.join(work, "ok.lenb")), "①不产出 .lenb")

    // ---------- ② 模块里有类型错误（旧版会漏）----------
    var badMod = dirs.join(work, "bad_mod.leno")
    files.write(badMod, @"export func f(): int {
    int x = ""oops""
    return x
}
")
    var entry = dirs.join(work, "entry.leno")
    files.write(entry, @"import ""bad_mod.leno"" as m
main() {
    print(m.f())
}
")
    var r2 = _exec(_executable() + " --check \"" + entry + "\"", 30000)
    assert_true((r2.code as int) != 0, "②模块有错 ⇒ 退出非 0")
    var out2 = r2.output as string
    assert_true(out2.has("bad_mod.leno"), "②报错点名模块文件")
    assert_true(out2.has("类型") or out2.has("不匹配"), "②是类型错误")

    // ---------- ③ 入口自身有错 ----------
    var selfBad = dirs.join(work, "self_bad.leno")
    files.write(selfBad, @"main() {
    int y = ""nope""
    print(y)
}
")
    var r3 = _exec(_executable() + " --check \"" + selfBad + "\"", 30000)
    assert_true((r3.code as int) != 0, "③入口自身有错 ⇒ 非 0")

    print("test_check_flag passed（好文件通过 / 模块错误被抓 / 入口错误被抓）")
}
