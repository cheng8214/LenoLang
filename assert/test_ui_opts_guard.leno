// test_ui_opts_guard.leno — 控件选项对账"**真的会拦**"吗？
//
// 为什么值得有这么个测试（2026-09-29）：
//   这套对账的价值**全在两条**：① 该报的一定报 ✓ ② 不该报的一句不报 ✓
//   任一条失守，它就退化成噪音 ✗（要么漏掉拼错的键 ✗，要么把合法用法刷屏 ✗）
//   ⇒ 光靠肉眼看屏是回归不住的 ⇒ 用断言钉住 ✓（这也是它**无 SDL 依赖**的原因 ✓：
//     只测 sdl_opts 这个纯逻辑层 ✓ ⇒ 不需要窗口/字体 ⇒ 哪里都能跑 ✓）
//
// 覆盖：错键必报 ✓ / 对键零报 ✓ / 近名建议 ✓（icon→image、basiss→basis ✓）/
//       去重（循环里建控件不刷屏 ✓）/ 空 Dict 与 null 不炸 ✓ / STRICT 前缀 ✓（★ 2026-10-13：
//       这句原来**只是口号** ✗ —— 正文根本没断言过 ⇒ 本轮补上，并把前缀抽成可断言的纯函数 ✓）/
//       窗口侧通用键 `z` 豁免（防误报 ✓ 2026-10-13 补）/ 内边距键**四套写法**用错时有近名提示 ✓
import "sdl_opts" as dochk
import strings

var fails = 0
func check(string name, bool ok) {
    if ok {
        print($"[通过] {name}")
    } else {
        fails = fails + 1
        print($"[失败] {name}")
    }
}

// 日志里有没有某条（子串匹配 ✓）
func has(Array[string] log, string sub): bool {
    for log to s { if strings.find(s, sub) >= 0 { return true } }
    return false
}

main() {
    // ==================== ① 错键 ⇒ 必须拦下 ====================
    dochk.check("探针A", {label: "x", icon: "a.png"}, ["label", "image"])
    var l1 = dochk.take_log()
    check("错键 ⇒ 拦下 1 条", l1.len() == 1)
    check("拦下的提示里含键名 icon", has(l1, "icon"))
    check("提示里含控件名 探针A", has(l1, "探针A"))

    // ==================== ② 全对 ⇒ 一条都不能报 ====================
    dochk.check("探针B", {label: "x", image: "a.png"}, ["label", "image"])
    check("全对 ⇒ 零警告（不误报 ✓）", dochk.take_log().len() == 0)

    // ==================== ③ 近名建议（这套东西最值钱的一条 ✓）====================
    dochk.check("探针C", {basiss: 1}, ["basis", "grow"])
    var l3 = dochk.take_log()
    check("错键 basiss ⇒ 拦下 1 条", l3.len() == 1)
    check("给出近名建议 basis", has(l3, "basis"))
    check("提示用了『你是不是想要』句式", has(l3, "你是不是想要"))

    // ==================== ④ 去重：同一个 (控件,键) 只报一次 ====================
    //   （循环里建 N 个控件时，绝不能刷 N 行 ✗）
    dochk.check("探针D", {nope: 1}, ["a"])
    dochk.check("探针D", {nope: 1}, ["a"])
    dochk.check("探针D", {nope: 1}, ["a"])
    check("同键重复提交 ⇒ 只报一次", dochk.take_log().len() == 1)
    // 去重只针对**同一个键** ✓ ⇒ 换一个键该报还是报（不能把新错误吞掉 ✗）
    dochk.check("探针D", {other: 2}, ["a"])
    check("换个键 ⇒ 照报（去重不误伤 ✓）", dochk.take_log().len() == 1)

    // ==================== ⑤ 边界：空 Dict / null / 空白名单 ====================
    dochk.check("探针E", {}, ["a"])
    check("空 Dict ⇒ 零警告", dochk.take_log().len() == 0)
    dochk.check("探针F", {zzz: 1}, [])   // ⚠ 键名别用 `any` —— 那是保留字（会被当成类型 ✗）
    check("空白名单 ⇒ 任意键都算不认识（报 1 条）", dochk.take_log().len() == 1)

    // ==================== ⑥ 近名函数本身（含"太远就不给建议"✓）====================
    check("near(icon, [image,label]) ⇒ 无建议（差太远 ✓）", dochk.near("icon", ["image", "label"]) == "")
    check("near(basiss, [basis]) ⇒ basis", dochk.near("basiss", ["basis"]) == "basis")
    check("near(imiage, [image]) ⇒ image", dochk.near("imiage", ["image"]) == "image")
    check("near 完全相等 ⇒ 也给回自己（距离 0 ✓）", dochk.near("image", ["image"]) == "image")

    // ==================== ⑦ STRICT 前缀（2026-10-13 补 ✓）====================
    //   头注一直声称覆盖它 ✗ 但正文**没有断言** ✓ ⇒ 本轮补上 ✓
    //   注意两个事实（都是实测出来的 ✓）：
    //     · `take_log()` 里存的是**原文**（不带前缀 ✓）⇒ 断言里**没有** `[ui]` ✓
    //     · 前缀由 `dochk.format_line()` 生成 ✓ ⇒ 断言这个纯函数即可（两种模式都对得上 ✓）
    dochk.check("探针G", {nope: 1}, ["a"])
    var l7 = dochk.take_log()
    check("日志存的是**原文**（不带前缀 ✓ 便于子串断言）",
          l7.len() == 1 and strings.find(l7[0], "[ui]") < 0 and strings.find(l7[0], "nope") >= 0)
    string pfx = dochk.format_line("X")
    if dochk._strict() {
        check("STRICT 模式的可见前缀 = `[ui][STRICT] ` ✓", strings.find(pfx, "[ui][STRICT] ") == 0)
    } else {
        check("非 STRICT 的可见前缀 = `[ui] ` ✓", strings.find(pfx, "[ui] ") == 0)
        check("非 STRICT 模式**不能**出现 STRICT 字样 ✓", strings.find(pfx, "[STRICT]") < 0)
    }

    // ==================== ⑧ 窗口侧通用键 `z` 不算未知（2026-10-13 补 ✓）====================
    //   为什么：`z` 由 `Window.addXxx` 读走做层级 ✓，控件自己不认它 ⇒ 按未知键报就是**误报** ✗
    dochk.check("探针H", {z: 3.0}, ["text"])
    check("窗口侧键 z ⇒ 不报（防误报 ✓）", dochk.take_log().len() == 0)
    dochk.check("探针H", {zz: 3.0}, ["text"])
    check("豁免只针对 z：`zz` 仍要报 ✓", dochk.take_log().len() == 1)

    // ==================== ⑨ 内边距键"分裂"必须被兜住（2026-10-13 补 ✓）====================
    //   现状：全库**四套写法**（`pad` / `pad_x·pad_y` / `padX·padY` / `padding`）✗
    //   ⇒ 不强行统一（有几处是**刻意的**：Button 的 `padding` 是文字内边距、
    //     Card 的 `pad` 与 `content_pad` 语义不同、layout 的 `padTop/Left/…` 是四边非对称 ✓）
    //   ⇒ 退而求其次：**用错时必须被近名提示兜住** ✓（否则使用者只能瞎猜 ✓）
    //   ★ 2026-10-13（选项命名统一）：`padX` / `padY`（gridlayout）已收敛成 **`pad_x` / `pad_y`** ✓
    //     （同概念同写法：alert / badge / drag / card… 早就用后者 ✓）⇒ 进了**改名表** ✓
    //     其余差异**保留**（上面那几处"刻意"的理由仍然成立 ✓）
    dochk.check("Badge", {pad: 6}, ["pad_x", "pad_y"])
    var l9 = dochk.take_log()
    check("Badge 传 pad ⇒ 报未知键", l9.len() == 1)
    check("并提示近名 pad_x ✓（分裂但可发现 ✓）", has(l9, "pad_x"))
    // 反向：Canvas 那族用的是光杆 `pad` ✓ ⇒ 传 `pad_x` 也要被指回 `pad` ✓
    dochk.check("Canvas", {pad_x: 6}, ["pad"])
    check("Canvas 传 pad_x ⇒ 指回 pad ✓", has(dochk.take_log(), "pad"))

    // ==================== ⑩ 改名表：旧名"**能用但会被告知**"（2026-10-13 补 ✓）====================
    //   为什么必须有这一节：改名的最大风险是"用户代码**悄悄**失效" ✗。改名表给了两条保证：
    //     · 旧名**照旧可用**（控件那边仍然读它 ✓）⇒ **现有代码零破坏** ✓
    //     · 但会被 warn 一次 ⇒ **警告清零 = 迁移完成**，可验证 ✓
    //   ⚠ 本节的**核心判据**：旧名**仍在白名单里**（因为控件还在读它）⇒ 必须**照样报** ✓
    //     如果把改名判断放在 `known` 之后，旧名在白名单里就**永远不报** ✗（那这张表等于没用 ✓）
    check("renamed_to(fontSize) ⇒ font_size", dochk.renamed_to("fontSize") == "font_size")
    check("renamed_to(padY) ⇒ pad_y", dochk.renamed_to("padY") == "pad_y")
    check("renamed_to(imageMode) ⇒ image_mode", dochk.renamed_to("imageMode") == "image_mode")
    check("renamed_to 对正常键 ⇒ 空串 ✓", dochk.renamed_to("bg_color") == "")

    dochk.check("探针I", {fontSize: 20.0}, ["font_size", "fontSize"])
    var l10 = dochk.take_log()
    check("★ 旧名**即使在白名单里**也必须报（否则永远发现不了 ✗）", l10.len() == 1)
    check("提示里给出**新名** font_size ✓", has(l10, "font_size"))
    check("口径是『已改名』（**不是**『不认识的选项』✓）", has(l10, "已改名"))
    // 反向：新名**一条都不能报** ✓（否则迁移完了还有噪音 ✗）
    dochk.check("探针J", {font_size: 20.0}, ["font_size", "fontSize"])
    check("新名 ⇒ 零警告 ✓", dochk.take_log().len() == 0)
    // 改名表**不是**近名建议的替代：真正拼错的键仍走"你是不是想要 xxx" ✓
    dochk.check("探针K", {fontsize: 20.0}, ["font_size"])
    check("拼错（fontsize）仍走近名建议 ✓", has(dochk.take_log(), "你是不是想要"))

    print("")
    if fails > 0 {
        print($"共 {fails} 项失败")
        _exit(1)
    }
    print("全部通过（对账确实会拦 ✓ 且不误报 ✓）")
}
