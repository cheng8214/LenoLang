// 数组测试
var arr = [1, 2, 3, 4, 5]
assert_eq(arr.len(), 5)
assert_eq(arr[0], 1)
assert_eq(arr[4], 5)

arr.add(6)
assert_eq(arr.len(), 6)
assert_eq(arr[5], 6)

arr[0] = 10
assert_eq(arr[0], 10)

var empty = []
assert_eq(empty.len(), 0)

var mixed = [1, "two", true, null]
assert_eq(mixed.len(), 4)

print("test_array passed")
