// 无界面门禁：用 SDL 模块自带的**确定性基准模式**跑真实游戏脚本（飞机大战）。
//
// 覆盖：启动（SDL3 模块加载 / 字体 / 音频）→ 逐帧渲染循环 → 跑满退出。
// 不覆盖：需要键盘输入的交互路径（"回车开始 → 开火两发"）—— SDL dummy 驱动收不到键盘
//         事件 ⇒ 那条路径仍只能人工跑（或用 SDL_PushEvent 注入，未做）。
//
// 依赖的机制：`LENO_SDL_FRAMES=<n>` + `SDL_VIDEODRIVER=dummy`（见 leno_module/LenoSDL3/lib/
// sdl_window.leno:1067 的说明：跑满 n 帧后自动清理退出并打印一行确定性摘要；纯软件、不开窗口）。
// 语言没有 setenv 内建（sys.c 只注册了 _env/_os/_exec/_args/_exit）⇒ 环境变量只能在
// **子进程命令行**里设置，且 Windows(cmd) 与 POSIX(sh) 写法不同 ⇒ 用 `_os()` 分支。
//
// 判据：① 正常退出（不卡死）② 出口码 0 ③ 输出含"启动成功" ④ 输出含 frames=<N> 摘要
//      （=真跑满，不是提前退出）。

import dirs
import files
import strings

func tail_lines(string s, int n):string {
    var lines = strings.split(s, "\n")
    var out = ""
    int i = lines.len() - n
    if i < 0 { i = 0 }
    while i < lines.len() {
        out = out + lines[i] + "\n"
        i = i + 1
    }
    return out
}

main() {
    // 本用例走完整的 GUI 栈（LenoSDL3 + LenoMusic）。两个平台都能跑：
    //   LenoMusic 现按 `_os()` 加载 `miniaudio.dll`（Windows）/ `miniaudio.so`（POSIX，见
    //   src/build_so.sh）；无音频设备的环境下引擎初始化失败会**优雅降级为静音**
    //   （打印「音频初始化失败，游戏将以静音模式运行」后照常跑帧）⇒ 不影响下面的帧数判据 ✓
    int frames = 120
    // 用 `_executable()`（= 当前解释器自身的绝对路径）而不是写死 "build\leno.exe"：
    // 本仓库的解释器产物叫 leno.exe（build.bat）/ leno_vm.exe（build_vm.bat），
    // 写死成品名会让用例"还没跑就注定失败"（实测 exit=1、输出为空）。
    // 这也是 assert/helpers/compiler.leno 的既有口径（它同样用 `_executable()`）。
    var leno = _executable()
    assert_eq(leno != null, true)     // 解释器路径必须解析得出来

    // ★ 2026-10-11：七个游戏已迁到**独立仓 LenoGame**（本仓不再含 leno_gui/游戏/）
    //   ⇒ 按顺序探三个位置（谁在就用谁 ✓）：
    //     ① 环境变量 `LENO_GAME_DIR` 指向 LenoGame 仓根 ✓
    //     ② 本仓旧位置（兼容还没迁完的工作区 ✓）
    //     ③ 与本仓**同级**的 `..\LenoGame` ✓
    //   ⚠ 一处都没有 ⇒ **跳过**（打印一行说明、不算失败 ✓）—— 这是"依赖外部仓的用例"的正确姿态：
    //     没装就跳过；判红只会逼人把这个用例删掉 ✗（那就把覆盖丢了 ✗）
    var rel = dirs.join("飞机大战", "plane_war.leno")
    var cands = []
    var gameDir = _env("LENO_GAME_DIR")
    if gameDir != null and gameDir != "" { cands.add(dirs.join(gameDir, rel)) }
    cands.add(dirs.abspath(dirs.join("leno_gui", "游戏", rel)))
    cands.add(dirs.abspath(dirs.join("..", "LenoGame", rel)))
    var game = ""
    for cands to cand {
        if files.exists(cand) { game = cand  break }
    }
    if game == "" {
        print("[SKIP] 飞机大战无界面门禁用例：找不到 " + rel + "\n")
        print("       游戏已迁到 LenoGame 仓 ✓ —— 把 LenoGame 放在本仓同级，或设 LENO_GAME_DIR 指向它即可跑 ✓\n")
        return
    }

    var run = "\"" + leno + "\" --no-cache \"" + game + "\""
    // 注意：`_exec` 在 Windows 下已经经过 `cmd /c`，这里不要再自己加 "cmd /c"；
    // `set X=v&&` 里 `&&` 前不留空格，否则值会带上尾空格。
    var cmd = ""
    if _os() == "windows" {
        cmd = "set SDL_VIDEODRIVER=dummy&& set LENO_SDL_FRAMES=" + frames + "&& " + run
    } else {
        cmd = "SDL_VIDEODRIVER=dummy LENO_SDL_FRAMES=" + frames + " " + run
    }

    var r = _exec(cmd)
    if r == null {
        assert_eq("_exec 返回 null", "期望 [输出, 退出码]")
        return
    }
    var out = r.output
    var code = r.code
    if out == null { out = "" }

    // 失败时把尾部输出打出来，便于定位（成功时不打印，保持套件安静）
    var want_frames = "frames=" + frames + " "
    if code != 0 or not strings.has(out, want_frames) {
        print("---- 飞机大战（无界面，" + frames + " 帧）输出尾部 ----")
        print(tail_lines(out, 25))
        print("----------------------------------------------")
    }

    assert_eq(code, 0)                                         // ① 正常退出（卡死会超时/异常收尾）
    assert_eq(strings.has(out, "[OK] 飞机大战启动成功"), true)        // ② 真的启动起来了
    assert_eq(strings.has(out, want_frames), true)             // ③ 真跑满 N 帧（不是提前退出）

    // ④ 历史教训（§8.129）：曾经"某条指令每轮回退 + 同一轮已有堆侧副作用"
    //   会静默把副作用执行两遍 ✗。现在没有这类回退路径，判据只剩上面三条。

    print("test_plane_war_headless passed")
}
