// 回归测试模块：导出含 >= 2^31 位标志值的 enum
// 复现 BUG_TRAY_COMPILER.md：enum 成员值 >= 2^31 时 u32 FFI 传参溢出
export enum TrayEntryFlag {
    BUTTON   = 0x00000001
    CHECKBOX = 0x00000002
    SUBMENU  = 0x00000004
    DISABLED = 0x80000000
    CHECKED  = 0x40000000
}

// 负值成员回归：运行期按名取成员值的函数曾用「返回 -1」表示未找到，
// 调用方判 `值 < 0` ⇒ 合法负值成员被误报「enum 'X' 没有成员 'NEG'」。
// 已改为 found 出参（enum_def_lookup_member_value）。
export enum SignedFlag {
    NEG_ONE = -1
    NEG_BIG = -100
    ZERO    = 0
    POS     = 5
}
