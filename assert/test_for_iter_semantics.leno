// 回归测试：`for 容器 to v [, idx]` 的迭代语义
//
// ★ 2026-11-26 **语义变更**：循环边界在**进入时确定**（捕获一次 len），不再每轮重读。
//   旧约定是"长度每轮重读"⇒ `for a to x { a.add(..) }` 会边加边遍历（6 轮、可能停不下来），
//   `remove` 会静默跳过元素 —— 两条都是**静默**的行为改变，且编译器看不到别名/闭包/线程
//   里的修改，靠警告永远补不全。
//   新约定：边界固定；容器**变短**时取元素必越界 ⇒ 运行期**当场报错**
//   （"数组迭代索引越界（遍历中容器被改短了？…）"），不再静默。
//   两条规则都由本文件钉住（① 追加不变长、② 变短会抛错）。
//
// 同时覆盖：空容器不进体、break/continue 绑定、带索引变量、字典/结构体/枚举迭代、
//   嵌套（内层 continue 不得跳到外层）。

enum Color { RED; GREEN; BLUE }

// ① 迭代中追加：**边界在进入时确定** ⇒ 循环**不会**被撑长
//    进入时 len=2 ⇒ 只走 2 轮；两轮各追加一个 ⇒ 最终 len=4
var grow = [1, 2]
var rounds = 0
for grow to x {
    rounds = rounds + 1
    if rounds < 5 {
        grow.add(9)
    }
}
assert_eq(rounds, 2)
assert_eq(grow.len(), 4)

// ①b 迭代中删除：容器变短 ⇒ 取元素越界，**运行期抛错**（不再静默跳过）
//    用 try 捕获，断言错误文案点明"改短"
var shrink = [1, 2, 3, 4, 5]
int caught = 0
try {
    for shrink to v {
        if v == 2 { shrink.remove(1) }     // len 5 → 4，但循环边界仍是 5
    }
} catch e {
    caught = 1
    assert_true(_str(e).has("改短"), "越界错误应点明'遍历中容器被改短'；实际：" + _str(e))
}
assert_eq(caught, 1)

// ② 空容器：一次都不进（入口那条"为假则跳"）
var empty = []
var entered = 0
for empty to x {
    entered = entered + 1
}
assert_eq(entered, 0)

// ③ break / continue：continue 走"先自增再测"，break 到退出
var b = [1, 2, 3, 4, 5]
var s = 0
for b to v {
    if v == 2 {
        continue
    }
    if v == 5 {
        break
    }
    s = s + v
}
assert_eq(s, 8)

// ④ 带索引变量
var idx_sum = 0
var idx_str = ""
for b to v, i {
    idx_sum = idx_sum + i
    idx_str = idx_str + i
}
assert_eq(idx_sum, 10)
assert_eq(idx_str, "01234")

// ⑤ 字典：键/值两路（值是 OP_ITER_GET_VALUE，不是序号）
var d = {"a": 1, "b": 2}
var keys = ""
var vals = 0
for d to k, val {
    keys = keys + k
    vals = vals + val
}
assert_eq(vals, 3)
assert_eq(keys.len(), 2)

// ⑥ 枚举：成员遍历（长度支缺了会让循环一次都不进）
var n = 0
for Color to c {
    n = n + 1
}
assert_eq(n, 3)

// ⑦ 嵌套：内层 continue 必须只作用于内层（若跳错到外层，k 会多算成 5）
var outer_sum = 0
for b to ov {
    var k = 0
    for b to inner {
        if inner == 2 {
            continue
        }
        k = k + 1
    }
    outer_sum = outer_sum + k
}
assert_eq(outer_sum, 20)

// ⑧ 循环变量在体内被重新赋值不影响下一轮取值（每轮由 ITER_GET 重取）
var sum2 = 0
for b to v2 {
    sum2 = sum2 + v2
    v2 = 1000
}
assert_eq(sum2, 15)

print("test_for_iter_semantics passed")
