// 颜色字面量测试：#RGB / #RRGGBB / #AARRGGBB
// 验证 # 颜色字面量与等价的 0xAARRGGBB 完全相等

main() {
    // --- #RGB 格式（每位重复，Alpha 默认 0xFF）---
    const _c_f00    = #F00       // 期望 0xFFFF0000
    const _c_0f0    = #0F0       // 期望 0xFF00FF00
    const _c_00f    = #00F       // 期望 0xFF0000FF
    const _c_fff    = #FFF       // 期望 0xFFFFFFFF
    const _c_123    = #123       // 期望 0xFF112233

    // --- #RRGGBB 格式（Alpha 默认 0xFF）---
    const _c_ff0000 = #FF0000    // 期望 0xFFFF0000
    const _c_3366ff = #3366FF    // 期望 0xFF3366FF
    const _c_282830 = #282830    // 期望 0xFF282830
    const _c_000000 = #000000    // 期望 0xFF000000（纯黑不透明）

    // --- #AARRGGBB 格式（显式 Alpha）---
    const _c_80ff0000 = #80FF0000  // 期望 0x80FF0000（半透明红）
    const _c_ff000000 = #FF000000  // 期望 0xFF000000（不透明黑）
    const _c_00ff0000 = #00FF0000  // 期望 0x00FF0000（全透明红）

    // --- 验证等价性 ---
    assert_eq(_c_f00, 0xFFFF0000)
    assert_eq(_c_0f0, 0xFF00FF00)
    assert_eq(_c_00f, 0xFF0000FF)
    assert_eq(_c_fff, 0xFFFFFFFF)
    assert_eq(_c_123, 0xFF112233)

    assert_eq(_c_ff0000, 0xFFFF0000)
    assert_eq(_c_3366ff, 0xFF3366FF)
    assert_eq(_c_282830, 0xFF282830)
    assert_eq(_c_000000, 0xFF000000)

    assert_eq(_c_80ff0000, 0x80FF0000)
    assert_eq(_c_ff000000, 0xFF000000)
    assert_eq(_c_00ff0000, 0x00FF0000)

    // --- 混合使用：颜色字面量与十六进制整数运算 ---
    const _colorRed = #FF0000
    const _colorBlue = #3366FF
    const _colorSemiRed = #80FF0000

    assert_eq(_colorRed, 0xFFFF0000)
    assert_eq(_colorBlue, 0xFF3366FF)
    assert_eq(_colorSemiRed, 0x80FF0000)

    // --- 位运算提取分量（模拟 UI 渲染场景）---
    var _bg = #282830
    assert_eq((_bg >> 16) & 0xFF, 0x28)  // R
    assert_eq((_bg >> 8) & 0xFF, 0x28)   // G
    assert_eq(_bg & 0xFF, 0x30)           // B
    assert_eq((_bg >> 24) & 0xFF, 0xFF)   // A (默认不透明)

    var _semi = #80FF0000
    assert_eq((_semi >> 24) & 0xFF, 0x80) // Alpha = 0x80
    assert_eq((_semi >> 16) & 0xFF, 0xFF) // R = 0xFF

    print("All color literal tests passed!")
}
