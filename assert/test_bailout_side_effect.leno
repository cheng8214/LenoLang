// 循环里的**副作用不得重复执行**（§8.126 的数据污染回归）。
//
// 背景（历史）：当时的机器码在"守卫失败"时会重放整轮 —— 而那一轮里已经发生的副作用
// （数组 append / 计数 / 状态改写）**不回滚** ⇒ 副作用执行两遍 ✗。
// 触发它的是 §8.105 的"歧义区"守卫：普通输入（`[1,2,3]`，非负 int48）就会命中 ⇒
// 数据被污染。修法：撤销那个守卫（§8.126）。
//
// 判据（绝对期望值）：
//   · sum == 201（`for 0:200` 含两端 ⇒ 201 轮）
//   · G.len() == 201 —— 修前是 204（循环里 `G.add(i)` 多执行了 3 次）
var G = []

func f(int n): int {
    var acc = 0
    for 0:n to i {
        G.add(i)                // ← 副作用（每轮必须只执行一次）
        var t = [1, 2, 3]       // ← §8.105 的守卫当年就是在这里误判的（非负元素）
        acc = acc + t[0]
    }
    return acc
}

main() {
    var r = f(200)
    assert_eq(r, 201)
    assert_eq(G.len(), 201)
    print("test_bailout_side_effect passed")
}
