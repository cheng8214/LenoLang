// 警告类诊断回归（2026-10-10 新增）
//
// 为什么要有这个文件：套件原本只有「**必须编译失败**」的入口（`ce.expect_error` ✗），
//   而"漏写 return / 不可达代码"这类诊断是**警告** —— 编译**成功**（exit=0）✓ ⇒
//   它们在套件里表达不出来 ✗。实测后果：`WARN_UNUSED_VAR` / `WARN_UNREACHABLE`
//   在 leno_types.h 里有枚举、在 error.c 里有名字表，却**全仓零调用点** ✗
//   （= 检查根本没实现，也永远不会有人发现 ✓）。⇒ 本文件 + `ce.expect_warning`
//   补上"警告也能被钉住"这条入口 ✓。
//
// 本文件覆盖的两条检查（都是本轮体检发现"静默放过"后实现的 ✓）：
//   A. `[漏写 return]`（WARN_MISSING_RETURN ✓）：函数声明了返回类型却存在走到底的路径。
//      实测危害：调用点**静默拿到 null** ✗（不报错、不警告 ⇒ 极难查 ✓）。
//   B. `[不可达代码]`（WARN_UNREACHABLE ✓）：终止语句（return/throw/break/continue）后面
//      紧邻的语句永远不会执行。
//
// ⚠ 一半的用例是**防误报对照**（"不该报"✓）：新检查最容易在大代码库上刷屏 ✗ ——
//   实测过一次：A 的初版在 SDL3 上刷出 **254 条全误报** ✗（根因：没排除 void 函数
//   在 AST 里的 `TYPE_INFER` 占位 ✓），第二版又被 `try/catch { return ... }` 这种
//   完全正确的写法误报 ✗。这两条都已修 ✓ 并在这里钉住 ✓。

import dirs
import files

// 起编译器子进程 + 判据的共享工具（命令行拼接、失败判据的唯一实现，见 S7）
import "helpers/compiler.leno" as ce

main() {
    var work = dirs.join(_tmpdir(), "leno_diag_warnings")
    // 先清一次：上次若中途断言失败会留下工作目录与 .lenocache，
    // 而"应当编译成功"的对照用例一旦命中旧缓存就直接过 ⇒ 回归就验不出来了 ✓
    dirs.delete(work)
    dirs.mkdir_p(work)

    // ==================== A. 漏写 return ====================

    // A1：`if` 没有 else ⇒ 存在"走到底"的路径 ⇒ 必须报，且落在**函数声明行**（第 1 行）
    var p1 = dirs.join(work, "missing_return_if.leno")
    files.write(p1,
        "func half(int x): int {\n"
        + "    if x > 0 { return x }\n"
        + "}\n"
        + "\n"
        + "main() { print(_str(half(1)) + \"\\n\") }\n")
    ce.expect_warning(p1, "漏写 return：if 无 else", "[漏写 return]", 1)

    // A2（防误报 ✓）：**末尾 return 之后压着死代码**时，不能报"漏写 return" ✗
    //   钉的是本轮修掉的一个自误报：块内原先只看"最后一条语句" ⇒ 被死代码骗 ⇒
    //   `func f(): int { return 1; print("dead") }` 被误判成漏 return ✗
    //   （现改成**正序扫、任一条必然离开即算离开** ✓；那句死代码由 B 单独提示 ✓）
    var p2 = dirs.join(work, "dead_after_return.leno")
    files.write(p2,
        "func f(): int {\n"
        + "    return 1\n"
        + "    print(\"dead\\n\")\n"
        + "}\n"
        + "\n"
        + "main() { print(_str(f()) + \"\\n\") }\n")
    var o2 = ce.expect_warning(p2, "不可达：return 后有死代码", "[不可达代码]", 3)
    ce.expect_no_warning(o2, "不可达：return 后有死代码（不该连带报漏 return）", "[漏写 return]")

    // A3（防误报 ✓）：`try { ... return ... } catch { ... return ... }` 是**正确**写法 ⇒
    //   两边都必然离开 ⇒ 不该报 ✗（本仓 sdl_table 的 to_float / is_number_str 就是它 ✓
    //   初版把这种写法全报成漏 return ⇒ 警告数从个位数顶到 200+ ✗）
    var p3 = dirs.join(work, "try_both_return.leno")
    files.write(p3,
        "func pick(int n): int {\n"
        + "    try {\n"
        + "        return n + 1\n"
        + "    } catch {\n"
        + "        return 0\n"
        + "    }\n"
        + "}\n"
        + "\n"
        + "main() { print(_str(pick(1)) + \"\\n\") }\n")
    var o3 = ce.expect_ok(p3, "对照组：try/catch 两支都 return", "")
    ce.expect_no_warning(o3, "对照组：try/catch 两支都 return", "[漏写 return]")

    // A4（对照 ✓）：`if / else` 两支都 return ⇒ 必然离开 ⇒ 不该报 ✗（钉 if-else 规则 ✓）
    var p4 = dirs.join(work, "if_else_both_return.leno")
    files.write(p4,
        "func sign(int n): int {\n"
        + "    if n > 0 {\n"
        + "        return 1\n"
        + "    } else {\n"
        + "        return -1\n"
        + "    }\n"
        + "}\n"
        + "\n"
        + "main() { print(_str(sign(1)) + \"\\n\") }\n")
    var o4 = ce.expect_ok(p4, "对照组：if/else 两支都 return", "")
    ce.expect_no_warning(o4, "对照组：if/else 两支都 return", "[漏写 return]")

    // A5 ★ 2026-10-10 修（**原来这里钉的是"仍会误报"** ✗ 现在改成"不该报" ✓）
    //   `while true { … }` 恒真 + **本层没有 break** ⇒ 控制流**永远落不到循环之后** ✓
    //   （要么在里面 return/throw 走掉 ✓、要么一直转下去 ✓）⇒ 不该报"漏写 return" ✓
    //   ⚠ 教训（值得留着）：当初把"我没实现"写成了"这是设计取舍" ✗ —— 这条误报害得
    //     一轮体检的结论**虚高** ✓（报了"LenoMusic 3 / LenoTrae 29 条真命中"✗，
    //     查下去 26 条在框架、6 条是 `:void` / `while true` ✓ **全是本检查自己的误报** ✗）
    var p5 = dirs.join(work, "while_true_return.leno")
    files.write(p5,
        "func f(): int {\n"
        + "    while true {\n"
        + "        return 7\n"
        + "    }\n"
        + "}\n"
        + "\n"
        + "main() { print(_str(f()) + \"\\n\") }\n")
    var o5 = ce.expect_ok(p5, "while true + 无 break ⇒ 不报（原先误报）", "7")
    ce.expect_no_warning(o5, "while true + 无 break", "[漏写 return]")

    // A6（对照 ✓）：`while true` 里**有 break** ⇒ 可能落到循环之后 ⇒ 仍然该报 ✓
    //   （而且这正是**真**漏 return：`f(1)` 会 break 出去、走到底返回 null ✗）
    var pwt = dirs.join(work, "while_true_break.leno")
    files.write(pwt,
        "func f(int n): int {\n"
        + "    while true {\n"
        + "        if n > 0 { break }\n"
        + "        return 1\n"
        + "    }\n"
        + "}\n"
        + "\n"
        + "main() { print(_str(f(0)) + \"\\n\") }\n")
    ce.expect_warning(pwt, "while true 里有 break ⇒ 仍报（真漏 return）", "[漏写 return]", 1)

    // A7（对照 ✓）：**显式 `: void`** 不算"声明了返回值" ⇒ 不报 ✓
    //   ⚠ 原先漏了这条 ✗：`void` 在类型解析里是 **TYPE_NULL**（不是 TYPE_INFER ✗）
    //     ⇒ 只排除 TYPE_INFER 的写法会把 `func stop(): void {…}` 和 `func():void {…}`
    //     回调全报出来 ✓（实测就是它和 while true 一起，把两个应用的"命中"顶到 32 条 ✗）
    //   ⚠ 形状照**真实用法**来 ✓：`func():void` 当**实参**传（LenoTrae 的
    //     `cfg.showSettings(win, func():void {…})` ✓）—— 别赋给变量 ✗（那会撞上
    //     "声明类型与初始化值类型不匹配"那个已知 wart ✓ 与本检查无关 ✓）
    var pvoid = dirs.join(work, "void_funcs.leno")
    files.write(pvoid,
        "func stop(): void {\n"
        + "    print(\"s\")" + "\n"
        + "}\n"
        + "\n"
        + "func call_it(func():void cb) { cb() }\n"
        + "\n"
        + "main() { call_it(func():void { stop() }); print(\"ok\\n\") }\n")
    var ovoid = ce.expect_ok(pvoid, "对照：: void 不算声明了返回值", "ok")
    ce.expect_no_warning(ovoid, "对照：: void 与 func():void 回调", "[漏写 return]")

    // ==================== B. 不可达代码 ====================

    // B1：循环体里 `continue` 后面跟一句 ⇒ 那句永远不执行 ⇒ 报在第 4 行
    var p6 = dirs.join(work, "dead_after_continue.leno")
    files.write(p6,
        "main() {\n"
        + "    for 0 : 3 to i {\n"
        + "        continue\n"
        + "        print(\"dead\\n\")\n"
        + "    }\n"
        + "    print(\"done\\n\")\n"
        + "}\n")
    ce.expect_warning(p6, "不可达：continue 后有死代码", "[不可达代码]", 4)

    // B2（防误报 ✓）：正常的多语句块（没有任何终止语句）⇒ 一句都不该报 ✓
    var p7 = dirs.join(work, "no_dead_code.leno")
    files.write(p7,
        "func twice(int n): int {\n"
        + "    int a = n + 1\n"
        + "    int b = a + 1\n"
        + "    return b\n"
        + "}\n"
        + "\n"
        + "main() { print(_str(twice(1)) + \"\\n\") }\n")
    var o7 = ce.expect_ok(p7, "对照组：正常块", "3")   // twice(1) = 1+1+1 = 3 ✓
    ce.expect_no_warning(o7, "对照组：正常块", "[不可达代码]")

    // ==================== C. printf 名字骗人（WARN_PRINTF_NO_FORMAT）====================
    // 速查 §三 ㉖ 的实测：`printf("%d = %s\n", 3, "x")` **不报错** ✗ —— `%d`/`%s` 原样打出来、
    //   后面几个实参只是按空格拼在末尾 ✓（运行时输出就是 `%d = %s` 换行后接 ` 3 x` ✓）。
    //   名字叫 printf ✗ 但语义只有"不换行打印" ⇒ 从 C/Python 过来**第一眼必踩** ✓，
    //   而编译器一声不吭 ⇒ 这类"静默给错"最难查 ✓。现在编译期就提醒 ✓。
    // 判据三条**缺一不报** ✓：① 点名 `printf` ✓ ② 首参是含 '%' 的**字符串字面量** ✓
    //   ③ 实参个数 > 1 ✓ ←（②③ 正是"以为它在做 % 替换"的形状 ✓）

    // C1：正是那个坑 ⇒ 必须报，且落在**调用行**（第 3 行）
    var pc1 = dirs.join(work, "printf_percent.leno")
    files.write(pc1,
        "main() {\n"
        + "    print(\"a\")\n"
        + "    printf(\"%d = %s\\n\", 3, \"x\")\n"
        + "}\n")
    ce.expect_warning(pc1, "printf：首参含 % 且带实参", "[printf不做格式化]", 3)

    // C2（防误报 ✓ **最要紧的一条**）：`format(...)` 是**真格式化**函数 ⇒ **绝不能报它** ✗
    //   ⚠ 这条是**实测当场抓到的** ✗：第一版判据只写"是原生函数 + 首参含 % 的字面量"
    //     ⇒ 实测把 `format("…%d…", 3)` 与 `print("%d", 3)` **一起报了** ✗
    //     —— 等于把**正确答案**骂一遍 ✗（`format` 就在 strings.c 里，与 printf 同族 ✓）。
    //   本用例一次钉住五种"不该报"的形状 ✓（含"变量里装的格式串"⇒ 不猜 ⇒ 不报 ✓）
    var pc2 = dirs.join(work, "printf_no_false_alarm.leno")
    files.write(pc2,
        "main() {\n"
        + "    print(format(\"真格式化: %d-%s\", 3, \"x\") + \"\\n\")\n"
        + "    print(\"%d\", 3)\n"
        + "    printf(\"hello \")\n"
        + "    printf(\"a\", \"b\")\n"
        + "    var f = \"%d\"\n"
        + "    printf(f, 3)\n"
        + "    print(\"\\n\")\n"
        + "}\n")
    var oc2 = ce.expect_ok(pc2, "对照组：format/print/单参/无 %/变量格式串", "真格式化: 3-x")
    ce.expect_no_warning(oc2, "对照组：五种形状都不该报", "[printf不做格式化]")

    // C3：`io.printf(...)` 走**另一条通道**（原生模块方法 ✓）⇒ 同样要报 ✓
    //   两条通道共用 `semantic_check_printf_style` ✓ 但入口是两个（visit_expr / visit_module ✓）
    //   ⇒ 各钉一条，免得将来只改一条、另一条静默失效 ✗
    var pc3 = dirs.join(work, "io_printf_percent.leno")
    files.write(pc3,
        "import io\n"
        + "\n"
        + "main() {\n"
        + "    io.printf(\"%d\\n\", 7)\n"
        + "}\n")
    ce.expect_warning(pc3, "io.printf：模块通道同样要报", "[printf不做格式化]", 4)

    // ============ D. `not` 的优先级陷阱（WARN_NOT_PRECEDENCE，2026-10-10 加）============
    // 形状：**表达式**里写 `not x is T` ⇒ 它其实是 `(not x) is T` ✗（`not` 是前缀一元 ✓）
    //   实测（x = 42）：`not x is string` = **false** ✗、`not (x is string)` = **true** ✓
    //   —— 结论**正好相反** ✓ 且编译一声不吭 ✗（典型"静默给错值" ✓）。
    //   为什么从 Python 过来必踩：那边 `not` 比 `is` / `in` **低**优先级 ⇒ `not x is T`
    //   就等于 `not (x is T)` ✓ ⇒ 两个语言的同一句话意思相反 ✗。
    // ⚠ 顺带记一条**语言口径**（用户确认过 ✓）：`is not` 不存在 ✗；取反写
    //   `x not is T`（if / for **条件位置** ✓）或 `not (x is T)`（**表达式** ✓）。
    //   ⚠ `x not is T` 在表达式里**不合法** ✗（实测报一堆语法错 ✓）。

    // D1：正是那个坑 ⇒ 必须报，落在**函数声明行**（第 1 行整行是一行的形式）
    var pd1 = dirs.join(work, "not_prec_is.leno")
    files.write(pd1,
        "func a1(any x): bool { return not x is string }\n"
        + "main() { print(_str(a1(42)) + \"\\n\") }\n")
    ce.expect_warning(pd1, "not x is T ⇒ 报警告（结果其实是反的）", "[not的优先级陷阱]", 1)

    // D2（防误报 ✓）：六种**不该报**的形状一次钉住 ✓
    //   · `not (x is T)` ✓ 加了括号就是对的（左操作数是括号里的 is ✓）
    //   · `not (x in arr)` / `x not in arr` ✓ 两种正确写法
    //   · `not f == true` / `not f` ✓ **有意**的写法（本检查刻意只查 is 与 in ✗ 不碰比较 ✓）
    //   · `if x not is int { }` ✓ 正式的**否定类型守卫**（条件位置 ✓ parser_stmt_control.c ✓）
    var pd2 = dirs.join(work, "not_prec_ok.leno")
    files.write(pd2,
        "func a2(any x): bool { return not (x is string) }\n"
        + "func b2(Array[int] arr, int x): bool { return not (x in arr) }\n"
        + "func b3(Array[int] arr, int x): bool { return x not in arr }\n"
        + "func c1(bool f): bool { return not f == true }\n"
        + "func c2(bool f): bool { return not f }\n"
        + "func g(any x): int {\n"
        + "    if x not is int { return 1 }\n"
        + "    return 2\n"
        + "}\n"
        + "main() { print(_str(a2(42)) + \"|\" + _str(b2([1], 1)) + \"|\" + _str(c2(false)) + \"\\n\") }\n")
    var od2 = ce.expect_ok(pd2, "对照组：加括号 / not in / 比较 / not is 守卫", "true|false|true")
    ce.expect_no_warning(od2, "对照组：六种形状都不该报", "[not的优先级陷阱]")

    // 清理临时文件（含对照用例成功编译产生的 .lenocache ✓）
    dirs.delete(work)

    print("test_diag_warnings passed")
}
