// rands 模块测试

import rands

main()
{
    // 测试1: ints 生成指定范围的随机整数
    var r1 = rands.ints(1, 10)
    print("随机数1: " + r1)
    assert_eq(r1 >= 1, true)
    assert_eq(r1 <= 10, true)

    var r2 = rands.ints(100, 200)
    print("随机数2: " + r2)
    assert_eq(r2 >= 100, true)
    assert_eq(r2 <= 200, true)

    // 测试2: 生成多个随机数，验证范围
    var all_in_range = true
    for 10 to i {
        var r = rands.ints(1, 100)
        if r < 1 or r > 100 {
            all_in_range = false
        }
    }
    assert_eq(all_in_range, true)

    // 测试3: 生成随机数组 (3个参数: n, min, max)
    var arr = rands.array(5, 1, 100)
    assert_eq(arr.len(), 5)
    for arr to val {
        assert_eq(val >= 1, true)
        assert_eq(val <= 100, true)
    }

    // 测试4: int_array 生成不重复的随机排列 (2个参数: min, max)
    var arr2 = rands.int_array(1, 10)
    assert_eq(arr2.len(), 10)

    // 测试5: 随机浮点数 om()
    var rf = rands.om()
    print("随机浮点数: " + rf)
    assert_eq(rf >= 0.0, true)
    assert_eq(rf < 1.0, true)

    // 测试6: floats 生成范围浮点数
    var rf2 = rands.floats(0.0, 10.0)
    print("范围浮点数: " + rf2)
    assert_eq(rf2 >= 0.0, true)
    assert_eq(rf2 < 10.0, true)

    // ---- 类型契约（v3.2.6，编译期把关）----
    //   `choice(arr)` 返回**元素本身**、`sample(arr,n)` / `shuffle(arr)` 返回**与入参同元素类型**的数组
    //   —— 靠关系型规格 `NATIVE_T_ARG0_ELEM` / `NATIVE_T_ARR_ARG0_ELEM`（返回类型跟第 0 个实参走）。
    //   下面全是**不做收窄**的强类型局部变量 ⇒ 规格一漂（改回 any / Array[any]）就编译失败。
    //   为什么值得钉：native 规格**只在编译期生效**，运行期不校验元素类型 ⇒ 只有编译期能挡住这类回归。
    var nums = [7, 8, 9]
    int picked = rands.choice(nums)
    Array[int] shuffled = rands.shuffle(nums)
    Array[int] sampled = rands.sample(nums, 2)
    assert_eq(shuffled.len(), 3)
    assert_eq(sampled.len(), 2)
    assert_eq(picked >= 7 and picked <= 9, true)
    assert_eq(shuffled[0] + shuffled[1] + shuffled[2], 24)   // 元素是 int ⇒ 能直接做运算

    // ---- 从 examples/rands 收编（2026-09-27）：bools / str / seed(可重复) / gauss / BigInt 档 ints ----
    //   这几个此前在 assert/ 里**零覆盖**（示例是纯 print、无人校验）—— 其中 `seed` 的
    //   "同种子 ⇒ 同序列"是随机模块最要紧的**可用性保证**，最该钉住。
    assert_eq(rands.bools(1.0), true)          // 概率 1.0 ⇒ 恒 true
    assert_eq(rands.bools(0.0), false)         // 概率 0.0 ⇒ 恒 false
    bool maybe = rands.bools(0.5)              // 类型契约：返回 bool（不是 any）
    assert_eq(maybe == true or maybe == false, true)

    string rs = rands.str(8, "abc")
    assert_eq(rs.len(), 8)                     // 长度按请求
    assert_eq(rs.has("d"), false)              // 字符集限定：不会出现 'd'

    rands.seed(12345)
    int rq1 = rands.ints(1, 100)
    rands.seed(12345)
    int rq2 = rands.ints(1, 100)
    assert_eq(rq1, rq2)                        // 同种子 ⇒ 同序列（可重现）

    float rg = rands.gauss(50, 10)             // 类型契约：返回 float
    assert_eq(rg > -500.0 and rg < 600.0, true)

    // 大范围 rands.ints：范围 > int32 ⇒ 走 BigInt 分支（`min + rand_limbs % range`）
    //   ⚠ 这里此前**必崩**（0xC0000005）—— 根因是 BigInt 多 limb 长除法（余数走这条路时
    //   静默返回 null，再被解引用）。2026-09-27 **已修** ✓ 所以现在可以真断言了：
    //   详见 assert/test_bigint_arith.leno 的回归块与 docs 实例二十一。
    assert_eq(rands.ints(1, 4294967296) > 0, true)     // 2^32 上限（int64 快路）
    var rbig = rands.ints(1, 10000000000)              // 更大范围（BigInt 路）⇒ 修前必崩
    assert_eq(rbig >= 1 and rbig <= 10000000000, true)

    print("test_rands passed")
}
