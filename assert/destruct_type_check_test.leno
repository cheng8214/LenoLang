// 解构声明编译时类型检查测试
// 验证：不兼容的类型在编译时被拦截，而不是运行时崩溃
// 此文件包含期望的编译错误（不应通过编译）
//
// ★ 类型检查规则（any 槽位优先）：
//   1. any 槽位：总是兼容，跳过检查，不生成 CAST
//      - var[any, any](a, b) = [1, "x"]      ✓ Array[any] + any 槽位
//      - var[any](a) = [1, 2, 3]              ✓ Array[int] + any 槽位
//   2. 具体类型槽位 + 具体元素类型：走 type_is_compatible 检查
//      - var[int, float](a, b) = [1, 2]       ✓
//      - var[string](a) = [1, 2]              ✗
//   3. 具体类型槽位 + any 元素类型：报错
//      - var[int](a) = [1, "x"]              ✗ Array[any] + int 槽位
//   4. 源不是 Array/Dict：报错
//   5. 源是 any/infer（无返回类型注解的函数）：报错

// ============================================================================
// 1. 数组解构：string 槽位 vs int 元素 — 应编译报错
// ============================================================================
// arr_src 的元素类型是 int（统一类型），槽位声明 string 不兼容
var arr_src = [10, 20, 30]
var[string, int, int](bad1, bad2, bad3) = arr_src  // 期望：槽位 0 类型 string 与数组元素类型 int 不兼容

// ============================================================================
// 2. 字典解构：string 槽位 vs int 值类型 — 应编译报错
// ============================================================================
var dict_src = {"x": 100, "y": 200}
var{"x": string, "y": int}(bad4, bad5) = dict_src  // 期望：槽位 0 类型 string 与字典值类型 int 不兼容

// ============================================================================
// 3. 函数返回值解构：string 槽位 vs 函数返回的 Array[int] — 应编译报错
// ============================================================================
func get_ints(): Array[int] {
    return [1, 2, 3]
}
var[string, int, int](bad6, bad7, bad8) = get_ints()  // 期望：槽位 0 类型 string 与数组元素类型 int 不兼容

// ============================================================================
// 4. 数组解构给非数组 — 应编译报错
// ============================================================================
var not_array = 42
var[int, int](bad9, bad10) = not_array  // 期望：数组解构要求初始化值为 Array 类型，实际为 int

// ============================================================================
// 5. 字典解构给非字典 — 应编译报错
// ============================================================================
var not_dict = "hello"
var{"key": int}(bad11) = not_dict  // 期望：字典解构要求初始化值为 Dict 类型，实际为 string

// ============================================================================
// 6. 数组解构：float → int 截断 — 应编译报错（类型系统不允许 float→int）
// ============================================================================
var float_arr = [3.14, 2.71]
var[int, int](bad12, bad13) = float_arr  // 期望：槽位类型 int 与数组元素类型 float 不兼容

// ============================================================================
// 7. 混合类型数组 + 具体类型槽位 — 应编译报错（Array[any] 不能转具体类型）
// ============================================================================
// [1, 2.0, "hello"] 中 int + float 提升为 float，但 float + string 无法提升 → Array[any]
var mixed_arr = [1, 2.0, "hello"]
var[int, float, string](bad14, bad15, bad16) = mixed_arr  // 期望：源元素类型为 any，无法转换为具体类型

// ============================================================================
// 8. 无返回类型的函数解构 — 应编译报错（返回类型为 infer 不允许解构）
// ============================================================================
func no_return_type() {
    return [1, 2, 3]
}
var[any, any, any](bad17, bad18, bad19) = no_return_type()  // 期望：返回类型为 var，无法确认是 Array

// ============================================================================
// 9. 混合值类型字典 + 具体类型槽位 — 应编译报错（Dict[string, any] 不能转具体类型）
// ============================================================================
// {"count": 10, "ratio": 0.5} 中 int != float → 值类型为 any
var mixed_dict = {"count": 10, "ratio": 0.5}
var{"count": int, "ratio": float}(bad20, bad21) = mixed_dict  // 期望：源值类型为 any，无法转换为具体类型

print("此文件不应通过编译")
