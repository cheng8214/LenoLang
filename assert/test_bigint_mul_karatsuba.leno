// test_bigint_mul_karatsuba.leno —— Karatsuba 乘法的正确性看守（2026-11-22）
//
// 加 Karatsuba 时踩过两个**静默错值**的坑，本用例专门钉它们：
//   ① **丢最高进位**：(a0+a1) 的和可能要 m+1 个 limb，把进位扔掉后，
//      低半段全 1 的操作数（`2^k-1`）必错 —— 而 `2^k` 这种只有一位是 1 的数进位恒为 0，
//      恰好测不出来。⇒ 用例必须用 **`2^k-1` 形态**。
//   ② **减法借位只传低半段**：`z1 - z0` 的借位要能一路传到高位，只在低 2m limb 里减会吞借位。
//   ③ **不等长操作数**：`(2^n-1)*(2^n+1)` 的 limb 数是 n 与 n+1 ⇒ 一开始被"等长"判据挡在
//      Karatsuba 之外（等于最常用形态没加速）。这里同时覆盖 40 limb（恰好等于阈值）
//      与明显大于阈值的档位。
main() {
    // ① 阈值附近（40 limb = 1280 bit）：低半段全 1 ⇒ 必然产生最高进位
    var m40 = (1 << 1280) - 1
    assert_eq(m40 * m40, (1 << 2560) - (1 << 1281) + 1, "① (2^1280-1)² 展开")

    // ② 奇数 limb（41）—— 走的是「补齐到 42」那条路
    var m41 = (1 << 1300) - 1
    assert_eq(m41 * m41, (1 << 2600) - (1 << 1301) + 1, "② (2^1300-1)² 展开")

    // ③ 不等长操作数（62500 vs 62501 limb）：曾被"等长"判据挡掉
    var a = (1 << 2000000) - 1
    var b = (1 << 2000000) + 1
    assert_eq(a * b, (1 << 4000000) - 1, "③ (2^n-1)(2^n+1) = 2^2n-1")

    // ④ 交换律（不等长两种顺序都要对）
    assert_eq(b * a, a * b, "④ 交换律")

    // ⑤ 大数平方恒等：(x+1)(x-1) = x²-1
    var x = 1 << 100000
    assert_eq((x + 1) * (x - 1), x * x - 1, "⑤ (x+1)(x-1)=x²-1")

    // ⑥ 小数字边界（走教科书式）：int48 边界与 2^64
    assert_eq(2147483647 * 2147483647, 4611686014132420609, "⑥ int32 边界平方")
    var t64 = (1 << 64) - 1
    assert_eq(t64 * t64, (1 << 128) - (1 << 65) + 1, "⑥ (2^64-1)²")

    print("test_bigint_mul_karatsuba passed")
}
