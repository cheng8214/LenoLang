// 跨模块 clib 测试 - 底层模块
import ffi

clib core_lib {
    i32 abs(i32 x)
    i32 add(i32 a, i32 b)
}

clib extra_lib {
    i32 get_value()
}

core_lib g_core = null
extra_lib g_extra = null

export func loadCore(): core_lib {
    if g_core == null {
        g_core = ffi.load(if _os() == "windows" then "msvcrt.dll" else "libc.so.6")
    }
    return g_core
}

export func loadExtra(): extra_lib {
    if g_extra == null {
        // 与 loadCore 同口径：Windows 用 kernel32，POSIX 换 libc.so.6 ⇒ 用例本身跨平台
        //   （`get_value` 从未被调用，这里只要能拿到"第二个 clib 句柄"即可 —— 用例要验的是
        //     跨模块传递**多个** clib 类型，不是某个具体函数 ✓）
        g_extra = ffi.load(if _os() == "windows" then "kernel32.dll" else "libc.so.6")
    }
    return g_extra
}

export func coreAbs(int x): int {
    core_lib c = loadCore()
    return c.abs(x) as int
}
