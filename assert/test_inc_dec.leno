// 自增自减运算符测试

main()
{
    // 测试1: 后置 ++
    var a = 0
    a++
    assert_eq(a, 1)

    // 测试2: 后置 ++ 返回值（先返回旧值）
    var b = 10
    var result = b++
    assert_eq(result, 10)  // 返回旧值
    assert_eq(b, 11)       // b 已增加

    // 测试3: 前置 ++
    var c = 5
    var result2 = ++c
    assert_eq(result2, 6)  // 返回新值
    assert_eq(c, 6)        // c 已增加

    // 测试4: 后置 --
    var d = 10
    var result3 = d--
    assert_eq(result3, 10) // 返回旧值
    assert_eq(d, 9)        // d 已减少

    // 测试5: 前置 --
    var e = 5
    var result4 = --e
    assert_eq(result4, 4)  // 返回新值
    assert_eq(e, 4)        // e 已减少

    // 测试6: 多次自增
    var f = 0
    f++
    f++
    f++
    assert_eq(f, 3)

    // 测试7: 自增自减混合
    var g = 10
    g++
    g--
    assert_eq(g, 10)

    // ==========================================================================
    // 2026-10-15 追加（用户实测报的 bug）：**前缀 `++i` / `--i` 当语句**整句被上一行吃掉 ✗
    //
    // 上面的测试 3 / 5 只测了"前缀当**表达式**"（`var result2 = ++c`）—— 那条路一直是好的 ✓
    // ⇒ 所以这个 bug 一直没被覆盖。最小复现（修前报两条**指不到真因**的错）：
    //     int i = 1
    //     ++i                 // ← 被上一行的 `1` 绑成 `1++`
    //     print(_str(i))      // ← 于是 `i print` 被当成"类型 i 的变量 print"
    // ⇒ 报「未定义的类型: i」+「局部变量 'print' 声明后从未被使用」✗
    // 真因：本语言**语句尾部不吃分号**，而后缀 `++` 优先级最高 ⇒ 跨行的 `++i` 被当成
    //   "上一行表达式的后缀自增"。
    // 修法：**后缀 `++`/`--` 不许跨行**（同 JS 的 restricted production）——
    //   判据是"操作符与**上一个已消费的 token** 同一行"，见 parser_expr.c 的 parse_postfix_inc_dec ✓
    // ==========================================================================

    // 测试8: 前缀当**语句**（原 bug 本体）
    var h = 1
    ++h
    assert_eq(h, 2)
    --h
    assert_eq(h, 1)

    // 测试9: 下标里的后缀（同行；`arr[k++]` 很常用）
    Array[int] arr = [10, 20, 30]
    var k = 0
    arr[k++] = 99
    assert_eq(k, 1)
    assert_eq(arr[0], 99)

    // 测试10: **多行表达式** 之后跟行首前缀（原 bug 的另一种触发形态）
    var m = 2
    var mm = add2(1,
                  2)
    ++m
    assert_eq(m, 3)
    assert_eq(mm, 3)

    // 测试11: **跨行赋值** 之后跟行首前缀
    var n = 5
    var q = 1 +
            2
    ++n
    assert_eq(n, 6)
    assert_eq(q, 3)

    print("test_inc_dec passed")
}

// 测试10 用（放在文件末尾，与文件既有风格一致：Leno 里函数定义与 main 平级 ✓）
func add2(int a, int b): int { return a + b }
