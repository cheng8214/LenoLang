// 数组字面量**元素类型**回归（§8.127 静态通道 + 局部量通道、§8.128 callout 通道）。
//
// 背景（三节文档的总根因）：JIT 的 vstack / 局部量 scratch 用**裸 64 位**表示，而
// `float 0.0`（位型全 0）与 `int 0` 在值域上**不可分** ✗ —— 任何"看位型猜类型"的判据
// 都必然错一半（§8.103/§8.105 的守卫、§8.126 的数据污染都是这个族）。
// ⇒ 类型只能来自**产出者证明**：产出指令白名单、序言按局部量 tag 建的 RBX 位图、
//    以及 callout 返回值在 Value→raw 转换点上顺手记的标志（`setne`）。
//
// 本测试把三条通道各钉一个形态，断言用**字符串形态**：int 0 打印 "0"、float 0.0 打印 "0.0"
// ⇒ 类型一旦分叉必被抓到 ✓（用绝对期望值，因此 JIT 与 LENO_NO_JIT=1 两种模式都必须 PASS）。
//
// 修前实测：局部量形态 `g=[0]`、callout 形态 `g=[0]`（都应为 `[0.0]`）。
// 注意：callout 形态的下标**必须依赖循环变量**（`i % 2`）—— 否则 `t[0]` 是循环不变量，
// 会被 LICM 提升出循环，元素改由局部量产出 ⇒ 反而被局部量通道救回，测试变**假绿** ✗
// （§8.128 记录：我最初 5 个形态就是栽在这里）。

var G_CONST = []
var G_LOCAL = []
var G_CALLOUT = []

main() {
    // 浮点 0.0（SSE 结果 ⇒ 裸 double 位型；用 1.0-1.0 而不是写字面量，避免被常量折叠/优化掉）
    var z = 1.0 - 1.0
    var t = [0.0, 0.0]          // 元素是 float 0.0，供 callout 形态取值
    int i = 0
    while i < 300 {
        var a = [0.0]           // ① 静态通道：float **常量**（OP_CONST 的 float 分支）
        var b = [z]             // ② 局部量通道：z 在循环内**不被写入** ⇒ RBX 位图仍精确
        var c = [t[i % 2]]      // ③ callout 通道：元素是 OP_INDEX 返回值（下标依赖 i ⇒ 不可提升）
        G_CONST = a
        G_LOCAL = b
        G_CALLOUT = c
        i = i + 1
    }

    assert_eq("" + G_CONST[0], "0.0")
    assert_eq("" + G_LOCAL[0], "0.0")
    assert_eq("" + G_CALLOUT[0], "0.0")

    // 反面对照：int 元素必须仍是 int（别把上面三条修成"一律当 float"）
    var d = [0]
    var e = [7]
    assert_eq("" + d[0], "0")
    assert_eq("" + e[0], "7")

    print("test_jit_array_literal_types passed")
}
