// 测试：参数位置 var 不允许，必须用 any
import io

// ============================================================
// 用例1: var 参数应报错
// ============================================================
// func bad1(var x) { }          // 应报错: 参数 'x' 不能使用 var 类型，请改用 any
// func bad2(var x, var y) { }   // 应报错: 两个参数都报错
// func bad3(var x = 10) { }     // 应报错: 有默认值也不允许 var

// ============================================================
// 用例2: any 参数正常工作
// ============================================================
func ok1(any x) {
    if x is int {
        return x * 2
    }
    return 0
}

func ok2(any x, any y) {
    return x
}

func ok3(any x = 10) {
    if x is int {
        return x + 1
    }
    return 0
}

// ============================================================
// 用例3: var 在函数体内（局部变量）仍然正常
// ============================================================
func ok4() {
    var a = 42        // 局部变量推断为 int
    var b = "hello"   // 局部变量推断为 string
    return b
}

// ============================================================
// 用例4: 匿名函数参数用 any
// ============================================================
func ok5(): Array[int] {
    var items = [1, 2, 3]
    var result = items.map(func(any x): int {
        if x is int { return x * x }
        return 0
    })
    return result
}

// ============================================================
// 验证
// ============================================================
main() {
    assert_eq(ok1(21), 42)
    assert_eq(ok2("a", "b"), "a")
    assert_eq(ok3(), 11)
    assert_eq(ok3(20), 21)
    assert_eq(ok4(), "hello")

    var r = ok5()
    assert_eq(r[0], 1)
    assert_eq(r[1], 4)
    assert_eq(r[2], 9)

    io.print("[PASS] 参数 var 报错 + any 正常工作")
}
