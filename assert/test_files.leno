// files 模块测试

import files
import io
import dirs
import ffi
import strings

// ---- File / Ptr 作为**类型**的用例（2026-09-27 从 examples/files 收编）----
// 为什么值得钉：`File`（native 句柄）与 `Ptr`（裸指针）能不能当**函数形参**、能不能当
//   **struct 字段**，是类型系统的一条独有面（native 句柄/指针参与签名与字段解析），
//   `assert/` 里此前**零覆盖**。原示例还都写死了 `D:\` 之类的绝对路径（会脏盘、留垃圾）
//   ⇒ 收编时一律改走 `_tmpdir()`。
func read_file_param(File f): string {
    string content = f.read()
    f.close()
    return content
}

func write_read_ptr(Ptr p): int {
    ffi.write_int(p, 0, 100)
    return ffi.read_int(p, 0)
}

struct FileWrap {
    File handle
    string path = 0
}

struct PtrWrap {
    Ptr memory
    int size = 0
}

main()
{
    // 测试1: 文件写入和读取
    var test_content = "Hello, Leno!\n这是一行中文。"
    var filename = "test_temp_file.txt"

    // 写入文件
    files.write(filename, test_content)

    // 读取文件
    var read_content = files.read(filename)
    assert_eq(read_content, test_content)

    // 测试2: 文件存在检查
    var exists = files.exists(filename)
    assert_eq(exists, true)

    var not_exists = files.exists("non_existent_file.txt")
    assert_eq(not_exists, false)

    // 测试3: 删除文件
    var delete_result = files.delete(filename)
    assert_eq(delete_result, true)

    var exists_after_delete = files.exists(filename)
    assert_eq(exists_after_delete, false)

    // 测试4: 文件对象操作
    files.write(filename, "Line 1\nLine 2\nLine 3")
    var f = files.open(filename, "r")

    // 读取一行
    var line1 = f.readline()
    assert_eq(line1, "Line 1")

    // 读取全部行
    f.seek(0, "set")
    var lines = f.readlines()
    assert_eq(lines.len(), 3)
    assert_eq(lines[0], "Line 1")
    assert_eq(lines[1], "Line 2")
    assert_eq(lines[2], "Line 3")

    // 获取文件大小
    var file_size = f.len()
    assert_eq(file_size > 0, true)

    // ---- 类型契约（v3.2.6，编译期把关）----
    //   `f.readlines()` 返回 `Array[string]`（实现逐行 str_copy）、`f.writeln()` / `f.close()` 返回 `null`。
    //   下面做收窄的地方是**故意留的对照**（readlines 的元素不做收窄就能直接当 string 用）
    //   ⇒ 规格一漂回裸 `Array`，这两行立刻编译失败。
    Array[string] typed_lines = lines
    string first_line = lines[0]
    assert_eq(first_line, "Line 1")
    assert_eq(typed_lines.len(), 3)
    assert_eq(f.writeln("contract"), null)     // 追加一行（返回值是 null，不是字节数 —— 与 f.write() 不同）
    assert_eq(f.close(), null)

    // 模块级 `files.write()` 同样返回 null（只写盘、不产生值）
    assert_eq(files.write(filename, "rewritten-by-contract"), null)
    assert_eq(files.read(filename), "rewritten-by-contract")

    // ---- UTF-8 BOM（2026-10-01）----
    //   口径：`files.read` 是**文本语义**的快捷读取 ⇒ 剥 BOM；二进制模式**原样**给字节。
    //   为什么要钉：BOM 若混进正文，正则 / 字符串比较 / 数字解析都会**静默失配**（不报错、只错值）。
    var bomp = dirs.join(_tmpdir(), "leno_bom_contract.txt")
    var bomW = files.open(bomp, "wb")
    bomW.write(strings.char(0xEF, 0xBB, 0xBF) + "hello")     // 手写 3 字节 BOM（不靠编辑器 ✓）
    bomW.close()
    assert_eq(files.read(bomp), "hello")                     // 文本读取 ⇒ 剥掉 BOM
    assert_eq(files.read(bomp).len(), 5)
    var bomR = files.open(bomp, "rb")
    var bomRaw = bomR.read()
    // ⚠ 断言按**内容**比、不按 `.len()`：Leno 的字符串长度/索引是 **Unicode 字符**
    //   （BOM 三字节算 1 个字符）⇒ 用字节数当期望值会算错 ✗
    assert_eq(bomRaw, strings.char(0xEF, 0xBB, 0xBF) + "hello")   // 二进制 ⇒ BOM 原样带出
    assert_eq(bomRaw.byte(0), 0xEF)                               // 首字节就是 BOM 的 EF
    bomR.close()
    // 反例：没有 BOM 的文件一个字节都不能少（避免"剥"的逻辑误伤）
    files.write(bomp, "hello")
    assert_eq(files.read(bomp), "hello")
    assert_eq(files.read(bomp).len(), 5)
    files.delete(bomp)

    // ---- File / Ptr 作形参与 struct 字段（2026-09-27 从 examples/files 收编）----
    var work = dirs.join(_tmpdir(), "leno_files_param_struct")
    dirs.delete(work)
    dirs.mkdir_p(work)

    // ① File 作**函数形参**（形参里读 + 关）
    var pf = dirs.join(work, "param.txt")
    files.write(pf, "Hello from File parameter!")
    assert_eq(read_file_param(files.open(pf, "r")), "Hello from File parameter!")

    // ② Ptr 作**函数形参**
    Ptr pp = ffi.malloc(16)
    assert_eq(write_read_ptr(pp), 100)
    ffi.free(pp)

    // ③ File 作 **struct 字段**（含字段重新赋值）
    var sf = dirs.join(work, "struct.txt")
    var fw = new FileWrap(handle = files.open(sf, "w"), path = sf)
    fw.handle.write("Hello from struct!")
    fw.handle.close()
    fw.handle = files.open(fw.path, "r")          // 字段重新赋值
    assert_eq(fw.handle.read(), "Hello from struct!")
    fw.handle.close()

    // ④ Ptr 作 **struct 字段**
    var pw = new PtrWrap(memory = ffi.malloc(16), size = 16)
    ffi.write_int(pw.memory, 0, 42)
    ffi.write_int(pw.memory, 4, 99)
    assert_eq(ffi.read_int(pw.memory, 0), 42)
    assert_eq(ffi.read_int(pw.memory, 4), 99)
    ffi.free(pw.memory)

    // 清理
    dirs.delete(work)

    // 清理
    files.delete(filename)

    print("test_files passed")
}
