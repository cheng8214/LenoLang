// 字典方法测试

main()
{
    // 测试字典创建和基本操作
    var d = {name: "leno", version: 1, active: true}
    assert_eq(d["name"], "leno")
    assert_eq(d["version"], 1)
    assert_eq(d["active"], true)

    // 测试点访问
    assert_eq(d.name, "leno")
    assert_eq(d.version, 1)

    // 测试添加新键
    d["author"] = "developer"
    assert_eq(d["author"], "developer")

    // 测试修改值
    d["version"] = 2
    assert_eq(d["version"], 2)

    // 测试长度
    assert_eq(d.len(), 4)

    // 测试嵌套字典
    var nested = {
        user: {
            name: "张三",
            age: 25
        },
        settings: {
            theme: "dark",
            lang: "zh"
        }
    }
    // 嵌套字典访问需要类型收窄：dict 值类型为 any，需先用 is Dict 收窄
    var user = nested["user"]
    if user is Dict {
        assert_eq(user["name"], "张三")
    }
    var settings = nested["settings"]
    if settings is Dict {
        assert_eq(settings["theme"], "dark")
    }
    // 点访问语法同样需要收窄
    var user2 = nested.user
    if user2 is Dict {
        assert_eq(user2["name"], "张三")
    }

    // 测试：keys/values 的**元素类型跟接收者走**（2026-09-27 起）
    //   `d.keys()` → `Array[K]`、`d.values()` → `Array[V]`（`NTYPE_ARG0_KEY` / `NTYPE_ARG0_VALUE`）。
    //   此前注册成 `TYPE_ARRAY + TYPE_UNKNOWN` ⇒ 拿到裸 `Array`、元素是 any ⇒ 每次都要手动收窄 ✗
    //   ⚠ 下面每行都是**不做收窄**的强类型赋值 ⇒ 规格一漂这里就编译失败。
    Dict[string, int] kv = {"a": 1, "b": 2, "c": 3}
    Array[string] ks = kv.keys()
    Array[int]    vs = kv.values()
    assert_eq(ks.len(), 3)
    assert_eq(vs.len(), 3)
    assert_eq(ks.has("a"), true)              // 元素类型是 string ⇒ 能直接进 Array[string] 的方法
    int vs_sum = vs[0] + vs[1] + vs[2]        // 元素类型是 int ⇒ 能直接做运算（any 过不了）
    assert_eq(vs_sum, 6)

    //   ⚠ `get` **故意不标**：它的类型由**默认值实参**推出来（`get("x", 0)` → int、
    //     `get("y", 0.0)` → float，见 assert/test_dict_get_infer.leno），是另一条更精确的规则；
    //     标成 `Array` 的值类型会把它盖掉（实测会让 4 个用例退化成 any）。
    Dict[string, int] gi = {"n": 42}
    int gi_default = gi.get("n", 0)
    assert_eq(gi_default, 42)

    // ---- 类型契约（v3.2.6）----
    //   `set()` / `remove()` / `clear()` 返回 `null`（实现都是 `return val_null()`：只改字典、不产生值）。
    //   ⚠ 它们**不能**标成"值类型 V" —— 那会骗人（`val_obj(d.set(k,v))` 这种写法本来就不成立）；
    //     原来标 any 则等于放弃了这条信息（LSP 悬停与 `var x = d.set(...)` 的推断都会显示 any）。
    Dict[string, int] cd = {"k": 1}
    assert_eq(cd.set("k2", 2), null)
    assert_eq(cd.remove("k2"), null)
    assert_eq(cd.clear(), null)
    assert_eq(cd.len(), 0)

    // ---- setdefault / items（2026-10-01 新增）----
    //   setdefault：键在 ⇒ 返回现值（**不覆盖**）；键不在 ⇒ 写入 default 并返回它 ✓
    Dict[string, int] sd = {"a": 1}
    assert_eq(sd.setdefault("a", 99), 1)        // 已存在 ⇒ 不覆盖 ✓
    assert_eq(sd.get("a", 0), 1)
    assert_eq(sd.setdefault("b", 7), 7)         // 不存在 ⇒ 写入并返回 ✓
    assert_eq(sd.get("b", 0), 7)
    assert_eq(sd.len(), 2)

    //   items()：`Array[DictEntry{key, value}]` —— **按插入序**、字段编译期已知 ✓
    var it_src = {"x": 1, "y": 2, "z": 3}
    var its = it_src.items()
    assert_eq(its.len(), 3)
    assert_eq(_str(its[0].key), "x")            // 插入序 ✓
    assert_eq(_int(its[0].value), 1)
    assert_eq(_str(its[2].key), "z")
    assert_eq(_int(its[2].value), 3)

    // 遍历写法：比 `keys()` + `get()` 两步更直白 ✓
    int sum_v = 0
    for its to it {
        sum_v += _int(it.value)
    }
    assert_eq(sum_v, 6)

    // 空字典 ⇒ 空数组（不是 null ✓）
    var empty_d = {}
    assert_eq(empty_d.items().len(), 0)

    // setdefault 的典型用法：计数（省掉"先 has 再 set" ✓）
    var cnt2 = {}
    var ks2 = ["p", "q", "p"]
    for ks2 to k {
        cnt2.setdefault(k, 0)
        cnt2.set(k, _int(cnt2.get(k)) + 1)
    }
    assert_eq(_int(cnt2.get("p")), 2)
    assert_eq(_int(cnt2.get("q")), 1)

    print("test_dict_methods passed")
}
