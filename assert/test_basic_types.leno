// 基本类型测试
assert_eq(1 + 1, 2)
assert_eq(10 - 3, 7)
assert_eq(3 * 4, 12)
assert_eq(15 / 5, 3)
assert_eq(10 % 3, 1)
assert_eq(-5 + 5, 0)

assert_true(true)
assert_false(false)
assert_null(null)

assert_eq(true and true, true)
assert_eq(true and false, false)
assert_eq(false or true, true)
assert_eq(false or false, false)
assert_eq(not true, false)
assert_eq(not false, true)

assert_eq(3 > 2, true)
assert_eq(2 > 3, false)
assert_eq(3 < 2, false)
assert_eq(2 < 3, true)
assert_eq(3 >= 3, true)
assert_eq(3 <= 3, true)
assert_eq(3 == 3, true)
assert_eq(3 != 4, true)

print("test_basic_types passed")
