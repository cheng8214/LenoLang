// LenoSys 跨平台系统模块回归（build\leno_module\LenoSys）
//
// ★ 用例只写**任何平台都成立**的断言：
//     「有/无」「>0」「不抛」「结构正确」—— 不做"进程正好 174 个"这类机器相关断言 ✗
// ★ 不碰用户环境：**不真删文件、不清空回收站**（真删动作已由人工探针验过 ✓）
//     —— 换平台（尤其 Linux）时请跑 `Sys.selfTest()` 看真机明细 ✓
import Sys
import dirs
import jsons
import strings
import times

main() {
    print("=== LenoSys 跨平台系统模块回归 ===")

    // ---------- 平台 ----------
    assert_true(Sys.os() != "", "os() 不该为空")
    assert_true(Sys.isWindows() or Sys.isLinux() or Sys.isMacos(), "总得认出一个平台")

    // ---------- 目录 / 路径 ----------
    assert_true(Sys.homeDir() != "", "homeDir 不该为空")
    assert_true(Sys.tempDir() != "", "tempDir 不该为空")
    assert_true(Sys.systemRoot() != "", "systemRoot 不该为空")
    assert_true(Sys.pathSep() == "/" or Sys.pathSep() == "\\", "分隔符只可能是 / 或 \\")
    assert_eq(Sys.joinPath(["a", "b"]), "a" + Sys.pathSep() + "b", "joinPath 应使用本平台分隔符")
    assert_eq(Sys.joinPath(["a", "", "b"]), "a" + Sys.pathSep() + "b", "空段应被跳过")

    // ---------- 环境变量 ----------
    // ★ 取不到的环境变量必须**原样保留**（静默变空串最危险：路径会变得"看似可用" ✗）
    assert_eq(Sys.expandEnv("%LENOSYS_NO_SUCH_VAR%"), "%LENOSYS_NO_SUCH_VAR%", "未知 %VAR% 应原样保留")
    assert_eq(Sys.expandEnv("$LENOSYS_NO_SUCH_VAR"), "$LENOSYS_NO_SUCH_VAR", "未知 $VAR 应原样保留")
    assert_eq(Sys.env("LENOSYS_NO_SUCH_VAR", "def"), "def", "默认值应生效")
    print("平台/路径/环境 通过!")

    // ---------- 进程 ----------
    int pid = Sys.currentPid()
    assert_true(pid > 0, "currentPid 应 > 0")
    assert_true(Sys.processExists(pid), "自己这个进程必须'存在'")
    assert_true(Sys.processMemoryKb(pid) >= 0, "自己的常驻内存应可读（>=0）")

    var ps = Sys.listProcesses()
    assert_true(ps.len() > 0, "进程列表不该为空")
    for ps to p { assert_true(p.pid > 0, "每个进程都应有 pid") }

    string exe = Sys.exePath()
    assert_true(exe != "", "exePath 不该为空")

    // 用**自己的 exe 名**去找自己（比找 explorer/sshd 这类机器相关名字稳 ✓）
    string self = dirs.basename(exe)
    if self != "" {
        string base = self
        int dot = strings.find(self, ".")
        if dot > 0 { base = strings.slice(self, 0, dot - 1) }
        assert_true(Sys.findProcess(base).len() > 0, "应能找到自己（" + base + "）")
    }
    assert_true(not Sys.processExists(-1), "非法 pid 必须返回 false")
    assert_true(not Sys.killProcess(0), "kill(0) 必须安全返回 false")
    print("进程 通过!")

    // ---------- 磁盘 ----------
    var d = Sys.diskSpace(Sys.systemRoot())
    assert_true(jsons.get_bool(d, "ok", false), "系统盘空间应可读")
    assert_true(jsons.get_int(d, "total", 0) > 0, "总容量应 > 0")
    assert_true(jsons.get_int(d, "free", 0) >= 0, "可用空间不该为负")
    assert_true(Sys.listDrives().len() > 0, "至少要有一个盘符/挂载点")
    int pct = Sys.diskUsagePercent(Sys.systemRoot())
    assert_true(pct >= 0 and pct <= 100, "使用率应在 0..100（实测 " + _str(pct) + "）")
    print("磁盘 通过!")

    // ---------- 卷 / 分区（volumeOf）----------
    // ★ 跨平台不变量（任何平台都成立 ⇒ 可以无脑断 ✓）：
    //   · 系统盘/家目录必然能判出卷
    //   · **幂等**：卷根归属它自己（`volumeOf(volumeOf(x)) == volumeOf(x)` ✓）
    //   · 空路径 ⇒ ""（判不出；绝不能兜底成某个盘 ✗）
    string volSys = Sys.volumeOf(Sys.systemRoot())
    assert_true(volSys != "", "volumeOf(systemRoot) 不该为空")
    string volHome = Sys.volumeOf(Sys.homeDir())
    if Sys.homeDir() != "" {
        assert_true(volHome != "", "volumeOf(homeDir) 不该为空")
    }
    assert_eq(Sys.volumeOf(volSys), volSys, "volumeOf 必须幂等（卷根归属它自己）")
    assert_eq(Sys.volumeOf(""), "", "空路径 ⇒ 空（判不出，且不抛 ✓）")
    //   卷根必须是"路径的前缀"（拿一个卷下的真实文件回来验 ✓）
    string exe2 = Sys.exePath()
    if exe2 != "" {
        string volExe = Sys.volumeOf(exe2)
        assert_true(strings.starts_with(exe2, volExe), "exe 路径必须落在 volumeOf(exe) 之下："
                    + volExe + " vs " + exe2)
    }
    print("卷 / 分区 通过!")

    // ---------- 回收站（**非破坏性**断言 ✓）----------
    var del0 = Sys.deleteToTrash([])
    assert_true(jsons.get_bool(del0, "ok", false), "空列表必须安全返回 ok=true")
    assert_eq(jsons.get_int(del0, "count", -1), 0, "空列表 count 应为 0")

    // 列出回收站：**只读**（本用例不删任何东西 ✓）
    //   ⚠ 0 条也可能是"回收站真的空" ⇒ 这里只验结构，不验数量 ✓（两端都已实现 ★ 2026-10-15）
    var tl = Sys.listTrash()
    for tl to it {
        assert_true(it.name != "", "回收站条目必须有名字")
        assert_true(it.trashDir != "", "回收站条目必须报出它属于哪个回收站根")
        if it.originalPath != "" {
            // 账本里写了原始路径 ⇒ 必须是**绝对路径**（解码后不该还留着 %XX 之类 ✓）
            assert_true(strings.starts_with(it.originalPath, "/") or Sys.isWindows(),
                        "原始路径应是绝对路径（实际 " + it.originalPath + "）")
            assert_true(strings.find(it.originalPath, "%") < 0, "原始路径必须已解码（不该留 %XX）")
        }
    }
    print("回收站 通过（当前 " + _str(tl.len()) + " 条）!")

    // ---------- 进程路径（processPath）----------
    //   ★ 2026-10-15：Windows 侧已实现 ⇒ 两端都把"非空"写成硬断言 ✓
    int me2 = Sys.currentPid()
    string pp = Sys.processPath(me2)
    assert_true(pp != "", "自己进程的 exe 路径应可读（实际 '" + pp + "'）")
    if Sys.isWindows() {
        assert_true(strings.find(pp, ":\\") > 0, "Windows 的 exe 路径应是盘符绝对路径（实际 '" + pp + "'）")
        //   交叉校验：processPath(self) 与 exePath() 说的应是**同一个文件**（大小写可能不同 ✓）
        string exeSelf = Sys.exePath()
        if exeSelf != "" {
            assert_eq(strings.to_lower(pp), strings.to_lower(exeSelf),
                      "processPath(self) 应与 exePath() 一致")
        }
    } else {
        assert_true(strings.starts_with(pp, "/"), "应是绝对路径")
    }
    assert_eq(Sys.processPath(0), "", "pid 0 ⇒ 空（不抛 ✓）")
    assert_eq(Sys.processPath(-1), "", "非法 pid ⇒ 空（不抛 ✓）")
    assert_eq(Sys.processPath(999999999), "", "不存在的 pid ⇒ 空（不抛 ✓）")
    print("进程路径 通过!")

    // ---------- 系统信息（sysInfo / isElevated）----------
    // ★ 跨平台不变量（两端都成立 ⇒ 可无脑断 ✓）：
    //   · 不抛异常
    //   · `memAvailKb <= memTotalKb`（可用不该超过总量 ✓ —— 这条任何平台都成立 ✓）
    //   · 各计数/字节字段**不为负**（未知用 0 ✓）
    //   · `sysInfo().elevated` 与 `isElevated()` **必须一致**（前者内部就是调后者 ⇒ 单一实现 ✓）
    //   ★ 2026-10-15：Windows 侧由"未实现桩"改为真读 ⇒ **两端**都可以把"非空/大于 0"硬断 ✓
    var si = Sys.sysInfo()
    assert_true(si.cpuCount >= 0, "cpuCount 不该为负")
    assert_true(si.memTotalKb >= 0 and si.memAvailKb >= 0, "内存字段不该为负")
    assert_true(si.uptimeSec >= 0, "uptime 不该为负")
    if si.memTotalKb > 0 {
        assert_true(si.memAvailKb <= si.memTotalKb, "可用内存不该超过总量："
                    + _str(si.memAvailKb) + " > " + _str(si.memTotalKb))
    }
    assert_eq(si.elevated, Sys.isElevated(), "sysInfo.elevated 必须与 isElevated() 一致（单一实现 ✓）")
    // ★ 2026-10-15：Windows 侧已实现（注册表 + 直连 API）⇒ 这些字段两端都应为真 ✓
    //   ⚠ 大小写归一后再比：Windows 的主机名/用户名是**大写**的，而环境变量兜底那一路未必 ✓
    assert_true(si.host != "", "host 应可读（Win: GetComputerNameW / Linux: /proc/sys/kernel/hostname）")
    assert_true(si.user != "", "user 应可读（Win: GetUserNameW / Linux: id -un）")
    assert_true(si.cpuCount > 0, "cpuCount 应 > 0（Win: GetActiveProcessorCount / Linux: /proc/cpuinfo）")
    assert_true(si.memTotalKb > 0, "memTotalKb 应 > 0（Win: GlobalMemoryStatusEx / Linux: /proc/meminfo）")
    assert_true(si.uptimeSec > 0, "uptimeSec 应 > 0（Win: GetTickCount64 / Linux: /proc/uptime）")
    if Sys.isWindows() {
        //   交叉校验①：主机的名字必须与"系统自己说的 COMPUTERNAME"一致（大写口径 ✓）
        string envHost = strings.to_upper(Sys.env("COMPUTERNAME", ""))
        if envHost != "" {
            assert_eq(strings.to_upper(si.host), envHost, "计算机名应与 COMPUTERNAME 一致")
        }
        //   交叉校验②：核数必须与 NUMBER_OF_PROCESSORS 一致（两者都来自系统 ✓）
        string envCpus = strings.trim(Sys.env("NUMBER_OF_PROCESSORS", ""))
        if envCpus != "" {
            assert_eq(_str(si.cpuCount), envCpus, "cpuCount 应与 NUMBER_OF_PROCESSORS 一致")
        }
        //   交叉校验③：osName/kernel 来自注册表 ≠ 桩（原先全空）⇒ 至少该有版本号 ✓
        assert_true(si.osName != "", "osName 应可读（注册表 CurrentVersion）")
        assert_true(si.kernel != "", "kernel 应可读（主.次.内部版本号.UBR）")
        assert_true(si.cpuModel != "", "cpuModel 应可读（注册表 CentralProcessor\\0）")
    }
    if not Sys.isWindows() {
        assert_true(si.osName != "", "osName 应可读（/etc/os-release）")
        assert_true(si.kernel != "", "kernel 应可读（/proc/sys/kernel/osrelease）")
        //   ★ 交叉校验 isElevated：Linux 的判据就是 `uid == 0` ⇒ 与 `id -u` 的读数必须一致 ✓
        //     （这条把"实现"与"外部事实"对上 —— 不是自己跟自己对 ✓）
        //     ⚠ `Sys.exec` 返回的键是 **out**（不是 output ✓）
        var idr = Sys.exec("id -u")
        string uidTxt = ""
        if jsons.get_bool(idr, "ok", false) {
            uidTxt = strings.trim(jsons.get_str(idr, "out", ""))
        }
        if uidTxt != "" {
            assert_eq(Sys.isElevated(), uidTxt == "0", "isElevated 必须等价于 `id -u == 0`")
        }
    }
    print("系统信息 通过（osName='" + si.osName + "' cpu×" + _str(si.cpuCount) + "）!")

    // ---------- 桌面集成（openWith / revealInFolder / notify）----------
    // ★ 本用例的规矩是"**不碰用户环境**"（见文件头）⇒ 这里**只喂空/非法入参**：
    //   它们按契约必须返回 false 且**不产生任何副作用**（不会开窗口、不会弹通知 ✓）。
    //   ⚠ 真开窗口/真发通知的路径**不在这里验**（那会打扰跑测试的人 ✗）⇒ 交给探针/
    //     人工 ✓ —— 这也是本模块一贯的做法（真删/真清空同样只由人工探针验 ✓）
    assert_eq(Sys.openWith(""), false, "空路径 ⇒ false（不抛、不开任何东西 ✓）")
    assert_eq(Sys.openWith("   "), false, "纯空白 ⇒ false ✓")
    assert_eq(Sys.revealInFolder(""), false, "空路径 ⇒ false ✓")
    assert_eq(Sys.notify(""), false, "空标题 ⇒ false（标题必填 ✓）")
    assert_eq(Sys.notify("   ", "正文"), false, "纯空白标题 ⇒ false ✓")
    // ★ 2026-10-15：不存在的路径**两端**都必须挡住 —— 这条现在可以跨平台硬断了 ✓
    //   （Windows 的 ShellExecuteW 对不存在的路径会给错误码 ≤32，我们**先**用 dirs.exists 挡一道，
    //     不依赖"Shell 会不会报错"这种不确定行为 ✓）
    string ghost = Sys.systemRoot() + "definitely_not_here_xyz_9f3a.txt"
    assert_eq(Sys.openWith(ghost), false, "不存在的路径 ⇒ false ✓")
    assert_eq(Sys.revealInFolder(ghost), false, "不存在的路径 ⇒ false ✓")
    if not Sys.isWindows() {
        //   ⚠ 不测"工具在不在"：裸 Linux 容器里可能真没有 xdg-open/notify-send
        //     ⇒ 那属于环境差异，写成硬断言会变成机器相关用例 ✗
    }
    print("桌面集成 通过（只验空/非法入参 ⇒ 无副作用 ✓）!")

    // ---------- 命令执行的**超时参数**（★ 2026-10-16 新增）----------
    // ★ 这一段的关键是**判别性**：老实现把超时**写死 30s** ⇒ 参数会被忽略 ⇒ 下面第一条就会
    //   "跑满 2s 后返回 code=0"（而不是 124）⇒ 用例**必红** ✓（不是"看着像验过" ✓）
    //   ⚠ 只有"给出更小限额"这一侧能在用例里廉价判别；"0 = 不超时 / 负值退回 30s"
    //     都需要跑 31s+ 才能判别 ⇒ 放探针（本文件规矩：慢的/碰环境的交给探针 ✓）
    // ⚠ 只验 POSIX：`sleep` 是 sh 的东西，Windows 的 cmd 没有等价物 ⇒ 硬断会变成机器相关用例 ✗
    //   （`_exec` 自身的超时语义已由 assert/test_exec_timeout.leno 覆盖 ✓，这里验的是**门面参数** ✓）
    if not Sys.isWindows() {
        var t0 = times.ms()
        var to1 = Sys.exec("sleep 2", 300)                    // 300ms 限额 ⇒ 必超时
        var el1 = times.ms() - t0
        assert_eq(jsons.get_int(to1, "code", -1), 124, "超时的退出码应为 124（GNU 惯例）")
        assert_true(el1 < 1500,
            "应在 ~300ms 内返回（证明子进程真被杀，没等它跑完）；实际 " + _str(el1) + "ms")
        var to2 = Sys.exec("sleep 2", 8000)                   // 限额足够 ⇒ 正常跑完
        assert_eq(jsons.get_int(to2, "code", -1), 0, "限额足够时应正常结束（code=0）")
        // ⚠ 负值**绝不能**退化成"不超时"（内置 `_exec` 对非正数一律不套超时 ⇒ 透传就等于摘掉守卫 ✗）
        //   这里只验"照样正常返回" ✓；"负值确实按缺省 30s 算"由探针用 31s 睡眠判别 ✓
        var to3 = Sys.exec("sleep 1", -5)
        assert_eq(jsons.get_int(to3, "code", -1), 0, "负值应退回缺省（本条 1s 内跑得完 ✓）")
        print("命令超时参数 通过!")
    } else {
        print("命令超时参数 跳过（本段用 POSIX sh 的 sleep 语义 ✓）")
    }

    // ---------- 启动项 / 已装软件 / 最近文件：只验"可调用 + 结构对" ----------
    var su = Sys.listStartupItems()
    for su to it { assert_true(it.id != "" or it.name != "", "启动项应有 id 或 name") }

    var sw = Sys.listInstalledSoftware()
    for sw to it { assert_true(it.name != "", "已装软件必须有名字（空名已被门面过滤 ✓）") }

    var rec = Sys.recentFiles(3)
    assert_true(rec.len() <= 3, "max 参数应生效")
    print("系统项 通过（启动项 " + _str(su.len()) + " / 软件 " + _str(sw.len()) + " / 最近 " + _str(rec.len()) + "）")

    // ---------- 开机自启动三件套（★ 用**临时 id** 且跑完删掉 ⇒ 不污染真实自启 ✓）----------
    if not Sys.isMacos() {
        string tid = "LenoSysSelfTest_" + _str(times.ms())
        assert_eq(Sys.getAutostart(tid), "", "临时 id 一开始不该有自启项")
        assert_true(Sys.setAutostart(tid, "LenoSys 自检", "echo lenosys"), "写自启项应成功")
        assert_eq(Sys.getAutostart(tid), "echo lenosys", "读回来必须与写入**逐字一致**")
        assert_true(Sys.removeAutostart(tid), "删自启项应成功")
        assert_eq(Sys.getAutostart(tid), "", "删完必须读不到（不留痕 ✓）")
        // 幂等：再删一次也应成功（"不再自启"这个目标本来就达成 ✓）
        assert_true(Sys.removeAutostart(tid), "对不存在项再删一次应返回 true（幂等 ✓）")
        assert_eq(Sys.setAutostart("", "空 id", "echo x"), false, "空 id 必须拒绝")
        assert_eq(Sys.setAutostart(tid, "空命令", ""), false, "空命令行必须拒绝")
    }
    print("开机自启动 通过!")

    // ---------- 自检 ----------
    var st = Sys.selfTest()
    assert_true(jsons.get_bool(st, "ok", false), "selfTest 应全绿（失败项见输出）")

    print("=== LenoSys 回归：全部通过 ===")
}
