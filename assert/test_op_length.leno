// OP_LENGTH（`.len()`）回归 —— §8.52
//
// 覆盖 5 种形态：string（按字符数，不是字节数）、Array、Dict、字符串常量，
// 以及数字形态（只有 `for n to i`（n 是变量）会产生 OP_LENGTH，所以这里用嵌套 for
// 把它放进循环体里）。
//
// 作用：把循环跑到 3000 轮，一旦 `.len()` 算错长度（例如把字符数当成字节数、
// 数字 clamp 方向反了），结果就会与断言不符。
// 断言是绝对期望值 ⇒ 任何执行配置下都必须通过。
main() {
    string s = "中文abc"          // char_len = 5（字符数；字节数是 8）
    Array[int] arr = [1, 2, 3, 4]
    Dict[string, int] d = {"a": 1, "b": 2}
    int bound = 3

    int cs = 0, ca = 0, cd = 0, ck = 0, cn = 0
    for 3000 to i {
        cs = s.len()
        ca = arr.len()
        cd = d.len()
        ck = "abcd".len()
        int inner = 0
        for bound to j { inner = inner + 1 }   // 数字形态 OP_LENGTH
        cn = inner
    }

    assert_eq(cs, 5)
    assert_eq(ca, 4)
    assert_eq(cd, 2)
    assert_eq(ck, 4)
    assert_eq(cn, 3)

    print("test_op_length: OK")
}
