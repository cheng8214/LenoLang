// test_threads_module_entry.leno —— TH2：**模块函数作线程入口**（回归）
//
// 背景（见 docs/线程并发能力修复追踪.md 的 TH2 与 docs/语言摩擦与隐式契约清单.md 的 M1）：
//   原先 `threads.start` 硬拦"入口必须是入口脚本（顶层文件）里的具名全局函数" ✗
//   —— 判据是 `closure->function->module != NULL`。根因只有一处：协程首帧漏设
//   `frame->module`（`src/vm/vm.c` 的 `vm_run_coroutine_with_vm`），而模块字节码全走
//   `frame->module` 寻址 ⇒ 模块函数体里第一条模块符号指令就报「不在模块上下文中」。
//   后果是**库自己没法封装并发**（LenoWeb 想自开线程池、LenoMusic 想自管后台线程都做不到），
//   只能把函数从宿主"当值传进模块"绕过去。
//
// 判据：
//   ① 入口脚本直接 `threads.start(模块函数, …)` ⇒ 能跑、能 join 出正确值
//   ② 模块函数带多参数、内部循环 ⇒ 正常
//   ③ 模块函数里再调同模块的另一个函数 ⇒ 正常（第二条模块符号寻址路径）
//   ④ **模块自己开线程跑自己的函数**（TH2 的真正目标）⇒ 正常
//   ⑤ 模块级可变状态**跨线程共享**（已知口径，不是 bug —— 隔离不在本期范围，见 TH5）

import threads
import "helpers/th2_mod.leno" as m

main() {
    // ---------- ① 入口脚本直接拿模块函数当入口 ----------
    var t = threads.start(m.add_base, 5)
    assert_eq(t.join(), 105, "①模块函数应能直接作线程入口（5 + 100）")

    // ---------- ② 多参数 + 循环 ----------
    var t2 = threads.start(m.sum_range, 0, 3)
    assert_eq(t2.join(), 6, "②模块函数带两个参数、内部闭区间循环（0+1+2+3）")

    // ---------- ③ 模块函数里再调同模块的另一个函数 ----------
    var t3 = threads.start(m.indirect, 5)
    assert_eq(t3.join(), 210, "③模块函数内再调模块函数（(5+100)×2）")

    // ---------- ④ 模块**自己**开线程跑自己的函数（TH2 的真正价值） ----------
    //   parallel_sum(0, 1, 3) = _sum_worker(0,1) + _sum_worker(2,3) = 1 + 5 = 6
    assert_eq(m.parallel_sum(0, 1, 3), 6, "④模块内部自己 threads.start 自己的函数")

    // ---------- ⑤ 模块 globals 是**共享**的（已知口径） ----------
    //   ① 的 add_base 与 ③ 的 indirect→add_base 各 +1 ⇒ 2。
    //   ⚠ 这条断言是**有意**的：它把"模块级可变状态跨线程共享"钉成显式契约
    //     （与 `_ParseCtx` 那种"把状态收进实例"的写法互为对照，见
    //     docs/多线程struct与模块全局变量问题记录.md §四）。若哪天做了线程隔离，这条会红 —— 那时再改它。
    assert_eq(m.calls(), 2, "⑤模块级可变状态被子线程改到 ⇒ 共享（已知口径，TH5 待办）")

    print("test_threads_module_entry passed")
}
