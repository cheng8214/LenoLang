// test_deep_nesting.leno — 验证 Leno VM 深递归的健壮性（栈深度能力）
// 结论：Leno VM 能处理 50000+ 层递归，远超 CPython 默认的 1000 层上限

main() {
    // 测试1: 深层递归求和（构造 50000 层递归）
    int r1 = _sum(50000)
    assert_eq(r1, 50000)
    print("test_deep_nesting: OK")
}

// 纯尾递归：返回 1 + 递归，用于测栈深度（不优化为循环，验证真实栈）
func _sum(int n): int {
    if n <= 1 {
        return 1
    }
    return 1 + _sum(n - 1)
}
