// 正则表达式模块测试
import regexs

main() {
    print("=== 测试 regexs 模块 ===")

    // ========== 测试 match ==========
    print("\n--- 测试 match ---")

    // 基本匹配
    assert_eq(regexs.match("hello", "[a-z]+"), true)
    assert_eq(regexs.match("hello123", "[a-z]+[0-9]+"), true)
    assert_eq(regexs.match("hello", "^hello$"), true)

    // 不匹配的情况
    assert_eq(regexs.match("Hello", "^[a-z]+$"), false)
    assert_eq(regexs.match("123", "^[a-z]+$"), false)

    // 使用点号匹配
    assert_eq(regexs.match("abc", "a.c"), true)

    print("match 测试通过!")

    // ========== 测试 find ==========
    print("\n--- 测试 find ---")

    // 基本查找（0-indexed，未找到返回 -1）
    assert_eq(regexs.find("Hello, World!", "World"), 7)
    assert_eq(regexs.find("abc123def", "[0-9]+"), 3)

    // 未找到
    assert_eq(regexs.find("Hello", "xyz"), -1)

    // 查找开头
    assert_eq(regexs.find("Hello", "^Hello"), 0)

    // ★ 2026-10-10（A 组第 5 条）：**偏移按字符**（与切片 / .len() / strings.find 同口径 ✓）
    //   ⚠ 例子必须选"两种口径结果不同"的 ✗ —— 旧文档曾用 `"abc中文def"` 找 `"中文"`⇒3，
    //     可前三个字符是 ASCII ⇒ 字节数 == 字符数 ✗ 根本区分不出来（那次结论因此错了 ✗）。
    //     `"中文字abc"`：字符下标 3 ✓ / 字节偏移 9 ✗ ⇒ 能区分 ✓
    assert_eq(regexs.find("中文字abc", "abc"), 3)
    assert_eq("中文".len(), 2)          // 字符口径（对照：byte_len 才是 6 ✓）

    print("find 测试通过!")

    // ========== 测试 find_all ==========
    print("\n--- 测试 find_all ---")

    var matches = regexs.find_all("abc123def456", "[0-9]+")
    assert_eq(matches.len(), 2)
    // 类型契约（v3.2.7，编译期把关）：返回 `Array[RegexMatch]`，字段类型编译期已知
    //   ⇒ 下面三个强类型局部变量**不做任何收窄**（spec 一漂回裸 Dict 就编译失败）。
    //   理由同 test_dirs：native 规格**只在编译期生效**，运行期不校验字段类型。
    string m0_text  = matches[0].text
    int    m0_start = matches[0].start
    int    m0_end   = matches[0].end
    assert_eq(m0_text, "123")
    assert_eq(m0_start, 3)
    assert_eq(m0_end, 6)
    assert_eq(matches[1].text, "456")
    assert(not (matches[0] is Dict))     // 守住"不再是 Dict"（旧的 m["x"] 收窄路径已作废）

    // 无匹配
    var no_matches = regexs.find_all("hello", "[0-9]+")
    assert_eq(no_matches.len(), 0)

    // ★ 含中文：start/end 同样是**字符**下标 ✓（2026-10-10 改 ✓），且能直接拿去切片 ✓
    //   实测口径：`"a中b中"` 找 `"中"` ⇒ start=1 / start=3 ✓（按字节会是 1 / 5 ✗）
    var zh = "a中b中"
    var zm = regexs.find_all(zh, "中")
    assert_eq(zm.len(), 2)
    assert_eq(zm[0].start, 1)
    assert_eq(zm[1].start, 3)
    assert_eq(zm[0].text, "中")
    //   切片是**闭区间**而 end **不含** ⇒ 要 -1 ✓（这才是拿偏移切片的正确写法 ✓）
    assert_eq(zh[zm[0].start : zm[0].end - 1], "中")

    print("find_all 测试通过!")

    // ========== 测试 extract ==========
    print("\n--- 测试 extract ---")

    assert_eq(regexs.extract("Email: user@example.com", "[a-z]+@[a-z.]+"), "user@example.com")
    assert_eq(regexs.extract("abc123def", "[0-9]+"), "123")
    assert_eq(regexs.extract("hello", "[0-9]+"), null)

    print("extract 测试通过!")

    // ========== 测试 extract_all ==========
    print("\n--- 测试 extract_all ---")

    var all_nums = regexs.extract_all("abc123def456ghi789", "[0-9]+")
    assert_eq(all_nums.len(), 3)
    assert_eq(all_nums[0], "123")
    assert_eq(all_nums[1], "456")
    assert_eq(all_nums[2], "789")

    // 无匹配
    var empty = regexs.extract_all("hello", "[0-9]+")
    assert_eq(empty.len(), 0)

    print("extract_all 测试通过!")

    // ========== 测试 replace ==========
    print("\n--- 测试 replace ---")

    assert_eq(regexs.replace("hello world", "world", "Leno"), "hello Leno")
    assert_eq(regexs.replace("abc123def", "[0-9]+", "XXX"), "abcXXXdef")

    // 未找到时返回原字符串
    assert_eq(regexs.replace("hello", "xyz", "abc"), "hello")

    print("replace 测试通过!")

    // ========== 测试 replace_all ==========
    print("\n--- 测试 replace_all ---")

    assert_eq(regexs.replace_all("a1b2c3", "[0-9]", "X"), "aXbXcX")
    assert_eq(regexs.replace_all("hello world hello", "hello", "hi"), "hi world hi")

    print("replace_all 测试通过!")

    // ========== 测试 split ==========
    print("\n--- 测试 split ---")

    // 基本分割
    var parts1 = regexs.split("a,b,c", ",")
    assert_eq(parts1.len(), 3)
    assert_eq(parts1[0], "a")
    assert_eq(parts1[1], "b")
    assert_eq(parts1[2], "c")

    print("split 测试通过!")

    // ========== 测试 escape ==========
    print("\n--- 测试 escape ---")

    assert_eq(regexs.escape("hello.world"), "hello\\.world")
    assert_eq(regexs.escape("a+b*c?"), "a\\+b\\*c\\?")
    assert_eq(regexs.escape("[test]"), "\\[test\\]")

    // 验证转义后的字符串可以正确匹配
    var escaped = regexs.escape("hello.world")
    assert_eq(regexs.match("hello.world", escaped), true)
    assert_eq(regexs.match("helloXworld", escaped), false)

    print("escape 测试通过!")

    // ========== 综合测试 ==========
    print("\n--- 综合测试 ---")

    // 统计单词
    func count_words(string text):int {
        var words = regexs.extract_all(text, "[a-zA-Z]+")
        return words.len()
    }

    assert_eq(count_words("Hello, World! This is Leno."), 5)

    print("综合测试通过!")

    // ========== 转义简写 `\d` `\w` `\s`（2026-10-01 起**支持**）==========
    //   演进史留一笔：① 最早 `\d` 被当**字面字母 d**（`match("123","\d+")` 静默 false ✗）
    //   ② 上一版改为**报错**挡住（不再静默 ✗→✓）③ 现在真正展开成等价字符类 ✓
    //   ⇒ 这组断言从"必须报错"改成了"能力验证" ✓
    assert_eq(regexs.match("123", "\\d+"), true)
    assert_eq(regexs.match("d", "\\d"), false)          // `\d` 不再等于字面 d ✓
    assert_eq(regexs.match("abc_1", "\\w+"), true)
    assert_eq(regexs.match(" ", "\\s"), true)
    assert_eq(regexs.match("abc", "\\D+"), true)        // 取反：非数字 ✓
    assert_eq(regexs.match("123", "\\D+"), false)
    assert_eq(regexs.match(" ", "\\W"), true)
    assert_eq(regexs.match("5", "[\\d]"), true)         // 字符类内的简写（**只认小写** ✓）
    assert_eq(regexs.match("123", "[\\d]+"), true)
    assert_eq(regexs.extract("2026-10-01", "\\d+-\\d+-\\d+"), "2026-10-01")
    assert_eq(regexs.replace("13812345678", "(\\d\\d\\d)\\d\\d\\d\\d(\\d\\d\\d\\d)", "$1****$2"),
              "138****5678")                            // 简写 + 反向引用一起用 ✓
    assert_eq(regexs.replace_all("a   b", "\\s+", " "), "a b")

    // ---- 词边界 `\b` / `\B` 与控制字符转义（2026-10-01 起支持）----
    assert_eq(regexs.match("foo", "\\bfoo\\b"), true)
    assert_eq(regexs.match("foobar", "\\bfoo\\b"), false)      // 词内不算边界 ✓
    assert_eq(regexs.find("a cat!", "\\bcat\\b"), 2)
    assert_eq(regexs.find("scat", "\\bcat\\b"), -1)            // 前面是词字符 ⇒ 无边界 ✓
    assert_eq(regexs.find("scats", "\\Bcat\\B"), 1)            // `\B` = 非边界 ✓
    assert_eq(regexs.extract("hello world", "\\bworld\\b"), "world")
    // 实用场景：**只替换整词**（`scat` 里的 cat 不动 ✓）
    assert_eq(regexs.replace_all("cat scat cat", "\\bcat\\b", "DOG"), "DOG scat DOG")
    // 控制字符：`\t` `\n` 等展开成真字符 ✓
    assert_eq(regexs.match("\t", "\\t"), true)
    assert_eq(regexs.match("\n", "\\n"), true)
    assert_eq(regexs.split("a\nb", "\\n").len(), 2)
    assert_eq(regexs.replace_all("a\t\tb", "\\t+", "|"), "a|b")

    // 不认识的转义**仍然报错**（别静默当字面量 ✓）—— 顺带钉住"消息指出是哪个转义"
    var e1 = ""
    try {
        regexs.match("x", "\\q")
    } catch e {
        e1 = _str(e.msg)
    }
    assert_eq(e1.has("不支持的转义"), true)
    assert_eq(e1.has("\\q"), true)

    // 字符类**内**仍只认小写简写：`[\D]`（类内再取反）语义含糊 ⇒ 报错 ✓
    var e2 = ""
    try {
        regexs.match("x", "[\\D]")
    } catch e {
        e2 = _str(e.msg)
    }
    assert_eq(e2.has("无效的正则表达式"), true)

    // 量词 `{n}` 与 POSIX 字符类 `[:digit:]` 同理**不支持** ⇒ 响亮报错
    //   （以前 `a{2}` 被当字面 "a{2}"、`[[:digit:]]` 静默不匹配 —— 都是"看不出来"的错 ✗）
    var e6 = ""
    try {
        regexs.match("aa", "a{2}")
    } catch e {
        e6 = _str(e.msg)
    }
    assert_eq(e6.has("不支持量词"), true)

    var e7 = ""
    try {
        regexs.match("5", "[[:digit:]]")
    } catch e {
        e7 = _str(e.msg)
    }
    assert_eq(e7.has("不支持 POSIX 字符类"), true)

    // 未闭合的字符类（`[invalid` / 单个 `[`）⇒ 报错
    //   （以前会一路吃到串尾当"字符类到此为止"⇒ 静默按错内容匹配 ✗）
    var e9 = ""
    try {
        regexs.match("test", "[invalid")
    } catch e {
        e9 = _str(e.msg)
    }
    assert_eq(e9.has("无效的正则表达式"), true)

    // ★ 替换串里的反向引用（`$1`）**自 2026-10-01 起真支持**（此前是"报错挡住"：
    //   更早还会把 `$1****$2` **原样写进结果** ✗）
    assert_eq(regexs.replace("13812345678",
                             "([0-9][0-9][0-9])[0-9][0-9][0-9][0-9]([0-9][0-9][0-9][0-9])",
                             "$1****$2"),
              "138****5678")
    assert_eq(regexs.replace("2026-10-01", "([0-9]+)-([0-9]+)-([0-9]+)", "$3/$2/$1"), "01/10/2026")
    // replace_all：**每次匹配按当次捕获**展开（不是全程用第一次的 ✗）
    assert_eq(regexs.replace_all("a1b2", "([a-z])([0-9])", "$2$1"), "1a2b")
    assert_eq(regexs.replace_all("a1b2", "([a-z])([0-9])", "$1|$2"), "a|1b|2")
    assert_eq(regexs.replace("abc123", "[0-9]+", "<$0>"), "abc<123>")   // `$0` = 整体匹配 ✓
    assert_eq(regexs.replace("x", "x", "$$1"), "$1")                    // `$$` ⇒ 字面 `$` ✓
    assert_eq(regexs.replace("a", "(a)", "$1-$5"), "a-")                // 超出组号 ⇒ 空串 ✓
    assert_eq(regexs.replace("x", "x", "a$b"), "a$b")                   // 单独 `$` 原样 ✓

    // ★ 捕获组（2026-10-01 匹配器重写后**真的可用**）：`groups()` 返回 `[整体, 组1, 组2, ...]`
    //   此前它只回 1 个元素（名不副实）—— 这条断言从"现状钉桩"升级成了"能力验证" ✓
    var g1 = regexs.groups("2026-10-01", "([0-9][0-9][0-9][0-9])-([0-9][0-9])-([0-9][0-9])")
    assert_eq(g1.len(), 4)
    assert_eq(g1[0], "2026-10-01")     // 整体匹配
    assert_eq(g1[1], "2026")
    assert_eq(g1[2], "10")
    assert_eq(g1[3], "01")

    var g2 = regexs.groups("user@example.com", "([a-z]+)@([a-z.]+)")
    assert_eq(g2.len(), 3)
    assert_eq(g2[1], "user")
    assert_eq(g2[2], "example.com")

    // 未参与本次匹配的组 ⇒ **空串**（数组元素类型是 string ⇒ 不用 null ✓）
    var g3 = regexs.groups("b", "(a)|(b)")
    assert_eq(g3.len(), 3)
    assert_eq(g3[1], "")
    assert_eq(g3[2], "b")

    // 重复组取**最后一次**匹配（与 Python 一致 ✓）
    var g4 = regexs.groups("abab", "(ab)+")
    assert_eq(g4.len(), 2)
    assert_eq(g4[1], "ab")

    // ---- 回溯（旧匹配器"贪吃不会吐"⇒ 下面这些曾经**静默 false** ✗）----
    assert_eq(regexs.match("ab.c.def", "[a-z.]+\\.[a-z]+"), true)
    assert_eq(regexs.match("aaab", "a*a*b"), true)
    assert_eq(regexs.match("ababc", "(a|b)+c"), true)
    assert_eq(regexs.match("ac", "(a|b)c"), true)          // 或分支之后要能接上后续 ✓
    assert_eq(regexs.match("abc", "abc$"), true)
    assert_eq(regexs.match("", "^$"), true)                // 空串 + 串尾锚定 ✓
    assert_eq(regexs.match("y", "x?y"), true)
    assert_eq(regexs.extract("https://www.example.com/path", "[a-zA-Z0-9.]+\\.com"), "www.example.com")

    // 反例：转义花括号照旧可以匹配**字面**花括号 ✓
    assert_eq(regexs.match("{2}", "\\{2\\}"), true)

    // 反例：合法转义照旧工作 —— 元字符转义，以及类内的 `\-`（阻止范围解释的正当写法 ✓）
    assert_eq(regexs.match("a.b", "a\\.b"), true)
    assert_eq(regexs.match("aXb", "a\\.b"), false)
    assert_eq(regexs.match("-", "[\\-]"), true)
    assert_eq(regexs.find("a\\b", "\\\\"), 1)   // `\\` = 一个字面反斜杠，位于下标 1

    print("\n=== 所有测试通过! ===")
}
