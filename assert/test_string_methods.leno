// 字符串方法测试

main()
{
    // 测试字符串长度
    var s = "hello"
    assert_eq(s.len(), 5)

    // 测试字符串拼接
    var concat = s + " world"
    assert_eq(concat, "hello world")

    // 测试字符串相等比较
    assert_eq("abc" == "abc", true)
    assert_eq("abc" != "def", true)
    assert_eq("abc" == "def", false)

    // 测试字符串索引访问
    assert_eq(s[0], "h")
    assert_eq(s[4], "o")

    // 测试 has
    assert_eq(s.has("ell"), true)
    assert_eq(s.has("xyz"), false)

    // 测试 split
    var parts = "a,b,c".split(",")
    assert_eq(parts.len(), 3)
    assert_eq(parts[0], "a")
    assert_eq(parts[2], "c")

    // 测试 take
    var sub = "hello world".take(0, 5)
    assert_eq(sub, "hello")

    // 测试字符串插值
    var name = "Leno"
    var version = 1.0
    var message = $"Welcome to {name} v{version}!"
    assert_eq(message, "Welcome to Leno v1.0!")

    // ---- 类型契约（v3.2.6，编译期把关）----
    //   `s.split(sep)` 返回 `Array[string]`（实现两分支装的都是 str_copy 出来的子串）。
    //   下面都是**不做收窄**的强类型局部变量 ⇒ 规格一漂回裸 `Array`，这里立刻编译失败。
    //   为什么值得单独钉：native 规格**只在编译期生效**（运行期不校验元素类型）
    //   ⇒ "spec 漏写 / 写错 / 被改回 any" 这类毛病，运行期断言永远是绿的。
    Array[string] split_all = "a,b,c".split(",")
    string split_first = "a,b,c".split(",")[0]
    assert_eq(split_all.len(), 3)
    assert_eq(split_first, "a")
    assert_eq(split_all[2], "c")          // string 元素 ⇒ 能直接进 Array[string] 的方法

    // ---- find 的 ^ / $ 锚点（2026-11-15 统一：多字节与 ASCII 同一语义、x$ 尊重 start）----
    //   修之前：锚点只认"目标恰好 1 字节" ⇒ "中x".find("^中") 当字面量找 ⇒ -1；
    //   且 "abc".find("c$", 3) 无视 start ⇒ 给 2（早于起点）
    assert_eq("abc".find("^a"), 0)
    assert_eq("abc".find("^b"), -1)
    assert_eq("abc".find("^b", 1), 1)
    assert_eq("abc".find("c$"), 2)
    assert_eq("abc".find("c$", 3), -1, "命中位置 2 早于 start=3 ⇒ -1（原来给 2）")
    assert_eq("中x".find("^中"), 0, "多字节 ^ 锚点（原来当字面量 ⇒ -1）")
    assert_eq("x中".find("中$"), 1, "多字节 $ 锚点（原来当字面量 ⇒ -1）")
    assert_eq("中x".find("中$"), -1)
    assert_eq("a".find("^a$"), 0)
    assert_eq("ab".find("^a$"), -1)
    assert_eq("".find("^$"), 0)
    assert_eq("abc".find("^$"), -1)
    assert_eq("a^b".find("^"), 1, "单独 ^ 不是锚点，按字面量找")
    assert_eq("x^a".find("^a", 0, true), 1, "plain=true ⇒ 一律字面量")
    assert_eq("x^a".find("^a"), -1, "plain 省略 ⇒ ^ 是锚点")

    print("test_string_methods passed")
}
