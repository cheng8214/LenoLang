// test_regex_invalid.leno —— 正则的**非法模式必须报错**，不能静默"匹配不上"
//
// 背景（2026-11-15 压测）：`regexs.find("abc", "(unclosed")` 返回 **-1**、`match` 返回 false，
//   零诊断 —— 根因是 parse_atom 里写成 `if (*p == ')') p++;`，未闭合的组被静默接受、
//   一直延伸到串尾 ⇒ 永远匹配失败。这类"模式写错 = 永远 false"最难查（看着像数据不对）。
//
// 判据：未闭合 `(`、多余 `)`、未闭合 `[`、非法转义、**写错的** `{n,m}` 量词
//      都必须抛错且文案点名原因；正常模式（锚定 / 查找 / 替换 / 空模式）行为不变。
//      （2026-11-19：`{n}` 系列从"一律报不支持"变成"支持，只在写错时报错" ✓）
import regexs

func want_error(string tag, string text, string pattern, string expect) {
    var caught = ""
    try {
        regexs.find(text, pattern)
    } catch e {
        caught = e.msg
    }
    assert_true(caught.len() > 0, tag + " 必须抛错（不能静默给 -1）；pattern=" + pattern)
    assert_true(caught.find(expect) >= 0,
        tag + " 的报错要点名原因「" + expect + "」；实际=" + caught)
}

main() {
    // ① 未闭合的组（原先静默 -1）
    want_error("①未闭合 (", "abc", "(unclosed", "括号没有闭合")

    // ② 多出的 ')'
    want_error("②多余 )", "abc", "abc)", "多了一个 ')'")

    // ③ 未闭合字符类 / 非法转义
    want_error("③未闭合 [", "abc", "[", "无效的正则表达式")
    want_error("④非法转义", "abc", "\\q", "不支持的转义")

    // ⑤ ★ 2026-11-19：`{n}` / `{n,}` / `{n,m}` **已支持**，所以这里改成"写错时才报错"：
    //    写法不对 / 上界写反 / 超出上限 ⇒ 都点名叫"无效的量词"，不落到笼统的「无效的正则表达式」
    want_error("⑤a 空花括号", "abc", "a{}", "无效的量词")
    want_error("⑤b 非数字", "abc", "a{x}", "无效的量词")
    want_error("⑤c 缺右括号", "abc", "a{2", "无效的量词")
    want_error("⑤d 上下界写反", "abc", "a{3,2}", "无效的量词")
    want_error("⑤e 超出上限", "abc", "a{1001}", "无效的量词")
    want_error("⑤f 花括号前没有元素", "abc", "{2}a", "前面没有可重复的元素")
    want_error("⑤g 两个量词连写", "abc", "a{2}{3}", "前面没有可重复的元素")
    want_error("⑤h 非贪婪 {n}?", "abc", "a{2}?", "不支持非贪婪量词")
    want_error("⑤i 多余 }", "abc", "a}b", "多了一个 '}'")

    // ⑤b 更具体的诊断（2026-11-15）：此前这几种都只得到笼统的「无效的正则表达式」
    want_error("⑤b 未闭合字符类（有内容）", "abc", "[abc", "字符类没有闭合")
    want_error("⑤c 量词前面没有元素", "abc", "a**", "前面没有可重复的元素")
    want_error("⑤d 开头就是量词", "abc", "*a", "前面没有可重复的元素")
    want_error("⑤e 捕获组超上限", "abcdefghijklmnopq",
        "(a)(b)(c)(d)(e)(f)(g)(h)(i)(j)(k)(l)(m)(n)(o)(p)(q)", "捕获组太多")

    // ⑥ 正常路径不受影响
    assert_eq(regexs.match("abc", "^a.c$"), true, "⑥锚定匹配")
    assert_eq(regexs.find("abc", "b"), 1, "⑥子串查找")
    assert_eq(regexs.replace_all("aaa", "a", "b"), "bbb", "⑥全量替换")
    assert_eq(regexs.match("abc", ""), true, "⑥空模式匹配")
    assert_eq(regexs.find("abc", "zzz"), -1, "⑥正常的不匹配仍是 -1")

    // ⑦ 配平的括号 / 转义括号照常可用
    assert_eq(regexs.match("abc", "(ab)c"), true, "⑦成对括号")
    assert_eq(regexs.match("a(c", "a\\(c"), true, "⑦转义括号当字面量")

    print("test_regex_invalid passed（未闭合/多余括号、非法转义、写错的量词；正常模式不变）")
}
