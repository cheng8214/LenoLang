// 立即数快速路径（OP_ADD_INT_IMM / OP_SUB_INT_IMM）回归
// ----------------------------------------------------------------------------
// 背景：examples/性能测试/经典斐波那契数列测试_int.leno 里 `n - 2` / `n - 1` 各要
// 「MOV + LOADI + SUB_INT」3 条指令，而栈式只要 1 条（SUB_INT_IMM）⇒ 递归基准上
// 指令数 23 vs 11。补了立即数形式后寄存器式每次调用从 23 条降到 19 条。
// 本文件钉住三类容易踩的点：
//   ① 立即数的边界与负数（C 字段是 8 位**有符号**，-128..127）；
//   ② 超出 8 位范围时必须老实走普通路径；
//   ③ 左边不是 int（如 bigint）时不能用立即数指令 —— 否则"跳过右值求值却走通用路径"，
//      会让 `big1 + 100` 静默失效（写这段时真踩过：test_bigint 差 100）。
import io

func fib(int n): int {
    if n <= 1 {
        return n
    }
    return fib(n - 2) + fib(n - 1)
}

main() {
    // ① 立即数加减：常规 / 负立即数 / 8 位边界
    var x = 10
    assert_eq(x - 1, 9)
    assert_eq(x + 1, 11)
    assert_eq(x - 128, -118)
    assert_eq(x + 127, 137)
    assert_eq(x - 127, -117)

    // ② 超出 [-128,127] ⇒ 走普通路径，结果同样要对
    assert_eq(x + 128, 138)
    assert_eq(x - 129, -119)
    assert_eq(x + 1000, 1010)

    // ③ 复合赋值（内部也走加减）
    var y = 5
    y += 1
    y -= 2
    assert_eq(y, 4)
    var acc = 0
    for 10 { acc += 1 }
    assert_eq(acc, 10)

    // ④ bigint + 小整数：左值不是 int ⇒ 必须走通用算术（这是踩过的坑）
    var big = 12345678901234567890
    assert_eq(big + 100, 12345678901234567990)
    assert_eq(big - 100, 12345678901234567790)

    // ⑤ 递归形态（立即数减法 + 立即数比较同时出现）
    assert_eq(fib(20), 6765)

    io.print("test_int_imm passed")
}
