// 嵌套块注释（B5，2026-11-02）
//
// 以前块注释在**第一个** `*/` 就结束 ⇒ 注释掉一段"本身含块注释"的代码时，
// 后半段会被当成代码继续词法分析：轻则报「期望表达式」（指不到真因），
// 重则编译通过但语义变了（"注释吞代码"）。

/* 外层
   /* 内层 */
   这段文字在 2026-11-02 之前会被当成代码 ⇒ 「期望表达式」
*/

/* 连续两层且内层里有 * 和 / 字符
   /* a */ /**/ /** */
*/

main() {
    // ① 注释外的代码正常执行（说明注释确实被完整吞掉）
    assert_eq(1 + 1, 2, "注释后的代码正常")

    // ② 行注释里出现 /* 不影响任何东西
    // /* 这行全是注释 */
    assert_eq(2 + 2, 4, "行注释里的 /* 无副作用")

    /* ③ 单层块注释照旧 */
    assert_eq(3 + 3, 6, "单层块注释")

    // ④ 字符串里出现 */ 也不会提前结束注释（不在注释里，只是验证词法不串味）
    string s = "*/"
    assert_eq(s, "*/", "字符串里的 */")

    print("test_nested_comment all passed")
}
