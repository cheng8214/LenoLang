// int48 越界必须**提升 bigint**，不能静默截断/回绕
// ----------------------------------------------------------------------------
// 背景：int 是 48 位有符号（[-2^47, 2^47-1]），越界时本语言的一贯约定是提升为
// bigint（见 OP_NEG / VM_INT_RESULT）。有两处特化快路径漏了这个约定，会把结果
// **静默**截成 48 位 —— 值不报错、只是错的（比崩溃更难查）：
//
//   ① 左移：守卫只看**移位量**（shi < 32），看不到**左值大小**。左值本身在 int48 内、
//      移位量也合法，结果照样能越界 ⇒ `123456789012345 << 3` 曾算出 -138245594743864
//      （正确值 987654312098760）。
//   ② 除法：只有一个组合越界 —— `INT48_MIN / -1 == +2^47`（比 INT48_MAX 大 1），
//      曾回绕成 -140737488355328（负号都没了）。
//
// 这两个用例原先**一个都没被覆盖**：断言套件全绿却漏掉了它们。本文件专门钉住。
//
// ⚠ 判据必须**先比阈值、再移位**：左值有 48 位有效位、移位量最大 31 ⇒ 结果可达 79 位，
//   先移位会撞上 int64 左移溢出（UB），回绕后的值还会被误判成"在范围内"
//   （`hi << 1`（hi = 2^47-1）就是这么算成 -2 的）。
import io

main() {
    var hi = 140737488355327      // INT48_MAX = 2^47 - 1
    var lo = -140737488355328     // INT48_MIN = -2^47

    // ---- ① 左移越界：结果必须提升 bigint ----
    var c = 123456789012345       // 本身在 int48 内，但 << 3 之后越界
    assert_eq(c << 3, 987654312098760)
    assert_eq(c << 1, 246913578024690)
    assert_eq(hi << 1, 281474976710654)
    assert_eq(lo << 1, -281474976710656)

    // ---- ①' 左移不越界：必须仍是 int，且能参与算术与比较 ----
    assert_eq(hi << 0, 140737488355327)
    assert_eq(lo << 0, -140737488355328)
    assert_eq(5 << 2, 20)
    assert_eq(-5 << 1, -10)
    assert_eq((5 << 2) + 1, 21)
    assert_eq((5 << 2) == 20, true)
    assert_eq((hi << 0) + 1, 140737488355328)   // int + int 越界 ⇒ 提升 bigint

    // ---- ② 除法越界：唯一组合 INT48_MIN / -1 ----
    assert_eq(lo / -1, 140737488355328)
    assert_eq(lo / 1, -140737488355328)         // 不越界，仍是 int
    assert_eq(hi / 1, 140737488355327)
    assert_eq(lo / 2, -70368744177664)

    // ---- ②' 取模不会越界（结果绝对值恒小于除数）----
    assert_eq(lo % -1, 0)
    assert_eq(lo % 7, -4)

    // ---- ③ 取负（对照组，一直是正确的）----
    assert_eq(-lo, 140737488355328)
    assert_eq(-hi, -140737488355327)

    // ---- ④ 越界结果必须能继续参与运算（确认拿到的是真 bigint 而不是坏位模式）----
    assert_eq((lo / -1) - 1, 140737488355327)
    assert_eq((c << 3) / 8, 123456789012345)

    io.print("test_int48_overflow passed")
}
