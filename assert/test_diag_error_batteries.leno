// test_diag_error_batteries.leno —— 一批"故意写错"的示例收编成的**负例断言**（2026-09-28；实例四十八）
//
// 这些例子原本散在 `examples/` 各处（sys / struct / enum / clib / 多返回值 …），共同点是
//   **天生编译不过**（它们演示的正是编译器要拒绝的写法）⇒ 作为"示例"永远跑不通，但作为
//   **诊断回归**很有价值。做法：fixture 移到 `assert/error_cases/`（不改名会以 `test_` 开头被
//   run_tests 当用例跑 ⇒ 一律换成语义化名字），断言收到本文件（一条一行：fixture / 文案 / 落点行）。
//
// ⚠ fixture 是**原样搬运**的 ⇒ 文件顶部可能还留着与当年一致、但与现在落点不符的注释；
//   **以本文件的断言为准**。

import "helpers/compiler.leno" as ce
import dirs
import files

main() {
    // 动态脚本落在这个临时目录（静态 fixture 走 cwd 相对路径，见文件头说明）
    var work = dirs.join(_tmpdir(), "leno_error_batteries")
    dirs.delete(work)
    dirs.mkdir_p(work)

    // ---- 内置函数实参个数（sys）----
    ce.expect_error("assert/error_cases/arity_gc_too_many.leno",
        "_gc 参数过多要报错", "_gc 参数过多: 最多 1 个, 实际 2", 3)
    ce.expect_error("assert/error_cases/arity_assert_too_few.leno",
        "assert 参数过少要报错", "assert 参数过少: 最少 1 个, 实际 0", 3)
    ce.expect_error("assert/error_cases/arity_assert_eq_too_few.leno",
        "assert_eq 参数过少要报错", "assert_eq 参数过少: 最少 2 个, 实际 1", 3)

    // ---- struct ----
    ce.expect_error("assert/error_cases/struct_redefine.leno",
        "struct 重复定义要报错", "struct 'Config' 重复定义", 24)
    ce.expect_error("assert/error_cases/struct_direct_method_call.leno",
        "把方法当普通函数直接调要报错", "未定义的函数: Point_test", 14)
    ce.expect_error("assert/error_cases/struct_scope_resolution.leno",
        "作用域写错要报语法错", "期望表达式", 15)

    // ---- face ----
    ce.expect_error("assert/error_cases/face_missing_method.leno",
        "声明 impl 但缺方法要报错", "但缺少方法 'speak'", 16)
    ce.expect_error("assert/error_cases/face_not_impl.leno",
        "未实现 face 的 struct 传给 face 形参要报错（并给 impl 提示）",
        "第 1 个参数类型不匹配: 期望 face Speaker, 实际 struct Fish", 36)

    // ---- enum ----
    ce.expect_error("assert/error_cases/enum_redefine.leno",
        "enum 重复定义要报错", "enum 'Color' 重复定义", 10)
    ce.expect_error("assert/error_cases/enum_no_member.leno",
        "访问不存在的枚举成员要报错", "枚举 'Color' 中没有成员 'blue'", 10)

    // ---- clib ----
    ce.expect_error("assert/error_cases/clib_load_mismatch.leno",
        "clib 变量类型与 ffi.load 结果不符要报错",
        "变量 'lib2' 声明类型与初始化值类型不匹配", 18)
    ce.expect_error("assert/error_cases/clib_str8_param.leno",
        "clib 形参用 string 而声明是 Ptr 要报错",
        "函数 'strlen' 参数 1 类型不匹配: 期望 'Ptr', 实际 'string'", 11)

    // ---- 多返回值 ----
    ce.expect_error("assert/error_cases/multi_ret_count_mismatch.leno",
        "多返回值个数不匹配要报错", "多返回值数量不匹配：期望 2 个，实际 3 个", 8)

    // ---- 泛型系统的边界错误（`examples/泛型系统/边界与错误`，6 个）----
    //   其中 `test_face_access_err`（face 变量访问底层字段）的文案**本文件外已有覆盖** ⇒ 不再重复钉，
    //   只删文件；另 5 个各钉一条。搬运时把两个 fixture 的 `import "../模块/generic_module2.leno"`
    //   换成**本地极简 fixture** `error_cases/generic_box_mod.leno`（跨目录相对路径搬不过去 ✓）。
    ce.expect_error("assert/error_cases/generic_needs_type_param.leno",
        "泛型 struct 实例化不带类型参数要报错（`new Box(...)`）",
        "泛型 struct 'Box' 需要类型参数（如 Box[类型]）", 9)
    ce.expect_error("assert/error_cases/generic_needs_type_param2.leno",
        "泛型 struct 实例化不带类型参数要报错（另一处写法）",
        "泛型 struct 'Box' 需要类型参数（如 Box[类型]）", 7)
    ce.expect_error("assert/error_cases/generic_arg_type_mismatch.leno",
        "泛型函数显式实参与形参类型不符要报错",
        "strict 第 2 个参数类型不匹配: 期望 int, 实际 string", 9)
    ce.expect_error("assert/error_cases/generic_method_arg_mismatch.leno",
        "泛型 struct 方法实参类型不符要报错",
        "set 第 1 个参数类型不匹配: 期望 int, 实际 string", 10)
    ce.expect_error("assert/error_cases/use_not_found.leno",
        "use 模块里不存在的符号要报错（并可能给相似名提示）",
        "模块 'gm' 中没有类型或函数 'NotExist'", 5)

    // ---- `any` 的三条严格化诊断（2026-09-28；实例五十）----
    //   收编自 `examples/测试/*`、`examples/crypto/rsa.leno` 等处**被新严格化拦下**的写法
    //   （实例二十三起：静态 any 不许进 native 形参 / 不能在 any 上访问成员）。
    //   这三句此前**一条断言都没有** ⇒ 一并钉住（谁放宽/收紧了都能立刻看到）。
    var an1 = dirs.join(work, "any_index.leno")
    files.write(an1, @"export func idx(any x): any {
    return x[0]
}
")
    ce.expect_error(an1, "any 上做索引访问要报错", "不能在 any 类型上进行索引访问", 2)

    var an2 = dirs.join(work, "any_cmp.leno")
    files.write(an2, @"export func cmp(any a, any b): bool {
    return a < b
}
")
    ce.expect_error(an2, "any 参与大小比较要报错（并提示指定元素类型）",
        "any 类型不能参与大小比较", 2)

    // 未标返回类型的函数 ⇒ 返回值是 **any**（**当前契约**：要在算术里用就得标注或用 _int/_str）
    //   ⚠ 这条**文档里没写**（grep 教程/手册 0 命中）⇒ 钉住是为了"将来若改成按函数体推断，
    //     这里会先红"，而不是宣称这是最佳设计。来源：examples/测试/数组字典边界/嵌套数组类型问题.leno（已删）
    var an3 = dirs.join(work, "unannotated_ret.leno")
    files.write(an3, @"func f() {
    return 42
}

main() {
    var a = 0
    a = a + f()
}
")
    ce.expect_error(an3, "未标返回类型的函数返回值是 any（进算术要报错）",
        "无法将值赋值给变量 'a'", 7)

    // ---- 解构 / 容器元素类型（2026-09-28；实例五十一）----
    //   ① 解构槽位类型不兼容：收编自 examples/测试/cs_design.leno（已删）
    ce.expect_error("assert/error_cases/destruct_type_mismatch.leno",
        "解构槽位声明类型与返回值不兼容要报错",
        "解构槽位 0 ('a') 类型 string 与返回值类型 int 不兼容", 5)
    //   ② Array[int] 里 add 字符串：收编自 examples/多变量声明/multi_var_array.leno（已删）
    ce.expect_error("assert/error_cases/array_int_add_string.leno",
        "Array[int].add(string) 要报错", "参数 1 期望 'int'，但传入 'string'", 7)

    //   ③ `any` 形参赋给具体类型变量要报错（收编自 examples/func/func 默认参数/default_param_type_check.leno，已删）
    var anyp = dirs.join(work, "any_param_to_int.leno")
    files.write(anyp, @"main() {
    func test2(any a, any b = 0) {
        int n = a
        print(n)
    }
    test2(42)
}
")
    ce.expect_error(anyp, "any 形参赋给 int 变量要报错",
        "变量 'n' 声明类型与初始化值类型不匹配", 3)

    // ---- `use` 语法指引（2026-09-28；实例五十三）----
    //   带**模块前缀的类型声明**（`m.Helper h = ...`）不被支持，编译器要给"先 use 再直接写类型名"
    //   的指引。收编自 examples/func/func类型/bug_repro_alias_use.leno（已删）—— 那个 repro 想演示
    //   的"场景 3"根本走不到，**首条错误**就是这条指引 ⇒ 把这句钉住。
    ce.expect_error("assert/error_cases/mod_prefixed_type.leno",
        "带模块前缀的类型声明要报错并给指引（先说 use、再直接写类型名）",
        "不支持带模块前缀的类型声明 'm.Helper 变量名'", 7)

    print("test_diag_error_batteries passed（27 例）")
}
