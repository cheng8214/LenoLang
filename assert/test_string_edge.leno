// 字符串边界情况回归测试
// 覆盖：索引越界、空字符串、Unicode、特殊字符、方法边界

main()
{
    // 测试1: 空字符串
    var empty = ""
    assert_eq(empty.len(), 0)
    assert_eq(empty + "", "")
    assert_eq(empty == "", true)
    assert_eq(empty != "", false)

    // 测试2: 字符串索引越界被 try-catch 捕获
    var caught_oob = false
    try {
        var s2 = "hello"
        var c2 = s2[100]
    } catch e {
        caught_oob = true
    }
    assert_eq(caught_oob, true)

    // 测试3: 负索引越界
    var caught_neg = false
    try {
        var s3 = "hello"
        var c3 = s3[-1]
    } catch e {
        caught_neg = true
    }
    assert_eq(caught_neg, true)

    // 测试4: 边界索引（最后一个字符）
    var s4 = "hello"
    assert_eq(s4[0], "h")
    assert_eq(s4[4], "o")

    // 测试5: 长度1的字符串
    var one = "x"
    assert_eq(one.len(), 1)
    assert_eq(one[0], "x")

    // 测试6: Unicode 字符串（按字节索引）
    var uni = "你好世界"
    assert_eq(uni.len(), 12)        // 4个中文字 × 3字节 = 12字节
    // 注意：字符串索引是按字节的，中文字符占3字节

    // 测试7: 混合 ASCII 和 Unicode
    var mixed = "hi你好"
    assert_eq(mixed.len(), 8)       // 2 ASCII + 2中文×3字节 = 8字节

    // 测试8: 字符串拼接边界
    assert_eq("" + "a", "a")
    assert_eq("a" + "", "a")
    assert_eq("" + "", "")

    // 测试9: 字符串比较
    assert_eq("abc" == "abc", true)
    assert_eq("abc" == "abd", false)
    assert_eq("" == "", true)
    assert_eq("a" == "A", false)

    // 测试10: 字符串方法 - trim 边界
    assert_eq("  hello  ".trim(), "hello")
    assert_eq("   ".trim(), "")
    assert_eq("".trim(), "")
    assert_eq("hello".trim(), "hello")

    // 测试11: 字符串方法 - to_upper / to_lower
    assert_eq("hello".to_upper(), "HELLO")
    assert_eq("HELLO".to_lower(), "hello")
    assert_eq("".to_upper(), "")
    assert_eq("".to_lower(), "")
    assert_eq("123".to_upper(), "123")

    // 测试12: 字符串方法 - starts_with / ends_with
    assert_eq("hello".starts_with("hel"), true)
    assert_eq("hello".starts_with(""), true)
    assert_eq("hello".starts_with("world"), false)
    assert_eq("hello".ends_with("llo"), true)
    assert_eq("hello".ends_with(""), true)
    assert_eq("hello".ends_with("world"), false)
    assert_eq("".starts_with(""), true)
    assert_eq("".ends_with(""), true)

    // 测试13: 字符串方法 - has
    assert_eq("hello".has("ell"), true)
    assert_eq("hello".has("hello"), true)
    assert_eq("hello".has(""), true)
    assert_eq("hello".has("world"), false)
    assert_eq("".has(""), true)
    assert_eq("".has("a"), false)

    // 测试14: 字符串方法 - replace
    assert_eq("hello".replace("l", "r"), "herro")
    assert_eq("hello".replace("", "-"), "hello")   // 空字符串替换不做任何操作
    assert_eq("hello".replace("z", "x"), "hello")
    assert_eq("aaa".replace("a", "bb"), "bbbbbb")

    // 测试15: 字符串方法 - split
    var parts = "a,b,c".split(",")
    assert_eq(parts.len(), 3)
    assert_eq(parts[0], "a")
    assert_eq(parts[2], "c")

    // split 空分隔符
    var chars = "abc".split("")
    assert_eq(chars.len(), 3)

    // split 无匹配
    var no_match = "hello".split(",")
    assert_eq(no_match.len(), 1)
    assert_eq(no_match[0], "hello")

    // 测试16: 字符串方法 - sub_str
    assert_eq("hello world".sub_str(0, 5), "hello")
    assert_eq("hello world".sub_str(6, 11), "world")
    assert_eq("hello".sub_str(0, 5), "hello")
    assert_eq("hello".sub_str(2, 5), "llo")

    // 测试17: 字符串方法 - reverse
    assert_eq("hello".reverse(), "olleh")
    assert_eq("".reverse(), "")
    assert_eq("a".reverse(), "a")

    // 测试18: 字符串方法 - rep (重复)
    assert_eq("ab".rep(3), "ababab")
    assert_eq("x".rep(1), "x")
    assert_eq("x".rep(0), "")

    // 测试19: 字符串方法 - count
    assert_eq("hello".count("l"), 2)
    assert_eq("hello".count("o"), 1)
    assert_eq("hello".count("z"), 0)
    assert_eq("aaa".count("a"), 3)
    assert_eq("".count("a"), 0)

    // 测试20: 字符串方法 - find（0-indexed，找不到返回 -1）
    assert_eq("hello world".find("world", 0, true), 6)
    assert_eq("hello world".find("hello", 0, true), 0)
    assert_eq("hello world".find("xyz", 0, true), -1)

    // 测试21: 字符串方法 - pad_start / pad_end
    assert_eq("5".pad_start(3, "0"), "005")
    assert_eq("hi".pad_start(5, " "), "   hi")
    assert_eq("hi".pad_end(5, " "), "hi   ")

    // 测试22: 字符串方法 - slice
    assert_eq("hello".slice(1, 3), "el")
    assert_eq("hello".slice(0, 5), "hello")

    // 测试23: 字符串方法 - byte
    var byte_val = "A".byte(0)
    assert_eq(byte_val, 65)

    // 测试24: 特殊字符
    assert_eq("hello\nworld".has("\n"), true)
    assert_eq("tab\there".has("\t"), true)
    assert_eq("quote\"here".has("\""), true)

    // 测试25: 字符串插值边界
    var x = 0
    assert_eq($"x={x}", "x=0")
    var null_str = null
    assert_eq($"n={null_str}", "n=null")

    // 测试26: 字符串与类型转换
    assert_eq(_str(42), "42")
    assert_eq(_str(3.14), "3.14")
    assert_eq(_str(true), "true")
    assert_eq(_str(null), "null")

    // 测试27: 字符串与 in / not in
    assert_eq("ell" in "hello", true)
    assert_eq("xyz" in "hello", false)
    assert_eq("xyz" not in "hello", true)

    // 测试28: 字符串方法链式调用
    assert_eq("  Hello World  ".trim().to_lower(), "hello world")
    assert_eq("hello".to_upper().reverse(), "OLLEH")

    print("test_string_edge passed")
}
