// 回归：**跨模块调用的默认参数**必须补齐
//   被调函数的 AST 在另一个模块里，调用点拿不到 param_defaults ⇒ 必须查导入模块的
//   符号表（param_count + param_default_texts，文本形式求值）。
//   原来省略的实参在运行期就是 null（`mod.test_int(5)` 得 5 而非 15、
//   `mod.test_any(5)` 直接报「加法运算: null 不能参与运算」）。
import "xmod_defaults.leno" as m

main() {
    // ① 单个 int 默认参数
    assert_eq(m.add10(5), 15)
    assert_eq(m.add10(5, 20), 25)

    // ② float 默认参数（文本 "2.0" 要解析成浮点）
    assert_eq(m.scale(3.0), 6.0)
    assert_eq(m.scale(3.0, 4.0), 12.0)

    // ③ 多个默认参数，逐个补齐
    assert_eq(m.multi(1), "a=1 b=20 c=hi")
    assert_eq(m.multi(1, 2), "a=1 b=2 c=hi")
    assert_eq(m.multi(1, 2, "x"), "a=1 b=2 c=x")

    // ④ 对照组：没有默认参数的函数
    assert_eq(m.no_default(3, 4), 7)

    // ⑤ bool 默认参数（文本 "true"）
    assert_eq(m.typed_default(), true)
    assert_eq(m.typed_default(false), false)

    // ⑥ 默认值参与表达式
    assert_eq(m.add10(1) + m.add10(2, 3), 11 + 5)

    // ⑦ 跨模块 **struct 方法** 的默认参数（2026-10-02，符号表 v36）
    //   同一个"调用点拿不到被调 AST"的问题在方法侧一直没人管（`ModuleStructMethod`
    //   没有 default_count / param_default_texts）⇒ 省略的实参是**未初始化槽位**：
    //   `c.plus()` 得 `<object>`、`c.mul(5)` 得随机整数，**不报错**（静默垃圾 ✗）。
    //   同时钉两个方向：① 不传 ⇒ 补默认值；② 传了 ⇒ 用实参（别把默认值覆盖上去）。
    var c = new m.Calc(base = 1)
    assert_eq(c.plus(), 11)
    assert_eq(c.plus(20), 21)
    assert_eq(c.mul(5), 30)          // 5*2*3
    assert_eq(c.mul(5, 4), 60)       // 5*4*3
    assert_eq(c.mul(5, 4, 2), 40)    // 5*4*2
    assert_eq(c.tag(), "s=hi n=7")
    assert_eq(c.tag("x"), "s=x n=7")
    assert_eq(c.tag("x", 1), "s=x n=1")
    // 对照组：无默认值的方法照旧
    assert_eq(c.no_default(3, 4), 34)
    print("[7] cross-module struct method default args passed")
}
