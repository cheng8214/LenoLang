// 测试运算符优先级

main() {
    // === * / % > + - ===
    assert_eq(2 + 3 * 4, 14)
    assert_eq(10 - 6 / 2, 7)
    assert_eq(10 % 3 * 2, 2)

    // === 位运算 ===
    assert_eq(0x0F & 0xF0, 0)
    assert_eq(0x0F | 0xF0, 0xFF)
    assert_eq(0xFF ^ 0x0F, 0xF0)
    assert_eq(~5, -6)
    assert_eq(~0, -1)

    // << 左移
    assert_eq(1 << 3, 8)
    assert_eq(8 << 2, 32)
    assert_eq(10 << 1, 20)

    // >> 算术右移
    assert_eq(8 >> 2, 2)
    assert_eq(32 >> 3, 4)

    // >>> 逻辑右移（正数同 >>）
    assert_eq(256 >>> 8, 1)
    assert_eq(8 >>> 2, 2)

    // === 比较 ===
    assert_true(1 + 2 == 3)
    assert_false(5 < 3)

    // === and/or/not (短路求值 + 返回值) ===
    // not: 返回真假
    assert_eq(not 1, false)
    assert_eq(not 0, true)

    // and: 返回第一个假值或最后一个真值
    var a1 = 1 and 2
    assert_eq(a1, 2)
    var a2 = 0 and 2
    assert_eq(a2, 0)

    // or: 返回第一个真值或最后一个假值
    var o1 = 1 or 2
    assert_eq(o1, 1)
    var o2 = 0 or 3
    assert_eq(o2, 3)

    // 短路：左侧为真/假时右侧不执行
    var flag = 0
    var r = 1 or (flag = 1)
    assert_eq(r, 1)
    assert_eq(flag, 0)   // flag 未变，证明右侧未执行

    var r2 = 0 and (flag = 2)
    assert_eq(r2, 0)
    assert_eq(flag, 0)   // flag 未变

    // === 优先级: 比较 > and/or ===
    var c1 = 3 > 2 and 5 > 4
    assert_true(c1)
    var c2 = 3 > 2 or 5 < 4
    assert_true(c2)

    // === = 赋值优先级（链式） ===
    int a = 0
    int b = 0
    a = b = 5
    assert_eq(a, 5)
    assert_eq(b, 5)

    print("test_operator_precedence passed")
}
