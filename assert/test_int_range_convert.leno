// 回归测试：大数转换/大字面量**不得被 32 位截断或饱和**（int64 / BigInt 边界）
//
// 历史 bug（2026-09-25 修，三类同源）：
//   ① `_int(字符串)`：原写法 `strtol` + `(int)` —— Windows 的 `long` 只有 32 位 ⇒
//      `_int("9999999999999999")` 被**饱和**成 2147483647；而在 `long` 是 64 位的平台上
//      `(int)` 又变成**截断**（同一份代码跨平台两种错法 ✗）。现为 `strtoll` + `val_int_safe` ✓
//   ② `_int(float)`：原 `val_int((int)d)` ⇒ `_int(1000000000000.0)` = -2147483648 ✗。
//      现先夹到 int64 边界再 `val_int_safe` ✓
//   ③ 模块级 `export var` 字面量预登记：原 `val_int((int)…)` ⇒ `export var BIG = 3000000000`
//      跨模块读到 -2147483648 ✗（见 test_int_range_convert_mod.leno ✓）
//
// 本用例钉住的是**值**（不钉内部表示）：int48 内是 int、超出后自动升 bigint，但值都必须一致 ✓
import "test_int_range_convert_mod.leno" as m

// ④ 用的 enum（必须声明在**模块级**：main 里声明的局部 enum 迭代不到成员 ✗ 实测）
enum BigFlag {
    A = 0x80000000        // 2147483648
    B = 0x80000001        // 2147483649
}

main() {
    // === ① 字符串：大数（修复前全是 2147483647）===
    assert_eq(_int("9999999999999999"), 9999999999999999)
    assert_eq(_int("1640290765340685"), 1640290765340685)
    assert_eq(_int("2147483647"), 2147483647)          // int32 上界：本来就对，钉住别改坏 ✓
    assert_eq(_int("2147483648"), 2147483648)          // 刚过 int32 上界
    assert_eq(_int("4294967296"), 4294967296)          // int32 的两倍
    assert_eq(_int("140737488355327"), 140737488355327)  // int48 上界（2^47-1）
    assert_eq(_int("140737488355328"), 140737488355328)  // 刚过 int48 ⇒ 内部转 bigint，值不变 ✓

    // === 负数（修复前为 -2147483648）===
    assert_eq(_int("-9999999999999999"), -9999999999999999)
    assert_eq(_int("-2147483648"), -2147483648)        // int32 下界
    assert_eq(_int("-2147483649"), -2147483649)        // 刚过 int32 下界
    assert_eq(_int("-140737488355328"), -140737488355328)  // int48 下界（-2^47）

    // === 超 int64 ⇒ 交 bigint 解析（修复前是饱和值，不是真值 ✗）===
    assert_eq(_int("18446744073709551616"), 18446744073709551616)        // 2^64
    assert_eq(_int("-18446744073709551616"), -18446744073709551616)
    assert_eq(_int("123456789012345678901234567890"), 123456789012345678901234567890)

    // === 常规值：修复不能改变它们 ✓ ===
    assert_eq(_int("123"), 123)
    assert_eq(_int("-7"), -7)
    assert_eq(_int("0"), 0)
    assert_eq(_int(true), 1)
    assert_eq(_int(false), 0)
    assert_eq(_int(null), 0)
    assert_eq(_int(3.9), 3)                            // 小数截断（老语义 ✓）
    assert_eq(_int(-3.9), -3)
    assert_eq(_int(42), 42)

    // === ② 浮点：大值不得溢出（修复前 _int(1000000000000.0) = -2147483648 ✗）===
    assert_eq(_int(1000000000000.0), 1000000000000)
    assert_eq(_int(-1000000000000.0), -1000000000000)
    assert_eq(_int(3000000000.0), 3000000000)
    assert_eq(_int(140737488355328.0), 140737488355328)   // 刚过 int48
    // 超出 int64：**刻意**夹到 int64 边界（不是截断、也不是饱和成 int32 ✗）
    assert_eq(_int(9223372036854775808.0), 9223372036854775807)

    // === ③ 模块级大字面量（修复前 m.BIG = -2147483648 ✗）===
    assert_eq(m.BIG, 3000000000)
    assert_eq(m.BIG_NEG, -3000000000)
    assert_eq(m.BIG_CONST, 3000000000)
    assert_eq(m.HUGE, 3000000000000000)                // bigint 字面量：本来就对 ✓
    assert_eq(m.BIG + 1, 3000000001)
    assert_eq(m.BIG_NEG + 1, -2999999999)

    // === ④ 同族「(int) 截断」：enum 迭代取值 > 2^31 不得被截断 ===
    // （这正是 docs/枚举求值与模块符号表问题.md 的 ENUM-4 类；一并钉住 ✓）
    int sum = 0
    int cnt = 0
    for BigFlag to f {
        sum = sum + f
        cnt = cnt + 1
    }
    assert_eq(cnt, 2)
    assert_eq(sum, 4294967297)                          // 2147483648 + 2147483649

    // === ⑤ `_int` != `_int32`：后者是**刻意**的环绕/截断语义，别被"修 _int"顺手改掉 ✗ ===
    assert_eq(_int32(3000000000), -1294967296)
    assert_eq(_int32(-1), -1)
    assert_eq(_int32(2147483648), -2147483648)
    assert_eq(_uint32(-1), 4294967295)

    print("大数转换/大字面量（int32 截断回归）测试通过")
}
