// 编译器内联的「模块变量访问」安全边界回归（roadmap R7①）
//
// 背景：`scan_callee_for_inline()` 原先对 `OP_GET_MODULE_VAR` / `OP_SET_MODULE_VAR` /
// `OP_GET_MODULE_FUNC` 一律拒绝内联（「内联后没有 callee 的帧，模块归属不可知」，
// 是内联侧第一大缺口）。放开的**唯一**条件是：**callee 与 caller 同属一个模块**
// —— 因为内联后 codegen 用的是编译期嵌入的 module（等于调用方的 module），
// 同模块时它正确，跨模块时会用错 globals 下标、**静默读错变量**。
//
// 覆盖两条判据：
//   ① 同模块（辅助模块内部 `runSame` → `Acc.bump`）：允许内联，且取值必须精确 ——
//      一旦内联体的栈记账写错，下面的断言立刻失败。
//   ② 跨模块（本文件 → 辅助模块的 `Acc.bump`）：**必须仍然拒绝内联**（安全边界），
//      取值同样必须精确。
//
// 循环次数取 200 次（反复调用 ⇒ 记账类错误会被放大）。

import "inline_modvar_mod.leno"
use inline_modvar_mod.Acc

// 跨模块：调用方在本文件，被调方法 `bump` 属于辅助模块
func benchCross(Acc a, int n): int {
    var total = 0
    for n {
        total = total + a.bump(4)
    }
    return total
}

main() {
    var n = 200

    // ① 同模块：每次 bump(4) 使 _sum += 4，返回 4*S + 10（S 为该次调用前的 _sum）
    //    ⇒ total = Σ_{k=0}^{n-1} (4*(0 + 4k) + 10) = 8n(n-1) + 10n
    assert_eq(inline_modvar_mod.runSame(n), 8 * n * (n - 1) + 10 * n)
    assert_eq(inline_modvar_mod.get_seen(), n)

    // ② 跨模块：期望值由**实测的模块状态**推出，不硬编码
    var s0 = inline_modvar_mod.get_sum()
    var a = inline_modvar_mod.make_acc(1)
    var cross = benchCross(a, n)
    var s1 = inline_modvar_mod.get_sum()
    assert_eq(s1, s0 + 4 * n)                              // 每次 bump 加 4
    assert_eq(cross, 4 * s0 * n + 8 * n * (n - 1) + 10 * n)

    print("test_inline_module_var: OK")
}
