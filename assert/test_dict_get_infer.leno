// 测试 Dict.get 默认值类型推断
// opts.get("x", 0) → int, opts.get("y", 0.0) → float, opts.get("z", true) → bool, opts.get("name", "") → string

main() {
    var opts = {x: 42, y: 3.14, z: true, name: "leno"}

    // === 基本类型推断 ===

    // int 默认值 → 推断返回 int
    int xi = opts.get("x", 0)
    assert_eq(xi, 42)

    // float 默认值 → 推断返回 float
    float yf = opts.get("y", 0.0)
    assert_eq(yf, 3.14)

    // bool 默认值 → 推断返回 bool
    bool zb = opts.get("z", false)
    assert_eq(zb, true)

    // string 默认值 → 推断返回 string
    string ns = opts.get("name", "")
    assert_eq(ns, "leno")

    // === 键不存在时返回默认值 ===

    int missing_int = opts.get("nokey", 99)
    assert_eq(missing_int, 99)

    float missing_float = opts.get("nofloat", 1.5)
    assert_eq(missing_float, 1.5)

    string missing_str = opts.get("nostr", "default")
    assert_eq(missing_str, "default")

    bool missing_bool = opts.get("nobool", false)
    assert_eq(missing_bool, false)

    // === int → float 自动提升 ===

    // int 默认值推断为 int，赋给 float 变量时自动提升
    float xf = opts.get("x", 0)
    assert_eq(xf, 42.0)

    float missing_promote = opts.get("nokey", 0)
    assert_eq(missing_promote, 0.0)

    // === 1 参形态：返回**字典的值类型 V**（v3.2.8 起；此前是 any） ===
    //   为什么值得钉：`int v = d.get("k")` 这种写法**此前编译不过**（实际类型 any，
    //   只能 `var v` 再手动收窄）⇒ 现在与 2 参形态同样精确。
    //   ⚠ 键不存在时运行期返回 null（严格说该是 `V?`）—— 与 2 参形态（返回默认值类型）同一口径。
    Dict[string, int] dint = {"a": 7}
    int v1 = dint.get("a")
    assert_eq(v1, 7)
    Dict[string, string] dstr = {"a": "x"}
    string v2 = dstr.get("a")
    assert_eq(v2, "x")
    Dict[string, float] dfloat = {"a": 1.5}
    float v3 = dfloat.get("a")
    assert_eq(v3, 1.5)
    Dict[string, bool] dbool = {"a": true}
    bool v4 = dbool.get("a")
    assert_eq(v4, true)
    assert_eq(dint.get("nokey"), null)      // 键不存在 ⇒ 运行期 null（静态仍是 V）

    // 值类型本身是 any（混合字典）⇒ 1 参形态仍只能是 any（没有可推的信息）✓ 合理
    var v = opts.get("x")
    assert_eq(v, 42)

    // === Dict[string, any] 外部 dict 场景 ===

    Dict[string, any] data = {x: 42, y: 3.14, name: "leno", active: true}
    var dv1 = data.get("x", 0)
    assert_eq(dv1, 42)
    var dv2 = data.get("y", 0.0)
    assert_eq(dv2, 3.14)
    var dv3 = data.get("name", "")
    assert_eq(dv3, "leno")
    var dv4 = data.get("active", false)
    assert_eq(dv4, true)

    // 混合类型 dict
    var config = {width: 800, height: 600, title: "window"}
    var w = config.get("width", 0)
    var h = config.get("height", 0)
    var t = config.get("title", "")
    assert_eq(w, 800)
    assert_eq(h, 600)
    assert_eq(t, "window")

    print("test_dict_get_infer passed")
}
