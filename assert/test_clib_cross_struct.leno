// 跨模块 clib + struct 字段测试
import "clib_cross_base.leno" as base
use base.core_lib

struct ClibHolder {
    core_lib core = null
    string   name = ""
}

main() {
    // 1. struct 创建和字段访问
    core_lib c = base.loadCore()
    var h = new ClibHolder(core = c, name = "test")
    assert_eq(h.name, "test")
    assert_eq(h.core.abs(-5), 5)

    // 2. 字段重新赋值
    core_lib c2 = base.loadCore()
    h.core = c2
    assert_eq(h.core.abs(-7), 7)

    // 3. struct 数组
    var holders = [
        new ClibHolder(core = base.loadCore(), name = "a"),
        new ClibHolder(core = base.loadCore(), name = "b"),
        new ClibHolder(core = base.loadCore(), name = "c")
    ]
    assert_eq(holders.len(), 3)
    assert_eq(holders[0].core.abs(-11), 11)
    assert_eq(holders[1].core.abs(-13), 13)
    assert_eq(holders[2].core.abs(-17), 17)

    // 4. 遍历 struct 数组调用 clib
    var count = 0
    for holders to item {
        var val = item.core.abs(-1)
        assert_eq(val, 1)
        count = count + 1
    }
    assert_eq(count, 3)
}
