// export alias 别名链测试：B = A，A = int
import "alias_chain_mod.leno" as m

main() {
    // A = int
    A val = 42
    assert_eq(val, 42)

    // B = A = int（别名链解析）
    B val2 = 100
    assert_eq(val2, 100)

    // Size = int
    Size s = 7
    assert_eq(s, 7)

    print("test_export_alias_chain passed")
}
