// 回归测试：「比较 + 条件跳转」融合（T10-①）
//
// codegen 把 `if/while` 条件里的**有序比较**（两侧静态类型都是 int、左操作数是普通
// 局部变量/参数）直接融合成一条 `OP_CMPJMP_*`（8 字节：第二个 4 字节字携带跳转偏移），
// 语义必须与原来的「`*_INT[_IMM]` 比较 + `JMP_IF_FALSE`」**逐条一致**：
//   ① 比较为假 ⇒ 跳转（与 JMP_IF_FALSE 同向）；
//   ② int 快路径只排除 null、不做类型检查（与 *_INT 系列同口径）；
//   ③ 立即数超出 int8（-128..127）/ 右操作数不是简单局部变量 / 两侧不是 int
//      ⇒ 不融合，走原路径，行为不变。
//      ⚠ ⑤-ad（2026-09-24）后只剩"两侧不是 int"这一条会不融合：**非变量形态的左/右操作数**
//      （下标 `a[i]`、算术子表达式 `hi-lo`、全局/upvalue）现在会先求值到临时寄存器再融合，
//      超 int8 的立即数也从"回退三条"变成 `LOADI + CMPJMP` 两条（语义不变）。见下面第 8 组。
//
// 覆盖：四种有序比较的真假两侧、立即数与局部变量两种形式、负立即数与 0 边界、
//       while 循环条件（回跳目标必须是融合指令的起始字）、立即数越界回退、
//       浮点比较（不融合）、以及分支"为假时不得进入"、
//       ⑤-ad 的非变量操作数（下标 vs 变量 / 下标 vs 下标 / 下标 vs 超 int8 立即数 /
//       算术子表达式 / 全局，以及"回边重测下标"的 while）、
//       ⑤-ae 的 `and` 链逐侧融合（第一侧为假时后续侧**不求值**、三侧链、回边、
//       可融合/不可融合混合、以及"第二侧下标不得越界求值"）。
//
// 对照实验：`LENO_NO_CMPJMP=1` 可关掉融合跑同一份断言（两者都必须过）。

var bad = 0
var g_lim = 3    // 第 8 组用：模块级变量读进来是 SYM_GLOBAL（非变量形态的"取值指令"路径）
var g_side2 = 0  // 第 9 组用：`and` 链第二侧的调用计数（验短路：第一侧为假时不得执行）
func chain_false():bool { return false }
func chain_true():bool { return true }
func chain_bump():bool { g_side2 = g_side2 + 1; return true }

func fail(int tag):int {
    print("FAIL case " + tag)
    bad = bad + 1
    return 0
}

main() {
    // ---- 1) 立即数形式：四种比较、真假两侧都要走到 ----
    var n = 5
    var hit = 0
    if n <= 1 { hit = hit + 1 }
    if n <= 5 { hit = hit + 10 } else { hit = hit + 100 }
    if n < 5 { hit = hit + 1000 }
    if n < 6 { hit = hit + 10000 }
    if n >= 5 { hit = hit + 100000 } else { hit = hit + 1000000 }
    if n >= 6 { hit = hit + 10000000 }
    if n > 5 { hit = hit + 100000000 }
    if n > 4 { hit = hit + 1000000000 }
    if hit != 1000110010 { print("hit=" + hit); fail(1) }

    // ---- 2) 0 与负立即数边界 ----
    var z = 0
    var h2 = 0
    if z <= 0 { h2 = h2 + 1 } else { h2 = h2 + 100 }
    if z < 0 { h2 = h2 + 1000 }
    if z >= 0 { h2 = h2 + 10000 } else { h2 = h2 + 100000 }
    if z > -1 { h2 = h2 + 1000000 }
    if h2 != 1010001 { print("h2=" + h2); fail(2) }

    // ---- 3) 局部变量 vs 局部变量（寄存器形式）----
    var lo = 3
    var hi = 7
    var h3 = 0
    if lo < hi { h3 = h3 + 1 } else { h3 = h3 + 100 }
    if hi > lo { h3 = h3 + 10 }
    if hi <= lo { h3 = h3 + 1000 }
    if lo >= hi { h3 = h3 + 10000 }
    if lo <= lo { h3 = h3 + 100000 }
    if h3 != 100011 { print("h3=" + h3); fail(3) }

    // ---- 4) while 循环条件（融合指令占 8 字节，回跳必须落在它的起始字上）----
    var i = 0
    var sum = 0
    while i < 10 {
        sum = sum + i
        i = i + 1
    }
    if sum != 45 { print("sum=" + sum); fail(4) }

    // ---- 5) 立即数超出 int8（±128）：语义不变（⑤-ad 后改走 `LOADI + CMPJMP` 寄存器模式）----
    var big = 300
    var h5 = 0
    if big < 301 { h5 = h5 + 1 } else { h5 = h5 + 100 }
    if big > 299 { h5 = h5 + 10 }
    if big <= 300 { h5 = h5 + 100 }
    if h5 != 111 { print("h5=" + h5); fail(5) }

    // ---- 6) 浮点比较：不融合（类型不是 int），但语义必须正确 ----
    var f = 1.5
    var h6 = 0
    if f < 2.0 { h6 = h6 + 1 } else { h6 = h6 + 100 }
    if f > 1.0 { h6 = h6 + 10 }
    if h6 != 11 { print("h6=" + h6); fail(6) }

    // ---- 7) 参数位置也要融合：函数参数也是"普通局部变量" ----
    if cmp_param(3, 7) != 1 { fail(7) }
    if cmp_param(7, 3) != 0 { fail(7) }

    // ---- 8) ⑤-ad：**非变量形态**的操作数也要融合 ----
    //   `a[i] <= m` 这类原先编成 `INDEX_ARRAY_INT + LE_INT + JMP_IF_FALSE`（3 条），
    //   现在先把下标求值到临时寄存器、再让 CMPJMP 读它（2 条）⇒ 真假两侧都要对。
    Array[int] a = [5, 3, 9, 1]
    var m = 5
    var h8 = 0
    if a[0] <= m { h8 = h8 + 1 } else { h8 = h8 + 100 }              // 下标 vs 变量：真
    if a[1] <= 2 { h8 = h8 + 1000 } else { h8 = h8 + 10000 }         // 假（走 else）
    if a[2] > a[3] { h8 = h8 + 100000 } else { h8 = h8 + 1000000 }   // 下标 vs 下标：真
    if a[3] > a[2] { h8 = h8 + 10000000 }                            // 假（不进体）
    if a[2] < 301 { h8 = h8 + 100000000 }                            // 下标 vs 超 int8 立即数：真
    if hi - lo <= 4 { h8 = h8 + 1000000000 } else { h8 = h8 + 1 }    // 算术子表达式：真（复用第 3 组的 hi/lo）
    if g_lim <= 3 { h8 = h8 + 10000 } else { h8 = h8 + 100 }         // 全局 vs 立即数：真
    // 回边要**重测下标**（分区内层 `while a[i] < pivot` 的形状）：j 每轮都变
    var lim = 9
    var j = 0
    while a[j] < lim { j = j + 1 }
    if j != 2 { print("j=" + j); fail(8) }
    if h8 != 1100120001 { print("h8=" + h8); fail(8) }

    // ---- 9) ⑤-ae：`and` 链条件**逐侧**融合 —— 语义必须与原来的短路求值逐条一致 ----
    //   这是最容易出"静默错值"的地方：融合把"每侧自己的 JMP + 链尾的 JMP"换成了
    //   每侧一条"假则跳"，**求值次数与求值顺序都不能变**。
    var h9 = 0
    // 9a) 第一侧为假 ⇒ 第二侧（有副作用）**不得执行**
    if chain_false() and chain_bump() { h9 = h9 + 1000 }
    if g_side2 != 0 { print("g_side2=" + g_side2); fail(9) }
    // 9b) 两侧都真 ⇒ 第二侧执行
    if chain_true() and chain_bump() { h9 = h9 + 1 }
    if g_side2 != 1 { print("g_side2=" + g_side2); fail(9) }
    // 9c) 三侧链，假在**中段**（第二侧之后不得再求值第三侧）
    if 1 < 2 and chain_false() and chain_bump() { h9 = h9 + 10000 }
    if g_side2 != 1 { print("g_side2=" + g_side2); fail(9) }
    // 9d) while 链（回边也是逐侧融合）：第二侧每轮求值一次，共 3 次（入口 + 2 次回边）
    var n9 = 0
    while n9 < 3 and chain_bump() { n9 = n9 + 1 }
    if n9 != 3 or g_side2 != 4 { print("n9=" + n9 + " g_side2=" + g_side2); fail(9) }
    // 9e) 混合：一侧可融合（下标比较）、一侧不可融合（bool 真值）⇒ 都要走对分支
    Array[int] c9 = [7, 8, 9]
    var ok9 = true
    if c9[1] > 1 and ok9 { h9 = h9 + 100000 }
    if c9[0] > 100 and ok9 { h9 = h9 + 1000000 }          // 第一侧假 ⇒ 不进体
    if h9 != 100001 { print("h9=" + h9); fail(9) }
    // 9f) ★关键：第一侧为假时，第二侧的**下标求值**必须被跳过
    //   （否则 c9[3] 越界 ⇒ 直接报运行期错误；这正是插入排序内层的形状）
    var i9 = 3
    while i9 < 3 and c9[i9] > 0 { i9 = i9 + 1 }
    if i9 != 3 { print("i9=" + i9); fail(9) }

    if bad > 0 {
        print("test_cmpjmp FAILED: " + bad + " 处")
        _exit(1)
    }
    print("test_cmpjmp ok")
}

// 参数是 SYM_PARAM，也应命中融合（与 SYM_LOCAL 同等对待）
func cmp_param(int a, int b):int {
    if a < b { return 1 }
    return 0
}
