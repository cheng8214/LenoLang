// 从模块导入 cfunc 签名并实际使用 ffi.callback
import ffi
import "cfunc_ffi_source.leno" as src
use src.MyCompare

func compare_impl(Ptr a, Ptr b): int {
    int va = ffi.read_int(a, 0)
    int vb = ffi.read_int(b, 0)
    if va < vb { return -1 }
    if va > vb { return 1 }
    return 0
}

main() {
    // 使用跨模块导入的 cfunc 签名创建回调
    var cb = ffi.callback(compare_impl, MyCompare)
    assert(cb != null, "ffi.callback with cross-module cfunc succeeded")
    print("cfunc cross-module ffi.callback test passed")
}
