// 跨模块 use 导入 enum 并验证表达式值正确
import "enum_source.leno" as src
use src.HttpStatus
use src.BitFlags

main() {
    assert_eq(HttpStatus.OK, 200)
    assert_eq(HttpStatus.NOT_FOUND, 404)
    assert_eq(HttpStatus.SERVER_ERROR, 500)
    assert_eq(HttpStatus.CREATED, 201)
    assert_eq(HttpStatus.BAD_REQUEST, 400)
    assert_eq(HttpStatus.INTERNAL_ERROR, 500)

    assert_eq(BitFlags.FLAG_A, 1)
    assert_eq(BitFlags.FLAG_B, 2)
    assert_eq(BitFlags.FLAG_C, 4)
    assert_eq(BitFlags.ALL_FLAGS, 7)

    // 跨模块 enum 位运算
    int combined = BitFlags.FLAG_A | BitFlags.FLAG_C
    assert_eq(combined, 5)

    print("enum cross-module use test passed")
}
