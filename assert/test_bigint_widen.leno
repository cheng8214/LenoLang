// probe_bigint_widen.leno - T26 probe (generated by tools/gen_bigint_probe.ps1, do not edit)
// Each line is a call the whitelist ALLOWS (widening arg). If the runtime error
// complains about the TYPE => latent bug (printed as BUG). Range/IO errors => noise.
import dirs
import maths
import rands
import regexs
import strings
import times

int probe_cnt = 0
int bug_cnt = 0
int noise_cnt = 0

func probe_hit(string tag, string msg) {
    probe_cnt = probe_cnt + 1
    string m = if msg == null then "" else msg
    if strings.has(m, "类型") or strings.has(m, "必须是") or strings.has(m, "期望") {
        bug_cnt = bug_cnt + 1
        print("BUG  " + tag + "  <--  " + m)
    } else {
        noise_cnt = noise_cnt + 1
        print("NOISE  " + tag + "  <--  " + m)
    }
}

main() {
    var _BIG = -99999999999999999999   // negative: saturated value is still negative => range error, not a giant alloc

    try { maths.sqrt(_BIG) } catch e { probe_hit("maths.sqrt[TYPE_FLOAT#0<_BIG>]", e.msg) }
    try { maths.sqrt(true) } catch e { probe_hit("maths.sqrt[TYPE_FLOAT#0<true>]", e.msg) }
    try { maths.abs(_BIG) } catch e { probe_hit("maths.abs[TYPE_FLOAT#0<_BIG>]", e.msg) }
