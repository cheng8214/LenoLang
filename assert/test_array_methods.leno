// 数组方法测试

main()
{
    // 测试数组创建和基本操作
    var arr = [1, 2, 3, 4, 5]
    assert_eq(arr.len(), 5)
    assert_eq(arr[0], 1)
    assert_eq(arr[4], 5)

    // 测试 add
    arr.add(6)
    assert_eq(arr.len(), 6)
    assert_eq(arr[5], 6)

    // 测试 insert
    arr.insert(0, 0)
    assert_eq(arr.len(), 7)
    assert_eq(arr[0], 0)
    assert_eq(arr[1], 1)

    // insert 的负索引是 `pos = len + index + 1`：-1 ⇒ 末尾之后（= append），-2 ⇒ 最后一个之前
    //   ⚠ 与 Python 的 list.insert(-1, x) **差一位**；文档 module_arrays.md 曾把 -1 写成"最后一个之前"✗
    //   这套"越界夹取、不抛错"的口径由 test_semantics_pins.leno 的 P33 钉住
    var ins = [1, 2, 3]
    assert_eq(ins.insert(-1, 4), 4, "insert 返回新长度")
    assert_eq(_str(ins), "[1, 2, 3, 4]", "-1 ⇒ 追加到末尾")
    var ins2 = [1, 2, 3]
    ins2.insert(-2, 9)
    assert_eq(_str(ins2), "[1, 2, 9, 3]", "-2 ⇒ 插到最后一个元素之前")
    var ins3 = [1, 2, 3]
    ins3.insert(-999, 8)
    assert_eq(_str(ins3), "[8, 1, 2, 3]", "负向越界夹到 0")
    var ins4 = [1, 2, 3]
    ins4.insert(999, 7)
    assert_eq(_str(ins4), "[1, 2, 3, 7]", "正向越界夹到末尾")

    // 测试 remove
    var removed = arr.remove(0)
    assert_eq(removed, 0)
    assert_eq(arr.len(), 6)
    assert_eq(arr[0], 1)

    // 测试 has
    assert_eq(arr.has(3), true)
    assert_eq(arr.has(100), false)

    // 测试 pop
    var popped = arr.pop()
    assert_eq(popped, 6)
    assert_eq(arr.len(), 5)

    // 测试 clear
    arr.clear()
    assert_eq(arr.len(), 0)

    // 测试 copy
    var arr2 = [1, 2, 3]
    var arr3 = arr2.copy()
    assert_eq(arr3.len(), 3)
    assert_eq(arr3[0], 1)
    arr3[0] = 100
    assert_eq(arr2[0], 1) // 原数组不应改变

    // 测试多维数组
    var arr2d = [[1, 2], [3, 4], [5, 6]]
    assert_eq(arr2d.len(), 3)
    assert_eq(arr2d[0].len(), 2)
    assert_eq(arr2d[1][1], 4)

    print("test_array_methods passed")
}
