// 解释器与脚本的命令行边界 —— 回归测试（易用性痛点 P2）
//
// 背景（2026-09-18 实测）：`leno.exe trae_sign.leno --list` 会被解释器当成**自己的**未知选项 ⇒
//   打印帮助、**脚本根本不跑** ✗（移植 TraeSign 时几乎静默地卡住；参考件 `trae-checkin.js`
//   的 CLI 全是 `--status/--json/--list`，照抄必踩）。
//
// 修法（与 `_args()` 的取法对齐成**同一条边界**）：
//   · 脚本路径**之后**的 '-' 开头参数 ⇒ 原样交给脚本（`_args()` 能拿到）；
//   · `--` 终止解释器自己的选项解析（其后的第一个参数就是脚本，哪怕它以 '-' 开头）；
//   · 未知旗标写在**脚本路径之前**仍报「未知选项」+ 打印帮助（别把这个提示弄丢）。
//
// 判据：
//   ① 脚本路径之后的旗标必须原样进 `_args()`（修前脚本根本不跑）；
//   ② `--` 终止符之后的参数同样进 `_args()`；
//   ③ 守卫：脚本**之前**的未知旗标仍必须报错（退出码非 0 + 文案含「未知选项」）；
//   ④ 守卫：无参数时照常跑（`_args()` 为空）；
//   ⑤ 与**内置名撞名**的旗标写在脚本之后也归脚本（P2 彻底化，2026-09-26；修前 `-v` 会打印版本、
//      脚本不跑 ✗）；
//   ⑥ 守卫：内置旗标写在脚本**之前**仍归解释器（`-v` 照旧打印版本）—— 口径 = 内置旗标前置。
//   ⑦ **打包版**（2026-10-17 修）：打包产物的命令行里**根本没有脚本路径**（脚本嵌在 exe 里）
//      ⇒ 第一个用户参数不许被当成脚本吃掉，且 `_script()` / `dirs.script_dir()` 要按 **exe 自身**取。
//      修前判据是"第一个非选项参数有没有 `.exe` 后缀"，两处都错 ✗（那个位置在打包版下就是
//      第一个**用户参数**；且 Linux 打包产物没有 .exe 后缀）⇒ 判定恒假、退化成"解释器 + 脚本"
//      切分 ⇒ `app a b -c` 得到 `["b","-c"]`（a 被吃）、`_script()` 返回 'a'、
//      `script_dir()` 跟着 'a' 跑到 CWD ✗（真实症状：LenoQR 的打包版 `gen_png URL out.png`
//      把 out.png 当成要编码的文本 ✓）。

import dirs
import files
import strings

main() {
    var work = dirs.join(_tmpdir(), "leno_cli_script_args")
    dirs.delete(work)
    dirs.mkdir_p(work)

    var echo = dirs.join(work, "echoargs.leno")
    files.write(echo,
        "main() {\n"
        + "    var a = _args()\n"
        + "    print(\"N=\" + a.len())\n"
        + "    for a to v {\n"
        + "        print(\"A=\" + v)\n"
        + "    }\n"
        + "}\n")

    // exe 不能加引号（native_exec 走 `cmd /c <cmd> > tmp 2>&1`，cmd 会剥最外两层引号）；
    // 只给脚本路径加引号（临时目录路径可能含空格）。与 assert/helpers/compiler.leno 同理。
    var exe = _executable()

    // ① 脚本路径之后的旗标 ⇒ 进 _args()
    var r1 = _exec(exe + " \"" + echo + "\" --list status")
    assert_ne(r1, null, "①_exec 返回 null（子进程起不来？）")
    var o1 = _str(r1.output)
    assert_eq(r1.code, 0, "①脚本后带旗标必须照常运行（修前脚本不跑）；输出=" + o1)
    assert_true(strings.has(o1, "N=2"), "①_args() 应有 2 个参数；输出=" + o1)
    assert_true(strings.has(o1, "A=--list"), "①_args() 应含 --list（原样透传）；输出=" + o1)
    assert_true(strings.has(o1, "A=status"), "①_args() 应含 status；输出=" + o1)

    // ② '--' 终止解释器选项解析
    var r2 = _exec(exe + " -- \"" + echo + "\" -x")
    assert_ne(r2, null, "②_exec 返回 null")
    var o2 = _str(r2.output)
    assert_eq(r2.code, 0, "②'--' 之后必须照常运行；输出=" + o2)
    assert_true(strings.has(o2, "A=-x"), "②'--' 之后的 -x 应进 _args()；输出=" + o2)

    // ③ 守卫：脚本之前的未知旗标仍要报错（提示别弄丢）
    var r3 = _exec(exe + " --nope \"" + echo + "\"")
    assert_ne(r3, null, "③_exec 返回 null")
    var o3 = _str(r3.output)
    assert_true(r3.code != 0, "③脚本前的未知旗标必须报错（exit != 0）；输出=" + o3)
    assert_true(strings.has(o3, "未知选项"), "③应提示「未知选项」；输出=" + o3)

    // ④ 守卫：无参数时照常跑，_args() 为空
    var r4 = _exec(exe + " \"" + echo + "\"")
    assert_ne(r4, null, "④_exec 返回 null")
    var o4 = _str(r4.output)
    assert_eq(r4.code, 0, "④无参数应照常运行；输出=" + o4)
    assert_true(strings.has(o4, "N=0"), "④无参数时 _args() 应为空；输出=" + o4)

    // ⑤ 与**内置名撞名**的旗标写在脚本路径之后 ⇒ 同样原样进 _args()（P2 彻底化，2026-09-26）
    //    修前：`… echoargs.leno -v` 会打印解释器版本、**脚本根本不跑** ✗（同类还有 -h/--help/
    //    -c/-p/-o/--debug/--pause/--no-cache…：要么脚本不执行，要么"双重生效"✗）
    var r5 = _exec(exe + " \"" + echo + "\" -v --no-cache")
    assert_ne(r5, null, "⑤_exec 返回 null")
    var o5 = _str(r5.output)
    assert_eq(r5.code, 0, "⑤脚本后的内置同名旗标必须照常运行；输出=" + o5)
    assert_true(strings.has(o5, "N=2"), "⑤_args() 应有 2 个参数；输出=" + o5)
    assert_true(strings.has(o5, "A=-v"), "⑤_args() 应含 -v（不再被解释器吃掉）；输出=" + o5)
    assert_true(strings.has(o5, "A=--no-cache"), "⑤_args() 应含 --no-cache；输出=" + o5)
    assert_true(not strings.has(o5, "LenoLang Compiler"), "⑤不应打印解释器版本（没被当成内置旗标）；输出=" + o5)

    // ⑥ 守卫：内置旗标写在脚本**之前**仍归解释器（口径：内置旗标前置 ✓）
    var r6 = _exec(exe + " -v")
    assert_ne(r6, null, "⑥_exec 返回 null")
    var o6 = _str(r6.output)
    assert_eq(r6.code, 0, "⑥前置 -v 应正常退出；输出=" + o6)
    assert_true(strings.has(o6, "LenoLang Compiler"), "⑥前置 -v 仍必须打印版本；输出=" + o6)

    // ⑦ 打包版：命令行里没有脚本路径 ⇒ 第一个用户参数不许被当脚本吃掉（2026-10-17 修，见文件头）
    //   判据用**关系式**（打包版 _script() 必须 == _executable()、script_dir() 必须 == 它的 dirname），
    //   这样不受 /tmp 软链规范化影响（macOS 的 /tmp → /private/tmp 之类）✓
    //   另一个脚本把这两条关系**自己算一遍**并打印 SELFCHECK ⇒ 断言只看结果，不看路径字面量 ✓
    var dist = dirs.join(work, "dist")
    var paths = dirs.join(work, "paths.leno")
    files.write(paths,
        "import dirs\n"
        + "main() {\n"
        + "    var s = _script()\n"
        + "    var e = _executable()\n"
        + "    print(\"SCRIPT=\" + (if s == null then \"(null)\" else s))\n"
        + "    print(\"DIR=\" + dirs.script_dir())\n"
        + "    print(\"EXE=\" + e)\n"
        + "    var ok = s != null and s == e and dirs.script_dir() == dirs.dirname(e)\n"
        + "    print(\"SELFCHECK=\" + (if ok then \"OK\" else \"FAIL\"))\n"
        + "}\n")

    var packedArgs = dirs.join(dist, "echoargs")
    var packedPaths = dirs.join(dist, "paths")
    if _os() == "windows" { packedArgs = packedArgs + ".exe"; packedPaths = packedPaths + ".exe" }

    var pr1 = _exec(exe + " -p -o \"" + dist + "\" \"" + echo + "\"", 120000)
    assert_ne(pr1, null, "⑦打包 echoargs：_exec 返回 null")
    assert_eq(pr1.code, 0, "⑦打包 echoargs 应成功；输出=" + _str(pr1.output))
    var pr2 = _exec(exe + " -p -o \"" + dist + "\" \"" + paths + "\"", 120000)
    assert_ne(pr2, null, "⑦打包 paths：_exec 返回 null")
    assert_eq(pr2.code, 0, "⑦打包 paths 应成功；输出=" + _str(pr2.output))
    assert_true(files.exists(packedArgs), "⑦打包产物应存在：" + packedArgs)

    var r7 = _exec(packedArgs + " a b -c")
    assert_ne(r7, null, "⑦_exec 返回 null")
    var o7 = _str(r7.output)
    assert_eq(r7.code, 0, "⑦打包版应正常退出；输出=" + o7)
    assert_true(strings.has(o7, "N=3"), "★⑦第一个用户参数不许被吃掉（修前 N=2）；输出=" + o7)
    assert_true(strings.has(o7, "A=a"), "★⑦_args() 应含第一个参数 a（修前被当脚本吃掉）；输出=" + o7)
    assert_true(strings.has(o7, "A=b"), "⑦_args() 应含 b；输出=" + o7)
    assert_true(strings.has(o7, "A=-c"), "⑦_args() 应含 -c；输出=" + o7)

    // 带一个参数跑：修前 `_script()` 会返回这个参数、`script_dir()` 会跟着它跑到 CWD ⇒ 双红 ✓
    var r8 = _exec(packedPaths + " x")
    assert_ne(r8, null, "⑦_exec 返回 null")
    var o8 = _str(r8.output)
    assert_eq(r8.code, 0, "⑦打包版 paths 应正常退出；输出=" + o8)
    assert_true(strings.has(o8, "SELFCHECK=OK"),
        "★⑦打包版 _script()/_script_dir() 必须按 exe 自身取（修前会取到用户参数 'x' 及其 CWD）；输出=" + o8)
    assert_true(strings.has(o8, "SCRIPT=" + packedPaths),
        "★⑦_script() 应等于 exe 自身路径；输出=" + o8)
    assert_true(strings.has(o8, "DIR=" + dirs.dirname(packedPaths)),
        "★⑦script_dir() 应为 exe 所在目录；输出=" + o8)

    dirs.delete(work)
    print("test_cli_script_args passed")
}
