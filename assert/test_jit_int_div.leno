// 回归测试：JIT 的 OP_DIV_INT 必须产出 int48（与解释器 val_int(a / b) 一致）
//
// 背景：JIT 旧实现把 int/int 的商 CVTSI2SD 成 double 压栈，而解释器
// （vm/vminc/op_type_specialized.inc:119）压的是 val_int(a / b)。
// 后果：紧随其后的 % 会拿 double 的位模式做整数 idiv →
// examples/排序测试/更多排序.leno 的基数排序 digit 全错、排错并报「数组索引越界」。
//
// 另：OP_DIV_INT / OP_MOD_INT 原先直接 idiv，除数为 0 会 #DE 崩进程，
// 而解释器是抛「整数/取模除零错误」—— 这里一并回归「必须可捕获、不许崩」。
//
// 循环次数需超过 JIT 热点阈值（JIT_HOT_THRESHOLD = 50）才会触发 JIT 编译。

var EXP = 1

// (arr[i] / EXP) % 10：基数排序里取当前位的写法
func digitsOf(Array[int] arr): string {
    var s = ""
    for 0 : arr.len() - 1 to var i {
        var d = (arr[i] / EXP) % 10
        s = s + _str(d)
    }
    return s
}

// int/int 的「向零截断」语义 + 商必须是整数
// （不用 `is int`：OP_IS 不在 scan 支持列表内，会让整个循环被拒绝编译，
//   那样就测不到 JIT 路径了 —— 用「整除结果再取模」代替，商若被当成 double
//   这一步会算出垃圾值，同样能抓到。）
func divSemantics(): int {
    var bad = 0
    for 0 : 300 to var k {
        var a = k * 7
        var q = a / 3
        var r = a - q * 3
        if r < 0 { r = 0 - r }
        if r >= 3 { bad = bad + 1 }     // 向零截断 ⇒ |余| < |除数|
        var m = (a / 3) % 4             // a >= 0 ⇒ m 必须落在 [0,3]
        if m < 0 or m > 3 { bad = bad + 1 }
    }
    return bad
}

// 热循环内除零/模零：必须抛出可捕获的错误（不是 #DE 崩进程）
func divZeroCaught(): int {
    var caught = 0
    for 0 : 60 to var k {
        try {
            var z = k - k
            var a = 100 / z
            a = a + 1
        } catch e {
            caught = caught + 1
        }
        try {
            var z2 = k - k
            var b = 100 % z2
            b = b + 1
        } catch e2 {
            caught = caught + 1
        }
    }
    return caught
}

main() {
    var bad = 0

    // 0) 类型契约：int / int 结果是 int（不是 float）
    var q0 = 100 / 3
    if not (q0 is int) {
        bad = bad + 1
        print("100/3 不是 int")
    }

    // 1) 取位串必须与解释器逐字符一致
    //    （多跑几轮让该循环达到热点阈值，确保覆盖 JIT 路径）
    var arr = []
    for 0 : 39 to var i { arr.add(i) }
    var got = ""
    for 0 : 5 to var k { got = digitsOf(arr) }
    var want = "0123456789012345678901234567890123456789"
    if got != want {
        bad = bad + 1
        print("digit 串错误: [" + got + "]")
    }

    // 2) int/int 结果类型 + 截断语义
    var d1 = divSemantics()
    if d1 != 0 {
        bad = bad + 1
        print("int/int 语义错误: " + _str(d1) + " 处")
    }

    // 3) 浮点除法不受影响（10.0/4.0 = 2.5，301 次 = 752.5）
    var fs = 0.0
    for 0 : 300 to var k { fs = fs + 10.0 / 4.0 }
    if fs < 752.0 or fs > 753.0 {
        bad = bad + 1
        print("浮点除法异常: " + _str(fs))
    }

    // 4) 除零/模零必须可捕获（61 轮 × 2 = 122）
    var caught = divZeroCaught()
    if caught != 122 {
        bad = bad + 1
        print("除零未按预期抛错: " + _str(caught) + " (期望 122)")
    }

    if bad > 0 {
        print("JIT 整除语义错误: " + _str(bad) + " 项")
        _exit(1)
    }
    print("test_jit_int_div ok")
}
