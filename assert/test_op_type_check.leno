// OP_TYPE_CHECK 回归（§8.65）
//
// `is` 编译出 OP_TYPE_CHECK（同时 `switch ... case is T` 也走它 —— 这正是
// file_manager 里 ×16 的来源，事件分发全是 case is）。
// 判定一律走 VM 的 type_check_value（语义唯一来源）：
//   编译期解出 type_kind / elem_type / name_const → 运行时判定 → 压 bool。
// v3.2.2 起**泛型实参带约束**的形态改走 OP_TYPE_CHECK_SPEC / OP_AS_CAST_SPEC：
//   指令尾随一棵**递归类型规格**，判定走 vm.c 的 type_spec_match（与紧凑路径共用叶子口径）。
//
// 覆盖：
//   1. struct 名字判定（含**反例**，确认不是恒真）
//   2. face 变量上的判定（TYPE_FACE + face_def_find + struct_implements_face）
//   3. switch case is（真实程序里的高频形态）
//   4. 无类型值（dict）上的基本类型判定（+ 反例）
//   5. enum 判定 —— TYPE_ENUM 也读 2 字节名字常量，顺带守住刚修的 opcode_size
//   6. Dict[K,V] 的**逐键值**校验 —— 修复前 K/V 完全不校验（`{"a":1} is Dict[string,string]` 为 true）
//   7. `as` 与 `is` 同口径（不匹配 ⇒ null）
//   8. `=>` 收窄绑定按真实键值类型分流
//   9. Array/Dict 的**递归**规格（`Array[Array[Array[int]]]`、`Dict[string,Array[int]]`）
//  10. 嵌套位置的**名字**校验（`Array[Point]` / `Array[Shape]` / `Dict[string,Point]` / `Array[Color]`）
//  11. 防无限递归（自引用容器）+ 嵌套深度上限 + Ptr[T]

struct Point { int x = 0; int y = 0 }

face Shape { func area():float }

struct Rect impl Shape {
    float w = 0.0
    float h = 0.0
    func area():float { return self.w * self.h }
}

enum Color { red; green; blue }

main() {
    // ---- 1) struct / face 名字判定（含反例）----
    Shape s = new Rect(w = 2.0, h = 3.0)
    int yes = 0
    int no = 0
    int i = 0
    while i < 3000 {
        if s is Rect { yes = yes + 1 }
        if s is Point { no = no + 1 }
        i = i + 1
    }
    assert_eq(yes, 3000)
    assert_eq(no, 0)

    // ---- 2) switch case is ----
    int h2 = 0
    int j = 0
    while j < 3000 {
        switch s {
            case is Rect { h2 = h2 + 1 }
            default { }
        }
        j = j + 1
    }
    assert_eq(h2, 3000)

    // ---- 3) 无类型值（dict）的基本类型判定（含反例）----
    var d = {"k": 5}
    int h3 = 0
    int h4 = 0
    int k = 0
    while k < 3000 {
        if d["k"] is int { h3 = h3 + 1 }
        if d["k"] is string { h4 = h4 + 1 }
        k = k + 1
    }
    assert_eq(h3, 3000)
    assert_eq(h4, 0)

    // ---- 4) enum 判定（顺带守住 TYPE_ENUM 的 4 字节长度）----
    var c = Color
    int h5 = 0
    int m = 0
    while m < 3000 {
        if c is Color { h5 = h5 + 1 }
        m = m + 1
    }
    assert_eq(h5, 3000)

    // ---- 5) Dict[K,V] 逐键值校验（修复：此前 K/V 完全不校验）----
    var d_ss = {"a": "1", "b": "2"}
    assert(d_ss is Dict[string, string], "值全是 string ⇒ 匹配 Dict[string,string]")
    var d_si = {"a": 1}
    assert(not (d_si is Dict[string, string]), "值是 int ⇒ 不得匹配 Dict[string,string]")
    assert(d_si is Dict[string, int], "值是 int ⇒ 匹配 Dict[string,int]")
    var d_null = {"a": null}
    assert(not (d_null is Dict[string, string]), "值是 null ⇒ 不得匹配 Dict[string,string]")
    var d_obj = {"a": {"b": 1}}
    assert(not (d_obj is Dict[string, string]), "值是嵌套对象 ⇒ 不得匹配 Dict[string,string]")
    var d_empty = {}
    assert(d_empty is Dict[string, string], "空字典 ⇒ 恒匹配（无元素可违反）")
    // V = any ⇒ 该侧不校验（旧行为必须保持）
    assert(d_si is Dict[string, any], "Dict[string,any] 的 V 不校验 ⇒ 仍匹配")
    assert(d_null is Dict[string, any], "Dict[string,any] 的 V 不校验 ⇒ null 值也匹配")
    // 键侧同样校验
    Dict[int, string] d_is = {1: "a", 2: "b"}
    assert(not (d_is is Dict[string, string]), "键是 int ⇒ 不得匹配 Dict[string,string]")
    assert(d_is is Dict[int, string], "键=int/值=string ⇒ 匹配 Dict[int,string]")
    // 非字典值
    assert(not ([1, 2] is Dict[string, string]), "数组不是字典")
    assert(not ("hi" is Dict[string, string]), "字符串不是字典")

    // ---- 6) as Dict[K,V]：不匹配 ⇒ null（与 is 同口径）----
    var c_ok = d_ss as Dict[string, string]
    assert(c_ok != null, "匹配 ⇒ 返回原字典")
    var c_bad = d_si as Dict[string, string]
    assert(c_bad == null, "不匹配 ⇒ null")
    var c_any = d_si as Dict[string, any]
    assert(c_any != null, "V = any ⇒ 仍匹配")

    // ---- 7) => 收窄绑定按真实键值类型分流 ----
    int got = 0
    if d_si is Dict[string, string] => x {
        got = 1
    } else {
        got = 2
    }
    assert_eq(got, 2)
    if d_ss is Dict[string, string] => y {
        got = y.keys().len()
    }
    assert_eq(got, 2)

    // ---- 8) Array[T] 的容器种类同样收紧（共用 value_matches_kind）----
    var aa = [[1, 2], [3]]
    assert(aa is Array[Array[int]], "元素都是数组 ⇒ 匹配 Array[Array[int]]")
    var ab = [[1, 2], 5]
    assert(not (ab is Array[Array[int]]), "混入非数组元素 ⇒ 不得匹配（修复前放行）")

    // ---- 9) 递归规格：Array/Dict 的实参递归到底（v3.2.2）----
    var a3 = [[[1]]]
    assert(a3 is Array[Array[Array[int]]], "三层嵌套且全是 int ⇒ 匹配")
    var a3b = [[["x"]]]
    assert(not (a3b is Array[Array[Array[int]]]), "最内层是 string ⇒ 不得匹配")
    var mv1 = {"a": [1, 2]}
    assert(mv1 is Dict[string, Array[int]], "值是真数组 ⇒ 匹配 Dict[string,Array[int]]")
    var mv2 = {"a": [1, "x"]}
    assert(not (mv2 is Dict[string, Array[int]]), "值数组里混入 string ⇒ 不得匹配")
    var mv3 = {"a": 5}
    assert(not (mv3 is Dict[string, Array[int]]), "值根本不是数组 ⇒ 不得匹配")

    // ---- 10) 嵌套位置的**名字**校验（struct / face / enum）----
    var points = [new Point(x = 1, y = 2)]
    assert(points is Array[Point], "元素都是 Point ⇒ 匹配 Array[Point]")
    var mixed = [new Point(x = 1, y = 2), 5]
    assert(not (mixed is Array[Point]), "混入非 struct ⇒ 不得匹配")
    var rects = [new Rect(w = 2.0, h = 3.0)]
    assert(rects is Array[Shape], "Rect impl Shape ⇒ 匹配 Array[Shape]")
    assert(not (rects is Array[Point]), "Rect 不是 Point ⇒ 不得匹配")
    var pdict = {"p": new Point(x = 1, y = 2)}
    assert(pdict is Dict[string, Point], "值是 Point ⇒ 匹配 Dict[string,Point]")
    var pdict2 = {"p": 3}
    assert(not (pdict2 is Dict[string, Point]), "值不是 struct ⇒ 不得匹配")
    // 枚举成员在运行期就是 int ⇒ Array[Color] 只要求"是 int"（语言本身不区分是哪个 enum）
    var colors = [0, 1, 2]
    assert(colors is Array[Color], "枚举成员是 int ⇒ 放行")

    // ---- 11) 防无限递归 / 深度上限 / Ptr ----
    var self_arr = []
    self_arr.add(self_arr)
    assert(not (self_arr is Array[Array[int]]), "自引用容器 ⇒ fail-closed（且不得崩）")
    assert(self_arr is Array, "顶层判定不受影响")
    var deep = []
    var di = 0
    while di < 40 {
        deep = [deep]
        di = di + 1
    }
    assert(not (deep is Array[Array[int]]), "40 层 > 深度上限 ⇒ fail-closed")
    assert(deep is Array, "顶层判定不受影响")
    assert(not (null is Ptr[u8]), "null 不是 FFI 指针")
    assert(not (d_ss is Ptr[u8]), "Dict 不是 FFI 指针")

    print("test_op_type_check: OK")
}
