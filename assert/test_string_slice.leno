// 字符串切片测试 — 覆盖 str[start:end], str[:end], str[start:]
// 结束索引为包含（与数组切片一致），索引为 UTF-8 字符级

main() {
    var s = "Hello,World"

    // 测试1: 基本切片 str[start:end]（包含 end）
    var s1 = s[0:4]
    assert_eq(s1, "Hello")       // 索引 0,1,2,3,4 = H,e,l,l,o
    print("[PASS] 测试1: 基本切片 s[0:4]")

    // 测试2: 中间切片
    var s2 = s[6:10]
    assert_eq(s2, "World")       // 索引 6,7,8,9,10 = W,o,r,l,d
    print("[PASS] 测试2: 中间切片 s[6:10]")

    // 测试3: 从开头切片 str[:end]
    var s3 = s[:4]
    assert_eq(s3, "Hello")
    print("[PASS] 测试3: 从开头切片 s[:4]")

    // 测试4: 到末尾切片 str[start:]
    var s4 = s[6:]
    assert_eq(s4, "World")
    print("[PASS] 测试4: 到末尾切片 s[6:]")

    // 测试5: 单字符切片 str[i:i]
    var s5 = s[0:0]
    assert_eq(s5, "H")
    print("[PASS] 测试5: 单字符切片 s[0:0]")

    // 测试6: 完整切片（等于复制）
    var s6 = s[0:10]
    assert_eq(s6, "Hello,World")
    print("[PASS] 测试6: 完整切片 s[0:10]")

    // 测试7: end 越界自动截断
    var s7 = s[0:100]
    assert_eq(s7, "Hello,World")
    print("[PASS] 测试7: end越界截断 s[0:100]")

    // 测试8: start 越界返回空字符串
    var s8 = s[100:200]
    assert_eq(s8, "")
    print("[PASS] 测试8: start越界返回空串 s[100:200]")

    // 测试9: UTF-8 中文切片
    var cn = "你好，世界"
    assert_eq(cn[0:1], "你好")       // 字符索引 0,1
    assert_eq(cn[0:2], "你好，")     // 字符索引 0,1,2
    assert_eq(cn[3:4], "世界")       // 字符索引 3,4
    assert_eq(cn[3:], "世界")        // 从索引3到末尾
    assert_eq(cn[:2], "你好，")      // 从开头到索引2
    print("[PASS] 测试9: UTF-8中文切片")

    // 测试10: 中英混合字符串切片
    var mix = "Hi你好"
    assert_eq(mix[0:1], "Hi")       // 字符索引 0,1 = H,i
    assert_eq(mix[2:3], "你好")     // 字符索引 2,3 = 你,好
    assert_eq(mix[2:], "你好")
    assert_eq(mix[:1], "Hi")
    print("[PASS] 测试10: 中英混合切片")

    // 测试11: 切片不修改原字符串
    var orig = "abcdef"
    var sliced = orig[1:3]
    assert_eq(orig, "abcdef")
    assert_eq(sliced, "bcd")
    print("[PASS] 测试11: 切片不修改原字符串")

    // 测试12: 空字符串切片
    var empty = ""
    assert_eq(empty[0:0], "")
    assert_eq(empty[0:], "")
    print("[PASS] 测试12: 空字符串切片")

    // ================= 口径哨兵（★ 2026-10-10） =================
    // 方法 `slice`/`byte_slice` 已从"左闭右开"统一成**闭区间**，与上面的语法 `s[a:b]` 同一口径。
    // 下面这些是**故意的行为契约**：改语言语义前先看这里（口径再分家会静默错，别靠记忆）。
    assert_eq("abcde".slice(1, 3), "bcd")                 // 闭区间：含 end（语法 s[1:3] 也是 "bcd"）
    assert_eq("abcde".slice(1, 4), "bcde")
    assert_eq("abcde".slice(0, 0), "a")                   // 单字符
    assert_eq("abcde".slice(0, 99), "abcde")              // end 超界 ⇒ 钳到末位
    assert_eq("abcde".slice(0, "abcde".len()), "abcde")   // "到末尾"写 .len() 仍然成立（靠钳位）
    assert_eq("abcde".slice(4, 3), "")                    // start > end ⇒ 空串
    assert_eq("abcde".slice(-2, 4), "de")                 // 负起点：从末尾数
    assert_eq("abcde".slice(1, -1), "")                   // **负终点 ⇒ 空串**（有意，见 module_strings.md）
    assert_eq("你好世界".slice(0, 1), "你好")              // 按 Unicode 字符
    assert_eq("abcde".byte_slice(0, 2), "abc")            // 字节级同口径
    assert_eq("abcde".byte_slice(0, -1), "")              // 负终点同样给空串
    print("[PASS] 测试13: 口径哨兵（slice/byte_slice = 闭区间）")

    print("test_string_slice all passed")
}
