// 数字分隔符 `1_000_000`（B3，2026-11-02）
//
// `_` 只允许出现在**两个数字之间**：`1_`、`1__0`、`0x_FF` 都不是合法字面量
// （`1_` 会被切成 `1` + 标识符 `_` ⇒ 报「同一行出现标识符」）；`_1` 本来就是标识符，不受影响。
// 实现要点：token 的 text/len 保留原文（诊断/高亮要看原样），但做数值转换前**去掉下划线** ——
// strtod / strtoull 会在 `_` 处停下，否则 `1_000` 会被静默读成 1。

main() {
    // ① 十进制
    assert_eq(1_000_000, 1000000, "1_000_000")
    assert_eq(3_600_000, 3600000, "3_600_000 毫秒常量")

    // ② 十六进制 / 二进制
    assert_eq(0xFF_FF, 65535, "0xFF_FF")
    assert_eq(0b1010_1010, 170, "0b1010_1010")

    // ③ 浮点与科学计数法
    assert_eq(1_000.5, 1000.5, "1_000.5")
    assert_eq(1_0e3, 10000.0, "1_0e3")
    assert_eq(1_0.5e2, 1050.0, "1_0.5e2")

    // ④ 与不带分隔符的写法完全等值
    assert_eq(1_000, 1000, "十进制等值")
    assert_eq(0xFF_FF, 0xFFFF, "十六进制等值")
    assert_eq(1_0e3, 1e4, "科学计数等值")

    // ⑤ bigint 路径（超过 int48）也要认
    int big = 1_000_000_000_000_000
    assert_eq(big, 1000000000000000, "bigint 路径")
    assert_eq(big > 999999999999999, true, "bigint 比较")

    // ⑥ `_1` 仍是合法标识符（以下划线开头的名字）
    int _1 = 42
    assert_eq(_1, 42, "_1 是标识符，不是数字")

    print("test_number_separator all passed")
}
