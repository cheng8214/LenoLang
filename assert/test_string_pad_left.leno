// test_string_pad_left.leno —— strings.pad_left（2026-11-09）
//
// 背景：四个项目各抄了一份 `pad2`（LenoMusic ×3 + LenoTrae ×1），实现逐字相同，
//   其中一份注释写着"两处各一份，改动要一起改 ⚠" —— 缺一个通用原语的典型后果。
//   `pad2(v)` 只是 `pad_left(_str(v), 2, "0")` 的一个用法。
import strings

main() {
    // ① 补零：等价于那四份 pad2
    assert_eq(strings.pad_left("7", 2, "0"), "07", "补零到 2 位")
    assert_eq(strings.pad_left("0", 3, "0"), "000", "补零到 3 位")
    assert_eq(strings.pad_left("12", 2, "0"), "12", "已够宽 ⇒ 原样（不截断）")
    assert_eq(strings.pad_left("123", 2, "0"), "123", "超出宽度 ⇒ 不截断")

    // ② 其它填充字符
    assert_eq(strings.pad_left("abc", 6, " "), "   abc", "补空格")
    assert_eq(strings.pad_left("x", 4, "-"), "---x", "补短横")

    // ③ 中文按**字符**算（不是字节）—— "你好" 是 2 个字符，补到 4 加 2 个
    assert_eq(strings.pad_left("你好", 4, "*"), "**你好", "中文按字符计数")
    assert_eq(strings.pad_left("你好", 2, "*"), "你好", "中文已够宽")

    // ④ fill 多字符只取首个（不重复整串）
    assert_eq(strings.pad_left("a", 3, "xy"), "xxa", "fill 取首字符")

    // ⑤ 空串
    assert_eq(strings.pad_left("", 3, "0"), "000", "空串补宽")

    // ⑥ 宽度 0 / 负数 ⇒ 原样
    assert_eq(strings.pad_left("abc", 0, "0"), "abc", "宽度 0")
    assert_eq(strings.pad_left("abc", -5, "0"), "abc", "宽度为负")

    // ⑦ 真实用法：mm:ss
    int m = 5
    int s = 7
    string t = strings.pad_left(_str(m), 2, "0") + ":" + strings.pad_left(_str(s), 2, "0")
    assert_eq(t, "05:07", "时间格式化")

    // ⑧ 类型检查不能放松
    //    （写在临时文件里用 --check 验，这里只用编译期能过的方式验证返回值类型）
    string r = strings.pad_left("1", 2, "0")
    assert_true(r is string, "返回类型是 string")

    print("test_string_pad_left passed")
}
