// defer 语句回归测试

var log = []

func add(string s) {
    log.add(s)
}

main()
{
    // 测试1: 基本 defer 执行 + 逆序
    log = []
    {
        add("a")
        defer add("defer-1")
        add("b")
        defer add("defer-2")
    }
    assert_eq(log.len(), 4)
    assert_eq(log[0], "a")
    assert_eq(log[1], "b")
    assert_eq(log[2], "defer-2")
    assert_eq(log[3], "defer-1")

    // 测试2: defer 在异常时执行
    log = []
    try {
        defer add("cleanup")
        throw "error"
    } catch e {
        add("caught")
    }
    assert_eq(log[0], "cleanup")
    assert_eq(log[1], "caught")

    // 测试3: defer 在函数返回时执行
    func do_work() {
        add("working")
        defer add("cleanup")
        return
    }
    log = []
    do_work()
    assert_eq(log[0], "working")
    assert_eq(log[1], "cleanup")

    // 测试4: defer 在函数返回值之后执行
    func compute() {
        defer add("defer")
        add("compute")
        return 42
    }
    log = []
    var result = compute()
    assert_eq(result, 42)
    assert_eq(log[0], "compute")
    assert_eq(log[1], "defer")

    // 测试5: 无 defer 时不影响正常逻辑
    log = []
    {
        add("x")
        add("y")
    }
    assert_eq(log.len(), 2)

    // 测试6: defer 在 if 块中
    log = []
    var x = 10
    if x > 5 {
        defer add("defer-if")
        add("in-if")
    }
    add("after-if")
    assert_eq(log[0], "in-if")
    assert_eq(log[1], "defer-if")
    assert_eq(log[2], "after-if")

    // 测试7: defer + break 在 for 循环中
    // 使用数组记录避免内联函数干扰
    log = []
    for 0:3 to i {
        defer add("defer")
        add("iter")
        if i == 1 {
            add("breaking")
            break
        }
    }
    add("after")
    assert_eq(log[0], "iter")
    assert_eq(log[1], "defer")
    assert_eq(log[2], "iter")
    assert_eq(log[3], "breaking")
    assert_eq(log[4], "defer")
    assert_eq(log[5], "after")

    // 测试8: defer + continue 在 for 循环中
    log = []
    for 0:3 to i {
        defer add("defer")
        add("iter")
        if i == 1 {
            add("continuing")
            continue
        }
        add("after-if")
    }
    add("after")
    assert_eq(log[0], "iter")
    assert_eq(log[1], "after-if")
    assert_eq(log[2], "defer")
    assert_eq(log[3], "iter")
    assert_eq(log[4], "continuing")
    assert_eq(log[5], "defer")
    assert_eq(log[6], "iter")
    assert_eq(log[7], "after-if")
    assert_eq(log[8], "defer")

    // 测试9: defer + break 在 while 循环中
    log = []
    var j = 0
    while j < 3 {
        defer add("defer")
        add("iter")
        if j == 1 {
            add("breaking")
            break
        }
        j = j + 1
    }
    add("after")
    assert_eq(log[0], "iter")
    assert_eq(log[1], "defer")
    assert_eq(log[2], "iter")
    assert_eq(log[3], "breaking")
    assert_eq(log[4], "defer")
    assert_eq(log[5], "after")

    // 测试10: 嵌套块的 defer 执行顺序
    log = []
    {
        defer add("outer-defer")
        add("outer-start")
        {
            defer add("inner-defer")
            add("inner-start")
            add("inner-end")
        }
        add("outer-end")
    }
    assert_eq(log[0], "outer-start")
    assert_eq(log[1], "inner-start")
    assert_eq(log[2], "inner-end")
    assert_eq(log[3], "inner-defer")
    assert_eq(log[4], "outer-end")
    assert_eq(log[5], "outer-defer")

    // 测试11: defer 在 for 循环中（无 break）
    log = []
    for 0:2 to i {
        defer add("defer")
        add("iter")
    }
    add("done")
    assert_eq(log[0], "iter")
    assert_eq(log[1], "defer")
    assert_eq(log[2], "iter")
    assert_eq(log[3], "defer")
    assert_eq(log[4], "iter")
    assert_eq(log[5], "defer")
    assert_eq(log[6], "done")

    print("test_defer passed")
}
