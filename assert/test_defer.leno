// defer 语句回归测试
// 测试 defer 在正常退出、异常退出、函数返回时的行为

var log = []

func add(string s) {
    log.add(s)
}

main()
{
    // 测试1: 基本 defer 执行 + 逆序
    log = []
    {
        add("a")
        defer add("defer-1")
        add("b")
        defer add("defer-2")
    }
    assert_eq(log.len(), 4)
    assert_eq(log[0], "a")
    assert_eq(log[1], "b")
    assert_eq(log[2], "defer-2")
    assert_eq(log[3], "defer-1")

    // 测试2: defer 在异常时执行
    log = []
    try {
        defer add("cleanup")
        throw "error"
    } catch e {
        add("caught")
    }
    assert_eq(log[0], "cleanup")
    assert_eq(log[1], "caught")

    // 测试3: defer 在函数返回时执行
    func do_work() {
        add("working")
        defer add("cleanup")
        return
    }
    log = []
    do_work()
    assert_eq(log[0], "working")
    assert_eq(log[1], "cleanup")

    // 测试4: defer 在函数返回值之后执行
    func compute() {
        defer add("defer")
        add("compute")
        return 42
    }
    log = []
    var result = compute()
    assert_eq(result, 42)
    assert_eq(log[0], "compute")
    assert_eq(log[1], "defer")

    // 测试5: 无 defer 时不影响正常逻辑
    log = []
    {
        add("x")
        add("y")
    }
    assert_eq(log.len(), 2)

    // 测试6: defer 在 if 块中
    log = []
    var x = 10
    if x > 5 {
        defer add("defer-if")
        add("in-if")
    }
    add("after-if")
    assert_eq(log[0], "in-if")
    assert_eq(log[1], "defer-if")
    assert_eq(log[2], "after-if")

    print("test_defer passed")
}
