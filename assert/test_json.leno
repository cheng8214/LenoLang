// JSON 模块测试

import jsons
import files
import dirs

main()
{
    // 测试1: decode 基本类型
    var str1 = jsons.decode("\"hello\"")
    assert_eq(str1, "hello")

    var num1 = jsons.decode("42")
    assert_eq(num1, 42)

    var num2 = jsons.decode("3.14")
    assert_eq(num2, 3.14)

    var bool1 = jsons.decode("true")
    assert_eq(bool1, true)

    var bool2 = jsons.decode("false")
    assert_eq(bool2, false)

    var null1 = jsons.decode("null")
    assert_eq(null1, null)

    // 测试2: decode 数组
    var arr1 = jsons.decode("[1, 2, 3]")
    if arr1 is Array
    {
    assert_eq(arr1.len(), 3)
    assert_eq(arr1[0], 1)
    assert_eq(arr1[1], 2)
    assert_eq(arr1[2], 3)
    }

    // 测试3: decode 对象
    var obj1 = jsons.decode("{\"name\": \"Leno\", \"version\": 1.0}")
    // jsons.decode 返回 any，需先用 is Dict 收窄才能访问字段
    if obj1 is Dict {
        assert_eq(obj1.name, "Leno")
        assert_eq(obj1.version, 1.0)
    }

    // 测试4: decode 嵌套对象
    var obj2 = jsons.decode("{\"user\": {\"id\": 1, \"name\": \"张三\"}, \"active\": true}")
    if obj2 is Dict {
        var user = obj2.user
        if user is Dict {
            assert_eq(user.name, "张三")
            assert_eq(user.id, 1)
        }
        assert_eq(obj2.active, true)
    }

    // 测试5: encode
    var test_obj = {
        name: "测试",
        count: 42,
        valid: true
    }
    var encoded = jsons.encode(test_obj)
    assert_eq(encoded.has("\"name\":\"测试\""), true)
    assert_eq(encoded.has("\"count\":42"), true)
    assert_eq(encoded.has("\"valid\":true"), true)

    // 测试6: 空对象和空数组
    var empty_obj = jsons.decode("{}")
    assert_eq(type(empty_obj), "Dict")

    var empty_arr = jsons.decode("[]")
    if empty_arr is Array
    {
    assert_eq(empty_arr.len(), 0)
    }

    // 测试7: T21 类型化取值助手（any 收窄收进标准库 ⇒ 调用点零样板 ✓）
    var acc = jsons.decode("{\"token\": \"abc\", \"credits\": 150, \"ratio\": 0.5, \"ok\": true, \"nested\": {\"user\": \"张三\"}, \"list\": [1, 2]}")
    assert_eq(jsons.get_str(acc, "token", ""), "abc")
    assert_eq(jsons.get_str(acc, "missing", "缺省"), "缺省")            // 缺键 ⇒ 默认值
    assert_eq(jsons.get_str(acc, "credits", ""), "150")                 // 数字也能取成字符串（打印口径 ✓）
    assert_eq(jsons.get_int(acc, "credits", -1), 150)
    assert_eq(jsons.get_int(acc, "token", -1), -1)                      // 字符串不是数字 ⇒ 默认值
    assert_eq(jsons.get_int(acc, "missing", -1), -1)
    assert_eq(jsons.get_float(acc, "ratio", 0.0), 0.5)
    assert_eq(jsons.get_float(acc, "credits", 0.0), 150.0)              // int ⇒ float ✓
    assert_eq(jsons.get_bool(acc, "ok", false), true)
    assert_eq(jsons.get_bool(acc, "missing", false), false)
    assert_eq(jsons.get_str(jsons.get_obj(acc, "nested"), "user", ""), "张三")  // 嵌套：get_obj 钻下去
    assert_eq(jsons.get_str(acc, "list", "不是标量"), "不是标量")        // 容器不参与转换 ⇒ 默认值
    assert_eq(jsons.get_obj(acc, "missing"), null)                      // 非字典/缺键 ⇒ null
    var ks = jsons.keys(acc)
    assert_eq(ks.len(), 6)                                              // 插入序 ✓
    assert_eq(ks[0], "token")
    assert_eq(jsons.keys("不是字典").len(), 0)                           // 非字典 ⇒ 空数组
    assert_eq(jsons.get_str("不是字典", "k", "d"), "d")                   // 非字典 ⇒ 默认值

    // 测试8: write_text 原样写（write_file 会把入参再编码一次 ⇒ 写"已编码文本"必须用它 ✓）
    // `_tmpdir()` 的尾部分隔符依平台而异（Windows 带 `\`、POSIX 无）⇒ 必须经 dirs.join 拼，
//   直接字符串相加在 POSIX 会得到 `/tmpleno_...`（不存在 ⇒ write_text 返回 false）
    var tmp = dirs.join(_tmpdir(), "leno_jsons_t21_test.json")
    assert_eq(jsons.write_text(tmp, "{}"), true)
    var back = jsons.read_file(tmp)
    assert_eq(type(back), "Dict")                                       // 原样写 "{}" ⇒ 读回就是对象（不是带引号的串 ✗）
    if back is Dict { assert_eq(jsons.keys(back).len(), 0) }
    files.delete(tmp)

    // 测试9: decode 的 `\uXXXX` 转义（★ 2026-10-09 修）
    //   为什么钉：旧实现只写 `code < 128`（ASCII ⇒ 单字节）的，中文码点（如 U+5468）
    //   **一个字节都不写** ⇒ 该段被静默吞掉（实测 `{"name":"\u5c4b\u9876"}` 解出空串 ✗）。
    //   LenoMusic 的"音乐库"源就是踩在这个坑上（整列歌名全空）。
    //   ⇒ 现在一律按 UTF-8 写出，代理对（emoji）合成一个码点 ✓
    var esc = jsons.decode("{\"cn\":\"\\u5468\\u6770\\u4f26\",\"mix\":\"A\\u4e2dB\",\"emoji\":\"\\uD83D\\uDE00\",\"ascii\":\"\\u0041\\u0042\",\"lit\":\"\\\\u5468\"}")
    assert_eq(jsons.get_str(esc, "cn", ""), "周杰伦")                 // 中文（3 字节/字）
    assert_eq(jsons.get_str(esc, "cn", "").byte_len(), 9)
    assert_eq(jsons.get_str(esc, "mix", ""), "A中B")                  // 与 ASCII 混排
    assert_eq(jsons.get_str(esc, "emoji", "").byte_len(), 4)          // 代理对 ⇒ 合成一个码点（4 字节）
    assert_eq(jsons.get_str(esc, "ascii", ""), "AB")                  // ASCII 照旧（单字节）
    assert_eq(jsons.get_str(esc, "lit", ""), "\\u5468")               // `\\u` 是**字面**反斜杠 ⇒ 不误伤
    var arr2 = jsons.decode("[\"\\u5c4b\\u9876\"]")
    if arr2 is Array { assert_eq(arr2[0], "屋顶") }                    // 数组元素里同样生效

    // 测试10: **大整数精度**（★ 2026-10-10 修 / B 组第 11 条）
    //   为什么钉：旧实现把**所有** JSON 数字一律过 `strtod` ✗，再靠 `num == (int64_t)num`
    //   判"是不是整数"✗ —— 那条对 **> 2^53** 的值根本不成立 ✓（double 存不下 ⇒ 精度早就丢了）。
    //   现实里最需要它的正是**雪花 ID / 大时间戳**（> 2^53 但**在 int64 内** ✓）。
    //   ⇒ 现在整数文本走精确 int64 ✓（超出 int48 会自动升 bigint ✓ 所以不能用 val_int ✓）。
    //   ⚠ 连带修的两处（不修就是**新的静默错值** ✗，我实测抓到的）：
    //     ① `get_float` 拿不到 bigint ⇒ 静默回**默认值** ✗（实测就是 -1.0 ✓）；
    //     ② JSON **编码器**不会写 bigint ⇒ 静默写成 **null** ✗（实测 `{"id":null}` ✗
    //        —— 比原来的"精度丢"更糟 ✓）。
    var snow = jsons.decode("{\"id\": 153282510146394112}")
    assert_eq(jsons.get_int(snow, "id", -1), 153282510146394112)   // 精确（旧实现会错 ✗）
    // 取浮点也能拿到（不再静默回默认 ✗）
    //   ⚠ 大数别写成**科学计数法字面量** ✗：本语言**源码里的浮点字面量不支持** `1.5e17` ✓
    //     （实测报「期望 ')'」✗ —— 我在这里踩了两次、第一次还误判成"实参必须加括号"✗
    //      后来实测 `assert_eq(x > 3, true)` **不加括号也过** ✓ ⇒ 才定位到真因 ✓）
    //     ⇒ 要么写全数字 ✓ 要么 `_float("1.5e17")` ✓（两者都实测通过 ✓）
    var idf = jsons.get_float(snow, "id", -1.0)
    assert_eq((idf > 150000000000000000.0), true)
    assert_eq(jsons.encode(snow), "{\"id\":153282510146394112}")   // 回写**精确**（不再是 null ✗）
    //   对照：普通整数/浮点的口径**没变** ✓（42 是整数 ✓、42.0 / 1e3 是浮点 ✓）
    var plain = jsons.decode("{\"n\": 42, \"f\": 42.0, \"e\": 1e3, \"neg\": -7}")
    assert_eq(jsons.get_int(plain, "n", -1), 42)
    assert_eq(jsons.get_float(plain, "f", -1.0), 42.0)
    assert_eq(jsons.get_float(plain, "e", -1.0), 1000.0)
    assert_eq(jsons.get_int(plain, "neg", -1), -7)
    //   超 int64 的整数文本（>19 位）仍退回 double ✓ —— 文档写明的边界 ✓（本轮不接大整数串入口 ✓）
    assert_eq((jsons.encode(jsons.decode("12345678901234567890")) != "null"), true)

    print("test_json passed")
}
