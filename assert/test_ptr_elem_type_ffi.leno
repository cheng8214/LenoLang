// 回归：`Ptr[T] p = ffi.malloc(...)` 必须把 **元素类型** 写进运行时指针对象
//   —— OP_SET_PTR_ELEM_TYPE 原来在寄存器式里是空实现、codegen 也从不发射，
//   于是 ptr->element_type 恒为 TYPE_PTR，ffi.read_at/write_at 直接抛
//   「需要 Ptr[T] 类型指针（如 Ptr[u32]），不支持无类型 Ptr」
//   （examples/clib/test_read_write_at.leno、test_cfunc_qsort.leno 整份跑不出来）。
import ffi

main() {
    // ① u32：按元素宽度算偏移（index*4）
    Ptr[u32] p32 = ffi.malloc(20)       // 5 个 u32
    ffi.write_at(p32, 0, 10)
    ffi.write_at(p32, 4, 50)
    assert_eq(ffi.read_at(p32, 0) as int, 10)
    assert_eq(ffi.read_at(p32, 4) as int, 50)
    // 与字节偏移口径一致：第 5 个 u32 在字节 16 处
    assert_eq(ffi.read_int(p32, 16), 50)
    ffi.free(p32)

    // ② u8：index 即字节偏移
    Ptr[u8] p8 = ffi.malloc(5)
    ffi.write_at(p8, 0, 65)
    ffi.write_at(p8, 4, 69)
    assert_eq(ffi.read_at(p8, 0) as int, 65)
    assert_eq(ffi.read_at(p8, 4) as int, 69)
    ffi.free(p8)

    // ③ f64
    Ptr[f64] pf = ffi.malloc(24)        // 3 个 f64
    ffi.write_at(pf, 0, 1.5)
    ffi.write_at(pf, 2, 3.5)
    float v0 = ffi.read_at(pf, 0) as float
    float v2 = ffi.read_at(pf, 2) as float
    assert_eq(v0, 1.5)
    assert_eq(v2, 3.5)
    ffi.free(pf)

    // ④ u16（UTF-16 缓冲区）
    Ptr[u16] p16 = ffi.malloc(10)       // 5 个 u16
    ffi.write_at(p16, 0, 72)
    ffi.write_at(p16, 1, 105)
    assert_eq(ffi.read_at(p16, 0) as int, 72)
    assert_eq(ffi.read_at(p16, 1) as int, 105)
    ffi.free(p16)
}
