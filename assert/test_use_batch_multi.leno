// use 批量导入语法测试 — 多符号
// 语法: use module.(A, B, C)
import "use_mod_c.leno" as c

// 批量导入：同一模块的多个类型
use c.(Point, Color, Rect, Size)

main() {
    Point p = new c.Point(x = 10, y = 20)
    assert_eq(p.x, 10)
    assert_eq(p.y, 20)

    Color cl = new c.Color(r = 100, g = 200, b = 50)
    assert_eq(cl.r, 100)
    assert_eq(cl.g, 200)

    Rect r = new c.Rect(w = 640, h = 480)
    assert_eq(r.w, 640)
    assert_eq(r.h, 480)

    Size s = {w: 800, h: 600}
    assert_eq(s["w"], 800)

    print("test_use_batch_multi passed")
}
