// dirs 模块测试

import dirs
import files

main()
{
    // 测试1: 获取当前工作目录
    var cwd = dirs.cwd()
    print("当前目录: " + cwd)
    assert_eq(cwd.len() > 0, true)

    // 测试2: 检查目录是否存在
    var exists = dirs.exists(cwd)
    assert_eq(exists, true)

    var not_exists = dirs.exists("/non_existent_dir_12345")
    assert_eq(not_exists, false)

    // 测试3: 判断是文件还是目录
    assert_eq(dirs.is_dir(cwd), true)
    assert_eq(dirs.is_file(cwd), false)

    // 测试4: 创建和删除目录 (使用 rmdir)
    var test_dir = "test_temp_dir"

    // 确保目录不存在
    if dirs.exists(test_dir) {
        dirs.rmdir(test_dir)
    }

    // 创建目录
    var create_result = dirs.mkdir(test_dir)
    assert_eq(create_result, true)
    assert_eq(dirs.exists(test_dir), true)
    assert_eq(dirs.is_dir(test_dir), true)

    // 删除目录
    var remove_result = dirs.rmdir(test_dir)
    assert_eq(remove_result, true)
    assert_eq(dirs.exists(test_dir), false)

    // 测试5: 路径拼接
    var joined_path = dirs.join("folder", "subfolder", "file.txt")
    print("拼接路径: " + joined_path)
    assert_eq(joined_path.has("folder"), true)
    assert_eq(joined_path.has("file.txt"), true)

    // 测试6: 路径操作
    var path = "src/module/io/io.c"
    var basename = dirs.basename(path)
    var dirname = dirs.dirname(path)
    var extname = dirs.extname(path)
    print("文件名: " + basename)
    print("目录名: " + dirname)
    print("扩展名: " + extname)
    assert_eq(basename, "io.c")
    assert_eq(dirname, "src/module/io")
    assert_eq(extname, ".c")

    // 测试7: 绝对路径
    var abs = dirs.abspath("test")
    print("绝对路径: " + abs)
    assert_eq(abs.len() > 0, true)

    // 测试8: 路径分隔符
    var sep = dirs.sep()
    print("路径分隔符: '" + sep + "'")
    assert_eq(sep.len(), 1)

    // 测试9: 列出目录内容
    var entries = dirs.listdir(cwd)
    print("当前目录条目数: " + entries.len())
    assert_eq(entries.len() > 0, true)

    // 测试10: stat 获取文件信息 —— 返回 `DirInfo`（**字段类型编译期已知**，v3.2.4）
    //   旧形态是无类型 `Dict` ⇒ `info["size"]` 是 any，取 size 得 `if st is Dict` + `if s is int`；
    //   现在 `info.size` 直接是 int、`info.exists` 直接是 bool ✓
    var info = dirs.stat(cwd)
    print("目录信息: exists=" + info.exists + ", is_dir=" + info.is_dir)
    assert_eq(info.exists, true)
    assert_eq(info.is_dir, true)
    assert_eq(info.is_file, false)
    assert(not (info is Dict))          // 守住"不再是 Dict"（字段类型已知；旧的收窄路径已作废）

    // 类型契约：下面两行**不做任何收窄/转换** ⇒ 编译期就把字段类型钉住了
    //   （若字段是 any，`int x = info.size` / `bool b = info.exists` 都会编译失败）
    int info_bytes = info.size
    bool info_ok = info.exists
    assert_eq(info_bytes >= 0, true)
    assert_eq(info_ok, true)

    // 测试11: `stat(p).size` —— 取大小的**唯一入口**（2026-09-27 收敛：删掉了并行的 dirs.size()）
    //   原 `dirs.size()` 只是"stat 返回无类型 Dict 时补的类型化入口"；stat 改结构体后它就是
    //   重复入口 ⇒ 收敛成一条路，避免同一件事两种写法长期共存
    var self = "assert\\test_dirs.leno"          // 用一个**确定存在**的文件
    assert_eq(dirs.exists(self), true)

    // ① 类型自证：能直接做 int 整除（any 类型过不了这道）
    assert_eq(dirs.stat(self).size > 0, true)
    assert_eq(dirs.stat(self).size / 1024 >= 0, true)

    // ② 不存在 ⇒ 0（与 stat 的默认值同口径；要区分"空文件"与"不存在"先 dirs.exists()）
    assert_eq(dirs.stat("assert\\不存在的文件_9b2f.leno").size, 0)

    // ③ 目录 ⇒ 给的是**目录条目自身**的大小，不是递归总大小（同 walk 口径）
    assert_eq(dirs.stat("assert").size >= 0, true)
    assert_eq(dirs.stat("assert").is_dir, true)

    // 测试13: dirs.walk() —— 返回 `Array[DirEntry]`（带**字段类型**的 native struct，v3.2.3）
    //   背景：`walk` 旧形态是 `Array[Array]` 的三元组 `[root, dirs, files]` ⇒ 元素是 any，取值
    //   只能 `e[0]/e[1]/e[2]`；而 native 元数据过去只有"一个 TypeKind 槽"，表达不了
    //   `Array[DirEntry]`。现在用 NativeTypeSpec 声明（**编译期字段表 + 运行期 ObjStructDef
    //   同一来源**）⇒ 字段类型编译期已知、零收窄 ✓（过渡期的 `walk_entries` 已合并回 `walk`）
    var wes = dirs.walk("src/module/arrays")
    assert_eq(wes.len(), 1)

    // ① 字段类型在**编译期**已知：下面三行没有任何 as / 收窄
    //    （若字段是 any，这三行会直接编译失败 —— 这就是本用例要守住的东西）
    string wroot = wes[0].root
    Array[string] wfiles = wes[0].files
    Array[string] wdirs = wes[0].dirs
    assert_eq(wroot, "src/module/arrays")
    assert_eq(wdirs.len(), 0)
    assert_eq(wfiles.has("arrays.c"), true)     // 元素类型是 string ⇒ 能直接进 Array[string] 的方法

    // ② 多层递归：每条 root 都必须是真目录（root 是 string ⇒ 能直接传给 dirs.is_dir）
    var wmulti = dirs.walk("src/module")
    assert_eq(wmulti.len() > 1, true)
    int wtotal = 0
    for wmulti to we {
        assert_eq(dirs.is_dir(we.root), true)
        wtotal = wtotal + we.files.len()
    }
    assert_eq(wtotal > 0, true)

    // ③ dirs / files 都是**名字**（不含路径；与 listdir 同口径）⇒ 完整路径靠 join 拼 ✓
    var one = dirs.walk("src/module/arrays")[0]
    assert_eq(dirs.exists(dirs.join(one.root, one.files[0])), true)
    assert_eq(dirs.extname(one.files[0]), ".c")
    assert_eq(one.dirs.len(), 0)

    // 测试14: **全部 dirs 方法的类型契约**（编译期把关）
    //   为什么值得单独写一段：native 的类型规格**只在编译期生效**（运行期不校验字段/元素类型）
    //   ⇒ "spec 漏写 / 写错 / 被改回 any" 这类毛病，运行期断言永远是绿的，只有编译期能挡住；
    //   而 dirs 的返回形态在 v3.2.3/v3.2.4 连改两次（walk / stat）⇒ 正是该被钉住的地方。
    //   下面每行都是**不做收窄、不做转换**的赋值 ⇒ spec 一漂，这里就编译失败。
    //   ⚠ v3.2.5 起 native struct 名（`DirEntry` / `DirInfo`）**可以当类型标注**（见测试16）⇒
    //     下面直接用标注钉，比 `var` + 逐字段更硬：标注与 spec 不一致就编译失败。
    string t_cwd    = dirs.cwd()
    string t_abs    = dirs.abspath(".")
    string t_base   = dirs.basename("a\\b.c")
    string t_dir    = dirs.dirname("a\\b.c")
    string t_ext    = dirs.extname("a\\b.c")
    string t_join   = dirs.join("a", "b", "c")
    string t_sep    = dirs.sep()
    string t_script = dirs.script_dir()
    string t_res    = dirs.res_dir()
    Array[string] t_drives = dirs.list_drives()
    Array[string] t_ls     = dirs.listdir(".")
    int  t_size     = dirs.stat(self).size

    // walk ⇒ `Array[DirEntry]`：三个字段逐个钉
    Array[DirEntry] t_walk = dirs.walk("src/module/arrays")
    string        t_w_root  = t_walk[0].root
    Array[string] t_w_dirs  = t_walk[0].dirs
    Array[string] t_w_files = t_walk[0].files

    // stat ⇒ `DirInfo`：五个字段逐个钉
    DirInfo t_stat = dirs.stat(self)
    bool t_st_exists  = t_stat.exists
    int  t_st_size    = t_stat.size
    bool t_st_is_file = t_stat.is_file
    bool t_st_is_dir  = t_stat.is_dir
    int  t_st_mtime   = t_stat.mtime

    // 上面这些变量存在的意义就是**编译期**钉类型；这里统一消费一次（也顺便断言口径）
    assert_eq(t_cwd.len() > 0 and t_abs.len() > 0 and t_base == "b.c" and t_dir == "a", true)
    assert_eq(t_ext == ".c" and t_join.len() > 0 and t_sep.len() == 1, true)
    assert_eq(t_script.len() >= 0 and t_res.len() >= 0 and t_drives.len() >= 0, true)
    assert_eq(t_ls.len() > 0 and t_size > 0, true)
    assert_eq(t_w_root == "src/module/arrays" and t_w_dirs.len() == 0 and t_w_files.len() > 0, true)
    assert_eq(t_st_exists and t_st_size > 0 and t_st_is_file and not t_st_is_dir and t_st_mtime >= 0, true)

    // 测试15: 写操作（mkdir / mkdir_p / rename / delete / is_symlink）—— 临时目录里建-改-删往返，跑完自清
    string tmp = "test_dirs_tmp"
    // 上一次跑中途挂掉可能留下**非空**的 tmp ⇒ 先自底向上清干净（`rmdir` 只吃空目录）；
    //   walk 是"先父后子"，所以倒着遍历就是"先深后浅"✓（这段顺带也演示了字段取值的用法）
    if dirs.exists(tmp) {
        var stale = dirs.walk(tmp)
        int si = stale.len() - 1
        while si >= 0 {
            var e = stale[si]
            for e.files to fn { dirs.delete(dirs.join(e.root, fn)) }
            if e.root != tmp { dirs.rmdir(e.root) }
            si = si - 1
        }
        dirs.rmdir(tmp)
    }

    bool w_mkdir  = dirs.mkdir(tmp)
    assert_eq(w_mkdir, true)
    bool w_mkdirp = dirs.mkdir_p(dirs.join(tmp, "a", "b"))
    assert_eq(w_mkdirp, true)
    assert_eq(dirs.is_dir(dirs.join(tmp, "a", "b")), true)

    string f1 = dirs.join(tmp, "t1.txt")
    string f2 = dirs.join(tmp, "t2.txt")
    files.write(f1, "x")
    assert_eq(dirs.is_file(f1), true)

    bool w_ren = dirs.rename(f1, f2)
    assert_eq(w_ren, true)
    assert_eq(dirs.exists(f1), false)
    assert_eq(dirs.exists(f2), true)

    bool w_del = dirs.delete(f2)
    assert_eq(w_del, true)
    assert_eq(dirs.exists(f2), false)

    // is_symlink：普通文件/目录 ⇒ false（Windows 建符号链接要特权 ⇒ 只测反例）
    bool w_sym_file = dirs.is_symlink(dirs.join(tmp, "a"))
    bool w_sym_dir  = dirs.is_symlink(tmp)
    assert_eq(w_sym_file, false)
    assert_eq(w_sym_dir, false)

    // listdir 与 walk 的**同一层口径一致**：都只给名字、不含路径（walk 逐层，子目录自己也是一条）
    var layer  = dirs.listdir(tmp)
    var walked = dirs.walk(tmp)
    assert_eq(layer.len(), 1)
    assert_eq(layer.has("a"), true)
    assert_eq(walked.len(), 3)                  // tmp、tmp\a、tmp\a\b（b 是空目录，自己也占一条）
    assert_eq(walked[0].dirs.len(), 1)
    assert_eq(walked[0].dirs[0], "a")           // 与 listdir 的名字口径一致

    // 清理（自底向上：rmdir 只吃空目录）
    assert_eq(dirs.rmdir(dirs.join(tmp, "a", "b")), true)
    assert_eq(dirs.rmdir(dirs.join(tmp, "a")), true)
    assert_eq(dirs.rmdir(tmp), true)
    assert_eq(dirs.exists(tmp), false)

    // 测试16: native struct 名当**类型标注**（v3.2.5）—— 以前只能写 `var`
    //   背景：`DirEntry` / `DirInfo` 由 native 模块用 NativeStructSpec 声明，**不在符号表里**
    //   ⇒ 类型名校验会判"未定义的类型"，于是 `DirInfo d = dirs.stat(p)` 编译不过（报错还建议一个
    //   native 根本不存在的 `use module.DirInfo`）。现在 4 处校验点都加了 native 兜底判据
    //   （变量声明有/无初始化、函数参数与返回、脚本 struct 的字段类型）。
    //   本段把这些位置各钉一条；（不存在的名字仍报错，见测试17 的说明）
    DirInfo ann_info = dirs.stat(self)                  // ① 变量标注（有初始化）
    assert_eq(ann_info.size > 0, true)

    DirInfo ann_decl                                    // ② 变量标注（无初始化，另一条校验路径）
    ann_decl = dirs.stat(self)
    assert_eq(ann_decl.exists, true)

    assert_eq(ann_size(ann_info), ann_info.size)        // ③ 作函数参数（返回类型也标注成 int）

    DirEntry ann_entry = ann_first("src/module/arrays") // ④ 作函数返回类型（内部标注 Array[DirEntry]）
    assert_eq(ann_entry.root, "src/module/arrays")
    assert_eq(ann_entry.files.has("arrays.c"), true)

    var ann_holder = new AnnHolder(info=ann_info)       // ⑤ 作脚本 struct 的字段类型
    assert_eq(ann_holder.info.size, ann_info.size)
    assert_eq(ann_holder.tag.len() > 0, true)

    var ann_any = dirs.stat(self)
    assert_eq(ann_any is DirInfo, true)                 // ⑥ `is` 判定也认这个名字

    print("test_dirs passed")
}

// --- 测试16 的辅助（native 类型标注用在参数 / 返回 / 脚本 struct 字段上）---
//   ⚠ 负例（`NotAThing x = 1` 仍须报"未定义的类型"）不适合放这里：本文件是**能跑通**的用例，
//     编译失败的用例要去 diag 那一类用例里守 —— 已在会话里手工对照过（见提交信息）。
func ann_size(DirInfo d): int {
    return d.size
}

func ann_first(string p): DirEntry {
    Array[DirEntry] w = dirs.walk(p)
    return w[0]
}

struct AnnHolder {
    DirInfo info
    string  tag = "native-type-annotation"
}
