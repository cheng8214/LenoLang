// dirs 模块测试

import dirs

main()
{
    // 测试1: 获取当前工作目录
    var cwd = dirs.cwd()
    print("当前目录: " + cwd)
    assert_eq(cwd.len() > 0, true)

    // 测试2: 检查目录是否存在
    var exists = dirs.exists(cwd)
    assert_eq(exists, true)

    var not_exists = dirs.exists("/non_existent_dir_12345")
    assert_eq(not_exists, false)

    // 测试3: 判断是文件还是目录
    assert_eq(dirs.is_dir(cwd), true)
    assert_eq(dirs.is_file(cwd), false)

    // 测试4: 创建和删除目录 (使用 rmdir)
    var test_dir = "test_temp_dir"

    // 确保目录不存在
    if dirs.exists(test_dir) {
        dirs.rmdir(test_dir)
    }

    // 创建目录
    var create_result = dirs.mkdir(test_dir)
    assert_eq(create_result, true)
    assert_eq(dirs.exists(test_dir), true)
    assert_eq(dirs.is_dir(test_dir), true)

    // 删除目录
    var remove_result = dirs.rmdir(test_dir)
    assert_eq(remove_result, true)
    assert_eq(dirs.exists(test_dir), false)

    // 测试5: 路径拼接
    var joined_path = dirs.join("folder", "subfolder", "file.txt")
    print("拼接路径: " + joined_path)
    assert_eq(joined_path.has("folder"), true)
    assert_eq(joined_path.has("file.txt"), true)

    // 测试6: 路径操作
    var path = "src/module/io/io.c"
    var basename = dirs.basename(path)
    var dirname = dirs.dirname(path)
    var extname = dirs.extname(path)
    print("文件名: " + basename)
    print("目录名: " + dirname)
    print("扩展名: " + extname)
    assert_eq(basename, "io.c")
    assert_eq(dirname, "src/module/io")
    assert_eq(extname, ".c")

    // 测试7: 绝对路径
    var abs = dirs.abspath("test")
    print("绝对路径: " + abs)
    assert_eq(abs.len() > 0, true)

    // 测试8: 路径分隔符
    var sep = dirs.sep()
    print("路径分隔符: '" + sep + "'")
    assert_eq(sep.len(), 1)

    // 测试9: 列出目录内容
    var entries = dirs.listdir(cwd)
    print("当前目录条目数: " + entries.len())
    assert_eq(entries.len() > 0, true)

    // 测试10: stat 获取文件信息
    var info = dirs.stat(cwd)
    print("目录信息: exists=" + info["exists"] + ", is_dir=" + info["is_dir"])
    assert_eq(info["exists"], true)
    assert_eq(info["is_dir"], true)

    // 测试11: dirs.size() —— stat 缺的那个类型化取值入口（2026-09-26 新增）
    //   背景：`dirs.stat()` 返回无类型 Dict ⇒ 取 size 要 `if st is Dict` + `if s is int` 手动收窄；
    //   而 stat 的另三个键 exists/is_file/is_dir 早就有专用函数（dirs.exists/is_file/is_dir）
    //   ⇒ 补上 size 这一格。返回类型是 TYPE_INT（不是 any）⇒ 可直接做 int 运算 ✓
    var self = "assert\\test_dirs.leno"          // 用一个**确定存在**的文件
    assert_eq(dirs.exists(self), true)

    // ① 与 stat 的 size 字段一致（同口径）
    assert_eq(dirs.size(self), info_size(self))

    // ② 类型自证：能直接做 int 整除（any 类型过不了这道）
    assert_eq(dirs.size(self) > 0, true)
    assert_eq(dirs.size(self) / 1024 >= 0, true)

    // ③ 不存在 ⇒ 0（与 stat 的默认值同口径；要区分"空文件"与"不存在"先 dirs.exists()）
    assert_eq(dirs.size("assert\\不存在的文件_9b2f.leno"), 0)
    assert_eq(dirs.size("assert\\不存在的文件_9b2f.leno"), dirs.stat("assert\\不存在的文件_9b2f.leno")["size"])

    // ④ 目录 ⇒ 与 stat 一致（给的是目录条目自身的大小，不是递归总大小）
    assert_eq(dirs.size("assert"), dirs.stat("assert")["size"])

    // 测试13: dirs.walk() —— 返回 `Array[DirEntry]`（带**字段类型**的 native struct，v3.2.3）
    //   背景：`walk` 旧形态是 `Array[Array]` 的三元组 `[root, dirs, files]` ⇒ 元素是 any，取值
    //   只能 `e[0]/e[1]/e[2]`；而 native 元数据过去只有"一个 TypeKind 槽"，表达不了
    //   `Array[DirEntry]`。现在用 NativeTypeSpec 声明（**编译期字段表 + 运行期 ObjStructDef
    //   同一来源**）⇒ 字段类型编译期已知、零收窄 ✓（过渡期的 `walk_entries` 已合并回 `walk`）
    var wes = dirs.walk("src/module/arrays")
    assert_eq(wes.len(), 1)

    // ① 字段类型在**编译期**已知：下面三行没有任何 as / 收窄
    //    （若字段是 any，这三行会直接编译失败 —— 这就是本用例要守住的东西）
    string wroot = wes[0].root
    Array[string] wfiles = wes[0].files
    Array[string] wdirs = wes[0].dirs
    assert_eq(wroot, "src/module/arrays")
    assert_eq(wdirs.len(), 0)
    assert_eq(wfiles.has("arrays.c"), true)     // 元素类型是 string ⇒ 能直接进 Array[string] 的方法

    // ② 多层递归：每条 root 都必须是真目录（root 是 string ⇒ 能直接传给 dirs.is_dir）
    var wmulti = dirs.walk("src/module")
    assert_eq(wmulti.len() > 1, true)
    int wtotal = 0
    for wmulti to we {
        assert_eq(dirs.is_dir(we.root), true)
        wtotal = wtotal + we.files.len()
    }
    assert_eq(wtotal > 0, true)

    // ③ dirs / files 都是**名字**（不含路径；与 listdir 同口径）⇒ 完整路径靠 join 拼 ✓
    var one = dirs.walk("src/module/arrays")[0]
    assert_eq(dirs.exists(dirs.join(one.root, one.files[0])), true)
    assert_eq(dirs.extname(one.files[0]), ".c")
    assert_eq(one.dirs.len(), 0)

    print("test_dirs passed")
}

// 取 stat 的 size 字段（**故意保留手动收窄** ⇒ 用它当上面 ① 的对照基准）
func info_size(string path): int {
    var st = dirs.stat(path)
    if st is Dict {
        var s = st.get("size", 0)
        if s is int { return s }
    }
    return 0
}
