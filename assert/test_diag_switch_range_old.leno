// 区间 case 的旧写法 `case 1 to 3` 必须给出定向提示（2026-11-03 统一成 `:`）
//
// 为什么改：Leno 里"区间"只有一个符号 —— 切片 `arr[2:8]`、范围 `x in 0:9` 都是 `:`，
// 且都是闭区间。case 头再造一个 `to` 等于两套等价写法。

import "helpers/compiler.leno" as ce
import dirs
import files

main() {
    var work = dirs.join(_tmpdir(), "leno_case_range_old")
    dirs.delete(work)
    dirs.mkdir_p(work)

    // ① 旧写法：报错并指路
    var f1 = dirs.join(work, "old_to.leno")
    files.write(f1, @"main() {
    int v = 2
    switch v {
        case 1 to 3 { print(""range"") }
        default { print(""other"") }
    }
}
")
    ce.expect_error(f1, "旧写法 case ... to ...", "case 的区间写法是 `case 1:3`", 4)

    // ② 新写法：正常
    var f2 = dirs.join(work, "new_colon.leno")
    files.write(f2, @"main() {
    int v = 2
    switch v {
        case 1:3 { print(""range"") }
        default { print(""other"") }
    }
}
")
    ce.expect_ok(f2, "新写法 case 1:3", "range")

    print("=== test_diag_switch_range_old ALL passed ===")
}
