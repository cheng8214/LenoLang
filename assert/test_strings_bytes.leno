// test_strings_bytes.leno — 字节 ↔ 文本 的桥 + 扫描原语的护栏（2026-10-02）
//
// 为什么有这批 API（数出来的重复实现）：
//   `strings.char(...)` 159 处 / 39 文件（crypto/base64/PE/web_html 都在逐字节拼串，且是 O(n²)）、
//   "字节串↔hex" 22 处 / 12 文件、`to_lower(a)==to_lower(b)` 8 处、`slice(i,i+1)` 逐字符扫描 10 处。
// 收编进度（2026-10-02）：
//   · hex 家族（to_hex/from_hex/bytes_to_hex/hex_to_bytes）**全部收编**（含 8 份 byte_to_hex 死码清理）
//   · `to_lower(a)==to_lower(b)` 7 处 → `eq_ignore_case`（对拍 3025 对 0 分歧）
//   · `slice(i,i+1)` 逐字符扫描 9 处 → `byte(i)`+数值区间 / `codepoint_at` / `to_codepoints`+`from_codepoint`
//     （测宽循环那 4 处靠 ⑦ 这条"cps[i] 还原 == slice(i,i+1)"替掉 O(n²) 扫描）
//   · `strings.char` **逐字节累加**（`x = x + strings.char(b)` 形态）已收编部分（2026-10-03）：
//     crypto 家族 13 份 byte_to_hex（43 处调用）→ `from_bytes(...).to_hex()`；
//     web_crawler 4 + pe_analyzer 5 + web_html 26 处 → 一律"字节先收 `Array[int]`，
//     在消费点/末尾一趟 `strings.from_bytes`"✓
//     证据：① `from_bytes(数组) == 逐字节 strings.char 拼接`（0-255 全量 / 多字节文本 / 空数组对拍 0 分歧）
//           ② web 两模块"改动前后逐字对拍"：URL / HTML / CDATA / script / 实体 / **16 条选择器**用例，
//              52 行输出全同 ✓；③ 21 个加密示例与逐字基线一致 ✓
//     ⚠ **仍有 44 处未收编**（2026-10-03 全仓统计，排除注释）：vigenere 6、caesar 6、康托尔对角线 4、
//       patch_title 3、chacha20 2、以及 chacha20_1/2、rc4、xtea、tea、speck、rc5、aes128、crypto_aes、
//       sys_parse、w32_memory、pe 的 test_analyzer、若干 assert 用例各 1。
//       其中**一次性追加**（如 `padding += strings.char(pad_len)`，只执行一次）不构成 O(n²) ⇒ 无收编必要；
//       loop 型的（vigenere/caesar/chacha20/rc4 等）可按同一口径继续收编（crypto 示例有逐字基线可对拍 ✓）
// 判据：
//   ① 往返一致（bytes/hex/codepoints 三条都要"来回一趟 == 原串"）
//   ② 硬编码期望值（防"两边一起漂"）——含中文 3 字节与 emoji 4 字节
//   ③ 错误路径**必须抛**（越界字节 / 奇数长度 hex / 非法 hex 字符）—— 不许静默截断
//   ④ 越界口径与既有 `byte` 一致（返回 null）
import strings
import io

func dump(Array[int] a):string {
    var out = ""
    int i = 0
    for a to x {
        if i > 0 { out += "," }
        out += _str(x)
        i += 1
    }
    return "[" + out + "]"
}

main() {
    io.print("=== strings 字节桥 / 扫描原语 验证 ===\n")

    // ① to_bytes / from_bytes 往返 + 硬编码
    assert_eq(dump("Hi中文".to_bytes()), "[72,105,228,184,173,230,150,135]", "①to_bytes 硬编码期望")
    assert_eq(strings.from_bytes("Hi中文".to_bytes()), "Hi中文", "①bytes 往返必须一致")
    assert_eq(dump("".to_bytes()), "[]", "①空串 ⇒ 空数组")
    assert_eq(strings.from_bytes([]), "", "①空数组 ⇒ 空串")
    io.print("[1] bytes 往返 ✓")

    // ② to_hex / from_hex（**默认小写**、`upper=true` 大方写、读取时大小写都收）
    assert_eq("Hi".to_hex(), "4869", "②to_hex 默认（纯数字串看不出大小写，下面才见真章）")
    assert_eq("中".to_hex(), "e4b8ad", "②to_hex **默认小写**（3 字节中文）")
    var ab_cd = strings.from_bytes([171, 205])
    assert_eq(ab_cd.to_hex(), "abcd", "②to_hex 默认小写（0xAB 0xCD）")
    assert_eq(ab_cd.to_hex(true), "ABCD", "②to_hex(upper=true) 大写")
    assert_eq(strings.to_hex(ab_cd), "abcd", "②模块式与实例式同默认（小写）")
    assert_eq(strings.from_hex("4869"), "Hi", "②from_hex 读大写")
    assert_eq(strings.from_hex("4869".to_lower()), "Hi", "②from_hex 读小写")
    assert_eq(strings.from_hex("中文".to_hex()), "中文", "②hex 往返含中文")
    assert_eq(strings.from_hex("e4b8ad"), "中", "②小写 hex 也能读回来")
    assert_eq("".to_hex(), "", "②空串 ⇒ 空 hex")
    io.print("[2] hex 往返 ✓")

    // ③ 错误路径必须抛（响亮，不静默）
    int threw = 0
    try { var x1 = strings.from_bytes([256]) } catch e { threw += 1 }
    try { var x2 = strings.from_bytes([-1]) } catch e { threw += 1 }
    try { var x3 = strings.from_hex("abc") } catch e { threw += 1 }     // 奇数长度
    try { var x4 = strings.from_hex("zz") } catch e { threw += 1 }      // 非 hex 字符
    assert_eq(threw, 4, "③四条错误路径都必须抛（实抛 " + threw + " 条）")
    io.print("[3] 错误路径 4 条都抛 ✓")

    // ④ eq_ignore_case：与 to_lower 两边比**同语义**
    assert_true("Hello".eq_ignore_case("hELLO"), "④应相等")
    assert_true(not "Hello".eq_ignore_case("world"), "④应不等")
    assert_true(not "abc".eq_ignore_case("ab"), "④长度不同 ⇒ 不等（不该越界读）")
    assert_true("".eq_ignore_case(""), "④空串 = 空串")
    assert_true(strings.eq_ignore_case("ABC", "abc"), "④模块式同样可用")
    io.print("[4] eq_ignore_case ✓")

    // ⑤ codepoint_at：ASCII / 中文 / emoji(4 字节) / 负索引 / 越界 null
    var s = "a中🙂"
    assert_eq(s.codepoint_at(0), 97, "⑤ASCII 'a' = 97")
    assert_eq(s.codepoint_at(1), 20013, "⑤'中' = U+4E2D = 20013")
    assert_eq(s.codepoint_at(2), 128578, "⑤'🙂' = U+1F642 = 128578（4 字节路径）")
    assert_eq(s.codepoint_at(-1), 128578, "⑤负索引取最后一个字符")
    assert_eq(s.codepoint_at(99), null, "⑤越界 ⇒ null（与 byte 同口径）")
    assert_eq("中".codepoint_at(0), 20013, "⑤字面量上也能调（模块式/实例式两条通道）")
    io.print("[5] codepoint_at ✓")

    // ⑥ to_codepoints：一趟扫全部（替代循环 codepoint_at 的 O(n²)）
    assert_eq(dump("a中🙂".to_codepoints()), "[97,20013,128578]", "⑥码点数组硬编码期望")
    assert_eq(dump("".to_codepoints()), "[]", "⑥空串 ⇒ 空数组")
    assert_eq(dump("abc".to_codepoints()), dump(["abc".codepoint_at(0), "abc".codepoint_at(1), "abc".codepoint_at(2)]),
              "⑥与逐点 codepoint_at 必须一致")
    io.print("[6] to_codepoints ✓")

    // ⑦ from_codepoint：`to_codepoints` 的**逆操作**（码点 → 单字符串）；1..4 字节档位 + 非法码点抛错
    assert_eq(strings.from_codepoint(65), "A", "⑦ASCII 码点")
    assert_eq(strings.from_codepoint(20013), "中", "⑦中文（3 字节）")
    assert_eq(strings.from_codepoint(128578), "🙂", "⑦emoji（4 字节）")
    assert_eq("x".from_codepoint(65), "A", "⑦实例式（接收者被忽略，与模块式同结果）")
    // 与 slice 逐字符一致 —— sdl_label / sdl_edit 的逐字测宽循环正是靠这条替代 slice(i, i+1)
    var rt = "a中🙂Ä"
    Array[int] cps7 = rt.to_codepoints()
    assert_eq(cps7.len(), rt.len(), "⑦码点数 == len()（字符数）")
    var back7 = ""
    for cps7 to cp { back7 += strings.from_codepoint(cp) }
    assert_eq(back7, rt, "⑦码点→字符串 往返 == 原串")
    int diff7 = 0
    for 0:rt.len() - 1 to i {
        if strings.from_codepoint(cps7[i]) != rt.slice(i, i + 1) { diff7 += 1 }
    }
    assert_eq(diff7, 0, "⑦from_codepoint(cps[i]) == slice(i, i+1)（逐字符一致）")
    // UTF-8 长度档位边界（1/2/3/4 字节）
    assert_eq(strings.from_codepoint(127).byte_len(), 1, "⑦0x7F ⇒ 1 字节")
    assert_eq(strings.from_codepoint(128).byte_len(), 2, "⑦0x80 ⇒ 2 字节")
    assert_eq(strings.from_codepoint(2047).byte_len(), 2, "⑦0x7FF ⇒ 2 字节")
    assert_eq(strings.from_codepoint(2048).byte_len(), 3, "⑦0x800 ⇒ 3 字节")
    assert_eq(strings.from_codepoint(65535).byte_len(), 3, "⑦0xFFFF ⇒ 3 字节（代理区之外）")
    assert_eq(strings.from_codepoint(65536).byte_len(), 4, "⑦0x10000 ⇒ 4 字节")
    assert_eq(strings.from_codepoint(1114111).byte_len(), 4, "⑦0x10FFFF ⇒ 4 字节（上限）")
    // 非法码点必须抛：负数 / 超上限 / UTF-16 代理区两端
    int threw7 = 0
    try { var z1 = strings.from_codepoint(-1) } catch e { threw7 += 1 }
    try { var z2 = strings.from_codepoint(1114112) } catch e { threw7 += 1 }
    try { var z3 = strings.from_codepoint(55296) } catch e { threw7 += 1 }
    try { var z4 = strings.from_codepoint(57343) } catch e { threw7 += 1 }
    assert_eq(threw7, 4, "⑦非法码点 4 条都必须抛（实抛 " + threw7 + " 条）")
    io.print("[7] from_codepoint ✓")

    io.print("\n=== strings 字节桥全部通过 ===")
}
