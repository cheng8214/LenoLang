// 辅助模块：**模块级变量**的声明类型 CAST + 跨模块成员访问
//   （覆盖 gen_var_decl 的 SYM_MODULE 分支：`export float modFloat = 1`
//     内部必须是浮点，否则 modFloat/2 走 int 语义得 0）

export float modFloat = 1
export float modFloatExpr = 1 + 1
export var modVar = 3
export float modFloatFromVar = modVar
export int modInt = 7
export string modStr = "s"
export bool modFlag = true

export func half_of_mod_float(): float {
    return modFloat / 2
}

export func mod_var_half(): float {
    return modFloatFromVar / 2
}

// ★ C1：**函数返回值**同样要按声明类型规范化（此前返回值完全不 CAST）
//   跨模块调用点只信声明类型，值本身是 int ⇒ `type(m.ret_float_lit())` = int、
//   `/2` 走 int 除法得 0（应为 0.5）。栈式侧同样如此（共有缺口，寄存器式已修 → A4）。
export func ret_float_lit(): float {
    return 1
}

export func ret_float_var(): float {
    int n = 5
    return n
}

// 反向：int / string 返回值不能被顺手转成 float
export func ret_int(): int {
    return 7
}

export func ret_str(): string {
    return "s"
}

