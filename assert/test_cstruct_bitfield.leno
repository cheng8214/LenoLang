// `cstruct` 位域（2026-11-12）
//
// 语法：`u32 flags : 3`（必须在整数类型上，宽度 1..sizeof(type)*8，不能是数组、不能进 union）。
//
// 布局按 C 的常见规则（小端）：
//   · 同类型、能塞进当前存储单元 ⇒ 从 LSB 起接着排；
//   · 类型变了 / 塞不下 ⇒ 按类型对齐开新单元。
//   读：取单元值 → 右移 bit_offset → 掩码（有符号类型做符号扩展）；
//   写：读-改-写（只动自己那几位，邻居不受影响）。
import ffi

cstruct Flags {
    u32 a : 1
    u32 b : 2
    u32 c : 3
    u32 d : 26
}

cstruct Mix {
    u8  x : 4
    u8  y : 4
    u16 z
}

cstruct Signed {
    i32 s : 4
    i32 t : 4
}

main() {
    // ---- 布局 ----
    assert_eq(Flags.size(), 4, "4 个 u32 位域正好占 1 个 u32")
    assert_eq(Mix.size(), 4, "u8 位域占 1 字节，u16 对齐到 2 ⇒ 总长 4")
    assert_eq(Mix.offset_of("z"), 2, "u16 的偏移")
    assert_eq(Signed.size(), 4, "i32 位域占 1 个 i32")

    // ---- 各字段独立读写 ----
    var f = Flags.malloc()
    f.a = 1
    f.b = 2
    f.c = 5
    f.d = 12345
    assert_eq(f.a, 1, "a")
    assert_eq(f.b, 2, "b")
    assert_eq(f.c, 5, "c")
    assert_eq(f.d, 12345, "d")

    // 写 a 不能影响邻居
    f.a = 0
    assert_eq(f.b, 2, "改 a 后 b 不变")
    assert_eq(f.c, 5, "改 a 后 c 不变")
    assert_eq(f.d, 12345, "改 a 后 d 不变")

    // ---- 与 C 的字节排布一致（LSB 起）----
    f.a = 1
    var raw = f.to_ptr()
    int low6 = ffi.read_int(raw, 0) & 63
    assert_eq(low6, (1 | (2 << 1) | (5 << 3)) & 63, "低 6 位符合 LSB 排布")

    // ---- 有符号位域符号扩展 ----
    var s = Signed.malloc()
    s.s = 7
    assert_eq(s.s, 7, "s = 7")
    s.s = -8                                  // 4 位补码 1000
    assert_eq(s.s, -8, "s = -8（符号扩展）")
    s.t = 3
    assert_eq(s.s, -8, "写 t 不影响 s")
    assert_eq(s.t, 3, "t = 3")

    // ---- 超宽写入按位截断 ----
    f.b = 7                                   // 只有 2 位
    assert_eq(f.b, 3, "写 7 进 2 位得 3")

    // ---- cstruct 数组里的位域元素 ----
    var arr = Flags.malloc_array(2)
    arr[0].a = 1
    arr[1].b = 3
    assert_eq(arr[0].a, 1, "元素 0 的 a")
    assert_eq(arr[0].b, 0, "元素 0 的 b 未被元素 1 影响")
    assert_eq(arr[1].b, 3, "元素 1 的 b")
    arr.free_all()

    f.free()
    s.free()
    print("test_cstruct_bitfield passed")
}
