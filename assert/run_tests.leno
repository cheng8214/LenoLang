// Leno 自举测试运行器
// 用法：build/leno assert/run_tests.leno [解释器] [测试目录]
//   Windows：build\leno.exe assert\run_tests.leno build\leno.exe assert
//   Linux/macOS：build/leno assert/run_tests.leno build/leno assert

import dirs
import strings

func get_arg(int idx, string fallback):string {
    var args = _args()
    if idx < args.len() {
        return args[idx]
    }
    return fallback
}

main() {
    // 默认解释器按平台取：Windows 为 build\leno.exe，其余为 build/leno
    var default_exe = dirs.join("build", "leno")
    if _os() == "windows" {
        default_exe = default_exe + ".exe"
    }
    var leno_exe = get_arg(0, default_exe)
    var test_dir = get_arg(1, "assert")

    // 将解释器转为绝对路径：Windows 下 _exec 用 cmd /c 执行，
    // cmd 无法解析 POSIX 风格的正斜杠相对路径（如 ./build/leno.exe），
    // 绝对路径（如 D:\...\build\leno.exe）才能被 cmd 正确执行。
    var leno_abs = dirs.abspath(leno_exe)
    if leno_abs != null {
        leno_exe = leno_abs
    }

    print("LenoC 自举测试运行器")
    print("解释器: " + leno_exe)
    print("测试目录: " + test_dir)
    print("========================================")

    // 测试前删除测试目录下所有 .lenocache 缓存文件夹，避免旧缓存导致测试结果不一致
    // _exec("cmd /c for /r \"" + test_dir + "\" %d in (.lenocache) do @if exist \"%d\" rmdir /s /q \"%d\" 2>nul")
    var caches = dirs.walk(test_dir)
    for caches to cw {
        var croot = cw.root
        var cdirs = cw.dirs
        for cdirs to cd {
            if cd == ".lenocache" {
                dirs.delete(dirs.join(croot, cd))
            }
        }
    }

    int passed = 0
    int failed = 0

    // 每个测试的超时（毫秒）。默认 120000（2 分钟）；可用 LENO_TEST_TIMEOUT_MS 覆盖，
    // 传 0 = 不限制（**不推荐**：一个挂死的测试会拖死整套 —— 这正是加它的原因）。
    var test_timeout_ms = 120000
    var tt_env = _env("LENO_TEST_TIMEOUT_MS")
    if tt_env != null {
        test_timeout_ms = _int(tt_env)
    }

    // walk 递归遍历子目录，每个 entry 是 DirEntry{ root, dirs, files }（v3.2.3 起）
    var walks = dirs.walk(test_dir)
    for walks to w {
        var root = w.root
        var files = w.files
        for files to entry {
            if strings.starts_with(entry, "test_") and strings.ends_with(entry, ".leno") {
                var full = dirs.abspath(dirs.join(root, entry))
                // 直接传绝对路径，system() 包装层处理 stderr
                var cmd = leno_exe + " " + full

            // 执行测试（不重试）；★ P6：带**超时** —— 一个挂死的测试曾把整套拖死 ✗
            var result = _exec(cmd, test_timeout_ms)

            // 判空用 `is` 而非 `== null`：native `_exec` 的失败路径确实返回 null（见 sys.c 各
            //   `val_null()`）⇒ 这里**不是**死代码；但它返回规格声明的是非可空 struct ExecResult，
            //   直接 `== null` 会被编译器误报「struct 与 null 比较」警告 ⇒
            //   `is ExecResult` 是等价的非空判据（实测：null ⇒ false、实值 ⇒ true）且不触发警告 ✓
            if not (result is ExecResult) {
                print("  [FAIL] " + entry + " - 执行失败")
                failed = failed + 1
            } else {
                var output = result.output
                var code = result.code

                if code != 0 {
                    if code == 124 {
                        print("  [FAIL] " + entry + " - 超时（" + test_timeout_ms + " ms，已被杀掉）")
                    } else {
                        print("  [FAIL] " + entry)
                    }
                    failed = failed + 1
                    if output != null and strings.len(_str(output)) > 0 {
                        var lines = strings.split(_str(output), "\n")
                        int shown = 0
                        for lines to line {
                            if shown >= 3 { break }
                            if strings.has(line, "错误") or strings.has(line, "error") {
                                print("         " + strings.trim(line))
                                shown = shown + 1
                            }
                        }
                    }
                } else {
                    print("  [PASS] " + entry)
                    passed = passed + 1
                }
            }
        }
    }
    }

    print("========================================")
    print("Results: " + passed + " passed, " + failed + " failed (total " + (passed + failed) + ")")

    if failed > 0 {
        _exit(1)
    }
}
