// Leno 自举测试运行器
// 用法：build\leno.exe assert\run_tests.leno [解释器] [测试目录]

import dirs
import strings

func get_arg(int idx, string fallback):string {
    var args = _args()
    if idx < args.len() {
        return args[idx]
    }
    return fallback
}

main() {
    var leno_exe = get_arg(0, "build\\leno.exe")
    var test_dir = get_arg(1, "assert")

    print("LenoC 自举测试运行器")
    print("解释器: " + leno_exe)
    print("测试目录: " + test_dir)
    print("========================================")

    int passed = 0
    int failed = 0

    // walk 递归遍历子目录，每个 entry 是 [root, [dirs], [files]]
    var walks = dirs.walk(test_dir)
    for walks to w {
        var root = w[0]
        var files = w[2]
        for files to entry {
            if strings.starts_with(entry, "test_") and strings.ends_with(entry, ".leno") {
                var full = root + "\\" + entry
                // 直接传绝对路径，system() 包装层处理 stderr
                var cmd = leno_exe + " " + full

            // 执行测试（不重试）
            var result = _exec(cmd)

            if result == null {
                print("  [FAIL] " + entry + " - 执行失败")
                failed = failed + 1
            } else {
                var output = result[0]
                var code = result[1]

                if code != 0 {
                    print("  [FAIL] " + entry)
                    failed = failed + 1
                    if output != null and strings.len(output) > 0 {
                        var lines = strings.split(output, "\n")
                        int shown = 0
                        for lines to line {
                            if shown >= 3 { break }
                            if strings.has(line, "错误") or strings.has(line, "error") {
                                print("         " + strings.trim(line))
                                shown = shown + 1
                            }
                        }
                    }
                } else {
                    print("  [PASS] " + entry)
                    passed = passed + 1
                }
            }
        }
    }
    }

    print("========================================")
    print("Results: " + passed + " passed, " + failed + " failed (total " + (passed + failed) + ")")

    if failed > 0 {
        _exit(1)
    }
}
