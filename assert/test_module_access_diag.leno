// 跨模块**成员访问**的诊断与写穿（2026-10-24 起，2026-10-25 补齐写侧）
//
//   N1 `m.var = v` / `m.var += v`  跨模块写导出变量
//      · 2026-10-24 之前：`m.var = v` 零报错零效果（codegen 的 gen_assign 根本没有模块
//        目标分支，连赋值指令都不发）；`m.var += v` 运行期报「下标赋值: 对象不支持索引」。
//        当时改成**编译期报错** + setter 处方（因为读的还是 exports 里的初始化副本）。
//      · 2026-10-24：读改成实时（OP_SET_MODULE_VAR 顺手同步 exports）。
//      · 2026-10-25：**写也打通了** —— `m.var = v` 编译成 OP_INDEX_SET(值, 模块对象, "名字")，
//        VM 按 module->export_mappings 写穿到 `module->globals[槽位]` 并同步 exports
//        ⇒ 模块内外的读写从此是同一份存储 ✓ 这里改成**正向用例**。
//        仍然拦：写 **const** 变量、写**非变量**成员、类型不匹配（三条都在下面）。
//
//   N2 `m.根本没有的名字`         ⇒ 编译期报「模块中没有成员」
//      改之前：静默返回 null（exit=0）；而"调用不存在的成员" `m.xxx()` 早就报错了。
//
//   N7 同一别名 import 两个模块   ⇒ 编译期报错（原来静默取第一个）
//
//   正向对照：导出的 setter/getter、跨模块改**容器的元素**、模块里根本没有的类型名
//   （cstruct 等）都必须照常通过 —— 防止把这几条做成"一刀切"。

import "helpers/compiler.leno" as ce
import dirs
import files

main() {
    var work = dirs.join(_tmpdir(), "leno_module_access_diag")
    dirs.delete(work)
    dirs.mkdir_p(work)

    // 被访问的模块：一个可变导出变量（三种访问形态）+ 一个未导出变量
    files.write(dirs.join(work, "mv.leno"), @"export var shared = 1
var SECRET = 42

export func get_shared(): int { return shared }
export func set_shared(int v) { shared = v }
")

    // ---- N1（2026-10-25 起）：跨模块写导出变量**现在真的能写**，且与模块内部同一份存储 ----
    var n1a = dirs.join(work, "write_var.leno")
    files.write(n1a, @"import ""mv.leno"" as m
main() {
    m.shared = 100
    // 模块内 getter 立刻看到（同一份存储）；外部读也是实时值
    print(""get="" + _str(m.get_shared()) + "" read="" + _str(m.shared))
}
")
    ce.expect_ok(n1a, "N1: 跨模块**赋值**导出变量生效（内外同一份存储）",
        "get=100 read=100")

    var n1b = dirs.join(work, "compound_write_var.leno")
    files.write(n1b, @"import ""mv.leno"" as m
main() {
    m.shared += 5
    print(""get="" + _str(m.get_shared()))
}
")
    ce.expect_ok(n1b, "N1: 跨模块**复合赋值**导出变量生效", "get=6")

    // ---- N1 负向①：const 变量不能跨模块写 ----
    files.write(dirs.join(work, "mc.leno"), @"export const K = 7
")
    var n1c = dirs.join(work, "write_const.leno")
    files.write(n1c, @"import ""mc.leno"" as m
main() {
    m.K = 8
}
")
    ce.expect_error(n1c, "N1 负向：写模块的 const 变量要编译期报错",
        "const 变量 'K' 赋值", 3)

    var n1d = dirs.join(work, "compound_write_const.leno")
    files.write(n1d, @"import ""mc.leno"" as m
main() {
    m.K += 1
}
")
    ce.expect_error(n1d, "N1 负向：复合赋值模块的 const 变量也要报错",
        "const 变量 'K' 做复合赋值", 3)

    // ---- N1 负向②：类型不匹配（模块变量的声明类型在提供端）----
    var n1e = dirs.join(work, "write_type_mismatch.leno")
    files.write(n1e, @"import ""mv.leno"" as m
main() {
    m.shared = ""oops""
}
")
    ce.expect_error(n1e, "N1 负向：写模块变量时类型不匹配要报错",
        "无法将值赋给模块变量", 3)

    // 正向：导出的 setter / getter 照常（这就是报错文案给的处方）
    var n1ok = dirs.join(work, "setter_ok.leno")
    files.write(n1ok, @"import ""mv.leno"" as m
main() {
    m.set_shared(100)
    print(""got="" + _str(m.get_shared()))
}
")
    ce.expect_ok(n1ok, "N1 正向：导出 setter/getter 照常改得动",
        "got=100")

    // ---- N2：读模块里**根本没有**的成员 ⇒ 编译期报错（原来静默 null）----
    var n2a = dirs.join(work, "missing_member.leno")
    files.write(n2a, @"import ""mv.leno"" as m
main() {
    print(_str(m.nosuchvar))
}
")
    ce.expect_error(n2a, "N2: 读模块里不存在的成员要编译期报错",
        "模块 'm' 中没有成员 'nosuchvar'", 3)

    // 正向对照：**未导出但存在**的变量走的是另一条（更早的）检查，仍然只报那一句
    var n2b = dirs.join(work, "noexport_member.leno")
    files.write(n2b, @"import ""mv.leno"" as m
main() {
    print(_str(m.SECRET))
}
")
    ce.expect_error(n2b, "N2 边界：未导出变量仍报「没有 export」而不是「没有成员」",
        "没有 export", 3)

    // ---- N7：同一别名 import 两个模块 ⇒ 编译期报错（原来静默取第一个）----
    files.write(dirs.join(work, "other.leno"), @"export func ping(): int { return 7 }
")
    var n7a = dirs.join(work, "dup_alias.leno")
    files.write(n7a, @"import ""mv.leno"" as m
import ""other.leno"" as m
main() {
    print(_str(m.ping()))
}
")
    ce.expect_error(n7a, "N7: 同一别名 import 两个模块要编译期报错",
        "模块别名 'm' 已被前面的 import 占用", 2)

    // 正向对照：同一模块被两次 import 成**不同别名**完全合法（等于共享同一份实例）
    var n7ok = dirs.join(work, "dup_import_ok.leno")
    files.write(n7ok, @"import ""mv.leno"" as a
import ""mv.leno"" as b
main() {
    a.set_shared(5)
    print(""a="" + _str(a.get_shared()) + "" b="" + _str(b.get_shared()))
}
")
    ce.expect_ok(n7ok, "N7 正向：同一模块两个别名共享同一份状态", "a=5 b=5")

    // ---- 正向：跨模块改**容器的元素**照常（引用语义，与"改变量"是两件事）----
    files.write(dirs.join(work, "cmod.leno"), @"export var items = [1, 2, 3]
export func get_items(): Array[int] { return items }
")
    var okarr = dirs.join(work, "mutate_elem_ok.leno")
    files.write(okarr, @"import ""cmod.leno"" as c
main() {
    c.get_items()[0] = 99
    print(_str(c.get_items()[0]))
}
")
    ce.expect_ok(okarr, "正向：跨模块改容器元素照常（引用语义）", "99")

    print("=== test_module_access_diag ALL passed ===")
}
