// 护栏（f7）：`try { … } finally { … }`（**无 catch**）里抛的异常必须继续向外抛，
//   不能被静默吞掉；finally 必须照常执行；异常文案/位置原样保留。
//
//   背景（2026-10-02 实测）：修前 codegen 一律发 `OP_TRY A=0`，把 **finally 块**登记成
//   catch handler ⇒ 异常被"当成已捕获"跳进 finally、随即被 `OP_FINALLY` 的
//   `vm.exception = val_null()` 清掉 ⇒ **整条异常消失**（外层 catch 根本不进、程序照常
//   往下跑）。旧二进制 aacb70b 同样如此 ⇒ 老 bug。
//   修法：`OP_TRY A=1` 表示"Bx 指向 finally 块"（登记成 finally handler、走 pending 语义），
//   无 catch 体时不再发"catch 块入口"那条 END_TRY；END_TRY 收尾处**原样**继续抛
//   （原来会换成"未捕获的异常"）。bump LENO_BIN_VERSION v3.2.11 / MODCACHE v27。
import arrays

func oneLevel(): int {
    try {
        throw "one-boom"          // ← 第 15 行（下面 ① 断言这个行号）
    } finally {
        print("  [one] finally 跑了")
    }
    return 0
}

func twoLevel(): int {
    try {
        try {
            throw "two-boom"
        } finally {
            print("  [two] 内层 finally 跑了")
        }
    } finally {
        print("  [two] 外层 finally 跑了")
    }
    return 0
}

func normalReturn(): int {
    try {
        return 7
    } finally {
        print("  [ret] finally 跑了")
    }
}

func returnInFinally(): int {
    try {
        throw "orig-ret"
    } finally {
        return 5              // return **覆盖**在飞异常（JS/Python 同语义）
    }
}

func loopFinally(): int {
    var i = 0
    var hits = 0
    while i < 3 {
        try {
            if i == 1 { throw "loop-boom" }
            hits = hits + 1
        } finally {
            i = i + 1
        }
    }
    return hits
}

func breakOutOfFinally(): int {
    var i = 0
    var out = 0
    while i < 3 {
        i = i + 1
        try {
            if i == 1 { throw "discarded-by-break" }
            out = out + 10
        } finally {
            break                 // break 覆盖在飞异常 ⇒ 丢掉，循环直接结束
        }
    }
    return out                    // 0：第一轮就跳出，且异常被丢弃
}

func continueOutOfFinally(): int {
    var i = 0
    var n = 0
    while i < 3 {
        try {
            i = i + 1
            throw "discarded-by-continue"
        } finally {
            continue              // 每轮的异常都被丢弃（否则第一轮就该上抛）
        }
        n = n + 100
    }
    return n                      // 0：`continue` 跳过了 n 自增
}

func afterBreakStale(): int {
    var i = 0
    while i < 1 {
        i = i + 1
        try {
            throw "first"
        } finally {
            break
        }
    }
    throw "after-loop"            // 上一轮的异常已丢弃 + try 注册已注销 ⇒ 只有这条上抛
    return 0
}

main() {
    // ① 基本：异常原样上抛 + finally 执行
    var c1 = false
    try {
        oneLevel()
    } catch e {
        c1 = true
        assert_eq(_str(e.msg), "one-boom", "异常文案必须原样保留（修前整条被吞）")
        assert_eq(_int(e.line), 15, "位置应指向 throw 那行（本文件第 15 行）")
    }
    assert_eq(c1, true, "try/finally 里的异常必须向外抛")

    // ② 两层 finally：都执行，异常仍上抛
    var c2 = false
    try {
        twoLevel()
    } catch e {
        c2 = true
        assert_eq(_str(e.msg), "two-boom")
    }
    assert_eq(c2, true)

    // ③ 正常路径不受影响：return 照常、finally 照跑
    assert_eq(normalReturn(), 7)

    // ④ 回调里的 try/finally 抛异常同样要上抛（宿主边界 + finally 叠加）
    var a = [1, 2, 3]
    var c4 = false
    try {
        var r = a.map(func(int x, int i): int {
            try {
                if x == 1 { throw "cb-finally" }
                return x
            } finally {
                print("  [cb] finally 跑了 x=" + _str(x))
            }
            return 0
        })
        print("④ map 不该正常返回，结果=" + _str(r))
    } catch e {
        c4 = true
        assert_eq(_str(e.msg), "cb-finally")
    }
    assert_eq(c4, true)

    // ⑤ finally 里 `return`：覆盖在飞异常、正常返回，且**不许泄漏**到调用方
    //    （修法（三）之前它会泄漏出去，在调用方的 END_TRY 处变成"未捕获的异常"直接终止）
    var c5 = false
    var r5 = 0
    try {
        r5 = returnInFinally()
        c5 = true
    } catch e {
        print("⑤ 不该进 catch: " + e.msg)
    }
    assert_eq(c5, true, "finally 里的 return 应覆盖异常、正常返回")
    assert_eq(r5, 5)

    // ⑥ 循环里的 try/finally：异常必须能穿过循环（修前被静默吞掉、循环照常跑完）
    var c6 = false
    try {
        var h = loopFinally()
        print("⑥ 不该正常返回 h=" + _str(h))
    } catch e {
        c6 = true
        assert_eq(_str(e.msg), "loop-boom")
    }
    assert_eq(c6, true)

    // ⑦ finally 里 `throw`：覆盖原异常（既有文档语义，别被这次改动弄丢）
    var c7 = false
    try {
        try {
            throw "orig"
        } finally {
            throw "from-finally"
        }
    } catch e {
        c7 = true
        assert_eq(_str(e.msg), "from-finally")
    }
    assert_eq(c7, true)

    // ⑧⑨ finally 体内 break/continue 跳出：在飞异常被**丢弃**（JS/Python 同语义）
    assert_eq(breakOutOfFinally(), 0, "break 应丢弃在飞异常、直接跳出循环")
    assert_eq(continueOutOfFinally(), 0, "continue 应丢弃在飞异常、回到循环头")

    // ⑩ 同时 try 注册必须注销：跳出 finally 之后同一帧里再抛，必须正常上抛
    //    （修前 pending 泄漏 ⇒ 要么旧异常冒出来、要么跳回已跑完的 finally 块）
    var c10 = false
    try {
        afterBreakStale()
    } catch e {
        c10 = true
        assert_eq(_str(e.msg), "after-loop", "跳出 finally 后应只上抛新异常（旧异常已丢弃）")
    }
    assert_eq(c10, true)

    print("test_try_finally_rethrow passed")
}
