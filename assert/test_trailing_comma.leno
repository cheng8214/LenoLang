// 字面量的**尾随逗号**（B3）—— 回归
//
// 背景（实录 B3）：`new SongInfo(a = 1,)` 报「期望字段名」（列号指向 `)`），
//   `[a, b,]` 报「期望表达式」—— 两处都**指不到真病因**（那个逗号）。
//   多行初始化时顺手留一个尾随逗号是极自然的写法，多数语言都允许，
//   所以"支持它"比"只改文案"更值（成本也就是几行）。
//
// 判据：四种形态都要能编译并跑对（数组 / 字典 / new / 调用实参），
//   且**常规写法一字不变**（含空容器这类边界）。

struct P {
    int x = 0
    int y = 0
}

func sum3(int a, int b, int c): int { return a + b + c }

main() {
    // ---------- ① 数组 ----------
    var a = [1, 2, 3,]
    assert_eq(a.len(), 3, "①数组 + 尾随逗号")
    var a1 = [1,]
    assert_eq(a1.len(), 1, "①单元素 + 尾随逗号")
    var a2 = [[1, 2,], [3,],]
    assert_eq(a2.len(), 2, "①嵌套（内外都有尾随逗号）")
    assert_eq(a2[0].len(), 2, "①嵌套的内层长度")

    // ---------- ② 字典 ----------
    var d = {"a": 1, "b": 2,}
    assert_eq(d.len(), 2, "②字典 + 尾随逗号")
    var d1 = {"only": 1,}
    assert_eq(d1.len(), 1, "②单键 + 尾随逗号")

    // ---------- ③ new 的字段表 ----------
    P p = new P(x = 1, y = 2,)
    assert_eq(p.x + p.y, 3, "③new + 尾随逗号")

    // ---------- ④ 调用实参 ----------
    assert_eq(sum3(1, 2, 3,), 6, "④调用实参 + 尾随逗号")

    // ---------- ⑤ 守卫：常规写法不受影响 ----------
    var b = [1, 2, 3]
    assert_eq(b.len(), 3, "⑤常规数组")
    var dd = {"a": 1}
    assert_eq(dd.len(), 1, "⑤常规字典")
    P q = new P(x = 5)
    assert_eq(q.x, 5, "⑤常规 new")
    assert_eq(sum3(1, 2, 3), 6, "⑤常规调用")
    var e = []
    assert_eq(e.len(), 0, "⑤空数组")
    var f = {}
    assert_eq(f.len(), 0, "⑤空字典")

    print("test_trailing_comma passed")
}
