// struct 边界测试：自递归、接口、链式访问、深层嵌套、null 安全
// 修复：OP_*_INT_IMM 对 null 值比较返回错误结果的 bug

// ============================================================
// 1. 自递归 struct 基础：链式构建和读取
// ============================================================
struct Node {
    int id
    string name = ""
    Array[Node] children = []
}

func test_self_recursive_basic() {
    Node root = new Node(); root.id = 1; root.name = "root"
    Node c1 = new Node(); c1.id = 2; c1.name = "child1"
    Node c2 = new Node(); c2.id = 3; c2.name = "child2"
    Node gc1 = new Node(); gc1.id = 4; gc1.name = "grandchild1"

    root.children.add(c1)
    root.children.add(c2)
    c1.children.add(gc1)

    // 常量下标访问
    assert_eq(root.children[0].id, 2)
    assert_eq(root.children[0].name, "child1")
    assert_eq(root.children[1].id, 3)
    assert_eq(root.children[0].children[0].id, 4)
    assert_eq(root.children[0].children[0].name, "grandchild1")

    // 循环下标访问
    int total = 0
    for root.children.len() to i {
        total = total + root.children[i].id
    }
    assert_eq(total, 5)  // 2 + 3

    print("[1] self_recursive_basic passed")
}

// ============================================================
// 2. 自递归 struct + 递归函数搜索
// ============================================================
func findNode(Node n, int id): Node {
    if n.id == id { return n }
    for n.children.len() to i {
        Node found = findNode(n.children[i], id)
        if found.id != null { return found }
    }
    Node e = new Node(); return e
}

func countNodes(Node n): int {
    int c = 1
    for n.children.len() to i {
        c = c + countNodes(n.children[i])
    }
    return c
}

func test_self_recursive_search() {
    Node root = new Node(); root.id = 1
    Node c1 = new Node(); c1.id = 2
    Node c2 = new Node(); c2.id = 3
    Node gc1 = new Node(); gc1.id = 4
    root.children.add(c1); root.children.add(c2)
    c1.children.add(gc1)

    Node found = findNode(root, 4)
    assert_eq(found.id, 4)
    assert_eq(found.name, "")

    Node notFound = findNode(root, 99)
    assert_eq(notFound.id, null)  // 空节点 id=null

    assert_eq(countNodes(root), 4)

    print("[2] self_recursive_search passed")
}

// ============================================================
// 3. 自递归 struct 的写回验证（引用语义）
// ============================================================
func setNodeName(Node n, int id, string name) {
    if n.id == id { n.name = name; return }
    for n.children.len() to i {
        setNodeName(n.children[i], id, name)
    }
}

func test_self_recursive_writeback() {
    Node root = new Node(); root.id = 1
    Node c1 = new Node(); c1.id = 2
    Node c2 = new Node(); c2.id = 3
    root.children.add(c1); root.children.add(c2)

    // 通过递归函数写
    setNodeName(root, 2, "modified")
    assert_eq(c1.name, "modified")
    assert_eq(root.children[0].name, "modified")

    // 通过返回值写
    Node found = findNode(root, 3)
    found.name = "also_modified"
    assert_eq(c2.name, "also_modified")
    assert_eq(root.children[1].name, "also_modified")

    print("[3] self_recursive_writeback passed")
}

// ============================================================
// 4. struct + face（接口）+ 不同 struct 存同一数组
// ============================================================
face INode {
    func get_id(): int
    func get_label(): string
}

struct FileNode impl INode {
    int _id
    string _label = ""

    func get_id(): int { return _id }
    func get_label(): string { return _label }
}

struct DirNode impl INode {
    int _id
    string _label = ""
    Array[INode] _items = []

    func get_id(): int { return _id }
    func get_label(): string { return _label }
}

func test_struct_face_recursive() {
    FileNode f1 = new FileNode(); f1._id = 10; f1._label = "file1"
    FileNode f2 = new FileNode(); f2._id = 20; f2._label = "file2"
    DirNode dir = new DirNode(); dir._id = 1; dir._label = "dir"

    dir._items.add(f1)
    dir._items.add(f2)

    // 直接用具体类型访问
    assert_eq(f1.get_id(), 10)
    assert_eq(f1.get_label(), "file1")
    assert_eq(dir.get_label(), "dir")

    // 通过 face 类型变量
    INode n1 = f1
    INode n2 = f2
    assert_eq(n1.get_id(), 10)
    assert_eq(n2.get_id(), 20)

    print("[4] struct_face_recursive passed")
}

// ============================================================
// 5. 深层嵌套自递归（用 Array 代替 Link 避免空链式访问）
// ============================================================
func treeDepth(Node n): int {
    if n.children.len() == 0 { return 1 }
    int max_d = 0
    for n.children.len() to i {
        int d = treeDepth(n.children[i])
        if d > max_d { max_d = d }
    }
    return max_d + 1
}

func test_deep_nesting() {
    // 构建深度5的链
    Node n1 = new Node(); n1.id = 1
    Node n2 = new Node(); n2.id = 2
    Node n3 = new Node(); n3.id = 3
    Node n4 = new Node(); n4.id = 4
    Node n5 = new Node(); n5.id = 5
    n1.children.add(n2); n2.children.add(n3)
    n3.children.add(n4); n4.children.add(n5)

    assert_eq(treeDepth(n1), 5)

    // 深层修改
    Node deep = findNode(n1, 5)
    deep.name = "deepest"
    assert_eq(n5.name, "deepest")

    // 从深到浅写回
    n4.children[0].id = 99
    assert_eq(n5.id, 99)

    print("[5] deep_nesting passed")
}

// ============================================================
// 6. null 字段比较安全性（修复的核心 bug）
// ============================================================
struct Item {
    int id
    bool active
    float score = 0.0
}

func findActiveItem(Array[Item] list, int id): Item {
    for list.len() to i {
        if list[i].id == id { return list[i] }
    }
    Item e = new Item(); return e  // 空项：id=null, active=null
}

func test_null_field_compare() {
    Array[Item] items = []
    Item a = new Item(); a.id = 1; a.active = true
    Item b = new Item(); b.id = 2; b.active = false
    items.add(a); items.add(b)

    // 找到存在的项
    Item found = findActiveItem(items, 1)
    assert_eq(found.id, 1)

    // 找不到时返回空 Item，其 id=null
    Item notFound = findActiveItem(items, 99)
    assert_eq(notFound.id, null)

    // 关键测试：null 与 int 的比较不应该返回 true
    // 修复前：null >= 0 = true（val_as_int(null)=0, 0>=0=true）
    // 修复后：null >= 0 = false
    assert_eq(notFound.id >= 0, false)
    assert_eq(notFound.id > 0, false)
    assert_eq(notFound.id < 0, false)
    assert_eq(notFound.id <= 0, false)
    assert_eq(notFound.id == 0, false)

    // 正常 int 的比较不受影响
    assert_eq(found.id >= 0, true)
    assert_eq(found.id > 0, true)
    assert_eq(found.id == 1, true)

    print("[6] null_field_compare passed")
}

// ============================================================
// 7. 自递归 struct 方法
// ============================================================
struct Tree {
    int value = 0
    Array[Tree] subs = []

    func add_child(int v): Tree {
        Tree child = new Tree(); child.value = v
        subs.add(child)
        return child
    }

    func depth(): int {
        if subs.len() == 0 { return 1 }
        int max_d = 0
        for subs.len() to i {
            int d = subs[i].depth()
            if d > max_d { max_d = d }
        }
        return max_d + 1
    }

    func sum(): int {
        int s = value
        for subs.len() to i {
            s = s + subs[i].sum()
        }
        return s
    }
}

func test_self_recursive_methods() {
    Tree t = new Tree(); t.value = 1
    Tree c1 = t.add_child(2)
    Tree c2 = t.add_child(3)
    c1.add_child(4)
    c1.add_child(5)
    c2.add_child(6)

    assert_eq(t.depth(), 3)  // root -> c1 -> gc1
    assert_eq(t.sum(), 21)   // 1+2+3+4+5+6

    print("[7] self_recursive_methods passed")
}

// ============================================================
// 8. 跨函数传递自递归 struct 数组
// ============================================================
func filterById(Array[Node] list, int minId): Array[Node] {
    Array[Node] result = []
    for list.len() to i {
        if list[i].id >= minId {
            result.add(list[i])
        }
    }
    return result
}

func mapNames(Array[Node] list): Array[string] {
    Array[string] names = []
    for list.len() to i {
        names.add(list[i].name)
    }
    return names
}

func test_cross_function_array() {
    Node a = new Node(); a.id = 1; a.name = "a"
    Node b = new Node(); b.id = 2; b.name = "b"
    Node c = new Node(); c.id = 3; c.name = "c"
    Array[Node] nodes = [a, b, c]

    Array[Node] filtered = filterById(nodes, 2)
    assert_eq(filtered.len(), 2)
    assert_eq(filtered[0].name, "b")
    assert_eq(filtered[1].name, "c")

    Array[string] names = mapNames(filtered)
    assert_eq(names[0], "b")
    assert_eq(names[1], "c")

    // 验证引用语义：修改原节点影响过滤结果
    b.name = "b_modified"
    assert_eq(filtered[0].name, "b_modified")

    print("[8] cross_function_array passed")
}

// ============================================================
// 9. struct 实现多个 face
// ============================================================
face Printable {
    func format(): string
}

face Countable {
    func count(): int
}

struct Bag impl Printable, Countable {
    Array[string] items = []

    func add(string s) { items.add(s) }
    func format(): string { return "Bag(" + _int(items.len()) + ")" }
    func count(): int { return items.len() }
}

func test_multi_face() {
    Bag bag = new Bag()
    bag.add("x"); bag.add("y"); bag.add("z")

    // 直接调用
    assert_eq(bag.count(), 3)
    assert_eq(bag.format(), "Bag(3)")

    // face 类型变量
    Printable p = bag
    assert_eq(p.format(), "Bag(3)")

    Countable c = bag
    assert_eq(c.count(), 3)

    // 修改后 face 变量也更新
    bag.add("w")
    assert_eq(c.count(), 4)

    print("[9] multi_face passed")
}

// ============================================================
// 10. 自递归 struct 的 setFlag + get 经典场景（原始 bug）
// ============================================================
struct RecN { int id; bool flag; Array[RecN] kids = [] }
Array[RecN] globalList = []

func recSetFlag(int id, bool v) {
    for globalList.len() to i {
        if globalList[i].id == id { globalList[i].flag = v; return }
        recSetFlagIn(globalList[i].kids, id, v)
    }
}

func recSetFlagIn(Array[RecN] list, int id, bool v) {
    for list.len() to i {
        if list[i].id == id { list[i].flag = v; return }
        recSetFlagIn(list[i].kids, id, v)
    }
}

func recGet(int id): RecN {
    for globalList.len() to i {
        if globalList[i].id == id { return globalList[i] }
        RecN c = recFindIn(globalList[i].kids, id)
        if c.id != null { return c }
    }
    RecN e = new RecN(); return e
}

func recFindIn(Array[RecN] list, int id): RecN {
    for list.len() to i {
        if list[i].id == id { return list[i] }
        RecN c = recFindIn(list[i].kids, id)
        if c.id != null { return c }
    }
    RecN e = new RecN(); return e
}

func test_original_bug() {
    RecN a = new RecN(); a.id = 1
    RecN a1 = new RecN(); a1.id = 2; a.kids.add(a1)
    RecN b = new RecN(); b.id = 3
    globalList.add(a); globalList.add(b)

    // 初始状态：flag 均为 null
    assert_eq(globalList[1].flag, null)

    // 设置 flag
    recSetFlag(3, true)
    assert_eq(globalList[1].flag, true)

    // 通过 get 获取并验证
    RecN result = recGet(3)
    assert_eq(result.id, 3)
    assert_eq(result.flag, true)  // 修复前这里返回 null

    // 修改返回值，验证引用语义
    result.flag = false
    assert_eq(globalList[1].flag, false)

    print("[10] original_bug passed")
}

// ============================================================
// 运行所有测试
// ============================================================
main() {
    test_self_recursive_basic()
    test_self_recursive_search()
    test_self_recursive_writeback()
    test_struct_face_recursive()
    test_deep_nesting()
    test_null_field_compare()
    test_self_recursive_methods()
    test_cross_function_array()
    test_multi_face()
    test_original_bug()

    print("=== ALL struct edge tests passed ===")
}
