// 换行后的行首 `(` 不能被并进上一行（2026-10-24，第四轮报告 B6）
//
// 修前：
//     var a = 1
//     (a)++            ⇒ 被吞成 `1(a)++` ⇒ 报「变量 a 在初始化前使用」
//     var a = 1
//     (a)              ⇒ 同样报错
// 判据：中缀 `(` 只在**与左表达式最后 token 同行**时才当调用
//   —— 与 parse_postfix_inc_dec（后缀 `++`/`--`）同一规则、同一理由（JS restricted production）。
//
// 为什么这么选（对照其他语言）：
//   · JS  —— 继续当调用（ASI 只在"不能续接"时插分号）⇒ 经典坑，只能靠强制分号规避
//   · Go  —— 行尾是字面量/标识符就自动插分号 ⇒ 正确
//   · Swift / Kotlin / Python —— 换行即语句结束 ⇒ 正确
//   · Rust —— 必须显式分号，否则报错 ⇒ 从不静默误解
//   Leno 不吃分号、与 JS 同构 ⇒ 必须走 Go/Swift 那条路，而 Leno 对 `++` 早已这么做。

func add(int a, int b): int {
    return a + b
}

main() {
    // ① 行首 (a)++ 算新语句
    var a = 1
    (a)++
    assert_eq(a, 2)

    // ② 行首 (a) 算新语句（不并进 `var a = ...`）
    var b = 10
    (b)
    assert_eq(b, 10)

    // ③ 多行实参：`(` 与函数名同行 ⇒ 照旧
    assert_eq(add(
        20,
        22
    ), 42)

    // ④ 同行调用照旧
    assert_eq(add(1, 2), 3)

    // ⑤ 分号分隔照旧
    var c = 1; (c)++
    assert_eq(c, 2)

    // ⑥ 多行分组表达式不受影响
    var d = (
        1 +
        2
    )
    assert_eq(d, 3)
}
