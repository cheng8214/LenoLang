// 数组索引复合赋值测试
// 复合赋值运算符（+= -= *= /= %= &= |= ^= <<= >>=）支持数组索引

main()
{
    // ===== 直接写法测试 =====

    // 测试1: arr[i] += n
    var arr1 = [10, 20, 30]
    arr1[0] += 5
    assert_eq(arr1[0], 15)

    // 测试2: arr[i] -= n
    var arr2 = [100, 200, 300]
    arr2[1] -= 50
    assert_eq(arr2[1], 150)

    // 测试3: arr[i] *= n
    var arr3 = [2, 4, 6]
    arr3[2] *= 3
    assert_eq(arr3[2], 18)

    // 测试4: arr[i] /= n
    var arr4 = [10, 20, 30]
    arr4[0] /= 3
    assert_eq(arr4[0], 3)

    // 测试5: arr[i] %= n
    var arr5 = [7, 14, 21]
    arr5[1] %= 5
    assert_eq(arr5[1], 4)

    // 测试6: arr[i] &= n（位与）
    var arr6 = [0xFF, 0xAB, 0xCD]
    arr6[0] &= 0x0F
    assert_eq(arr6[0], 0x0F)

    // 测试7: arr[i] |= n（位或）
    var arr7 = [0x0F, 0x00, 0xF0]
    arr7[1] |= 0xAA
    assert_eq(arr7[1], 0xAA)

    // 测试8: arr[i] ^= n（位异或）
    var arr8 = [0xFF, 0x0F, 0xF0]
    arr8[2] ^= 0xFF
    assert_eq(arr8[2], 0x0F)

    // 测试9: arr[i] <<= n（左移）
    var arr9 = [1, 2, 4]
    arr9[0] <<= 3
    assert_eq(arr9[0], 8)

    // 测试10: arr[i] >>= n（右移）
    var arr10 = [16, 32, 64]
    arr10[1] >>= 2
    assert_eq(arr10[1], 8)

    // 测试11: 变量索引的复合赋值
    var arr11 = [0, 0, 0, 0, 0]
    int idx = 2
    arr11[idx] += 10
    assert_eq(arr11[2], 10)

    // 测试12: 循环中的复合赋值（频率统计场景）
    var freq = [0, 0, 0, 0, 0]
    var data = [2, 1, 3, 2, 0, 4, 2, 1]
    for data.len() to n {
        int i = _int(data[n])
        freq[i] += 1
    }
    assert_eq(freq[0], 1)
    assert_eq(freq[1], 2)
    assert_eq(freq[2], 3)
    assert_eq(freq[3], 1)
    assert_eq(freq[4], 1)

    // 测试13: 连续复合赋值
    var arr13 = [10, 20, 30]
    arr13[0] += 5
    arr13[0] *= 2
    assert_eq(arr13[0], 30)

    // 测试14: 表达式索引
    var arr14 = [0, 0, 0, 0, 0]
    int base = 1
    arr14[base + 1] += 7
    assert_eq(arr14[2], 7)

    print("test_compound_assign_array_index passed")
}
