// 取模运算测试

main()
{
    // 测试1: 基本取模
    assert_eq(10 % 3, 1)
    assert_eq(17 % 5, 2)
    assert_eq(20 % 4, 0)

    // 测试2: 负数取模
    assert_eq(-10 % 3, -1)
    assert_eq(10 % -3, 1)
    assert_eq(-10 % -3, -1)

    // 测试3: 大数取模
    var big = 100000000000000000000
    assert_eq(big % 3, 1)
    // 100000000000000000000 % 7 = 2（已验证）
    assert_eq(big % 7, 2)

    // 测试4: 复合赋值 %=
    var x = 10
    x %= 3
    assert_eq(x, 1)

    // 测试5: 取模与除法结合
    var dividend = 17
    var divisor = 5
    var quotient = dividend / divisor   // 3 (整数除法)
    var remainder = dividend % divisor  // 2
    assert_eq(quotient * divisor + remainder, dividend)

    // 测试6: BigInt 取模
    var big1 = 1267650600228229401496703205376  // 2^100
    assert_eq(big1 % 1000000007, 976371285)
    var big2 = 10000000000000000000
    assert_eq(big2 % 97, 17)

    // 测试7: 常量折叠取模（大数）
    assert_eq(10000000000 % 7, 4)
    assert_eq(999999999999 % 13, 0)

    print("test_modulo passed")
}
