// test_diag_static_errors.leno —— 诊断补全回归（B3/B4/B5/C1/C2/D1/D2/D3/D6）
//
// 此前这九类手误全部**静默通过**或**无提示**，修复后应编译期报错/警告/给出相似名建议：
//   B3  break/continue 在循环外 → 静默通过（编译不报错、运行期什么都不做）
//   B4  重复参数名 func f(int a, int a) → scope_define 静默覆盖，后者遮蔽前者
//   B5  struct 重复字段 → 静默取前者，后者被丢弃
//   C1  方法名拼错（内置类型/用户 struct）→ 只报"没有方法"，无相似名建议
//   C2  函数名拼错 → 只报"未定义函数"，无相似名建议（变量拼错早有提示，不一致）
//   D1  模块名拼错 → 只报"未定义的模块或变量"，无相似名建议（内置模块 + 已导入别名）
//   D2  if/while 条件中赋值（if x = 5，C 经典坑）→ 静默通过，赋值永真且改写变量 → 警告
//   D3  for x in arr（Python 遍历习惯）→ 被当条件循环（in 是成员测试），报误导的
//       "未定义变量 x" → 补 [for头成员测试] 警告给出遍历写法 'for x to arr'
//   D6  var x: 类型（TS/Kotlin 标注习惯）→ 报离谱的"声明语句后"级联 → 改报明确写法指引
//   E1  "abc".pad_start（字符串字面量的字符串下标 = 漏括号的方法引用）→ 此前运行期才抛
//       「字符串索引必须是数字」→ 编译期拦截并给两种正确写法（数字下标 / 加括号）
//   D7  var (a, b) = ...（Python 的"一行声明多个"习惯）→ 此前报「期望变量名」（`(` 被当表达式
//       开头 ⇒ 落点是那个括号、看不出真因）→ 改报「解构声明必须写形状」（var[]/var[...]），
//       并点出 `a, b = ...` 是**并行赋值**（只能改已存在的变量，不能声明新的）
//
// 另含四条**不得误伤**的正向用例：循环内的 break/continue 合法；
// 无效转义 \q 保持"按原样保留"的宽松行为；in 成员测试表达式照常工作；
// 前置类型声明 int? a = null 不受 D6 拦截影响。

import "helpers/compiler.leno" as ce
import dirs
import files
import strings

main() {
    var work = dirs.join(_tmpdir(), "leno_diag_static_errors")
    dirs.delete(work)
    dirs.mkdir_p(work)

    // ---- B3：break / continue 在循环外 ----
    var b1 = dirs.join(work, "break_outside.leno")
    files.write(b1, @"main() {
    break
}
")
    ce.expect_error(b1, "break 在循环外要报错", "'break' 不能用在循环外", 2)

    var b2 = dirs.join(work, "continue_outside.leno")
    files.write(b2, @"func f():int {
    continue
    return 1
}
")
    ce.expect_error(b2, "continue 在循环外要报错", "'continue' 不能用在循环外", 2)

    // B3 反向：闭包体内的 break 不得借用外层循环（函数边界隔离）
    var b3 = dirs.join(work, "break_in_closure.leno")
    files.write(b3, @"main() {
    var f = func():int {
        break
        return 0
    }
    f()
}
")
    ce.expect_error(b3, "闭包体内的 break 不属于外层循环", "'break' 不能用在循环外", 3)

    // ---- B4：重复参数名 ----
    var d1 = dirs.join(work, "dup_param.leno")
    files.write(d1, @"func f(int a, int a):int { return a }
main() {
    print(f(1, 2))
}
")
    ce.expect_error(d1, "重复参数名要报错", "重复的参数名 'a'（参数 1 与参数 2 重名）", 1)

    // ---- B5：struct 重复字段 ----
    var d2 = dirs.join(work, "dup_field.leno")
    files.write(d2, @"struct P {
    int x = 0
    int x = 1
}
main() {
    var p = new P()
    print(p.x)
}
")
    // 落点在 struct 声明行（预注册阶段无逐字段行号）
    ce.expect_error(d2, "重复字段名要报错", "struct 'P' 存在重复字段 'x'", 1)

    // ---- C1：方法名拼错给相似名建议 ----
    var m1 = dirs.join(work, "method_typo_builtin.leno")
    files.write(m1, @"main() {
    var s = ""abc""
    print(s.to_uppr())
}
")
    ce.expect_error(m1, "内置类型方法拼错给建议", "是否想用 'to_upper'？", 0)

    var m2 = dirs.join(work, "method_typo_struct.leno")
    files.write(m2, @"struct Box {
    int v = 0
    func sttore(int x) { self.v = x }
}
main() {
    var b = new Box()
    b.stor(1)
}
")
    ce.expect_error(m2, "用户 struct 方法拼错给建议", "是否想用 'sttore'？", 0)

    // ---- C2：函数名拼错给相似名建议 ----
    var f1 = dirs.join(work, "func_typo.leno")
    files.write(f1, @"main() {
    prnt(""hello"")
}
")
    ce.expect_error(f1, "函数名拼错给建议（print 为内置）", "是否想输入 'print'？", 0)

    // ---- D1：模块名拼错给相似名建议（内置模块名）----
    var f2 = dirs.join(work, "module_typo_builtin.leno")
    files.write(f2, @"main() {
    print(stringd.trim(""  a  ""))
}
")
    ce.expect_error(f2, "内置模块名拼错给建议", "是否想用 'strings'？", 0)

    // D1 已导入别名路径：拼错已导入的模块名也要有建议
    var f3 = dirs.join(work, "module_typo_alias.leno")
    files.write(f3, @"import strings
main() {
    print(stringsd.trim(""  a  ""))
}
")
    ce.expect_error(f3, "已导入模块名拼错给建议", "是否想用 'strings'？", 0)

    // ---- D2：if 条件中赋值 → 警告（程序照常运行，不阻断）----
    var f4 = dirs.join(work, "assign_in_if.leno")
    files.write(f4, @"main() {
    var x = 0
    if x = 5 {
        print(""five"")
    }
    print(x)
}
")
    // 行为保持：赋值表达式以写入的值作为条件 → 打印 five 和 5；新增警告指明疑似漏写 ==
    ce.expect_ok(f4, "if 条件中赋值出警告不阻断", "[条件中的赋值]")

    // ---- D3：for 头的 'x in arr' → 警告给出遍历写法 ----
    var f5 = dirs.join(work, "for_in_cond.leno")
    files.write(f5, @"main() {
    var x = 0
    // 0 不在 [1,2,3] 中 → 条件循环体不执行（合法但几乎必是误用）
    for x in [1, 2, 3] {
        print(""body"")
    }
    print(""OK"")
}
")
    ce.expect_ok(f5, "for 头成员测试出警告不阻断", "[for头成员测试]")

    // ---- D6：'var x: 类型' 标注 → 明确写法指引（不再报"声明语句后"级联）----
    var f6 = dirs.join(work, "colon_annotation.leno")
    files.write(f6, @"main() {
    var x: int = 5
    print(x)
}
")
    ce.expect_error(f6, "冒号类型标注报写法指引", "不支持 'var 名字: 类型' 标注写法", 2)

    // ---- E1/E2/E5：跨模块 use 诊断 ----
    // E1: use 符号名拼错 → 在模块符号表所有名字桶里找相似
    var f7 = dirs.join(work, "use_symbol_typo.leno")
    files.write(f7, @"export struct Point {
    int x = 0
}
")
    var f8 = dirs.join(work, "use_symbol_typo_host.leno")
    files.write(f8, @"import ""use_symbol_typo.leno"" as m
use m.Ponit
main() {
    print(""ok"")
}
")
    ce.expect_error(f8, "use 符号名拼错给建议", "是否想用 'Point'？", 0)

    // E2: use 的模块别名拼错 → 在已导入别名里找相似
    var f9 = dirs.join(work, "use_module_typo_host.leno")
    files.write(f9, @"import ""use_symbol_typo.leno"" as m
use md.Point
main() {
    print(""ok"")
}
")
    ce.expect_error(f9, "use 模块别名拼错给建议", "是否想用 'm'？", 0)

    // E5: 漏 use 裸用模块导出类型 → 提示 use 写法
    var f10 = dirs.join(work, "missing_use_host.leno")
    files.write(f10, @"import ""use_symbol_typo.leno"" as m
main() {
    var p = new Point()
    print(p)
}
")
    ce.expect_error(f10, "漏 use 裸用导出类型给 use 指引", "请先 'use m.Point' 导入后裸名使用", 0)

    // ---- F1：var 声明列表部分初值 → 警告（Python 多重赋值习惯，静默产出 null）----
    var f11 = dirs.join(work, "partial_init.leno")
    files.write(f11, @"main() {
    var a, b = 1, 2
    print(""a="" + _str(a))
    print(""b="" + _str(b))
}
")
    // 行为保持（a=null, b=1）但新增警告指明多重赋值不支持
    var out11 = ce.expect_ok(f11, "部分初值声明出警告不阻断", "[部分初值声明]")
    assert_eq(strings.has(out11, "a=null"), true, "部分初值警告不应改变运行行为（a 仍为 null）")

    // 正向：全无初值 / 全有初值都合法，不得误伤
    var ok5 = dirs.join(work, "decl_all_no_init.leno")
    files.write(ok5, @"main() {
    var a, b
    a = 1
    b = 2
    print(a + b)
}
")
    var out5 = ce.expect_ok(ok5, "全无初值多声明合法", "3")
    assert_eq(strings.has(out5, "[部分初值声明]"), false, "全无初值不应出部分初值警告")

    var ok6 = dirs.join(work, "decl_all_init.leno")
    files.write(ok6, @"main() {
    var a = 1, b = 2
    print(a + b)
}
")
    var out6 = ce.expect_ok(ok6, "全有初值多声明合法", "3")
    assert_eq(strings.has(out6, "[部分初值声明]"), false, "全有初值不应出部分初值警告")

    // ---- F4：0x 后无数字此前静默按 0 解析 → 响亮报错（与 0b 对称）----
    var f12 = dirs.join(work, "hex_empty.leno")
    files.write(f12, @"main() {
    var x = 0x
    print(x)
}
")
    ce.expect_error(f12, "0x 空数字报错不静默", "十六进制字面量需要 0x 后跟至少一位十六进制数字", 2)

    // ---- G1：枚举成员拼错 → 在成员名列表找相似 ----
    var f13 = dirs.join(work, "enum_member_typo.leno")
    files.write(f13, @"enum Color {
    RED = 1
    GREEN = 2
}
main() {
    var c = Color.REDD
    print(c)
}
")
    ce.expect_error(f13, "枚举成员拼错给建议", "是否想用 'RED'？", 0)

    // ---- G2：Python 大写首字面量（True）→ 提示小写写法 ----
    var f14 = dirs.join(work, "capital_true.leno")
    files.write(f14, @"main() {
    while True {
        print(""loop"")
        break
    }
}
")
    ce.expect_error(f14, "大写 True 提示小写字面量", "字面量写法是小写 'true'", 0)

    // 正向：小写 true 合法（G2 不得误伤）
    var ok7 = dirs.join(work, "lowercase_true.leno")
    files.write(ok7, @"main() {
    var f = true
    while f { break }
    print(""ok"")
}
")
    ce.expect_ok(ok7, "小写 true 合法不误伤", "ok")

    // ---- 正向：in 成员测试表达式照常工作（D3 不得误伤）----
    var ok3 = dirs.join(work, "in_operator_ok.leno")
    files.write(ok3, @"main() {
    var a = [1, 2, 3]
    assert_eq(2 in a, true)
    assert_eq(9 in a, false)
    print(""OK"")
}
")
    ce.expect_ok(ok3, "in 成员测试正常工作", "OK")

    // ---- 正向：前置类型声明不受 D6 影响 ----
    var ok4 = dirs.join(work, "prefix_type_ok.leno")
    files.write(ok4, @"main() {
    int a = 5
    int? b = null
    print(type(b))
}
")
    ce.expect_ok(ok4, "前置类型声明正常工作", "null")

    // ---- 正向：循环内的 break/continue 合法 ----
    var ok1 = dirs.join(work, "break_inside.leno")
    files.write(ok1, @"main() {
    var sum = 0
    for 1:10 to i {
        if i == 5 { break }
        if i == 2 { continue }
        sum = sum + i
    }
    // 1 + 3 + 4 = 8（i==2 跳过，i==5 退出）
    assert_eq(sum, 8)
    print(""OK "" + sum)
}
")
    ce.expect_ok(ok1, "循环内 break/continue 合法", "OK 8")

    // ---- 正向：无效转义 \q 宽松保留（警告不阻断）----
    var ok2 = dirs.join(work, "bad_escape_kept.leno")
    files.write(ok2, @"main() {
    var s = ""a\qz""
    // \q 非法但按原样保留：a + 反斜杠 + q + z，共 4 字符
    assert_eq(s.len(), 4)
    print(""OK"")
}
")
    ce.expect_ok(ok2, "无效转义按原样保留", "OK")

    // ---- v3.2.6：native 类型通道（use 通道 + 同名诊断）----
    //   背景：native 模块**没有 sym_table**（字段表在 native 类型规格注册表里）⇒ `use dirs.DirEntry`
    //   过去只会得到"模块 'dirs' 没有符号表"。现在走独立通道，且名字写错要**列出可用类型**；
    //   没 import 就 use 则与源码模块同规矩（否则又出一种"不 import 也能 use"的怪状态）。
    var n1 = dirs.join(work, "use_native_typo.leno")
    files.write(n1, @"import dirs
use dirs.Nope

main() {
    print(1)
}
")
    ce.expect_error(n1, "use 写错 native 类型名要列出可用类型", "可用类型: DirEntry / DirInfo", 2)

    var n2 = dirs.join(work, "use_native_noimport.leno")
    files.write(n2, @"use dirs.DirInfo

main() {
    print(1)
}
")
    ce.expect_error(n2, "use native 类型前必须先 import", "模块 'dirs' 未导入", 1)

    //   脚本 struct 与 native 类型同名 ⇒ **编译期警告**（不是错误：形状一致时是合法用法，
    //   运行期会复用同一份 ObjStructDef）
    var n3 = dirs.join(work, "native_name_clash.leno")
    files.write(n3, @"import dirs

struct DirInfo {
    int x = 0
}

main() {
    var m = new DirInfo(x=1)
    print(m.x)
}
")
    ce.expect_ok(n3, "脚本 struct 与 native 类型同名要给警告", "与native类型同名")

    // ---- v3.2.7：**静态 any 不允许流进具体类型的 native 形参**（两条通道都要拦）----
    //   背景：模块方法 / 实例方法这两条 native 通道此前对"实参静态类型是 any"**直接跳过检查**
    //   （`visit_module.inc` 里的 `arg_type->kind != TYPE_ANY` 豁免），而 native 侧普遍**无校验强转**
    //   （如 `(ObjString*)val_as_obj(args[0])`）⇒ 实测
    //       var a = _env("不存在的变量") ; regexs.find_all(a, "[0-9]+")
    //   直接崩（0xC0000005）。现在与"返回值 / 赋值 / 脚本形参 / 数组元素 / 字典值"五条通道**同一口径**。
    // ⚠ any 源：无返回注解的本地函数（推 any）。旧写法用 `_env(...)` —— 但它已按
    //   NTYPE_BY_ARITY 规格定型（读 ⇒ string，见下面 ev 组判据）⇒ 不能再当 any 源。
    var a1 = dirs.join(work, "any_to_native_arg.leno")
    files.write(a1, @"import strings
func any_src() { return null }
main() {
    var a = any_src()
    print(strings.len(a))
}
")
    ce.expect_error(a1, "any 传给 native 形参要编译期拦下（修前是运行期崩）", "但传入 'any'", 5)

    var a2 = dirs.join(work, "any_to_module_arg.leno")
    files.write(a2, @"import regexs
func any_src() { return null }
main() {
    var a = any_src()
    print(regexs.find_all(a, ""[0-9]+"").len())
}
")
    ce.expect_error(a2, "any 传给模块方法形参要编译期拦下", "但传入 'any'", 5)

    // 正向（不得误伤）：显式 `_str()` 转换之后照常编译运行
    var a3 = dirs.join(work, "any_explicit_cast_ok.leno")
    files.write(a3, @"import strings
func any_src() { return null }
main() {
    var a = any_src()
    print(strings.len(_str(a)))
}
")
    ce.expect_ok(a3, "显式 _str() 转换后应通过", "4")     // _str(null) == "null" ⇒ 长度 4 ✓

    // 全局**内置函数**也是 native 通道（第三条）：`sleep` / `_int` 这类带类型形参的同样要拦
    var a4 = dirs.join(work, "any_to_builtin_arg.leno")
    files.write(a4, @"func any_src() { return null }
main() {
    var a = any_src()
    sleep(a)
}
")
    ce.expect_error(a4, "any 传给内置函数的 int 形参要编译期拦下", "期望 'int'，但传入 'any'", 4)

    // ---- `_env` 双形态规格（NTYPE_BY_ARITY，2026-09-28）：读 ⇒ string、写 ⇒ bool ----
    //   此前整体 any：`bool b = _env(...)` 静默放行、运行期炸；现在定型 ⇒ 编译期拦。
    var ev1 = dirs.join(work, "env_read_is_string.leno")
    files.write(ev1, @"main() {
    bool b = _env(""PATH"")
}
")
    ce.expect_error(ev1, "_env 读形态定型 string（any 时代静默放行）", "实际类型: string", 2)

    var ev2 = dirs.join(work, "env_write_is_bool.leno")
    files.write(ev2, @"main() {
    string s = _env(""LENO_X"", ""1"")
}
")
    // ⚠ 判据别用 `int n = _env(...)`：bool→int 是编译期白名单加宽（1/0），会放行
    ce.expect_error(ev2, "_env 写形态定型 bool", "实际类型: bool", 2)

    var ev3 = dirs.join(work, "env_ok.leno")
    files.write(ev3, @"main() {
    string p = _env(""PATH"")
    bool ok = _env(""LENO_NO_SUCH_XYZ"", ""1"")
    print(p.len() >= 0 and ok)
}
")
    ce.expect_ok(ev3, "_env 读/写形态各归其位", "true")

    // ---- 嵌套容器的**类型不变性**检查（2026-09-27 从 examples/dict/类型的嵌套字典.leno 收进来 ——
    //   那份示例目录已删除，而这是它唯一在守的真实保证：外层容器的写入要递归检查内层类型）----
    var nv1 = dirs.join(work, "nested_dict_invariance.leno")
    files.write(nv1, @"main() {
    Dict[string, Dict[string, int]] nested = {a: {x: 1}}
    nested.set(""b"", {y: ""wrong""})
}
")
    ce.expect_error(nv1, "嵌套字典写入要检查内层值类型", "参数 2 期望 'Dict[string, int]'", 3)

    var nv2 = dirs.join(work, "array_of_dict_invariance.leno")
    files.write(nv2, @"main() {
    var arr = [{x: 1}, {y: 2}]
    arr.add({z: 3})
    arr.add({w: ""wrong""})
}
")
    ce.expect_error(nv2, "字典数组 add 要检查元素类型", "参数 1 期望 'Dict[string, int]'", 4)

    // ---- struct 上的**整数下标**要在编译期拦下（2026-09-28；实例二十六）----
    //   背景：`s.field` 在语义层被转成 `s["field"]`（见 VM 07_collections.inc 的注释），
    //   所以 struct 在 AST 层只认字符串字段名。此前只有"数组索引必须整数"的反向检查，
    //   struct 侧漏了 ⇒ `r[0]` **编译通过**、运行期才抛「结构体字段名必须是字符串」。
    //   为什么值得单独钉：这正是"类型变更（`Array[any]` → `ExecResult` 这类结构体化）"迁移时
    //   最想在**编译期**看到的东西 —— 缺口在时，错误要等跑起来才暴露。
    //   ⚠ 文案要点（用户指出的）：**首选写法是 `x.field`**，`x["field"]` 只是它的动态形态
    //     ⇒ 报错必须先说 `x.field`，否则会让人以为字段访问长成下标的样子。
    //   ⚠ 只校验含 `x.field` 的那半句（末句带 `x["field"]`，里面有双引号，避免嵌套转义噪音）。
    var si1 = dirs.join(work, "struct_int_index.leno")
    files.write(si1, @"struct R {
    string output
    int code
}

main() {
    var r = new R(output = ""x"", code = 0)
    print(r[0])
}
")
    ce.expect_error(si1, "struct 上用整数下标要编译期拦下", "struct 的字段请用 'x.field'", 8)

    // 普通赋值 `r[1] = 5` 同样漏检过。⚠ 它**不是** AST_INDEX_ASSIGN —— parser 里普通赋值是
    //   `AST_ASSIGN(target=AST_INDEX)`（AST_INDEX_ASSIGN 只用于**复合赋值**与 `.field` 脱糖），
    //   所以它由上面那条**读**检查拦下 ⇒ 文案当初写"访问"就与语境冲突（实测踩到）。
    //   两条分支现已统一为**同一句不含语境词的文案**。
    var si2 = dirs.join(work, "struct_int_index_assign.leno")
    files.write(si2, @"struct R {
    string output
    int code
}

main() {
    var r = new R(output = ""x"", code = 0)
    r[1] = 5
}
")
    ce.expect_error(si2, "struct 普通赋值的整数下标也要拦下", "struct 的字段请用 'x.field'", 8)

    // 边界：**复合赋值** `r[1] += 5` 在 **parser** 就被拒（`AST_INDEX_ASSIGN` 分支因此不可达）。
    //   这里钉的是**那条边界本身** —— 若哪天放开了"下标复合赋值"，这条会先红，
    //   提醒回去确认 AST_INDEX_ASSIGN 分支上的同款检查还在（它是防御性的，见源码注释）。
    var si2b = dirs.join(work, "struct_int_index_compound.leno")
    files.write(si2b, @"struct R {
    string output
    int code
}

main() {
    var r = new R(output = ""x"", code = 0)
    r[1] += 5
}
")
    ce.expect_error(si2b, "下标复合赋值在 parser 就被拒（AST_INDEX_ASSIGN 因此不可达）",
        "复合赋值只支持简单变量", 8)

    // 正向（不得误伤）：**两种合法写法都照常** —— `r.output`（首选）与 `r[""output""]`（动态形态）
    var si3 = dirs.join(work, "struct_str_index_ok.leno")
    files.write(si3, @"struct R {
    string output
    int code
}

main() {
    var r = new R(output = ""x"", code = 0)
    print(r[""output""])
    print(r.output)
}
")
    ce.expect_ok(si3, "字符串字段名索引照常通过", "x")

    // ⚠ cstruct **不在此列**（有意豁免）：`Cv.malloc_array(n)` 的静态类型仍是那个 cstruct，
    //   但它是"cstruct 数组"⇒ `v[0].x = 1.0` 是合法写法。加检查时它误报过，
    //   现由 assert/cstruct_export_b.leno（核心测试 `cstruct.malloc_array()[i].x = xxx`）守着。

    // ---- 可变参数 native 方法的**参数类型**（2026-09-28；实例二十八）----
    //   两条通道都要用 `*_set_*_vararg_params()` **在注册之后**声明参数类型 ——
    //   注册时那排 `param_types` 实参对 `arity == -1` 是**整份忽略**的。
    //   实测踩过：先把 `strings.char` 的注册实参从 NULL 换成 `{TYPE_INT}`，结果
    //   `strings.char("x")` 依旧编译通过、运行期才抛「ASCII码必须在0-255之间」✗。
    var vp1 = dirs.join(work, "vararg_param_module.leno")
    files.write(vp1, @"import strings
main() {
    print(strings.char(""x""))
}
")
    ce.expect_error(vp1, "可变参数模块方法的参数类型要拦下", "期望 'int'，但传入 'string'", 3)

    var vp2 = dirs.join(work, "vararg_param_builtin.leno")
    files.write(vp2, @"main() {
    input(123)
}
")
    ce.expect_error(vp2, "可变参数**内置**函数的参数类型要拦下", "参数 1 期望 'string'", 2)

    // 正向（不得误伤）：`strings.char` 收多个码值照常（前缀 + 可变部分都是 int）
    var vp3 = dirs.join(work, "vararg_param_ok.leno")
    files.write(vp3, @"import strings
main() {
    print(strings.char(65, 66, 67))
}
")
    ce.expect_ok(vp3, "多码值 strings.char 照常通过", "ABC")

    // ---- struct 构造 / 命名的四条诊断（2026-09-28；实例二十九）----
    //   来源：`examples/import/module_chain/混合测试/` 那批**手搓草稿**（文件名 main/main2/main4/…，
    //   main.leno 开头还写着"新建文件: Untitled.leno"）。它们"编译不过"恰恰是因为**语言正确拒绝了**
    //   这些写法；而断言里对这四条**零覆盖** ⇒ 先把覆盖点收进来，再删掉那批草稿（免得永远没人跑、还误导扫描）。
    var ec1 = dirs.join(work, "struct_as_call.leno")
    files.write(ec1, @"struct Info {
    int x
}

main() {
    var i = new Info(x = 1)
    print(i())
}
")
    //   ⚠ 文案里的建议用的是**变量名**（`new i()`），而正确的类型名是 `Info` —— 已登记为待修的小缺陷
    //   （断言只钉「需要使用 new 关键字实例化」这半句，等修好文案再收紧）
    ce.expect_error(ec1, "struct 实例当函数调用要报错", "需要使用 new 关键字实例化", 7)

    // ★ 2026-10-10 新增：**把 struct 类型名当接收者用**（忘写 new 的另一种形态 ✓）
    //   实测背景：`C.go(1)` 原先一路走到**运行期**才报「类型 string 上不存在方法 'go'」✗
    //   —— 完全指不到点上 ✗（写的人找不到北 ✓）。
    //   现在在"实例方法调用"分支里按 **SYM_STRUCT** 拦下 ✓（判据怎么定的见 visit_module.inc 的注释：
    //   探针实测脚本 struct 的符号 kind = SYM_STRUCT ✓，不是 SYM_TYPE ✗ —— 后者是 enum/face ✓，
    //   cstruct/clib 又是另外两个 kind ✓ ⇒ 只认脚本 struct 才能不误伤 `Vec.malloc()` 那种合法静态写法 ✓）
    var ec_rcv = dirs.join(work, "struct_as_receiver.leno")
    files.write(ec_rcv, @"struct C {
    func go(int n) { print(_str(n)) }
}

main() {
    C.go(1)
}
")
    ce.expect_error(ec_rcv, "struct 类型名当接收者要报错（忘写 new）",
        "不能直接当接收者用", 6)

    // ★ 2026-10-10（A 组第 6 条）：`is not` **不存在** ⇒ 现在**单条**说清 + 给出两种正确写法
    //   ⚠ 修的是"报错指不到病因"✗：原先它喷**两条**语法错
    //     （`类型检查表达式期望类型名（如 int, float, string, bool, Array[int] 等）` +
    //      纯噪音 `期望表达式`✗）⇒ 写的人从这两条里看不出"原来是 `is not` 不行"✓。
    //   ⚠ 这条**只钉文案**，不钉"它变成合法语法"✗ —— 语言里取反的正式写法是
    //     `x not is T`（if / for **条件位置** ✓ 见 assert/test_narrow_edge.leno 的
    //     "测试 11: 否定类型守卫 (not is)" ✓）与 `not (x is T)`（**表达式**位置 ✓）；
    //     ⚠ `x not is T` 在表达式里**不合法** ✗（实测 `return x not is string` 报一堆语法错 ✓）
    //   ⚠ 我第一版曾把它"顺手实现成合法语法"✗ ⇒ 已撤回 ✓（那是擅自加语言 ✓ 用户确认过口径 ✓）
    var ec_isnot = dirs.join(work, "is_not_unsupported.leno")
    files.write(ec_isnot, @"func f(any x): bool { return x is not string }

main() { print(1) }
")
    ce.expect_error(ec_isnot, "`is not` 不存在 ⇒ 单条报错并给正确写法",
        "本语言不支持 `is not`", 1)

    var ec2 = dirs.join(work, "struct_positional.leno")
    files.write(ec2, @"struct P {
    int x
    int y
}

main() {
    var p = new P(10, 20)
}
")
    ce.expect_error(ec2, "struct 初始化必须用字段名（位置参数被拒）", "期望字段名", 7)

    var ec3 = dirs.join(work, "struct_unknown_field.leno")
    files.write(ec3, @"struct P {
    int x
}

main() {
    var p = new P(x = 1, z = 2)
}
")
    ce.expect_error(ec3, "命名参数里的未知字段要报错", "没有字段 'z'", 6)

    var ec4 = dirs.join(work, "untyped_param.leno")
    files.write(ec4, @"func f(a, b): int {
    return 1
}

main() {
    print(f(1, 2))
}
")
    ce.expect_error(ec4, "函数形参必须写类型", "期望参数名", 1)

    // 正向（不得误伤）：命名参数支持**无序**（草稿里 main3/main5 的正面用例）
    var ec5 = dirs.join(work, "named_args_ok.leno")
    files.write(ec5, @"struct Point3 {
    int x
    int y
    int z
}

main() {
    var p1 = new Point3(x = 10, y = 20, z = 30)
    var p2 = new Point3(z = 100, x = 50, y = 75)
    print(_str(p1.x + p1.y + p1.z) + ""/"" + _str(p2.x + p2.y + p2.z))
}
")
    ce.expect_ok(ec5, "命名参数无序照常通过", "60/225")

    // ---- 数组元素类型的**不变性**三连（2026-09-28；实例三十）----
    //   来源：`examples/type类型/` 里三个**故意负例**（文件里自己写着"这里要报错"/"这行会报错"）
    //   ⇒ 覆盖收进断言后删除，免得"编译不过的示例"永远在那儿误导扫描与新人。
    //   为什么要单独钉：这三条正是"数组元素类型**不变**"这条规则的三个入口（实例方法 / 模块方法 / copy）。
    var ti1 = dirs.join(work, "array_add_invariance.leno")
    files.write(ti1, @"main() {
    var arr = [1, 2]
    var s = ""x""
    arr.add(s)
}
")
    ce.expect_error(ti1, "Array[int].add(string) 要拦下（实例方法入口）", "期望 'int'，但传入 'string'", 4)

    var ti2 = dirs.join(work, "array_module_insert_invariance.leno")
    files.write(ti2, @"import arrays
main() {
    var arr = [1, 2]
    var s = ""x""
    arrays.insert(arr, arr.len(), s)
}
")
    ce.expect_error(ti2, "arrays.insert 传错类型要拦下（模块方法入口）", "参数 3 类型错误", 5)

    var ti3 = dirs.join(work, "array_multidim_invariance.leno")
    files.write(ti3, @"main() {
    Array[Array[int]] arr1 = [[1, 2], [3, 4]]
    Array[Array[Array[int]]] a = arr1.copy()
    print(type(a))
}
")
    ce.expect_error(ti3, "多维数组 copy 不许降维（copy 入口）", "声明类型与初始化值类型不匹配", 3)

    // ---- face 上的越界访问（2026-09-28；实例三十一）----
    //   来源：`examples/泛型系统/泛型接口与约束/test_face_access2.leno` —— 那是"face 变量能否调用 /
    //   访问**非 face 定义**的方法与字段？"的**探索草稿**，答案是**不能** ⇒ 收进断言后删除草稿。
    //   断言里之前**零覆盖**这两条 face 越界诊断。
    var fa1 = dirs.join(work, "face_call_cross.leno")
    files.write(fa1, @"face Speaker {
    func speak(): string
}

struct Dog impl Speaker {
    string name

    func speak(): string {
        return ""woof from "" + self.name
    }

    func getAge(): int {
        return 3
    }
}

main() {
    var d = new Dog(name = ""Rex"")
    Speaker s = d
    print(s.speak())
    print(s.getAge())
}
")
    //   ⚠ 同一行会报**两条**（先一条"不能在 any 类型上调用方法 'getAge'"、再一条
    //     "类型 'face Speaker' 没有方法 'getAge'"）—— 前者是误导性的噪点，已登记为待修
    ce.expect_error(fa1, "face 变量不能调用非 face 定义的方法", "类型 'face Speaker' 没有方法 'getAge'", 21)

    var fa2 = dirs.join(work, "face_field_cross.leno")
    files.write(fa2, @"face Speaker {
    func speak(): string
}

struct Dog impl Speaker {
    string name

    func speak(): string {
        return ""woof from "" + self.name
    }
}

main() {
    var d = new Dog(name = ""Rex"")
    Speaker s = d
    print(s.name)
}
")
    ce.expect_error(fa2, "face 变量不能访问非 face 字段（提示用 as 转型）", "没有字段或方法 'name'", 16)

    // ---- face 变量的**正向**能力（2026-09-28；收编后删除 examples/泛型系统/泛型接口与约束/test_face_access.leno）----
    //   那个示例是**探索型脚本**（问"face 变量能不能访问底层 struct 字段"）⇒ 编译器**正确地**报错
    //   ⇒ 它永远不可能"跑通"（每跑必是编译错误）。这里把它**两条结论**都收编：face 定义的方法能调 ✓
    //   （本用例）、struct 特有字段不能直接访问 ✗（见上面的 fa2）—— 收编完就删掉那个跑不通的示例。
    var fa3 = dirs.join(work, "face_access_ok.leno")
    files.write(fa3, @"face Speaker {
    func speak(): string
}

struct Dog impl Speaker {
    string name

    func speak(): string {
        return ""woof from "" + self.name
    }
}

main() {
    var d = new Dog(name = ""Rex"")
    Speaker s = d
    print(s.speak())
}
")
    ce.expect_ok(fa3, "face 变量能调用 face 定义的方法（收编 test_face_access 的正向半边）",
        "woof from Rex")

    // ---- struct 方法捕获外层局部（2026-09-28；实例三十二）**崩溃回归** ----
    //   ⚠ 修好之前：这个写法**能编译**，运行期 0xC0000005（实测；机理是方法不是闭包、
    //     却照常被挂 upvalue ⇒ 读野指针）。现在在**解析点**就报错 ⇒ 崩溃变清晰报错。
    //   这条用例的价值：它钉的是"**不许退化成崩溃**"，而不只是文案。
    var up1 = dirs.join(work, "method_capture_upvalue.leno")
    files.write(up1, @"func makeLocal(): int {
    var local_var = 100

    struct L {
        int data

        func get(): int {
            return local_var + data
        }
    }

    var o = new L(data = 5)
    return o.get()
}

main() {
    print(_str(makeLocal()))
}
")
    //   ⚠ 落点是**方法声明行**（`func get(): int {`）而不是使用行 —— 报错发生在
    //     `resolve_variable_with_upvalue()` 里，那一层拿不到 AST 节点（只有函数栈）。
    //     想精确到使用行得给该解析函数加 AST 参数（~20 个调用点），列为后续小改进。
    ce.expect_error(up1, "struct 方法不能捕获外层局部变量（原崩溃点）",
        "struct 方法不能捕获外层局部变量 'local_var'", 7)

    // 正向对照：把外部值作为**字段**在 new 时传入 ⇒ 照常通过（当前唯一稳妥写法）
    var up2 = dirs.join(work, "method_field_ok.leno")
    files.write(up2, @"func makeLocal(): int {
    var local_var = 100

    struct L {
        int data
        int base

        func get(): int {
            return base + data
        }
    }

    var o = new L(data = 5, base = local_var)
    return o.get()
}

main() {
    print(_str(makeLocal()))
}
")
    ce.expect_ok(up2, "外部值经字段传入照常通过", "105")

    // ---- dict 上的"方法名拼错"仍要报（2026-09-28；实例三十六）----
    //   背景：为了支持"dict 里存函数 ⇒ `d["k"](args)` 当调用值"（见 test_function_closure 的正向用例），
    //   语义侧对 **dict** 上找不到的方法名放宽了。但**拼错内置方法名**必须继续报错，否则会静默
    //   变成运行期的"不是函数"错误。判据：与真·Dict 方法相似（semantic_method_hint 非空）⇒ 报错。
    var dd1 = dirs.join(work, "dict_method_typo.leno")
    files.write(dd1, @"main() {
    var d = {a: 1}
    print(_str(d.leng()))
}
")
    ce.expect_error(dd1, "dict 上拼错内置方法名仍要报错（并给出相似名提示）", "没有方法 'leng'", 3)

    // ---- 泛型 face 的接收者类型实参要代入方法形参（2026-09-28；实例三十九）----
    //   这是修误报的**反向对照**：`Comparable[int]` 上 `compareTo("x")` 仍要在编译期报，
    //   且**期望类型要显示代入后的 `int`**（不是占位 `struct T`）——
    //   证明这次不是"把检查关掉了"，而是"代入后再比对"。
    var fg1 = dirs.join(work, "face_generic_mismatch.leno")
    files.write(fg1, @"face Comparable[T] {
    func compareTo(T other): int
}

struct IntVal impl Comparable[int] {
    int val = 0
    func compareTo(int other): int {
        return 0
    }
}

main() {
    Comparable[int] a = new IntVal(val = 3)
    print(_str(a.compareTo(""x"")))
}
")
    ce.expect_error(fg1, "泛型 face 上真类型不匹配仍要报（且期望类型是代入后的 int）",
        "compareTo 第 1 个参数类型不匹配: 期望 int, 实际 string", 14)

    // ---- face impl 的**返回类型**：没标注时按函数体推（2026-09-28；实例四十二）----
    //   实测误报（examples/switch 三个用例）：`face Shape { func area(): int }` +
    //   `struct Rect impl Shape { func area() { return w * h } }` ⇒ 报「期望 int, 实际 var」✗
    //   —— 检查拿 `TYPE_INFER`（var）直接比，从没试过推函数体。现在按"没标注就推函数体"处理。
    var fr1 = dirs.join(work, "face_ret_infer_ok.leno")
    files.write(fr1, @"face Shape {
    func area(): int
}

struct Rect impl Shape {
    int w = 3
    int h = 4
    func area() { return w * h }
}

main() {
    Shape s = new Rect()
    print(_str(s.area()))
}
")
    ce.expect_ok(fr1, "impl 方法没标返回类型时按函数体推（不误报）", "12")

    // 加宽方向：face 要 float、impl 体算出 int ⇒ **允许**（语言允许 int → float 隐式加宽，
    //   实测 `func f(int a): float { return a }` ✓；而收窄 float → int 是报错的）
    var fr2 = dirs.join(work, "face_ret_widen_ok.leno")
    files.write(fr2, @"face Shape {
    func area(): float
}

struct Rect impl Shape {
    int w = 3
    int h = 4
    func area() { return w * h }
}

main() {
    Shape s = new Rect()
    print(_str(s.area()))
}
")
    ce.expect_ok(fr2, "face 要 float 而 impl 体算出 int ⇒ 按加宽放行", "12")

    // 反向对照（**关键**）：impl 体算出的类型**真不匹配**时仍要报 —— 证明不是把检查关掉了。
    //   报文行号是 **struct 定义**那行（error_add_at 用的是 ast->line）。
    var fr3 = dirs.join(work, "face_ret_mismatch.leno")
    files.write(fr3, @"face Shape {
    func area(): int
}

struct Rect impl Shape {
    int w = 3
    func area() { return ""oops"" }
}

main() {
    print(""x"")
}
")
    ce.expect_error(fr3, "impl 体返回 string 而 face 要 int ⇒ 仍要报（反向对照）",
        "返回类型与 face 'Shape' 不匹配", 5)

    // ---- E1：字符串接收者的字符串下标（双字面量必拦）----
    //   "abc".pad_start（少了括号的方法引用）此前一路放行到运行期才抛
    //   「字符串索引必须是数字」⇒ 现在编译期拦截 + 给出两种正确写法。
    var s1 = dirs.join(work, "str_str_index.leno")
    files.write(s1, @"main() {
    var r = ""abc"".pad_start
    print(r)
}
")
    ce.expect_error(s1, "字符串的字符串下标要报错（漏了括号的方法引用）",
        "字符串不支持字符串下标 'pad_start'", 2)

    // ---- E1 正向：合法形态一个都不能误伤 ----
    //   数字下标取字符、带括号的方法调用（静态接收者 ⇒ 走 OP_GET_METHOD 的参数检查）照常。
    //   变量接收者 + 字符串下标照旧放行（枚举兜底形态，运行期才判）⇒ 这里无需用例。
    var s2 = dirs.join(work, "str_index_ok.leno")
    files.write(s2, @"main() {
    var s = ""hello""
    print(s[1])
    print(""abc"".pad_start(8, "".""))
}
")
    ce.expect_ok(s2, "数字下标 + 带括号方法调用不受影响", ".....abc")

    // ---- const 的**元素**不可改（2026-09-28；实例四十三）----
    //   收编 `examples/测试/export array or dict` 下 4 个"只演示会报错"的脚本
    //   （test_const_mutate / test_const_syntax / test_dict_const / test_dict_const2 —— 都跑不通，
    //   因为它们演示的正是**编译器拒绝**的写法）。这条检查自栈式 VM 基线（c07a9f6）就在，
    //   语义是"const **深不可变**"（教程：const 是**不可变**常量），跨模块形态另有专门检查。
    // ⚠ 这三条用的是**静态 fixture**（assert/const_elem_*.leno）而不是动态写文件：
    //   被收编的形态是"**跨模块**访问 const 容器的元素"，必须有模块可 import；而动态脚本写在
    //   `_tmpdir()` 里，相对 import 解析不到 assert/ 下的 fixture（实测：找不到模块文件 ✗）。
    //   静态 fixture 的定位以 **cwd** 为基准（helpers/compiler.leno 顶部写明了这条规矩：
    //   run_tests.leno 从仓库根启动）⇒ 传 "assert/xxx.leno" 即可。
    ce.expect_error("assert/const_elem_neg_array.leno", "const 数组的元素不能改（跨模块形态）",
        "不能对 const 变量 'cm.CARR' 的元素重新赋值", 9)

    ce.expect_error("assert/const_elem_neg_dict.leno", "const 字典的元素不能改（跨模块形态）",
        "不能对 const 变量 'cm.CDICT' 的元素重新赋值", 7)

    // **正向对照（关键）**：非 const 的导出容器照常可改 —— 证明那条检查没有过宽
    ce.expect_ok("assert/const_elem_ok_nonconst.leno",
        "非 const 的导出数组/字典照常可改元素（不误伤）", "99,42")

    // ---- 模块级导出变量的**类型不匹配**（7 条；2026-09-28；实例四十三）----
    //   收编 `examples/测试/export array or dict/mod_errors.leno`（已删）—— 那示例自己就写着
    //   "应该报错"。fixture 里 7 条一次编译能报全 ⇒ 这里逐条钉"变量名 + 落点行"。
    //   ⚠ 落点行随 fixture 顶部注释平移（现为 10/13/16/19/22/25/28）。
    var tb = "assert/type_mismatch_battery.leno"
    ce.expect_error(tb, "模块级 int ← string 要报错", "变量 'badInt' 声明类型与初始化值类型不匹配", 10)
    ce.expect_error(tb, "模块级 float ← string 要报错", "变量 'badFloat' 声明类型与初始化值类型不匹配", 13)
    ce.expect_error(tb, "模块级 string ← int 要报错", "变量 'badStr' 声明类型与初始化值类型不匹配", 16)
    ce.expect_error(tb, "模块级 bool ← int 要报错", "变量 'badBool' 声明类型与初始化值类型不匹配", 19)
    ce.expect_error(tb, "模块级 int ← float（收窄）要报错",
        "变量 'badIntFromFloat' 声明类型与初始化值类型不匹配", 22)
    ce.expect_error(tb, "模块级 Array[int] 里放 string 要报错",
        "变量 'badArr' 声明类型与初始化值类型不匹配", 25)
    ce.expect_error(tb, "模块级 Dict[string,int] 里放 string 要报错",
        "变量 'badDict' 声明类型与初始化值类型不匹配", 28)

    // ---- 导入错误处理（2026-09-28；实例四十五）----
    //   收编 `examples/import/boundary_tests/15_import_error_handling` 下的**故意负例**（已删，
    //   那几个文件自己就写着"如果看到这行，说明导入没有正确报错"）。两条行为：
    //   ① 导入**不存在**的模块 ⇒ 编译期报错；
    //   ② 导入**有语法错误**的模块 ⇒ 编译期报错，且错误报在**那个模块自己那行**上。
    var im1 = dirs.join(work, "import_missing.leno")
    files.write(im1, @"main() {
    import ""nonexistent_module.leno"" as m
}
")
    ce.expect_error(im1, "导入不存在的模块要报错", "找不到模块文件: nonexistent_module.leno", 2)

    // ② 用静态 fixture（assert/import_broken*.leno）：坏模块必须在 assert/ 下才能被相对 import 找到
    ce.expect_error("assert/import_broken.leno", "导入有语法错误的模块要报错（报在 fixture 自己那行）",
        "期望 '{'", 8)

    // ---- "错误信息质量"三个 bug-repro 的**收编**（2026-09-28；实例四十七）----
    //   收编 `examples/import/compiler_bug_repro`（4 个；该目录已删）—— 那批是当年提的
    //   三个报错质量问题，**现在都不再复现**了，把"应有的行为"钉成断言：
    //   ① `bug3`：导入不存在的模块 ⇒ **第一个**错误就该是「找不到模块文件」（已在上面 im1 钉住 ✓）；
    //   ② `bug1`：any 上访问字段 ⇒ 报**语义错误**并给收窄提示（不再标成 unknown_tool_error）；
    //   ③ `bug2`：上游模块有类型错误 ⇒ **只报上游那一条**（带上游文件 + 行号），不级联。
    var ba1 = dirs.join(work, "any_field_access.leno")
    files.write(ba1, @"export func bad_access(any data) {
    return data.field
}
")
    ce.expect_error(ba1, "any 上直接访问字段要报语义错误（并给收窄提示）",
        "不能在 any 类型 'data' 上直接访问字段 'field'", 2)

    // ③ 用静态 fixture（assert/import_type_error{,_module}.leno）：上游那一条落在**上游文件**的第 7 行
    ce.expect_error("assert/import_type_error.leno",
        "导入有类型错误的模块：只报上游那一条（上游文件 + 行号）",
        "返回类型不匹配：期望 int，实际 any", 7)

    // ---- D7：`var (a, b) = ...`（Python 习惯）⇒ 定向提示"必须写形状"（2026-10-02）----
    //   缘起：写 Leno 版批量替换脚本时想照 Python 那样一行取参，`var (p, o, n) = a` 报的是
    //   「期望变量名」—— 因为 `(` 被当成**表达式开头**，报错点在那个括号上、看不出真因 ✗
    //   （同族还有一条：`(a[0], a[1])` 不是表达式 —— Leno 没有元组字面量）
    var d7a = dirs.join(work, "var_paren.leno")
    files.write(d7a, @"main() {
    var arr = [1, 2]
    var (a, b) = arr
    print(a + b)
}
")
    ce.expect_error(d7a, "var (a,b) = ... 要给「必须写形状」的定向提示",
        "解构声明必须写形状", 3)

    // const 走同一条路径（下一条断言即"同一实现"的护栏）
    var d7b = dirs.join(work, "const_paren.leno")
    files.write(d7b, @"main() {
    var arr = [1, 2]
    const (a, b) = arr
}
")
    ce.expect_error(d7b, "const (a,b) = ... 同样给形状提示", "解构声明必须写形状", 3)

    // 守卫①：别的"var 后面不是变量名"仍走原通用文案（提示别撒得太宽）
    var d7c = dirs.join(work, "var_no_name.leno")
    files.write(d7c, @"main() {
    var = 1
}
")
    ce.expect_error(d7c, "var = 1 仍报「期望变量名」（未被新提示顶掉）", "期望变量名", 2)

    // 守卫②：三种**正确**写法不得误伤（正向，必须编译+运行成功）
    var d7d = dirs.join(work, "destruct_ok.leno")
    files.write(d7d, @"main() {
    var[](x, y) = [1, 2]
    var a = 10, b, c = 1
    print(""OK="" + (x + y + a + c))
}
")
    ce.expect_ok(d7d, "解构声明 / 多变量声明照常编译运行", "OK=14")

    // ---- F1：泛型参数直接传给 **native** 形参（曾静默编过 ⇒ 运行期 0xC0000005 访存越界）----
    // 判据只加在 native 通道（C 侧 `val_as_obj/val_as_int` 是无校验盲转）；用户函数/字段/赋值不拦
    //   （那不是 UB —— Value 自带 tag，且定义处一刀切会误伤一片合法泛型代码，见测试里的两条守卫）
    // B 方案（两段式需求推断）：**定义处不再报错** —— 改在**调用点**用推断出的类型实参校验 ✓
    var g1 = dirs.join(work, "generic_native_module.leno")
    files.write(g1, @"import strings
func hexit[T](T x):string { return strings.to_hex(x) }
main() { print(hexit(42)) }
")
    ce.expect_error(g1, "模块式：T=int 喂给 native string 形参 ⇒ 调用点报错",
                    "泛型参数 'T' 的需求不满足", 3)

    var g2 = dirs.join(work, "generic_native_instance.leno")
    files.write(g2, @"import strings
func eqx[T](string s, T x):bool { return s.eq_ignore_case(x) }
main() { print(_str(eqx(""ab"", 42))) }
")
    ce.expect_error(g2, "实例式：T=int 喂给 native string 形参 ⇒ 调用点报错",
                    "泛型参数 'T' 的需求不满足", 3)

    // 守卫③：**同一个泛型函数**只要所有调用点都满足需求就完全合法（B 的核心收益 ✓）
    //   （这是"定义处一刀切"做不到的：那样 `hexit` 无论怎么调都不许编译 ✗）
    var g5 = dirs.join(work, "generic_req_ok.leno")
    files.write(g5, @"import strings
func hexit[T](T x):string { return strings.to_hex(x) }
main() { print(hexit(""中"")) }
")
    ce.expect_ok(g5, "同一函数只以 string 实例化 ⇒ 合法并跑通（B 的核心收益）", "e4b8ad")

    // 守卫①：容器元素 mutator（add/insert）是合法泛型写法（存 Value、不越界）⇒ 不得误伤
    var g3 = dirs.join(work, "generic_push_ok.leno")
    files.write(g3, @"func push_ok[T](Array[T] a, T v) { a.add(v) }
main() {
    Array[int] a = []
    push_ok(a, 7)
    print(""ok="" + _str(a.len()))
}
")
    ce.expect_ok(g3, "容器元素 mutator 的泛型写法不得误伤", "ok=1")

    // 守卫②：用户函数通道不拦 —— 定义处一刀切会拒掉大量合法泛型代码（实测误伤过 4 个用例）
    var g4 = dirs.join(work, "generic_userfn_ok.leno")
    files.write(g4, @"func userfn(string s):int { return s.byte_len() }
func user_ok[T](T v):int { return userfn(v) }
main() { print(""ok="" + _str(user_ok(""中""))) }
")
    ce.expect_ok(g4, "泛型参数传给用户函数不得误伤", "ok=3")

    // ---- F2：泛型 **struct 方法** 里的 native 调用（B 第二步，2026-10-02）----
    //   方法自己的 AST 不带类型参数，`self.value` 的 T 来自**接收者 struct** ⇒ 需求按 (struct, 方法, T) 记，
    //   在**方法调用点**用接收者的类型实参校验 ✓
    var g6 = dirs.join(work, "generic_struct_native.leno")
    files.write(g6, @"import strings
struct Cell[T] {
    T value
    func bad():string { return strings.to_hex(self.value) }
}
main() {
    Cell[int] c = new Cell[int](value=1)
    print(c.bad())
}
")
    ce.expect_error(g6, "struct 泛型：Cell[int] 调要求 string 的 native ⇒ 方法调用点报错",
                    "泛型参数 'T' 的需求不满足", 8)

    // 守卫④：同一个 struct 只以 string 实例化 ⇒ 合法（与 g5 对称 ✓）
    var g7 = dirs.join(work, "generic_struct_native_ok.leno")
    files.write(g7, @"import strings
struct Cell[T] {
    T value
    func bad():string { return strings.to_hex(self.value) }
}
main() {
    Cell[string] c = new Cell[string](value=""ab"")
    print(c.bad())
}
")
    ce.expect_ok(g7, "struct 泛型：Cell[string] 调同一方法 ⇒ 合法并跑通", "6162")

    // ---- F3：可空值直传 native（盲转遇 null ⇒ 段错误；2026-10-02）----
    //   实测 `string? s = null; strings.to_hex(s)` 编译通过、运行期 exit=0xC0000005 ✗
    var g8 = dirs.join(work, "nullable_native.leno")
    files.write(g8, @"import strings
main() {
    string? s = null
    print(strings.to_hex(s))
}
")
    ce.expect_error(g8, "可空值直传 native 必须编译报错（此前是运行期段错误）",
                    "可空值不能直接传给", 4)

    // 守卫⑤：**收窄之后**合法 —— `if x is T { ... }` 是推荐写法（对可空类型有效 ✓），
    //   显式转换 `x as T` / `_str(x)` 也可以 ✓；⚠ 只有 `if x != null` 不算收窄 ✗
    var g9 = dirs.join(work, "nullable_narrow_ok.leno")
    files.write(g9, @"import strings
main() {
    string? s = ""ab""
    if s is string { print(strings.to_hex(s)) }
    print(strings.to_hex(s as string))
    print(strings.to_hex(_str(s)))
}
")
    ce.expect_ok(g9, "可空值先收窄（is / as / _str 三种）再传给 native ⇒ 合法并跑通", "6162")

    // ---- F4：**顺序无关**（2026-10-03）----
    //   需求在"访问定义体"时记录；调用点可能更早被访问（main 在前 / struct 前向引用）⇒
    //   当场判会漏过 ✗ ⇒ 改为"调用点只登记、分析收尾统一复查" ✓
    var g10 = dirs.join(work, "generic_order_fn.leno")
    files.write(g10, @"import strings
main() {
    print(hexit(42))
}
func hexit[T](T x):string {
    return strings.to_hex(x)
}
")
    ce.expect_error(g10, "调用在定义之前（函数）⇒ 收尾仍要报出需求错", "需求不满足", 3)

    var g11 = dirs.join(work, "generic_order_struct.leno")
    files.write(g11, @"import strings
main() {
    Cell[int] c = new Cell[int](value=1)
    print(c.bad())
}
struct Cell[T] {
    T value
    func bad():string { return strings.to_hex(self.value) }
}
")
    ce.expect_error(g11, "调用在定义之前（struct 前向引用）⇒ 收尾仍要报出需求错", "需求不满足", 4)

    // ---- F5：泛型 struct **前向引用**时，字段类型也要正确替换（2026-10-03）----
    //   原先 visit_struct_init 用的是 type_substitute（只认 TYPE_GENERIC_PARAM），
    //   而前向引用时字段类型是"TYPE_STRUCT 占位 T" ✗ ⇒ 合法代码被拒：
    //     new Cell[int](value=1) ⇒「字段 'value' 类型不匹配: 期望 'struct T'，实际 'int'」✗
    var g12 = dirs.join(work, "generic_struct_fwd_ok.leno")
    files.write(g12, @"import strings
main() {
    Cell[string] c = new Cell[string](value=""ab"")
    print(c.bad())
}
struct Cell[T] {
    T value
    func bad():string { return strings.to_hex(self.value) }
}
")
    ce.expect_ok(g12, "struct 定义在使用之后 ⇒ 泛型字段替换仍要生效（合法用法不得被拒）", "6162")

    // ---- F6：前向引用泛型的**多种形状**都要合法（锁住"占位形式"这一类坑，2026-10-03）----
    //   涵盖：返回 T、双类型参数 Pair[K,V]、Array[T] 字段 + 元素 mutator、以及对 T 做比较/算术。
    //   （比较/算术会有"泛型无约束"警告 ✓ 那是**按设计**的提示，不是错误 ✓）
    var g13 = dirs.join(work, "generic_fwd_shapes.leno")
    files.write(g13, @"import strings
main() {
    var b = new Box[int](value=7)
    print(""get="" + _str(b.get()))
    var p = new Pair[string, int](key=""k"", val=1)
    print(""desc="" + p.describe())
    var ls = new Bag[string]()
    ls.addItem(""x"")
    print(""count="" + _str(ls.count()))
    var c = new Cmp[int](value=7)
    print(""sum="" + _str(c.plus(5)))
}
struct Box[T] {
    T value
    func get():T { return self.value }
}
struct Pair[K, V] {
    K key
    V val
    func describe():string { return _str(self.key) + ""/"" + _str(self.val) }
}
struct Bag[T] {
    Array[T] items = []
    func addItem(T x) { self.items.add(x) }
    func count():int { return self.items.len() }
}
struct Cmp[T] {
    T value
    func plus(T other):T { return self.value + other }
}
")
    ce.expect_ok(g13, "前向引用泛型的多形状（返回 T / Pair[K,V] / Array[T] / T 运算）都要合法", "sum=12")

    // ---- F7：泛型参数的具体类型约束 `[T: string]`（2026-10-03）----
    //   原先约束只能写 face 名（写 `string` 直接语法报错 ✗）。放开后：
    //     · 意图写清 ⇒ 定义处即可判 native 形参是否与约束相容 ✓
    //     · 调用点按约束校验实参类型 ✓；struct 侧在**实例化处**校验 ✓
    var g14 = dirs.join(work, "cstr_ok.leno")
    files.write(g14, @"import strings
func hexit[T: string](T x):string { return strings.to_hex(x) }
main() { print(hexit(""中"")) }
")
    ce.expect_ok(g14, "约束 [T: string] 的合法调用 ⇒ 编译并跑通", "e4b8ad")

    var g15 = dirs.join(work, "cstr_bad_call.leno")
    files.write(g15, @"import strings
func hexit[T: string](T x):string { return strings.to_hex(x) }
main() { print(hexit(42)) }
")
    ce.expect_error(g15, "违反约束的调用（T 应为 string 却传 int）⇒ 报错", "不满足约束", 3)

    var g16 = dirs.join(work, "cstr_bad_body.leno")
    files.write(g16, @"import strings
func bad[T: int](T x):string { return strings.to_hex(x) }
main() { print(bad(1)) }
")
    ce.expect_error(g16, "约束与 native 形参不相容 ⇒ **定义处**报错（不必等调用点）", "两者不相容", 2)

    var g17 = dirs.join(work, "cstr_struct_bad.leno")
    files.write(g17, @"import strings
struct Cell[T: string] {
    T value
    func hex():string { return strings.to_hex(self.value) }
}
main() {
    Cell[int] c = new Cell[int](value=1)
    print(c.hex())
}
")
    ce.expect_error(g17, "struct 实例化违反约束（Cell[int] 而 T 约束为 string）⇒ 报错", "不满足约束", 7)

    var g18 = dirs.join(work, "cstr_struct_ok.leno")
    files.write(g18, @"import strings
struct Cell[T: string] {
    T value
    func hex():string { return strings.to_hex(self.value) }
}
main() {
    Cell[string] c = new Cell[string](value=""ab"")
    print(c.hex())
}
")
    ce.expect_ok(g18, "struct 约束的合法实例化（Cell[string]）⇒ 编译并跑通", "6162")

    print("=== test_diag_static_errors ALL passed ===")
}
