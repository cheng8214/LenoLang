// float -> string 的「最短往返」表示回归测试
//
// 背景（2026-10-07 实战爬虫发现）：
//   旧实现统一用 "%.17g" 把浮点转字符串，而 double 的 9.7 真实值是
//   9.699999999999999289...，于是
//       print(9.7)                -> 9.6999999999999993
//       "平均分: " + 9.068        -> 平均分: 9.0680000000000032
//   同时 CSV/JSON 走的是 "%g" ⇒ 同一个值在不同出口长得不一样，且 JSON 里
//   0.1+0.2 会被写成 "0.3"（丢精度）、1.0 被写成 "1"（往返后类型都变了）。
//
// 现在统一为：%.15g → %.16g → %.17g 取第一个 **strtod 能精确回读** 的精度。
//   · 9.7 在 15 位就往返成功 ⇒ "9.7"
//   · 0.1+0.2 真的需要 17 位 ⇒ 仍输出 "0.30000000000000004"（不丢信息）
//   · 整数值的浮点补 ".0"（1.0 不写成 1），与旧行为一致
import jsons

main() {
    // ① 常见小数必须干净
    assert_eq(_str(9.7), "9.7")
    assert_eq(_str(0.5), "0.5")
    assert_eq(_str(3.14), "3.14")
    assert_eq(_str(-2.25), "-2.25")
    assert_eq(_str(_float("9.068")), "9.068")

    // ② 整数值的浮点保留浮点特征
    assert_eq(_str(1.0), "1.0")
    assert_eq(_str(100.0), "100.0")
    assert_eq(_str(-3.0), "-3.0")

    // ③ 字符串拼接与 _str 同口径
    assert_eq("x=" + 9.7, "x=9.7")
    assert_eq("" + (_float("2.5") * 2), "5.0")

    // ④ 需要更多位时不丢信息
    assert_eq("" + (0.1 + 0.2), "0.30000000000000004")
    assert_eq(_str(1.0 / 3.0), "0.3333333333333333")

    // ⑤ JSON 序列化同口径，且浮点往返无损
    assert_eq(jsons.encode(3.14), "3.14")
    assert_eq(jsons.encode(1.0), "1.0")
    assert_eq(jsons.decode(jsons.encode(0.1 + 0.2)), 0.1 + 0.2)

    print("test_float_repr passed")
}
