// test_threads_globals.leno —— TH8：入口脚本的全局对象跨线程**各自一份**（回归）
//
// 背景（见 docs/线程并发能力修复追踪.md 的 TH8）：
//   旧行为是"把全局变量表逐个 Value 抄过去"⇒ 标量独立、**对象共享**
//   ⇒ 子线程 `arr.add(4)` / `box.set` 主线程全看得见（跨堆引用 ⇒ 偶发 0xC0000374）。
//   现在：string / Array / Dict / struct / 闭包 克隆进子线程堆；
//         module / function / native / cstruct_def / socket / file / channel / thread 仍共享。
//
// 判据：
//   ① 子线程看到的是**初始内容**，改完之后自己读得到新值
//   ② 主线程的 Array / Dict / struct **一点没变**
//   ③ 标量本来就各一份（既有语义，别退化）
//   ④ 嵌套容器（Dict 里放 Array）也是深拷贝
import threads

struct Cfg {
    int x = 0
}

var arr = [1, 2, 3]
var box = {n: 0}
var cfg = new Cfg()
var counter = 0

// 子线程入口：就地改全局对象，返回它自己看到的三个值
func worker(): string {
    var before = arr.len()
    arr.add(4)
    box.set("n", 99)
    cfg.x = 7
    counter = 100
    return _str(before) + "/" + _str(arr.len()) + "/" + _str(box.get("n", -1)) + "/" + _str(cfg.x)
}

// 嵌套容器：全局 Dict 里装 Array
var nested = {}

func workerNested(): int {
    var a = nested["list"] as Array[int]
    a.add(9)
    return a.len()
}

main() {
    arr = [1, 2, 3]
    box = {n: 0}
    cfg = new Cfg()
    cfg.x = 1
    counter = 1

    var t = threads.start(worker)
    assert_eq(t.join(), "3/4/99/7", "①子线程看到初始 3，改完是 4/99/7")

    // ② 主线程不受影响
    assert_eq(arr.len(), 3, "②主线程的 Array 没被改")
    assert_eq(_int(box.get("n", -1)), 0, "②主线程的 Dict 没被改")
    assert_eq(cfg.x, 1, "②主线程的 struct 没被改")
    assert_eq(counter, 1, "③标量本来就各一份")

    // ④ 嵌套容器
    nested = {}
    nested.set("list", [1, 2])
    var t2 = threads.start(workerNested)
    assert_eq(t2.join(), 3, "④子线程在副本上 add 到 3")
    var mainList = nested["list"] as Array[int]
    assert_eq(mainList.len(), 2, "④主线程的嵌套 Array 没被改")

    print("test_threads_globals passed")
}
