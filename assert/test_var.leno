// test_var.leno
// 使用赋值给指定类型的方式验证类型推断是否正确
// 如果类型推断为 any，编译器会报类型不匹配错误
import "test_var_mod.leno" as mod
main() {
    // ARR = [1, 2, 3] 应推断为 Array[int]
    int a0 = mod.ARR[0]
    int a1 = mod.ARR[1]
    int a2 = mod.ARR[2]
    assert_eq(a0, 1)
    assert_eq(a1, 2)
    assert_eq(a2, 3)

    // ARR2 = [[1,2],[3,4]] 应推断为 Array[Array[int]]
    int b0 = mod.ARR2[0][0]
    int b1 = mod.ARR2[0][1]
    int b2 = mod.ARR2[1][0]
    int b3 = mod.ARR2[1][1]
    assert_eq(b0, 1)
    assert_eq(b1, 2)
    assert_eq(b2, 3)
    assert_eq(b3, 4)

    // ARR3 = [1, 0.1, "cs"] 混合类型应推断为 Array[any]
    // 元素类型为 any，用 var 接收不报错即可
    var c0 = mod.ARR3[0]
    var c1 = mod.ARR3[1]
    var c2 = mod.ARR3[2]
    assert_eq(c0, 1)
    assert_eq(c1, 0.1)
    assert_eq(c2, "cs")

    print("test_var passed")
}
