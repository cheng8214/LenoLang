// 回归：跨模块 struct 方法的默认参数（含 **use 导入类型** 与 **链式接收者**）
//
// 这里钉两类曾经坏掉、而且坏法很"隐蔽"的形态：
//
// ① `use mod.(StructType)` 导入类型后，本编译单元里的方法条目只是**桩**：
//    形参个数对、默认值信息全丢。codegen 原先只认"本地有真 AST"或"本地完全没有"两条路 ⇒
//    桩存在时两条都落空 ⇒ 省略的实参是 null（实测 `c.add(1)` 报「null 不能参与运算」；
//    同一份代码改用限定名 `new m.Counter()` 就正常 ⇒ 差别只在有没有 use）。
//
// ② **链式接收者**（`m.mkCalc().plus()`、`new Calc(base=1).plus()`）：
//    语义分析只对"接收者是变量/字段链"的形态把 receiver 插进 args[0]，链式不会插 ⇒
//    实参与形参的槽位差一格：①编译期被误报「参数不足」，②codegen 即便填了默认值也填到
//    没人读的下一格 ⇒ 运行期形参是 null。两处都按"不含 self"的坐标修好了
//    （semantic 按符号表折算默认值个数；codegen 归纳化槽位并补 self 副本）。
//
// ③ 顺带钉住：补 self 副本必须用寄存器 MOV，**不能把接收者表达式再求值一遍**
//    （否则 `mkCalcCounted()` 这种带副作用的接收者会被调用两次）。
import "xmod_defaults.leno" as m

use m.Calc

main() {
    // ① use 进来的类型 + 变量接收者：省略默认值也要补上
    var c = new Calc(base = 1)
    assert_eq(c.plus(), 11)            // 默认 v=10
    assert_eq(c.plus(20), 21)          // 传了就用实参
    assert_eq(c.mul(5), 30)            // 5 * 2 * 3
    assert_eq(c.mul(5, 4), 60)         // 5 * 4 * 3
    assert_eq(c.mul(5, 4, 2), 40)
    assert_eq(c.tag(), "s=hi n=7")
    assert_eq(c.tag("x"), "s=x n=7")
    assert_eq(c.tag("x", 1), "s=x n=1")
    // 对照组：无默认值的方法照旧
    assert_eq(c.no_default(3, 4), 34)

    // ② 链式接收者：三种来源都要能补齐默认值
    assert_eq(new Calc(base = 1).plus(), 11)          // new 表达式直接接方法
    assert_eq(m.mkCalc().plus(), 11)                  // 跨模块函数返回值
    assert_eq(m.mkCalc().plus(20), 21)
    assert_eq(m.mkCalc().mul(5), 30)
    assert_eq(m.mkCalc().mul(5, 4, 2), 40)
    assert_eq(m.mkCalc().tag("x"), "s=x n=7")
    assert_eq(m.mkCalc().no_default(3, 4), 34)        // 链式 + 无默认值
    assert_eq(m.mkCalc().plus(5) + m.mkCalc().plus(), 6 + 11)

    // ③ 接收者只求值一次（副作用检查）
    int before = m.mkCalcCalls()
    assert_eq(m.mkCalcCounted().plus(), 11)
    assert_eq(m.mkCalcCalls() - before, 1)

    // ④ 同模块内的默认参数（一直是对的，防止回退时改坏）
    assert_eq(m.add10(5), 15)
    assert_eq(m.add10(5, 20), 25)
    assert_eq(m.scale(3.0), 6.0)
    assert_eq(m.multi(1), "a=1 b=20 c=hi")

    print("[use_struct_default_param] passed")
}
