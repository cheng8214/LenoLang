// 回归测试模块：enum 成员值的三路径一致性
// 配套用例：test_enum_value_consistency.leno
//
// 覆盖的表达式形态（每一种都曾因「扫描器另有一套求值/丢成员」而算错或被丢弃）：
//   A  优先级：2 + 3 * 4      = 14（不是从左到右的 20）
//   B  括号  ：2 * (3 + 4)    = 14（不是 2*3+4 = 10）
//   C  隐式  ：自动递增        = 15（不写 `=` 的成员此前根本不进符号表）
//   D  位运算：1 | 2 << 3     = 17
//   E  负值  ：-1
//   F  成员引用：B + 1        = 15
//   BIG 大值 ：1 << 62        = 4611686018427387904（>2^53，double 承载会舍入）
//   BIN 二进制：0b1010        = 10（词法器此前完全不支持 0b：`0b1010` 被切成 `0` +
//                               标识符 `b1010`，于是模块内/运行期得 0、扫描器得 10）
export enum EV {
    A = 2 + 3 * 4
    B = 2 * (3 + 4)
    C
    D = 1 | 2 << 3
    E = -1
    F = B + 1
    BIG = 1 << 62
    BIN = 0b1010
}

// 表达式形态矩阵（2026-09-16 追加，对应文档 Phase 0.1）：与 test_enum_value_consistency.leno
// 里的 LocalFX **逐字相同**，逐项在三条路径上比绝对值。括号里是期望值。
//
// 为什么要有这个矩阵（而不是"扫全语料"）：漂移来自**求值器语义**，不是某个模块的写法，
// 所以靶子是表达式形态本身。下面每一项要么曾在两套求值器里算不同，要么是两套词表的边界。
//
// 注意 IMPL 之后的 ZERO_DIV/ZERO_MOD 刻意排在**非零前驱**（REF2=271 ⇒ IMPL=272）之后：
// 若某处求值失败退化成"自动递增值"，就会得到 273/274 而不是 0 —— 这次正是这么暴露的
// （见下面两行的注释）。若把失败项放在首位，自动值恰好是 0，错值会被掩盖。
export enum FX {
    PREC = 1 + 2 * 3          // 7     优先级：* 高于 +
    PAREN = (1 + 2) * 3       // 9     括号改变优先级
    NEST = 2 * (3 + 4)        // 14    嵌套括号
    LEFT = 10 - 3 - 2         // 5     左结合
    DIV = 100 / 7             // 14    整数除法截断
    MOD = 100 % 7             // 2     取模
    SHL = 1 << 4              // 16    左移
    SHR = 256 >> 4            // 16    右移
    MIX = 5 ^ 3 & 1           // 4     位运算优先级：& 高于 ^
    ORSH = 1 | 2 << 3         // 17    | 低于 <<
    BNOT = ~0                 // -1    按位取反
    LOGNOT = not 0            // 1     逻辑非：扫描器曾不认 `not`，use 路径得 0（隐含自动值）
    LOGNOT5 = not 5           // 0     逻辑非：同上，use 路径曾得 1
    NEGP = -(2 + 3)           // -5    一元负号 + 括号
    NEGM = -7 % 3             // -1    负号先与字面量结合
    HEX = 0xFF                // 255   十六进制字面量
    HEXBIN = 0x10 + 0b10      // 18    hex + bin 混合
    REF1 = PAREN + 1          // 10    成员引用
    REF2 = SHL + HEX          // 271   两个成员引用
    IMPL                      // 272   隐式递增（紧跟 REF2）
    ZERO_DIV = 5 / 0          // 0     除零：解析器给 0（不报错），扫描器曾判"求值失败"⇒ use 得 273
    ZERO_MOD = 7 % 0          // 0     取模零：同上，use 曾得 274
    BIG = 1 << 62             // 4611686018427387904   >2^53，double 承载会舍入
    NEG = -1                  // -1    负值
    FLOAT = 1.5               // 1     浮点字面量被 (int64_t) 截断（当前语义；是否该报错属开放问题）
    HUGE = 99999999999999999999  // 9223372036854775807  大整数经 strtoll 饱和到 INT64_MAX
}

// 模块侧取值（解析器路径）与迭代取值（ITER_GET 的 enum 分支，曾用 (int) 截断）
export func sum_all():int {
    var s = 0
    for EV to v {
        // 刻意**不写** _int(v)：迭代变量 v 应被推断为 int（枚举成员值是整数常量）。
        // 若类型推断退回 any，本行会直接编译失败（「无法将值赋给变量 's'」）——
        // 这正是本用例要锁住的回归点。
        s = s + v
    }
    return s
}

// 让枚举迭代进入 JIT（内层回边次数超阈值）后取值仍必须正确：
// JIT 的 OP_ITER_GET 走 jit_callout_iter_get，曾用 val_int((int)…) 截断成员值，
// 与解释器路径（已改 val_int_safe）不一致 ⇒ 同一循环 JIT 与否会得到不同的值。
export func sum_all_hot(int rounds):int {
    var total = 0
    for 0:rounds-1 to i {
        for EV to v {
            total = total + v
        }
    }
    return total
}
