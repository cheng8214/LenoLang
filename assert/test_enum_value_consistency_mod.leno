// 回归测试模块：enum 成员值的三路径一致性
// 配套用例：test_enum_value_consistency.leno
//
// 覆盖的表达式形态（每一种都曾因「扫描器另有一套求值/丢成员」而算错或被丢弃）：
//   A  优先级：2 + 3 * 4      = 14（不是从左到右的 20）
//   B  括号  ：2 * (3 + 4)    = 14（不是 2*3+4 = 10）
//   C  隐式  ：自动递增        = 15（不写 `=` 的成员此前根本不进符号表）
//   D  位运算：1 | 2 << 3     = 17
//   E  负值  ：-1
//   F  成员引用：B + 1        = 15
//   BIG 大值 ：1 << 62        = 4611686018427387904（>2^53，double 承载会舍入）
export enum EV {
    A = 2 + 3 * 4
    B = 2 * (3 + 4)
    C
    D = 1 | 2 << 3
    E = -1
    F = B + 1
    BIG = 1 << 62
}

// 模块侧取值（解析器路径）与迭代取值（ITER_GET 的 enum 分支，曾用 (int) 截断）
export func sum_all():int {
    var s = 0
    for EV to v {
        s = s + _int(v)   // 迭代变量是 any（枚举成员值可为 bigint），显式转 int
    }
    return s
}
