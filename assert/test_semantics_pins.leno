// 语言语义**钉桩**（characterization test；2026-10-10，第五批"行为正确性"体检的产物）
//
// 这批用例的性质和别的不同，先说清楚 ✓：
//   它们**不检查"对不对"**（这些语义都是**有意设计** ✓ 框架里到处按它写 ✓），
//   而是把**当前口径钉住** —— 哪天有人改了这些语义，这里会红 ✓，
//   那时**要么**说明是"有意变更"（那就同步改这里的期望值 ✓ 并在提交信息里写清 ✓），
//   **要么**说明是不小心改坏了（那正是本文件的价值 ✓）。
//
// 每条都带**实测值**（2026-10-10 ✓）：都是我先写成探针跑出来、再照实写进来的 ✓
// —— 不看文档猜语义 ✗（这次就有一条差点被我按别的语言的习惯写反 ✗）。

import dirs
import files

// 起编译器子进程 + 判据的共享工具（命令行拼接、失败判据的唯一实现，见 S7）
import "helpers/compiler.leno" as ce

main() {
    var work = dirs.join(_tmpdir(), "leno_semantics_pins")
    dirs.delete(work)
    dirs.mkdir_p(work)
    var n = "\n"

    // P1 ★ struct 是**引用语义**：赋值是共享同一个实例（不是拷贝 ✓）
    //   框架里到处依赖这条 ✓（sdl_radio 的互斥注册表、web_gzip 的就地修改、web_html 的节点比较 ✓）
    var p1 = dirs.join(work, "struct_ref_assign.leno")
    files.write(p1, "struct P { int x = 1 }" + n
        + "main() {" + n
        + "    var a = new P()" + n
        + "    var b = a" + n
        + "    b.x = 7" + n
        + "    print(_str(a.x) + \"\\n\")" + n
        + "}" + n)
    ce.expect_ok(p1, "struct 赋值是共享实例（改 b 看 a）", "7")

    // P2：想独立就各自 new ✓（互不影响 ✓）
    var p2 = dirs.join(work, "struct_two_new.leno")
    files.write(p2, "struct P { int x = 1 }" + n
        + "main() {" + n
        + "    var a = new P()" + n
        + "    var b = new P()" + n
        + "    b.x = 7" + n
        + "    print(_str(a.x) + \"|\" + _str(b.x) + \"\\n\")" + n
        + "}" + n)
    ce.expect_ok(p2, "各自 new 互不影响", "1|7")

    // P3 ★ 切片是**闭区间**（两端都含 ✓）—— 与 `for A : B` 同口径 ✓
    //   ⚠ 从别的语言过来最容易差一位 ✗（那边多半是 [0:1) ✓）
    var p3 = dirs.join(work, "slice_closed.leno")
    files.write(p3, "main() { print(\"中文字\"[0:1] + \"|\\n\") }" + n)
    ce.expect_ok(p3, "切片闭区间（[0:1] 取到两个字）", "中文|")

    // P4：`.len()` 数的是**字符**不是字节 ✓（汉字算 1 ✓）
    var p4 = dirs.join(work, "len_chars.leno")
    files.write(p4, "main() { print(_str(\"中文abc\".len()) + \"\\n\") }" + n)
    ce.expect_ok(p4, "len() 数字符（2 汉字 + 3 字母 = 5）", "5")

    // P5 ★ 除法 / 取模 / `_int()` 都是 **C 式向零截断** ✓
    //   ⚠ 别按 Python 的直觉写 ✗（那边 -7 % 3 = 2 ✓ 这里 -1 ✓）
    var p5 = dirs.join(work, "c_style_int.leno")
    files.write(p5, "main() {" + n
        + "    print(_str(-7 / 2) + \" \" + _str(-7 % 3) + \" \" + _str(_int(-3.7)) + \"\\n\")" + n
        + "}" + n)
    ce.expect_ok(p5, "C 式截断：-7/2=-3、-7%3=-1、_int(-3.7)=-3", "-3 -1 -3")

    // P6：整数运算会**升 bigint**（不静默翻负 ✓）
    var p6 = dirs.join(work, "bigint_promote.leno")
    files.write(p6, "main() { print(_str(2147483647 + 1) + \"\\n\") }" + n)
    ce.expect_ok(p6, "整数溢出升 bigint", "2147483648")

    // P7：浮点打印是**全精度**（要显示就自己格式化 ✓）
    var p7 = dirs.join(work, "float_precision.leno")
    files.write(p7, "main() { print(_str(0.1 + 0.2) + \"\\n\") }" + n)
    ce.expect_ok(p7, "浮点全精度输出", "0.30000000000000004")

    // P8：struct 与 null 比较**恒为 false**（结构体值不为 null ✓ 同时还有专门告警 ✓）
    //   ⚠ "引用语义" 与 "不为 null" 两件事同时成立 ✓ 别搞混 ✗
    var p8 = dirs.join(work, "struct_eq_null.leno")
    files.write(p8, "struct P { int x = 1 }" + n
        + "main() {" + n
        + "    var a = new P()" + n
        + "    print(_str(a == null) + \"\\n\")" + n
        + "}" + n)
    ce.expect_ok(p8, "struct == null 恒 false", "false")

    // P9（对照 ✓）：短路求值不执行右侧 —— `false and f()` 里 f 不能跑 ✓
    //   （这条**是**"对不对"型 ✓ 不是钉桩 —— 放这里是因为它同属"行为正确性"这批 ✓）
    var p9 = dirs.join(work, "short_circuit.leno")
    files.write(p9, "func t(): bool { print(\"SIDE\") ; return true }" + n
        + "main() { bool r = false and t(); print(_str(r) + \"\\n\") }" + n)
    ce.expect_ok(p9, "短路求值不执行右侧（输出里不能有 SIDE）", "false")

    // ---------- 第六批（容器/数值/相等 ✓）实测后补的钉桩 ----------

    // P10 ★ `==` 口径：**数组逐元素 ✓、字典按引用 ✗**（明文出处：src/vm/vm.c:1219 的注释 ✓）
    //   最容易咬人的一条 ✓：两个"看起来一样"的字典**不相等** ✓
    var p10 = dirs.join(work, "eq_semantics.leno")
    files.write(p10, "main() {" + n
        + "    print(_str([1, 2] == [1, 2]) + \"|\" + _str({\"a\": 1} == {\"a\": 1}) + \"\\n\")" + n
        + "}" + n)
    ce.expect_ok(p10, "数组比内容 / 字典比引用", "true|false")

    // P11：`arr.sum()` **返回 float**（纯 int 数组也是 ✓）—— 有意设计 ✓ 理由在 module_arrays.md:305 ✓
    var p11 = dirs.join(work, "sum_float.leno")
    files.write(p11, "main() { print(_str([1, 2, 3].sum()) + \"\\n\") }" + n)
    ce.expect_ok(p11, "sum() 返回 float（6.0）", "6.0")

    // P12：空数组 `pop()` ⇒ **null、不抛错**（对比：`a[5]`/`remove(越界)` 会抛 ✓ 口径不齐 ✓）
    var p12 = dirs.join(work, "empty_pop.leno")
    files.write(p12, "main() {" + n
        + "    var e = []" + n
        + "    var r = e.pop()" + n
        + "    print(_str(r) + \"|\" + _str(e.len()) + \"\\n\")" + n
        + "}" + n)
    ce.expect_ok(p12, "空 pop ⇒ null 且长度仍 0", "null|0")

    // P13：`_int()` 解析**严**（不去空格 ✗）—— 解析用户输入要先 trim ✓
    var p13 = dirs.join(work, "int_strict.leno")
    files.write(p13, "main() {" + n
        + "    string v = \"-\"" + n
        + "    try { v = _str(_int(\" 5 \")) } catch { v = \"THREW\" }" + n
        + "    print(v + \"\\n\")" + n
        + "}" + n)
    ce.expect_ok(p13, "_int(\" 5 \") 会抛（不自动 trim）", "THREW")

    // P14：`arrays.copy` **深到元素级** ✓（容器独立 ✓ struct 元素也造新实例 ✓）
    //   ⚠ 与 P1 的 struct 引用语义对照 ✓：赋值共享、copy 独立 ✓
    var p14 = dirs.join(work, "array_copy_deep.leno")
    files.write(p14, "import arrays" + n
        + "struct P { int x = 1 }" + n
        + "main() {" + n
        + "    var a = [1, 2]" + n
        + "    var b = arrays.copy(a)" + n
        + "    a.add(3)" + n
        + "    var s1 = [new P()]" + n
        + "    var s2 = arrays.copy(s1)" + n
        + "    s2[0].x = 9" + n
        + "    print(_str(a.len()) + \"|\" + _str(b.len()) + \"|\" + _str(s1[0].x) + \"\\n\")" + n
        + "}" + n)
    ce.expect_ok(p14, "arrays.copy 深到元素级", "3|2|1")

    // ---------- 第八批（长跑/GC ✓）实测后补的钉桩 ----------

    // P15 ★ **大量分配之后，先前持有的数据不变形** ✓（GC 正确性的最小回归 ✓）
    //   实测背景（2026-10-10）：百万次字符串分配（G7/H2 ✓）之后，先持有的一批字符串
    //   内容逐个正确 ✓；这里取 2 万次（约 20ms ✓）作轻量版 ✓ —— 退化就说明 GC 出问题 ✓
    //   ⚠ 断言**同时钉"计数"和"内容"** ✓：只看计数抓不住"内容被改写"✗
    var p15 = dirs.join(work, "gc_long_run.leno")
    files.write(p15, "main() {" + n
        + "    Array[string] keep = []" + n
        + "    int total = 0" + n
        + "    int i = 0" + n
        + "    while i < 20000 {" + n
        + "        string s = \"v\" + _str(i)" + n
        + "        total = total + s.len()" + n
        + "        if i % 5000 == 0 { keep.add(s) }" + n
        + "        i = i + 1" + n
        + "    }" + n
        + "    string chk = \"\"" + n
        + "    for keep to t { chk = chk + t + \",\" }" + n
        + "    print(_str(total) + \"|\" + chk + \"\\n\")" + n
        + "}" + n)
    ce.expect_ok(p15, "长跑 2 万次分配后既有数据不变形", "108890|v0,v5000,v10000,v15000,")

    // ---------- 第九批（正则/JSON/文件/目录 ✓）实测后补的钉桩 ----------

    // P16 ★ **2026-10-10 改（A 组第 5 条）**：`find` 与 `find_all` 统一成**字符**下标 ✓
    //   ⚠ **这条钉桩原来钉的是"两种口径"** ✗（`find` 按字符 ✓ / `find_all` 按字节 ✗）——
    //     而"find 按字符"这个结论**本身就是错的** ✗：它用的例子 `"abc中文def"` 前三个字符
    //     是 ASCII ⇒ **字节 == 字符** ✗ **区分不出来** ✓（重新实测：`"中文字abc"` 找 `"abc"`
    //     ⇒ 旧值 **9** ✗，字符应是 **3** ✓）⇒ 两者其实**一直一致**（都是字节 ✗），
    //     只是"与切片 / `.len()` / `strings.find` 不一致" ✗ ⇒ 现在统一到**字符** ✓。
    //   ⚠ 例子必须**能区分**两种口径 ✗（"中文字abc" ✓ 而不是 "abc中文def" ✗）——
    //     这条教训值钱：**例子选错 ⇒ 结论错了还被当成"实测过"** ✓
    //   ⚠ `end` 仍是**不含**（开区间尾巴 ✓），而切片是**闭区间** ⇒ 用法 `s[m.start : m.end-1]` ✓
    var p16 = dirs.join(work, "regex_offsets.leno")
    files.write(p16, "import regexs" + n
        + "main() {" + n
        + "    int c = regexs.find(\"中文字abc\", \"abc\")" + n
        + "    var ms = regexs.find_all(\"a中b中\", \"中\")" + n
        + "    var s = \"a中b中\"" + n
        + "    print(_str(c) + \"|\" + _str(ms[0].start) + \",\" + _str(ms[1].start)" + n
        + "        + \"|\" + s[ms[0].start : ms[0].end - 1] + \"\\n\")" + n
        + "}" + n)
    ce.expect_ok(p16, "find/find_all 都按字符（3|1,3|中，且切片对得上）", "3|1,3|中")

    // P17：`jsons.decode` **解析失败 ⇒ null**（不抛错 ✓）—— 必须自己判 null ✓
    var p17 = dirs.join(work, "json_bad_decode.leno")
    files.write(p17, "import jsons" + n
        + "main() {" + n
        + "    print(_str(jsons.decode(\"{bad}\") == null) + \",\" + _str(jsons.decode(\"\") == null) + \"\\n\")" + n
        + "}" + n)
    ce.expect_ok(p17, "decode 失败给 null（不抛错）", "true,true")

    // P18：`files.read` 读**不存在**的文件 ⇒ **抛错** ✓（不是静默 null ✓ —— 这条是"好"的口径 ✓）
    var p18 = dirs.join(work, "read_missing.leno")
    files.write(p18, "import files" + n
        + "main() {" + n
        + "    string v = \"-\"" + n
        + "    try { v = _str(files.read(\"Z:\\\\绝对不存在的文件.txt\")) } catch e { v = \"THREW\" }" + n
        + "    print(v + \"\\n\")" + n
        + "}" + n)
    ce.expect_ok(p18, "读不存在文件会抛错", "THREW")

    // P19：`dirs.join` 是**朴素拼接**（不归一化 ✓）⇒ 自己塞 `/` 会拼出混用分隔符 ✗
    //   ⚠ 这条钉的是**当前口径** ✓（文档 :165 也这么写 ✓）：别自己往 join 的参数里塞斜杠 ✗
    var p19 = dirs.join(work, "dirs_join.leno")
    files.write(p19, "import dirs" + n
        + "main() { print(dirs.join(\"a/\", \"/b\") + \"\\n\") }" + n)
    ce.expect_ok(p19, "dirs.join 朴素拼接（不归一化）", "a\\/b")

    // ---------- 第十批（数值/随机 ✓）实测后补的钉桩 ----------

    // P20 ★ `.round()` 遇 .5 **远离零**（不是银行家舍入 ✗）；floor/ceil 对负数的口径 ✓
    var p20 = dirs.join(work, "num_rounding.leno")
    files.write(p20, "import maths" + n
        + "main() {" + n
        + "    print(_str((2.5).round()) + \"|\" + _str((-2.5).round()) + \"|\"" + n
        + "        + _str((-3.5).floor()) + \"|\" + _str((-3.5).ceil()) + \"|\"" + n
        + "        + _str(maths.max(1, 2)) + \"\\n\")" + n
        + "}" + n)
    ce.expect_ok(p20, "round 远离零 / floor / ceil / max 返回 float",
        "3.0|-3.0|-4.0|-3.0|2.0")

    // P21 ★ `rands.ints(a, b)` 的**上界含**（闭区间 ✓ 与 for A : B 同口径 ✓）
    //   200 次抽样里 0 与 3（两端）都必须出现 ✓ —— 只看"值域不越界"抓不住半开/闭区间 ✗
    var p21 = dirs.join(work, "rands_inclusive.leno")
    files.write(p21, "import rands" + n
        + "main() {" + n
        + "    rands.seed(7)" + n
        + "    int lo = 99" + n
        + "    int hi = -99" + n
        + "    int i = 0" + n
        + "    while i < 200 {" + n
        + "        int x = rands.ints(0, 3)" + n
        + "        if x < lo { lo = x }" + n
        + "        if x > hi { hi = x }" + n
        + "        i = i + 1" + n
        + "    }" + n
        + "    print(_str(lo) + \"|\" + _str(hi) + \"\\n\")" + n
        + "}" + n)
    ce.expect_ok(p21, "rands.ints 上界含（两端都出现过）", "0|3")

    // P22/P23：`rands.str` / `rands.bools` 的**参数都是必填**（文档此前写错 ✗ 已修正 ✓）
    //   这条钉的是"编译期就该拦住" ✓（别让用户以为有默认值 ✓）
    var p22 = dirs.join(work, "rands_str_arity.leno")
    files.write(p22, "import rands" + n
        + "main() { print(rands.str(8) + \"\\n\") }" + n)
    ce.expect_error(p22, "rands.str 缺 chars ⇒ 编译期拦住", "参数数量不匹配", 0)

    var p23 = dirs.join(work, "rands_bools_arity.leno")
    files.write(p23, "import rands" + n
        + "main() { print(_str(rands.bools()) + \"\\n\") }" + n)
    ce.expect_error(p23, "rands.bools 缺 probability ⇒ 编译期拦住", "参数数量不匹配", 0)

    // ---------- 第十一批（types/io ✓）实测后补的钉桩 ----------

    // P24 ★ `print` **换行**、`printf` **不换行**、且 `printf` **不做 % 替换** ✗
    //   （名字叫 printf ✗ 语义只是"不换行打印" ✓ —— 最容易误用的一条 ✓）
    var p24 = dirs.join(work, "print_vs_printf.leno")
    files.write(p24, "import io" + n
        + "main() {" + n
        + "    printf(\"[P1]\")" + n
        + "    printf(\"[P3]\")" + n
        + "    printf(\"%d|%s\", 3, \"x\")" + n
        + "    print(\"\")" + n
        + "}" + n)
    //   ⚠ 钉法要**与行尾风格无关** ✓：两个 printf 的输出必须**紧挨着**（证明它不加换行 ✓）；
    //     若改用 "A\nB" 这种期望 ✗ 就会被 \r\n / \n 的差异搞成假失败 ✓（我第一版就这么挂的 ✗）。
    //     "format 串与实参之间怎么拼"我仍未查清 ✗ ⇒ 不当承诺 ✓（别把没查清的事写成断言 ✗）
    ce.expect_ok(p24, "printf 不换行（两段输出紧挨着）", "[P1][P3]")

    // P25 ★ `_bool` 的**字符串真值**：非空恒真 ✗（"false" 也是 true ✗）
    var p25 = dirs.join(work, "bool_truthy.leno")
    files.write(p25, "import types" + n
        + "main() {" + n
        + "    print(_str(_bool(\"false\")) + \"|\" + _str(_bool(\"0\")) + \"|\"" + n
        + "        + _str(_bool(\"\")) + \"|\" + _str(_bool(0)) + \"\\n\")" + n
        + "}" + n)
    ce.expect_ok(p25, "_bool：非空字符串恒真", "true|true|false|false")

    // P26 ★ `_int_or(null, 默认)` ⇒ **默认值** ✓（**2026-10-10 改** / B 组第 9 条）
    //   ⚠ 这条钉桩**原来钉的是 `null ⇒ 0`** ✗（把它当成"实测口径"记下来了 ✓）。
    //     改的理由：本函数的契约就是"**拿不到就给默认值**"✓（源码注释自己写着 ✓），
    //     而同类口径本来就不一致 ✗（`_int_or("", -1)` ⇒ -1 ✓、`_int_or(容器, d)` ⇒ d ✓、
    //     只有 `null` ⇒ 0 ✗）⇒ 这是**不一致**不是设计 ✓（与 `_env_or("不存在", 兜底)` ⇒ 兜底 ✓
    //     同一族 ✓）。
    //   ⚠ 影响面（**改前扫过** ✓）：真实调用点全是 `_int_or(x, 0)`（LenoMusic 两处 ✓）
    //     ⇒ 默认是 0 时**行为完全不变** ✓ ⇒ 不会动到既有应用 ✓。
    //   ⚠ 没动的那半条：`" 7 "` 仍因**不 trim** ⇒ 回默认值 ✓（要 trim 请自己写 strings.trim ✓）
    var p26 = dirs.join(work, "int_or_null.leno")
    files.write(p26, "import types" + n
        + "main() {" + n
        + "    print(_str(_int_or(null, 42)) + \"|\" + _str(_int_or(\" 7 \", 42)) + \"|\"" + n
        + "        + _str(_int_or(\"7\", 42)) + \"|\" + _str(_int_or(null, 0)) + \"\\n\")" + n
        + "}" + n)
    ce.expect_ok(p26, "_int_or：null 取默认值 / 不 trim 仍回默认 / 能转照转", "42|42|7|0")

    // ---------- 第十二批（FFI / cstruct ✓）实测后补的钉桩 ----------

    // P27 ★ cstruct 布局与 **C ABI 逐项一致** ✓（size / offset_of / alignment ✓）
    //   钉住它 = 钉住"能安全地和 C 共享内存布局"这件承诺 ✓（哪天布局算法被改坏会红 ✓）
    var p27 = dirs.join(work, "cstruct_layout.leno")
    files.write(p27, "cstruct Normal { u8 a  i32 b  u8 c }" + n
        + "packed cstruct PackedDemo { u8 a  i32 b  u8 c }" + n
        + "align(16) cstruct A { i32 a }" + n
        + "cstruct Ar { i32 n  i32 v[4] }" + n
        + "main() {" + n
        + "    var nn = Normal.malloc()" + n
        + "    var qq = PackedDemo.malloc()" + n
        + "    var aa = A.malloc()" + n
        + "    var ar = Ar.malloc()" + n
        + "    print(_str(nn.size()) + \"|\" + _str(nn.offset_of(\"b\")) + \"|\" + _str(nn.offset_of(\"c\")) + \"|\" + _str(nn.alignment())" + n
        + "        + \"|\" + _str(qq.size()) + \"|\" + _str(qq.offset_of(\"b\")) + \"|\" + _str(qq.alignment())" + n
        + "        + \"|\" + _str(aa.size()) + \"|\" + _str(aa.alignment())" + n
        + "        + \"|\" + _str(ar.size()) + \"|\" + _str(ar.offset_of(\"v\")) + \"\\n\")" + n
        + "    nn.free(); qq.free(); aa.free(); ar.free()" + n
        + "}" + n)
    ce.expect_ok(p27, "cstruct 布局对齐 C ABI（Normal/packed/align16/数组字段）",
        "12|4|8|4|6|1|1|16|16|20|4")

    // P28 ★ **非对齐** int64 读写是正确的 ✓（可以放心按字节偏移拼包 ✓）
    var p28 = dirs.join(work, "ffi_unaligned.leno")
    files.write(p28, "import ffi" + n
        + "main() {" + n
        + "    Ptr p = ffi.malloc(16)" + n
        + "    ffi.write_int64(p, 0, 1234567890123)" + n
        + "    ffi.write_double(p, 8, 3.25)" + n
        + "    string ok = _str(ffi.read_int64(p, 0)) + \"|\" + _str(ffi.read_double(p, 8))" + n
        + "    ffi.write_int64(p, 1, 42)" + n
        + "    print(ok + \"|\" + _str(ffi.read_int64(p, 1)) + \"\\n\")" + n
        + "    ffi.free(p)" + n
        + "    ffi.free(ffi.nullptr())" + n
        + "    print(\"free(null) ok\\n\")" + n
        + "}" + n)
    ce.expect_ok(p28, "非对齐 int64 读写正确 / free(null) 安全",
        "1234567890123|3.25|42")

    // P29：`ffi.alloc("int")` **初值可省** ✓（清零 ✓）
    var p29 = dirs.join(work, "ffi_alloc_optional.leno")
    files.write(p29, "import ffi" + n
        + "main() {" + n
        + "    Ptr a = ffi.alloc(\"int\")" + n
        + "    Ptr b = ffi.alloc(\"int\", 7)" + n
        + "    print(_str(ffi.read_int(a, 0)) + \"|\" + _str(ffi.read_int(b, 0)) + \"\\n\")" + n
        + "}" + n)
    ce.expect_ok(p29, "ffi.alloc 初值可省（清零）", "0|7")

    // ---------- 第十三批（asyncs 深化 ✓）实测后补的钉桩 ----------

    // P30 ★ `asyncs.all`：**未完成的 Future ⇒ 抛错**（2026-10-10 改 ✓，A 组第 2 条）
    //   ⚠ **这条钉桩本身也改过** ✗（值得记着）：原版钉的是"不 await ⇒ **静默全 null**" ✓
    //     —— 那是当时的**实现行为**，但它是**静默给错值** ✗（看起来像"协程没跑"，
    //     而不是"你没等它" ✗）⇒ 本轮改成**抛错**：把静默错值变成响的 ✓ 且文案给出
    //     两种正确做法 ✓（先 await / 先 asyncs.run()；或改用 is_done + get_result ✓）。
    //   ⚠ 用例**必须**在 `asyncs.run()` **之前**看那一眼 ✗ —— 先 run() 再 all 的话
    //     两个 Future 早完成了 ⇒ "坏情况"根本不成立 ⇒ 断言假失败 ✓（"用例先自证" ✓）
    //   ⚠ 全量套件实测：改动只挂这**一条**钉桩 ✓（其余 435 条全过 ✓）⇒ 全仓没有
    //     任何地方依赖"静默 null"这个旧行为 ✓（这条实测数据比"我觉得安全"值钱 ✓）
    var p30 = dirs.join(work, "asyncs_all.leno")
    files.write(p30, "import asyncs" + n
        + "import strings" + n
        + "async func job(int v): int { await asyncs.sleep(1); return v }" + n
        + "main() {" + n
        + "    var a = job(1)" + n
        + "    var b = job(2)" + n
        + "    try {" + n
        + "        var bad = asyncs.all([a, b])" + n
        + "        printf(\"noThrow=\" + _str(bad) + \"|\")" + n
        + "    } catch e {" + n
        + "        printf(\"threw=\" + _str(strings.has(_str(e.msg), \"还没完成\")) + \"|\")" + n
        + "    }" + n
        + "    asyncs.run()" + n
        + "    print(\"afterRun=\" + _str(asyncs.all([a, b])) + \"\\n\")" + n
        + "}" + n)
    ce.expect_ok(p30, "all：未完成 ⇒ 抛错（文案说清）+ 跑完 ⇒ 真结果",
        "threw=true|afterRun=[1, 2]")

    // P31：`timeout / sleep / yield` 在**非 async** 上下文里 ⇒ **明确报错** ✓（不是静默 ✓）
    var p31 = dirs.join(work, "asyncs_guard.leno")
    files.write(p31, "import asyncs" + n
        + "main() { print(_str(asyncs.sleep(1)) + \"\\n\") }" + n)
    ce.expect_error(p31, "sleep 在 main 里 ⇒ 编译/运行期明确拦住", "只能在 async 函数中调用", 0)

    // P32：嵌套 await（协程里等协程 ✓）⇒ 结果正确 ✓
    var p32 = dirs.join(work, "asyncs_nested_await.leno")
    files.write(p32, "import asyncs" + n
        + "async func inner(int v): int { await asyncs.sleep(1); return v + 1 }" + n
        + "async func outer(int v): int { var r = await inner(v); return r * 10 }" + n
        + "main() {" + n
        + "    var f = outer(4)" + n
        + "    asyncs.run()" + n
        + "    print(_str(asyncs.get_result(f)) + \"\\n\")" + n
        + "}" + n)
    ce.expect_ok(p32, "嵌套 await ⇒ (4+1)*10 = 50", "50")

    dirs.delete(work)

    print("test_semantics_pins passed")
}
