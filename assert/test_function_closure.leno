// 函数与闭包测试
func add(any a, any b) {
    return a + b
}
assert_eq(add(3, 4), 7)
assert_eq(add(1.5, 2.5), 4.0)

func factorial(int n) {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}
assert_eq(factorial(5), 120)
assert_eq(factorial(0), 1)

func make_counter() {
    var count = 0
    func increment() {
        count = count + 1
        return count
    }
    return increment
}

var counter = make_counter()
assert_eq(counter(), 1)
assert_eq(counter(), 2)
assert_eq(counter(), 3)

func make_adder(any x) {
    func adder(any y) {
        return x + y
    }
    return adder
}

var add5 = make_adder(5)
assert_eq(add5(3), 8)
assert_eq(add5(10), 15)

// ---- dict 里存函数 ⇒ "取出的值当函数调用"（2026-09-28；实例三十六）----
//   背景：`ops["double"](5)` 这类写法原来被当成"dict 的方法"而报
//   「类型 'Dict[string, func(any):any]' 没有方法 'double'」（提示还误导成"数组切片"）。
//   dict **没有自定义方法** ⇒ 非内置方法名应当按"key 取出来的值"调用 ✓。
var ops = {"double": func(any x) { return x * 2 }, "inc": func(any x) { return x + 1 }}
assert_eq(ops["double"](5), 10)
assert_eq(ops["inc"](5), 6)

// 值类型是 `any` 的字典同样按"调用值"处理（闭包工厂返回的"方法字典"就是这一形态）
// ⚠ 键名**不要叫内置 Dict 方法名**（如 get/len/has/keys…）—— 那样会被当方法查，
//   于是走 arity 检查而不是"调用值"（实测 `m["get"]()` ⇒ 调用方法 'get' 时参数过少）。
var m = {}
m.set("fetch", func() { return 42 })
assert_eq(m["fetch"](), 42)

// ⚠ 反向：**与内置方法相似**的名字仍当拼错报错（`d.leng()` ⇒ 提示 len）——
//   该判据在 test_diag_static_errors.leno 里守着（这里只留说明，避免把负例混进本文件）。
print("test_function_closure passed")
