// 泛型约束测试 - 验证 T: FaceName 语法解析及基础设施

// --- 1. 无约束泛型函数仍正常工作 ---
func identity[T](T v): T {
    return v
}

// --- 2. 带约束的泛型函数可以定义（只做算术，不调 face 方法） ---
face Comparable {
    func compare(Comparable other): int
}

func maxBy[T: Comparable](T a, T b): T {
    if a.compare(b) >= 0 { return a }
    return b
}

// --- 3. struct 带约束定义 ---
struct SortedBox[T: Comparable] {
    T value
}

// --- 4. 多约束（一个约束一个不约束） ---
struct Pair[K, V: Comparable] {
    K key
    V val
}

// --- 5. 约束函数配合无约束泛型调用 ---
func wrap[T: Comparable](T v): T {
    return identity[T](v)  // T 传给无约束泛型
}

// --- 6. face 带泛型参数约束 ---
face Container[T] {
    func put(T item)
    func get(): T
}

// face 自身带参数，可约束
struct IntBox {
    int value = 0
    func put(int item) { self.value = item }
    func get(): int { return self.value }
}

// --- 7. struct impl Comparable，泛型约束调用 face 方法 ---
struct OrdInt impl Comparable {
    int value = 0
    func compare(Comparable other): int {
        var o = other as OrdInt
        if self.value < o.value { return -1 }
        if self.value > o.value { return 1 }
        return 0
    }
}

struct OrdStr impl Comparable {
    string value = 0
    func compare(Comparable other): int {
        var o = other as OrdStr
        if self.value < o.value { return -1 }
        if self.value > o.value { return 1 }
        return 0
    }
}

// --- 执行测试 ---
main() {
    // 1. 无约束泛型不变
    assert_eq(identity[int](42), 42)
    assert_eq(identity[string]("hello"), "hello")

    // 2. 带约束函数调用 struct impl Comparable 的 face 方法
    var a1 = new OrdInt(value=10)
    var b1 = new OrdInt(value=20)
    var r1 = maxBy(a1, b1)
    var ri1 = r1 as OrdInt
    assert_eq(ri1.value, 20)

    var a2 = new OrdInt(value=50)
    var b2 = new OrdInt(value=30)
    var r2 = maxBy(a2, b2)
    var ri2 = r2 as OrdInt
    assert_eq(ri2.value, 50)

    var s1 = new OrdStr(value="apple")
    var s2 = new OrdStr(value="banana")
    var rs = maxBy(s1, s2)
    var ris = rs as OrdStr
    assert_eq(ris.value, "banana")

    // 3. 约束 struct 实例化（T 必须实现 Comparable ⇒ 用 OrdInt）
    var box = new SortedBox[OrdInt](value=new OrdInt(value=100))
    assert_eq(box.value.value, 100)

    // 4. 混合约束 struct（K 无约束、V 必须是 Comparable）
    var p = new Pair[string, OrdInt](key="key", val=new OrdInt(value=100))
    assert_eq(p.key, "key")
    assert_eq(p.val.value, 100)

    // 5. 约束函数调用无约束函数（T 必须满足 face 约束 ⇒ 用实现了 Comparable 的 struct ✓）
    var w1 = wrap[OrdInt](new OrdInt(value=42))
    assert_eq((w1 as OrdInt).value, 42)
    var w2 = wrap[OrdStr](new OrdStr(value="test"))
    assert_eq((w2 as OrdStr).value, "test")

    // 6. 非约束泛型嵌套在约束里（T 仍须实现 Comparable）
    var strBox = new SortedBox[OrdStr](value=new OrdStr(value="abc"))
    assert_eq(strBox.value.value, "abc")

    print("test_generic_constraint: ALL PASSED")
}
