// 泛型约束完整测试 - T: FaceName 语法 + 基本用法

// 基础结构
face Comparable {
    func compare(Comparable other): int
}

struct IntBox impl Comparable {
    int value
    func compare(Comparable other): int {
        var o = other as IntBox
        if self.value < o.value { return -1 }
        if self.value > o.value { return 1 }
        return 0
    }
}

// --- 1. 带约束的泛型函数（算术运算，不调 face 方法） ---
func maxBy[T: Comparable](T a, T b): T {
    if a >= b { return a }
    return b
}

// --- 2. 约束 struct 实例化 ---
struct SortedBox[T: Comparable] {
    T value
}

// --- 3. 混合约束（一个约束一个不约束） ---
struct Pair[K, V: Comparable] {
    K key
    V val
}

// --- 4. 约束函数调用无约束泛型 ---
func identity[T](T v): T { return v }
func wrap[T: Comparable](T v): T {
    return identity[T](v)
}

// --- 5. face 自身带泛型参数 ---
face Container[T] {
    func put(T item)
    func get(): T
}

main() {
    // 1. 无约束泛型不变
    assert_eq(identity[int](42), 42)
    assert_eq(identity[string]("hello"), "hello")

    // 2. 带约束函数算术比较
    assert_eq(maxBy[int](10, 20), 20)
    assert_eq(maxBy[float](3.5, 1.2), 3.5)

    // 3. 约束 struct
    var box = new SortedBox[int](value=100)
    assert_eq(box.value, 100)

    // 4. 混合约束 struct
    var p = new Pair[string, float](key="k", val=3.14)
    assert_eq(p.key, "k")
    assert_eq(p.val, 3.14)

    // 5. 约束函数调无约束
    assert_eq(wrap[int](42), 42)

    // 6. struct 实例调用自己方法（直接在 main，不在泛型内）
    var a = new IntBox(value=10)
    var b = new IntBox(value=20)
    assert_eq(a.compare(b), -1)

    // 7. 约束兼容 - SortedBox[string] 正常
    var strBox = new SortedBox[string](value="abc")
    assert_eq(strBox.value, "abc")

    print("test_generic_constraint: ALL PASSED")
}
