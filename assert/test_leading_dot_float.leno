// 前导小数点浮点 `.5`（B2，2026-11-02）
//
// 判据：`.` 后面必须是数字，且 `.` 前面**刚结束一个表达式**时（标识符 / `)` / `]` / 数字）
// 仍然当成员访问 ⇒ `p.x` / `arr[0].y` / `(obj).f` 全部照旧。
// 数值转换补一个前导 '0'（`.5` ⇒ `0.5`），下划线分隔同样支持。

struct Point2 {
    int x = 7
    float y = 1.0
}

main() {
    // ① 基本
    assert_eq(.5, 0.5, ".5")
    assert_eq(.25, 0.25, ".25")

    // ② 负数（`-` 是前缀运算符，不参与词法）
    assert_eq(-.5, -0.5, "-.5")

    // ③ 指数
    assert_eq(.5e3, 500.0, ".5e3")
    assert_eq(.5e-2, 0.005, ".5e-2")

    // ④ 表达式里
    assert_eq(.5 + .5, 1.0, ".5 + .5")
    assert_eq(1.0 - .5, 0.5, "1.0 - .5")
    assert_eq(.5 * 4, 2.0, ".5 * 4")

    // ⑤ 不误伤成员访问
    Point2 p = new Point2()
    assert_eq(p.x, 7, "p.x")
    assert_eq((p).x, 7, "(p).x")
    var arr = [1, 2, 3]
    assert_eq(arr[0], 1, "arr[0]")
    assert_eq(arr.len(), 3, "arr.len()")

    // ⑥ 与 `0.5` 完全等价
    assert_eq(.5, 0.5, "与 0.5 等值")
    assert_eq(type(.5), type(0.5), "类型一致（float）")

    print("test_leading_dot_float all passed")
}
