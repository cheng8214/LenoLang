// test_string_perf.leno — 测量字符串拼接性能（大文本场景）
import arrays
import strings
import times
import io

main() {
    io.print("=== 字符串拼接性能测量 ===\n")

    // 构造大文本（重复 "abcde" 10000 次 = 5万字符）
    string chunk = "abcde"
    int repeat = 10000

    // 方式1: 直接 + 拼接
    int t1 = times.ms()
    string s1 = ""
    for repeat to i {
        s1 = s1 + chunk
    }
    int dt1 = times.ms() - t1
    io.print("[1] 直接+拼接 " + s1.len() + " 字符耗时 " + dt1 + "ms")

    // 方式2: 数组收集 + join
    int t2 = times.ms()
    Array[string] buf = []
    for repeat to i {
        buf.add(chunk)
    }
    string s2 = arrays.join(buf, "")
    int dt2 = times.ms() - t2
    io.print("[2] 数组+join " + s2.len() + " 字符耗时 " + dt2 + "ms")

    io.print("\n=== 性能测量完成 ===")
}
