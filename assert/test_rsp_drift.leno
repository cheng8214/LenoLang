// 回归测试：短路 `and` / `or` 在**热循环**里反复执行时，各条分支都必须走对且结果正确
//
// 三种形状都覆盖：`and` 短路 / 单条件 / `or` 短路。每桶 5000 轮 × 101 桶，
// 本文件取 101 × 20000 = 2.02M 轮 ⇒ "每轮多算/少算一点"的错误会被放大到断言失败。
// 历史（2026-09-14）：当时的机器码生成在**合并点**（一条跳转的目标恰好是另一条的直落点）
// 只按"直落"形态发码 ⇒ 跳转路径多压的那一项永远没人消费 ⇒ 每轮泄漏 8 字节、
// RSP 单调下漂撞到栈底后以 0xC00000FD 崩溃（**不是断言失败，是进程崩溃**）；
// 实测约 55 万轮是临界点 ⇒ 本文件留 3.7 倍余量，现在仍是毫秒级。
// 期望值都是编译期算好的绝对数值（与执行路径无关）。

var bad = 0

func fail(int tag):int {
    print("FAIL case " + tag)
    bad = bad + 1
    return 0
}

main() {
    // ---- 数据：logs[i] = 250 + i%50（值域 250..299）、ms[i] = 1 ----
    //   多次运行的实测漂移量（未修复版）：退出码 0xC00000FD
    var n = 20000
    var logs = []
    var ms = []
    for 0 : n - 1 to i {
        logs.add(250 + (i % 50))
        ms.add(1)
    }

    // ---- 形状 A：`and` 短路 + 体内数组读（漏点原形）----
    //   只有 b0=250 那个桶（250..299）命中：s = 5000 个 dc 之和、t = 5000
    var a_s = 0
    var a_t = 0
    var a_buckets = 0
    var b0 = 0
    var b1 = 49
    while b0 <= 5000 {
        for 0 : logs.len() - 1 to k {
            var dc = logs[k]
            if dc >= b0 and dc <= b1 {
                a_s += dc
                a_t += ms[k]
            }
        }
        a_buckets += 1
        b0 += 50
        b1 += 50
    }
    if a_buckets != 101 { fail(1) }
    if a_t != n { fail(2) }
    // 20000 × 250 + 400 × (0+1+…+49) = 5000000 + 490000
    if a_s != 5490000 { fail(3) }

    // ---- 形状 B：单条件（同样构成「跳转目标 + 直落」的合并点）----
    //   b0 = 0/50/100/150/200/250 这 6 个桶全部命中 ⇒ 6 × 5000
    var b_hit = 0
    var c0 = 0
    while c0 <= 5000 {
        for 0 : logs.len() - 1 to k {
            var dc2 = logs[k]
            if dc2 >= c0 { b_hit += 1 }
        }
        c0 += 50
    }
    if b_hit != 6 * n { fail(4) }

    // ---- 形状 C：`or` 短路（truthy 路径同样会 push 后跳转）----
    var c_hit = 0
    var d0 = 0
    while d0 <= 5000 {
        for 0 : logs.len() - 1 to k {
            var dc3 = logs[k]
            if dc3 < d0 or dc3 >= d0 { c_hit += 1 }
        }
        d0 += 50
    }
    if c_hit != 101 * n { fail(5) }

    if bad > 0 {
        print("test_rsp_drift FAILED: " + bad + " 处")
        _exit(1)
    }
    print("test_rsp_drift ok")
}
