// 辅助模块：跨模块**默认参数**（被调函数 AST 在另一个模块里，
//   调用点只能从模块符号表读 param_count / param_default_texts 来补默认值）。

export func add10(int a, int b = 10): int {
    return a + b
}

export func scale(float a, float k = 2.0): float {
    return a * k
}

export func multi(int a, int b = 20, string c = "hi"): string {
    return $"a={a} b={b} c={c}"
}

export func no_default(int a, int b): int {
    return a + b
}

// ==================== 非字面量默认值（2026-10-17 修）====================
// 以前：跨模块调用点只认字面量文本 ⇒ `= INFO` / `= Flags.ALL` / `= 10+20` 一律变 null
//   （静默错值）。现在在**定义模块**做常量折叠，折成字面量文本再给调用点。
export var INFO = 20
export const LIMIT = 99

export enum Flags {
    ALL  = 0xFF
    NONE = 0
}

export func def_var(int level = INFO): int { return level }
export func def_const(int x = LIMIT): int { return x }
export func def_enum(int f = Flags.ALL): int { return f }
export func def_expr(int x = 10 + 20): int { return x }
export func def_float(float k = 1.5 * 2.0): float { return k }
export func def_str(string s = "a" + "b"): string { return s }

export func typed_default(bool flag = true): bool {
    return flag
}

// ★ struct 方法的默认参数（2026-10-02 补，符号表 v36）：
//   与模块级函数**同一件事**，但那边早有 `ModuleFuncSymbol.param_default_texts`，
//   而 `ModuleStructMethod` 一直没有 ⇒ 跨模块 `c.plus()` 补不出默认值，
//   VM 按未初始化槽位读形参 ⇒ **静默垃圾**（不报错，值随机）。
export struct Calc {
    int base = 0

    func plus(int v = 10): int {
        return base + v
    }

    func mul(int a, int b = 2, int c = 3): int {
        return a * b * c
    }

    func tag(string s = "hi", int n = 7): string {
        return $"s={s} n={n}"
    }

    // 方法默认值引用**本模块 const**（折叠路径与模块函数同一套）
    func plus_def(int v = LIMIT): int {
        return base + v
    }

    func no_default(int a, int b): int {
        return a * 10 + b
    }
}

// 工厂：让调用方能测"接收者静态类型来自**跨模块函数返回值**"这条路径
//   （与写 `new Calc(base = 1)` 是两条不同的类型推断来源，见
//    assert/test_use_struct_default_param.leno 的注释）
export func mkCalc(): Calc {
    return new Calc(base = 1)
}

// ★ 带**副作用**的工厂 + 调用计数：钉住"链式调用的接收者只求值一次"。
//   为什么单独要这个：codegen 在"实参不含隐式 self"的形态下要往 R[base+1] 补一个 self 副本，
//   若实现成"把接收者表达式再求值一遍"就会把 `m.mkCalcCounted()` 调两次（本用例会立刻红）。
//   正确实现是接收者求值后的一条寄存器 MOV ✓
int _mkCalls = 0

export func mkCalcCounted(): Calc {
    _mkCalls = _mkCalls + 1
    return new Calc(base = 1)
}

export func mkCalcCalls(): int {
    return _mkCalls
}
