// 辅助模块：跨模块**默认参数**（被调函数 AST 在另一个模块里，
//   调用点只能从模块符号表读 param_count / param_default_texts 来补默认值）。

export func add10(int a, int b = 10): int {
    return a + b
}

export func scale(float a, float k = 2.0): float {
    return a * k
}

export func multi(int a, int b = 20, string c = "hi"): string {
    return $"a={a} b={b} c={c}"
}

export func no_default(int a, int b): int {
    return a + b
}

export func typed_default(bool flag = true): bool {
    return flag
}

// ★ struct 方法的默认参数（2026-10-02 补，符号表 v36）：
//   与模块级函数**同一件事**，但那边早有 `ModuleFuncSymbol.param_default_texts`，
//   而 `ModuleStructMethod` 一直没有 ⇒ 跨模块 `c.plus()` 补不出默认值，
//   VM 按未初始化槽位读形参 ⇒ **静默垃圾**（不报错，值随机）。
export struct Calc {
    int base = 0

    func plus(int v = 10): int {
        return base + v
    }

    func mul(int a, int b = 2, int c = 3): int {
        return a * b * c
    }

    func tag(string s = "hi", int n = 7): string {
        return $"s={s} n={n}"
    }

    func no_default(int a, int b): int {
        return a * 10 + b
    }
}

// 工厂：让调用方能测"接收者静态类型来自**跨模块函数返回值**"这条路径
//   （与写 `new Calc(base = 1)` 是两条不同的类型推断来源，见
//    assert/test_use_struct_default_param.leno 的注释）
export func mkCalc(): Calc {
    return new Calc(base = 1)
}
