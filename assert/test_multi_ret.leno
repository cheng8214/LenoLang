// 多返回值测试

// 1. 基本多返回值
func get_user(): [int, string, float] {
    return 42, "Alice", 95.5
}

var[int, string, float](id, name, score) = get_user()
print(id)     // 42
print(name)   // Alice
print(score)  // 95.5

// 2. 两个值的多返回值
func get_pos(): [int, int] {
    return 100, 200
}

var[int, int](x, y) = get_pos()
print(x)  // 100
print(y)  // 200

// 3. int -> float 类型提升
func get_dims(): [int, int] {
    return 800, 600
}
var[float, float](w, h) = get_dims()
print(w)  // 800
print(h)  // 600

// 4. any 槽位接收
var[any, any, any](a, b, c) = get_user()
print(a)  // 42
print(b)  // Alice
print(c)  // 95.5

// 5. 部分接收
var[int, string](id2, name2) = get_user()
print(id2)    // 42
print(name2)  // Alice

// 6. 普通调用（只取第一个返回值）
var first = get_user()
print(first)  // 42

// 7. 表达式语句调用
get_user()

// 8. 带键名的多返回值类型
func parse_info(): {"code": int, "msg": string} {
    return 200, "OK"
}
var{"code": int, "msg": string}(code, msg) = parse_info()
print(code)  // 200
print(msg)   // OK

print("=== 多返回值测试通过 ===")
