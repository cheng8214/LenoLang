// 跨模块 var[] 自动推断测试
import destruct_auto_infer_mod

// 测试 1: 跨模块多返回值
var[](mx, my, mw, mh) = destruct_auto_infer_mod.getMetrics()
assert(mx == 100, "跨模块 var[]: mx 应为 100")
assert(my == 200, "跨模块 var[]: my 应为 200")
assert(mw == 50, "跨模块 var[]: mw 应为 50")
assert(mh == 75, "跨模块 var[]: mh 应为 75")
assert(type(mx) == "int", "跨模块 var[]: mx 类型应为 int")
assert(type(mw) == "int", "跨模块 var[]: mw 类型应为 int")

// 测试 2: 跨模块混合类型
var[](uid, uname, uactive) = destruct_auto_infer_mod.getUserInfo()
assert(uid == 1, "跨模块 var[] 混合: uid 应为 1")
assert(uname == "test", "跨模块 var[] 混合: uname 应为 test")
assert(uactive == true, "跨模块 var[] 混合: uactive 应为 true")
assert(type(uid) == "int", "跨模块 var[] 混合: uid 类型应为 int")
assert(type(uname) == "string", "跨模块 var[] 混合: uname 类型应为 string")
assert(type(uactive) == "bool", "跨模块 var[] 混合: uactive 类型应为 bool")

// 测试 3: 跨模块 float 多返回值
var[](fx, fy) = destruct_auto_infer_mod.getFloats()
assert(fx == 1.5, "跨模块 var[] float: fx 应为 1.5")
assert(fy == 2.5, "跨模块 var[] float: fy 应为 2.5")
assert(type(fx) == "float", "跨模块 var[] float: fx 类型应为 float")

// 测试 4: 旧语法跨模块仍然工作
var[int, int, int, int](ox, oy, ow, oh) = destruct_auto_infer_mod.getMetrics()
assert(ox == 100, "跨模块旧语法: ox 应为 100")
assert(oh == 75, "跨模块旧语法: oh 应为 75")

print("test_destruct_auto_infer_cross: 全部通过")
