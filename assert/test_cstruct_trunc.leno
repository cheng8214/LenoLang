// 回归（2026-11-22，压测发现）：cstruct 窄整数字段**越界写入统一按补码截断**
//
// 修前：每个分支直接 `(int8_t)val_as_num(value)` —— 那是 **double → 窄整数**的转换，
//   超出目标范围在 C 里是**未定义行为**。实测 x86/MSVC：
//     u8  ← 300          ⇒ 44            （截断）
//     i8  ← 200          ⇒ -56           （截断）
//     u16 ← 70000        ⇒ 4464          （截断）
//     i32 ← 3000000000   ⇒ **-2147483648**（饱和！与上面三个不一致 ✗）
//   ⇒ 同一个 cstruct 里两套越界行为、且都无任何诊断。
// 修后：统一 `(int64_t)` 中转再窄化 —— Leno 的 int 是 int48、必在 int64 内 ⇒ 中转无损，
//   窄化就是确定的补码截断（i32 也得 -1294967296，与 u8/u16 同口径 ✓）。
//
// ⚠ 编译期**字面量**范围检查还没做（本次只统一了运行期语义）：`t.a = 300` 仍能编译通过，
//   值是确定的截断结果。要做那条得在语义层拿到 cstruct 字段的窄 kind（codegen 的字段
//   指令路径对 cstruct 不生效），属独立一块，见 LenoDocsSrc/site/待办与路线图.html。
cstruct T {
    u8 a
    i8 b
    u16 c
    i32 d
    u32 e
}

main() {
    var t = T.malloc()
    t.a = 300
    t.b = 200
    t.c = 70000
    t.d = 3000000000
    t.e = 4294967296

    assert_eq(_int(t.a), 44, "u8 ← 300 ⇒ 44（截断）")
    assert_eq(_int(t.b), -56, "i8 ← 200 ⇒ -56（截断）")
    assert_eq(_int(t.c), 4464, "u16 ← 70000 ⇒ 4464（截断）")
    assert_eq(_int(t.d), -1294967296, "i32 ← 3000000000 ⇒ -1294967296（补码截断，**不是**饱和的 INT32_MIN）")
    assert_eq(_int(t.e), 0, "u32 ← 2^32 ⇒ 0（截断）")

    print("test_cstruct_trunc passed\n")
}
