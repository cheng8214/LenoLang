// test_diag_parse_hints.leno —— 解析期"指不出真因"的一批诊断（2026-11-07）
//
// 每个用例都是实测"报错完全看不出病因"或"零诊断"的场景：
//   ① `main(int x)` 带参数 ⇒ 此前报「期望表达式」+「期望 ')'」两条，看不出 main 不能有参数
//   ② `main() -> int`（Rust 风格）⇒ 此前落到表达式解析，级联一串
//   ③ `func f() -> int` ⇒ 此前连刷 5 条级联（期望 '{' / 期望表达式 / 字典解构…）
//   ④ `case` 落在 switch 外 ⇒ 此前只报「期望表达式」
//   ⑤ `default` 落在 switch 外 ⇒ 同上
//   ⑥ 跨语言关键字 class / interface / fn / pub / match ⇒ 此前落到表达式解析
//   ⑦ `nil` / `raise` ⇒ 此前只报「未定义的变量」，看不出该写 null / throw
//   ⑧ `x := 1`（Go 风格）⇒ 此前报「期望表达式」，列号指向 '='
//   ⑨ `# 注释`（Python 风格）⇒ 此前只提"颜色字面量"，不提注释写法
//   ⑩ 区间 case 部分重叠 ⇒ 此前零诊断（后一个分支部分不可达）
//
// 另含三条防误报：`main(1)` 作为普通调用仍按"参数过多"报；互不重叠的区间不得报；
// 单行 `//` 注释照常工作。

import "helpers/compiler.leno" as ce
import dirs
import files

main() {
    var work = dirs.join(_tmpdir(), "leno_diag_parse_hints")
    dirs.delete(work)
    dirs.mkdir_p(work)

    // ---- ① main 带参数：语义层点名（解析层不再放弃）----
    var mainParams = dirs.join(work, "main_params.leno")
    files.write(mainParams, @"main(int x) {
    print(""x\n"")
}
")
    ce.expect_error(mainParams, "main 带参数 => 明确指出不能有参数",
        "入口函数 main 不能有参数", 1)

    // ---- ② main() -> int：定向报错并继续解析（不再级联）----
    var mainArrow = dirs.join(work, "main_arrow.leno")
    files.write(mainArrow, @"main() -> int {
    return 0
}
")
    ce.expect_error(mainArrow, "main() -> int => 指向 ':' 写法",
        "返回类型写在 ':' 后面", 1)

    // ---- ③ 普通函数 -> 返回类型：一条定向错误，不再刷 5 条级联 ----
    var funcArrow = dirs.join(work, "func_arrow.leno")
    files.write(funcArrow, @"func f() -> int { return 1 }
main() { print(_str(f())) }
")
    var outArrow = ce.expect_error(funcArrow, "func f() -> int => 定向报错",
        "返回类型写在 ':' 后面", 1)
    ce.expect_no_warning(outArrow, "-> 用例", "字典解构期望键名")

    // ---- ④ case 落在 switch 外：定向报错并整块跳过 ----
    var caseOutside = dirs.join(work, "case_outside.leno")
    files.write(caseOutside, @"main() {
    case 1 { print(""x"") }
}
")
    ce.expect_error(caseOutside, "case 在 switch 外 => 定向报错",
        "`case` 只能写在 switch 语句内部", 2)

    // ---- ⑤ default 落在 switch 外 ----
    var defaultOutside = dirs.join(work, "default_outside.leno")
    files.write(defaultOutside, @"main() {
    default { print(""x"") }
}
")
    ce.expect_error(defaultOutside, "default 在 switch 外 => 定向报错",
        "`default` 只能写在 switch 语句内部", 2)

    // ---- ⑥ 跨语言关键字：一句点名 + 直接给 Leno 写法 ----
    var classFile = dirs.join(work, "kw_class.leno")
    files.write(classFile, @"class P { }
main() { }
")
    ce.expect_error(classFile, "class 关键字 => 指向 struct",
        "没有 `class`", 1)

    var interfaceFile = dirs.join(work, "kw_interface.leno")
    files.write(interfaceFile, @"interface F { }
main() { }
")
    ce.expect_error(interfaceFile, "interface 关键字 => 指向 face",
        "没有 `interface`", 1)

    var fnFile = dirs.join(work, "kw_fn.leno")
    files.write(fnFile, @"fn f(): int { return 1 }
main() { }
")
    ce.expect_error(fnFile, "fn 关键字 => 指向 func", "没有 `fn`", 1)

    var pubFile = dirs.join(work, "kw_pub.leno")
    files.write(pubFile, @"pub func f(): int { return 1 }
main() { }
")
    ce.expect_error(pubFile, "pub 关键字 => 指向 export / pri", "没有 `pub`", 1)

    var matchFile = dirs.join(work, "kw_match.leno")
    files.write(matchFile, @"main() {
    var x = 1
    match x { }
}
")
    ce.expect_error(matchFile, "match 关键字 => 指向 switch", "没有 `match`", 3)

    // ---- ⑦ nil / raise：未定义变量旁边给正确写法 ----
    var nilFile = dirs.join(work, "expr_nil.leno")
    files.write(nilFile, @"main() {
    var a = nil
    print(_str(a))
}
")
    ce.expect_error(nilFile, "nil => 提示改 null",
        "空值字面量是 **`null`**", 2)

    var raiseFile = dirs.join(work, "stmt_raise.leno")
    files.write(raiseFile, @"main() {
    raise ""boom""
}
")
    ce.expect_error(raiseFile, "raise => 提示改 throw",
        "抛异常用 **`throw 表达式`**", 2)

    // ---- ⑧ :=（Go 风格）----
    var walrusFile = dirs.join(work, "stmt_walrus.leno")
    files.write(walrusFile, @"main() {
    x := 1
    print(_str(x))
}
")
    ce.expect_error(walrusFile, "x := 1 => 定向报错",
        "没有 `:=`", 2)

    // ---- ⑨ # 注释（Python 风格）----
    var hashFile = dirs.join(work, "comment_hash.leno")
    files.write(hashFile, @"# 注释
main() { print(""x"") }
")
    ce.expect_error(hashFile, "# 注释 => 提示用 //",
        "注释写 `//`", 1)

    // ---- ⑩ 区间 case 部分重叠：警告（后一个分支部分不可达）----
    var overlapFile = dirs.join(work, "range_overlap.leno")
    files.write(overlapFile, @"main() {
    var x = 5
    switch x {
        case 1:4 { print(""a"") }
        case 3:6 { print(""b"") }
        default { print(""c"") }
    }
}
")
    ce.expect_warning(overlapFile, "区间 1:4 与 3:6 重叠 => 警告",
        "与第 4 行的区间重叠", 5)

    // ---- ⑩b 防误报：互不重叠的区间不得报 ----
    var noOverlap = dirs.join(work, "range_no_overlap.leno")
    files.write(noOverlap, @"main() {
    var x = 6
    switch x {
        case 1:3 { print(""a"") }
        case 5:7 { print(""b"") }
        default { print(""c"") }
    }
}
")
    var outNoOverlap = ce.expect_ok(noOverlap, "互不重叠的区间（防误报）", "b")
    ce.expect_no_warning(outNoOverlap, "互不重叠的区间", "区间重叠")

    // ---- ⑪ 防误报：`main(1)` 作为普通调用 ⇒ 仍报参数数量，不误判成入口定义 ----
    var mainCall = dirs.join(work, "main_call.leno")
    files.write(mainCall, @"func g(): int {
    main(1)
    return 0
}
main() { print(_str(g())) }
")
    ce.expect_error(mainCall, "main(1) 普通调用 => 参数过多",
        "main 参数数量过多", 2)

    // ---- ⑫ if / while / for / switch 漏写条件或表达式：一条定向错误，不再级联 ----
    var ifNoCond = dirs.join(work, "if_no_cond.leno")
    files.write(ifNoCond, @"main() {
    if { print(""x"") }
}
")
    var outIf = ce.expect_error(ifNoCond, "if 漏写条件 => 定向报错",
        "if 后面必须跟条件表达式", 2)
    ce.expect_no_warning(outIf, "if 漏写条件", "期望 ':'")

    var whileNoCond = dirs.join(work, "while_no_cond.leno")
    files.write(whileNoCond, @"main() {
    while { print(""x"") }
}
")
    var outWhile = ce.expect_error(whileNoCond, "while 漏写条件 => 定向报错",
        "while 后面必须跟条件表达式", 2)
    ce.expect_no_warning(outWhile, "while 漏写条件", "期望 ':'")

    var forNoRange = dirs.join(work, "for_no_range.leno")
    files.write(forNoRange, @"main() {
    for { print(""x"") }
}
")
    ce.expect_error(forNoRange, "for 漏写范围 => 定向报错",
        "for 后面必须跟范围或容器表达式", 2)

    var switchNoExpr = dirs.join(work, "switch_no_expr.leno")
    files.write(switchNoExpr, @"main() {
    switch { case 1 { } }
}
")
    var outSwitch = ce.expect_error(switchNoExpr, "switch 漏写表达式 => 定向报错",
        "switch 后面必须跟要匹配的表达式", 2)
    ce.expect_no_warning(outSwitch, "switch 漏写表达式", "字典键必须是字符串")

    // ---- ⑬ 类型别名循环引用：此前 `alias A = Array[A]` 一旦被使用就**栈溢出核心转储** ----
    var aliasSelf = dirs.join(work, "alias_self_cycle.leno")
    files.write(aliasSelf, @"alias A = Array[A]
main() {
    A a = []
    print(_str(a.len()))
}
")
    ce.expect_error(aliasSelf, "别名直接自引用 => 报循环引用（不再崩溃）",
        "存在循环引用", 3)

    var aliasIndirect = dirs.join(work, "alias_indirect_cycle.leno")
    files.write(aliasIndirect, @"alias A = B
alias B = A
main() {
    A a = null
    print(_str(a))
}
")
    ce.expect_error(aliasIndirect, "别名间接循环 => 报循环引用",
        "存在循环引用", 4)

    // ⑬b 防误报：正常的多级别名链必须照常工作
    var aliasChain = dirs.join(work, "alias_chain.leno")
    files.write(aliasChain, @"alias B = int
alias A = B
main() {
    A x = 7
    print(_str(x))
}
")
    ce.expect_ok(aliasChain, "多级别名链（防误报）", "7")

    // ---- ⑭ export 写在函数体内：此前**静默生效**（用户以为导出了）----
    var exportInFunc = dirs.join(work, "export_in_func.leno")
    files.write(exportInFunc, @"main() {
    export var x = 1
    print(_str(x))
}
")
    ce.expect_error(exportInFunc, "函数体内写 export => 报只能写在模块顶层",
        "export 只能写在模块顶层", 2)

    // ---- ⑮ 数字末尾的小数点（`1.`）：此前解析成"在 int 上调方法"，报一堆误导错误 ----
    var trailingDot = dirs.join(work, "trailing_dot.leno")
    files.write(trailingDot, @"main() {
    var x = 1.
    print(_str(x))
}
")
    var outDot = ce.expect_error(trailingDot, "数字末尾小数点 => 定向报错",
        "小数点后面必须跟数字", 2)
    ce.expect_no_warning(outDot, "数字末尾小数点", "没有方法 'print'")

    // ---- ⑯ 字面量除零：运行期必报，编译期先提醒（变量/表达式不猜）----
    // 放在**不会执行的分支**里：只验编译期警告，不触发真的除零（否则子进程 exit≠0）
    var divZero = dirs.join(work, "div_zero.leno")
    files.write(divZero, @"func f(int z): int {
    if z == 0 { return 1 / 0 }
    return z
}
main() { print(_str(f(2))) }
")
    ce.expect_warning(divZero, "1 / 0 => 字面量除零警告", "字面量 0", 2)

    var modZero = dirs.join(work, "mod_zero.leno")
    files.write(modZero, @"func f(int z): int {
    if z == 0 { return 7 % 0 }
    return z
}
main() { print(_str(f(2))) }
")
    ce.expect_warning(modZero, "7 % 0 => 字面量除零警告", "字面量 0", 2)

    // ⑯b 防误报：非零除数 / 变量除数都不得报
    var divOk = dirs.join(work, "div_ok.leno")
    files.write(divOk, @"main() {
    var z = 2
    var a = 10 / z
    var b = 10 / 2
    print(_str(a + b))
}
")
    var outDivOk = ce.expect_ok(divOk, "非零/变量除数（防误报）", "10")
    ce.expect_no_warning(outDivOk, "非零/变量除数", "字面量 0")

    // ---- ⑰ 缺值类：每处只报一条定向错误（不再级联 2~4 条）----
    var dictNoValue = dirs.join(work, "dict_no_value.leno")
    files.write(dictNoValue, @"main() {
    var d = {""a"": }
    print(_str(d))
}
")
    var outDictVal = ce.expect_error(dictNoValue, "字典缺值 => 一条定向错误",
        "字典的值不能为空", 2)
    ce.expect_no_warning(outDictVal, "字典缺值", "期望 ',' 或 '}'")

    var dictNoColon = dirs.join(work, "dict_no_colon.leno")
    files.write(dictNoColon, @"main() {
    var d = {""a"" 1}
    print(_str(d))
}
")
    var outDictColon = ce.expect_error(dictNoColon, "字典缺冒号 => 一条定向错误",
        "字典键后面必须跟 ':'", 2)
    ce.expect_no_warning(outDictColon, "字典缺冒号", "声明语句后期望换行")

    var callEmpty = dirs.join(work, "call_empty.leno")
    files.write(callEmpty, @"func f(int a, int b): int { return a + b }
main() { print(_str(f(, 2))) }
")
    var outCallEmpty = ce.expect_error(callEmpty, "空实参 => 一条定向错误",
        "实参不能为空", 2)
    ce.expect_no_warning(outCallEmpty, "空实参", "期望 ')'")

    var arrayEmpty = dirs.join(work, "array_empty.leno")
    files.write(arrayEmpty, @"main() {
    var a = [1,,2]
    print(_str(a))
}
")
    var outArrayEmpty = ce.expect_error(arrayEmpty, "空数组元素 => 一条定向错误",
        "数组元素不能为空", 2)
    ce.expect_no_warning(outArrayEmpty, "空数组元素", "期望 ',' 或 ']'")

    var newNoValue = dirs.join(work, "new_no_value.leno")
    files.write(newNoValue, @"struct P { int x = 1 }
main() {
    var p = new P(x = , y = 2)
    print(_str(p.x))
}
")
    var outNewVal = ce.expect_error(newNoValue, "构造缺字段值 => 一条定向错误",
        "字段 'x' 的初始值不能为空", 3)
    ce.expect_no_warning(outNewVal, "构造缺字段值", "期望 ')'")

    var defaultNoValue = dirs.join(work, "default_no_value.leno")
    files.write(defaultNoValue, @"func f(int a = ): int { return a }
main() { print(_str(f())) }
")
    var outDefVal = ce.expect_error(defaultNoValue, "参数默认值缺失 => 一条定向错误",
        "参数 'a' 的默认值不能为空", 1)
    ce.expect_no_warning(outDefVal, "参数默认值缺失", "期望 ')'")

    // ⑰b 防误报：尾随逗号照旧合法
    var trailingComma = dirs.join(work, "trailing_comma_ok.leno")
    files.write(trailingComma, @"func f(int a, int b): int { return a + b }
main() {
    var d = {""a"": 1, }
    var a = [1, 2, ]
    print(_str(d[""a""]) + _str(a.len()) + _str(f(1, 2, )))
}
")
    ce.expect_ok(trailingComma, "尾随逗号（防误报）", "123")

    print("test_diag_parse_hints passed")
}
