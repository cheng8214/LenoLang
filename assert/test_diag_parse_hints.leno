// test_diag_parse_hints.leno —— 解析期"指不出真因"的一批诊断（2026-11-07）
//
// 每个用例都是实测"报错完全看不出病因"或"零诊断"的场景：
//   ① `main(int x)` 带参数 ⇒ 此前报「期望表达式」+「期望 ')'」两条，看不出 main 不能有参数
//   ② `main() -> int`（Rust 风格）⇒ 此前落到表达式解析，级联一串
//   ③ `func f() -> int` ⇒ 此前连刷 5 条级联（期望 '{' / 期望表达式 / 字典解构…）
//   ④ `case` 落在 switch 外 ⇒ 此前只报「期望表达式」
//   ⑤ `default` 落在 switch 外 ⇒ 同上
//   ⑥ 跨语言关键字 class / interface / fn / pub / match ⇒ 此前落到表达式解析
//   ⑦ `nil` / `raise` ⇒ 此前只报「未定义的变量」，看不出该写 null / throw
//   ⑧ `x := 1`（Go 风格）⇒ 此前报「期望表达式」，列号指向 '='
//   ⑨ `# 注释`（Python 风格）⇒ 此前只提"颜色字面量"，不提注释写法
//   ⑩ 区间 case 部分重叠 ⇒ 此前零诊断（后一个分支部分不可达）
//
// 另含三条防误报：`main(1)` 作为普通调用仍按"参数过多"报；互不重叠的区间不得报；
// 单行 `//` 注释照常工作。

import "helpers/compiler.leno" as ce
import dirs
import files

main() {
    var work = dirs.join(_tmpdir(), "leno_diag_parse_hints")
    dirs.delete(work)
    dirs.mkdir_p(work)

    // ---- ① main 带参数：语义层点名（解析层不再放弃）----
    var mainParams = dirs.join(work, "main_params.leno")
    files.write(mainParams, @"main(int x) {
    print(""x\n"")
}
")
    ce.expect_error(mainParams, "main 带参数 => 明确指出不能有参数",
        "入口函数 main 不能有参数", 1)

    // ---- ② main() -> int：定向报错并继续解析（不再级联）----
    var mainArrow = dirs.join(work, "main_arrow.leno")
    files.write(mainArrow, @"main() -> int {
    return 0
}
")
    ce.expect_error(mainArrow, "main() -> int => 指向 ':' 写法",
        "返回类型写在 ':' 后面", 1)

    // ---- ③ 普通函数 -> 返回类型：一条定向错误，不再刷 5 条级联 ----
    var funcArrow = dirs.join(work, "func_arrow.leno")
    files.write(funcArrow, @"func f() -> int { return 1 }
main() { print(_str(f())) }
")
    var outArrow = ce.expect_error(funcArrow, "func f() -> int => 定向报错",
        "返回类型写在 ':' 后面", 1)
    ce.expect_no_warning(outArrow, "-> 用例", "字典解构期望键名")

    // ---- ④ case 落在 switch 外：定向报错并整块跳过 ----
    var caseOutside = dirs.join(work, "case_outside.leno")
    files.write(caseOutside, @"main() {
    case 1 { print(""x"") }
}
")
    ce.expect_error(caseOutside, "case 在 switch 外 => 定向报错",
        "`case` 只能写在 switch 语句内部", 2)

    // ---- ⑤ default 落在 switch 外 ----
    var defaultOutside = dirs.join(work, "default_outside.leno")
    files.write(defaultOutside, @"main() {
    default { print(""x"") }
}
")
    ce.expect_error(defaultOutside, "default 在 switch 外 => 定向报错",
        "`default` 只能写在 switch 语句内部", 2)

    // ---- ⑥ 跨语言关键字：一句点名 + 直接给 Leno 写法 ----
    var classFile = dirs.join(work, "kw_class.leno")
    files.write(classFile, @"class P { }
main() { }
")
    ce.expect_error(classFile, "class 关键字 => 指向 struct",
        "没有 `class`", 1)

    var interfaceFile = dirs.join(work, "kw_interface.leno")
    files.write(interfaceFile, @"interface F { }
main() { }
")
    ce.expect_error(interfaceFile, "interface 关键字 => 指向 face",
        "没有 `interface`", 1)

    var fnFile = dirs.join(work, "kw_fn.leno")
    files.write(fnFile, @"fn f(): int { return 1 }
main() { }
")
    ce.expect_error(fnFile, "fn 关键字 => 指向 func", "没有 `fn`", 1)

    var pubFile = dirs.join(work, "kw_pub.leno")
    files.write(pubFile, @"pub func f(): int { return 1 }
main() { }
")
    ce.expect_error(pubFile, "pub 关键字 => 指向 export / pri", "没有 `pub`", 1)

    var matchFile = dirs.join(work, "kw_match.leno")
    files.write(matchFile, @"main() {
    var x = 1
    match x { }
}
")
    ce.expect_error(matchFile, "match 关键字 => 指向 switch", "没有 `match`", 3)

    // ---- ⑦ nil / raise：未定义变量旁边给正确写法 ----
    var nilFile = dirs.join(work, "expr_nil.leno")
    files.write(nilFile, @"main() {
    var a = nil
    print(_str(a))
}
")
    ce.expect_error(nilFile, "nil => 提示改 null",
        "空值字面量是 **`null`**", 2)

    var raiseFile = dirs.join(work, "stmt_raise.leno")
    files.write(raiseFile, @"main() {
    raise ""boom""
}
")
    ce.expect_error(raiseFile, "raise => 提示改 throw",
        "抛异常用 **`throw 表达式`**", 2)

    // ---- ⑧ :=（Go 风格）----
    var walrusFile = dirs.join(work, "stmt_walrus.leno")
    files.write(walrusFile, @"main() {
    x := 1
    print(_str(x))
}
")
    ce.expect_error(walrusFile, "x := 1 => 定向报错",
        "没有 `:=`", 2)

    // ---- ⑨ # 注释（Python 风格）----
    var hashFile = dirs.join(work, "comment_hash.leno")
    files.write(hashFile, @"# 注释
main() { print(""x"") }
")
    ce.expect_error(hashFile, "# 注释 => 提示用 //",
        "注释写 `//`", 1)

    // ---- ⑩ 区间 case 部分重叠：警告（后一个分支部分不可达）----
    var overlapFile = dirs.join(work, "range_overlap.leno")
    files.write(overlapFile, @"main() {
    var x = 5
    switch x {
        case 1:4 { print(""a"") }
        case 3:6 { print(""b"") }
        default { print(""c"") }
    }
}
")
    ce.expect_warning(overlapFile, "区间 1:4 与 3:6 重叠 => 警告",
        "与第 4 行的区间重叠", 5)

    // ---- ⑩b 防误报：互不重叠的区间不得报 ----
    var noOverlap = dirs.join(work, "range_no_overlap.leno")
    files.write(noOverlap, @"main() {
    var x = 6
    switch x {
        case 1:3 { print(""a"") }
        case 5:7 { print(""b"") }
        default { print(""c"") }
    }
}
")
    var outNoOverlap = ce.expect_ok(noOverlap, "互不重叠的区间（防误报）", "b")
    ce.expect_no_warning(outNoOverlap, "互不重叠的区间", "区间重叠")

    // ---- ⑪ 防误报：`main(1)` 作为普通调用 ⇒ 仍报参数数量，不误判成入口定义 ----
    var mainCall = dirs.join(work, "main_call.leno")
    files.write(mainCall, @"func g(): int {
    main(1)
    return 0
}
main() { print(_str(g())) }
")
    ce.expect_error(mainCall, "main(1) 普通调用 => 参数过多",
        "main 参数数量过多", 2)

    // ---- ⑫ if / while / for / switch 漏写条件或表达式：一条定向错误，不再级联 ----
    var ifNoCond = dirs.join(work, "if_no_cond.leno")
    files.write(ifNoCond, @"main() {
    if { print(""x"") }
}
")
    var outIf = ce.expect_error(ifNoCond, "if 漏写条件 => 定向报错",
        "if 后面必须跟条件表达式", 2)
    ce.expect_no_warning(outIf, "if 漏写条件", "期望 ':'")

    var whileNoCond = dirs.join(work, "while_no_cond.leno")
    files.write(whileNoCond, @"main() {
    while { print(""x"") }
}
")
    var outWhile = ce.expect_error(whileNoCond, "while 漏写条件 => 定向报错",
        "while 后面必须跟条件表达式", 2)
    ce.expect_no_warning(outWhile, "while 漏写条件", "期望 ':'")

    var forNoRange = dirs.join(work, "for_no_range.leno")
    files.write(forNoRange, @"main() {
    for { print(""x"") }
}
")
    ce.expect_error(forNoRange, "for 漏写范围 => 定向报错",
        "for 后面必须跟范围或容器表达式", 2)

    var switchNoExpr = dirs.join(work, "switch_no_expr.leno")
    files.write(switchNoExpr, @"main() {
    switch { case 1 { } }
}
")
    var outSwitch = ce.expect_error(switchNoExpr, "switch 漏写表达式 => 定向报错",
        "switch 后面必须跟要匹配的表达式", 2)
    ce.expect_no_warning(outSwitch, "switch 漏写表达式", "字典键必须是字符串")

    // ---- ⑬ 类型别名循环引用：此前 `alias A = Array[A]` 一旦被使用就**栈溢出核心转储** ----
    var aliasSelf = dirs.join(work, "alias_self_cycle.leno")
    files.write(aliasSelf, @"alias A = Array[A]
main() {
    A a = []
    print(_str(a.len()))
}
")
    ce.expect_error(aliasSelf, "别名直接自引用 => 报循环引用（不再崩溃）",
        "存在循环引用", 3)

    var aliasIndirect = dirs.join(work, "alias_indirect_cycle.leno")
    files.write(aliasIndirect, @"alias A = B
alias B = A
main() {
    A a = null
    print(_str(a))
}
")
    ce.expect_error(aliasIndirect, "别名间接循环 => 报循环引用",
        "存在循环引用", 4)

    // ⑬b 防误报：正常的多级别名链必须照常工作
    var aliasChain = dirs.join(work, "alias_chain.leno")
    files.write(aliasChain, @"alias B = int
alias A = B
main() {
    A x = 7
    print(_str(x))
}
")
    ce.expect_ok(aliasChain, "多级别名链（防误报）", "7")

    // ---- ⑭ export 写在函数体内：此前**静默生效**（用户以为导出了）----
    var exportInFunc = dirs.join(work, "export_in_func.leno")
    files.write(exportInFunc, @"main() {
    export var x = 1
    print(_str(x))
}
")
    ce.expect_error(exportInFunc, "函数体内写 export => 报只能写在模块顶层",
        "export 只能写在模块顶层", 2)

    // ---- ⑮ 数字末尾的小数点（`1.`）：此前解析成"在 int 上调方法"，报一堆误导错误 ----
    var trailingDot = dirs.join(work, "trailing_dot.leno")
    files.write(trailingDot, @"main() {
    var x = 1.
    print(_str(x))
}
")
    var outDot = ce.expect_error(trailingDot, "数字末尾小数点 => 定向报错",
        "小数点后面必须跟数字", 2)
    ce.expect_no_warning(outDot, "数字末尾小数点", "没有方法 'print'")

    // ---- ⑯ 字面量除零：运行期必报，编译期先提醒（变量/表达式不猜）----
    // 放在**不会执行的分支**里：只验编译期警告，不触发真的除零（否则子进程 exit≠0）
    var divZero = dirs.join(work, "div_zero.leno")
    files.write(divZero, @"func f(int z): int {
    if z == 0 { return 1 / 0 }
    return z
}
main() { print(_str(f(2))) }
")
    ce.expect_warning(divZero, "1 / 0 => 字面量除零警告", "字面量 0", 2)

    var modZero = dirs.join(work, "mod_zero.leno")
    files.write(modZero, @"func f(int z): int {
    if z == 0 { return 7 % 0 }
    return z
}
main() { print(_str(f(2))) }
")
    ce.expect_warning(modZero, "7 % 0 => 字面量除零警告", "字面量 0", 2)

    // ⑯b 防误报：非零除数 / 变量除数都不得报
    var divOk = dirs.join(work, "div_ok.leno")
    files.write(divOk, @"main() {
    var z = 2
    var a = 10 / z
    var b = 10 / 2
    print(_str(a + b))
}
")
    var outDivOk = ce.expect_ok(divOk, "非零/变量除数（防误报）", "10")
    ce.expect_no_warning(outDivOk, "非零/变量除数", "字面量 0")

    // ---- ⑰ 缺值类：每处只报一条定向错误（不再级联 2~4 条）----
    var dictNoValue = dirs.join(work, "dict_no_value.leno")
    files.write(dictNoValue, @"main() {
    var d = {""a"": }
    print(_str(d))
}
")
    var outDictVal = ce.expect_error(dictNoValue, "字典缺值 => 一条定向错误",
        "字典的值不能为空", 2)
    ce.expect_no_warning(outDictVal, "字典缺值", "期望 ',' 或 '}'")

    var dictNoColon = dirs.join(work, "dict_no_colon.leno")
    files.write(dictNoColon, @"main() {
    var d = {""a"" 1}
    print(_str(d))
}
")
    var outDictColon = ce.expect_error(dictNoColon, "字典缺冒号 => 一条定向错误",
        "字典键后面必须跟 ':'", 2)
    ce.expect_no_warning(outDictColon, "字典缺冒号", "声明语句后期望换行")

    var callEmpty = dirs.join(work, "call_empty.leno")
    files.write(callEmpty, @"func f(int a, int b): int { return a + b }
main() { print(_str(f(, 2))) }
")
    var outCallEmpty = ce.expect_error(callEmpty, "空实参 => 一条定向错误",
        "实参不能为空", 2)
    ce.expect_no_warning(outCallEmpty, "空实参", "期望 ')'")

    var arrayEmpty = dirs.join(work, "array_empty.leno")
    files.write(arrayEmpty, @"main() {
    var a = [1,,2]
    print(_str(a))
}
")
    var outArrayEmpty = ce.expect_error(arrayEmpty, "空数组元素 => 一条定向错误",
        "数组元素不能为空", 2)
    ce.expect_no_warning(outArrayEmpty, "空数组元素", "期望 ',' 或 ']'")

    var newNoValue = dirs.join(work, "new_no_value.leno")
    files.write(newNoValue, @"struct P { int x = 1 }
main() {
    var p = new P(x = , y = 2)
    print(_str(p.x))
}
")
    var outNewVal = ce.expect_error(newNoValue, "构造缺字段值 => 一条定向错误",
        "字段 'x' 的初始值不能为空", 3)
    ce.expect_no_warning(outNewVal, "构造缺字段值", "期望 ')'")

    var defaultNoValue = dirs.join(work, "default_no_value.leno")
    files.write(defaultNoValue, @"func f(int a = ): int { return a }
main() { print(_str(f())) }
")
    var outDefVal = ce.expect_error(defaultNoValue, "参数默认值缺失 => 一条定向错误",
        "参数 'a' 的默认值不能为空", 1)
    ce.expect_no_warning(outDefVal, "参数默认值缺失", "期望 ')'")

    // ⑰b 防误报：尾随逗号照旧合法
    var trailingComma = dirs.join(work, "trailing_comma_ok.leno")
    files.write(trailingComma, @"func f(int a, int b): int { return a + b }
main() {
    var d = {""a"": 1, }
    var a = [1, 2, ]
    print(_str(d[""a""]) + _str(a.len()) + _str(f(1, 2, )))
}
")
    ce.expect_ok(trailingComma, "尾随逗号（防误报）", "123")

    // ---- ⑱ 负数移位：运行期必报，编译期先提醒（变量移位量不猜）----
    var negShift = dirs.join(work, "neg_shift.leno")
    files.write(negShift, @"func f(int z): int {
    if z == 0 { return 1 << -1 }
    return z
}
main() { print(_str(f(2))) }
")
    ce.expect_warning(negShift, "1 << -1 => 负数移位警告", "移位量是负数", 2)

    var shiftOk = dirs.join(work, "shift_ok.leno")
    files.write(shiftOk, @"main() {
    var k = 2
    print(_str(1 << k))
}
")
    var outShiftOk = ce.expect_ok(shiftOk, "变量移位量（防误报）", "4")
    ce.expect_no_warning(outShiftOk, "变量移位量", "移位量是负数")

    // ---- ⑲ 注解多参数：指向"要写成字符串数组"（旧文案只有「期望 ')'」）----
    var annoMulti = dirs.join(work, "anno_multi.leno")
    files.write(annoMulti, @"@optkeys(""a"", ""b"")
struct P {
    int a = 1
}
main() { print(_str(new P().a)) }
")
    ce.expect_error(annoMulti, "注解多参数 => 指向数组写法",
        "注解只接受**一个**参数", 1)

    // ⑲b 正确写法（字符串数组）照常可用
    var annoOk = dirs.join(work, "anno_ok.leno")
    files.write(annoOk, @"@optkeys([""a""])
struct P {
    int a = 1
}
main() { print(_str(new P(a = 2).a)) }
")
    ce.expect_ok(annoOk, "注解字符串数组（防误报）", "2")

    // ---- ⑳ face 方法参数类型必须与 impl 一致（此前只比个数，类型不符静默通过）----
    var faceParam = dirs.join(work, "face_param_mismatch.leno")
    files.write(faceParam, @"face F { func m(int x): int }
struct S impl F {
    func m(string x): int { return 1 }
}
main() { }
")
    ce.expect_error(faceParam, "face 参数类型不匹配 => 编译期报错",
        "第 1 个参数类型与 face 'F' 不匹配", 2)

    // ⑳b 防误报：参数类型一致的 impl 照常可用
    var faceParamOk = dirs.join(work, "face_param_ok.leno")
    files.write(faceParamOk, @"face F { func m(int x): int }
struct S impl F {
    func m(int x): int { return x + 1 }
}
main() {
    F f = new S()
    print(_str(f.m(5)))
}
")
    ce.expect_ok(faceParamOk, "face 参数类型一致（防误报）", "6")

    // ---- ㉑ 泛型约束必须在**调用点**校验：int/string 不实现 face 时此前静默通过 ----
    var constraintBad = dirs.join(work, "constraint_bad.leno")
    files.write(constraintBad, @"face Comparable { func cmp(): int }
struct N impl Comparable { func cmp(): int { return 1 } }
func useIt[T: Comparable](T x): int { return x.cmp() }
main() {
    print(_str(useIt(42)))
}
")
    ce.expect_error(constraintBad, "约束 T: Face 传 int => 编译期报错",
        "类型 'int' 不满足约束 'Comparable'", 5)

    // ㉑b 防误报：显式 impl 了 face 的 struct 照常可用
    var constraintOk = dirs.join(work, "constraint_ok.leno")
    files.write(constraintOk, @"face Comparable { func cmp(): int }
struct N impl Comparable { func cmp(): int { return 1 } }
func useIt[T: Comparable](T x): int { return x.cmp() }
main() {
    print(_str(useIt(new N())))
}
")
    ce.expect_ok(constraintOk, "约束 T: Face 合规（防误报）", "1")

    // ---- ㉒ impl 的 face 方法不能声明为 pri（此前通过 face 调用照样能进）----
    var priFaceMethod = dirs.join(work, "pri_face_method.leno")
    files.write(priFaceMethod, @"face F { func m(): int }
struct S impl F {
    pri func m(): int { return 1 }
}
main() { }
")
    ce.expect_error(priFaceMethod, "impl 的 face 方法标 pri => 报错",
        "不能声明为 pri", 2)

    // ---- ㉓ 泛型类型参数写错：一条定向错误（不再刷「期望变量名」等级联）----
    var arrArity = dirs.join(work, "array_arity.leno")
    files.write(arrArity, @"main() {
    Array[int, int] a = [1]
    print(_str(a.len()))
}
")
    var outArrArity = ce.expect_error(arrArity, "Array 多写类型参数 => 一条错误",
        "期望 ']' 结束 Array 类型", 2)
    ce.expect_no_warning(outArrArity, "Array 多写类型参数", "期望变量名")

    var dictArity = dirs.join(work, "dict_arity.leno")
    files.write(dictArity, @"main() {
    Dict[string] d = {""a"": 1}
    print(_str(d.len()))
}
")
    var outDictArity = ce.expect_error(dictArity, "Dict 少写类型参数 => 一条错误",
        "Dict 类型需要两个参数", 2)
    ce.expect_no_warning(outDictArity, "Dict 少写类型参数", "期望变量名")

    var arrEmpty = dirs.join(work, "array_empty_arg.leno")
    files.write(arrEmpty, @"main() {
    Array[] a = []
    print(_str(a.len()))
}
")
    var outArrEmpty = ce.expect_error(arrEmpty, "Array 空类型参数 => 一条错误",
        "Array 元素类型解析失败", 2)
    ce.expect_no_warning(outArrEmpty, "Array 空类型参数", "期望变量名")

    var ptrArity = dirs.join(work, "ptr_arity.leno")
    files.write(ptrArity, @"main() {
    Ptr[int, int] p = null
    print(""x"")
}
")
    var outPtrArity = ce.expect_error(ptrArity, "Ptr 多写类型参数 => 一条错误",
        "期望 ']' 结束 Ptr 类型", 2)
    ce.expect_no_warning(outPtrArity, "Ptr 多写类型参数", "期望变量名")

    // ---- ㉔ 泛型 struct 实例化的约束校验（此前 `new B[int]` 零诊断）----
    var structConstraint = dirs.join(work, "struct_constraint_bad.leno")
    files.write(structConstraint, @"face C { func m(): int }
struct B[T: C] { T v }
main() {
    var b = new B[int](v = 1)
    print(_str(b.v))
}
")
    ce.expect_error(structConstraint, "new B[int] 违反 T: C 约束 => 编译期报错",
        "不满足约束 'C'", 4)

    // ㉔b 防误报：显式 impl 该 face 的 struct 可以实例化
    var structConstraintOk = dirs.join(work, "struct_constraint_ok.leno")
    files.write(structConstraintOk, @"face C { func m(): int }
struct G impl C { func m(): int { return 1 } }
struct B[T: C] { T v }
main() {
    var b = new B[G](v = new G())
    print(_str(b.v.m()))
}
")
    ce.expect_ok(structConstraintOk, "new B[G] 满足约束（防误报）", "1")

    // ㉔c 跨模块：约束名随模块符号表传递，`new cm.B[int]` 同样要报
    var cmod = dirs.join(work, "constraint_mod.leno")
    files.write(cmod, @"export face C { func m(): int }
export struct G impl C { func m(): int { return 1 } }
export struct B[T: C] { T v }
")
    var crossBad = dirs.join(work, "struct_constraint_cross_bad.leno")
    files.write(crossBad, @"import ""./constraint_mod.leno"" as cm
main() {
    var b = new cm.B[int](v = 1)
    print(_str(b.v))
}
")
    ce.expect_error(crossBad, "跨模块 new cm.B[int] 违反约束 => 报错",
        "不满足约束 'C'", 3)

    var crossOk = dirs.join(work, "struct_constraint_cross_ok.leno")
    files.write(crossOk, @"import ""./constraint_mod.leno"" as cm
use cm.G
main() {
    var b = new cm.B[G](v = new G())
    print(""ok"")
}
")
    ce.expect_ok(crossOk, "跨模块 new cm.B[G] 满足约束", "ok")

    // ---- ㉕ catch / finally 落在 try 之外：此前只报「期望表达式」（catch 还连报两次）----
    var catchOutside = dirs.join(work, "catch_outside.leno")
    files.write(catchOutside, @"main() {
    catch (e) { print(""x"") }
}
")
    ce.expect_error(catchOutside, "catch 在 try 外 => 定向报错",
        "`catch` 只能跟在 try 语句后面", 2)

    var finallyOutside = dirs.join(work, "finally_outside.leno")
    files.write(finallyOutside, @"main() {
    finally { print(""x"") }
}
")
    ce.expect_error(finallyOutside, "finally 在 try 外 => 定向报错",
        "`finally` 只能跟在 try 语句后面", 2)

    // ---- ㉖ `throw` 缺表达式：此前**静默**当成 `throw null`（运行期只打 "[错误] …: null"）----
    var throwNoExpr = dirs.join(work, "throw_no_expr.leno")
    files.write(throwNoExpr, @"main() {
    throw
    print(""x"")
}
")
    ce.expect_error(throwNoExpr, "throw 缺表达式 => 定向报错",
        "throw 后面必须跟要抛出的表达式", 2)

    // ㉖b 防误报：正常的 try / catch / finally 与带表达式的 throw 必须照常工作
    var tryOk = dirs.join(work, "try_throw_ok.leno")
    files.write(tryOk, @"main() {
    try {
        throw ""boom""
    } catch e {
        print(e.msg)
    } finally {
        print(""done"")
    }
}
")
    ce.expect_ok(tryOk, "try/catch/finally + throw 表达式（防误报）", "boom")

    // ---- ㉗ `struct P { int x, int y }` / cstruct 逗号分隔：此前只报「期望字段名」---
    var structComma = dirs.join(work, "struct_comma_type.leno")
    files.write(structComma, @"struct P { int x, int y }
main() {
    var p = new P(x = 1, y = 2)
    print(_str(p.x + p.y))
}
")
    var outStructComma = ce.expect_error(structComma, "struct 逗号后又写类型 => 定向报错",
        "逗号后", 1)
    ce.expect_no_warning(outStructComma, "struct 逗号后又写类型", "期望 '}' 结束 struct 定义")

    var cstructComma = dirs.join(work, "cstruct_comma.leno")
    files.write(cstructComma, @"cstruct C { int x, int y }
main() {
    C c = C.malloc()
    print(_str(c.x))
}
")
    ce.expect_error(cstructComma, "cstruct 逗号分隔 => 定向报错",
        "cstruct 字段不支持逗号分隔", 1)

    // ㉗b 防误报：合法的 `int x, y`（共用类型）必须照常可用
    var commaNames = dirs.join(work, "struct_comma_names.leno")
    files.write(commaNames, @"struct P { int x = 1, y = 2 }
main() {
    var p = new P()
    print(_str(p.x + p.y))
}
")
    ce.expect_ok(commaNames, "int x, y 共用类型（防误报）", "3")

    // ---- ㉘ `export export func`：此前先报一条不相干的「期望类型…」----
    var exportTwice = dirs.join(work, "export_twice.leno")
    files.write(exportTwice, @"export export func f(): int { return 1 }
main() { print(_str(f())) }
")
    var outExportTwice = ce.expect_error(exportTwice, "export 重复 => 单条定向报错",
        "export 重复了", 1)
    ce.expect_no_warning(outExportTwice, "export 重复", "期望类型")

    print("test_diag_parse_hints passed")
}
