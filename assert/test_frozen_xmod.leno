// test_frozen_xmod.leno —— frozen 跨模块 / 别名 / 泛型 / 模块级导出 / 缓存往返
//
// 覆盖（都是单文件用例碰不到的路径）：
//   ① `Frozen[fx.Row]`：T 来自另一个模块，跨模块读字段
//   ② 跨模块形参 `Frozen[Array[int]]` / `Frozen[Array[Row]]`
//   ③ 跨模块**返回** `Frozen[...]`（模块自己冻、调用方接着用）
//   ④ 模块级 `export Frozen[...]` 变量：主线程读 + 子线程（globals 克隆）读
//   ⑤ 别名：`import ... as fx` 与 `use fx.Row`（不带限定名）
//   ⑥ 泛型 struct：`Frozen[fx.Box[int]]`
//   ⑦ 深层嵌套：`Frozen[Dict[string, Array[Row]]]`
//   ⑧ 跨模块的编译期拦截（元素写 / 字段写 / 赋给可变类型）
import threads
import "./fixture_frozen_xmod.leno" as fx
use fx.Row
use fx.Box

func read_shared_in_thread(): int {
    return fx.SHARED.len() + fx.shared_len()
}

main() {
    // ================= ① 跨模块 struct =================
    var rows = fx.make_rows(3)
    Frozen[Array[fx.Row]] frozenRows = _freeze(rows)
    assert_eq(frozenRows.len(), 3, "①长度")
    assert_eq(frozenRows[1].name, "row1", "①跨模块 struct 字段读")
    assert_eq(frozenRows[2].nums[1], 3, "①跨模块 struct 里的数组字段")
    assert_eq(_is_frozen(frozenRows), true, "①确实冻住了")

    // ================= ② 跨模块形参 =================
    var ints = []
    for 1 : 100 to i { ints.add(i) }
    Frozen[Array[int]] snap = _freeze(ints)
    assert_eq(fx.sum_of(snap), 5050, "②跨模块 Frozen 形参")
    assert_eq(fx.first_name(frozenRows), "row0", "②跨模块 Frozen[Array[Row]] 形参")

    // ================= ③ 跨模块返回 Frozen =================
    Frozen[Array[int]] made = fx.make_frozen(5)
    assert_eq(made.len(), 5, "③跨模块返回 Frozen")
    assert_eq(made[4], 16, "③返回的 frozen 可读")
    assert_eq(fx.sum_of(made), 0 + 1 + 4 + 9 + 16, "③再传回模块函数")

    // ================= ④ 模块级 export Frozen =================
    assert_eq(fx.SHARED.len(), 3, "④主线程读模块级 frozen")
    assert_eq(fx.SHARED[1], 20, "④元素可读")
    var t = threads.start(read_shared_in_thread)
    assert_eq(t.join(), 6, "④子线程 globals 克隆后仍可读（3+3）")

    // ================= ⑤ 别名 + use（不带限定名） =================
    Row r = new Row(id = 7, name = "alias")
    Frozen[Row] fr = _freeze(r)
    assert_eq(fr.id, 7, "⑤use 之后 Frozen[Row] 可用")
    assert_eq(fr.name, "alias", "⑤字段读")

    // ================= ⑥ 泛型 struct =================
    Box[int] b = new Box[int](v = 42)
    Frozen[Box[int]] fb = _freeze(b)
    assert_eq(fb.v, 42, "⑥冻结泛型 struct")
    assert_eq(fb.get(), 42, "⑥冻结泛型 struct 的方法（只读）")

    // ================= ⑦ 深层嵌套 =================
    Dict[string, Array[Row]] d = {}
    d.set("a", fx.make_rows(2))
    var fd = _freeze(d)
    var inner = fd.get("a") as Array[Row]
    assert_eq(inner.len(), 2, "⑦嵌套读到内层数组")
    assert_eq(inner[1].name, "row1", "⑦内层跨模块 struct 字段")

    // ================= ⑧ 跨模块编译期拦截 =================
    var chk = _exec(_executable() + " --check assert/fixture_frozen_xmod_err.leno", 30000)
    if chk is ExecResult {
        assert_eq(_int(chk.code) != 0, true, "⑧跨模块写 frozen 应编译失败")
        var out = _str(chk.output)
        assert_eq(has_sub(out, "frozen"), true, "⑧报错文案要提 frozen（实际：" + out + "）")
    } else {
        assert_eq(1, 0, "⑧--check 子进程没跑起来")
    }

    // ================= ⑨ _thaw 之后可写（跨模块类型也能 thaw） =================
    Array[Row] copy = _thaw(frozenRows)
    copy[0].name = "changed"
    assert_eq(copy[0].name, "changed", "⑨thaw 出来的可写")
    assert_eq(frozenRows[0].name, "row0", "⑨冻结那份不受影响")

    print("test_frozen_xmod passed")
}

func has_sub(string text, string needle): bool {
    if text.len() < needle.len() { return false }
    for 0 : text.len() - needle.len() to i {
        if text[i : i + needle.len() - 1] == needle { return true }
    }
    return false
}
