// test_module_method_hint.leno —— 模块方法名写错必须给出**可猜的**建议
//
// 历史（保留，免得下次又走回头路）：
//   2026-11-23：`strings.upper` / `strings.repeat` 报错且**一条建议都没有** ——
//     相似名提示用的是编辑距离 ≤2，而 `upper`→`to_upper`、`repeat`→`rep` 都是 3 ⇒ 被挡掉。
//     补了「词缀规则」（同词根、前后缀差 ≤3 字符、双向查）。
//   同日一度加过 `repeat`/`upper`/`lower` **别名**，随后删除：同一功能两个名字会让
//     文档/示例/用户代码长期两种写法混用 ⇒ **只用提示纠错，不留第二条路**。
//   ⇒ 本用例守的就是这两条提示 + "没有相近项时不瞎猜"。
import "helpers/compiler.leno" as ce
import dirs
import files

main() {
    var work = dirs.join(_tmpdir(), "leno_method_hint")
    dirs.delete(work)
    dirs.mkdir_p(work)

    // ① 少写 `to_` 前缀：应提示 to_upper
    var d1 = dirs.join(work, "m1.leno")
    files.write(d1, @"import strings

main() {
    print(strings.upper(""abc""))
}
")
    ce.expect_error(d1, "① strings.upper 应提示 to_upper", "是否想用 'to_upper'", 4)

    // ② 多写后缀（候选比输入短的方向）：应提示 rep
    var d2 = dirs.join(work, "m2.leno")
    files.write(d2, @"import strings

main() {
    print(strings.repeat(""-"", 3))
}
")
    ce.expect_error(d2, "② strings.repeat 应提示 rep", "是否想用 'rep'", 4)

    // ③ 对照：真的没有相近名字时**不要瞎猜**（误报红线）
    var d3 = dirs.join(work, "m3.leno")
    files.write(d3, @"import strings

main() {
    print(strings.contians(""abc"", ""b""))
}
")
    var o3 = ce.expect_error(d3, "③ 毫无相近项时不提示", "未找到模块方法", 4)
    ce.expect_no_warning(o3, "③ 不该硬凑一个建议", "是否想用")

    dirs.delete(work)
    print("test_module_method_hint passed")
}
