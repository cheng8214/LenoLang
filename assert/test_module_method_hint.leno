// test_module_method_hint.leno —— 「模块方法名写错」要给出**可猜的**建议（2026-11-23）
//
// 由来：写 bench 脚本时把 `strings.to_upper` 写成 `strings.upper`、`strings.rep` 写成
//   `strings.repeat` —— 报错只列了 43 个方法名（还被截断），一条建议都没有。
//   根因不是"没做相似名提示"，而是提示用的是 **编辑距离 ≤2**：
//     `upper` → `to_upper` 距离 3、`repeat` → `rep` 距离 3 ⇒ 恰好都被挡掉 ✗
//   修法：在编辑距离之外补一条**词缀规则**（同一词根、只差 ≤3 字符的前缀/后缀，双向查）。
import "helpers/compiler.leno" as ce
import dirs
import files

main() {
    var work = dirs.join(_tmpdir(), "leno_method_hint")
    dirs.delete(work)
    dirs.mkdir_p(work)

    // ① 少写了 `to_` 前缀
    var d1 = dirs.join(work, "m1.leno")
    files.write(d1, @"import strings

main() {
    print(strings.upper(""abc""))
}
")
    ce.expect_error(d1, "① strings.upper 应提示 to_upper",
        "是否想用 'to_upper'", 4)

    // ② 多写了后缀（候选比输入短的方向）
    var d2 = dirs.join(work, "m2.leno")
    files.write(d2, @"import strings

main() {
    print(strings.repeat(""-"", 3))
}
")
    ce.expect_error(d2, "② strings.repeat 应提示 rep",
        "是否想用 'rep'", 4)

    // ③ 对照：真的没有相近的名字时**不要瞎猜**（误报红线）
    var d3 = dirs.join(work, "m3.leno")
    files.write(d3, @"import strings

main() {
    print(strings.contians(""abc"", ""b""))
}
")
    var o3 = ce.expect_error(d3, "③ 毫无相近项时不提示", "未找到模块方法", 4)
    ce.expect_no_warning(o3, "③ 不该硬凑一个建议", "是否想用")

    dirs.delete(work)
    print("test_module_method_hint passed")
}
