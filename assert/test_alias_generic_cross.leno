// test_alias_generic_cross.leno —— 泛型 alias 的四条路径（2026-11-25 钉住）
//
// 修前两个 bug（都能写成"合法代码被拒"，且报错**指错靶子**）：
//   ① `export alias Stack[T] = ct.Stack[T]`（别名体是**限定名** + 泛型参数）
//      ⇒ 报「未定义的变量: T」—— 因为解析器把右值当成了**值别名**（`alias X = Enum.member`），
//         于是 `[T]` 被当作**下标表达式**，T 就成了"变量" ✗
//   ② 同一句修好解析后，`new StackAlias[int]()` 又报「未定义的 struct 类型 'Stack'」——
//      `new` 那里把别名体替换成 struct_name 时**丢了模块前缀**（`ct.`）✗
// 修法：parser_func.c 的值别名探测加两条排除（带类型参数 / 成员名后跟 `[`）；
//       parser_expr.c 的别名替换把 `qual.name` 拼回去。
import "helpers/alias_box_mod.leno" as m
use m.BoxAlias        // 模块级：下面的 viaParam / viaReturn 也要用（`use` 有作用域）

// A) 本地泛型 alias → 本地泛型 struct
struct LocalBox[T] {
    Array[T] items = []
    func put(T v) { items.add(v) }
    func take(): T { return items.pop() }
}
alias LB[T] = LocalBox[T]

// B) 本地泛型 alias → 内置泛型容器
alias LA[T] = Array[T]

// C) 跨模块泛型 alias → 别的模块的泛型 struct（这是原来必崩的那条）
export alias MB[T] = m.Box[T]

// D) 非泛型 alias → **已实例化**的跨模块泛型 struct
alias IntBox = m.Box[int]

// E) 值别名（`alias X = Enum.member`）不能被上面的修复带坏
enum Color { RED = 0; BLUE = 1 }
alias RedAlias = Color.RED

main() {
    // A
    var a = new LB[int]()
    a.put(11)
    assert_eq(a.take(), 11, "A 本地泛型 alias → 本地泛型 struct")

    // B
    LA[int] arr = []
    arr.add(22)
    assert_eq(arr[0], 22, "B 本地泛型 alias → Array[T]")

    // C
    var c = new MB[string]()
    c.put("cc")
    assert_eq(c.take(), "cc", "C 跨模块泛型 alias → m.Box[T]")

    // D
    var d = new IntBox()
    d.put(44)
    assert_eq(d.take(), 44, "D alias → 已实例化的跨模块泛型 struct")

    // E
    assert_eq(RedAlias, 0, "E 值别名 alias X = Enum.member 仍然有效")

    // F) 跨模块泛型别名 + use 裸名调用（2026-11-25 才通的路径：
    //    形参名随符号表导出 ⇒ 语义期把 `new BoxAlias[int]()` 展开成 `new m.Box[int]()`）
    var f = new BoxAlias[int]()
    f.put(66)
    assert_eq(f.take(), 66, "F use 导入的跨模块泛型别名")

    // G) 跨模块**已实例化**别名（调用点没有实参）
    var g = new m.IntBoxAlias()
    g.put(77)
    assert_eq(g.take(), 77, "G 跨模块已实例化别名")

    // H) 限定名直接写别名（不走 use）
    var h = new m.BoxAlias[string]()
    h.put("hh")
    assert_eq(h.take(), "hh", "H 限定名 m.BoxAlias[T]")

    // I) 别名作**函数形参类型**（2026-11-25 补：签名里的别名此前不展开 ⇒ 假报类型不匹配）
    assert_eq(viaParam(new BoxAlias[int]()), 88, "I 别名作形参")

    // J) 别名作**返回类型**
    assert_eq(viaReturn().take(), 99, "J 别名作返回类型")

    // K) 别名作**局部变量注解**（走 resolve_alias_in_type 的常规路径）
    BoxAlias[int] k = new BoxAlias[int]()
    k.put(12)
    assert_eq(k.take(), 12, "K 别名作局部变量注解")

    print("test_alias_generic_cross passed")
}

// 别名作形参类型：调用点实参是 `new BoxAlias[int]()`（已被展开成 m.Box[int]），
// 形参若不展开就停在别名名上 ⇒ 假报「参数类型不匹配」。这个用例专门钉住那次修复。
func viaParam(BoxAlias[int] b): int {
    b.put(88)
    return b.take()
}

// 别名作返回类型
func viaReturn(): BoxAlias[int] {
    var b = new BoxAlias[int]()
    b.put(99)
    return b
}
