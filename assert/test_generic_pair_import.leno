// test_generic_pair_import.leno —— 跨模块泛型（struct 返回类型 / 类型实参代入）（2026-09-28；实例二十九 + 三十八）
//
// 修的两件事：
// ① 模块符号表扫描器解析返回类型字符串时，**只要见到逗号就把整份当 `Dict[K,V]`**（不看标识符）
//    ⇒ `export func makePair[K, V](...): Pair[K, V]` 的返回类型被记成 `Dict[K,V]` ⇒ 调用方拿到
//    `Dict[struct K, struct V]` ⇒ `p.getKey()` 报「类型 'Dict[struct K, struct V]' 没有方法 'getKey'」。
//    实测来源：examples/泛型系统/{泛型函数,跨模块泛型} 两个用例（"直接 new Pair[..] 好、经泛型函数差"）。
// ② 修完①后返回值的**静态**类型仍是 `Pair[K, V]`（占位符没代入调用点的类型实参）⇒
//    `string k = p.getKey()` 报「期望 string，实际 struct K」。根因：`ModuleFuncSymbol` 只记了
//    类型形参**数量**（struct 方法侧早有 `return_generic_param_names`）；且
//    `semantic_substitute_generic_param` **不递归 generic_args**（而 `Pair[K,V]` 的 K/V 正藏在那里）
//    ⇒ 两处都补上（随 `.lenosymc` v31 往返）。

import "generic_pair_mod.leno" as gm

main() {
    // ① 双类型参数：泛型函数返回泛型 struct ⇒ 能调方法、能取字段
    var p = gm.makePair[string, int]("x", 10)
    assert_eq(p.getKey(), "x")
    assert_eq(p.getVal(), 10)
    assert_eq(type(p).has("Pair"), true)      // 运行期类型名带 Pair（不再是 Dict[...]）

    var p2 = gm.makePair[int, string](7, "seven")
    assert_eq(p2.getKey(), 7)
    assert_eq(p2.getVal(), "seven")

    // ② 类型实参要**代入静态类型**（此前这些强类型写法编不过：实际类型 struct K / struct V）
    string k = p.getKey()
    int v = p.getVal()
    assert_eq(k, "x")
    assert_eq(v, 10)
    int k2 = p2.getKey()
    string v2 = p2.getVal()
    assert_eq(k2, 7)
    assert_eq(v2, "seven")

    // ③ 裸类型形参返回（`identity[T]: T` ⇒ 代入后是具体类型）
    int i = gm.identity[int](42)
    string s = gm.identity[string]("hi")
    assert_eq(i, 42)
    assert_eq(s, "hi")

    // ④ 单类型参数泛型 struct（同一表示法的对照组）
    var b = gm.makeBox[int](42)
    int bv = b.get()
    assert_eq(bv, 42)

    // ⑤ 反向对照：**真的 `Dict[K,V]`** 仍必须是字典（修法只针对"标识符不是 Dict"的情况）
    var d = {"a": 1, "b": 2}
    assert_eq(d.len(), 2)
    assert_eq(d["a"], 1)

    print("test_generic_pair_import passed")
}
