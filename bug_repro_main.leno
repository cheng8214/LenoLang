// main.leno — export struct + 跨模块 cstruct 数组索引赋值
import "bug_repro_core.leno" as core
use core.Vertex

export struct Renderer {
    func test() {
        Vertex v = Vertex.malloc_array(3)
        v[0].x = 1.0
        v[0].y = 2.0
        v.free()
    }
}

Renderer r = new Renderer()
r.test()
print("ok")
