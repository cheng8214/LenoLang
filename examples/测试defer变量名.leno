// 测试不同变量名

var log = []
func add(string s) { log.add(s) }

print("=== A: for 0:3 to i, defer 引用 i ===")
log = []
for 0:3 to i {
    defer add("defer-" + i)
    add("iter-" + i)
    if i == 1 {
        add("breaking")
        break
    }
}
add("after")
print("  " + log)

print("\n=== B: for 0:3 to x, defer 引用 x ===")
log = []
for 0:3 to x {
    defer add("defer-" + x)
    add("iter-" + x)
    if x == 1 {
        add("breaking")
        break
    }
}
add("after")
print("  " + log)

print("\n=== C: for 0:3 to i, defer 引用 i, print i ===")
log = []
for 0:3 to i {
    defer add("defer-" + i)
    print("  body i=" + i)
    if i == 1 {
        add("breaking")
        break
    }
}
add("after")
print("  " + log)
