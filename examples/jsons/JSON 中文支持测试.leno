import jsons
import "json_any.leno" as j

// 注（2026-09-19）：`jsons.decode/read_file` 的静态返回类型是 `any` ⇒ 取值统一走同目录的
// `json_any.leno`（jstr / jshow / jobj / jat / jats / jlen）—— 显式类型收窄收在那一层，
// 这里才写得出 `j.jstr(obj, "键")` 这种直白形式（原来的 `obj["键"]` 编译不过 ✗）。
print("========== JSON 中文支持测试 ==========\n")

// ========== 1. 中文字符串 ==========
print("--- 1. 中文字符串测试 ---")

var chinese_str = jsons.decode("\"你好世界\"")
print("中文字符串: " + j.jshow(chinese_str))

var mixed_str = jsons.decode("\"Hello 你好 World 世界\"")
print("混合字符串: " + j.jshow(mixed_str))

// ========== 2. 中文键名 ==========
print("\n--- 2. 中文键名测试 ---")

var chinese_keys = jsons.decode("{\"姓名\": \"张三\", \"年龄\": 25, \"城市\": \"北京\"}")
print("中文键对象: " + j.jshow(chinese_keys))
print("  姓名: " + j.jstr(chinese_keys, "姓名"))
print("  年龄: " + j.jstr(chinese_keys, "年龄"))
print("  城市: " + j.jstr(chinese_keys, "城市"))

// ========== 3. 中文数组 ==========
print("\n--- 3. 中文数组测试 ---")

var chinese_arr = jsons.decode("[\"苹果\", \"香蕉\", \"橙子\"]")
print("中文数组: " + j.jshow(chinese_arr))
print("  第1个: " + j.jats(chinese_arr, 0))
print("  第2个: " + j.jats(chinese_arr, 1))
print("  第3个: " + j.jats(chinese_arr, 2))

// ========== 4. 复杂中文对象 ==========
print("\n--- 4. 复杂中文对象测试 ---")

var user_json = "{\"用户\": {\"昵称\": \"小明\", \"邮箱\": \"xiaoming@example.com\"}, \"订单\": [{\"商品\": \"手机\", \"价格\": 3999}, {\"商品\": \"耳机\", \"价格\": 299}], \"总计\": 4298}"
var user_data = jsons.decode(user_json)

print("用户信息:")
print("  昵称: " + j.jstr(j.jobj(user_data, "用户"), "昵称"))
print("  邮箱: " + j.jstr(j.jobj(user_data, "用户"), "邮箱"))
print("\n订单列表:")
var orders = j.jobj(user_data, "订单")
print("  订单1: " + j.jstr(j.jat(orders, 0), "商品") + " - ¥" + j.jstr(j.jat(orders, 0), "价格"))
print("  订单2: " + j.jstr(j.jat(orders, 1), "商品") + " - ¥" + j.jstr(j.jat(orders, 1), "价格"))
print("  总计: ¥" + j.jstr(user_data, "总计"))

// ========== 5. 中文编码测试 ==========
print("\n--- 5. 中文编码测试 ---")

// 使用引号字符串作为中文键
// 注：显式声明成 `Dict[string, any]` —— 写成裸 `var chinese_obj = {}` 时，值类型会被**首个插入**
// 推成 `string` ⇒ 之后塞 `{}`（子字典）或 `4999`（int）就报「类型错误：字典值类型不匹配」✗
// （实测；这也是原示例编译不过的两个错处）。子字典同理：先建成变量、再整体塞进去，
// 因为 `chinese_obj["规格"]["内存"] = ...` 里的中间结果是 `any`，不能再下标赋值 ✗。
Dict[string, any] spec = {}
spec["内存"] = "8GB"
spec["存储"] = "256GB"

Dict[string, any] chinese_obj = {}
chinese_obj["产品"] = "智能手机"
chinese_obj["品牌"] = "华为"
chinese_obj["规格"] = spec
chinese_obj["价格"] = 4999

var encoded = jsons.encode(chinese_obj)
print("编码结果: " + j.jshow(encoded))

var pretty = jsons.encode_pretty(chinese_obj)
print("美化格式:\n" + j.jshow(pretty))

// ========== 6. 中文文件读写 ==========
print("\n--- 6. 中文文件读写测试 ---")

// 写到系统临时目录（别在仓库根留垃圾；也便于本示例被"冒烟门禁"直接跑 ✓）
var chinese_file = _tmpdir() + _sep() + "leno_chinese_test.json"
jsons.write_file(chinese_file, chinese_obj)
print("写入文件: " + chinese_file)

var read_back = jsons.read_file(chinese_file)
print("读取结果: " + j.jshow(read_back))
print("  产品: " + j.jstr(read_back, "产品"))
print("  品牌: " + j.jstr(read_back, "品牌"))
print("  规格.内存: " + j.jstr(j.jobj(read_back, "规格"), "内存"))

// ========== 7. 特殊中文字符 ==========
print("\n--- 7. 特殊中文字符测试 ---")

var special = jsons.decode("{\"标点\": \"，。！？\" , \"符号\": \"【】《》\"}")
print("特殊字符:")
print("  标点: " + j.jstr(special, "标点"))
print("  符号: " + j.jstr(special, "符号"))

// ========== 8. 中文与数字混合 ==========
print("\n--- 8. 中文与数字混合测试 ---")

var mixed = jsons.decode("{\"编号\": \"第001号\", \"金额\": \"¥1000.50元\", \"百分比\": \"50%\"}")
print("混合内容:")
print("  编号: " + j.jstr(mixed, "编号"))
print("  金额: " + j.jstr(mixed, "金额"))
print("  百分比: " + j.jstr(mixed, "百分比"))

// ========== 9. 长文本中文 ==========
print("\n--- 9. 长文本中文测试 ---")

var long_text = jsons.decode("{\"描述\": \"这是一个很长的中文描述文本，用于测试JSON模块对长文本的处理能力。可以包含各种特殊字符。\"}")
print("长文本:")
print("  " + j.jstr(long_text, "描述"))

// ========== 10. 中文诗词测试 ==========
print("\n--- 10. 中文诗词测试 ---")

var poem = jsons.decode("{\"标题\": \"静夜思\", \"作者\": \"李白\", \"内容\": [\"床前明月光\", \"疑是地上霜\", \"举头望明月\", \"低头思故乡\"]}")
print(j.jstr(poem, "标题") + " - " + j.jstr(poem, "作者"))
var lines = j.jobj(poem, "内容")
print("  " + j.jats(lines, 0))
print("  " + j.jats(lines, 1))
print("  " + j.jats(lines, 2))
print("  " + j.jats(lines, 3))

print("\n========== 中文测试全部通过 ==========")
