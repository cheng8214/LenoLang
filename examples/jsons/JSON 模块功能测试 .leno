import jsons
import "json_any.leno" as j

// 注（2026-09-19）：`jsons.decode/read_file` 的静态返回类型是 `any` ⇒ 取值统一走同目录的
// `json_any.leno`（jstr / jshow / jobj / jat / jats / jlen）。原来的 `obj.name` / `arr[0]` 写法
// 编译不过 ✗（「不能在 any 类型上直接访问字段 / 进行索引访问」）。
print("========== JSON 模块功能测试 ==========\n")

// ========== 1. decode 函数测试 ==========
print("--- 1. decode 函数测试 ---")

// 基本类型测试
print("\n>> 基本类型:")
var str1 = jsons.decode("\"hello world\"")
print("字符串: " + j.jshow(str1))

var num1 = jsons.decode("42")
print("整数: " + j.jshow(num1))

var num2 = jsons.decode("3.14")
print("浮点数: " + j.jshow(num2))

var bool1 = jsons.decode("true")
print("布尔 true: " + j.jshow(bool1))

var bool2 = jsons.decode("false")
print("布尔 false: " + j.jshow(bool2))

var null1 = jsons.decode("null")
print("null: " + j.jshow(null1))

// 数组测试
print("\n>> 数组:")
var arr1 = jsons.decode("[1, 2, 3]")
print("数字数组: " + j.jshow(arr1))
print("  arr1[0]: " + j.jats(arr1, 0))
print("  arr1[1]: " + j.jats(arr1, 1))
print("  arr1[2]: " + j.jats(arr1, 2))

var arr2 = jsons.decode("[\"a\", \"b\", \"c\"]")
print("字符串数组: " + j.jshow(arr2))
print("  arr2[0]: " + j.jats(arr2, 0))

var arr3 = jsons.decode("[1, \"two\", true, null]")
print("混合数组: " + j.jshow(arr3))

// 嵌套数组
var arr4 = jsons.decode("[[1, 2], [3, 4]]")
print("嵌套数组: " + j.jshow(arr4))
print("  arr4[0][0]: " + j.jats(j.jat(arr4, 0), 0))
print("  arr4[1][1]: " + j.jats(j.jat(arr4, 1), 1))

// 对象测试
print("\n>> 对象:")
var obj1 = jsons.decode("{\"name\": \"Leno\", \"version\": 1.0}")
print("简单对象: " + j.jshow(obj1))
print("  obj1.name: " + j.jstr(obj1, "name"))
print("  obj1.version: " + j.jstr(obj1, "version"))

// 嵌套对象
print("\n>> 嵌套对象:")
var obj2 = jsons.decode("{\"user\": {\"id\": 1, \"name\": \"张三\"}, \"active\": true}")
print("嵌套对象: " + j.jshow(obj2))
print("  obj2.user.name: " + j.jstr(j.jobj(obj2, "user"), "name"))
print("  obj2.user.id: " + j.jstr(j.jobj(obj2, "user"), "id"))
print("  obj2.active: " + j.jstr(obj2, "active"))

// 复杂嵌套
print("\n>> 复杂嵌套结构:")
var complex = jsons.decode("{\"users\": [{\"name\": \"A\", \"age\": 20}, {\"name\": \"B\", \"age\": 25}], \"total\": 2}")
print("复杂对象: " + j.jshow(complex))
print("  complex.total: " + j.jstr(complex, "total"))
var users = j.jobj(complex, "users")
print("  complex.users[0].name: " + j.jstr(j.jat(users, 0), "name"))
print("  complex.users[1].age: " + j.jstr(j.jat(users, 1), "age"))

// 空对象和空数组
print("\n>> 空对象和空数组:")
var empty_obj = jsons.decode("{}")
print("空对象: " + j.jshow(empty_obj))

var empty_arr = jsons.decode("[]")
print("空数组: " + j.jshow(empty_arr))

// 转义字符测试
print("\n>> 转义字符:")
var escape = jsons.decode("{\"text\": \"line1\\nline2\\ttab\"}")
print("转义字符: " + j.jstr(escape, "text"))

// ========== 2. encode 函数测试 ==========
print("\n--- 2. encode 函数测试 ---")

var test_obj = {
    name: "测试",
    count: 42,
    valid: true,
    data: null,
    items: ["a", "b", "c"],
    nested: {x: 1, y: 2}
}

var encoded = jsons.encode(test_obj)
print("编码结果: " + j.jshow(encoded))

// ========== 3. encode_pretty 函数测试 ==========
print("\n--- 3. encode_pretty 函数测试 ---")

var pretty = jsons.encode_pretty(test_obj)
print("美化格式:\n" + j.jshow(pretty))

// ========== 4. write_file 和 read_file 测试 ==========
print("\n--- 4. 文件操作测试 ---")

// 写到系统临时目录（别在仓库根留垃圾；也便于本示例被"冒烟门禁"直接跑 ✓）
var test_file = _tmpdir() + _sep() + "leno_json_mod_test.json"

// 写入文件
var write_result = jsons.write_file(test_file, test_obj)
var result_str = "失败"
if (write_result) {
    result_str = "成功"
}
print("写入文件: " + test_file + " - " + result_str)

// 读取文件
var read_data = jsons.read_file(test_file)
print("读取文件结果: " + j.jshow(read_data))
print("  read_data.name: " + j.jstr(read_data, "name"))
print("  read_data.count: " + j.jstr(read_data, "count"))
print("  read_data.items: " + j.jshow(j.jobj(read_data, "items")))
print("  read_data.nested.x: " + j.jstr(j.jobj(read_data, "nested"), "x"))

// ========== 5. 类型保持测试 ==========
print("\n--- 5. 类型保持测试 ---")

var type_test = jsons.decode("{\"int\": 100, \"float\": 3.14, \"bool\": false, \"null_val\": null}")
print("int 类型: " + type(j.jobj(type_test, "int")))
print("float 类型: " + type(j.jobj(type_test, "float")))
print("bool 类型: " + type(j.jobj(type_test, "bool")))
print("null 类型: " + type(j.jobj(type_test, "null_val")))

// ========== 6. 中文测试 ==========
print("\n--- 6. 中文支持测试 ---")

var chinese = jsons.decode("{\"中文\": \"你好世界\", \"emoji\": \"🎉\"}")
print("中文键值: " + j.jshow(chinese))
print("  chinese['中文']: " + j.jstr(chinese, "中文"))

// ========== 7. 数字边界测试 ==========
print("\n--- 7. 数字边界测试 ---")

var numbers = jsons.decode("{\"negative\": -123, \"zero\": 0, \"large\": 999999999}")
print("数字边界: " + j.jshow(numbers))
print("  negative: " + j.jstr(numbers, "negative"))
print("  zero: " + j.jstr(numbers, "zero"))
print("  large: " + j.jstr(numbers, "large"))

// ========== 8. 特殊字符测试 ==========
print("\n--- 8. 特殊字符测试 ---")

var special = jsons.decode("{\"quote\": \"say \\\"hello\\\"\", \"backslash\": \"path\\\\to\\\\file\", \"slash\": \"http://example.com\"}")
print("特殊字符:")
print("  quote: " + j.jstr(special, "quote"))
print("  backslash: " + j.jstr(special, "backslash"))
print("  slash: " + j.jstr(special, "slash"))

// ========== 9. 深度嵌套测试 ==========
print("\n--- 9. 深度嵌套测试 ---")

var deep = jsons.decode("{\"a\": {\"b\": {\"c\": {\"d\": \"deep value\"}}}}")
print("深度嵌套: " + j.jshow(deep))
print("  a.b.c.d: " + j.jstr(j.jobj(j.jobj(j.jobj(deep, "a"), "b"), "c"), "d"))

// ========== 10. 数组索引访问测试 ==========
print("\n--- 10. 数组操作测试 ---")

var arr_obj = jsons.decode("[{\"id\": 1}, {\"id\": 2}, {\"id\": 3}]")
print("对象数组:")
print("  arr_obj[0].id: " + j.jstr(j.jat(arr_obj, 0), "id"))
print("  arr_obj[1].id: " + j.jstr(j.jat(arr_obj, 1), "id"))
print("  arr_obj[2].id: " + j.jstr(j.jat(arr_obj, 2), "id"))

print("\n========== 所有测试完成 ==========")
