main() {
    // 测试相等的数组
    print([1, 2, 3] == [1, 2, 3])
    
    // 测试不相等的数组（不同值）
    print([1, 2, 3] == [1, 2, 4])
    
    // 测试不相等的数组（不同长度）
    print([1, 2, 3] == [1, 2])
    
    // 测试空数组
    print([] == [])
    
    // 测试字符串数组
    print(["a", "b"] == ["a", "b"])
    print(["a", "b"] == ["a", "c"])
}
