main() {
  // 测试1：三层嵌套 add
  var arr1 = [[[]]]
  arr1[0][0].add(1)
  arr1[0][0].add(2)
  print("三层 add: " + type(arr1))
  print(arr1)
  
  // 测试2：三层嵌套 insert
  var arr2 = [[[]]]
  arr2[0][0].insert(0, 100)
  print("三层 insert: " + type(arr2))
  print(arr2)
  // 测试3：四层嵌套
  var arr3 = [[[[]]]]
  arr3[0][0][0].add(999)
  print("四层 add: " + type(arr3))
  print(arr3)
  
  // 测试4：类型不匹配检查
  var arr4 = [[[]]]
  arr4[0][0].add(1)
  // arr4[0][0].add("string")  // 应该报错
}
