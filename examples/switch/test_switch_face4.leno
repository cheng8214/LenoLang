// face 存在但不 impl
face Shape {
    func area():int
}

struct Rect {
    int width = 0
    int height = 0
    func area() { return width * height }
}

var r = new Rect(width=10, height=20)
print("created Rect")

switch r {
    case is Rect {
        print("r is Rect")
    }
    default {
        print("r is not Rect")
    }
}
