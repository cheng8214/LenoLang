// leno-lines — 自统计行数：按扩展名分组（.c / .h / .leno）
// 用法: leno leno-lines.leno [目录]     （默认当前目录）
//   输出：逐文件行数 + 每组汇总（文件数/总行/空行/代码行）+ 总计
import files
import strings
import dirs

string sep = if _os() == "windows" then "\\" else "/"

// 分组计数：0=.c  1=.h  2=.leno（数组元素赋值 ✓ —— leno_gui 真实代码大量在用 ✓）
Array[int] g_cnt = [0, 0, 0]
Array[int] g_tot = [0, 0, 0]
Array[int] g_blk = [0, 0, 0]

// path —— **真实路径**（读盘用 ✓）；root —— 只用于把显示路径换成**相对 root** 的短写法。
//   为什么不直接打 walk 给的路径：`dirs.walk(".")` 的 root 带 `.` 段（拼出来是 `.\src\x.c`）⇒
//   报告里混进前缀，下游对账脚本（lines_check.py）不得不自己 `strip(".\\")` ✗。
//   现在直接用 `dirs.relpath`（2026-10-01 新增）⇒ 与 Python `os.path.relpath` 逐字一致 ✓
func count_file(string path, string root, int gi) {
    // ⚠ `files.read` 失败**抛异常**、不返回 null（2026-09-30 实测：无 try ⇒ 程序直接终止；
    //   有 try ⇒ 由 catch 接走，消息在 e.msg）⇒ 原来那句 `if content == null` 是**死判断**，
    //   一旦有文件读不了（占用 / 权限 / 路径过长），整轮统计会当场崩掉 ✗。
    //   正确容错只能靠 try：读不了就记一行、跳过，继续统计其余文件 ✓
    string content = ""
    try {
        content = files.read(path)
    } catch e {
        // 不再重复打 path：read 的失败消息自 2026-09-30 起**自带路径**（与 open / write 同口径 ✓）
        print($"  (读不了) {_str(e.msg)}")
        return
    }
    var lines = strings.split(content, "\n")
    int n = lines.len()
    if n > 0 and lines[n - 1] == "" { n -= 1 }    // 结尾换行不算一行 ✓
    print($"  {strings.format("%6d", n) }  {dirs.relpath(path, root)}")
    int b = 0
    for 0 : n - 1 to i {
        if strings.trim(lines[i]) == "" { b += 1 }
    }
    g_cnt[gi] = g_cnt[gi] + 1
    g_tot[gi] = g_tot[gi] + n
    g_blk[gi] = g_blk[gi] + b
}

// 一遍 walk 扫一种扩展名 ⇒ 输出自然按组分好 ✓
func scan(string root, string ext, int gi) {
    var walks = dirs.walk(root)
    for walks to w {
        var fnames = w.files
        for fnames to f {
            if strings.ends_with(f, ext) { count_file(w.root + sep + f, root, gi) }
        }
    }
}

main() {
    var args = _args()
    string root = if args.len() >= 1 then args[0] else "."
    print($"== 行数统计: {root} ==")

    print("\n== .c ==");    scan(root, ".c", 0)
    print("\n== .h ==");    scan(root, ".h", 1)
    print("\n== .leno =="); scan(root, ".leno", 2)

    print("\n== 汇总 ==")
    Array[string] names = [".c    ", ".h    ", ".leno "]
    int tc = 0; int tt = 0
    for 0 : 2 to k {
        print($"{names[k]}: {g_cnt[k]} 文件, {g_tot[k]} 行 (空 {g_blk[k]}, 代码 {g_tot[k] - g_blk[k]})")
        tc = tc + g_cnt[k]; tt = tt + g_tot[k]
    }
    print($"总计  : {tc} 文件, {tt} 行")
}
