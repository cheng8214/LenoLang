// leno-grep  - Leno 实现的 grep 工具
// 用法: leno leno-grep.leno [line] [icase] pattern file [file2...]

import files
import strings

int opt_line_num  = 0
int opt_ignore_case = 0
int match_count   = 0
int file_count    = 0

func matches(string line, string pattern):bool {
    if opt_ignore_case {
        return strings.has(strings.to_lower(line), strings.to_lower(pattern))
    }
    return strings.has(line, pattern)
}

func search(string filepath, string pattern) {
    var content = files.read(filepath)
    if content == null { return }

    var lines = strings.split(content, "\n")
    int found = 0
    int ln = 1
    for lines to line {
        if matches(line, pattern) {
            found = found + 1
            if opt_line_num {
                print(filepath + ":" + ln + ": " + line)
            } else {
                print(filepath + ": " + line)
            }
        }
        ln = ln + 1
    }
    if found > 0 {
        file_count = file_count + 1
        match_count = match_count + found
    }
}

main() {
    var args = _args()
    if args.len() < 1 {
        print("usage: leno leno-grep.leno [line] [icase] pattern file...")
        return
    }

    int i = 0
    while i < args.len() {
        var arg = args[i]
        if arg == "line" { opt_line_num = 1; i = i + 1 }
        else if arg == "icase" { opt_ignore_case = 1; i = i + 1 }
        else { break }
    }

    if i >= args.len() { print("no pattern"); return }
    var pattern = args[i] as string
    i = i + 1
    if i >= args.len() { print("no files"); return }

    while i < args.len() {
        search(args[i] as string, pattern)
        i = i + 1
    }

    if file_count > 1 {
        print("--- " + match_count + " matches in " + file_count + " files")
    }
}
