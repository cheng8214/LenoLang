// 最小复现: defer 引用循环变量

var log = []
func add(string s) { log.add(s) }

print("=== A: defer 引用 i ===")
log = []
for 0:3 to i {
    defer add("defer-" + i)
    add("iter-" + i)
    if i == 1 {
        add("breaking")
        break
    }
}
add("after")
print("  " + log)

print("\n=== B: defer 不引用 i ===")
log = []
for 0:3 to i {
    defer add("defer")
    add("iter-" + i)
    if i == 1 {
        add("breaking")
        break
    }
}
add("after")
print("  " + log)

print("\n=== C: defer 引用 i, 无 break ===")
log = []
for 0:2 to i {
    defer add("defer-" + i)
    add("iter-" + i)
}
add("after")
print("  " + log)

print("\n=== D: defer 引用 i, 无 if ===")
log = []
for 0:3 to i {
    defer add("defer-" + i)
    add("iter-" + i)
    break
}
add("after")
print("  " + log)
