// 测试3: 数组索引类型不匹配 + 参数类型不匹配
// 期望错误:
//   第9行第5列: add("hello", 2) 参数类型不匹配 (add 从第5列开始)
//   第13行第5列: add(1) 参数不足 (add 从第5列开始)

func add(int a, int b): int {
    return a + b
}

main()
{
    // 第12行: add("hello", 2) 第一个参数类型不匹配，add 从第5列
    add("hello", 2)

    // 第15行: add(1) 参数不足，add 从第5列
    add(1)
}
