// 最小复现

var log = []
func add(string s) { log.add(s) }

print("=== 1: defer + if+break (无 add 在 body) ===")
log = []
for 0:3 to i {
    defer add("defer")
    if i == 1 { add("breaking"); break }
}
add("after")
print("  " + log)

print("\n=== 2: defer + if+break (多行, 无 add 在 body) ===")
log = []
for 0:3 to i {
    defer add("defer")
    if i == 1 {
        add("breaking")
        break
    }
}
add("after")
print("  " + log)

print("\n=== 3: defer + add + if+break (分号) ===")
log = []
for 0:3 to i {
    defer add("defer")
    add("iter")
    if i == 1 { add("breaking"); break }
}
add("after")
print("  " + log)

print("\n=== 4: defer + add + if+break (多行) ===")
log = []
for 0:3 to i {
    defer add("defer")
    add("iter")
    if i == 1 {
        add("breaking")
        break
    }
}
add("after")
print("  " + log)
