// 复杂中文标识符测试

// 测试1: 中文结构体
struct 点 {
    int x坐标
    int y坐标

    func 移动(int dx, int dy) {
        x坐标 = x坐标 + dx
        y坐标 = y坐标 + dy
    }

    func 到原点距离() {
        return x坐标 * x坐标 + y坐标 * y坐标
    }
}

// 测试2: 中文枚举
enum 颜色 {
    红色
    绿色
    蓝色
}

// 测试3: 中文类（带方法的struct）
struct 银行账户 {
    string 户名
    int 余额

    func 存款(int 金额) {
        余额 = 余额 + 金额
        return 余额
    }

    func 取款(int 金额) {
        if 金额 > 余额 {
            throw "余额不足"
        }
        余额 = 余额 - 金额
        return 余额
    }

    func 查询余额() {
        return 余额
    }
}

// 测试4: 中文数组和字典操作
func 测试集合() {
    var 数字列表 = [1, 2, 3, 4, 5]
    var 学生成绩 = {"张三": 90, "李四": 85, "王五": 88}

    int 总和 = 0
    for 数字列表 to 数 {
        总和 = 总和 + 数
    }

    return 总和
}

// 测试5: 中文递归函数
func 阶乘(int 数) {
    if 数 <= 1 {
        return 1
    }
    return 数 * 阶乘(数 - 1)
}

main() {
    print("=== 复杂中文标识符测试 ===")

    // 测试结构体
    var p = 点(x坐标=3, y坐标=4)
    print("点坐标: (" + p.x坐标 + ", " + p.y坐标 + ")")
    p.移动(1, 1)
    print("移动后: (" + p.x坐标 + ", " + p.y坐标 + ")")

    // 测试枚举
    var 我的颜色 = 颜色.红色
    print("颜色值: " + 我的颜色)

    // 测试银行账户
    var 账户 = 银行账户(户名="张三", 余额=1000)
    print("初始余额: " + 账户.查询余额())
    账户.存款(500)
    print("存款后: " + 账户.查询余额())
    账户.取款(200)
    print("取款后: " + 账户.查询余额())

    // 测试集合
    print("数字总和: " + 测试集合())

    // 测试递归
    print("5的阶乘: " + 阶乘(5))

    print("=== 测试完成 ===")
}
