// 测试中文变量名和函数名

func 打招呼(any 名字) {
    return "你好，" + 名字 + "！"
}

func 计算面积(any 长, any 宽) {
    return 长 * 宽
}

main() {
    var 姓名 = "世界"
    var 长度 = 10
    var 宽度 = 5
    
    print(打招呼(姓名))
    print("面积: " + 计算面积(长度, 宽度))
    
    // 测试中文变量赋值
    var 计数器 = 0
    计数器 = 计数器 + 1
    print("计数器: " + 计数器)
}
