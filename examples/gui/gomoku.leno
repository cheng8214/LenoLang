import guis
import maths

main() {
    Style[window] w_style = {
        width: 800,
        height: 900,
        resizable: true
    }
    Win win = guis.create_window("Gomoku", w_style)

    var font_title = guis.load_font("SimSun", 28)
    var font_info = guis.load_font("SimSun", 18)

    var board_size = 15
    var cell = 40
    var board_x = 50
    var board_y = 80
    var board_w = (board_size - 1) * cell
    var board_h = (board_size - 1) * cell

    var board = []
    for board_size to r {
        var row = []
        for board_size to c {
            row.add(0)
        }
        board.add(row)
    }

    var current_player = 1
    var game_over = false
    var winner = 0
    var last_move_r = -1
    var last_move_c = -1
    var ai_player = 2
    var human_player = 1
    var ai_thinking = false

    func check_win(int br, int bc) {
        var player = board[br][bc]
        if player == 0 {
            return false
        }

        var directions = [
            [0, 1],
            [1, 0],
            [1, 1],
            [1, -1]
        ]

        for directions to d {
            var dr = d[0]
            var dc = d[1]
            var count = 1

            var r = br + dr
            var c = bc + dc
            while r >= 0 and r < board_size and c >= 0 and c < board_size and board[r][c] == player {
                count = count + 1
                r = r + dr
                c = c + dc
            }

            r = br - dr
            c = bc - dc
            while r >= 0 and r < board_size and c >= 0 and c < board_size and board[r][c] == player {
                count = count + 1
                r = r - dr
                c = c - dc
            }

            if count >= 5 {
                return true
            }
        }

        return false
    }

    func reset_game() {
        for board_size to r {
            for board_size to c {
                board[r][c] = 0
            }
        }
        current_player = 1
        game_over = false
        winner = 0
        last_move_r = -1
        last_move_c = -1
        ai_thinking = false
    }

    func evaluate_line(int r, int c, int dr, int dc, int player):int {
        var score = 0
        var count = 1  // 包含当前要下的位置
        var empty_ends = 0

        // 正向搜索
        var rr = r + dr
        var cc = c + dc
        while rr >= 0 and rr < board_size and cc >= 0 and cc < board_size and board[rr][cc] == player {
            count = count + 1
            rr = rr + dr
            cc = cc + dc
        }
        // 检查正向末端是否为空
        if rr >= 0 and rr < board_size and cc >= 0 and cc < board_size and board[rr][cc] == 0 {
            empty_ends = empty_ends + 1
        }

        // 反向搜索
        rr = r - dr
        cc = c - dc
        while rr >= 0 and rr < board_size and cc >= 0 and cc < board_size and board[rr][cc] == player {
            count = count + 1
            rr = rr - dr
            cc = cc - dc
        }
        // 检查反向末端是否为空
        if rr >= 0 and rr < board_size and cc >= 0 and cc < board_size and board[rr][cc] == 0 {
            empty_ends = empty_ends + 1
        }

        // 评分：count 包含当前位置，所以 count=5 就是五连（获胜）
        if count >= 5 {
            score = 1000000  // 直接获胜
        } else if count == 4 {
            if empty_ends == 2 {
                score = 500000   // 活四 - 下这里就赢
            } else if empty_ends == 1 {
                score = 10000    // 冲四
            }
        } else if count == 3 {
            if empty_ends == 2 {
                score = 10000    // 活三 - 很大威胁
            } else if empty_ends == 1 {
                score = 1000     // 冲三
            }
        } else if count == 2 {
            if empty_ends == 2 {
                score = 1000     // 活二
            } else if empty_ends == 1 {
                score = 100      // 冲二
            }
        } else if count == 1 {
            if empty_ends == 2 {
                score = 100      // 活一
            } else if empty_ends == 1 {
                score = 10       // 冲一
            }
        }

        return score
    }

    func evaluate_position(int r, int c, int player):float {
        if board[r][c] != 0 {
            return -1.0
        }

        var directions = [
            [0, 1],
            [1, 0],
            [1, 1],
            [1, -1]
        ]

        var attack_score = 0
        for directions to d {
            attack_score = attack_score + evaluate_line(r, c, d[0], d[1], player)
        }

        int opponent = if player == 1 then 2 else 1
        var defense_score = 0
        for directions to d {
            defense_score = defense_score + evaluate_line(r, c, d[0], d[1], opponent)
        }

        // 防守权重提高到1.2，确保优先拦截对手威胁
        return _float(attack_score) + _float(defense_score) * 1.2
    }

    func ai_move() {
        float best_score = -1.0
        var best_r = -1
        var best_c = -1

        for board_size to r {
            for board_size to c {
                if board[r][c] == 0 {
                    var score = evaluate_position(r, c, ai_player)
                    if score > best_score {
                        best_score = score
                        best_r = r
                        best_c = c
                    }
                }
            }
        }

        if best_r >= 0 and best_c >= 0 {
            board[best_r][best_c] = ai_player
            last_move_r = best_r
            last_move_c = best_c

            if check_win(best_r, best_c) {
                game_over = true
                winner = ai_player
            } else {
                current_player = human_player
            }
        }

        ai_thinking = false
    }

    func do_human_move(int r, int c) {
        if board[r][c] != 0 {
            return
        }

        board[r][c] = human_player
        last_move_r = r
        last_move_c = c

        if check_win(r, c) {
            game_over = true
            winner = human_player
        } else {
            current_player = ai_player
            ai_thinking = true
            ai_move()
        }
    }

    guis.run(win,
        func(Draw ren) {
            ren.set_color(_rgb(30, 30, 46, 255))
            ren.clear()

            ren.set_color(_rgb(255, 255, 255, 255))
            ren.text_font(font_title, "五子棋", 300, 20)

            var margin = 20
            ren.set_color(_rgb(220, 180, 100, 255))
            ren.fill_rect(board_x - margin, board_y - margin, board_w + margin*2, board_h + margin*2)

            ren.set_color(_rgb(240, 210, 140, 255))
            ren.fill_rect(board_x - margin/2, board_y - margin/2, board_w + margin, board_h + margin)

            ren.set_color(_rgb(80, 60, 40, 255))
            for board_size to i {
                var x = board_x + i * cell
                ren.line(x, board_y, x, board_y + board_h)
            }
            for board_size to i {
                var y = board_y + i * cell
                ren.line(board_x, y, board_x + board_w, y)
            }

            var star_points = [[3, 3], [3, 11], [7, 7], [11, 3], [11, 11]]
            for star_points to sp {
                var sx = board_x + sp[1] * cell
                var sy = board_y + sp[0] * cell
                ren.set_color(_rgb(60, 40, 20, 255))
                ren.fill_circle(sx, sy, 4)
            }

            for board_size to r {
                for board_size to c {
                    var cx = board_x + c * cell
                    var cy = board_y + r * cell

                    if board[r][c] == 1 {
                        ren.set_color(_rgb(30, 30, 30, 255))
                        ren.fill_circle(cx, cy, 16)
                        ren.set_color(_rgb(60, 60, 60, 255))
                        ren.circle(cx, cy, 16)
                    } else if board[r][c] == 2 {
                        ren.set_color(_rgb(240, 240, 240, 255))
                        ren.fill_circle(cx, cy, 16)
                        ren.set_color(_rgb(180, 180, 180, 255))
                        ren.circle(cx, cy, 16)
                    }

                    if r == last_move_r and c == last_move_c {
                        ren.set_color(_rgb(255, 0, 0, 255))
                        ren.rect(cx - 18, cy - 18, 36, 36)
                    }
                }
            }

            ren.set_color(_rgb(200, 200, 200, 255))
            if game_over {
                if winner == human_player {
                    ren.text_font(font_info, "你赢了! 按 R 重新开始", 240, 720)
                } else {
                    ren.text_font(font_info, "AI获胜! 按 R 重新开始", 240, 720)
                }
            } else {
                if ai_thinking {
                    ren.text_font(font_info, "AI 思考中...", 280, 720)
                } else {
                    ren.text_font(font_info, "当前: 你的回合", 270, 720)
                }
            }

            ren.set_color(_rgb(150, 150, 150, 255))
            ren.text_font(font_info, "ESC 退出  |  R 重新开始", 240, 740)

            ren.present()
        },
        func(Event e) {
            if e.is_quit() or e.is_window_close() {
                win.set_should_close(true)
            }
            if e.is_key_down() {
                var key = e.key()
                if key == 0x1B {
                    win.set_should_close(true)
                }
                if key == 0x52 or key == 0x72 {
                    reset_game()
                }
            }
            if e.is_mouse_down() and not game_over and not ai_thinking and current_player == human_player {
                int mx = e.mouse_x()
                int my = e.mouse_y()
                int c = _int(maths.round(_float(mx - board_x) / cell))
                int r = _int(maths.round(_float(my - board_y) / cell))

                if c < 0 { c = 0 }
                if c >= board_size { c = board_size - 1 }
                if r < 0 { r = 0 }
                if r >= board_size { r = board_size - 1 }

                do_human_move(r, c)
            }
        }
    )

    guis.destroy_font(font_title)
    guis.destroy_font(font_info)
    win.close()
}
