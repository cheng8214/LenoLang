import guis as gui

main() {
    var win = gui.create_window("标题", 800, 600, 1)
    
    func Draw1(Draw ren)
    {
            // onDraw: 每帧调用，ren 是自动创建的渲染器
             ren.set_color(_rgb( 30, 30, 46, 255))
             ren.clear()
             ren.set_color(_rgb( 255, 0, 0, 255))
             ren.fill_rect(100, 100, 200, 150)
             ren.present()
     }
    func Event1(Event event) 
    {
            // onEvent: 每个事件调用
            if event.is_window_close() or event.is_key_down()
            {
                gui.set_should_close(win, true)
            }
    }
    gui.run(win,Draw1,Event1)
   
    
     gui.cleanup(win)
}
