import guis

main() {
    Win win = guis.create_window("LenoC GUI - Font Test", 800, 600, 1)

    var font_arial = guis.load_font("Arial", 24)
    var font_consolas = guis.load_font("Consolas", 18)
    var font_simhei = guis.load_font("SimHei", 28)
    var font_yahei = guis.load_font("Microsoft YaHei", 20)

    guis.run(win,
        func(Draw ren) {
            ren.set_color(_rgb(30, 30, 46, 255))
            ren.clear()

            ren.set_color(_rgb(255, 255, 255, 255))
            ren.text("Built-in 8x8 Font:", 30, 20, 2)
            ren.text("Hello, LenoC GUI!", 30, 50, 2)

            ren.set_color(_rgb(100, 255, 100, 255))
            ren.text_font(font_arial, "Arial 24px - System Font", 30, 100)

            ren.set_color(_rgb(100, 200, 255, 255))
            ren.text_font(font_consolas, "Consolas 18px - Monospace", 30, 140)

            ren.set_color(_rgb(255, 200, 100, 255))
            ren.text_font(font_simhei, "SimHei 28px - 黑体中文测试", 30, 180)

            ren.set_color(_rgb(200, 150, 255, 255))
            ren.text_font(font_yahei, "Microsoft YaHei 20px - 微软雅黑", 30, 230)

            ren.set_color(_rgb(255, 100, 100, 255))
            ren.text_font(font_arial, "ABCDEFGHIJKLMNOPQRSTUVWXYZ", 30, 280)
            ren.text_font(font_consolas, "0123456789 !@#$%^&*()", 30, 310)

            ren.set_color(_rgb(150, 150, 150, 255))
            ren.text("Press ESC to quit", 30, 560, 2)

            ren.present()
        },
        func(Event e) {
            if e.is_quit() or e.is_window_close() {
                guis.set_should_close(win, true)
            }
            if e.is_key_down() and e.key() == 0x1B {
                guis.set_should_close(win, true)
            }
        }
    )

    guis.destroy_font(font_arial)
    guis.destroy_font(font_consolas)
    guis.destroy_font(font_simhei)
    guis.destroy_font(font_yahei)
    guis.cleanup(win)
    print("font test done!")
}
