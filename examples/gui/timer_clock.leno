import guis
import times

main() {
    guis.init()
    Win win = guis.create_window("LenoC Timer & Clock", 800, 600, 1)

    var elapsed = 0
    var start_ms = times.ms()

    var tid = guis.add_timer(100, func(int id, int interval) {
        elapsed = times.ms() - start_ms
        return interval
    })

    guis.run(win,
        func(Draw ren) {
            ren.set_draw_color(30, 30, 46, 255)
            ren.clear()

            ren.set_draw_color(255, 255, 255, 255)
            ren.draw_text("Timer & Clock Demo", 50, 30, 3)

            var total_sec = elapsed / 1000
            var min = total_sec / 60
            var sec = total_sec % 60
            var ms = elapsed % 1000

            ren.set_draw_color(100, 255, 100, 255)
            ren.draw_text("Elapsed: " + _str(min) + "m " + sec + "s " +ms + "ms", 50, 100, 2)

            var now = times.now()
            var time_str = times.format(now, "%H:%M:%S")
            var date_str = times.format(now, "%Y-%m-%d")

            ren.set_draw_color(255, 200, 100, 255)
            ren.draw_text("Clock: " + time_str, 50, 160, 3)

            ren.set_draw_color(150, 150, 200, 255)
            ren.draw_text("Date:  " + date_str, 50, 210, 2)

            ren.set_draw_color(100, 150, 255, 255)
            ren.draw_text("times.ms()  = " + times.ms(), 50, 280, 2)

            ren.set_draw_color(180, 100, 255, 255)
            ren.draw_text("Press ESC to quit", 50, 350, 2)

            ren.present()
        },
        func(Event e) {
            if e.is_quit() or e.is_window_close() {
                guis.set_window_should_close(win, true)
            }
            if e.is_key_down() and e.key() == 0x1B {
                guis.set_window_should_close(win, true)
            }
        }
    )

    guis.cleanup(win)
    print("timer clock done!")
}
