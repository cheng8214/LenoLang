// 测试 e.stack 和 e.file 属性

func inner() {
    // 抛出异常
    var a = 1 / 0;
}

func middle() {
    inner();
}

func outer() {
    middle();
}
main()
{
	try {
	    outer();
	} catch e {
	    print("===== 异常信息 =====");
	    print("msg: " + e.msg);
	    print("file: " + e.file);
	    print("stack: " + e.stack);
	}
}