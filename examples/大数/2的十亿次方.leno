// 2 的十亿次方（2026-11-22）
//
// 结论（本机实测）：
//   · **计算** 2^1e9 几乎免费 —— `1 << 1000000000` 约 **0.2 秒**（bigint 精确移位）
//   · 结果有 **301,029,996 位十进制**（≈301MB 文本）
//   · **打印 3 亿位仍不可行**：bigint→十进制 2026-11-22 已改成**分治 + Knuth-D 除法**
//     （次平方）：30 万位 1.4s → **0.45s**、300 万位从"跑不完（>120s）" → **35s**；
//     但 3 亿位按这个趋势仍要**小时级**。所以下面只做"精确性校验"，位数用公式算
//     （并用小规模实测交叉验证公式本身）。
//   · 顺带：**乘法**已加 Karatsuba（同日），200 万比特 ×4 从 11.6s → 0.8s。
//
// ⚠ 顺带一个坑：`maths.pow(2, N)` 走 double，`N > 1023` 就是 `inf` —— 要精确大数必须用
//   bigint（`1 << N` 或逐步乘 2），不能指望 `maths.pow`。

func digits_of_pow2(int n): int {
    // 2^n 的十进制位数 = floor(n*log10(2)) + 1
    return _int(_float(n) * 0.30102999566398120) + 1
}

main() {
    var n = 1000000000

    print("计算 2^1000000000 = 1 << 1000000000 ...\n")
    var p = 1 << n

    // 三条互相独立的精确性校验（都比"打印出来看"便宜得多）
    print("① 回移一位还原        : " + _str((p >> n) == 1) + "\n")
    print("② 等于 (1<<(n-1))*2   : " + _str(p == ((1 << (n - 1)) * 2)) + "\n")
    print("③ 等于 (p/2)*2        : " + _str((p / 2) * 2 == p) + "\n")

    print("④ 十进制位数（公式）   : " + _str(digits_of_pow2(n)) + "\n")

    // 公式本身要与实测对齐：2^100000 有 30103 位（这里只转 3 万位，很快）
    var small = 1 << 100000
    print("⑤ 2^100000 实测位数    : " + _str(_str(small).len()) +
          "（公式 " + _str(digits_of_pow2(100000)) + "）\n")

    // 手工倍增与移位必须一致（证明"移位"这条路不是近路）
    var byDouble = 1
    for 0 : 99999 to i {
        byDouble = byDouble * 2
    }
    print("⑥ 手工乘 10 万次与移位一致 : " + _str(byDouble == small) + "\n")
}
