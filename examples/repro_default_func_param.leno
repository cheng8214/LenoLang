struct WinB {
    func run(int x, int y) { print("run: x=" + x + " y=" + y) }
    func run2(int x, int y = 0) { print("run2: x=" + x + " y=" + y) }
    func run3(int x, int y = 0, int z = 1) { print("run3: x=" + x + " y=" + y + " z=" + z) }
    func self_call() { self.run2(42) }
}

main() {
    var b = new WinB()
    // 无默认参数
    b.run(1, 2)
    // 一个默认参数
    b.run2(3)
    b.run2(3, 4)
    // 两个默认参数
    b.run3(5)
    b.run3(5, 6)
    b.run3(5, 6, 7)
    // 方法内部调用 self.method()
    b.self_call()
    print("ALL PASSED")
}
