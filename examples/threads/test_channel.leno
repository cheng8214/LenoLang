import threads
import times as ti

// 测试1: 通过参数传递 channel
func producer(any ch) {
    ch.send("hello from thread")
    ch.send(42)
    ch.send(3.14)
    ch.close()
}

// 测试2: 多条消息
func counter(any ch) {
    for 5 to var i {
        ch.send(i)
    }
    ch.close()
}

// 测试3: 数组消息
func array_sender(any ch) {
    ch.send([1, 2, 3, 4, 5])
    ch.close()
}

// 测试4: 字典消息
func dict_sender(any ch) {
    ch.send({name: "Leno", version: 1})
    ch.close()
}

main() {
    // 测试1: 基本发送接收
    print("=== 测试1: 基本发送接收 ===")
    var ch1 = threads.channel(10)
    var t1 = threads.start(producer, ch1)

    var msg1 = ch1.receive()
    print("收到: " + msg1)
    var msg2 = ch1.receive()
    print("收到: " + msg2)
    var msg3 = ch1.receive()
    print("收到: " + msg3)

    t1.join()
    print("测试1完成")

    // 测试2: 多条消息
    print("\n=== 测试2: 多条消息 ===")
    var ch2 = threads.channel(10)
    var t2 = threads.start(counter, ch2)

    for 5 to var i {
        var msg = ch2.receive()
        print("收到: " + msg)
    }

    t2.join()
    print("测试2完成")

    // 测试3: 数组消息
    print("\n=== 测试3: 数组消息 ===")
    var ch3 = threads.channel(10)
    var t3 = threads.start(array_sender, ch3)

    var arr = ch3.receive()
    print("收到数组: " + arr)

    t3.join()
    print("测试3完成")

    // 测试4: 字典消息
    print("\n=== 测试4: 字典消息 ===")
    var ch4 = threads.channel(10)
    var t4 = threads.start(dict_sender, ch4)

    var d = ch4.receive()
    print("收到字典: " + d)

    t4.join()
    print("测试4完成")

    // 测试5: 双线程通过 channel 通讯
    print("\n=== 测试5: 双线程通讯 ===")
    var ch5 = threads.channel(10)

    func sender(any ch) {
        for 3 to var i {
            ch.send("消息" + (i + 1))
        }
        ch.send("结束")
        ch.close()
    }

    func receiver(any ch) {
        while true {
            var msg = ch.receive()
            print("接收: " + msg)
            if msg == "结束" {
                break
            }
        }
    }

    var ts = threads.start(sender, ch5)
    var tr = threads.start(receiver, ch5)
    ts.join()
    tr.join()
    print("测试5完成")

    print("\n===== 所有通讯测试完成 =====")
}
