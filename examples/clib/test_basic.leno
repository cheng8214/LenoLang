import ffi
import io

clib msvcrt {
    // ⚠ 2026-09-28 修示例：clib 形参**不能用 `string`**（编译器明确要求 `str8` / `ptr`）——
    //   原文写 `string s` ⇒ 报「clib 函数 'strlen' 参数 1 类型不能使用 'string'，请使用 'str8' 或 'ptr'」。
    //   字面量可以隐式转 `str8`，与 examples/clib/test_call_simple.leno 的写法一致。
    i32 strlen(str8 s)
}

main() {
    msvcrt lib = ffi.load("msvcrt.dll")
    lib.strlen("hello")
    io.print("done")
}
