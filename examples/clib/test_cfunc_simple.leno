// 测试 cfunc 回调（不调 qsort，避免 GC 问题）
import ffi

cfunc Compare(Ptr a, Ptr b): i32
cfunc EnumWindowsProc(Ptr hwnd, Ptr lParam): i32

func my_compare(Ptr a, Ptr b): int {
    int va = ffi.read_int(a, 0)
    int vb = ffi.read_int(b, 0)
    if va < vb { return -1 }
    if va > vb { return 1 }
    return 0
}

main() {
    // 测试1: 创建 cfunc 回调
    var cb1 = ffi.callback(my_compare, Compare)
    print("Compare callback: " + (cb1 != null))

    // 测试2: 创建另一个 cfunc 回调
    var cb2 = ffi.callback(my_compare, EnumWindowsProc)
    print("EnumWindowsProc callback: " + (cb2 != null))

    print("cfunc callback test done")
}
