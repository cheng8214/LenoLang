import ffi
import io

// 测试 clib FFI 调用 - 多函数
clib msvcrt {
    i32 strlen(str8 s)
    i32 printf(str8 fmt)
    Ptr malloc(i32 size)
    void free(Ptr ptr)
}

main() {
    msvcrt libc = ffi.load(if _os() == "windows" then "msvcrt.dll" else "libc.so.6")
    var len = libc.strlen("hello")
    io.print("hello length: ")
    io.print(len)
}
