// 测试 clib 支持 cstruct 参数 — cstruct 名作为参数类型，自动传指针
import ffi

cstruct POINT {
    i32 x
    i32 y
}

cstruct RECT {
    i32 left
    i32 top
    i32 right
    i32 bottom
}

clib user32 {
    i32 GetCursorPos(POINT lpPoint)
    i32 GetWindowRect(Ptr hWnd, RECT lpRect)
    i32 SetCursorPos(i32 x, i32 y)
}

main() {
    user32 lib = ffi.load("user32.dll")

    // 测试 1: GetCursorPos — cstruct POINT 作为参数，自动传指针
    POINT pt = POINT.malloc()
    int ok1 = lib.GetCursorPos(pt)
    if ok1 != 0 {
        print("  PASS: GetCursorPos 成功, x=" + pt.x + " y=" + pt.y)
    } else {
        print("  FAIL: GetCursorPos 返回 0")
    }

    // 测试 2: GetWindowRect — cstruct RECT 作为参数
    RECT rc = RECT.malloc()
    int ok2 = lib.GetWindowRect(null, rc)
    if ok2 == 0 {
        print("  PASS: GetWindowRect(null) 安全失败（预期行为）")
    } else {
        print("  NOTE: GetWindowRect 成功, left=" + rc.left)
    }

    // 测试 3: SetCursorPos — 普通 i32 参数不受影响
    int ok3 = lib.SetCursorPos(pt.x, pt.y)
    if ok3 != 0 {
        print("  PASS: SetCursorPos 成功")
    } else {
        print("  NOTE: SetCursorPos 失败（可能权限不足）")
    }

    // 测试 4: 也可以手动传 Ptr（兼容旧写法）
    Ptr pt_ptr = pt.to_ptr()
    int ok4 = lib.GetCursorPos(pt_ptr)
    if ok4 != 0 {
        print("  PASS: 手动 to_ptr() 仍然可用")
    } else {
        print("  FAIL: 手动 to_ptr() 调用失败")
    }

    pt.free()
    rc.free()
    print("clib cstruct 参数测试完成")
}
