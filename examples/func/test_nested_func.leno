// 测试嵌套函数（命名函数返回）

func make_counter(any start) {
    var count = start
    
    func increment() {
        count = count + 1
        return count
    }
    
    return increment
}

func make_adder(any base) {
    func add(any x) {
        return base + x
    }
    return add
}

main() {
    print("=== 嵌套函数测试 ===")
    
    // 测试1: 计数器
    var counter = make_counter(10)
    print("Counter1: " + counter())
    print("Counter2: " + counter())
    print("Counter3: " + counter())
    
    // 测试2: 加法器
    var add5 = make_adder(5)
    print("Add5 to 10: " + add5(10))
    print("Add5 to 20: " + add5(20))
    
    print("=== 测试完成 ===")
}
