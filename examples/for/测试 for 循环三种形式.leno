// 测试 for 循环三种形式
main() {
    print("=== for 循环测试 ===\n")

    // 测试1: for 3 → 迭代 0, 1, 2
    print("1. for 3 (预期: 0, 1, 2):")
    var results1 = []
    for 3 to var i {
        results1.add(i)
    }
    print("  结果: " + results1)

    // 测试2: for 0:3 → 迭代 0, 1, 2, 3（闭区间）
    print("\n2. for 0:3 (预期: 0, 1, 2, 3):")
    var results2 = []
    for 0:3 to var i {
        results2.add(i)
    }
    print("  结果: " + results2)

    // 测试3: for 1:3 → 迭代 1, 2, 3（闭区间）
    print("\n3. for 1:3 (预期: 1, 2, 3):")
    var results3 = []
    for 1:3 to var i {
        results3.add(i)
    }
    print("  结果: " + results3)

    // 测试4: for 1:5 → 迭代 1, 2, 3, 4, 5（闭区间）
    print("\n4. for 1:5 (预期: 1, 2, 3, 4, 5):")
    var results4 = []
    for 1:5 to var i {
        results4.add(i)
    }
    print("  结果: " + results4)


}