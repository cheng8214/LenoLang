// 测试 defer 管理 FFI 内存分配/释放
// defer 只支持单表达式，多步清理用辅助函数包装

import ffi

var order = []

func free1(any p) { ffi.free(p); order.add("buf1") }
func free2(any p) { ffi.free(p); order.add("buf2") }
func free3(any p) { ffi.free(p); order.add("buf3") }

var cleaned = false
func markClean() { cleaned = true }

main() {
    print("=== 测试1: defer 确定性释放 FFI 内存 ===")
    {
        var buf = ffi.malloc(64)
        ffi.write_int(buf, 0, 42)
        assert_eq(ffi.sizeof(buf), 64)
        assert_eq(ffi.read_int(buf, 0), 42)
        defer ffi.free(buf)
    }
    print("  [PASS] defer 在作用域退出时释放了内存")

    print("\n=== 测试2: defer 在异常路径释放 FFI 内存 ===")
    cleaned = false
    try {
        var buf = ffi.malloc(32)
        defer ffi.free(buf)
        defer markClean()
        throw "模拟异常"
    } catch e {
        print("  捕获异常: " + e)
    }
    assert_eq(cleaned, true)
    print("  [PASS] defer 在异常时也释放了内存")

    print("\n=== 测试3: 不用 defer，依赖 GC 兜底回收 ===")
    {
        var b3 = ffi.malloc(48)
        ffi.write_int(b3, 0, 99)
        assert_eq(ffi.read_int(b3, 0), 99)
        // 不调用 ffi.free，GC 会在回收 ObjFFIPointer 时自动释放
    }
    print("  [PASS] 未手动释放，GC 将兜底回收（owned && !freed）")

    print("\n=== 测试4: 多次 defer FFI 释放（逆序） ===")
    order = []
    {
        var buf1 = ffi.malloc(16)
        var buf2 = ffi.malloc(16)
        var buf3 = ffi.malloc(16)
        defer free1(buf1)
        defer free2(buf2)
        defer free3(buf3)
    }
    assert_eq(order[0], "buf3")
    assert_eq(order[1], "buf2")
    assert_eq(order[2], "buf1")
    print("  [PASS] defer 逆序释放: " + order)

    print("\n=== 测试5: defer + ffi.alloc 类型化分配 ===")
    {
        var p = ffi.alloc("int", 12345)
        assert_eq(ffi.read_int(p, 0), 12345)
        defer ffi.free(p)
    }
    print("  [PASS] defer 释放 ffi.alloc 分配的内存")

    print("\n=== 测试6: 循环中 defer FFI 释放（无泄漏） ===")
    for 0:100 to i {
        var b = ffi.malloc(256)
        ffi.write_int(b, 0, i)
        defer ffi.free(b)
    }
    print("  [PASS] 100 次循环中 defer 全部释放")

    print("\n=== 测试7: defer 释放后 GC 不会重复释放（双安全） ===")
    {
        var b2 = ffi.malloc(32)
        defer ffi.free(b2)
        // ffi.free 设置 freed=1
        // GC 回收时 ffi_pointer_free_resources 检查 !freed，跳过
    }
    print("  [PASS] defer 释放 + GC 检查 freed 标志，无 double-free")

    print("\n=== 结论 ===")
    print("defer 能胜任 FFI 内存管理:")
    print("  1. 确定性释放: 作用域退出即释放，不等 GC")
    print("  2. 异常安全: 异常路径也执行 defer")
    print("  3. 逆序释放: 多个 defer 按注册逆序执行")
    print("  4. GC 兜底: 忘记 defer/free 时 GC 自动回收")
    print("  5. 双安全: defer 释放后 GC 不会重复释放")
}
