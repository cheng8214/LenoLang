// Base64 编码/解码 —— 纯 LenoC 实现
// 展示 LenoC 的位运算、字符串操作能力

import strings

// Base64 编码表
var ENCODE_TABLE = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

// 位掩码常量
int MASK_3F = 0x3F
int MASK_FF = 0xFF

// 从编码表取一个字符（0-based 索引）
// 用 byte() + strings.char() 避免 slice 分配新字符串
func table_char(int index):string {
    return strings.char(ENCODE_TABLE.byte(index))
}

// 合法 Base64 字符集合（用 byte 值作 int 键，O(1) 数组查找）
func build_valid_set():Dict[int, int] {
    Dict[int, int] s = {}
    for 0:63 to i {
        s[ENCODE_TABLE.byte(i)] = 1
    }
    s[61] = 1  // '=' 的 ASCII 值
    return s
}

var VALID_SET = build_valid_set()

// Base64 解码表（byte 值 -> 6 位索引，int 键 O(1) 数组查找）
func build_decode_table():Dict[int, int] {
    Dict[int, int] table = {}
    for 0:63 to i {
        table[ENCODE_TABLE.byte(i)] = i
    }
    return table
}

var DECODE_TABLE = build_decode_table()

// 检查字符串是否为合法的 Base64 字符
func is_valid_base64(string input):bool {
    int len = input.byte_len()
    for len to i {
        if (not VALID_SET.has(input.byte(i))) {
            return false
        }
    }
    return true
}

// Base64 编码
func base64_encode(string input):string {
    var result = ""
    int i = 0
    int len = input.byte_len()

    // 每次处理 3 个字节
    while i + 2 < len {
        // byte() 是 0-based 索引
        int b0 = input.byte(i)
        int b1 = input.byte(i + 1)
        int b2 = input.byte(i + 2)

        // 拼成 24 位
        int n = (b0 << 16) | (b1 << 8) | b2

        // 拆成 4 个 6 位单元，查表
        result += table_char((n >> 18) & MASK_3F)
        result += table_char((n >> 12) & MASK_3F)
        result += table_char((n >> 6) & MASK_3F)
        result += table_char(n & MASK_3F)

        i = i + 3
    }

    // 处理剩余字节
    int remain = len - i
    if (remain == 1) {
        int b0 = input.byte(i)
        int n = b0 << 16
        result += table_char((n >> 18) & MASK_3F)
        result += table_char((n >> 12) & MASK_3F)
        result += "=="
    } else if (remain == 2) {
        int b0 = input.byte(i)
        int b1 = input.byte(i + 1)
        int n = (b0 << 16) | (b1 << 8)
        result += table_char((n >> 18) & MASK_3F)
        result += table_char((n >> 12) & MASK_3F)
        result += table_char((n >> 6) & MASK_3F)
        result += "="
    }

    return result
}

// Base64 解码
func base64_decode(string input):string {
    var result = ""
    int len = input.byte_len()

    if (not is_valid_base64(input)) {
        throw "Invalid Base64 input"
    }

    // 检查 padding（'=' 的 ASCII 码是 61）
    int pad = 0
    if (len > 0 and input.byte(len - 1) == 61) {
        pad = 1
        if (len > 1 and input.byte(len - 2) == 61) {
            pad = 2
        }
    }

    int valid_len = len - pad

    int i = 0
    while (i + 4 <= valid_len) {
        int c0 = DECODE_TABLE[input.byte(i)]
        int c1 = DECODE_TABLE[input.byte(i + 1)]
        int c2 = DECODE_TABLE[input.byte(i + 2)]
        int c3 = DECODE_TABLE[input.byte(i + 3)]

        int n = (c0 << 18) | (c1 << 12) | (c2 << 6) | c3

        result += strings.char((n >> 16) & MASK_FF)
        result += strings.char((n >> 8) & MASK_FF)
        result += strings.char(n & MASK_FF)

        i = i + 4
    }

    // 处理带 padding 的尾部
    if (pad == 1) {
        int c0 = DECODE_TABLE[input.byte(i)]
        int c1 = DECODE_TABLE[input.byte(i + 1)]
        int c2 = DECODE_TABLE[input.byte(i + 2)]

        int n = (c0 << 18) | (c1 << 12) | (c2 << 6)

        result += strings.char((n >> 16) & MASK_FF)
        result += strings.char((n >> 8) & MASK_FF)
    } else if (pad == 2) {
        int c0 = DECODE_TABLE[input.byte(i)]
        int c1 = DECODE_TABLE[input.byte(i + 1)]

        int n = (c0 << 18) | (c1 << 12)

        result += strings.char((n >> 16) & MASK_FF)
    }

    return result
}

// 获取 Base64 字符对应的 6 位值
func base64_char_value(string ch):int {
    int b = ch.byte(0)
    if (DECODE_TABLE.has(b)) {
        return DECODE_TABLE[b]
    }
    throw "Invalid Base64 character: " + ch
}

// ==================== 测试 ====================

main() {
    print("=== Base64 编码/解码测试 ===")
    print("")

    // 测试 1：标准测试向量
    var tests = ["", "f", "fo", "foo", "foob", "fooba", "foobar"]
    var expected = ["", "Zg==", "Zm8=", "Zm9v", "Zm9vYg==", "Zm9vYmE=", "Zm9vYmFy"]

    int pass = 0
    int i = 0
    while (i < tests.len()) {
        var encoded = base64_encode(tests[i])
        var decoded = base64_decode(encoded)

        int ok = 1
        if (encoded != expected[i]) {
            ok = 0
        }
        if (decoded != tests[i]) {
            ok = 0
        }

        if (ok == 1) {
            pass += 1
        } else {
            print("FAIL: input=" + tests[i])
            print("  encode: got " + encoded + ", expect " + expected[i])
            print("  decode: got " + decoded + ", expect " + tests[i])
        }

        i += 1
    }

    print("标准测试: " + _str(pass) + "/" + _str(tests.len()) + " 通过")
    print("")

    // 测试 2：Hello World
    var hello = "Hello, World!"
    var enc = base64_encode(hello)
    var dec = base64_decode(enc)
    print("原文: " + hello)
    print("编码: " + enc)
    print("解码: " + dec)
    print("往返: " + if dec == hello then "OK" else "FAIL")
    print("")

    // 测试 3：中文 UTF-8 字节
    var cn = "你好LenoC"
    var enc_cn = base64_encode(cn)
    var dec_cn = base64_decode(enc_cn)
    print("原文: " + cn)
    print("编码: " + enc_cn)
    print("解码: " + dec_cn)
    print("往返: " + if dec_cn == cn then "OK" else "FAIL")
}
