// 轮常量
Array[int] RCON = [0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80, 0x1b, 0x36]

// ==================== GF(2^8) 运算 ====================

// GF(2^8) 乘法（不可约多项式 x^8 + x^4 + x^3 + x + 1 = 0x11b）
func gf_mul(int a, int b):int {
    a = a & 0xFF
    b = b & 0xFF
    int p = 0
    for 8 {
        if ((b & 1) != 0) { p = p ^ a }
        int hi = a & 0x80
        a = _int32(a << 1) & 0xFF
        if (hi != 0) { a = a ^ 0x1b }
        b = b >> 1
    }
    return p
}

// ==================== AES 核心操作 ====================

// SubBytes：字节替换
func sub_bytes(Array[int] state):Array[int] {
    var result = state.copy()
    for 0:15 to i {
        result[i] = SBOX[state[i]]
    }
    return result
}

// InvSubBytes：逆字节替换
func inv_sub_bytes(Array[int] state):Array[int] {
    var result = state.copy()
    for 0:15 to i {
        result[i] = INV_SBOX[state[i]]
    }
    return result
}

// ShiftRows：行移位（列优先 4x4 矩阵）
// 行0: 不移, 行1: 左移1, 行2: 左移2, 行3: 左移3
func shift_rows(Array[int] state):Array[int] {
    Array[int] s = state.copy()
    // 行1: [1,5,9,13] -> [5,9,13,1]
    s[1], s[5], s[9], s[13] = state[5], state[9], state[13], state[1]
    // 行2: [2,6,10,14] -> [10,14,2,6]
    s[2], s[6], s[10], s[14] = state[10], state[14], state[2], state[6]
    // 行3: [3,7,11,15] -> [15,3,7,11]
    s[3], s[7], s[11], s[15] = state[15], state[3], state[7], state[11]
    return s
}

// InvShiftRows：逆行移位
func inv_shift_rows(Array[int] state):Array[int] {
    Array[int] s = state.copy()
    // 行1: 右移1
    s[1], s[5], s[9], s[13] = state[13], state[1], state[5], state[9]
    // 行2: 右移2
    s[2], s[6], s[10], s[14] = state[10], state[14], state[2], state[6]
    // 行3: 右移3
    s[3], s[7], s[11], s[15] = state[7], state[11], state[15], state[3]
    return s
}

// MixColumns：列混合
func mix_columns(Array[int] state):Array[int] {
    var result = []
    for 0:3 to c {
        int col = c * 4
        int s0 = state[col]
        int s1 = state[col + 1]
        int s2 = state[col + 2]
        int s3 = state[col + 3]
        result.add(gf_mul(2, s0) ^ gf_mul(3, s1) ^ s2 ^ s3)
        result.add(s0 ^ gf_mul(2, s1) ^ gf_mul(3, s2) ^ s3)
        result.add(s0 ^ s1 ^ gf_mul(2, s2) ^ gf_mul(3, s3))
        result.add(gf_mul(3, s0) ^ s1 ^ s2 ^ gf_mul(2, s3))
    }
    return result
}

// InvMixColumns：逆列混合
func inv_mix_columns(Array[int] state):Array[int] {
    var result = []
    for 0:3 to c {
        int col = c * 4
        int s0 = state[col]
        int s1 = state[col + 1]
        int s2 = state[col + 2]
        int s3 = state[col + 3]
        result.add(gf_mul(0x0e, s0) ^ gf_mul(0x0b, s1) ^ gf_mul(0x0d, s2) ^ gf_mul(0x09, s3))
        result.add(gf_mul(0x09, s0) ^ gf_mul(0x0e, s1) ^ gf_mul(0x0b, s2) ^ gf_mul(0x0d, s3))
        result.add(gf_mul(0x0d, s0) ^ gf_mul(0x09, s1) ^ gf_mul(0x0e, s2) ^ gf_mul(0x0b, s3))
        result.add(gf_mul(0x0b, s0) ^ gf_mul(0x0d, s1) ^ gf_mul(0x09, s2) ^ gf_mul(0x0e, s3))
    }
    return result
}

// AddRoundKey：轮密钥加
func add_round_key(Array[int] state, Array[int] round_key):Array[int] {
    var result = state.copy()
    for 0:15 to i {
        result[i] = state[i] ^ round_key[i]
    }
    return result
}

// ==================== 密钥扩展 ====================

// AES-128 密钥扩展：16 字节 -> 176 字节 (11 个轮密钥)
func key_expansion(Array[int] key):Array[int] {
    var w = key.copy()

    int i = 4
    while (i < 44) {
        // 获取前一个字（4 字节）
        int t0 = w[(i - 1) * 4]
        int t1 = w[(i - 1) * 4 + 1]
        int t2 = w[(i - 1) * 4 + 2]
        int t3 = w[(i - 1) * 4 + 3]

        if (i % 4 == 0) {
            // RotWord + SubWord + Rcon
            t0, t1, t2, t3 = SBOX[t1], SBOX[t2], SBOX[t3], SBOX[t0]
            t0 = t0 ^ RCON[i / 4 - 1]
        }

        w.add(w[(i - 4) * 4] ^ t0)
        w.add(w[(i - 4) * 4 + 1] ^ t1)
        w.add(w[(i - 4) * 4 + 2] ^ t2)
        w.add(w[(i - 4) * 4 + 3] ^ t3)
        i = i + 1
    }

    return w
}

// 获取第 r 轮的轮密钥（16 字节），用切片
func get_round_key(Array[int] w, int r):Array[int] {
    return w[r * 16:r * 16 + 15]
}

// ==================== AES 加密/解密 ====================

// AES-128 加密一个 16 字节块
func aes_encrypt_block(Array[int] plaintext, Array[int] key):Array[int] {
    Array[int] w = key_expansion(key)

    // 初始轮密钥加
    Array[int] state = add_round_key(plaintext, get_round_key(w, 0))

    // 第 1-9 轮
    for 1:9 to round {
        state = sub_bytes(state)
        state = shift_rows(state)
        state = mix_columns(state)
        state = add_round_key(state, get_round_key(w, round))
    }

    // 最后一轮（无 MixColumns）
    state = sub_bytes(state)
    state = shift_rows(state)
    state = add_round_key(state, get_round_key(w, 10))

    return state
}

// AES-128 解密一个 16 字节块
func aes_decrypt_block(Array[int] ciphertext, Array[int] key):Array[int] {
    Array[int] w = key_expansion(key)

    // 初始轮密钥加
    Array[int] state = add_round_key(ciphertext, get_round_key(w, 10))

    // 第 9-1 轮
    for 9:1 to round {
        state = inv_shift_rows(state)
        state = inv_sub_bytes(state)
        state = add_round_key(state, get_round_key(w, round))
        state = inv_mix_columns(state)
    }

    // 最后一轮
    state = inv_shift_rows(state)
    state = inv_sub_bytes(state)
    state = add_round_key(state, get_round_key(w, 0))

    return state
}

// ==================== 字符串接口 ====================

// Hex 工具
func byte_to_hex(int b):string {
    b = b & 0xFF
    var hex_chars = "0123456789abcdef"
    return hex_chars.slice((b >> 4) & 0xF, ((b >> 4) & 0xF) + 1) + hex_chars.slice(b & 0xF, (b & 0xF) + 1)
}

func hex_nibble(int b):int {
    if (b >= 48 and b <= 57) { return b - 48 }
    if (b >= 97 and b <= 102) { return b - 87 }
    if (b >= 65 and b <= 70) { return b - 55 }
    return 0
}

func hex_to_bytes(string hex):Array[int] {
    var result = []
    int i = 0
    while (i + 1 < hex.len()) {
        int hi = hex_nibble(hex.byte(i))
        int lo = hex_nibble(hex.byte(i + 1))
        result.add((hi << 4) | lo)
        i = i + 2
    }
    return result
}

func bytes_to_hex(Array[int] bytes):string {
    var result = ""
    for 0:bytes.len() - 1 to i {
        result += byte_to_hex(bytes[i])
    }
    return result
}

// PKCS7 填充
func pkcs7_pad(string data, int block_size):string {
    int pad_len = block_size - (data.len() % block_size)
    var result = data
    for 0:pad_len - 1 to i {
        result += strings.char(pad_len)
    }
    return result
}

func pkcs7_unpad(string data):string {
    if (data.len() == 0) { return data }
    int pad_len = data.byte(data.len() - 1)
    if (pad_len > data.len() or pad_len == 0) { return data }
    // 验证填充
    for 0:pad_len - 1 to i {
        if (data.byte(data.len() - 1 - i) != pad_len) { return data }
    }
    return data.slice(0, data.len() - pad_len)
}

// 字符串转字节块（16 字节）
func str_to_block(string s, int offset):Array[int] {
    var block = []
    for 0:15 to i {
        if (offset + i < s.len()) {
            block.add(s.byte(offset + i))
        } else {
            block.add(0)
        }
    }
    return block
}

// 字节块转字符串
func block_to_str(Array[int] block):string {
    var result = ""
    for 0:block.len() - 1 to i {
        result += strings.char(block[i])
    }
    return result
}

// AES-128 加密字符串（ECB 模式 + PKCS7 填充）
// key: 16 字节密钥字符串
// plaintext: 明文字符串
// 返回 hex 编码的密文
func aes128_encrypt(string key, string plaintext):string {
    // 填充
    var padded = pkcs7_pad(plaintext, 16)

    // 密钥转字节
    Array[int] key_bytes = str_to_block(key, 0)

    var result = ""
    int i = 0
    while (i < padded.len()) {
        Array[int] block = str_to_block(padded, i)
        Array[int] encrypted = aes_encrypt_block(block, key_bytes)
        result += bytes_to_hex(encrypted)
        i = i + 16
    }

    return result
}

// AES-128 解密字符串（ECB 模式 + PKCS7 填充）
// key: 16 字节密钥字符串
// hex_ciphertext: hex 编码的密文
func aes128_decrypt(string key, string hex_ciphertext):string {
    Array[int] key_bytes = str_to_block(key, 0)
    Array[int] ct_bytes = hex_to_bytes(hex_ciphertext)

    var result = ""
    int i = 0
    while (i + 15 < ct_bytes.len()) {
        Array[int] block = ct_bytes[i:i + 15]
        Array[int] decrypted = aes_decrypt_block(block, key_bytes)
        result += block_to_str(decrypted)
        i = i + 16
    }

    return pkcs7_unpad(result)
}

// ==================== 测试 ====================

main() {
    print("=== AES-128 加密算法测试 ===")
    print("")

    // 测试 1：NIST FIPS-197 附录 B 测试向量
    print("--- NIST 测试向量 ---")
    // 明文: 3243f6a8885a308d313198a2e0370734
    // 密钥: 2b7e151628aed2a6abf7158809cf4f3c
    // 密文: 3925841d02dc09fbdc118597196a0b32
    Array[int] nist_key = [0x2b, 0x7e, 0x15, 0x16, 0x28, 0xae, 0xd2, 0xa6, 0xab, 0xf7, 0x15, 0x88, 0x09, 0xcf, 0x4f, 0x3c]
    Array[int] nist_pt = [0x32, 0x43, 0xf6, 0xa8, 0x88, 0x5a, 0x30, 0x8d, 0x31, 0x31, 0x98, 0xa2, 0xe0, 0x37, 0x07, 0x34]
    Array[int] nist_ct = aes_encrypt_block(nist_pt, nist_key)
    print("密文: " + bytes_to_hex(nist_ct))
    print("预期: 3925841d02dc09fbdc118597196a0b32")
    print("验证: " + if bytes_to_hex(nist_ct) == "3925841d02dc09fbdc118597196a0b32" then "OK" else "FAIL")
    print("")

    // 测试 2：块解密往返
    print("--- 块解密往返 ---")
    Array[int] dec_block = aes_decrypt_block(nist_ct, nist_key)
    print("解密: " + bytes_to_hex(dec_block))
    print("往返: " + if bytes_to_hex(dec_block) == "3243f6a8885a308d313198a2e0370734" then "OK" else "FAIL")
    print("")

    // 测试 3：字符串加解密
    print("--- 字符串加解密 ---")
    var aes_key = "0123456789abcdef"
    var aes_pt = "Hello, AES-128!"
    var aes_ct = aes128_encrypt(aes_key, aes_pt)
    var aes_dec = aes128_decrypt(aes_key, aes_ct)
    print("密钥: " + aes_key)
    print("明文: " + aes_pt)
    print("密文: " + aes_ct)
    print("解密: " + aes_dec)
    print("往返: " + if aes_dec == aes_pt then "OK" else "FAIL")
    print("")

    // 测试 4：长文本
    print("--- 长文本 ---")
    var long_pt = "This is a longer message for AES-128 encryption test, more than one block!"
    var long_ct = aes128_encrypt(aes_key, long_pt)
    var long_dec = aes128_decrypt(aes_key, long_ct)
    print("明文长度: " + _str(long_pt.len()))
    print("密文长度: " + _str(long_ct.len()))
    print("往返: " + if long_dec == long_pt then "OK" else "FAIL")
    print("")

    // 测试 5：中文
    print("--- 中文加解密 ---")
    var cn_pt = "你好，AES加密世界！"
    var cn_ct = aes128_encrypt(aes_key, cn_pt)
    var cn_dec = aes128_decrypt(aes_key, cn_ct)
    print("明文: " + cn_pt)
    print("解密: " + cn_dec)
    print("往返: " + if cn_dec == cn_pt then "OK" else "FAIL")
    print("")

    // 测试 6：错误密钥
    print("--- 错误密钥 ---")
    var wrong_key = "fedcba9876543210"
    var wrong_dec = aes128_decrypt(wrong_key, aes128_encrypt(aes_key, "test data"))
    print("非原文: " + if wrong_dec != "test data" then "OK" else "FAIL")

    print("")
    print("=== AES-128 测试完成 ===")
}
