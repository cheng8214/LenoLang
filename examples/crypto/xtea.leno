// XTEA (eXtended TEA) —— 纯 LenoC 实现
// XTEA 是 TEA 的改进版，修复了等价密钥问题，算法更简洁
//
// 与 TEA 的区别：
//   - 相同的 64 位数据块 + 128 位密钥
//   - 同样 32 轮 Feistel 网络
//   - 但轮函数更简单，密钥调度方式不同
//   - 无等价密钥问题

import strings

// ==================== XTEA 核心 ====================

// 黄金比例常数 δ
int DELTA = -0x61C88647

// XTEA 加密一个 64 位块
func xtea_encrypt_block(int v0, int v1, int k0, int k1, int k2, int k3):Array[int] {
    Array[int] key = [k0, k1, k2, k3]
    int sum = 0
    for 32 {
        v0 = _int32(v0 + _int32((_int32(_int32(v1 << 4) ^ _int32(v1 >> 5)) + v1) ^ _int32(sum + key[_int32(sum & 3)])))
        sum = _int32(sum + DELTA)
        v1 = _int32(v1 + _int32((_int32(_int32(v0 << 4) ^ _int32(v0 >> 5)) + v0) ^ _int32(sum + key[_int32(sum >> 11) & 3])))
    }
    return [v0, v1]
}

// XTEA 解密一个 64 位块
func xtea_decrypt_block(int v0, int v1, int k0, int k1, int k2, int k3):Array[int] {
    Array[int] key = [k0, k1, k2, k3]
    // 计算初始 sum = δ * 32
    int sum = 0
    for 32 { sum = _int32(sum + DELTA) }

    for 32 {
        v1 = _int32(v1 - _int32((_int32(_int32(v0 << 4) ^ _int32(v0 >> 5)) + v0) ^ _int32(sum + key[_int32(sum >> 11) & 3])))
        sum = _int32(sum - DELTA)
        v0 = _int32(v0 - _int32((_int32(_int32(v1 << 4) ^ _int32(v1 >> 5)) + v1) ^ _int32(sum + key[_int32(sum & 3)])))
    }
    return [v0, v1]
}

// ==================== 字符串 <-> 块 转换 ====================

func read_be32(string data, int offset):int {
    int b0 = data.byte(offset)
    int b1 = data.byte(offset + 1)
    int b2 = data.byte(offset + 2)
    int b3 = data.byte(offset + 3)
    return _int32((b0 << 24) | (b1 << 16) | (b2 << 8) | b3)
}

func write_be32(int value):string {
    return strings.char(
        _int32(value >> 24) & 0xFF,
        _int32(value >> 16) & 0xFF,
        _int32(value >> 8) & 0xFF,
        _int32(value) & 0xFF
    )
}

// ==================== PKCS7 填充 ====================

func pkcs7_pad(string data):string {
    int pad_len = 8 - (data.len() % 8)
    var padding = ""
    for pad_len to i {
        padding += strings.char(pad_len)
    }
    return data + padding
}

func pkcs7_unpad(string data):string {
    int pad_len = data.byte(data.len() - 1)
    if (pad_len < 1 or pad_len > 8) {
        throw "Invalid PKCS7 padding"
    }
    return data.slice(0, data.len() - pad_len)
}

// ==================== XTEA 字符串加密/解密 ====================

func key_to_subkeys(string key):Array[int] {
    while (key.len() < 16) {
        key += " "
    }
    return [
        read_be32(key, 0),
        read_be32(key, 4),
        read_be32(key, 8),
        read_be32(key, 12)
    ]
}

// XTEA ECB 模式加密
func xtea_encrypt(string key, string plaintext):string {
    var padded = pkcs7_pad(plaintext)
    Array[int] subkeys = key_to_subkeys(key)

    var result = ""
    int i = 0
    while (i + 7 < padded.len()) {
        int v0 = read_be32(padded, i)
        int v1 = read_be32(padded, i + 4)

        Array[int] encrypted = xtea_encrypt_block(v0, v1, subkeys[0], subkeys[1], subkeys[2], subkeys[3])

        result += write_be32(encrypted[0])
        result += write_be32(encrypted[1])
        i += 8
    }

    return result
}

// XTEA ECB 模式解密
func xtea_decrypt(string key, string ciphertext):string {
    Array[int] subkeys = key_to_subkeys(key)

    var result = ""
    int i = 0
    while (i + 7 < ciphertext.len()) {
        int v0 = read_be32(ciphertext, i)
        int v1 = read_be32(ciphertext, i + 4)

        Array[int] decrypted = xtea_decrypt_block(v0, v1, subkeys[0], subkeys[1], subkeys[2], subkeys[3])

        result += write_be32(decrypted[0])
        result += write_be32(decrypted[1])
        i += 8
    }

    return pkcs7_unpad(result)
}

// ==================== Hex 工具 ====================

func byte_to_hex(int b):string {
    b = b & 0xFF
    var hex_chars = "0123456789abcdef"
    return hex_chars.slice((b >> 4) & 0xF, ((b >> 4) & 0xF) + 1) + hex_chars.slice(b & 0xF, (b & 0xF) + 1)
}

func to_hex(string input):string {
    var result = ""
    for 0:input.len() - 1 to i {
        result += byte_to_hex(input.byte(i))
    }
    return result
}

func hex_char_val(int b):int {
    if (b >= 48 and b <= 57) { return b - 48 }
    if (b >= 97 and b <= 102) { return b - 87 }
    if (b >= 65 and b <= 70) { return b - 55 }
    throw "Invalid hex character"
}

func from_hex(string hex_str):string {
    var result = ""
    int i = 0
    while (i + 1 < hex_str.len()) {
        int hi = hex_char_val(hex_str.byte(i))
        int lo = hex_char_val(hex_str.byte(i + 1))
        result += strings.char((hi << 4) | lo)
        i += 2
    }
    return result
}

// ==================== 便捷接口 ====================

func xtea_encrypt_hex(string key, string plaintext):string {
    return to_hex(xtea_encrypt(key, plaintext))
}

func xtea_decrypt_hex(string key, string hex_ct):string {
    return xtea_decrypt(key, from_hex(hex_ct))
}

// ==================== 测试 ====================

main() {
    print("=== XTEA 块加密测试 ===")
    print("")

    // 测试 1：XTEA 参考向量
    // v0=0, v1=0, key=[0,0,0,0]
    print("--- 块级测试 ---")
    Array[int] ct = xtea_encrypt_block(0, 0, 0, 0, 0, 0)
    print("加密 (0,0) key=[0,0,0,0]: v0=" + _str(ct[0]) + " v1=" + _str(ct[1]))
    Array[int] pt = xtea_decrypt_block(ct[0], ct[1], 0, 0, 0, 0)
    print("解密回: v0=" + _str(pt[0]) + " v1=" + _str(pt[1]))
    print("往返: " + if pt[0] == 0 and pt[1] == 0 then "OK" else "FAIL")
    print("")

    // 测试 2：XTEA Wikipedia 测试向量
    // key = [0x01020304, 0x05060708, 0x09101112, 0x13141516]
    // v0 = 0x41424344, v1 = 0x45464748
    print("--- Wikipedia 测试向量 ---")
    Array[int] wiki_ct = xtea_encrypt_block(0x41424344, 0x45464748, 0x01020304, 0x05060708, 0x09101112, 0x13141516)
    print("密文: v0=" + _str(wiki_ct[0]) + " v1=" + _str(wiki_ct[1]))
    Array[int] wiki_pt = xtea_decrypt_block(wiki_ct[0], wiki_ct[1], 0x01020304, 0x05060708, 0x09101112, 0x13141516)
    print("往返: " + if wiki_pt[0] == 0x41424344 and wiki_pt[1] == 0x45464748 then "OK" else "FAIL")
    print("")

    // 测试 3：字符串加解密
    print("--- 字符串加解密 ---")
    var key = "0123456789abcdef"
    var text1 = "Hello, XTEA!"
    var enc1 = xtea_encrypt(key, text1)
    var dec1 = xtea_decrypt(key, enc1)
    print("密钥: " + key)
    print("明文: " + text1)
    print("密文(hex): " + to_hex(enc1))
    print("解密: " + dec1)
    print("往返: " + if dec1 == text1 then "OK" else "FAIL")
    print("")

    // 测试 4：短密钥
    print("--- 短密钥测试 ---")
    var short_key = "xtea_key"
    var text2 = "XTEA encryption test"
    var enc2 = xtea_encrypt(short_key, text2)
    var dec2 = xtea_decrypt(short_key, enc2)
    print("明文: " + text2)
    print("解密: " + dec2)
    print("往返: " + if dec2 == text2 then "OK" else "FAIL")
    print("")

    // 测试 5：中文加解密
    print("--- 中文加解密 ---")
    var cn_key = "LenoC密钥"
    var cn_text = "你好，XTEA加密世界！"
    var cn_enc = xtea_encrypt(cn_key, cn_text)
    var cn_dec = xtea_decrypt(cn_key, cn_enc)
    print("原文: " + cn_text)
    print("解密: " + cn_dec)
    print("往返: " + if cn_dec == cn_text then "OK" else "FAIL")
    print("")

    // 测试 6：Hex 便捷接口
    print("--- Hex 便捷接口 ---")
    var hex_enc = xtea_encrypt_hex("my_secret_key16", "Hex interface test!")
    var hex_dec = xtea_decrypt_hex("my_secret_key16", hex_enc)
    print("加密(hex): " + hex_enc)
    print("解密: " + hex_dec)
    print("往返: " + if hex_dec == "Hex interface test!" then "OK" else "FAIL")
    print("")

    // 测试 7：错误密钥
    print("--- 错误密钥 ---")
    try {
        var wrong_dec = xtea_decrypt("wrong_key!!!!!!!", xtea_encrypt("correct_key_16b", "test data here"))
        print("非原文: " + if wrong_dec != "test data here" then "OK" else "FAIL")
    } catch {
        print("解密失败(预期行为): OK")
    }

    print("")
    print("=== XTEA 测试完成 ===")
}
