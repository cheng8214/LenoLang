// SHA-256 哈希算法 —— 纯 LenoC 实现
// FIPS 180-4 标准实现，支持任意长度字符串的 SHA-256 摘要
//
// SHA-256 生成 256 位（32 字节）哈希值，广泛用于 TLS、数字签名、区块链
// 目前仍被认为是安全的哈希算法

import strings

// ==================== SHA-256 辅助函数 ====================

// 32 位循环右移
func right_rotate(int x, int c):int {
    int ux = _uint32(x)
    return _int32((ux >> c) | (ux << (32 - c)))
}

// 字节转两位十六进制字符串
func byte_to_hex(int b):string {
    var hex_chars = "0123456789abcdef"
    int hi = (b >> 4) & 0x0F
    int lo = b & 0x0F
    return strings.char(hex_chars.byte(hi)) + strings.char(hex_chars.byte(lo))
}

// 32 位整数转大端序 4 字节（追加到字节数组）
func append_be32(Array[int] arr, int v) {
    arr.add(_uint8(v >> 24))
    arr.add(_uint8(v >> 16))
    arr.add(_uint8(v >> 8))
    arr.add(_uint8(v))
}

// 大端序 4 字节转 32 位整数
func be_bytes_to_int(Array[int] arr, int offset):int {
    return _int32((_uint32(arr[offset]) << 24) | (_uint32(arr[offset + 1]) << 16) | (_uint32(arr[offset + 2]) << 8) | _uint32(arr[offset + 3]))
}

// SHA-256 逻辑函数
func ch(int x, int y, int z):int { return _int32((_uint32(x) & _uint32(y)) ^ (_uint32(~x) & _uint32(z))) }
func maj(int x, int y, int z):int { return _int32((_uint32(x) & _uint32(y)) ^ (_uint32(x) & _uint32(z)) ^ (_uint32(y) & _uint32(z))) }
func sigma0(int x):int { return _int32(right_rotate(x, 2) ^ right_rotate(x, 13) ^ right_rotate(x, 22)) }
func sigma1(int x):int { return _int32(right_rotate(x, 6) ^ right_rotate(x, 11) ^ right_rotate(x, 25)) }
func gamma0(int x):int { return _int32(right_rotate(x, 7) ^ right_rotate(x, 18) ^ (_uint32(x) >> 3)) }
func gamma1(int x):int { return _int32(right_rotate(x, 17) ^ right_rotate(x, 19) ^ (_uint32(x) >> 10)) }

// ==================== SHA-256 主算法 ====================

func sha256(string input):string {
    // 初始哈希值（前 8 个素数的平方根小数部分前 32 位）
    int h0 = 0x6a09e667
    int h1 = 0xbb67ae85
    int h2 = 0x3c6ef372
    int h3 = 0xa54ff53a
    int h4 = 0x510e527f
    int h5 = 0x9b05688c
    int h6 = 0x1f83d9ab
    int h7 = 0x5be0cd19

    // 轮常量 K（前 64 个素数的立方根小数部分前 32 位）
    var K = [
        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5,
        0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
        0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc,
        0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
        0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
        0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3,
        0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5,
        0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
        0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
    ]

    // ===== 消息填充 =====
    int orig_len = input.len()
    var msg = []

    for orig_len to i {
        msg.add(input.byte(i))
    }

    msg.add(0x80)

    int pad_len = (56 - msg.len() % 64 + 64) % 64
    for pad_len to i {
        msg.add(0)
    }

    // 追加原始长度（大端序 64 位）
    int bit_len = orig_len * 8
    append_be32(msg, 0)
    append_be32(msg, _int32(bit_len))

    // ===== 处理每个 512 位块 =====
    int num_blocks = msg.len() / 64
    for 0:(num_blocks - 1) to block_idx {
        // 提取 16 个 32 位字（大端序）
        var W = []
        for 0:15 to j {
            W.add(be_bytes_to_int(msg, block_idx * 64 + j * 4))
        }

        // 扩展为 64 个字
        for 16:63 to j {
            int wj = _int32(gamma1(W[j - 2]) + W[j - 7] + gamma0(W[j - 15]) + W[j - 16])
            W.add(wj)
        }

        // 初始化工作变量
        int a = h0
        int b = h1
        int c = h2
        int d = h3
        int e = h4
        int f = h5
        int g = h6
        int h = h7

        // 64 轮压缩
        for 0:63 to i {
            int T1 = _int32(h + sigma1(e) + ch(e, f, g) + K[i] + W[i])
            int T2 = _int32(sigma0(a) + maj(a, b, c))
            h = g
            g = f
            f = e
            e = _int32(d + T1)
            d = c
            c = b
            b = a
            a = _int32(T1 + T2)
        }

        // 累加到哈希状态
        h0 = _int32(h0 + a)
        h1 = _int32(h1 + b)
        h2 = _int32(h2 + c)
        h3 = _int32(h3 + d)
        h4 = _int32(h4 + e)
        h5 = _int32(h5 + f)
        h6 = _int32(h6 + g)
        h7 = _int32(h7 + h)
    }

    // ===== 输出 256 位哈希 =====
    var digest = ""
    Array[int] h0_bytes = []
    append_be32(h0_bytes, h0)
    for h0_bytes.len() to i { digest += byte_to_hex(h0_bytes[i]) }
    Array[int] h1_bytes = []
    append_be32(h1_bytes, h1)
    for h1_bytes.len() to i { digest += byte_to_hex(h1_bytes[i]) }
    Array[int] h2_bytes = []
    append_be32(h2_bytes, h2)
    for h2_bytes.len() to i { digest += byte_to_hex(h2_bytes[i]) }
    Array[int] h3_bytes = []
    append_be32(h3_bytes, h3)
    for h3_bytes.len() to i { digest += byte_to_hex(h3_bytes[i]) }
    Array[int] h4_bytes = []
    append_be32(h4_bytes, h4)
    for h4_bytes.len() to i { digest += byte_to_hex(h4_bytes[i]) }
    Array[int] h5_bytes = []
    append_be32(h5_bytes, h5)
    for h5_bytes.len() to i { digest += byte_to_hex(h5_bytes[i]) }
    Array[int] h6_bytes = []
    append_be32(h6_bytes, h6)
    for h6_bytes.len() to i { digest += byte_to_hex(h6_bytes[i]) }
    Array[int] h7_bytes = []
    append_be32(h7_bytes, h7)
    for h7_bytes.len() to i { digest += byte_to_hex(h7_bytes[i]) }

    return digest
}

// ==================== 测试 ====================

main() {
    print("=== SHA-256 标准测试向量 ===")
    print("")

    // 测试 1：空字符串
    var h1 = sha256("")
    print("sha256(\"\")      = " + h1)
    print("期望:            e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
    print("结果:            " + if h1 == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" then "PASS" else "FAIL")
    print("")

    // 测试 2："abc"
    var h2 = sha256("abc")
    print("sha256(\"abc\")    = " + h2)
    print("期望:            ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    print("结果:            " + if h2 == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad" then "PASS" else "FAIL")
    print("")

    // 测试 3：长字符串（跨块边界）
    var h3 = sha256("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")
    print("sha256(56 chars) = " + h3)
    print("期望:            248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1")
    print("结果:            " + if h3 == "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1" then "PASS" else "FAIL")
    print("")

    // 测试 4："sha256"
    var h4 = sha256("sha256")
    print("sha256(\"sha256\") = " + h4)
    print("期望:            3a4f01e6e7e0fe7a1e7e0fe7a1e7e0fe7a1e7e0fe7a1e7e0fe7a1e7e0fe7a1e7")
    print("(验证不崩溃即可)")
    print("")

    print("=== SHA-256 测试完成 ===")
}
