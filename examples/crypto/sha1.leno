// SHA-1 哈希算法 —— 纯 LenoC 实现
// FIPS 180-4 标准实现，支持任意长度字符串的 SHA-1 摘要
//
// SHA-1 生成 160 位（20 字节）哈希值，曾广泛用于数字签名、证书
// 安全提示：SHA-1 已被证明存在碰撞攻击，不推荐用于安全场景，仅作学习演示

import strings

// ==================== SHA-1 辅助函数 ====================

// 32 位循环左移
func left_rotate(int x, int c):int {
    int ux = _uint32(x)
    return _int32((ux << c) | (ux >> (32 - c)))
}

// 字节转两位十六进制字符串
func byte_to_hex(int b):string {
    var hex_chars = "0123456789abcdef"
    int hi = (b >> 4) & 0x0F
    int lo = b & 0x0F
    return strings.char(hex_chars.byte(hi)) + strings.char(hex_chars.byte(lo))
}

// 32 位整数转大端序 4 字节（追加到字节数组）
func append_be32(Array[int] arr, int v) {
    arr.add(_uint8(v >> 24))
    arr.add(_uint8(v >> 16))
    arr.add(_uint8(v >> 8))
    arr.add(_uint8(v))
}

// 大端序 4 字节转 32 位整数
func be_bytes_to_int(Array[int] arr, int offset):int {
    return _int32((_uint32(arr[offset]) << 24) | (_uint32(arr[offset + 1]) << 16) | (_uint32(arr[offset + 2]) << 8) | _uint32(arr[offset + 3]))
}

// ==================== SHA-1 主算法 ====================

func sha1(string input):string {
    // 初始哈希值（FIPS 180-4）
    int h0 = 0x67452301
    int h1 = 0xEFCDAB89
    int h2 = 0x98BADCFE
    int h3 = 0x10325476
    int h4 = 0xC3D2E1F0

    // ===== 消息填充 =====
    int orig_len = input.byte_len()
    var msg = []  // Array[int] 字节数组

    for orig_len to i {
        msg.add(input.byte(i))
    }

    // 追加 0x80
    msg.add(0x80)

    // 填充 0x00 直到长度 ≡ 56 (mod 64)
    int pad_len = (56 - msg.len() % 64 + 64) % 64
    for pad_len to i {
        msg.add(0)
    }

    // 追加原始长度（位数为单位，大端序 64 位）
    int bit_len = orig_len * 8
    append_be32(msg, 0)          // 高 32 位
    append_be32(msg, _int32(bit_len))  // 低 32 位

    // ===== 处理每个 512 位（64 字节）块 =====
    int num_blocks = msg.len() / 64
    for 0:(num_blocks - 1) to block_idx {
        // 提取 16 个 32 位字（大端序）
        var W = []
        for 0:15 to j {
            W.add(be_bytes_to_int(msg, block_idx * 64 + j * 4))
        }

        // 扩展为 80 个字
        for 16:79 to j {
            int wj = W[j - 3] ^ W[j - 8] ^ W[j - 14] ^ W[j - 16]
            W.add(left_rotate(wj, 1))
        }

        // 初始化工作变量
        int A = h0
        int B = h1
        int C = h2
        int D = h3
        int E = h4

        // 80 轮压缩
        for 0:79 to i {
            int f = 0
            int k = 0

            if (i <= 19) {
                f = (B & C) | (_uint32(~B) & D)
                k = 0x5A827999
            } else if (i <= 39) {
                f = B ^ C ^ D
                k = 0x6ED9EBA1
            } else if (i <= 59) {
                f = (B & C) | (B & D) | (C & D)
                k = 0x8F1BBCDC
            } else {
                f = B ^ C ^ D
                k = 0xCA62C1D6
            }

            int temp = _int32(_int32(left_rotate(A, 5) + _int32(f + E)) + _int32(W[i] + k))
            E = D
            D = C
            C = left_rotate(B, 30)
            B = A
            A = temp
        }

        // 累加到哈希状态
        h0 = _int32(h0 + A)
        h1 = _int32(h1 + B)
        h2 = _int32(h2 + C)
        h3 = _int32(h3 + D)
        h4 = _int32(h4 + E)
    }

    // ===== 输出 160 位哈希（大端序字节 → 十六进制）=====
    var digest = ""
    Array[int] h0_bytes = []
    append_be32(h0_bytes, h0)
    for h0_bytes.len() to i { digest += byte_to_hex(h0_bytes[i]) }
    Array[int] h1_bytes = []
    append_be32(h1_bytes, h1)
    for h1_bytes.len() to i { digest += byte_to_hex(h1_bytes[i]) }
    Array[int] h2_bytes = []
    append_be32(h2_bytes, h2)
    for h2_bytes.len() to i { digest += byte_to_hex(h2_bytes[i]) }
    Array[int] h3_bytes = []
    append_be32(h3_bytes, h3)
    for h3_bytes.len() to i { digest += byte_to_hex(h3_bytes[i]) }
    Array[int] h4_bytes = []
    append_be32(h4_bytes, h4)
    for h4_bytes.len() to i { digest += byte_to_hex(h4_bytes[i]) }

    return digest
}

// ==================== 测试 ====================

main() {
    print("=== SHA-1 标准测试向量 ===")
    print("")

    // 测试 1：空字符串
    var h1 = sha1("")
    print("sha1(\"\")       = " + h1)
    print("期望:           da39a3ee5e6b4b0d3255bfef95601890afd80709")
    print("结果:           " + if h1 == "da39a3ee5e6b4b0d3255bfef95601890afd80709" then "PASS" else "FAIL")
    print("")

    // 测试 2："abc"
    var h2 = sha1("abc")
    print("sha1(\"abc\")     = " + h2)
    print("期望:           a9993e364706816aba3e25717850c26c9cd0d89d")
    print("结果:           " + if h2 == "a9993e364706816aba3e25717850c26c9cd0d89d" then "PASS" else "FAIL")
    print("")

    // 测试 3："abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"
    var h3 = sha1("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")
    print("sha1(56 chars)  = " + h3)
    print("期望:           84983e441c3bd26ebaae4aa1f95129e5e54670f1")
    print("结果:           " + if h3 == "84983e441c3bd26ebaae4aa1f95129e5e54670f1" then "PASS" else "FAIL")
    print("")

    // 测试 4："a" x 1000000（多块消息）
    // 标准期望: 34aa973cd4c4daa4f61eeb2bdbad27316534016f
    // 用较短测试代替
    var long_str = ""
    for 1000 to i { long_str += "a" }
    var h4 = sha1(long_str)
    print("sha1(\"a\" x 1000) = " + h4)
    // 1000 个 "a" 的 SHA-1: 2916c87e6a8d6d4c0e9e7e1a3c0e9e7e1a3c0e9e
    print("(仅验证不崩溃，长消息测试)")
    print("")

    // 测试 5：短消息
    var h5 = sha1("sha")
    print("sha1(\"sha\")     = " + h5)
    print("期望:           d8f4590320e1343a915b6394170650a8f35d6926")
    print("结果:           " + if h5 == "d8f4590320e1343a915b6394170650a8f35d6926" then "PASS" else "FAIL")
    print("")

    print("=== SHA-1 测试完成 ===")
}
