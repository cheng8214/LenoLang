// 调试 struct 方法

struct Point
{
    int x
    int y
    func test():int
    {
        // 直接使用 self.x 而不是 x
        return self.x + self.y
    }
}

main()
{
    print("调试 struct 方法")
    
    var p1 = new Point()
    p1.x = 10
    p1.y = 20
    
    // 调用 struct 方法
    var result = p1.test()
    print($"test() result: {result}")
    
    print("测试完成!")
}
