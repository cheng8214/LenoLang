// 跨模块 packed cstruct 导出定义
// 模拟实际项目中定义网络协议结构体并导出给其他模块使用

// packed 网络协议头
export packed cstruct PacketHeader {
    u8  magic
    u8  version
    u16 length
    u32 sequence
    u8  type
    u8  flags
}
// total=10, alignment=1

// align(32) 缓存行对齐结构体
export align(32) cstruct AlignedBuffer {
    u8 data[32]
}
// total=32, alignment=32

// packed + align(16) 组合
export packed align(16) cstruct ComboPacket {
    u8  type
    u16 payload_size
    u8  checksum
}
// packed 后 4 字节, align(16) 后 total=16, alignment=16

// 普通结构体（向后兼容性验证）
export cstruct NormalStruct {
    i32 x
    i32 y
}
// total=8, alignment=4
