// ============================================================
// 多返回值错误类型测试（应该被语义分析拦截）
// ============================================================

// ---------- 测试 1: 返回值数量不匹配 ----------
// 声明返回 2 个值，实际返回 3 个
func wrong_count(): [int, string] {
    return 1, "ok", 42   // 错误：返回了 3 个值，声明只有 2 个
}

// ---------- 测试 2: 返回值类型不匹配 ----------
func wrong_type(): [int, string] {
    return "not_an_int", 42   // 错误：第一个应该是 int，给了 string
}

// ---------- 测试 3: 返回值数量不足 ----------
func too_few(): [int, int, int] {
    return 1, 2   // 错误：声明 3 个，只返回了 2 个
}

// ---------- 测试 4: 解构槽位数量与返回值不匹配时类型检查 ----------
func ok_func(): [int, string] {
    return 42, "hello"
}
// 槽位类型不匹配
var[string, int](bad_a, bad_b) = ok_func()   // 错误：第一个槽位是 string，但返回的是 int

// ---------- 测试 5: 多返回值用于表达式（非解构/非语句） ----------
func get_pair(): [int, int] {
    return 1, 2
}
var x = get_pair() + 10   // 错误：多返回值不能直接参与算术运算

// ---------- 测试 6: 多返回值函数作为条件 ----------
func check(): [int, bool] {
    return 1, true
}
if check() {   // 错误：多返回值不能直接用于条件判断
    print("unreachable")
}

// ---------- 测试 7: 多返回值用于函数参数 ----------
func add(int a, int b): int {
    return a + b
}
var result = add(get_pair())   // 错误：多返回值不能直接作为单个参数

print("=== 这行不应该被执行 ===")
