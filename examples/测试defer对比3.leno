// 测试 for + defer + break 的不同变体

var log = []
func add(string s) { log.add(s) }

print("=== 1: for + defer + break (无if) ===")
log = []
for 0:3 to i {
    defer add("defer")
    add("iter-" + i)
    break
}
add("after")
print("  结果: " + log)

print("\n=== 2: for + defer + if+break ===")
log = []
for 0:3 to i {
    defer add("defer")
    add("iter-" + i)
    if i == 1 {
        add("breaking")
        break
    }
}
add("after")
print("  结果: " + log)

print("\n=== 3: for + defer + if+break (add在if后) ===")
log = []
for 0:3 to i {
    defer add("defer")
    if i == 1 {
        add("breaking")
        break
    }
    add("iter-" + i)
}
add("after")
print("  结果: " + log)

print("\n=== 4: for + defer + if+break (无add在body) ===")
log = []
for 0:3 to i {
    defer add("defer")
    if i == 1 {
        break
    }
}
add("after")
print("  结果: " + log)
