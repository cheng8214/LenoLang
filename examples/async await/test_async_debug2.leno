import io
import asyncs

async func task(string name, int ms) {
    io.print($"{name} 开始")
    await asyncs.sleep(ms)
    io.print($"{name} 完成")
}

async func test() {
    io.print("test 开始")
    var f = task("X", 100)
    io.print("task 已启动")
    await f
    io.print("await 完成")
}

main() {
    io.print("=== 开始 ===")
    test()
    asyncs.run()
    io.print("=== 结束 ===")
}
