import io
import asyncs

// 测试并发
async func task(string name, int ms) {
    io.print($"任务 {name} 开始")
    await asyncs.sleep(ms)
    io.print($"任务 {name} 完成")
}

async func test_concurrent() {
    io.print("开始并发测试")
    var f1 = task("A", 300)
    var f2 = task("B", 200)
    var f3 = task("C", 100)
    await f1
    await f2
    await f3
    io.print("并发测试完成")
}

main() {
    io.print("=== 测试 ===")
    test_concurrent()
    asyncs.run()
    io.print("=== 完成 ===")
}
