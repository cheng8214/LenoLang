face Speaker {
    func speak():string
}

struct Dog impl Speaker{
    func speak():string { return "woof" }
}

struct Cat impl Speaker{
    func speak():string { return "meow" }
}

struct Bird impl Speaker{
    func speak():string { return "tweet" }
}

// 编译期确定类型的 face 调用
func face_compile_time(Speaker s, int n) {
    for 0:n to i { s.speak() }
}

// 运行时确定类型的 face 调用（从数组取）
func face_runtime(var speakers, int n) {
   
            print("cs:"+speakers)
            if speakers is Array[Speaker]
            {
            for n{
	            for  speakers to i
	            {
	            	
	            	i.speak()
	            }
            }
            }
       
}

// 直接调用
func direct_call(Dog d, int n) {
    for 0:n to i { d.speak() }
}

main() {
    import times
    var dog = new Dog()
    var cat = new Cat()
    var bird = new Bird()

    // 编译期 face 调用
    var t1 = times.ns()
    face_compile_time(dog, 1000000)
    var t2 = times.ns()
    print("编译期face: " + (t2 - t1) + " ns")

    // 直接调用
    var t3 = times.ns()
    direct_call(dog, 1000000)
    var t4 = times.ns()
    print("直接调用: " + (t4 - t3) + " ns")

    // 运行时 face 调用 - 单一类型数组
    var single_type = [dog]
    var t5 = times.ns()
    face_runtime(single_type, 1000000)
    var t6 = times.ns()
    print("运行时face(单类型): " + (t6 - t5) + " ns")

    // 运行时 face 调用 - 混合类型数组
    var mixed = [dog, cat, bird]
    var t7 = times.ns()
    face_runtime(mixed, 1000000)
    var t8 = times.ns()
    print("运行时face(混合): " + (t8 - t7) + " ns")

    // 验证实际输出
    print("=== 验证输出 ===")
    print(type(mixed))
    for mixed to s {
        print(s.speak())
    }
}