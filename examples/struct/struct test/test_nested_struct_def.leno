// 测试在函数内定义 struct

// ⚠ 2026-09-28 修示例：**函数内定义的 struct 出不了函数作用域** ——
//   原来把它 `return` 出去、在外面 `obj.getData()`，调用点看到的是 any
//   （"不能在 any 类型上调用方法 'getData'"）。演示"函数内定义 struct"的正确形态是
//   **在函数内使用它**，把具体类型的结果返回出去。
func createStructWithCapture(): int
{
    var local_var = 100

    // 在函数内部定义 struct
    struct LocalStruct
    {
        int data = 0

        func getData(): int
        {
            return data
        }
    }

    var obj = new LocalStruct(data = local_var / 20)   // 用上外层局部变量
    return obj.getData()
}

main()
{
    print("测试在函数内定义 struct")
    int result = createStructWithCapture()
    print($"结果: {result}")
}
