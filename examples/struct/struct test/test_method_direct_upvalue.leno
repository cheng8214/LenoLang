// 测试 struct 方法直接使用外部变量（upvalue）
// 这种情况方法本身需要捕获外部变量

// 全局变量
var global_counter = 0

struct TestStruct
{
    int value
    
    // 方法直接使用全局变量
    func useGlobal()
    {
        global_counter = global_counter + 1
        return global_counter
    }
    
    // 方法访问 self 和全局变量
    func combine()
    {
        return value + global_counter
    }
}

// 测试在函数内定义 struct，捕获局部变量
// ⚠ 2026-09-28 修示例：函数内定义的 struct **出不了函数作用域** ——
//   原来把它 return 出去、在外面 `obj.getLocal()`，调用点看到的是 any
//   （"不能在 any 类型上调用方法 'getLocal'"）⇒ 在函数内用掉它，把**具体类型的结果**返回出去。
func createStructWithCapture(): int
{
    var local_var = 100
    
    struct LocalStruct
    {
        int data
        int base        // ⚠ 外部值用**字段**承接（见下面说明）

        // 读自己的两个字段 —— 不捕获外层局部
        func getLocal(): int
        {
            return base + data
        }
    }

    // ⚠ 2026-09-28：本函数原来的写法是让方法**直接读外层局部**（`return local_var + data`）——
    //   那会 **0xC0000005 崩**（事故与机理见 docs 实例三十一 / 三十二）。**已修**：
    //   编译器现在在解析点就拒绝（「struct 方法不能捕获外层局部变量 'local_var'…」），
    //   崩溃变成一行清晰错误（响亮报错 > 静默崩溃）。
    //   正确写法：把外部值在 `new` 时作为**字段**传进去（下面这样）。
    var obj = new LocalStruct(data = 5, base = local_var)
    return obj.getLocal()
}

main()
{
    print("======== struct 方法直接使用外部变量测试 ========")
    print("")
    
    // 测试1: 使用全局变量
    print("--- 测试1: 方法使用全局变量 ---")
    TestStruct t = new TestStruct(value = 10)
    
    var r1 = t.useGlobal()
    print($"第一次调用: {r1}, 期望: 1")
    
    var r2 = t.useGlobal()
    print($"第二次调用: {r2}, 期望: 2")
    
    var r3 = t.combine()
    print($"combine 结果: {r3}, 期望: 12 (10 + 2)")
    
    if r1 == 1 and r2 == 2 and r3 == 12
    {
        print("测试1通过!")
    }
    else
    {
        print("测试1失败!")
    }
    print("")
    
    // 测试2: 捕获局部变量
    print("--- 测试2: 方法捕获局部变量 ---")
    int result = createStructWithCapture()
    print($"结果: {result}, 期望: 105 (100 + 5)")
    
    if result == 105
    {
        print("测试2通过!")
    }
    else
    {
        print("测试2失败!")
    }
    print("")
    
    print("======== 测试完成 ========")
}
