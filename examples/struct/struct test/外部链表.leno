struct Node
{
    int value
    Node next = null
}

struct LinkedList
{
    Node head = null
    int count = 0
}

// ✅ 正确的添加：追加到链表尾部
func list_add(LinkedList list, int value)
{
    var new_node = new Node()
    new_node.value = value
    
    if (list.head == null)
    {
        // 第一个节点
        list.head = new_node
    }
    else
    {
        // 找到最后一个节点，追加到后面
        var current = list.head
        while (current.next != null)
        {
            current = current.next
        }
        current.next = new_node
    }
    list.count = list.count + 1
}

// ✅ 或者：头插法（新节点插在最前面）
func list_add_head(LinkedList list, int value)
{
    var new_node = new Node()
    new_node.value = value
    new_node.next = list.head   // 新节点指向原来的 head
    list.head = new_node        // head 指向新节点
    list.count = list.count + 1
}

main()
{
    print("=== 尾插法 ===")
    var list1 = new LinkedList()
    for 5 to i
    {
        list_add(list1, 100 + i)  // 添加 100, 101, 102, 103, 104
    }
    
    // 打印链表
    var current = list1.head
    while (current != null)
    {
        print(current.value)
        print(" -> ")
        current = current.next
    }
    print("null")
    print("\n节点数: ")
    print(list1.count)
    
    print("\n=== 头插法 ===")
    var list2 = new LinkedList()
    for 5 to i
    {
        list_add_head(list2, 100 + i)  // 添加 100, 101, 102, 103, 104
    }
    
    // 打印链表（顺序是反的）
    current = list2.head
    while (current != null)
    {
        print(current.value)
        print(" -> ")
        current = current.next
    }
    print("null")
}
