// 测试运行时 struct 重新定义（模拟热更新场景）
// 由于语义分析会阻止重复定义，我们测试正常 struct 使用

struct Config
{
    int version
    string name
}

main()
{
    print("测试 struct 正常使用")
    
    // 创建多个实例
    Config c1 = new Config(version = 1, name = "config1")
    Config c2 = new Config(version = 2, name = "config2")
    Config c3 = new Config(version = 3, name = "config3")
    
    print($"c1: version={c1.version}, name={c1.name}")
    print($"c2: version={c2.version}, name={c2.name}")
    print($"c3: version={c3.version}, name={c3.name}")
    
    print("测试通过!")
}
