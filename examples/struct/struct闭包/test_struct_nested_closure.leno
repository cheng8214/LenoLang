// 测试 struct 中更复杂的闭包场景

struct Calculator
{
    int result = 0

    // 返回一个可以链式调用的闭包工厂
    func create_adder(int n)
    {
        return func()
        {
            result = result + n
            // 返回另一个闭包用于继续操作
            return func(int m)
            {
                result = result + m
                return result
            }
        }
    }

    // 返回多个闭包，共享同一状态
    func get_operations()
    {
        var add_fn = func(int n)
        {
            result = result + n
            return result
        }

        var sub_fn = func(int n)
        {
            result = result - n
            return result
        }

        var get_val = func()
        {
            return result
        }

        // 返回一个包含多个闭包的字典
        return {
            "add_fn": add_fn,
            "sub_fn": sub_fn,
            "get_val": get_val
        }
    }
}

main()
{
    print("=== 测试 struct 嵌套闭包 ===")

    var calc = new Calculator()

    print("\n测试闭包工厂:")
    var add5 = calc.create_adder(5)
    print("创建 add5 后调用:")
    var add_more = add5()  // result = 5, 返回另一个闭包
    print(calc.result)

    print("继续添加 3:")
    add_more(3)
    print(calc.result)

    print("\n测试多个闭包共享状态:")
    var ops = calc.get_operations()
    print("当前值:")
    print(ops["get_val"]())

    print("加 10:")
    ops["add_fn"](10)
    print(ops["get_val"]())

    print("减 5:")
    ops["sub_fn"](5)
    print(ops["get_val"]())

    print("\n验证不同实例隔离:")
    var calc2 = new Calculator()
    var ops2 = calc2.get_operations()
    ops2["add_fn"](100)
    print("calc2 的值:")
    print(ops2["get_val"]())
    print("calc1 的值应该不变:")
    print(ops["get_val"]())
}
