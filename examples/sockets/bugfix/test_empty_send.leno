import sockets
import asyncs
import io

// 单独测试空字符串发送

async func srv(int port) {
    var s = sockets.listen("127.0.0.1", port)
    if s == null { io.print("[S] null"); return }
    io.print("[S] listening")
    
    var c = await s.aaccept()
    io.print("[S] accepted: " + c)
    if c != null {
        io.print("[S] waiting recv...")
        var d = await c.arecv(1024)
        io.print("[S] recv returned: '" + d + "'")
        io.print("[S] recv len: " + d.len())
        
        // 发送确认
        if d.len() == 0 {
            c.send("EMPTY_OK")
        } else {
            c.send("LEN_" + d.len())
        }
        c.close()
    }
    s.close()
}

async func cli(int port) {
    await asyncs.sleep(100)
    var s = sockets.connect("127.0.0.1", port)
    io.print("[C] connect result: " + s)
    if s == null { return }
    
    io.print("[C] sending empty string...")
    var ok = s.send("")
    io.print("[C] send empty returned: " + ok)
    
    io.print("[C] waiting reply...")
    var r = await s.arecv(1024)
    io.print("[C] got: '" + r + "'")
    s.close()
}

async func keeper(int ms) {
    await asyncs.sleep(ms)
}

main() {
    var port = 12700
    srv(port)
    cli(port)
    keeper(5000)
    io.print("running...")
    asyncs.run()
    io.print("done")
}
