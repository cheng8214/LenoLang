import sockets
import io

// 聊天客户端 V2 - 面向对象风格（使用 select）

main() {
    var host = "127.0.0.1"
    var port = 8888
    var name = "用户"

    io.print("=== Leno 聊天客户端 ===")

    // 输入昵称
    var input_name = input("请输入昵称：")
    input_name = input_name.trim()
    if input_name.len() > 0 {
        name = input_name
    }

    io.print("连接到 " + host + ":" + port)

    // 连接服务器
    var conn = sockets.connect(host, port)
    if conn == null {
        io.print("连接失败！")
        return
    }

    io.print("已连接！")

    // 设置非阻塞模式
    conn.set_nonblocking(true)

    // 接收欢迎消息
    var welcome = conn.recv(1024)
    if welcome != null {
        io.print(welcome)
    }

    io.print("")
    io.print("=== 开始聊天 ===")
    io.print("提示：输入消息按回车发送，输入 /quit 退出")
    io.print("")

    // 主循环
    while true {
        // 检查是否有新消息（使用 select）
        var socks = [conn]
        var ready = sockets.select(socks, 50)

        // 接收所有可用消息
        var idx = 0
        while idx < ready.len() {
            var msg = conn.recv(1024)
            if msg != null {
                io.print(msg)
            }
            idx = idx + 1
        }

        // 读取用户输入
        var input_msg = input("[" + name + "] ")
        input_msg = input_msg.trim()

        if input_msg.len() == 0 {
            continue
        }

        // 发送消息
        var full_msg = input_msg + "\n"
        var sent = conn.send(full_msg)

        if not sent {
            io.print("[系统] 发送失败")
            break
        }

        // 检查退出命令
        if input_msg == "/quit" {
            break
        }

        // 发送后立即检查响应
        var check_count = 0
        while check_count < 10 {
            var response_socks = [conn]
            var response_ready = sockets.select(response_socks, 100)

            if response_ready.len() > 0 {
                var reply = conn.recv(1024)
                if reply != null {
                    io.print(reply)
                }
            }
            check_count = check_count + 1
        }
    }

    conn.close()
    io.print("")
    io.print("客户端已退出")
}
