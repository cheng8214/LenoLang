import sockets
import io

// 测试 sockets 模块 - 面向对象风格
main() {
    io.print("=== Sockets 模块测试 ===")
    io.print("")

    // 测试1: TCP 客户端连接
    io.print("测试1: TCP 连接到 baidu.com:80")
    Socket conn = sockets.connect("www.baidu.com", 80)
	print(conn)
    if conn != null {
        io.print("  连接成功!")

        // 发送 HTTP 请求
        var request = "GET / HTTP/1.0\r\nHost: www.baidu.com\r\n\r\n"
        var sent = conn.send(request)
        io.print("  发送请求: " + sent)

        // 接收响应
        var response = conn.recv(1024)
        if response != null {
            io.print("  收到响应长度: " + response.len())
            io.print("  响应前50字符: " + response.sub_str(0, 50))
        } else {
            io.print("  接收失败或连接已关闭")
        }

        // 关闭连接
        conn.close()
        io.print("  连接已关闭")
    } else {
        io.print("  连接失败")
    }

    io.print("")
    io.print("=== 测试完成 ===")
}
