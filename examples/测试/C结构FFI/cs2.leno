// 简化版线程测试
//
// ⚠ 2026-09-28 已知运行期 bug（**不是本文件的写法问题**）：本文件 6/6 **稳定**触发
//   进程收尾堆损坏 0xC0000374（输出一切正常，退出阶段堆检查抓到）。
//   二分已排除：from_ptr / ffi.load+malloc+free / 子线程里的 s.free()；
//   触发形态是「子线程里创建 cstruct + 其字段进 dict + dict 经通道发」。
//   详见 docs 实例三十四，稳定复现见 assert/fixture_thread_cstruct_crash.leno。
import ffi
import threads

// cstruct 定义
cstruct TEST_STRUCT {
    u32 field1
    u32 field2
}

// ---- 收窄助手（2026-09-28 修示例）----
// 背景：`ch.receive()` 的静态类型是 **any**（语言没有 `Channel[T]`，所以没有元素类型可推），
//   而本语言**不允许在 any 上直接点字段**（"不能在 any 类型 'msg1' 上直接访问字段 'type'"）。
//   正确姿势：先 `is Dict` 守卫（下标的写法不是收窄的替代品 —— 裸 `as Dict[K,V]` 编译得过但
//   运行期类型是 `Dict[any, any]`、带参数的守卫恒假），再用下标读。
//   这里收敛成一个助手，免得三段接收代码各写一遍同样的守卫。
func msg_field(any m, string key): string {
    if m is Dict {
        return _str(m[key])
    }
    return ""
}

// 供 examples/测试/模块/main.leno 调用的模块测试入口
export func test() {
    print("=== cs2.test(): cstruct 模块方法 ===")
    var s = TEST_STRUCT.malloc()
    s.field1 = 100
    s.field2 = 200
    print("field1=" + s.field1 + ", field2=" + s.field2)
    s.free()
    print("cs2 模块方法测试通过")
}

// 测试函数：在线程中使用 cstruct
func test_cstruct_in_thread(any ch) {
    // 尝试在子线程中使用 cstruct
    try {
        var s = TEST_STRUCT.malloc()
        s.field1 = 100
        s.field2 = 200
        if ch is Channel {
            ch.send({type: "ok", msg: "cstruct 工作正常", f1: s.field1, f2: s.field2})
        }
        s.free()
    } catch e {
        if ch is Channel {
            ch.send({type: "error", msg: "cstruct 失败: " + e})
        }
    }
}

// 测试函数：在线程中使用 ffi
func test_ffi_in_thread(any ch) {
    try {
        var kernel32 = ffi.load("kernel32.dll")
        var buffer = ffi.malloc(100)

        if buffer != ffi.nullptr() {
            if ch is Channel {
                ch.send({type: "ok", msg: "ffi malloc 成功"})
            }
        } else {
            if ch is Channel {
                ch.send({type: "error", msg: "ffi malloc 失败"})
            }
        }

        ffi.free(buffer)
        ffi.free(kernel32)
    } catch e {
        if ch is Channel {
            ch.send({type: "error", msg: "ffi 失败: " + e})
        }
    }
}

// 测试函数：在线程中使用 cstruct from_ptr
func test_cstruct_from_ptr(any ch) {
    try {
        var kernel32 = ffi.load("kernel32.dll")
        var buffer = ffi.malloc(100)

        // 写入测试数据
        ffi.write_uint(buffer, 0, 123)
        ffi.write_uint(buffer, 4, 456)

        // 使用 from_ptr 读取
        var s = TEST_STRUCT.from_ptr(buffer)

        if ch is Channel {
            ch.send({type: "ok", msg: "from_ptr 成功", f1: s.field1, f2: s.field2})
        }

        ffi.free(buffer)
        ffi.free(kernel32)
    } catch e {
        if ch is Channel {
            ch.send({type: "error", msg: "from_ptr 失败: " + e})
        }
    }
}

main() {
    print("=== 线程测试 ===")
    print("")

    var ch = threads.channel(10)

    // 测试 1: cstruct 在线程中
    print("测试 1: 子线程中使用 cstruct...")
    var t1 = threads.start(test_cstruct_in_thread, ch)
    if ch is Channel {
        var msg1 = ch.receive()
        print("  结果: " + msg_field(msg1, "type") + " - " + msg_field(msg1, "msg"))
        if msg_field(msg1, "type") == "ok" {
            print("  field1=" + msg_field(msg1, "f1") + ", field2=" + msg_field(msg1, "f2"))
        }
    }
    t1.join()
    print("")

    // 测试 2: ffi 在线程中
    print("测试 2: 子线程中使用 ffi...")
    var t2 = threads.start(test_ffi_in_thread, ch)
    if ch is Channel {
        var msg2 = ch.receive()
        print("  结果: " + msg_field(msg2, "type") + " - " + msg_field(msg2, "msg"))
    }
    t2.join()
    print("")

    // 测试 3: cstruct from_ptr 在线程中
    print("测试 3: 子线程中使用 cstruct from_ptr...")
    var t3 = threads.start(test_cstruct_from_ptr, ch)
    if ch is Channel {
        var msg3 = ch.receive()
        print("  结果: " + msg_field(msg3, "type") + " - " + msg_field(msg3, "msg"))
        if msg_field(msg3, "type") == "ok" {
            print("  field1=" + msg_field(msg3, "f1") + ", field2=" + msg_field(msg3, "f2"))
        }
    }
    t3.join()
    print("")

    print("=== 测试完成 ===")
}
