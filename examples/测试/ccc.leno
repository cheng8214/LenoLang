import gui

main() {
    gui.init()
    
    var win = gui.create_window("标题", 800, 600, 1)
    
    func Draw(var ren)
    {
            // onDraw: 每帧调用，ren 是自动创建的渲染器
            gui.set_draw_color(ren, 30, 30, 46, 255)
            gui.render_clear(ren)
            gui.set_draw_color(ren, 255, 0, 0, 255)
            gui.render_fill_rect(ren, 100, 100, 200, 150)
            gui.render_present(ren)
        }
    func Event(Event event) 
    {
            // onEvent: 每个事件调用
            if event.is_window_close() or event.is_key_down() 
            {
                gui.set_window_should_close(win, true)
            }
    }
    gui.run(win,Draw,Event)
   
    
    gui.destroy_window(win)
    gui.quit()
}