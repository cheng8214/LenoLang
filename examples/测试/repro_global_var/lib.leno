// 最小复现 - 带调试输出
import strings

var _g_pos = 0
var _g_html = ""

func _parseWord(): string {
    string word = ""
    int len = _g_html.len()
    while _g_pos < len {
        int b = _g_html.byte(_g_pos)
        if b >= 97 and b <= 122 {
            word = word + strings.char(b)
            _g_pos = _g_pos + 1
        } else {
            break
        }
    }
    return word
}

export func parse(string html): string {
    _g_html = html
    _g_pos = 0
    
    string result = ""
    
    int loopCount = 0
    while _g_pos < _g_html.len() {
        loopCount = loopCount + 1
        print("[loop " + loopCount + "] _g_pos=" + _g_pos + " type=" + type(_g_pos) + " _g_html type=" + type(_g_html))
        
        int b = _g_html.byte(_g_pos)
        if b == 60 {
            _g_pos = _g_pos + 1
            string tag = _parseWord()
            print("[after _parseWord] _g_pos=" + _g_pos + " type=" + type(_g_pos) + " _g_html type=" + type(_g_html))
            result = result + tag + ","
            while _g_pos < _g_html.len() and _g_html.byte(_g_pos) != 62 {
                _g_pos = _g_pos + 1
            }
            if _g_pos < _g_html.len() {
                _g_pos = _g_pos + 1
            }
        } else {
            _g_pos = _g_pos + 1
        }
    }
    
    return result
}
