face Speaker {
    func speak():string
}

struct Dog impl Speaker {
    string name = ""
    func speak():string { return "woof" }
}

struct Cat impl Speaker {
    func speak():string { return "meow" }
}

func make_sound(Speaker s) {
    print(s.speak())
}

main() {
    var d = new Dog()
    var c = new Cat()
    make_sound(d)
    make_sound(c)

    Speaker s = new Dog()
    print(s.speak())

    if d is Speaker {
        print("Dog is Speaker")
    }
}
