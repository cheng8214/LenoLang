// 调试 for + defer + break inside if

var log = []

func add(string s) {
    log.add(s)
}

print("=== 调试: for + defer + break inside if ===")
log = []
for 0:3 to i {
    defer add("defer")
    add("iter-" + i)
    print("  i=" + i + " log=" + log)
    if i == 1 {
        print("  breaking!")
        add("breaking")
        break
    }
    print("  after-if, i=" + i)
}
print("  after-loop, log=" + log)
