import times

// ============================================================================
// 尾调用优化 (TCO) 测试
// ============================================================================
// 尾调用优化应该使尾递归函数使用常量栈空间，而不是线性增长的栈

main() {
    print("======== 尾调用优化测试 ========")
    print("")
    
    // 测试1: 简单尾递归（斐波那契尾递归版本）
    print("--- 测试1: 尾递归斐波那契 ---")
    var n = 10000  // 大数测试，如果没有TCO会栈溢出
    
    var t1 = times.ms()
    var result1 = fib_tail(n, 0, 1)
    var t2 = times.ms()
    print($"fib_tail({n}) = {result1}")
    print($"耗时: {t2 - t1}ms")
    print("")
    
    // 测试2: 非尾递归对比（经典递归）
    print("--- 测试2: 经典递归斐波那契 (n=30) ---")
    n = 30
    t1 = times.ms()
    var result2 = fib_recursive(n)
    t2 = times.ms()
    print($"fib_recursive({n}) = {result2}")
    print($"耗时: {t2 - t1}ms")
    print("")
    
    // 测试3: 阶乘尾递归
    print("--- 测试3: 尾递归阶乘 ---")
    n = 1000
    t1 = times.ms()
    var result3 = factorial_tail(n, 1)
    t2 = times.ms()
    print($"factorial_tail({n}) 结果长度: {_str(result3).len()}")
    print($"耗时: {t2 - t1}ms")
    print("")
    
    // 测试4: 普通调用（非尾调用位置）
    print("--- 测试4: 普通函数调用（非尾调用位置）---")
    t1 = times.ms()
    var result4 = test_normal_call()
    t2 = times.ms()
    print($"结果: {result4}")
    print($"耗时: {t2 - t1}ms")
    print("")
    
    // 测试5: 互相尾递归
    print("--- 测试5: 互相尾递归 (is_even/is_odd) ---")
    n = 1000 // 大数测试
    t1 = times.ms()
    var result5 = is_even(n)
    t2 = times.ms()
    print($"is_even({n}) = {result5}")
    print($"耗时: {t2 - t1}ms")
    print("")
    
    print("======== 测试完成 ========")
}

// ============================================================================
// 尾递归版本斐波那契 - 应该被优化为循环
// ============================================================================
func fib_tail(any n, any a,any b) {
    if n == 0 {
        return a
    }
    if n == 1 {
        return b
    }
    return fib_tail(n - 1, b, a + b)  // 尾调用位置
}

// ============================================================================
// 经典递归斐波那契 - 非尾递归，无法优化
// ============================================================================
func fib_recursive(any n) {
    if n <= 1 {
        return n
    }
    return fib_recursive(n - 1) + fib_recursive(n - 2)  // 非尾调用（加法操作）
}

// ============================================================================
// 尾递归阶乘
// ============================================================================
func factorial_tail(any n, any acc) {
    if n <= 1 {
        return acc
    }
    return factorial_tail(n - 1, n * acc)  // 尾调用位置
}

// ============================================================================
// 测试普通调用（非尾调用位置）
// ============================================================================
func helper(any x) {
    return x * 2
}

func test_normal_call() {
    var a = helper(5)   // 普通调用，不是尾调用
    var b = helper(a)   // 普通调用，不是尾调用
    return helper(b)    // 尾调用，应该被优化
}

// ============================================================================
// 互相尾递归测试
// ============================================================================
func is_even(any n) {
    if n == 0 {
        return true
    }
    return is_odd(n - 1)  // 尾调用
}

func is_odd(any n) {
    if n == 0 {
        return false
    }
    return is_even(n - 1)  // 尾调用
}
