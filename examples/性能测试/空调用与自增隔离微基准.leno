import times

// ============================================================================
// 隔离微基准：把「空函数调用」「i++」「i = i + 1」「1 参调用」分开量，各 1 千万次。
// ----------------------------------------------------------------------------
// 为什么单独写一份：`调用开销微基准.leno` 的被调函数体里有 `for 1 {}`（防内联），
// 于是"调用开销"被函数体的执行时间盖住了 —— 那边我们反而比栈式快 1.3x。而
// **真正暴露固定调用开销**的是空函数体：
//   栈式 11.6ns/次 vs 我们 64ns/次（慢 5.4x），Lua 19ns/次。
// 同时它对拍 `i++` 与 `i = i + 1`：原先 `i++` 反而更慢（do_inc_dec 跨 TU + 逐类型派发）。
// 见 docs/待办与路线图.md 的 ⑤-f / ⑤-g。
// ============================================================================

func empty() {}

func one(int x):int {
    return x
}

main() {
    int N = 10000000

    var t1 = times.ms()
    for N {
        empty()
    }
    var t2 = times.ms()
    print($"空调用: " + (t2 - t1) + "ms")

    var i = 0
    t1 = times.ms()
    for N {
        i++
    }
    t2 = times.ms()
    print($"i++: " + (t2 - t1) + "ms  结果:" + i)

    i = 0
    t1 = times.ms()
    for N {
        i = i + 1
    }
    t2 = times.ms()
    print($"i = i + 1: " + (t2 - t1) + "ms  结果:" + i)

    var s = 0
    t1 = times.ms()
    for N {
        s = one(s)
    }
    t2 = times.ms()
    print($"1参调用: " + (t2 - t1) + "ms  结果:" + s)

    return 0
}
