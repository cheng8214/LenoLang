// 斐波那契数列优化对比
import times as time
// 版本1：经典递归（原始版本）
func fib_recursive(int n):int {
    if n <= 1 {
        return n
    }
    return fib_recursive(n - 2) + fib_recursive(n - 1)
}

// 版本2：记忆化递归
func fib_memo(int n) {
    var memo = {}
    return fib_memo_helper(n, memo)
}

func fib_memo_helper(int n, Dict memo) {
    if n <= 1 {
        return n
    }
    var str=_str(n)
    if memo.has(str) {
        return memo[str]
    }
    var result = fib_memo_helper(n - 1, memo) + fib_memo_helper(n - 2, memo)
    memo[str] = result
    return result
}

// 版本3：迭代实现（最快）
func fib_iterative(int n) {
    if n <= 1 {
        return n
    }
    var a = 0
    var b = 1
    // 循环从 2 到 n（包含 n），因为 LenoLang 的 range 语法包含结束值
    // for 2:n 会生成 [2, 3, ..., n]，共 n-1 个元素
    for 2:n to var i {
        var temp = a + b
        a = b
        b = temp
    }
    return b
}

// 版本4：尾递归优化
func fib_tail(int n):int {
    return fib_tail_helper(n, 0, 1)
}

func fib_tail_helper(int n,int a,int b):int {
    if n == 0 {
        return a
    }
    if n == 1 {
        return b
    }
    return fib_tail_helper(n - 1, b, a + b)
}

main() {
    var n = 30
    
    print("斐波那契数列优化对比 (n=" + n + "):\n")
    
    // 测试1：经典递归
    var t1 = time.ms()
    var r1 = fib_recursive(n)
    var t2 = time.ms()
    print("经典递归: " + r1 + "  耗时: " + (t2 - t1) + "ms")
    
    // 测试2：记忆化递归
    var t3 = time.ms()
    var r2 = fib_memo(n)
    var t4 = time.ms()
    print("记忆化递归: " + r2 + "  耗时: " + (t4 - t3) + "ms")
    
    // 测试3：迭代实现
    var t5 = time.ms()
    var r3 = fib_iterative(n)
    var t6 = time.ms()
    print("迭代实现: " + r3 + "  耗时: " + (t6 - t5) + "ms")
    
    // 测试4：尾递归
    var t7 = time.ms()
    var r4 = fib_tail(n)
    var t8 = time.ms()
    print("尾递归: " + r4 + "  耗时: " + (t8 - t7) + "ms")
    
    print("\n测试更大的数 (n=1000):")
    var t9 = time.ms()
    var r5 = fib_iterative(1000)
    var t10 = time.ms()
    print("迭代实现 fib(1000): " + r5 + "  耗时: " + (t10 - t9) + "ms")
}
