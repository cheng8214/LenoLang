import times
import maths

// 用纯 Leno 手写 sin / cos / sqrt / log 替换 maths 调用，
// 跑与原基准完全相同的负载：5000 万次 × (sin*cos + sqrt + log)
// 同一进程里先跑 maths 版作对照，再跑手写版。

const PI      = 3.141592653589793
const TWO_PI  = 6.283185307179586
const HALF_PI = 1.5707963267948966
const LN2     = 0.6931471805599453

// ---------- sqrt：多档折半到 [1,4)，线性初值 + 4 次牛顿 ----------
func my_sqrt(float x): float {
    if x <= 0.0 {
        return 0.0
    }
    var t = x
    var s = 1.0
    while t >= 16777216.0 {
        t = t * 5.9604644775390625e-08
        s = s * 4096.0
    }
    while t >= 4096.0 {
        t = t * 0.000244140625
        s = s * 64.0
    }
    while t >= 64.0 {
        t = t * 0.015625
        s = s * 8.0
    }
    while t >= 4.0 {
        t = t * 0.25
        s = s * 2.0
    }
    while t < 1.0 {
        t = t * 4.0
        s = s * 0.5
    }
    var g = 0.5 + 0.5 * t
    g = 0.5 * (g + t / g)
    g = 0.5 * (g + t / g)
    g = 0.5 * (g + t / g)
    g = 0.5 * (g + t / g)
    return g * s
}

// ---------- sin：周期归约到 [-π,π] → 折到 [-π/2,π/2] → 11 项 Horner ----------
func my_sin(float x): float {
    var k = _int(x / TWO_PI)
    x = x - _float(k) * TWO_PI
    while x > PI {
        x = x - TWO_PI
    }
    while x < -PI {
        x = x + TWO_PI
    }
    if x > HALF_PI {
        x = PI - x
    } else {
        if x < -HALF_PI {
            x = -PI - x
        }
    }
    var x2 = x * x
    var p = 1.0 / 51090942171709440000.0
    p = -1.0 / 121645100408832000.0 + x2 * p
    p = 1.0 / 355687428096000.0 + x2 * p
    p = -1.0 / 1307674368000.0 + x2 * p
    p = 1.0 / 6227020800.0 + x2 * p
    p = -1.0 / 39916800.0 + x2 * p
    p = 1.0 / 362880.0 + x2 * p
    p = -1.0 / 5040.0 + x2 * p
    p = 1.0 / 120.0 + x2 * p
    p = -1.0 / 6.0 + x2 * p
    p = 1.0 + x2 * p
    return x * p
}

// ---------- cos：同样归约后折到 [0,π/2]，11 项 Horner ----------
func my_cos(float x): float {
    var k = _int(x / TWO_PI)
    x = x - _float(k) * TWO_PI
    while x > PI {
        x = x - TWO_PI
    }
    while x < -PI {
        x = x + TWO_PI
    }
    if x < 0.0 {
        x = -x
    }
    var sign = 1.0
    if x > HALF_PI {
        x = PI - x
        sign = -1.0
    }
    var x2 = x * x
    var p = -1.0 / 1124000727777607680000.0
    p = 1.0 / 2432902008176640000.0 + x2 * p
    p = -1.0 / 6402373705728000.0 + x2 * p
    p = 1.0 / 20922789888000.0 + x2 * p
    p = -1.0 / 87178291200.0 + x2 * p
    p = 1.0 / 479001600.0 + x2 * p
    p = -1.0 / 3628800.0 + x2 * p
    p = 1.0 / 40320.0 + x2 * p
    p = -1.0 / 720.0 + x2 * p
    p = 1.0 / 24.0 + x2 * p
    p = -1.0 / 2.0 + x2 * p
    p = 1.0 + x2 * p
    return sign * p
}

// ---------- log：多档折出 x = m·2^e (m∈[1,2))，再求和 atanh 级数到 z^29 ----------
func my_log(float x): float {
    if x <= 0.0 {
        return -1.0e308
    }
    var e = 0
    var m = x
    while m >= 65536.0 {
        m = m * 1.52587890625e-05
        e = e + 16
    }
    while m >= 256.0 {
        m = m * 0.00390625
        e = e + 8
    }
    while m >= 16.0 {
        m = m * 0.0625
        e = e + 4
    }
    while m >= 4.0 {
        m = m * 0.25
        e = e + 2
    }
    while m >= 2.0 {
        m = m * 0.5
        e = e + 1
    }
    while m < 1.0 {
        m = m * 2.0
        e = e - 1
    }
    var z = (m - 1.0) / (m + 1.0)
    var z2 = z * z
    var term = z
    var sum = z
    var k = 3
    while k <= 29 {
        term = term * z2
        sum = sum + term / _float(k)
        k = k + 2
    }
    return 2.0 * sum + _float(e) * LN2
}

// ---------- 两套负载 ----------
func run_builtin(int n): float {
    var result = 0.0
    for 1 : n to i {
        result = result + maths.sin(i) * maths.cos(i)
        result = result + maths.sqrt(i)
        result = result + maths.log(i)
    }
    return result
}

func run_manual(int n): float {
    var result = 0.0
    for 1 : n to i {
        var x = _float(i)
        result = result + my_sin(x) * my_cos(x)
        result = result + my_sqrt(x)
        result = result + my_log(x)
    }
    return result
}

main() {
    int n = 50000000

    // ---- 先核对四个手写函数的精度（err 应在 1e-16 量级） ----
    var chk = [0.5, 1.0, 2.0, 3.5, 7.25, 100.0]
    for 0 : chk.len() - 1 to j {
        var v = chk[j]
        print("x=" + _str(v) + "  sin err=" + _str(my_sin(v) - maths.sin(v)) + "  cos err=" + _str(my_cos(v) - maths.cos(v)) + "  sqrt err=" + _str(my_sqrt(v) - maths.sqrt(v)) + "  log err=" + _str(my_log(v) - maths.log(v)))
    }
    print("")

    print("负载: " + _str(n) + " 次循环，每次 sin*cos + sqrt + log")

    var t0 = times.ms()
    var r1 = run_builtin(n)
    var t1 = times.ms()
    print("maths  版: " + _str((t1 - t0) / 1000.0) + " 秒   result=" + _str(r1))

    t0 = times.ms()
    var r2 = run_manual(n)
    t1 = times.ms()
    print("纯手写 版: " + _str((t1 - t0) / 1000.0) + " 秒   result=" + _str(r2))

    print("result 差: " + _str(r2 - r1))
}
