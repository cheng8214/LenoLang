import times

main()
{
    var t1 = times.ms()
    for 100000000
    {
    }
    var t2 = times.ms()
    print("空for循环: " + (t2-t1) + "ms")

    t1 = times.ms()
    for 100000000
    {
        var x = 1
    }
    t2 = times.ms()
    print("for+const: " + (t2-t1) + "ms")

    t1 = times.ms()
    var sum = 0
    for 100000000
    {
        sum = 1
    }
    t2 = times.ms()
    print("for+assign: " + (t2-t1) + "ms")
    print(sum)
}
