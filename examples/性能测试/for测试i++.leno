import times
main()
{
	var t1=times.ms()
	var i=0
	for 10000000
	{
		i++
	}
	var t2=times.ms()
	print("i++:"+(t2-t1)+"ms")
	
	t1=times.ms()
	i=0
	for 10000000
	{
		i+=1
	}
	t2=times.ms()
	print("i+=1:"+(t2-t1)+"ms")
	
	t1=times.ms()
	i=0
	for 10000000
	{
		i=i+1
	}
	t2=times.ms()
	print("i=i+1:"+(t2-t1)+"ms")
}