import times

func empty() {}
func simple(): int { return 1 }

main()
{
    var t1 = times.ms()
    for 100000000
    {
        empty()
    }
    var t2 = times.ms()
    print("空函数调用: " + (t2-t1) + "ms")

    t1 = times.ms()
    var sum = 0
    for 100000000
    {
        sum = simple()
    }
    t2 = times.ms()
    print("带返回值: " + (t2-t1) + "ms")
    print(sum)
}
