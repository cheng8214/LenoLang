// 调试 for + defer 循环变量

var log = []

func add(string s) {
    log.add(s)
}

print("=== 有 defer ===")
for 0:3 to i {
    defer add("defer")
    print("i = " + i)
    if i == 1 {
        print("breaking!")
        break
    }
    print("after if")
}
print("after loop, log=" + log)

print("\n=== 无 defer 对照 ===")
for 0:3 to i {
    print("i = " + i)
    if i == 1 {
        print("breaking!")
        break
    }
    print("after if")
}
print("after loop")
