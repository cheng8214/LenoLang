// 测试切片操作后是否保持原有数组类型
// 预期：切片应返回同类型数组，可直接赋值给同类型变量
// 实际：切片返回 any，赋值给具体类型变量时报类型不匹配

main() {
    Array[int] arr = [10, 20, 30, 40, 50, 60, 70, 80]
    print("=== 测试1: 切片赋值给同类型变量 ===")
    // 直接赋值——如果切片保持类型应成功
    Array[int] sliced = arr[2 : 5]   // 预期取 [30, 40, 50, 60]
    print("arr[2:5] 长度: " + sliced.len())   // 预期 4
    print("arr[2:5] 内容: " + sliced)
    
    print("")
    print("=== 测试2: 切片后调用数组方法 ===")
    // 切片后直接调 .len()——如果类型是 any 应报错
    print("arr[:3].len() = " + arr[:3].len())    // 预期 4 (0,1,2,3)
    print("arr[5:].len() = " + arr[5:].len())    // 预期 3 (5,6,7)
    
    print("")
    print("=== 测试3: 字符串数组切片 ===")
    Array[string] strs = ["aa", "bb", "cc", "dd", "ee"]
    Array[string] s2 = strs[1 : 3]   // 预期 ["bb", "cc", "dd"]
    print("strs[1:3] 长度: " + s2.len())  // 预期 3
    print("strs[1:3] 内容: " + s2)
    
    print("")
    print("=== 测试4: 切片嵌套切片 ===")
    Array[int] inner = arr[2 : 6]    // [30,40,50,60,70]
    Array[int] nested = inner[1 : 3] // [40,50,60]
    print("嵌套切片内容: " + nested)
    print("嵌套切片长度: " + nested.len())  // 预期 3
}
