// 测试字符串切片功能
// 字符串切片使用 str[start:end] 语法，结束索引为包含（与数组切片一致）
// 索引为 UTF-8 字符级，正确处理中文

main() {
    // 基本切片测试
    var s = "Hello,World"
    print("原始字符串: " + s)
    print("s[0:4] 切片: " + s[0:4])     // "Hello"（包含索引4）
    print("s[6:10] 切片: " + s[6:10])   // "World"（包含索引10）
    
    // 省略起始索引
    print("s[:4] 切片: " + s[:4])       // "Hello"
    
    // 省略结束索引
    print("s[6:] 切片: " + s[6:])       // "World"
    
    // 中文 UTF-8 切片测试
    var cn = "你好，世界"
    print("原始中文字符串: " + cn)
    print("cn[0:1] 切片: " + cn[0:1])   // "你好"（包含索引1）
    print("cn[0:2] 切片: " + cn[0:2])   // "你好，"
    print("cn[3:4] 切片: " + cn[3:4])   // "世界"（包含索引4）
    print("cn[3:] 切片: " + cn[3:])     // "世界"
    print("cn[:2] 切片: " + cn[:2])     // "你好，"
    
    // 边界测试
    print("s[0:0] 切片: " + s[0:0])     // "H"（单个字符）
    print("s[0:100] 切片: " + s[0:100]) // 整个字符串（end越界自动截断）
    print("s[100:200] 切片: " + s[100:200]) // 空字符串（start越界）
    
    // 混合中英文
    var mix = "Hi你好"
    print("原始混合字符串: " + mix)
    print("mix[0:1] 切片: " + mix[0:1]) // "Hi"（包含索引1）
    print("mix[2:3] 切片: " + mix[2:3]) // "你好"
    print("mix[2:] 切片: " + mix[2:])   // "你好"
}
