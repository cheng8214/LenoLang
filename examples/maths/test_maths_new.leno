// 快速测试新增 maths 函数
import maths

print("=== maths 新增函数测试 ===")

// fmod
print("fmod(10.5, 3.0) = " + maths.fmod(10.5, 3.0))  // 1.5
print("fmod(7.0, 2.0) = " + maths.fmod(7.0, 2.0))     // 1.0

// clamp
print("clamp(5.0, 0.0, 10.0) = " + maths.clamp(5.0, 0.0, 10.0))   // 5
print("clamp(-3.0, 0.0, 10.0) = " + maths.clamp(-3.0, 0.0, 10.0)) // 0
print("clamp(15.0, 0.0, 10.0) = " + maths.clamp(15.0, 0.0, 10.0))  // 10

// lerp
print("lerp(0.0, 100.0, 0.5) = " + maths.lerp(0.0, 100.0, 0.5))   // 50
print("lerp(10.0, 20.0, 0.3) = " + maths.lerp(10.0, 20.0, 0.3))   // 13

// rsqrt
print("rsqrt(4.0) = " + maths.rsqrt(4.0))    // 0.5
print("rsqrt(1.0) = " + maths.rsqrt(1.0))    // 1.0
print("rsqrt(16.0) = " + maths.rsqrt(16.0))  // 0.25

// hypot
print("hypot(3.0, 4.0) = " + maths.hypot(3.0, 4.0))  // 5
print("hypot(5.0, 12.0) = " + maths.hypot(5.0, 12.0)) // 13

// log2
print("log2(8.0) = " + maths.log2(8.0))    // 3
print("log2(1024.0) = " + maths.log2(1024.0)) // 10

// sin_fast vs sin
print("sin(1.5707) = " + maths.sin(1.5707))       // ≈1.0
print("sin_fast(1.5707) = " + maths.sin_fast(1.5707)) // ≈1.0
print("sin(0.0) = " + maths.sin(0.0))              // 0
print("sin_fast(0.0) = " + maths.sin_fast(0.0))    // 0

// cos_fast vs cos
print("cos(0.0) = " + maths.cos(0.0))              // 1
print("cos_fast(0.0) = " + maths.cos_fast(0.0))    // 1
print("cos(3.14159) = " + maths.cos(3.14159))       // ≈-1
print("cos_fast(3.14159) = " + maths.cos_fast(3.14159)) // ≈-1

// 实例方法
print("3.0.hypot(4.0) = " + 3.0.hypot(4.0))      // 5
print("5.0.clamp(0.0, 3.0) = " + 5.0.clamp(0.0, 3.0))  // 3

print("=== 测试完成 ===")
