// 精确定位 for + break + defer 的问题

var log = []

func add(string s) {
    log.add(s)
}

// 测试 1: for + defer + break 直接在循环体（无 if 包裹）
print("=== 测试 1: for + defer + break (无if) ===")
log = []
for 0:3 to i {
    defer add("defer")
    add("iter-" + i)
    break
}
add("after")
print("  结果: " + log)
print("  预期: [iter-0, defer, after]")

// 测试 2: for + defer 无 break
print("\n=== 测试 2: for + defer 无 break ===")
log = []
for 0:2 to i {
    defer add("defer")
    add("iter-" + i)
}
add("after")
print("  结果: " + log)
print("  预期: [iter-0, defer, iter-1, defer, iter-2, defer, after]")

// 测试 3: for 无 defer + break
print("\n=== 测试 3: for 无 defer + break ===")
log = []
for 0:3 to i {
    add("iter-" + i)
    break
}
add("after")
print("  结果: " + log)
print("  预期: [iter-0, after]")

// 测试 4: while + defer + break (对照)
print("\n=== 测试 4: while + defer + break (对照) ===")
log = []
var j = 0
while j < 3 {
    defer add("defer")
    add("iter-" + j)
    break
}
add("after")
print("  结果: " + log)
print("  预期: [iter-0, defer, after]")
