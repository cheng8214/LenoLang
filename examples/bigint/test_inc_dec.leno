main() 
{ 
    print("自增自减 BigInt 测试:")
    
    // 测试 1: 普通整数自增
    var x = 5
    x++
    print("5++ = " + x)
    
    // 测试 2: BigInt 自增
    var big = 9999999999999999999
    big++
    print("9999999999999999999++ = " + big)
    
    // 测试 3: BigInt 自减
    var big2 = 10000000000000000000
    big2--
    print("10000000000000000000-- = " + big2)
    
    // 测试 4: 负数 BigInt 自增
    var neg_big = -9999999999999999999
    neg_big++
    print("-9999999999999999999++ = " + neg_big)
    
    print("")
    print("所有测试完成!")
}
