main() 
{ 
    print("自增自减测试:")
    
    // 测试 1: 普通整数自增
    int x = 5
    x++
    print("5++ = " + x)
    
    // 测试 2: 大整数自增
    int big = 9999999999999999999
    big++
    print("9999999999999999999++ = " + big)
    print("type(big) = " + type(big))
    
    // 测试 3: 大整数自减
    int big2 = 10000000000000000000
    big2--
    print("10000000000000000000-- = " + big2)
    
    // 测试 4: 负数大整数自增
    int neg_big = -9999999999999999999
    neg_big++
    print("-9999999999999999999++ = " + neg_big)
    
    print("")
    print("所有测试完成!")
}
