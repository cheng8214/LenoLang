main() 
{ 
    print("测试 3:")
    int big2 = 12345678901234567890
    int divisor = 1000000000
    int mod_result = big2 % divisor
    print("mod_result = " + mod_result)
    print("预期 = 234567890")
    
    // 测试 4: 普通整数取模
    print("")
    int big3 = 123456789
    int result2 = big3 % 100
    print("123456789 % 100 = " + result2)
    print("预期 = 89")
}
