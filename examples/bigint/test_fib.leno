import times as time 

func fib_iterative(int n) { 
    if n <= 1 { 
        return n 
    } 
    var a = 0 
    var b = 1 
    for 2:n to var i { 
        var temp = a + b 
        a = b 
        b = temp 
    } 
    return b 
} 

main() { 
    print("斐波那契数列测试:")
    print("fib(30) = " + fib_iterative(30))
    print("")
    print("fib(1000) = ")
    var t1 = time.ms()
    var result = fib_iterative(1000)
    var t2 = time.ms()
    print(result)
    print("")
    print("耗时: " + (t2 - t1) + "ms")
    print("")
    print("注意: fib(1000) 应该是 209 位的数字")
}
