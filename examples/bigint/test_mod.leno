main() 
{ 
    int big1 = 999999999999999999999999999999 
    int big2 = 12345678901234567890 
    
    print("big1 = " + big1) 
    print("big2 = " + big2) 
    print("type(big1) = " + type(big1))
    
    int mod_result = big1 % big2 
    print("big1 % big2 = " + mod_result) 
    print("") 
    print("正确结果应该是: 81910000008189")
}
