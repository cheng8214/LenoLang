// 测试超大数取模

main()
{
    print("======== 超大数取模测试 ========")
    print("")
    
    // 测试1: 小数字取模（应该正确）
    print("--- 测试1: 小数字取模 ---")
    var a1 = 1234567890123456789
    var b1 = 100
    var r1 = a1 % b1
    print($"{a1} % {b1} = {r1}, 期望: 89")
    
    // 测试2: 超大数取模
    print("")
    print("--- 测试2: 超大数取模 ---")
    // 超过 int64 范围的大数
    var big_a = 1234567890123456789012345678901234567890
    var big_b = 100
    var r2 = big_a % big_b
    print($"超大数 % 100 = {r2}")
    print("注意：超大数取模可能返回近似值")
    
    // 测试3: 超大数取模的正确性验证
    print("")
    print("--- 测试3: 验证超大数取模 ---")
    // 使用数学性质验证：(a * b + c) % b == c
    var base = 123456789012345678901234567890
    var divisor = 7
    var remainder = 3
    var dividend = base * divisor + remainder
    var result = dividend % divisor
    print($"({base} * {divisor} + {remainder}) % {divisor} = {result}")
    print($"期望: {remainder}")
    
    if result == remainder
    {
        print("测试通过!")
    }
    else
    {
        print("测试失败! 超大数取模结果不正确")
    }
    
    print("")
    print("======== 测试完成 ========")
}
