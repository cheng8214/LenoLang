main()
{
    print("=== 测试移位溢出修复 ===")
    print("")
    
    // 1. 小移位（< 32）- 应该走 int 路径
    print("1. 小移位 (< 32):")
    int a = 1 << 10
    print($"   1 << 10 = {a}")
    
    // 2. 大移位（>= 32）- 应该自动使用 int（底层 BigInt）
    print("")
    print("2. 大移位 (>= 32):")
    int b = 1 << 32
    print($"   1 << 32 = {b}")
    print($"   type: " + type(b))
    
    int c = 1 << 64
    print($"   1 << 64 = {c}")
    
    int d = 1 << 100
    print($"   1 << 100 = {d}")
    
    // 验证 1 << 100 的正确值
    // 2^100 = 1267650600228229401496703205376
    int expected = 1267650600228229401496703205376
    if d == expected {
        print("   ✓ 1 << 100 正确!")
    } else {
        print($"   期望: {expected}")
    }
    
    // 3. 超大位移
    print("")
    print("3. 超大位移 (1 << 1000):")
    int e = 1 << 1000
    print($"   1 << 1000 = {e}")
    
    print("")
    print("=== 测试完成 ===")
}
