// 测试2: 泛型 struct 嵌套 - 简化版
import "generic_module2.leno" as gm
use gm.Box

// 嵌套泛型: Box 里放 Box
var inner = new Box[int](value=42)
var outer = new Box[Box[int]](value=inner)

// outer.get() 返回 inner，可以访问字段
var innerResult = outer.get()
// innerResult 类型被擦除，需要 as 转型才能调用方法
var innerBox = innerResult as Box[int]
assert(innerBox.get() == 42)

// type() 测试
var t = type(outer)
print("type(outer) = " + t)

print("test_generic_nested: PASSED with as cast")
