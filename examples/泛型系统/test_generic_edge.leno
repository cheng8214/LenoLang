// ======================================
// 泛型边界测试 - 全面
// ======================================

// 1. 泛型调用泛型，类型参数链式传播
func chain1[T](T val):Array[T] {
    var result = []
    result.add(val)
    return result
}
func chain2[T](T val):Array[T] {
    return chain1(val)   // 泛型调泛型
}

// 2. 嵌套容器泛型 Array[Array[T]]
func flatten[T](Array[Array[T]] arr):Array[T] {
    var result = []
    for arr to row {
        for row to item {
            result.add(item)
        }
    }
    return result
}

// 3. 多个泛型函数共用同一文件
func first[T](Array[T] arr):T {
    return arr[0]
}
func last[T](Array[T] arr):T {
    return arr[arr.len() - 1]
}
func swap[T, U](T a, U b) {
    print("swap: " + type(a) + " <-> " + type(b))
}

// 4. 泛型函数作为参数传给泛型函数
func twice[T](func(T):T fn, T val):T {
    return fn(fn(val))
}
func add_one(int x):int { return x + 1 }

// 5. 泛型默认参数（类型参数不影响默认参数）
func with_default[T](T val, int count = 1) {
    for 0:count to i {
        print(val)
    }
}

// 6. 单字母和多字母类型参数
func fold[T, Acc](Array[T] arr, Acc init, func(Acc, T):Acc fn):Acc {
    var acc = init
    for arr to item {
        acc = fn(acc, item)
    }
    return acc
}

// 7. 空数组在泛型上下文中
func unwrap[T](T val):T {
    return val
}

// 8. 泛型函数多次调用不同类型
func box[T](T val) {
    print(type(val))
}

// 9. Any 类型与泛型混合
func passthrough[T](var val):T {
    return val
}

// fold 的加法函数
func sum_acc(int acc, int item):int { return acc + item }

// 闭包中使用泛型
func make_mapper[T](T multiplier):func(T):T {
    if type(multiplier) == "int" {
        func mapper(T x):T {
            return multiplier + x
        }
        return mapper
    }
    return null
}

main() {
    // 测试 chain
    var c = chain2(42)
    print(c)                    // [42]
    print(c[0])                 // 42
    
    // 测试 first/last
    var arr = [10, 20, 30, 40]
    print(first(arr))           // 10
    print(last(arr))            // 40
    
    // 测试 swap
    swap(10, "hi")
    
    // 测试 flatten
    var matrix = [[1, 2], [3, 4], [5, 6]]
    var flat = flatten(matrix)
    print(flat)                 // [1, 2, 3, 4, 5, 6]
    
    // 测试 twice
    print(twice(add_one, 5))    // 7 (5+1+1)
    
    // 测试 with_default
    with_default("Leno", 2)     // Leno Leno
    
    // 测试 fold
    var nums = [1, 2, 3, 4]
    print(fold(nums, 0, sum_acc))  // 10
    
    // 测试 unwrap 多次调用
    print(unwrap(42))
    print(unwrap("text"))
    print(unwrap(true))
    
    // 测试 box 多次不同类型
    box(100)
    box("string")
    box(3.14)
    
    // 测试 passthrough
    print(type(passthrough(42)))
}
