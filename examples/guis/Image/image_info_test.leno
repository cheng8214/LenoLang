// encoding: UTF-8
import guis
import io

main() {
    print($"=== guis.image_info() 测试 ===")
    print($"")

    // 测试图片路径
    var png_path = "D:\\CLeno\\LenoC\\icons\\leno_logo.png"
    var jpg_path = "D:\\CLeno\\LenoC\\icons\\leno_logo_2.jpg"
    var not_exist_path = "D:\\CLeno\\LenoC\\icons\\not_exist.png"

    // 1. 测试 PNG 图片信息
    print($"1. 测试 PNG 图片信息:")
    var png_info = guis.image_info(png_path)
    if png_info != null {
        print($"   路径: {png_path}")
        print($"   宽度: {png_info.width}")
        print($"   高度: {png_info.height}")
        print($"   通道: {png_info.channels}")
        print($"   ✓ 成功获取 PNG 信息")
    } else {
        print($"   ✗ 获取 PNG 信息失败")
    }
    print($"")

    // 2. 测试 JPG 图片信息
    print($"2. 测试 JPG 图片信息:")
    var jpg_info = guis.image_info(jpg_path)
    if jpg_info != null {
        print($"   路径: {jpg_path}")
        print($"   宽度: {jpg_info.width}")
        print($"   高度: {jpg_info.height}")
        print($"   通道: {jpg_info.channels}")
        print($"   ✓ 成功获取 JPG 信息")
    } else {
        print($"   ✗ 获取 JPG 信息失败")
    }
    print($"")

    // 3. 测试不存在的图片
    print($"3. 测试不存在的图片:")
    var not_exist_info = guis.image_info(not_exist_path)
    if not_exist_info == null {
        print($"   路径: {not_exist_path}")
        print($"   ✓ 正确返回 null")
    } else {
        print($"   ✗ 应该返回 null，但没有")
    }
    print($"")

    // 4. 对比 image_info 和实际加载后的尺寸
    print($"4. 对比 image_info 和实际加载后的尺寸:")
    var img = guis.load_image(png_path)
    if img != null {
        var info = guis.image_info(png_path)
        print($"   image_info 宽度: {info.width}, 实际宽度: {img.width()}")
        print($"   image_info 高度: {info.height}, 实际高度: {img.height()}")
        if info.width == img.width() and info.height == img.height() {
            print($"   ✓ 尺寸一致")
        } else {
            print($"   ✗ 尺寸不一致")
        }
        img.close()
    } else {
        print($"   ✗ 加载图片失败")
    }
    print($"")

    print($"=== 测试完成 ===")
}
