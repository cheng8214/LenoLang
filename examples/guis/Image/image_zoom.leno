import guis

main() {
    Style[window] w_style = {
        width: 800,
        height: 600,
        resizable: true
    }
    Win win = guis.create_window("LenoC GUI - Image Zoom", w_style)

    Image img = guis.load_image("D:\CLeno\LenoC\icons\leno_logo.png")
    if img == null {
        print("加载图片失败")
        return
    }

    int img_w = img.width()
    int img_h = img.height()
    print("Image size:", img_w, "x", img_h)

    // 缩放因子，1.0 = 原始大小
    var scale = 1.0
    var min_scale = 0.1
    var max_scale = 5.0

    win.run(
        func(Draw ren) {
            ren.set_color(_rgb(30, 30, 46, 255))
            ren.clear()

            // 计算缩放后的尺寸
            var dw = _int(img_w * scale)
            var dh =_int(img_h * scale)

            // 用窗口大小居中
            var win_w = 800
            var win_h = 600
            var dx = (win_w - dw) / 2
            var dy = (win_h - dh) / 2

            ren.set_color(_rgb(255, 255, 255, 255))
            img.draw_scaled(ren, dx, dy, dw, dh)

            // 显示缩放比例信息
            var font = guis.load_font("SimSun", 16)
            var info = "缩放: " + _str(scale * 100.0) + "%"
            ren.set_color(_rgb(255, 255, 255, 255))
            ren.draw_text(font, info, 10, 10)
            font.close()

            ren.present()
        },
        func(Event e) {
            if e.is_quit() or e.is_window_close() {
                win.set_should_close(true)
            }
            if e.is_key_down() and e.key() == 0x1B {
                win.set_should_close(true)
            }
            if e.is_mouse_wheel() {
                var wy = e.wheel_y()
                if wy > 0 {
                    scale = scale * 1.1
                    if scale > max_scale {
                        scale = max_scale
                    }
                }
                if wy < 0 {
                    scale = scale * 0.9
                    if scale < min_scale {
                        scale = min_scale
                    }
                }
            }
        }
    )

    img.close()
    win.close()
    print("image zoom test done!")
}
