// Leno GUI 精灵动画测试
// 测试 image.draw_src() 方法实现精灵动画效果

import guis

main() {
    Win win = guis.create_window("Sprite Animation Test", {
        width: 800,
        height: 600
    })
    
    // 创建一个简单的精灵表 - 使用纯色块模拟不同帧
    // 由于没有现成的精灵表图片，我们用程序生成一个测试图像
    // 实际项目中应该使用 guis.load_image("assets/character.png")
    
    // 为了测试，我们先尝试加载一个可能存在的图片
    // 如果不存在，就用彩色矩形代替精灵动画
    
    var test_img = guis.load_image("test_sprite.png")
    var has_image = test_img != null
    
    // 精灵动画参数
    var frame_w = 64
    var frame_h = 64
    var frame_count = 8
    var current_frame = 0
    var anim_timer = 0
    var anim_speed = 5  // 每5帧切换一次
    
    // 模拟精灵位置
    var sprite_x = 368  // 居中
    var sprite_y = 268
    
    // 移动方向
    var move_x = 2
    
    win.run(
        func(Draw ren) {
            // 清空背景
            ren.set_color(_rgb(40, 40, 60, 255))
            ren.clear()
            
            // 更新动画帧
            anim_timer = anim_timer + 1
            if anim_timer >= anim_speed {
                anim_timer = 0
                current_frame = (current_frame + 1) % frame_count
            }
            
            // 移动精灵
            sprite_x = sprite_x + move_x
            if sprite_x > 700 or sprite_x < 50 {
                move_x = -move_x  // 碰到边界反弹
            }
            
            // 绘制地面
            ren.set_color(_rgb(80, 120, 80, 255))
            ren.fill_rect(0, 450, 800, 150)
            
            // 绘制精灵（使用不同颜色的矩形模拟不同帧）
            // 每帧使用不同的颜色来模拟动画效果
            var colors = [
                _rgb(255, 100, 100, 255),  // 红
                _rgb(255, 150, 100, 255),  // 橙
                _rgb(255, 255, 100, 255),  // 黄
                _rgb(100, 255, 100, 255),  // 绿
                _rgb(100, 255, 255, 255),  // 青
                _rgb(100, 100, 255, 255),  // 蓝
                _rgb(255, 100, 255, 255),  // 紫
                _rgb(255, 255, 255, 255)   // 白
            ]
            
            // 绘制精灵主体
            ren.set_color(colors[current_frame])
            ren.fill_rect(sprite_x, sprite_y, frame_w, frame_h)
            
            // 绘制精灵边框
            ren.set_color(_rgb(0, 0, 0, 255))
            ren.rect(sprite_x, sprite_y, frame_w, frame_h)
            
            // 绘制眼睛（根据方向）
            ren.set_color(_rgb(0, 0, 0, 255))
            if move_x > 0 {
                // 向右看
                ren.fill_rect(sprite_x + 40, sprite_y + 15, 10, 10)
                ren.fill_rect(sprite_x + 40, sprite_y + 35, 10, 10)
            } else {
                // 向左看
                ren.fill_rect(sprite_x + 14, sprite_y + 15, 10, 10)
                ren.fill_rect(sprite_x + 14, sprite_y + 35, 10, 10)
            }
            
            // 显示帧信息
            // 使用矩形绘制简单的文字显示区域
            ren.set_color(_rgb(20, 20, 30, 200))
            ren.fill_rect(10, 10, 200, 80)
            
            ren.set_color(_rgb(255, 255, 255, 255))
            // 绘制当前帧指示器
            for 0:frame_count to i {
                if i == current_frame {
                    ren.set_color(_rgb(255, 255, 0, 255))
                    ren.fill_rect(20 + i * 22, 20, 18, 18)
                } else {
                    ren.set_color(_rgb(100, 100, 100, 255))
                    ren.fill_rect(20 + i * 22, 20, 18, 18)
                }
            }
            
            // 绘制说明
            ren.set_color(_rgb(200, 200, 200, 255))
            ren.fill_rect(20, 50, 10, 10)  // 模拟文字
            
            // 如果有图片，尝试绘制图片的一部分
            if has_image {
                // 测试 draw_src 方法
                var img_w = test_img.width()
                var img_h = test_img.height()
                
                // 从图片中截取一小部分绘制到右上角
                if img_w > 32 and img_h > 32 {
                    test_img.draw_src(ren, 0, 0, 32, 32, 750, 10, 32, 32)
                }
            }
            
            ren.present()
        },
        func(Event e) {
            if e.is_quit() or e.is_window_close() {
                win.set_should_close(true)
            }
            
            // 测试：打印所有按键事件
            if e.is_key_down() {
                print("Key down: " + e.key())
            }
            
            // 按空格加速动画
            if e.is_key_down() and e.key() == guis.KEY_SPACE {
                print("Space pressed!")
                anim_speed = if anim_speed == 5 then 2 else 5
            }
            
            // 按方向键控制移动速度
            if e.is_key_down() {
                var key = e.key()
                if key == guis.KEY_RIGHT {
                    print("Right arrow!")
                    move_x = 4
                }
                if key == guis.KEY_LEFT {
                    print("Left arrow!")
                    move_x = -4
                }
            }
            
            // 鼠标点击测试
            if e.is_mouse_down() {
                print("Mouse clicked at: " + e.mouse_x() + ", " + e.mouse_y())
            }
        }
    )
    
    if has_image {
        test_img.close()
    }
    win.close()
}
