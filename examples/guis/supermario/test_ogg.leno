import "LenoMusic" as audio
import dirs

main() {
    var path = dirs.script_dir()
    var s = audio.createSound(path + "/resources/sound/coin.ogg")
    print("coin dur=" + s.getDuration())

    // 测试1: 快速连续播放（模拟连续顶砖）
    print("--- 连续播放 ---")
    for 0:4 to i {
        s.seek(0)
        s.play()
        sleep(200)
    }
    sleep(1500)

    // 测试2: 同时加载多个音效并播放
    print("--- 多音效同时 ---")
    var bump = audio.createSound(path + "/resources/sound/bump.ogg")
    var jump = audio.createSound(path + "/resources/sound/small_jump.ogg")
    var stomp = audio.createSound(path + "/resources/sound/stomp.ogg")

    bump.seek(0); bump.play()
    sleep(100)
    jump.seek(0); jump.play()
    sleep(100)
    stomp.seek(0); stomp.play()
    sleep(100)
    s.seek(0); s.play()
    sleep(2000)

    // 测试3: 播放后立刻检查状态
    print("--- 播放后检查 ---")
    var t = audio.createSound(path + "/resources/sound/coin.ogg")
    t.play()
    print("playing=" + t.isPlaying())
    sleep(500)
    print("playing=" + t.isPlaying())
    sleep(1000)
    print("playing=" + t.isPlaying())

    bump.uninit()
    jump.uninit()
    stomp.uninit()
    s.uninit()
    t.uninit()
    print("done")
}
