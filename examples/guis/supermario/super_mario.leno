// ============================================================
// 超级玛丽 Bros - Leno 语言版
// 使用真实精灵表渲染
// ============================================================
import guis
import times
import maths
import string_utils

// ===== 精灵表区域定义 =====
// sprite sheet 中精灵的源矩形坐标 (sx, sy, w, h)
// 使用典型的 SMB 精灵表布局，可能需要根据实际图片调整

struct Sprite {
    int sx; int sy; int w; int h
}

func make_sprite(int sx, int sy, int w, int h): Sprite {
    return new Sprite(sx=sx, sy=sy, w=w, h=h)
}

// ---- Mario sprites (mario_bros.png 384x528, 精灵从sx=80,sy=16开始) ----
var MARIO_SMALL_STAND_R = make_sprite(80,  16, 16, 16)
var MARIO_SMALL_STAND_L = make_sprite(96,  16, 16, 16)
var MARIO_SMALL_WALK1_R = make_sprite(112, 16, 16, 16)
var MARIO_SMALL_WALK1_L = make_sprite(128, 16, 16, 16)
var MARIO_SMALL_WALK2_R = make_sprite(144, 16, 16, 16)
var MARIO_SMALL_WALK2_L = make_sprite(160, 16, 16, 16)
var MARIO_SMALL_JUMP_R = make_sprite(176, 16, 16, 16)
var MARIO_SMALL_JUMP_L = make_sprite(192, 16, 16, 16)

var MARIO_BIG_STAND_R  = make_sprite(80,  32, 16, 32)
var MARIO_BIG_STAND_L  = make_sprite(96,  32, 16, 32)
var MARIO_BIG_WALK1_R  = make_sprite(112, 32, 16, 32)
var MARIO_BIG_WALK1_L  = make_sprite(128, 32, 16, 32)
var MARIO_BIG_WALK2_R  = make_sprite(144, 32, 16, 32)
var MARIO_BIG_WALK2_L  = make_sprite(160, 32, 16, 32)
var MARIO_BIG_JUMP_R   = make_sprite(176, 32, 16, 32)
var MARIO_BIG_JUMP_L   = make_sprite(192, 32, 16, 32)

// ---- 敌人 sprites (enemies.png / smb_enemies_sheet.png) ----
// Goomba / 栗子头
var ENEMY_GOOMBA_WALK1 = make_sprite(0, 4, 16, 16)
var ENEMY_GOOMBA_WALK2 = make_sprite(16, 4, 16, 16)
var ENEMY_GOOMBA_FLAT  = make_sprite(32, 4, 16, 8)

// ---- 地图 tile sprites (tile_set.png) ----
// 16x16 tiles in a 8-column grid
var TILE_GROUND      = make_sprite(0, 0, 16, 16)
var TILE_GROUND_TOP  = make_sprite(16, 0, 16, 16)
var TILE_BRICK       = make_sprite(32, 0, 16, 16)
var TILE_QUESTION_1  = make_sprite(48, 0, 16, 16)
var TILE_QUESTION_2  = make_sprite(64, 0, 16, 16)
var TILE_QUESTION_3  = make_sprite(80, 0, 16, 16)
var TILE_QUESTION_EMPTY = make_sprite(96, 0, 16, 16)
var TILE_PIPE_TL  = make_sprite(0, 16, 16, 16)
var TILE_PIPE_TR  = make_sprite(16, 16, 16, 16)
var TILE_PIPE_BL  = make_sprite(0, 32, 16, 16)
var TILE_PIPE_BR  = make_sprite(16, 32, 16, 16)

// ---- 物品 sprites (item_objects.png) ----
var ITEM_COIN_1  = make_sprite(0, 0, 8, 16)
var ITEM_COIN_2  = make_sprite(8, 0, 8, 16)
var ITEM_COIN_3  = make_sprite(16, 0, 8, 16)

// ===== 常量 =====
var SPRITE_SCALE = 3
var TILE_SIZE = 16
var MAP_ROWS = 23
var MAP_COLS = 80
var GROUND_ROW = MAP_ROWS - 2

// ===== 数据结构 =====

struct Player {
    int x; int y
    int w = 16 * SPRITE_SCALE; int h = 16 * SPRITE_SCALE   // 小马里奥 16px 高
    int vx = 0; int vy = 0
    int speed = 4
    int jump_power = -16
    bool on_ground = true
    bool facing_right = true
    bool is_big = false
    
    int walk_frame = 0
    int walk_timer = 0
    
    int invincible_timer = 0
    int lives = 3
    int coins = 0
    int score = 0
}

struct Enemy {
    int x; int y
    int w = 16 * SPRITE_SCALE; int h = 16 * SPRITE_SCALE
    int speed = 1
    bool dead = false
    int dead_timer = 0
    bool on_ground = true
    int vy = 0
    int walk_frame = 0; int walk_timer = 0
}

struct Coin {
    int x; int y
    int w = 12; int h = 16
    bool collected = false
    int anim_frame = 0
}

