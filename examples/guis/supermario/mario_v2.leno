// 马里奥 v2 - 更合理的经典第一关风格关卡
import guis
import times
import dirs
import maths
import "LenoMusic" as audio

main() {
    GWin win = guis.create_window("Mario", {width: 800, height: 600})
    var path = dirs.script_dir()
    GImage img = guis.load_image(path+"/resources/graphics/mario_bros.png")
    GImage tile = guis.load_image(path+"/resources/graphics/tile_set.png")
    GImage items = guis.load_image(path+"/resources/graphics/item_objects.png")
    GImage enemy_img = guis.load_image(path+"/resources/graphics/smb_enemies_sheet.png")
    GFont font = guis.load_font("Consolas", 18)

    // 背景音乐和音效
    var music_path = path + "/resources/music/main_theme.mp3"
    var death_path = path + "/resources/music/death.mp3"
    var clear_path = path + "/resources/music/stage_clear.mp3"
    var music = audio.createSound(music_path)
    var death_sound = audio.createSound(death_path)
    var clear_sound = audio.createSound(clear_path)
    if music.isInit() { music.play() }

    // 音效
    var snd_coin  = audio.createSound(path + "/resources/sound/coin.ogg")
    var snd_bump  = audio.createSound(path + "/resources/sound/bump.ogg")
    var snd_jump  = audio.createSound(path + "/resources/sound/small_jump.ogg")
    var snd_stomp = audio.createSound(path + "/resources/sound/stomp.ogg")

    var T = 48
    int ROWS = 12
    int COLS = 160

    // 马里奥状态
    int px = 3 * T
    int py = 7 * T
    var ph = T * 2
    int vx = 0; int vy = 0
    int key_l = 0; int key_r = 0; int key_c = 0
    bool on_ground = false
    bool face_r = true
    int cam = 0
    int anim_t = 0
    int anim_f = 0
    int lives = 3

    // 受伤/死亡状态
    int hurt_timer = 0      // >0 表示无敌闪烁中
    int dead_timer = 0      // >0 表示死亡动画中
    bool is_dead = false

    // 金币特效（撞击砖块后弹出）
    int coin_x = 0; int coin_y = 0; int coin_t = 0
    // 收集到的金币
    int coins = 0

    // 敌人：每个敌人 [x, y, w, h, vx, type, alive]
    // type=0: 板栗仔(Goomba) type=1: 绿乌龟(Koopa)
    var enemies = []
    func add_enemy(int x, int y, int etype) {
        enemies.add([x, y, T, T, -2, etype, 1])
    }

    // 静态金币 [x, y, alive]
    var coins_static = []
    func add_coin(int x, int y) {
        coins_static.add([x, y, 1])
    }

    // 子弹 [x, y, vx, alive]
    var bullets = []
    int bullet_cooldown = 0
    var snd_fire = audio.createSound(path + "/resources/sound/fireball.ogg")
    var snd_hurt = audio.createSound(path + "/resources/sound/bump.ogg")

    // 撒尿粒子 [x, y, vx, vy, life, alive]
    var pee_stream = []
    var pee_timer = 0
    var splash_parts = []  // 溅射粒子 [x, y, vx, vy, life]

    // 多重砖块剩余击打次数
    var multi_hits = []
    for 0:ROWS-1 to r { var row = []; for 0:COLS-1 to c { row.add(0) }; multi_hits.add(row) }

    // 瓦片类型：
    // 16 多重砖块（可连击出金币） 17 已使用的多重砖
    // 0 空
    // 1 问号砖   2 普通砖块   3 地面/泥土   4-7 平台砖
    // 8 管道左上  9 管道右上  10 管道左下  11 管道右下
    // 12 硬砖块（不可破坏）  13 台阶砖  20 城堡砖
    var M = []
    for 0:ROWS to r {
        var row = []
        for 0:COLS to c { row.add(0) }
        M.add(row)
    }

    // 辅助：填充矩形区域
    func set_rect(int c1, int r1, int w, int h, int t) {
        for c1:c1+w to c {
            for r1:r1+h to r {
                if c >= 0 and c < COLS and r >= 0 and r < ROWS {
                    M[r][c] = t
                }
            }
        }
    }
    // 辅助：画地面（行10为顶部草皮，行11为泥土），支持留空做坑洞
    func ground(int c1, int c2) {
        for c1:c2+1 to c {
            if c >= 0 and c < COLS {
                M[10][c] = 3
                M[11][c] = 3
            }
        }
    }
    // 辅助：放砖块行
    func brick_row(int c1, int c2, int r) {
        for c1:c2+1 to c {
            if c >= 0 and c < COLS and r >= 0 and r < ROWS {
                M[r][c] = 2
            }
        }
    }
    // 辅助：放问号砖（每隔一个放）
    func question_row(int c1, int c2, int r) {
        for c1:c2+1 to c {
            if c >= 0 and c < COLS and r >= 0 and r < ROWS {
                if (c - c1) % 2 == 0 { M[r][c] = 1 }
                else { M[r][c] = 2 }
            }
        }
    }
    // 辅助：放管道
    func pipe(int c, int h) {
        // h 是地面以上的高度
        if c < 0 or c >= COLS - 1 { return }
        int base_r = 10
        for 0:h to i {
            int rr = base_r - 1 - i
            if rr >= 0 and rr < ROWS {
                if i == h - 1 {
                    M[rr][c] = 8
                    M[rr][c+1] = 9
                } else {
                    M[rr][c] = 10
                    M[rr][c+1] = 11
                }
            }
        }
    }

    // ============ 关卡设计 ============
    // 地面分段（留出坑洞增加挑战性）
    ground(0, 20)
    ground(23, 43)
    ground(46, 70)
    ground(73, 95)
    ground(98, 120)
    ground(123, 140)
    ground(143, 170)
    ground(173, 200)
    ground(203, COLS-1)

    // 起始平台
    brick_row(15, 19, 6)
    add_coin(16*T + T/2, 5*T + T/2)
    add_coin(18*T + T/2, 5*T + T/2)

    // 第一个管道
    pipe(22, 2)

    // 经典三连问号牌砖
    M[6][27] = 1
    M[6][28] = 1
    M[6][29] = 1
    add_coin(27*T + T/2, 5*T + T/2)
    add_coin(29*T + T/2, 5*T + T/2)

    // 高台 (h=2→3行)
    set_rect(33, 8, 6, 2, 3)
    brick_row(34, 36, 6)
    add_enemy(35*T, 7*T, 0)

    // 第二个管道
    pipe(42, 2)

    // 空中平台（拉开间距，够高）
    set_rect(48, 6, 3, 0, 2)
    set_rect(58, 5, 3, 0, 2)
    set_rect(68, 6, 3, 0, 2)

    // 台阶上坡 (h含边界，h=0→1行, h=1→2行, h=2→3行)
    set_rect(66, 9, 2, 0, 13)
    set_rect(68, 8, 2, 1, 13)
    set_rect(70, 7, 2, 2, 13)

    // 敌人巡逻区
    add_enemy(50*T, 9*T, 0)
    add_enemy(78*T, 9*T, 0)
    add_enemy(85*T, 9*T, 1)

    // 第三个管道（h=3→4行，从地面可跳上）
    pipe(90, 3)

    // 空中金币平台
    set_rect(98, 6, 3, 0, 2)
    set_rect(106, 5, 3, 0, 2)
    add_coin(99*T + T/2, 5*T + T/2)
    add_coin(107*T + T/2, 4*T + T/2)

    // 大型悬空砖块结构
    brick_row(113, 118, 5)
    M[5][115] = 1
    M[5][117] = 1

    // 第四个管道
    pipe(125, 2)

    // 最后冲刺：逐级升高的平台
    set_rect(130, 8, 3, 0, 2)
    set_rect(136, 7, 3, 0, 2)
    set_rect(142, 6, 3, 0, 2)

    // 终点城堡 (h=1→row 8-9, 2行)
    set_rect(COLS-10, 8, 8, 1, 20)

    // 读取瓦片
    func get(int c, int r): int {
        if c < 0 or c >= COLS or r < 0 or r >= ROWS { return 0 }
        return M[r][c]
    }

    // ===== 区域2：更多挑战 =====
    add_enemy(145*T, 9*T, 0); add_enemy(148*T, 9*T, 0)
    add_enemy(152*T, 9*T, 1)

    // 多重砖块（可连击出金币，type=16）
    M[6][150] = 16; multi_hits[6][150] = 5
    M[6][153] = 16; multi_hits[6][153] = 5
    M[6][156] = 16; multi_hits[6][156] = 5

    add_enemy(160*T, 9*T, 0)
    set_rect(165, 7, 3, 0, 2)
    add_enemy(168*T, 9*T, 0)

    M[5][172] = 16; multi_hits[5][172] = 3
    M[5][175] = 16; multi_hits[5][175] = 3

    set_rect(180, 8, 3, 0, 2)
    set_rect(187, 7, 3, 0, 2)
    add_enemy(183*T, 9*T, 0); add_enemy(190*T, 9*T, 1)

    // 保存初始地图+敌人（用于重置）
    var M_init = []
    for 0:ROWS-1 to r {
        var row = []
        for 0:COLS-1 to c { row.add(M[r][c]) }
        M_init.add(row)
    }
    var enemies_init = []
    for 0:enemies.len()-1 to i {
        enemies_init.add([enemies[i][0], enemies[i][1], T, T, enemies[i][4], enemies[i][5], 1])
    }
    // 重置关卡
    func reset_level() {
        for 0:ROWS-1 to r { for 0:COLS-1 to c { M[r][c] = M_init[r][c] } }
        for 0:ROWS-1 to r { for 0:COLS-1 to c { multi_hits[r][c] = 0 } }
        multi_hits[6][150] = 5; multi_hits[6][153] = 5; multi_hits[6][156] = 5
        multi_hits[5][172] = 3; multi_hits[5][175] = 3
        enemies = []; coins_static = []
        for 0:enemies_init.len()-1 to i {
            var ei = enemies_init[i]
            enemies.add([ei[0], ei[1], ei[2], ei[3], ei[4], ei[5], 1])
            add_coin(16*T + T/2, 5*T + T/2)
            add_coin(18*T + T/2, 5*T + T/2)
            add_coin(27*T + T/2, 5*T + T/2)
            add_coin(29*T + T/2, 5*T + T/2)
            add_coin(99*T + T/2, 5*T + T/2)
            add_coin(107*T + T/2, 4*T + T/2)
        }
        px = 3 * T; py = 7 * T; vx = 0; vy = 0
        cam = 0; bullets = []; coin_t = 0
        if music.isInit() { music.seek(0); music.play() }
    }

    // 通关/烟花 [x, y, vx, vy, life, r, g, b, type]
    bool game_won = false
    int win_timer = 0
    var fireworks = []
    int fw_timer = 0

    // FPS 跟踪
    int fps_val = 0; int frame_count = 0; var last_fps_time = times.ms()
    var frame_start = times.ms()  // 用于帧率限制

    win.run(
        func(GDraw ren) {
            // FPS 计算（用实际经过时间）
            var now = times.ms()
            if now - last_fps_time >= 1000 {
                fps_val = frame_count
                frame_count = 0
                last_fps_time = now
            }

            // 背景音乐循环（非死亡/通关时）
            if music.isInit() and not music.isPlaying() and dead_timer == 0 {
                music.seek(0)
                music.play()
            }

            ren.set_color(_rgb(92, 148, 252, 255))
            ren.clear()

            // 蓝天白云（视差滚动）
            var cam_slow = cam / 3
            var cloud_y = [] ; cloud_y.add(30); cloud_y.add(70); cloud_y.add(50); cloud_y.add(90); cloud_y.add(40)
            var cloud_x = [] ; cloud_x.add(100); cloud_x.add(500); cloud_x.add(1000); cloud_x.add(1500); cloud_x.add(2200)
            for 0:4 to i {
                var cx = cloud_x[i] - cam_slow
                var cy = cloud_y[i]
                if cx > -100 and cx < 900 {
                    ren.set_color(_rgb(255, 255, 255, 255))
                    ren.fill_circle(cx, cy, 18)
                    ren.fill_circle(cx - 16, cy + 8, 12)
                    ren.fill_circle(cx + 16, cy + 8, 12)
                }
            }

            var y_offset = 600 - ROWS * T
            var sc = cam / T; if sc < 0 { sc = 0 }
            var ec = (cam + 800) / T + 1; if ec > COLS - 1 { ec = COLS - 1 }

            // 画地图
            for sc:ec+1 to c {
                for 0:ROWS to r {
                    var t = M[r][c]
                    if t == 0 { continue }
                    var sx = c * T - cam
                    var sy = r * T + y_offset
                    if tile != null {
                        var tx = 0; var ty = 0
                        if t == 1 { tx = 32; ty = 0 }
                        else if t == 2 { tx = 48; ty = 0 }
                        else if t == 12 { tx = 64; ty = 0 }
                        else if t == 13 { tx = 80; ty = 0 }
                        else if t == 20 { tx = 96; ty = 0 }
                        else if t == 14 { tx = 0; ty = 48 }
                        else if t == 15 { tx = 16; ty = 48 }
                        else if t == 16 { tx = 32; ty = 0 }
                        else if t == 17 { tx = 0; ty = 48 }
                        else if t == 8 { tx = 0; ty = 64 }
                        else if t == 9 { tx = 16; ty = 64 }
                        else if t == 10 { tx = 0; ty = 80 }
                        else if t == 11 { tx = 16; ty = 80 }
                        else if t == 3 { tx = 0; ty = 0; if r == 10 { tx = 16; ty = 0 } }
                        else if t == 4 { tx = 0; ty = 16 }
                        else if t == 5 { tx = 16; ty = 16 }
                        else if t == 6 { tx = 0; ty = 32 }
                        else if t == 7 { tx = 16; ty = 32 }
                        tile.draw_src(ren, tx, ty, 16, 16, sx, sy, T, T)
                    } else {
                        ren.set_color(_rgb(200, 100, 50, 255))
                        ren.fill_rect(sx, sy, T, T)
                    }
                }
            }

            // 画静态金币
            for 0:coins_static.len()-1 to i {
                var coin = coins_static[i]
                if coin[2] == 1 {
                    var cx = coin[0] - cam
                    var cy = coin[1] + y_offset
                    if items != null {
                        // item_objects.png 中金币大致区域（第3行中部），如坐标不对可手动调整
                        items.draw_src(ren, 0, 96, 16, 16, cx - 12, cy - 12, 24, 24)
                    } else {
                        ren.set_color(_rgb(255, 215, 0, 255))
                        ren.fill_rect(cx - 12, cy - 12, 24, 24)
                    }
                }
            }

            // 画敌人
            for 0:enemies.len()-1 to i {
                var e = enemies[i]
                if e[6] == 1 {
                    var ex = e[0] - cam
                    var ey = e[1] + y_offset
                    if enemy_img != null {
                        // smb_enemies_sheet.png 左上角为板栗仔
                        var etx = 0; var ety = 0
                        if e[5] == 1 { etx = 0; ety = 96 }  // 绿乌龟
                        enemy_img.draw_src(ren, etx, ety, 16, 16, ex, ey, T, T)
                    } else {
                        ren.set_color(_rgb(150, 50, 0, 255))
                        ren.fill_rect(ex, ey, T, T)
                    }
                }
            }

            // 画子弹（火球）
            for 0:bullets.len()-1 to i {
                var b = bullets[i]
                if b[4] == 1 {
                    var bx = b[0] - cam
                    var by = b[1] + y_offset
                    ren.set_color(_rgb(255, 100, 0, 255))
                    ren.fill_circle(bx, by, 6)
                    ren.set_color(_rgb(255, 200, 0, 255))
                    ren.fill_circle(bx, by, 3)
                }
            }
            // 画尿
            if pee_stream.len() > 0 {
                for 0:pee_stream.len()-1 to i {
                    var pp = pee_stream[i]
                    if pp[5] == 0 { continue }
                    ren.set_color(_rgb(255, 240, 60, 200))
                    ren.fill_rect(pp[0] - cam, pp[1] + y_offset, 3, 3)
                }
            }
            // 画溅射水花
            for 0:splash_parts.len()-1 to i {
                var sp = splash_parts[i]
                if sp[4] <= 0 { continue }
                var alpha = sp[4] * 30; if alpha > 200 { alpha = 200 }
                ren.set_color(_rgb(200, 220, 255, alpha))
                ren.fill_rect(sp[0] - cam, sp[1] + y_offset, 2, 2)
            }

        // 物理
            vy = vy + 1; if vy > 16 { vy = 16 }
            if key_l == 1 { vx = vx - 2; if vx < -5 { vx = -5 } }
            if key_r == 1 { vx = vx + 2; if vx > 5 { vx = 5 } }
            if key_l == 0 and key_r == 0 { vx = vx * 8 / 10 }
            px = px + vx

            py = py + vy
            on_ground = false

            // 碰撞检测范围（马里奥占据 px~px+T, py~py+ph）
            // 上升时：头部撞到障碍物
            if vy < 0 {
                var rt = py / T
                if rt >= 0 and rt < ROWS {
                    var ct = (px + T/2) / T
                    if ct >= 0 and ct < COLS {
                        var tt = get(ct, rt)
                        if tt > 0 {
                            py = (rt + 1) * T
                            vy = 0
                            // 问号砖/普通砖/多重砖 → 撞击出金币
                            if tt == 1 {
                                M[rt][ct] = 14
                                coin_x = ct * T; coin_y = (rt + 1) * T; coin_t = 14
                                coins = coins + 1
                                if snd_coin.isInit() { snd_coin.seek(0); snd_coin.play() }
                            } else if tt == 16 {
                                multi_hits[rt][ct] = multi_hits[rt][ct] - 1
                                coin_x = ct * T; coin_y = (rt + 1) * T; coin_t = 14
                                coins = coins + 1
                                if snd_coin.isInit() { snd_coin.seek(0); snd_coin.play() }
                                if multi_hits[rt][ct] <= 0 { M[rt][ct] = 17 }
                            } else if tt == 2 {
                                M[rt][ct] = 15
                                if snd_bump.isInit() { snd_bump.seek(0); snd_bump.play() }
                            }
                        }
                    }
                }
            }

            // 下落/站立：脚底和侧面（简化为中心列）
            if vy >= 0 and not is_dead {
                var rb = (py + ph) / T
                var cb = (px + T/2) / T
                if cb >= 0 and cb < COLS and rb >= 0 and rb < ROWS and get(cb, rb) > 0 {
                    py = rb * T - ph
                    vy = 0
                    on_ground = true
                }
            }

            // 左右碰撞（防止穿墙），死亡动画中禁用
            if not is_dead {
                if vx > 0 {
                    var cb = (px + T) / T
                    var rb = (py + ph - 1) / T
                    if cb >= 0 and cb < COLS and rb >= 0 and rb < ROWS and get(cb, rb) > 0 {
                        px = cb * T - T
                        vx = 0
                    }
                } else if vx < 0 {
                    var cb = px / T
                    var rb = (py + ph - 1) / T
                    if cb >= 0 and cb < COLS and rb >= 0 and rb < ROWS and get(cb, rb) > 0 {
                        px = (cb + 1) * T
                        vx = 0
                    }
                }
            }

            // 掉坑重置
            if py > ROWS * T + 100 {
                lives = lives - 1
                if lives <= 0 { lives = 3; coins = 0; reset_level() }
                else { px = 3 * T; py = 7 * T; vy = 0; vx = 0 }
                hurt_timer = 0; dead_timer = 0; is_dead = false
            }

            // 受伤无敌计时
            if hurt_timer > 0 { hurt_timer = hurt_timer - 1 }

            // 死亡动画计时
            if dead_timer > 0 {
                dead_timer = dead_timer - 1
                if dead_timer <= 0 {
                    is_dead = false; dead_timer = 0; hurt_timer = 0
                    lives = 3; coins = 0
                    reset_level()
                }
            }

            // 通关检测：碰到城堡
            if not game_won {
                var mc = (px + T/2) / T
                var mr = (py + ph) / T
                if mc >= 0 and mc < COLS and mr >= 0 and mr < ROWS and get(mc, mr) == 20 {
                    game_won = true; win_timer = 200
                    if music.isInit() { music.stop() }
                    if clear_sound.isInit() { clear_sound.seek(0); clear_sound.play() }
                }
            }

            // 烟花：上升→爆炸（参考 fireworks.leno）
            if game_won {
                win_timer = win_timer - 1
                fw_timer = fw_timer + 1
                // 每25帧发射新烟花
                if fw_timer >= 25 and win_timer > 30 {
                    fw_timer = 0
                    var lx = cam + 100 + (win_timer * 37) % 600
                    var ri = 255 - (win_timer * 7) % 200
                    var gi = (win_timer * 13) % 256
                    var bi = (win_timer * 19) % 256
                    fireworks.add([lx, 450 + y_offset, 0, -14, 40, ri, gi, bi, 0])
                }
                for 0:fireworks.len()-1 to fi {
                    var fw = fireworks[fi]
                    if fw[4] <= 0 { continue }
                    fw[4] = fw[4] - 1
                    if fw[8] == 0 {
                        fw[1] = fw[1] + fw[3]
                        fw[3] = fw[3] + 1
                        if fw[3] >= 0 {
                            for 0:29 to j {
                                var ang = j * 6
                                var spd = 3 + j % 5
                                fireworks.add([fw[0], fw[1], _int(maths.cos(ang)*spd), _int(maths.sin(ang)*spd), 30+j%10, fw[5], fw[6], fw[7], 1])
                            }
                            fw[4] = 0
                        }
                    } else {
                        fw[2] = fw[2] * 97 / 100
                        fw[3] = fw[3] + 1
                        fw[0] = fw[0] + fw[2]
                        fw[1] = fw[1] + fw[3]
                    }
                }
                // 清理死粒子
                if fireworks.len() > 500 { fireworks = [] }
                // 通关结束
                if win_timer <= 0 {
                    game_won = false; lives = 3; coins = 0
                    fireworks = []
                    reset_level()
                }
            }

            // 更新敌人
            for 0:enemies.len()-1 to i {
                var e = enemies[i]
                if e[6] == 0 { continue }
                e[0] = e[0] + e[4]
                // 简单的边缘/墙转向
                var ec_c = (e[0] + T/2) / T
                var ec_r = (e[1] + T) / T
                if ec_c < 0 or ec_c >= COLS or ec_r < 0 or ec_r >= ROWS or get(ec_c, ec_r) == 0 {
                    e[4] = -e[4]
                    e[0] = e[0] + e[4] * 2
                }
                // 与马里奥碰撞（非无敌/非死亡时才处理）
                if hurt_timer <= 0 and dead_timer <= 0 {
                    // AABB 重叠检测（马里奥高 2T，敌人高 T）
                    bool overlap_x = px < e[0] + T and px + T > e[0]
                    bool overlap_y = py < e[1] + T and py + ph > e[1]
                    if overlap_x and overlap_y {
                        // 下落且马里奥底部进入敌人上半部分 → 踩死
                        if vy > 0 and py + ph - e[1] < T - 8 {
                            e[6] = 0
                            vy = -10
                            coins = coins + 1
                            if snd_stomp.isInit() { snd_stomp.seek(0); snd_stomp.play() }
                        } else {
                            // 被敌人碰到，扣生命
                            lives = lives - 1
                            if lives <= 0 {
                                // 没命了，进入死亡动画
                                is_dead = true
                                dead_timer = 150
                                hurt_timer = 0
                                vy = -18
                                vx = 0
                                if music.isInit() { music.stop() }
                                if death_sound.isInit() { death_sound.play() }
                            } else {
                                // 还有命，进入无敌闪烁并弹开
                                hurt_timer = 60
                                vx = -vx
                                if snd_hurt.isInit() { snd_hurt.seek(0); snd_hurt.play() }
                            }
                        }
                    }
                }
            }

            // 更新子弹（弹跳火球）
            if bullet_cooldown > 0 { bullet_cooldown = bullet_cooldown - 1 }
            for 0:bullets.len()-1 to i {
                var b = bullets[i]
                if b[4] == 0 { continue }
                // 重力
                b[3] = b[3] + 1; if b[3] > 12 { b[3] = 12 }
                b[0] = b[0] + b[2]
                b[1] = b[1] + b[3]
                // 撞地面 → 反弹
                int _bc = _int(b[0] / T)
                int _br = _int(b[1] / T)
                if _br >= 0 and _br < ROWS and _bc >= 0 and _bc < COLS and get(_bc, _br) > 0 {
                    b[3] = -10; b[1] = _br * T - 2  // 弹起
                    b[5] = b[5] + 1
                }
                // 撞墙 → 反弹或销毁
                if _bc < 0 or _bc >= COLS or (_br >= 0 and _br < ROWS and get(_bc, _int((b[1] - 4) / T)) > 0) {
                    b[2] = -b[2]; b[5] = b[5] + 1
                }
                // 撞敌人销毁
                for 0:enemies.len()-1 to ei {
                    var ee = enemies[ei]
                    if ee[6] == 0 { continue }
                    if maths.abs(b[0] - (ee[0] + T/2)) < T * 0.7 and maths.abs(b[1] - (ee[1] + T/2)) < T * 0.7 {
                        ee[6] = 0; b[4] = 0
                        if snd_stomp.isInit() { snd_stomp.seek(0); snd_stomp.play() }
                        break
                    }
                }
                // 超出屏幕或弹跳次数过多 → 销毁
                if b[4] == 0 { continue }
                if b[0] < cam - 48 or b[0] > cam + 848 or b[5] >= 6 { b[4] = 0 }
            }

            // 撒尿粒子生成（按住C键，抛物线弧线）
            if key_c == 1 {
                pee_timer = pee_timer + 1
                if pee_timer >= 2 {
                    pee_timer = 0
                    var dir = 1; if not face_r { dir = -1 }
                    pee_stream.add([px + T/2, py + ph - 8, dir * 3, -10, 60, 1])
                }
            }
            // 更新尿粒子（先加重力再移动，同子弹逻辑）
            if pee_stream.len() > 0 {
                for 0:pee_stream.len()-1 to i {
                    var pp = pee_stream[i]
                    if pp[5] == 0 { continue }
                    pp[3] = pp[3] + 1
                    pp[0] = pp[0] + pp[2]
                    pp[1] = pp[1] + pp[3]
                    // 碰到地面/平台 → 消失+溅水花
                    int ppx = _int(pp[0] / T)
                    int ppy = _int(pp[1] / T)
                    if ppy >= 0 and ppy < ROWS and ppx >= 0 and ppx < COLS and get(ppx, ppy) > 0 {
                        pp[5] = 0
                        for 0:3 to sj { splash_parts.add([pp[0], pp[1], -2+sj*2, -3-sj*2, 8]) }
                    }
                    // 离开屏幕或太久 → 消失
                    if pp[1] > ROWS * T + 100 or pp[4] <= 0 or pp[0] < cam - 100 or pp[0] > cam + 900 { pp[5] = 0 }
                    pp[4] = pp[4] - 1
                }
            }
            if pee_stream.len() > 300 { pee_stream = [] }
            // 溅射更新
            for 0:splash_parts.len()-1 to i {
                var sp = splash_parts[i]
                if sp[4] <= 0 { continue }
                sp[3] = sp[3] + 1
                sp[0] = sp[0] + sp[2]
                sp[1] = sp[1] + sp[3]
                sp[4] = sp[4] - 1
            }
            if splash_parts.len() > 100 { splash_parts = [] }

            // 收集金币
            for 0:coins_static.len()-1 to i {
                var coin = coins_static[i]
                if coin[2] == 1 {
                    if maths.abs(coin[0] - (px + T/2)) < T * 0.6 and maths.abs(coin[1] - (py + T)) < T * 0.9 {
                        coin[2] = 0
                        coins = coins + 1
                        if snd_coin.isInit() { snd_coin.seek(0); snd_coin.play() }
                    }
                }
            }

            // 相机
            cam = px - 266
            if cam < 0 { cam = 0 }
            if cam > COLS * T - 800 { cam = COLS * T - 800 }

            // 马里奥动画
            var dx = px - cam
            var dy = py + y_offset

            var spx = 96
            if not on_ground or is_dead {
                spx = 192
            } else if vx != 0 {
                anim_t = anim_t + 1
                if anim_t > 6 { anim_t = 0; anim_f = 1 - anim_f }
                if anim_f == 0 { spx = 96 } else { spx = 112 }
            }

            // 无敌闪烁：hurt_timer > 0 时每 6 帧隐藏一次
            bool should_draw_mario = true
            if hurt_timer > 0 {
                if (hurt_timer / 6) % 2 == 0 { should_draw_mario = false }
            }

            if should_draw_mario {
                if img != null {
                    if face_r {
                        img.draw_src(ren, spx, 0, 16, 32, dx, dy, T, ph)
                    } else {
                        img.draw_src_flipped(ren, spx, 0, 16, 32, dx, dy, T, ph)
                    }
                }
            }

            // 金币弹出特效
            if coin_t > 0 {
                coin_t = coin_t - 1
                var cx = coin_x - cam + T/2 - 10
                var cy = coin_y + y_offset - coin_t * 4 - 10
                if items != null {
                    items.draw_src(ren, 0, 96, 16, 16, cx, cy, 24, 24)
                } else {
                    ren.set_color(_rgb(255, 215, 0, 255))
                    ren.fill_rect(cx, cy, 24, 24)
                }
            }

            // 烟花渲染
            if game_won {
                for 0:fireworks.len()-1 to fi {
                    var fw = fireworks[fi]
                    if fw[4] <= 0 { continue }
                    var fwx = _int(fw[0] - cam)
                    var fwy = _int(fw[1])
                    var alpha = 255
                    if fw[4] < 15 { alpha = fw[4] * 17 }
                    ren.set_color(_rgb(fw[5], fw[6], fw[7], alpha))
                    if fw[8] == 0 { ren.fill_circle(fwx, fwy, 5) }
                    else { ren.fill_circle(fwx, fwy, 2) }
                }
                // 恭喜通关
                ren.set_color(_rgb(0, 0, 0, 120))
                ren.fill_rect(100, 220, 600, 100)
                ren.set_color(_rgb(255, 255, 255, 255))
                if font != null {
                    ren.draw_text(font, "CONGRATULATIONS! You Win!", 180, 250)
                    int wt = win_timer/60 + 1
                    ren.draw_text(font, "Restarting in " + wt, 280, 290)
                }
            }

            // HUD: FPS | 金币 | 生命 (文字渲染)
            ren.set_color(_rgb(0, 0, 0, 180))
            ren.fill_rect(0, 0, 800, 28)
            ren.set_color(_rgb(255, 255, 255, 255))
            if font != null {
                ren.draw_text(font, "FPS:" + fps_val, 8, 4)
                ren.draw_text(font, "COINS:" + coins, 160, 4)
                ren.draw_text(font, "LIVES:" + lives, 320, 4)
            }

            frame_count = frame_count + 1

            // 帧率限制（同 fireworks 方式）
            var elapsed = times.ms() - frame_start
            if elapsed < 16 { sleep(16 - elapsed) }
            frame_start = times.ms()
        },
        func(GEvent e) {
            if e.is_quit() or e.is_window_close() { win.set_should_close(true) }
            if e.is_key_down() {
                var k = e.key()
                if k == guis.KEY_LEFT { key_l = 1; face_r = false }
                if k == guis.KEY_RIGHT { key_r = 1; face_r = true }
                if k == guis.KEY_SPACE and on_ground { vy = -22; if snd_jump.isInit() { snd_jump.seek(0); snd_jump.play() } }
                if k == 67 { key_c = 1 }   // C键撒尿
                if k == 88 and bullet_cooldown <= 0 {
                    var bvx = 8; if not face_r { bvx = -8 }
                    bullets.add([px + T/2, py + T + T/2, bvx, -6, 1, 0])
                    bullet_cooldown = 12
                    if snd_fire.isInit() { snd_fire.seek(0); snd_fire.play() }
                }
            }
            if e.is_key_up() {
                var k = e.key()
                if k == guis.KEY_LEFT { key_l = 0 }
                if k == guis.KEY_RIGHT { key_r = 0 }
                if k == 67 { key_c = 0 }
            }
        }
    )
    win.close()
}
