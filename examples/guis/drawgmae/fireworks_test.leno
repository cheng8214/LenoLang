// ============================================================================
// 烟花爆炸效果 - 绚丽版
// 8 种爆炸形状 + 颜色主题 + 辉光 + 二次爆炸 + 背景星空
// ============================================================================
import guis
import times
import maths
import rands
// ---- 粒子 ----
struct Particle {
    float x
    float y
    float vx
    float vy
    int r
    int g
    int b
    int a = 255
    int life
    int max_life
    int size = 1
    float gravity = 0.05
    float friction = 0.98
    int ptype = 0   // 0=普通 1=辉光 2=火花 3=闪烁
}

// ---- 烟花 ----
struct Firework {
    float x
    float y
    float vx
    float vy
    float target_y
    int state      // 0=上升 1=爆炸
    int burst_type // 爆炸形状 0-7
    int r
    int g
    int b
}

// ---- 背景星星 ----
struct Star {
    float x
    float y
    float twinkle
    float twinkle_speed
    int r
    int g
    int b
}

main() {
_gc(false)
    Win win = guis.create_window("🎆 烟花绚烂 - 压力测试版", {
        width: 960,
        height: 680
    })

    var font_fps = guis.load_font("Consolas", 14)
    var font_info = guis.load_font("Consolas", 11)
    var screen_w = 960
    var screen_h = 680

    // ---- 粒子池 ----
    var MAX_PARTICLES = 6000
    var particles = {}
    var particle_ids = {}
    var particle_count = 0
    var next_pid = 0

    // ---- 烟花池 ----
    var fireworks = {}
    var firework_ids = {}
    var firework_count = 0
    var next_fid = 0

    // ---- 地面火花池 ----
    var MAX_GROUND = 200
    var ground_sparks = {}
    var ground_ids = {}
    var ground_count = 0
    var next_gid = 0

    // ---- 背景星星 ----
    var MAX_STARS = 120
    var stars = {}
    var star_ids = {}
    var star_count = 0
    var next_sid = 0

    // ---- 计时 ----
    var launch_timer = 0
    var launch_interval = 20

    // ---- FPS ----
    var frame_count = 0
    var fps = 0
    var last_fps_time = times.ms()
    var frame_start = times.ms()
    var target_frame_ms = 16
    var peak_particles = 0

    // ===== 颜色主题表 (RGB) =====
    // 18 种主题色，确保颜色鲜艳
    var themes = [
        [255, 50, 50],    // 红
        [255, 140, 0],    // 橙
        [255, 220, 0],    // 金
        [50, 255, 50],    // 绿
        [0, 200, 255],    // 天蓝
        [50, 80, 255],    // 蓝
        [180, 50, 255],   // 紫
        [255, 50, 200],   // 品红
        [255, 100, 100],  // 浅红
        [255, 180, 60],   // 琥珀
        [100, 255, 100],  // 亮绿
        [0, 255, 200],    // 青
        [100, 150, 255],  // 淡蓝
        [220, 100, 255],  // 淡紫
        [255, 80, 150],   // 玫红
        [255, 255, 100],  // 亮黄
        [255, 160, 120],  // 珊瑚
        [120, 255, 160] // 薄荷
    ]

    // ===== 粒子操作 =====
    func spawn_particle(float x, float y, float vx, float vy, int r, int g, int b, int life, int size, int ptype, float grav, float fric) {
        if particle_count >= MAX_PARTICLES{ return }

        var p = new Particle(
            x=x, y=y, vx=vx, vy=vy,
            r=r, g=g, b=b,
            life=life, max_life=life,
            size=size, ptype=ptype,
            gravity=grav, friction=fric
        )

        var id = next_pid
        particles["p" + _str(id)] = p
        particle_ids["i" + _str(particle_count)] = id
        particle_count = particle_count + 1
        next_pid = next_pid + 1
    }

    func remove_particle(int index) {
        var last = particle_count - 1
        var pid = particle_ids["i" + _str(index)]
        particles.remove("p" + _str(pid))
        if index != last {
            particle_ids["i" + _str(index)] = particle_ids["i" + _str(last)]
        }
        particle_ids.remove("i" + _str(last))
        particle_count = particle_count - 1
    }

    func remove_firework(int index) {
        var last = firework_count - 1
        var fid = firework_ids["i" + _str(index)]
        fireworks.remove("f" + _str(fid))
        if index != last {
            firework_ids["i" + _str(index)] = firework_ids["i" + _str(last)]
        }
        firework_ids.remove("i" + _str(last))
        firework_count = firework_count - 1
    }

    func remove_ground(int index) {
        var last = ground_count - 1
        var gid = ground_ids["i" + _str(index)]
        ground_sparks.remove("g" + _str(gid))
        if index != last {
            ground_ids["i" + _str(index)] = ground_ids["i" + _str(last)]
        }
        ground_ids.remove("i" + _str(last))
        ground_count = ground_count - 1
    }

    // ===== 地面火花 =====
    func spawn_ground(float x, float y, int r, int g, int b) {
        if ground_count >= MAX_GROUND { return }
        var count = rands.ints(5, 15)
        for 0:count - 1 to j {
            var ang = rands.floats(0.0, 6.28318)
            var spd = rands.floats(0.5, 3.0)
            var gs = new Particle(
                x=x, y=y,
                vx=maths.cos(ang) * spd,
                vy=maths.sin(ang) * spd * 0.5 - rands.floats(0.5, 2.0),
                r=r, g=g, b=b,
                life=rands.ints(10, 30), max_life=0,
                size=rands.ints(1, 2),
                gravity=0.1, friction=0.92
            )
            gs.max_life = gs.life

            var gid = next_gid
            ground_sparks["g" + _str(gid)] = gs
            ground_ids["i" + _str(ground_count)] = gid
            ground_count = ground_count + 1
            next_gid = next_gid + 1
        }
    }

    // ===== 发射烟花 =====
    func launch_firework(float from_x, float from_y, float target_x, float target_y) {
        if firework_count >= 80 { return }

        var btype = rands.ints(0, 7)
        var theme = themes[rands.ints(0, 17)]
        var tr = theme[0]
        var tg = theme[1]
        var tb = theme[2]

        // 添加随机色彩偏移
        tr = tr + rands.ints(-30, 30)
        tg = tg + rands.ints(-30, 30)
        tb = tb + rands.ints(-30, 30)
        if tr < 0 { tr = 0 } else if tr > 255 { tr = 255 }
        if tg < 0 { tg = 0 } else if tg > 255 { tg = 255 }
        if tb < 0 { tb = 0 } else if tb > 255 { tb = 255 }

        var dx = target_x - from_x
        var dy = target_y - from_y
        var dist = maths.sqrt(dx * dx + dy * dy)
        if dist < 1.0 { dist = 1.0 }
        var speed = rands.floats(11.0, 16.0)
        var vx = dx / dist * speed * 0.25
        var vy = dy / dist * speed

        var fw = new Firework(
            x=from_x, y=from_y, vx=vx, vy=vy,
            target_y=target_y, state=0,
            burst_type=btype,
            r=tr, g=tg, b=tb
        )

        var id = next_fid
        fireworks["f" + _str(id)] = fw
        firework_ids["i" + _str(firework_count)] = id
        firework_count = firework_count + 1
        next_fid = next_fid + 1

        // 地面火花
        spawn_ground(from_x, screen_h - 3, tr, tg, tb)
    }

    // ===== 爆炸核心 =====
    func explode_firework(float x, float y, int r, int g, int b, int burst_type) {
        var count = rands.ints(100, 250)
        var hue_idx = rands.ints(0, 17)

        // ---- 中心辉光团 ----
        for 0:6 to j {
            var ang = j * 1.047
            var spd = rands.floats(1.0, 4.0)
            spawn_particle(x, y,
                maths.cos(ang) * spd,
                maths.sin(ang) * spd,
                255, 255, 240, rands.ints(8, 15), rands.ints(2, 3), 1, 0.01, 0.93)
        }

        // ---- 闪烁星光核心 ----
        for 0:8 to j {
            var ang = rands.floats(0.0, 6.28318)
            var spd = rands.floats(0.3, 1.5)
            spawn_particle(x, y,
                maths.cos(ang) * spd,
                maths.sin(ang) * spd,
                255, 255, 255, rands.ints(20, 35), rands.ints(1, 2), 3, 0.0, 1.0)
        }

        // 产生2000个粒子测试
        for 0:1999 to i {
            var ang = i * 6.28318 / 2000.0
            var spd = rands.floats(2.5, 8.0)
            spawn_particle(x, y,
                maths.cos(ang) * spd,
                maths.sin(ang) * spd,
                r, g, b, rands.ints(35, 80), 1, 0, 0.04, 0.98)
        }

        // 二次爆炸和地面火花已删除

    }

    // 星空背景已删除

    // ========================================================================
    // 主渲染循环
    // ========================================================================
    win.run(
        func(Draw ren) {
            frame_count = frame_count + 1
            var now = times.ms()
            if now - last_fps_time >= 1000 {
                fps = frame_count
                frame_count = 0
                last_fps_time = now
            }

            if particle_count > peak_particles {
                peak_particles = particle_count
            }

            // ===== 清屏（带拖尾） =====
            ren.set_color(_rgb(6, 6, 20, 35))
            ren.clear()

            // ===== 更新烟花 =====
            var fi = 0
            while fi < firework_count {
                var fid = firework_ids["i" + _str(fi)]
                var fw = fireworks["f" + _str(fid)]
                var removed = false

                if fw.state == 0 {
                    // 上升
                    fw.y = fw.y + fw.vy
                    fw.x = fw.x + fw.vx
                    fw.vy = fw.vy + 0.1

                    // 到达目标 -> 爆炸
                    if fw.y <= fw.target_y {
                        fw.state = 1
                        explode_firework(fw.x, fw.y, fw.r, fw.g, fw.b, fw.burst_type)
                        remove_firework(fi)
                        removed = true
                    }
                }

                if removed == false {
                    fi = fi + 1
                }
            }

            // ===== 更新粒子 =====
            var pj = 0
            while pj < particle_count {
                var pid = particle_ids["i" + _str(pj)]
                var p = particles["p" + _str(pid)]

                p.life = p.life - 1
                if p.life <= 0 {
                    remove_particle(pj)
                } else {
                    p.x = p.x + p.vx
                    p.y = p.y + p.vy
                    p.vy = p.vy + p.gravity
                    p.vx = p.vx * p.friction
                    p.vy = p.vy * p.friction

                    p.a = (p.life * 255 / p.max_life) as int
                    if p.a < 0 { p.a = 0 } else if p.a > 255 { p.a = 255 }

                    pj = pj + 1
                }
            }

            // ===== 绘制粒子 =====
            for 0:particle_count - 1 to pk {
                var pid = particle_ids["i" + _str(pk)]
                var p = particles["p" + _str(pid)]

                if p.x >= -20.0 and p.x <= (screen_w + 20) and p.y >= -20.0 and p.y <= (screen_h + 20) {
                    var px = p.x as int
                    var py = p.y as int

                    ren.set_color(_rgb(p.r, p.g, p.b, p.a))
                    if p.size <= 1 {
                        ren.fill_rect(px, py, 1, 1)
                    } else if p.size <= 2 {
                        ren.fill_circle(px, py, p.size)
                    } else {
                        // 较大粒子
                        ren.fill_circle(px, py, p.size)
                    }
                }
            }

            // ===== HUD =====
            ren.set_color(_rgb(255, 255, 255, 230))
            ren.draw_text(font_fps,
                "FPS:" + fps + "  粒子:" + particle_count + "  峰值:" + peak_particles + "  烟花:" + firework_count,
                10, 10)

            ren.set_color(_rgb(160, 160, 200, 200))
            ren.draw_text(font_info,
                "SPACE=齐射  |  CLICK=点击发射  |  R=重置峰值",
                10, 28)

            ren.present()

            // 帧率限制
            var elapsed = times.ms() - frame_start
            if elapsed < target_frame_ms {
                sleep(target_frame_ms - elapsed)
            }
            frame_start = times.ms()
        },
        func(Event e) {
            if e.is_quit() or e.is_window_close() {
                win.set_should_close(true)
            }
            if e.is_key_down() {
                if e.key() == guis.KEY_SPACE {
                    // 齐射 6 发
                    for 0:5 to bv {
                        launch_firework(
                            rands.floats(80.0, screen_w - 80.0), screen_h - 30.0,
                            rands.floats(100.0, screen_w - 100.0),
                            rands.floats(60.0, screen_h * 0.45))
                    }
                }
                if e.key() == 0x52 {
                    peak_particles = 0
                }
            }
            if e.is_mouse_down() {
                var mx = e.mouse_x()
                var my = e.mouse_y()
                if my > 50 {
                    // 点击发射烟花
                    for 0:2 to bv {
                        launch_firework(
                            rands.floats(mx - 80.0, mx + 80.0), screen_h - 25.0,
                            mx + rands.floats(-40.0, 40.0),
                            my + rands.floats(-40.0, 20.0))
                    }
                }
            }
        }
    )

    font_fps.close()
    font_info.close()
    win.close()
}
