// Leno GUI 跳跃重力测试 - 超级玛丽式场景滚动（结构体优化版）
// 按空格跳跃，受重力影响下降

import guis
import times

// ===== 数据结构定义 =====

struct Platform {
    int x
    int y
    int w
    int h
}

struct Enemy {
    int x
    int y
    int w = 32
    int h = 32
    int speed
    int min_x
    int max_x
    int dead = 0
}

struct Player {
    int x
    int y
    int w = 48
    int h = 64
    int vx = 0
    int vy = 0
    int speed = 8
    int jump_power = -20
    int friction_num = 90
    int friction_den = 100
    bool on_ground = true
    bool facing_right = true
    int current_platform = -1
}

main() {
    Win win = guis.create_window("Jump & Gravity Test - Mario Style", {
        width: 800,
        height: 600
    })
    
    // 加载字体
    Font font_fps = guis.load_font("Arial", 16)
    
    // 窗口尺寸
    int screen_w = 800
    var screen_h = 600
    
    // 地面高度
    var ground_y = 450
    
    // 玩家（初始化结构体）
    Player player = new Player(x=100, y=ground_y - 64)
    
    // 场景滚动
    int camera_x = 0
    int player_screen_x = 100
    var gravity = 1
    
    // 状态
    var key_left = false
    var key_right = false
    var key_space = false
    bool space_pressed = false
    
    // 动画
    var anim_frame = 0
    var anim_timer = 0
    
    // 帧率统计
    var frame_count = 0
    var fps = 0
    var last_fps_time = times.ms()
    
    // 帧率限制 ~60fps
    var frame_start = times.ms()
    var target_frame_ms = 16
    
    // 平台列表 - 更长的关卡
    Array platforms = [
        // 第一区域
        new Platform(x=300, y=380, w=100, h=20),
        new Platform(x=500, y=320, w=100, h=20),
        new Platform(x=700, y=380, w=100, h=20),
        // 第二区域
        new Platform(x=900, y=350, w=80, h=20),
        new Platform(x=1100, y=280, w=100, h=20),
        new Platform(x=1300, y=350, w=80, h=20),
        // 第三区域 - 高台挑战
        new Platform(x=1500, y=380, w=120, h=20),
        new Platform(x=1700, y=300, w=100, h=20),
        new Platform(x=1900, y=220, w=150, h=20),
        // 第四区域
        new Platform(x=2200, y=380, w=100, h=20),
        new Platform(x=2400, y=320, w=100, h=20),
        new Platform(x=2600, y=260, w=100, h=20),
        new Platform(x=2800, y=200, w=200, h=20),
        // 终点平台
        new Platform(x=3100, y=380, w=300, h=20)
    ]
    var platform_count = 14
    
    // 关卡终点
    var level_end = 3700
    
    // 敌人列表（在地面上左右移动）
    var enemies = [
        new Enemy(x=400,  y=ground_y - 32, speed=2, min_x=350,  max_x=600),
        new Enemy(x=1000, y=ground_y - 32, speed=3, min_x=900,  max_x=1200),
        new Enemy(x=1600, y=ground_y - 32, speed=2, min_x=1550, max_x=1750),
        new Enemy(x=2300, y=ground_y - 32, speed=4, min_x=2200, max_x=2500),
        new Enemy(x=3200, y=ground_y - 32, speed=2, min_x=3150, max_x=3350)
    ]
    var enemy_count = 5
    
    // 保存敌人初始状态用于重置
    var enemy_init = [
        new Enemy(x=400,  y=ground_y - 32, speed=2, min_x=350,  max_x=600),
        new Enemy(x=1000, y=ground_y - 32, speed=3, min_x=900,  max_x=1200),
        new Enemy(x=1600, y=ground_y - 32, speed=2, min_x=1550, max_x=1750),
        new Enemy(x=2300, y=ground_y - 32, speed=4, min_x=2200, max_x=2500),
        new Enemy(x=3200, y=ground_y - 32, speed=2, min_x=3150, max_x=3350)
    ]
    
    var is_alive = true
    var death_timer = 0
    
    win.run(
        func(Draw ren) {
            // 帧率统计
            frame_count = frame_count + 1
            var now = times.ms()
            if now - last_fps_time >= 1000 {
                fps = frame_count
                frame_count = 0
                last_fps_time = now
            }
            
            // 清空背景（天空色）
            ren.set_color(_rgb(135, 206, 235, 255))
            ren.clear()
            
            // 绘制云朵（视差效果）
            ren.set_color(_rgb(255, 255, 255, 200))
            var cloud_offset = camera_x / 3
            ren.fill_ellipse(150 - cloud_offset % 1000, 100, 60, 30)
            ren.fill_ellipse(180 - cloud_offset % 1000, 90, 50, 35)
            ren.fill_ellipse(550 - cloud_offset % 1000, 150, 70, 25)
            ren.fill_ellipse(600 - cloud_offset % 1000, 140, 55, 30)
            ren.fill_ellipse(850 - cloud_offset % 1000, 80, 80, 40)
            ren.fill_ellipse(1200 - cloud_offset % 1000, 120, 60, 30)
            
            // 绘制地面
            ren.set_color(_rgb(34, 139, 34, 255))
            ren.fill_rect(-camera_x, ground_y, level_end + 800, 600 - ground_y)
            
            // 草地顶部
            ren.set_color(_rgb(50, 205, 50, 255))
            ren.fill_rect(-camera_x, ground_y, level_end + 800, 10)
            
            // 绘制平台
            for 0:platform_count - 1 to i {
                var p = platforms[i]
                var px = p.x - camera_x
                
                ren.set_color(_rgb(139, 69, 19, 255))
                ren.fill_rect(px, p.y, p.w, p.h)
                
                ren.set_color(_rgb(210, 180, 140, 255))
                ren.fill_rect(px, p.y, p.w, 4)
                
                ren.set_color(_rgb(101, 67, 33, 255))
                ren.rect(px, p.y, p.w, p.h)
            }
            
            // ===== 物理更新 =====
            if is_alive {
                player.vy = player.vy + gravity
                player.x = player.x + player.vx
                player.y = player.y + player.vy
                
                // 平台碰撞检测
                var was_on_ground = player.on_ground
                player.on_ground = false
                player.current_platform = -1
                
                var edge_tolerance = 8
                var vertical_tolerance = 12
                
                for 0:platform_count - 1 to i {
                    var p = platforms[i]
                    
                    var in_x_range = player.x + player.w > p.x - edge_tolerance and player.x < p.x + p.w + edge_tolerance
                    var was_above = player.y + player.h - player.vy <= p.y + vertical_tolerance
                    var now_on_or_below = player.y + player.h >= p.y - vertical_tolerance
                    
                    if in_x_range and was_above and now_on_or_below and player.vy >= 0 {
                        player.y = p.y - player.h
                        player.vy = 0
                        player.on_ground = true
                        player.current_platform = i
                    }
                }
                
                // 地面碰撞
                if not player.on_ground and player.y >= ground_y - player.h {
                    player.y = ground_y - player.h
                    player.vy = 0
                    player.on_ground = true
                    player.current_platform = -1
                }
                
                // 边界限制
                if player.x < 0 {
                    player.x = 0
                    player.vx = 0
                }
                if player.x > level_end {
                    player.x = level_end
                    player.vx = 0
                }
            }
            
            // 更新敌人
            if is_alive {
                for 0:enemy_count - 1 to i {
                    if enemies[i].dead == 1 { continue }
                    
                    var e = enemies[i]
                    
                    // AI: 检测玩家是否在视野范围内
                    var dist_x = player.x - e.x
                    var dist_y = player.y - e.y
                    if dist_x < 0 { dist_x = -dist_x }
                    if dist_y < 0 { dist_y = -dist_y }
                    var see_player = dist_x < 400 and dist_y < 150
                    
                    var base_speed = e.speed
                    if base_speed < 0 { base_speed = -base_speed }
                    
                    if see_player {
                        var diff = (player.x + player.w / 2) - (e.x + e.w / 2)
                        if diff > 20      { e.speed = base_speed }
                        else if diff < -20 { e.speed = -base_speed }
                    } else {
                        if e.speed > 0 { e.speed = base_speed }
                        else { e.speed = -base_speed }
                    }
                    
                    e.x = e.x + e.speed
                    
                    // 巡逻边界转向
                    if not see_player and (e.x <= e.min_x or e.x + e.w >= e.max_x) {
                        e.speed = -e.speed
                        e.x = e.x + e.speed * 2
                    }
                    
                    // 写回
                    enemies[i].x = e.x
                    enemies[i].speed = e.speed
                    
                    // 碰撞检测
                    var overlap_x = player.x < e.x + e.w and player.x + player.w > e.x
                    var overlap_y = player.y < e.y + e.h and player.y + player.h > e.y
                    
                    if overlap_x and overlap_y {
                        var player_above = player.y + player.h - player.vy <= e.y + 10
                        if player.vy > 0 and player_above {
                            // 踩死敌人
                            enemies[i].dead = 1
                            player.vy = -12
                            player.on_ground = false
                        } else {
                            // 玩家死亡
                            is_alive = false
                            death_timer = 60
                        }
                    }
                }
            }
            
            // 头部碰撞检测
            if is_alive and player.vy < 0 {
                for 0:platform_count - 1 to i {
                    var p = platforms[i]
                    var in_x_range = player.x + player.w > p.x and player.x < p.x + p.w
                    var was_below = player.y - player.vy >= p.y + p.h
                    var now_above_or_at = player.y <= p.y + p.h
                    
                    if in_x_range and was_below and now_above_or_at {
                        player.y = p.y + p.h
                        player.vy = 0
                    }
                }
            }
            
            // 水平移动
            if key_left {
                player.vx = player.vx - 2
                if player.vx < -player.speed { player.vx = -player.speed }
                player.facing_right = false
            }
            if key_right {
                player.vx = player.vx + 2
                if player.vx > player.speed { player.vx = player.speed }
                player.facing_right = true
            }
            
            // 地面摩擦力
            if player.on_ground and not key_left and not key_right {
                player.vx = player.vx * player.friction_num / player.friction_den
            }
            
            // 空中阻力
            if not player.on_ground {
                player.vx = player.vx * 99 / 100
            }
            
            // 摄像机
            camera_x = player.x - player_screen_x
            if camera_x < 0 { camera_x = 0 }
            
            var draw_x = player_screen_x
            var max_camera_x = level_end - screen_w
            if camera_x > max_camera_x {
                camera_x = max_camera_x
                draw_x = player.x - max_camera_x
                if draw_x > screen_w - player.w { draw_x = screen_w - player.w }
            }
            
            // ===== 绘制玩家 =====
            if player.on_ground {
                ren.set_color(_rgb(255, 100, 100, 255))
            } else {
                ren.set_color(_rgb(100, 100, 255, 255))
            }
            ren.fill_rect(draw_x, player.y, player.w, player.h)
            ren.set_color(_rgb(0, 0, 0, 255))
            ren.rect(draw_x, player.y, player.w, player.h)
            
            // 眼睛
            ren.set_color(_rgb(255, 255, 255, 255))
            var eye_y = player.y + 15
            if player.facing_right {
                ren.fill_rect(draw_x + 28, eye_y, 12, 12)
                ren.fill_rect(draw_x + 10, eye_y, 8, 8)
            } else {
                ren.fill_rect(draw_x + 8, eye_y, 12, 12)
                ren.fill_rect(draw_x + 30, eye_y, 8, 8)
            }
            
            ren.set_color(_rgb(0, 0, 0, 255))
            if player.facing_right {
                ren.fill_rect(draw_x + 32, eye_y + 3, 6, 6)
            } else {
                ren.fill_rect(draw_x + 10, eye_y + 3, 6, 6)
            }
            
            // 腿部动画
            if player.vx != 0 and player.on_ground {
                anim_timer = anim_timer + 1
                if anim_timer > 5 {
                    anim_timer = 0
                    anim_frame = (anim_frame + 1) % 2
                }
                
                ren.set_color(_rgb(139, 69, 19, 255))
                if anim_frame == 0 {
                    ren.fill_rect(draw_x + 8, player.y + player.h, 10, 12)
                    ren.fill_rect(draw_x + 30, player.y + player.h - 5, 10, 17)
                } else {
                    ren.fill_rect(draw_x + 8, player.y + player.h - 5, 10, 17)
                    ren.fill_rect(draw_x + 30, player.y + player.h, 10, 12)
                }
            } else {
                ren.set_color(_rgb(139, 69, 19, 255))
                ren.fill_rect(draw_x + 8, player.y + player.h, 10, 12)
                ren.fill_rect(draw_x + 30, player.y + player.h, 10, 12)
            }
            
            // 绘制敌人
            for 0:enemy_count - 1 to i {
                if enemies[i].dead == 1 { continue }
                
                var e = enemies[i]
                var ex = e.x - camera_x
                var ey = e.y
                
                if ex + e.w > 0 and ex < screen_w {
                    ren.set_color(_rgb(200, 50, 50, 255))
                    ren.fill_rect(ex, ey, e.w, e.h)
                    
                    ren.set_color(_rgb(150, 0, 0, 255))
                    ren.rect(ex, ey, e.w, e.h)
                    
                    // 眼睛
                    ren.set_color(_rgb(255, 255, 255, 255))
                    ren.fill_rect(ex + 6, ey + 8, 8, 8)
                    ren.fill_rect(ex + 18, ey + 8, 8, 8)
                    
                    // 瞳孔
                    ren.set_color(_rgb(0, 0, 0, 255))
                    if e.speed > 0 {
                        ren.fill_rect(ex + 10, ey + 10, 4, 4)
                        ren.fill_rect(ex + 22, ey + 10, 4, 4)
                    } else {
                        ren.fill_rect(ex + 6, ey + 10, 4, 4)
                        ren.fill_rect(ex + 18, ey + 10, 4, 4)
                    }
                    
                    // 尖刺
                    ren.set_color(_rgb(150, 0, 0, 255))
                    ren.fill_rect(ex + 8, ey - 6, 4, 6)
                    ren.fill_rect(ex + 20, ey - 6, 4, 6)
                }
            }
            
            // 死亡效果
            if not is_alive {
                death_timer = death_timer - 1
                
                var alpha = 100
                if death_timer > 30 {
                    alpha = 100 + (60 - death_timer) * 3
                } else {
                    alpha = 100 + death_timer * 3
                }
                if alpha > 180 { alpha = 180 }
                ren.set_color(_rgb(0, 0, 0, alpha))
                ren.fill_rect(0, 0, screen_w, screen_h)
                
                ren.set_color(_rgb(255, 0, 0, 255))
                var death_x = screen_w / 2 - 80
                ren.draw_text(font_fps, "YOU DIED!", death_x, screen_h / 2 - 20)
                
                // 重置游戏
                if death_timer <= 0 {
                    player.x = 100
                    player.y = ground_y - player.h
                    player.vx = 0
                    player.vy = 0
                    player.on_ground = true
                    player.facing_right = true
                    player.current_platform = -1
                    is_alive = true
                    death_timer = 0
                    
                    // 一键重置所有敌人
                    for 0:enemy_count - 1 to i {
                        enemies[i].x = enemy_init[i].x
                        enemies[i].y = enemy_init[i].y
                        enemies[i].speed = enemy_init[i].speed
                        enemies[i].dead = 0
                    }
                }
            }
            
            // FPS
            ren.set_color(_rgb(255, 255, 255, 255))
            ren.draw_text(font_fps, "FPS: " + fps, 10, 10)
            
            ren.present()
            
            // 帧率限制 ~60fps
            var elapsed = times.ms() - frame_start
            if elapsed < target_frame_ms {
                sleep(target_frame_ms - elapsed)
            }
            frame_start = times.ms()
        },
        func(Event e) {
            if e.is_quit() or e.is_window_close() {
                win.set_should_close(true)
            }
            
            if e.is_key_down() {
                if e.key() == guis.KEY_SPACE {
                    key_space = true
                    if player.on_ground and not space_pressed {
                        player.vy = player.jump_power
                        player.on_ground = false
                        space_pressed = true
                    }
                }
                
                if e.key() == guis.KEY_LEFT  { key_left = true }
                if e.key() == guis.KEY_RIGHT { key_right = true }
                
                // R键重置
                if e.key() == 82 {
                    player.x = 100
                    player.y = ground_y - player.h
                    player.vx = 0
                    player.vy = 0
                    player.on_ground = true
                    player.facing_right = true
                    player.current_platform = -1
                    key_left = false
                    key_right = false
                    key_space = false
                    space_pressed = false
                    
                    // 重置敌人
                    for 0:enemy_count - 1 to i {
                        enemies[i].x = enemy_init[i].x
                        enemies[i].y = enemy_init[i].y
                        enemies[i].speed = enemy_init[i].speed
                        enemies[i].dead = 0
                    }
                }
            }
            
            if e.is_key_up() {
                if e.key() == guis.KEY_SPACE {
                    key_space = false
                    space_pressed = false
                }
                if e.key() == guis.KEY_LEFT  { key_left = false }
                if e.key() == guis.KEY_RIGHT { key_right = false }
            }
        }
    )
    
    font_fps.close()
    win.close()
}
