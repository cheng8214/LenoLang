// ============================================================
// GButton 光标测试 - 不同按钮设置不同悬停光标
// 移动鼠标到各个按钮上，观察光标变化
// ============================================================

import guis

func test_cursor() {
    print("=== GButton cursor 光标测试 ===")
    print("将鼠标移到各个按钮上，观察光标变化")

    Style[window] w_style = {
        width: 800,
        height: 500,
        center: true,
        bg_color: _rgb(30, 30, 46, 255),
        resizable: true
    }
    var win = guis.create_window("GButton 光标测试", w_style)

    // 第一行
    GButton btn1 = win.add_button({
        x: 50, y: 40, width: 120, height: 40,
        text: "hand",
        bg_color: _rgb(70, 130, 180),
        hover_color: _rgb(100, 160, 210),
        text_color: _rgb(255, 255, 255),
        radius: 8,
        cursor: "hand"
    })

    GButton btn2 = win.add_button({
        x: 190, y: 40, width: 120, height: 40,
        text: "ibeam",
        bg_color: _rgb(180, 70, 130),
        hover_color: _rgb(210, 100, 160),
        text_color: _rgb(255, 255, 255),
        radius: 8,
        cursor: "ibeam"
    })

    GButton btn3 = win.add_button({
        x: 330, y: 40, width: 120, height: 40,
        text: "crosshair",
        bg_color: _rgb(130, 180, 70),
        hover_color: _rgb(160, 210, 100),
        text_color: _rgb(255, 255, 255),
        radius: 8,
        cursor: "crosshair"
    })

    GButton btn4 = win.add_button({
        x: 470, y: 40, width: 120, height: 40,
        text: "wait",
        bg_color: _rgb(180, 130, 70),
        hover_color: _rgb(210, 160, 100),
        text_color: _rgb(255, 255, 255),
        radius: 8,
        cursor: "wait"
    })

    GButton btn5 = win.add_button({
        x: 610, y: 40, width: 120, height: 40,
        text: "progress",
        bg_color: _rgb(70, 180, 130),
        hover_color: _rgb(100, 210, 160),
        text_color: _rgb(255, 255, 255),
        radius: 8,
        cursor: "progress"
    })

    // 第二行
    GButton btn6 = win.add_button({
        x: 50, y: 100, width: 140, height: 40,
        text: "resize_nwse",
        bg_color: _rgb(100, 100, 200),
        hover_color: _rgb(130, 130, 230),
        text_color: _rgb(255, 255, 255),
        radius: 8,
        cursor: "resize_nwse"
    })

    GButton btn7 = win.add_button({
        x: 210, y: 100, width: 140, height: 40,
        text: "resize_nesw",
        bg_color: _rgb(200, 100, 100),
        hover_color: _rgb(230, 130, 130),
        text_color: _rgb(255, 255, 255),
        radius: 8,
        cursor: "resize_nesw"
    })

    GButton btn8 = win.add_button({
        x: 370, y: 100, width: 120, height: 40,
        text: "resize_ew",
        bg_color: _rgb(100, 200, 100),
        hover_color: _rgb(130, 230, 130),
        text_color: _rgb(255, 255, 255),
        radius: 8,
        cursor: "resize_ew"
    })

    GButton btn9 = win.add_button({
        x: 510, y: 100, width: 120, height: 40,
        text: "resize_ns",
        bg_color: _rgb(200, 200, 100),
        hover_color: _rgb(230, 230, 130),
        text_color: _rgb(255, 255, 255),
        radius: 8,
        cursor: "resize_ns"
    })

    GButton btn10 = win.add_button({
        x: 650, y: 100, width: 100, height: 40,
        text: "move",
        bg_color: _rgb(100, 200, 200),
        hover_color: _rgb(130, 230, 230),
        text_color: _rgb(255, 255, 255),
        radius: 8,
        cursor: "move"
    })

    // 第三行
    GButton btn11 = win.add_button({
        x: 50, y: 160, width: 140, height: 40,
        text: "not_allowed",
        bg_color: _rgb(150, 150, 150),
        hover_color: _rgb(180, 180, 180),
        text_color: _rgb(255, 255, 255),
        radius: 8,
        cursor: "not_allowed"
    })

    // 不设置 cursor 的按钮（默认 arrow）
    GButton btn12 = win.add_button({
        x: 210, y: 160, width: 200, height: 40,
        text: "默认 arrow",
        bg_color: _rgb(70, 70, 70),
        hover_color: _rgb(100, 100, 100),
        text_color: _rgb(255, 255, 255),
        radius: 8
    })

    // 关闭按下效果的按钮
    GButton btn13 = win.add_button({
        x: 430, y: 160, width: 140, height: 40,
        text: "无按下效果",
        bg_color: _rgb(200, 100, 200),
        hover_color: _rgb(230, 130, 230),
        text_color: _rgb(255, 255, 255),
        radius: 8,
        cursor: "hand",
        press_effect: false
    })

    // 更大偏移的按钮
    GButton btn14 = win.add_button({
        x: 590, y: 160, width: 140, height: 40,
        text: "偏移3px",
        bg_color: _rgb(100, 200, 200),
        hover_color: _rgb(130, 230, 230),
        text_color: _rgb(255, 255, 255),
        radius: 8,
        cursor: "hand",
        press_offset: 3
    })

    win.run(
        func(GDraw ren) {
            ren.set_color(_rgb(30, 30, 46, 255))
            ren.clear()
        },
        func(GEvent e) {
            if e.window_close() or (e.key_down() and e.key() == 27) {
                win.set_should_close(true)
            }
        }
    )
    win.close()
}

test_cursor()
