// ============================================================
// GTextBox 文本框测试
// 功能: 文本输入、光标、占位符、密码模式、Ctrl+C/V/A/X、锚点
// ============================================================

import guis

main() {
    print("=== GTextBox 测试 ===")
    print("点击文本框输入，Ctrl+A/C/V/X可用，回车提交")

    Style[window] w_style = {
        width: 700,
        height: 500,
        center: true,
        bg_color: _rgb(30, 30, 46, 255),
        resizable: true
    }
    var win = guis.create_window("GTextBox 文本框测试", w_style)

    GFont font = guis.load_font("Consolas", 16)

    // 普通文本框
    GTextBox tb1 = win.add_textbox({
        x: 50, y: 60, width: 300, height: 40,
        placeholder: "请输入用户名...",
        bg_color: _rgb(255, 255, 255, 255),
        border_color: _rgb(180, 180, 180, 255),
        focus_color: _rgb(70, 130, 220, 255),
        text_color: _rgb(30, 30, 30, 255),
        radius: 6,
        border_width: 1,
        font: "Consolas",
        font_size: 16,
        padding_x: 10
    })

    // 密码框
    GTextBox tb2 = win.add_textbox({
        x: 50, y: 130, width: 300, height: 40,
        placeholder: "请输入密码...",
        password: true,
        bg_color: _rgb(255, 255, 255, 255),
        border_color: _rgb(180, 180, 180, 255),
        focus_color: _rgb(70, 130, 220, 255),
        text_color: _rgb(30, 30, 30, 255),
        radius: 6,
        border_width: 1,
        font: "Consolas",
        font_size: 16,
        padding_x: 10
    })

    // 锚点测试：右下角文本框
    GTextBox tb3 = win.add_textbox({
        x: 0, y: 0, width: 250, height: 36,
        placeholder: "右下角锚点",
        radius: 4,
        border_width: 1,
        font: "Consolas",
        font_size: 14,
        padding_x: 8
    })
    tb3.set_anchor(4, 10, 10)  // 右下角

    // 回调
    tb1.on_change(func() {
        print("用户名变化: " + tb1.get_text())
    })
    tb1.on_submit(func() {
        print("用户名提交: " + tb1.get_text())
    })

    tb2.on_submit(func() {
        print("密码提交: " + tb2.get_text())
    })

    tb3.on_submit(func() {
        print("右下角提交: " + tb3.get_text())
    })

    win.run(
        func(GDraw ren) {
            ren.set_color(_rgb(30, 30, 46, 255))
            ren.clear()

            if font != null {
                ren.set_color(_rgb(200, 200, 200, 200))
                ren.draw_text(font, "用户名:", 50, 35)
                ren.draw_text(font, "密码:", 50, 108)
                ren.set_color(_rgb(100, 200, 100, 180))
                ren.draw_text(font, "Ctrl+A/C/V/X 可用 | 回车提交 | 密码框隐藏字符", 50, 200)
                ren.draw_text(font, "拖动窗口缩放 - 右下角框跟随锚点", 50, 230)
            }
        },
        func(GEvent e) {
            if e.is_window_close() or (e.is_key_down() and e.key() == 27) {
                win.set_should_close(true)
            }
        }
    )
    win.close()
    print("文本框测试结束")
}
