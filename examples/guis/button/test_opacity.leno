// ============================================================
// GButton 透明度测试 - 验证 opacity 样式和 set_opacity 方法
// ============================================================

import guis

main() {
    var bg = _rgb(28, 28, 44, 255)

    GWin win = guis.create_window("GButton Opacity Test", {
        width: 700,
        height: 500,
        center: true,
        bg_color: bg,
        resizable: true
    })

    /* 先放一个醒目的背景标签，方便观察透明度效果 */
    GLabel lb_bg = win.add_label({
        text: "BACKGROUND LABEL - 你应该能透过半透明按钮看到这段文字",
        x: 50, y: 60,
        text_color: _rgb(255, 200, 100, 255),
        font_size: 20,
        bg_color: _rgb(60, 60, 100, 255),
        padding_x: 16, padding_y: 10,
        radius: 8,
        width: 550, height: 60
    })

    /* ========== 不同 opacity 级别 ========== */
    var opacities = [255, 200, 150, 100, 50]
    var labels = ["255 (100%)", "200 (78%)", "150 (59%)", "100 (39%)", "50 (20%)"]

    for 5 to i {
        GButton btn = win.add_button({
            text: "opacity: " + labels[i],
            x: 50,
            y: 140 + i * 50,
            width: 200,
            height: 40,
            bg_color: _rgb(70, 130, 180, 255),
            text_color: _rgb(255, 255, 255, 255),
            radius: 8,
            opacity: opacities[i]
        })
    }

    /* ========== 带圆角 + opacity ========== */
    for 5 to i {
        GButton btn2 = win.add_button({
            text: "round " + labels[i],
            x: 280,
            y: 140 + i * 50,
            width: 200,
            height: 40,
            bg_color: _rgb(180, 70, 70, 255),
            text_color: _rgb(255, 255, 255, 255),
            radius: 12,
            opacity: opacities[i]
        })
    }

    /* ========== 动态 set_opacity 测试 ========== */
    GButton btn_dyn = win.add_button({
        text: "Click: opacity cycles 255->128->64->32->255",
        x: 50, y: 400,
        width: 350, height: 40,
        bg_color: _rgb(80, 160, 120, 255),
        text_color: _rgb(255, 255, 255, 255),
        radius: 8
    })

    var op_idx = 0
    var dyn_ops = [255, 128, 64, 32]
    btn_dyn.on_click(func() {
        op_idx = (op_idx + 1) % 4
        btn_dyn.set_opacity(dyn_ops[op_idx])
        btn_dyn.set_text("Current opacity: " + dyn_ops[op_idx])
    })

    /* ========== 带 hover/press_color + opacity ========== */
    GButton btn_hover = win.add_button({
        text: "hover+press + opacity:128",
        x: 420, y: 400,
        width: 230, height: 40,
        bg_color: _rgb(70, 130, 180, 255),
        hover_color: _rgb(100, 160, 210, 255),
        press_color: _rgb(50, 100, 150, 255),
        text_color: _rgb(255, 255, 255, 255),
        radius: 8,
        opacity: 128
    })

    /* ========== 带边框 + opacity ========== */
    GButton btn_border = win.add_button({
        text: "border + opacity:100",
        x: 420, y: 450,
        width: 230, height: 40,
        bg_color: _rgb(60, 60, 80, 255),
        text_color: _rgb(255, 255, 255, 255),
        radius: 10,
        border_width: 2,
        border_color: _rgb(100, 180, 255, 255),
        opacity: 100
    })

    win.run(
        func(GDraw ren) {
            ren.set_color(bg)
            ren.clear()
        },
        func(GEvent e) {
            if e.window_close() or (e.key_down() and e.key() == 27) {
                win.set_should_close(true)
            }
        }
    )

    win.close()
}
