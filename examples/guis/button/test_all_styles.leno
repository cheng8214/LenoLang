        shadow_color: _rgb(0, 0, 0, 40)
    })

    win.add_button({
        x: 410, y: 310, width: 160, height: 50,
        text: "大字体",
        bg_color: _rgb(255, 100, 50, 255),
        hover_color: _rgb(255, 120, 70, 255),
        press_color: _rgb(230, 80, 40, 255),
        text_color: _rgb(255, 255, 255, 255),
        radius: 8,
        font_size: 24
    })

    win.add_button({
        x: 590, y: 310, width: 120, height: 42,
