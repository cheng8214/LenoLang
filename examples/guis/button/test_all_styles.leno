        press_color: _rgb(80, 100, 120, 255),
        text_color: _rgb(255, 255, 255, 255),
        radius: 6,
        text_decoration: "underline"
    })

    win.add_button({
        x: 590, y: 380, width: 100, height: 42,
        text: "删除",
        bg_color: _rgb(240, 70, 70, 255),
        hover_color: _rgb(255, 90, 90, 255),
        press_color: _rgb(210, 50, 50, 255),
        text_color: _rgb(255, 255, 255, 255),
        radius: 6
    })

    /* ========== 第7行 ========== */
    win.add_button({
        x: 50, y: 440, width: 120, height: 42,
        text: "删除线",
        bg_color: _rgb(120, 120, 120, 255),
        hover_color: _rgb(140, 140, 140, 255),
        press_color: _rgb(100, 100, 100, 255),
        text_color: _rgb(255, 255, 255, 255),
        radius: 6,
        text_decoration: "strikethrough"
    })

    win.add_button({
        x: 190, y: 440, width: 120, height: 42,
