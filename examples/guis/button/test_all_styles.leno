        bg_color: _rgb(240, 80, 130, 255),
        hover_color: _rgb(255, 100, 150, 255),
        press_color: _rgb(220, 60, 110, 255),
        text_color: _rgb(255, 255, 255, 255),
        radius: 6,
        hover_scale: 1.1
    })

    win.add_button({
        x: 470, y: 440, width: 120, height: 42,
