    win.add_button({
        x: 590, y: 110, width: 80, height: 42,
        text: "上传",
        bg_color: _rgb(80, 170, 80, 255),
        hover_color: _rgb(100, 190, 100, 255),
        press_color: _rgb(60, 150, 60, 255),
        text_color: _rgb(255, 255, 255, 255),
        radius: 6
    })

    /* ========== 第3行 ========== */
    win.add_button({
        x: 50, y: 170, width: 160, height: 42,
        text: "半透明",
        bg_color: _rgb(100, 170, 240, 255),
        hover_color: _rgb(120, 190, 255, 255),
        press_color: _rgb(80, 150, 220, 255),
        text_color: _rgb(255, 255, 255, 255),
