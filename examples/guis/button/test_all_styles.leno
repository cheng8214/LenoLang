import guis

main() {
    Style[window] w_style = {
        width: 900,
        height: 700,
        center: true,
        bg_color: _rgb(245, 245, 245, 255),
        resizable: true
    }
    var win = guis.create_window("Button Style 测试", w_style)

    /* ========== 第1行 ========== */
    win.add_button({
        x: 50, y: 50, width: 160, height: 42,
        text: "圆角按钮",
        bg_color: _rgb(70, 130, 220, 255),
        hover_color: _rgb(90, 150, 240, 255),
        press_color: _rgb(50, 110, 200, 255),
        text_color: _rgb(255, 255, 255, 255),
        radius: 8
    })

    win.add_button({
        x: 230, y: 50, width: 160, height: 42,
        text: "警告按钮",
        bg_color: _rgb(240, 70, 70, 255),
        hover_color: _rgb(255, 90, 90, 255),
        press_color: _rgb(210, 50, 50, 255),
        text_color: _rgb(255, 255, 255, 255),
