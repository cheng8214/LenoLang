        bg_color: _rgb(80, 170, 80, 255),
        hover_color: _rgb(100, 190, 100, 255),
        press_color: _rgb(60, 150, 60, 255),
        text_color: _rgb(255, 255, 255, 255),
        radius: 6
    })

    win.add_button({
        x: 230, y: 110, width: 160, height: 42,
