    /* ========== 第6行 ========== */
    win.add_button({
        x: 50, y: 380, width: 160, height: 42,
        text: "独立圆角",
        bg_color: _rgb(150, 50, 180, 255),
        hover_color: _rgb(170, 70, 200, 255),
        press_color: _rgb(130, 40, 160, 255),
        text_color: _rgb(255, 255, 255, 255),
        radius_tl: 20,
        radius_tr: 4,
        radius_bl: 4,
        radius_br: 20
    })

    win.add_button({
        x: 230, y: 380, width: 160, height: 42,
        text: "虚线边框",
        bg_color: _rgb(255, 255, 255, 255),
        hover_color: _rgb(240, 248, 255, 255),
        press_color: _rgb(220, 240, 255, 255),
        text_color: _rgb(60, 120, 180, 255),
        radius: 6,
        border_width: 2,
        border_color: _rgb(60, 120, 180, 255),
        border_style: "dashed"
