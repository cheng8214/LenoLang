        press_color: _rgb(80, 40, 130, 255),
        text_color: _rgb(255, 255, 255, 255),
        radius: 8
    })

    /* ========== 第5行 ========== */
    win.add_button({
        x: 50, y: 310, width: 160, height: 42,
        text: "边框变化",
        bg_color: _rgb(255, 255, 255, 255),
        hover_color: _rgb(240, 240, 240, 255),
        press_color: _rgb(220, 220, 220, 255),
        text_color: _rgb(80, 80, 80, 255),
        radius: 6,
        border_width: 2,
        border_color: _rgb(150, 150, 150, 255)
    })

    win.add_button({
        x: 230, y: 310, width: 160, height: 42,
        text: "立体效果",
        bg_color: _rgb(80, 170, 80, 255),
        hover_color: _rgb(100, 190, 100, 255),
        press_color: _rgb(60, 150, 60, 255),
        text_color: _rgb(255, 255, 255, 255),
        radius: 6,
        border_width: 2,
        border_color: _rgb(60, 140, 60, 255),
        shadow_offset_x: 0,
        shadow_offset_y: 3,
