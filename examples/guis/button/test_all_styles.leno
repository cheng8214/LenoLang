        text_color: _rgb(255, 255, 255, 255),
        radius: 21
    })

    /* ========== 第4行 ========== */
    win.add_button({
        x: 50, y: 230, width: 60, height: 60,
        text: "圆形",
        bg_color: _rgb(220, 50, 100, 255),
        hover_color: _rgb(240, 70, 120, 255),
        press_color: _rgb(200, 40, 80, 255),
        text_color: _rgb(255, 255, 255, 255),
        radius: 30
    })

    win.add_button({
        x: 130, y: 230, width: 160, height: 42,
