        bg_color: _rgb(255, 255, 255, 255),
        hover_color: _rgb(255, 250, 240, 255),
        press_color: _rgb(255, 240, 220, 255),
        text_color: _rgb(200, 100, 50, 255),
        radius: 6,
        border_width: 2,
        border_color: _rgb(200, 100, 50, 255),
        border_style: "dotted"
    })

    /* ========== 第8行 ========== */
    win.add_button({
        x: 50, y: 500, width: 120, height: 42,
        text: "上划线",
        bg_color: _rgb(120, 90, 70, 255),
        hover_color: _rgb(140, 110, 90, 255),
        press_color: _rgb(100, 70, 50, 255),
        text_color: _rgb(255, 255, 255, 255),
        radius: 6,
        text_decoration: "overline"
    })

    win.add_button({
        x: 190, y: 500, width: 160, height: 50,
        text: "胶囊按钮",
        bg_color: _rgb(0, 180, 200, 255),
        hover_color: _rgb(0, 200, 220, 255),
        press_color: _rgb(0, 160, 180, 255),
        text_color: _rgb(255, 255, 255, 255),
        radius: 25,
        font_size: 18
    })

    win.add_button({
        x: 370, y: 500, width: 160, height: 50,
        text: "[ 超级 ]",
        bg_color: _rgb(100, 60, 180, 255),
        hover_color: _rgb(120, 80, 200, 255),
        press_color: _rgb(80, 50, 160, 255),
        text_color: _rgb(255, 255, 255, 255),
        radius: 10,
        font_size: 18,
        letter_spacing: 4
    })

    win.add_button({
        x: 550, y: 500, width: 180, height: 50,
        text: "终极按钮",
        gradient: [_rgb(255, 80, 80, 255), _rgb(255, 50, 150, 255)],
        hover_color: _rgb(255, 100, 100, 255),
        press_color: _rgb(230, 60, 130, 255),
        text_color: _rgb(255, 255, 255, 255),
        radius: 25,
        font_size: 20,
        border_width: 2,
        border_color: _rgb(255, 150, 150, 255),
        shadow_offset_x: 0,
        shadow_offset_y: 5,
        shadow_radius: 15,
        shadow_color: _rgb(255, 80, 80, 100)
    })

    /* ========== 底部说明文字 ========== */

    win.run(
        func(GDraw ren) {
            ren.set_color(_rgb(245, 245, 245, 255))
            ren.clear()
        },
        func(GEvent e) {
            if e.window_close() or (e.key_down() and e.key() == 27) {
                win.set_should_close(true)
            }
        }
    )
    win.close()
}
