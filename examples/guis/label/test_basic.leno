import guis

main() {
    var bg = _rgb(28, 28, 44, 255)

    GWin win = guis.create_window("GLabel - Basic Test", {
        width: 600,
        height: 400,
        resizable: true,
        bg_color: bg
    })

    GLabel lb1 = win.add_label({
        text: "Hello, GLabel!",
        x: 20, y: 20,
        text_color: _rgb(255, 255, 255, 255),
        font_size: 24
    })

    GLabel lb2 = win.add_label({
        text: "This is a static text label.",
        x: 20, y: 60,
        text_color: _rgb(180, 200, 220, 255),
        font_size: 16
    })

    GLabel lb3 = win.add_label({
        text: "支持中文文本显示",
        x: 20, y: 100,
        text_color: _rgb(100, 200, 255, 255),
        font_size: 18
    })

    win.run(
        func(GDraw ren) {
            ren.clear()
        },
        func(GEvent e) {
            if e.window_close() { win.set_should_close(true) }
        }
    )

    win.close()
}