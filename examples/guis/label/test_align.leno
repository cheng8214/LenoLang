import guis

main() {
    var bg = _rgb(28, 28, 44, 255)

    GWin win = guis.create_window("GLabel - Align Test", {
        width: 600,
        height: 400,
        resizable: true,
        bg_color: bg
    })

    var w = 540
    var h = 50

    /* 左对齐 (0) */
    win.add_label({
        text: "← Left Aligned",
        x: 30, y: 20, width: w, height: h,
        text_color: _rgb(255, 255, 255, 255),
        bg_color: _rgb(60, 60, 80, 255),
        font_size: 18,
        align: 0, padding_x: 12, radius: 6
    })

    /* 居中 (1) */
    win.add_label({
        text: "Center Aligned",
        x: 30, y: 85, width: w, height: h,
        text_color: _rgb(255, 255, 255, 255),
        bg_color: _rgb(50, 70, 100, 255),
        font_size: 18,
        align: 1, padding_x: 12, radius: 6
    })

    /* 右对齐 (2) */
    win.add_label({
        text: "Right Aligned →",
        x: 30, y: 150, width: w, height: h,
        text_color: _rgb(255, 255, 255, 255),
        bg_color: _rgb(70, 50, 80, 255),
        font_size: 18,
        align: 2, padding_x: 12, radius: 6
    })

    /* 不同字号居中 */
    win.add_label({
        text: "Large Centered Text",
        x: 30, y: 230, width: w, height: 60,
        text_color: _rgb(100, 200, 255, 255),
        bg_color: _rgb(40, 40, 55, 255),
        font_size: 26,
        align: 1, radius: 8,
        border_width: 1,
        border_color: _rgb(80, 120, 180, 128)
    })
 
    win.run(
        func(GDraw ren) { ren.clear() },
        func(GEvent e) {
            if e.window_close() { win.set_should_close(true) }
        }
    )

    win.close()
}