// ============================================================
// GLabel 标签全面测试 - 新增特性: font_bold, font_name, opacity, shadow, enabled
// ============================================================

import guis

main() {
    var bg = _rgb(28, 28, 44, 255)

    GWin win = guis.create_window("GLabel 全面测试", {
        width: 800,
        height: 600,
        center: true,
        bg_color: bg,
        resizable: true
    })

    /* ========== 1. font_bold 测试 ========== */
    GLabel lb_bold = win.add_label({
        text: "Bold Text (font_bold: true)",
        x: 20, y: 20,
        text_color: _rgb(255, 200, 100, 255),
        font_size: 22,
        font_bold: true,
        bg_color: _rgb(50, 50, 70, 200),
        padding_x: 12, padding_y: 6,
        radius: 6
    })

    GLabel lb_normal = win.add_label({
        text: "Normal Text (font_bold: false)",
        x: 20, y: 60,
        text_color: _rgb(200, 200, 200, 255),
        font_size: 22,
        font_bold: false,
        bg_color: _rgb(50, 50, 70, 200),
        padding_x: 12, padding_y: 6,
        radius: 6
    })

    /* ========== 2. opacity 测试 ========== */
    GLabel lb_full = win.add_label({
        text: "opacity: 255 (完全不透明)",
        x: 20, y: 110,
        text_color: _rgb(100, 200, 255, 255),
        font_size: 18,
        bg_color: _rgb(70, 70, 90, 255),
        padding_x: 10, padding_y: 4,
        radius: 4,
        opacity: 255
    })

    GLabel lb_half = win.add_label({
        text: "opacity: 128 (50% 透明)",
        x: 20, y: 145,
        text_color: _rgb(100, 200, 255, 255),
        font_size: 18,
        bg_color: _rgb(70, 70, 90, 255),
        padding_x: 10, padding_y: 4,
        radius: 4,
        opacity: 128
    })

    GLabel lb_low = win.add_label({
        text: "opacity: 64 (低透明度)",
        x: 20, y: 180,
        text_color: _rgb(100, 200, 255, 255),
        font_size: 18,
        bg_color: _rgb(70, 70, 90, 255),
        padding_x: 10, padding_y: 4,
        radius: 4,
        opacity: 64
    })

    /* ========== 3. shadow 测试 ========== */
    GLabel lb_shadow = win.add_label({
        text: "Shadow Label",
        x: 300, y: 20,
        text_color: _rgb(255, 255, 255, 255),
        font_size: 24,
        bg_color: _rgb(80, 120, 180, 255),
        padding_x: 16, padding_y: 10,
        radius: 8,
        shadow_offset_x: 3,
        shadow_offset_y: 3,
        shadow_radius: 6,
        shadow_color: _rgb(0, 0, 0, 180)
    })

    GLabel lb_shadow_big = win.add_label({
        text: "Big Shadow",
        x: 300, y: 80,
        text_color: _rgb(255, 220, 150, 255),
        font_size: 28,
        bg_color: _rgb(120, 80, 60, 255),
        padding_x: 20, padding_y: 12,
        radius: 10,
        shadow_offset_x: 5,
        shadow_offset_y: 5,
        shadow_radius: 12,
        shadow_color: _rgb(0, 0, 0, 220)
    })

    /* ========== 4. font_name 测试 ========== */
    GLabel lb_font1 = win.add_label({
        text: "Microsoft YaHei (默认)",
        x: 20, y: 230,
        text_color: _rgb(180, 180, 220, 255),
        font_size: 16,
        font_name: "Microsoft YaHei"
    })

    GLabel lb_font2 = win.add_label({
        text: "SimHei (黑体)",
        x: 20, y: 260,
        text_color: _rgb(180, 180, 220, 255),
        font_size: 16,
        font_name: "SimHei"
    })

    /* ========== 5. 动态方法测试 ========== */
    GLabel lb_dyn = win.add_label({
        text: "Dynamic Label",
        x: 300, y: 140,
        text_color: _rgb(255, 255, 255, 255),
        font_size: 20,
        bg_color: _rgb(60, 60, 80, 255),
        padding_x: 12, padding_y: 6,
        radius: 6
    })

    var dyn_count = 0

    /* 按钮控制动态修改 */
    GButton btn_bold = win.add_button({
        text: "Toggle Bold",
        x: 20, y: 310,
        width: 140, height: 32,
        bg_color: _rgb(70, 130, 180, 255),
        text_color: _rgb(255, 255, 255, 255),
        radius: 6
    })
    btn_bold.on_click(func() {
        dyn_count = dyn_count + 1
        if dyn_count % 2 == 1 {
            lb_dyn.set_font_bold(true)
            lb_dyn.set_text("Bold Dynamic")
        } else {
            lb_dyn.set_font_bold(false)
            lb_dyn.set_text("Normal Dynamic")
        }
    })

    GButton btn_opacity = win.add_button({
        text: "Change Opacity",
        x: 170, y: 310,
        width: 140, height: 32,
        bg_color: _rgb(70, 130, 180, 255),
        text_color: _rgb(255, 255, 255, 255),
        radius: 6
    })
    btn_opacity.on_click(func() {
        var ops = [255, 200, 128, 64, 32]
        var idx = dyn_count % 5
        lb_dyn.set_opacity(ops[idx])
        lb_dyn.set_text("Opacity: " + ops[idx])
    })

    GButton btn_shadow = win.add_button({
        text: "Toggle Shadow",
        x: 320, y: 310,
        width: 140, height: 32,
        bg_color: _rgb(70, 130, 180, 255),
        text_color: _rgb(255, 255, 255, 255),
        radius: 6
    })
    btn_shadow.on_click(func() {
        dyn_count = dyn_count + 1
        if dyn_count % 2 == 1 {
            lb_dyn.set_shadow(3, 3, 8, _rgb(0, 0, 0, 180))
            lb_dyn.set_text("Shadow On")
        } else {
            lb_dyn.set_shadow(0, 0, 0, _rgb(0, 0, 0, 0))
            lb_dyn.set_text("Shadow Off")
        }
    })

    GButton btn_font = win.add_button({
        text: "Change Font",
        x: 470, y: 310,
        width: 140, height: 32,
        bg_color: _rgb(70, 130, 180, 255),
        text_color: _rgb(255, 255, 255, 255),
        radius: 6
    })
    btn_font.on_click(func() {
        var fonts = ["Microsoft YaHei", "SimHei", "KaiTi", "FangSong"]
        var idx = dyn_count % 4
        lb_dyn.set_font_name(fonts[idx])
        lb_dyn.set_text("Font: " + fonts[idx])
        dyn_count = dyn_count + 1
    })

    /* ========== 6. enabled 测试 ========== */
    GLabel lb_enabled = win.add_label({
        text: "Enabled Label",
        x: 20, y: 370,
        text_color: _rgb(100, 255, 100, 255),
        font_size: 18
    })

    GButton btn_enable = win.add_button({
        text: "Toggle Enabled",
        x: 200, y: 370,
        width: 140, height: 32,
        bg_color: _rgb(70, 130, 180, 255),
        text_color: _rgb(255, 255, 255, 255),
        radius: 6
    })
    var en_state = true
    btn_enable.on_click(func() {
        en_state = not en_state
        lb_enabled.set_enabled(en_state)
        if en_state {
            lb_enabled.set_text("Enabled Label")
            lb_enabled.set_text_color(_rgb(100, 255, 100, 255))
        } else {
            lb_enabled.set_text("Disabled Label")
            lb_enabled.set_text_color(_rgb(128, 128, 128, 255))
        }
    })

    /* ========== 7. opacity + shadow 组合 ========== */
    GLabel lb_combo = win.add_label({
        text: "Opacity + Shadow",
        x: 300, y: 370,
        text_color: _rgb(255, 255, 200, 255),
        font_size: 20,
        bg_color: _rgb(100, 60, 40, 255),
        padding_x: 14, padding_y: 8,
        radius: 8,
        opacity: 180,
        shadow_offset_x: 4,
        shadow_offset_y: 4,
        shadow_radius: 8,
        shadow_color: _rgb(0, 0, 0, 150)
    })

    /* ========== 提示信息 ========== */
    GLabel lb_tip = win.add_label({
        text: "点击按钮测试动态修改: font_bold / opacity / shadow / font_name / enabled",
        x: 20, y: 420,
        text_color: _rgb(160, 160, 180, 255),
        font_size: 14
    })

    win.run(
        func(GDraw ren) {
            ren.set_color(bg)
            ren.clear()
        },
        func(GEvent e) {
            if e.window_close() or (e.key_down() and e.key() == 27) {
                win.set_should_close(true)
            }
        }
    )

    win.close()
}
