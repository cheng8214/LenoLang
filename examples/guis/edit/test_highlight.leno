// ============================================================
// GTextBox - 关键字高亮测试
// 自动高亮 for/if/else/func/import/var/return/while/true/false
// 复制几百行代码进来测试性能
// ============================================================

import guis

main() {

    Style[window] w_style = {
        width: 900,
        height: 720,
        center: true,
        bg_color: _rgb(20, 22, 36, 255),
        resizable: true
    }
    GWin win = guis.create_window("关键字高亮测试 - 可粘贴代码", w_style)

    var font_title = guis.load_font("Consolas", 18)
    var font_btn = guis.load_font("Arial", 12)

    // ===== 大编辑框（等宽字体） =====
    Style[edit] s_edit = {
        x: 20, y: 50, width: 860, height: 540,
        placeholder: "在此粘贴代码，然后点下面按钮高亮...",
        multiline: true,
        font: "Consolas",
        font_size: 15, radius: 4,
        bg_color: _rgb(30, 32, 50, 255),
        text_color: _rgb(210, 210, 230, 255),
        cursor_color: _rgb(180, 200, 240, 255),
        selection_color: _rgb(80, 120, 200, 100),
        border_color: _rgb(50, 55, 75, 255),
        focus_color: _rgb(80, 140, 220, 255),
        placeholder_color: _rgb(100, 100, 130, 150),
        sb_track_color: _rgb(22, 24, 38, 255),
        sb_thumb_color: _rgb(70, 80, 110, 255),
        sb_thumb_hover_color: _rgb(100, 120, 170, 255),
        sb_thumb_press_color: _rgb(50, 60, 90, 255)
    }
    GTextBox tb = win.add_textbox(s_edit)

    // 预置示例代码
    var sample =
"// Leno 语言示例代码\n" +
"import guis\n" +
"import strings\n" +
"\n" +
"func factorial(int n):int {\n" +
"    if n <= 1 { return 1 }\n" +
"    return n * factorial(n - 1)\n" +
"}\n" +
"\n" +
"func is_prime(int n):bool {\n" +
"    if n < 2 { return false }\n" +
"    var i = 2\n" +
"    while i * i <= n {\n" +
"        if n % i == 0 { return false }\n" +
"        i = i + 1\n" +
"    }\n" +
"    return true\n" +
"}\n" +
"\n" +
"func main() {\n" +
"    var x = 10\n" +
"    for 0 : x to i {\n" +
"        var n = i * i\n" +
"        if is_prime(n) {\n" +
"            print(_str(n) + \" is prime\")\n" +
"        } else {\n" +
"            print(_str(n) + \" is not prime\")\n" +
"        }\n" +
"    }\n" +
"\n" +
"    var arr = [1, 2, 3, 4, 5]\n" +
"    for 0 : arr.len() to j {\n" +
"        if arr[j] > 3 { break }\n" +
"        print(arr[j])\n" +
"    }\n" +
"    return 0\n" +
"}\n"
    tb.set_text(sample)

    // ===== 按钮 =====
    var by = 605
    var bw = 110; var bh = 36

    GButton btn_all = win.add_button({
        x: 20, y: by, width: bw, height: bh,
        text: "手动高亮",
        bg_color: _rgb(80, 120, 200, 255),
        hover_color: _rgb(110, 150, 230, 255),
        press_color: _rgb(50, 80, 150, 255),
        text_color: _rgb(255, 255, 255, 255), radius: 6
    })

    var auto_mode = false
    GButton btn_auto = win.add_button({
        x: 140, y: by, width: bw, height: bh,
        text: "自动高亮:关",
        bg_color: _rgb(100, 100, 120, 255),
        hover_color: _rgb(140, 140, 160, 255),
        press_color: _rgb(60, 60, 80, 255),
        text_color: _rgb(255, 255, 255, 255), radius: 6
    })

    GButton btn_clear = win.add_button({
        x: 260, y: by, width: 90, height: bh,
        text: "清除",
        bg_color: _rgb(150, 80, 80, 255),
        hover_color: _rgb(190, 110, 110, 255),
        press_color: _rgb(110, 50, 50, 255),
        text_color: _rgb(255, 255, 255, 255), radius: 6
    })

    GButton btn_reset = win.add_button({
        x: 360, y: by, width: 90, height: bh,
        text: "重置",
        bg_color: _rgb(80, 80, 100, 255),
        hover_color: _rgb(120, 120, 140, 255),
        press_color: _rgb(50, 50, 70, 255),
        text_color: _rgb(255, 255, 255, 255), radius: 6
    })

    // ===== 状态 =====
    var result_msg = "点击 [高亮全部关键字] 或粘贴代码后再点"
    var total_highlights = 0

    // ===== 高亮辅助函数 =====
    // 判断字符是不是单词组成部分
    func is_word_char(int c):bool {
        return (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or (c >= 48 and c <= 57) or c == 95
    }

    func highlight_keyword(string kw, int len, int r, int g, int b) {
        var pos = 0
        var count = 0
        var text = tb.get_text()
        var text_len = text.len()
        while pos >= 0 and pos < text_len {
            pos = tb.find(kw, pos)
            if pos < 0 { break }
            var ok = true
            if pos > 0 {
                if is_word_char(text.byte(pos - 1)) { ok = false }
            }
            if pos + len < text_len {
                if is_word_char(text.byte(pos + len)) { ok = false }
            }
            if ok {
                tb.set_range_color(pos, len, _rgb(r, g, b, 255))
                count = count + 1
            }
            pos = pos + 1
        }
        return count
    }

    func do_highlight() {
        tb.clear_colors()
        var c = 0
        c = c + _int(highlight_keyword("for",    3, 255, 140, 60))
        c = c + _int(highlight_keyword("while",  5, 255, 140, 60))
        c = c + _int(highlight_keyword("if",     2, 255, 140, 60))
        c = c + _int(highlight_keyword("else",   4, 255, 140, 60))
        c = c + _int(highlight_keyword("break",  5, 255, 140, 60))
        c = c + _int(highlight_keyword("return", 6, 255, 140, 60))
        c = c + _int(highlight_keyword("func",   4, 80, 160, 255))
        c = c + _int(highlight_keyword("import", 6, 80, 160, 255))
        c = c + _int(highlight_keyword("var",    3, 80, 160, 255))
        c = c + _int(highlight_keyword("true",   4, 60, 200, 200))
        c = c + _int(highlight_keyword("false",  5, 60, 200, 200))
        total_highlights = c
        result_msg = "高亮: " + _str(c) + " 个关键字"
    }

    // ===== 按钮回调 =====
    btn_all.on_click(func() { do_highlight() })

    btn_auto.on_click(func() {
        auto_mode = not auto_mode
        if auto_mode {
            btn_auto.set_text("自动高亮:开")
            do_highlight()
        } else {
            btn_auto.set_text("自动高亮:关")
        }
    })

    btn_clear.on_click(func() {
        tb.clear_colors()
        result_msg = "已清除高亮"
        total_highlights = 0
    })

    btn_reset.on_click(func() {
        tb.clear_colors()
        tb.set_text(sample)
        result_msg = "已重置为示例代码"
        total_highlights = 0
    })

    // ===== 自动高亮：文本变化时触发 =====
    tb.on_change(func() {
        if auto_mode { do_highlight() }
    })

    // ===== 渲染 =====
    win.run(
        func(GDraw ren) {
            ren.set_color(_rgb(20, 22, 36, 255))
            ren.clear()

            ren.set_color(_rgb(255, 255, 255, 255))
            ren.draw_text(font_title, "关键字高亮测试 - 复制代码进来试试", 20, 18)

            ren.set_color(_rgb(140, 140, 170, 255))
            if result_msg != "" {
                ren.set_color(_rgb(255, 220, 100, 255))
                ren.draw_text(font_btn, result_msg, 380, by + 10)
            }
            if total_highlights > 0 {
                ren.set_color(_rgb(160, 200, 160, 255))
                ren.draw_text(font_btn, "函数/定义=蓝色 | 控制流=橙色 | 常量=青色", 20, by + 50)
            }

            ren.set_color(_rgb(100, 100, 130, 255))
            ren.draw_text(font_btn, "Ctrl+V 粘贴代码 | 拖动滚动条 | 选中文本", 20, 685)
        },
        func(GEvent e) {
            if e.window_close() { win.set_should_close(true) }
            if e.key_down() and e.key() == 27 { win.set_should_close(true) }
        }
    )

    font_title.close()
    font_btn.close()
    win.close()
}
