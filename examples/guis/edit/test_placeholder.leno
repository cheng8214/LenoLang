// ============================================================
// GTextBox - placeholder 测试
// 测试：不同颜色、字体大小、多行、密码框等场景
// ============================================================

import guis

main() {
    _console(false)

    Style[window] w_style = {
        width: 750,
        height: 650,
        center: true,
        bg_color: _rgb(30, 30, 46, 255),
        resizable: true
    }
    GWin win = guis.create_window("GTextBox Placeholder 测试", w_style)

    var font_title = guis.load_font("Arial", 24)
    var font_label = guis.load_font("Arial", 13)

    // ---- 1. 默认 placeholder ----
    GTextBox tb1 = win.add_textbox({
        x: 50, y: 70, width: 300, height: 36,
        placeholder: "请输入用户名...",
        font_size: 14,
        radius: 6
    })

    // ---- 2. 自定义 placeholder 颜色 ----
    GTextBox tb2 = win.add_textbox({
        x: 50, y: 130, width: 300, height: 36,
        placeholder: "浅红色 placeholder",
        placeholder_color: _rgb(255, 120, 120, 180),
        font_size: 16,
        radius: 6
    })

    // ---- 3. placeholder 字体更小 ----
    GTextBox tb3 = win.add_textbox({
        x: 50, y: 190, width: 300, height: 40,
        placeholder: "Search something... (smaller)",
        placeholder_color: _rgb(140, 160, 200, 200),
        placeholder_font_size: 11,
        font_size: 18,
        radius: 6
    })

    // ---- 4. 密码框 placeholder ----
    GTextBox tb4 = win.add_textbox({
        x: 400, y: 70, width: 300, height: 36,
        placeholder: "输入密码",
        placeholder_color: _rgb(200, 200, 150, 200),
        password: true,
        font_size: 14,
        radius: 6
    })

    // ---- 5. 多行 placeholder ----
    GTextBox tb5 = win.add_textbox({
        x: 400, y: 130, width: 300, height: 120,
        placeholder: "多行编辑框...\n可以输入多行文字\n支持滚动条",
        placeholder_color: _rgb(120, 180, 140, 200),
        multiline: true,
        font_size: 14,
        radius: 6
    })

    // ---- 6. 深色背景 + 亮色 placeholder ----
    GTextBox tb6 = win.add_textbox({
        x: 50, y: 260, width: 300, height: 40,
        placeholder: "深色背景 placeholder",
        bg_color: _rgb(50, 55, 70, 255),
        text_color: _rgb(220, 220, 240, 255),
        placeholder_color: _rgb(180, 180, 200, 150),
        border_color: _rgb(100, 110, 140, 255),
        focus_color: _rgb(100, 180, 255, 255),
        font_size: 16,
        radius: 6
    })

    // ---- 7. 粗边框 + 大圆角 + placeholder ----
    GTextBox tb7 = win.add_textbox({
        x: 400, y: 280, width: 300, height: 44,
        placeholder: "大圆角 & 粗边框",
        border_width: 2,
        radius: 12,
        font_size: 15,
        placeholder_color: _rgb(160, 160, 180, 200)
    })

    // ---- 回调：动态修改 tb3 的 placeholder 颜色 ----
    tb3.on_change(func() {
        // placeholder 颜色保持不变
    })

    tb1.on_submit(func() {
        print("用户输入: ")
    })

    win.run(
        func(GDraw ren) {
            ren.set_color(_rgb(30, 30, 46, 255))
            ren.clear()

            ren.set_color(_rgb(255, 255, 255, 255))
            ren.draw_text(font_title, "GTextBox - Placeholder 测试", 50, 20)

            // 标签
            ren.set_color(_rgb(180, 180, 200, 255))

            ren.draw_text(font_label, "默认", 50, 55)
            ren.draw_text(font_label, "自定义颜色", 50, 115)
            ren.draw_text(font_label, "小字体 placeholder", 50, 175)
            ren.draw_text(font_label, "深色背景", 50, 245)

            ren.draw_text(font_label, "密码框", 400, 55)
            ren.draw_text(font_label, "多行编辑框", 400, 115)
            ren.draw_text(font_label, "大圆角粗边框", 400, 265)
        },
        func(GEvent e) {
            if e.is_window_close() { win.set_should_close(true) }
            if e.is_key_down() and e.key() == 27 { win.set_should_close(true) }
        }
    )

    font_title.close()
    font_label.close()
    win.close()
}
