// ============================================================
// GTextBox - Style[edit] 样式声明测试
// 使用 Style[edit] 而非内联 dict，支持 IDE 自动补全
// ============================================================

import guis

main() {
    _console(false)

    // ===== window 样式 =====
    Style[window] w_style = {
        width: 820,
        height: 680,
        center: true,
        bg_color: _rgb(22, 22, 38, 255),
        resizable: true
    }
    GWin win = guis.create_window("Style[edit] 测试", w_style)

    var font_title = guis.load_font("Arial", 22)
    var font_label = guis.load_font("Arial", 12)

    // ========== 1. 样式：红色光标 + 橙色选区 ==========
    Style[edit] s_cursor = {
        x: 50, y: 70, width: 340, height: 38,
        placeholder: "红色光标 + 橙色选区",
        cursor_color: _rgb(255, 60, 60, 255),
        selection_color: _rgb(255, 180, 60, 140),
        font_size: 15, radius: 6
    }
    GTextBox tb1 = win.add_textbox(s_cursor)
    tb1.set_text("选中文字看选区颜色")

    // ========== 2. 样式：蓝色主题全部颜色 ==========
    Style[edit] s_blue = {
        x: 50, y: 130, width: 340, height: 38,
        placeholder: "蓝色主题",
        bg_color: _rgb(28, 32, 50, 255),
        text_color: _rgb(180, 200, 255, 255),
        cursor_color: _rgb(100, 160, 255, 255),
        border_color: _rgb(60, 80, 130, 255),
        focus_color: _rgb(80, 160, 255, 255),
        font_size: 15, radius: 6
    }
    win.add_textbox(s_blue)

    // ========== 3. 样式：字间距 4px + 绿色主题 ==========
    Style[edit] s_green = {
        x: 50, y: 190, width: 340, height: 38,
        placeholder: "字间距 4px",
        bg_color: _rgb(20, 38, 28, 255),
        text_color: _rgb(160, 240, 180, 255),
        cursor_color: _rgb(80, 255, 120, 255),
        border_color: _rgb(40, 100, 60, 255),
        focus_color: _rgb(60, 220, 100, 255),
        letter_spacing: 4,
        font_size: 16, radius: 6
    }
    GTextBox tb3 = win.add_textbox(s_green)
    tb3.set_text("G R E E N")

    // ========== 4. 样式：自定义滚动条颜色 ==========
    Style[edit] s_scroll = {
        x: 50, y: 260, width: 340, height: 180,
        placeholder: "自定义滚动条颜色",
        multiline: true,
        font_size: 14, radius: 6,
        sb_track_color: _rgb(30, 32, 50, 255),
        sb_thumb_color: _rgb(140, 100, 200, 255),
        sb_thumb_hover_color: _rgb(180, 150, 240, 255),
        sb_thumb_press_color: _rgb(100, 60, 160, 255)
    }
    GTextBox tb4 = win.add_textbox(s_scroll)
    tb4.set_text("紫色滚动条\nLine 2\nLine 3\nLine 4\nLine 5\nLine 6\nLine 7\nLine 8\nLine 9\nLine 10\nLine 11\nLine 12\nLine 13")

    // ========== 5. 样式：深色滚动条 + 亮色主题 ==========
    Style[edit] s_dark = {
        x: 50, y: 460, width: 340, height: 160,
        placeholder: "深色滚动条",
        multiline: true,
        bg_color: _rgb(20, 22, 38, 255),
        text_color: _rgb(200, 210, 240, 255),
        cursor_color: _rgb(200, 200, 255, 255),
        border_color: _rgb(50, 55, 75, 255),
        focus_color: _rgb(100, 140, 220, 255),
        selection_color: _rgb(80, 120, 200, 120),
        font_size: 14, radius: 6,
        sb_track_color: _rgb(16, 18, 32, 255),
        sb_thumb_color: _rgb(60, 70, 100, 255),
        sb_thumb_hover_color: _rgb(90, 110, 160, 255),
        sb_thumb_press_color: _rgb(40, 50, 80, 255)
    }
    GTextBox tb5 = win.add_textbox(s_dark)
    tb5.set_text("暗色主题滚动条\nLine 2\nLine 3\nLine 4\nLine 5\nLine 6\nLine 7\nLine 8\nLine 9\nLine 10")

    // ========== 6. 样式：密码框 + placeholder 颜色 ==========
    Style[edit] s_pwd = {
        x: 430, y: 70, width: 340, height: 38,
        placeholder: "请输入密码",
        placeholder_color: _rgb(200, 180, 140, 200),
        password: true,
        cursor_color: _rgb(255, 200, 60, 255),
        border_color: _rgb(160, 140, 80, 255),
        focus_color: _rgb(220, 190, 60, 255),
        font_size: 15, radius: 6
    }
    win.add_textbox(s_pwd)

    // ========== 7. 样式：圆角 + 粗边框 ==========
    Style[edit] s_round = {
        x: 430, y: 130, width: 340, height: 42,
        placeholder: "大圆角 + 粗边框 + 字间距",
        border_width: 3,
        radius: 16,
        letter_spacing: 2,
        cursor_color: _rgb(255, 140, 60, 255),
        border_color: _rgb(200, 140, 80, 255),
        focus_color: _rgb(255, 160, 60, 255),
        font_size: 16
    }
    win.add_textbox(s_round)

    // ========== 8. 样式：placeholder 独立字体大小 ==========
    Style[edit] s_ph = {
        x: 430, y: 200, width: 340, height: 40,
        placeholder: "小号 placeholder 字体...",
        placeholder_color: _rgb(140, 160, 200, 180),
        placeholder_font_size: 11,
        font_size: 18, radius: 6
    }
    win.add_textbox(s_ph)

    // ========== 9. 样式：禁用状态 ==========
    Style[edit] s_disabled = {
        x: 430, y: 260, width: 340, height: 38,
        placeholder: "禁用的输入框",
        border_color: _rgb(120, 120, 140, 255),
        font_size: 15, radius: 6
    }
    GTextBox tb9 = win.add_textbox(s_disabled)
    tb9.set_enabled(false)

    // ========== 10. 样式：全属性综合 ==========
    Style[edit] s_all = {
        x: 430, y: 320, width: 340, height: 300,
        placeholder: "全部样式属性",
        multiline: true,
        bg_color: _rgb(26, 28, 44, 255),
        text_color: _rgb(210, 220, 245, 255),
        placeholder_color: _rgb(120, 130, 160, 160),
        cursor_color: _rgb(255, 220, 80, 255),
        selection_color: _rgb(140, 120, 220, 130),
        border_color: _rgb(80, 90, 120, 255),
        focus_color: _rgb(140, 140, 220, 255),
        border_width: 2,
        radius: 10,
        font_size: 14,
        letter_spacing: 1,
        padding_x: 12, padding_y: 6,
        placeholder_font_size: 12,
        sb_track_color: _rgb(20, 22, 38, 255),
        sb_thumb_color: _rgb(80, 90, 140, 255),
        sb_thumb_hover_color: _rgb(120, 140, 200, 255),
        sb_thumb_press_color: _rgb(60, 70, 110, 255)
    }
    GTextBox tb10 = win.add_textbox(s_all)
    tb10.set_text("全属性 Style[edit] 示例\n边框/圆角/颜色/滚动条\n字间距/placeholder/字体\nLine 4\nLine 5\nLine 6\nLine 7\nLine 8\nLine 9\nLine 10\nLine 11\nLine 12\nLine 13\nLine 14\nLine 15\nLine 16\nLine 17\nLine 18\nLine 19\nLine 20")

    // ===== 渲染 =====
    win.run(
        func(GDraw ren) {
            ren.set_color(_rgb(22, 22, 38, 255))
            ren.clear()

            ren.set_color(_rgb(255, 255, 255, 255))
            ren.draw_text(font_title, "Style[edit] 样式声明测试", 50, 25)

            ren.set_color(_rgb(160, 160, 200, 255))
            ren.draw_text(font_label, "1.红色光标+橙色选区", 50, 55)
            ren.draw_text(font_label, "2.蓝色主题", 50, 115)
            ren.draw_text(font_label, "3.绿色+字间距4px", 50, 175)
            ren.draw_text(font_label, "4.紫色滚动条三态颜色", 50, 245)
            ren.draw_text(font_label, "5.暗色主题+深色滚动条", 50, 445)

            ren.set_color(_rgb(170, 170, 210, 255))
            ren.draw_text(font_label, "6.密码框+金色光标", 430, 55)
            ren.draw_text(font_label, "7.大圆角+粗边框+字间距", 430, 115)
            ren.draw_text(font_label, "8.小号placeholder字体", 430, 185)
            ren.draw_text(font_label, "9.禁用状态", 430, 245)
            ren.draw_text(font_label, "10.全属性综合(21个字段)", 430, 305)
        },
        func(GEvent e) {
            if e.window_close() { win.set_should_close(true) }
            if e.key_down() and e.key() == 27 { win.set_should_close(true) }
        }
    )

    font_title.close()
    font_label.close()
    win.close()
}
