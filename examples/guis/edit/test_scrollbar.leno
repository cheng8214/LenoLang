// ============================================================
// GTextBox - 滚动条颜色 & 字间距测试
// 测试：hover 变色、按下变深、字间距效果
// ============================================================

import guis

main() {
    _console(false)

    Style[window] w_style = {
        width: 800,
        height: 700,
        center: true,
        bg_color: _rgb(24, 24, 40, 255),
        resizable: true
    }
    GWin win = guis.create_window("GTextBox 滚动条 & 字间距测试", w_style)

    var font_title = guis.load_font("Arial", 22)
    var font_label = guis.load_font("Arial", 12)

    // ========== 1. 水平滚动条颜色（单行长文字） ==========
    GTextBox tb_h = win.add_textbox({
        x: 50, y: 70, width: 350, height: 40,
        placeholder: "水平滚动条...",
        font_size: 16, radius: 6
    })
    tb_h.set_text("这是一行很长很长很长很长很长很长很长很长很长很长很长很长很长很长的文字用来测试水平滚动条")
    tb_h.set_sb_track(_rgb(35, 38, 55, 255))
    tb_h.set_sb_thumb(_rgb(90, 140, 200, 255))
    tb_h.set_sb_thumb_hover(_rgb(120, 170, 240, 255))
    tb_h.set_sb_thumb_press(_rgb(60, 100, 160, 255))

    // ========== 2. 垂直滚动条颜色（多行） ==========
    GTextBox tb_v = win.add_textbox({
        x: 50, y: 150, width: 350, height: 180,
        placeholder: "垂直滚动条...",
        multiline: true,
        font_size: 14, radius: 6
    })
    tb_v.set_text("Line 1\nLine 2\nLine 3\nLine 4\nLine 5\nLine 6\nLine 7\nLine 8\nLine 9\nLine 10\nLine 11\nLine 12\nLine 13\nLine 14\nLine 15")
    tb_v.set_sb_track(_rgb(35, 38, 55, 255))
    tb_v.set_sb_thumb(_rgb(180, 120, 80, 255))
    tb_v.set_sb_thumb_hover(_rgb(220, 160, 110, 255))
    tb_v.set_sb_thumb_press(_rgb(140, 80, 40, 255))

    // ========== 3. 字间距 3px ==========
    GTextBox tb_sp1 = win.add_textbox({
        x: 50, y: 370, width: 350, height: 36,
        placeholder: "letter_spacing: 3px",
        font_size: 16, radius: 6
    })
    tb_sp1.set_text("Hello World 123 !")
    tb_sp1.set_letter_spacing(3)

    // ========== 4. 字间距 6px（加大） ==========
    GTextBox tb_sp2 = win.add_textbox({
        x: 50, y: 430, width: 350, height: 36,
        placeholder: "letter_spacing: 6px",
        font_size: 16, radius: 6
    })
    tb_sp2.set_text("Spaced Text")
    tb_sp2.set_letter_spacing(6)

    // ========== 5. 深色主题滚动条 ==========
    GTextBox tb_dark = win.add_textbox({
        x: 430, y: 70, width: 330, height: 200,
        placeholder: "深色主题",
        multiline: true,
        bg_color: _rgb(30, 32, 48, 255),
        text_color: _rgb(200, 210, 230, 255),
        border_color: _rgb(60, 70, 90, 255),
        focus_color: _rgb(100, 150, 230, 255),
        font_size: 14, radius: 6
    })
    tb_dark.set_text("暗色主题文本框\n滚动条也适配\nLine 3\nLine 4\nLine 5\nLine 6\nLine 7\nLine 8\nLine 9\nLine 10\nLine 11\nLine 12\nLine 13\nLine 14\nLine 15")
    tb_dark.set_cursor_color(_rgb(200, 200, 255, 255))
    tb_dark.set_selection_color(_rgb(100, 140, 220, 120))
    // 暗色滚动条
    tb_dark.set_sb_track(_rgb(35, 38, 55, 255))
    tb_dark.set_sb_thumb(_rgb(80, 90, 120, 255))
    tb_dark.set_sb_thumb_hover(_rgb(120, 140, 190, 255))
    tb_dark.set_sb_thumb_press(_rgb(60, 70, 100, 255))

    // ========== 6. 绿色主题滚动条 ==========
    GTextBox tb_green = win.add_textbox({
        x: 430, y: 300, width: 330, height: 200,
        placeholder: "绿色主题",
        multiline: true,
        font_size: 14, radius: 6
    })
    tb_green.set_text("绿色主题滚动条\n提词器风格\nLine 3\nLine 4\nLine 5\nLine 6\nLine 7\nLine 8\nLine 9\nLine 10\nLine 11\nLine 12\nLine 13\nLine 14\nLine 15")
    tb_green.set_bg_color(_rgb(20, 40, 30, 255))
    tb_green.set_text_color(_rgb(180, 240, 200, 255))
    tb_green.set_border_color(_rgb(40, 100, 60, 255))
    tb_green.set_focus_color(_rgb(60, 220, 120, 255))
    tb_green.set_cursor_color(_rgb(100, 255, 150, 255))
    tb_green.set_sb_track(_rgb(15, 35, 25, 255))
    tb_green.set_sb_thumb(_rgb(50, 160, 90, 255))
    tb_green.set_sb_thumb_hover(_rgb(80, 220, 140, 255))
    tb_green.set_sb_thumb_press(_rgb(30, 100, 50, 255))

    // ========== 7. 字间距 + 长文字（横向滚动 + 大间距） ==========
    GTextBox tb_sp3 = win.add_textbox({
        x: 430, y: 540, width: 330, height: 36,
        placeholder: "spacing:4 + 长文字",
        font_size: 16, radius: 6
    })
    tb_sp3.set_text("W I D E  S P A C E D  T E X T")
    tb_sp3.set_letter_spacing(4)
    tb_sp3.set_sb_thumb(_rgb(180, 120, 200, 255))
    tb_sp3.set_sb_thumb_hover(_rgb(210, 160, 240, 255))
    tb_sp3.set_sb_thumb_press(_rgb(130, 80, 160, 255))

    // ===== 渲染 =====
    win.run(
        func(GDraw ren) {
            ren.set_color(_rgb(24, 24, 40, 255))
            ren.clear()

            ren.set_color(_rgb(255, 255, 255, 255))
            ren.draw_text(font_title, "滚动条颜色 & 字间距测试", 50, 25)

            ren.set_color(_rgb(160, 160, 200, 255))
            ren.draw_text(font_label, "1.水平滚动条(蓝色)，鼠标移上去变亮", 50, 55)
            ren.draw_text(font_label, "2.垂直滚动条(橙色)，鼠标移上去变亮", 50, 135)
            ren.draw_text(font_label, "3.字间距 3px", 50, 355)
            ren.draw_text(font_label, "4.字间距 6px", 50, 415)

            ren.set_color(_rgb(170, 170, 210, 255))
            ren.draw_text(font_label, "5.深色主题全适配", 430, 55)
            ren.draw_text(font_label, "6.绿色提词器风格", 430, 285)
            ren.draw_text(font_label, "7.字间距4px + 横向滚动", 430, 525)
        },
        func(GEvent e) {
            if e.is_window_close() { win.set_should_close(true) }
            if e.is_key_down() and e.key() == 27 { win.set_should_close(true) }
        }
    )

    font_title.close()
    font_label.close()
    win.close()
}
