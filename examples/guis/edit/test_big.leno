// ============================================================
// GTextBox - 大文本测试
// 编辑框铺满窗口，Ctrl+V 粘贴代码，ESC 退出
// ============================================================

import guis

main() {
 //   _console(false)

    Style[window] w_style = {
        width: 1100,
        height: 800,
        center: true,
        bg_color: _rgb(22, 24, 38, 255),
        resizable: true,
        title: "大文本测试 - Ctrl+V 粘贴 | ESC 退出"
    }
    GWin win = guis.create_window("大文本测试", w_style)

    // 编辑框: 1100x800，铺满
    Style[edit] s_edit = {
        x: 0, y: 0, width: 1100, height: 800,
        multiline: true,
        font: "Consolas",
        font_size: 14, radius: 0,
        border_width: 1,
        bg_color: _rgb(30, 32, 50, 255),
        text_color: _rgb(210, 210, 230, 255),
        border_color: _rgb(50, 55, 75, 255),
        cursor_color: _rgb(180, 200, 240, 255),
        selection_color: _rgb(80, 120, 200, 100),
        placeholder_color: _rgb(100, 100, 140, 120),
        placeholder: "Ctrl+V 粘贴代码 | ESC 退出",
        padding_x: 10, padding_y: 8,
        sb_track_color: _rgb(22, 24, 38, 255),
        sb_thumb_color: _rgb(70, 80, 110, 255),
        sb_thumb_hover_color: _rgb(100, 120, 170, 255),
        sb_thumb_press_color: _rgb(50, 60, 90, 255)
    }
    GTextBox tb = win.add_textbox(s_edit)

    win.run(
        func(GDraw ren) {
            // 不需要额外绘制
        },
        func(GEvent e) {
            if e.is_window_close() { win.set_should_close(true) }
            if e.is_key_down() and e.key() == 27 { win.set_should_close(true) }
        }
    )

    win.close()
}
