// 中文输入诊断
import guis

main() {
    print("=== 中文输入诊断 ===")
    print("1. 点击文本框获得焦点")
    print("2. 切换中文输入法，打字")
    print("3. 观察控制台 TEXT_INPUT 输出")

    Style[window] w_style = {
        width: 500, height: 250, center: true,
        bg_color: _rgb(30, 30, 46, 255)
    }
    var win = guis.create_window("诊断", w_style)
    GFont font = guis.load_font("Consolas", 16)

    GTextBox tb = win.add_textbox({
        x: 50, y: 80, width: 380, height: 40,
        placeholder: "点我，切中文输入法，打字",
        radius: 4, border_width: 1,
        font: "Consolas", font_size: 15, padding_x: 10,
        text_color: _rgb(0, 0, 0, 255),
        bg_color: _rgb(255, 255, 255, 255)
    })

    tb.on_change(func() { print("[文本框内容改变]") })

    win.run(
        func(GDraw ren) {
            ren.set_color(_rgb(30, 30, 46, 255))
            ren.clear()
        },
        func(GEvent e) {
            if e.window_close() or (e.key_down() and e.key() == 27) {
                win.set_should_close(true)
            }
            if e.text_input() {
                print("[TEXT_INPUT] '" + e.text() + "'")
            }
        }
    )
    win.close()
}
