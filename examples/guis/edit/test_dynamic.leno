// ============================================================
// GTextBox - 动态属性测试
// 测试所有 setter: 颜色/尺寸/位置/字体等
// ============================================================

import guis

main() {
    _console(false)

    Style[window] w_style = {
        width: 800,
        height: 700,
        center: true,
        bg_color: _rgb(28, 28, 44, 255),
        resizable: true
    }
    GWin win = guis.create_window("GTextBox 动态属性测试", w_style)

    var font_title = guis.load_font("Arial", 22)
    var font_label = guis.load_font("Arial", 12)

    // ========== 1. 光标颜色测试（使用 Style[edit] 支持 IDE 补全） ==========
    Style[edit] s1 = {
        x: 50, y: 70, width: 320, height: 36,
        placeholder: "点我输入，红色光标...",
        font_size: 15, radius: 6
    }
    GTextBox tb_cursor = win.add_textbox(s1)
    tb_cursor.set_cursor_color(_rgb(255, 60, 60, 255))

    // ========== 2. 文字颜色测试 ==========
    GTextBox tb_text = win.add_textbox({
        x: 50, y: 130, width: 320, height: 36,
        placeholder: "蓝色文字",
        font_size: 15, radius: 6
    })
    tb_text.set_text_color(_rgb(80, 160, 255, 255))
    tb_text.set_cursor_color(_rgb(80, 160, 255, 255))

    // ========== 3. 背景色测试 ==========
    GTextBox tb_bg = win.add_textbox({
        x: 50, y: 190, width: 320, height: 36,
        placeholder: "深色背景",
        font_size: 15, radius: 6
    })
    tb_bg.set_bg_color(_rgb(40, 45, 60, 255))
    tb_bg.set_text_color(_rgb(220, 220, 240, 255))
    tb_bg.set_border_color(_rgb(80, 90, 120, 255))
    tb_bg.set_cursor_color(_rgb(200, 200, 255, 255))
    tb_bg.set_focus_color(_rgb(100, 180, 255, 255))

    // ========== 4. 边框样式测试 ==========
    GTextBox tb_border = win.add_textbox({
        x: 50, y: 250, width: 320, height: 36,
        placeholder: "粗边框 + 大圆角",
        font_size: 15, radius: 6
    })
    tb_border.set_border_width(3)
    tb_border.set_radius(14)
    tb_border.set_border_color(_rgb(100, 200, 150, 255))
    tb_border.set_focus_color(_rgb(255, 180, 60, 255))

    // ========== 5. 选区颜色测试 ==========
    GTextBox tb_sel = win.add_textbox({
        x: 50, y: 310, width: 320, height: 36,
        placeholder: "Ctrl+A 看选区高亮颜色",
        font_size: 15, radius: 6
    })
    tb_sel.set_selection_color(_rgb(255, 180, 80, 140))
    tb_sel.set_text("选中文字看看效果")

    // ========== 6. 动态尺寸：按钮切换大/小 ==========
    var is_big = false
    GTextBox tb_pos = win.add_textbox({
        x: 430, y: 70, width: 160, height: 36,
        placeholder: "点按钮变大...",
        font_size: 14, radius: 6
    })
    GButton btn_toggle = win.add_button({
        x: 600, y: 70, width: 50, height: 36,
        text: "换",
        bg_color: _rgb(100, 140, 200, 255),
        hover_color: _rgb(130, 170, 230, 255),
        press_color: _rgb(70, 100, 150, 255),
        text_color: _rgb(255, 255, 255, 255),
        radius: 6
    })
    btn_toggle.on_click(func() {
        is_big = not is_big
        if is_big {
            tb_pos.set_size(350, 48)
            tb_pos.set_placeholder("大框了!")
        } else {
            tb_pos.set_size(160, 36)
            tb_pos.set_placeholder("点按钮变大...")
        }
    })

    // ========== 7. 字体大小测试 ==========
    GTextBox tb_font = win.add_textbox({
        x: 430, y: 130, width: 320, height: 48,
        placeholder: "大字体 (22px)",
        font_size: 22, radius: 6
    })
    tb_font.set_cursor_color(_rgb(255, 200, 50, 255))

    // ========== 8. 内边距测试 ==========
    GTextBox tb_pad = win.add_textbox({
        x: 430, y: 200, width: 320, height: 40,
        placeholder: "大内边距 padding",
        font_size: 14, radius: 6,
        padding_x: 20, padding_y: 8
    })

    // ========== 9. 聚焦色测试 ==========
    GTextBox tb_focus = win.add_textbox({
        x: 430, y: 260, width: 320, height: 36,
        placeholder: "点击看看聚焦边框...",
        font_size: 15, radius: 6
    })
    tb_focus.set_focus_color(_rgb(255, 80, 180, 255))
    tb_focus.set_border_width(2)

    // ========== 10. 密码框自定义光标 ==========
    GTextBox tb_pwd = win.add_textbox({
        x: 430, y: 320, width: 320, height: 36,
        placeholder: "密码框 - 绿色光标",
        password: true,
        font_size: 15, radius: 6
    })
    tb_pwd.set_cursor_color(_rgb(80, 255, 120, 255))
    tb_pwd.set_border_color(_rgb(80, 180, 120, 255))
    tb_pwd.set_focus_color(_rgb(80, 255, 120, 255))

    // ========== 11. 禁用测试 ==========
    GTextBox tb_disabled = win.add_textbox({
        x: 50, y: 380, width: 320, height: 36,
        placeholder: "禁用状态",
        font_size: 15, radius: 6
    })
    tb_disabled.set_enabled(false)

    // ========== 12. 综合：所有颜色自定义 ==========
    GTextBox tb_all = win.add_textbox({
        x: 50, y: 440, width: 700, height: 44,
        placeholder: "综合自定义: 所有属性独立设置",
        font_size: 18, radius: 8, border_width: 2
    })
    tb_all.set_text_color(_rgb(200, 200, 255, 255))
    tb_all.set_bg_color(_rgb(35, 38, 55, 255))
    tb_all.set_border_color(_rgb(100, 120, 180, 255))
    tb_all.set_focus_color(_rgb(180, 140, 255, 255))
    tb_all.set_cursor_color(_rgb(255, 220, 80, 255))
    tb_all.set_selection_color(_rgb(180, 140, 255, 120))
    tb_all.set_placeholder_color(_rgb(120, 120, 160, 180))
    tb_all.set_placeholder_font_size(13)

    // ========== 13. 多行 + 所有颜色 ==========
    GTextBox tb_multi = win.add_textbox({
        x: 50, y: 510, width: 700, height: 130,
        placeholder: "多行编辑框\nCtrl+A 全选看选区颜色\n滚动看滚动条颜色",
        multiline: true,
        font_size: 15, radius: 6
    })
    tb_multi.set_cursor_color(_rgb(255, 150, 50, 255))
    tb_multi.set_selection_color(_rgb(100, 200, 255, 120))
    tb_multi.set_focus_color(_rgb(100, 200, 255, 255))
    tb_multi.set_text("多行文本示例\n第二行内容\n第三行 - 测试光标颜色和选区\nLorem ipsum dolor sit amet consectetur\n一行很长的文字来看看横向滚动条的效果如何显示")

    // ===== 渲染 =====
    win.run(
        func(GDraw ren) {
            ren.set_color(_rgb(28, 28, 44, 255))
            ren.clear()

            ren.set_color(_rgb(255, 255, 255, 255))
            ren.draw_text(font_title, "GTextBox - 动态属性测试", 50, 25)

            ren.set_color(_rgb(160, 160, 190, 255))
            ren.draw_text(font_label, "1.红色光标", 50, 58)
            ren.draw_text(font_label, "2.蓝色文字", 50, 118)
            ren.draw_text(font_label, "3.深色背景", 50, 178)
            ren.draw_text(font_label, "4.粗边框+大圆角", 50, 238)
            ren.draw_text(font_label, "5.选区高亮(橙色)", 50, 298)
            ren.draw_text(font_label, "11.禁用状态", 50, 368)

            ren.draw_text(font_label, "6.set_size 改变尺寸", 430, 58)
            ren.draw_text(font_label, "7.大字体 22px", 430, 118)
            ren.draw_text(font_label, "8.大内边距", 430, 188)
            ren.draw_text(font_label, "9.聚焦色(粉红)", 430, 248)
            ren.draw_text(font_label, "10.密码+绿光标", 430, 308)

            ren.draw_text(font_label, "12.综合: 全部颜色属性独立设置 + placeholder", 50, 428)
            ren.draw_text(font_label, "13.多行: 颜色+选区+滚动条", 50, 498)
        },
        func(GEvent e) {
            if e.is_window_close() { win.set_should_close(true) }
            if e.is_key_down() and e.key() == 27 { win.set_should_close(true) }
        }
    )

    font_title.close()
    font_label.close()
    win.close()
}
