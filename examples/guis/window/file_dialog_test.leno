/* file_dialog 功能测试示例
   按键操作：
   O - 打开文件对话框（多选）
   S - 保存文件对话框
   F - 打开文件夹对话框
   ESC - 退出
*/
import guis

main() {
    Style[window] w_style = {
        width: 650,
        height: 480,
        resizable: true
    }
    Win win = guis.create_window("File Dialog Test", w_style)

    var font = guis.load_font("SimSun", 20)
    var font_small = guis.load_font("SimSun", 14)

    var selected_files = []
    var filter_index = -1
    var last_action = "按 O=打开文件 | S=保存文件 | F=打开文件夹"

    /* 定义过滤器选项 */
    var open_opts = {
        title: "选择要打开的文件",
        filters: [
            { name: "All Files", pattern: "*.*" },
            { name: "Text Files", pattern: "*.txt" },
            { name: "Leno Files", pattern: "*.leno" }
        ],
        multiple: true
    }

    var save_opts = {
        title: "保存文件为...",
        filters: [
            { name: "Text Files", pattern: "*.txt" },
            { name: "All Files", pattern: "*.*" }
        ],
        path: "untitled.txt"
    }

    var folder_opts = {
        title: "选择文件夹"
    }

    guis.run(win,
        func(Draw ren) {
            ren.set_color(_rgb(34, 34, 34, 255))
            ren.clear()

            /* 标题 */
            ren.set_color(_rgb(255, 255, 255, 255))
            ren.draw_text_ex(font, "File Dialog Test", 20, 20)

            /* 操作提示 */
            ren.set_color(_rgb(100, 180, 255, 255))
            ren.draw_text_ex(font_small, "按键操作: [O] 打开文件  [S] 保存文件  [F] 打开文件夹  [ESC] 退出", 20, 55)

            /* 分隔线 */
            ren.set_color(_rgb(80, 80, 80, 255))
            ren.line(20, 80, 620, 80)

            /* 显示结果 */
            ren.set_color(_rgb(200, 200, 200, 255))
            ren.draw_text_ex(font_small, "操作: " + last_action, 20, 100)

            if filter_index >= 0 {
                ren.set_color(_rgb(136, 136, 136, 255))
                ren.draw_text_ex(font_small, "过滤器索引: " + _str(filter_index), 20, 125)
            }

            ren.set_color(_rgb(136, 136, 136, 255))
            var n = selected_files.len()
            ren.draw_text_ex(font_small, "选中文件 (" + _str(n) + " 个):", 20, 155)

            var y = 180
            for selected_files to f {
                ren.set_color(_rgb(102, 204, 102, 255))
                ren.draw_text_ex(font_small, "  " + f, 30, y)
                y = y + 22
                if y > 440 {
                    ren.set_color(_rgb(102, 102, 102, 255))
                    ren.draw_text_ex(font_small, "  ... (更多文件未显示)", 30, y)
                    break
                }
            }

            ren.present()
        },
        func(Event e) {
            if e.is_quit() or e.is_window_close() {
                win.set_should_close(true)
            }
            if e.is_key_down() {
                var key = e.key()
                if key == 0x1B {
                    win.set_should_close(true)
                }
                if key == 0x4F or key == 0x6F {
                    /* O - 打开文件 */
                    last_action = "打开文件中..."
                    guis.file_dialog(0, func(var file_list, var idx) {
                        if file_list is Array {
                            selected_files = file_list
                            var count = file_list.len()
                            last_action = "打开文件完成 (" + _str(count) + " 个文件)"
                        }
                        if idx is int {
                            filter_index = idx
                        }
                    }, open_opts)
                }
                if key == 0x53 or key == 0x73 {
                    /* S - 保存文件 */
                    last_action = "保存文件中..."
                    guis.file_dialog(1, func(var file_list, var idx) {
                        if file_list is Array {
                            selected_files = file_list
                        }
                        if idx is int {
                            filter_index = idx
                        }
                        last_action = "保存文件完成"
                    }, save_opts)
                }
                if key == 0x46 or key == 0x66 {
                    /* F - 打开文件夹 */
                    last_action = "打开文件夹中..."
                    guis.file_dialog(2, func(var file_list, var idx) {
                        if file_list is Array {
                            selected_files = file_list
                        }
                        if idx is int {
                            filter_index = idx
                        }
                        last_action = "打开文件夹完成"
                    }, folder_opts)
                }
            }
        }
    )

    font.close()
    font_small.close()
    win.close()
}
