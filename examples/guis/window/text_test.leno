import guis

main() {
    Style[window] w_style = {
        width: 800,
        height: 600,
        resizable: true
    }
    GWin win = guis.create_window("LenoC GUI - Text Test", w_style)

    var font_large = guis.load_font("Arial", 32)
    var font_medium = guis.load_font("Arial", 20)
    var font_small = guis.load_font("Arial", 14)
    var font_tiny = guis.load_font("Arial", 10)

    win.run(
        func(GDraw ren) {
            ren.set_color(_rgb(30, 30, 46, 255))
            ren.clear()

            ren.set_color(_rgb(255, 255, 255, 255))
            ren.draw_text(font_large, "Hello, LenoC!", 50, 50)

            ren.set_color(_rgb(100, 255, 100, 255))
            ren.draw_text(font_medium, "GUI Module - text", 50, 100)

            ren.set_color(_rgb(255, 100, 100, 255))
            ren.draw_text(font_medium, "ABCDEFGHIJKLMNOPQRSTUVWXYZ", 50, 140)

            ren.set_color(_rgb(100, 150, 255, 255))
            ren.draw_text(font_medium, "0123456789 !@#$%^&*()", 50, 170)

            ren.set_color(_rgb(255, 255, 0, 255))
            ren.draw_text(font_tiny, "Tiny", 50, 210)
            ren.draw_text(font_small, "Small", 130, 210)
            ren.draw_text(font_medium, "Medium", 220, 210)
            ren.draw_text(font_large, "Large", 350, 210)

            ren.set_color(_rgb(180, 100, 255, 255))
            ren.draw_text(font_medium, "Press ESC to quit", 50, 300)
        },
        func(GEvent e) {
            if e.is_quit() or e.is_window_close() {
                win.set_should_close(true)
            }
            if e.is_key_down() {
                if e.key() == 0x1B {
                    win.set_should_close(true)
                }
            }
        }
    )

    font_large.close()
    font_medium.close()
    font_small.close()
    font_tiny.close()
    win.close()
    print("text test done!")
}
