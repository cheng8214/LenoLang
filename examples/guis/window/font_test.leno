import guis

main() {
    Style[window] w_style = {
        width: 800,
        height: 600,
        resizable: true
    }
    Win win = guis.create_window("LenoC GUI - Font Test", w_style)

    var font_arial = guis.load_font("Arial", 24)
    var font_consolas = guis.load_font("Consolas", 18)
    var font_simhei = guis.load_font("SimHei", 28)
    Font font_yahei = guis.load_font("Microsoft YaHei", 20)
    var font_small = guis.load_font("Arial", 16)

    guis.run(win,
        func(Draw ren) {
            ren.set_color(_rgb(30, 30, 46, 255))
            ren.clear()

            ren.set_color(_rgb(255, 255, 255, 255))
            ren.draw_text(font_small, "System Font Test:", 30, 20)
            ren.draw_text(font_small, "Hello, LenoC GUI!", 30, 50)

            ren.set_color(_rgb(100, 255, 100, 255))
            ren.draw_text(font_arial, "Arial 24px - System Font", 30, 100)

            ren.set_color(_rgb(100, 200, 255, 255))
            ren.draw_text(font_consolas, "Consolas 18px - Monospace", 30, 140)

            ren.set_color(_rgb(255, 200, 100, 255))
            ren.draw_text(font_simhei, "SimHei 28px - 黑体中文测试", 30, 180)

            ren.set_color(_rgb(200, 150, 255, 255))
            ren.draw_text(font_yahei, "Microsoft YaHei 20px - 微软雅黑", 30, 230)

            ren.set_color(_rgb(255, 100, 100, 255))
            ren.draw_text(font_arial, "ABCDEFGHIJKLMNOPQRSTUVWXYZ", 30, 280)
            ren.draw_text(font_consolas, "0123456789 !@#$%^&*()", 30, 310)

            ren.set_color(_rgb(150, 150, 150, 255))
            ren.draw_text(font_small, "Press ESC to quit", 30, 560)

            ren.present()
        },
        func(Event e) {
            if e.is_quit() or e.is_window_close() {
                win.set_should_close(true)
            }
            if e.is_key_down() and e.key() == 0x1B {
                win.set_should_close(true)
            }
        }
    )

    font_arial.close()
    font_consolas.close()
    font_simhei.close()
    font_yahei.close()
    font_small.close()
    win.close()
    print("font test done!")
}
