import guis

main() {
    Style[window] w_style = {
        width: 800,
        height: 600,
        borderless: true,
        resizable: true
    }
    GWin win = guis.create_window("Borderless", w_style)

    // 限制只有顶部标题栏区域可拖动（可选）
    // 如果不调用，整个窗口都可拖动
   
   win.set_drag_area(0, 0, 800, 40)

    // 加载中文字体（Windows 系统字体）
    GFont font = guis.load_font("Microsoft YaHei", 16)

    win.run(
        func(GDraw ren) {
            ren.set_color(_rgb(30, 30, 46, 255))
            ren.clear()

            // 自定义标题栏区域
            ren.set_color(_rgb(60, 60, 90, 255))
            ren.fill_rect(0, 0, 800, 40)

            // 关闭按钮
            ren.set_color(_rgb(255, 80, 80, 255))
            ren.fill_circle(770, 20, 10)

            // 标题文字（使用系统字体渲染中文）
            ren.set_color(_rgb(255, 255, 255, 255))
            if font != null {
                ren.draw_text(font, "无边框窗口 - 拖动标题栏移动", 50, 10)
            } else {
                // 字体加载失败，使用内置字体（不支持中文）
                ren.draw_text("Borderless Window", 50, 12, 2)
            }
        },
        func(GEvent e) {
            if e.is_quit() or e.is_window_close() {
                win.set_should_close(true)
            }
            if e.is_key_down() and e.key() == 0x1B {
                win.set_should_close(true)
            }

            // 点击关闭按钮
            if e.is_mouse_down() {
                int mx = e.mouse_x()
                int my = e.mouse_y()
                print(mx,my)
                if mx > 760 and mx < 780 and my > 10 and my < 30 {
                    win.set_should_close(true)
                }
            }
        }
    )

    // 清理字体资源
    if font != null {
        font.close()
    }

    win.close()
}
