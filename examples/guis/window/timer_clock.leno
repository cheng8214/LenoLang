import guis
import times

main() {
    Style[window] w_style = {
        width: 800,
        height: 600,
        resizable: true
    }
    Win win = guis.create_window("LenoC Timer & Clock", w_style)

    var font_title = guis.load_font("Arial", 32)
    var font_large = guis.load_font("Arial", 24)
    var font_medium = guis.load_font("Arial", 18)
    var font_small = guis.load_font("Arial", 14)

    var elapsed = 0
    var start_ms = times.ms()

    var tid = guis.add_timer(100, func(int id, int interval) {
        elapsed = times.ms() - start_ms
        return interval
    })

    guis.run(win,
        func(Draw ren) {
            ren.set_color(_rgb(30, 30, 46, 255))
            ren.clear()

            ren.set_color(_rgb(255, 255, 255, 255))
            ren.draw_text(font_title, "Timer & Clock Demo", 50, 30)

            var total_sec = elapsed / 1000
            var min = total_sec / 60
            var sec = total_sec % 60
            var ms = elapsed % 1000

            ren.set_color(_rgb(100, 255, 100, 255))
            ren.draw_text(font_medium, "Elapsed: " + _str(min) + "m " + sec + "s " +ms + "ms", 50, 100)

            var now = times.now()
            var time_str = times.format(now, "%H:%M:%S")
            var date_str = times.format(now, "%Y-%m-%d")

            ren.set_color(_rgb(255, 200, 100, 255))
            ren.draw_text(font_large, "Clock: " + time_str, 50, 160)

            ren.set_color(_rgb(150, 150, 200, 255))
            ren.draw_text(font_medium, "Date:  " + date_str, 50, 210)

            ren.set_color(_rgb(100, 150, 255, 255))
            ren.draw_text(font_medium, "times.ms()  = " + times.ms(), 50, 280)

            ren.set_color(_rgb(180, 100, 255, 255))
            ren.draw_text(font_small, "Press ESC to quit", 50, 350)

            ren.present()
        },
        func(Event e) {
            if e.is_quit() or e.is_window_close() {
                win.set_should_close(true)
            }
            if e.is_key_down() and e.key() == 0x1B {
                win.set_should_close(true)
            }
        }
    )

    font_title.close()
    font_large.close()
    font_medium.close()
    font_small.close()
    win.close()
    print("timer clock done!")
}
