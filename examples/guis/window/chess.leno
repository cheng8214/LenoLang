import guis
//_gc(false)
main() {
    Style[window] w_style = {
        width: 600,
        height: 600,
        resizable: true
    }
    GWin win = guis.create_window("Chess", w_style)

    var font = guis.load_font("Arial", 36)
    var font_sm = guis.load_font("Arial", 16)
    var font_title = guis.load_font("Arial", 24)

    var board_x = 40
    var board_y = 60
    var cell = 70

    var selected_row = -1
    var selected_col = -1

    win.run(
        func(GDraw ren) {
            ren.set_color(_rgb(40, 40, 55, 255))
            ren.clear()

            ren.set_color(_rgb(230, 230, 240, 255))
            ren.draw_text(font_title, "Chess Board", 250, 15)

            for 8 to var r {
                for 8 to var c {
                    var x = board_x + c * cell
                    var y = board_y + r * cell

                    if (r + c) % 2 == 0 {
                        ren.set_color(_rgb(240, 217, 181, 255))
                    } else {
                        ren.set_color(_rgb(181, 136, 99, 255))
                    }

                    if r == selected_row and c == selected_col {
                        ren.set_color(_rgb(130, 180, 100, 255))
                    }

                    ren.fill_rect(x, y, cell, cell)
                    ren.set_color(_rgb(60, 50, 40, 255))
                    ren.rect(x, y, cell, cell)
                }
            }

            var pieces_b = ["♜","♞","♝","♛","♚","♝","♞","♜"]
            for 8 to var c {
                var px = board_x + c * cell + 14
                ren.set_color(_rgb(30, 30, 30, 255))
                ren.draw_text(font, pieces_b[c], px, board_y + 14)
            }

            for 8 to var c {
                var px = board_x + c * cell + 14
                ren.set_color(_rgb(30, 30, 30, 255))
                ren.draw_text(font, "♟", px, board_y + cell + 14)
            }

            for 8 to var c {
                var px = board_x + c * cell + 14
                ren.set_color(_rgb(250, 250, 250, 255))
                ren.draw_text(font, "♙", px, board_y + 6 * cell + 14)
            }

            var pieces_w = ["♖","♘","♗","♕","♔","♗","♘","♖"]
            for 8 to var c {
                var px = board_x + c * cell + 14
                ren.set_color(_rgb(250, 250, 250, 255))
                ren.draw_text(font, pieces_w[c], px, board_y + 7 * cell + 14)
            }

            for 8 to var c {
                ren.set_color(_rgb(180, 180, 190, 255))
                ren.draw_text(font_sm, _str(c + 1), board_x + c * cell + 28, board_y + 8 * cell + 6)
            }

            var cols = ["a","b","c","d","e","f","g","h"]
            for 8 to var r {
                ren.set_color(_rgb(180, 180, 190, 255))
                ren.draw_text(font_sm, cols[r], board_x - 18, board_y + r * cell + 26)
            }

            ren.set_color(_rgb(120, 120, 140, 255))
            ren.draw_text(font_sm, "Click to select  |  ESC to quit", 190, 670)
        },
        func(GEvent e) {
            if e.is_quit() or e.is_window_close() {
                win.set_should_close(true)
            }
            if e.is_key_down() and e.key() == 0x1B {
                win.set_should_close(true)
            }
            if e.is_mouse_down() {
                var mx = e.mouse_x()
                var my = e.mouse_y()
                var c = (mx - board_x) / cell
                var r = (my - board_y) / cell
                if c >= 0 and c < 8 and r >= 0 and r < 8 {
                    if r == selected_row and c == selected_col {
                        selected_row = -1
                        selected_col = -1
                    } else {
                        selected_row = r
                        selected_col = c
                    }
                }
            }
        }
    )

    font.close()
    font_sm.close()
    font_title.close()
    win.close()
}
