import guis as gui

main() {
    Style[window] w_style = {
        width: 800,
        height: 600,
        resizable: true
    }
    var win = gui.create_window("标题", w_style)

    
    win.run(Draw1,Event1)
func Draw1(GDraw ren)
    {
            // onDraw: 每帧调用，ren 是自动创建的渲染器
             ren.set_color(_rgb( 30, 30, 46, 255))
             ren.clear()
             ren.set_color(_rgb( 255, 0, 0, 255))
             ren.fill_rect(100, 100, 200, 150)
     }
    func Event1(GEvent event)
    {
            // onEvent: 每个事件调用
            if event.window_close() or event.key_down()
            {
                win.set_should_close(true)
            }
    }
    win.close()
}
