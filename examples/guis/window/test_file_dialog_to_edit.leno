/* 文件对话框 + 文件读取 + Edit 测试
   流程：点击"打开"按钮 -> dialog 选择文件 -> files.read 读取 -> print 打印内容 -> edit.set_text 显示
   测试目的：逐步排查崩溃位置
   1. file_dialog 回调中能否正常获取路径
   2. files.read 在回调中能否正常工作
   3. edit.set_text 能否正确设置内容
*/
import guis
import files
main() {
    Style[window] w_style = {
        width: 800,
        height: 600,
        resizable: true
    }
    GWin win = guis.create_window("FileDialog+FileRead+Edit", w_style)

    /* 打开按钮 */
    var btn_open = win.add_button({
        x: 20,
        y: 20,
        width: 80,
        height: 32,
        text: "打开",
        bg_color: _rgb(70, 130, 180, 255),
        text_color: _rgb(255, 255, 255, 255),
        font_name: "SimSun",
        font_size: 14,
        radius: 4
    })
    /* 文本框 */
    var edit = win.add_textbox({
        x: 20,
        y: 70,
        width: 760,
        height: 500,
        multiline: true,
        line_spacing: 4,
        bg_color: _rgb(255, 255, 255, 255),
        text_color: _rgb(30, 30, 30, 255),
        border_color: _rgb(180, 180, 180, 255),
        focus_color: _rgb(70, 130, 220, 255),
        font_name: "SimSun",
        font_size: 14,
        padding_x: 8,
        padding_y: 6,
        radius: 4,
        border_width: 1,
        placeholder: "点击\"打开\"按钮选择文件..."
    })

    /* 按钮点击 -> 打开文件对话框 */
    btn_open.on_click(func() {
    
                    var path = "D:\\CLeno\\chacha20.leno"
                    /* 读取文件 */
                    File fp=files.open(path,"r")
                    string content=fp.read()
                    fp.close()
                    print(type(content))
                    print(content)
                    edit.set_text(content)
                    print("[6] edit.set_text 完成")
                
            })
    
   
   
    win.run(
        func(GDraw ren) {
            ren.set_color(_rgb(34, 34, 34, 255))
            ren.clear()
        },
        func(GEvent e) {
            if e.quit() or e.window_close() {
                win.set_should_close(true)
            }
        }
    )

    win.close()
}
