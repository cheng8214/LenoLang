// ============================================================
// 测试窗口样式新特性 - Style[window] 创建时所有字段
// 覆盖: center, min/max_size, bg_color, maximized, vsync, opacity
// ============================================================

import guis

// -------------------- 测试 1: 基础居中窗口 + 背景色 --------------------
func test_basic_center() {
    print("=== 测试 1: 居中窗口 + 背景色 ===")
    Style[window] w_style = {
        width: 800,
        height: 600,
        center: true,
        resizable: true,
        bg_color: _rgb(30, 30, 46, 255)
    }
    var win = guis.create_window("测试1 - 居中 + 背景色", w_style)
    print("窗口创建成功, center=true")

    win.run(
        func(GDraw ren) {
            ren.set_color(_rgb(30, 30, 46, 255))
            ren.clear()
            ren.set_color(_rgb(0, 255, 100, 255))
            ren.fill_rect(50, 50, 200, 150)
            ren.set_color(_rgb(255, 200, 0, 255))
            ren.fill_rect(300, 50, 200, 150)
        },
        func(GEvent e) {
            if e.is_window_close() or e.is_key_down() {
                win.set_should_close(true)
            }
        }
    )
    win.close()
}

// -------------------- 测试 2: 最小/最大尺寸限制 + 指定位置 --------------------
func test_min_max_size() {
    print("=== 测试 2: 尺寸限制 + 指定位置 ===")
    Style[window] w_style = {
        width: 600,
        height: 400,
        x: 100,
        y: 100,
        min_width: 400,
        min_height: 300,
        max_width: 1200,
        max_height: 900,
        resizable: true
    }
    var win = guis.create_window("测试2 - 尺寸限制 min/max", w_style)
    print("窗口创建成功, min=400x300, max=1200x900")

    win.run(
        func(GDraw ren) {
            ren.set_color(_rgb(50, 50, 70, 255))
            ren.clear()
            ren.set_color(_rgb(255, 100, 100, 255))
            ren.fill_rect(10, 10, 580, 380)
        },
        func(GEvent e) {
            if e.is_window_close() or e.is_key_down() {
                win.set_should_close(true)
            }
        }
    )
    win.close()
}

// -------------------- 测试 3: 半透明窗口 + vsync 禁用 --------------------
func test_opacity_vsync() {
    print("=== 测试 3: 透明度 + vsync ===")
    Style[window] w_style = {
        width: 500,
        height: 400,
        center: true,
        opacity: 0.85,
        vsync: false,
        resizable: true,
        bg_color: _rgb(40, 40, 60, 255)
    }
    var win = guis.create_window("测试3 - 半透明 + vsync=false", w_style)
    print("窗口创建成功, opacity=0.85, vsync=false")

    win.run(
        func(GDraw ren) {
            ren.set_color(_rgb(40, 40, 60, 255))
            ren.clear()
            ren.set_color(_rgb(100, 200, 255, 255))
            ren.fill_rect(100, 100, 300, 200)
        },
        func(GEvent e) {
            if e.is_window_close() or e.is_key_down() {
                win.set_should_close(true)
            }
        }
    )
    win.close()
}

// -------------------- 测试 4: 最大化启动 + 始终置顶 --------------------
func test_maximized_always_on_top() {
    print("=== 测试 4: 最大化 + 始终置顶 ===")
    Style[window] w_style = {
        width: 1024,
        height: 768,
        maximized: true,
        always_on_top: true,
        resizable: true
    }
    var win = guis.create_window("测试4 - 最大化 + 置顶", w_style)
    print("窗口创建成功, maximized=true, always_on_top=true")

    win.run(
        func(GDraw ren) {
            ren.set_color(_rgb(20, 20, 40, 255))
            ren.clear()
            ren.set_color(_rgb(255, 255, 255, 255))
            var sz = win.get_size()
            var cx = sz[0] / 2
            var cy = sz[1] / 2
            ren.fill_rect(cx - 100, cy - 50, 200, 100)
        },
        func(GEvent e) {
            if e.is_window_close() or e.is_key_down() {
                win.set_should_close(true)
            }
        }
    )
    win.close()
}

// -------------------- 测试 5: 无边框窗口 --------------------
func test_borderless() {
    print("=== 测试 5: 无边框窗口 ===")
    Style[window] w_style = {
        width: 800,
        height: 600,
        borderless: true,
        center: true,
        bg_color: _rgb(20, 25, 35, 255)
    }
    var win = guis.create_window("测试5 - 无边框窗口", w_style)
    print("窗口创建成功, borderless=true")

    win.run(
        func(GDraw ren) {
            ren.set_color(_rgb(20, 25, 35, 255))
            ren.clear()
            ren.set_color(_rgb(255, 80, 80, 255))
            ren.fill_rect(20, 20, 100, 40)
            ren.set_color(_rgb(255, 255, 255, 255))
            ren.fill_rect(300, 200, 200, 200)
        },
        func(GEvent e) {
            if e.is_window_close() or e.is_key_down() {
                win.set_should_close(true)
            }
        }
    )
    win.close()
}

// -------------------- 测试 6: 全部样式字段综合测试 --------------------
func test_full_style() {
    print("=== 测试 6: 全部新样式字段 ===")
    Style[window] w_style = {
        width: 960,
        height: 680,
        min_width: 640,
        min_height: 480,
        max_width: 1920,
        max_height: 1080,
        center: true,
        title: "测试6 - 全部样式字段",
        bg_color: _rgb(34, 40, 49, 255),
        resizable: true,
        borderless: false,
        fullscreen: false,
        opacity: 1.0,
        visible: true,
        always_on_top: false,
        maximized: false,
        vsync: true
    }
    var win = guis.create_window("测试6 - 综合窗口", w_style)
    print("窗口创建成功! 全部字段已应用")

    win.run(
        func(GDraw ren) {
            ren.set_color(_rgb(34, 40, 49, 255))
            ren.clear()
            ren.set_color(_rgb(255, 99, 71, 255))
            ren.fill_rect(50, 50, 150, 100)
            ren.set_color(_rgb(50, 205, 50, 255))
            ren.fill_rect(250, 50, 150, 100)
            ren.set_color(_rgb(30, 144, 255, 255))
            ren.fill_rect(450, 50, 150, 100)
            ren.set_color(_rgb(255, 215, 0, 255))
            ren.fill_rect(650, 50, 150, 100)
        },
        func(GEvent e) {
            if e.is_window_close() or e.is_key_down() {
                win.set_should_close(true)
            }
        }
    )
    win.close()
}

// -------------------- 测试 7: center 优先于 x/y --------------------
func test_center_priority() {
    print("=== 测试 7: center 优先于 x/y ===")
    Style[window] w_style = {
        width: 600,
        height: 400,
        x: 10,
        y: 10,
        center: true,
        resizable: true
    }
    var win = guis.create_window("测试7 - center优先", w_style)
    print("x=10, y=10 但 center=true, 应该居中")

    var pos = win.get_pos()
    print("实际位置: (" + _str(pos[0]) + ", " + _str(pos[1]) + ")")

    win.run(
        func(GDraw ren) {
            ren.set_color(_rgb(40, 40, 60, 255))
            ren.clear()
            ren.set_color(_rgb(100, 255, 150, 255))
            ren.fill_rect(150, 100, 300, 200)
        },
        func(GEvent e) {
            if e.is_window_close() or e.is_key_down() {
                win.set_should_close(true)
            }
        }
    )
    win.close()
}

// -------------------- 测试 8: 不可调整大小 + 隐藏初始 --------------------
func test_nonresizable_hidden() {
    print("=== 测试 8: 不可调整大小 + visible=false ===")
    Style[window] w_style = {
        width: 400,
        height: 300,
        center: true,
        resizable: false,
        visible: false,
        bg_color: _rgb(60, 30, 40, 255)
    }
    var win = guis.create_window("测试8 - 不可调整大小", w_style)
    print("窗口创建成功, resizable=false, visible=false(初始隐藏)")

    // 手动显示窗口
    win.show()
    print("调用 win.show() 显示窗口")

    win.run(
        func(GDraw ren) {
            ren.set_color(_rgb(60, 30, 40, 255))
            ren.clear()
            ren.set_color(_rgb(255, 180, 200, 255))
            ren.fill_rect(100, 80, 200, 140)
        },
        func(GEvent e) {
            if e.is_window_close() or e.is_key_down() {
                win.set_should_close(true)
            }
        }
    )
    win.close()
}

// -------------------- 测试 9: 禁止最大化 --------------------
func test_no_maximize() {
    print("=== 测试 9: 禁止最大化 ===")
    Style[window] w_style = {
        width: 600,
        height: 400,
        center: true,
        maximizable: false,
        resizable: true,
        bg_color: _rgb(50, 20, 20, 255)
    }
    var win = guis.create_window("测试9 - 禁止最大化", w_style)
    print("窗口创建成功, maximizable=false")
    print("注意: 最大化和最小化按钮应该被禁用")

    win.run(
        func(GDraw ren) {
            ren.set_color(_rgb(50, 20, 20, 255))
            ren.clear()
            ren.set_color(_rgb(255, 255, 100, 255))
            ren.fill_rect(200, 150, 200, 100)
        },
        func(GEvent e) {
            if e.is_window_close() or e.is_key_down() {
                win.set_should_close(true)
            }
        }
    )
    win.close()
}

// -------------------- 主入口 --------------------
main() {
    print("========================================")
    print("窗口新样式特性测试 - Style[window]")
    print("========================================")
    print("")
    print("测试字段: center, min_width, min_height,")
    print("         max_width, max_height, maximized,")
    print("         maximizable, vsync, opacity,")
    print("         bg_color, icon, borderless,")
    print("         fullscreen, etc.")
    print("")

    // 逐个运行测试
    // test_basic_center()
    // test_min_max_size()
    // test_opacity_vsync()
    // test_maximized_always_on_top()
    // test_borderless()
    // test_full_style()
    // test_center_priority()
    // test_nonresizable_hidden()
    test_no_maximize()

    print("取消注释需要运行的测试函数")
    print("每个测试会弹出窗口，关闭后继续下一个")
    print("========================================")
}
