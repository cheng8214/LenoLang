/* 测试：只用文件对话框选择文件并打印路径，不读取、不 set_text */
import guis

var g_pending_path = ""

main() {
    Style[window] w_style = {
        width: 800,
        height: 600,
        resizable: true,
        title: "Test FileDialog Only Print"
    }
    GWin win = guis.create_window("Test FileDialog Only Print", w_style)

    var btn = win.add_button({
        x: 20,
        y: 10,
        width: 120,
        height: 32,
        text: "选择文件",
        bg_color: _rgb(70, 130, 180, 255),
        text_color: _rgb(255, 255, 255, 255),
        font_name: "SimSun",
        font_size: 14,
        radius: 4
    })

    var opts = {
        title: "选择 Leno 文件",
        filters: [
            { name: "Leno Files", pattern: "*.leno" },
            { name: "All Files", pattern: "*.*" }
        ],
        multiple: false
    }

    btn.on_click(func() {
        guis.file_dialog(0, func(var file_list, var idx) {
            if file_list is Array and file_list.len() > 0 {
                var path = file_list[0]
                if path is string {
                    g_pending_path = path
                }
            }
        }, opts)
    })

    win.run(
        func(GDraw ren) {
            ren.set_color(_rgb(34, 34, 34, 255))
            ren.clear()

            if g_pending_path != "" {
                var path = g_pending_path
                g_pending_path = ""
                print("selected path: " + path)
            }
        },
        func(GEvent e) {
            if e.quit() or e.window_close() {
                win.set_should_close(true)
            }
        }
    )

    win.close()
}
