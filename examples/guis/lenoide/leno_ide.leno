import guis
import files

main() {
    GWin win = guis.create_window("Leno IDE", {
        width: 900, height: 650, resizable: true, title: "Leno IDE"
    })

    string current_path = ""

    GEdit edit = win.add_edit({
        x: 20, y: 52, width: 860, height: 570,
        multiline: true, line_spacing: 4,
        bg_color: _rgb(255, 255, 255, 255),
        text_color: _rgb(30, 30, 30, 255),
        border_color: _rgb(180, 180, 180, 255),
        focus_color: _rgb(70, 130, 220, 255),
        font_name: "SimSun", font_size: 14,
        padding_x: 8, padding_y: 6,
        radius: 4, border_width: 1,
        placeholder: "打开 .leno 文件开始编辑"
    })

    var btn_open = win.add_button({
        x: 20, y: 10, width: 80, height: 32,
        text: "打开",
        bg_color: _rgb(70, 130, 180, 255),
        text_color: _rgb(255, 255, 255, 255),
        font_name: "SimSun", font_size: 14, radius: 4
    })

    var btn_save = win.add_button({
        x: 108, y: 10, width: 80, height: 32,
        text: "保存",
        bg_color: _rgb(70, 130, 180, 255),
        text_color: _rgb(255, 255, 255, 255),
        font_name: "SimSun", font_size: 14, radius: 4
    })

    var opts = {
        title: "选择文件",
        filters: [{name:"Leno",pattern:"*.leno"},{name:"All",pattern:"*.*"}],
        multiple: false
    }

    btn_open.on_click(func() {
        guis.file_dialog(0, func(var fl, var _) {
            if fl is Array[string] and fl.len() > 0 {
                current_path = fl[0]
                File fp = files.open(current_path, "r")
                string content = fp.read()
                fp.close()
                edit.set_text(content)
            }
        }, opts)
    })

    btn_save.on_click(func() {
        if current_path != "" {
            var content = edit.get_text()
            File fp = files.open(current_path, "w")
            fp.write(content)
            fp.close()
        } else {
            guis.file_dialog(1, func(var fl, var _) {
                if fl is Array[string] and fl.len() > 0 {
                    current_path = fl[0]
                    var content = edit.get_text()
                    File fp = files.open(current_path, "w")
                    fp.write(content)
                    fp.close()
                }
            }, opts)
        }
    })

    win.run(
        func(GDraw ren) { ren.set_color(_rgb(34,34,34,255)); ren.clear() },
        func(GEvent e) { if e.quit() or e.window_close() { win.set_should_close(true) } }
    )
    win.close()
}
