// 测试 enum 基本功能

// 定义一个 enum
enum Color {
    red
    green
    blue
}

// 定义带显式值的 enum
enum Status {
    ok = 200
    not_found = 404
    error = 500
}

// 定义混合的 enum（部分显式值，部分自动递增）
enum Priority {
    low = 1
    medium  // 自动为 2
    high    // 自动为 3
}

// 辅助函数
func test_enum_value(var color) {
    print("传入的颜色值:", color)
}

// 测试 enum 访问
main() {
    // 测试基本 enum 值
    
    print("Color.red =", Color.red)
    print("Color.green =", Color.green)
    print("Color.blue =", Color.blue)
    // 测试带显式值的 enum
    print("Status.ok =", Status.ok)
    print("Status.not_found =", Status.not_found)
    print("Status.error =", Status.error)
    
    // 测试混合 enum
    print("Priority.low =", Priority.low)
    print("Priority.medium =", Priority.medium)
    print("Priority.high =", Priority.high)
    
    // 测试 enum 值在条件中的使用
    if Color.red == 0 {
        print("Color.red 等于 0，正确！")
    }
    
    // 测试 enum 作为函数参数
    test_enum_value(Color.blue)
    
    // 测试 enum 值比较
    int color =Color.green
    print("color =", color)
    if color == Color.green {
        print("颜色是 green！")
    }
}
