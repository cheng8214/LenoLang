// 测试导入模块中的 enum

import "color_module.leno"

main() {
    // 测试访问导入的 enum 成员
    print("Color.red =", color_module.Color.red)
    print("Color.green =", color_module.Color.green)
    print("Color.blue =", color_module.Color.blue)

    print("Status.ok =", color_module.Status.ok)
    print("Status.not_found =", color_module.Status.not_found)
    print("Status.error =", color_module.Status.error)

    // 测试直接使用 enum 值
    var my_color = color_module.Color.blue
    print("我的颜色值:", my_color)

    // 测试条件判断
    if (color_module.Color.red == 0) {
        print("Color.red 等于 0，正确！")
    }
}
