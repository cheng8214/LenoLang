// 测试嵌套闭包 - 函数返回函数返回函数

func outer() {
    var x = 1
    func middle() {
        var y = 2
        func inner() {
            return x + y
        }
        return inner
    }
    return middle
}

main() {
    var m1 = outer()
    var m2 = outer()
    
    var i1 = m1()
    var i2 = m2()
    
    print(i1())  // 3
    print(i2())  // 3
}
