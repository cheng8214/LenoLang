// 测试多条件类型守卫

var x = 5
var y = "hello"

if x is int or y is string {   // ← 故意触发 [ or类型守卫 ] 警告 ✓（本文件是教学/边界用例，不是漏改 ✓）
    print("guard passed")
} else {
    print("guard failed")
}

// 测试单条件类型守卫（兼容旧版本）
var a = 10
if a is int {
    print("single guard passed")
}

print("All multi-guard tests passed!")
