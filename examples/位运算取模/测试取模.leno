main()
{
    // 测试取模
    print("=== 取模测试 ===")
    print("10 % 3 = " + (100000000000000000000 % 3))
    print("17 % 5 = " + (17 % 5))
    
    // 测试位运算
    print("=== 位运算测试 ===")
    var a = 5  // 二进制 101
    var b = 3  // 二进制 011
    
    print("5 & 3 = " + (a & b))   // 001 = 1
    print("5 | 3 = " + (a | b))   // 111 = 7
    print("5 ^ 3 = " + (a ^ b))   // 110 = 6
    print("~5 = " + (~a))         // ~101 = ...11111010 = -6
    
    // 测试位移
    print("=== 位移测试 ===")
    var c = 8  // 二进制 1000
    print("8 << 2 = " + (c << 2))  // 100000 = 32
    print("8 >> 2 = " + (c >> 2))  // 10 = 2
    
    // 测试复合赋值
    print("=== 复合赋值测试 ===")
    var x = 10
    x %= 3
    print("x %= 3: x = " + x)      // 1
    
    var y = 5
    y &= 3
    print("y &= 3: y = " + y)      // 1
    
    var z = 5
    z |= 2
    print("z |= 2: z = " + z)      // 7
    
    var w = 5
    w ^= 3
    print("w ^= 3: w = " + w)      // 6
    
    var s = 8
    s <<= 2
    print("s <<= 2: s = " + s)     // 32
    
    var t = 8
    t >>= 2
    print("t >>= 2: t = " + t)     // 2
}
