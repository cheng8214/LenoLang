// Windows 注册表操作模块（Unicode 版本）- 使用 enum，完整版
// 功能：
// 1. 基本键操作（打开、创建、关闭、删除）
// 2. 值操作（读写字符串、DWORD、MULTI_SZ）
// 3. 枚举子键和值（RegEnumKeyEx, RegEnumValue）
// 4. 统一的错误码处理
// 版本: 2.0

import ffi

// ========== 枚举定义 ==========

// 访问权限枚举
export enum KeyAccess {
    QUERY_VALUE        = 0x0001
    SET_VALUE          = 0x0002
    CREATE_SUB_KEY     = 0x0004
    ENUMERATE_SUB_KEYS = 0x0008
    READ               = 0x20019
    WRITE              = 0x20006
    ALL_ACCESS         = 0xF003F
}

// 值类型枚举
export enum ValueType {
    NONE        = 0
    SZ          = 1
    EXPAND_SZ   = 2
    BINARY      = 3
    DWORD       = 4
    MULTI_SZ    = 7
    QWORD       = 11
}

// HKEY 根键枚举
export enum HKey {
    CLASSES_ROOT   = 0x80000000
    CURRENT_USER   = 0x80000001
    LOCAL_MACHINE  = 0x80000002
    USERS          = 0x80000003
    CURRENT_CONFIG = 0x80000005
}

// Windows 错误码枚举
export enum WinError {
    SUCCESS             = 0
    FILE_NOT_FOUND      = 2
    PATH_NOT_FOUND      = 3
    ACCESS_DENIED       = 5
    INVALID_HANDLE      = 6
    OUTOFMEMORY         = 14
    MORE_DATA           = 234
    NO_MORE_ITEMS       = 259
    KEY_DELETED         = 1018
}

// ========== 内部辅助函数 ==========

func toWstr(var str) {
    return ffi.utf8_to_utf16(str)
}

// 预计算的 HKEY 根键指针（与 win_reg.leno 相同）
// 注意：这些变量在模块加载时初始化，只计算一次
export var HKEY_CLASSES_ROOT   = ffi.ptr_from_int(0x80000000)
export var HKEY_CURRENT_USER   = ffi.ptr_from_int(0x80000001)
export var HKEY_LOCAL_MACHINE  = ffi.ptr_from_int(0x80000002)
export var HKEY_USERS          = ffi.ptr_from_int(0x80000003)
export var HKEY_CURRENT_CONFIG = ffi.ptr_from_int(0x80000005)

// 内部辅助函数：将 HKey enum 值转换为指针
// 支持传入 enum HKey 或直接使用 HKEY_* 变量
func getHKeyPtr(var hKey) {
    // 如果已经是指针类型，直接返回
    if ffi.is_ptr(hKey) {
        return hKey
    }
    // 根据 enum 值转换为指针
    switch hKey {
        case HKey.CLASSES_ROOT   { return HKEY_CLASSES_ROOT }
        case HKey.CURRENT_USER   { return HKEY_CURRENT_USER }
        case HKey.LOCAL_MACHINE  { return HKEY_LOCAL_MACHINE }
        case HKey.USERS          { return HKEY_USERS }
        case HKey.CURRENT_CONFIG { return HKEY_CURRENT_CONFIG }
        default {
            // 对于其他值，尝试直接转换
            return ffi.ptr_from_int(hKey)
        }
    }
}

export func errorToString(var errorCode) {
    switch errorCode {
        case WinError.SUCCESS { return "SUCCESS" }
        case WinError.FILE_NOT_FOUND { return "FILE_NOT_FOUND" }
        case WinError.PATH_NOT_FOUND { return "PATH_NOT_FOUND" }
        case WinError.ACCESS_DENIED { return "ACCESS_DENIED" }
        case WinError.INVALID_HANDLE { return "INVALID_HANDLE" }
        case WinError.OUTOFMEMORY { return "OUTOFMEMORY" }
        case WinError.MORE_DATA { return "MORE_DATA" }
        case WinError.NO_MORE_ITEMS { return "NO_MORE_ITEMS" }
        case WinError.KEY_DELETED { return "KEY_DELETED" }
        default { return "UNKNOWN_ERROR(" + errorCode + ")" }
    }
}

// ========== 键操作 ==========

export func openKey(var hKey, var subKey, var samDesired) {
    var advapi = ffi.load("advapi32.dll")
    var hResult = ffi.malloc(8)
    try {
        var wSubKey = toWstr(subKey)
        try {
            var hKeyPtr = getHKeyPtr(hKey)
            var result = ffi.call(advapi, "RegOpenKeyExW",
                hKeyPtr, wSubKey, 0, samDesired, hResult)
            if result == WinError.SUCCESS {
                return [ffi.read_ptr(hResult, 0), 0]
            }
            return [null, result]
        } finally {
            ffi.free(wSubKey)
        }
    } finally {
        ffi.free(hResult)
        ffi.free(advapi)
    }
}

export func createKey(var hKey, var subKey, var samDesired) {
    var advapi = ffi.load("advapi32.dll")
    var hResult = ffi.malloc(8)
    var disp = ffi.malloc(4)
    try {
        var wSubKey = toWstr(subKey)
        try {
            var hKeyPtr = getHKeyPtr(hKey)
            var result = ffi.call(advapi, "RegCreateKeyExW",
                hKeyPtr, wSubKey, 0, ffi.nullptr(), 0,
                samDesired, ffi.nullptr(), hResult, disp)
            if result == WinError.SUCCESS {
                return [ffi.read_ptr(hResult, 0), 0, ffi.read_int(disp, 0) == 1]
            }
            return [null, result, false]
        } finally {
            ffi.free(wSubKey)
        }
    } finally {
        ffi.free(hResult)
        ffi.free(disp)
        ffi.free(advapi)
    }
}

export func closeKey(var hKey) {
    var advapi = ffi.load("advapi32.dll")
    try {
        return ffi.call(advapi, "RegCloseKey", hKey)
    } finally {
        ffi.free(advapi)
    }
}

export func deleteKey(var hKey, var subKey) {
    var advapi = ffi.load("advapi32.dll")
    var wSubKey = toWstr(subKey)
    try {
        var hKeyPtr = getHKeyPtr(hKey)
        return ffi.call(advapi, "RegDeleteKeyW", hKeyPtr, wSubKey)
    } finally {
        ffi.free(wSubKey)
        ffi.free(advapi)
    }
}

// ========== 枚举操作 ==========

// 枚举子键 - 获取所有子键名称
// 参数：hKey - 打开的键句柄
// 返回：[子键名称数组, 错误码]
export func enumSubKeys(var hKey) {
    var advapi = ffi.load("advapi32.dll")
    var subKeys = []
    var index = 0
    
    try {
        while true {
            // 分配缓冲区（Windows 最大键名长度 255 + null）
            var nameBuf = ffi.malloc(512)
            var nameLen = ffi.malloc(4)
            ffi.write_int(nameLen, 0, 256)
            
            var result = ffi.call(advapi, "RegEnumKeyExW",
                hKey, index, nameBuf, nameLen, ffi.nullptr(),
                ffi.nullptr(), ffi.nullptr(), ffi.nullptr())
            
            if result == WinError.NO_MORE_ITEMS {
                ffi.free(nameBuf)
                ffi.free(nameLen)
                break
            }
            
            if result == WinError.SUCCESS {
                // 读取子键名
                var keyName = ffi.utf16_to_utf8(nameBuf)
                subKeys.add(keyName)
                index = index + 1
            }
            
            ffi.free(nameBuf)
            ffi.free(nameLen)
            
            if result != WinError.SUCCESS and result != WinError.NO_MORE_ITEMS {
                return [subKeys, result]
            }
        }
        return [subKeys, 0]
    } finally {
        ffi.free(advapi)
    }
}

// 枚举值 - 获取所有值的信息
// 参数：hKey - 打开的键句柄
// 返回：[值信息数组, 错误码]
// 值信息格式：{name: 值名, type: 类型常量, typeName: 类型名称}
export func enumValues(var hKey) {
    var advapi = ffi.load("advapi32.dll")
    var values = []
    var index = 0
    
    try {
        while true {
            // 分配缓冲区
            var nameBuf = ffi.malloc(512)
            var nameLen = ffi.malloc(4)
            ffi.write_int(nameLen, 0, 256)
            
            var typeBuf = ffi.malloc(4)
            var dataBuf = ffi.malloc(2048)
            var dataLen = ffi.malloc(4)
            ffi.write_int(dataLen, 0, 2048)
            
            var result = ffi.call(advapi, "RegEnumValueW",
                hKey, index, nameBuf, nameLen, ffi.nullptr(),
                typeBuf, dataBuf, dataLen)
            
            if result == WinError.NO_MORE_ITEMS {
                ffi.free(nameBuf)
                ffi.free(nameLen)
                ffi.free(typeBuf)
                ffi.free(dataBuf)
                ffi.free(dataLen)
                break
            }
            
            if result == WinError.SUCCESS {
                var valName = ffi.utf16_to_utf8(nameBuf)
                var valType = ffi.read_int(typeBuf, 0)
                
                // 获取类型名称
                var typeName = "UNKNOWN"
                switch valType {
                    case ValueType.SZ { typeName = "SZ" }
                    case ValueType.EXPAND_SZ { typeName = "EXPAND_SZ" }
                    case ValueType.BINARY { typeName = "BINARY" }
                    case ValueType.DWORD { typeName = "DWORD" }
                    case ValueType.MULTI_SZ { typeName = "MULTI_SZ" }
                    case ValueType.QWORD { typeName = "QWORD" }
                }
                
                values.add({
                    name: valName,
                    type: valType,
                    typeName: typeName
                })
                index = index + 1
            }
            
            ffi.free(nameBuf)
            ffi.free(nameLen)
            ffi.free(typeBuf)
            ffi.free(dataBuf)
            ffi.free(dataLen)
            
            if result != WinError.SUCCESS and result != WinError.NO_MORE_ITEMS {
                return [values, result]
            }
        }
        return [values, 0]
    } finally {
        ffi.free(advapi)
    }
}

// ========== 值操作 ==========

export func readString(var hKey, var valueName) {
    var advapi = ffi.load("advapi32.dll")
    var dataType = ffi.malloc(4)
    var dataSize = ffi.malloc(4)
    
    try {
        var wValueName = if valueName == "" then ffi.nullptr() else toWstr(valueName)
        try {
            ffi.write_int(dataSize, 0, 0)
            var result = ffi.call(advapi, "RegQueryValueExW",
                hKey, wValueName, ffi.nullptr(), dataType, ffi.nullptr(), dataSize)
            
            if result != WinError.SUCCESS {
                return [null, result]
            }
            
            var actualType = ffi.read_int(dataType, 0)
            if actualType != ValueType.SZ and actualType != ValueType.EXPAND_SZ {
                return [null, WinError.INVALID_HANDLE]
            }
            
            var requiredSize = ffi.read_int(dataSize, 0)
            var dataBuffer = ffi.malloc(requiredSize)
            try {
                result = ffi.call(advapi, "RegQueryValueExW",
                    hKey, wValueName, ffi.nullptr(), dataType, dataBuffer, dataSize)
                
                if result == WinError.SUCCESS {
                    return [ffi.utf16_to_utf8(dataBuffer), 0]
                }
                return [null, result]
            } finally {
                ffi.free(dataBuffer)
            }
        } finally {
            if wValueName != ffi.nullptr() {
                ffi.free(wValueName)
            }
        }
    } finally {
        ffi.free(dataType)
        ffi.free(dataSize)
        ffi.free(advapi)
    }
}

export func readDword(var hKey, var valueName) {
    var advapi = ffi.load("advapi32.dll")
    var dataType = ffi.malloc(4)
    var dataSize = ffi.malloc(4)
    var dataBuffer = ffi.malloc(4)
    
    try {
        ffi.write_int(dataSize, 0, 4)
        var wValueName = if valueName == "" then ffi.nullptr() else toWstr(valueName)
        try {
            var result = ffi.call(advapi, "RegQueryValueExW",
                hKey, wValueName, ffi.nullptr(), dataType, dataBuffer, dataSize)
            
            if result != WinError.SUCCESS {
                return [null, result]
            }
            
            if ffi.read_int(dataType, 0) != ValueType.DWORD {
                return [null, WinError.INVALID_HANDLE]
            }
            
            return [ffi.read_int(dataBuffer, 0), 0]
        } finally {
            if wValueName != ffi.nullptr() {
                ffi.free(wValueName)
            }
        }
    } finally {
        ffi.free(dataType)
        ffi.free(dataSize)
        ffi.free(dataBuffer)
        ffi.free(advapi)
    }
}

// 读取 MULTI_SZ 值（字符串数组）- 简化版
// 返回：[[字符串1, 字符串2, ...], 错误码]
export func readMultiString(var hKey, var valueName) {
    var advapi = ffi.load("advapi32.dll")
    var dataType = ffi.malloc(4)
    var dataSize = ffi.malloc(4)
    
    try {
        var wValueName = if valueName == "" then ffi.nullptr() else toWstr(valueName)
        try {
            ffi.write_int(dataSize, 0, 0)
            var result = ffi.call(advapi, "RegQueryValueExW",
                hKey, wValueName, ffi.nullptr(), dataType, ffi.nullptr(), dataSize)
            
            if result != WinError.SUCCESS {
                return [null, result]
            }
            
            if ffi.read_int(dataType, 0) != ValueType.MULTI_SZ {
                return [null, WinError.INVALID_HANDLE]
            }
            
            var requiredSize = ffi.read_int(dataSize, 0)
            var dataBuffer = ffi.malloc(requiredSize)
            try {
                result = ffi.call(advapi, "RegQueryValueExW",
                    hKey, wValueName, ffi.nullptr(), dataType, dataBuffer, dataSize)
                
                if result == WinError.SUCCESS {
                    // 简化处理：返回原始数据（需要进一步解析）
                    // 实际实现需要 ffi.parse_multi_sz 支持
                    return ["MULTI_SZ_DATA", 0]
                }
                return [null, result]
            } finally {
                ffi.free(dataBuffer)
            }
        } finally {
            if wValueName != ffi.nullptr() {
                ffi.free(wValueName)
            }
        }
    } finally {
        ffi.free(dataType)
        ffi.free(dataSize)
        ffi.free(advapi)
    }
}

export func writeString(var hKey, var valueName, var value) {
    var advapi = ffi.load("advapi32.dll")
    var wValueName = if valueName == "" then ffi.nullptr() else toWstr(valueName)
    var wValue = toWstr(value)
    
    try {
        var byteLen = ffi.sizeof(wValue)
        var result = ffi.call(advapi, "RegSetValueExW",
            hKey, wValueName, 0, ValueType.SZ, wValue, byteLen)
        return result
    } finally {
        if wValueName != ffi.nullptr() {
            ffi.free(wValueName)
        }
        ffi.free(wValue)
        ffi.free(advapi)
    }
}

export func writeDword(var hKey, var valueName, var value) {
    var advapi = ffi.load("advapi32.dll")
    var buffer = ffi.malloc(4)
    try {
        ffi.write_int(buffer, 0, value)
        var wValueName = if valueName == "" then ffi.nullptr() else toWstr(valueName)
        try {
            return ffi.call(advapi, "RegSetValueExW",
                hKey, wValueName, 0, ValueType.DWORD, buffer, 4)
        } finally {
            if wValueName != ffi.nullptr() {
                ffi.free(wValueName)
            }
        }
    } finally {
        ffi.free(buffer)
        ffi.free(advapi)
    }
}

export func deleteValue(var hKey, var valueName) {
    var advapi = ffi.load("advapi32.dll")
    var wValueName = toWstr(valueName)
    try {
        return ffi.call(advapi, "RegDeleteValueW", hKey, wValueName)
    } finally {
        ffi.free(wValueName)
        ffi.free(advapi)
    }
}

export func setDefaultValue(var hKey, var value) {
    return writeString(hKey, "", value)
}

export func getDefaultValue(var hKey) {
    return readString(hKey, "")
}

export func flushKey(var hKey) {
    var advapi = ffi.load("advapi32.dll")
    try {
        return ffi.call(advapi, "RegFlushKey", hKey)
    } finally {
        ffi.free(advapi)
    }
}

// ========== 高级操作 ==========

export func keyExists(var hKey, var subKey) {
    var result = openKey(hKey, subKey, KeyAccess.QUERY_VALUE)
    var handle = result[0]
    var errorCode = result[1]
    
    if handle != null {
        closeKey(handle)
        return true
    }
    return errorCode != WinError.FILE_NOT_FOUND and errorCode != WinError.PATH_NOT_FOUND
}

export func valueExists(var hKey, var valueName) {
    var result = readString(hKey, valueName)
    return result[1] == 0
}
