// 问题1复现 - struct clib字段跨模块丢失
import ffi

clib core_lib { i32 abs(i32 x) }
core_lib g = null
export func loadCore(): core_lib {
    if g == null { g = ffi.load("msvcrt.dll") }
    return g
}

export struct Holder {
    core_lib lib = null
    string   tag = ""
}
export func useHolder(Holder h, int x): int {
    return h.lib.abs(x) as int
}
