import "win_process_optimized.leno" as wp

print("测试开始")
var pid = wp.getCurrentPid()
print("PID 值: " + pid)

var count = wp.getProcessorCount()
print("处理器数量: " + count)

print("\n系统内存信息:")
var memInfo = wp.getSystemMemory()
print("  内存负载: " + memInfo.memoryLoad + "%")
print("  总物理内存: " + memInfo.totalPhys + " MB")
print("  可用物理内存: " + memInfo.availPhys + " MB")

print("\n当前进程内存:")
var procMem = wp.getProcessMemory(pid)
if procMem.errorCode == 0 {
    print("  工作集: " + procMem.workingSet + " KB")
    print("  峰值工作集: " + procMem.peakWorkingSet + " KB")
} else {
    print("  获取内存信息失败")
}

print("\n测试完成!")
