// 高级数学模块 - 同时依赖 math_utils 和 geometry

import "math_utils.leno" as math
import "geometry.leno" as geo

export func cylinder_volume(var radius, var height)
{
    // 调用 geometry 模块的函数，而 geometry 内部又调用了 math_utils
    var base_area = geo.circle_area(radius)
    return math.multiply(base_area, height)
}

export func cylinder_surface_area(var radius, var height)
{
    var base_area = geo.circle_area(radius)
    var two_bases = math.multiply(2, base_area)
    
    // 圆周长 = 2 * PI * radius
    var circumference = math.multiply(math.multiply(2, math.PI), radius)
    var side_area = math.multiply(circumference, height)
    
    return math.add(two_bases, side_area)
}
