// 测试类型定义模块

import "types.leno" as t

main()
{
    print("=== 测试导出 enum 和 struct ===")
    
    // 测试枚举
    print("--- 测试枚举 ---")
    print("Color.RED = ")
    print(t.Color.RED)
    print("Color.GREEN = ")
    print(t.Color.GREEN)
    print("Color.BLUE = ")
    print(t.Color.BLUE)
    
    print("Status.PENDING = ")
    print(t.Status.PENDING)
    print("Status.COMPLETED = ")
    print(t.Status.COMPLETED)
    
    // 测试枚举函数
    print("color_name(Color.RED) = ")
    print(t.color_name(t.Color.RED))
    print("color_name(Color.BLUE) = ")
    print(t.color_name(t.Color.BLUE))
    
    print("status_name(Status.RUNNING) = ")
    print(t.status_name(t.Status.RUNNING))
    
    // 测试结构体
    print("--- 测试结构体 ---")
    var p = t.create_point(10, 20)
    print("Point: x = ")
    print(p.x)
    print("Point: y = ")
    print(p.y)
    
    var r = t.create_rect(0, 0, 100, 50)
    print("Rectangle: width = ")
    print(r.width)
    print("Rectangle: height = ")
    print(r.height)
    print("Rectangle area = ")
    print(t.rect_area(r))
    
    var person = t.create_person("Alice", 30)
    print("Person: name = ")
    print(person.name)
    print("Person: age = ")
    print(person.age)
    
    print("=== 完成 ===")
}
