// 简化混合测试

import "shape_math.leno" as sm

main()
{
    print("=== 简化混合测试 ===")
    
    // 测试圆形面积
    var area = sm.circle_area(5)
    print("Circle area = ")
    print(area)
    
    // 测试矩形
    var rect = sm.create_rectangle(0, 0, 10, 20)
    print("Rect width = ")
    print(rect.width)
    
    // 测试矩形面积
    var rect_area = sm.rectangle_area(rect)
    print("Rect area = ")
    print(rect_area)
    
    print("=== 完成 ===")
}
