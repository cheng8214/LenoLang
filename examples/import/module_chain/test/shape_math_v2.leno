// 形状数学模块 v2

import "../数学模块链/geometry.leno" as geo
import "../类型定义/types.leno" as ty

// 计算圆形面积
export func circle_area(var radius)
{
    return geo.circle_area(radius)
}

// 创建矩形结构体
export func create_rectangle(int x, int y, int w, int h)
{
    return new ty.Rectangle(x = x, y = y, width = w, height = h)
}

// 计算矩形面积
export func rectangle_area(var rect)
{
    return ty.rect_area(rect)
}

// 获取颜色名称
export func get_color_name(var color)
{
    return ty.color_name(color)
}
