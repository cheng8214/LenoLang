// 形状数学模块 v2

import "../数学模块链/geometry.leno" as geo
import "../类型定义/types.leno" as ty
use ty.Rectangle
use ty.Point

// 计算圆形面积
export func circle_area(int radius): int
{
    return geo.circle_area(radius)
}

// 创建矩形结构体
export func create_rectangle(int x, int y, int w, int h): Rectangle
{
    return new ty.Rectangle(x = x, y = y, width = w, height = h)
}

// 计算矩形面积
export func rectangle_area(Rectangle rect): int
{
    return ty.rect_area(rect)
}

// 获取颜色名称
export func get_color_name(any color): string
{
    return ty.color_name(color)
}

// 创建带颜色的形状
export func create_colored_rect(int x, int y, int w, int h, any color): Rectangle
{
    return new ty.Rectangle(x = x, y = y, width = w, height = h)
}

// 复杂计算：圆形 + 矩形
export func mixed_shape_area(int radius, Rectangle rect): int
{
    var circle = geo.circle_area(radius)
    var rectangle = ty.rect_area(rect)
    return circle + rectangle
}

// 计算两个矩形的总面积
export func total_area(Rectangle rect1, Rectangle rect2): int
{
    return ty.rect_area(rect1) + ty.rect_area(rect2)
}

// 创建点数组
export func create_points(int count): Array
{
    var points = []
    for 0 : count - 1 to var i {
        var p = ty.create_point(i * 10, i * 20)
        points.add(p)
    }
    return points
}

// 计算点数组的总距离（简化版）
export func total_distance(Array points): int
{
    int total = 0
    var n = points.len()
    for 0 : n - 2 to var i {
        var p1 = points[i]
        var p2 = points[i + 1]
        if p1 is Point and p2 is Point {
            int dx = p2.x - p1.x
            int dy = p2.y - p1.y
            if dx < 0 { dx = -dx }
            if dy < 0 { dy = -dy }
            total = total + dx + dy
        }
    }
    return total
}
