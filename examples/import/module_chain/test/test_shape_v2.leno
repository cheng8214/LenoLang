// 测试形状数学模块 v2

import "shape_math_v2.leno" as sm
import "../类型定义/types.leno" as ty

main()
{
    print("=== 测试形状数学 v2 ===")
    
    // 测试圆形面积
    var area = sm.circle_area(5)
    print("Circle area = ")
    print(area)
    
    // 测试创建矩形
    var rect = sm.create_rectangle(0, 0, 100, 50)
    print("Rect width = ")
    print(rect.width)
    print("Rect height = ")
    print(rect.height)
    
    // 测试矩形面积
    var rect_area = sm.rectangle_area(rect)
    print("Rect area = ")
    print(rect_area)
    
    // 测试颜色名称
    var name = sm.get_color_name(ty.Color.RED)
    print("Color name = ")
    print(name)
    
    print("=== 完成 ===")
}
