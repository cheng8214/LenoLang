// 测试导入结构体

import "struct_module.leno" as m

main()
{
    print("=== 测试导入结构体 ===")
    
    // 通过函数创建结构体
    var s1 = m.create_test(10, 20)
    print("s1.a = ")
    print(s1.a)
    print("s1.b = ")
    print(s1.b)
    
    // 直接创建结构体
    var s2 = new m.TestStruct(a = 100, b = 200)
    print("s2.a = ")
    print(s2.a)
    print("s2.b = ")
    print(s2.b)
    
    print("=== 完成 ===")
}
