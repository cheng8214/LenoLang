// 异常模块 - 提供可能抛出异常的函数

export func may_throw(any should_throw) {
    if should_throw {
        throw "Error from error_module"
    }
    return "Success"
}

export func always_throw() {
    throw "Always throws"
}

export func nested_error() {
    try {
        throw "Inner error"
    } catch e {
        throw "Outer error: " + e
    }
}
