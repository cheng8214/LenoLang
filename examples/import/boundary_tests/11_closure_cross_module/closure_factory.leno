// 闭包工厂模块 - 创建带 upvalue 的闭包

export func make_counter(any start) {
    var count = start

    func counter_func() {
        count = count + 1
        return count
    }
    return counter_func
}

export func make_adder(any base) {
    func adder_func(any x) {
        return base + x
    }
    return adder_func
}

export func make_multiplier(any factor) {
    func multiplier_func(any x) {
        return x * factor
    }
    return multiplier_func
}

// 返回多个闭包共享同一个 upvalue
export func make_bank_account(int initial) {
    // ⚠ 2026-09-28 修示例：`initial` 与下面闭包的 `amount` 都要写具体类型 ——
    //   否则 `balance` 是 any，`amount > balance` / `int + any` 都会被拒。
    var balance = initial

    func deposit_func(int amount) {
        balance = balance + amount
        return balance
    }

    // ⚠ 2026-09-28 修示例：形参写具体类型 —— `any` 不能参与大小比较（`amount > balance`）
    func withdraw_func(int amount) {
        if amount > balance {
            throw "Insufficient funds"
        }
        balance = balance - amount
        return balance
    }

    func get_balance_func() {
        return balance
    }

    var account = {}
    account["deposit"] = deposit_func
    account["withdraw"] = withdraw_func
    account["get_balance"] = get_balance_func
    return account
}
