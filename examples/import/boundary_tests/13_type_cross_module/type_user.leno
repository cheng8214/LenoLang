// 类型跨模块使用测试
// 使用其他模块定义的类型

import "point_struct.leno" as ps
import "color_enum.leno" as ce
import "type_aliases.leno" as ta
use ps.Point
use ps.Rectangle

// 1. 使用其他模块的 struct
export func create_line(any p1, any p2) {
    // 先计算长度，避免在字典字面量中调用跨模块函数
    var len = ps.distance(p1, p2)
    return {
        "start": p1,
        "end": p2,
        "length": len
    }
}

export func is_point_in_rect(Point point, Rectangle rect) {
    // 使用局部变量存储中间结果，避免链式访问问题
    var tl = rect.top_left
    var br = rect.bottom_right
    return point.x >= tl.x and
           point.x <= br.x and
           point.y >= tl.y and
           point.y <= br.y
}

// 2. 使用其他模块的 enum
export func get_status_icon(any status) {
    if (status == ce.Status.PENDING) {
        return "pending"
    } else if (status == ce.Status.RUNNING) {
        return "running"
    } else if (status == ce.Status.COMPLETED) {
        return "completed"
    } else if (status == ce.Status.FAILED) {
        return "failed"
    }
    return "unknown"
}

export func create_colored_point(any x, any y, any color) {
    // 先获取颜色名称，避免在字典字面量中调用跨模块函数
    var name = ce.color_name(color)
    return {
        "x": x,
        "y": y,
        "color": color,
        "color_name": name
    }
}

// 3. 使用其他模块的类型别名
export func process_data(any data) {
    var result = {}
    result["sum"] = ta.pair_sum(data)
    result["swapped"] = ta.pair_swap(data)
    return result
}

// 4. 组合使用多个模块的类型
export func create_shape(any tl, any br, any fill_color, any border_color) {
    // 先计算所有值，避免在字典字面量中调用跨模块函数
    var rect = ps.create_rectangle(tl, br)
    var area = ps.rectangle_area(rect)
    var fill_name = ce.color_name(fill_color)
    var border_name = ce.color_name(border_color)
    var meta = ta.create_string_map()
    return {
        "rectangle": rect,
        "area": area,
        "fill": fill_name,
        "border": border_name,
        "metadata": meta
    }
}
