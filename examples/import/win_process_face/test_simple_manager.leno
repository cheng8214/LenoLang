// 简单的进程管理器模块（无 FFI，用于测试）

// 进程管理器接口
export face ProcessManager {
    // 获取进程列表
    func listProcesses():Dict
    
    // 根据名称查找进程
    func findByName(string name):Dict
    
    // 检查进程是否存在
    func exists(int pid):bool
}

// 标准进程管理器实现
export struct StandardProcessManager impl ProcessManager {
    
    // 获取进程列表
    func listProcesses():Dict {
        // 返回模拟数据
        var processes = [
            {pid: 1, name: "System"},
            {pid: 100, name: "explorer.exe"},
            {pid: 200, name: "chrome.exe"},
            {pid: 300, name: "notepad.exe"}
        ]
        return {processes: processes, errorCode: 0}
    }
    
    // 根据名称查找进程
    func findByName(string name):Dict {
        var result = listProcesses()
        for result.processes to proc {
            if proc.name.to_lower() == name.to_lower() {
                return {found: true, pid: proc.pid}
            }
        }
        return {found: false, pid: 0}
    }
    
    // 检查进程是否存在
    func exists(int pid):bool {
        var result = listProcesses()
        for result.processes to proc {
            if proc.pid == pid {
                return true
            }
        }
        return false
    }
}

// 获取当前进程 ID（模拟）
export func getCurrentPid():int {
    return 100  // 模拟当前进程是 explorer.exe
}
