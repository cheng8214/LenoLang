// 测试导入模块中的 face
import "test_module_face.leno" as mf

main() {
    print("===== 测试模块中定义的 face =====")
    print("")

    // 创建 Rectangle
    print("--- Rectangle ---")
    var rect = mf.createRectangle(5.0, 3.0)
    print("宽度: 5.0, 高度: 3.0")
    mf.printShapeInfo(rect)
    print("")

    // 创建 Circle
    print("--- Circle ---")
    var circle = mf.createCircle(2.0)
    print("半径: 2.0")
    mf.printShapeInfo(circle)
    print("")

    // 使用模块中的 face 类型作为变量类型（多态）
    print("--- 多态测试 ---")
    var shape1 = mf.createRectangle(4.0, 4.0)
    var shape2 = mf.createCircle(1.0)

    print("Shape1 (Rectangle):")
    mf.printShapeInfo(shape1)

    print("Shape2 (Circle):")
    mf.printShapeInfo(shape2)

    print("===== 测试完成 =====")
}
