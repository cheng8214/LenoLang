// 进程管理接口模块 - face 定义在模块中

export face ProcessManager {
    func getCurrentPid():int
    func getSystemInfo():Dict
    func getSystemUpTime():int
    func formatUptime(int ms):string
}

export func createMockManager():ProcessManager {
    return MockManager()
}

struct MockManager impl ProcessManager {
    int _pid = 1234
    int _uptimeMs = 3600000
    Dict _info = {
        "processorCount": 4,
        "pageSize": 4096,
        "memoryLoad": 45,
        "totalPhys": 16384,
        "availPhys": 8192
    }

    func getCurrentPid():int { return _pid }
    func getSystemInfo():Dict { return _info }
    func getSystemUpTime():int { return _uptimeMs }
    func formatUptime(int ms):string {
        int totalSec = _int(ms / 1000)
        int hours = _int(totalSec / 3600)
        int minutes = _int((totalSec % 3600) / 60)
        int seconds = totalSec % 60
        return hours + " 小时 " + minutes + " 分钟 " + seconds + " 秒"
    }
}

