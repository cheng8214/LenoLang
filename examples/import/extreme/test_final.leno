// 终极边界测试
import "sub/lib_shared.leno" as sub
import "lib_a.leno" as a
import "lib_b.leno" as b
use sub.math_lib
use a.handle_lib
use sub.Dir

main() {
    print("=== 终极边界 ===")

    // 1. 子目录import
    math_lib m = sub.loadMath()
    var v1 = m.abs(-5) as int
    print("1. subdir: " + v1)

    // 2. 子目录enum
    print("2. enum: " + Dir.Down)

    // 3. 模块A clib
    handle_lib ha = a.loadHandle()
    var v3 = ha.abs(-7) as int
    print("3. A: " + v3)

    // 4. 模块B - 不用use, 用模块名访问
    var hb = b.loadHandle()
    var v4 = hb.abs(-11) as int
    print("4. B: " + v4)

    // 5. 变量重导出 - 函数作为值
    var fn = b.absFunc
    var v5 = fn(-13)
    print("5. varFunc: " + v5)

    // 6. 两个clib混用
    var v6a = ha.abs(-17) as int
    var v6b = hb.abs(-19) as int
    print("6. 混用: " + v6a + " " + v6b)

    print("=== 全部通过 ===")
}
