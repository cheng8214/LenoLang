import files

// 测试复制二进制文件
var src_path = "d:\\1.zip"
var dst_path = "c:\\111.zip"

// 检查源文件是否存在
if !files.exists(src_path) {
    print("错误: 源文件不存在: " + src_path)
    return
}

print("开始复制文件...")
print("源文件: " + src_path)
print("目标文件: " + dst_path)

// 以二进制读取模式打开源文件
var f_src = files.open(src_path, "rb")

// 以二进制写入模式打开目标文件
var f_dst = files.open(dst_path, "wb")

// 获取文件大小
var file_size = f_src.len()
print("源文件大小: " + file_size + " 字节")

// 一次性读取全部内容（适合小文件）
var content = f_src.read()
print("读取完成，内容长度: " + content.len())

// 写入目标文件
f_dst.write(content)
print("写入完成")

// 关闭文件
f_src.close()
f_dst.close()

print("\n复制完成!")

// 验证目标文件
if files.exists(dst_path) {
    var f_check = files.open(dst_path, "rb")
    var dst_size = f_check.len()
    f_check.close()
    print("目标文件大小: " + dst_size + " 字节")
    
    if dst_size == file_size {
        print("文件大小匹配，复制成功!")
    } else {
        print("文件大小不匹配!")
    }
} else {
    print("目标文件创建失败!")
}
