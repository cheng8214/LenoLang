// B9 + B14 验证
main() {
    print("--- B9: 宽容版转换 ---")
    print("  _int_or(\"abc\", -1)      = " + _int_or("abc", -1))
    print("  _int_or(\"42\", -1)       = " + _int_or("42", -1))
    print("  _int_or(\"12abc\", -1)    = " + _int_or("12abc", -1))
    print("  _float_or(\"999.06Kb\", -1.0) = " + _float_or("999.06Kb", -1.0))
    print("  _float_or(\"3.5\", 0.0)   = " + _float_or("3.5", 0.0))
    print("  _float_or(\"zp\", -1.0)   = " + _float_or("zp", -1.0))
    var arr = [1, 2, 3]
    print("  _int_or(Array, 0)       = " + _int_or(arr, 0))
    print("  非字符串仍照常转: _int_or(3.9, 0) = " + _int_or(3.9, 0))

    print("--- B14: 报错是否带坏值 ---")
    try {
        var v = _float("999.06Kb")
        print("  没抛? " + v)
    } catch e {
        print("  _float 抛：" + $"{e}")
    }
    try {
        var v2 = _int("zp")
        print("  没抛? " + v2)
    } catch e2 {
        print("  _int 抛：" + $"{e2}")
    }
}
