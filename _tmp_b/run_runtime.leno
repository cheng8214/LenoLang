// 现状探针：B4（_str 口径）/ B9+B14（脏数字抛异常与消息内容）
func named(int n): int { return n * 2 }

main() {
    print("--- B4: _str 对 容器 / 异常 ---")
    var a = [1, 2, 3]
    var d = {"x": 1}
    print("  _str(Array)      = " + _str(a))
    print("  _str(Dict)       = " + _str(d))
    print("  _str(_args())    = " + _str(_args()))
    try {
        var z = _int("abc")
        print("  (没有异常? " + z + ")")
    } catch e {
        print("  异常插值 $e      = " + $"{e}")
        print("  _str(异常)       = " + _str(e))
        print("  e.msg            = " + e.msg)
    }

    print("--- B9/B14: 脏串转换 ---")
    try {
        var f = _float("999.06kb")
        print("  _float(脏串) 未抛异常，返回 " + f)
    } catch e2 {
        print("  _float 抛异常    = " + $"{e2}")
    }
    try {
        var i2 = _int("zp")
        print("  _int(脏串) 未抛异常，返回 " + i2)
    } catch e3 {
        print("  _int 抛异常      = " + $"{e3}")
    }
}
