// ============================================================================
// 探针 6 / 网络：DNS → TCP → 手写 HTTP/1.1 请求 → 解析响应
// 这是 app 最需要的能力。Leno 只给到 socket 原语（没有内置 HTTP 客户端），
// 所以这里顺便验证"用 socket 自己拼一个 GET"到底能不能成 —— 能成，就不必依赖任何库。
// ⚠ 需要 AndroidManifest 里的 INTERNET 权限
// ============================================================================
import sockets
import strings
import times

int g_ok = 0
int g_ng = 0

func chk(string name, bool cond, string detail) {
    if cond { g_ok = g_ok + 1; print("OK   " + name + " | " + detail) }
    else    { g_ng = g_ng + 1; print("NG   " + name + " | " + detail) }
}

// 用裸 socket 发一个 HTTP/1.1 GET，返回完整响应文本（失败返回 ""）
func httpGet(string host, int port, string path): string {
    var ip = sockets.resolve(host)
    if ip == "" { return "" }

    var s = sockets.connect(host, port)
    if s == null { return "" }
    s.set_timeout(8000)                    // ⚠ 单位是**毫秒**（传 8 会变成 8ms 超时 ⇒ recv 立刻返回 null）

    var req = "GET " + path + " HTTP/1.1\r\n"
        + "Host: " + host + "\r\n"
        + "User-Agent: LenoVM/1.0\r\n"
        + "Connection: close\r\n"
        + "Accept: */*\r\n\r\n"
    s.send(req)

    var resp = ""
    var guard = 0
    while guard < 200 {
        var chunk = s.recv(4096)
        if chunk == null or chunk == "" { break }
        resp = resp + chunk
        guard = guard + 1
    }
    s.close()
    return resp
}

main() {
    print("== c6 网络 ==")

    // ---- 1. DNS ----
    var ip = sockets.resolve("example.com")
    chk("dns.resolve", ip != "" and ip.has("."), "example.com -> " + ip)

    // 解析失败应返回空串（不崩）
    var badIp = sockets.resolve("no-such-host-leno-test.invalid")
    chk("dns.fail", badIp == null or badIp == "", "不存在域名 -> " + _str(badIp))

    // ---- 2. TCP 连接 ----
    var t0 = times.ms()
    var s = sockets.connect("example.com", 80)
    var connMs = times.ms() - t0
    chk("tcp.connect", s != null, "example.com:80 用时 " + _str(_int(connMs)) + "ms")
    if s != null { s.close() }

    // ---- 3. 手写 HTTP GET ----
    // 网络断言天生会抖（DNS/握手偶发超时），失败重试一次再判定
    var resp = httpGet("example.com", 80, "/")
    if not resp.has("200 OK") {
        print("INFO http.get 首次失败，重试一次")
        resp = httpGet("example.com", 80, "/")
    }
    var firstLine = ""
    if resp.len() > 0 { firstLine = strings.split(resp, "\r\n")[0] }
    chk("http.get", resp.has("200 OK") and resp.len() > 100,
        "状态行=" + firstLine + " 响应字节=" + _str(resp.len()))

    // ---- 4. HTTPS 端口能连（TLS 握手不在 VM 内，只验证 TCP 通）----
    var hs = sockets.connect("example.com", 443)
    chk("tcp.443", hs != null, "443 可连（HTTPS 内容需自备 TLS 实现）")
    if hs != null { hs.close() }

    // ---- 5. 连不上的端口应快速失败而不是死等 ----
    var t1 = times.ms()
    var dead = sockets.connect("127.0.0.1", 9)
    var failMs = times.ms() - t1
    chk("tcp.refused", dead == null, "拒绝连接 -> null，耗时 " + _str(_int(failMs)) + "ms")
    if dead != null { dead.close() }

    print("== c6 结果: ok=" + _str(g_ok) + " ng=" + _str(g_ng) + " ==")
}
