// 测试模块

export struct TestStruct {
    int value
    bool isInit

    func init(): bool {
        isInit = true
        return true
    }

    func sleep(int ms) {
        print("sleep " + ms + " ms")
    }

    func uninit() {
        print("uninit called")
        isInit = false
    }
}

export func createTest(): TestStruct {
    var obj = new TestStruct()
    obj.init()
    return obj
}
