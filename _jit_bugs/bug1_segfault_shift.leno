import strings
func hex64(int v):string {
    var hx = "0123456789abcdef"
    string s = ""
    for 0:15 to i {
        int bb = (v >> (60 - i*4)) & 0xf
        s += strings.char(hx.byte(bb))
    }
    return s
}
main() {
    print("L1(字面量0xffffffffffffffff): " + hex64(0xffffffffffffffff))
    print("L2(字面量-1): " + hex64(-1))
    int neg = -1
    print("L3(var=-1): " + hex64(neg))
    int calc = 0x80000000 * 4294967296
    print("L4(calc=2^63): " + hex64(calc))
    int calc2 = calc + 1
    print("L5(calc2=2^63+1): " + hex64(calc2))
    print("DONE")
}
