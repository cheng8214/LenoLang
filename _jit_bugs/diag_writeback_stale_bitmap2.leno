// §8.128 诊断（形态扫描 v3）：可达的"动态类型"来源只有**混合元素数组**取值
// （`any` 不能作形参类型 ✗；`float→int` 赋值是类型错误 ✗ ⇒ 静态已知类型构不出该形态）。
// 期望：所有形态 JIT == LENO_NO_JIT。

var G = [1.0, 2]                       // 混合元素 ⇒ 元素静态类型 any

main() {
    // A：入口 = G[0]（运行期 float ⇒ 位图 bit=1），循环内赋 **int**
    var a = null
    a = G[0]
    int i = 0
    while i < 300 { a = 7; i = i + 1 }
    print("A=[" + a + "]\n")

    // B（对照）：入口 = G[0]（float ⇒ bit=1），循环内赋 **float** ⇒ 应正确
    var b = null
    b = G[0]
    int j = 0
    while j < 300 { b = 1.5; j = j + 1 }
    print("B=[" + b + "]\n")

    // C：入口 = G[0]（float ⇒ bit=1），循环内赋"运行期 int 的 any 值"
    var c = null
    c = G[0]
    int k = 0
    while k < 300 { c = G[1]; k = k + 1 }
    print("C=[" + c + "]\n")
}
