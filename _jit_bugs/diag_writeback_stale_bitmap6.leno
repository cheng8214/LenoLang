// §8.128 诊断（关键修正 v2）：v3~v6 的 RHS 都是**循环不变量** ⇒ 被 LICM 提升出循环
// （实测日志：循环体只剩 GET_LOCAL/SET_LOCAL_POP/FOLD）⇒ 那些"与解释器一致"是**空结论** ✗。
// 本件：入口用 any 容器取值把局部量变成 **any 型**（静态类型已知时 `float→int` 是类型错误 ✗），
// 循环内再用**依赖循环变量**的 int（不可提升）⇒ 真正打到写回路径。
// 期望：A=[299]（若写回按陈旧 bit=1 原样存回裸 int48 ⇒ VM 读到次正规垃圾 ✗）。

var D = {"z": 0.0}

main() {
    var a = D["z"]                 // 首次赋值来自 any 容器 ⇒ a 是 any 型；运行期是 float 0.0 ⇒ bit=1
    print("pre=[" + a + "]\n")
    int i = 0
    while i < 300 { a = i; i = i + 1 }   // 不可提升的 int ⇒ 裸 int48
    print("A=[" + a + "]\n")
}
