// bug3 的剩余部分（乘法仍是负的）：先判别"字面量本身有没有被窄化"。
main() {
    print("L_a  0x80000000            = " + 0x80000000)
    print("L_b  4294967296            = " + 4294967296)
    print("L_c  0x80000000 * 1        = " + (0x80000000 * 1))
    print("L_d  2 * 4294967296        = " + (2 * 4294967296))
    print("L_e  0x80000000 * 4294967296 = " + (0x80000000 * 4294967296))
    int a = 0x80000000
    int b = 4294967296
    print("L_f  a(变量)               = " + a)
    print("L_g  b(变量)               = " + b)
    print("L_h  a * b                 = " + (a * b))
    print("L_i  a * b 的位型(hex)     = ")
    print("DONE")
}
