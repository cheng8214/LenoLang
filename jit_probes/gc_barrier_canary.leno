// 写屏障「金丝雀」用例（2026-09-13 重做 —— 现在**真的敏感**）
//
// 场景：老年代 holder 反复把「新生代 Node」写进自己的字段；写完后夹大量分配促发回收。
//       若写屏障失效（老年代 holder 未进 remembered set），这个只被老年代对象引用的
//       年轻 Node 就会被 Minor GC 回收 —— 随后读 h.n 应当拿到 null / 被复用后的 3.0，
//       或者直接崩溃（use-after-free）。
//
// 判据（必须配合确定性 GC 钩子，见下）：
//   有屏障（正常二进制）：bad=0，正常跑完
//   屏障改成空操作：**崩溃**（退出码 -1，stdout 无 bad=，最后一行的 rem=0）
//
// 用法：
//   set LENO_GC_YOUNG_THRESHOLD=64KB    # 钉住年轻代阈值（否则回收时机不可控）
//   set LENO_GC_FORCE_EVERY=2000        # 每 2000 次分配强制回收一次 —— 本探针的关键
//   set LENO_NO_JIT=1                   # 可选：纯解释器，安全点最多、最有确定性
//   set LENO_GC_TRACE=1                 # 可选：打印每次回收的 rem/freed/promoted
//   build\lenojit.exe jit_probes\gc_barrier_canary.leno
//
// 实测（2026-09-13，i5-3450）：
//   有屏障 NO_JIT：6000 次强制回收，bad=0，跑完
//   有屏障 JIT  ：4050 次，bad=0，跑完
//   无屏障 NO_JIT：第 2002 次回收处崩溃（无输出），末行 rem=0
//   无屏障 JIT  ：第   52 次回收处崩溃
//
// 为什么旧设计抓不到（保留下来的教训）：
//   旧版在 main 里直接写 `h.n = new Node(...)`，然后 churn 两次就读，结果是
//   **无论屏障是否生效都 bad=0**。两个原因，第一个是决定性的：
//     1) 写入与读取之间只隔 2 次 churn（4000 次分配），而自然回收间隔是
//        「256 次返回 × 2000 次分配 = 512K 次分配」（trace 里 freed=512128 就是这个数）
//        —— 目标对象在「写入→读取」窗口内**根本没被回收过**，所以永远读到有效值。
//     2) main 帧的残余临时/局部槽还可能让 mark_roots 保守保活它（此条未验证）。
//   本版的两处改动就是针对这两点：
//     * 用 LENO_GC_FORCE_EVERY 把回收**强制塞进**「写入与读取之间」；
//     * 把「分配 + 写字段」一起放进 setHolder()，返回后该帧消失 →
//       那个年轻 Node 只经老年代 holder 可达，屏障是它唯一的保活路径。
//   trace 佐证：有屏障时每次回收 rem>=1（holder 在 remembered set 里），
//   无屏障时 rem=0 —— 差别正是屏障本身。

struct Node {
    float v = 0.0
}

// 必须是可空引用字段（Node?）。写成非空 `Node n` 时该字段是值语义
// （就地刷新嵌套实例），holder 不会真正持有「年轻代对象的引用」，屏障无从生效。
struct Holder {
    Node? n
}

func churn(int k): int {
    var s = 0
    var i = 0
    while i < 2000 {
        var junk = new Node(v = 3.0)
        s = s + _int(junk.v)
        i = i + 1
    }
    return s + k
}

// 关键：分配与写入都在本帧内完成。返回后本帧消失，
// 这个年轻 Node 的引用只剩 h.n（老年代 holder 的字段）。
func setHolder(Holder h): int {
    h.n = new Node(v = 7.0)
    return 0
}

main() {
    var h = new Holder()

    // 预热：让 h 晋升到老年代。
    // 否则 h 还是年轻代，young→young 边由 mark_roots 直接覆盖，屏障无关。
    var i = 0
    while i < 2000 {
        churn(i)
        i = i + 1
    }

    var bad = 0
    i = 0
    while i < 2000 {
        setHolder(h)
        churn(i)                  // 大量分配 → 触发回收（窗口内该 Node 只被 h.n 引用）
        churn(i)                  // 再分配一批，复用被回收的槽（否则读到的仍是旧值）
        if h.n == null { bad = bad + 1 }
        else { if h.n.v != 7.0 { bad = bad + 1 } }
        i = i + 1
    }
    print("bad=" + bad)
    return 0
}
