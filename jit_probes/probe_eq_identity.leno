// OP_EQ 身份比较快路径的差分探针（新增 2026-09-13，配套 §8.34）
//
// 背景：通用 OP_EQ/OP_NEQ 原本对「任一 NaN-boxed」一律 bailout，于是
// `Ptr == Ptr`（如 matrix_rain 的 `_texCache[i].ren == renderer`）所在的循环
// 每次执行都 bailout、跑不进 JIT。现补了一条**运行时**身份比较快路径：
//   两个操作数都是 OBJ、obj->type 相同、且类型 ∉ {OBJ_STRING, OBJ_ARRAY, OBJ_BIGINT}
//   → 值位比较（= 对象身份）。不满足则落回原有慢路径（对 NaN-boxed 仍 bailout）。
//
// 用法（判据）：
//   1) JIT 与解释器结果必须**逐条一致**：
//        build\lenojit.exe jit_probes\probe_eq_identity.leno
//        set LENO_NO_JIT=1 & build\lenojit.exe jit_probes\probe_eq_identity.leno
//      期望两边都是：
//        sameObj=2000 diffObj=0 neq=2000 nullPtr=2000 str=2000 arr=2000 struct=2000
//   2) Bailouts 必须**只剩** c_str / c_arr / c_nullPtr 三个（见下），
//      即身份比较类（c_sameObj / c_diffObj / c_neq / c_struct）不再 bailout。
//
// 三个必须仍然 bailout 的用例（语义不能被快路径吞掉）：
//   c_str      —— 字符串按内容比较
//   c_arr      —— 数组逐元素比较
//   c_nullPtr  —— `ffi.nullptr() == null`：解释器走「看包装地址」的特殊规则（为真），
//                 纯身份比较会给假 ⇒ 绝不能进快路径
import ffi

struct P {
    int v = 0
}

// 同一对象 → true（快路径命中）
func c_sameObj(): int {
    var p = ffi.ptr_from_int(4096)
    var h = 0
    for 2000 { if p == p { h = h + 1 } }
    return h
}

// 两个对象、同一地址 → 解释器按「对象身份」= false（快路径命中）
func c_diffObj(): int {
    var p = ffi.ptr_from_int(4096)
    var q = ffi.ptr_from_int(4096)
    var h = 0
    for 2000 { if p == q { h = h + 1 } }
    return h
}

// != → true（快路径命中）
func c_neq(): int {
    var p = ffi.ptr_from_int(4096)
    var q = ffi.ptr_from_int(4096)
    var h = 0
    for 2000 { if p != q { h = h + 1 } }
    return h
}

// ffi.nullptr() == null → 解释器为 true（特殊规则）；必须仍走解释器
func c_nullPtr(): int {
    var n = ffi.nullptr()
    var h = 0
    for 2000 { if n == null { h = h + 1 } }
    return h
}

// 字符串按内容 → true；类型被快路径排除
func c_str(): int {
    var s = "abc"
    var t = "abc"
    var h = 0
    for 2000 { if s == t { h = h + 1 } }
    return h
}

// 数组逐元素 → true；类型被快路径排除
func c_arr(): int {
    var a = [1, 2, 3]
    var b = [1, 2, 3]
    var h = 0
    for 2000 { if a == b { h = h + 1 } }
    return h
}

// struct 同一对象 → true（身份比较，快路径命中）
func c_struct(): int {
    var s1 = new P(v = 1)
    var h = 0
    for 2000 { if s1 == s1 { h = h + 1 } }
    return h
}

main() {
    print("sameObj=" + c_sameObj())
    print("diffObj=" + c_diffObj())
    print("neq=" + c_neq())
    print("nullPtr=" + c_nullPtr())
    print("str=" + c_str())
    print("arr=" + c_arr())
    print("struct=" + c_struct())
    return 0
}
