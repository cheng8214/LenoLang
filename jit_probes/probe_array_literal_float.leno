// §8.105 探针：**字面量元素在 callout 内部转换**导致的类型污染，且污染值**活过循环**。
//
// 可达性前提（前两版都空转，记下来）：
//   ① 字面量放在**单独小函数**里不行 ✗ —— 函数级 JIT 不编它（实测只编 main）⇒ 字面量在解释器里建；
//   ② 字面量放在 JIT 热循环里、但**同循环内**还有 `"" + a[0]` 也不行 ✗ ——
//      concat 被 §8.103 守卫 ⇒ 整循环被拉黑、退回解释执行 ⇒ 结果被"掩盖"成正确。
//   ③ 所以本版：**在 JIT 区域里建字面量并存入全局**（循环内不做任何类型敏感操作 ⇒ 不 bail），
//      **循环外**用解释器读回 —— 这样看到的是"真的被存进去的那个值"。
//
// 观测口径（§8.102）：值本身（字符串形态）；期望 g=[0.0]（JIT 与 NO_JIT 逐字一致）。
var G = []

main() {
    var z = 1.0 - 1.0                 // 浮点 0.0（SSE 结果 ⇒ 裸 double）
    int i = 0
    while i < 300 {
        var a = [z]                   // ← JIT 区域内的数组字面量（元素在 callout 内部转换）
        G = a
        i = i + 1
    }
    // 循环外读回（不在任何 JIT 区域 ⇒ 无守卫干扰）
    var back = G
    print("g=[" + back[0] + "]\n")
}
