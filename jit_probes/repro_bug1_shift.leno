// Bug1 最小复现（用户报告）：乘法产生的 2^63 级值在循环内做 >> 段错误
// 触发条件（对照实验结论）：必须是"乘法得到的位模式 0x8000000000000000" + 循环内右移
// 且 LENO_NO_JIT=1 同样崩 ⇒ 根因在解释器 VM / 共享字节码层（不是 JIT）。
int calc = 0x80000000 * 4294967296     // 乘法得 2^63，位模式 0x8000000000000000
main() {
    int acc = 0
    for 0 : 15 to i {
        int bb = (calc >> (60 - i * 4)) & 0xf
        acc = acc + bb
    }
    print("acc=" + acc)
}
