// OP_INDEX 慢路径回归探针
//
// 背景（2026-09-13 修复）：ops_index.inc 的 OP_INDEX 慢路径
// （obj 不是数组：dict 取键 / struct 按字段名 / 非 int 索引）在 callout 之后
// **直接落进了「数组越界」bailout 桩**，导致这类索引每次执行都无条件 bailout ——
// 含 `d[k]` / `obj["field"]` 的循环**永远跑不进 JIT**（每轮都退回解释器）。
//
// 修法：慢路径末尾补一条 jmp done，并在 done 处一并 patch。
//
// 验收判据：下方 useStructName 的循环必须 **Bailouts 不再增长**。
//   修复前：Bailouts ≥ 6（两个循环各 3 次）；
//   修复后（§8.33 当时）：只剩 useDict 的 3 次（那是另一条路径，见下）；
//   现状（2026-09-15 复测）：**Bailouts: 0**（useDict 也被顺带修好了）。
//
// ✅ 已解释（2026-09-15）：useDict 里 `s = s + d["k"]` 当年在 OP_ADD_FLOAT 处 bailout，
//   真因是 §8.67 / roadmap R12 —— OP_GET_PROPERTY 的**独立访问形态**漏弹 receiver 槽
//   （`pop_bytes: 0`，提交 5f82acc1 改为 8）⇒ 每执行一次内存栈多留 8 字节 ⇒ 编译期
//   vstack 与运行时栈位错位 ⇒ 操作数从错槽读出、int48 检查不过而 bailout。
//   基线：`Compiled: 3 / Executed: 28 / Bailouts: 0`，且 `dict= 1000.0`。
//   注意这与本探针头部的 OP_INDEX 慢路径是两回事：那条是"能编译但每轮回退"，
//   这条是"栈位错位"。

struct Tex {
    int ok = 0
}

// 元素静态类型不明的数组 → `arr[i].ok` 编译成 OP_INDEX(struct["ok"]) → 慢路径
func useStructName(int p): int {
    var arr = []
    arr.add(new Tex(ok = 1))
    arr.add(new Tex(ok = 2))
    var s = 0
    for 1000 {
        for arr.len() to i {
            if arr[i].ok == p { s = s + 1 }
        }
    }
    return s
}

// dict 取键（走 OP_GET_PROPERTY，另一条路径，本探针只做记录）
func useDict(): float {
    var d = {}
    d["k"] = 1.0
    var s = 0.0
    for 1000 {
        s = s + d["k"]
    }
    return s
}

main() {
    var a = useStructName(1)
    var b = useDict()
    print("stname= " + a + "  dict= " + b)
    return 0
}
