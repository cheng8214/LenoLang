// 净损失实验 A：热循环里调用一个「**函数体含循环**」的辅助函数
//
// 这一形态正是 census 里 `func|函数体含循环（func_mode 不支持）` 那一类（3 个应用共 39 个）：
//   · 被调函数**不能进函数级 JIT**（函数级 JIT 只编"函数体不含循环"的函数）；
//   · 它也**不能被内联**进调用方的热循环 ⇒ 每次调用都得走一次解释器调用（callout）；
//   · 但它**内部的那个循环**是可以被**循环级 JIT** 编掉的（同一回边、同一调用点 ⇒ 缓存命中）。
//
// 因此 A 与 B（见 netloss_b_loop_in_main.leno，等价代码把循环写在 main 里）的差
// **就是"函数体含循环"这条拒收的净损失**。两边 checksum 必须相同（total=48000000）：
//   dot() 每次 = 1*2+2*3+...+8*9 = 240；1,000,000 次调用 ⇒ 240,000,000
//   （工作量取大是为了让**进程启动开销**（~10-30ms）相对可忽略 ⇒ 计时才有意义）
func dot(Array[int] a, Array[int] b, int n): int {
    int s = 0
    for 0 : n to j {
        s = s + a[j] * b[j]
    }
    return s
}

main() {
    var a = [1, 2, 3, 4, 5, 6, 7, 8]
    var b = [2, 3, 4, 5, 6, 7, 8, 9]

    int total = 0
    int i = 0
    while i < 1000000 {
        total = total + dot(a, b, 7)
        i = i + 1
    }
    print("total=" + total + "\n")
}
