// §8.124：大整数位运算的**符号语义**（无限精度补码，与 Python 一致）——
// 原先 `&`/`|`/`^` 都用"看结果最高 limb 的符号位"判正负 ✗，只有当结果幅值**没用到**
// 最高位时才碰巧正确 ⇒ `(2^63) & 0xffffffffffffffff` 被打印成负数 ✗（应 +2^63 ✓）。
// 真判据是**操作数符号**：and ⇒ 两负才负；or ⇒ 有负即负；xor ⇒ 恰一负才负 ✓。
//
// 期望值（手算核对过 ✓）：
//   a & mask   = 9223372036854775808      (+2^63)
//   a | 0      = 9223372036854775808
//   -1 & mask  = 18446744073709551615     (+2^64-1)
//   -1 | 0     = -1
//   -1 ^ mask  = -18446744073709551616    (XOR 唯一会放大幅值 ⇒ 需要多一个 limb)
//   -2 & -3    = -4
//   -1 & 5     = 5
//   -6 ^ 3     = -7
int a = 0x80000000 * 4294967296        // +2^63（§8.123 之后乘法的符号已正确 ✓）
int mask = 0xffffffffffffffff          // +2^64-1

main() {
    print("and_mask = " + (a & mask))
    print("or_zero  = " + (a | 0))
    print("neg_and  = " + (-1 & mask))
    print("neg_or   = " + (-1 | 0))
    print("neg_xor  = " + (-1 ^ mask))
    print("both_neg = " + (-2 & -3))
    print("mix_and  = " + (-1 & 5))
    print("mix_xor  = " + (-6 ^ 3))
    print("DONE")
}
