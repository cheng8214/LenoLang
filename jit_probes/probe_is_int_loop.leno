// §8.117：热循环里对**非负整数**做 `is int` —— 命中 §8.100 的"歧义区 ⇒ bailout"守卫
// （判据 raw>>47 == 0 等于"所有非负 int48" ✗）⇒ 每次迭代都 bail ⇒ 循环被拉黑 ✗。
// 修法：TOS 由白名单指令**证明**为裸 int48 时（§8.41 的 prev_int48），不必猜 ⇒ 直接走正常判定 ✓。
func hotIsInt(int n): int {
    int acc = 0
    int i = 0
    while i < n {
        int v = i + 1          // 非负小整数（也正是歧义区里的值）
        if v is int {
            acc = acc + 1
        }
        i = i + 1
    }
    return acc
}

// 反向情形也要对：float 0.0 **不**应被判成 int（它没有"证明" ⇒ 仍会保守回退 ✓）
func hotIsFloat(int n): int {
    int acc = 0
    int i = 0
    while i < n {
        float f = _float(i) * 0.0
        if f is float {
            acc = acc + 1
        }
        i = i + 1
    }
    return acc
}

main() {
    print("isInt=" + hotIsInt(50000))
    print("isFloat=" + hotIsFloat(50000))
}
