// gen_player_icons.leno — 生成音乐下载器**播放条按钮图标**（PNG：透明底 + 纯白 ⇒ 交给 Button 的 image_tint ✓）
//
// 为什么"离线生成 PNG"而不是每帧自绘：
//   · 按钮本来就支持 `image_path` / `image_tint`（见 sdl_button ✓）⇒ 生成一次，按钮负责加载与状态色 ✓
//   · 每帧自绘得为每个图标配 Canvas + 命中 + hover ✗；而图标形状是固定的，没必要每帧算 ✓
//   · 观感统一：一套图标配 `image_tint` 就能适配所有主题（深/浅/强调色 ✓）
//
// 为什么"纯白 + 透明底"：
//   · 颜色交给 `image_tint` ⇒ 一套图走遍所有主题 ✓（图里就不要再带颜色了 ✗）
//
// 用法：
//   $env:SDL_VIDEODRIVER='dummy'                       # 无头（不弹窗，推荐 ✓）
//   build\leno.exe tools\gen_player_icons.leno [输出目录] [边长] [force]
//     · 不给输出目录 ⇒ 默认 leno_gui\应用\音乐下载器\images ✓
//     · 边长默认 24（与按钮显示尺寸 1:1 ⇒ 不会再插值、最清晰 ✓）；想看大图就传 96 ✓
//     · ⚠⚠ **默认不覆盖已存在的文件**（跳过并报出来 ✓）
//       默认目录里是**应用正在用的图标**、可能有人手工调过 ⇒ 一跑就全盖掉 ✗（2026-10-08 真踩过 ✓）
//       要覆盖必须在命令行**显式**加 `force` ✓
//   例：build\leno.exe tools\gen_player_icons.leno "%TEMP%\icons_big" 96      # 出大图，不碰应用目录 ✓
//       build\leno.exe tools\gen_player_icons.leno "%TEMP%\icons" 24 force    # 覆盖那个目录 ✓
//
// 产出：play / pause / prev / next / list / loop_all / loop_one / lrc
//   · "循环：关"复用 loop_all + 灰色 tint ✓ ⇒ 不另出一张 ✗
//   · `lrc` = 歌词按钮（一张"纸" + 三行文本 ✓）
//
// 实现要点：
//   · 图形全靠渲染器的 AA 图元（fillTri / fillRoundedRect / drawCircle / fillCircle ✓）
//     ⇒ 没有手写像素、也没有抗锯齿锯齿问题 ✓
//   · 读回像素走 `readPixelsAt`（内部 SDL_RenderReadPixels ✓）+ `saveImagePNG` ✓
//     —— 与截图自检（DSHOT）同一条路 ✓，所以这套在无头下也能跑 ✓
import SDL3
import dirs
import files
import maths
use SDL3.(Renderer, Window, Color)

// ==================== 图标画法（都在 sz×sz 画布内，纯白 ✓）====================
// 比例基准：24px 时半宽 8（图标约占 16~18px ✓）；其它尺寸按 k = sz/24 缩放 ✓

func draw_play(Renderer r, float k) {
    r.fillTri(3.0 * k, 1.0 * k, 3.0 * k, 23.0 * k, 21.0 * k, 12.0 * k, 255, 255, 255)
}

func draw_pause(Renderer r, float k) {
    r.fillRoundedRect(1.5 * k, 1.0 * k, 7.5 * k, 22.0 * k, 2.0 * k)
    r.fillRoundedRect(15.0 * k, 1.0 * k, 7.5 * k, 22.0 * k, 2.0 * k)
}

func draw_prev(Renderer r, float k) {
    r.fillRoundedRect(1.0 * k, 1.0 * k, 5.0 * k, 22.0 * k, 2.0 * k)
    r.fillTri(22.0 * k, 1.0 * k, 22.0 * k, 23.0 * k, 8.0 * k, 12.0 * k, 255, 255, 255)
}

func draw_next(Renderer r, float k) {
    r.fillRoundedRect(18.0 * k, 1.0 * k, 5.0 * k, 22.0 * k, 2.0 * k)
    r.fillTri(2.0 * k, 1.0 * k, 2.0 * k, 23.0 * k, 16.0 * k, 12.0 * k, 255, 255, 255)
}

// 列表：三行"点 + 横条"（与标题栏的 menu 图标区分开 ⇒ 左边有点 ✓）
func draw_list(Renderer r, float k) {
    for 3 to i {
        float y = (5.0 + _float(i) * 7.0) * k
        r.fillCircle(2.5 * k, y, 2.0 * k)
        r.fillRoundedRect(7.0 * k, y - 1.6 * k, 15.0 * k, 3.2 * k, 1.6 * k)
    }
}

// 循环：圆环（两条同心描边当"加粗" ✓ + 右缘**朝右**的箭头 ✓）
//   ⚠ 箭头顶点**必须在右边**：顶点放左边会画成"◀"，看着像"上一曲"而不是循环 ✗（第一版就画反了）
func loop_base(Renderer r, float k) {
    r.drawCircle(12.0 * k, 12.0 * k, 9.0 * k)
    r.drawCircle(12.0 * k, 12.0 * k, 7.4 * k)
    r.fillTri(22.0 * k, 12.0 * k, 15.0 * k, 7.6 * k, 15.0 * k, 16.4 * k, 255, 255, 255)
}

func draw_loop_all(Renderer r, float k) { loop_base(r, k) }

// 单曲：环里再放一个"1"（竖条 + 左侧小旗 ✓；放**左中**，别跟右缘箭头挤一起 ✗）
func draw_loop_one(Renderer r, float k) {
    loop_base(r, k)
    r.fillRoundedRect(9.4 * k, 7.0 * k, 2.6 * k, 10.0 * k, 1.3 * k)
    r.fillTri(9.4 * k, 7.0 * k, 12.0 * k, 7.0 * k, 9.4 * k, 10.2 * k, 255, 255, 255)
}

// 歌词（2026-10-08 新增 ✓）：一张"纸"（圆角描边）+ 三条长短不一的文本线 ✓
//   ⚠ 别用文字"词"：`drawText` 要字体、还得管字形缺失 ✗ ⇒ 图形最稳 ✓
//   ⚠ 三条线**要长短不一**：等长会看着像"列表"图标（跟 list.png 撞脸 ✗）
func draw_lrc(Renderer r, float k) {
    r.drawRoundedRect(3.5 * k, 3.0 * k, 17.0 * k, 18.0 * k, 2.4 * k)
    r.fillRoundedRect(6.5 * k, 7.0 * k, 11.0 * k, 2.6 * k, 1.3 * k)
    r.fillRoundedRect(6.5 * k, 11.2 * k, 8.0 * k, 2.6 * k, 1.3 * k)
    r.fillRoundedRect(6.5 * k, 15.4 * k, 10.0 * k, 2.6 * k, 1.3 * k)
}

// ==================== 出图 ====================
// ⚠⚠ 关键坑（第一版就栽在这，别人做图标时也一定会踩）：
//   别把图标画在**窗口后缓冲**上再读回 —— 后缓冲**没有 alpha 通道** ✗
//   ⇒ `clearColor(#00000000)` 的"透明"存出来是**实心黑** ✗（看着就是图标带黑底 ✗）
//   正解：渲染到一张 **ARGB8888 的 target 纹理**上（目标纹理带 alpha ✓），再 `readPixelsAt` 读它 ✓
//     —— `SDL_RenderReadPixels` 读的是**当前渲染目标** ⇒ 读到的就是这张 ARGB 纹理 ✓
// 覆盖保护（2026-10-08 ✓）：默认**不覆盖**已存在的文件
//   ⚠ 默认输出目录就是应用在用的 `images/` ⇒ 一跑就把别人手工调的图标全盖掉 ✗（真踩过 ✓）
//   ⇒ 跳过 + 报出来；要覆盖得在命令行显式给 `force` ✓
var gForce = false
int gSkipped = 0

func gen_one(Renderer r, Ptr[u8] tex, string outDir, string name, int sz, int which) {
    string path = outDir + "\\" + name + ".png"
    if files.exists(path) and not gForce {
        gSkipped = gSkipped + 1
        print("[icons] 跳过（已存在；要覆盖请加 force ✓）：" + path + "\n")
        return
    }
    float k = _float(sz) / 24.0
    r.setRenderTarget(tex)                  // ★ 切到带 alpha 的目标纹理 ✓
    r.clearColor(#00000000)                 // 全透明底 ✓（颜色由按钮 tint ⇒ 图里不带色 ✓）
    r.setColor(#FFFFFFFF)
    if which == 0 { draw_play(r, k) }
    eif which == 1 { draw_pause(r, k) }
    eif which == 2 { draw_prev(r, k) }
    eif which == 3 { draw_next(r, k) }
    eif which == 4 { draw_list(r, k) }
    eif which == 5 { draw_loop_all(r, k) }
    eif which == 6 { draw_loop_one(r, k) }
    else { draw_lrc(r, k) }
    // ⚠ 这里**不能** present()：present 是给窗口后缓冲的，目标纹理上调用没意义 ✗
    var s = r.readPixelsAt(0, 0, sz, sz)
    bool ok = false
    if s != null { ok = SDL3.saveImagePNG(s, path) }
    print("[icons] " + name + ".png  " + _str(sz) + "x" + _str(sz) + "  " + (if ok then "OK ✓" else "**失败**") + "\n")
}

main() {
    var args = _args()
    string out = ""
    if args.len() >= 1 { out = _str(args[0]) }
    if out == "" {
        // 本工具在 tools/ ⇒ 默认落到应用的 images/ 里 ✓
        out = dirs.script_dir() + "\\..\\leno_gui\\应用\\音乐下载器\\images"
    }
    int sz = 24
    if args.len() >= 2 { sz = _int(_str(args[1])) }
    if sz < 8 { sz = 8 }
    if sz > 512 { sz = 512 }
    // 第 3 个参数是 `force` 才允许覆盖（默认保护已有文件 ✓ 见文件头 ⚠⚠）
    if args.len() >= 3 and _str(args[2]).trim() != "" { gForce = true }

    if not dirs.exists(out) { dirs.mkdir_p(out) }
    print("[icons] 输出目录：" + out + "\n")

    var win = SDL3.createWindow({title: "gen_player_icons", w: sz, h: sz})
    if not win.ok {
        print("[icons] 建窗失败（无头请设 SDL_VIDEODRIVER=dummy ✓）\n")
        return
    }
    Renderer r = SDL3.createRenderer(win.handle)
    if r.handle == null {
        print("[icons] 建渲染器失败\n")
        return
    }

    // ★ 一张 ARGB8888 的 **target 纹理**（带 alpha ✓）—— 图标全画在它上面，理由见 gen_one 上面的 ⚠⚠
    Ptr[u8] tex = r.createTexture(SDL3.PIXELFORMAT_ARGB8888, SDL3.TextureAccess.TARGET, sz, sz)
    if tex == null {
        print("[icons] 建目标纹理失败（ARGB8888 + TARGET）\n")
        return
    }

    gen_one(r, tex, out, "play", sz, 0)
    gen_one(r, tex, out, "pause", sz, 1)
    gen_one(r, tex, out, "prev", sz, 2)
    gen_one(r, tex, out, "next", sz, 3)
    gen_one(r, tex, out, "list", sz, 4)
    gen_one(r, tex, out, "loop_all", sz, 5)
    gen_one(r, tex, out, "loop_one", sz, 6)
    gen_one(r, tex, out, "lrc", sz, 7)
    r.setRenderTarget(null)                 // 收尾复位 ✓
    SDL3.destroyTexture(tex)
    string msg = "[icons] 完成：8 个图标（透明底 + 纯白 ⇒ 用 image_tint 上色 ✓）"
    if gSkipped > 0 {
        msg = msg + "\n[icons] 跳过 " + _str(gSkipped) + " 个已存在的（**没覆盖** ✓；确实要覆盖请在末尾加 force）"
    }
    print(msg + "\n")
}
