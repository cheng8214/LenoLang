// png_to_ico.leno — 把一张 PNG **原样**封进 ICO 容器（给 resource.toml 的 `[pack] icon` 用 ✓）
//
// 为什么需要它：打包 exe 时 Windows **只认 .ico** —— 图标是 PE 资源（RT_GROUP_ICON / RT_ICON），
//   PNG/JPG 必须先转成 ICO 容器 ✗（见 docs/单文件打包使用指南.md §4.2 ✓）
// 但 ICO 里的图像数据是**原样搬运**的 ✓ ⇒ 直接把 PNG 字节塞进 ICO 容器就行，
//   **不需要解码、不需要重新编码** ✓✓ ⇒ 本工具也就**不依赖 SDL3**，只写 22 字节头 + 原 PNG ✓
//
// 用法：
//   build\leno.exe tools\png_to_ico.leno <输入.png> [输出.ico]
//   不给输出 ⇒ 同目录同名、扩展名换 .ico ✓
//   例：build\leno.exe tools\png_to_ico.leno leno_gui\应用\音乐下载器\images\index.png leno_gui\应用\音乐下载器\app.ico
//
// ⚠ 两条边界（都在下面明确报错，不产出坏文件 ✗）：
//   · 输入必须是 PNG（查 8 字节签名 ✓）
//   · 单条上限 256×256，且本工具**不缩放** ⇒ 超了直接报错（先拿别的工具缩 ✓）
//     想要"大图标"清晰，请给 **256×256** 的 PNG：48×48 会被系统放大 ⇒ 发虚 ✗
//
// 实现要点：
//   · 读文件走 `files.open(p, "rb").read()` —— `files.read()` 是**文本语义**、会剥 UTF-8 BOM ✗
//   · 写文件走 `files.write()`（原生是 `"wb"` + `fwrite(str->chars, 1, str->len)` ⇒ 按长度写、二进制安全 ✓）
//     ⚠ 它返回 **null**（不是 bool）⇒ 不能写 `if not files.write(...)` ✗；本工具**写完再读回来对比字节数** ✓
//   · 字节拼装一律走 ffi 原语（`write_byte` / `write_le_i16` / `write_le_i32` / `read_be_i32` ✓）
import ffi
import files

main() {
    var args = _args()
    if args.len() < 1 {
        print("用法: leno tools\\png_to_ico.leno <输入.png> [输出.ico]\n")
        print("  不给输出 ⇒ 同目录同名、扩展名换 .ico\n")
        _exit(1)
    }
    string src = _str(args[0])
    string dst = ""
    if args.len() >= 2 {
        dst = _str(args[1])
    } else if src.len() > 4 and src.slice(src.len() - 4, src.len()) == ".png" {
        dst = src.slice(0, (src.len() - 4) - 1) + ".ico"
    } else {
        dst = src + ".ico"
    }

    if not files.exists(src) {
        print("[ico] 找不到输入文件：" + src + "\n")
        _exit(1)
    }

    // ① 读原始字节（二进制模式：不做任何处理 ✓）
    var f = files.open(src, "rb")
    string png = f.read()
    f.close()
    // ⚠ 必须用 `byte_len()`：`len()` 是**码点数** ✗，PNG 里全是任意字节 ⇒ 拿它当缓冲大小会越界 ✗
    int n = png.byte_len()
    if n < 24 {
        print("[ico] 文件太小，不像 PNG：" + _str(n) + " 字节\n")
        _exit(1)
    }

    Ptr[u8] p = ffi.malloc(n)
    ffi.write_bytes(p, 0, png)

    // ② 校签名 + 取宽高（PNG：8 字节签名 + 4 长度 + 4 类型 ⇒ 宽在 16..19、高在 20..23，**大端** ✓）
    if ffi.read_byte(p, 0) != 0x89 or ffi.read_byte(p, 1) != 0x50
       or ffi.read_byte(p, 2) != 0x4E or ffi.read_byte(p, 3) != 0x47 {
        print("[ico] 这不是 PNG（8 字节签名不对）\n")
        ffi.free(p)
        _exit(1)
    }
    int w = ffi.read_be_i32(p, 16)
    int h = ffi.read_be_i32(p, 20)
    if w <= 0 or h <= 0 or w > 256 or h > 256 {
        print("[ico] 尺寸不支持：" + _str(w) + "x" + _str(h)
              + "（ICO 单条上限 256×256，且本工具不缩放 ⇒ 请先缩到 ≤256 ✓）\n")
        ffi.free(p)
        _exit(1)
    }

    // ③ 22 字节 ICO 头 = ICONDIR(6) + ICONDIRENTRY(16)，之后紧跟**原 PNG 数据** ✓
    Ptr[u8] hdr = ffi.malloc(22)
    ffi.write_le_i16(hdr, 0, 0)                             // reserved
    ffi.write_le_i16(hdr, 2, 1)                             // type: 1 = icon
    ffi.write_le_i16(hdr, 4, 1)                             // count: 1 张
    ffi.write_byte(hdr, 6, if w >= 256 then 0 else w)        // 宽（**0 表示 256** ✓）
    ffi.write_byte(hdr, 7, if h >= 256 then 0 else h)        // 高（同上 ✓）
    ffi.write_byte(hdr, 8, 0)                               // 调色板色数（0 = 真彩 ✓）
    ffi.write_byte(hdr, 9, 0)                               // reserved
    ffi.write_le_i16(hdr, 10, 1)                            // color planes
    ffi.write_le_i16(hdr, 12, 32)                           // bits per pixel
    ffi.write_le_i32(hdr, 14, n)                            // 图像数据字节数（= PNG 原样长度 ✓）
    ffi.write_le_i32(hdr, 18, 22)                           // 数据偏移 = 6 + 16 ✓

    // ④ 拼起来（头 + 原 PNG）写盘
    string out = ffi.read_bytes(hdr, 0, 22) + png
    files.write(dst, out)

    // ⑤ 写完**读回来对比字节数**（`files.write` 不返回成败 ⇒ 自己验 ✓）
    int total = 22 + n
    var chk = files.open(dst, "rb")
    int got = chk.read().byte_len()          // 二进制 ⇒ 同样要按字节比 ✓
    chk.close()
    bool ok = got == total
    print("[ico] " + (if ok then "完成" else "**写盘异常**") + "：" + dst
          + "\n      尺寸 " + _str(w) + "x" + _str(h)
          + " · PNG 原样 " + _str(n) + " 字节 · 合计 " + _str(total)
          + " 字节 · 回读 " + _str(got) + " 字节"
          + (if ok then " ✓" else " ✗") + "\n")
    if w < 256 or h < 256 {
        print("      ⚠ 源图不足 256×256 ⇒ 资源管理器的\"大图标\"会被系统放大、发虚 ✗\n"
              + "        建议换一张 256×256 的 PNG 重新生成 ✓\n")
    }

    ffi.free(p)
    ffi.free(hdr)
    if not ok { _exit(1) }
}
