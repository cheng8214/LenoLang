// bench_sdl3_renderer.leno —— LenoSDL3 渲染/事件热路径基准（无头，可重复）
//
// 用法（仓库根目录）：
//     $env:SDL_VIDEODRIVER="dummy"        # Windows PowerShell
//     ./build/leno.exe tools/bench_sdl3_renderer.leno
//
// 为什么用 dummy 驱动：只测**我们这层封装**（cstruct 分配、批处理写入、VM 调用开销），
// 不测 GPU。software 渲染器会把 SDL_RenderTexture 的开销也计入，所以纹理绘制那两行的
// 绝对值包含 SDL 自己的光栅化成本 —— 看**前后对比**即可，不要当绝对性能承诺。
//
// 2026-11-12 基线 → 优化后（同机、同脚本、各取 3 轮最好）：
//
//   单次调用：
//     drawTextureAt                  597 → 424 ns/次  (-29%)
//     drawTextureFromTo              892 → 567 ns/次  (-36%)
//     drawTextureAt（opacity 0.5）  1348 → 954 ns/次  (-29%)
//
//   端到端一帧（含 present，**software** 渲染器）：
//     50 纹理 + 50 矩形     155.2 → 161.5 us/帧   （噪声：只省 ~14us，present 18us 波动更大）
//     200 纹理 + 200 矩形   613.5 → 600.9 us/帧   (-2.1%)
//     1000 纹理 + 500 矩形  2852  → 2695  us/帧   (-5.5%)
//
//   ⚠ 帧级只降 2~6%，因为 **software 渲染器**的光栅化占大头：1000 精灵省下的 157us
//     正好≈ 1000 × 173ns（= 单次的差额）⇒ 剩下 ~2.7us/精灵 全是软件 blit。
//     真实 GPU 上 `SDL_RenderTexture` 只是入队、blit 近乎免费 ⇒ 我们这层的占比更高，
//     帧级收益会接近上面的"单次调用"数字。留这份软件基准是为了**可重复、无显卡依赖**。
//
//   文字批处理（512 条 1×1 条目 + 一次 flush，量的是"我们这层"）：
//     424.6 → 394.2 us/批  (-7.2%)
//     （原来每 flush 都：`Array[int] idxArr = []` + 6×count 次 add + `ffi.malloc(idxPtr)`
//       + 一趟全量拷贝；现在索引模式固定，直接在填顶点的同一个循环里写进**复用缓冲**。）
//
//   优化手段：把每次绘制都 `SDL_FRect.malloc() + to_ptr() + free()` 换成
//   **模块级复用的临时 cstruct**（渲染是单线程的，用完即弃，见 sdl_renderer.leno 顶部）。
//
//   文字批处理的**索引模式**有独立回归：`build/leno_module/LenoSDL3/test/test_renderer_texbatch.leno`
//   （无头也能跑：读回索引缓冲断言 4k,4k+1,4k+2,4k,4k+2,4k+3）。
import ffi
import times
import "../build/leno_module/LenoSDL3/lib/sdl_core.leno" as core
import "../build/leno_module/LenoSDL3/lib/sdl_window.leno" as win
import "../build/leno_module/LenoSDL3/lib/sdl_renderer.leno" as rend
import "../build/leno_module/LenoSDL3/lib/sdl_event.leno" as evt
use win.(Window, Renderer)
use evt.Event

Renderer R = null
Ptr[u8] G_TEX = null

// 端到端「一帧」基准：模拟一帧里画 sprites 个纹理 + rects 个矩形 + 一次 present，
// 直接报 µs/帧 与理论 FPS（比单次调用更接近真实观感）。
//   ⚠ 这里是 **software 渲染器**：纹理光栅化成本被算进来了 ⇒ 真实 GPU 下
//     `SDL_RenderTexture` 只是入队，我们这层的占比更高，本优化的收益只会更明显。
func frameOnce(int sprites, int rects) {
    for 0 : rects - 1 to i {
        R.fillRect(_float(i % 40) * 8.0, _float(i / 40) * 8.0, 7.0, 7.0)
    }
    for 0 : sprites - 1 to i {
        R.drawTextureAt(G_TEX, _float(i % 20) * 32.0, _float(i / 20) * 32.0, 32.0, 32.0)
    }
    R.present()
}

// **取 3 轮的最好成绩**：帧级基准的单轮波动能有 ±10%（调度 / 缓存预热），
//   取 min 才能让"改动前后"的对比有意义。
func benchFrames(string name, int frames, int sprites, int rects) {
    for 0 : 2 to _w { frameOnce(sprites, rects) }        // warmup 3 帧
    var best = -1.0
    for 0 : 2 to _rep {
        var t0 = times.us()
        for 0 : frames - 1 to _f { frameOnce(sprites, rects) }
        var t1 = times.us()
        var per = (t1 - t0) / _float(frames)
        if best < 0.0 or per < best { best = per }
    }
    if best <= 0.0 { best = 1.0 }
    print("  " + name + "  " + _str(frames) + " 帧 ×3 轮取最好 ⇒ " + _str(best) + " us/帧，理论 "
          + _str(1000000.0 / best) + " FPS")
}

func bench(string name, int iters, func():void body) {
    body()                                   // warmup
    var t0 = times.us()
    body()
    var t1 = times.us()
    var dt = t1 - t0
    if dt <= 0.0 { dt = 1.0 }
    var per = dt * 1000.0 / _float(iters)               // ns / 次
    print("  " + name + "  " + _str(iters) + " 次 " + _str(_int(dt)) + " us  ⇒ " + _str(per) + " ns/次")
}

main() {
    if not core.initVideo() { print("initVideo failed: " + core.getError()); return }

    var w = win.createWindow({ title: "bench", w: 640, h: 480 })
    R = w.createRenderer()

    Ptr[u8] tex = R.createTexture(core.PIXELFORMAT_RGBA8888, 0, 64, 64)
    G_TEX = tex
    print("渲染驱动 = " + R.driver_name() + "，纹理 = " + _str(tex != null))

    print("=== 端到端：一帧的成本（含 present）===")
    benchFrames("轻量界面（50 纹理 + 50 矩形）", 200, 50, 50)
    benchFrames("中等界面（200 纹理 + 200 矩形）", 150, 200, 200)
    benchFrames("密集场景（1000 纹理 + 500 矩形）", 60, 1000, 500)

    print("=== 文字批处理（flushTexBatch，无 TTF 也能测）===")
    // ⚠ 用 **1×1 像素** 的条目：把 SDL 的光栅化成本压到接近 0 ⇒ 量到的基本是
    //   "我们这层"（pushTexBatch 写缓冲 + flush 建顶点/索引 + SDL 调用）。
    //   用 18×22 的条目时 SDL 软件光栅占 90%+，看不出我们改了什么。
    bench("pushTexBatch 512 条(1×1) + flush", 2000, func() {
        for 0 : 1999 to _r {
            for 0 : 511 to i {
                R._dbgPushTex(tex, _float(i % 20) * 2.0, _float(i / 20) * 2.0, 1.0, 1.0, 1.0)
            }
            R._dbgFlushBatches()
        }
    })

    print("=== 绘制热路径（单次调用）===")

    bench("setColorFloat（同色，命中缓存）", 1000000, func() {
        for 0 : 999999 to i { R.setColorFloat(0.5, 0.25, 0.75, 1.0) }
    })

    bench("fillRect（批处理写入）", 500000, func() {
        for 0 : 499999 to i { R.fillRect(1.0, 2.0, 3.0, 4.0) }
        R.fillRect(-1.0, -1.0, 0.0, 0.0)
    })

    bench("drawTextureAt（单次纹理绘制）", 200000, func() {
        for 0 : 199999 to i { R.drawTextureAt(tex, 10.0, 20.0, 64.0, 64.0) }
    })

    bench("drawTextureFromTo（源+目标矩形）", 100000, func() {
        for 0 : 99999 to i { R.drawTextureFromTo(tex, 0.0, 0.0, 32.0, 32.0, 10.0, 10.0, 64.0, 64.0) }
    })

    R.setAlphaScale(0.5)
    bench("drawTextureAt（opacity 0.5，走 _texScalePush）", 100000, func() {
        for 0 : 99999 to i { R.drawTextureAt(tex, 10.0, 20.0, 64.0, 64.0) }
    })
    R.setAlphaScale(1.0)

    bench("present（含一次批处理 flush）", 300, func() {
        for 0 : 299 to i {
            R.fillRect(0.0, 0.0, 100.0, 100.0)
            R.present()
        }
    })

    print("=== 事件热路径 ===")
    var e = evt.createEvent()
    bench("poll 空队列", 200000, func() {
        for 0 : 199999 to i { var _has = e.poll() }
    })
    bench("push + poll（合成鼠标移动）", 20000, func() {
        for 0 : 19999 to i {
            var _p = win.testMoveAt(1, 1.0, 2.0)
            var _h = e.poll()
        }
    })
    e.uninit()

    R.destroy()
    w.destroy()
    core.quit()
    print("done")
}
